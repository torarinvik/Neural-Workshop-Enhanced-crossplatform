include "./tasks/inside_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"

module SceneInside:
    const WIDTH: f64 = 857.28
    const HEIGHT: f64 = 389.0
    const BOTTOM: f64 = 179.0
    const CX: f64 = 456.0
    const BUTTON_HEIGHT: f64 = HEIGHT * 0.13
    const BUTTON_GAP: f64 = WIDTH * 0.012
    const BUTTON_WIDTH: f64 = WIDTH * 0.3
    const PAPER_INK: u32 = 0x282e46ff

    def button(port: i64) -> SceneHiddenRule::Rect:
        return SceneHiddenRule::Rect{x: CX - BUTTON_WIDTH - BUTTON_GAP / 2.0 + port.f64() * (BUTTON_WIDTH + BUTTON_GAP),
            y: BOTTOM, w: BUTTON_WIDTH, h: BUTTON_HEIGHT}

    def hit(run: InsideGame::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return InsideGame::START if run.phase == InsideGame::READY or run.phase == InsideGame::DONE
            return -1 if run.phase != InsideGame::PLAYING
            for port in 0..<2 |x, y|:
                rect: SceneHiddenRule::Rect = button(port)
                return port if x >= rect.x and x <= rect.x + rect.w and y >= rect.y and y <= rect.y + rect.h
            return -1

    def choice(pair: bool, port: i64) -> sview:
        if pair:
            return "Yes" if port == 0 else "No"
        return "Inside" if port == 0 else "Outside"

    def paint_buttons(list: mutable Display::DisplayList&, run: InsideGame::Run&, ink: u32, dark: bool):
        can Memory.Allocate, Abort.Panic:
            paper: u32 = 0x2e323aff if dark else 0xe8ebf0ff
            for port in 0..<2 |list, run, ink, paper|:
                rect: SceneHiddenRule::Rect = button(port)
                border: mutable u32 = ink
                if run.phase == InsideGame::JUDGED:
                    if port == run.puzzle.answer:
                        border <- 0x3caa5aff
                    elif port == run.chosen:
                        border <- 0xd6403aff
                Display::draw_bordered_rect(list, rect.x, rect.y, rect.w, rect.h, paper, border, 2.0 if border == ink else 5.0)
                label: mutable dstr = []
                dstr_append_cstr(&label, "1  " if port == 0 else "2  ")
                dstr_append_sview(&label, choice(run.puzzle.level.pair, port))
                Display::draw_text(list, bytes_view(label), rect.x + rect.w / 2.0, rect.y + rect.h / 2.0,
                    14.0, ink, Display::ANCHOR_CENTER_CENTER)

    def path_point(cell: i64) -> Inside::Point:
        return Inside::Point{x: Inside::x_of(cell).f64(), y: Inside::y_of(cell).f64()}

    def stroke(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&, cell: f64,
               thick: f64, a: Inside::Point, b: Inside::Point):
        can Memory.Allocate, Abort.Panic:
            ax: f64 = box.x + (a.x + 1.0) * cell
            ay: f64 = box.y + (a.y + 1.0) * cell
            bx: f64 = box.x + (b.x + 1.0) * cell
            by: f64 = box.y + (b.y + 1.0) * cell
            if ax != bx or ay != by:
                Display::draw_line(list, ax, ay, bx, by, thick, PAPER_INK)
            Display::draw_circle(list, ax, ay, thick / 2.0, PAPER_INK)

    def paint_puzzle(list: mutable Display::DisplayList&, run: InsideGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            side: f64 = HEIGHT - BUTTON_HEIGHT - HEIGHT * 0.03
            cell: f64 = side / (run.puzzle.level.size + 2).f64()
            area: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: CX - side / 2.0, y: BOTTOM + HEIGHT - side, w: side, h: side}
            paper: SceneHiddenRule::Rect = ScenePolish::spread_box(&area, 8.0)
            ScenePolish::card_face(list, &paper, 14.0, 0xfaf4e4ff, 0xd6c8aaff, 0.u32(), dark)
            if run.phase == InsideGame::JUDGED:
                for id in 0..<Inside::CELLS |run, list, area, cell|:
                    if run.puzzle.region[id.usize()]:
                        p: Inside::Point = path_point(id)
                        Display::draw_rect(list, area.x + (p.x + 1.0) * cell, area.y + (p.y + 1.0) * cell, cell, cell, 0x78c8a06e)
            thick: f64 = SceneHiddenRule::minimum(5.0, cell * 0.28) if cell * 0.28 > 2.0 else 2.0
            for i in 0..<run.puzzle.count |run, list, area, cell, thick|:
                next: usize = ((i + 1) % run.puzzle.count).usize()
                stroke(list, &area, cell, thick, path_point(run.puzzle.loop[i.usize()]), path_point(run.puzzle.loop[next]))
            rng: mutable MT19937 = run.puzzle.decoy_rng
            for _line in 0..<run.puzzle.level.decoys |run, list, area, cell, thick, rng|:
                line: Inside::Stroke = Inside::decoy(run.puzzle.level.size, &rng)
                for i in 0..<(line.count - 1) |list, area, cell, thick, line|:
                    stroke(list, &area, cell, thick, line.points[i.usize()], line.points[(i + 1).usize()])
                p: Inside::Point = line.points[(line.count - 1).usize()]
                stroke(list, &area, cell, thick, p, p)
            dots: i64 = 2 if run.puzzle.level.pair else 1
            radius: f64 = cell * 0.3 if cell * 0.3 > 4.0 else 4.0
            for i in 0..<dots |run, list, area, cell, radius|:
                p: Inside::Point = path_point(run.puzzle.dots[i.usize()])
                x: f64 = area.x + (p.x + 1.5) * cell
                y: f64 = area.y + (p.y + 1.5) * cell
                colour: u32 = 0xec4850ff if i == 0 else 0x3c8cf0ff
                alphas: u32[4] = [13, 22, 31, 45]
                for layer in 0..<4 |list, x, y, radius, colour, alphas|:
                    Display::draw_circle(list, x, y, radius * 2.4 * (1.0 - layer.f64() * 0.2),
                        (colour & 0xffffff00.u32()) | alphas[layer.usize()])
                Display::draw_circle(list, x, y, radius, colour)
                Display::draw_circle(list, x - radius * 0.3, y + radius * 0.3, radius * 0.3, 0xffffffff)

    def judgement(run: InsideGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_cstr(out, "Right: " if run.passed else "No: ")
            dstr_append_sview(out, choice(run.puzzle.level.pair, run.puzzle.answer))

    def message(run: InsideGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == InsideGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif run.phase == InsideGame::DONE:
                dstr_append_i64(out, run.passed_count)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, run.scored_count)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, run.best_rung)
            elif run.phase == InsideGame::JUDGED:
                judgement(run, out)
            elif run.puzzle.level.pair:
                dstr_append_cstr(out, "Can the two dots meet without crossing the line?")
            else:
                dstr_append_cstr(out, "Is the dot inside the closed line?")

    def render(list: mutable Display::DisplayList&, run: InsideGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Inside or Out?", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "I: inside / yes   O: outside / no   or click   Esc: menu", CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            status: mutable dstr = []
            message(run, &status)
            Display::draw_text(list, bytes_view(status), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if run.has_verdict:
                verdict: mutable dstr = []
                judgement(run, &verdict)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.passed, bytes_view(verdict), 60.0, 16.0)
            if run.phase == InsideGame::FLAGGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, false, "Out of time", 60.0, 16.0)
            return if run.phase == InsideGame::READY or run.phase == InsideGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, run.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, run.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, run.total)
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            paint_puzzle(list, run, dark)
            paint_buttons(list, run, ink, dark)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Inside::Grade = Inside::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_cstr(out, "a blob." if level.kind == 0 else ("a blob with fingers." if level.kind == 1 else "a labyrinth."))
            if level.pair:
                dstr_append_cstr(out, "  Two dots.")
            if level.decoys > 0:
                dstr_append_cstr(out, "  Decoy lines.")
