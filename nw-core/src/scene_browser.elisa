include "./tasks/browser_game.elisa"
include "./display.elisa"
include "./scene_verdict.elisa"
include "./textmetrics.elisa"

module SceneBrowser:
    # ui/browser.py's drawing: a browser window -- a tab, a toolbar with
    # Back, Home, the address and the cart, the page and its scrollbar --
    # and the drawn pointer, inside RungTask's title, status and footnote.
    const CX: f64 = BrowserGame::WIDTH / 2.0
    const TABS: u32 = 0xdee2e8ff
    const TAB: u32 = 0xfafbfdff
    const TOOLBAR: u32 = 0xf0f2f6ff
    const PAGE: u32 = 0xffffffff
    const EDGE: u32 = 0xaab0bcff
    const INK: u32 = 0x181a20ff
    const LINK: u32 = 0x1e50c8ff
    const MUTED: u32 = 0x787c84ff
    const BUTTON: u32 = 0xe4e8f0ff
    const BANNER: u32 = 0xffeeaaff
    const GOOD: u32 = 0x1e783cff
    const BAD: u32 = 0xaa3228ff
    const NO_FILL: u32 = 0x00000000

    # _rect: a rectangle given in page units, its top-left corner first.
    def rect(list: mutable Display::DisplayList&, at: BrowserGame::Frame, x: f64, y: f64, w: f64, h: f64, fill: u32, edge: u32):
        can Memory.Allocate, Abort.Panic:
            left: f64 = at.left + x * at.scale
            bottom: f64 = at.top - (y + h) * at.scale
            if edge == NO_FILL:
                Display::draw_rect(list, left, bottom, w * at.scale, h * at.scale, fill)
            else:
                Display::draw_bordered_rect(list, left, bottom, w * at.scale, h * at.scale, fill, edge, 1.0)

    # _words: text at a page point, shrunk to fit `width` when it is given.
    # Returns the width drawn, for a link's underline.
    def words(list: mutable Display::DisplayList&, at: BrowserGame::Frame, text: sview, x: f64, y: f64, size: f64,
            colour: u32, bold: bool, anchor: u32, width: f64) -> f64:
        can Memory.Allocate, Abort.Panic:
            scaled: mutable f64 = size * at.scale
            drawn: mutable f64 = TextMetrics::text_width(scaled, sview_len(text).i64()).f64()
            room: f64 = width * at.scale
            if width > 0.0 and drawn > room:
                # pyglet's content_width follows the new font size.
                scaled <- scaled * room / drawn
                drawn <- TextMetrics::text_width(scaled, sview_len(text).i64()).f64()
            Display::draw_text_weight(list, text, at.left + x * at.scale, at.top - y * at.scale, scaled,
                colour, anchor, bold)
            return drawn

    def said(text: cstr) -> dstr:
        can Memory.Allocate, Abort.Panic:
            out: mutable dstr = []
            dstr_append_cstr(&out, text)
            return out

    def element(list: mutable Display::DisplayList&, at: BrowserGame::Frame, session: BrowserSession::Session&,
            item: BrowserPages::Element&):
        can Memory.Allocate, Abort.Panic:
            place: BrowserSession::Rectangle = BrowserSession::on_screen(session, item)
            text: mutable dstr = []
            BrowserText::words(&text, &session.deal, item.words)
            middle: f64 = place.y + place.height / 2.0
            style: i64 = item.style
            left: u32 = Display::ANCHOR_LEFT_CENTER
            if style == BrowserPages::TITLE:
                _ = words(list, at, bytes_view(text), place.x, middle, 22.0, INK, true, left, place.width)
            elif style == BrowserPages::LINK:
                drawn: f64 = words(list, at, bytes_view(text), place.x, middle, 15.0, LINK, false, left, place.width)
                line_x: f64 = at.left + place.x * at.scale
                line_y: f64 = at.top - (middle + 10.0) * at.scale
                Display::draw_line(list, line_x, line_y, line_x + drawn, line_y, 1.0, LINK)
            elif style == BrowserPages::BUTTON:
                rect(list, at, place.x, place.y, place.width, place.height, BUTTON, EDGE)
                _ = words(list, at, bytes_view(text), place.x + place.width / 2.0, middle, 15.0, INK, true,
                    Display::ANCHOR_CENTER_CENTER, place.width - 10.0)
            elif style == BrowserPages::BANNER:
                rect(list, at, place.x, place.y, place.width, place.height, BANNER, EDGE)
                _ = words(list, at, bytes_view(text), place.x + 20.0, middle, 16.0, LINK, true, left, place.width - 40.0)
            elif style == BrowserPages::MUTED:
                _ = words(list, at, bytes_view(text), place.x, middle, 14.0, MUTED, false, left, place.width)
            elif style == BrowserPages::GOOD or style == BrowserPages::BAD:
                _ = words(list, at, bytes_view(text), place.x, middle, 15.0, GOOD if style == BrowserPages::GOOD else BAD, true,
                    left, place.width)
            else:
                _ = words(list, at, bytes_view(text), place.x, middle, 15.0, INK, false, left, place.width)

    def scrollbar(list: mutable Display::DisplayList&, at: BrowserGame::Frame, session: BrowserSession::Session&,
            most: f64):
        can Memory.Allocate, Abort.Panic:
            return if most <= 0.0
            total: f64 = session.view_h + most
            bar: f64 = session.view_h * session.view_h / total
            top: f64 = session.view_top + session.scroll / total * session.view_h
            rect(list, at, 988.0, session.view_top, 10.0, session.view_h, TABS, NO_FILL)
            rect(list, at, 989.0, top, 8.0, bar, MUTED, NO_FILL)

    def pointer(list: mutable Display::DisplayList&, at: BrowserGame::Frame, session: BrowserSession::Session&):
        can Memory.Allocate, Abort.Panic:
            pointer_at(list, at, session.pointer)

    # _pointer: the drawn arrow, its tip at a page point.
    def pointer_at(list: mutable Display::DisplayList&, at: BrowserGame::Frame, spot: BrowserSession::Pointer):
        can Memory.Allocate, Abort.Panic:
            size: f64 = fmax(10.0, 22.0 * at.scale)
            x: f64 = at.left + spot.x * at.scale
            y: f64 = at.top - spot.y * at.scale
            Display::draw_triangle(list, x - 2.0, y + 3.0, x - 2.0, y - size - 3.0, x + size * 0.75, y - size * 0.7, INK)
            Display::draw_triangle(list, x, y, x, y - size, x + size * 0.65, y - size * 0.65, PAGE)

    # _draw_shop: the browser window, from the session's offset down.
    def shop(list: mutable Display::DisplayList&, at: BrowserGame::Frame, session: BrowserSession::Session&):
        can Memory.Allocate, Abort.Panic:
            shown: BrowserPages::Layout = BrowserSession::elements(session)
            shop_with(list, at, session, &shown)
            pointer(list, at, session)

    # shop_with: the window around a page whose elements are `shown`,
    # without the pointer.
    def shop_with(list: mutable Display::DisplayList&, at: BrowserGame::Frame, session: BrowserSession::Session&,
            shown: BrowserPages::Layout&):
        can Memory.Allocate, Abort.Panic:
            o: f64 = session.offset
            rect(list, at, 0.0, o, Browser::SCREEN_W, Browser::SCREEN_H - o, PAGE, EDGE)
            rect(list, at, 0.0, o, Browser::SCREEN_W, 32.0, TABS, NO_FILL)
            rect(list, at, 10.0, o + 4.0, 300.0, 28.0, TAB, EDGE)
            title: mutable dstr = []
            BrowserText::page_title(&title, &session.deal, &session.page)
            _ = words(list, at, bytes_view(title), 22.0, o + 18.0, 12.0, INK, false, Display::ANCHOR_LEFT_CENTER, 280.0)
            rect(list, at, 0.0, o + 32.0, Browser::SCREEN_W, Browser::VIEW_TOP - 32.0, TOOLBAR, NO_FILL)
            for which in 0..<3 |list, at, session|:
                place: BrowserSession::Rectangle = BrowserSession::chrome_rectangle(session, which)
                rect(list, at, place.x, place.y, place.width, place.height, BUTTON, EDGE)
                label: mutable dstr = []
                if which == 0:
                    dstr_append_cstr(&label, "Back")
                elif which == 1:
                    dstr_append_cstr(&label, "Home")
                else:
                    dstr_append_cstr(&label, "Cart (")
                    dstr_append_i64(&label, session.cart.count)
                    dstr_append_cstr(&label, ")")
                _ = words(list, at, bytes_view(label), place.x + place.width / 2.0, place.y + place.height / 2.0, 12.0, INK, true,
                    Display::ANCHOR_CENTER_CENTER, 0.0)
            rect(list, at, 170.0, o + 38.0, 700.0, 30.0, PAGE, EDGE)
            where: mutable dstr = []
            BrowserText::address(&where, &session.deal, &session.page)
            _ = words(list, at, bytes_view(where), 180.0, o + 53.0, 12.0, MUTED, false, Display::ANCHOR_LEFT_CENTER, 680.0)
            for index in 0..<shown.count |list, at, session, shown|:
                item: BrowserPages::Element = shown.elements[index.usize()]
                element(list, at, session, &item) if BrowserSession::visible(session, &item)
            scrollbar(list, at, session, BrowserSession::max_scroll_of(session, shown))

    def verdict_words(game: BrowserGame::Session&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            clicks: i64 = game.browser.clicks
            if game.verdict == BrowserGame::BOUGHT:
                dstr_append_cstr(out, "Bought the right things in ")
                dstr_append_i64(out, clicks)
                dstr_append_cstr(out, " clicks (par ")
                dstr_append_i64(out, game.par)
                dstr_append_cstr(out, ")")
            elif game.verdict == BrowserGame::OVER_PAR:
                dstr_append_cstr(out, "The right things, but ")
                dstr_append_i64(out, clicks)
                dstr_append_cstr(out, " clicks against a par of ")
                dstr_append_i64(out, game.par)
            else:
                dstr_append_cstr(out, "Not what the list asked for (")
                dstr_append_i64(out, clicks)
                dstr_append_cstr(out, " clicks, par ")
                dstr_append_i64(out, game.par)
                dstr_append_cstr(out, ")")

    # The status line: what RungTask's message says in each phase.
    def message(game: BrowserGame::Session&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if game.phase == BrowserGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif game.phase == BrowserGame::DONE:
                dstr_append_i64(out, game.wins)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, game.trial)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, game.best_rung)
            elif game.phase == BrowserGame::JUDGED:
                verdict_words(game, out)
            else:
                BrowserText::goal_words(out, &game.browser.deal)

    def facts(game: BrowserGame::Session&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_cstr(out, "rung ")
            dstr_append_i64(out, game.rung)
            dstr_append_cstr(out, "  ")
            dstr_append_i64(out, game.trial)
            dstr_append_cstr(out, "/")
            dstr_append_i64(out, game.total)
            dstr_append_cstr(out, "   clicks ")
            dstr_append_i64(out, game.browser.clicks)
            dstr_append_cstr(out, "   par ")
            dstr_append_i64(out, game.par)

    # _fit: a one-line label shrunk until it fits 96% of the window.
    def line(list: mutable Display::DisplayList&, text: sview, y: f64, size: f64, ink: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            room: f64 = BrowserGame::WIDTH * 0.96
            wide: f64 = TextMetrics::text_width(size, sview_len(text).i64()).f64()
            fitted: f64 = fmax(6.0, size * room / wide) if wide > room else size
            Display::draw_text_weight(list, text, CX, y, fitted, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Browser::Grade = Browser::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.departments)
            dstr_append_cstr(out, " departments of ")
            dstr_append_i64(out, level.products)
            dstr_append_cstr(out, " products; ")
            dstr_append_i64(out, level.buys)
            dstr_append_cstr(out, " to buy.")
            found: mutable i64 = 0
            for feature in 0..<5 |out, level, found|:
                present: bool = level.sorting if feature == 0 else (level.stock if feature == 1 else (level.shipping if feature == 2 else (level.paged if feature == 3 else level.stale)))
                if present:
                    dstr_append_cstr(out, "  With " if found == 0 else ", ")
                    if feature == 0:
                        dstr_append_cstr(out, "sortable lists")
                    elif feature == 1:
                        dstr_append_cstr(out, "stock shown only on product pages")
                    elif feature == 2:
                        dstr_append_cstr(out, "shipping costs")
                    elif feature == 3:
                        dstr_append_cstr(out, "lists over several pages")
                    else:
                        dstr_append_cstr(out, "list prices that may be out of date")
                    found <- found + 1
            dstr_append_cstr(out, ".") if found > 0
            dstr_append_cstr(out, "  Par allows ")
            dstr_append_i64(out, py_round_half_even(level.slack * 100.0))
            dstr_append_cstr(out, "% of a thorough shopper's extra clicks.")

    def render(list: mutable Display::DisplayList&, game: BrowserGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            title: dstr = said("Browser")
            line(list, bytes_view(title), 648.0, 22.0, ink, true)
            status: mutable dstr = []
            message(game, &status)
            line(list, bytes_view(status), 614.0, 14.0, ink, false)
            footnote: dstr = said("click links and buttons   wheel or Up/Down: scroll   Backspace: back   Esc: menu")
            line(list, bytes_view(footnote), 26.0, 12.0, ink, false)
            return if game.phase != BrowserGame::PLAYING and game.phase != BrowserGame::JUDGED
            known: mutable dstr = []
            facts(game, &known)
            line(list, bytes_view(known), 588.0, 12.0, ink, false)
            shop(list, BrowserGame::frame(), &game.browser)
            if game.phase == BrowserGame::JUDGED:
                SceneVerdict::put(list, BrowserGame::WIDTH, BrowserGame::HEIGHT, 1.0, 1.0, game.verdict == BrowserGame::BOUGHT,
                    bytes_view(status), 60.0, 16.0)
