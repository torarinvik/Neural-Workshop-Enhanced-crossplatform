include "./tasks/kitchen_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./verdict.elisa"
include "./geometry.elisa"

module SceneKitchen:
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const PI: f64 = 3.141592653589793
    const COUNTER: u32 = 0x966842ff
    const COUNTER_TOP: u32 = 0xba8a5cff
    const STEEL: u32 = 0xb0b8c4ff
    const WHITE: u32 = 0xffffffff


    struct Frame:
        x: f64
        y: f64
        scale: f64
        top: f64

    def frame() -> Frame:
        can Abort.Panic:
            bottom: f64 = Verdict::above_the_band(HEIGHT, Geometry::from_bottom_edge(HEIGHT, 58.0).f64()).f64()
            top: f64 = Geometry::from_top_edge(HEIGHT, 116.0).f64()
            height: f64 = fmax(40.0, top - bottom)
            scale: f64 = fmin(WIDTH * 0.94 / Kitchen::WIDTH, (height - height * 0.2) / Kitchen::HEIGHT)
            return Frame{x: (WIDTH - Kitchen::WIDTH * scale) / 2.0, y: bottom, scale: scale, top: bottom + height}

    def hit(session: KitchenGame::Session&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return KitchenGame::START if session.phase == KitchenGame::READY or session.phase == KitchenGame::DONE
            return Kitchen::NO_PORT if session.phase != KitchenGame::PLAYING
            area: Frame = frame()
            port: mutable i64 = Kitchen::NO_PORT
            best: mutable f64 = area.scale * area.scale
            for i in 0..<Kitchen::PORTS |session, area, port, best, x, y|:
                station: Kitchen::Station = session.run.shift.stations[i.usize()]
                if station.present:
                    dx: f64 = area.x + station.x * area.scale - x
                    dy: f64 = area.y + station.y * area.scale - y
                    distance: f64 = dx * dx + dy * dy
                    if distance < best:
                        best <- distance
                        port <- i
            return port

    def round_box(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, r: f64, ink: u32):
        can Abort.Panic, Memory.Allocate:
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: x, y: y, w: w, h: h}
            ScenePolish::rounded(list, &box, r, ink)

    def oval(list: mutable Display::DisplayList&, x: f64, y: f64, rx: f64, ry: f64, ink: u32, half: bool = false):
        can Abort.Panic, Memory.Allocate:
            count: i64 = 17 if half else 20
            denom: f64 = 16.0 if half else 10.0
            Display::begin_polygon(list, count, x + rx, y, ink)
            for i in 0..<count |list, x, y, rx, ry, denom|:
                a: f64 = PI * i.f64() / denom
                Display::polygon_point(list, x + cos(a) * rx, y + sin(a) * ry)

    def food(list: mutable Display::DisplayList&, x: f64, y: f64, r: f64, kind: i64, stage: i64):
        can Abort.Panic, Memory.Allocate:
            colours: u32[4] = [0xe64034ff, 0x9c5cc4ff, 0xc6a076ff, 0x5a9ce2ff]
            base: u32 = colours[kind.usize()]
            if stage != Kitchen::RAW:
                ink: u32 = 0x282220ff if stage == Kitchen::BURNT else ScenePolish::mix_rgb(base, 0x78461eff, 0.35) if stage == Kitchen::COOKED else base
                Display::draw_circle(list, x - 0.4 * r, y - 0.2 * r, r * 0.45, ink)
                Display::draw_circle(list, x + 0.4 * r, y - 0.25 * r, r * 0.45, ScenePolish::mix_rgb(ink, WHITE, 0.08))
                Display::draw_circle(list, x, y + 0.35 * r, r * 0.45, ScenePolish::mix_rgb(ink, WHITE, 0.16))
            elif kind == 0:
                Display::draw_circle(list, x, y, r, base)
                Display::draw_circle(list, x - 0.3 * r, y + 0.3 * r, r * 0.22, ScenePolish::mix_rgb(base, WHITE, 0.4))
                Display::draw_triangle(list, x - 0.3 * r, y + 0.9 * r, x + 0.3 * r, y + 0.9 * r, x, y + 1.3 * r, 0x46a046ff)
            elif kind == 1:
                Display::draw_circle(list, x, y - 0.1 * r, r * 0.9, base)
                Display::draw_triangle(list, x - 0.45 * r, y + 0.5 * r, x + 0.45 * r, y + 0.5 * r, x, y + 1.3 * r, base)
            elif kind == 2:
                Display::draw_rect(list, x - r * 0.25, y - r, r * 0.5, r, 0xf0e4ceff)
                oval(list, x, y - r * 0.1, r, r, base, true)
            else:
                oval(list, x, y, r * 1.1, r * 0.6, base)
                Display::draw_triangle(list, x + r * 0.9, y, x + r * 1.5, y + r * 0.5, x + r * 1.5, y - r * 0.5, base)
                Display::draw_circle(list, x - r * 0.6, y + r * 0.1, r * 0.12, 0x14141eff)

    def food_part(list: mutable Display::DisplayList&, x: f64, y: f64, r: f64, part: i64):
        can Abort.Panic, Memory.Allocate:
            food(list, x, y, r, Kitchen::part_food(part), Kitchen::part_stage(part))

    def dish(list: mutable Display::DisplayList&, x: f64, y: f64, r: f64, offset: f64, plate: Kitchen::Dish&):
        can Abort.Panic, Memory.Allocate:
            for k in 0..<plate.count |list, x, y, r, offset, plate|:
                a: f64 = (90 + k * 120).f64() * PI / 180.0
                food_part(list, x + cos(a) * offset, y + sin(a) * offset, r, plate.parts[k.usize()])

    def scenery(list: mutable Display::DisplayList&, area: Frame, shift: Kitchen::Shift&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.scale
            w: f64 = Kitchen::WIDTH * s
            h: f64 = Kitchen::HEIGHT * s
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: area.x - 6.0, y: area.y - 6.0, w: w + 12.0, h: h + 12.0}
            ScenePolish::shadow(list, &box, 12.0, 4.0, dark)
            ScenePolish::rounded(list, &box, 12.0, COUNTER)
            tile: f64 = 0.75 * s
            for c in 0..<16 |list, area, tile, h|:
                for row in 0..<10 |list, area, tile, h, c|:
                    py: f64 = row.f64() * tile
                    Display::draw_rect(list, area.x + c.f64() * tile, area.y + py, tile, fmin(tile, h - py),
                        0xf4e8d2ff if (row + c) % 2 == 1 else 0xe2ceb2ff)
            for i in 0..<Kitchen::PORTS |list, area, shift, s|:
                st: Kitchen::Station = shift.stations[i.usize()]
                if st.present:
                    x: f64 = area.x + st.x * s
                    y: f64 = area.y + st.y * s
                    round_box(list, x - s * 0.62, y - s * 0.62, s * 1.24, s * 1.24, s * 0.12, COUNTER)
                    hot: bool = (i >= Kitchen::STOVE and i < Kitchen::PLATE) or i == Kitchen::PASS
                    round_box(list, x - s * 0.56, y - s * 0.52, s * 1.12, s * 1.1, s * 0.1, 0x464850ff if hot else COUNTER_TOP)

    def board(list: mutable Display::DisplayList&, x: f64, y: f64, s: f64, run: Kitchen::Run&, index: i64):
        can Abort.Panic, Memory.Allocate:
            round_box(list, x - s * 0.42, y - s * 0.3, s * 0.84, s * 0.6, s * 0.08, 0xdeb478ff)
            item: Kitchen::WorkItem = run.boards[index.usize()]
            return if item.part == 0
            done: bool = item.time >= Kitchen::CHOP
            food(list, x, y, s * 0.2, Kitchen::part_food(item.part), Kitchen::CHOPPED if done else Kitchen::RAW)
            share: f64 = fmin(1.0, item.time / Kitchen::CHOP)
            ScenePolish::arc(list, x, y, s * 0.5, PI / 2.0, 2.0 * PI * share, fmax(3.0, s * 0.07), 0x78e68cff if done else 0x5ac8ffff)
            if run.chopping == index:
                a: f64 = sin(run.t * 18.0) * 0.5
                Display::draw_line(list, x + s * 0.1, y + s * 0.3, x + s * (0.1 + 0.4 * cos(a)),
                    y + s * (0.3 + 0.2 * sin(a)), fmax(3.0, s * 0.07), 0xc8ced8ff)

    def stove(list: mutable Display::DisplayList&, x: f64, y: f64, s: f64, run: Kitchen::Run&, index: i64):
        can Abort.Panic, Memory.Allocate:
            pan: Kitchen::WorkItem = run.stoves[index.usize()]
            lit: bool = pan.part != 0
            if lit:
                ScenePolish::glow(list, x, y, s * 0.65, 0xff7828ff, 80)
            ScenePolish::ring(list, x, y, s * 0.4, fmax(2.0, s * 0.06), 0xff6e28ff if lit else 0x3c3c42ff, 32)
            Display::draw_circle(list, x, y, s * 0.32, 0x2e2e34ff)
            Display::draw_line(list, x + s * 0.3, y, x + s * 0.6, y - s * 0.08, fmax(3.0, s * 0.08), 0x2e2e34ff)
            return if not lit
            stage: i64 = Kitchen::pan_stage(run, pan, run.t)
            food(list, x, y, s * 0.18, Kitchen::part_food(pan.part), stage)
            age: f64 = run.t - pan.time
            share: mutable f64 = 1.0
            ink: mutable u32 = 0x3c3232ff
            if stage == Kitchen::CHOPPED:
                share <- age / Kitchen::COOK
                ink <- 0x6edc78ff
            elif stage == Kitchen::COOKED:
                hold: f64 = run.shift.level.hold
                share <- (Kitchen::COOK + hold - age) / hold
                pulse: f64 = 0.5 + 0.5 * sin(run.t * (8.0 + 12.0 * (1.0 - share)))
                ink <- ScenePolish::mix_rgb(ScenePolish::mix_rgb(0xffd23cff, 0xff3c32ff, 1.0 - share), WHITE, 0.3 * pulse)
            ScenePolish::arc(list, x, y, s * 0.52, PI / 2.0, 2.0 * PI * fmax(0.0, fmin(1.0, share)), fmax(3.0, s * 0.08), ink)
            for k in 0..<3 |list, x, y, s, run, stage|:
                phase: f64 = run.t * 0.7 + k.f64() / 3.0
                ph: f64 = phase - floor(phase)
                alpha: u32 = (150.0 * (1.0 - ph)).u32()
                rgb: u32 = 0x3c383800 if stage == Kitchen::BURNT else 0xfafafa00
                Display::draw_circle(list, x + sin(run.t * 2.0 + k.f64() * 2.0) * s * 0.12,
                    y + s * (0.3 + 0.7 * ph), s * (0.08 + 0.12 * ph), rgb | alpha)

    def station(list: mutable Display::DisplayList&, area: Frame, run: Kitchen::Run&, port: i64):
        can Abort.Panic, Memory.Allocate:
            at: Kitchen::Station = run.shift.stations[port.usize()]
            return if not at.present
            s: f64 = area.scale
            x: f64 = area.x + at.x * s
            y: f64 = area.y + at.y * s
            if port < Kitchen::BOARD:
                Display::draw_rect(list, x - s * 0.45, y - s * 0.4, s * 0.9, s * 0.62, 0xa87846ff)
                offsets: f64[3] = [-0.22, 0.22, 0.0]
                for k in 0..<3 |list, x, y, s|:
                    yy: f64 = y - s * 0.4 + k.f64() * s * 0.2
                    Display::draw_line(list, x - s * 0.45, yy, x + s * 0.45, yy, 2.0, 0x825832ff)
                for k in 0..<3 |list, x, y, s, offsets, at|:
                    food(list, x + offsets[k.usize()] * s, y + s * (0.36 if k == 2 else 0.24), s * 0.18, at.food, Kitchen::RAW)
            elif port < Kitchen::STOVE:
                board(list, x, y, s, run, port - Kitchen::BOARD)
            elif port < Kitchen::PLATE:
                stove(list, x, y, s, run, port - Kitchen::STOVE)
            elif port < Kitchen::PASS:
                Display::draw_circle(list, x, y, s * 0.42, 0xfafafcff)
                ScenePolish::ring(list, x, y, s * 0.32, 2.0, 0xd6dce8ff, 32)
                plate: Kitchen::Dish = run.plates[(port - Kitchen::PLATE).usize()]
                dish(list, x, y, s * 0.13, s * 0.17 if plate.count > 1 else 0.0, &plate)
            elif port == Kitchen::PASS:
                round_box(list, x - s * 0.45, y - s * 0.35, s * 0.9, s * 0.7, s * 0.08, STEEL)
                oval(list, x, y - s * 0.05, s * 0.22, s * 0.22, 0xfac83cff, true)
                Display::draw_circle(list, x, y + s * 0.2, s * 0.05, 0xfac83cff)
            else:
                round_box(list, x - s * 0.28, y - s * 0.35, s * 0.56, s * 0.62, s * 0.06, 0x6e7682ff)
                Display::draw_rect(list, x - s * 0.34, y + s * 0.24, s * 0.68, s * 0.1, 0x505662ff)
            kx: f64 = x - s * 0.5
            ky: f64 = y + s * 0.46
            round_box(list, kx - s * 0.16, ky - s * 0.16, s * 0.32, s * 0.32, s * 0.06, 0x28242cff)
            keys: u8[13] = [49, 50, 51, 52, 81, 87, 69, 82, 84, 65, 83, 68, 70]
            key: mutable dstr = []
            key.push(keys[port.usize()])
            Display::draw_text_weight(list, bytes_view(key), kx, ky, fmax(7.0, s * 0.2), WHITE, Display::ANCHOR_CENTER_CENTER, true)

    def cook(list: mutable Display::DisplayList&, area: Frame, run: Kitchen::Run&):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.scale
            x: f64 = area.x + run.x * s
            y: f64 = area.y + run.y * s
            walking: bool = run.target != Kitchen::NO_PORT
            if walking:
                target: Kitchen::Station = run.shift.stations[run.target.usize()]
                tx: f64 = area.x + target.x * s
                ty: f64 = area.y + target.y * s
                Display::draw_line(list, x, y, tx, ty, 2.0, 0x5a8ce678)
                ScenePolish::ring(list, tx, ty, s * 0.66, 2.0, 0x5a8ce6ff, 32)
            bob: f64 = sin(run.t * 14.0) * s * 0.03 if walking else 0.0
            oval(list, x, y - s * 0.3, s * 0.3, s * 0.1, 0x3c281e50)
            Display::draw_circle(list, x, y + bob, s * 0.3, 0xfcfcffff)
            ScenePolish::ring(list, x, y + bob, s * 0.3, 2.0, 0xaab0beff, 32)
            Display::draw_circle(list, x, y + s * 0.18 + bob, s * 0.16, 0xf2c8a0ff)
            round_box(list, x - s * 0.14, y + s * 0.3 + bob, s * 0.28, s * 0.26, s * 0.08, WHITE)
            hx: f64 = x + s * 0.38
            hy: f64 = y + s * 0.05 + bob
            if run.held_dish.count > 0:
                Display::draw_circle(list, hx, hy, s * 0.24, 0xfafafcff)
                dish(list, hx, hy, s * 0.08, s * 0.1, &run.held_dish)
            elif run.held_part > 0:
                food_part(list, hx, hy, s * 0.14, run.held_part)

    def note_text(words: i64) -> sview:
        return "served!" if words == Kitchen::NOTE_SERVED else "no such ticket" if words == Kitchen::NOTE_NO_TICKET else "binned"

    def flashes(list: mutable Display::DisplayList&, area: Frame, run: Kitchen::Run&):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.scale
            first: i64 = run.flash_count - 6 if run.flash_count > 6 else 0
            for i in first..<run.flash_count |list, area, run, s|:
                note: Kitchen::Flash = run.flashes[(i % 6).usize()]
                age: f64 = run.t - note.time
                if age <= 1.5:
                    at: Kitchen::Station = run.shift.stations[note.port.usize()]
                    alpha: u32 = (255.0 * (1.0 - age / 1.5)).u32()
                    Display::draw_text_weight(list, note_text(note.words), area.x + (at.x - 0.4) * s,
                        area.y + (at.y + 0.8 + age * 0.6) * s, fmax(9.0, s * 0.26), 0x288c4600 | alpha,
                        Display::ANCHOR_RIGHT_CENTER, true)

    def stage_mark(list: mutable Display::DisplayList&, x: f64, y: f64, r: f64, stage: i64):
        can Abort.Panic, Memory.Allocate:
            if stage == Kitchen::CHOPPED:
                Display::draw_line(list, x - r, y - r, x + r, y + r, fmax(2.0, r * 0.3), 0x96a0afff)
                Display::draw_line(list, x - r, y - r, x - r * 0.4, y - r * 0.4, fmax(2.5, r * 0.45), 0x6e4628ff)
            else:
                Display::draw_triangle(list, x - r * 0.7, y - r * 0.8, x + r * 0.7, y - r * 0.8, x, y + r, 0xff7828ff)
                Display::draw_triangle(list, x - r * 0.35, y - r * 0.8, x + r * 0.35, y - r * 0.8, x, y + r * 0.3, 0xffdc5aff)

    def ticket_card(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&, scale: f64,
                    ticket: Kitchen::Ticket&, share: f64, time: f64):
        can Abort.Panic, Memory.Allocate:
            paper: u32 = 0xfffaecff
            ink: u32 = ScenePolish::mix_rgb(paper, 0xffa096ff, 0.5 + 0.5 * sin(time * 8.0)) if share < 0.3 else paper
            card: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: box.x, y: box.y, w: box.w, h: box.h - scale * 0.1}
            ScenePolish::shadow(list, &card, 6.0, 2.0, false)
            ScenePolish::rounded(list, &card, 6.0, ink)
            n: f64 = ticket.dish.count.f64()
            fy: f64 = box.y + box.h * 0.55
            for q in 0..<ticket.dish.count |list, box, scale, ticket, n, fy|:
                fx: f64 = box.x + box.w * (q.f64() + 0.5) / n
                part: i64 = ticket.dish.parts[q.usize()]
                food(list, fx, fy, fmin(scale * 0.2, box.w / (n * 3.2)), Kitchen::part_food(part), Kitchen::RAW)
                stage_mark(list, fx + box.w / (n * 4.0), fy - box.h * 0.18, scale * 0.1, Kitchen::part_stage(part))
            Display::draw_rect(list, box.x + box.w * 0.08, box.y + box.h * 0.08, box.w * 0.84 * share, box.h * 0.1,
                ScenePolish::mix_rgb(0xe6463cff, 0x46be6eff, fmin(1.0, share * 1.5)))

    def rail(list: mutable Display::DisplayList&, area: Frame, run: Kitchen::Run&):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.scale
            w: f64 = Kitchen::WIDTH * s
            y: f64 = area.y + Kitchen::HEIGHT * s + s * 0.3
            h: f64 = fmin(s * 1.7, area.top - y - 4.0)
            cw: f64 = fmin(s * 2.4, w / 6.3)
            Display::draw_rect(list, area.x, y + h - s * 0.08, w, s * 0.08, STEEL)
            index: mutable i64 = 0
            for i in 0..<run.arrived |list, area, run, s, w, y, h, cw, index|:
                status: i64 = get run.status[i.usize()] else Kitchen::WAITING
                if status == Kitchen::OPEN:
                    x: f64 = area.x + index.f64() * (cw + s * 0.15)
                    break if x + cw > area.x + w
                    ticket: Kitchen::Ticket = get run.shift.tickets[i.usize()] else zeroed
                    box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: x, y: y, w: cw, h: h}
                    ticket_card(list, &box, s, &ticket, fmax(0.0, Kitchen::ticket_left(run, i) / ticket.patience), run.t)
                    index <- index + 1
            waiting: mutable dstr = []
            dstr_append_i64(&waiting, run.shift.level.tickets - run.arrived)
            dstr_append_cstr(&waiting, " to come")
            Display::draw_text_weight(list, bytes_view(waiting), area.x + w, y + h * 0.45,
                fmax(9.0, s * 0.26), 0x786e64ff, Display::ANCHOR_RIGHT_CENTER, true)

    def verdict(run: Kitchen::Run&, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            if run.result == Kitchen::CLEAR:
                dstr_append_cstr(out, "Shift done: ")
                dstr_append_i64(out, run.served)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, run.shift.level.tickets)
                dstr_append_cstr(out, " served")
            elif run.result == Kitchen::EXPIRED:
                dstr_append_cstr(out, "A ticket ran out of patience")

    def kitchen_text(list: mutable Display::DisplayList&, words: sview, y: f64, size: f64, ink: u32, bold: bool = false):
        can Abort.Panic, Memory.Allocate:
            Display::draw_text_weight(list, words, WIDTH / 2.0, y, size, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def render(list: mutable Display::DisplayList&, session: KitchenGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = WHITE if dark else 0x000000ff
            kitchen_text(list, "Kitchen", 648.0, 22.0, ink, true)
            kitchen_text(list, "crates 1-4  boards Q W  stoves E R T  plates A S  pass D  bin F  (or click)   Esc: menu", 26.0, 12.0, ink)
            caption: mutable dstr = []
            if session.verdict != Kitchen::LIVE:
                verdict(&session.run, &caption)
            status: mutable dstr = []
            if session.phase == KitchenGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == KitchenGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == KitchenGame::JUDGED:
                status <- caption
            else:
                dstr_append_cstr(&status, "Cook and plate every ticket before it lapses")
            kitchen_text(list, bytes_view(status), 614.0, 14.0, ink)
            if session.phase == KitchenGame::PLAYING or session.phase == KitchenGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   served ")
                dstr_append_i64(&facts, session.run.served)
                dstr_append_cstr(&facts, " of ")
                dstr_append_i64(&facts, session.run.shift.level.tickets)
                dstr_append_cstr(&facts, "   lapsed ")
                dstr_append_i64(&facts, session.run.lapsed)
                kitchen_text(list, bytes_view(facts), 588.0, 12.0, ink)
                area: Frame = frame()
                scenery(list, area, &session.run.shift, dark)
                for p in 0..<Kitchen::PORTS |list, area, session|:
                    station(list, area, &session.run, p)
                cook(list, area, &session.run)
                flashes(list, area, &session.run)
                rail(list, area, &session.run)
            if caption.count > 0:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, KitchenGame::passed_verdict(session.verdict),
                    bytes_view(caption), 60.0, 16.0)

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: Kitchen::Grade = Kitchen::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.tickets)
            dstr_append_cstr(out, " tickets of up to ")
            dstr_append_i64(out, level.parts)
            dstr_append_cstr(out, " part(s), ")
            dstr_append_i64(out, level.stoves)
            dstr_append_cstr(out, " stove(s).  A done pan burns after ")
            dstr_append_fixed(out, py_round_decimal(level.hold, 10.0), 1)
            dstr_append_cstr(out, " s.")
            dstr_append_cstr(out, "  One ticket may lapse.") if level.lapse > 0
