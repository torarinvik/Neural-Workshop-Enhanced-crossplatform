# The seam between what a menu row SAYS and where it SITS.
#
# menu_model.elisa formats rows and knows nothing about the display list;
# scene_menu.elisa lays rows out and knows nothing about values. This joins
# them, and is kept in its own file so neither side gains the other's
# dependencies -- the row formatter stays usable without a display list, and the
# layout stays usable with rows a caller formatted some other way.
#
# Include display.elisa, scene_menu.elisa and menu_model.elisa first.

# Format a screen's rows and hand them to the layout.
#
# The formatted strings must outlive the call, so they are kept in `held` for
# its duration: `options` are VIEWS into them, and a dstr that went out of
# scope would leave the display list pointing at freed bytes. Both live in the
# caller's region, so this is a lifetime the region already governs.
#
# Requires scene_menu.elisa to be included first -- this is the seam between
# what a row SAYS (here) and where it SITS (there).
def render_menu_screen(list: mutable DisplayList&, title: sview, footnote: sview, rows: darray[MenuText::Row]&, selpos: i64, black_background: bool):
    can Memory.Allocate, Abort.Panic:
        held: mutable darray[dstr] = []
        for row in rows |held|:
            held.push(MenuText::row_text(row.name, row.kind, row.number, row.text))
        options: mutable darray[sview] = []
        index: mutable i64 = 0
        while index < held.count.i64() |index, options, held|:
            options.push(bytes_view(get held[index.usize()] else []))
            index <- index + 1
        render_menu_frame(list, title, footnote, &options, selpos, black_background)
