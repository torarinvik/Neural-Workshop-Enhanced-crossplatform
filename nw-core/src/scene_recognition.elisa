# The Seen it before? screen: game state in, display list out.
#
# Port of neural_workshop/ui/recognition.py -- the drawing, not the thinking.
#
# Three labels, a verdict, a stage and two buttons. What goes on the stage
# depends on the MEDIUM:
#
#   pictures  the item itself, a sprite scaled by `side / image.width`
#   sounds    a tinted plate with a crotchet on it -- there is nothing to
#             look at, so the screen says so rather than going blank
#
# and the two are not symmetric: a sound's plate stays up through the HIDDEN
# phase, because the sound is still playing, while a picture is taken down.
#
# The plate and the buttons carry the only colours in the workshop that are
# not from the Okabe-Ito set and not derived from the background: they are
# fixed pairs, one for each page colour, and they are what the reference draws.
#
# The crotchet's size is `max(12, calc_fontsize(side * 0.30))` -- a font size
# taken from the STAGE and then scaled again by the window, which double-counts
# the window and is reproduced rather than corrected.
#
# NOTE: needs elisacore_math, strings, geometry, display and scene_verdict
# included by the driver.

module SceneRecognition:

    const PHASE_READY: i64 = 0
    const PHASE_SHOWING: i64 = 1
    const PHASE_HIDDEN: i64 = 2
    const PHASE_DONE: i64 = 3

    const MEDIUM_PICTURE: i64 = 0
    const MEDIUM_SOUND: i64 = 1

    struct RecognitionPaint:
        ink: mutable u32
        plate: mutable u32
        button: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> RecognitionPaint:
        back: i64 = 0 if black_background else 255
        fore: i64 = 255 - back
        plate: u32 = Display::rgba(40, 46, 60, 255) if black_background else Display::rgba(226, 231, 240, 255)
        button: u32 = Display::rgba(58, 74, 110, 255) if black_background else Display::rgba(222, 228, 240, 255)
        return RecognitionPaint{ink: Display::rgba(fore, fore, fore, 255),
                     plate: plate, button: button,
                     width: width, height: height, sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: RecognitionPaint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    def put_rect(list: mutable Display::DisplayList&, paint: RecognitionPaint&,
                 x: f64, y: f64, width: f64, height: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, x / paint.sx, y / paint.sy,
                               width / paint.sx, height / paint.sy, color)

    # Centre and side of the square the item is presented in.
    def stage_side(width: f64, height: f64) -> f64:
        across: f64 = width * 0.5
        down: f64 = height * 0.5
        return across if across < down else down

    def stage_y(height: f64) -> f64:
        can Abort.Panic:
            return Geometry::height_center(height).f64() + height * 0.04

    struct RecognitionButtons:
        left: mutable f64
        bottom: mutable f64
        width: mutable f64
        height: mutable f64
        gap: mutable f64

    def buttons_of(out: mutable RecognitionButtons&, width: f64, height: f64):
        can Abort.Panic:
            share: f64 = width * 0.24
            third: f64 = width / 3.2
            wide: f64 = share if share < third else third
            tall: f64 = height * 0.075
            out.width <- wide
            out.height <- tall if tall > 40.0 else 40.0
            out.gap <- width * 0.04
            out.bottom <- Geometry::from_bottom_edge(height, 90.0).f64()
            out.left <- (width - (wide * 2.0 + out.gap)) / 2.0

    def render(list: mutable Display::DisplayList&, paint: RecognitionPaint&, phase: i64,
               medium: i64, asset: i64, image_width: i64,
               image_height: i64, index: i64, trials: i64, message: sview,
               verdict: i64, verdict_text: sview, fitted_photo: bool):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()
            answering: bool = phase == PHASE_SHOWING or phase == PHASE_HIDDEN
            # `current()` is None once the index runs off the end, which it
            # does on the way out of a run -- so there is a phase where the
            # buttons are up and the stage is empty.
            has_trial: bool = index >= 0 and index < trials

            put_text(list, paint, sview("Seen it before?", 0, -1), middle,
                     Geometry::from_top_edge(paint.height, 36.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            status: mutable dstr = []
            dstr_append_sview(&status, message)
            if trials > 0 and phase != PHASE_DONE:
                # `min(index + 1, len(trials))` -- the counter stops at the
                # last trial rather than running past it on the way out.
                shown: i64 = index + 1 if index + 1 < trials else trials
                dstr_append_cstr(&status, "     ")
                dstr_append_i64(&status, shown)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, trials)
            put_text(list, paint, bytes_view(status), middle,
                     Geometry::from_top_edge(paint.height, 70.0).f64(),
                     Geometry::calc_fontsize(paint.height, 14.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            put_text(list, paint,
                     sview("Esc: task menu     Space: start     ← seen / new →     R: replay     C: options", 0, -1),
                     middle, Geometry::from_bottom_edge(paint.height, 30.0).f64(),
                     Geometry::calc_fontsize(paint.height, 12.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            if verdict >= 0:
                SceneVerdict::put(list, paint.width, paint.height, paint.sx, paint.sy,
                                  verdict == 1, verdict_text, 60.0, 16.0)

            side: f64 = stage_side(paint.width, paint.height)
            centre_y: f64 = stage_y(paint.height)

            if has_trial and answering:
                if medium == MEDIUM_SOUND:
                    put_rect(list, paint, middle - side / 2.0,
                             centre_y - side / 2.0, side, side, paint.plate)
                    glyph: f64 = Geometry::calc_fontsize(paint.height, side * 0.30)
                    put_text(list, paint, sview("♪", 0, -1), middle, centre_y,
                             glyph if glyph > 12.0 else 12.0, paint.ink,
                             Display::ANCHOR_CENTER_CENTER, true)
                elif phase == PHASE_SHOWING and fitted_photo:
                    Display::draw_sprite_fitted(list, asset.u32(), middle / paint.sx,
                        centre_y / paint.sy, side / paint.sx, side / paint.sx, 0.0,
                        Display::rgba(255, 255, 255, 255))
                elif phase == PHASE_SHOWING:
                    Display::draw_sprite(list, asset.u32(),
                                         (middle - side / 2.0) / paint.sx,
                                         (centre_y - side / 2.0) / paint.sy,
                                         side / (image_width if image_width > 1 else 1).f64() / paint.sx,
                                         0.0, image_width, image_height,
                                         Display::rgba(255, 255, 255, 255))

            if not answering:
                return
            where: mutable RecognitionButtons = RecognitionButtons{left: 0.0, bottom: 0.0, width: 0.0, height: 0.0, gap: 0.0}
            buttons_of(&where, paint.width, paint.height)
            # A rectangle and its label, one button at a time -- so the two
            # rectangles are NOT adjacent in the list and a shell cannot
            # batch them.
            put_button(list, paint, &where, where.left, sview("Seen it", 0, -1))
            put_button(list, paint, &where, where.left + where.width + where.gap,
                       sview("New", 0, -1))

    def put_button(list: mutable Display::DisplayList&, paint: RecognitionPaint&,
                   where: RecognitionButtons&, left: f64, text: sview):
        can Memory.Allocate, Abort.Panic:
            put_rect(list, paint, left, where.bottom, where.width,
                     where.height, paint.button)
            put_text(list, paint, text, left + where.width / 2.0,
                     where.bottom + where.height / 2.0,
                     Geometry::calc_fontsize(paint.height, 15.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)
