include "./tasks/shadow_play_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./geometry.elisa"

module SceneShadowPlay:
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const CX: f64 = WIDTH / 2.0
    const WALL_X: f64 = 3.4
    const WALL_TOP: f64 = 2.4
    const FLOOR_NEAR: f64 = 1.8
    const COPPER: u32 = 0xd68046ff
    const GOLD_SOFT: u32 = 0xffce5a3c
    const GOLD_EDGE: u32 = 0xffce5adc
    const SHADOW: u32 = 0x281e2eaf
    const FITTED_SHADOW: u32 = 0x285a32be
    const HOLD_RING: u32 = 0x6ef096ff

    struct Lens:
        camera: RoomsView::Camera
        focal: f64
        center_x: f64
        center_y: f64

    struct Segment:
        a: RoomsView::Vec
        b: RoomsView::Vec
        depth: f64
        lit: f64

    struct PaintedRod:
        pieces: mutable Segment[9]
        count: i64

    def area() -> SceneHiddenRule::Rect:
        return SceneHiddenRule::Rect{x: 27.36, y: 179.0, w: 857.28, h: 389.0}

    def lens(box: SceneHiddenRule::Rect&) -> Lens:
        can Abort.Panic:
            eye: RoomsView::Vec = RoomsView::vec(0.5, 0.7, 5.6)
            aim: RoomsView::Vec = RoomsView::vec(0.0, -0.35, -1.0)
            forward: RoomsView::Vec = RoomsView::unit(RoomsView::sub(aim, eye))
            right: RoomsView::Vec = RoomsView::unit(RoomsView::cross(forward, RoomsView::vec(0.0, 1.0, 0.0)))
            cam: RoomsView::Camera = RoomsView::Camera{eye: eye, forward: forward, right: right,
                up: RoomsView::cross(right, forward)}
            corners: RoomsView::Vec[4] = [
                RoomsView::vec(-WALL_X, WALL_TOP, -ShadowPlay::WALL), RoomsView::vec(WALL_X, WALL_TOP, -ShadowPlay::WALL),
                RoomsView::vec(-WALL_X, -ShadowPlay::FLOOR, FLOOR_NEAR), RoomsView::vec(WALL_X, -ShadowPlay::FLOOR, FLOOR_NEAR)]
            low_x: mutable f64 = 1e18
            low_y: mutable f64 = 1e18
            high_x: mutable f64 = -1e18
            high_y: mutable f64 = -1e18
            for p in corners |cam, low_x, low_y, high_x, high_y|:
                q: RoomsView::Point = RoomsView::project(&cam, p)
                low_x <- q.x if q.x < low_x
                low_y <- q.y if q.y < low_y
                high_x <- q.x if q.x > high_x
                high_y <- q.y if q.y > high_y
            w: f64 = box.w * 0.96 / (high_x - low_x)
            h: f64 = (box.h - 20.0) * 0.96 / (high_y - low_y)
            focal: f64 = w if w < h else h
            return Lens{camera: cam, focal: focal,
                center_x: box.x + box.w / 2.0 - focal * (high_x + low_x) / 2.0,
                center_y: box.y + 20.0 + (box.h - 20.0) / 2.0 - focal * (high_y + low_y) / 2.0}

    def see(view: Lens&, p: RoomsView::Vec) -> RoomsView::Vec:
        delta: RoomsView::Vec = RoomsView::sub(p, view.camera.eye)
        depth: f64 = RoomsView::dot(delta, view.camera.forward)
        scale: f64 = view.focal / depth
        return RoomsView::vec(view.center_x + RoomsView::dot(delta, view.camera.right) * scale,
            view.center_y + RoomsView::dot(delta, view.camera.up) * scale, depth)

    def quad(list: mutable Display::DisplayList&, view: Lens&, corners: RoomsView::Vec[4], colour: u32):
        can Abort.Panic, Memory.Allocate:
            anchor: RoomsView::Vec = see(view, corners[0])
            Display::begin_polygon(list, 4, anchor.x, anchor.y, colour)
            for p in corners |list, view|:
                q: RoomsView::Vec = see(view, p)
                Display::polygon_point(list, q.x, q.y)

    def room(list: mutable Display::DisplayList&, view: Lens&, box: SceneHiddenRule::Rect&, light: RoomsView::Vec):
        can Abort.Panic, Memory.Allocate:
            card: SceneHiddenRule::Rect = ScenePolish::spread_box(box, 4.0)
            ScenePolish::card_face(list, &card, 14.0, 0x241e22ff, 0.u32(), 0.u32(), true)
            floor_y: f64 = -ShadowPlay::FLOOR
            wall_z: f64 = -ShadowPlay::WALL
            for i in 0..<10 |list, view, floor_y, wall_z|:
                y0: f64 = floor_y + (WALL_TOP - floor_y) * i.f64() / 10.0
                y1: f64 = floor_y + (WALL_TOP - floor_y) * (i + 1).f64() / 10.0
                colour: u32 = ScenePolish::mix_rgb(0x968478ff, 0xd6c4aaff, 1.0 - ShadowPlay::abs(i.f64() - 5.5) / 10.0)
                corners: RoomsView::Vec[4] = [RoomsView::vec(-WALL_X, y0, wall_z), RoomsView::vec(WALL_X, y0, wall_z),
                    RoomsView::vec(WALL_X, y1, wall_z), RoomsView::vec(-WALL_X, y1, wall_z)]
                quad(list, view, corners, colour)
            for i in 0..<8 |list, view, floor_y, wall_z|:
                z0: f64 = wall_z + (FLOOR_NEAR - wall_z) * i.f64() / 8.0
                z1: f64 = wall_z + (FLOOR_NEAR - wall_z) * (i + 1).f64() / 8.0
                colour: u32 = ScenePolish::mix_rgb(0x6e503cff, 0x966c4cff, i.f64() / 8.0)
                corners: RoomsView::Vec[4] = [RoomsView::vec(-WALL_X, floor_y, z0), RoomsView::vec(WALL_X, floor_y, z0),
                    RoomsView::vec(WALL_X, floor_y, z1), RoomsView::vec(-WALL_X, floor_y, z1)]
                quad(list, view, corners, colour)
            center: RoomsView::Vec = see(view, ShadowPlay::on_wall(RoomsView::vec(0.0, 0.0, 0.0), light))
            ScenePolish::glow(list, center.x, center.y, view.focal * 0.28, 0xffe6aaff, 120)
            a: RoomsView::Vec = see(view, RoomsView::vec(-WALL_X, floor_y, wall_z))
            b: RoomsView::Vec = see(view, RoomsView::vec(WALL_X, floor_y, wall_z))
            Display::draw_line(list, a.x, a.y, b.x, b.y, 3.0, 0x503c32ff)

    def cast(rod: ShadowPlay::Rod&, turn: DrShape::Matrix, view: Lens&, light: RoomsView::Vec, floor_shadow: bool) -> PaintedRod:
        can Abort.Panic:
            count: i64 = rod.count - 1
            out: mutable PaintedRod = PaintedRod{pieces: zeroed, count: count}
            for i in 0..<count |out, rod, turn, view, light, floor_shadow|:
                pa: RoomsView::Vec = DrShape::apply(turn, rod.joints[i.usize()])
                pb: RoomsView::Vec = DrShape::apply(turn, rod.joints[(i + 1).usize()])
                a: RoomsView::Vec = see(view, ShadowPlay::on_floor(pa, light) if floor_shadow else ShadowPlay::on_wall(pa, light))
                b: RoomsView::Vec = see(view, ShadowPlay::on_floor(pb, light) if floor_shadow else ShadowPlay::on_wall(pb, light))
                out.pieces[i.usize()] <- Segment{a: a, b: b, depth: a.z, lit: 0.0}
            return out

    def shadows(list: mutable Display::DisplayList&, view: Lens&, run: ShadowPlay::Run&, wall_light: RoomsView::Vec):
        can Abort.Panic, Memory.Allocate:
            planes: i64 = 2 if run.setup.level.floor else 1
            target: DrShape::Matrix = ShadowPlay::target_at(&run.setup, run.t)
            actual: u32 = FITTED_SHADOW if run.fit <= run.setup.level.tol else SHADOW
            for layer in 0..<3 |list, view, run, wall_light, target, planes, actual|:
                for plane in 0..<planes |list, view, run, wall_light, layer, target, actual|:
                    light: RoomsView::Vec = wall_light if plane == 0 else ShadowPlay::floor_light()
                    projected: PaintedRod = cast(&run.setup.rod, target if layer < 2 else run.turn, view, light, plane == 1)
                    for i in 0..<projected.count |list, view, projected, layer, actual|:
                        line: Segment = projected.pieces[i.usize()]
                        size: f64 = view.focal / line.depth
                        edge: f64 = size * 0.16 * 0.4
                        width: f64 = size * 0.11 if layer == 2 else (size * 0.16 * 2.2 if layer == 0 else (edge if edge > 2.0 else 2.0))
                        colour: u32 = GOLD_SOFT if layer == 0 else (GOLD_EDGE if layer == 1 else actual)
                        Display::draw_line(list, line.a.x, line.a.y, line.b.x, line.b.y, width, colour)
                        if layer == 2:
                            Display::draw_circle(list, line.a.x, line.a.y, width * 0.5, colour)
                            Display::draw_circle(list, line.b.x, line.b.y, width * 0.5, colour)

    def copper(rod: ShadowPlay::Rod&, turn: DrShape::Matrix, view: Lens&, light: RoomsView::Vec) -> PaintedRod:
        can Abort.Panic:
            count: i64 = rod.count - 1
            out: mutable PaintedRod = PaintedRod{pieces: zeroed, count: count}
            for i in 0..<count |out, rod, turn, view, light|:
                pa: RoomsView::Vec = DrShape::apply(turn, rod.joints[i.usize()])
                pb: RoomsView::Vec = DrShape::apply(turn, rod.joints[(i + 1).usize()])
                a: RoomsView::Vec = see(view, pa)
                b: RoomsView::Vec = see(view, pb)
                lit: f64 = ShadowPlay::abs(RoomsView::dot(RoomsView::unit(RoomsView::sub(pb, pa)), light))
                depth: f64 = (a.z + b.z) / 2.0
                slot: mutable i64 = i
                while slot > 0 |out, slot, depth|:
                    last: Segment = out.pieces[(slot - 1).usize()]
                    break if last.depth >= depth
                    out.pieces[slot.usize()] <- last
                    slot <- slot - 1
                out.pieces[slot.usize()] <- Segment{a: a, b: b, depth: depth, lit: lit}
            return out

    def paint_rod(list: mutable Display::DisplayList&, view: Lens&, painted: PaintedRod&):
        can Abort.Panic, Memory.Allocate:
            highlight: u32 = ScenePolish::mix_rgb(COPPER, 0xffffffff, 0.45)
            for i in 0..<painted.count |list, view, painted, highlight|:
                line: Segment = painted.pieces[i.usize()]
                w: f64 = 0.13 * view.focal / line.depth
                base: u32 = ScenePolish::mix_rgb(COPPER, 0x5a321eff, 0.55 * line.lit)
                joint: u32 = ScenePolish::mix_rgb(base, 0x000000ff, 0.1)
                Display::draw_line(list, line.a.x, line.a.y, line.b.x, line.b.y, w, base)
                Display::draw_line(list, line.a.x, line.a.y + w * 0.2, line.b.x, line.b.y + w * 0.2,
                    w * 0.3 if w * 0.3 > 1.0 else 1.0, highlight)
                Display::draw_circle(list, line.a.x, line.a.y, w * 0.55, joint)
                Display::draw_circle(list, line.b.x, line.b.y, w * 0.55, joint)

    def meter(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&, run: ShadowPlay::Run&):
        can Abort.Panic, Memory.Allocate:
            width: f64 = box.w * 0.4
            bg: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: box.x + box.w * 0.3, y: box.y + 14.0, w: width, h: 10.0}
            share: f64 = ShadowPlay::closeness(run)
            progress: f64 = width * share
            bar: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: bg.x, y: bg.y, w: progress if progress > 10.0 else 10.0, h: bg.h}
            ScenePolish::rounded(list, &bg, 5.0, 0xffffff3c)
            ScenePolish::rounded(list, &bar, 5.0, ScenePolish::mix_rgb(0xec5a46ff, 0x6ee68cff, share))
            if run.fit_since >= 0.0:
                hold: f64 = DrShapeDeal::clamp((run.t - run.fit_since) / run.setup.level.hold, 0.0, 1.0)
                if hold > 0.0:
                    ScenePolish::arc(list, bg.x + width + 20.0, bg.y + 5.0, 10.0, ShadowPlay::PI * 0.5, ShadowPlay::PI * 2.0 * hold, 4.0, HOLD_RING)
            seconds: f64 = run.setup.level.seconds - run.t
            clock: mutable dstr = []
            dstr_append_i64(&clock, ceil(seconds).i64() if seconds > 0.0 else 0)
            Display::draw_text_weight(list, bytes_view(clock), bg.x - 24.0, bg.y + 5.0, 11.0,
                0xffffffdc, Display::ANCHOR_CENTER_CENTER, true)

    def render(list: mutable Display::DisplayList&, session: ShadowPlayGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x12121eff
            Display::draw_text_weight(list, "Shadow Play", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Drag to turn (right button or Shift: roll)   A D / W S / Q E or arrows   Esc: menu",
                CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            if session.phase == ShadowPlayGame::READY:
                Display::draw_text(list, "Press Space or Enter to start", CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            if session.phase == ShadowPlayGame::DONE:
                score: mutable dstr = []
                dstr_append_i64(&score, session.passed)
                dstr_append_cstr(&score, " of ")
                dstr_append_i64(&score, session.trial)
                dstr_append_cstr(&score, " passed   highest rung passed ")
                dstr_append_i64(&score, session.best)
                Display::draw_text(list, bytes_view(score), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            run: ShadowPlay::Run& = &session.run
            guide: sview = "Turn it left and right until the shadow fits the outline" if run.setup.level.axes == 1 else (
                "Turn and tip it until the shadow fits the outline" if run.setup.level.axes == 2 else "Turn, tip and roll it until the shadow fits the outline")
            Display::draw_text(list, guide, CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.total)
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            box: SceneHiddenRule::Rect = area()
            view: Lens = lens(&box)
            light: RoomsView::Vec = ShadowPlay::wall_light(run.setup.level.swing, run.t)
            room(list, &view, &box, light)
            shadows(list, &view, run, light)
            rod: PaintedRod = copper(&run.setup.rod, run.turn, &view, light)
            paint_rod(list, &view, &rod)
            meter(list, &box, run)
            if session.phase == ShadowPlayGame::JUDGED:
                good: bool = run.result == ShadowPlay::WON
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, good, "The shadow fits" if good else "Out of time", 60.0, 16.0)

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: ShadowPlay::Grade = ShadowPlay::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.bends)
            dstr_append_cstr(out, " bends, ")
            dstr_append_i64(out, level.axes)
            dstr_append_cstr(out, " axes.")
            if level.floor:
                dstr_append_cstr(out, "  Floor shadow too.")
            if level.turning != 0.0:
                dstr_append_cstr(out, "  The outline turns.")
            if level.swing != 0.0:
                dstr_append_cstr(out, "  The lamp swings.")
