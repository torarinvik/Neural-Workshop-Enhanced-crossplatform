include "./scene_desktop_draw.elisa"

module SceneDesktopWindows:
    # ui/desktop.py's windows, the explorer, the taskbar, and what opens
    # over them: menus, Start, dialogs, right-click menus, dropdown lists,
    # popups, and a drag on its way.
    const NONE: i64 = -1
    const BODY: i64 = SceneDesktopDraw::BODY
    const PARTS: i64 = SceneDesktopDraw::PARTS
    const TEXT: i64 = SceneDesktopDraw::TEXT

    def short_name(index: i64) -> cstr:
        return Desktop::place_name(index)

    # _short_path: Home left off, and only the last three folders.
    def short_path(desk: DesktopState::Desk&, node: i64) -> dstr:
        can Memory.Allocate, Abort.Panic:
            chain: darray[i64] = DesktopFiles::chain(desk, node)
            names: mutable darray[i64] = []
            for at in chain |names|:
                names.push(at) if at != Desktop::HOME
            out: mutable dstr = []
            if names.count == 0.usize():
                dstr_append_cstr(&out, Desktop::place_name(Desktop::HOME))
                return out
            first: i64 = 0 if names.count <= 3.usize() else names.count.i64() - 3
            if first > 0:
                dstr_append_cstr(&out, "…")
            for index in first..<names.count.i64() |out, names, desk, first|:
                dstr_append_cstr(&out, " / ") if index > first or first > 0
                name: dstr = SceneDesktopDraw::node_name(desk, names[index.usize()])
                dstr_append_dstr(&out, name)
            return out

    def title_bar(list: mutable Display::DisplayList&, drawing: SceneDesktopDraw::Pen, desk: DesktopState::Desk&, window: i64,
            colour: u32):
        can Abort.Panic, Memory.Allocate:
            win: DesktopState::Window = desk.windows[window.usize()]
            SceneDesktopDraw::rect(list, drawing, PARTS, DesktopState::title_rect(&win), colour)
            title: dstr = SceneDesktopDraw::title_of(desk, window)
            ink: u32 = SceneDesktopDraw::INK if win.kind == Desktop::NOTE else SceneDesktopDraw::WHITE
            SceneDesktopDraw::words(list, drawing, TEXT, bytes_view(title), win.x + 12.0, win.y + (Desktop::TITLE_H / 2).f64(),
                13.0, ink, false, true)
            SceneDesktopDraw::button(list, drawing, DesktopState::minimise_rect(&win), "–", SceneDesktopDraw::BUTTON,
                SceneDesktopDraw::INK, true)
            SceneDesktopDraw::button(list, drawing, DesktopState::close_rect(&win), "×", SceneDesktopDraw::BUTTON,
                SceneDesktopDraw::INK, true)

    def tool_usable(desk: DesktopState::Desk&, place: DesktopState::Place&, tool: i64) -> bool:
        can Abort.Panic:
            return place.history.count > 0.usize() if tool == Desktop::BACK
            return desk.nodes[place.path.usize()].parent != NONE if tool == Desktop::UP
            return place.selected != NONE if tool == Desktop::CUT or tool == Desktop::COPY or tool == Desktop::DELETE
            return desk.picking.clipboard != NONE if tool == Desktop::PASTE
            return true

    def has_children(desk: DesktopState::Desk&, folder: i64) -> bool:
        for node in desk.nodes |folder|:
            return true if node.parent == folder
        return false

    # _draw_explorer.
    def explorer(list: mutable Display::DisplayList&, drawing: SceneDesktopDraw::Pen, desk: mutable DesktopState::Desk&,
            window: i64):
        can Abort.Panic, Memory.Allocate:
            win: DesktopState::Window = desk.windows[window.usize()]
            place: DesktopState::Place = DesktopView::current(desk, window)
            for tool in 0..<7 |list, drawing, desk, win, place|:
                usable: bool = tool_usable(desk, &place, tool)
                SceneDesktopDraw::named_button(list, drawing, DesktopState::tool_rect(&win, tool), Desktop::tool_name(tool),
                    SceneDesktopDraw::BUTTON, SceneDesktopDraw::INK if usable else SceneDesktopDraw::GREY, false, 10.0)
            for index in 0..<win.browsing.places.count.i64() |list, drawing, desk, win|:
                active: bool = index == win.browsing.current
                name: dstr = SceneDesktopDraw::node_name(desk, win.browsing.places[index.usize()].path)
                SceneDesktopDraw::button(list, drawing, DesktopState::place_tab_rect(&win, index), bytes_view(name),
                    SceneDesktopDraw::PANEL if active else SceneDesktopDraw::BUTTON, SceneDesktopDraw::INK, active, 10.0)
            if win.browsing.places.count.i64() < Desktop::MOST_TABS:
                SceneDesktopDraw::button(list, drawing, DesktopState::plus_rect(&win), "+", SceneDesktopDraw::BUTTON,
                    SceneDesktopDraw::INK, true)
            path: DesktopState::Rect = DesktopState::path_rect(&win)
            SceneDesktopDraw::rect(list, drawing, PARTS, path, SceneDesktopDraw::WHITE, SceneDesktopDraw::PANEL_EDGE)
            shown: dstr = short_path(desk, place.path)
            SceneDesktopDraw::words(list, drawing, TEXT, bytes_view(shown), path.x + 6.0, path.y + path.h / 2.0, 10.0)
            for index in 0..<Desktop::PLACE_COUNT |list, drawing, win, place|:
                side: DesktopState::Rect = DesktopState::sidebar_rect(&win, index)
                here: bool = place.path == index
                SceneDesktopDraw::rect(list, drawing, PARTS, side, SceneDesktopDraw::SELECTED if here else SceneDesktopDraw::PANEL)
                SceneDesktopDraw::named(list, drawing, TEXT, Desktop::place_name(index), side.x + 8.0, side.y + side.h / 2.0, 11.0,
                    SceneDesktopDraw::INK, false, here)
            if not has_children(desk, place.path):
                area: DesktopState::Rect = DesktopState::grid_area(&win)
                SceneDesktopDraw::words(list, drawing, TEXT, "This folder is empty", area.x + area.w / 2.0, area.y + 30.0, 11.0,
                    SceneDesktopDraw::GREY, true)
            icons: darray[DesktopView::Placed] = DesktopView::placed_icons(desk, window)
            for icon in icons |list, drawing, desk, place, win|:
                SceneDesktopDraw::rect(list, drawing, PARTS, icon.rect, SceneDesktopDraw::SELECTED) if place.selected == icon.node
                faded: bool = desk.picking.clipboard == icon.node and not desk.picking.copying
                if win.browsing.list_view:
                    SceneDesktopDraw::list_row(list, drawing, desk, icon.node, icon.rect, faded)
                else:
                    SceneDesktopDraw::node_glyph(list, drawing, desk, icon.node, icon.rect, faded)
            if DesktopView::ex_scrolls(desk, window):
                SceneDesktopDraw::button(list, drawing, DesktopState::ex_scroll_rect(&win, 0), "▲", SceneDesktopDraw::BUTTON,
                    SceneDesktopDraw::INK, false, 10.0)
                SceneDesktopDraw::button(list, drawing, DesktopState::ex_scroll_rect(&win, 1), "▼", SceneDesktopDraw::BUTTON,
                    SceneDesktopDraw::INK, false, 10.0)

    def apply_pending(desk: DesktopState::Desk&, window: i64) -> bool:
        for control in desk.controls |window|:
            return true if control.window == window and control.dialog == NONE and control.shown != control.value
        return false

    def app(list: mutable Display::DisplayList&, drawing: SceneDesktopDraw::Pen, desk: DesktopState::Desk&, window: i64):
        can Abort.Panic, Memory.Allocate:
            win: DesktopState::Window = desk.windows[window.usize()]
            for index in 0..<win.menus |list, drawing, win|:
                menu: DesktopState::Rect = DesktopState::menu_rect(&win, index)
                SceneDesktopDraw::named(list, drawing, TEXT, Desktop::menu_name(index), menu.x + 8.0, menu.y + menu.h / 2.0)
            if win.tab_count > 1:
                for index in 0..<win.tab_count |list, drawing, win|:
                    active: bool = index == win.active
                    SceneDesktopDraw::named_button(list, drawing, DesktopState::tab_rect(&win, index), Desktop::tab_name(index),
                        SceneDesktopDraw::PANEL if active else SceneDesktopDraw::BUTTON, SceneDesktopDraw::INK, active)
            for row in 0..<win.per_tab |list, drawing, desk, win, window|:
                SceneDesktopDraw::draw_control(list, drawing, desk,
                    desk.dealt.tabs[DesktopDeal::tab_slot(window, win.active, row).usize()], win.w)
            if DesktopState::scrolls(&win):
                SceneDesktopDraw::button(list, drawing, DesktopState::scroll_rect(&win, 0), "▲", SceneDesktopDraw::BUTTON,
                    SceneDesktopDraw::INK, false, 10.0)
                SceneDesktopDraw::button(list, drawing, DesktopState::scroll_rect(&win, 1), "▼", SceneDesktopDraw::BUTTON,
                    SceneDesktopDraw::INK, false, 10.0)
            if win.apply:
                pending: bool = apply_pending(desk, window)
                SceneDesktopDraw::button(list, drawing, DesktopState::apply_rect(&win), "Apply",
                    SceneDesktopDraw::ACCENT if pending else SceneDesktopDraw::BUTTON,
                    SceneDesktopDraw::WHITE if pending else SceneDesktopDraw::INK)
            # The corner to resize by: three short diagonal steps.
            grip: DesktopState::Rect = DesktopState::grip_rect(&win)
            for step in 0..<3 |list, drawing, grip|:
                inset: f64 = (4 + step * 4).f64()
                SceneDesktopDraw::rect(list, drawing, TEXT, DesktopState::rect(grip.x + inset, grip.y + grip.h - 3.0,
                    grip.w - inset - 2.0, 2.0), SceneDesktopDraw::PANEL_EDGE)

    # _draw_window, one stage of it.
    def window(list: mutable Display::DisplayList&, drawing: SceneDesktopDraw::Pen, desk: mutable DesktopState::Desk&,
            index: i64):
        can Abort.Panic, Memory.Allocate:
            win: DesktopState::Window = desk.windows[index.usize()]
            whole: DesktopState::Rect = DesktopState::box(&win)
            if win.kind == Desktop::EXPLORER:
                SceneDesktopDraw::rect(list, drawing, BODY, whole, SceneDesktopDraw::PANEL, SceneDesktopDraw::PANEL_EDGE)
                title_bar(list, drawing, desk, index, SceneDesktopDraw::rgb(40, 60, 90))
                explorer(list, drawing, desk, index)
            elif win.kind == Desktop::NOTE:
                SceneDesktopDraw::rect(list, drawing, BODY, whole, SceneDesktopDraw::NOTE, SceneDesktopDraw::PANEL_EDGE)
                title_bar(list, drawing, desk, index, SceneDesktopDraw::rgb(236, 200, 80))
                SceneDesktopDraw::named(list, drawing, TEXT, Desktop::note_text(win.note_text), win.x + 14.0,
                    win.y + (Desktop::TITLE_H + 30).f64())
            else:
                SceneDesktopDraw::rect(list, drawing, BODY, whole, SceneDesktopDraw::PANEL, SceneDesktopDraw::PANEL_EDGE)
                title_bar(list, drawing, desk, index, SceneDesktopDraw::title_colour(index))
                app(list, drawing, desk, index)

    # _draw_taskbar, one stage of it.
    def taskbar(list: mutable Display::DisplayList&, drawing: SceneDesktopDraw::Pen, desk: DesktopState::Desk&):
        can Abort.Panic, Memory.Allocate:
            SceneDesktopDraw::rect(list, drawing, BODY, DesktopState::rect(0.0, Desktop::WORK_H.f64(), Desktop::SCREEN_W.f64(),
                Desktop::TASKBAR_H.f64()), SceneDesktopDraw::TASKBAR)
            SceneDesktopDraw::button(list, drawing, DesktopState::start_rect(), "Start", SceneDesktopDraw::ACCENT,
                SceneDesktopDraw::WHITE, true)
            front: i64 = DesktopReference::top_app(desk)
            listed: darray[i64] = DesktopView::taskbar_windows(desk)
            for position in 0..<listed.count.i64() |list, drawing, desk, listed, front|:
                window: i64 = listed[position.usize()]
                title: dstr = SceneDesktopDraw::title_of(desk, window)
                SceneDesktopDraw::button(list, drawing, DesktopView::taskbar_rect(position), bytes_view(title),
                    SceneDesktopDraw::rgb(110, 118, 136) if front == window else SceneDesktopDraw::TASK_BUTTON,
                    SceneDesktopDraw::GREY if desk.windows[window.usize()].minimised else SceneDesktopDraw::WHITE, false, 11.0)
            if desk.dealt.hide_card:
                SceneDesktopDraw::button(list, drawing, DesktopState::peek_rect(), "Card",
                    SceneDesktopDraw::ACCENT if desk.picking.peeking else SceneDesktopDraw::TASK_BUTTON, SceneDesktopDraw::WHITE,
                    false, 11.0)
            SceneDesktopDraw::button(list, drawing, DesktopState::done_rect(), "Done", SceneDesktopDraw::ON,
                SceneDesktopDraw::WHITE, true)
