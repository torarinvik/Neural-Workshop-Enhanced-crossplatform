# The glyph family two tasks share.
#
# Port of `make_glyph` and `place_glyph` from neural_workshop/ui/lookout.py.
# They are module-level over there for the same reason they are their own
# module here: Pursuit draws the same shapes, and one maker is what keeps a
# "square" the same square in both.
#
# Four forms and each is a different pyglet class. Two are worth naming:
#
#   * the SQUARE is a Rectangle with `anchor_position` set to its own middle,
#     so its x and y are the point it is centred on and not its corner. The
#     display list carries that anchor rather than pre-subtracting it, because
#     a shell that ignored it would draw every square up and to the right by
#     half a side.
#   * the TRIANGLE is not equilateral and not centred on its middle: it sits
#     0.8r below and 1.1r above the point, which is a taller triangle than a
#     regular one and is what the reference draws.
#
# NOTE: needs display included by the driver.

module SceneGlyphRow:

    const FORM_CIRCLE: i64 = 0
    const FORM_SQUARE: i64 = 1
    const FORM_TRIANGLE: i64 = 2
    const FORM_STAR: i64 = 3

    const FORM_COUNT: i64 = 4
    const COLOR_COUNT: i64 = 6

    # COLORS, in order. The names are the reference's and are not drawn here.
    def glyph_color(which: i64) -> u32:
        ring: i64 = which % COLOR_COUNT
        if ring == 0:
            return Display::rgba(230, 159, 0, 255)      # orange
        if ring == 1:
            return Display::rgba(86, 180, 233, 255)     # sky blue
        if ring == 2:
            return Display::rgba(0, 158, 115, 255)      # green
        if ring == 3:
            return Display::rgba(240, 228, 66, 255)     # yellow
        if ring == 4:
            return Display::rgba(0, 114, 178, 255)      # blue
        return Display::rgba(213, 94, 0, 255)           # vermilion

    # `x`, `y` and `r` are in PIXELS; `sx`, `sy` take them to reference space.
    def put(list: mutable Display::DisplayList&, form: i64, x: f64, y: f64,
            r: f64, color: u32, sx: f64, sy: f64):
        can Memory.Allocate, Abort.Panic:
            if form == FORM_CIRCLE:
                Display::draw_circle(list, x / sx, y / sy, r / sy, color)
                return
            if form == FORM_SQUARE:
                side: f64 = r * 1.8
                Display::draw_rect_anchored(list, x / sx, y / sy,
                                            side / sx, side / sy,
                                            side / 2.0 / sx, side / 2.0 / sy,
                                            color)
                return
            if form == FORM_TRIANGLE:
                Display::draw_triangle(list, (x - r) / sx, (y - r * 0.8) / sy,
                                       (x + r) / sx, (y - r * 0.8) / sy,
                                       x / sx, (y + r * 1.1) / sy, color)
                return
            Display::draw_star(list, x / sx, y / sy, r * 1.25 / sy,
                               r * 0.55 / sy, 5, 0.0, color)
