# Building strings, which in Elisa means building a `dstr` -- a darray[u8].
#
# f-strings would be the natural way and cannot be used: stage1's backend
# declines the whole compilation unit when one is present (see
# repro/nw_gamemode_fstring_stage1.elisa, the same family as the generic
# `Store` impl decline that blocks print(i64)). So text is assembled byte by
# byte, which is why these exist at all.
#
# Extracted from gamemode.elisa when syllogism needed them too: that module
# prints whole sentences, and a second copy of an append routine is a second
# place for a formatting difference to hide.

def dstr_append_sview(out: mutable dstr&, text: sview):
    can Memory.Allocate, Abort.Panic:
        length: i64 = sview_len(text).i64()
        index: mutable i64 = 0
        while index < length |out, text, index, length|:
            out.push(sview_at(text, index.usize()))
            index <- index + 1

def dstr_append_cstr(out: mutable dstr&, text: cstr):
    can Memory.Allocate, Abort.Panic:
        dstr_append_sview(out, sview(text, 0, -1))

def dstr_append_dstr(out: mutable dstr&, text: dstr):
    can Memory.Allocate, Abort.Panic:
        dstr_append_sview(out, bytes_view(text))

# '%i' % value, as CPython formats it: no sign for zero or positive, '-' for
# negative.
def dstr_append_i64(out: mutable dstr&, value: i64):
    can Memory.Allocate, Abort.Panic:
        if value == 0:
            out.push(48.u8())
        else:
            digits: mutable u8[24] = zeroed
            slot: mutable i64 = 0
            remainder: mutable i64 = value
            negative: bool = value < 0
            while remainder != 0 |digits, slot, remainder|:
                digit: i64 = remainder % 10
                magnitude: i64 = digit if digit >= 0 else -digit
                digits[slot.usize()] <- (48 + magnitude).u8()
                slot <- slot + 1
                remainder <- remainder / 10
            if negative:
                out.push(45.u8())
            cursor: mutable i64 = slot - 1
            while cursor >= 0 |out, digits, cursor|:
                out.push(digits[cursor.usize()])
                cursor <- cursor - 1

def dstr_of_cstr(text: cstr) -> dstr:
    can Memory.Allocate, Abort.Panic:
        out: mutable dstr = []
        dstr_append_cstr(&out, text)
        return out

