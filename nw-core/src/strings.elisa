# Building strings, which in Elisa means building a `dstr` -- a darray[u8].
#
# f-strings would be the natural way and cannot be used: stage1's backend
# declines the whole compilation unit when one is present (see
# repro/nw_gamemode_fstring_stage1.elisa, the same family as the generic
# `Store` impl decline that blocks print(i64)). So text is assembled byte by
# byte, which is why these exist at all.
#
# Extracted from gamemode.elisa when syllogism needed them too: that module
# prints whole sentences, and a second copy of an append routine is a second
# place for a formatting difference to hide.

# The current Stage1 runtime names these bounds-safe primitives
# string_view_len/string_view_index. Keep the older source-facing spellings
# used throughout nw-core as thin adapters so Stage0 and current Stage1 compile
# the same port sources.
def sview_len(view: sview) -> usize:
    length: i64 = string_view_len(view)
    return 0.usize() if length <= 0
    return 0.usize() if length.usize().i64() != length
    return length.usize()

def sview_at(view: sview, index: usize) -> u8:
    return string_view_index(view, index.i64()).u8()

def dstr_append_sview(out: mutable dstr&, text: sview):
    can Memory.Allocate, Abort.Panic:
        length: i64 = sview_len(text).i64()
        index: mutable i64 = 0
        while index < length |out, text, index, length|:
            out.push(sview_at(text, index.usize()))
            index <- index + 1

def dstr_append_cstr(out: mutable dstr&, text: cstr):
    can Memory.Allocate, Abort.Panic:
        dstr_append_sview(out, sview(text, 0, -1))

def dstr_append_dstr(out: mutable dstr&, text: dstr):
    can Memory.Allocate, Abort.Panic:
        dstr_append_sview(out, bytes_view(text))

# '%i' % value, as CPython formats it: no sign for zero or positive, '-' for
# negative.
def dstr_append_i64(out: mutable dstr&, value: i64):
    can Memory.Allocate, Abort.Panic:
        if value == 0:
            out.push(48.u8())
        else:
            digits: mutable u8[24] = zeroed
            slot: mutable i64 = 0
            remainder: mutable i64 = value
            negative: bool = value < 0
            while remainder != 0 |digits, slot, remainder|:
                digit: i64 = remainder % 10
                magnitude: i64 = digit if digit >= 0 else -digit
                digits[slot.usize()] <- (48 + magnitude).u8()
                slot <- slot + 1
                remainder <- remainder / 10
            if negative:
                out.push(45.u8())
            cursor: mutable i64 = slot - 1
            while cursor >= 0 |out, digits, cursor|:
                out.push(digits[cursor.usize()])
                cursor <- cursor - 1

def dstr_of_cstr(text: cstr) -> dstr:
    can Memory.Allocate, Abort.Panic:
        out: mutable dstr = []
        dstr_append_cstr(&out, text)
        return out


def dstr_append_spaces(out: mutable dstr&, count: i64):
    can Memory.Allocate, Abort.Panic:
        remaining: mutable i64 = count
        while remaining > 0 |out, remaining|:
            out.push(32.u8())
            remaining <- remaining - 1

# '%.<places>f'. CPython formats the double it is given, rounding half to even,
# so a half-even rounder is required rather than a naive +0.5.
def dstr_append_fixed(out: mutable dstr&, value: f64, places: i64):
    can Memory.Allocate, Abort.Panic:
        scale: mutable f64 = 1.0
        step: mutable i64 = 0
        while step < places |scale, step, places|:
            scale <- scale * 10.0
            step <- step + 1
        negative: bool = value < 0.0
        magnitude: f64 = -value if negative else value
        units: i64 = round_half_even(magnitude * scale)
        divisor: i64 = scale.i64()
        whole: i64 = units / divisor
        fraction: i64 = units % divisor
        if negative and units != 0:
            out.push(45.u8())
        dstr_append_i64(out, whole)
        if places > 0:
            out.push(46.u8())
            # Leading zeros of the fractional part: 0.05 at two places is "05",
            # and appending the integer 5 alone would print "0.5".
            guard: mutable i64 = divisor / 10
            while guard > 1 and fraction < guard |guard, out, fraction|:
                out.push(48.u8())
                guard <- guard / 10
            dstr_append_i64(out, fraction)

# A non-negative value to one place exactly as '%.1f' prints it: the
# exact binary value, not its product with ten, decides a tie (56.05 is
# "56.0"). value * 8 and value * 2 are exact, so TwoSum gives the
# product's rounding error.
def dstr_append_one_place(out: mutable dstr&, value: f64):
    can Memory.Allocate, Abort.Panic:
        eight: f64 = value * 8.0
        two: f64 = value * 2.0
        product: f64 = eight + two
        share: f64 = product - eight
        residue: f64 = (eight - (product - share)) + (two - share)
        whole: i64 = product.i64()
        part: f64 = product - whole.f64()
        rounds_up: bool = part > 0.5 or (part == 0.5 and (residue > 0.0 or (residue == 0.0 and whole % 2 == 1)))
        rounded: i64 = whole + 1 if rounds_up else whole
        dstr_append_i64(out, rounded / 10)
        out.push(46.u8())
        dstr_append_i64(out, rounded % 10)

# A non-negative score: whole numbers without a decimal ('%d'), others
# to one place ('%.1f').
def dstr_append_points(out: mutable dstr&, value: f64):
    can Memory.Allocate, Abort.Panic:
        if value.i64().f64() == value:
            dstr_append_i64(out, value.i64())
        else:
            dstr_append_one_place(out, value)

# Round half to even, for a NON-NEGATIVE value only.
#
# This is py_round_half_even's arithmetic with its `floor` removed. floor and
# truncation agree on non-negative inputs, and dstr_append_fixed takes the
# magnitude before calling, so the results are identical over the whole domain
# this sees -- which the menurow differential checks against CPython's own %f.
#
# Worth the duplication: floor is libm, and pulling libm in for one call would
# make elisacore_math (and with it pyrandom, which pymath needs) a dependency of
# every menu screen, including the wasm build, which links neither.
def round_half_even(value: f64) -> i64:
    can Abort.Panic:
        whole: i64 = value.i64()
        part: f64 = value - whole.f64()
        if part > 0.5:
            return whole + 1
        if part < 0.5:
            return whole
        return whole if whole % 2 == 0 else whole + 1


# An em dash, U+2014, three bytes of UTF-8. Every task screen's status line
# joins its parts with one, and it is inside a translated string -- so it is the
# reference's bytes that matter and not a hyphen that looks close enough.
def dstr_append_em_dash(out: mutable dstr&):
    can Memory.Allocate, Abort.Panic:
        out.push(226.u8())
        out.push(128.u8())
        out.push(148.u8())
