include "./scene_hand.elisa"
include "./geometry.elisa"
include "./scene_verdict.elisa"
include "./strings.elisa"
include "./tasks/semaphore_game.elisa"

# ui/semaphore.py: the far ship and its signaller, your own two flags, the
# code chart down both sides, and the message along the top.
module SceneSemaphore:
    def point(x: f64, y: f64) -> RoomsView::Vec:
        return RoomsView::vec(x, y, 1.0)

    # handtask.rect: cut to the screen, then drawn.
    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            left: f64 = fmax(0.0, x)
            bottom: f64 = fmax(0.0, y)
            width: f64 = fmin(1000.0, x + w) - left
            height: f64 = fmin(640.0, y + h) - bottom
            return if width <= 0.0 or height <= 0.0
            Display::draw_rect(list, SceneHand::x(left), SceneHand::y(bottom), width * SceneHand::SCALE, height * SceneHand::SCALE, tint)

    # handtask.disc: a circle, or over the edge a 16-sided polygon cut to it.
    def disc(list: mutable Display::DisplayList&, x: f64, y: f64, radius: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            return if x < -radius or x > 1000.0 + radius or y < -radius or y > 640.0 + radius
            if x < radius or y < radius or x > 1000.0 - radius or y > 640.0 - radius:
                points: mutable RoomsView::Vec[32] = zeroed
                for i in 0..<16 |points, x, y, radius|:
                    angle: f64 = 3.141592653589793 * i.f64() / 8.0
                    points[i.usize()] <- point(x + radius * cos(angle), y + radius * sin(angle))
                SceneHand::polygon(list, &points, 16, tint)
                return
            Display::draw_circle(list, SceneHand::x(x), SceneHand::y(y), fmax(1.0, radius * SceneHand::SCALE), tint)

    def triangle(list: mutable Display::DisplayList&, a: RoomsView::Vec, b: RoomsView::Vec, c: RoomsView::Vec, tint: u32):
        can Abort.Panic, Memory.Allocate:
            points: mutable RoomsView::Vec[32] = zeroed
            points[0] <- a
            points[1] <- b
            points[2] <- c
            SceneHand::polygon(list, &points, 3, tint)

    def quad(list: mutable Display::DisplayList&, a: RoomsView::Vec, b: RoomsView::Vec, c: RoomsView::Vec, d: RoomsView::Vec, tint: u32):
        can Abort.Panic, Memory.Allocate:
            points: mutable RoomsView::Vec[32] = zeroed
            points[0] <- a
            points[1] <- b
            points[2] <- c
            points[3] <- d
            SceneHand::polygon(list, &points, 4, tint)

    # Semaphore._flag: the staff, then the flag as two triangles, red and yellow.
    def flag(list: mutable Display::DisplayList&, pivot: RoomsView::Vec, angle: f64, arm: f64, size: f64):
        can Abort.Panic, Memory.Allocate:
            d: RoomsView::Point = Semaphore::way(angle)
            tip: RoomsView::Vec = point(pivot.x + arm * d.x, pivot.y + arm * d.y)
            SceneHand::line(list, pivot, tip, fmax(2.0, size * 0.18), 0xe6dcc8ff)
            nx: f64 = -d.y
            ny: f64 = d.x
            a: RoomsView::Vec = point(tip.x - d.x * size, tip.y - d.y * size)
            b: RoomsView::Vec = point(a.x + nx * size, a.y + ny * size)
            c: RoomsView::Vec = point(tip.x + nx * size, tip.y + ny * size)
            triangle(list, a, b, tip, 0xe23c32ff)
            triangle(list, b, c, tip, 0xfad23cff)

    struct Deck:
        cos_roll: f64
        sin_roll: f64

    def deck(ship: Deck, x: f64, y: f64) -> RoomsView::Vec:
        return point(Semaphore::FAR_X + x * ship.cos_roll + y * ship.sin_roll,
            Semaphore::FAR_Y - 95.0 - x * ship.sin_roll + y * ship.cos_roll)

    def letter(index: i64) -> sview:
        can Abort.Panic:
            return sview("ABCDEFGHIJKLMNOPQRSTUVWXYZ", index, index + 1)

    def play(list: mutable Display::DisplayList&, run: Semaphore::Run&):
        can Abort.Panic, Memory.Allocate:
            SceneHand::card(list, 0x1e3250ff)
            for k in 0..<6 |list|:
                rect(list, 0.0, 360.0 + 47.0 * k.f64(), 1000.0, 47.0, ScenePolish::mix_rgb(0xbed6ecff, 0x5a8cd2ff, k.f64() / 5.0))
            rect(list, 0.0, 0.0, 1000.0, 360.0, 0x285a82ff)
            for k in 0..<12 |list, run|:
                y: f64 = 30.0 + 27.0 * k.f64()
                x: f64 = Semaphore::pymod((k * 173).f64() + run.time * (10.0 + 3.0 * k.f64()), 1100.0) - 50.0
                SceneHand::line(list, point(x, y), point(x + 60.0 + 6.0 * k.f64(), y), 2.0, 0x78aac896)
            roll: f64 = Semaphore::radians(Semaphore::roll(run))
            ship: Deck = Deck{cos_roll: Semaphore::cosine(roll), sin_roll: Semaphore::sine(roll)}
            quad(list, deck(ship, -170.0, 0.0), deck(ship, 170.0, 0.0), deck(ship, 130.0, -50.0), deck(ship, -130.0, -50.0), 0x3c2824ff)
            quad(list, deck(ship, -150.0, 0.0), deck(ship, 150.0, 0.0), deck(ship, 150.0, 10.0), deck(ship, -150.0, 10.0), 0x966e46ff)
            SceneHand::line(list, deck(ship, -90.0, 10.0), deck(ship, -90.0, 230.0), 5.0, 0x5a4632ff)
            triangle(list, deck(ship, -86.0, 220.0), deck(ship, -86.0, 120.0), deck(ship, -10.0, 130.0), 0xf0ecdcff)
            back: bool = Semaphore::back(run)
            quad(list, deck(ship, -13.0, 10.0), deck(ship, 13.0, 10.0), deck(ship, 13.0, 98.0), deck(ship, -13.0, 98.0),
                0x1e2846ff if back else 0xf0f0faff)
            theirs: RoomsView::Point = Semaphore::theirs(run)
            flag(list, deck(ship, 0.0, 95.0), theirs.x, Semaphore::FAR_ARM, 22.0)
            flag(list, deck(ship, 0.0, 95.0), theirs.y, Semaphore::FAR_ARM, 22.0)
            head: RoomsView::Vec = deck(ship, 0.0, 110.0)
            disc(list, head.x, head.y, 12.0, 0x463228ff if back else 0xecc8aaff)
            rect(list, 0.0, 300.0, 1000.0, 340.0, 0xc8d2dceb) if Semaphore::fogged(run)
            px: f64 = Semaphore::PIVOT_X
            py: f64 = Semaphore::PIVOT_Y
            quad(list, point(px - 60.0, 0.0), point(px + 60.0, 0.0), point(px + 46.0, py + 10.0), point(px - 46.0, py + 10.0), 0x1e2846ff)
            disc(list, px, py + 42.0, 30.0, 0x463228ff)
            for which in 0..<2 |list, run, px, py|:
                flag(list, point(px, py), run.flags[which.usize()], Semaphore::ARM, 40.0)
                at: RoomsView::Point = Semaphore::tip(run, which)
                disc(list, at.x, at.y, 7.0, 0xffffffc8 if run.held == which else 0xffffff5a)
            helped: i64 = Semaphore::helped(run)
            k: i64 = Semaphore::index(run)
            if helped == Semaphore::NAMED and k >= 0:
                rect(list, Semaphore::FAR_X + 120.0, Semaphore::FAR_Y - 30.0, 70.0, 70.0, 0x10121cdc)
                SceneHand::word(list, letter(run.message.text[k.usize()]), Semaphore::FAR_X + 155.0, Semaphore::FAR_Y + 5.0, 34.0, 0xffe678ff, true)
            if helped == Semaphore::CHART or helped == Semaphore::NAMED:
                for n in 0..<26 |list, run|:
                    x: f64 = 46.0 if n / 13 == 0 else 954.0
                    y: f64 = 590.0 - 42.0 * (n % 13).f64()
                    rect(list, x - 34.0, y - 19.0, 68.0, 38.0, 0x10121cc8)
                    SceneHand::word(list, letter(n), x - 18.0, y, 13.0, 0xffffffff, true)
                    pair: i64 = run.code[n.usize()]
                    for side in 0..<2 |list, pair, x, y|:
                        d: RoomsView::Point = Semaphore::way((pair / 8 if side == 0 else pair % 8).f64() * 45.0)
                        SceneHand::line(list, point(x + 12.0, y), point(x + 12.0 + 15.0 * d.x, y + 15.0 * d.y), 3.0, 0xfad23cff)
                    disc(list, x + 12.0, y, 2.5, 0xffffffff)
            count: i64 = run.message.count
            for i in 0..<count |list, run, count, k|:
                x: f64 = 500.0 + 34.0 * (i.f64() - (count - 1).f64() / 2.0)
                got: i64 = run.read[i.usize()]
                rect(list, x - 14.0, 598.0, 28.0, 30.0,
                    0x3c965aff if got == 1 else (0xaa3c38ff if got == 0 else (0xffdc78ff if i == k else 0x10121cff)))
                if got != -1:
                    SceneHand::word(list, letter(run.message.text[i.usize()]), x, 613.0, 14.0, 0xffffffff, true)
            if k >= 0:
                share: f64 = fmax(0.0, 1.0 - Semaphore::since(run) / run.message.level.hold)
                rect(list, 350.0, 586.0, 300.0 * share, 6.0, 0xffc846ff)
            SceneHand::word(list, "their back is to you", 760.0, 566.0, 12.0, 0xffffffff, true) if back
            for i in 0..<run.message.level.strikes |list, run|:
                disc(list, 150.0 + 24.0 * i.f64(), 30.0, 8.0, 0xec5040ff if i < run.strikes else 0x1e3246ff)
            # TIME_BAR is off for Semaphore: the pointer only.
            SceneHand::progress(list, &run.hand, 0.0)

    # The run's result text: '%d of %d read', or what went wrong.
    def verdict(out: mutable dstr&, run: Semaphore::Run&):
        can Abort.Panic, Memory.Allocate:
            if run.result == Semaphore::PASSED:
                dstr_append_i64(out, Semaphore::read_count(run))
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, run.message.count)
                dstr_append_cstr(out, " read")
                return
            if run.said == Semaphore::SAID_MISMATCH:
                dstr_append_cstr(out, "Your flags do not match")
                return
            dstr_append_cstr(out, "That was " if run.said == Semaphore::SAID_WRONG else "You let ")
            letter_view: sview = letter(run.said_letter)
            out.push(sview_at(letter_view, 0.usize()))
            dstr_append_cstr(out, " pass") if run.said == Semaphore::SAID_PASSED

    # '%.1f' of a non-negative value, rounded the way CPython rounds it: from
    # the exact binary value. dstr_append_fixed rounds value * 10 after that
    # product has itself been rounded, so 4.65 (just above, in binary) comes
    # out 4.6 where Python says 4.7. hypot_mul gives the product exactly as
    # hi + lo; the fraction against one half decides, and only an exact half
    # goes to even.
    def append_tenths(out: mutable dstr&, value: f64):
        can Abort.Panic, Memory.Allocate:
            product: HypotDouble = hypot_mul(value, 10.0)
            whole: f64 = floor(product.hi)
            above: f64 = (product.hi - whole - 0.5) + product.lo
            units: mutable i64 = whole.i64()
            if above > 0.0 or (above == 0.0 and units % 2 == 1):
                units <- units + 1
            dstr_append_i64(out, units / 10)
            dstr_append_cstr(out, ".")
            dstr_append_i64(out, units % 10)

    # taskoptions.semaphore_note.
    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: Semaphore::Grade = Semaphore::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.letters)
            dstr_append_cstr(out, " letters, ")
            append_tenths(out, level.hold)
            dstr_append_cstr(out, " seconds each.")
            dstr_append_cstr(out, "  The signaller sometimes turns their back.") if level.turns
            dstr_append_cstr(out, "  No chart.") if level.help == Semaphore::NONE

    def render(list: mutable Display::DisplayList&, game: SemaphoreGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Semaphore", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Drag your flags by their tips to copy the signal, then type its letter   Esc: menu", 456.0, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            if game.phase == SemaphoreGame::READY:
                Display::draw_text(list, "Press Space or click to start", 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            if game.phase == SemaphoreGame::DONE:
                report: mutable dstr = []
                dstr_append_i64(&report, game.wins)
                dstr_append_cstr(&report, " of ")
                dstr_append_i64(&report, game.trial)
                dstr_append_cstr(&report, " passed   highest rung passed ")
                dstr_append_i64(&report, game.best_rung)
                Display::draw_text(list, bytes_view(report), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            play(list, &game.run)
            Display::draw_text(list, "Copy each signal with your flags and type its letter", 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if game.phase == SemaphoreGame::JUDGED:
                text: mutable dstr = []
                verdict(&text, &game.run)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, game.run.result == Semaphore::PASSED, bytes_view(text), 60.0, 16.0)
