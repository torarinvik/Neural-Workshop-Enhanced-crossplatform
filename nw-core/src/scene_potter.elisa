include "./scene_hand.elisa"
include "./geometry.elisa"
include "./scene_verdict.elisa"
include "./tasks/potter_game.elisa"

module ScenePotter:
    const INK: u32 = 0xe6e6e6ff
    const CLAY: u32 = 0xb0704eff

    def point(x: f64, y: f64) -> RoomsView::Vec:
        return RoomsView::Vec{x: x, y: y, z: 1.0}

    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, color: u32):
        can Abort.Panic, Memory.Allocate:
            Display::draw_rect(list, SceneHand::x(x), SceneHand::y(y), w * SceneHand::SCALE, h * SceneHand::SCALE, color)

    def oval(list: mutable Display::DisplayList&, x: f64, y: f64, rx: f64, ry: f64, color: u32):
        can Abort.Panic, Memory.Allocate:
            vertices: mutable RoomsView::Vec[32] = zeroed
            for i in 0..<20 |vertices, x, y, rx, ry|:
                angle: f64 = 6.283185307179586 * i.f64() / 20.0
                vertices[i.usize()] <- point(x + rx * cos(angle), y + ry * sin(angle))
            SceneHand::polygon(list, &vertices, 20, color)

    def disc(list: mutable Display::DisplayList&, x: f64, y: f64, radius: f64, color: u32):
        can Abort.Panic, Memory.Allocate:
            Display::draw_circle(list, SceneHand::x(x), SceneHand::y(y), radius * SceneHand::SCALE, color)

    def pot(list: mutable Display::DisplayList&, radii: f64[16]&, n: i64, cx: f64, foot: f64,
            tall: f64, unit: f64, tint: u32, turn: f64 = -1.0):
        can Abort.Panic, Memory.Allocate:
            splits: f64[5] = [-1.0, -0.55, 0.25, 0.6, 1.0]
            shades: f64[4] = [0.62, 0.86, 1.0, 0.78]
            for k in 0..<n |list, radii, n, cx, foot, tall, unit, tint, turn, splits, shades|:
                r: f64 = radii[k.usize()]
                lo: f64 = (r + radii[(k - 1).usize()]) / 2.0 * unit if k > 0 else r * unit
                hi: f64 = (r + radii[(k + 1).usize()]) / 2.0 * unit if k + 1 < n else r * unit
                y0: f64 = foot + tall * k.f64() / n.f64()
                y1: f64 = foot + tall * (k + 1).f64() / n.f64()
                for i in 0..<4 |list, splits, shades, cx, lo, hi, y0, y1, tint|:
                    a: f64 = splits[i.usize()]
                    b: f64 = splits[(i + 1).usize()]
                    vertices: mutable RoomsView::Vec[32] = zeroed
                    vertices[0] <- point(cx + a * lo, y0)
                    vertices[1] <- point(cx + b * lo, y0)
                    vertices[2] <- point(cx + b * hi, y1)
                    vertices[3] <- point(cx + a * hi, y1)
                    SceneHand::polygon(list, &vertices, 4, ScenePolish::mix_rgb(0x000000ff, tint, shades[i.usize()]))
                if turn >= 0.0:
                    for i in 0..<3 |list, turn, k, cx, lo, hi, y0, y1, tint|:
                        at: f64 = turn + 2.1 * i.f64() + 0.4 * k.f64()
                        if sin(at) > 0.0:
                            x: f64 = cos(at)
                            SceneHand::line(list, point(cx + x * lo, y0), point(cx + x * hi, y1),
                                2.0, ScenePolish::mix_rgb(0x000000ff, tint, 0.7))
            top: f64 = radii[(n - 1).usize()] * unit
            oval(list, cx, foot + tall, top, fmax(3.0, top * 0.16), ScenePolish::mix_rgb(0x000000ff, tint, 0.45))

    def backdrop(list: mutable Display::DisplayList&, turn: f64):
        can Abort.Panic, Memory.Allocate:
            SceneHand::card(list, 0x2c2422ff)
            rect(list, 0.0, 0.0, 1000.0, 640.0, 0x3a302eff)
            rect(list, 0.0, 0.0, 1000.0, 150.0, 0x584232ff)
            for k in 0..<5 |list|:
                shift: f64 = 190.0 * k.f64()
                rect(list, 40.0 + shift, 560.0, 150.0, 8.0, 0x604836ff)
                oval(list, 115.0 + shift, 590.0, 26.0 + 6.0 * (k % 2).f64(), 24.0,
                    Display::rgba(120 + 12 * k, 86, 70, 255))
            oval(list, Potter::AXIS, Potter::FOOT - 14.0, 250.0, 40.0, 0x28282eff)
            oval(list, Potter::AXIS, Potter::FOOT - 4.0, 240.0, 36.0, 0x787880ff)
            for i in 0..<8 |list, turn|:
                a: f64 = turn + 0.7853981633974483 * i.f64()
                x: f64 = cos(a)
                y: f64 = sin(a)
                SceneHand::line(list, point(Potter::AXIS + 150.0 * x, Potter::FOOT - 4.0 + 22.0 * y),
                    point(Potter::AXIS + 236.0 * x, Potter::FOOT - 4.0 + 35.0 * y), 2.0, 0x606068ff)

    def target(list: mutable Display::DisplayList&, run: Potter::Run&):
        can Abort.Panic, Memory.Allocate:
            return if not Potter::shown(run)
            n: i64 = run.pot.level.bands
            if run.pot.level.ghost != Potter::OVER:
                rect(list, 770.0, 300.0, 200.0, 250.0, 0x1e1a1ae6)
                pot(list, &run.pot.shape, n, 870.0, 330.0, 170.0, 70.0, 0xd2c8beff)
                SceneHand::word(list, "wanted", 870.0, 315.0, 11.0, INK)
                return
            for k in 0..<n |list, run, n|:
                offset: f64 = run.pot.shape[k.usize()] * Potter::UNIT
                y0: f64 = Potter::FOOT + Potter::TALL * k.f64() / n.f64() + 2.0
                y1: f64 = Potter::FOOT + Potter::TALL * (k + 1).f64() / n.f64() - 2.0
                SceneHand::line(list, point(Potter::AXIS - offset, y0), point(Potter::AXIS - offset, y1), 3.0, 0xffffffbe)
                SceneHand::line(list, point(Potter::AXIS + offset, y0), point(Potter::AXIS + offset, y1), 3.0, 0xffffffbe)

    def play(list: mutable Display::DisplayList&, run: Potter::Run&):
        can Abort.Panic, Memory.Allocate:
            backdrop(list, run.turn)
            n: i64 = run.pot.level.bands
            wet: u32 = ScenePolish::mix_rgb(0x968278ff, CLAY, run.wet)
            pot(list, &run.radius, n, Potter::AXIS, Potter::FOOT, Potter::TALL, Potter::UNIT, wet, run.turn)
            target(list, run)
            if run.pot.level.rung < 7:
                for k in 0..<n |list, run, n|:
                    disc(list, Potter::AXIS + 1.35 * Potter::UNIT, Potter::band_y(n, k.f64()), 6.0,
                        0x6edc8cff if run.was_near[k.usize()] else 0x5a5050ff)
            if run.hand.down and run.touching >= 0:
                disc(list, run.hand.x, run.hand.y, 16.0, 0xecc8aae6)
            SceneHand::word(list, "wheel", 60.0, 520.0, 12.0, INK)
            for k in 0..<3 |list, run|:
                disc(list, 110.0 + 22.0 * k.f64(), 520.0, 7.0, 0xffc846ff if k < run.speed else 0x5a5050ff)
            if run.pot.level.dry > 0.0:
                SceneHand::word(list, "wet", 60.0, 492.0, 12.0, INK)
                rect(list, 100.0, 486.0, 90.0, 10.0, 0x463c3cff)
                if run.wet > 0.0:
                    rect(list, 100.0, 486.0, 90.0 * run.wet, 10.0, 0x5aaaf0ff if run.wet > 0.25 else 0xec5040ff)
            SceneHand::progress(list, &run.hand, fmax(0.0, (run.pot.level.seconds - run.time) / run.pot.level.seconds))

    def verdict(result: i64) -> sview:
        return "A fine pot" if result == Potter::FINISHED
        return "The pot collapsed" if result == Potter::COLLAPSED
        return "The clay went hard"

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: Potter::Grade = Potter::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.bands)
            dstr_append_cstr(out, " bands.")
            if level.dry > 0.0:
                dstr_append_cstr(out, "  The clay dries.")
            if level.ghost != Potter::OVER:
                dstr_append_cstr(out, "  The pot wanted is not drawn over the clay.")

    def render(list: mutable Display::DisplayList&, game: PotterGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Potter's Wheel", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Hold the button and press the clay in or draw it out   Up/Down: wheel speed   Space: wet the clay   Esc: menu",
                456.0, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            if game.phase == PotterGame::READY:
                Display::draw_text(list, "Press Space or click to start", 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            if game.phase == PotterGame::DONE:
                report: mutable dstr = []
                dstr_append_i64(&report, game.wins)
                dstr_append_cstr(&report, " of ")
                dstr_append_i64(&report, game.trial)
                dstr_append_cstr(&report, " passed   highest rung passed ")
                dstr_append_i64(&report, game.best_rung)
                Display::draw_text(list, bytes_view(report), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            play(list, &game.run)
            Display::draw_text(list, "Shape the clay to the pot shown, then let go", 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            facts: mutable dstr = dstr_of_cstr("rung ")
            dstr_append_i64(&facts, game.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, game.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, game.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, game.run.pot.level.bands)
            dstr_append_cstr(&facts, " bands")
            Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            if game.phase == PotterGame::JUDGED:
                result: i64 = game.run.result
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, result == Potter::FINISHED, verdict(result), 60.0, 16.0)
