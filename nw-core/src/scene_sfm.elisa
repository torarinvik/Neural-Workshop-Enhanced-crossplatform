include "./tasks/sfm_game.elisa"
include "./display.elisa"
include "./geometry.elisa"
include "./strings.elisa"
include "./scene_verdict.elisa"

module SceneShapeFromMotion:
    const CX: f64 = 456.0
    const WIDTH: f64 = 857.28
    const BOTTOM: f64 = 179.0
    const HEIGHT: f64 = 389.0
    const BUTTON_H: f64 = HEIGHT * 0.13
    const GAP: f64 = WIDTH * 0.012
    const FIELD_Y: f64 = BOTTOM + HEIGHT * 0.16
    const FIELD_H: f64 = HEIGHT * 0.84
    const FIELD_W: f64 = FIELD_H * 1.2
    const SCALE: f64 = FIELD_H / (2.0 * ShapeFromMotion::VIEW)
    const DOT_COLOR: u32 = 0xeceef2ff

    def solid_name(solid: i64, lowercase: bool) -> cstr:
        return ("ball" if lowercase else "Ball") if solid == 0
        return ("cube" if lowercase else "Cube") if solid == 1
        return ("cylinder" if lowercase else "Cylinder") if solid == 2
        return ("cone" if lowercase else "Cone") if solid == 3
        return ("ring" if lowercase else "Ring") if solid == 4
        return ("pyramid" if lowercase else "Pyramid") if solid == 5
        return ("saddle" if lowercase else "Saddle") if solid == 6
        return "spring" if lowercase else "Spring"

    def choice(puzzle: ShapeFromMotion::Puzzle&, index: i64, lowercase: bool = false) -> cstr:
        can Abort.Panic:
            return ("Front turns left" if index == 0 else "Front turns right") if puzzle.spin
            return solid_name(puzzle.options[index.usize()], lowercase)

    def button_width(count: i64) -> f64:
        size: f64 = (WIDTH - GAP * (count - 1).f64()) / count.f64()
        return size if size < WIDTH * 0.3 else WIDTH * 0.3

    def button_left(count: i64, width: f64, index: i64) -> f64:
        return CX - (width * count.f64() + GAP * (count - 1).f64()) / 2.0 + index.f64() * (width + GAP)

    def hit(run: ShapeFromMotionGame::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return ShapeFromMotionGame::START if run.phase == ShapeFromMotionGame::READY or run.phase == ShapeFromMotionGame::DONE
            return -1 if run.phase != ShapeFromMotionGame::PLAYING or y < BOTTOM or y > BOTTOM + BUTTON_H
            count: i64 = run.puzzle.count
            width: f64 = button_width(count)
            for i in 0..<count |count, width, x|:
                left: f64 = button_left(count, width, i)
                return i if x >= left and x <= left + width
            return -1

    def message(run: ShapeFromMotionGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == ShapeFromMotionGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif run.phase == ShapeFromMotionGame::DONE:
                dstr_append_i64(out, run.passed)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, run.trial)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, run.best)
            elif run.phase == ShapeFromMotionGame::JUDGED:
                dstr_append_cstr(out, "Right: " if run.chosen == run.puzzle.answer else "No: ")
                if not run.puzzle.spin:
                    dstr_append_cstr(out, "a ")
                dstr_append_cstr(out, choice(&run.puzzle, run.puzzle.answer, true))
            else:
                dstr_append_cstr(out, "Which way does the front of it turn?" if run.puzzle.spin else "What solid are the dots on?")

    def paint_field(list: mutable Display::DisplayList&, run: ShapeFromMotionGame::Run&):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, CX - FIELD_W / 2.0, FIELD_Y, FIELD_W, FIELD_H, 0x101218ff)
            for i in 0..<run.puzzle.level.dots |list, run|:
                dot: ShapeFromMotion::Dot = run.cloud.dots[i.usize()]
                width: f64 = SCALE * 0.028 * dot.size
                x: f64 = CX + dot.x * SCALE - width / 2.0
                y: f64 = FIELD_Y + FIELD_H / 2.0 + dot.y * SCALE - width / 2.0
                Display::draw_rect(list, x, y, width, width, DOT_COLOR)
            if run.phase == ShapeFromMotionGame::JUDGED:
                name: mutable dstr = []
                dstr_append_cstr(&name, choice(&run.puzzle, run.puzzle.answer))
                Display::draw_text(list, bytes_view(name), CX, FIELD_Y + 6.0, 12.0, DOT_COLOR, Display::ANCHOR_CENTER_BOTTOM)

    def paint_buttons(list: mutable Display::DisplayList&, run: ShapeFromMotionGame::Run&, ink: u32, dark: bool):
        can Memory.Allocate, Abort.Panic:
            count: i64 = run.puzzle.count
            width: f64 = button_width(count)
            for i in 0..<count |list, run, ink, dark, count, width|:
                x: f64 = button_left(count, width, i)
                border: mutable u32 = ink
                if run.phase == ShapeFromMotionGame::JUDGED:
                    border <- 0x3caa5aff if i == run.puzzle.answer else (0xd6403aff if i == run.chosen else ink)
                Display::draw_rect(list, x, BOTTOM, width, BUTTON_H, 0x2e323aff if dark else 0xe8ebf0ff)
                Display::draw_box(list, x, BOTTOM, width, BUTTON_H, border, 2.0 if border == ink else 5.0)
                label: mutable dstr = []
                dstr_append_i64(&label, i + 1)
                dstr_append_cstr(&label, "  ")
                dstr_append_cstr(&label, choice(&run.puzzle, i))
                Display::draw_text(list, bytes_view(label), x + width / 2.0, BOTTOM + BUTTON_H / 2.0,
                    14.0, ink, Display::ANCHOR_CENTER_CENTER)

    def render(list: mutable Display::DisplayList&, run: ShapeFromMotionGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Shape from Motion", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "click an answer or press its number   Esc: menu", CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            status: mutable dstr = []
            message(run, &status)
            Display::draw_text(list, bytes_view(status), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            return if run.phase == ShapeFromMotionGame::READY or run.phase == ShapeFromMotionGame::DONE
            stats: mutable dstr = []
            dstr_append_cstr(&stats, "rung ")
            dstr_append_i64(&stats, run.rung)
            dstr_append_cstr(&stats, "  ")
            dstr_append_i64(&stats, run.trial)
            dstr_append_cstr(&stats, "/")
            dstr_append_i64(&stats, run.total)
            Display::draw_text(list, bytes_view(stats), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            paint_field(list, run)
            paint_buttons(list, run, ink, dark)
            if run.phase == ShapeFromMotionGame::JUDGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.chosen == run.puzzle.answer, bytes_view(status), 60.0, 16.0)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            g: ShapeFromMotion::Grade = ShapeFromMotion::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, g.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, g.dots)
            dstr_append_cstr(out, " dots, ")
            dstr_append_i64(out, g.choices)
            dstr_append_cstr(out, " choices.")
            if g.life > 0.0:
                dstr_append_cstr(out, "  Each dot lives 0.50 s." if g.life == 0.5 else "  Each dot lives 0.25 s.")
            if g.noise > 0:
                dstr_append_cstr(out, "  ")
                dstr_append_i64(out, g.noise * 100 / g.dots)
                dstr_append_cstr(out, "% noise.")
            if g.spin_share > 0.0:
                dstr_append_cstr(out, "  A third ask which way it turns.")
            if g.alike:
                dstr_append_cstr(out, "  Wrong choices look alike.")
