include "./tasks/desktop_game.elisa"
include "./display.elisa"
include "./geometry.elisa"
include "./verdict.elisa"

module SceneDesktopDraw:
    # ui/desktop.py's drawing primitives and windows. pyglet draws by
    # group: each part of the screen has a body, parts and text group, so
    # each is drawn in three passes and a primitive draws only on its own
    # layer's stage.
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const BODY: i64 = 0
    const PARTS: i64 = 1
    const TEXT: i64 = 2
    const NONE: i64 = -1

    const PANEL: u32 = 0xf4f5f8ff
    const PANEL_EDGE: u32 = 0x5a606eff
    const DESK: u32 = 0x466682ff
    const TASKBAR: u32 = 0x22262eff
    const TASK_BUTTON: u32 = 0x464c5aff
    const ACCENT: u32 = 0x346edcff
    const ON: u32 = 0x3ca05aff
    const OFF: u32 = 0xb0b4bcff
    const GREY: u32 = 0x96989eff
    const BUTTON: u32 = 0xdee2eaff
    const NOTE: u32 = 0xfae278ff
    const FOLDER: u32 = 0xecbe46ff
    const SELECTED: u32 = 0xc4d8faff
    const DRAG_EDGE: u32 = 0x286edcff
    const DROP_OK: u32 = 0x34a853ff
    const DROP_NO: u32 = 0xc8463cff
    const APP_TILE: u32 = 0x465a82ff
    const WARN: u32 = 0xbe3c32ff
    const INK: u32 = 0x14161cff
    const WHITE: u32 = 0xffffffff

    struct Pen:
        stage: i64
        left: f64
        top: f64
        scale: f64

    # _frame: the screen's left and top in pixels, and pixels per unit.
    def pen(stage: i64) -> Pen:
        can Abort.Panic:
            top: f64 = Geometry::from_top_edge(HEIGHT, 116.0).f64()
            bottom: f64 = Verdict::above_the_band(HEIGHT, Geometry::from_bottom_edge(HEIGHT, 58.0).f64()).f64()
            scale: f64 = fmin(WIDTH * 0.68 / Desktop::SCREEN_W.f64(), (top - bottom) / Desktop::SCREEN_H.f64())
            return Pen{stage: stage, left: WIDTH * 0.02, top: top, scale: scale}

    def on(drawing: Pen, stage: i64) -> Pen:
        return Pen{stage: stage, left: drawing.left, top: drawing.top, scale: drawing.scale}

    def rgb(red: i64, green: i64, blue: i64) -> u32:
        return (((red * 256 + green) * 256 + blue) * 256 + 255).u32()

    def title_colour(index: i64) -> u32:
        colours: u32[6] = [0x3a62aaff.u32(), 0x96463cff.u32(), 0x3c825aff.u32(), 0x785096ff.u32(), 0xaa7828ff.u32(),
            0x3c788cff.u32()]
        return colours[(index % 6).usize()]

    def file_band(kind: i64) -> u32:
        return ACCENT if kind == Desktop::DOC
        return 0x3c9650ff.u32() if kind == Desktop::SHEET
        return 0xc85a96ff.u32() if kind == Desktop::IMAGE
        return 0x965ac8ff.u32() if kind == Desktop::MUSIC
        return GREY

    # _rect: a rectangle in screen units, cut to the screen.
    def rect(list: mutable Display::DisplayList&, drawing: Pen, layer: i64, place: DesktopState::Rect, colour: u32,
            edge: u32 = 0.u32()):
        can Abort.Panic, Memory.Allocate:
            return if layer != drawing.stage
            x0: f64 = fmax(0.0, place.x)
            y0: f64 = fmax(0.0, place.y)
            x1: f64 = fmin(Desktop::SCREEN_W.f64(), place.x + place.w)
            y1: f64 = fmin(Desktop::SCREEN_H.f64(), place.y + place.h)
            return if x1 <= x0 or y1 <= y0
            px: f64 = drawing.left + x0 * drawing.scale
            py: f64 = drawing.top - y1 * drawing.scale
            width: f64 = (x1 - x0) * drawing.scale
            height: f64 = (y1 - y0) * drawing.scale
            Display::draw_rect(list, px, py, width, height, colour)
            Display::draw_box(list, px, py, width, height, edge, 1.0) if edge != 0.u32()

    # _words: a label at a point in screen units.
    def words(list: mutable Display::DisplayList&, drawing: Pen, layer: i64, text: sview, x: f64, y: f64, size: f64 = 13.0,
            colour: u32 = INK, centred: bool = false, bold: bool = false):
        can Abort.Panic, Memory.Allocate:
            return if layer != drawing.stage or sview_len(text) == 0.usize()
            return if x < 0.0 or x >= (Desktop::SCREEN_W - 8).f64()
            anchor: u32 = Display::ANCHOR_CENTER_CENTER if centred else Display::ANCHOR_LEFT_CENTER
            Display::draw_text_weight(list, text, drawing.left + x * drawing.scale, drawing.top - y * drawing.scale,
                fmax(5.0, size * drawing.scale), colour, anchor, bold)

    def named(list: mutable Display::DisplayList&, drawing: Pen, layer: i64, text: cstr, x: f64, y: f64, size: f64 = 13.0,
            colour: u32 = INK, centred: bool = false, bold: bool = false):
        can Abort.Panic, Memory.Allocate:
            spelled: mutable dstr = []
            dstr_append_cstr(&spelled, text)
            words(list, drawing, layer, bytes_view(spelled), x, y, size, colour, centred, bold)

    def button(list: mutable Display::DisplayList&, drawing: Pen, place: DesktopState::Rect, text: sview, colour: u32 = BUTTON,
            ink: u32 = INK, bold: bool = false, size: f64 = 12.0):
        can Abort.Panic, Memory.Allocate:
            rect(list, drawing, PARTS, place, colour, PANEL_EDGE)
            words(list, drawing, TEXT, text, DesktopState::centre_x(place), DesktopState::centre_y(place), size, ink, true, bold)

    def named_button(list: mutable Display::DisplayList&, drawing: Pen, place: DesktopState::Rect, text: cstr,
            colour: u32 = BUTTON, ink: u32 = INK, bold: bool = false, size: f64 = 12.0):
        can Abort.Panic, Memory.Allocate:
            spelled: mutable dstr = []
            dstr_append_cstr(&spelled, text)
            button(list, drawing, place, bytes_view(spelled), colour, ink, bold, size)

    def outline(list: mutable Display::DisplayList&, drawing: Pen, layer: i64, place: DesktopState::Rect, colour: u32,
            width: f64 = 3.0):
        can Abort.Panic, Memory.Allocate:
            x: f64 = place.x
            y: f64 = place.y
            rect(list, drawing, layer, DesktopState::rect(x, y, place.w, width), colour)
            rect(list, drawing, layer, DesktopState::rect(x, y + place.h - width, place.w, width), colour)
            rect(list, drawing, layer, DesktopState::rect(x, y, width, place.h), colour)
            rect(list, drawing, layer, DesktopState::rect(x + place.w - width, y, width, place.h), colour)

    def node_name(desk: DesktopState::Desk&, node: i64) -> dstr:
        can Memory.Allocate, Abort.Panic:
            out: mutable dstr = []
            name: DesktopDeal::Name = desk.nodes[node.usize()].name
            for at in 0..<name.count |out, name|:
                out.push(name.bytes[at.usize()])
            return out

    def title_of(desk: DesktopState::Desk&, window: i64) -> dstr:
        can Memory.Allocate, Abort.Panic:
            return dstr_of_cstr(DesktopView::title_text(desk, window))

    # --- icons ---------------------------------------------------------------

    # The glyph kinds.
    const GLYPH_FOLDER: i64 = 0
    const GLYPH_FILE: i64 = 1
    const GLYPH_TRASH: i64 = 2
    const GLYPH_APP: i64 = 3

    # _glyph: an icon in the top of place, with its name beneath.
    def glyph(list: mutable Display::DisplayList&, drawing: Pen, kind: i64, place: DesktopState::Rect, name: sview,
            faded: bool = false, file_kind: i64 = -1):
        can Abort.Panic, Memory.Allocate:
            size: f64 = fmin(place.w, place.h) * 0.5
            gx: f64 = place.x + (place.w - size) / 2.0
            gy: f64 = place.y + 6.0
            if kind == GLYPH_FOLDER:
                rect(list, drawing, PARTS, DesktopState::rect(gx, gy + size * 0.12, size * 0.45, size * 0.18), FOLDER)
                rect(list, drawing, PARTS, DesktopState::rect(gx, gy + size * 0.25, size, size * 0.7), FOLDER, PANEL_EDGE)
            elif kind == GLYPH_FILE:
                rect(list, drawing, PARTS, DesktopState::rect(gx + size * 0.15, gy, size * 0.7, size * 0.95), WHITE, PANEL_EDGE)
                rect(list, drawing, TEXT, DesktopState::rect(gx + size * 0.15, gy + size * 0.6, size * 0.7, size * 0.2),
                    file_band(file_kind))
            elif kind == GLYPH_TRASH:
                rect(list, drawing, PARTS, DesktopState::rect(gx + size * 0.1, gy, size * 0.8, size * 0.14), GREY, PANEL_EDGE)
                rect(list, drawing, PARTS, DesktopState::rect(gx + size * 0.2, gy + size * 0.18, size * 0.6, size * 0.78),
                    rgb(200, 204, 212), PANEL_EDGE)
            else:
                rect(list, drawing, PARTS, DesktopState::rect(gx, gy, size, size), APP_TILE, PANEL_EDGE)
                first: mutable dstr = []
                first.push(sview_at(name, 0.usize())) if sview_len(name) > 0.usize()
                words(list, drawing, TEXT, bytes_view(first), gx + size / 2.0, gy + size / 2.0, 16.0, WHITE, true, true)
            rect(list, drawing, TEXT, DesktopState::rect(gx, gy, size, size), rgb(230, 232, 236)) if faded
            shown: mutable dstr = []
            if sview_len(name) <= 10.usize():
                dstr_append_sview(&shown, name)
            else:
                for at in 0..<9 |shown, name|:
                    shown.push(sview_at(name, at.usize()))
                dstr_append_cstr(&shown, "…")
            words(list, drawing, TEXT, bytes_view(shown), place.x + place.w / 2.0, place.y + place.h - 12.0, 10.0, INK, true)

    def kind_word(kind: i64) -> cstr:
        return "Folder" if kind == Desktop::FOLDER
        return "Doc" if kind == Desktop::DOC
        return "Sheet" if kind == Desktop::SHEET
        return "Image" if kind == Desktop::IMAGE
        return "Music"

    # _list_row: one row of the list view.
    def list_row(list: mutable Display::DisplayList&, drawing: Pen, desk: DesktopState::Desk&, node: i64,
            place: DesktopState::Rect, faded: bool):
        can Abort.Panic, Memory.Allocate:
            entry: DesktopState::Node = desk.nodes[node.usize()]
            size: f64 = place.h - 8.0
            if entry.folder:
                rect(list, drawing, PARTS, DesktopState::rect(place.x + 6.0, place.y + 6.0, size * 1.2, size * 0.8), FOLDER,
                    PANEL_EDGE)
            else:
                rect(list, drawing, PARTS, DesktopState::rect(place.x + 8.0, place.y + 4.0, size * 0.8, size), WHITE, PANEL_EDGE)
                rect(list, drawing, TEXT, DesktopState::rect(place.x + 8.0, place.y + 4.0 + size * 0.6, size * 0.8, size * 0.25),
                    file_band(entry.kind))
            name: dstr = node_name(desk, node)
            words(list, drawing, TEXT, bytes_view(name), place.x + 40.0, place.y + place.h / 2.0, 11.0, GREY if faded else INK)
            named(list, drawing, TEXT, kind_word(entry.kind), place.x + place.w - 110.0, place.y + place.h / 2.0, 10.0, GREY)

    def node_glyph(list: mutable Display::DisplayList&, drawing: Pen, desk: DesktopState::Desk&, node: i64,
            place: DesktopState::Rect, faded: bool = false):
        can Abort.Panic, Memory.Allocate:
            entry: DesktopState::Node = desk.nodes[node.usize()]
            name: dstr = node_name(desk, node)
            glyph(list, drawing, GLYPH_FOLDER if entry.folder else GLYPH_FILE, place, bytes_view(name), faded, entry.kind)

    # _draw_desktop_icons, on the parts (1) and text (2) passes.
    def desktop_icons(list: mutable Display::DisplayList&, drawing: Pen, desk: DesktopState::Desk&):
        can Abort.Panic, Memory.Allocate:
            icons: darray[i64] = DesktopView::desktop_icons(desk)
            for index in 0..<icons.count.i64() |list, drawing, desk, icons|:
                key: i64 = icons[index.usize()]
                place: DesktopState::Rect = DesktopState::desktop_icon_rect(index)
                rect(list, drawing, PARTS, place, rgb(110, 140, 180)) if desk.picking.picked == key
                if key == DesktopState::KEY_EXPLORER:
                    glyph(list, drawing, GLYPH_APP, place, "Explorer")
                elif key == DesktopState::KEY_TRASH:
                    glyph(list, drawing, GLYPH_TRASH, place, "Trash")
                elif key < DesktopState::KEY_NODE:
                    title: dstr = title_of(desk, key - DesktopState::KEY_APP)
                    glyph(list, drawing, GLYPH_APP, place, bytes_view(title))
                else:
                    node_glyph(list, drawing, desk, key - DesktopState::KEY_NODE, place)

    # --- controls --------------------------------------------------------------

    # Control.word: what a value is called.
    def word(desk: DesktopState::Desk&, ident: i64, value: i64) -> dstr:
        can Memory.Allocate, Abort.Panic:
            spec: DesktopDeal::Spec = desk.dealt.specs[ident.usize()]
            out: mutable dstr = []
            if spec.kind == Desktop::TOGGLE:
                dstr_append_cstr(&out, "on" if value == 1 else "off")
            elif spec.kind == Desktop::SLIDER or spec.kind == Desktop::STEPPER:
                dstr_append_i64(&out, value + 1)
            elif spec.kind == Desktop::COLOUR:
                dstr_append_cstr(&out, Desktop::colour_name(spec.words[value.usize()]))
            else:
                dstr_append_cstr(&out, Desktop::word_name(spec.words[value.usize()]))
            return out

    def label(desk: DesktopState::Desk&, ident: i64) -> dstr:
        can Memory.Allocate, Abort.Panic:
            return dstr_of_cstr(Desktop::label_name(desk.dealt.specs[ident.usize()].label))

    def faded_colour(colour: u32) -> u32:
        red: i64 = (colour / 16777216.u32()).i64()
        green: i64 = ((colour / 65536.u32()) % 256.u32()).i64()
        blue: i64 = ((colour / 256.u32()) % 256.u32()).i64()
        return rgb((red + 200) / 2, (green + 200) / 2, (blue + 200) / 2)

    def control_label(list: mutable Display::DisplayList&, drawing: Pen, desk: DesktopState::Desk&, ident: i64,
            row: DesktopState::Rect, enabled: bool, ink: u32):
        can Abort.Panic, Memory.Allocate:
            control: DesktopState::Control = desk.controls[ident.usize()]
            name: dstr = label(desk, ident)
            if enabled or control.other == NONE:
                words(list, drawing, TEXT, bytes_view(name), row.x + 14.0, row.y + row.h / 2.0, 13.0, ink)
                return
            words(list, drawing, TEXT, bytes_view(name), row.x + 14.0, row.y + row.h * 0.32, 13.0, ink)
            needs: mutable dstr = []
            dstr_append_cstr(&needs, "needs ")
            other: dstr = label(desk, control.other)
            dstr_append_dstr(&needs, other)
            dstr_append_cstr(&needs, ": ")
            wanted: dstr = word(desk, control.other, control.wanted)
            dstr_append_dstr(&needs, wanted)
            words(list, drawing, TEXT, bytes_view(needs), row.x + 14.0, row.y + row.h * 0.75, 9.0, ink)

    # _draw_control.
    def draw_control(list: mutable Display::DisplayList&, drawing: Pen, desk: DesktopState::Desk&, ident: i64, width: f64):
        can Abort.Panic, Memory.Allocate:
            row: DesktopView::Spot = DesktopView::row_rect(desk, ident)
            return if not row.found
            control: DesktopState::Control = desk.controls[ident.usize()]
            spec: DesktopDeal::Spec = desk.dealt.specs[ident.usize()]
            enabled: bool = DesktopView::enabled(desk, ident)
            ink: u32 = INK if enabled else GREY
            control_label(list, drawing, desk, ident, row.rect, enabled, ink)
            place: DesktopState::Rect = DesktopState::widget_rect(row.rect.x, row.rect.y, width)
            value: i64 = control.shown
            kind: i64 = control.kind
            if kind == Desktop::TOGGLE:
                part: DesktopState::Rect = DesktopState::part(kind, control.count, place, 0)
                rect(list, drawing, PARTS, part, ((ON if value == 1 else OFF) if enabled else BUTTON), PANEL_EDGE)
                shift: f64 = part.w - part.h if value == 1 else 0.0
                rect(list, drawing, TEXT, DesktopState::rect(part.x + shift + 3.0, part.y + 3.0, part.h - 6.0, part.h - 6.0), WHITE)
            elif kind == Desktop::DROPDOWN:
                part: DesktopState::Rect = DesktopState::part(kind, control.count, place, 0)
                rect(list, drawing, PARTS, part, WHITE, PANEL_EDGE)
                shown: mutable dstr = word(desk, ident, value)
                dstr_append_cstr(&shown, "  ▾")
                words(list, drawing, TEXT, bytes_view(shown), part.x + 8.0, part.y + part.h / 2.0, 13.0, ink)
            elif kind == Desktop::STEPPER:
                minus: DesktopState::Rect = DesktopState::part(kind, control.count, place, 0)
                plus: DesktopState::Rect = DesktopState::part(kind, control.count, place, 1)
                button(list, drawing, minus, "−", BUTTON, INK, true)
                button(list, drawing, plus, "+", BUTTON, INK, true)
                shown: dstr = word(desk, ident, value)
                words(list, drawing, TEXT, bytes_view(shown), (minus.x + minus.w + plus.x) / 2.0, minus.y + minus.h / 2.0, 13.0,
                    ink, true, true)
            elif kind == Desktop::COLOUR:
                for index in 0..<control.count |list, drawing, control, place, value, enabled, spec|:
                    part: DesktopState::Rect = DesktopState::part(Desktop::COLOUR, control.count, place, index)
                    rect(list, drawing, PARTS, part, INK if enabled else GREY) if index == value
                    swatch: u32 = Desktop::colour_rgba(spec.words[index.usize()])
                    rect(list, drawing, TEXT, DesktopState::rect(part.x + 3.0, part.y + 3.0, part.w - 6.0, part.h - 6.0),
                        swatch if enabled else faded_colour(swatch))
            elif kind == Desktop::CHOICE:
                for index in 0..<control.count |list, drawing, desk, control, place, value, enabled, ink, ident|:
                    part: DesktopState::Rect = DesktopState::part(Desktop::CHOICE, control.count, place, index)
                    picked: bool = index == value
                    shown: dstr = word(desk, ident, index)
                    button(list, drawing, part, bytes_view(shown), ((ACCENT if enabled else GREY) if picked else BUTTON),
                        WHITE if picked else ink, false, 10.0)
            else:
                rect(list, drawing, PARTS, DesktopState::rect(place.x, place.y + place.h / 2.0 - 2.0, place.w, 4.0), GREY)
                for index in 0..<control.count |list, drawing, control, place, value, enabled|:
                    part: DesktopState::Rect = DesktopState::part(Desktop::SLIDER, control.count, place, index)
                    centre: f64 = part.x + part.w / 2.0
                    size: f64 = 14.0 if index == value else 6.0
                    rect(list, drawing, TEXT, DesktopState::rect(centre - size / 2.0, place.y + place.h / 2.0 - size / 2.0, size,
                        size), ((ACCENT if enabled else GREY) if index == value else PANEL_EDGE))
                shown: dstr = word(desk, ident, value)
                words(list, drawing, TEXT, bytes_view(shown), place.x + place.w + 6.0, place.y + place.h / 2.0, 10.0, ink)
