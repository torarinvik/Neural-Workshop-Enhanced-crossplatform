include "./tasks/rooms_game.elisa"
include "./rooms_view.elisa"
include "./scene_hidden_rule.elisa"

module SceneRooms:
    const LEFT: f64 = 27.36
    const WIDTH: f64 = 857.28
    const BOTTOM: f64 = 179.0
    const HEIGHT: f64 = 389.0
    const CENTRE: f64 = 456.0
    const BUTTON_W: f64 = WIDTH * 0.24
    const BUTTON_H: f64 = HEIGHT * 0.1
    const BUTTON_X: f64 = CENTRE - BUTTON_W / 2.0

    struct Placement:
        x: f64
        y: f64
        scale: f64

    def placement(cam: RoomsView::Camera&, level: Rooms::Grade, testing: bool) -> Placement:
        can Abort.Panic:
            bounds: RoomsView::Bounds = RoomsView::bounds(cam, level.cols, level.rows)
            floor: f64 = BOTTOM if testing else BOTTOM + BUTTON_H * 1.3
            height: f64 = BOTTOM + HEIGHT - floor
            sx: f64 = WIDTH / (bounds.right - bounds.left)
            sy: f64 = height / (bounds.top - bounds.bottom)
            scale: f64 = 0.9 * (sx if sx < sy else sy)
            return Placement{x: CENTRE - (bounds.left + bounds.right) * scale / 2.0,
                y: floor + height / 2.0 - (bounds.bottom + bounds.top) * scale / 2.0, scale: scale}

    def hit(run: RoomsGame::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return RoomsGame::START if run.phase == RoomsGame::READY or run.phase == RoomsGame::DONE
            return -1 if run.phase != RoomsGame::PLAYING
            if not RoomsGame::testing(run):
                return RoomsGame::NEXT if x >= BUTTON_X and x <= BUTTON_X + BUTTON_W and y >= BOTTOM and y <= BOTTOM + BUTTON_H
                return -1
            level: Rooms::Grade = run.puzzle.level
            cam: RoomsView::Camera = RoomsView::camera(level.cols, level.rows, run.puzzle.angle)
            place: Placement = placement(&cam, level, true)
            picture: RoomsView::Picture = RoomsView::scene(&cam, level.cols, level.rows, &run.puzzle.changed)
            return RoomsView::pick(&picture, (x - place.x) / place.scale, (y - place.y) / place.scale)

    def polygon(list: mutable Display::DisplayList&, p: RoomsView::Polygon&, place: Placement, colour: u32, rim: f64):
        can Memory.Allocate, Abort.Panic:
            cx: mutable f64 = 0.0
            cy: mutable f64 = 0.0
            for i in 0..<p.count |p, cx, cy|:
                cx <- cx + p.points[i.usize()].x
                cy <- cy + p.points[i.usize()].y
            cx <- cx / p.count.f64()
            cy <- cy / p.count.f64()
            for i in 0..<p.count |p, cx, cy, list, place, rim, colour|:
                point: RoomsView::Point = p.points[i.usize()]
                dx: f64 = (point.x - cx) * place.scale
                dy: f64 = (point.y - cy) * place.scale
                length: f64 = sqrt(dx * dx + dy * dy)
                inset: f64 = (length - rim) / length if length > rim else 0.0
                x: f64 = place.x + cx * place.scale + dx * inset
                y: f64 = place.y + cy * place.scale + dy * inset
                if i == 0:
                    Display::begin_polygon(list, p.count, x, y, colour)
                Display::polygon_point(list, x, y)

    def outline(list: mutable Display::DisplayList&, p: RoomsView::Polygon&, place: Placement, colour: u32):
        can Memory.Allocate, Abort.Panic:
            for i in 0..<p.count |p, place, list, colour|:
                a: RoomsView::Point = p.points[((i + p.count - 1) % p.count).usize()]
                b: RoomsView::Point = p.points[i.usize()]
                Display::draw_line(list, place.x + a.x * place.scale, place.y + a.y * place.scale,
                    place.x + b.x * place.scale, place.y + b.y * place.scale, 5.0, colour)

    def judgement(run: RoomsGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            change: i64 = run.judged_change
            dstr_append_cstr(out, "Right: that is " if run.passed else "No: ")
            dstr_append_cstr(out, "the thing that moved" if change == Rooms::MOVED else
                ("where the missing thing stood" if change == Rooms::GONE else
                ("the two that swapped" if change == Rooms::SWAPPED else "the thing that changed colour")))
            if not run.passed:
                dstr_append_cstr(out, " is outlined")

    def message(run: RoomsGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == RoomsGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif run.phase == RoomsGame::DONE:
                dstr_append_i64(out, run.passed_count)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, run.scored_count)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, run.best_rung)
            elif run.phase == RoomsGame::JUDGED:
                judgement(run, out)
            elif not RoomsGame::testing(run):
                dstr_append_cstr(out, "Room ")
                dstr_append_i64(out, run.stage + 1)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, run.puzzle.level.rooms)
                dstr_append_cstr(out, ": ")
                dstr_append_cstr(out, Rooms::name(run.puzzle.rooms[run.stage.usize()].name))
                dstr_append_cstr(out, " -- remember where everything is")
            else:
                change: i64 = run.puzzle.change
                dstr_append_cstr(out, "Two things in " if change == Rooms::SWAPPED else "Something in ")
                dstr_append_cstr(out, Rooms::name(run.puzzle.changed.name))
                dstr_append_cstr(out, " has moved. Click it." if change == Rooms::MOVED else
                    (" has gone. Click where it stood." if change == Rooms::GONE else
                    (" have swapped places. Click one." if change == Rooms::SWAPPED else " has changed colour. Click it.")))

    def draw_judgement(list: mutable Display::DisplayList&, run: RoomsGame::Run&):
        can Memory.Allocate, Abort.Panic:
            verdict: mutable dstr = []
            judgement(run, &verdict)
            SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.passed, bytes_view(verdict), 60.0, 16.0)

    def render(list: mutable Display::DisplayList&, run: RoomsGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            SceneHiddenRule::text(list, "Where Was It?", CENTRE, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            SceneHiddenRule::text(list, "Space: next room   then click where it changed   Esc: menu", CENTRE, 26.0, 12.0, ink)
            status: mutable dstr = []
            message(run, &status)
            SceneHiddenRule::text(list, bytes_view(status), CENTRE, 614.0, 14.0, ink)
            if run.phase == RoomsGame::DONE and run.judged_change >= 0:
                draw_judgement(list, run)
            return if run.phase == RoomsGame::READY or run.phase == RoomsGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, run.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, run.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, run.total)
            SceneHiddenRule::text(list, bytes_view(facts), CENTRE, 588.0, 12.0, ink)
            testing: bool = RoomsGame::testing(run)
            level: Rooms::Grade = run.puzzle.level
            cam: RoomsView::Camera = RoomsView::camera(level.cols, level.rows, run.puzzle.angle if testing else 0.0)
            place: Placement = placement(&cam, level, testing)
            floor: f64 = BOTTOM if testing else BOTTOM + BUTTON_H * 1.3
            Display::draw_rect(list, LEFT, floor, WIDTH, BOTTOM + HEIGHT - floor, 0x1c1e24ff if dark else 0xeef0f4ff)
            if not testing:
                Display::draw_rect(list, BUTTON_X, BOTTOM, BUTTON_W, BUTTON_H, 0x2e323aff if dark else 0xe8ebf0ff)
                Display::draw_box(list, BUTTON_X, BOTTOM, BUTTON_W, BUTTON_H, ink, 2.0)
                SceneHiddenRule::text(list, "Ready" if run.stage + 1 == level.rooms else "Next room",
                    CENTRE, BOTTOM + BUTTON_H / 2.0, 13.615, ink)
            room: Rooms::Room& = &run.puzzle.changed if testing else &run.puzzle.rooms[run.stage.usize()]
            picture: RoomsView::Picture = RoomsView::scene(&cam, level.cols, level.rows, room)
            for i in 0..<picture.count |picture, list, place|:
                p: RoomsView::Polygon& = &picture.polygons[i.usize()]
                polygon(list, p, place, 0x22242aff, 0.0)
                polygon(list, p, place, p.colour, 1.3)
            if run.phase == RoomsGame::FLAGGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, false, "Out of time", 60.0, 16.0)
            elif run.phase == RoomsGame::JUDGED:
                for i in 0..<run.puzzle.answer_count |run, cam, level, place, list|:
                    p: RoomsView::Polygon = RoomsView::floor_cell(&cam, level.cols, run.puzzle.answer[i.usize()], 0)
                    outline(list, &p, place, 0x3caa5aff)
                if not run.passed:
                    p: RoomsView::Polygon = RoomsView::floor_cell(&cam, level.cols, run.chosen, 0)
                    outline(list, &p, place, 0xd6403aff)
                draw_judgement(list, run)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Rooms::Grade = Rooms::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.rooms)
            dstr_append_cstr(out, " room of " if level.rooms == 1 else " rooms of ")
            dstr_append_i64(out, level.things)
            dstr_append_cstr(out, " things on ")
            dstr_append_i64(out, level.cols)
            dstr_append_cstr(out, " by ")
            dstr_append_i64(out, level.rows)
            dstr_append_cstr(out, ".")
            if level.shared:
                dstr_append_cstr(out, "  The same things in every room.")
            if level.turn_high > 0.0:
                dstr_append_cstr(out, "  Seen at the test from ")
                dstr_append_i64(out, level.turn_low.i64())
                dstr_append_cstr(out, " to ")
                dstr_append_i64(out, level.turn_high.i64())
                dstr_append_cstr(out, " degrees round.")
