# The common task entry screen for the web shell.
#
# The original task hub launches a task UI first; the task's own Space action
# then starts its first round. This small shell keeps that two-step contract
# for task runners that do not yet have a browser-specific state adapter.
# The scoped 3D N-Back route uses its own controller scene.

module SceneTask:

    struct TaskPaint:
        ink: mutable u32
        muted: mutable u32
        accent: mutable u32
        panel: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> TaskPaint:
        back: i64 = 0 if black_background else 255
        fore: i64 = 255 - back
        panel: u32 = Display::rgba(32, 36, 46, 255) if black_background else Display::rgba(236, 239, 245, 255)
        return TaskPaint{ink: Display::rgba(fore, fore, fore, 255),
                         muted: Display::rgba(fore, fore, fore, 160),
                         accent: Display::rgba(64, 96, 255, 255),
                         panel: panel, width: width, height: height,
                         sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: TaskPaint&,
                 text: sview, x: f64, y: f64, size: f64, color: u32,
                 anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    def put_rect(list: mutable Display::DisplayList&, paint: TaskPaint&,
                 x: f64, y: f64, width: f64, height: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, x / paint.sx, y / paint.sy,
                               width / paint.sx, height / paint.sy, color)

    def render(list: mutable Display::DisplayList&, paint: TaskPaint&,
               category: i64, selected: i64, started: bool):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()
            name: sview = sview(TaskHubTasks::task_name(category, selected), 0, -1)
            category_label: sview = sview(TaskHubTasks::category_name(category), 0, -1)
            put_text(list, paint, name, middle,
                     Geometry::from_top_edge(paint.height, 48.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)
            put_text(list, paint, category_label, middle,
                     Geometry::from_top_edge(paint.height, 82.0).f64(),
                     Geometry::calc_fontsize(paint.height, 14.0), paint.muted,
                     Display::ANCHOR_CENTER_CENTER, false)

            panel_width: f64 = paint.width * 0.62
            panel_height: f64 = paint.height * 0.25
            panel_left: f64 = (paint.width - panel_width) / 2.0
            panel_bottom: f64 = Geometry::from_bottom_edge(paint.height, 220.0).f64()
            put_rect(list, paint, panel_left, panel_bottom,
                     panel_width, panel_height, paint.panel)
            message: sview = sview("Press SPACE or ENTER to start", 0, -1) if not started else sview("Game started", 0, -1)
            put_text(list, paint, message, middle,
                     panel_bottom + panel_height / 2.0,
                     Geometry::calc_fontsize(paint.height, 18.0), paint.accent,
                     Display::ANCHOR_CENTER_CENTER, true)

            put_text(list, paint,
                     sview("Esc: task menu     Space: start", 0, -1),
                     middle, Geometry::from_bottom_edge(paint.height, 36.0).f64(),
                     Geometry::calc_fontsize(paint.height, 12.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)
