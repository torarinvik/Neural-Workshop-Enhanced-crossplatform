include "./tasks/crane_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./geometry.elisa"
include "./verdict.elisa"

module SceneCrane:
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const STEEL: u32 = 0xeeb02aff
    const STEEL_DARK: u32 = 0xb07818ff

    struct Frame:
        x: f64
        y: f64
        s: f64

    def frame() -> Frame:
        can Abort.Panic:
            bottom: f64 = Verdict::above_the_band(HEIGHT, Geometry::from_bottom_edge(HEIGHT, 58.0).f64()).f64()
            top: f64 = Geometry::from_top_edge(HEIGHT, 116.0).f64()
            scale: f64 = fmin(WIDTH * 0.94 / Crane::WIDTH, fmax(40.0, top - bottom) / (Crane::HEIGHT + 2.4))
            return Frame{x: (WIDTH - Crane::WIDTH * scale) / 2.0, y: bottom + 0.9 * scale, s: scale}

    def colour(index: i64) -> u32:
        can Abort.Panic:
            hues: u32[5] = [0xde483cff, 0x3478d6ff, 0x3ca860ff, 0xf09628ff, 0x965cc4ff]
            return hues[index.usize()]

    def crane_rect(list: mutable Display::DisplayList&, f: Frame, x: f64, y: f64, w: f64, h: f64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, f.x + x * f.s, f.y + y * f.s, w * f.s, h * f.s, ink)

    def crane_round(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, r: f64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: x, y: y, w: fmax(1.0, w), h: fmax(1.0, h)}
            ScenePolish::rounded(list, &box, r, ink)

    def harbour_gradient(list: mutable Display::DisplayList&, f: Frame, y: f64, w: f64, h: f64, low: u32, high: u32, bands: i64):
        can Memory.Allocate, Abort.Panic:
            step: f64 = h * f.s / bands.f64()
            for k in 0..<bands |list, f, y, w, low, high, bands, step|:
                ink: u32 = ScenePolish::mix_rgb(low, high, (k.f64() + 0.5) / bands.f64())
                Display::draw_rect(list, f.x, f.y + y * f.s + k.f64() * step, w * f.s, step + 1.0, ink)

    def scenery(list: mutable Display::DisplayList&, f: Frame, yard: Crane::Yard&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            s: f64 = f.s
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: f.x - 6.0, y: f.y - 0.9 * s - 6.0,
                w: Crane::WIDTH * s + 12.0, h: (Crane::HEIGHT + 0.9) * s + 12.0}
            ScenePolish::shadow(list, &box, 14.0, 4.0, dark)
            ScenePolish::rounded(list, &box, 14.0, 0x283246ff)
            harbour_gradient(list, f, 0.0, Crane::WIDTH, Crane::HEIGHT, 0xfac496ff, 0x6e8cc8ff, 24)
            sun_x: f64 = f.x + 30.0 * s
            sun_y: f64 = f.y + 13.0 * s
            ScenePolish::glow(list, sun_x, sun_y, 5.5 * s, 0xffe2a0ff, 120)
            Display::draw_circle(list, sun_x, sun_y, 1.8 * s, 0xffecbeff)
            rng: mutable MT19937 = zeroed
            mt_seed_int(&rng, yard.gust_seed.u64())
            for i in 0..<14 |list, f, rng|:
                x: f64 = 18.0 + i.f64() * 1.9 + py_uniform(&rng, -0.3, 0.3)
                h: f64 = py_uniform(&rng, 2.0, 6.5)
                crane_rect(list, f, x, 0.0, 1.5, h + 1.5, 0x968ca8ff)
            harbour_gradient(list, f, -0.9, 17.0, 3.3, 0x1e548cff, 0x4696c4ff, 6)
            crane_rect(list, f, 17.0, -0.9, Crane::WIDTH - 17.0, 0.9, 0xa8a49eff)
            for i in 0..<yard.bay_count |list, f, yard, s|:
                bay: Crane::Bay = yard.bays[i.usize()]
                ink: u32 = colour(bay.colour)
                half: f64 = Crane::BOX_W / 2.0 + 0.2
                crane_rect(list, f, bay.x - half, -0.55, Crane::BOX_W + 0.4, 0.5, ink)
                for side in [-1, 1] |list, f, bay, half, ink, s|:
                    x: f64 = f.x + (bay.x + side.f64() * half) * s
                    Display::draw_line(list, x, f.y, x, f.y + 1.2 * s, 2.0, (ink & 0xffffff00.u32()) | 160.u32())
            for i in 0..<py_round_half_even(yard.level.wall / Crane::BOX_H) |list, f, yard, s|:
                x: f64 = f.x + (yard.wall_x - 1.6) * s
                y: f64 = f.y + i.f64() * Crane::BOX_H * s
                ink: u32 = 0x787e88ff if i % 2 == 0 else 0x847e88ff
                Display::draw_rect(list, x, y, 3.2 * s, Crane::BOX_H * s - 1.0, ink)
                for j in 1..<7 |list, x, y, s, ink|:
                    xx: f64 = x + j.f64() * 3.2 * s / 7.0
                    Display::draw_line(list, xx, y + 2.0, xx, y + Crane::BOX_H * s - 3.0, 1.0,
                        ScenePolish::mix_rgb(ink, 0x000000ff, 0.15))
            crane_rect(list, f, 0.25, -0.9, 0.7, Crane::RAIL + 1.5, STEEL_DARK)
            crane_rect(list, f, Crane::WIDTH - 0.95, -0.9, 0.7, Crane::RAIL + 1.5, STEEL_DARK)
            crane_rect(list, f, 0.2, Crane::RAIL + 0.15, Crane::WIDTH - 0.4, 0.8, STEEL)
            y: f64 = f.y + (Crane::RAIL + 0.15) * s
            for k in 0..<22 |list, f, y, s|:
                x: f64 = f.x + (0.2 + 2.0 * k.f64()) * s
                Display::draw_line(list, x, y, x + 2.0 * s, y + 0.8 * s, 2.0, STEEL_DARK)

    def ship(list: mutable Display::DisplayList&, f: Frame, run: Crane::Run&):
        can Memory.Allocate, Abort.Panic:
            s: f64 = f.s
            x: f64 = f.x + 1.2 * s
            y: f64 = f.y + (Crane::DECK + Crane::roll(run) - 2.4) * s
            top: f64 = y + 2.4 * s
            Display::begin_polygon(list, 4, x, top, 0x363e50ff)
            Display::polygon_point(list, x, top)
            Display::polygon_point(list, x + 14.6 * s, top)
            Display::polygon_point(list, x + 13.2 * s, y)
            Display::polygon_point(list, x + 1.2 * s, y)
            Display::draw_rect(list, x, y + 2.2 * s, 14.6 * s, 0.25 * s, 0xd6463cff)
            for k in 0..<9 |list, f, run, s|:
                drift: f64 = 2.1 * k.f64() + 0.6 * run.t
                wx: f64 = drift - floor(drift / 17.0) * 17.0
                wy: f64 = 1.8 + 0.25 * sin(run.t * 1.3 + k.f64())
                ScenePolish::arc(list, f.x + wx * s, f.y + wy * s, 0.5 * s, 0.0, 3.141592653589793, 2.0, 0xd2ecfaa0)

    def container(list: mutable Display::DisplayList&, f: Frame, at: Crane::Position, paint: i64, glow: bool):
        can Memory.Allocate, Abort.Panic:
            s: f64 = f.s
            x: f64 = f.x + (at.x - Crane::BOX_W / 2.0) * s
            y: f64 = f.y + at.y * s
            w: f64 = Crane::BOX_W * s
            h: f64 = Crane::BOX_H * s
            ink: u32 = colour(paint)
            if glow:
                ScenePolish::glow(list, x + w / 2.0, y + h / 2.0, w * 0.8, ink, 80)
            Display::draw_rect(list, x, y, w, h, ink)
            rib: u32 = ScenePolish::mix_rgb(ink, 0x000000ff, 0.2)
            for j in 1..<8 |list, x, y, w, h, rib|:
                xx: f64 = x + j.f64() * w / 8.0
                Display::draw_line(list, xx, y + 2.0, xx, y + h - 2.0, 1.0, rib)
            Display::draw_box(list, x, y, w, h, ScenePolish::mix_rgb(ink, 0x000000ff, 0.35), 2.0)

    def trolley(list: mutable Display::DisplayList&, f: Frame, run: Crane::Run&):
        can Memory.Allocate, Abort.Panic:
            s: f64 = f.s
            tx: f64 = f.x + run.x * s
            ty: f64 = f.y + Crane::RAIL * s
            tip: Crane::Position = Crane::hook(run)
            x: f64 = f.x + tip.x * s
            y: f64 = f.y + tip.y * s
            ready: bool = run.held < 0 and Crane::grabbable(run) >= 0
            if ready:
                ScenePolish::glow(list, x, y, 1.2 * s, 0xfff078ff, 120)
            Display::draw_line(list, tx, ty, x, y, 2.0, 0x32323cff)
            crane_round(list, tx - s, ty - 0.2 * s, 2.0 * s, 0.9 * s, 0.15 * s, 0x3c4254ff)
            Display::draw_circle(list, tx - 0.6 * s, ty + 0.75 * s, 0.22 * s, 0x1e1e28ff)
            Display::draw_circle(list, tx + 0.6 * s, ty + 0.75 * s, 0.22 * s, 0x1e1e28ff)
            if run.held >= 0:
                item: Crane::Box = run.yard.boxes[run.held.usize()]
                container(list, f, Crane::Position{x: tip.x, y: tip.y - Crane::BOX_H}, item.colour, false)
                Display::draw_box(list, x - Crane::BOX_W * s / 2.0, f.y + Crane::surface(run, tip.x) * s,
                    Crane::BOX_W * s, 3.0, 0xffffff96, 2.0)
            Display::draw_rect(list, x - 0.45 * s, y, 0.9 * s, 0.35 * s, 0xffdc50ff if ready else 0xf0c83cff)

    def wind_indicator(list: mutable Display::DisplayList&, f: Frame, run: Crane::Run&):
        can Memory.Allocate, Abort.Panic:
            push: f64 = Crane::wind(run)
            lean: f64 = fmax(-1.0, fmin(1.0, push / 1.2))
            for k in 0..<4 |list, f, lean|:
                crane_rect(list, f, Crane::WIDTH - 0.8 + lean * k.f64() * 0.45,
                    Crane::RAIL + 1.2 - (1.0 - fabs(lean)) * k.f64() * 0.3,
                    0.45, 0.3, 0xf05a3cff if k % 2 == 0 else 0xfafafaff)
            if fabs(push) > 0.05:
                direction: f64 = -1.0 if push < 0.0 else 1.0
                s: f64 = f.s
                length: f64 = direction * 1.4 * s * fmin(1.5, fabs(push))
                for k in 0..<10 |list, f, run, direction, s, length|:
                    t: f64 = run.t * 0.35 * direction + k.f64() * 0.1
                    x: f64 = f.x + (t - floor(t)) * Crane::WIDTH * s
                    drift: f64 = k.f64() * 7.3
                    y: f64 = f.y + (4.0 + drift - floor(drift / 16.0) * 16.0) * s
                    Display::draw_line(list, x, y, x - length, y, 1.0, 0xffffff6e)

    def progress(list: mutable Display::DisplayList&, f: Frame, run: Crane::Run&):
        can Memory.Allocate, Abort.Panic:
            s: f64 = f.s
            y: f64 = f.y + (Crane::HEIGHT + 0.3) * s
            for i in 0..<run.yard.level.boxes |list, f, run, s, y|:
                ink: u32 = colour(run.yard.boxes[i.usize()].colour) if run.location[i.usize()] >= 0 else 0xc8ccd6ff
                Display::draw_rect(list, f.x + (1.0 + 1.4 * i.f64()) * s, y, 1.1 * s, 0.7 * s, ink)
            share: f64 = fmax(0.0, 1.0 - run.t / run.yard.level.seconds)
            x: f64 = f.x + (Crane::WIDTH - 14.5) * s
            crane_round(list, x, y, 14.0 * s, 0.7 * s, 0.35 * s, 0xbec4d0ff)
            if share > 0.02:
                crane_round(list, x, y, 14.0 * s * share, 0.7 * s, 0.35 * s,
                    ScenePolish::mix_rgb(0xec5040ff, 0x3cbe78ff, fmin(1.0, share * 1.6)))

    def verdict_text(run: Crane::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            result: i64 = run.result
            if result == Crane::CLEAR:
                dstr_append_cstr(out, "All ")
                dstr_append_i64(out, run.placed)
                dstr_append_cstr(out, " containers in their bays")
            elif result == Crane::HARD_DROP:
                dstr_append_cstr(out, "A container was dropped hard")
            elif result == Crane::WRONG_BAY:
                dstr_append_cstr(out, "Wrong bay for that colour")
            elif result == Crane::OUTSIDE_BAY:
                dstr_append_cstr(out, "Set down outside a bay")
            elif result == Crane::COLLISION:
                dstr_append_cstr(out, "The load struck something")
            elif result == Crane::TIMEOUT:
                dstr_append_cstr(out, "Out of time")

    def crane_text(list: mutable Display::DisplayList&, words: sview, y: f64, size: f64, ink: u32, bold: bool = false):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, words, WIDTH / 2.0, y, size, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def render(list: mutable Display::DisplayList&, session: CraneGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            crane_text(list, "Crane", 648.0, 22.0, ink, true)
            crane_text(list, "Left / Right: trolley   Up / Down: hoist   Space: grab or release   Esc: menu", 26.0, 12.0, ink)
            caption: mutable dstr = []
            verdict_text(&session.run, &caption)
            status: mutable dstr = []
            if session.phase == CraneGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == CraneGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == CraneGame::JUDGED:
                status <- caption
            else:
                dstr_append_cstr(&status, "Each container to the bay of its colour")
            crane_text(list, bytes_view(status), 614.0, 14.0, ink)
            if session.phase == CraneGame::PLAYING or session.phase == CraneGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   ")
                dstr_append_i64(&facts, session.run.placed)
                dstr_append_cstr(&facts, " of ")
                dstr_append_i64(&facts, session.run.yard.level.boxes)
                dstr_append_cstr(&facts, " placed")
                crane_text(list, bytes_view(facts), 588.0, 12.0, ink)
                f: Frame = frame()
                scenery(list, f, &session.run.yard, dark)
                ship(list, f, &session.run)
                for i in 0..<session.run.yard.level.boxes |list, f, session|:
                    at: i64 = session.run.location[i.usize()]
                    if at != Crane::HELD:
                        container(list, f, Crane::box_rect(&session.run, i), session.run.yard.boxes[i.usize()].colour, at >= 0)
                trolley(list, f, &session.run)
                wind_indicator(list, f, &session.run)
                progress(list, f, &session.run)
            if (session.phase == CraneGame::JUDGED or session.phase == CraneGame::DONE) and caption.count > 0:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, session.run.result == Crane::CLEAR,
                    bytes_view(caption), 60.0, 16.0)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Crane::Grade = Crane::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.boxes)
            dstr_append_cstr(out, " containers, ")
            dstr_append_i64(out, level.seconds.i64())
            dstr_append_cstr(out, " s.")
            dstr_append_cstr(out, "  A stack stands in the way.") if level.wall > 0.0
            dstr_append_cstr(out, "  Wind pushes the load.") if level.wind > 0.0
            dstr_append_cstr(out, "  The ship rolls.") if level.roll > 0.0
