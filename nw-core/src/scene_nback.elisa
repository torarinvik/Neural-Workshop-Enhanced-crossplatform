# The n-back presenter: game state in, display list out.
#
# This is the layer that replaces neural_workshop/ui/field.py and its
# neighbours. It computes LAYOUT -- where the grid sits, which cell is lit,
# where the chrome goes -- and emits display-list commands. It never touches a
# renderer, a font, or a window.
#
# Layout follows the original's reference-space geometry: a square field
# centred horizontally, with the board occupying the middle of the window and
# the readouts above and below it.

const FIELD_SIZE: f64 = 340.0
const FIELD_BOTTOM: f64 = 180.0

const FIELD_LEFT: f64 = (Display::REFERENCE_WIDTH - FIELD_SIZE) / 2.0

def color_background() -> u32:
    return Display::rgba(0, 0, 0, 255)

def color_grid() -> u32:
    return Display::rgba(70, 70, 70, 255)

def color_stimulus() -> u32:
    return Display::rgba(0, 132, 255, 255)

def color_chrome() -> u32:
    return Display::rgba(200, 200, 200, 255)

def color_verdict(verdict: i64) -> u32:
    # Codes match matching.elisa's verdict_code: 0 correct, 1 incorrect,
    # 2 missed, 3 unknown.
    if verdict == 0:
        return Display::rgba(0, 200, 0, 255)
    if verdict == 1:
        return Display::rgba(220, 40, 40, 255)
    if verdict == 2:
        return Display::rgba(240, 180, 0, 255)
    return Display::rgba(120, 120, 120, 255)

# Bottom-left corner of cell (col, row) on an n x n board.
def cell_origin_x(col: i64, size: i64) -> f64:
    return FIELD_LEFT + (col.f64() * FIELD_SIZE) / size.f64()

def cell_origin_y(row: i64, size: i64) -> f64:
    # Row 0 is the TOP row in the reference's board numbering, and the display
    # list's origin is bottom-left, so rows count down from the field top.
    return FIELD_BOTTOM + FIELD_SIZE - ((row + 1).f64() * FIELD_SIZE) / size.f64()

def cell_extent(size: i64) -> f64:
    return FIELD_SIZE / size.f64()

# Paint one n-back frame. `position` is a 1-based board position, or <= 0 for
# "no stimulus this tick" (the blank phase). `verdict` is a verdict_code, or
# negative to omit the verdict command entirely -- which is what a trial that
# has not resolved yet must do, since a verdict shown while the player can
# still act is an answer key rather than feedback.
def render_nback_frame(list: mutable Display::DisplayList&, trial: i64, nback: i64, position: i64, verdict: i64):
    can Memory.Allocate, Abort.Panic:
        size: i64 = 3
        extent: f64 = cell_extent(size)

        Display::draw_rect(list, 0.0, 0.0, Display::REFERENCE_WIDTH, Display::REFERENCE_HEIGHT, color_background())

        # The board: an outline plus its interior grid lines.
        Display::draw_box(list, FIELD_LEFT, FIELD_BOTTOM, FIELD_SIZE, FIELD_SIZE, color_grid(), 2.0)
        divider: mutable i64 = 1
        while divider < size |divider, list, extent, size|:
            offset: f64 = divider.f64() * extent
            Display::draw_line(list, FIELD_LEFT + offset, FIELD_BOTTOM, FIELD_LEFT + offset, FIELD_BOTTOM + FIELD_SIZE, 1.0, color_grid())
            Display::draw_line(list, FIELD_LEFT, FIELD_BOTTOM + offset, FIELD_LEFT + FIELD_SIZE, FIELD_BOTTOM + offset, 1.0, color_grid())
            divider <- divider + 1

        # The stimulus square, inset so the grid line stays visible behind it.
        if position > 0:
            col: i64 = classic_3x3_col(position)
            row: i64 = classic_3x3_row(position)
            inset: f64 = extent * 0.12
            Display::draw_rect(list, cell_origin_x(col, size) + inset, cell_origin_y(row, size) + inset, extent - 2.0 * inset, extent - 2.0 * inset, color_stimulus())

        # Chrome: the mode above the board, the trial counter below it.
        Display::draw_text(list, "Dual N-Back", Display::REFERENCE_WIDTH / 2.0, FIELD_BOTTOM + FIELD_SIZE + 40.0, 22.0, color_chrome(), Display::ANCHOR_CENTER_BOTTOM)
        Display::draw_text(list, "N =", 40.0, Display::REFERENCE_HEIGHT - 40.0, 16.0, color_chrome(), Display::ANCHOR_LEFT_TOP)
        Display::draw_text(list, "Trial", 40.0, Display::REFERENCE_HEIGHT - 70.0, 16.0, color_chrome(), Display::ANCHOR_LEFT_TOP)

        # The verdict, only once the trial has resolved.
        if verdict >= 0:
            Display::draw_rect(list, Display::REFERENCE_WIDTH / 2.0 - 60.0, 90.0, 120.0, 30.0, color_verdict(verdict))
            Display::emit_verdict(list, verdict)

        Display::emit_marker(list, "frame-end")
