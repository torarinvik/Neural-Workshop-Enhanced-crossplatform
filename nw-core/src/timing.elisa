# The stateful wrapper around the scheduling kernel.
#
# Port of neural_workshop/timing.py. Scheduling owns the pure millisecond and
# phase arithmetic; this module owns the small mutable config/mode slice that
# the Python module reads and writes.

module Timing:

    struct State:
        tick_ms: mutable i64
        interval_ms: mutable i64
        stimulus_ms: mutable i64
        feedback_ms: mutable i64
        ticks_per_trial: mutable i64

    def tick_duration_ms(state: State&) -> i64:
        return 1 if state.tick_ms < 1 else state.tick_ms

    def trial_interval_ms(state: State&) -> i64:
        can Abort.Panic:
            explicit: i64 = state.interval_ms
            if explicit > 0:
                return clamp_trial_interval_ms(explicit, tick_duration_ms(state), 3, 60000)
            return state.ticks_per_trial * tick_duration_ms(state)

    def set_trial_interval_ms(state: mutable State&, ms: i64) -> i64:
        can Abort.Panic:
            snapped: i64 = clamp_trial_interval_ms(ms, tick_duration_ms(state), 3, 60000)
            state.interval_ms <- snapped
            state.ticks_per_trial <- ms_to_ticks(snapped.f64(), tick_duration_ms(state))
            return snapped

    def apply_trial_interval_override(state: mutable State&):
        if state.interval_ms > 0:
            dropped: i64 = set_trial_interval_ms(state, state.interval_ms)

    def plan_current_trial_phases(state: State&) -> TrialPhases:
        return plan_trial_phases(trial_interval_ms(state), state.stimulus_ms,
                                 state.feedback_ms, tick_duration_ms(state))

    def feedback_tick(state: State&) -> i64:
        plan: TrialPhases = plan_current_trial_phases(state)
        return plan.stimulus_ticks + plan.blank_ticks + 1
