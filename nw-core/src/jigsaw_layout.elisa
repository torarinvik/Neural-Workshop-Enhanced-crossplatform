module JigsawLayout:
    struct TileSpans:
        width: f64
        height: f64
        seam: f64

    def spans(size: f64, columns: i64, rows: i64) -> TileSpans:
        return spans_for(size, size, columns, rows)

    def spans_for(width: f64, height: f64, columns: i64, rows: i64) -> TileSpans:
        horizontal: f64 = width / columns.f64()
        vertical: f64 = height / rows.f64()
        pitch: f64 = horizontal if horizontal < vertical else vertical
        seam: f64 = 2.0 if pitch >= 24.0 else (1.0 if pitch >= 10.0 else 0.0)
        return TileSpans{
            width: (width - seam * (columns - 1).f64()) / columns.f64(),
            height: (height - seam * (rows - 1).f64()) / rows.f64(),
            seam: seam,
        }

    struct PhotoCrop:
        left: i64
        top: i64
        width: i64
        height: i64

    # Pyglet measures its integer image regions from the bottom edge.
    # Convert them to top-down SDL texture coordinates after cutting.
    def photo_crop(width: i64, height: i64, columns: i64, rows: i64, tile: i64) -> PhotoCrop:
        square: i64 = width if width < height else height
        left: i64 = (width - square) / 2
        bottom: i64 = (height - square) / 2
        crop: PhotoCrop = image_crop(square, square, columns, rows, tile)
        return PhotoCrop{left: left + crop.left, top: height - bottom - square + crop.top,
            width: crop.width, height: crop.height}

    def image_crop(width: i64, height: i64, columns: i64, rows: i64, tile: i64) -> PhotoCrop:
        if tile < 0:
            return PhotoCrop{left: 0, top: 0, width: width, height: height}
        tile_width: i64 = width / columns
        tile_height: i64 = height / rows
        return PhotoCrop{
            left: (tile % columns) * tile_width,
            top: height - (rows - tile / columns) * tile_height,
            width: tile_width,
            height: tile_height,
        }
