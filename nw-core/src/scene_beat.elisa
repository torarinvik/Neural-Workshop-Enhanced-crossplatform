include "./tasks/beat_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"

module SceneBeat:
    const CX: f64 = 456.0
    const WIDTH: f64 = 857.28
    const LEFT: f64 = (912.0 - WIDTH) / 2.0
    const BOTTOM: f64 = 179.0
    const HEIGHT: f64 = 389.0
    const FLOOR: f64 = BOTTOM + HEIGHT * 0.24
    const TAU: f64 = 6.283185307179586

    def gradient(list: mutable Display::DisplayList&, y: f64, height: f64, low: u32, high: u32, bands: i64):
        can Memory.Allocate, Abort.Panic:
            step: f64 = height / bands.f64()
            for i in 0..<bands |list, y, step, low, high, bands|:
                colour: u32 = ScenePolish::mix_rgb(low, high, (i.f64() + 0.5) / bands.f64())
                Display::draw_rect(list, LEFT, y + i.f64() * step, WIDTH, step + 1.0, colour)

    def stage(list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT, y: BOTTOM, w: WIDTH, h: HEIGHT}
            alphas: u32[3] = [30.u32(), 18.u32(), 12.u32()]
            for layer in 0..<3 |list, box, alphas|:
                spread: f64 = layer.f64() * 2.0
                shadow: SceneHiddenRule::Rect = ScenePolish::spread_box(&box, spread, 4.0)
                ScenePolish::rounded(list, &shadow, 16.0 + spread, alphas[layer.usize()])
            ScenePolish::rounded(list, &box, 16.0, 0x28141eff)
            gradient(list, BOTTOM, HEIGHT, 0x461e28ff, 0x180e1eff, 20)
            gradient(list, BOTTOM, FLOOR - BOTTOM, 0x6e4628ff, 0x96643cff, 6)
            for i in 0..<14 |list|:
                x: f64 = LEFT + WIDTH * i.f64() / 14.0
                Display::draw_line(list, x, BOTTOM, x + WIDTH * 0.02, FLOOR, 1.0, 0x5a381eff)
            ScenePolish::glow(list, LEFT + WIDTH * 0.32, FLOOR + HEIGHT * 0.3, HEIGHT * 0.45, 0xffdca0ff, 60)

    def metronome(list: mutable Display::DisplayList&, run: Beat::Run&):
        can Memory.Allocate, Abort.Panic:
            song: Beat::Song& = &run.song
            x: f64 = LEFT + WIDTH * 0.32
            height: f64 = HEIGHT * 0.55
            width: f64 = height * 0.55
            hidden: bool = run.time > Beat::LEAD and Beat::curtain(song, run.time)
            last: i64 = Beat::last_beat(song, run.time)
            since: f64 = run.time - song.times[last.usize()] if last >= 0 else 9.0
            flash: f64 = 1.0 - since / 0.15 if not hidden and since < 0.15 else 0.0
            Display::begin_polygon(list, 4, x - width / 2.0, FLOOR, 0x96542cff)
            Display::polygon_point(list, x - width / 2.0, FLOOR)
            Display::polygon_point(list, x + width / 2.0, FLOOR)
            Display::polygon_point(list, x + width * 0.16, FLOOR + height)
            Display::polygon_point(list, x - width * 0.16, FLOOR + height)
            Display::begin_polygon(list, 4, x - width * 0.32, FLOOR + height * 0.12, 0xecdcbeff)
            Display::polygon_point(list, x - width * 0.32, FLOOR + height * 0.12)
            Display::polygon_point(list, x + width * 0.32, FLOOR + height * 0.12)
            Display::polygon_point(list, x + width * 0.1, FLOOR + height * 0.88)
            Display::polygon_point(list, x - width * 0.1, FLOOR + height * 0.88)
            angle: mutable f64 = 0.0
            if last >= 0 and last + 1 < song.count:
                span: f64 = song.times[(last + 1).usize()] - song.times[last.usize()]
                angle <- (0.42 if last % 2 != 0 else -0.42) * cos(since / span * TAU / 2.0)
            pivot: f64 = FLOOR + height * 0.18
            sine: f64 = sin(angle)
            cosine: f64 = cos(angle)
            lamp: u32 = 0xffe678ff if last >= 0 and last % song.level.cycle == 0 else 0xff8c5aff
            light_y: f64 = FLOOR + height + 18.0
            ScenePolish::glow(list, x, light_y, 40.0 + 30.0 * flash, lamp, (40.0 + 160.0 * flash).i64())
            Display::draw_line(list, x, pivot, x + sine * height * 0.7, pivot + cosine * height * 0.7, 5.0, 0x3c323cff)
            Display::draw_rect(list, x + sine * height * 0.45 - 9.0, pivot + cosine * height * 0.45 - 6.0, 18.0, 12.0, 0xc8aa50ff)
            Display::draw_circle(list, x, light_y, 11.0, ScenePolish::mix_rgb(0x5a3c32ff, lamp, flash))
            if hidden:
                curtain: f64 = width * 1.5
                for i in 0..<7 |list, x, curtain, height|:
                    colour: u32 = ScenePolish::mix_rgb(0x781024ff, 0xaa1e34ff, 0.5 + 0.5 * sin(i.f64() * 1.7))
                    Display::draw_rect(list, x - curtain / 2.0 + curtain * i.f64() / 7.0, FLOOR,
                        curtain / 7.0 + 1.0, height + 50.0, colour)
                Display::draw_text_weight(list, "keep it going", x, FLOOR + height * 0.5, 16.0, 0xffe6c8e6, Display::ANCHOR_CENTER_CENTER, true)

    def ellipse(list: mutable Display::DisplayList&, x: f64, y: f64, rx: f64, ry: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            Display::begin_polygon(list, 48, x + rx, y, colour)
            for i in 0..<48 |list, x, y, rx, ry|:
                angle: f64 = TAU * i.f64() / 48.0
                Display::polygon_point(list, x + rx * cos(angle), y + ry * sin(angle))

    def drum(list: mutable Display::DisplayList&, run: Beat::Run&):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            x: f64 = LEFT + WIDTH * 0.7
            y: f64 = FLOOR + HEIGHT * 0.12
            radius: f64 = HEIGHT * 0.14
            last: f64 = Beat::tap_time(run, run.tap_count - 1)
            age: f64 = run.time - last
            boom: f64 = 1.0 - age / 0.2 if last >= 0.0 and age < 0.2 else 0.0
            ellipse(list, x, y - radius * 0.5, radius, radius * 0.4, 0xa02828ff)
            Display::draw_rect(list, x - radius, y - radius * 0.5, radius * 2.0, radius * 0.5, 0xbe3232ff)
            ellipse(list, x, y, radius, radius * 0.4, ScenePolish::mix_rgb(0xf0e6d2ff, 0xffffffff, boom))
            if boom > 0.0:
                ScenePolish::arc(list, x, y, radius * (1.1 + 0.5 * (1.0 - boom)), 0.0, TAU,
                    3.0, 0xffe6a000 | (220.0 * boom).u32())

    def strip_x(time: f64, first: f64, span: f64) -> f64:
        share: f64 = (time - first) / span
        return LEFT + WIDTH * 0.06 + WIDTH * 0.88 * (0.0 if share < 0.0 else (1.0 if share > 1.0 else share))

    def strip(list: mutable Display::DisplayList&, run: Beat::Run&):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            song: Beat::Song& = &run.song
            first: f64 = song.times[song.intro.usize()] - 1.5
            span: f64 = song.end - first
            y: f64 = BOTTOM + (FLOOR - BOTTOM) * 0.35
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT + WIDTH * 0.06, y: y - 8.0, w: WIDTH * 0.88, h: 16.0}
            ScenePolish::rounded(list, &box, 8.0, 0x3c2218ff)
            if run.result != Beat::PENDING:
                for i in song.intro..<song.count |list, song, first, span, y|:
                    continue if Beat::heard(song, i)
                    beat: f64 = song.times[i.usize()]
                    low: f64 = strip_x(beat - song.level.window, first, span)
                    high: f64 = strip_x(beat + song.level.window, first, span)
                    x: f64 = strip_x(beat, first, span)
                    Display::draw_rect(list, low, y - 8.0, high - low, 16.0, 0x5ac87896)
                    Display::draw_line(list, x, y - 11.0, x, y + 11.0, 2.0, 0x8cffaaff)
            for i in 0..<run.tap_count |run, first, span, y, list|:
                tap: f64 = Beat::tap_time(run, i)
                if tap >= first:
                    Display::draw_circle(list, strip_x(tap, first, span), y, 5.0, 0xffdc78ff)

    def render(list: mutable Display::DisplayList&, session: BeatGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Keep the Beat", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Space: tap   tap along, then keep the beat going when the curtain falls   Esc: menu",
                CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            msg: mutable dstr = []
            if session.phase == BeatGame::READY:
                dstr_append_cstr(&msg, "Press Space or click to start")
            elif session.phase == BeatGame::DONE:
                dstr_append_i64(&msg, session.passed_count)
                dstr_append_cstr(&msg, " of ")
                dstr_append_i64(&msg, session.trial)
                dstr_append_cstr(&msg, " passed   highest rung passed ")
                dstr_append_i64(&msg, session.best_rung)
            elif session.phase == BeatGame::JUDGED:
                Beat::result_text(&session.run, &msg)
            else:
                dstr_append_cstr(&msg, "Tap along -- then keep it going on your own")
            Display::draw_text(list, bytes_view(msg), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if session.phase >= BeatGame::JUDGED and session.run.result != Beat::PENDING:
                verdict: mutable dstr = []
                Beat::result_text(&session.run, &verdict)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.run.result == Beat::PASSED, bytes_view(verdict), 60.0, 16.0)
            return if session.phase == BeatGame::READY or session.phase == BeatGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, session.run.song.judged)
            dstr_append_cstr(&facts, " beats to keep   ")
            dstr_append_i64(&facts, session.run.tap_count)
            dstr_append_cstr(&facts, " taps")
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            stage(list)
            metronome(list, &session.run)
            drum(list, &session.run)
            strip(list, &session.run)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Beat::Grade = Beat::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": carry ")
            dstr_append_i64(out, Beat::whole_cycles(level.silent, level.cycle))
            dstr_append_cstr(out, " beats, with a ")
            dstr_append_i64(out, py_round_half_even(level.window * 1000.0))
            dstr_append_cstr(out, " ms window")
            dstr_append_cstr(out, " and a metronome reprise" if level.reprise else "")
            dstr_append_cstr(out, ".")
