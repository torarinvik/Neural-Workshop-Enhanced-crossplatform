include "./tasks/glider_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"

module SceneGlider:
    const CX: f64 = 456.0
    const BOTTOM: f64 = 179.0
    const HEIGHT: f64 = 389.0
    const SCALE: f64 = HEIGHT / Glider::HEIGHT
    const WIDTH: f64 = Glider::WIDTH * SCALE
    const LEFT: f64 = CX - WIDTH / 2.0

    struct Point:
        x: f64
        y: f64

    def scenery(list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT - 6.0, y: BOTTOM - 6.0, w: WIDTH + 12.0, h: HEIGHT + 12.0}
            alphas: u32[3] = [30.u32(), 18.u32(), 12.u32()]
            for layer in 0..<3 |list, box, alphas|:
                spread: f64 = layer.f64() * 2.0
                shadow: SceneHiddenRule::Rect = ScenePolish::spread_box(&box, spread, 4.0)
                ScenePolish::rounded(list, &shadow, 14.0 + spread, alphas[layer.usize()])
            ScenePolish::rounded(list, &box, 14.0, 0x3c1e1eff)
            for band in 0..<24 |list|:
                colour: u32 = ScenePolish::mix_rgb(0xfaaa64ff, 0x5a3c8cff, (band.f64() + 0.5) / 24.0)
                Display::draw_rect(list, LEFT, BOTTOM + band.f64() * HEIGHT / 24.0, WIDTH, HEIGHT / 24.0 + 1.0, colour)
            ScenePolish::glow(list, LEFT + WIDTH * 0.8, BOTTOM + HEIGHT * 0.3, HEIGHT * 0.3, 0xffdc96ff, 90)
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, 5.u64())
            x: mutable f64 = 0.0
            while x < Glider::WIDTH |rng, x, list|:
                w: f64 = 8.0 + 8.0 * py_random(&rng)
                h: f64 = 8.0 + 12.0 * py_random(&rng)
                end: f64 = SceneHiddenRule::minimum(Glider::WIDTH, x + w)
                start: f64 = LEFT + x * SCALE
                Display::begin_polygon(list, 4, start, BOTTOM, 0x965050ff)
                Display::polygon_point(list, start, BOTTOM)
                Display::polygon_point(list, LEFT + SceneHiddenRule::minimum(end, x + w * 0.2) * SCALE, BOTTOM + h * SCALE)
                Display::polygon_point(list, LEFT + SceneHiddenRule::minimum(end, x + w * 0.8) * SCALE, BOTTOM + h * SCALE)
                Display::polygon_point(list, LEFT + end * SCALE, BOTTOM)
                x <- x + w * 0.8

    def rock(list: mutable Display::DisplayList&, left: f64, right: f64, y: f64, height: f64):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, left, y, right - left, height, 0xc86e46ff)
            for k in 0..<((height / (2.5 * SCALE)).i64() + 1) |list, left, right, y, height|:
                layer: f64 = y + k.f64() * 2.5 * SCALE
                if layer < y + height:
                    Display::draw_line(list, left, layer, right, layer, 1.0, 0xaa5638ff)

    def walls(list: mutable Display::DisplayList&, run: Glider::Run&):
        can Memory.Allocate, Abort.Panic:
            course: Glider::Course& = &run.course
            for i in 0..<course.level.count |list, course, run|:
                wall: Glider::Wall = course.walls[i.usize()]
                x: f64 = Glider::wall_x(course, wall, run.time)
                gx: f64 = LEFT + (x - Glider::WALL / 2.0) * SCALE
                left: f64 = LEFT if gx < LEFT else gx
                right: f64 = SceneHiddenRule::minimum(LEFT + WIDTH, gx + Glider::WALL * SCALE)
                if right <= left:
                    continue
                centre: f64 = Glider::gap_centre(course, wall, run.time)
                low: f64 = (centre - course.level.gap / 2.0) * SCALE
                high: f64 = (centre + course.level.gap / 2.0) * SCALE
                rock(list, left, right, BOTTOM, low)
                rock(list, left, right, BOTTOM + high, HEIGHT - high)
                Display::draw_rect(list, left - 2.0, BOTTOM + low - 3.0, right - left + 4.0, 6.0, 0x783c28ff)
                Display::draw_rect(list, left - 2.0, BOTTOM + high - 3.0, right - left + 4.0, 6.0, 0x783c28ff)
            if course.level.gust != 0.0:
                dust: f64 = Glider::gust(course, run.time)
                for k in 0..<12 |list, run, dust|:
                    dx: f64 = k.f64() * 9.0 - run.time * 30.0
                    dy: f64 = k.f64() * 13.0 + run.time * dust * 2.0
                    x: f64 = dx - Glider::WIDTH * floor(dx / Glider::WIDTH)
                    y: f64 = dy - Glider::HEIGHT * floor(dy / Glider::HEIGHT)
                    Display::draw_line(list, LEFT + x * SCALE, BOTTOM + y * SCALE,
                        LEFT + (x + 4.0) * SCALE, BOTTOM + (y + dust * 0.12) * SCALE, 1.0, 0xfff0d26e)

    def wing(y: f64, u: f64, v: f64, c: f64, s: f64) -> Point:
        return Point{x: LEFT + (Glider::X + u * c - v * s) * SCALE, y: BOTTOM + (y + u * s + v * c) * SCALE}

    def craft(list: mutable Display::DisplayList&, run: Glider::Run&):
        can Memory.Allocate, Abort.Panic:
            course: Glider::Course& = &run.course
            for i in 0..<run.trail_count |run, course, list|:
                p: Glider::Point = run.trail[((run.trail_next + 24 - run.trail_count + i) % 24).usize()]
                x: f64 = Glider::X - (run.time - p.time) * course.level.speed
                if x > 0.0:
                    Display::draw_circle(list, LEFT + x * SCALE, BOTTOM + p.y * SCALE, 0.3 * SCALE, 0xffffff8c)
            velocity: f64 = run.vy / 40.0
            tilt: f64 = -0.6 if velocity < -0.6 else SceneHiddenRule::minimum(velocity, 0.6)
            c: f64 = cos(tilt)
            s: f64 = sin(tilt)
            if run.lifting:
                glow: Point = wing(run.y, -2.6, 0.0, c, s)
                ScenePolish::glow(list, glow.x, glow.y, 1.6 * SCALE, 0xffe696ff, 90)
            nose: Point = wing(run.y, 3.0, 0.0, c, s)
            fold: Point = wing(run.y, -1.4, 0.0, c, s)
            top: Point = wing(run.y, -2.4, 1.6, c, s)
            low: Point = wing(run.y, -2.4, -1.4, c, s)
            Display::draw_triangle(list, nose.x, nose.y, top.x, top.y, fold.x, fold.y, 0xfafaffff)
            Display::draw_triangle(list, nose.x, nose.y, low.x, low.y, fold.x, fold.y, 0xc8d2f0ff)
            for i in 0..<course.level.count |list, course, run|:
                x: f64 = CX + (i.f64() - (course.level.count - 1).f64() / 2.0) * 2.6 * SCALE
                Display::draw_circle(list, x, BOTTOM + HEIGHT - 2.0 * SCALE, 0.8 * SCALE,
                    0x78e696ff if i < run.passed else 0xffffff78)

    def render(list: mutable Display::DisplayList&, session: GliderGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Glider", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "hold Space (or Up) to climb, let go to sink   Esc: menu",
                CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            msg: mutable dstr = []
            if session.phase == GliderGame::READY:
                dstr_append_cstr(&msg, "Press Space or click to start")
            elif session.phase == GliderGame::DONE:
                dstr_append_i64(&msg, session.passed_count)
                dstr_append_cstr(&msg, " of ")
                dstr_append_i64(&msg, session.trial)
                dstr_append_cstr(&msg, " passed   highest rung passed ")
                dstr_append_i64(&msg, session.best_rung)
            elif session.phase == GliderGame::JUDGED:
                Glider::result_text(&session.run, &msg)
            else:
                dstr_append_cstr(&msg, "Thread every gap")
            Display::draw_text(list, bytes_view(msg), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if session.phase >= GliderGame::JUDGED and session.run.result != Glider::PENDING:
                verdict: mutable dstr = []
                Glider::result_text(&session.run, &verdict)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.run.result == Glider::PASSED, bytes_view(verdict), 60.0, 16.0)
            return if session.phase == GliderGame::READY or session.phase == GliderGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_cstr(&facts, "wall ")
            count: i64 = session.run.course.level.count
            dstr_append_i64(&facts, session.run.passed + 1 if session.run.passed < count else count)
            dstr_append_cstr(&facts, " of ")
            dstr_append_i64(&facts, count)
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            scenery(list)
            walls(list, &session.run)
            craft(list, &session.run)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Glider::Grade = Glider::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.count)
            dstr_append_cstr(out, " walls with ")
            dstr_append_fixed(out, level.gap, 1)
            dstr_append_cstr(out, " unit gaps")
            dstr_append_cstr(out, ", moving gaps" if level.slide != 0.0 else "")
            dstr_append_cstr(out, ", gusts" if level.gust != 0.0 else "")
            dstr_append_cstr(out, ".")
