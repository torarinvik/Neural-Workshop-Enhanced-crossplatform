include "./tasks/beliefs.elisa"
include "./strings.elisa"

module BeliefsText:
    def person(index: i64) -> cstr:
        return "Ann" if index == 0
        return "Ben" if index == 1
        return "Cleo" if index == 2
        return "Dev" if index == 3
        return "Esme"

    def container(index: i64) -> cstr:
        return "basket" if index == 0
        return "box" if index == 1
        return "drawer" if index == 2
        return "cupboard"

    def thing(index: i64) -> cstr:
        return "ball" if index == 0
        return "key" if index == 1
        return "apple"

    def named(story: Beliefs::Story&, index: i64) -> cstr:
        can Abort.Panic:
            return person(story.names[index.usize()])

    def caption(story: Beliefs::Story&, e: Beliefs::Event, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            dstr_append_cstr(out, named(story, e.who))
            if e.kind == Beliefs::LEAVE or e.kind == Beliefs::ENTER:
                dstr_append_cstr(out, " goes out." if e.kind == Beliefs::LEAVE else " comes back in.")
                return
            if e.kind == Beliefs::CALL or e.kind == Beliefs::LIE:
                dstr_append_cstr(out, " phones ")
                dstr_append_cstr(out, named(story, e.other))
                dstr_append_cstr(out, ": \"The ")
                dstr_append_cstr(out, thing(e.thing))
                dstr_append_cstr(out, " is in the ")
                dstr_append_cstr(out, container(e.where))
                dstr_append_cstr(out, ".\"")
                return
            if e.kind == Beliefs::PEEK:
                dstr_append_cstr(out, " peeks into the ")
            else:
                dstr_append_cstr(out, " puts the " if e.kind == Beliefs::PUT else " moves the ")
                dstr_append_cstr(out, thing(e.thing))
                dstr_append_cstr(out, " in the " if e.kind == Beliefs::PUT else " to the ")
            dstr_append_cstr(out, container(e.where))
            dstr_append_cstr(out, ".")

    def question(story: Beliefs::Story&, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            q: Beliefs::Question = story.question
            if q.kind == Beliefs::TRUTH:
                dstr_append_cstr(out, "Where is the ")
                dstr_append_cstr(out, thing(q.thing))
                dstr_append_cstr(out, " really?")
                return
            dstr_append_cstr(out, "Where will " if q.kind == Beliefs::FIRST else "Where does ")
            dstr_append_cstr(out, named(story, q.who))
            if q.kind == Beliefs::SECOND:
                dstr_append_cstr(out, " think ")
                dstr_append_cstr(out, named(story, q.other))
                dstr_append_cstr(out, " will")
            dstr_append_cstr(out, " look for the ")
            dstr_append_cstr(out, thing(q.thing))
            dstr_append_cstr(out, "?")

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: Beliefs::Grade = Beliefs::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.people)
            dstr_append_cstr(out, " people, ")
            dstr_append_i64(out, level.containers)
            dstr_append_cstr(out, " containers, ")
            dstr_append_i64(out, level.things)
            dstr_append_cstr(out, " thing, " if level.things == 1 else " things, ")
            dstr_append_i64(out, level.short)
            dstr_append_cstr(out, " to ")
            dstr_append_i64(out, level.long)
            dstr_append_cstr(out, " events.")
            if level.second > 0.0:
                dstr_append_cstr(out, "  With second-order questions")
                if level.calls:
                    dstr_append_cstr(out, ", phone calls")
                if level.lies:
                    dstr_append_cstr(out, ", lies")
                if level.peeks:
                    dstr_append_cstr(out, ", peeks")
                dstr_append_cstr(out, ".")
