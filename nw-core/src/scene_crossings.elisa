include "./tasks/crossings_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"

module SceneCrossings:
    const WIDTH: f64 = 857.28
    const HEIGHT: f64 = 389.0
    const BOTTOM: f64 = 179.0
    const CX: f64 = 456.0
    const BUTTON_HEIGHT: f64 = HEIGHT * 0.13
    const BUTTON_GAP: f64 = WIDTH * 0.012

    def button(port: i64, count: i64) -> SceneHiddenRule::Rect:
        w: f64 = SceneHiddenRule::minimum(WIDTH * 0.3, (WIDTH - BUTTON_GAP * (count - 1).f64()) / count.f64())
        row: f64 = w * count.f64() + BUTTON_GAP * (count - 1).f64()
        return SceneHiddenRule::Rect{x: CX - row / 2.0 + port.f64() * (w + BUTTON_GAP), y: BOTTOM, w: w, h: BUTTON_HEIGHT}

    def hit(run: CrossingsGame::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return CrossingsGame::START if run.phase == CrossingsGame::READY or run.phase == CrossingsGame::DONE
            return -1 if run.phase != CrossingsGame::PLAYING
            count: i64 = CrossingsGame::choices(&run.puzzle)
            for port in 0..<count |count, x, y|:
                rect: SceneHiddenRule::Rect = button(port, count)
                return port if x >= rect.x and x <= rect.x + rect.w and y >= rect.y and y <= rect.y + rect.h
            return -1

    def paint_buttons(list: mutable Display::DisplayList&, run: CrossingsGame::Run&, ink: u32, dark: bool):
        can Memory.Allocate, Abort.Panic:
            paper: u32 = 0x2e323aff if dark else 0xe8ebf0ff
            count: i64 = CrossingsGame::choices(&run.puzzle)
            for port in 0..<count |list, run, ink, paper, count|:
                rect: SceneHiddenRule::Rect = button(port, count)
                border: mutable u32 = ink
                if run.phase == CrossingsGame::JUDGED:
                    if port == run.puzzle.answer:
                        border <- 0x3caa5aff
                    elif port == run.chosen:
                        border <- 0xd6403aff
                Display::draw_bordered_rect(list, rect.x, rect.y, rect.w, rect.h, paper, border, 2.0 if border == ink else 5.0)
                label: mutable dstr = []
                dstr_append_i64(&label, port + 1)
                dstr_append_cstr(&label, "  ")
                dstr_append_i64(&label, port)
                Display::draw_text(list, bytes_view(label), rect.x + rect.w / 2.0, rect.y + rect.h / 2.0,
                    14.0, ink, Display::ANCHOR_CENTER_CENTER)

    def judgement(run: CrossingsGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_cstr(out, "Right: " if run.passed else "No: ")
            dstr_append_i64(out, run.puzzle.answer)

    def message(run: CrossingsGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == CrossingsGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif run.phase == CrossingsGame::DONE:
                dstr_append_i64(out, run.passed_count)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, run.scored_count)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, run.best_rung)
            elif run.phase == CrossingsGame::JUDGED:
                judgement(run, out)
            else:
                dstr_append_cstr(out, "How many times does the red line cross the blue line?")

    def render(list: mutable Display::DisplayList&, run: CrossingsGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Crossings", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "0-6 or click: how many crossings   Esc: menu", CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            status: mutable dstr = []
            message(run, &status)
            Display::draw_text(list, bytes_view(status), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if run.has_verdict:
                verdict: mutable dstr = []
                judgement(run, &verdict)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.passed, bytes_view(verdict), 60.0, 16.0)
            if run.phase == CrossingsGame::FLAGGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, false, "Out of time", 60.0, 16.0)
            return if run.phase == CrossingsGame::READY or run.phase == CrossingsGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, run.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, run.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, run.total)
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            paint_puzzle(list, run, dark)
            paint_buttons(list, run, ink, dark)

    def paint_line(list: mutable Display::DisplayList&, line: Crossings::Line&, x: f64, y: f64,
                   scale: f64, thick: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            first: Crossings::Point = line.points[0.usize()]
            old_x: mutable f64 = x + first.x * scale
            old_y: mutable f64 = y + first.y * scale
            Display::draw_circle(list, old_x, old_y, thick * 1.2, colour)
            for i in 1..<line.count |list, line, x, y, scale, thick, colour, old_x, old_y|:
                point: Crossings::Point = line.points[i.usize()]
                px: f64 = x + point.x * scale
                py: f64 = y + point.y * scale
                Display::draw_line(list, old_x, old_y, px, py, thick, colour)
                Display::draw_circle(list, px, py, thick / 2.0, colour)
                old_x <- px
                old_y <- py
            Display::draw_circle(list, old_x, old_y, thick * 1.2, colour)

    def paint_puzzle(list: mutable Display::DisplayList&, run: CrossingsGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            h: f64 = HEIGHT - BUTTON_HEIGHT - HEIGHT * 0.03
            scale: f64 = h / Crossings::HEIGHT
            w: f64 = Crossings::WIDTH * scale
            x: f64 = CX - w / 2.0
            y: f64 = BOTTOM + HEIGHT - h
            paper: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: x, y: y, w: w, h: h}
            ScenePolish::card_face(list, &paper, 12.0, 0xfcfcf6ff, 0xc8cedcff, 0.u32(), dark)
            step: f64 = 5.0 * scale
            for i in 1..<20 |list, x, y, h, step|:
                at: f64 = x + i.f64() * step
                Display::draw_line(list, at, y + 2.0, at, y + h - 2.0, 1.0, 0xbed2ec78)
            for i in 1..<13 |list, x, y, w, step|:
                at: f64 = y + i.f64() * step
                Display::draw_line(list, x + 2.0, at, x + w - 2.0, at, 1.0, 0xbed2ec78)
            thick: f64 = scale * 0.7 if scale * 0.7 > 3.0 else 3.0
            for i in 0..<run.puzzle.level.decoys |list, run, x, y, scale, thick|:
                paint_line(list, &run.puzzle.decoys[i.usize()], x, y, scale, thick, 0x28a85aff)
            paint_line(list, &run.puzzle.blue, x, y, scale, thick, 0x286ee6ff)
            paint_line(list, &run.puzzle.red, x, y, scale, thick, 0xe23a46ff)
            if run.phase == CrossingsGame::JUDGED:
                for i in 0..<run.puzzle.hits.count |list, run, x, y, scale, thick|:
                    p: Crossings::Point = run.puzzle.hits.points[i.usize()]
                    ScenePolish::ring(list, x + p.x * scale, y + p.y * scale, thick * 3.0, 3.0, 0xfab41eff, 48)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Crossings::Grade = Crossings::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": up to ")
            dstr_append_i64(out, level.most)
            dstr_append_cstr(out, " crossings.")
            if level.decoys > 0:
                dstr_append_cstr(out, "  ")
                dstr_append_i64(out, level.decoys)
                dstr_append_cstr(out, " decoy line(s).")
