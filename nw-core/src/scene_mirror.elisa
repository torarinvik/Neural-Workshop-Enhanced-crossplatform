include "./tasks/mirror_game.elisa"
include "./mirror_view.elisa"
include "./scene_rooms.elisa"

module SceneMirror:
    const LEFT: f64 = 27.36
    const WIDTH: f64 = 857.28
    const BOTTOM: f64 = 179.0
    const HEIGHT: f64 = 389.0
    const CX: f64 = 456.0
    const BUTTON_H: f64 = HEIGHT * 0.13
    const PAIR_Y: f64 = BOTTOM + HEIGHT * 0.16
    const PAIR_H: f64 = HEIGHT * 0.84
    const GAP: f64 = WIDTH * 0.012

    struct Cards:
        left: f64
        width: f64
        height: f64

    def cards(count: i64, pair: bool) -> Cards:
        can Abort.Panic:
            split: f64 = (WIDTH - GAP * (count - 1).f64()) / count.f64()
            limit: f64 = WIDTH * 0.3 if pair else HEIGHT * 0.6
            width: f64 = split if split < limit else limit
            return Cards{left: CX - (width * count.f64() + GAP * (count - 1).f64()) / 2.0,
                width: width, height: BUTTON_H if pair else HEIGHT * 0.52}

    def hit(run: MirrorGame::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return MirrorGame::START if run.phase == MirrorGame::READY or run.phase == MirrorGame::DONE
            return -1 if run.phase != MirrorGame::PLAYING
            count: i64 = Mirror::choices(&run.puzzle)
            panel: Cards = cards(count, run.puzzle.count == 1)
            return -1 if y < BOTTOM or y > BOTTOM + panel.height
            for i in 0..<count |panel, x|:
                left: f64 = panel.left + i.f64() * (panel.width + GAP)
                return i if x >= left and x <= left + panel.width
            return -1

    def judgement(run: MirrorGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_cstr(out, "Right: " if run.passed else "No: ")
            if run.puzzle.count == 1:
                dstr_append_cstr(out, "Same" if run.puzzle.answer == Mirror::SAME else "Mirror")
            else:
                dstr_append_i64(out, run.puzzle.answer + 1)

    def message(run: MirrorGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == MirrorGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif run.phase == MirrorGame::DONE:
                dstr_append_i64(out, run.passed_count)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, run.scored_count)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, run.best_rung)
            elif run.phase == MirrorGame::JUDGED:
                judgement(run, out)
            else:
                dstr_append_cstr(out, "The same figure turned, or its mirror image?" if run.puzzle.count == 1
                    else "Which of the row is the same figure as the one on top?")

    def figure(list: mutable Display::DisplayList&, f: Mirror::Figure&, lit: bool, x: f64, y: f64, w: f64, h: f64, reach: f64):
        can Memory.Allocate, Abort.Panic:
            picture: RoomsView::Picture = MirrorView::scene(f, lit)
            scale: f64 = (w if w < h else h) * 0.46 / reach
            place: SceneRooms::Placement = SceneRooms::Placement{x: x + w / 2.0, y: y + h / 2.0, scale: scale}
            rim: f64 = scale * 0.04 if scale * 0.04 > 1.2 else 1.2
            for i in 0..<picture.count |picture, place, rim, list|:
                p: RoomsView::Polygon& = &picture.polygons[i.usize()]
                SceneRooms::polygon(list, p, place, 0x22242aff, 0.0)
                SceneRooms::polygon(list, p, place, p.colour, rim)

    def mark(run: MirrorGame::Run&, index: i64, ink: u32) -> u32:
        return ink if run.phase != MirrorGame::JUDGED
        return 0x3caa5aff if index == run.puzzle.answer
        return 0xd6403aff if index == run.chosen
        return ink

    def play(list: mutable Display::DisplayList&, run: MirrorGame::Run&, ink: u32, dark: bool):
        can Memory.Allocate, Abort.Panic:
            puzzle: Mirror::Puzzle& = &run.puzzle
            lit: bool = puzzle.level.lit
            reach: mutable f64 = MirrorView::radius(&puzzle.reference.shape)
            for i in 0..<puzzle.count |puzzle, reach|:
                r: f64 = MirrorView::radius(&puzzle.others[i.usize()].shape)
                reach <- r if r > reach
            pair: bool = puzzle.count == 1
            answer_count: i64 = Mirror::choices(puzzle)
            panel: Cards = cards(answer_count, pair)
            if pair:
                figure(list, &puzzle.reference, lit, LEFT, PAIR_Y, WIDTH / 2.0, PAIR_H, reach)
                figure(list, &puzzle.others[0], lit, CX, PAIR_Y, WIDTH / 2.0, PAIR_H, reach)
                Display::draw_rect(list, CX - 1.0, PAIR_Y + PAIR_H * 0.1, 2.0, PAIR_H * 0.8, 0xbec2caff)
                if run.phase == MirrorGame::JUDGED:
                    note: mutable dstr = []
                    dstr_append_i64(&note, py_round_half_even(puzzle.angles[0]))
                    dstr_append_cstr(&note, " degrees apart")
                    Display::draw_text(list, bytes_view(note), CX, PAIR_Y + 4.0, 12.0, ink, Display::ANCHOR_CENTER_BOTTOM)
            else:
                top: f64 = HEIGHT * 0.44
                figure(list, &puzzle.reference, lit, CX - top * 0.7, BOTTOM + HEIGHT - top, top * 1.4, top, reach)
            for i in 0..<answer_count |run, puzzle, list, lit, reach, pair, panel, ink, dark|:
                left: f64 = panel.left + i.f64() * (panel.width + GAP)
                border: u32 = mark(run, i, ink)
                back: u32 = 0x2e323aff if dark else (0xe8ebf0ff if pair else 0xf7f8fbff)
                Display::draw_rect(list, left, BOTTOM, panel.width, panel.height, back)
                Display::draw_box(list, left, BOTTOM, panel.width, panel.height, border, 2.0 if border == ink else 5.0)
                if pair:
                    label: sview = "1  Same" if i == 0 else "2  Mirror"
                    Display::draw_text(list, label, left + panel.width / 2.0, BOTTOM + panel.height / 2.0,
                        14.0, ink, Display::ANCHOR_CENTER_CENTER)
                else:
                    label: mutable dstr = []
                    dstr_append_i64(&label, i + 1)
                    Display::draw_text_weight(list, bytes_view(label), left + 8.0, BOTTOM + panel.height - 8.0,
                        13.0, ink, Display::ANCHOR_LEFT_TOP, true)
                    figure(list, &puzzle.others[i.usize()], lit, left, BOTTOM, panel.width, panel.height, reach)

    def render(list: mutable Display::DisplayList&, run: MirrorGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Same or Mirror?", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "S: same   M: mirror   or click; from rung 13 click the match or press its number   Esc: menu",
                CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            status: mutable dstr = []
            message(run, &status)
            Display::draw_text(list, bytes_view(status), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if run.has_verdict:
                verdict: mutable dstr = []
                judgement(run, &verdict)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.passed, bytes_view(verdict), 60.0, 16.0)
            if run.phase == MirrorGame::FLAGGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, false, "Out of time", 60.0, 16.0)
            return if run.phase == MirrorGame::READY or run.phase == MirrorGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, run.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, run.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, run.total)
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            play(list, run, ink, dark)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Mirror::Grade = Mirror::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.cubes)
            dstr_append_cstr(out, " cubes, turned up to ")
            dstr_append_i64(out, level.most.i64())
            dstr_append_cstr(out, " degrees about ")
            dstr_append_cstr(out, "any axis." if level.any_axis else "the vertical.")
            if level.options > 0:
                dstr_append_cstr(out, "  Pick the match among ")
                dstr_append_i64(out, level.options)
                dstr_append_cstr(out, ".")
            else:
                dstr_append_cstr(out, "  Same or mirror?")
            if level.nudged > 0:
                dstr_append_cstr(out, "  ")
                dstr_append_i64(out, level.nudged)
                dstr_append_cstr(out, " of the wrong ones one cube off.")
            if not level.lit:
                dstr_append_cstr(out, "  No shading.")
