                return "Video Jigsaw"
            elif which == 4:
                return "Sudoku"
            elif which == 5:
                return "Find the Winning Move"
            elif which == 6:
                return "Crossed Wires"
            elif which == 7:
                return "Crossword"
            elif which == 8:
                return "Scrabble"
            elif which == 9:
                return "Scramble"
            elif which == 10:
                return "Algebra"
            elif which == 11:
                return "Numberology"
            elif which == 12:
                return "Syllogisms"
            elif which == 13:
                return "Winning Move"
            elif which == 14:
                return "Verbal Reasoning"
            elif which == 15 and has_signals:
                return "Signals"
            elif which == 16 and has_fold_it:
                return "Fold It"
            elif which == 17 and has_beliefs:
                return "Who Knows What?"
            return ""
        elif category == 5:
            if which == 0:
                return "Tower of Hanoi"
            elif which == 1:
                return "Traveling Salesman"
            elif which == 2:
                return "Sokoban"
            elif which == 3:
                return "Maze"
            elif which == 4:
                return "3D Maze"
            elif which == 5:
                return "3D Sokoban"
            elif which == 6:
                return "Freeform Tetris"
            elif which == 7:
                return "N-in-a-row"
            return ""
        elif category == 6:
            if which == 0:
                return "Cookie Thief"
            return ""
        return ""

    # The hub with every ported task, as the desktop and browser shells show
    # it; `camera` says whether a camera is there for Camera's card.
    def task_count_all(category: i64, camera: bool) -> i64:
        return task_count(category, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, camera, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true)

    def task_name_all(category: i64, position: i64, camera: bool) -> cstr:
        return task_name(category, position, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, camera, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true)
