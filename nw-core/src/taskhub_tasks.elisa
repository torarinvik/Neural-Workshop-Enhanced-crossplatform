# The task hub's own tables: the categories, and the tasks under each.
#
# Lifted from neural_workshop/ui/taskhub.py, which is where they live -- they
# are the SCREEN's table and not the config's, because what they hold is the
# order the tabs appear in and the words on the cards.
#
# `self_control` is not a category of attention and the difference is the
# point: everything under attention is about finding or following the right
# thing, and this is about not doing a thing you are already doing and want to
# keep doing. Reflex would fail every rung of it by being fast.

module TaskHubTasks:

    const CATEGORY_COUNT: i64 = 7
    # The tabs after Decisions, in taskhub.CATEGORIES's order: Computer use,
    # Emotion, Social and Rationality. A tab with no card yet says so.
    const LATER_CATEGORIES: i64 = 4

    def category_count(has_triage: bool) -> i64:
        return CATEGORY_COUNT + (1 + LATER_CATEGORIES if has_triage else 0)

    def category_name(which: i64) -> cstr:
        if which == 0:
            return "Working memory"
        elif which == 1:
            return "Long-term memory"
        elif which == 2:
            return "Attention"
        elif which == 3:
            return "Perception"
        elif which == 4:
            return "Reasoning"
        elif which == 5:
            return "Planning"
        elif which == 6:
            return "Self-control"
        elif which == 7:
            return "Decisions"
        elif which == 8:
            return "Computer use"
        elif which == 9:
            return "Emotion"
        elif which == 10:
            return "Social"
        elif which == 11:
            return "Rationality"
        return ""

    def task_count(category: i64, has_video_sequence: bool = false, has_hidden_rule: bool = false, has_hidden_wiring: bool = false, has_triage: bool = false, has_delay: bool = false, has_stop_switch: bool = false, has_hold_it: bool = false, has_notebook: bool = false, has_where_was_it: bool = false, has_which_is_nearer: bool = false, has_same_or_mirror: bool = false, has_point_of_view: bool = false, has_inside_or_out: bool = false, has_touching: bool = false, has_crossings: bool = false, has_time_it: bool = false, has_balance: bool = false, has_juggler: bool = false, has_lander: bool = false, has_beat: bool = false, has_glider: bool = false, has_catch: bool = false, has_echo_cave: bool = false, has_drone_hoops: bool = false, has_field_manual: bool = false, has_safecracker: bool = false, has_stagehand: bool = false, has_loading_dock: bool = false, has_gunslinger: bool = false, has_camera: bool = false, has_what_next: bool = false, has_falls: bool = false, has_sfm: bool = false, has_drshape: bool = false, has_tuner: bool = false, has_shadow_play: bool = false, has_captcha: bool = false, has_signals: bool = false, has_fold_it: bool = false, has_beliefs: bool = false, has_dam_keeper: bool = false, has_sonar: bool = false, has_gamble: bool = false, has_dispatch: bool = false, has_bluff: bool = false, has_explore_exploit: bool = false, has_firebreak: bool = false, has_crossroads: bool = false, has_railyard: bool = false, has_airtraffic: bool = false, has_escort: bool = false, has_sokobanlive: bool = false, has_kitchen: bool = false, has_crane: bool = false, has_ferry: bool = false, has_docking: bool = false, has_rover: bool = false, has_unicycle: bool = false, has_morning_round: bool = false, has_heavier: bool = false, has_full_stop: bool = false, has_missing_word: bool = false, has_proofreader: bool = false, has_figures_of_speech: bool = false, has_crazy_cog: bool = false, has_cipher_abyss: bool = false, has_potters_wheel: bool = false, has_conductor: bool = false, has_tightrope: bool = false, has_sign_painter: bool = false, has_bartender: bool = false, has_lock_pick: bool = false, has_air_hockey: bool = false, has_semaphore: bool = false, has_shadow_puppets: bool = false, has_night_watch: bool = false, has_kerbside: bool = false, has_steadicam: bool = false, has_free_kick: bool = false, has_glove: bool = false, has_by_ear: bool = false, has_piano_tuner: bool = false, has_cricket_hunt: bool = false, has_claw_machine: bool = false, has_between_the_lines: bool = false, has_second_thoughts: bool = false, has_bad_argument: bool = false, has_social_sense: bool = false, has_which_feeling: bool = false, has_how_strongly: bool = false, has_reading_people: bool = false, has_why_they_feel: bool = false, has_tone_of_voice: bool = false, has_emotion: bool = false, has_browser: bool = false, has_spreadsheet: bool = false, has_errands: bool = false, has_manual: bool = false, has_forms: bool = false, has_desktop: bool = false) -> i64:
        if category == 0:
            return 6
        elif category == 1:
            return 3 + (1 if has_notebook else 0) + (1 if has_where_was_it else 0)
        elif category == 2:
            return 11 + (1 if has_crossings else 0) + (1 if has_balance else 0) + (1 if has_juggler else 0) + (1 if has_lander else 0) + (1 if has_beat else 0) + (1 if has_glider else 0) + (1 if has_catch else 0) + (1 if has_echo_cave else 0) + (1 if has_drone_hoops else 0) + (1 if has_field_manual else 0) + (1 if has_safecracker else 0) + (1 if has_stagehand else 0) + (1 if has_loading_dock else 0) + (1 if has_gunslinger else 0) + (1 if has_potters_wheel else 0) + (1 if has_conductor else 0) + (1 if has_tightrope else 0) + (1 if has_sign_painter else 0) + (1 if has_bartender else 0) + (1 if has_lock_pick else 0) + (1 if has_air_hockey else 0) + (1 if has_semaphore else 0) + (1 if has_shadow_puppets else 0) + (1 if has_night_watch else 0) + (1 if has_kerbside else 0) + (1 if has_steadicam else 0) + (1 if has_free_kick else 0) + (1 if has_glove else 0)
        elif category == 3:
            return 2 + (1 if has_camera else 0) + (1 if has_what_next else 0) + (1 if has_falls else 0) + (1 if has_sfm else 0) + (1 if has_drshape else 0) + (1 if has_which_is_nearer else 0) + (1 if has_same_or_mirror else 0) + (1 if has_point_of_view else 0) + (1 if has_inside_or_out else 0) + (1 if has_touching else 0) + (1 if has_time_it else 0) + (1 if has_tuner else 0) + (1 if has_shadow_play else 0) + (1 if has_captcha else 0) + (1 if has_by_ear else 0) + (1 if has_piano_tuner else 0) + (1 if has_cricket_hunt else 0) + (1 if has_claw_machine else 0)
        elif category == 4:
            return 15 + (1 if has_signals else 0) + (1 if has_fold_it else 0) + (1 if has_beliefs else 0) + (1 if has_video_sequence else 0) + (1 if has_hidden_rule else 0) + (1 if has_hidden_wiring else 0) + (1 if has_heavier else 0) + (1 if has_full_stop else 0) + (1 if has_missing_word else 0) + (1 if has_proofreader else 0) + (1 if has_figures_of_speech else 0) + (1 if has_crazy_cog else 0) + (1 if has_cipher_abyss else 0)
        elif category == 5:
            return 8 + (1 if has_railyard else 0) + (1 if has_airtraffic else 0) + (1 if has_escort else 0) + (1 if has_sokobanlive else 0) + (1 if has_kitchen else 0) + (1 if has_crane else 0) + (1 if has_ferry else 0) + (1 if has_docking else 0) + (1 if has_rover else 0) + (1 if has_unicycle else 0)
        elif category == 6:
            return 1 + (1 if has_delay else 0) + (1 if has_stop_switch else 0) + (1 if has_hold_it else 0) + (1 if has_morning_round else 0)
        return (1 if has_desktop else 0) + (1 if has_forms else 0) + (1 if has_manual else 0) + (1 if has_browser else 0) + (1 if has_errands else 0) + (1 if has_spreadsheet else 0) if category == 8
        return (1 if has_which_feeling else 0) + (1 if has_how_strongly else 0) + (1 if has_reading_people else 0) + (1 if has_why_they_feel else 0) + (1 if has_tone_of_voice else 0) + (1 if has_emotion else 0) if category == 9
        return (1 if has_between_the_lines else 0) + (1 if has_social_sense else 0) if category == 10
        return (1 if has_bad_argument else 0) + (1 if has_second_thoughts else 0) if category == 11
        return (1 if has_triage else 0) + (1 if has_dam_keeper else 0) + (1 if has_sonar else 0) + (1 if has_gamble else 0) + (1 if has_dispatch else 0) + (1 if has_bluff else 0) + (1 if has_explore_exploit else 0) + (1 if has_firebreak else 0) + (1 if has_crossroads else 0) if category == 7 else 0

    def task_name(category: i64, position: i64, has_video_sequence: bool = false, has_hidden_rule: bool = false, has_hidden_wiring: bool = false, has_triage: bool = false, has_delay: bool = false, has_stop_switch: bool = false, has_hold_it: bool = false, has_notebook: bool = false, has_where_was_it: bool = false, has_which_is_nearer: bool = false, has_same_or_mirror: bool = false, has_point_of_view: bool = false, has_inside_or_out: bool = false, has_touching: bool = false, has_crossings: bool = false, has_time_it: bool = false, has_balance: bool = false, has_juggler: bool = false, has_lander: bool = false, has_beat: bool = false, has_glider: bool = false, has_catch: bool = false, has_echo_cave: bool = false, has_drone_hoops: bool = false, has_field_manual: bool = false, has_safecracker: bool = false, has_stagehand: bool = false, has_loading_dock: bool = false, has_gunslinger: bool = false, has_camera: bool = false, has_what_next: bool = false, has_falls: bool = false, has_sfm: bool = false, has_drshape: bool = false, has_tuner: bool = false, has_shadow_play: bool = false, has_captcha: bool = false, has_signals: bool = false, has_fold_it: bool = false, has_beliefs: bool = false, has_dam_keeper: bool = false, has_sonar: bool = false, has_gamble: bool = false, has_dispatch: bool = false, has_bluff: bool = false, has_explore_exploit: bool = false, has_firebreak: bool = false, has_crossroads: bool = false, has_railyard: bool = false, has_airtraffic: bool = false, has_escort: bool = false, has_sokobanlive: bool = false, has_kitchen: bool = false, has_crane: bool = false, has_ferry: bool = false, has_docking: bool = false, has_rover: bool = false, has_unicycle: bool = false, has_morning_round: bool = false, has_heavier: bool = false, has_full_stop: bool = false, has_missing_word: bool = false, has_proofreader: bool = false, has_figures_of_speech: bool = false, has_crazy_cog: bool = false, has_cipher_abyss: bool = false, has_potters_wheel: bool = false, has_conductor: bool = false, has_tightrope: bool = false, has_sign_painter: bool = false, has_bartender: bool = false, has_lock_pick: bool = false, has_air_hockey: bool = false, has_semaphore: bool = false, has_shadow_puppets: bool = false, has_night_watch: bool = false, has_kerbside: bool = false, has_steadicam: bool = false, has_free_kick: bool = false, has_glove: bool = false, has_by_ear: bool = false, has_piano_tuner: bool = false, has_cricket_hunt: bool = false, has_claw_machine: bool = false, has_between_the_lines: bool = false, has_second_thoughts: bool = false, has_bad_argument: bool = false, has_social_sense: bool = false, has_which_feeling: bool = false, has_how_strongly: bool = false, has_reading_people: bool = false, has_why_they_feel: bool = false, has_tone_of_voice: bool = false, has_emotion: bool = false, has_browser: bool = false, has_spreadsheet: bool = false, has_errands: bool = false, has_manual: bool = false, has_forms: bool = false, has_desktop: bool = false) -> cstr:
        return "Full Stop" if has_full_stop and category == 4 and position == 22
        return "Full Stop" if has_full_stop and category == 4 and position == 15 + (1 if has_signals else 0) + (1 if has_fold_it else 0) + (1 if has_beliefs else 0) + (1 if has_video_sequence else 0) + (1 if has_hidden_rule else 0) + (1 if has_hidden_wiring else 0) + (1 if has_heavier else 0)
        return "Crazy Cog" if has_crazy_cog and category == 4 and position == 26
        return "The Cipher Abyss" if has_cipher_abyss and category == 4 and position == 26 + (1 if has_crazy_cog else 0)
        return "Figures of Speech" if has_figures_of_speech and category == 4 and position == 25
        return "The Proofreader" if has_proofreader and category == 4 and position == 24
        return "The Missing Word" if has_missing_word and category == 4 and position == 23
        return "The Missing Word" if has_missing_word and category == 4 and position == 15 + (1 if has_signals else 0) + (1 if has_fold_it else 0) + (1 if has_beliefs else 0) + (1 if has_video_sequence else 0) + (1 if has_hidden_rule else 0) + (1 if has_hidden_wiring else 0) + (1 if has_heavier else 0) + (1 if has_full_stop else 0)
        return "The Proofreader" if has_proofreader and category == 4 and position == 15 + (1 if has_signals else 0) + (1 if has_fold_it else 0) + (1 if has_beliefs else 0) + (1 if has_video_sequence else 0) + (1 if has_hidden_rule else 0) + (1 if has_hidden_wiring else 0) + (1 if has_heavier else 0) + (1 if has_full_stop else 0) + (1 if has_missing_word else 0)
        return "Figures of Speech" if has_figures_of_speech and category == 4 and position == 15 + (1 if has_signals else 0) + (1 if has_fold_it else 0) + (1 if has_beliefs else 0) + (1 if has_video_sequence else 0) + (1 if has_hidden_rule else 0) + (1 if has_hidden_wiring else 0) + (1 if has_heavier else 0) + (1 if has_full_stop else 0) + (1 if has_missing_word else 0) + (1 if has_proofreader else 0)
        return "Crazy Cog" if has_crazy_cog and category == 4 and position == 15 + (1 if has_signals else 0) + (1 if has_fold_it else 0) + (1 if has_beliefs else 0) + (1 if has_video_sequence else 0) + (1 if has_hidden_rule else 0) + (1 if has_hidden_wiring else 0) + (1 if has_heavier else 0) + (1 if has_full_stop else 0) + (1 if has_missing_word else 0) + (1 if has_proofreader else 0) + (1 if has_figures_of_speech else 0)
        return "The Cipher Abyss" if has_cipher_abyss and category == 4 and position == 15 + (1 if has_signals else 0) + (1 if has_fold_it else 0) + (1 if has_beliefs else 0) + (1 if has_video_sequence else 0) + (1 if has_hidden_rule else 0) + (1 if has_hidden_wiring else 0) + (1 if has_heavier else 0) + (1 if has_full_stop else 0) + (1 if has_missing_word else 0) + (1 if has_proofreader else 0) + (1 if has_figures_of_speech else 0) + (1 if has_crazy_cog else 0)
        return "Heavier" if has_heavier and category == 4 and position == 21
        return "Heavier" if has_heavier and category == 4 and position == 15 + (1 if has_signals else 0) + (1 if has_fold_it else 0) + (1 if has_beliefs else 0) + (1 if has_video_sequence else 0) + (1 if has_hidden_rule else 0) + (1 if has_hidden_wiring else 0)
        return "Morning Round" if has_morning_round and category == 6 and position == 4
        return "Morning Round" if has_morning_round and category == 6 and position == 1 + (1 if has_delay else 0) + (1 if has_stop_switch else 0) + (1 if has_hold_it else 0)
        return "Rail Yard" if has_railyard and category == 5 and position == 8
        return "Air Traffic" if has_airtraffic and category == 5 and position == 8 + (1 if has_railyard else 0)
        return "Escort" if has_escort and category == 5 and position == 8 + (1 if has_railyard else 0) + (1 if has_airtraffic else 0)
        return "Sokoban Live" if has_sokobanlive and category == 5 and position == 8 + (1 if has_railyard else 0) + (1 if has_airtraffic else 0) + (1 if has_escort else 0)
        return "Kitchen" if has_kitchen and category == 5 and position == 8 + (1 if has_railyard else 0) + (1 if has_airtraffic else 0) + (1 if has_escort else 0) + (1 if has_sokobanlive else 0)
        return "Crane" if has_crane and category == 5 and position == 8 + (1 if has_railyard else 0) + (1 if has_airtraffic else 0) + (1 if has_escort else 0) + (1 if has_sokobanlive else 0) + (1 if has_kitchen else 0)
        return "Ferry" if has_ferry and category == 5 and position == 8 + (1 if has_railyard else 0) + (1 if has_airtraffic else 0) + (1 if has_escort else 0) + (1 if has_sokobanlive else 0) + (1 if has_kitchen else 0) + (1 if has_crane else 0)
        return "Docking" if has_docking and category == 5 and position == 8 + (1 if has_railyard else 0) + (1 if has_airtraffic else 0) + (1 if has_escort else 0) + (1 if has_sokobanlive else 0) + (1 if has_kitchen else 0) + (1 if has_crane else 0) + (1 if has_ferry else 0)
        return "Rover" if has_rover and category == 5 and position == 8 + (1 if has_railyard else 0) + (1 if has_airtraffic else 0) + (1 if has_escort else 0) + (1 if has_sokobanlive else 0) + (1 if has_kitchen else 0) + (1 if has_crane else 0) + (1 if has_ferry else 0) + (1 if has_docking else 0)
        return "Unicycle" if has_unicycle and category == 5 and position == 8 + (1 if has_railyard else 0) + (1 if has_airtraffic else 0) + (1 if has_escort else 0) + (1 if has_sokobanlive else 0) + (1 if has_kitchen else 0) + (1 if has_crane else 0) + (1 if has_ferry else 0) + (1 if has_docking else 0) + (1 if has_rover else 0)
        return "Gunslinger" if has_gunslinger and category == 2 and position == 24
        return "Potter's Wheel" if has_potters_wheel and category == 2 and position == 25
        return "Conductor" if has_conductor and category == 2 and position == 25 + (1 if has_potters_wheel else 0)
        return "Tightrope" if has_tightrope and category == 2 and position == 25 + (1 if has_potters_wheel else 0) + (1 if has_conductor else 0)
        return "Sign Painter" if has_sign_painter and category == 2 and position == 25 + (1 if has_potters_wheel else 0) + (1 if has_conductor else 0) + (1 if has_tightrope else 0)
        return "Bartender" if has_bartender and category == 2 and position == 25 + (1 if has_potters_wheel else 0) + (1 if has_conductor else 0) + (1 if has_tightrope else 0) + (1 if has_sign_painter else 0)
        return "Lock Pick" if has_lock_pick and category == 2 and position == 25 + (1 if has_potters_wheel else 0) + (1 if has_conductor else 0) + (1 if has_tightrope else 0) + (1 if has_sign_painter else 0) + (1 if has_bartender else 0)
        return "Air Hockey" if has_air_hockey and category == 2 and position == 25 + (1 if has_potters_wheel else 0) + (1 if has_conductor else 0) + (1 if has_tightrope else 0) + (1 if has_sign_painter else 0) + (1 if has_bartender else 0) + (1 if has_lock_pick else 0)
        return "Semaphore" if has_semaphore and category == 2 and position == 25 + (1 if has_potters_wheel else 0) + (1 if has_conductor else 0) + (1 if has_tightrope else 0) + (1 if has_sign_painter else 0) + (1 if has_bartender else 0) + (1 if has_lock_pick else 0) + (1 if has_air_hockey else 0)
        return "Shadow Puppets" if has_shadow_puppets and category == 2 and position == 25 + (1 if has_potters_wheel else 0) + (1 if has_conductor else 0) + (1 if has_tightrope else 0) + (1 if has_sign_painter else 0) + (1 if has_bartender else 0) + (1 if has_lock_pick else 0) + (1 if has_air_hockey else 0) + (1 if has_semaphore else 0)
        return "Night Watch" if has_night_watch and category == 2 and position == 25 + (1 if has_potters_wheel else 0) + (1 if has_conductor else 0) + (1 if has_tightrope else 0) + (1 if has_sign_painter else 0) + (1 if has_bartender else 0) + (1 if has_lock_pick else 0) + (1 if has_air_hockey else 0) + (1 if has_semaphore else 0) + (1 if has_shadow_puppets else 0)
        return "Kerbside" if has_kerbside and category == 2 and position == 25 + (1 if has_potters_wheel else 0) + (1 if has_conductor else 0) + (1 if has_tightrope else 0) + (1 if has_sign_painter else 0) + (1 if has_bartender else 0) + (1 if has_lock_pick else 0) + (1 if has_air_hockey else 0) + (1 if has_semaphore else 0) + (1 if has_shadow_puppets else 0) + (1 if has_night_watch else 0)
        return "Steadicam" if has_steadicam and category == 2 and position == 25 + (1 if has_potters_wheel else 0) + (1 if has_conductor else 0) + (1 if has_tightrope else 0) + (1 if has_sign_painter else 0) + (1 if has_bartender else 0) + (1 if has_lock_pick else 0) + (1 if has_air_hockey else 0) + (1 if has_semaphore else 0) + (1 if has_shadow_puppets else 0) + (1 if has_night_watch else 0) + (1 if has_kerbside else 0)
        return "Free Kick" if has_free_kick and category == 2 and position == 25 + (1 if has_potters_wheel else 0) + (1 if has_conductor else 0) + (1 if has_tightrope else 0) + (1 if has_sign_painter else 0) + (1 if has_bartender else 0) + (1 if has_lock_pick else 0) + (1 if has_air_hockey else 0) + (1 if has_semaphore else 0) + (1 if has_shadow_puppets else 0) + (1 if has_night_watch else 0) + (1 if has_kerbside else 0) + (1 if has_steadicam else 0)
        return "Glove" if has_glove and category == 2 and position == 25 + (1 if has_potters_wheel else 0) + (1 if has_conductor else 0) + (1 if has_tightrope else 0) + (1 if has_sign_painter else 0) + (1 if has_bartender else 0) + (1 if has_lock_pick else 0) + (1 if has_air_hockey else 0) + (1 if has_semaphore else 0) + (1 if has_shadow_puppets else 0) + (1 if has_night_watch else 0) + (1 if has_kerbside else 0) + (1 if has_steadicam else 0) + (1 if has_free_kick else 0)
        return "Gunslinger" if has_gunslinger and category == 2 and position == 11 + (1 if has_lander else 0) + (1 if has_juggler else 0) + (1 if has_balance else 0) + (1 if has_crossings else 0) + (1 if has_beat else 0) + (1 if has_glider else 0) + (1 if has_catch else 0) + (1 if has_echo_cave else 0) + (1 if has_drone_hoops else 0) + (1 if has_field_manual else 0) + (1 if has_safecracker else 0) + (1 if has_stagehand else 0) + (1 if has_loading_dock else 0)
        return "Potter's Wheel" if has_potters_wheel and category == 2 and position == 11 + (1 if has_lander else 0) + (1 if has_juggler else 0) + (1 if has_balance else 0) + (1 if has_crossings else 0) + (1 if has_beat else 0) + (1 if has_glider else 0) + (1 if has_catch else 0) + (1 if has_echo_cave else 0) + (1 if has_drone_hoops else 0) + (1 if has_field_manual else 0) + (1 if has_safecracker else 0) + (1 if has_stagehand else 0) + (1 if has_loading_dock else 0) + (1 if has_gunslinger else 0)
