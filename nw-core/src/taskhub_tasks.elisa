# The task hub's own tables: the categories, and the tasks under each.
#
# Lifted from neural_workshop/ui/taskhub.py, which is where they live -- they
# are the SCREEN's table and not the config's, because what they hold is the
# order the tabs appear in and the words on the cards.
#
# `self_control` is not a category of attention and the difference is the
# point: everything under attention is about finding or following the right
# thing, and this is about not doing a thing you are already doing and want to
# keep doing. Reflex would fail every rung of it by being fast.

module TaskHubTasks:

    const CATEGORY_COUNT: i64 = 7

    def category_name(which: i64) -> cstr:
        if which == 0:
            return "Working memory"
        elif which == 1:
            return "Long-term memory"
        elif which == 2:
            return "Attention"
        elif which == 3:
            return "Perception"
        elif which == 4:
            return "Reasoning"
        elif which == 5:
            return "Planning"
        elif which == 6:
            return "Self-control"
        return ""

    def task_count(category: i64) -> i64:
        if category == 0:
            return 6
        elif category == 1:
            return 3
        elif category == 2:
            return 11
        elif category == 3:
            return 2
        elif category == 4:
            return 14
        elif category == 5:
            return 8
        elif category == 6:
            return 1
        return 0

    def task_name(category: i64, which: i64) -> cstr:
        if category == 0:
            if which == 0:
                return "3D N-Back"
            elif which == 1:
                return "Monkey Ladder"
            elif which == 2:
                return "In the Dark"
            elif which == 3:
                return "Fog of War"
            elif which == 4:
                return "Removals"
            elif which == 5:
                return "Chain of Custody"
            return ""
        elif category == 1:
            if which == 0:
                return "Concentration"
            elif which == 1:
                return "Seen It Before?"
            elif which == 2:
                return "Trivia"
            return ""
        elif category == 2:
            if which == 0:
                return "Reflex"
            elif which == 1:
                return "N-Cup Monte"
            elif which == 2:
                return "Moving Targets"
            elif which == 3:
                return "Lookout"
            elif which == 4:
                return "Pursuit"
            elif which == 5:
                return "Buzz Wire"
            elif which == 6:
                return "Out of Sight"
            elif which == 7:
                return "Donkey"
            elif which == 8:
                return "Two Hands"
            elif which == 9:
                return "Overrun"
            elif which == 10:
                return "Marble Maze"
            return ""
        elif category == 3:
            if which == 0:
                return "Count"
            elif which == 1:
                return "Mr. Time"
            return ""
        elif category == 4:
            if which == 0:
                return "Graph Mapping"
            elif which == 1:
                return "Matrix Reasoning"
            elif which == 2:
                return "Jigsaw Puzzle"
            elif which == 3:
                return "Sudoku"
            elif which == 4:
                return "Find the Winning Move"
            elif which == 5:
                return "Crossed Wires"
            elif which == 6:
                return "Crossword"
            elif which == 7:
                return "Scrabble"
            elif which == 8:
                return "Scramble"
            elif which == 9:
                return "Algebra"
            elif which == 10:
                return "Numberology"
            elif which == 11:
                return "Syllogisms"
            elif which == 12:
                return "Winning Move"
            elif which == 13:
                return "Verbal Reasoning"
            return ""
        elif category == 5:
            if which == 0:
                return "Tower of Hanoi"
            elif which == 1:
                return "Traveling Salesman"
            elif which == 2:
                return "Sokoban"
            elif which == 3:
                return "Maze"
            elif which == 4:
                return "3D Maze"
            elif which == 5:
                return "3D Sokoban"
            elif which == 6:
                return "Freeform Tetris"
            elif which == 7:
                return "N-in-a-row"
            return ""
        elif category == 6:
            if which == 0:
                return "Cookie Thief"
            return ""
        return ""
