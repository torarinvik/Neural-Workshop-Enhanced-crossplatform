include "./tasks/airtraffic_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./verdict.elisa"
include "./geometry.elisa"

module SceneAirTraffic:
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const DANGER: u32 = 0xff4646ff
    const LABEL: u32 = 0xe2ecf4ff

    struct Frame:
        x: f64
        y: f64
        size: f64

    struct Axes:
        center: AirTraffic::Point
        ux: f64
        uy: f64
        scale: f64

    def frame() -> Frame:
        can Abort.Panic:
            bottom: f64 = Verdict::above_the_band(HEIGHT, Geometry::from_bottom_edge(HEIGHT, 58.0).f64()).f64()
            height: f64 = fmax(40.0, Geometry::from_top_edge(HEIGHT, 116.0).f64() - bottom)
            size: f64 = fmin(WIDTH * 0.94 / AirTraffic::WORLD_W, height / AirTraffic::WORLD_H)
            return Frame{x: (WIDTH - AirTraffic::WORLD_W * size) / 2.0, y: bottom, size: size}

    def at(area: Frame, x: f64, y: f64) -> AirTraffic::Point:
        return AirTraffic::Point{x: area.x + x * area.size, y: area.y + y * area.size}

    def local(view: Axes, x: f64, y: f64) -> AirTraffic::Point:
        return AirTraffic::Point{x: view.center.x + (view.ux * x - view.uy * y) * view.scale,
            y: view.center.y + (view.uy * x + view.ux * y) * view.scale}

    def alpha(colour: u32, opacity: i64) -> u32:
        return (colour & 0xffffff00.u32()) | opacity.u32()

    def colour(run: AirTraffic::Run&, runway: i64) -> u32:
        return 0xf0f0faff if run.sky.level.runways == 1 else (0xffa032ff if runway == 0 else 0x46d2f0ff)

    def text(list: mutable Display::DisplayList&, words: sview, x: f64, y: f64, size: f64, ink: u32,
             bold: bool = false, anchor: u32 = Display::ANCHOR_CENTER_CENTER):
        can Abort.Panic, Memory.Allocate:
            Display::draw_text_weight(list, words, x, y, size, ink, anchor, bold)

    def segment(list: mutable Display::DisplayList&, a: AirTraffic::Point, b: AirTraffic::Point, thick: f64, ink: u32):
        can Abort.Panic, Memory.Allocate:
            Display::draw_line(list, a.x, a.y, b.x, b.y, thick, ink)

    def rounded(list: mutable Display::DisplayList&, x: f64, y: f64, width: f64, height: f64, r: f64, ink: u32):
        can Abort.Panic, Memory.Allocate:
            rect: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: x, y: y, w: fmax(1.0, width), h: fmax(1.0, height)}
            ScenePolish::rounded(list, &rect, r, ink)

    def hit(session: AirTrafficGame::Session&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return AirTrafficGame::START if session.phase == AirTrafficGame::READY or session.phase == AirTrafficGame::DONE
            return -1 if session.phase != AirTrafficGame::PLAYING
            run: AirTraffic::Run& = &session.airspace
            area: Frame = frame()
            radius: f64 = 5.0 * area.size
            best: mutable f64 = radius * radius
            slot: mutable i64 = -1
            for i in 0..<run.active |run, area, x, y, best, slot|:
                plane: AirTraffic::Plane = run.planes[i.usize()]
                p: AirTraffic::Point = at(area, plane.x, plane.y)
                dx: f64 = p.x - x
                dy: f64 = p.y - y
                distance: f64 = dx * dx + dy * dy
                if distance < best:
                    best <- distance
                    slot <- plane.slot
            return slot if slot >= 0
            selected: i64 = AirTraffic::plane_in(run, run.selected)
            return -1 if selected < 0
            rw: AirTraffic::Runway = run.sky.runways[run.planes[selected.usize()].runway.usize()]
            p: AirTraffic::Point = at(area, rw.point.x, rw.point.y)
            dx: f64 = p.x - x
            dy: f64 = p.y - y
            reach: f64 = rw.length * 0.7 * area.size
            return AirTraffic::SLOTS + AirTraffic::LAND if dx * dx + dy * dy < reach * reach else -1

    def scope(list: mutable Display::DisplayList&, area: Frame, elapsed: f64, dark: bool):
        can Abort.Panic, Memory.Allocate:
            w: f64 = AirTraffic::WORLD_W * area.size
            h: f64 = AirTraffic::WORLD_H * area.size
            card: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: area.x - 5.0, y: area.y - 5.0, w: w + 10.0, h: h + 10.0}
            ScenePolish::shadow(list, &card, 16.0, 4.0, dark)
            ScenePolish::rounded(list, &card, 16.0, 0x14283aff)
            rounded(list, area.x, area.y, w, h, 12.0, 0x0a1622ff)
            center: AirTraffic::Point = at(area, AirTraffic::WORLD_W / 2.0, AirTraffic::WORLD_H / 2.0)
            for i in 1..<5 |list, center, h|:
                ScenePolish::ring(list, center.x, center.y, i.f64() * 0.12 * h, 1.0, 0x224654ff, 64)
            for x in 1..<16 |list, area|:
                segment(list, at(area, x.f64() * 10.0, 1.0), at(area, x.f64() * 10.0, AirTraffic::WORLD_H - 1.0), 1.0, 0x10202eff)
            for y in 1..<10 |list, area|:
                segment(list, at(area, 1.0, y.f64() * 10.0), at(area, AirTraffic::WORLD_W - 1.0, y.f64() * 10.0), 1.0, 0x10202eff)
            angle: f64 = fmod(elapsed * 90.0, 360.0)
            reach: f64 = fmin(w, h) * 0.49
            for k in 0..<8 |list, center, angle, reach|:
                opacity: i64 = 46 - 6 * k
                Display::begin_polygon(list, 6, center.x, center.y, alpha(0x3cdca0ff, opacity if opacity > 4 else 4))
                Display::polygon_point(list, center.x, center.y)
                for i in 0..<5 |list, center, reach, angle, k|:
                    rad: f64 = AirTraffic::radians(angle - 6.0 * (k + 1).f64() + 1.5 * i.f64())
                    Display::polygon_point(list, center.x + cos(rad) * reach, center.y + sin(rad) * reach)
            rad: f64 = AirTraffic::radians(angle)
            Display::draw_line(list, center.x, center.y, center.x + cos(rad) * reach, center.y + sin(rad) * reach, 2.0, 0x3cdca096)

    def storms(list: mutable Display::DisplayList&, area: Frame, run: AirTraffic::Run&):
        can Abort.Panic, Memory.Allocate:
            for i in 0..<run.sky.level.storms |list, area, run|:
                storm: AirTraffic::Storm = run.storms[i.usize()]
                p: AirTraffic::Point = at(area, storm.x, storm.y)
                r: f64 = storm.radius * area.size
                opacities: i64[4] = [40, 60, 90, 120]
                for k in 0..<4 |list, p, r, run, opacities|:
                    x: f64 = p.x + sin(run.elapsed * 0.7 + k.f64()) * r * 0.06
                    y: f64 = p.y + cos(run.elapsed * 0.5 + k.f64()) * r * 0.06
                    ink: u32 = ScenePolish::mix_rgb(0x965adcff, 0x3c1e78ff, k.f64() * 0.2)
                    Display::draw_circle(list, x, y, r * (1.15 - k.f64() * 0.18), alpha(ink, opacities[k.usize()]))
                if (run.elapsed * 3.0 + storm.radius).i64() % 7 == 0:
                    xs: f64[7] = [0.0, -0.2, 0.05, -0.15, 0.25, 0.0, 0.2]
                    ys: f64[7] = [0.5, 0.0, 0.05, -0.5, 0.1, 0.05, 0.5]
                    for j in 1..<7 |list, p, r, xs, ys|:
                        a: usize = (j - 1).usize()
                        b: usize = j.usize()
                        Display::draw_line(list, p.x + xs[a] * r, p.y + ys[a] * r,
                            p.x + xs[b] * r, p.y + ys[b] * r, 2.0, 0xfffab4ff)

    def polygon(list: mutable Display::DisplayList&, view: Axes, xs: f64[6], ys: f64[6], count: i64, ink: u32):
        can Abort.Panic, Memory.Allocate:
            start: AirTraffic::Point = local(view, xs[0], ys[0])
            Display::begin_polygon(list, count, start.x, start.y, ink)
            for i in 0..<count |list, view, xs, ys|:
                p: AirTraffic::Point = local(view, xs[i.usize()], ys[i.usize()])
                Display::polygon_point(list, p.x, p.y)

    def runway(list: mutable Display::DisplayList&, area: Frame, run: AirTraffic::Run&, index: i64):
        can Abort.Panic, Memory.Allocate:
            rw: AirTraffic::Runway = run.sky.runways[index.usize()]
            h: f64 = AirTraffic::radians(AirTraffic::runway_heading(run, index))
            view: Axes = Axes{center: at(area, rw.point.x, rw.point.y), ux: cos(h), uy: sin(h), scale: area.size}
            l: f64 = rw.length / 2.0
            ink: u32 = colour(run, index)
            polygon(list, view, [-l - 0.6, l + 0.6, l + 0.6, -l - 0.6, 0.0, 0.0],
                [-2.2, -2.2, 2.2, 2.2, 0.0, 0.0], 4, ink)
            polygon(list, view, [-l, l, l, -l, 0.0, 0.0], [-1.6, -1.6, 1.6, 1.6, 0.0, 0.0], 4, 0x363a42ff)
            for i in 0..<4 |list, view, area, l|:
                x: f64 = -l + 3.0 + 3.0 * i.f64()
                segment(list, local(view, x, 0.0), local(view, x + 1.4, 0.0), fmax(1.0, 0.3 * area.size), 0xf0f0f0ff)
            sides: f64[4] = [-1.0, -0.4, 0.4, 1.0]
            for i in 0..<4 |list, view, area, l, sides|:
                y: f64 = sides[i.usize()]
                segment(list, local(view, -l + 0.4, y), local(view, -l + 2.0, y), fmax(1.0, 0.35 * area.size), 0xf0f0f0ff)
            tip: AirTraffic::Point = local(view, -l - 1.0, 0.0)
            a: AirTraffic::Point = local(view, -l - 2.6, 1.2)
            b: AirTraffic::Point = local(view, -l - 2.6, -1.2)
            segment(list, local(view, -l - 7.0, 0.0), tip, 2.0, ink)
            Display::draw_triangle(list, tip.x, tip.y, a.x, a.y, b.x, b.y, ink)
            target: AirTraffic::Point = AirTraffic::fix(run, index)
            p: AirTraffic::Point = at(area, target.x, target.y)
            Display::draw_star(list, p.x, p.y, 1.4 * area.size, 0.6 * area.size, 4, 0.0, alpha(ink, 180))
            if AirTraffic::closed(run, index):
                segment(list, local(view, -l, -1.6), local(view, l, 1.6), 4.0, DANGER)
                segment(list, local(view, l, -1.6), local(view, -l, 1.6), 4.0, DANGER)
            elif run.elapsed < run.busy_until[index.usize()]:
                Display::draw_circle(list, view.center.x, view.center.y, 1.2 * area.size, 0xffdc50ff)

    def dashes(list: mutable Display::DisplayList&, a: AirTraffic::Point, b: AirTraffic::Point, ink: u32):
        can Abort.Panic, Memory.Allocate:
            dx: f64 = b.x - a.x
            dy: f64 = b.y - a.y
            n: i64 = floor(py_hypot(dx, dy) / 10.0).i64()
            for i in 0..<n |list, a, dx, dy, n, ink|:
                continue if i % 2 != 0
                low: f64 = i.f64() / n.f64()
                high: f64 = (i + 1).f64() / n.f64()
                Display::draw_line(list, a.x + dx * low, a.y + dy * low,
                    a.x + dx * high, a.y + dy * high, 1.5, ink)

    def hot(run: AirTraffic::Run&, p: AirTraffic::Plane) -> bool:
        can Abort.Panic:
            for i in 0..<run.active |run, p|:
                other: AirTraffic::Plane = run.planes[i.usize()]
                return true if p.number != other.number and py_hypot(p.x - other.x, p.y - other.y) < AirTraffic::WARNING
            return false

    def plane_label(list: mutable Display::DisplayList&, p: AirTraffic::Plane, view: Axes, scale: f64, fuel: f64, ink: u32):
        can Abort.Panic, Memory.Allocate:
            x: f64 = view.center.x + 3.2 * scale
            y: f64 = view.center.y + 2.6 * scale
            words: mutable dstr = []
            dstr_append_i64(&words, p.slot + 1)
            dstr_append_cstr(&words, " H" if p.mode == AirTraffic::HOLDING else (" >" if p.mode == AirTraffic::FREE else " L"))
            rounded(list, x - 0.4 * scale, y - 1.3 * scale, 6.4 * scale, 2.6 * scale, 0.6 * scale, 0x0e1a26d2)
            text(list, bytes_view(words), x + 2.8 * scale, y, fmax(7.0, 1.6 * scale), ink, true)
            if fuel > 0.0:
                share: f64 = fmax(0.0, p.fuel / fuel)
                bar: u32 = 0x5adc78ff if share > 0.4 else (0xfac83cff if share > 0.2 else DANGER)
                rounded(list, x - 0.4 * scale, y - 2.3 * scale, 6.0 * scale * share, 0.6 * scale, 0.3 * scale, bar)

    def plane(list: mutable Display::DisplayList&, area: Frame, session: AirTrafficGame::Session&, p: AirTraffic::Plane):
        can Abort.Panic, Memory.Allocate:
            run: AirTraffic::Run& = &session.airspace
            h: f64 = AirTraffic::radians(p.heading)
            center: AirTraffic::Point = at(area, p.x, p.y)
            s: f64 = area.size
            ink: u32 = colour(run, p.runway)
            trail: AirTrafficGame::Trail& = &session.trails[p.number.usize()]
            first: i64 = trail.count - AirTrafficGame::TRAIL_SAMPLES if trail.count > AirTrafficGame::TRAIL_SAMPLES else 0
            for i in first..<trail.count |list, area, trail, first, ink, s|:
                point: AirTraffic::Point = trail.points[(i % AirTrafficGame::TRAIL_SAMPLES).usize()]
                out: AirTraffic::Point = at(area, point.x, point.y)
                Display::draw_circle(list, out.x, out.y, fmax(1.2, 0.35 * s), alpha(ink, 40 + 18 * (i - first)))
            if p.mode == AirTraffic::HOLDING:
                r: f64 = run.sky.level.speed / AirTraffic::radians(AirTraffic::HOLD_RATE)
                direction: f64 = AirTraffic::radians(p.heading + 90.0)
                point: AirTraffic::Point = at(area, p.x + cos(direction) * r, p.y + sin(direction) * r)
                ScenePolish::ring(list, point.x, point.y, r * s, 1.0, alpha(ink, 90), 32)
            if p.cleared:
                target: AirTraffic::Point = AirTraffic::fix(run, p.runway)
                dashes(list, center, at(area, target.x, target.y), alpha(ink, 120))
            view: Axes = Axes{center: center, ux: cos(h), uy: sin(h), scale: 1.15 * s}
            shadow: Axes = Axes{center: AirTraffic::Point{x: center.x + 0.35 * s, y: center.y - 0.5 * s},
                ux: view.ux, uy: view.uy, scale: view.scale}
            xs: f64[6] = [2.2, 1.4, -1.8, -2.0, -1.8, 1.4]
            ys: f64[6] = [0.0, 0.45, 0.45, 0.0, -0.45, -0.45]
            wing: u32 = ScenePolish::mix_rgb(ink, ScenePolish::mix_rgb(ink, 0x000000ff, 0.45), 0.35)
            polygon(list, shadow, xs, ys, 6, 0x0000005a)
            polygon(list, view, xs, ys, 6, ink)
            polygon(list, view, [0.6, -0.6, -1.1, -0.4, 0.0, 0.0], [0.3, 2.4, 2.4, 0.3, 0.0, 0.0], 4, wing)
            polygon(list, view, [0.6, -0.6, -1.1, -0.4, 0.0, 0.0], [-0.3, -2.4, -2.4, -0.3, 0.0, 0.0], 4, wing)
            polygon(list, view, [-1.4, -2.0, -2.3, -1.9, 0.0, 0.0], [0.3, 1.1, 1.1, 0.2, 0.0, 0.0], 4, wing)
            polygon(list, view, [-1.4, -2.0, -2.3, -1.9, 0.0, 0.0], [-0.3, -1.1, -1.1, -0.2, 0.0, 0.0], 4, wing)
            if run.selected == p.slot:
                ScenePolish::ring(list, center.x, center.y, 4.2 * s, 2.0, 0xffffffff, 32)
            if hot(run, p):
                ScenePolish::ring(list, center.x, center.y, AirTraffic::SEPARATION * s, 2.0, DANGER, 32)
            plane_label(list, p, view, s, run.sky.level.fuel, ink)

    def notice(why: i64) -> cstr:
        return "landed" if why == AirTraffic::LANDED
        return "go around: wind change" if why == AirTraffic::WIND_CHANGE
        return "go around: missed the runway" if why == AirTraffic::MISSED_RUNWAY
        return "go around: runway closed" if why == AirTraffic::RUNWAY_CLOSED
        return "go around: runway busy" if why == AirTraffic::RUNWAY_BUSY
        return "go around: not lined up"

    def radar(list: mutable Display::DisplayList&, session: AirTrafficGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            area: Frame = frame()
            run: AirTraffic::Run& = &session.airspace
            scope(list, area, run.elapsed, dark)
            storms(list, area, run)
            for k in 0..<run.sky.level.runways |list, area, run|:
                runway(list, area, run, k)
            for i in 0..<run.active |list, area, session, run|:
                plane(list, area, session, run.planes[i.usize()])
            if run.first_slot >= 0:
                loss: AirTraffic::Point = at(area, run.loss.x, run.loss.y)
                Display::draw_star(list, loss.x, loss.y, 5.0 * area.size, 2.0 * area.size, 10, 0.0, 0xffb43cff)
            start: i64 = run.notice_count - AirTraffic::NOTICES if run.notice_count > AirTraffic::NOTICES else 0
            for i in start..<run.notice_count |list, area, run|:
                event: AirTraffic::Notice = run.notices[(i % AirTraffic::NOTICES).usize()]
                age: f64 = run.elapsed - event.time
                if age < 3.0:
                    p: AirTraffic::Point = at(area, event.point.x, event.point.y + 6.0 + age * 2.0)
                    words: mutable dstr = []
                    dstr_append_cstr(&words, notice(event.why))
                    text(list, bytes_view(words), p.x, p.y, fmax(7.0, 1.7 * area.size),
                        alpha(0xffe68cff, (255.0 * (1.0 - age / 3.0)).i64()), true)
            words: mutable dstr = []
            dstr_append_cstr(&words, "down ")
            dstr_append_i64(&words, run.landed_count)
            dstr_append_cstr(&words, " of ")
            dstr_append_i64(&words, run.sky.level.planes)
            dstr_append_cstr(&words, "   inbound ")
            dstr_append_i64(&words, run.sky.level.planes - run.waiting)
            p: AirTraffic::Point = at(area, 3.0, AirTraffic::WORLD_H - 4.0)
            size: f64 = fmax(8.0, 2.0 * area.size)
            text(list, bytes_view(words), p.x, p.y, size, LABEL, false, Display::ANCHOR_LEFT_CENTER)
            if run.sky.shift >= 0.0 and not run.flipped:
                wind: mutable dstr = []
                dstr_append_cstr(&wind, "wind turns in ")
                dstr_append_i64(&wind, fmax(0.0, run.sky.shift - run.elapsed).i64())
                dstr_append_cstr(&wind, " s")
                p: AirTraffic::Point = at(area, AirTraffic::WORLD_W - 4.0, AirTraffic::WORLD_H - 4.0)
                text(list, bytes_view(wind), p.x, p.y, size, 0xffdc78ff, false, Display::ANCHOR_RIGHT_CENTER)

    def verdict(run: AirTraffic::Run&, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            if run.result == AirTraffic::CLEAR:
                dstr_append_cstr(out, "All ")
                dstr_append_i64(out, run.sky.level.planes)
                dstr_append_cstr(out, " planes down safely")
            elif run.result == AirTraffic::TIMEOUT:
                dstr_append_cstr(out, "Time: ")
                dstr_append_i64(out, run.landed_count)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, run.sky.level.planes)
                dstr_append_cstr(out, " planes down")
            elif run.result == AirTraffic::COLLISION:
                dstr_append_cstr(out, "Planes ")
                dstr_append_i64(out, run.first_slot + 1)
                dstr_append_cstr(out, " and ")
                dstr_append_i64(out, run.second_slot + 1)
                dstr_append_cstr(out, " collided")
            elif run.result != AirTraffic::LIVE:
                dstr_append_cstr(out, "Plane ")
                dstr_append_i64(out, run.first_slot + 1)
                dstr_append_cstr(out, " ran out of fuel" if run.result == AirTraffic::FUEL_LOSS else
                    (" left the airspace" if run.result == AirTraffic::AIRSPACE_LOSS else " flew into a storm"))

    def render(list: mutable Display::DisplayList&, session: AirTrafficGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            text(list, "Air Traffic", 456.0, 648.0, 22.0, ink, true)
            text(list, "click or 1-8: pick a plane   H hold   A/D turn   L or click its runway: land   Esc: menu",
                456.0, 26.0, 12.0, ink)
            caption: mutable dstr = []
            verdict(&session.airspace, &caption)
            status: mutable dstr = []
            if session.phase == AirTrafficGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == AirTrafficGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == AirTrafficGame::JUDGED:
                status <- caption
            else:
                dstr_append_cstr(&status, "Land every plane on the runway of its colour")
            text(list, bytes_view(status), 456.0, 614.0, 14.0, ink)
            if session.phase == AirTrafficGame::PLAYING or session.phase == AirTrafficGame::JUDGED:
                facts: mutable dstr = []
                run: AirTraffic::Run& = &session.airspace
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   ")
                dstr_append_i64(&facts, fmax(0.0, run.sky.seconds - run.elapsed).i64())
                dstr_append_cstr(&facts, " s left")
                if run.selected >= 0:
                    dstr_append_cstr(&facts, "   plane ")
                    dstr_append_i64(&facts, run.selected + 1)
                    dstr_append_cstr(&facts, " picked")
                text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink)
                radar(list, session, dark)
            if caption.count > 0:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, AirTrafficGame::passed_verdict(session.verdict),
                    bytes_view(caption), 60.0, 16.0)

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: AirTraffic::Grade = AirTraffic::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.planes)
            dstr_append_cstr(out, " planes, ")
            dstr_append_cstr(out, "one runway." if level.runways == 1 else "two runways.")
            if level.storms > 0:
                dstr_append_cstr(out, "  With ")
                dstr_append_i64(out, level.storms)
                dstr_append_cstr(out, " storm cells")
                if level.fuel >= 0.0:
                    dstr_append_cstr(out, ", fuel for ")
                    dstr_append_i64(out, level.fuel.i64())
                    dstr_append_cstr(out, " s")
                dstr_append_cstr(out, ", a runway closing") if level.closure
                dstr_append_cstr(out, ", the wind turning") if level.wind_shift
                dstr_append_cstr(out, ".")
