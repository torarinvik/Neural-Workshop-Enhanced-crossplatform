# `random.gauss`, kept apart from pyrandom.elisa because it is the one RNG
# primitive with a DEPENDENCY: sqrt, log, sin and cos. pyrandom.elisa is
# included by every sweep here and most of them have no use for libm, so
# putting this beside them would make elisacore_math a requirement of every
# driver in the port for the sake of one function.
#
# NOTE: needs elisacore_math and pyrandom included by the driver, in that order.

# `random.gauss` keeps HALF A DRAW in its pocket. Box-Muller makes two normals
# at a time from two uniforms; CPython returns one and caches the other, so
# every SECOND call consumes no randomness at all. The cache also survives
# between calls, so a run that draws three gaussians a tick leaves one waiting
# for the next tick -- get this wrong and the stream is a draw out for ever
# after, which looks exactly like a plausible but different simulation.
#
# Needs elisacore_math (sqrt, log, sin, cos) from the driver.
struct GaussCache:
    has: mutable bool
    value: mutable f64

def py_gauss(rng: mutable MT19937&, cache: mutable GaussCache&, mu: f64, sigma: f64) -> f64:
    can Abort.Panic:
        z: mutable f64 = 0.0
        if cache.has:
            z <- cache.value
            cache.has <- false
        else:
            # TWOPI is `2.0 * pi` computed once, so it rounds once too.
            x2pi: f64 = py_random(rng) * 6.283185307179586
            g2rad: f64 = sqrt(-2.0 * log(1.0 - py_random(rng)))
            z <- cos(x2pi) * g2rad
            cache.value <- sin(x2pi) * g2rad
            cache.has <- true
        return mu + z * sigma
