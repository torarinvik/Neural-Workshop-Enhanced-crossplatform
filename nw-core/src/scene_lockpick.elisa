include "./scene_hand.elisa"
include "./geometry.elisa"
include "./scene_verdict.elisa"
include "./tasks/lockpick_game.elisa"

module SceneLockPick:
    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            Display::draw_rect(list, SceneHand::x(x), SceneHand::y(y), w * SceneHand::SCALE, h * SceneHand::SCALE, tint)

    def line(list: mutable Display::DisplayList&, x: f64, y: f64, tx: f64, ty: f64, width: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            SceneHand::line(list, RoomsView::vec(x, y, 1.0), RoomsView::vec(tx, ty, 1.0), width, tint)

    def pin(list: mutable Display::DisplayList&, run: LockPick::Run&, k: i64):
        can Abort.Panic, Memory.Allocate:
            x: f64 = LockPick::pin_x(k)
            floor: f64 = LockPick::FLOOR
            rect(list, x - 17.0, floor, 34.0, 330.0, 0x242228ff)
            return if run.lock.level.hidden
            base: f64 = floor + run.lifts[k.usize()] * LockPick::LIFT
            tint: u32 = 0x6edc8cff if LockPick::is_set(run, k) else 0xecc85aff
            points: mutable RoomsView::Vec[32] = zeroed
            points[0] <- RoomsView::vec(x - 14.0, base + 10.0, 1.0)
            points[1] <- RoomsView::vec(x, base, 1.0)
            points[2] <- RoomsView::vec(x + 14.0, base + 10.0, 1.0)
            points[3] <- RoomsView::vec(x + 14.0, base + 60.0, 1.0)
            points[4] <- RoomsView::vec(x - 14.0, base + 60.0, 1.0)
            SceneHand::polygon(list, &points, 5, tint)
            rect(list, x - 14.0, base + 64.0, 28.0, 46.0, 0xaaaebeff)
            top: f64 = floor + 326.0
            for j in 0..<6 |list, x, top, base|:
                y0: f64 = base + 112.0 + (top - base - 112.0) * j.f64() / 6.0
                y1: f64 = base + 112.0 + (top - base - 112.0) * (j + 1).f64() / 6.0
                dx: f64 = -10.0 + 20.0 * (j % 2).f64()
                line(list, x + dx, y0, x - dx, y1, 2.0, 0xc8c8d2ff)
            if run.lock.level.glow and k == LockPick::binding(run):
                rect(list, x - 19.0, floor, 2.0, 330.0, 0xffdc5aff)
                rect(list, x + 17.0, floor, 2.0, 330.0, 0xffdc5aff)

    def stage(list: mutable Display::DisplayList&, run: LockPick::Run&):
        can Abort.Panic, Memory.Allocate:
            SceneHand::card(list, 0x181a22ff)
            left: f64 = LockPick::LEFT - 70.0
            right: f64 = LockPick::pin_x(run.lock.level.pins - 1) + 70.0
            floor: f64 = LockPick::FLOOR
            rect(list, left - 30.0, 150.0, right - left + 60.0, 440.0, 0x3c3e4aff)
            rect(list, left, 180.0, right - left, 390.0, 0xbe9646ff)
            rect(list, left, 180.0, right - left, floor - 180.0, 0x967432ff)
            rect(list, left - 30.0, floor - 26.0, right - left + 30.0, 26.0, 0x14141aff)
            for k in 0..<run.lock.level.pins |list, run|:
                pin(list, run, k)
            shear: f64 = floor + LockPick::LIFT + 62.0
            line(list, left, shear, right, shear, 1.0, 0x5a461eff)
            tip_x: f64 = run.hand.x
            tip_y: f64 = run.hand.y
            line(list, left - 200.0, floor - 40.0, tip_x - 14.0, tip_y - 14.0, 5.0, 0xd2d6e2ff)
            line(list, tip_x - 14.0, tip_y - 14.0, tip_x, tip_y, 5.0, 0xffdc78ff if run.hand.down else 0xd2d6e2ff)
            share: f64 = fmax(0.0, (run.lock.level.seconds - run.time) / run.lock.level.seconds)
            if share > 0.005:
                rect(list, 10.0, 6.0, 980.0 * share, 6.0,
                    ScenePolish::mix_rgb(0xec5040ff, 0x6edc8cff, fmin(1.0, share * 1.6)))

    def gauge(list: mutable Display::DisplayList&, run: LockPick::Run&):
        can Abort.Panic, Memory.Allocate:
            low: f64 = run.lock.level.low
            high: f64 = run.lock.level.high
            rect(list, 900.0, 200.0, 30.0, 300.0, 0x282a36ff)
            rect(list, 900.0, 200.0 + 300.0 * low, 30.0, 300.0 * (high - low), 0x3c8250ff)
            rect(list, 900.0, 200.0 + 300.0 * 0.97, 30.0, 9.0, 0xec5040ff)
            rect(list, 892.0, 196.0 + 300.0 * run.tension, 46.0, 8.0, 0xffffffff)
            SceneHand::word(list, "tension", 915.0, 180.0, 12.0, 0xe6e6e6ff)
            for k in 0..<3 |list, run|:
                Display::draw_circle(list, SceneHand::x(892.0 + 23.0 * k.f64()), SceneHand::y(530.0), 7.0 * SceneHand::SCALE,
                    0xec5040ff if k < run.slips else 0x464854ff)
            report: mutable dstr = []
            dstr_append_i64(&report, run.set_count)
            dstr_append_cstr(&report, " of ")
            dstr_append_i64(&report, run.lock.level.pins)
            dstr_append_cstr(&report, " set")
            SceneHand::word(list, bytes_view(report), 500.0, 612.0, 14.0, 0xffffffff, true)

    def verdict(result: i64) -> sview:
        return "The lock turned" if result == LockPick::TURNED
        return "The wrench slipped once too often" if result == LockPick::SLIPPED
        return "Someone is coming"

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: LockPick::Grade = LockPick::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.pins)
            dstr_append_cstr(out, " pins.")
            dstr_append_cstr(out, "  Some clicks are false.") if level.false_click
            dstr_append_cstr(out, "  The pins are not shown.") if level.hidden

    def render(list: mutable Display::DisplayList&, game: LockPickGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            tint: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Lock Pick", 456.0, 648.0, 22.0, tint, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Hold Space: tension   Hold the button under a pin and lift it until it sets   Esc: menu",
                456.0, 26.0, 12.0, tint, Display::ANCHOR_CENTER_CENTER)
            if game.phase == LockPickGame::READY:
                Display::draw_text(list, "Press Space or click to start", 456.0, 614.0, 14.0, tint, Display::ANCHOR_CENTER_CENTER)
                return
            if game.phase == LockPickGame::DONE:
                report: mutable dstr = []
                dstr_append_i64(&report, game.wins)
                dstr_append_cstr(&report, " of ")
                dstr_append_i64(&report, game.trial)
                dstr_append_cstr(&report, " passed   highest rung passed ")
                dstr_append_i64(&report, game.best_rung)
                Display::draw_text(list, bytes_view(report), 456.0, 614.0, 14.0, tint, Display::ANCHOR_CENTER_CENTER)
                return
            stage(list, &game.run)
            gauge(list, &game.run)
            Display::draw_text(list, "Keep the tension in the band and set each pin", 456.0, 614.0, 14.0, tint, Display::ANCHOR_CENTER_CENTER)
            facts: mutable dstr = dstr_of_cstr("rung ")
            dstr_append_i64(&facts, game.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, game.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, game.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, game.run.lock.level.pins)
            dstr_append_cstr(&facts, " pins")
            Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, tint, Display::ANCHOR_CENTER_CENTER)
            if game.phase == LockPickGame::JUDGED:
                result: i64 = game.run.result
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, result == LockPick::TURNED, verdict(result), 60.0, 16.0)
