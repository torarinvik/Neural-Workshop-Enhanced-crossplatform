include "./tasks/emotionfaces_game.elisa"
include "./scene_reading_quiz.elisa"

module SceneEmotionFaces:
    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            g: EmotionFaces::Grade = EmotionFaces::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, g.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, g.options)
            dstr_append_cstr(out, " emotions to tell apart.")

    def verdict(run: ReadingQuiz::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_i64(out, run.right)
            dstr_append_cstr(out, " of ")
            dstr_append_i64(out, run.round.items.count.i64())
            dstr_append_cstr(out, " right")
            if run.result == ReadingQuiz::FAILED:
                dstr_append_cstr(out, ", ")
                dstr_append_i64(out, run.round.need)
                dstr_append_cstr(out, " needed")

    # Run.face_visible: from rung 8 the face is covered after a moment.
    def visible(run: ReadingQuiz::Run&, flash: f64) -> bool:
        return flash <= 0.0 or run.showing or run.time - run.since < flash

    def segment(list: mutable Display::DisplayList&, x1: f64, y1: f64, x2: f64, y2: f64, width: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_line(list, SceneHand::x(x1), SceneHand::y(y1), SceneHand::x(x2), SceneHand::y(y2), width * SceneHand::SCALE, colour)

    # HandTask.oval: a twenty-sided polygon.
    def oval(list: mutable Display::DisplayList&, cx: f64, cy: f64, rx: f64, ry: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            points: mutable RoomsView::Vec[32] = zeroed
            for k in 0..<20 |points, cx, cy, rx, ry|:
                a: f64 = 2.0 * EmotionFaces::PI * k.f64() / 20.0
                points[k.usize()] <- RoomsView::Vec{x: cx + rx * cos(a), y: cy + ry * sin(a), z: 1.0}
            SceneHand::polygon(list, &points, 20, colour)

    # Emotion._drawn: brows, eyes and mouth on an oval, or the part the crop
    # keeps.
    def drawn(list: mutable Display::DisplayList&, face: EmotionFaces::Face&, crop: i64):
        can Memory.Allocate, Abort.Panic:
            tilt: f64 = face.params[0]
            brow_h: f64 = face.params[1]
            eye_open: f64 = face.params[2]
            curve: f64 = face.params[3]
            mouth_open: f64 = face.params[4]
            smirk: f64 = face.params[5]
            cx: f64 = 500.0
            cy: f64 = 380.0
            skin: u32 = 0xe8c4aaff
            ink: u32 = 0x3c2828ff
            if crop != EmotionFaces::MOUTH:
                oval(list, cx, cy, 120.0, 150.0, skin)
            else:
                SceneMissingWord::rect(list, cx - 120.0, cy - 150.0, 240.0, 120.0, skin)
            if crop == EmotionFaces::EYES:
                SceneMissingWord::rect(list, cx - 125.0, cy - 160.0, 250.0, 150.0, 0x181a22ff)
            if crop != EmotionFaces::MOUTH:
                for s in 0..<2 |list, tilt, brow_h, eye_open, cx, cy, ink|:
                    side: f64 = -1.0 if s == 0 else 1.0
                    ex: f64 = cx + side * 45.0
                    ey: f64 = cy + 35.0
                    oval(list, ex, ey, 18.0, 4.0 + 12.0 * fmax(0.1, eye_open), 0xfafafaff)
                    Display::draw_circle(list, SceneHand::x(ex), SceneHand::y(ey), 7.0 * SceneHand::SCALE, 0x3c3228ff)
                    by: f64 = ey + 30.0 + 18.0 * brow_h
                    inner: f64 = by - side * 0.0 + 16.0 * tilt * -1.0 * 0.8
                    segment(list, ex - side * 26.0, by - 10.0 * tilt * 0.0, ex + side * -2.0, inner, 6.0, ink)
            if crop != EmotionFaces::EYES:
                my: f64 = cy - 70.0
                px: mutable f64[13] = zeroed
                py: mutable f64[13] = zeroed
                for k in 0..<13 |px, py, curve, smirk, cx, my|:
                    u: f64 = (k - 6).f64() / 6.0
                    lift: mutable f64 = curve * 26.0 * (u * u) - curve * 10.0
                    lift <- lift + smirk * 18.0 * fmax(0.0, u)
                    px[k.usize()] <- cx + u * 50.0
                    py[k.usize()] <- my + lift
                for k in 0..<12 |list, px, py, ink|:
                    segment(list, px[k.usize()], py[k.usize()], px[(k + 1).usize()], py[(k + 1).usize()], 5.0, ink)
                if mouth_open > 0.2:
                    oval(list, cx, my - 4.0, 20.0 + 10.0 * mouth_open, 4.0 + 20.0 * mouth_open, 0x5a1e28ff)

    # Emotion._show: the face in a frame, or a cover once its moment ends.
    def show(list: mutable Display::DisplayList&, run: ReadingQuiz::Run&, corpus: EmotionFaces::Corpus&, flash: f64,
            faces: darray[i64]&, crops: darray[i64]&):
        can Memory.Allocate, Abort.Panic:
            cx: f64 = 500.0
            cy: f64 = 380.0
            half: f64 = 165.0
            SceneMissingWord::rect(list, cx - half - 6.0, cy - half - 6.0, 342.0, 342.0, 0x181a22ff)
            if not visible(run, flash):
                SceneMissingWord::rect(list, cx - half, cy - half, 330.0, 330.0, 0x6e7078ff)
                SceneHand::word(list, "?", cx, cy, 40.0, 0xc8c8d2ff, true)
                return
            return if run.index >= faces.count.i64() or run.index >= crops.count.i64()
            index: i64 = faces[run.index.usize()]
            return if index < 0 or index >= corpus.faces.count.i64()
            drawn(list, &corpus.faces[index.usize()], crops[run.index.usize()])

    # FeelingTask._scene with the face for the text box.
    def page(list: mutable Display::DisplayList&, run: ReadingQuiz::Run&, corpus: EmotionFaces::Corpus&, flash: f64,
            faces: darray[i64]&, crops: darray[i64]&):
        can Memory.Allocate, Abort.Panic:
            SceneReadingQuiz::dots(list, run)
            item: ReadingQuiz::Item = ReadingQuiz::question(run)
            count: i64 = item.steps.count.i64()
            return if count == 0
            show(list, run, corpus, flash, faces, crops)
            step: ReadingQuiz::Step = item.steps[(count - 1).usize()] if run.showing else ReadingQuiz::active_step(run)
            return if step.options.count == 0.usize()
            ask: mutable dstr = []
            color: mutable u32 = SceneReadingQuiz::PALE
            if run.showing:
                color <- 0x8ce6a0ff if run.correct else 0xff9682ff
                dstr_append_cstr(&ask, "Right: " if run.correct else "No: ")
                dstr_append_dstr(&ask, item.truth)
            else:
                dstr_append_dstr(&ask, step.ask)
                if count > 1:
                    dstr_append_cstr(&ask, "  (")
                    dstr_append_i64(&ask, run.progress + 1)
                    dstr_append_cstr(&ask, " of ")
                    dstr_append_i64(&ask, count)
                    dstr_append_cstr(&ask, ")")
            SceneReadingQuiz::paragraph(list, bytes_view(ask), 500.0, 150.0, 13.0, 900.0, color, false, false, true)
            SceneReadingQuiz::buttons(list, &step, run.showing, run.selected)
            if not run.showing:
                share: f64 = fmax(0.0, item.seconds - (run.time - run.since)) / item.seconds
                SceneMissingWord::rect(list, 20.0, 8.0, 960.0 * share, 6.0, 0x6ec88cff if share > 0.3 else 0xe66e50ff)

    def render(list: mutable Display::DisplayList&, session: EmotionFacesGame::Session&, corpus: EmotionFaces::Corpus&, dark: bool):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            SceneMissingWord::label(list, "Emotion", 648.0, 22.0, ink, true)
            SceneMissingWord::label(list, "Click an answer or press its number", 26.0, 12.0, ink)
            message: mutable dstr = []
            if session.phase == EmotionFacesGame::READY:
                dstr_append_cstr(&message, "Press Space or click to start")
            elif session.phase == EmotionFacesGame::DONE:
                dstr_append_i64(&message, session.wins)
                dstr_append_cstr(&message, " of ")
                dstr_append_i64(&message, session.trial)
                dstr_append_cstr(&message, " passed   highest rung passed ")
                dstr_append_i64(&message, session.best_rung)
            elif session.phase == EmotionFacesGame::JUDGED:
                verdict(&session.run, &message)
            else:
                dstr_append_cstr(&message, "Which emotion is this face showing?")
            SceneMissingWord::label(list, bytes_view(message), 614.0, 14.0, ink)
            if session.phase == EmotionFacesGame::PLAYING or session.phase == EmotionFacesGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                SceneMissingWord::label(list, bytes_view(facts), 588.0, 12.0, ink)
                SceneHand::card(list, 0x2c3040ff)
                page(list, &session.run, corpus, session.level.flash, &session.faces, &session.crops)
                SceneHand::progress(list, &session.hand, 0.0)
            if session.phase == EmotionFacesGame::JUDGED or session.phase == EmotionFacesGame::DONE:
                last: mutable dstr = []
                verdict(&session.run, &last)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.run.result == ReadingQuiz::PASSED,
                    bytes_view(last), 60.0, 16.0)
