include "./tasks/pov.elisa"

module PointOfViewView:
    const TABLE_TOP: u32 = 0xceba96ff

    def colour(solid: Nearer::Solid) -> u32:
        return Rooms::colour(solid.colour) if solid.colour >= 0 else 0xaaaab0ff

    def picture(table: PointOfView::Arrangement&, view: PointOfView::View) -> RoomsView::Picture:
        can Abort.Panic:
            cam: RoomsView::Camera = PointOfView::camera(view)
            t: f64 = PointOfView::TABLE
            zero: RoomsView::Vec = RoomsView::vec(0.0, 0.0, 0.0)
            top: RoomsView::Vec[6] = [RoomsView::vec(-t, 0.0, -t), RoomsView::vec(t, 0.0, -t),
                RoomsView::vec(t, 0.0, t), RoomsView::vec(-t, 0.0, t), zero, zero]
            out: mutable RoomsView::Picture = zeroed
            p: RoomsView::Polygon = RoomsView::polygon(&cam, &top, 4, zero, TABLE_TOP, -1)
            out.polygons[0] <- RoomsView::Polygon{points: p.points, count: 4, colour: TABLE_TOP, depth: 1000000000.0, cell: -1}
            out.count <- 1
            for i in 0..<table.count |table, out, cam|:
                s: Nearer::Solid = table.solids[i.usize()]
                solid: RoomsView::Solid = RoomsView::Solid{centre: RoomsView::vec(s.x, s.y, s.z),
                    size: s.size, height: s.y * 2.0, angle: s.yaw, cell: i, colour: colour(s)}
                if s.kind < 2:
                    RoomsView::box(&out, &cam, &solid, 1, s.kind == 1)
                else:
                    RoomsView::prism(&out, &cam, &solid, 1, s.kind == 2)
            if view.mirrored:
                for i in 0..<out.count |out|:
                    p: mutable RoomsView::Polygon = out.polygons[i.usize()]
                    for k in 0..<p.count |p|:
                        point: RoomsView::Point = p.points[k.usize()]
                        p.points[k.usize()] <- RoomsView::Point{x: -point.x, y: point.y}
                    out.polygons[i.usize()] <- p
            return out

    def footprint(s: Nearer::Solid) -> RoomsView::Polygon:
        can Abort.Panic:
            count: i64 = 6 if s.kind == 3 else 4
            out: mutable RoomsView::Polygon = RoomsView::Polygon{points: zeroed, count: count,
                colour: colour(s), depth: 0.0, cell: -1}
            if s.kind < 2:
                side: f64 = 0.5 * s.size * (0.7 if s.kind == 1 else 1.0)
                c: f64 = cos(s.yaw)
                sin_yaw: f64 = sin(s.yaw)
                for i in 0..<4 |out, s, c, sin_yaw, side|:
                    x: f64 = -side if i == 0 or i == 3 else side
                    z: f64 = -side if i < 2 else side
                    p: RoomsView::Vec = RoomsView::yaw(RoomsView::vec(x, 0.0, z), c, sin_yaw)
                    out.points[i.usize()] <- RoomsView::Point{x: s.x + p.x, y: s.z + p.z}
            else:
                r: f64 = s.size * (0.62 if s.kind == 2 else 0.55)
                for i in 0..<count |out, s, r, count|:
                    angle: f64 = s.yaw + 2.0 * PointOfView::PI * (count - 1 - i).f64() / count.f64()
                    out.points[i.usize()] <- RoomsView::Point{x: s.x + r * cos(angle), y: s.z + r * sin(angle)}
            return out
