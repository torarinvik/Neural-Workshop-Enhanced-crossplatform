include "./tasks/mirror.elisa"

module MirrorView:
    def centre(shape: Mirror::Shape&) -> RoomsView::Vec:
        can Abort.Panic:
            x: mutable i64 = 0
            y: mutable i64 = 0
            z: mutable i64 = 0
            for i in 0..<shape.count |shape, x, y, z|:
                c: Mirror::Cube = shape.cubes[i.usize()]
                x <- x + c.x
                y <- y + c.y
                z <- z + c.z
            n: f64 = shape.count.f64()
            return RoomsView::vec(x.f64() / n, y.f64() / n, z.f64() / n)

    def centered(c: Mirror::Cube, mean: RoomsView::Vec) -> RoomsView::Vec:
        return RoomsView::sub(RoomsView::vec(c.x.f64(), c.y.f64(), c.z.f64()), mean)

    def radius(shape: Mirror::Shape&) -> f64:
        can Abort.Panic:
            high: mutable f64 = 0.0
            mean: RoomsView::Vec = centre(shape)
            for i in 0..<shape.count |shape, mean, high|:
                v: RoomsView::Vec = centered(shape.cubes[i.usize()], mean)
                d: f64 = RoomsView::dot(v, v)
                high <- d if d > high
            return sqrt(high) + sqrt(3.0) / 2.0

    def camera() -> RoomsView::Camera:
        can Abort.Panic:
            eye: RoomsView::Vec = RoomsView::vec(7.0, 5.5, 11.0)
            forward: RoomsView::Vec = RoomsView::unit(RoomsView::mul(eye, -1.0))
            right: RoomsView::Vec = RoomsView::unit(RoomsView::cross(forward, RoomsView::vec(0.0, 1.0, 0.0)))
            return RoomsView::Camera{eye: eye, forward: forward, right: right, up: RoomsView::cross(right, forward)}

    def face(view: mutable RoomsView::Picture&, cam: RoomsView::Camera&, mid: RoomsView::Vec,
             normal: RoomsView::Vec, turn: Mirror::Matrix, lit: bool):
        can Abort.Panic:
            world_normal: RoomsView::Vec = Mirror::apply(turn, normal)
            return if RoomsView::dot(world_normal, cam.forward) >= -0.000000001
            helper: RoomsView::Vec = RoomsView::vec(0.0, 0.0, 1.0) if normal.y != 0.0 else RoomsView::vec(0.0, 1.0, 0.0)
            right: RoomsView::Vec = RoomsView::unit(RoomsView::cross(helper, normal))
            up: RoomsView::Vec = RoomsView::cross(normal, right)
            center: RoomsView::Vec = RoomsView::add(mid, RoomsView::mul(normal, 0.5))
            anchor: RoomsView::Vec = Mirror::apply(turn, mid)
            light: RoomsView::Vec = RoomsView::unit(RoomsView::vec(-0.45, 0.85, 0.55))
            brightness: f64 = RoomsView::dot(world_normal, light)
            shade: f64 = 0.48 + 0.52 * (brightness if brightness > 0.0 else 0.0)
            fill: u32 = RoomsView::tint(0xd6b070ff, shade) if lit else 0xe2d6beff
            item: mutable RoomsView::Polygon = RoomsView::Polygon{points: zeroed, count: 4, colour: fill,
                depth: RoomsView::dot(RoomsView::sub(anchor, cam.eye), cam.forward), cell: -1}
            for i in 0..<4 |item, center, right, up, turn, cam|:
                a: f64 = -0.5 if i == 0 or i == 3 else 0.5
                b: f64 = -0.5 if i < 2 else 0.5
                point: RoomsView::Vec = RoomsView::add(center, RoomsView::add(RoomsView::mul(right, a), RoomsView::mul(up, b)))
                v: RoomsView::Vec = RoomsView::sub(Mirror::apply(turn, point), cam.eye)
                item.points[i.usize()] <- RoomsView::Point{x: RoomsView::dot(v, cam.right), y: RoomsView::dot(v, cam.up)}
            RoomsView::insert(view, item, 0)

    def scene(figure: Mirror::Figure&, lit: bool) -> RoomsView::Picture:
        can Abort.Panic:
            cam: RoomsView::Camera = camera()
            mean: RoomsView::Vec = centre(&figure.shape)
            out: mutable RoomsView::Picture = zeroed
            for i in 0..<figure.shape.count |figure, mean, cam, out, lit|:
                cell: Mirror::Cube = figure.shape.cubes[i.usize()]
                mid: RoomsView::Vec = centered(cell, mean)
                for side in 0..<6 |figure, cell, mid, cam, out, lit|:
                    axis: i64 = side / 2
                    sign: i64 = 1 if side % 2 == 0 else -1
                    if not Mirror::has(&figure.shape, Mirror::step(cell, axis, sign)):
                        normal: RoomsView::Vec = Mirror::axis_row((axis + 1) * sign)
                        face(&out, &cam, mid, normal, figure.turn, lit)
            return out
