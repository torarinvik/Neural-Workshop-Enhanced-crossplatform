include "./scene_hand.elisa"
include "./geometry.elisa"
include "./scene_verdict.elisa"
include "./tasks/tightrope_game.elisa"

module SceneTightrope:
    const LENGTH: f64 = 70.0
    const GROUND: f64 = -38.0
    const FOCAL: f64 = 520.0
    const HORIZON: f64 = 400.0
    const BACK_OFF: f64 = 4.2
    const PI: f64 = 3.141592653589793

    struct View:
        camera: RoomsView::Vec
        walk_z: f64
        shape: f64

    struct Building:
        x: f64
        z: f64
        width: f64
        depth: f64
        height: f64
        tint: u32

    def point(x: f64, y: f64) -> RoomsView::Vec:
        return RoomsView::vec(x, y, 1.0)

    def project(view: View&, x: f64, y: f64, z: f64) -> RoomsView::Vec:
        depth: f64 = z - view.camera.z
        return RoomsView::vec(0.0, 0.0, 0.0) if depth < 0.4
        return point(500.0 + FOCAL * (x - view.camera.x) / depth,
            HORIZON + FOCAL * (y - view.camera.y) / depth)

    def wire(view: View&, run: Tightrope::Run&, z: f64) -> RoomsView::Vec:
        shape: f64 = fmax(0.0, sin(PI * z / LENGTH))
        ratio: f64 = fmin(shape / view.shape, 1.6)
        return RoomsView::vec(run.swing * 0.6 * ratio,
            run.boing * 0.35 * ratio - 1.2 * (shape - view.shape), z)

    def screen(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            width: f64 = fmin(1000.0, x + w) - x
            height: f64 = fmin(640.0, y + h) - y
            return if width <= 0.0 or height <= 0.0
            Display::draw_rect(list, SceneHand::x(x), SceneHand::y(y), width * SceneHand::SCALE, height * SceneHand::SCALE, tint)

    def face(list: mutable Display::DisplayList&, a: RoomsView::Vec, b: RoomsView::Vec, c: RoomsView::Vec,
             tint: u32, d: RoomsView::Vec = RoomsView::Vec{x: 0.0, y: 0.0, z: -1.0}):
        can Abort.Panic, Memory.Allocate:
            return if a.z == 0.0 or b.z == 0.0 or c.z == 0.0 or d.z == 0.0
            vertices: mutable RoomsView::Vec[32] = zeroed
            vertices[0] <- a
            vertices[1] <- b
            vertices[2] <- c
            vertices[3] <- d
            SceneHand::polygon(list, &vertices, 3 if d.z < 0.0 else 4, tint)

    def oval(list: mutable Display::DisplayList&, p: RoomsView::Vec, rx: f64, ry: f64, tint: u32, count: i64 = 20):
        can Abort.Panic, Memory.Allocate:
            vertices: mutable RoomsView::Vec[32] = zeroed
            for i in 0..<count |vertices, p, rx, ry, count|:
                angle: f64 = 2.0 * PI * i.f64() / count.f64()
                vertices[i.usize()] <- point(p.x + rx * cos(angle), p.y + ry * sin(angle))
            SceneHand::polygon(list, &vertices, count, tint)

    def disc(list: mutable Display::DisplayList&, p: RoomsView::Vec, radius: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            if p.x < radius or p.x > 1000.0 - radius or p.y < radius or p.y > 640.0 - radius:
                oval(list, p, radius, radius, tint, 16)
                return
            Display::draw_circle(list, SceneHand::x(p.x), SceneHand::y(p.y),
                fmax(1.0, radius * SceneHand::SCALE), tint)

    def backdrop(list: mutable Display::DisplayList&, view: View&):
        can Abort.Panic, Memory.Allocate:
            SceneHand::card(list, 0x1e2846ff)
            for k in 0..<8 |list|:
                screen(list, 0.0, HORIZON + 240.0 * k.f64() / 8.0, 1000.0, 31.0,
                    ScenePolish::mix_rgb(0xfab482ff, 0x324682ff, k.f64() / 7.0))
            for k in 0..<6 |list|:
                screen(list, 0.0, HORIZON * (1.0 - (k + 1).f64() / 6.0), 1000.0, HORIZON / 6.0 + 1.0,
                    ScenePolish::mix_rgb(0x786e82ff, 0x282c40ff, k.f64() / 5.0))
            for k in 0..<11 |list, view|:
                x: f64 = -60.0 + 12.0 * k.f64()
                SceneHand::line(list, project(view, x, GROUND, view.camera.z + 1.0),
                    project(view, x, GROUND, 200.0), 1.0, 0x5a5a6eff)
            for k in 0..<30 |list, view|:
                z: f64 = (k - 6).f64() * 9.0 + 4.5
                SceneHand::line(list, project(view, -80.0, GROUND, z), project(view, 80.0, GROUND, z), 1.0, 0x5a5a6eff)

    def building(list: mutable Display::DisplayList&, view: View&, block: Building&):
        can Abort.Panic, Memory.Allocate:
            z: f64 = block.z
            far: f64 = z + block.depth
            return if far < view.camera.z + 1.0 or z > view.camera.z + 160.0
            top: f64 = GROUND + block.height
            left: f64 = block.x - block.width / 2.0
            right: f64 = block.x + block.width / 2.0
            inner: f64 = left if block.x > view.camera.x else right
            face(list, project(view, left, GROUND, z), project(view, right, GROUND, z), project(view, right, top, z),
                ScenePolish::mix_rgb(block.tint, 0x000000ff, 0.2), project(view, left, top, z))
            face(list, project(view, inner, GROUND, z), project(view, inner, GROUND, far), project(view, inner, top, far),
                ScenePolish::mix_rgb(block.tint, 0x000000ff, 0.45), project(view, inner, top, z))
            face(list, project(view, left, top, z), project(view, right, top, z), project(view, right, top, far),
                ScenePolish::mix_rgb(block.tint, 0xffffffff, 0.25), project(view, left, top, far))
            return if z - view.camera.z >= 70.0
            row: mutable i64 = 2
            while row < block.height.i64() - 1 |list, view, block, z, left, row|:
                col: mutable i64 = 1
                while col < block.width.i64() - 1 |list, view, block, z, left, row, col|:
                    if ((block.x * 7.0).i64() + row * 3 + col) % 3 == 0:
                        x: f64 = left + col.f64()
                        y: f64 = GROUND + row.f64()
                        face(list, project(view, x, y, z), project(view, x + 0.8, y, z),
                            project(view, x + 0.8, y + 1.4, z), 0xfadc82ff, project(view, x, y + 1.4, z))
                    col <- col + 2
                row <- row + 4

    def city(list: mutable Display::DisplayList&, view: View&):
        can Abort.Panic, Memory.Allocate:
            draw: mutable MT19937 = zeroed
            mt_seed_int(&draw, 7.u64())
            blocks: mutable Building[126] = zeroed
            for row in 0..<21 |draw, blocks|:
                for column in 0..<6 |draw, blocks, row|:
                    side: f64 = -1.0 if column < 3 else 1.0
                    x: f64 = side * (9.0 + (column % 3).f64() * 13.0 + Tightrope::uniform(&draw, 0.0, 3.0))
                    z: f64 = (row - 3).f64() * 9.0 + Tightrope::uniform(&draw, -1.0, 1.0)
                    width: f64 = Tightrope::uniform(&draw, 4.0, 7.0)
                    depth: f64 = Tightrope::uniform(&draw, 3.0, 7.0)
                    height: f64 = Tightrope::uniform(&draw, 8.0, 30.0)
                    tint: u32 = ScenePolish::mix_rgb(0x2e3450ff, 0x605a6eff, mt_random_res53(&draw))
                    at: mutable i64 = column
                    while at > 0 and z > blocks[(row * 6 + at - 1).usize()].z |blocks, row, at, z|:
                        blocks[(row * 6 + at).usize()] <- blocks[(row * 6 + at - 1).usize()]
                        at <- at - 1
                    blocks[(row * 6 + at).usize()] <- Building{x: x, z: z, width: width, depth: depth, height: height, tint: tint}
            for k in 0..<21 |blocks, list, view|:
                for column in 0..<6 |blocks, list, view, k|:
                    building(list, view, &blocks[((20 - k) * 6 + column).usize()])

    def tower(list: mutable Display::DisplayList&, view: View&, time: f64, wind: f64):
        can Abort.Panic, Memory.Allocate:
            face(list, project(view, -2.5, GROUND, LENGTH), project(view, 2.5, GROUND, LENGTH),
                project(view, 2.5, 0.0, LENGTH), 0x464250ff, project(view, -2.5, 0.0, LENGTH))
            face(list, project(view, 2.5, GROUND, LENGTH), project(view, 2.5, GROUND, LENGTH + 5.0),
                project(view, 2.5, 0.0, LENGTH + 5.0), 0x2a2830ff, project(view, 2.5, 0.0, LENGTH))
            face(list, project(view, -3.5, 0.0, LENGTH - 1.0), project(view, 3.5, 0.0, LENGTH - 1.0),
                project(view, 3.5, 0.0, LENGTH + 6.0), 0xc85046ff, project(view, -3.5, 0.0, LENGTH + 6.0))
            flag_top: RoomsView::Vec = project(view, 1.5, 4.0, LENGTH)
            SceneHand::line(list, project(view, 1.5, 0.0, LENGTH), flag_top, 2.0, 0x282828ff)
            tip: f64 = 1.5 + 2.2 * HandView::clamp(wind / 1.2, -1.0, 1.0) + 0.3
            face(list, flag_top, project(view, tip, 3.6 + sin(time * 9.0) * 0.3, LENGTH),
                project(view, 1.5, 3.2, LENGTH), 0xf0dc50ff)

    def wire_and_wind(list: mutable Display::DisplayList&, view: View&, run: Tightrope::Run&, wind: f64):
        can Abort.Panic, Memory.Allocate:
            foot: RoomsView::Vec = wire(view, run, view.walk_z)
            base: RoomsView::Vec = project(view, foot.x, foot.y, foot.z)
            prev: mutable RoomsView::Vec = base
            for k in 1..<25 |list, view, run, prev|:
                z: f64 = view.walk_z + (LENGTH - view.walk_z) * pow(k.f64() / 24.0, 1.5)
                offset: RoomsView::Vec = wire(view, run, z)
                here: RoomsView::Vec = project(view, offset.x, offset.y, z)
                SceneHand::line(list, prev, here, 3.0, 0x1e1e24ff)
                prev <- here
            behind: RoomsView::Vec = wire(view, run, view.walk_z - 2.5)
            SceneHand::line(list, base, project(view, behind.x, behind.y, behind.z), 4.0, 0x1e1e24ff)
            return if fabs(wind) <= 0.05
            way: f64 = 1.0 if wind > 0.0 else -1.0
            tint: u32 = 0xffffff00.u32() | fmin(200.0, 60.0 + 110.0 * fabs(wind)).u32()
            for k in 0..<14 |list, view, run, wind, way, tint|:
                z: f64 = view.camera.z + (3 + k * 7 % 13).f64()
                drift: f64 = run.time * 9.0 * way * fabs(wind) + k.f64() * 5.3
                x: f64 = drift - floor(drift / 24.0) * 24.0 - 12.0
                y: f64 = -1.0 + (k * 3 % 7).f64() * 0.7
                SceneHand::line(list, project(view, x, y, z), project(view, x - 1.2 * way, y, z), 2.0, tint)

    def up(view: View&, run: Tightrope::Run&, foot: RoomsView::Vec, height: f64, side: f64 = 0.0) -> RoomsView::Vec:
        sx: f64 = side * cos(run.lean) + height * sin(run.lean)
        sy: f64 = height * cos(run.lean) - side * sin(run.lean)
        p: RoomsView::Vec = project(view, foot.x + sx, foot.y + sy * cos(run.pitch), foot.z + sy * sin(run.pitch))
        return p if p.z > 0.0 else project(view, foot.x, foot.y, foot.z)

    def pole(run: Tightrope::Run&, x: f64) -> RoomsView::Vec:
        return point(x, Tightrope::LEVEL + Tightrope::FWD_PX * run.held_f - (x - 500.0) * (tan(run.lean) * 0.5))

    def walker(list: mutable Display::DisplayList&, view: View&, run: Tightrope::Run&):
        can Abort.Panic, Memory.Allocate:
            foot: RoomsView::Vec = wire(view, run, view.walk_z)
            base: RoomsView::Vec = project(view, foot.x, foot.y, foot.z)
            k: f64 = FOCAL / BACK_OFF / 162.0
            oval(list, point(base.x, base.y - 2.0), 26.0 * k, 6.0 * k, 0x0000005a)
            for i in 0..<2 |list, view, run, foot, k|:
                side: f64 = -1.0 if i == 0 else 1.0
                shoe: RoomsView::Vec = project(view, foot.x + 0.06 * side, foot.y, foot.z + 0.12 * side * run.foot.f64())
                hip: RoomsView::Vec = up(view, run, foot, 0.92, 0.13 * side)
                face(list, point(shoe.x - 7.0 * k, shoe.y), point(shoe.x + 7.0 * k, shoe.y),
                    point(hip.x + 13.0 * k, hip.y), 0x282c46ff if i == 0 else 0x343a5aff, point(hip.x - 13.0 * k, hip.y))
                oval(list, point(shoe.x, shoe.y + 3.0 * k), 10.0 * k, 6.0 * k, 0x141418ff)
            face(list, up(view, run, foot, 0.9, -0.2), up(view, run, foot, 0.9), up(view, run, foot, 1.5),
                0xaa323cff, up(view, run, foot, 1.5, -0.26))
            face(list, up(view, run, foot, 0.9), up(view, run, foot, 0.9, 0.2), up(view, run, foot, 1.5, 0.26),
                0xd24650ff, up(view, run, foot, 1.5))
            face(list, up(view, run, foot, 1.46, -0.27), up(view, run, foot, 1.46, 0.27), up(view, run, foot, 1.53, 0.2),
                0xe65a64ff, up(view, run, foot, 1.53, -0.2))
            disc(list, up(view, run, foot, 1.62), 9.0 * k, 0xdcba9cff)
            disc(list, up(view, run, foot, 1.74), 21.0 * k, 0xecc8aaff)
            oval(list, up(view, run, foot, 1.78), 22.0 * k, 17.0 * k, 0x3c281eff)
            mid: f64 = 500.0 + Tightrope::REACH * run.held * 0.35
            left: RoomsView::Vec = pole(run, mid - 0.75 * Tightrope::REACH)
            right: RoomsView::Vec = pole(run, mid + 0.75 * Tightrope::REACH)
            SceneHand::line(list, left, right, 9.0, 0x968c6eff)
            SceneHand::line(list, left, right, 5.0, 0xf0e6c4ff)
            disc(list, left, 7.0, 0x5a5046ff)
            disc(list, right, 7.0, 0x5a5046ff)
            for i in 0..<2 |list, view, run, foot, k|:
                side: f64 = -1.0 if i == 0 else 1.0
                hand: RoomsView::Vec = pole(run, 500.0 + 70.0 * side)
                SceneHand::line(list, up(view, run, foot, 1.45, 0.24 * side), hand, 9.0 * k, 0xbe3c46ff)
                disc(list, hand, 8.0, 0xecc8aaff)
            for i in 0..<run.perches |list, run|:
                end: i64 = run.perched[i.usize()]
                side: f64 = end.f64()
                bird: RoomsView::Vec = Tightrope::bird_spot(run, end)
                oval(list, point(bird.x, bird.y + 12.0), 16.0, 11.0, 0x282832ff)
                oval(list, point(bird.x - 3.0 * side, bird.y + 14.0), 9.0, 6.0, 0x464654ff)
                disc(list, point(bird.x + 9.0 * side, bird.y + 22.0), 7.0, 0x282832ff)
                face(list, point(bird.x + 15.0 * side, bird.y + 23.0), point(bird.x + 24.0 * side, bird.y + 20.0),
                    point(bird.x + 15.0 * side, bird.y + 18.0), 0xfab43cff)

    def hud(list: mutable Display::DisplayList&, run: Tightrope::Run&, share: f64):
        can Abort.Panic, Memory.Allocate:
            screen(list, 250.0, 606.0, 500.0, 10.0, 0x141828dc)
            screen(list, 250.0, 606.0, 500.0 * share, 10.0, 0x6edc8cff)
            steps: mutable dstr = []
            dstr_append_i64(&steps, run.taken)
            dstr_append_cstr(&steps, " of ")
            dstr_append_i64(&steps, run.walk.level.steps)
            dstr_append_cstr(&steps, " steps")
            SceneHand::word(list, bytes_view(steps), 500.0, 588.0, 12.0, 0xffffffe6)
            lean: f64 = run.lean / 0.7
            pitch: f64 = run.pitch / 0.6
            danger: f64 = fmax(fabs(lean), fabs(pitch))
            center: RoomsView::Vec = point(930.0, 560.0)
            disc(list, center, 45.0, 0x141828dc)
            disc(list, center, 42.0, ScenePolish::mix_rgb(0x467850ff, 0xb43c32ff, fmin(1.0, danger)))
            disc(list, center, 21.0, ScenePolish::mix_rgb(0x5a9664ff, 0xc8503cff, fmin(1.0, danger)))
            SceneHand::line(list, point(888.0, 560.0), point(972.0, 560.0), 1.0, 0x141e14ff)
            SceneHand::line(list, point(930.0, 518.0), point(930.0, 602.0), 1.0, 0x141e14ff)
            disc(list, point(930.0 + HandView::clamp(lean, -1.0, 1.0) * 34.0,
                560.0 + HandView::clamp(pitch, -1.0, 1.0) * 34.0), 8.0, 0xf0fadcff)
            SceneHand::word(list, "forward", 930.0, 612.0, 8.0, 0xffffffc8)
            if danger > 0.5:
                warning: sview = "LEANING" if fabs(lean) > fabs(pitch) else ("TIPPING FORWARD" if pitch > 0.0 else "TIPPING BACK")
                SceneHand::word(list, warning, 500.0, 560.0, 14.0, 0xff785aff, true)

    def play(list: mutable Display::DisplayList&, run: Tightrope::Run&):
        can Abort.Panic, Memory.Allocate:
            share: f64 = run.taken.f64() / fmax(1.0, run.walk.level.steps.f64())
            z: f64 = 4.0 + share * (LENGTH - 8.0)
            view: View = View{camera: RoomsView::vec(run.swing * 0.6, 2.3 + run.boing * 0.35, z - BACK_OFF),
                walk_z: z, shape: fmax(0.25, sin(PI * z / LENGTH))}
            wind: f64 = Tightrope::wind(run)
            backdrop(list, &view)
            city(list, &view)
            tower(list, &view, run.time, wind)
            wire_and_wind(list, &view, run, wind)
            walker(list, &view, run)
            SceneHand::progress(list, &run.hand, fmax(0.0, (run.walk.level.seconds - run.time) / run.walk.level.seconds))
            hud(list, run, share)

    def verdict(result: i64) -> sview:
        return "Across" if result == Tightrope::ACROSS
        return "You fell" if result == Tightrope::SIDEWAYS
        return "You fell forward" if result == Tightrope::FORWARD
        return "You fell backward" if result == Tightrope::BACKWARD
        return "Out of time on the wire"

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: Tightrope::Grade = Tightrope::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.steps)
            dstr_append_cstr(out, " steps.")
            if level.gusts > 0:
                dstr_append_cstr(out, "  ")
                dstr_append_i64(out, level.gusts)
                dstr_append_cstr(out, " gusts.")
            if level.birds > 0:
                dstr_append_cstr(out, "  ")
                dstr_append_i64(out, level.birds)
                dstr_append_cstr(out, " birds.")

    def render(list: mutable Display::DisplayList&, game: TightropeGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Tightrope", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Mouse: the pole, across and forward   Space: a step   Click a bird to shoo it   Esc: menu",
                456.0, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            if game.phase == TightropeGame::READY:
                Display::draw_text(list, "Press Space or click to start", 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            if game.phase == TightropeGame::DONE:
                report: mutable dstr = []
                dstr_append_i64(&report, game.wins)
                dstr_append_cstr(&report, " of ")
                dstr_append_i64(&report, game.trial)
                dstr_append_cstr(&report, " passed   highest rung passed ")
                dstr_append_i64(&report, game.best_rung)
                Display::draw_text(list, bytes_view(report), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            play(list, &game.run)
            Display::draw_text(list, "Walk across: balance with the pole", 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            facts: mutable dstr = dstr_of_cstr("rung ")
            dstr_append_i64(&facts, game.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, game.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, game.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, game.run.walk.level.steps)
            dstr_append_cstr(&facts, " steps")
            Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            if game.phase == TightropeGame::JUDGED:
                result: i64 = game.run.result
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, result == Tightrope::ACROSS, verdict(result), 60.0, 16.0)
