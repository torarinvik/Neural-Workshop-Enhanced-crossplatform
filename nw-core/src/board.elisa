# The geometry of the position board.
#
# Port of bwaccel/board.py (GPL-2.0-or-later). A board is n x n cells, each
# with a 1-based position id. The classic 3x3 board keeps its historic
# id-to-cell mapping so old stats files still describe the same cells; every
# other size is numbered in reading order. On an odd board the centre cell is
# skipped unless include_center asks for it.
#
# Parity note: the reference orders cells by squared distance from the board
# centre, cx = (n-1)/2.0, in floating point. We scale by 4 and stay in
# integers -- (2*col - (n-1))^2 + ... -- which is the same total order with no
# float comparisons.

struct Cell:
    pid: i64
    col: i64
    row: i64
    depth: i64

# Historic id -> (col, row) for the original 3x3 board. Index is the id, so
# entry 0 is the id-0 row the reference table also carries.
def classic_3x3_col(pid: i64) -> i64:
    return 1 if pid == 0 else (2 if pid == 1 else (0 if pid == 2 else (1 if pid == 3 else (2 if pid == 4 else (0 if pid == 5 else (1 if pid == 6 else (2 if pid == 7 else (0 if pid == 8 else 1))))))))

def classic_3x3_row(pid: i64) -> i64:
    return 1 if pid == 0 else (1 if pid == 1 else (1 if pid == 2 else (2 if pid == 3 else (2 if pid == 4 else (2 if pid == 5 else (0 if pid == 6 else (0 if pid == 7 else (0 if pid == 8 else 1))))))))

def classic_3x3_has(pid: i64) -> bool:
    return pid >= 0 and pid <= 9

# [(position_id, col, row), ...] as Cell rows with depth 0.
def grid_layout_2d(n: i64, include_center: bool) -> darray[Cell]:
    can Memory.Allocate, Abort.Panic:
        size: i64 = n if n > 2 else 2
        cells: mutable darray[Cell] = []
        if size == 3:
            for pid in 1..<9 |cells|:
                cells.push(Cell{pid: pid, col: classic_3x3_col(pid), row: classic_3x3_row(pid), depth: 0})
            if include_center:
                cells.push(Cell{pid: 9, col: 1, row: 1, depth: 0})
            return cells
        skip_center: bool = (size % 2 == 1) and not include_center
        mid: i64 = size / 2
        pid: mutable i64 = 1
        for row in 0..<size |cells, pid, size, skip_center, mid|:
            for col in 0..<size |cells, pid, row, skip_center, mid|:
                if not (skip_center and col == mid and row == mid):
                    cells.push(Cell{pid: pid, col: col, row: row, depth: 0})
                    pid <- pid + 1
        return cells

# [(position_id, col, row, depth), ...] for an n x n x n cube.
def grid_layout_3d(n: i64, include_center: bool) -> darray[Cell]:
    can Memory.Allocate, Abort.Panic:
        size: i64 = n if n > 2 else 2
        skip_center: bool = (size % 2 == 1) and not include_center
        mid: i64 = size / 2
        cells: mutable darray[Cell] = []
        pid: mutable i64 = 1
        for depth in 0..<size |cells, pid, size, skip_center, mid|:
            for row in 0..<size |cells, pid, size, skip_center, mid, depth|:
                for col in 0..<size |cells, pid, row, depth, skip_center, mid|:
                    if not (skip_center and col == mid and row == mid and depth == mid):
                        cells.push(Cell{pid: pid, col: col, row: row, depth: depth})
                        pid <- pid + 1
        return cells

def grid_layout(n: i64, include_center: bool, dim: i64) -> darray[Cell]:
    can Memory.Allocate, Abort.Panic:
        if dim == 3:
            return grid_layout_3d(n, include_center)
        return grid_layout_2d(n, include_center)

# How many usable cells an n x n (or n x n x n) board has.
def grid_cell_count(n: i64, include_center: bool, dim: i64) -> i64:
    can Memory.Allocate, Abort.Panic:
        cells: darray[Cell] = grid_layout(n, include_center, dim)
        return cells.count.i64()

# Map a 1-based position id to a cell. A returned pid of 0 means "no cell":
# an unknown id, or position <= 0, which the reference reports as None and
# means "the centre of the field".
def position_cell(position: i64, n: i64, include_center: bool) -> Cell:
    can Memory.Allocate, Abort.Panic:
        size: i64 = n if n > 2 else 2
        miss: Cell = Cell{pid: 0, col: 0, row: 0, depth: 0}
        miss return if position <= 0
        if size == 3:
            miss return if not classic_3x3_has(position)
            return Cell{pid: position, col: classic_3x3_col(position), row: classic_3x3_row(position), depth: 0}
        cells: darray[Cell] = grid_layout_2d(size, include_center)
        found: Cell =
            for cell in cells |found=miss| -> found:
                found <- cell if cell.pid == position
        return found

def position_cell_3d(position: i64, n: i64, include_center: bool) -> Cell:
    can Memory.Allocate, Abort.Panic:
        miss: Cell = Cell{pid: 0, col: 0, row: 0, depth: 0}
        miss return if position <= 0
        cells: darray[Cell] = grid_layout_3d(n, include_center)
        found: Cell =
            for cell in cells |found=miss| -> found:
                found <- cell if cell.pid == position
        return found

# Squared distance from the board centre, scaled by 4 to stay integral.
def centre_distance4(cell: Cell, size: i64, dim: i64) -> i64:
    dx: i64 = 2 * cell.col - (size - 1)
    dy: i64 = 2 * cell.row - (size - 1)
    dz: i64 = 2 * cell.depth - (size - 1)
    flat: i64 = dx * dx + dy * dy
    return flat + dz * dz if dim == 3 else flat

# Curriculum order key: (distance, -row, col, depth). True when `lhs` sorts first.
def cell_before(lhs: Cell, rhs: Cell, size: i64, dim: i64) -> bool:
    left_distance: i64 = centre_distance4(lhs, size, dim)
    right_distance: i64 = centre_distance4(rhs, size, dim)
    true return if left_distance < right_distance
    false return if left_distance > right_distance
    true return if -lhs.row < -rhs.row
    false return if -lhs.row > -rhs.row
    true return if lhs.col < rhs.col
    false return if lhs.col > rhs.col
    return lhs.depth < rhs.depth if dim == 3 else false

# Position ids ordered from the board centre outwards. This is the curriculum
# order: a capped board uses the first N of these, so difficulty grows by
# spreading outwards.
def grid_center_out_ids(n: i64, include_center: bool, dim: i64) -> darray[i64]:
    can Memory.Allocate, Abort.Panic:
        size: i64 = n if n > 2 else 2
        ids: mutable darray[i64] = []
        if size == 3 and dim != 3 and not include_center:
            for pid in [1, 2, 3, 6, 4, 5, 7, 8] |ids|:
                ids.push(pid)
            return ids
        cells: mutable darray[Cell] = grid_layout(size, include_center, dim)
        # Selection sort: boards are tiny and this keeps the order total
        # and deterministic without a comparator-taking library sort.
        outer: mutable i64 = 0
        while outer < cells.count.i64() |cells, outer, size, dim|:
            best: mutable i64 = outer
            inner: mutable i64 = outer + 1
            while inner < cells.count.i64() |cells, best, inner, size, dim|:
                if cell_before(cells[inner.usize()], cells[best.usize()], size, dim):
                    best <- inner
                inner <- inner + 1
            if best != outer:
                swap: Cell = cells[outer.usize()]
                cells[outer.usize()] <- cells[best.usize()]
                cells[best.usize()] <- swap
            outer <- outer + 1
        for cell in cells |ids|:
            ids.push(cell.pid)
        return ids

# Ids that may be sampled. limit <= 0 means the whole board.
def active_position_ids(n: i64, include_center: bool, limit: i64, dim: i64) -> darray[i64]:
    can Memory.Allocate, Abort.Panic:
        cells: darray[Cell] = grid_layout(n, include_center, dim)
        total: i64 = cells.count.i64()
        ids: mutable darray[i64] = []
        if limit <= 0 or limit >= total:
            for cell in cells |ids|:
                ids.push(cell.pid)
            return ids
        order: darray[i64] = grid_center_out_ids(n, include_center, dim)
        capped: mutable i64 = limit if limit < order.count.i64() else order.count.i64()
        capped <- 2 if capped < 2
        index: mutable i64 = 0
        while index < capped |ids, order, index, capped|:
            ids.push(order[index.usize()])
            index <- index + 1
        return ids
