include "./tasks/touching_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"

module SceneTouching:
    const WIDTH: f64 = 857.28
    const HEIGHT: f64 = 389.0
    const BOTTOM: f64 = 179.0
    const CX: f64 = 456.0
    const BUTTON_HEIGHT: f64 = HEIGHT * 0.13
    const BUTTON_GAP: f64 = WIDTH * 0.012

    def button(port: i64, count: i64) -> SceneHiddenRule::Rect:
        w: f64 = SceneHiddenRule::minimum(WIDTH * 0.3, (WIDTH - BUTTON_GAP * (count - 1).f64()) / count.f64())
        row: f64 = w * count.f64() + BUTTON_GAP * (count - 1).f64()
        return SceneHiddenRule::Rect{x: CX - row / 2.0 + port.f64() * (w + BUTTON_GAP), y: BOTTOM, w: w, h: BUTTON_HEIGHT}

    def hit(run: TouchingGame::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return TouchingGame::START if run.phase == TouchingGame::READY or run.phase == TouchingGame::DONE
            return -1 if run.phase != TouchingGame::PLAYING
            count: i64 = TouchingGame::choices(&run.puzzle)
            for port in 0..<count |count, x, y|:
                rect: SceneHiddenRule::Rect = button(port, count)
                return port if x >= rect.x and x <= rect.x + rect.w and y >= rect.y and y <= rect.y + rect.h
            return -1

    def choice_label(count: i64, port: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if count == 6:
                dstr_append_i64(out, port)
            else:
                dstr_append_cstr(out, "Apart" if port == 0 else ("Touching" if port == 1 else "Overlapping"))

    def paint_buttons(list: mutable Display::DisplayList&, run: TouchingGame::Run&, ink: u32, dark: bool):
        can Memory.Allocate, Abort.Panic:
            paper: u32 = 0x2e323aff if dark else 0xe8ebf0ff
            count: i64 = TouchingGame::choices(&run.puzzle)
            for port in 0..<count |list, run, ink, paper, count|:
                rect: SceneHiddenRule::Rect = button(port, count)
                border: mutable u32 = ink
                if run.phase == TouchingGame::JUDGED:
                    if port == run.puzzle.answer:
                        border <- 0x3caa5aff
                    elif port == run.chosen:
                        border <- 0xd6403aff
                Display::draw_bordered_rect(list, rect.x, rect.y, rect.w, rect.h, paper, border, 2.0 if border == ink else 5.0)
                label: mutable dstr = []
                dstr_append_i64(&label, port + 1)
                dstr_append_cstr(&label, "  ")
                choice_label(count, port, &label)
                Display::draw_text(list, bytes_view(label), rect.x + rect.w / 2.0, rect.y + rect.h / 2.0,
                    14.0, ink, Display::ANCHOR_CENTER_CENTER)

    def paint_shape(list: mutable Display::DisplayList&, sh: Touching::Shape, x0: f64, y0: f64, scale: f64, thick: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            fill: u32 = (colour & 0xffffff00.u32()) | 150.u32()
            if not sh.square:
                x: f64 = x0 + sh.x * scale
                y: f64 = y0 + sh.y * scale
                if sh.filled:
                    Display::draw_circle(list, x, y, sh.r * scale, fill)
                ScenePolish::ring(list, x, y, sh.r * scale, thick, colour, 128)
                return
            points: Touching::Point[4] = Touching::corners(sh)
            if sh.filled:
                Display::begin_polygon(list, 4, x0 + sh.x * scale, y0 + sh.y * scale, fill)
                for i in 0..<4 |list, points, x0, y0, scale|:
                    p: Touching::Point = points[i.usize()]
                    Display::polygon_point(list, x0 + p.x * scale, y0 + p.y * scale)
            for i in 0..<4 |list, points, x0, y0, scale, thick, colour|:
                a: Touching::Point = points[i.usize()]
                b: Touching::Point = points[((i + 1) % 4).usize()]
                x: f64 = x0 + a.x * scale
                y: f64 = y0 + a.y * scale
                Display::draw_line(list, x, y, x0 + b.x * scale, y0 + b.y * scale, thick, colour)
                Display::draw_circle(list, x, y, thick / 2.0, colour)

    def paint_puzzle(list: mutable Display::DisplayList&, run: TouchingGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            height: f64 = HEIGHT - BUTTON_HEIGHT - HEIGHT * 0.03
            scale: f64 = height / 62.0
            w: f64 = Touching::WORLD * scale
            x0: f64 = CX - w / 2.0
            y0: f64 = BOTTOM + HEIGHT - height
            paper: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: x0, y: y0, w: w, h: height}
            ScenePolish::card_face(list, &paper, 16.0, 0xf6f4fcff, 0xd2cee6ff, 0.u32(), dark)
            weight: f64 = scale * (0.9 if run.puzzle.level.thick else 0.45)
            thick: f64 = weight if weight > 2.5 else 2.5
            colours: u32[6] = [0xec5460ff, 0x3482ecff, 0xfab028ff, 0x3cba78ff, 0x9c5cdcff, 0xf0783cff]
            # Python draws the even shapes in the lower group, then the odd ones.
            for parity in 0..<2 |list, run, x0, y0, scale, thick, colours|:
                for i in 0..<run.puzzle.count |list, run, x0, y0, scale, thick, colours, parity|:
                    if i % 2 == parity:
                        paint_shape(list, run.puzzle.shapes[i.usize()], x0, y0, scale, thick, colours[i.usize()])
            return if run.phase != TouchingGame::JUDGED
            for i in 0..<run.puzzle.count |run, list, x0, y0, scale, thick|:
                a: Touching::Shape = run.puzzle.shapes[i.usize()]
                for j in 0..<i |run, list, x0, y0, scale, thick, a|:
                    b: Touching::Shape = run.puzzle.shapes[j.usize()]
                    continue if Touching::relation(Touching::gap(a, b)) != 1
                    angle: f64 = atan2(b.y - a.y, b.x - a.x)
                    x: f64 = (a.x + b.x) / 2.0 if a.square else a.x + cos(angle) * a.r
                    y: f64 = (a.y + b.y) / 2.0 if a.square else a.y + sin(angle) * a.r
                    ScenePolish::ring(list, x0 + x * scale, y0 + y * scale, thick * 3.0, 3.0, 0xf0be28ff, 48)

    def judgement(run: TouchingGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_cstr(out, "Right: " if run.passed else "No: ")
            choice_label(TouchingGame::choices(&run.puzzle), run.puzzle.answer, out)

    def message(run: TouchingGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == TouchingGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif run.phase == TouchingGame::DONE:
                dstr_append_i64(out, run.passed_count)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, run.scored_count)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, run.best_rung)
            elif run.phase == TouchingGame::JUDGED:
                judgement(run, out)
            elif run.puzzle.level.count > 0:
                dstr_append_cstr(out, "How many pairs of shapes touch (just touch, not overlap)?")
            else:
                dstr_append_cstr(out, "Do the two shapes touch?")

    def render(list: mutable Display::DisplayList&, run: TouchingGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Touching?", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "A: apart   T: touching   O: overlapping   (or the number keys, or click)   Esc: menu", CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            status: mutable dstr = []
            message(run, &status)
            Display::draw_text(list, bytes_view(status), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if run.has_verdict:
                verdict: mutable dstr = []
                judgement(run, &verdict)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.passed, bytes_view(verdict), 60.0, 16.0)
            if run.phase == TouchingGame::FLAGGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, false, "Out of time", 60.0, 16.0)
            return if run.phase == TouchingGame::READY or run.phase == TouchingGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, run.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, run.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, run.total)
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            paint_puzzle(list, run, dark)
            paint_buttons(list, run, ink, dark)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Touching::Grade = Touching::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ".")
            if level.count > 0:
                dstr_append_cstr(out, "  Count the touching pairs among ")
                dstr_append_i64(out, level.count)
                dstr_append_cstr(out, " shapes.")
            if level.squares:
                dstr_append_cstr(out, "  Squares too.")
