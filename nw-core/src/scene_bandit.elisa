include "./tasks/bandit_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./verdict.elisa"
include "./geometry.elisa"
include "./textmetrics.elisa"

module SceneBandit:
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const ROWS: i64 = 6

    def table() -> SceneHiddenRule::Rect:
        can Abort.Panic:
            width: f64 = WIDTH * 0.94
            bottom: f64 = Verdict::above_the_band(HEIGHT, Geometry::from_bottom_edge(HEIGHT, 58.0).f64()).f64()
            return SceneHiddenRule::Rect{x: (WIDTH - width) / 2.0, y: bottom, w: width,
                h: fmax(40.0, Geometry::from_top_edge(HEIGHT, 116.0).f64() - bottom)}

    def machine_box(area: SceneHiddenRule::Rect&, count: i64, arm: i64) -> SceneHiddenRule::Rect:
        gap: f64 = area.w * 0.018
        width: f64 = fmin(area.w * 0.2, (area.w - gap * (count - 1).f64()) / count.f64())
        left: f64 = area.x + (area.w - (width * count.f64() + gap * (count - 1).f64())) / 2.0
        return SceneHiddenRule::Rect{x: left + arm.f64() * (width + gap), y: area.y + area.h * 0.03,
            w: width, h: area.h * 0.8}

    def hit(session: BanditGame::Session&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return BanditGame::START if session.phase == BanditGame::READY or session.phase == BanditGame::DONE
            return -1 if session.phase != BanditGame::PLAYING
            area: SceneHiddenRule::Rect = table()
            arms: i64 = session.run.level.arms
            for arm in 0..<arms |area, arms, x, y|:
                box: SceneHiddenRule::Rect = machine_box(&area, arms, arm)
                return arm if SceneHiddenRule::contains(&box, x, y)
            return -1

    def text(list: mutable Display::DisplayList&, value: sview, x: f64, y: f64, size: f64, ink: u32, bold: bool = false):
        can Abort.Panic, Memory.Allocate:
            Display::draw_text_weight(list, value, x, y, fmax(6.0, size), ink, Display::ANCHOR_CENTER_CENTER, bold)

    def number(list: mutable Display::DisplayList&, value: i64, x: f64, y: f64, size: f64, ink: u32, bold: bool = false):
        can Abort.Panic, Memory.Allocate:
            words: mutable dstr = []
            dstr_append_i64(&words, value)
            text(list, bytes_view(words), x, y, size, ink, bold)

    def machine(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&, session: BanditGame::Session&, arm: i64, shown: i64, dark: bool):
        can Abort.Panic, Memory.Allocate:
            hues: u32[8] = [0x5676c4ff, 0x34968cff, 0xcc7a4aff, 0x8c66bcff, 0x549656ff, 0xc45c80ff, 0x687c94ff, 0xb89634ff]
            hue: u32 = hues[arm.usize()]
            card: u32 = 0x262b38ff if dark else 0xffffffff
            edge: u32 = 0x424a5cff if dark else 0xd2d8e4ff
            ink: u32 = 0xffffffff if dark else 0x000000ff
            muted: u32 = 0x969eb0ff if dark else 0x70788aff
            pending: u32 = ScenePolish::mix_rgb(card, edge, 0.5)
            radius: f64 = fmin(box.w, box.h) * 0.08
            lit: bool = session.pulls > 0 and session.chosen[(session.pulls - 1).usize()] == arm
            ScenePolish::card_face(list, box, radius, ScenePolish::mix_rgb(card, hue, 0.08),
                edge, 0xe8ba3cff if lit else 0.u32(), dark)
            header_height: f64 = box.h * 0.14
            header_y: f64 = box.y + box.h - header_height
            header: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: box.x, y: header_y, w: box.w, h: header_height}
            ScenePolish::rounded(list, &header, radius, hue)
            Display::draw_rect(list, box.x, header_y, box.w, header_height * 0.5, hue)
            margin: f64 = box.w * 0.08
            screen_height: f64 = box.h * 0.62
            screen: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: box.x + margin, y: header_y - margin * 0.7 - screen_height,
                w: box.w - 2.0 * margin, h: screen_height}
            ScenePolish::rounded(list, &screen, radius * 0.6, 0x1b1e27ff if dark else 0xdee2e7ff)
            cx: f64 = box.x + box.w / 2.0
            size: f64 = fmin(14.0, box.w * 0.12)
            number(list, arm + 1, cx, header_y + header_height / 2.0, size * 1.8, 0xffffffff, true)
            height: f64 = screen.h / ROWS.f64()
            pulled: mutable i64 = 0
            for offset in 0..<session.pulls |list, session, arm, shown, card, pending, ink, muted, screen, cx, size, height, pulled|:
                turn: i64 = session.pulls - offset - 1
                continue if session.chosen[turn.usize()] != arm
                if pulled < ROWS:
                    bottom: f64 = screen.y + screen.h - (pulled + 1).f64() * height
                    chip: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: screen.x + screen.w * 0.12,
                        y: bottom + height * 0.12, w: screen.w * 0.76, h: height * 0.76}
                    known: bool = turn < shown
                    ScenePolish::rounded(list, &chip, height * 0.2, card if known else pending)
                    if known:
                        number(list, Bandit::payout(&session.run, turn, arm), cx, bottom + height / 2.0, size * 1.3, ink, pulled == 0)
                    else:
                        text(list, "?", cx, bottom + height / 2.0, size * 1.3, muted, pulled == 0)
                pulled <- pulled + 1
            words: mutable dstr = []
            dstr_append_cstr(&words, "pulled ")
            dstr_append_i64(&words, pulled)
            text(list, bytes_view(words), cx, box.y + (screen.y - box.y) / 2.0, size, muted)

    def coin(list: mutable Display::DisplayList&, x: f64, y: f64, radius: f64):
        can Abort.Panic, Memory.Allocate:
            gold: u32 = 0xf4b82cff
            Display::draw_circle(list, x, y - radius * 0.12, radius, ScenePolish::mix_rgb(gold, 0x000000ff, 0.35))
            Display::draw_circle(list, x, y, radius, gold)
            Display::draw_circle(list, x, y, radius * 0.72, ScenePolish::mix_rgb(gold, 0xffffffff, 0.18))
            Display::draw_circle(list, x - radius * 0.3, y + radius * 0.32, radius * 0.18, 0xffffffaa)

    def verdict(session: BanditGame::Session&, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            dstr_append_i64(out, session.verdict_coins)
            dstr_append_cstr(out, " coins (par ")
            dstr_append_i64(out, py_round_half_even(session.par))
            dstr_append_cstr(out, ")")

    def message(session: BanditGame::Session&, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            if session.phase == BanditGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif session.phase == BanditGame::DONE:
                dstr_append_i64(out, session.wins)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, session.trial - session.forfeits)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, session.best_rung)
            elif session.phase == BanditGame::JUDGED:
                verdict(session, out)
            else:
                dstr_append_i64(out, session.run.level.pulls)
                dstr_append_cstr(out, " pulls: collect as many coins as you can")

    def render(list: mutable Display::DisplayList&, session: BanditGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            text(list, "Explore or Exploit", 456.0, 648.0, 22.0, ink, true)
            text(list, "click a machine or press its number   Esc: menu", 456.0, 26.0, 12.0, ink)
            status: mutable dstr = []
            message(session, &status)
            text(list, bytes_view(status), 456.0, 614.0, 14.0, ink)
            if session.phase == BanditGame::PLAYING or session.phase == BanditGame::JUDGED or session.phase == BanditGame::FLAGGED:
                words: mutable dstr = []
                dstr_append_cstr(&words, "rung ")
                dstr_append_i64(&words, session.rung)
                dstr_append_cstr(&words, "  run ")
                dstr_append_i64(&words, session.trial)
                dstr_append_cstr(&words, "/")
                dstr_append_i64(&words, session.total)
                dstr_append_cstr(&words, "   par ")
                dstr_append_i64(&words, py_round_half_even(session.par))
                text(list, bytes_view(words), 456.0, 588.0, 12.0, ink)
                area: SceneHiddenRule::Rect = table()
                radius: f64 = fmax(10.0, area.h * 0.03)
                x: f64 = 456.0 + radius * 1.2
                y: f64 = area.y + area.h * 0.93
                purse: mutable dstr = []
                dstr_append_i64(&purse, session.revealed_coins)
                dstr_append_cstr(&purse, " coins     ")
                dstr_append_i64(&purse, session.run.level.pulls - session.pulls)
                dstr_append_cstr(&purse, " pulls left")
                text(list, bytes_view(purse), x, y, 20.0, ink, true)
                coin(list, x - TextMetrics::text_width(20.0, purse.count.i64()).f64() / 2.0 - radius * 1.6, y, radius)
                level: Bandit::Grade = session.run.level
                shown: i64 = session.pulls if session.phase == BanditGame::JUDGED else Bandit::seen_after(level, session.pulls)
                for arm in 0..<level.arms |list, area, level, session, shown, dark|:
                    box: SceneHiddenRule::Rect = machine_box(&area, level.arms, arm)
                    machine(list, &box, session, arm, shown, dark)
            if session.phase == BanditGame::FLAGGED:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, false, "Out of time", 60.0, 16.0)
            elif session.has_verdict:
                caption: mutable dstr = []
                verdict(session, &caption)
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, session.passed, bytes_view(caption), 60.0, 16.0)

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: Bandit::Grade = Bandit::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.arms)
            dstr_append_cstr(out, " machines, ")
            dstr_append_i64(out, level.pulls)
            dstr_append_cstr(out, " pulls.")
            dstr_append_cstr(out, "  Means drift.") if level.drift > 0.0
            if level.jumps != 0:
                dstr_append_cstr(out, "  Dealt afresh every ")
                dstr_append_i64(out, level.jumps)
                dstr_append_cstr(out, " pulls.")
            dstr_append_cstr(out, "  Payouts shown in fives.") if level.batch > 1
