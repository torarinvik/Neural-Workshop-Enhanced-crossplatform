module JigsawPhotoAssets:
    # Largest square side that fits the shared run's video-sized tile array.
    const MAX_PHOTO_SIDE: i64 = 277
    const MAX_PHOTO_TILES: i64 = MAX_PHOTO_SIDE * MAX_PHOTO_SIDE
    const VIDEO_WIDTH: i64 = 320
    const VIDEO_HEIGHT: i64 = 240
    const MAX_VIDEO_TILES: i64 = VIDEO_WIDTH * VIDEO_HEIGHT
    const FIRST_TILE: i64 = 3000
    const PREVIEW: i64 = FIRST_TILE + 2500
    const LAST_TILE: i64 = FIRST_TILE + MAX_VIDEO_TILES

    # Preserve the preview ID while extending the tile sprites beyond it.
    def tile_ref(tile: i64) -> i64:
        return FIRST_TILE + tile + (1 if tile >= PREVIEW - FIRST_TILE else 0)

    def tile_index(ref: i64) -> i64:
        return -1 if ref == PREVIEW
        return ref - FIRST_TILE - (1 if ref > PREVIEW else 0)
