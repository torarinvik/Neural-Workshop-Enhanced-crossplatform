# The Choose a task screen: game state in, display list out.
#
# Port of neural_workshop/ui/taskhub.py -- the drawing, not the routing.
#
# Three labels, a row of category tabs on a track, and a grid of task cards
# three across. Both the tabs and the cards SHRINK THEIR TEXT to fit, and the
# two do it differently, which is the thing to get right:
#
#   * a tab's size is chosen ONCE, from the LONGEST category name, and every
#     tab is then drawn at it -- so the row reads as a row rather than as
#     seven labels that happen to be next to each other
#   * a card's size is chosen PER CARD, from its own name
#
# Both walk down a point at a time from their starting size and stop at a
# floor, and both measure against the box less twenty-four pixels.
#
# The selected tab and the selected card are filled in the accent blue and
# written in white; everything else takes one of two greys depending on the
# page. A category with no tasks says so in the middle of the screen instead
# of leaving a hole.
#
# NOTE: needs elisacore_math, strings, geometry, textmetrics, display and
# taskhub_tasks included by the driver.

module SceneTaskHub:

    const COLUMNS: i64 = 3

    def color_accent() -> u32:
        return Display::rgba(64, 96, 255, 255)

    def color_white() -> u32:
        return Display::rgba(255, 255, 255, 255)

    struct HubPaint:
        ink: mutable u32
        muted: mutable u32
        track: mutable u32
        tab_fill: mutable u32
        card_fill: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> HubPaint:
        back: i64 = 0 if black_background else 255
        fore: i64 = 255 - back
        track: u32 = Display::rgba(28, 30, 38, 255) if black_background else Display::rgba(214, 218, 226, 255)
        tab: u32 = Display::rgba(48, 52, 64, 255) if black_background else Display::rgba(244, 246, 250, 255)
        card: u32 = Display::rgba(32, 36, 46, 255) if black_background else Display::rgba(236, 239, 245, 255)
        return HubPaint{ink: Display::rgba(fore, fore, fore, 255),
                     muted: Display::rgba(fore, fore, fore, 160),
                     track: track, tab_fill: tab, card_fill: card,
                     width: width, height: height, sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: HubPaint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    def put_rect(list: mutable Display::DisplayList&, paint: HubPaint&,
                 x: f64, y: f64, wide: f64, tall: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, x / paint.sx, y / paint.sy,
                               wide / paint.sx, tall / paint.sy, color)

    # The longest of the category names, in codepoints -- which is what the
    # tab size is chosen from, once, for the whole row.
    def widest_category(count: i64) -> i64:
        can Abort.Panic:
            widest: mutable i64 = 0
            for which in 0..<count |widest|:
                span: i64 = TextMetrics::codepoints(sview(TaskHubTasks::category_name(which), 0, -1))
                widest <- widest if widest > span else span
            return widest

    # `while size > floor:` step down a point at a time until the text fits
    # the box less 24 pixels. The step is a WHOLE POINT and not a ratio,
    # which is why it is a loop and not one division.
    def shrunk(size: f64, floor: f64, characters: i64, room: f64) -> f64:
        can Abort.Panic:
            at: mutable f64 = size
            while at > floor |at, floor, characters, room|:
                if TextMetrics::text_width(at, characters).f64() <= room:
                    break
                at <- at - 1.0
            return at

    struct HubTabs:
        left: i64
        center: i64
        width: i64
        height: i64
        gap: i64
        total_width: i64

    struct HubCards:
        left: i64
        top: i64
        width: i64
        height: i64
        gap_x: i64
        gap_y: i64

    def gutter_of(width: f64) -> i64:
        wanted: i64 = (width * 0.08).i64()
        return wanted if wanted > 48 else 48

    def gap_of(width: f64) -> i64:
        wanted: i64 = (width * 0.012).i64()
        return wanted if wanted > 10 else 10

    def tabs_of(width: f64, height: f64, count: i64 = TaskHubTasks::CATEGORY_COUNT) -> HubTabs:
        can Abort.Panic:
            gutter: i64 = gutter_of(width)
            gap: i64 = gap_of(width)
            tab_w: i64 = (width.i64() - 2 * gutter - gap * (count - 1)) / count
            tall_want: i64 = Geometry::calc_fontsize(height, 36.0).i64()
            tab_h: i64 = tall_want if tall_want > 48 else 48
            total_w: i64 = count * tab_w + (count - 1) * gap
            start_x: i64 = (width.i64() - total_w) / 2
            tab_y: i64 = Geometry::from_top_edge(height, 128.0)

            return HubTabs{left: start_x, center: tab_y, width: tab_w, height: tab_h, gap: gap, total_width: total_w}

    def cards_of(width: f64, height: f64, tasks: i64) -> HubCards:
        can Abort.Panic:
            rows: i64 = (tasks + COLUMNS - 1) / COLUMNS
            grid_want: i64 = (width * 0.68).i64()
            room: i64 = width.i64() - 2 * gutter_of(width)
            grid_w: mutable i64 = room if room < grid_want else grid_want
            card_gap_x: i64 = gap_of(width)
            card_w: i64 = (grid_w - card_gap_x * (COLUMNS - 1)) / COLUMNS
            grid_w <- COLUMNS * card_w + (COLUMNS - 1) * card_gap_x
            grid_x: i64 = (width.i64() - grid_w) / 2

            top: i64 = Geometry::from_top_edge(height, 215.0)
            bottom: i64 = Geometry::from_bottom_edge(height, 72.0)
            gap_y_want: i64 = (height * 0.015).i64()
            gap_y_capped: i64 = gap_y_want if gap_y_want < 18 else 18
            card_gap_y: i64 = gap_y_capped if gap_y_capped > 8 else 8
            span: i64 = top - bottom - card_gap_y * (rows - 1)
            available: i64 = span if span > 1 else 1
            wanted_h: i64 = (height * 0.095).i64()
            capped_h: i64 = wanted_h if wanted_h < 100 else 100
            preferred_h: i64 = capped_h if capped_h > 52 else 52
            fitted: i64 = available / rows
            shortest: i64 = preferred_h if preferred_h < fitted else fitted
            card_h: i64 = shortest if shortest > 36 else 36
            return HubCards{left: grid_x, top: top, width: card_w, height: card_h, gap_x: card_gap_x, gap_y: card_gap_y}

    def contains(x: f64, y: f64, left: i64, center: i64, width: i64, height: i64) -> bool:
        bottom: f64 = (center - height / 2).f64()
        return x >= left.f64() and x <= (left + width).f64() and y >= bottom and y <= bottom + height.f64()

    # Tabs occupy the first indices, followed by the cards in the active category.
    def hit(width: f64, height: f64, category: i64, x: f64, y: f64, has_video_sequence: bool = false, has_hidden_rule: bool = false, has_hidden_wiring: bool = false, has_triage: bool = false, has_delay: bool = false, has_stop_switch: bool = false, has_hold_it: bool = false, has_notebook: bool = false, has_where_was_it: bool = false, has_which_is_nearer: bool = false, has_same_or_mirror: bool = false, has_point_of_view: bool = false, has_inside_or_out: bool = false, has_touching: bool = false, has_crossings: bool = false, has_time_it: bool = false, has_balance: bool = false, has_juggler: bool = false, has_lander: bool = false, has_beat: bool = false, has_glider: bool = false, has_catch: bool = false, has_echo_cave: bool = false, has_drone_hoops: bool = false, has_field_manual: bool = false, has_safecracker: bool = false, has_stagehand: bool = false, has_loading_dock: bool = false, has_gunslinger: bool = false, has_camera: bool = false, has_what_next: bool = false, has_falls: bool = false, has_sfm: bool = false, has_drshape: bool = false, has_tuner: bool = false, has_shadow_play: bool = false, has_captcha: bool = false, has_signals: bool = false, has_fold_it: bool = false, has_beliefs: bool = false, has_dam_keeper: bool = false, has_sonar: bool = false, has_gamble: bool = false, has_dispatch: bool = false, has_bluff: bool = false, has_explore_exploit: bool = false, has_firebreak: bool = false, has_crossroads: bool = false, has_railyard: bool = false, has_airtraffic: bool = false, has_escort: bool = false, has_sokobanlive: bool = false, has_kitchen: bool = false, has_crane: bool = false, has_ferry: bool = false, has_docking: bool = false, has_rover: bool = false, has_unicycle: bool = false, has_morning_round: bool = false, has_heavier: bool = false, has_full_stop: bool = false, has_missing_word: bool = false, has_proofreader: bool = false, has_figures_of_speech: bool = false, has_crazy_cog: bool = false, has_cipher_abyss: bool = false, has_potters_wheel: bool = false, has_conductor: bool = false, has_tightrope: bool = false, has_sign_painter: bool = false, has_bartender: bool = false, has_lock_pick: bool = false, has_air_hockey: bool = false, has_semaphore: bool = false, has_shadow_puppets: bool = false, has_night_watch: bool = false, has_kerbside: bool = false, has_steadicam: bool = false, has_free_kick: bool = false, has_glove: bool = false, has_by_ear: bool = false, has_piano_tuner: bool = false, has_cricket_hunt: bool = false, has_claw_machine: bool = false, has_between_the_lines: bool = false, has_second_thoughts: bool = false, has_bad_argument: bool = false, has_social_sense: bool = false, has_which_feeling: bool = false, has_how_strongly: bool = false, has_reading_people: bool = false, has_why_they_feel: bool = false, has_tone_of_voice: bool = false, has_emotion: bool = false) -> i64:
        can Abort.Panic:
            count: i64 = TaskHubTasks::category_count(has_triage)
            tabs: HubTabs = tabs_of(width, height, count)
            for index in 0..<count |index, tabs, x, y|:
                left: i64 = tabs.left + index * (tabs.width + tabs.gap)
                return index if contains(x, y, left, tabs.center, tabs.width, tabs.height)
            tasks: i64 = TaskHubTasks::task_count(category, has_video_sequence, has_hidden_rule, has_hidden_wiring, has_triage, has_delay, has_stop_switch, has_hold_it, has_notebook, has_where_was_it, has_which_is_nearer, has_same_or_mirror, has_point_of_view, has_inside_or_out, has_touching, has_crossings, has_time_it, has_balance, has_juggler, has_lander, has_beat, has_glider, has_catch, has_echo_cave, has_drone_hoops, has_field_manual, has_safecracker, has_stagehand, has_loading_dock, has_gunslinger, has_camera, has_what_next, has_falls, has_sfm, has_drshape, has_tuner, has_shadow_play, has_captcha, has_signals, has_fold_it, has_beliefs, has_dam_keeper, has_sonar, has_gamble, has_dispatch, has_bluff, has_explore_exploit, has_firebreak, has_crossroads, has_railyard, has_airtraffic, has_escort, has_sokobanlive, has_kitchen, has_crane, has_ferry, has_docking, has_rover, has_unicycle, has_morning_round, has_heavier, has_full_stop, has_missing_word, has_proofreader, has_figures_of_speech, has_crazy_cog, has_cipher_abyss, has_potters_wheel, has_conductor, has_tightrope, has_sign_painter, has_bartender, has_lock_pick, has_air_hockey, has_semaphore, has_shadow_puppets, has_night_watch, has_kerbside, has_steadicam, has_free_kick, has_glove, has_by_ear, has_piano_tuner, has_cricket_hunt, has_claw_machine, has_between_the_lines, has_second_thoughts, has_bad_argument, has_social_sense, has_which_feeling, has_how_strongly, has_reading_people, has_why_they_feel, has_tone_of_voice, has_emotion)
            return -1 if tasks <= 0
            cards: HubCards = cards_of(width, height, tasks)
            for index in 0..<tasks |index, cards, x, y, count|:
                left: i64 = cards.left + (index % COLUMNS) * (cards.width + cards.gap_x)
                center: i64 = cards.top - (index / COLUMNS) * (cards.height + cards.gap_y)
                return count + index if contains(x, y, left, center, cards.width, cards.height)
            return -1

    def render(list: mutable Display::DisplayList&, paint: HubPaint&,
               category: i64, selected: i64, has_video_sequence: bool = false, has_hidden_rule: bool = false, has_hidden_wiring: bool = false, has_triage: bool = false, has_delay: bool = false, has_stop_switch: bool = false, has_hold_it: bool = false, has_notebook: bool = false, has_where_was_it: bool = false, has_which_is_nearer: bool = false, has_same_or_mirror: bool = false, has_point_of_view: bool = false, has_inside_or_out: bool = false, has_touching: bool = false, has_crossings: bool = false, has_time_it: bool = false, has_balance: bool = false, has_juggler: bool = false, has_lander: bool = false, has_beat: bool = false, has_glider: bool = false, has_catch: bool = false, has_echo_cave: bool = false, has_drone_hoops: bool = false, has_field_manual: bool = false, has_safecracker: bool = false, has_stagehand: bool = false, has_loading_dock: bool = false, has_gunslinger: bool = false, has_camera: bool = false, has_what_next: bool = false, has_falls: bool = false, has_sfm: bool = false, has_drshape: bool = false, has_tuner: bool = false, has_shadow_play: bool = false, has_captcha: bool = false, has_signals: bool = false, has_fold_it: bool = false, has_beliefs: bool = false, has_dam_keeper: bool = false, has_sonar: bool = false, has_gamble: bool = false, has_dispatch: bool = false, has_bluff: bool = false, has_explore_exploit: bool = false, has_firebreak: bool = false, has_crossroads: bool = false, has_railyard: bool = false, has_airtraffic: bool = false, has_escort: bool = false, has_sokobanlive: bool = false, has_kitchen: bool = false, has_crane: bool = false, has_ferry: bool = false, has_docking: bool = false, has_rover: bool = false, has_unicycle: bool = false, has_morning_round: bool = false, has_heavier: bool = false, has_full_stop: bool = false, has_missing_word: bool = false, has_proofreader: bool = false, has_figures_of_speech: bool = false, has_crazy_cog: bool = false, has_cipher_abyss: bool = false, has_potters_wheel: bool = false, has_conductor: bool = false, has_tightrope: bool = false, has_sign_painter: bool = false, has_bartender: bool = false, has_lock_pick: bool = false, has_air_hockey: bool = false, has_semaphore: bool = false, has_shadow_puppets: bool = false, has_night_watch: bool = false, has_kerbside: bool = false, has_steadicam: bool = false, has_free_kick: bool = false, has_glove: bool = false, has_by_ear: bool = false, has_piano_tuner: bool = false, has_cricket_hunt: bool = false, has_claw_machine: bool = false, has_between_the_lines: bool = false, has_second_thoughts: bool = false, has_bad_argument: bool = false, has_social_sense: bool = false, has_which_feeling: bool = false, has_how_strongly: bool = false, has_reading_people: bool = false, has_why_they_feel: bool = false, has_tone_of_voice: bool = false, has_emotion: bool = false):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()

            put_text(list, paint, sview("Choose a task", 0, -1), middle,
                     Geometry::from_top_edge(paint.height, 48.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            tasks: i64 = TaskHubTasks::task_count(category, has_video_sequence, has_hidden_rule, has_hidden_wiring, has_triage, has_delay, has_stop_switch, has_hold_it, has_notebook, has_where_was_it, has_which_is_nearer, has_same_or_mirror, has_point_of_view, has_inside_or_out, has_touching, has_crossings, has_time_it, has_balance, has_juggler, has_lander, has_beat, has_glider, has_catch, has_echo_cave, has_drone_hoops, has_field_manual, has_safecracker, has_stagehand, has_loading_dock, has_gunslinger, has_camera, has_what_next, has_falls, has_sfm, has_drshape, has_tuner, has_shadow_play, has_captcha, has_signals, has_fold_it, has_beliefs, has_dam_keeper, has_sonar, has_gamble, has_dispatch, has_bluff, has_explore_exploit, has_firebreak, has_crossroads, has_railyard, has_airtraffic, has_escort, has_sokobanlive, has_kitchen, has_crane, has_ferry, has_docking, has_rover, has_unicycle, has_morning_round, has_heavier, has_full_stop, has_missing_word, has_proofreader, has_figures_of_speech, has_crazy_cog, has_cipher_abyss, has_potters_wheel, has_conductor, has_tightrope, has_sign_painter, has_bartender, has_lock_pick, has_air_hockey, has_semaphore, has_shadow_puppets, has_night_watch, has_kerbside, has_steadicam, has_free_kick, has_glove, has_by_ear, has_piano_tuner, has_cricket_hunt, has_claw_machine, has_between_the_lines, has_second_thoughts, has_bad_argument, has_social_sense, has_which_feeling, has_how_strongly, has_reading_people, has_why_they_feel, has_tone_of_voice, has_emotion)
            empty: sview = sview("No tasks in this category yet.", 0, -1) if tasks == 0 else sview("", 0, -1)
            put_text(list, paint, empty, middle,
                     Geometry::from_top_edge(paint.height, 280.0).f64(),
                     Geometry::calc_fontsize(paint.height, 16.0), paint.muted,
                     Display::ANCHOR_CENTER_CENTER, false)

            put_text(list, paint,
                     sview("Esc: back     ← → category     ↑ ↓ task     C: options     Enter: start", 0, -1),
                     middle, Geometry::from_bottom_edge(paint.height, 36.0).f64(),
                     Geometry::calc_fontsize(paint.height, 12.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            count: i64 = TaskHubTasks::category_count(has_triage)
            tabs: HubTabs = tabs_of(paint.width, paint.height, count)
            start_x: i64 = tabs.left
            tab_w: i64 = tabs.width
            tab_h: i64 = tabs.height
            gap: i64 = tabs.gap
            tab_y: f64 = tabs.center.f64()
            total_w: i64 = tabs.total_width
            tab_font: f64 = shrunk(Geometry::calc_fontsize(paint.height, 15.0),
                                   11.0, widest_category(count), (tab_w - 24).f64())

            put_rect(list, paint, (start_x - 8).f64(),
                     tab_y - (tab_h / 2).f64() - 8.0, (total_w + 16).f64(),
                     (tab_h + 16).f64(), paint.track)

            for index in 0..<count |list, paint, start_x, tab_w, tab_h, gap, tab_y, tab_font, category, count|:
                x: i64 = start_x + index * (tab_w + gap)
                active: bool = index == category
                put_rect(list, paint, x.f64(), tab_y - (tab_h / 2).f64(),
                         tab_w.f64(), tab_h.f64(),
                         color_accent() if active else paint.tab_fill)
                put_text(list, paint,
                         sview(TaskHubTasks::category_name(index), 0, -1),
                         (x + tab_w / 2).f64(), tab_y, tab_font,
                         color_white() if active else paint.ink,
                         Display::ANCHOR_CENTER_CENTER, true)

            if tasks == 0:
                return

            # The cards. A tab's rectangle and its label are made one after
            # the other, and so are a card's, which is why they interleave.
            cards: HubCards = cards_of(paint.width, paint.height, tasks)
            grid_x: i64 = cards.left
            card_w: i64 = cards.width
            card_gap_x: i64 = cards.gap_x
            card_h: i64 = cards.height
            card_gap_y: i64 = cards.gap_y
            top: i64 = cards.top

            for index in 0..<tasks |list, paint, category, selected, grid_x, card_w, card_gap_x, card_h, card_gap_y, top, tasks, has_video_sequence, has_hidden_rule, has_hidden_wiring, has_triage, has_delay, has_stop_switch, has_hold_it, has_notebook, has_where_was_it, has_which_is_nearer, has_same_or_mirror, has_point_of_view, has_inside_or_out, has_touching, has_crossings, has_time_it, has_balance, has_juggler, has_lander, has_beat, has_glider, has_catch, has_echo_cave, has_drone_hoops, has_field_manual, has_safecracker, has_stagehand, has_loading_dock, has_gunslinger, has_camera, has_what_next, has_falls, has_sfm, has_drshape, has_tuner, has_shadow_play, has_captcha, has_signals, has_fold_it, has_beliefs, has_dam_keeper, has_sonar, has_gamble, has_dispatch, has_bluff, has_explore_exploit, has_firebreak, has_crossroads, has_railyard, has_airtraffic, has_escort, has_sokobanlive, has_kitchen, has_crane, has_ferry, has_docking, has_rover, has_unicycle, has_morning_round, has_heavier, has_full_stop, has_missing_word, has_proofreader, has_figures_of_speech, has_crazy_cog, has_cipher_abyss, has_potters_wheel, has_conductor, has_tightrope, has_sign_painter, has_bartender, has_lock_pick, has_air_hockey, has_semaphore, has_shadow_puppets, has_night_watch, has_kerbside, has_steadicam, has_free_kick, has_glove, has_by_ear, has_piano_tuner, has_cricket_hunt, has_claw_machine, has_between_the_lines, has_second_thoughts, has_bad_argument, has_social_sense, has_which_feeling, has_how_strongly, has_reading_people, has_why_they_feel, has_tone_of_voice, has_emotion|:
                row: i64 = index / COLUMNS
                column: i64 = index % COLUMNS
                card_x: i64 = grid_x + column * (card_w + card_gap_x)
                y: i64 = top - row * (card_h + card_gap_y)
                picked: bool = index == selected
                put_rect(list, paint, card_x.f64(), (y - card_h / 2).f64(),
                         card_w.f64(), card_h.f64(),
                         color_accent() if picked else paint.card_fill)
                name: sview = sview(TaskHubTasks::task_name(category, index, has_video_sequence, has_hidden_rule, has_hidden_wiring, has_triage, has_delay, has_stop_switch, has_hold_it, has_notebook, has_where_was_it, has_which_is_nearer, has_same_or_mirror, has_point_of_view, has_inside_or_out, has_touching, has_crossings, has_time_it, has_balance, has_juggler, has_lander, has_beat, has_glider, has_catch, has_echo_cave, has_drone_hoops, has_field_manual, has_safecracker, has_stagehand, has_loading_dock, has_gunslinger, has_camera, has_what_next, has_falls, has_sfm, has_drshape, has_tuner, has_shadow_play, has_captcha, has_signals, has_fold_it, has_beliefs, has_dam_keeper, has_sonar, has_gamble, has_dispatch, has_bluff, has_explore_exploit, has_firebreak, has_crossroads, has_railyard, has_airtraffic, has_escort, has_sokobanlive, has_kitchen, has_crane, has_ferry, has_docking, has_rover, has_unicycle, has_morning_round, has_heavier, has_full_stop, has_missing_word, has_proofreader, has_figures_of_speech, has_crazy_cog, has_cipher_abyss, has_potters_wheel, has_conductor, has_tightrope, has_sign_painter, has_bartender, has_lock_pick, has_air_hockey, has_semaphore, has_shadow_puppets, has_night_watch, has_kerbside, has_steadicam, has_free_kick, has_glove, has_by_ear, has_piano_tuner, has_cricket_hunt, has_claw_machine, has_between_the_lines, has_second_thoughts, has_bad_argument, has_social_sense, has_which_feeling, has_how_strongly, has_reading_people, has_why_they_feel, has_tone_of_voice, has_emotion), 0, -1)
                # Per CARD and not once for the grid: a long name shrinks and
                # its neighbours do not.
                size: f64 = shrunk(Geometry::calc_fontsize(paint.height, 16.0),
                                   10.0, TextMetrics::codepoints(name),
                                   (card_w - 24).f64())
                put_text(list, paint, name, (card_x + card_w / 2).f64(),
                         y.f64(), size,
                         color_white() if picked else paint.ink,
                         Display::ANCHOR_CENTER_CENTER, true)
