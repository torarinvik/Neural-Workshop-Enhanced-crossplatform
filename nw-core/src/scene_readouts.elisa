# The read-outs of past performance shown between sessions.
#
# Port of neural_workshop/ui/readouts.py -- where each goes and what colour it
# takes. The SCORING is `stats` and `nback`, which have suites of their own,
# so what each line says arrives as text.
#
# The chart is the one with a layout worth porting: twenty rows, three
# columns, and the columns are laid out as OFFSETS FROM THE FIRST rather than
# at three x values -- 0, then 30 points, then 30 plus 70. Each column is its
# own list of twenty labels, all made up front and blanked when there is
# nothing to show, so a short history does not move the rows that remain.
#
# A row's colour is the whole read-out: green when the score would raise the
# level, red when it would lower it, grey when it is a manual session or lands
# between the two thresholds. All three columns of a row take it together.
#
# NOTE: needs elisacore_math, strings, geometry and display included by the
# driver.

module SceneReadouts:

    const ROWS: i64 = 20

    def text_color(black_background: bool) -> u32:
        return Display::rgba(240, 240, 240, 255) if black_background else Display::rgba(0, 0, 0, 255)

    def color_normal() -> u32:
        return Display::rgba(128, 128, 128, 255)

    def color_advance() -> u32:
        return Display::rgba(0, 160, 0, 255)

    def color_fallback() -> u32:
        return Display::rgba(160, 0, 0, 255)

    struct ReadoutPaint:
        ink: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> ReadoutPaint:
        return ReadoutPaint{ink: text_color(black_background),
                     width: width, height: height, sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: ReadoutPaint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    # Per-modality hit and miss counts and the session's score, above the
    # keys along the bottom.
    def put_analysis(list: mutable Display::DisplayList&, paint: ReadoutPaint&, text: sview):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, text,
                     Geometry::width_center(paint.width).f64(),
                     Geometry::from_bottom_edge(paint.height, 92.0).f64(),
                     Geometry::calc_fontsize(paint.height, 14.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

    def put_chart_title(list: mutable Display::DisplayList&, paint: ReadoutPaint&, text: sview):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, text,
                     Geometry::from_right_edge(paint.width, 30.0).f64(),
                     Geometry::from_top_edge(paint.height, 85.0).f64(),
                     Geometry::calc_fontsize(paint.height, 10.0), paint.ink,
                     Display::ANCHOR_RIGHT_TOP, true)

    # A row's verdict against the two thresholds.
    const ROW_NORMAL: i64 = 0
    const ROW_ADVANCE: i64 = 1
    const ROW_FALLBACK: i64 = 2

    def row_color(kind: i64) -> u32:
        if kind == ROW_ADVANCE:
            return color_advance()
        if kind == ROW_FALLBACK:
            return color_fallback()
        return color_normal()

    # The last twenty sessions. `column` is 0, 1 or 2 and its x is an OFFSET
    # from the first column's, which is why the third is 30 plus 70 rather
    # than 100 of anything.
    def chart_x(paint: ReadoutPaint&, column: i64) -> f64:
        can Abort.Panic:
            start: f64 = Geometry::from_right_edge(paint.width, 140.0).f64()
            if column == 0:
                return start
            twelve: f64 = Geometry::calc_fontsize(paint.height, 30.0)
            if column == 1:
                return start + twelve
            return start + twelve + Geometry::calc_fontsize(paint.height, 70.0)

    def chart_y(paint: ReadoutPaint&, row: i64) -> f64:
        can Abort.Panic:
            start: f64 = Geometry::from_top_edge(paint.height, 105.0).f64()
            return start - row.f64() * Geometry::calc_fontsize(paint.height, 15.0)

    # Every cell of the chart, COLUMN BY COLUMN -- which is the order the
    # labels were made in and so the order they are drawn: all twenty of the
    # first column, then all twenty of the second.
    def put_chart(list: mutable Display::DisplayList&, paint: ReadoutPaint&,
                  first: darray[sview]&, second: darray[sview]&,
                  third: darray[sview]&, kinds: darray[i64]&, rows: i64):
        can Memory.Allocate, Abort.Panic:
            size: f64 = Geometry::calc_fontsize(paint.height, 10.0)
            put_column(list, paint, first, kinds, rows, 0, size)
            put_column(list, paint, second, kinds, rows, 1, size)
            put_column(list, paint, third, kinds, rows, 2, size)

    def put_column(list: mutable Display::DisplayList&, paint: ReadoutPaint&,
                   cells: darray[sview]&, kinds: darray[i64]&, rows: i64,
                   column: i64, size: f64):
        can Memory.Allocate, Abort.Panic:
            x: f64 = chart_x(paint, column)
            for row in 0..<ROWS |list, paint, cells, kinds, rows, x, size|:
                text: sview = (get cells[row.usize()] else sview("", 0, -1)) if row < rows else sview("", 0, -1)
                # A blank row keeps the colour it was last given, and a fresh
                # chart's rows are white -- pyglet's own default, and not the
                # page's ink.
                shade: u32 = row_color(get kinds[row.usize()] else 0) if row < rows else Display::rgba(255, 255, 255, 255)
                put_text(list, paint, text, x, chart_y(paint, row), size,
                         shade, Display::ANCHOR_LEFT_TOP, false)

    def put_average(list: mutable Display::DisplayList&, paint: ReadoutPaint&, text: sview):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, text,
                     Geometry::from_right_edge(paint.width, 30.0).f64(),
                     Geometry::from_top_edge(paint.height, 70.0).f64(),
                     Geometry::calc_fontsize(paint.height, 10.0), paint.ink,
                     Display::ANCHOR_RIGHT_TOP, false)

    # Time and session counts for today. Its x is the window's RIGHT EDGE
    # itself rather than a margin in from it.
    def put_today(list: mutable Display::DisplayList&, paint: ReadoutPaint&, text: sview):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, text, paint.width,
                     Geometry::from_top_edge(paint.height, 5.0).f64(),
                     Geometry::calc_fontsize(paint.height, 9.0), paint.ink,
                     Display::ANCHOR_RIGHT_TOP, false)

    def put_trials_remaining(list: mutable Display::DisplayList&, paint: ReadoutPaint&,
                             text: sview):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, text,
                     Geometry::from_right_edge(paint.width, 10.0).f64(),
                     Geometry::from_top_edge(paint.height, 5.0).f64(),
                     Geometry::calc_fontsize(paint.height, 12.0), paint.ink,
                     Display::ANCHOR_RIGHT_TOP, true)
