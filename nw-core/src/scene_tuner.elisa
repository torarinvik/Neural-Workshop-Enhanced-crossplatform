include "./tasks/tuner_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./geometry.elisa"

module SceneTuner:
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const CX: f64 = WIDTH / 2.0
    const PI: f64 = Tuner::TAU / 2.0

    struct Layout:
        cabinet: SceneHiddenRule::Rect
        dial: SceneHiddenRule::Rect
        knob: SceneHiddenRule::Rect

    def layout() -> Layout:
        h: f64 = 389.0
        w: f64 = h * 1.9
        x: f64 = CX - w / 2.0
        y: f64 = 179.0
        r: f64 = h * 0.17
        return Layout{cabinet: SceneHiddenRule::Rect{x: x, y: y, w: w, h: h},
            dial: SceneHiddenRule::Rect{x: x + w * 0.07, y: y + h * 0.62, w: w * 0.86, h: h * 0.26},
            knob: SceneHiddenRule::Rect{x: x + w * 0.8 - r, y: y + h * 0.3 - r, w: r * 2.0, h: r * 2.0}}

    def contains(box: SceneHiddenRule::Rect&, x: f64, y: f64) -> bool:
        return x >= box.x and x <= box.x + box.w and y >= box.y and y <= box.y + box.h

    def dial_at(box: SceneHiddenRule::Rect&, x: f64) -> f64:
        return (x - box.x) / box.w * Tuner::DIAL

    def pointer(s: mutable TunerGame::Session&, x: f64, y: f64, dx: f64, dy: f64, dragging: bool, fine: bool) -> bool:
        box: Layout = layout()
        if contains(&box.dial, x - dx, y - dy):
            return TunerGame::tune(s, dial_at(&box.dial, x))
        if dragging and contains(&box.knob, x - dx, y - dy):
            return TunerGame::tune(s, s.run.dial + (dx + dy) * (0.02 if fine else 0.12))
        return false

    def cabinet(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&):
        can Memory.Allocate, Abort.Panic:
            ScenePolish::card_face(list, box, box.w * 0.05, 0x784828ff, 0x60381eff, 0.u32(), true)
            band: f64 = box.h * 0.94 / 14.0
            for i in 0..<14 |list, box, band|:
                c: u32 = ScenePolish::mix_rgb(0x6e4022ff, 0x965e38ff, i.f64() / 13.0)
                Display::draw_rect(list, box.x + box.w * 0.02, box.y + box.h * 0.03 + band * i.f64(),
                    box.w * 0.96, band + 0.5, c)
            for i in 0..<9 |list, box|:
                y: f64 = box.y + box.h * (0.06 + 0.1 * i.f64())
                Display::draw_line(list, box.x + box.w * 0.03, y, box.x + box.w * 0.97,
                    y + sin(i.f64() * 1.7) * 3.0, 1.0, 0x60381e78)

    def dial(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&, run: Tuner::Run&, on: bool):
        can Memory.Allocate, Abort.Panic:
            bezel: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: box.x - 5.0, y: box.y - 5.0, w: box.w + 10.0, h: box.h + 10.0}
            lamp: u32 = ScenePolish::mix_rgb(0x3c3228ff, 0xfae2aaff, 1.0 if on else 0.25 + 0.15 * sin(run.t * 4.0))
            ScenePolish::rounded(list, &bezel, 10.0, 0xc8aa6eff)
            ScenePolish::rounded(list, box, 7.0, lamp)
            for i in 0..<51 |list, box|:
                x: f64 = box.x + box.w * i.f64() / 50.0
                major: bool = i % 5 == 0
                Display::draw_line(list, x, box.y + box.h * 0.15, x, box.y + box.h * (0.47 if major else 0.31),
                    2.0 if major else 1.0, 0x46321eff)
                if major:
                    label: mutable dstr = []
                    dstr_append_i64(&label, 88 + 2 * (i / 5))
                    Display::draw_text(list, bytes_view(label), x, box.y + box.h * 0.7, box.h * 0.13,
                        0x46321eff, Display::ANCHOR_CENTER_CENTER)
            if run.radio.level.lamps and on:
                for i in 0..<run.radio.count |list, box, run|:
                    x: f64 = box.x + box.w * Tuner::where(&run.radio, i, run.t) / Tuner::DIAL
                    ScenePolish::glow(list, x, box.y + box.h * 0.88, box.h * 0.1, 0xff8c3cff, 200)
            needle: f64 = box.x + box.w * run.dial / Tuner::DIAL
            Display::draw_line(list, needle, box.y + 3.0, needle, box.y + box.h - 3.0, 4.0, 0xc8281eff)
            if run.result == Tuner::WON:
                ScenePolish::glow(list, needle, box.y + box.h * 0.5, box.h * 0.8, 0x78ff96ff, 140)

    def speaker(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&, t: f64, signal: f64, on: bool):
        can Memory.Allocate, Abort.Panic:
            x: f64 = box.x + box.w * 0.24
            y: f64 = box.y + box.h * 0.3
            r: f64 = box.h * 0.2
            Display::draw_circle(list, x, y, r * 1.08, 0x5a341cff)
            Display::draw_circle(list, x, y, r, 0xc4aa82ff)
            throb: f64 = 0.02 * signal * sin(t * 30.0)
            for i in 1..<6 |list, x, y, r, throb|:
                ScenePolish::arc(list, x, y, r * (i.f64() / 6.0 + throb), 0.0, Tuner::TAU, 2.0, 0x96785aff)
            if not on:
                ScenePolish::glow(list, x, y, r * 1.3, 0xffc46eff, 160)
                for i in 0..<3 |list, x, y, r, t|:
                    ScenePolish::arc(list, x, y, r * (0.3 + 0.25 * i.f64() + 0.1 * sin(t * 6.0 - i.f64())),
                        0.0, Tuner::TAU, 3.0, 0xffffffc8)
                Display::draw_text_weight(list, "Listen", x, y - r * 1.25, r * 0.18,
                    0xfff0d2ff, Display::ANCHOR_CENTER_CENTER, true)

    def meter(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&, signal: f64):
        can Memory.Allocate, Abort.Panic:
            x: f64 = box.x + box.w * 0.52
            y: f64 = box.y + box.h * 0.2
            r: f64 = box.h * 0.24
            face: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: x - r * 1.1, y: y - r * 0.15, w: r * 2.2, h: r * 1.35}
            ScenePolish::rounded(list, &face, 8.0, 0xecdebeff)
            ScenePolish::arc(list, x, y, r * 0.9, PI * 0.2, PI * 0.6, 3.0, 0x503c28ff)
            a: f64 = PI * (0.8 - 0.6 * Tuner::clamp(signal, 0.0, 1.0))
            Display::draw_line(list, x, y, x + cos(a) * r * 0.95, y + sin(a) * r * 0.95, 3.0, 0x1e1e1eff)
            Display::draw_text_weight(list, "SIGNAL", x, y + r * 1.05, r * 0.12, 0x503c28ff,
                Display::ANCHOR_CENTER_CENTER, true)

    def knob(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&, run: Tuner::Run&):
        can Memory.Allocate, Abort.Panic:
            r: f64 = box.w * 0.5
            x: f64 = box.x + r
            y: f64 = box.y + r
            Display::draw_circle(list, x, y - 3.0, r, 0x281a10ff)
            Display::draw_circle(list, x, y, r, 0x462c1aff)
            for i in 0..<16 |list, x, y, r|:
                a: f64 = Tuner::TAU * i.f64() / 16.0
                dx: f64 = cos(a) * r
                dy: f64 = sin(a) * r
                Display::draw_line(list, x + dx * 0.85, y + dy * 0.85, x + dx, y + dy, 2.0, 0x6e4c32ff)
            a: f64 = run.dial / Tuner::DIAL * Tuner::TAU * 3.0
            Display::draw_line(list, x, y, x + cos(a) * r * 0.8, y + sin(a) * r * 0.8, 4.0, 0xf0dcbeff)
            if run.lock_since >= 0.0:
                share: f64 = Tuner::clamp((run.t - run.lock_since) / run.radio.level.hold, 0.0, 1.0)
                if share > 0.0:
                    ScenePolish::arc(list, x, y, r * 1.18, PI / 2.0, Tuner::TAU * share, 5.0, 0x6ef096ff)

    def clock(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&, run: Tuner::Run&, on: bool):
        can Memory.Allocate, Abort.Panic:
            share: f64 = Tuner::clamp((run.end - run.t) / run.radio.level.seconds, 0.0, 1.0) if on else 1.0
            if share > 0.01:
                bar: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: box.x + box.w * 0.07, y: box.y + box.h * 0.93,
                    w: box.w * 0.86 * share, h: box.h * 0.025}
                ScenePolish::rounded(list, &bar, 3.0, ScenePolish::mix_rgb(0xec5040ff, 0x6edc8cff, Tuner::clamp(share * 1.5, 0.0, 1.0)))

    def prompt(s: TunerGame::Session&) -> sview:
        return "Press Space or Enter to start" if s.phase == TunerGame::READY
        return "Run complete. Press Space or Enter to play again" if s.phase == TunerGame::DONE
        return "Listen to the sound..." if s.message == TunerGame::LISTEN
        return "Nothing there to lock on to" if s.message == Tuner::NO_SIGNAL
        return "Locking on -- stay with it" if s.message == Tuner::LOCKING
        return "Lost it -- find it and lock again" if s.message == Tuner::LOST_LOCK
        return "Find the station playing it, then Space"

    def render(list: mutable Display::DisplayList&, s: TunerGame::Session&, dark: bool, waiting: bool = false):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x12121eff
            Display::draw_text_weight(list, "Tuner", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Loading recordings..." if waiting else prompt(s), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            Display::draw_text(list, "Drag or click the dial, or Left / Right (Shift: fine)   Space: lock on   R: hear it again   Esc: menu",
                CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            return if s.phase != TunerGame::PLAYING and s.phase != TunerGame::JUDGED
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, s.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, s.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, s.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, s.run.radio.count)
            dstr_append_cstr(&facts, " stations   ")
            dstr_append_cstr(&facts, "recordings" if s.run.radio.heard.bank == Tuner::ESC50 else "tunes (fetch esc50 for recordings)")
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            box: Layout = layout()
            run: Tuner::Run& = &s.run
            on: bool = Tuner::on(run)
            signal: f64 = Tuner::signal(run)
            cabinet(list, &box.cabinet)
            dial(list, &box.dial, run, on)
            speaker(list, &box.cabinet, run.t, signal, on)
            meter(list, &box.cabinet, signal)
            knob(list, &box.knob, run)
            clock(list, &box.cabinet, run, on)
            if s.phase == TunerGame::JUDGED:
                won: bool = run.result == Tuner::WON
                message: sview = "Locked on to the sound" if won else ("Out of time" if run.result == Tuner::TIMED_OUT else "That station plays another sound")
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, won, message, 60.0, 16.0)

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: Tuner::Grade = Tuner::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.stations)
            dstr_append_cstr(out, " stations.")
            if level.lamps:
                dstr_append_cstr(out, "  Lamps mark them.")
            if level.shifted:
                dstr_append_cstr(out, "  The tune comes in another key.")
            if level.drift != 0.0:
                dstr_append_cstr(out, "  Stations drift.")
