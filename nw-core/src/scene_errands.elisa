include "./tasks/errands_game.elisa"
include "./scene_browser.elisa"

module SceneErrands:
    # ui/errands.py's drawing: the app strip, and below it Mail (an inbox
    # or one mail), Browser's shop, or the Expenses claim form; the drawn
    # pointer over them, inside RungTask's title, status and footnote.
    const STRIP: u32 = 0x343a46ff
    const STRIP_TAB: u32 = 0x545c6eff
    const STRIP_ON: u32 = 0xecf0f6ff
    const WHITE: u32 = 0xffffffff
    const MAIL: u32 = 0xfafbfdff
    const SEEN: u32 = 0x787c84ff
    const FIELD_ON: u32 = 0x285adcff
    const LEFT: u32 = Display::ANCHOR_LEFT_CENTER
    const CENTRE: u32 = Display::ANCHOR_CENTER_CENTER

    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, fill: u32, edge: u32):
        can Memory.Allocate, Abort.Panic:
            SceneBrowser::rect(list, BrowserGame::frame(), x, y, w, h, fill, edge)

    def box(list: mutable Display::DisplayList&, place: ErrandsOffice::Rectangle, fill: u32, edge: u32):
        can Memory.Allocate, Abort.Panic:
            rect(list, place.x, place.y, place.width, place.height, fill, edge)

    def words(list: mutable Display::DisplayList&, text: sview, x: f64, y: f64, size: f64, colour: u32, bold: bool, anchor: u32,
            width: f64):
        can Memory.Allocate, Abort.Panic:
            _ = SceneBrowser::words(list, BrowserGame::frame(), text, x, y, size, colour, bold, anchor, width)

    def label(list: mutable Display::DisplayList&, text: cstr, x: f64, y: f64, size: f64, colour: u32, bold: bool, anchor: u32):
        can Memory.Allocate, Abort.Panic:
            said: dstr = SceneBrowser::said(text)
            words(list, bytes_view(said), x, y, size, colour, bold, anchor, 0.0)

    def app_name(app: i64) -> cstr:
        return "Mail" if app == ErrandsOffice::MAIL
        return "Shop" if app == ErrandsOffice::SHOP
        return "Expenses"

    def strip(list: mutable Display::DisplayList&, office: ErrandsOffice::Office&):
        can Memory.Allocate, Abort.Panic:
            rect(list, 0.0, 0.0, Browser::SCREEN_W, Errands::STRIP, STRIP, SceneBrowser::NO_FILL)
            for index in 0..<ErrandsOffice::app_count(office) |list, office|:
                app: i64 = ErrandsOffice::app_at(office, index)
                place: ErrandsOffice::Rectangle = ErrandsOffice::tab(app)
                on: bool = app == office.app
                box(list, place, STRIP_ON if on else STRIP_TAB, SceneBrowser::NO_FILL)
                label(list, app_name(app), place.x + place.width / 2.0, place.y + place.height / 2.0, 13.0,
                    SceneBrowser::INK if on else WHITE, true, CENTRE)
            done: ErrandsOffice::Rectangle = ErrandsOffice::done_box()
            box(list, done, STRIP_TAB, WHITE)
            label(list, "Done", done.x + done.width / 2.0, done.y + done.height / 2.0, 13.0, WHITE, true, CENTRE)

    def inbox(list: mutable Display::DisplayList&, office: ErrandsOffice::Office&):
        can Memory.Allocate, Abort.Panic:
            top: f64 = Errands::STRIP
            label(list, "Inbox", 30.0, top + 30.0, 20.0, SceneBrowser::INK, true, LEFT)
            for index in 0..<office.deal.mail_count |list, office|:
                mail: Errands::Mail = office.deal.mails[index.usize()]
                place: ErrandsOffice::Rectangle = ErrandsOffice::mail_row(index)
                seen: bool = (office.read & (1 << index)) != 0
                box(list, place, WHITE, SceneBrowser::EDGE)
                colour: u32 = SEEN if seen else SceneBrowser::INK
                middle: f64 = place.y + place.height / 2.0
                said: mutable dstr = []
                ErrandsText::sender(&said, &mail)
                words(list, bytes_view(said), 34.0, middle, 14.0, colour, not seen, LEFT, 190.0)
                said <- []
                ErrandsText::subject(&said, &mail)
                words(list, bytes_view(said), 240.0, middle, 14.0, colour, false, LEFT, 620.0)
                said <- []
                ErrandsText::time(&said, &mail)
                words(list, bytes_view(said), 960.0, middle, 13.0, SEEN, false, Display::ANCHOR_RIGHT_CENTER, 0.0)

    def reading(list: mutable Display::DisplayList&, office: ErrandsOffice::Office&):
        can Memory.Allocate, Abort.Panic:
            top: f64 = Errands::STRIP
            mail: Errands::Mail = office.deal.mails[office.reading.usize()]
            label(list, "< Inbox", 30.0, top + 29.0, 15.0, SceneBrowser::LINK, true, LEFT)
            from: mutable dstr = []
            dstr_append_cstr(&from, "From: ")
            ErrandsText::sender(&from, &mail)
            dstr_append_cstr(&from, "      ")
            ErrandsText::time(&from, &mail)
            words(list, bytes_view(from), 30.0, top + 70.0, 15.0, SceneBrowser::INK, false, LEFT, 0.0)
            said: mutable dstr = []
            ErrandsText::subject(&said, &mail)
            words(list, bytes_view(said), 30.0, top + 104.0, 20.0, SceneBrowser::INK, true, LEFT, 940.0)
            text: mutable dstr = []
            ErrandsText::mail_body(&text, &office.deal, &mail)
            lines: darray[i64] = ErrandsText::wrap(&text)
            y: mutable f64 = top + 150.0
            line: mutable i64 = 0
            while line * 2 < lines.count.i64() |list, lines, text, y, line|:
                start: i64 = lines[(line * 2).usize()]
                piece: mutable dstr = []
                for at in start..<lines[(line * 2 + 1).usize()] |piece, text|:
                    piece.push(text[at.usize()])
                words(list, bytes_view(piece), 30.0, y, 15.0, SceneBrowser::INK, false, LEFT, 940.0)
                y <- y + 26.0
                line <- line + 1

    def form(list: mutable Display::DisplayList&, office: ErrandsOffice::Office&):
        can Memory.Allocate, Abort.Panic:
            top: f64 = Errands::STRIP
            label(list, "New expense claim", 30.0, top + 32.0, 20.0, SceneBrowser::INK, true, LEFT)
            for field in 0..<2 |list, office|:
                place: ErrandsOffice::Rectangle = ErrandsOffice::field_box(field)
                label(list, "Order number" if field == 0 else "Amount ($)", 30.0, place.y + place.height / 2.0, 14.0,
                    SceneBrowser::INK, false, LEFT)
                on: bool = office.form.focus == field
                box(list, place, WHITE, FIELD_ON if on else SceneBrowser::EDGE)
                if on:
                    rect(list, place.x - 2.0, place.y - 2.0, place.width + 4.0, 2.0, FIELD_ON, SceneBrowser::NO_FILL)
                    rect(list, place.x - 2.0, place.y + place.height, place.width + 4.0, 2.0, FIELD_ON, SceneBrowser::NO_FILL)
                typed: mutable dstr = []
                ErrandsText::digits(&typed, &office.form.fields[field.usize()])
                typed.push(124.u8()) if on
                words(list, bytes_view(typed), place.x + 12.0, place.y + place.height / 2.0, 17.0, SceneBrowser::INK, true, LEFT,
                    0.0)
            for index in 0..<11 |list|:
                place: ErrandsOffice::Rectangle = ErrandsOffice::key_box(index)
                digit: i64 = ErrandsOffice::key_label(index)
                box(list, place, SceneBrowser::BUTTON, SceneBrowser::EDGE)
                said: mutable dstr = []
                if digit == ErrandsOffice::DELETE:
                    dstr_append_cstr(&said, "del")
                else:
                    dstr_append_i64(&said, digit)
                words(list, bytes_view(said), place.x + place.width / 2.0, place.y + place.height / 2.0, 18.0, SceneBrowser::INK,
                    true, CENTRE, 0.0)

    def categories(list: mutable Display::DisplayList&, office: ErrandsOffice::Office&):
        can Memory.Allocate, Abort.Panic:
            first: ErrandsOffice::Rectangle = ErrandsOffice::category_box(0)
            label(list, "Category", 30.0, first.y + 20.0, 14.0, SceneBrowser::INK, false, LEFT)
            for category in 0..<Errands::CATEGORY_COUNT |list, office|:
                place: ErrandsOffice::Rectangle = ErrandsOffice::category_box(category)
                chosen: bool = office.form.category == category
                box(list, place, WHITE, FIELD_ON if chosen else SceneBrowser::EDGE)
                said: mutable dstr = []
                dstr_append_cstr(&said, "(o) " if chosen else "( ) ")
                dstr_append_cstr(&said, Errands::category_name(category))
                words(list, bytes_view(said), place.x + 12.0, place.y + place.height / 2.0, 15.0, SceneBrowser::INK, chosen,
                    LEFT, 0.0)

    def claims(list: mutable Display::DisplayList&, office: ErrandsOffice::Office&):
        can Memory.Allocate, Abort.Panic:
            submit: ErrandsOffice::Rectangle = ErrandsOffice::submit_box()
            box(list, submit, SceneBrowser::BUTTON, SceneBrowser::EDGE)
            label(list, "Submit claim", submit.x + submit.width / 2.0, submit.y + submit.height / 2.0, 16.0, SceneBrowser::INK,
                true, CENTRE)
            if office.notice != ErrandsOffice::QUIET:
                label(list, ErrandsText::notice(office.notice), 290.0, submit.y + submit.height / 2.0, 14.0, SceneBrowser::INK,
                    false, LEFT)
            label(list, "Filed claims", 760.0, Errands::STRIP + 32.0, 16.0, SceneBrowser::INK, true, LEFT)
            stored: i64 = office.form.claim_count if office.form.claim_count < ErrandsOffice::MOST_CLAIMS else ErrandsOffice::MOST_CLAIMS
            first: i64 = stored - 10 if stored > 10 else 0
            for index in first..<stored |list, office, first|:
                said: mutable dstr = []
                ErrandsText::claim(&said, &office.form.claims[index.usize()])
                words(list, bytes_view(said), 760.0, Errands::STRIP + 72.0 + (index - first).f64() * 30.0, 13.0,
                    SceneBrowser::INK, false, LEFT, 230.0)

    # _draw: the app in front, then the strip, then the pointer.
    def computer(list: mutable Display::DisplayList&, office: ErrandsOffice::Office&):
        can Memory.Allocate, Abort.Panic:
            at: BrowserGame::Frame = BrowserGame::frame()
            rect(list, 0.0, 0.0, Browser::SCREEN_W, Browser::SCREEN_H, WHITE, SceneBrowser::EDGE)
            if office.app == ErrandsOffice::SHOP:
                shown: BrowserPages::Layout = ErrandShop::elements(&office.shop)
                SceneBrowser::shop_with(list, at, &office.shop.session, &shown)
                SceneBrowser::pointer(list, at, &office.shop.session)
            else:
                rect(list, 0.0, Errands::STRIP, Browser::SCREEN_W, Browser::SCREEN_H - Errands::STRIP, MAIL, SceneBrowser::NO_FILL)
                if office.app == ErrandsOffice::MAIL:
                    if office.reading < 0:
                        inbox(list, office)
                    else:
                        reading(list, office)
                else:
                    form(list, office)
                    categories(list, office)
                    claims(list, office)
            strip(list, office)
            SceneBrowser::pointer_at(list, at, office.pointer)

    def verdict_words(game: ErrandsGame::Session&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if game.verdict == ErrandsGame::ALL_DONE:
                dstr_append_cstr(out, "All done in ")
                dstr_append_i64(out, game.office.clicks)
                dstr_append_cstr(out, " clicks (par ")
                dstr_append_i64(out, game.par)
                dstr_append_cstr(out, ")")
            elif game.verdict == ErrandsGame::OVER_PAR:
                dstr_append_cstr(out, "All done, but ")
                dstr_append_i64(out, game.office.clicks)
                dstr_append_cstr(out, " clicks against a par of ")
                dstr_append_i64(out, game.par)
            else:
                dstr_append_cstr(out, "Not done: ")
                ErrandsText::mistakes(out, &game.mistakes)

    def message(game: ErrandsGame::Session&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if game.phase == ErrandsGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif game.phase == ErrandsGame::DONE:
                dstr_append_i64(out, game.ladder.wins)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, game.ladder.trial)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, game.ladder.best_rung)
            elif game.phase == ErrandsGame::JUDGED:
                verdict_words(game, out)
            else:
                dstr_append_cstr(out, "Do what the mail asks, then press Done")

    def facts(game: ErrandsGame::Session&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_cstr(out, "rung ")
            dstr_append_i64(out, game.ladder.rung)
            dstr_append_cstr(out, "  ")
            dstr_append_i64(out, game.ladder.trial)
            dstr_append_cstr(out, "/")
            dstr_append_i64(out, game.ladder.total)
            dstr_append_cstr(out, "   clicks ")
            dstr_append_i64(out, game.office.clicks)
            dstr_append_cstr(out, "   par ")
            dstr_append_i64(out, game.par)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Errands::Grade = Errands::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.errands)
            dstr_append_cstr(out, " errand" if level.errands == 1 else " errands")
            dstr_append_cstr(out, ", ")
            dstr_append_i64(out, level.noise)
            dstr_append_cstr(out, " other mails.")
            found: mutable i64 = 0
            for feature in 0..<3 |out, level, found|:
                present: bool = (not level.shopping) if feature == 0 else (level.policy if feature == 1 else level.amend)
                if present:
                    dstr_append_cstr(out, "  With " if found == 0 else ", ")
                    if feature == 0:
                        dstr_append_cstr(out, "a receipt to claim, no shopping")
                    elif feature == 1:
                        dstr_append_cstr(out, "categories from a policy mail")
                    else:
                        dstr_append_cstr(out, "a request changed by a later mail")
                    found <- found + 1
            dstr_append_cstr(out, ".") if found > 0
            dstr_append_cstr(out, "  Par allows ")
            dstr_append_i64(out, py_round_half_even(level.slack * 100.0))
            dstr_append_cstr(out, "% of a thorough worker's extra clicks.")

    def render(list: mutable Display::DisplayList&, game: ErrandsGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            title: dstr = SceneBrowser::said("Errands")
            SceneBrowser::line(list, bytes_view(title), 648.0, 22.0, ink, true)
            status: mutable dstr = []
            message(game, &status)
            SceneBrowser::line(list, bytes_view(status), 614.0, 14.0, ink, false)
            footnote: dstr = SceneBrowser::said("click   wheel or Up/Down: scroll   digits type into a claim   Esc: menu")
            SceneBrowser::line(list, bytes_view(footnote), 26.0, 12.0, ink, false)
            return if game.phase != ErrandsGame::PLAYING and game.phase != ErrandsGame::JUDGED
            known: mutable dstr = []
            facts(game, &known)
            SceneBrowser::line(list, bytes_view(known), 588.0, 12.0, ink, false)
            computer(list, &game.office)
            if game.phase == ErrandsGame::JUDGED:
                SceneVerdict::put(list, BrowserGame::WIDTH, BrowserGame::HEIGHT, 1.0, 1.0, game.verdict == ErrandsGame::ALL_DONE,
                    bytes_view(status), 60.0, 16.0)
