# Web-shell task frames.
#
# The task hub is deliberately data-driven, but each task still owns its own
# scene. This adapter supplies small deterministic starter states to those
# scenes so every card opens a real task surface instead of the old generic
# "Game started" card. The browser owns the live input state; the core owns the
# pixels and the task-specific layout.

module SceneTaskGames:

    def render(list: mutable Display::DisplayList&, category: i64, selected: i64,
               phase: i64, action: i64, cursor: i64, value: i64, steps: i64,
               verdict: i64, black_background: i64, width: f64, height: f64):
        can Memory.Allocate, Abort.Panic:
            sx: f64 = width / Display::REFERENCE_WIDTH
            sy: f64 = height / Display::REFERENCE_HEIGHT

            # Reasoning --------------------------------------------------
            if category == 4 and selected == 9:
                typed_answer: mutable dstr = []
                if steps > 0:
                    dstr_append_i64(&typed_answer, value)
                paint: SceneAlgebra::AlgebraPaint = SceneAlgebra::paint_of(black_background != 0, width, height, sx, sy)
                SceneAlgebra::render(list, &paint, phase, true,
                                     sview("3x + 7 = 22", 0, -1),
                                     sview("solve for x", 0, -1),
                                     sview("3x = 15\nx = 5", 0, -1),
                                     bytes_view(typed_answer), 5.0, phase != 2,
                                     1, 5, sview("Type the answer, then press Enter", 0, -1))
                return

            if category == 2 and selected == 5:
                paint: SceneBuzzWire::BuzzWirePaint = SceneBuzzWire::paint_of(black_background != 0, width, height, sx, sy)
                SceneBuzzWire::render(list, &paint, phase, phase != 0,
                                      1, 5, 36 + steps * 3, 8, steps, 0, true, 0.32,
                                      sview("Steady now", 0, -1), -1,
                                      sview("", 0, -1))
                return

            if category == 6:
                paint: SceneCookieThief::Paint = SceneCookieThief::paint_of(black_background != 0, width, height, sx, sy)
                SceneCookieThief::render(list, &paint, phase, true, 10, 6,
                                         10, 5, 180, 3, steps, 8, 2, action == 2,
                                         steps, 1, action == 7, 1, 0,
                                         sview("How much can you take?", 0, -1),
                                         1, 5, sview("Take six and go", 0, -1),
                                         verdict, sview("", 0, -1))
                return

            if category == 4 and selected == 5:
                paint: SceneCrossedWires::CrossedWiresPaint = SceneCrossedWires::paint_of(black_background != 0, width, height, sx, sy)
                presses_left: i64 = 18 - steps if steps < 18 else 0
                SceneCrossedWires::render(list, &paint, 3, phase, true,
                                          2 + cursor % 3, 2 + (cursor / 3) % 2,
                                          5, 4, 0, 3, presses_left, 24,
                                          1, 5, sview("Press arrows to wire the marker", 0, -1),
                                          -1, sview("", 0, -1))
                return

            if category == 2 and selected == 10:
                paint: SceneMarbleMaze::MarblePaint = SceneMarbleMaze::paint_of(black_background != 0, width, height, sx, sy)
                # The browser owns the live tray snapshot and its physics. The
                # core still supplies the original chrome/help contract, but the
                # native recorder path must not draw a second placeholder board
                # underneath the browser's certified board.
                SceneMarbleMaze::render_with_board(list, &paint, 0, false,
                                        1, 5, 0, 3, 0, 0, 0,
                                        sview("", 0, -1), -1,
                                        sview("", 0, -1), 0, 0, false)
                return

            if category == 3 and selected == 1:
                paint: SceneMrTime::MrTimePaint = SceneMrTime::paint_of(black_background != 0, width, height, sx, sy)
                mr_phase: i64 = 2 if action == 2 and phase != 0 else phase
                SceneMrTime::render(list, &paint, mr_phase, true, 0,
                                    0.32, 0.38, 0.12, 0.5, 3, 0.5,
                                    sview("", 0, -1), 1, 5, steps,
                                    sview("Time it", 0, -1), -1,
                                    sview("", 0, -1))
                return

            if category == 4 and selected == 10:
                typed_sequence: mutable dstr = []
                if steps > 0:
                    dstr_append_i64(&typed_sequence, value)
                paint: SceneNumberology::NumberologyPaint = SceneNumberology::paint_of(black_background != 0, width, height, sx, sy)
                SceneNumberology::render(list, &paint, phase, true,
                                         sview("2, 4, 8, 16, ?", 0, -1),
                                         sview("each term doubles", 0, -1),
                                         bytes_view(typed_sequence), 1, 5,
                                         sview("Type the next number, then press Enter", 0, -1), verdict,
                                         sview("", 0, -1))
                return

            if category == 2 and selected == 4:
                paint: ScenePursuit::PursuitPaint = ScenePursuit::paint_of(black_background != 0, width, height, sx, sy)
                quarry_x: f64 = 0.45 + ((cursor % 5) - 2).f64() * 0.025
                quarry_y: f64 = 0.42 + (((cursor / 5) % 5) - 2).f64() * 0.025
                ScenePursuit::render(list, &paint, phase, true, quarry_x, quarry_y,
                                     12.0, 2, 3, true, 1.25, 1, 5,
                                     sview("Stay on it", 0, -1), verdict,
                                     sview("", 0, -1))
                return

            if category == 1 and selected == 1:
                paint: SceneRecognition::RecognitionPaint = SceneRecognition::paint_of(black_background != 0, width, height, sx, sy)
                SceneRecognition::render(list, &paint, phase, 0, cursor % 160, 160, 120,
                                         0, 5, sview("Seen it, or new?", 0, -1),
                                         -1, sview("", 0, -1), false)
                return

            if category == 4 and selected == 8:
                typed_scramble: mutable dstr = []
                if steps > 0:
                    dstr_append_i64(&typed_scramble, value)
                paint: SceneScramble::ScramblePaint = SceneScramble::paint_of(black_background != 0, width, height, sx, sy)
                SceneScramble::render(list, &paint, phase, true,
                                      sview("thec atsa tont hema t", 0, -1),
                                      bytes_view(typed_scramble), 0.18, true, 5, true,
                                      true, sview("", 0, -1), 1, 5,
                                      sview("Rung 3 - letters only", 0, -1), verdict,
                                      sview("", 0, -1))
                return

            if category == 4 and selected == 11:
                options: mutable darray[sview] = []
                options.push(sview("Alice is tallest", 0, -1))
                options.push(sview("Bob is tallest", 0, -1))
                options.push(sview("Carol is tallest", 0, -1))
                paint: SceneSyllogism::SyllogismPaint = SceneSyllogism::paint_of(black_background != 0, width, height, sx, sy)
                picked: i64 = cursor % 3
                answered: i64 = picked if phase == 2 else -1
                SceneSyllogism::render(list, &paint, phase, true,
                                       sview("Alice is taller than Bob.\nBob is taller than Carol.", 0, -1),
                                       2, sview("Who is the tallest?", 0, -1),
                                       sview("Follow the order.", 0, -1), &options,
                                       picked, answered, 1, 5,
                                       sview("Rung 3 - order", 0, -1), verdict,
                                       sview("", 0, -1))
                return

            if category == 4 and selected == 13:
                choices: mutable darray[sview] = []
                choices.push(sview("fits the sentence", 0, -1))
                choices.push(sview("contradicts the sentence", 0, -1))
                choices.push(sview("cannot be determined", 0, -1))
                paint: SceneVerbal::Paint = SceneVerbal::paint_of(black_background != 0, width, height, sx, sy)
                picked: i64 = cursor % 3
                answered: i64 = picked if phase == 2 else -1
                SceneVerbal::render(list, &paint, phase, true,
                                    sview("The lantern was bright, so the room was ___.", 0, -1),
                                    &choices, picked, answered, 1, 5,
                                    sview("Sentence Completion", 0, -1), false,
                                    sview("", 0, -1), verdict, sview("", 0, -1))
                return

            # Working memory --------------------------------------------
            if category == 0 and selected == 2:
                asked: mutable darray[i64] = []
                answers: mutable darray[i64] = []
                given: mutable darray[i64] = []
                asked.push(0)
                asked.push(1)
                answers.push(1)
                answers.push(2)
                given.push(1)
                paint: SceneInTheDark::InTheDarkPaint = SceneInTheDark::paint_of(black_background != 0, width, height, sx, sy)
                dark_phase: i64 = 2 if action == 7 and phase != 0 else phase
                room_cursor: i64 = cursor % 3
                SceneInTheDark::render(list, &paint, dark_phase, true, 3, 3, 0, 0, 1,
                                       room_cursor, 3, &asked, &answers, &given, 0,
                                       1, 5, sview("Rung 3 - three rooms", 0, -1),
                                       -1, sview("", 0, -1))
                return

            if category == 0 and selected == 3:
                walls: mutable darray[bool] = []
                revealed: mutable darray[bool] = []
                explored: i64 = 10 + (cursor % 35)
                for cell in 0..<63 |walls, revealed|:
                    x: i64 = cell % 9
                    y: i64 = cell / 9
                    walls.push(x == 0 or y == 0 or x == 8 or y == 6 or (x % 3 == 0 and y % 3 == 0))
                    revealed.push(cell % 4 == 0 or cell == explored)
                paint: SceneFogOfWar::FogPaint = SceneFogOfWar::paint_of(black_background != 0, width, height, sx, sy)
                SceneFogOfWar::render(list, &paint, phase, true, 9, 7, &walls,
                                      &revealed, explored, 1, 5,
                                      sview("Explore the fog", 0, -1))
                return

            if category == 0 and selected == 4:
                got: mutable Removals::RemovalsRound = Removals::RemovalsRound()
                got.yard <- Removals::RemovalsYard(2, 2, 3)
                got.move_n <- 4
                got.asked_n <- 1
                Ints::put(&got.move_kind, 0, Removals::PACK)
                Ints::put(&got.move_thing, 0, 4)
                Ints::put(&got.move_other, 0, 2)
                Ints::put(&got.move_kind, 1, Removals::SWAP)
                Ints::put(&got.move_thing, 1, 5)
                Ints::put(&got.move_other, 1, 3)
                Ints::put(&got.move_kind, 2, Removals::PACK)
                Ints::put(&got.move_thing, 2, 6)
                Ints::put(&got.move_other, 2, 3)
                Ints::put(&got.move_kind, 3, Removals::PACK)
                Ints::put(&got.move_thing, 3, 7)
                Ints::put(&got.move_other, 3, 2)
                Ints::put(&got.asked, 0, 4)
                paint: SceneRemovals::RemovalsPaint = SceneRemovals::paint_of(black_background != 0, width, height, sx, sy)
                SceneRemovals::render(list, &paint, &got,
                                      SceneRemovals::PHASE_MOVING, 3, 1, 5,
                                      cursor % got.move_n, 0)
                return

            if category == 0 and selected == 5:
                shop: mutable darray[SceneCustody::CustodyMachine] = []
                crates: mutable darray[SceneCustody::CustodyBox] = []
                shop.push(SceneCustody::CustodyMachine{slot: 1, kind: 0})
                shop.push(SceneCustody::CustodyMachine{slot: 4, kind: 1})
                crates.push(SceneCustody::CustodyBox{slot: 2, held: false, delivered: false,
                                               look: 0, charge: 40, heat: 20, is_core: true})
                crates.push(SceneCustody::CustodyBox{slot: 5, held: true, delivered: false,
                                               look: 1, charge: 20, heat: 40, is_core: false})
                paint: SceneCustody::CustodyPaint = SceneCustody::paint_of(black_background != 0, width, height, sx, sy)
                custody_phase: i64 = 1 if phase == 0 else phase
                SceneCustody::render(list, &paint, custody_phase, true, 3, 6, 5,
                                     &shop, &crates, 2 + (cursor % 3), 30, 80, 25, steps,
                                     sview("Follow the Core", 0, -1), 1, 5,
                                     sview("Mark the chain", 0, -1), -1,
                                     sview("", 0, -1))
                return

            # Attention --------------------------------------------------
            if category == 2 and selected == 0:
                targets: mutable darray[SceneReflex::ReflexTarget] = []
                first_remaining: f64 = 0.0 if action == 2 and cursor % 2 == 0 else 1.0
                second_remaining: f64 = 0.0 if action == 2 and cursor % 2 == 1 else 0.65
                targets.push(SceneReflex::ReflexTarget{x: 0.25, y: 0.35, remaining: first_remaining,
                                                 asset: 0, image_width: 64, image_height: 64})
                targets.push(SceneReflex::ReflexTarget{x: 0.62, y: 0.58, remaining: second_remaining,
                                                 asset: 1, image_width: 80, image_height: 60})
                paint: SceneReflex::ReflexPaint = SceneReflex::paint_of(black_background != 0, width, height, sx, sy)
                SceneReflex::render(list, &paint, phase, &targets, 70.0, 2, 8, steps, 0,
                                    sview("Click them before they go", 0, -1), -1,
                                    sview("", 0, -1))
                return

            if category == 2 and selected == 1:
                order: mutable darray[i64] = Ints::zeros(8)
                xs: mutable darray[f64] = Floats::zeros(8)
                for cup in 0..<8 |order, xs|:
                    Ints::put(&order, cup, cup)
                    Floats::put(&xs, cup, 0.12 + 0.105 * cup.f64())
                paint: SceneNCupMonte::NCupMontePaint = SceneNCupMonte::paint_of(black_background != 0, width, height, sx, sy)
                monte_phase: i64 = SceneNCupMonte::PHASE_RESULT if action == 2 else (SceneNCupMonte::PHASE_GUESS if phase != 0 else SceneNCupMonte::PHASE_READY)
                SceneNCupMonte::render(list, &paint, &order, &xs, 5, monte_phase, 2, cursor % 5,
                                       true, sview("Track the ball", 0, -1))
                return

            if category == 2 and selected == 2:
                balls: mutable darray[SceneTracking::TrackingBall] = []
                tracking_phase: i64 = 3 if action == 2 else phase
                balls.push(SceneTracking::TrackingBall{x: 0.25, y: 0.35, target: true, picked: action == 2 and cursor % 3 == 0})
                balls.push(SceneTracking::TrackingBall{x: 0.56, y: 0.62, target: false, picked: action == 2 and cursor % 3 == 1})
                balls.push(SceneTracking::TrackingBall{x: 0.72, y: 0.28, target: true, picked: action == 2 and cursor % 3 == 2})
                paint: SceneTracking::TrackingPaint = SceneTracking::paint_of(black_background != 0, width, height, sx, sy)
                SceneTracking::render(list, &paint, tracking_phase, &balls, 1, 5,
                                      sview("Follow the orange balls", 0, -1), -1,
                                      sview("", 0, -1))
                return

            if category == 2 and selected == 3:
                shapes: mutable darray[SceneLookout::Drifter] = []
                shapes.push(SceneLookout::Drifter{x: 0.24, y: 0.34, color: 1, form: 0})
                shapes.push(SceneLookout::Drifter{x: 0.58, y: 0.63, color: 3, form: 2})
                shapes.push(SceneLookout::Drifter{x: 0.73, y: 0.28, color: 4, form: 1})
                paint: SceneLookout::LookoutPaint = SceneLookout::paint_of(black_background != 0, width, height, sx, sy)
                lookout_phase: i64 = 2 if action == 7 and phase != 0 else phase
                SceneLookout::render(list, &paint, lookout_phase, 1, &shapes, 1, 0, 1, 5,
                                     sview("Watch for it", 0, -1), -1,
                                     sview("", 0, -1))
                return

            if category == 2 and selected == 6:
                dots: mutable darray[SceneOutOfSight::Dot] = []
                blinds: mutable darray[SceneOutOfSight::Blind] = []
                dots.push(SceneOutOfSight::Dot{x: 0.22, y: 0.35, target: true})
                dots.push(SceneOutOfSight::Dot{x: 0.56, y: 0.61, target: false})
                dots.push(SceneOutOfSight::Dot{x: 0.74, y: 0.28, target: false})
                blinds.push(SceneOutOfSight::Blind{left: 0.40, bottom: 0.28, width: 0.16, height: 0.26})
                paint: SceneOutOfSight::OutOfSightPaint = SceneOutOfSight::paint_of(black_background != 0, width, height, sx, sy)
                sight_phase: i64 = 3 if action == 7 and phase != 0 else phase
                answer: i64 = 1 if verdict == 1 else (0 if verdict == 0 else -1)
                SceneOutOfSight::render(list, &paint, sight_phase, &dots, &blinds, true,
                                        0.37, 0.46, answer, 1, 5, steps, 5,
                                        sview("Where did it go?", 0, -1))
                return

            if category == 2 and selected == 7:
                beasts: mutable darray[SceneDonkey::DonkeyBeast] = []
                beasts.push(SceneDonkey::DonkeyBeast{at: 12, lane: 0})
                beasts.push(SceneDonkey::DonkeyBeast{at: 24, lane: 1})
                paint: SceneDonkey::DonkeyPaint = SceneDonkey::paint_of(black_background != 0, width, height, sx, sy)
                donkey_phase: i64 = 2 if action != 0 and phase != 0 else phase
                SceneDonkey::render(list, &paint, donkey_phase, true, &beasts, 40, 40, 2,
                                    8 + steps, cursor % 3, 1 if action == 2 else 0, 6, steps, sview("Swerve in time", 0, -1),
                                    1, 5, sview("Swerve in time", 0, -1), -1,
                                    sview("", 0, -1))
                return

            if category == 2 and selected == 8:
                road: mutable darray[SceneTwoHands::TwoHandsHazard] = []
                sky: mutable darray[SceneTwoHands::TwoHandsTarget] = []
                road.push(SceneTwoHands::TwoHandsHazard{ahead: 2.5, lane: -1.0, kind: 1})
                road.push(SceneTwoHands::TwoHandsHazard{ahead: 4.0, lane: 1.0, kind: 3})
                sky.push(SceneTwoHands::TwoHandsTarget{across: 0.68, up: 0.62, downed: false})
                paint: SceneTwoHands::TwoHandsPaint = SceneTwoHands::paint_of(black_background != 0, width, height, sx, sy)
                hands_phase: i64 = 2 if phase != 0 else phase
                SceneTwoHands::render(list, &paint, hands_phase, true, 12 + steps, &road,
                                      (cursor % 3).f64() - 1.0,
                                      0.0, action == 5, &sky, 0.42, 0.36, true, 0.4, 0.3,
                                      1, 3, steps, 3, 3, 60, 22, 90, 10,
                                      sview("Drive and shoot", 0, -1), 1, 5,
                                      sview("Drive and shoot", 0, -1), -1,
                                      sview("", 0, -1))
                return

            if category == 2 and selected == 9:
                words: mutable darray[sview] = []
                starts: mutable darray[i64] = []
                words.push(sview("type", 0, -1))
                starts.push(0)
                words.push(sview("the", 0, -1))
                starts.push(5)
                words.push(sview("line", 0, -1))
                starts.push(9)
                typed_overrun: mutable dstr = []
                if steps > 0:
                    dstr_append_i64(&typed_overrun, value)
                paint: SceneOverrun::OverrunPaint = SceneOverrun::paint_of(black_background != 0, width, height, sx, sy)
                SceneOverrun::render(list, &paint, phase, true, &words, &starts,
                                     13, 11, 6.5, steps, bytes_view(typed_overrun), 0.0, 3,
                                     true, sview("", 0, -1), 1, 5,
                                     sview("Type the line", 0, -1), -1,
                                     sview("", 0, -1))
                return

            # Long-term memory ------------------------------------------
            if category == 1 and selected == 0:
                cards: mutable darray[SceneConcentration::SceneConcentrationCard] = []
                first_up: i64 = cursor % 4
                cards.push(SceneConcentration::SceneConcentrationCard{face_up: action == 2 and first_up == 0, matched: steps > 3, index: 0, asset: 0, image_width: 64, image_height: 64})
                cards.push(SceneConcentration::SceneConcentrationCard{face_up: action == 2 and first_up == 1, matched: steps > 3, index: 0, asset: 0, image_width: 64, image_height: 64})
                cards.push(SceneConcentration::SceneConcentrationCard{face_up: action == 2 and first_up == 2, matched: steps > 5, index: 1, asset: 1, image_width: 80, image_height: 60})
                cards.push(SceneConcentration::SceneConcentrationCard{face_up: action == 2 and first_up == 3, matched: steps > 5, index: 1, asset: 1, image_width: 80, image_height: 60})
                paint: SceneConcentration::SceneConcentrationPaint = SceneConcentration::paint_of(black_background != 0, width, height, sx, sy)
                SceneConcentration::render(list, &paint, 0, &cards, 2, steps, true,
                                           sview("Find the pairs", 0, -1), -1,
                                           sview("", 0, -1), false)
                return

            if category == 1 and selected == 2:
                options: mutable darray[sview] = []
                options.push(sview("Paris", 0, -1))
                options.push(sview("Oslo", 0, -1))
                options.push(sview("Tokyo", 0, -1))
                paint: SceneTrivia::TriviaPaint = SceneTrivia::paint_of(black_background != 0, width, height, sx, sy)
                trivia_choice: i64 = cursor % 3
                trivia_answered: i64 = trivia_choice if phase == 2 else -1
                SceneTrivia::render(list, &paint, phase, true,
                                         sview("Which city is the capital of Norway?", 0, -1),
                                         &options, trivia_choice, trivia_answered, 1, true, true,
                                         sview("", 0, -1), 137, 1, 5,
                                         sview("Rung 3 - general", 0, -1), verdict,
                                         sview("", 0, -1))
                return

            # Perception -------------------------------------------------
            if category == 3 and selected == 0:
                shapes: mutable darray[SceneCounting::CountRenderShape] = []
                shapes.push(SceneCounting::CountRenderShape{kind: 0, x1: 0.15, y1: 0.25,
                                                 x2: 0.30, y2: 0.45, x3: 0.0,
                                                 y3: 0.0, radius: 0.06})
                shapes.push(SceneCounting::CountRenderShape{kind: 1, x1: 0.45, y1: 0.35,
                                                 x2: 0.0, y2: 0.0, x3: 0.0,
                                                 y3: 0.0, radius: 0.08})
                shapes.push(SceneCounting::CountRenderShape{kind: 3, x1: 0.72, y1: 0.58,
                                                 x2: 0.0, y2: 0.0, x3: 0.0,
                                                 y3: 0.0, radius: 0.05})
                typed_count: mutable dstr = []
                if steps > 0:
                    dstr_append_i64(&typed_count, value)
                count_phase: i64 = 3 if phase == 2 else phase
                paint: SceneCounting::CountPaint = SceneCounting::paint_of(black_background != 0, width, height, sx, sy)
                SceneCounting::render(list, &paint, count_phase, &shapes,
                                      bytes_view(typed_count), 1, 5, 3 if verdict == 1 else -1,
                                      sview("How many?", 0, -1), -1,
                                      sview("", 0, -1))
                return

            # Reasoning --------------------------------------------------
            if category == 4 and selected == 0:
                left_edges: mutable darray[SceneGraphMapping::Edge] = []
                right_edges: mutable darray[SceneGraphMapping::Edge] = []
                left_spots: mutable darray[SceneGraphMapping::GraphMappingPoint] = []
                right_spots: mutable darray[SceneGraphMapping::GraphMappingPoint] = []
                for node in 0..<5 |left_spots, right_spots|:
                    left_spots.push(SceneGraphMapping::GraphMappingPoint{x: 0.16 + 0.13 * node.f64(), y: 0.25 + 0.09 * (node % 3).f64()})
                    right_spots.push(SceneGraphMapping::GraphMappingPoint{x: 0.66 + 0.08 * node.f64(), y: 0.22 + 0.11 * (node % 3).f64()})
                left_edges.push(SceneGraphMapping::Edge{first: 0, second: 1})
                left_edges.push(SceneGraphMapping::Edge{first: 1, second: 2})
                left_edges.push(SceneGraphMapping::Edge{first: 2, second: 3})
                right_edges.push(SceneGraphMapping::Edge{first: 0, second: 2})
                right_edges.push(SceneGraphMapping::Edge{first: 2, second: 4})
                paint: SceneGraphMapping::GraphMappingPaint = SceneGraphMapping::paint_of(black_background != 0, width, height, sx, sy)
                graph_phase: i64 = 3 if action == 2 and phase != 0 else phase
                SceneGraphMapping::render(list, &paint, graph_phase, 5, &left_edges,
                                          &right_edges, &left_spots, &right_spots,
                                          1, 5, 0, sview("The same network?", 0, -1),
                                          verdict, sview("", 0, -1))
                return

            if category == 4 and selected == 1:
                paint: SceneRavens::RavensPaint = SceneRavens::paint_of(black_background != 0, width, height, sx, sy)
                ravens_phase: i64 = 3 if phase == 2 else phase
                SceneRavens::render(list, &paint, ravens_phase, true, 3, 4, 1, cursor % 4,
                                    -1, false, 0, 256, 1, 128,
                                    sview("Rows, columns, and shapes change.", 0, -1),
                                    1, 5, 0, 3,
                                    sview("Which one finishes it?", 0, -1), -1,
                                    sview("", 0, -1))
                return

            if category == 4 and selected == 2:
                order: mutable darray[i64] = []
                assets: mutable darray[i64] = []
                for cell in 0..<9 |order, assets|:
                    order.push((cell + 1) % 9)
                    assets.push(cell)
                paint: SceneJigsaw::JigsawPaint = SceneJigsaw::paint_of(black_background != 0, width, height, sx, sy)
                jigsaw_phase: i64 = 2 if phase == 2 else phase
                SceneJigsaw::render(list, &paint, jigsaw_phase, 3, &order, 40, false,
                                    true, 240, 160, &assets, 9, -1, -1, true,
                                    1, 5, steps, 0, sview("", 0, -1),
                                    sview("Put it back together", 0, -1), -1,
                                    sview("", 0, -1))
                return

            if category == 4 and selected == 3:
                filled: mutable darray[i64] = Ints::zeros(256)
                givens: mutable darray[i64] = Ints::zeros(256)
                marks: mutable darray[i64] = Ints::zeros(256)
                for cell in 0..<16 |filled, givens|:
                    given: bool = cell % 3 == 0
                    Ints::put(&filled, cell, (cell % 4) + 1 if given else 0)
                    Ints::put(&givens, cell, 1 if given else 0)
                if steps > 0 and cursor % 3 != 0:
                    Ints::put(&filled, cursor % 16, (value % 4) + 1)
                paint: SceneSudoku::SudokuPaint = SceneSudoku::paint_of(black_background != 0, width, height, sx, sy)
                SceneSudoku::render(list, &paint, &filled, &givens, &marks, 2,
                                    phase, cursor % 16, true, false, 1, 5, true,
                                    sview("Fill every row, column, and box.", 0, -1),
                                    -1, sview("", 0, -1))
                return

            if category == 4 and selected == 4:
                board: mutable darray[i64] = Ints::zeros(Go::MOST_CELLS)
                target: mutable darray[i64] = Ints::zeros(Go::MOST_CELLS)
                Ints::put(&board, 6, 1)
                Ints::put(&board, 12, 2)
                Ints::put(&target, 7, 1)
                paint: SceneGo::GoPaint = SceneGo::paint_of(black_background != 0, width, height, sx, sy)
                SceneGo::render(list, &paint, &board, &target, 5, -1, true, false,
                                true, phase, 1, 1, 5,
                                cursor % 5, (cursor / 5) % 5,
                                sview("Capture the largest group.", 0, -1))
                return

            if category == 4 and selected == 6:
                solution: mutable darray[i64] = Ints::zeros(25)
                filled: mutable darray[i64] = Ints::zeros(25)
                givens: mutable darray[bool] = []
                for cell in 0..<25 |solution, filled, givens|:
                    Ints::put(&solution, cell, 97 + cell % 26)
                    Ints::put(&filled, cell, 97 + cell % 26 if cell % 4 == 0 else 0)
                    givens.push((cell % 5) == 0)
                if steps > 0:
                    Ints::put(&filled, cursor % 25, 97 + value % 26)
                slot_number: mutable darray[i64] = []
                slot_down: mutable darray[bool] = []
                slot_first: mutable darray[i64] = []
                slot_length: mutable darray[i64] = []
                clues: mutable darray[sview] = []
                slot_number.push(1)
                slot_down.push(false)
                slot_first.push(0)
                slot_length.push(3)
                clues.push(sview("A small bright object", 0, -1))
                paint: SceneCrossword::CrosswordPaint = SceneCrossword::paint_of(black_background != 0, width, height, sx, sy)
                SceneCrossword::render(list, &paint, phase, true, 5, &solution,
                                       &filled, &givens, &slot_number, &slot_down,
                                       &slot_first, &slot_length, &clues, cursor % 25, false,
                                       cursor % 25, false, 1, 5, sview("Solve the clue", 0, -1),
                                       verdict, sview("", 0, -1))
                return

            if category == 4 and selected == 7:
                premiums: mutable darray[i64] = Ints::zeros(25)
                letters: mutable darray[i64] = Ints::zeros(25)
                on_board: mutable darray[i64] = Ints::zeros(25)
                for cell in 0..<25 |premiums, letters, on_board|:
                    Ints::put(&premiums, cell, cell % 5)
                    Ints::put(&letters, cell, 0 if (cell % 3) != 0 else 97 + cell % 26)
                    Ints::put(&on_board, cell, 97 + cell % 26 if cell == 6 else 0)
                tiles: mutable darray[i64] = Ints::zeros(7)
                used: mutable darray[bool] = []
                for slot in 0..<7 |used|:
                    Ints::put(&tiles, slot, 97 + slot)
                    used.push(steps > 0 and slot == cursor % 7)
                if steps > 0:
                    Ints::put(&on_board, cursor % 25, 97 + value % 26)
                paint: SceneScrabble::ScrabblePaint = SceneScrabble::paint_of(black_background != 0, width, height, sx, sy)
                SceneScrabble::render(list, &paint, phase, true, 5, &premiums,
                                      &letters, &on_board, &tiles, &used, true, 6,
                                      cursor % 25, cursor % 7, action == 2, false, 1, 5,
                                      sview("Build a word", 0, -1), verdict,
                                      sview("", 0, -1))
                return

            # Planning ---------------------------------------------------
            if category == 5 and selected == 0:
                board: mutable Hanoi::Board = Hanoi::fresh_pegs(3)
                if steps % 2 == 1:
                    Hanoi::apply_move(&board, 0, 1)
                paint: SceneHanoi::Paint = SceneHanoi::paint_of(black_background != 0, width, height, sx, sy)
                SceneHanoi::render(list, &paint, &board, phase, cursor % 3, 1, 5, steps,
                                   Hanoi::minimum_moves(3), 3,
                                   sview("Move the tower to another peg", 0, -1))
                return

            if category == 5 and selected == 1:
                cities: mutable darray[SceneSalesman::Point] = []
                route: mutable darray[i64] = Ints::zeros(6)
                best: mutable darray[i64] = Ints::zeros(6)
                for city in 0..<6 |cities, route, best|:
                    cities.push(SceneSalesman::Point{x: 0.16 + 0.13 * (city % 3).f64(), y: 0.22 + 0.22 * (city / 3).f64()})
                    Ints::put(&route, city, (city + steps) % 6)
                    Ints::put(&best, city, 5 - city)
                paint: SceneSalesman::Paint = SceneSalesman::paint_of(black_background != 0, width, height, sx, sy)
                SceneSalesman::render(list, &paint, phase, &cities, &route, steps % 7,
                                      &best, 6, true, 1, 5, 6,
                                      sview("Visit every city once", 0, -1), verdict,
                                      sview("", 0, -1))
                return

            if category == 5 and selected == 2:
                wide: i64 = 7
                tall: i64 = 7
                walls: mutable darray[bool] = []
                goals: mutable darray[bool] = []
                traps: mutable darray[bool] = []
                boxes: mutable darray[i64] = []
                for cell in 0..<49 |walls, goals, traps|:
                    x: i64 = cell % wide
                    y: i64 = cell / wide
                    edge: bool = x == 0 or y == 0 or x == 6 or y == 6
                    walls.push(edge)
                    goals.push(cell == 40)
                    traps.push(cell == 17)
                boxes.push(16)
                paint: SceneSokoban::SokobanPaint = SceneSokoban::paint_of(black_background != 0, width, height, sx, sy)
                player: i64 = 8 + cursor % 25
                SceneSokoban::render(list, &paint, phase, true, wide, tall, &walls,
                                     &goals, &traps, &boxes, player, true, steps, 1, 5,
                                     sview("Push the box onto the goal", 0, -1), verdict,
                                     sview("", 0, -1))
                return

            if category == 5 and selected == 3:
                wide: i64 = 9
                tall: i64 = 7
                cells: i64 = wide * tall
                walls: mutable darray[i64] = Ints::zeros(cells)
                walked: mutable darray[i64] = Ints::zeros(cells)
                doors: mutable darray[i64] = Ints::zeros(2)
                keys: mutable darray[i64] = Ints::zeros(2)
                Ints::put(&doors, 0, 22)
                Ints::put(&doors, 1, 40)
                Ints::put(&keys, 0, 12)
                Ints::put(&keys, 1, 30)
                walker: i64 = wide + 1 + cursor % 25
                Ints::put(&walked, walker, 1)
                paint: SceneMaze::Paint = SceneMaze::paint_of(black_background != 0, width, height, sx, sy)
                SceneMaze::render(list, &paint, phase, true, wide, tall, &walls,
                                  &walked, true, cells - wide - 2, &doors, &keys,
                                  cursor % 2, walker, steps, 1, 5,
                                  sview("Find the exit", 0, -1), verdict,
                                  sview("", 0, -1))
                return

            if category == 5 and selected == 4:
                wide: i64 = 9
                tall: i64 = 9
                cells: i64 = wide * tall
                walls: mutable darray[i64] = Ints::zeros(cells)
                door_cells: mutable darray[i64] = Ints::zeros(2)
                key_cells: mutable darray[i64] = Ints::zeros(2)
                Ints::put(&door_cells, 0, 30)
                Ints::put(&door_cells, 1, 60)
                Ints::put(&key_cells, 0, 12)
                Ints::put(&key_cells, 1, 42)
                sights: mutable darray[SceneYouAreHere::Sight] = []
                for column in 0..<180 |sights|:
                    sights.push(SceneYouAreHere::Sight{distance: 0.4 + 0.02 * (column % 20).f64(),
                                                       cell: (column * 7) % cells,
                                                       side: column % 2})
                marks: mutable darray[SceneYouAreHere::Mote] = []
                marks.push(SceneYouAreHere::Mote{what: 0, which: 0, across: 0.3, distance: 0.8})
                paint: SceneYouAreHere::Paint = SceneYouAreHere::paint_of(black_background != 0, width, height, sx, sy)
                SceneYouAreHere::render(list, &paint, phase, true, wide, tall,
                                        &walls, &door_cells, &key_cells, 10, 70, 0,
                                        &sights, &marks, true, steps, 11, 1, 5,
                                        sview("Find your way out", 0, -1), verdict,
                                        sview("", 0, -1))
                return

            if category == 5 and selected == 5:
                wide: i64 = 9
                tall: i64 = 9
                cells: i64 = wide * tall
                walls: mutable darray[bool] = []
                goals: mutable darray[bool] = []
                traps: mutable darray[bool] = []
                live: mutable darray[bool] = []
                plan_boxes: mutable darray[i64] = []
                for cell in 0..<cells |walls, goals, traps, live|:
                    x: i64 = cell % wide
                    y: i64 = cell / wide
                    edge: bool = x == 0 or y == 0 or x == 8 or y == 8
                    walls.push(edge)
                    goals.push(cell == 70)
                    traps.push(cell == 25)
                    box: bool = cell == 20 or cell == 30
                    live.push(box)
                    if box:
                        plan_boxes.push(cell)
                sights: mutable darray[SceneSokoban3D::Sight] = []
                for column in 0..<180 |sights|:
                    sights.push(SceneSokoban3D::Sight{distance: 0.5 + 0.02 * (column % 20).f64(),
                                                       cell: (column * 5) % cells,
                                                       side: column % 2})
                marks: mutable darray[SceneSokoban3D::Mark] = []
                marks.push(SceneSokoban3D::Mark{across: 0.35, distance: 0.9})
                paint: SceneSokoban3D::Paint = SceneSokoban3D::paint_of(black_background != 0, width, height, sx, sy)
                SceneSokoban3D::render(list, &paint, phase, true, wide, tall,
                                       &walls, &goals, &traps, &plan_boxes, 10 + cursor % 25, &live,
                                       true, true, &sights, &marks, steps, steps, 1, 5,
                                       sview("Push through the 3D room", 0, -1), verdict,
                                       sview("", 0, -1))
                return

            if category == 5 and selected == 6:
                cols: i64 = 16
                rows: i64 = 20
                board: mutable darray[i64] = Ints::zeros(cols * rows)
                Ints::put(&board, 16, 1)
                queue_cells: mutable darray[SceneTetris::TetrisCell] = []
                queue_counts: mutable darray[i64] = []
                for bay in 0..<6 |queue_cells, queue_counts|:
                    queue_counts.push(3)
                    queue_cells.push(SceneTetris::TetrisCell{x: 0, y: 0, tint: 0})
                    queue_cells.push(SceneTetris::TetrisCell{x: 1, y: 0, tint: 0})
                    queue_cells.push(SceneTetris::TetrisCell{x: 1, y: 1, tint: 0})
                fits: mutable darray[i64] = []
                recut: mutable darray[bool] = []
                shadow: mutable darray[SceneTetris::TetrisBlock] = []
                air: mutable darray[SceneTetris::TetrisBlock] = []
                fits.push(1)
                recut.push(false)
                shadow.push(SceneTetris::TetrisBlock{x: 4.0 + (cursor % 4).f64(), y: 2.0})
                air.push(SceneTetris::TetrisBlock{x: 7.5 + (steps % 3).f64(), y: 15.5})
                paint: SceneTetris::TetrisPaint = SceneTetris::paint_of(black_background != 0, width, height, sx, sy)
                SceneTetris::render(list, &paint, phase, cols, rows, &board,
                                    &queue_cells, &queue_counts, &fits, &recut, 0,
                                    &shadow, true, &air, 1, 12.0,
                                    sview("Drop the falling piece", 0, -1),
                                    sview("1 line", 0, -1), -1, sview("", 0, -1))
                return

            if category == 5 and selected == 7:
                puzzle: mutable NinaRow::Puzzle = zeroed
                puzzle.ok <- true
                puzzle.size <- 5
                puzzle.pellets <- 7
                puzzle.length <- 3
                puzzle.answer <- 12
                cells: mutable darray[i64] = Ints::zeros(25)
                Ints::put(&cells, 6, NinaRow::PLAYER)
                Ints::put(&cells, 7, NinaRow::PLAYER)
                Ints::put(&cells, 11, NinaRow::OPPONENT)
                if steps > 0:
                    Ints::put(&cells, cursor % 25, NinaRow::PLAYER)
                paint: SceneNinaRow::Paint = SceneNinaRow::paint_of(black_background != 0, width, height, sx, sy)
                SceneNinaRow::render(list, &paint, &puzzle, &cells, true, phase,
                                     1, 5, cursor % 25, phase == 2,
                                     sview("Find the winning move", 0, -1))
                return

            # The two chess/Go tasks are separate cards in the source hub.
            if category == 4 and selected == 12:
                piece: mutable darray[i64] = Ints::zeros(64)
                white: mutable darray[i64] = Ints::zeros(64)
                targets: mutable darray[i64] = Ints::zeros(64)
                Ints::put(&piece, 0, 1)
                Ints::put(&piece, 7, 6)
                Ints::put(&white, 0, 1)
                Ints::put(&white, 7, 0)
                Ints::put(&targets, 14, 1)
                paint: SceneChess::Paint = SceneChess::paint_of(black_background != 0, width, height, sx, sy)
                SceneChess::render(list, &paint, &piece, &white, &targets, true,
                                   phase, cursor % 64, 1, 5,
                                   sview("White to move and find mate in one", 0, -1))
                return

            # Fallback for an unknown future card.
            paint: SceneTask::TaskPaint = SceneTask::paint_of(black_background != 0, width, height, sx, sy)
            SceneTask::render(list, &paint, category, selected, phase != 0)
