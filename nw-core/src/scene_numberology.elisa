# The Numberology screen: game state in, display list out.
#
# Port of neural_workshop/ui/numberology.py -- the drawing, not the thinking.
#
# Six labels and a verdict, no shapes. The only layout worth a comment is the typed line:
#
#     y = max(self._floor() + 36, from_bottom_edge(150))
#
# a MAX and not a min, so on a short window the entry is pushed UP off the
# verdict band rather than sliding down into it. The band reader pays the trial
# by what it finds in the bottom quarter, and a blue answer line down there is
# a scalar read off the scenery.
#
# NOTE: needs elisacore_math, strings, geometry, verdict and display included
# by the driver.

module SceneNumberology:

    const PHASE_READY: i64 = 0
    const PHASE_WORKING: i64 = 1
    const PHASE_JUDGED: i64 = 2
    const PHASE_DONE: i64 = 3

    struct NumberologyPaint:
        ink: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> NumberologyPaint:
        back: i64 = 0 if black_background else 255
        fore: i64 = 255 - back
        return NumberologyPaint{ink: Display::rgba(fore, fore, fore, 255),
                     width: width, height: height, sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: NumberologyPaint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    def floor_of(height: f64) -> f64:
        can Abort.Panic:
            return Verdict::above_the_band(height, Geometry::from_bottom_edge(height, 52.0).f64()).f64()

    def entry_y(height: f64) -> f64:
        can Abort.Panic:
            lifted: f64 = floor_of(height) + 36.0
            wanted: f64 = Geometry::from_bottom_edge(height, 150.0).f64()
            return lifted if lifted > wanted else wanted

    # `verdict` is -1 for "nothing resolved yet", 0 for wrong, 1 for right.
    # The screen keeps `verdict_shown` across a relayout, so the label is
    # rebuilt from state rather than surviving it.
    def options(list: mutable Display::DisplayList&, black: bool, selected: i64,
                level: i64, trials: i64, adaptive: bool):
        can Memory.Allocate, Abort.Panic:
            back: u32 = Display::rgba(0, 0, 0, 255) if black else Display::rgba(255, 255, 255, 255)
            panel: u32 = Display::rgba(23, 26, 32, 255) if black else Display::rgba(246, 247, 249, 255)
            highlight: u32 = Display::rgba(42, 48, 58, 255) if black else Display::rgba(226, 231, 239, 255)
            ink: u32 = Display::rgba(232, 235, 240, 255) if black else Display::rgba(32, 36, 42, 255)
            Display::draw_rect(list, 0.0, 0.0, 912.0, 684.0, back)
            Display::draw_rect(list, 62.0, 72.0, 788.0, 540.0, panel)
            Display::draw_text_weight(list, sview("Numberology options", 0, -1), 456.0, 558.0, 24.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            for row in 0..<3 |list, selected, level, trials, adaptive, highlight, ink|:
                y: f64 = 474.0 - row.f64() * 48.0
                if row == selected:
                    Display::draw_rect(list, 102.0, y - 18.0, 708.0, 36.0, highlight)
                label: sview = sview("Level", 0, -1) if row == 0 else sview("Questions per run", 0, -1) if row == 1 else sview("Climb after a perfect run", 0, -1)
                Display::draw_text_weight(list, label, 132.0, y, 16.0, ink, Display::ANCHOR_LEFT_CENTER, false)
                value: mutable dstr = []
                if row == 0:
                    dstr_append_i64(&value, level)
                elif row == 1:
                    dstr_append_i64(&value, trials)
                elif row == 2 and adaptive:
                    dstr_append_cstr(&value, "Yes")
                else:
                    dstr_append_cstr(&value, "No")
                Display::draw_text_weight(list, bytes_view(value), 780.0, y, 16.0, ink, Display::ANCHOR_RIGHT_CENTER, true)
            Display::draw_text_weight(list, sview("Find the next term of each sequence.", 0, -1), 456.0, 224.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER, false)
            Display::draw_text_weight(list, sview("Esc: cancel    Arrows: change    Enter: apply", 0, -1), 456.0, 92.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER, false)


    def render(list: mutable Display::DisplayList&, paint: NumberologyPaint&, phase: i64,
               has_puzzle: bool, asked: sview, rule: sview, typed: sview,
               trial: i64, total_trials: i64, message: sview,
               verdict: i64, verdict_text: sview):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()
            showing: bool = has_puzzle and (phase == PHASE_WORKING or phase == PHASE_JUDGED)

            put_text(list, paint, sview("Numberology", 0, -1), middle,
                     Geometry::from_top_edge(paint.height, 34.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            status: mutable dstr = []
            dstr_append_sview(&status, message)
            if phase == PHASE_WORKING:
                dstr_append_cstr(&status, "     question ")
                dstr_append_i64(&status, trial)
                dstr_append_cstr(&status, "/")
                dstr_append_i64(&status, total_trials)
            put_text(list, paint, bytes_view(status), middle,
                     Geometry::from_top_edge(paint.height, 68.0).f64(),
                     Geometry::calc_fontsize(paint.height, 13.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            sequence: sview = asked if showing else sview("", 0, -1)
            put_text(list, paint, sequence, middle,
                     Geometry::from_top_edge(paint.height, 190.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            hint: sview = rule if phase == PHASE_JUDGED and has_puzzle else sview("Find the rule, then type the next number.", 0, -1)
            put_text(list, paint, hint, middle,
                     Geometry::from_top_edge(paint.height, 250.0).f64(),
                     Geometry::calc_fontsize(paint.height, 13.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            entry: mutable dstr = []
            if phase == PHASE_WORKING or phase == PHASE_JUDGED:
                dstr_append_sview(&entry, typed)
                if phase == PHASE_WORKING:
                    entry.push(95.u8())
            put_text(list, paint, bytes_view(entry), middle, entry_y(paint.height),
                     Geometry::calc_fontsize(paint.height, 20.0),
                     Display::rgba(0, 114, 178, 255),
                     Display::ANCHOR_CENTER_CENTER, false)

            put_text(list, paint,
                     sview("Esc: menu   Space: start   type the answer   Enter: check   O: options", 0, -1),
                     middle, Geometry::from_bottom_edge(paint.height, 24.0).f64(),
                     Geometry::calc_fontsize(paint.height, 11.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            # Built last, so it is the last thing in the batch -- and drawn
            # only once a trial has resolved, because a verdict the player can
            # still act on is an answer key rather than a result.
            if verdict >= 0:
                SceneVerdict::put(list, paint.width, paint.height, paint.sx, paint.sy,
                                  verdict == 1, verdict_text, 60.0, 16.0)
