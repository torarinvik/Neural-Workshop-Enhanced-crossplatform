include "./tasks/beliefs_game.elisa"
include "./display.elisa"
include "./beliefs_text.elisa"
include "./scene_verdict.elisa"
include "./geometry.elisa"
include "./textmetrics.elisa"

module SceneBeliefs:
    const LEFT: f64 = 27.36
    const BOTTOM: f64 = 179.0
    const WIDTH: f64 = 857.28
    const HEIGHT: f64 = 389.0
    const CENTER_X: f64 = 456.0
    const BUTTON_H: f64 = HEIGHT * 0.1
    const BUTTON_GAP: f64 = WIDTH * 0.012
    const PANEL_GAP: f64 = WIDTH * 0.01
    const KEY_SIZE: f64 = 11.0
    const KEY_H: f64 = KEY_SIZE * 2.2
    const SCENE_BOTTOM: f64 = BOTTOM + BUTTON_H + HEIGHT * 0.03
    const SCENE_TOP: f64 = BOTTOM + HEIGHT
    const CENTER: u32 = Display::ANCHOR_CENTER_CENTER
    const TOP: u32 = Display::ANCHOR_CENTER_TOP

    struct Box:
        x: f64
        y: f64
        w: f64
        h: f64

    def min(a: f64, b: f64) -> f64:
        return a if a < b else b

    def font(size: f64) -> f64:
        return size if size >= 6.0 else 6.0

    def button(count: i64, index: i64) -> Box:
        w: f64 = min(WIDTH * 0.3, (WIDTH - BUTTON_GAP * (count - 1).f64()) / count.f64())
        x: f64 = CENTER_X - (w * count.f64() + BUTTON_GAP * (count - 1).f64()) / 2.0
        return Box{x: x + index.f64() * (w + BUTTON_GAP), y: BOTTOM, w: w, h: BUTTON_H}

    def panel_box(count: i64, index: i64) -> Box:
        cols: i64 = count if count < 4 else 4
        rows: i64 = (count + cols - 1) / cols
        w: f64 = (WIDTH - PANEL_GAP * (cols - 1).f64()) / cols.f64()
        h: f64 = min((SCENE_TOP - SCENE_BOTTOM - KEY_H - PANEL_GAP * (rows - 1).f64()) / rows.f64(), w * 0.75)
        x: f64 = LEFT + (index % cols).f64() * (w + PANEL_GAP)
        y: f64 = SCENE_TOP - h - (index / cols).f64() * (h + PANEL_GAP)
        return Box{x: x, y: y, w: w, h: h}

    def hit(run: BeliefsGame::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return BeliefsGame::START if run.phase == BeliefsGame::READY or run.phase == BeliefsGame::DONE
            return -1 if run.phase != BeliefsGame::PLAYING or y < BOTTOM or y > BOTTOM + BUTTON_H
            count: i64 = run.story.level.containers
            for i in 0..<count |x, count|:
                b: Box = button(count, i)
                return i if x >= b.x and x <= b.x + b.w
            return -1

    def box(list: mutable Display::DisplayList&, b: Box, fill: u32, edge: u32, thickness: f64):
        can Abort.Panic, Memory.Allocate:
            Display::draw_rect(list, b.x, b.y, b.w, b.h, fill)
            Display::draw_box(list, b.x, b.y, b.w, b.h, edge, thickness)

    def thing_colour(index: i64) -> u32:
        can Abort.Panic:
            colours: u32[3] = [0xe8463cff, 0xe6c43cff, 0x6ec850ff]
            return colours[index.usize()]

    def person(list: mutable Display::DisplayList&, story: Beliefs::Story&, index: i64, x: f64, y: f64, r: f64, size: f64):
        can Abort.Panic, Memory.Allocate:
            colours: u32[4] = [0xd66050ff, 0x508cd6ff, 0x60b068ff, 0xb078d2ff]
            Display::draw_circle(list, x, y, r, colours[index.usize()])
            Display::draw_text_weight(list, sview(BeliefsText::named(story, index), 0, 1), x, y, font(size), 0xffffffff, CENTER, true)

    def containers(list: mutable Display::DisplayList&, story: Beliefs::Story&, panel: Beliefs::Panel, b: Box, size: f64, ink: u32):
        can Abort.Panic, Memory.Allocate:
            colours: u32[4] = [0xc49660ff, 0x7896beff, 0x967860ff, 0x6eaa96ff]
            count: i64 = story.level.containers
            inner: f64 = b.w * 0.8
            cw: f64 = inner / (count.f64() + 0.6)
            gap: f64 = (inner - cw * count.f64()) / (count + 1).f64()
            room: f64 = b.h * 0.7
            top: f64 = b.y + b.h - room * 0.12
            ch: f64 = room * 0.4
            for at in 0..<count |list, story, panel, b, size, ink, colours, cw, gap, top, ch|:
                x: f64 = b.x + gap + at.f64() * (cw + gap)
                box(list, Box{x: x, y: top - ch, w: cw, h: ch}, colours[at.usize()], ink, 1.0)
                Display::draw_text(list, sview(BeliefsText::container(at), 0, -1), x + cw / 2.0, top - ch - 2.0, font(size), ink, TOP)
                inside: mutable i64 = 0
                for thing in 0..<story.level.things |panel, inside, at|:
                    inside <- inside + 1 if panel.places[thing.usize()] == at
                position: mutable i64 = 0
                for thing in 0..<story.level.things |list, panel, at, position, x, cw, ch, top, inside|:
                    if panel.places[thing.usize()] == at:
                        position <- position + 1
                        Display::draw_circle(list, x + cw * position.f64() / (inside + 1).f64(),
                            top - ch / 2.0, min(cw, ch) * 0.16, thing_colour(thing))

    def occupants(list: mutable Display::DisplayList&, story: Beliefs::Story&, present: i64, b: Box, size: f64):
        can Abort.Panic, Memory.Allocate:
            count: i64 = story.level.people
            count_in: mutable i64 = 0
            for i in 0..<count |count_in, present|:
                count_in <- count_in + 1 if Beliefs::inside(present, i)
            room: f64 = b.h * 0.7
            baseline: f64 = b.y + b.h * 0.3
            r: f64 = min(room * 0.11, b.w * 0.04)
            rank_in: mutable i64 = 0
            rank_out: mutable i64 = 0
            for i in 0..<count |list, story, present, b, size, room, baseline, r, count, count_in, rank_in, rank_out|:
                if Beliefs::inside(present, i):
                    rank_in <- rank_in + 1
                    person(list, story, i, b.x + b.w * 0.8 * rank_in.f64() / (count_in + 1).f64(), baseline + r * 1.6, r, size)
                else:
                    rank_out <- rank_out + 1
                    y: f64 = baseline + room * (1.0 - rank_out.f64() / ((count - count_in).f64() + 1.3))
                    person(list, story, i, b.x + b.w * 0.9, y, r, size)

    def wrapped_caption(list: mutable Display::DisplayList&, text: sview, b: Box, size: f64, ink: u32):
        can Abort.Panic, Memory.Allocate:
            length: i64 = sview_len(text).i64()
            advance: i64 = TextMetrics::advance(size)
            line_height: f64 = TextMetrics::line_height(size).f64()
            width: i64 = (b.w - 4.0).i64()
            start: mutable i64 = 0
            space: mutable i64 = -1
            y: mutable f64 = b.y + b.h * 0.3 - 2.0
            for i in 0..<length |list, text, b, size, ink, start, space, y, width, advance, line_height|:
                if sview_at(text, i.usize()) == 32.u8():
                    space <- i
                elif space >= start and (i - start + 1) * advance >= width:
                    Display::draw_text(list, string_view_slice(text, start, space), b.x + 2.0, y, size, ink, Display::ANCHOR_LEFT_TOP)
                    start <- space + 1
                    space <- -1
                    y <- y - line_height
            Display::draw_text(list, string_view_slice(text, start, length), b.x + 2.0, y, size, ink, Display::ANCHOR_LEFT_TOP)

    def panel(list: mutable Display::DisplayList&, story: Beliefs::Story&, index: i64, b: Box, dark: bool, ink: u32):
        can Abort.Panic, Memory.Allocate:
            cap: f64 = b.h * 0.3
            room: f64 = b.h - cap
            site: Beliefs::Panel = story.panels[index.usize()]
            box(list, Box{x: b.x, y: b.y + cap, w: b.w * 0.8, h: room}, 0x282a30ff if dark else 0xf6f4eeff, ink, 1.0)
            box(list, Box{x: b.x + b.w * 0.8, y: b.y + cap, w: b.w * 0.2, h: room}, 0x3e4048ff if dark else 0xd6d8deff, ink, 1.0)
            small: f64 = min(10.0, min(room * 0.1, b.w * 0.035))
            Display::draw_text(list, "out", b.x + b.w * 0.9, b.y + b.h - 3.0, font(small * 0.9), ink, TOP)
            containers(list, story, site, b, small, ink)
            occupants(list, story, site.present, b, small)
            text: mutable dstr = []
            dstr_append_i64(&text, index + 1)
            dstr_append_cstr(&text, ". ")
            BeliefsText::caption(story, site.event, &text)
            wrapped_caption(list, bytes_view(text), b, font(min(11.0, cap * 0.3)), ink)

    def options(list: mutable Display::DisplayList&, run: BeliefsGame::Run&, dark: bool, ink: u32):
        can Abort.Panic, Memory.Allocate:
            count: i64 = run.story.level.containers
            back: u32 = 0x2e323aff if dark else 0xe8ebf0ff
            for i in 0..<count |list, run, count, ink, back|:
                b: Box = button(count, i)
                correct: bool = run.phase == BeliefsGame::JUDGED and i == run.story.answer
                wrong: bool = run.phase == BeliefsGame::JUDGED and i == run.chosen and not correct
                edge: u32 = 0x3caa5aff if correct else (0xd6403aff if wrong else ink)
                box(list, b, back, edge, 5.0 if correct or wrong else 2.0)
                label: mutable dstr = []
                dstr_append_i64(&label, i + 1)
                dstr_append_cstr(&label, "  the ")
                dstr_append_cstr(&label, BeliefsText::container(i))
                Display::draw_text(list, bytes_view(label), b.x + b.w / 2.0, b.y + b.h / 2.0,
                    min(14.0, BUTTON_H * 0.3), ink, CENTER)

    def key(list: mutable Display::DisplayList&, count: i64, ink: u32):
        can Abort.Panic, Memory.Allocate:
            step: f64 = WIDTH / (count + 1).f64()
            y: f64 = SCENE_BOTTOM + KEY_H / 2.0
            for i in 0..<count |list, ink, step, y|:
                kx: f64 = LEFT + step * (i + 1).f64()
                Display::draw_circle(list, kx - KEY_SIZE * 1.6, y, KEY_SIZE * 0.5, thing_colour(i))
                label: mutable dstr = []
                dstr_append_cstr(&label, "the ")
                dstr_append_cstr(&label, BeliefsText::thing(i))
                Display::draw_text(list, bytes_view(label), kx - KEY_SIZE, y, KEY_SIZE, ink, Display::ANCHOR_LEFT_CENTER)

    def message(run: BeliefsGame::Run&, text: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            if run.phase == BeliefsGame::READY:
                dstr_append_cstr(text, "Press Space or click to start")
            elif run.phase == BeliefsGame::DONE:
                dstr_append_i64(text, run.passed_count)
                dstr_append_cstr(text, " of ")
                dstr_append_i64(text, run.scored_count)
                dstr_append_cstr(text, " passed   highest rung passed ")
                dstr_append_i64(text, run.best_rung)
            elif run.phase == BeliefsGame::JUDGED:
                dstr_append_cstr(text, "Right: the " if run.passed else "No: the ")
                dstr_append_cstr(text, BeliefsText::container(run.story.answer))
            else:
                BeliefsText::question(&run.story, text)

    def render(list: mutable Display::DisplayList&, run: BeliefsGame::Run&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Who Knows What?", CENTER_X, 648.0, 22.0, ink, CENTER, true)
            Display::draw_text(list, "click an answer or press its number   Esc: menu", CENTER_X, 26.0, 12.0, ink, CENTER)
            status: mutable dstr = []
            message(run, &status)
            Display::draw_text(list, bytes_view(status), CENTER_X, 614.0, 14.0, ink, CENTER)
            return if run.phase == BeliefsGame::READY or run.phase == BeliefsGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, run.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, run.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, run.total)
            Display::draw_text(list, bytes_view(facts), CENTER_X, 588.0, 12.0, ink, CENTER)
            options(list, run, dark, ink)
            key(list, run.story.level.things, ink)
            count: i64 = run.story.count
            for at in 0..<count |list, run, dark, ink, count|:
                panel(list, &run.story, at, panel_box(count, at), dark, ink)
            if run.phase == BeliefsGame::JUDGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.passed, bytes_view(status), 60.0, 16.0)
            elif run.phase == BeliefsGame::FLAGGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, false, "Out of time", 60.0, 16.0)
