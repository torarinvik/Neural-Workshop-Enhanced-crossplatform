include "./tasks/clawmachine_game.elisa"
include "./scene_live_view.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./scene_lens.elisa"

# ui/clawmachine.py: the cabinet from the front -- its back, sides and floor
# with lines across it, the prizes far to near, the trolley on its rail and
# the claw on its cable, the glass edges -- with the claw's shadow on the
# low rungs and, on rung 1, a side view in the corner.
module SceneClawMachine:
    const LEFT: f64 = (LiveView::WIDTH - LiveView::VIEW_WIDTH) / 2.0
    const PI: f64 = 3.141592653589793

    @inline(never)
    def sine(angle: f64) -> f64:
        return sin(angle)

    @inline(never)
    def cosine(angle: f64) -> f64:
        return cos(angle)

    def bottom() -> f64:
        can Abort.Panic:
            return Verdict::above_the_band(LiveView::HEIGHT, Geometry::from_bottom_edge(LiveView::HEIGHT, 58.0).f64()).f64()

    def height() -> f64:
        can Abort.Panic:
            return fmax(40.0, Geometry::from_top_edge(LiveView::HEIGHT, 116.0).f64() - bottom())

    def label(list: mutable Display::DisplayList&, text: sview, y: f64, size: f64, ink: u32, bold: bool = false):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, LiveView::CX, y, size, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def clip() -> SceneLens::Clip:
        can Abort.Panic:
            b: f64 = bottom()
            return SceneLens::Clip{x0: LEFT, y0: b, x1: LEFT + LiveView::VIEW_WIDTH, y1: b + height()}

    def v(x: f64, y: f64, z: f64) -> SceneLens::Vec:
        return SceneLens::vec(x, y, z)

    def quad(list: mutable Display::DisplayList&, cut: SceneLens::Clip, lens: SceneLens::Lens&, a: SceneLens::Vec,
             b: SceneLens::Vec, c: SceneLens::Vec, d: SceneLens::Vec, ink: u32):
        can Memory.Allocate, Abort.Panic:
            shape: SceneLens::Solid = SceneLens::quad(a, b, c, d)
            SceneLens::face(list, cut, lens, &shape, ink)

    # ClawMachine._draw, without the frame's card.
    def view(list: mutable Display::DisplayList&, run: ClawMachine::Run&):
        can Memory.Allocate, Abort.Panic:
            cut: SceneLens::Clip = clip()
            left: f64 = LEFT
            width: f64 = LiveView::VIEW_WIDTH
            b: f64 = bottom()
            h: f64 = height()
            level: ClawMachine::Grade& = &run.cab.level
            hw: f64 = ClawMachine::HALF
            d: f64 = ClawMachine::DEEP
            top: f64 = ClawMachine::TOP
            eye: SceneLens::Vec = v(0.0, 1.15, -2.9) if level.low else v(0.0, 2.3, -2.5)
            aim: SceneLens::Vec = v(0.0, 0.55, 0.8)
            lens: SceneLens::Lens = SceneLens::camera(eye, SceneLens::sub(aim, eye), left, b, width, h, 52.0, true)
            quad(list, cut, &lens, v(-hw, 0.0, d), v(hw, 0.0, d), v(hw, 2.0, d), v(-hw, 2.0, d), 0x462850ff)
            for i in 0..<2 |list, cut, lens, d, hw|:
                side: f64 = -hw if i == 0 else hw
                quad(list, cut, &lens, v(side, 0.0, 0.0), v(side, 0.0, d), v(side, 2.0, d), v(side, 2.0, 0.0), 0x3a2244ff)
            quad(list, cut, &lens, v(-hw, 0.0, 0.0), v(hw, 0.0, 0.0), v(hw, 0.0, d), v(-hw, 0.0, d), 0x786482ff)
            for k in 1..<8 |list, cut, lens, hw, d|:
                z: f64 = d * k.f64() / 8.0
                SceneLens::seg(list, cut, &lens, v(-hw, 0.002, z), v(hw, 0.002, z), 1.0, 0x8c7896ff)
            cx: f64 = ClawMachine::claw_x(run)
            cz: f64 = ClawMachine::claw_z(run)
            if level.shadow:
                shadow: mutable SceneLens::Solid = zeroed
                for i in 0..<16 |shadow, cx, cz|:
                    a: f64 = i.f64() * PI / 8.0
                    shadow.points[i.usize()] <- v(cx + 0.09 * cosine(a), 0.003, cz + 0.09 * sine(a))
                shadow.count <- 16
                SceneLens::face(list, cut, &lens, &shadow, 0x3c2d46ff)
            # the prizes, deepest first, ties in order
            count: i64 = level.prizes
            order: mutable i64[8] = [0, 1, 2, 3, 4, 5, 6, 7]
            for i in 1..<count |order, run|:
                j: mutable i64 = i
                while j > 0 and run.cab.prizes[order[(j - 1).usize()].usize()].z < run.cab.prizes[order[j.usize()].usize()].z |order, run, j|:
                    swap: i64 = order[j.usize()]
                    order[j.usize()] <- order[(j - 1).usize()]
                    order[(j - 1).usize()] <- swap
                    j <- j - 1
            held: bool = run.result == ClawMachine::GOT_IT
            for i in 0..<count |list, cut, lens, run, order, held|:
                k: i64 = order[i.usize()]
                continue if held and k == 0
                p: ClawMachine::Prize& = &run.cab.prizes[k.usize()]
                SceneLens::ball(list, cut, &lens, v(ClawMachine::prize_x(run, p), p.r, p.z), p.r, p.colour)
            SceneLens::seg(list, cut, &lens, v(-hw, top + 0.1, run.z), v(hw, top + 0.1, run.z), 4.0, 0x9696a0ff)
            SceneLens::box(list, cut, &lens, run.x - 0.08, top + 0.05, run.z - 0.08, run.x + 0.08, top + 0.15, run.z + 0.08,
                0xb4b4beff)
            cy: f64 = top - run.depth
            SceneLens::seg(list, cut, &lens, v(run.x, top + 0.05, run.z), v(cx, cy, cz), 2.0, 0xd2d2dcff)
            fingers: f64[3] = [0.0, 2.1, 4.2]
            for i in 0..<3 |list, cut, lens, cx, cy, cz, fingers|:
                a: f64 = fingers[i.usize()]
                SceneLens::seg(list, cut, &lens, v(cx, cy, cz), v(cx + 0.1 * cosine(a), cy - 0.14, cz + 0.1 * sine(a)), 3.0,
                    0xdcdce6ff)
            if held:
                gold: ClawMachine::Prize& = &run.cab.prizes[0]
                SceneLens::ball(list, cut, &lens, v(cx, cy - 0.12, cz), gold.r, gold.colour)
            SceneLens::seg(list, cut, &lens, v(-hw, 0.0, 0.0), v(-hw, 2.0, 0.0), 3.0, 0xc8dcff8c)
            SceneLens::seg(list, cut, &lens, v(hw, 0.0, 0.0), v(hw, 2.0, 0.0), 3.0, 0xc8dcff8c)
            SceneLens::seg(list, cut, &lens, v(-hw, 2.0, 0.0), v(hw, 2.0, 0.0), 3.0, 0xc8dcff8c)
            side_view(list, run, left + width - 230.0, b + 20.0, 210.0, 170.0) if level.side

    # ClawMachine._side: the cabinet from the side, depth across, height up.
    def side_view(list: mutable Display::DisplayList&, run: ClawMachine::Run&, x0: f64, y0: f64, w: f64, h: f64):
        can Memory.Allocate, Abort.Panic:
            cut: SceneLens::Clip = clip()
            d: f64 = ClawMachine::DEEP
            top: f64 = ClawMachine::TOP
            SceneLens::rect(list, cut, x0, y0, w, h, 0x14101aff)
            SceneLens::line(list, cut, x0 + 10.0 + (w - 20.0) * 0.0 / d, y0 + 10.0 + (h - 20.0) * 0.0 / 2.0,
                x0 + 10.0 + (w - 20.0) * d / d, y0 + 10.0 + (h - 20.0) * 0.0 / 2.0, 2.0, 0x9682a0ff)
            for k in 0..<run.cab.level.prizes |list, cut, run, x0, y0, w, h, d|:
                p: ClawMachine::Prize& = &run.cab.prizes[k.usize()]
                SceneLens::disc(list, cut, x0 + 10.0 + (w - 20.0) * p.z / d, y0 + 10.0 + (h - 20.0) * p.r / 2.0,
                    p.r * (w - 20.0) / d, p.colour)
            cz: f64 = ClawMachine::claw_z(run)
            SceneLens::line(list, cut, x0 + 10.0 + (w - 20.0) * run.z / d, y0 + 10.0 + (h - 20.0) * (top + 0.1) / 2.0,
                x0 + 10.0 + (w - 20.0) * cz / d, y0 + 10.0 + (h - 20.0) * (top - run.depth) / 2.0, 2.0, 0xd2d2dcff)
            SceneLens::disc(list, cut, x0 + 10.0 + (w - 20.0) * cz / d, y0 + 10.0 + (h - 20.0) * (top - run.depth) / 2.0, 5.0,
                0xe6e6f0ff)
            Display::draw_text_weight(list, "side view", x0 + w / 2.0, y0 + h - 10.0, 9.0, 0xc8c8d2c8,
                Display::ANCHOR_CENTER_CENTER, false)

    def card(list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            frame: SceneLens::Clip = clip()
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: frame.x0 - 4.0, y: frame.y0 - 4.0,
                w: frame.x1 - frame.x0 + 8.0, h: frame.y1 - frame.y0 + 8.0}
            shades: u32[3] = [30.u32(), 18.u32(), 12.u32()]
            for i in 0..<3 |list, box, shades|:
                blur: f64 = i.f64() * 2.0
                shadow: SceneHiddenRule::Rect = ScenePolish::spread_box(&box, blur, 4.0)
                ScenePolish::rounded(list, &shadow, 14.0 + blur, shades[i.usize()])
            ScenePolish::rounded(list, &box, 14.0, 0x281432ff)

    def verdict_text(run: ClawMachine::Run&, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            r: i64 = run.result
            if r == ClawMachine::GOT_IT:
                dstr_append_cstr(words, "Got it")
            elif r == ClawMachine::NOT_GOLD:
                dstr_append_cstr(words, "That is not the gold one")
            elif r == ClawMachine::TOO_FAR_IN:
                dstr_append_cstr(words, "Missed: too far in")
            elif r == ClawMachine::NOT_FAR_ENOUGH_IN:
                dstr_append_cstr(words, "Missed: not far enough in")
            elif r == ClawMachine::TO_THE_RIGHT:
                dstr_append_cstr(words, "Missed: to the right")
            elif r == ClawMachine::TO_THE_LEFT:
                dstr_append_cstr(words, "Missed: to the left")
            elif r == ClawMachine::OUT_OF_TIME:
                dstr_append_cstr(words, "Out of time")

    def render(list: mutable Display::DisplayList&, session: ClawMachineGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            run: ClawMachine::Run& = &session.run
            label(list, "Claw Machine", 648.0, 22.0, ink, true)
            label(list, "Arrows / WASD: move (Up is in)   Space: drop   Esc: menu", 26.0, 12.0, ink)
            caption: mutable dstr = []
            verdict_text(run, &caption)
            status: mutable dstr = []
            if session.phase == ClawMachineGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == ClawMachineGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == ClawMachineGame::JUDGED:
                status <- caption
            else:
                dstr_append_cstr(&status, "Drop the claw over the gold prize")
            label(list, bytes_view(status), 614.0, 14.0, ink)
            if session.phase == ClawMachineGame::PLAYING or session.phase == ClawMachineGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   ")
                dstr_append_fixed(&facts, py_round_decimal(ClawMachine::py_max(0.0, run.cab.seconds - run.t), 1.0), 0)
                dstr_append_cstr(&facts, " s")
                label(list, bytes_view(facts), 588.0, 12.0, ink)
                card(list)
                view(list, run)
            if session.phase == ClawMachineGame::JUDGED or session.phase == ClawMachineGame::DONE:
                SceneVerdict::put(list, LiveView::WIDTH, LiveView::HEIGHT, 1.0, 1.0, run.result == ClawMachine::GOT_IT,
                    bytes_view(caption), 60.0, 16.0)

    # taskoptions.clawmachine_note.
    def option_note(rung: i64, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: ClawMachine::Grade = ClawMachine::grade(rung)
            dstr_append_cstr(words, "Rung ")
            dstr_append_i64(words, level.rung)
            dstr_append_cstr(words, ": ")
            dstr_append_i64(words, level.prizes)
            dstr_append_cstr(words, " prizes.")
            if level.side:
                dstr_append_cstr(words, "  A side view.")
            elif level.shadow:
                dstr_append_cstr(words, "  The claw casts a shadow.")
            dstr_append_cstr(words, "  The claw swings.") if level.swing != 0.0
