include "./scene_hand.elisa"
include "./geometry.elisa"
include "./scene_verdict.elisa"
include "./strings.elisa"
include "./tasks/nightwatch_game.elisa"

# ui/nightwatch.py: the dark floor and its crates, the lamp on the safe, the
# round of light the torch carries and whoever stands in it, the night's
# orders, the whistle and the strikes, and arrows when the floor runs on.
module SceneNightWatch:
    def point(x: f64, y: f64) -> RoomsView::Vec:
        return RoomsView::vec(x, y, 1.0)

    # handtask.rect: cut to the screen, then drawn.
    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            left: f64 = fmax(0.0, x)
            bottom: f64 = fmax(0.0, y)
            width: f64 = fmin(1000.0, x + w) - left
            height: f64 = fmin(640.0, y + h) - bottom
            return if width <= 0.0 or height <= 0.0
            Display::draw_rect(list, SceneHand::x(left), SceneHand::y(bottom), width * SceneHand::SCALE, height * SceneHand::SCALE, tint)

    # handtask.disc: a circle, or over the edge a 16-sided polygon cut to it.
    def disc(list: mutable Display::DisplayList&, x: f64, y: f64, radius: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            return if x < -radius or x > 1000.0 + radius or y < -radius or y > 640.0 + radius
            if x < radius or y < radius or x > 1000.0 - radius or y > 640.0 - radius:
                points: mutable RoomsView::Vec[32] = zeroed
                for i in 0..<16 |points, x, y, radius|:
                    angle: f64 = 3.141592653589793 * i.f64() / 8.0
                    points[i.usize()] <- point(x + radius * cos(angle), y + radius * sin(angle))
                SceneHand::polygon(list, &points, 16, tint)
                return
            Display::draw_circle(list, SceneHand::x(x), SceneHand::y(y), fmax(1.0, radius * SceneHand::SCALE), tint)

    # handtask.oval with its default 20 sides.
    def oval(list: mutable Display::DisplayList&, x: f64, y: f64, rx: f64, ry: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            points: mutable RoomsView::Vec[32] = zeroed
            for k in 0..<20 |points, x, y, rx, ry|:
                angle: f64 = 2.0 * 3.141592653589793 * k.f64() / 20.0
                points[k.usize()] <- point(x + rx * cos(angle), y + ry * NightWatch::sine(angle))
            SceneHand::polygon(list, &points, 20, tint)

    def cap(colour: i64) -> u32:
        return 0xe23c36ff if colour == NightWatch::RED else (0x3cb45aff if colour == NightWatch::GREEN else
            (0x4678e6ff if colour == NightWatch::BLUE else (0xf0d23cff if colour == NightWatch::YELLOW else
            (0xf0f0f0ff if colour == NightWatch::WHITE else 0x82828cff))))

    # Run.orders.
    def orders(out: mutable dstr&, run: NightWatch::Run&):
        can Abort.Panic, Memory.Allocate:
            dstr_append_cstr(out, "Tonight the thieves wear ")
            dstr_append_cstr(out, NightWatch::colour(run.night.thief))
            dstr_append_cstr(out, ". The guard wears ")
            dstr_append_cstr(out, NightWatch::colour(run.night.guard))
            dstr_append_cstr(out, ".")

    def floor(list: mutable Display::DisplayList&, run: NightWatch::Run&, camera: HandView::Lens&):
        can Abort.Panic, Memory.Allocate:
            half: f64 = run.night.level.half
            corners: RoomsView::Vec[4] = [HandView::see(camera, RoomsView::vec(-half - 2.0, 0.0, 0.0)),
                HandView::see(camera, RoomsView::vec(half + 2.0, 0.0, 0.0)),
                HandView::see(camera, RoomsView::vec(half + 2.0, 0.0, NightWatch::DEEP + 3.0)),
                HandView::see(camera, RoomsView::vec(-half - 2.0, 0.0, NightWatch::DEEP + 3.0))]
            points: mutable RoomsView::Vec[32] = zeroed
            for i in 0..<4 |corners, points|:
                return if corners[i.usize()].z < 0.05
                points[i.usize()] <- point(corners[i.usize()].x, corners[i.usize()].y)
            SceneHand::polygon(list, &points, 4, 0x101016ff)
            # The crates.
            for k in 0..<(half.i64() * 2) |list, camera, half|:
                x: f64 = -half + 1.0 + fmod(k.f64() * 2.618, 2.0 * half - 2.0)
                z: f64 = 0.3 if k % 2 != 0 else NightWatch::DEEP - 0.2
                a: RoomsView::Vec = HandView::see(camera, RoomsView::vec(x - 0.5, 0.0, z))
                b: RoomsView::Vec = HandView::see(camera, RoomsView::vec(x + 0.5, 1.0 + 0.4 * (k % 3).f64(), z))
                continue if a.z < 0.05 or b.z < 0.05
                box: mutable RoomsView::Vec[32] = zeroed
                box[0] <- point(a.x, a.y)
                box[1] <- point(b.x, a.y)
                box[2] <- point(b.x, b.y)
                box[3] <- point(a.x, b.y)
                SceneHand::polygon(list, &box, 4, 0x1a181aff)

    def walkers(list: mutable Display::DisplayList&, run: NightWatch::Run&):
        can Abort.Panic, Memory.Allocate:
            spots: mutable NightWatch::Spot[20] = zeroed
            which: mutable i64[20] = zeroed
            count: mutable i64 = 0
            for k in 0..<run.night.count |run, spots, which, count|:
                continue if not NightWatch::lit(run, k)
                spots[count.usize()] <- NightWatch::spot(run, k)
                which[count.usize()] <- k
                count <- count + 1
            # seen.sort(key=depth): stable, the far first.
            for i in 1..<count |spots, which|:
                j: mutable i64 = i
                while j > 0 and spots[j.usize()].u < spots[(j - 1).usize()].u |spots, which, j|:
                    held: NightWatch::Spot = spots[j.usize()]
                    spots[j.usize()] <- spots[(j - 1).usize()]
                    spots[(j - 1).usize()] <- held
                    other: i64 = which[j.usize()]
                    which[j.usize()] <- which[(j - 1).usize()]
                    which[(j - 1).usize()] <- other
                    j <- j - 1
            for i in 0..<count |list, run, spots, which|:
                s: NightWatch::Spot = spots[i.usize()]
                x: f64 = s.x
                y: f64 = s.y
                u: f64 = s.u
                w: NightWatch::Walker = run.night.walkers[which[i.usize()].usize()]
                if w.kind == NightWatch::CAT:
                    oval(list, x, y, 0.42 * u, 0.2 * u, 0x787882ff)
                    disc(list, x + 0.36 * u, y + 0.2 * u, 0.15 * u, 0x787882ff)
                    SceneHand::line(list, point(x - 0.4 * u, y), point(x - 0.6 * u, y + 0.4 * u), 3.0, 0x787882ff)
                    continue
                rect(list, x - 0.24 * u, y - 1.0 * u, 0.48 * u, 0.65 * u, 0x282834ff)
                rect(list, x - 0.3 * u, y - 0.35 * u, 0.6 * u, 0.85 * u, 0x404254ff)
                disc(list, x, y + 0.7 * u, 0.2 * u, 0xe2bea0ff)
                rect(list, x - 0.24 * u, y + 0.8 * u, 0.48 * u, 0.16 * u, cap(w.colour))
                rect(list, x - 0.24 * u, y + 0.8 * u, 0.7 * u, 0.06 * u, cap(w.colour))

    def play(list: mutable Display::DisplayList&, run: NightWatch::Run&):
        can Abort.Panic, Memory.Allocate:
            SceneHand::card(list, 0x06060aff)
            rect(list, 0.0, 0.0, 1000.0, 640.0, 0x08080cff)
            camera: HandView::Lens = NightWatch::view(run)
            floor(list, run, &camera)
            level: NightWatch::Grade = run.night.level
            disc(list, run.hand.x, run.hand.y, level.beam, 0xd2c4963c)
            disc(list, run.hand.x, run.hand.y, level.beam * 0.72, 0xfff0c83c)
            q: RoomsView::Vec = HandView::see(&camera, RoomsView::vec(NightWatch::SAFE_X, 0.0, NightWatch::SAFE_Z))
            if q.z >= 0.05:
                u: f64 = 760.0 / q.z
                rect(list, q.x - 0.45 * u, q.y, 0.9 * u, 1.0 * u, 0x2c303cff)
                disc(list, q.x, q.y + 0.5 * u, 0.16 * u, 0x5a606eff)
                disc(list, q.x, q.y + 1.12 * u, 0.07 * u, 0x5ae678ff)
            walkers(list, run)
            rect(list, 150.0, 600.0, 700.0, 32.0, 0x14141ce6)
            said: mutable dstr = []
            orders(&said, run)
            SceneHand::word(list, bytes_view(said), 500.0, 616.0, 13.0, 0xffffffff, true)
            tally: mutable dstr = []
            dstr_append_cstr(&tally, "caught ")
            dstr_append_i64(&tally, run.caught)
            dstr_append_cstr(&tally, " / ")
            dstr_append_i64(&tally, level.thieves)
            SceneHand::word(list, bytes_view(tally), 80.0, 570.0, 12.0, 0xdcdce6ff)
            whistle: mutable dstr = []
            dstr_append_cstr(&whistle, "whistle: ")
            dstr_append_i64(&whistle, run.blasts)
            SceneHand::word(list, bytes_view(whistle), 80.0, 548.0, 12.0, 0xdcdce6ff)
            for k in 0..<level.strikes |list, run|:
                disc(list, 40.0 + 24.0 * k.f64(), 524.0, 7.0, 0xec5040ff if k < run.strikes else 0x282832ff)
            room: f64 = NightWatch::room(run)
            if room > 0.0:
                if run.cam > -room + 0.05:
                    SceneHand::word(list, "<  A", 40.0, 320.0, 16.0, 0xc8c8d2c8, true)
                if run.cam < room - 0.05:
                    SceneHand::word(list, "D  >", 960.0, 320.0, 16.0, 0xc8c8d2c8, true)
            SceneHand::progress(list, &run.hand, fmax(0.0, (level.seconds - run.time) / level.seconds))

    # The run's result text.
    def verdict(out: mutable dstr&, run: NightWatch::Run&):
        can Abort.Panic, Memory.Allocate:
            if run.result == NightWatch::CAUGHT_ALL:
                dstr_append_cstr(out, "Every thief caught")
            elif run.result == NightWatch::NO_WHISTLE:
                dstr_append_cstr(out, "No whistle left")
            elif run.result == NightWatch::WRONG_ONE:
                dstr_append_cstr(out, "That was the guard" if run.wrong == NightWatch::GUARD else "That was the cat")
            elif run.result == NightWatch::ROBBED:
                dstr_append_cstr(out, "The safe is robbed")
            else:
                dstr_append_cstr(out, "Dawn: ")
                dstr_append_i64(out, run.caught)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, run.night.level.thieves)
                dstr_append_cstr(out, " caught")

    # taskoptions.nightwatch_note.
    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: NightWatch::Grade = NightWatch::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.thieves)
            dstr_append_cstr(out, " thieves, ")
            dstr_append_i64(out, level.others)
            dstr_append_cstr(out, " others.")
            dstr_append_cstr(out, "  Read the orders: the colours change.") if not level.fixed

    def render(list: mutable Display::DisplayList&, game: NightWatchGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Night Watch", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Mouse: the torch   Click a thief   Left/Right or A/D: turn along the floor   Esc: menu", 456.0, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            if game.phase == NightWatchGame::READY:
                Display::draw_text(list, "Press Space or click to start", 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            if game.phase == NightWatchGame::DONE:
                report: mutable dstr = []
                dstr_append_i64(&report, game.wins)
                dstr_append_cstr(&report, " of ")
                dstr_append_i64(&report, game.trial)
                dstr_append_cstr(&report, " passed   highest rung passed ")
                dstr_append_i64(&report, game.best_rung)
                Display::draw_text(list, bytes_view(report), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            play(list, &game.run)
            said: mutable dstr = []
            orders(&said, &game.run)
            Display::draw_text(list, bytes_view(said), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if game.phase == NightWatchGame::JUDGED:
                text: mutable dstr = []
                verdict(&text, &game.run)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, game.run.result == NightWatch::CAUGHT_ALL, bytes_view(text), 60.0, 16.0)
