include "./tasks/sheet_game.elisa"
include "./scene_browser.elisa"

module SceneSheet:
    # ui/sheet.py's drawing: the filter bar, sortable headers, rows, sum
    # buttons and status bar on the left; the answer box, keypad and Submit
    # on the right; Browser's pointer over them, inside RungTask's title,
    # status and footnote.
    const GRID: u32 = 0xd6dae2ff
    const HEAD: u32 = 0xe8ecf4ff
    const ON: u32 = 0x285adcff
    const STRIPE: u32 = 0xf7f8fbff
    const WHITE: u32 = 0xffffffff
    const LEFT_ANCHOR: u32 = Display::ANCHOR_LEFT_CENTER
    const CENTRE_ANCHOR: u32 = Display::ANCHOR_CENTER_CENTER

    def rect(list: mutable Display::DisplayList&, place: Sheet::Rectangle, fill: u32, edge: u32):
        can Memory.Allocate, Abort.Panic:
            SceneBrowser::rect(list, BrowserGame::frame(), place.x, place.y, place.width, place.height, fill, edge)

    def words(list: mutable Display::DisplayList&, text: sview, x: f64, y: f64, size: f64, colour: u32, bold: bool,
            anchor: u32, width: f64):
        can Memory.Allocate, Abort.Panic:
            _ = SceneBrowser::words(list, BrowserGame::frame(), text, x, y, size, colour, bold, anchor, width)

    # A button with its label centred on it, as the chips, sums and keys are.
    def button(list: mutable Display::DisplayList&, place: Sheet::Rectangle, label: sview, size: f64, on: bool, bold: bool):
        can Memory.Allocate, Abort.Panic:
            rect(list, place, ON if on else SceneBrowser::BUTTON, SceneBrowser::EDGE)
            words(list, label, place.x + place.width / 2.0, place.y + place.height / 2.0, size,
                WHITE if on else SceneBrowser::INK, bold, CENTRE_ANCHOR, 0.0)

    def chips(list: mutable Display::DisplayList&, state: Sheet::Workbook&):
        can Memory.Allocate, Abort.Panic:
            for index in 0..<(1 + state.puzzle.category_count) |list, state|:
                filter: i64 = Sheet::chip_filter(state, index)
                label: mutable dstr = []
                dstr_append_cstr(&label, "All" if filter < 0 else Sheet::category_name(filter))
                on: bool = state.filter == filter
                button(list, Sheet::chip(state, index), bytes_view(label), 13.0, on, on)

    def headers(list: mutable Display::DisplayList&, state: Sheet::Workbook&):
        can Memory.Allocate, Abort.Panic:
            for column in 0..<6 |list, state|:
                place: Sheet::Rectangle = Sheet::header(column)
                rect(list, place, HEAD, GRID)
                label: mutable dstr = []
                dstr_append_cstr(&label, Sheet::column_label(column))
                if state.sort_column == column:
                    dstr_append_cstr(&label, "  v" if state.sort_down else "  ^")
                words(list, bytes_view(label), place.x + 8.0, Sheet::HEAD_Y + Sheet::HEAD_H / 2.0, 14.0, SceneBrowser::INK, true,
                    LEFT_ANCHOR, 0.0)

    def rows(list: mutable Display::DisplayList&, state: Sheet::Workbook&):
        can Memory.Allocate, Abort.Panic:
            shown: darray[i64] = Sheet::visible_rows(state)
            count: i64 = shown.count.i64()
            last: i64 = state.scroll + Sheet::VISIBLE if state.scroll + Sheet::VISIBLE < count else count
            right_edge: f64 = Sheet::column_x(Sheet::TOTAL) + Sheet::column_width(Sheet::TOTAL)
            for at in state.scroll..<last |list, state, shown, right_edge|:
                i: i64 = at - state.scroll
                y: f64 = Sheet::ROWS_Y + i.f64() * Sheet::ROW_H
                rect(list, Sheet::Rectangle{x: Sheet::LEFT, y: y, width: right_edge - Sheet::LEFT, height: Sheet::ROW_H},
                    STRIPE if i % 2 == 1 else WHITE, GRID)
                row: Sheet::Row = state.puzzle.rows[shown[at.usize()].usize()]
                for column in 0..<6 |list, row, y|:
                    x: f64 = Sheet::column_x(column)
                    w: f64 = Sheet::column_width(column)
                    numeric: bool = Sheet::numeric(column) or column == Sheet::ID
                    cell: mutable dstr = []
                    SheetText::cell(&cell, &row, column)
                    words(list, bytes_view(cell), x + w - 10.0 if numeric else x + 8.0, y + Sheet::ROW_H / 2.0, 14.0,
                        SceneBrowser::INK, false, Display::ANCHOR_RIGHT_CENTER if numeric else LEFT_ANCHOR, w - 14.0)
            if count > Sheet::VISIBLE:
                range: mutable dstr = []
                dstr_append_cstr(&range, "rows ")
                dstr_append_i64(&range, state.scroll + 1)
                dstr_append_cstr(&range, "-")
                dstr_append_i64(&range, last)
                dstr_append_cstr(&range, " of ")
                dstr_append_i64(&range, count)
                words(list, bytes_view(range), Sheet::LEFT, Sheet::ROWS_Y + Sheet::VISIBLE.f64() * Sheet::ROW_H + 2.0, 11.0,
                    SceneBrowser::MUTED, false, LEFT_ANCHOR, 0.0)

    def sums(list: mutable Display::DisplayList&, state: Sheet::Workbook&):
        can Memory.Allocate, Abort.Panic:
            label: dstr = SceneBrowser::said("Sum")
            for column in Sheet::QTY..<6 |list, state, label|:
                button(list, Sheet::sum_button(column), bytes_view(label), 13.0, state.stat == column, false)
            rect(list, Sheet::Rectangle{x: Sheet::LEFT, y: Sheet::STATUS_Y, width: 760.0, height: 30.0}, HEAD, GRID)
            status: mutable dstr = []
            SheetText::status(&status, state)
            words(list, bytes_view(status), Sheet::LEFT + 10.0, Sheet::STATUS_Y + 15.0, 14.0, SceneBrowser::INK, false,
                LEFT_ANCHOR, 740.0)

    def panel(list: mutable Display::DisplayList&, state: Sheet::Workbook&):
        can Memory.Allocate, Abort.Panic:
            heading: dstr = SceneBrowser::said("Answer")
            words(list, bytes_view(heading), Sheet::PANEL_X, 52.0, 15.0, SceneBrowser::INK, true, LEFT_ANCHOR, 0.0)
            box: Sheet::Rectangle = Sheet::answer_box()
            rect(list, box, WHITE, ON)
            typed: mutable dstr = []
            SheetText::typed(&typed, state)
            dstr_append_cstr(&typed, "|")
            words(list, bytes_view(typed), box.x + 10.0, box.y + box.height / 2.0, 20.0, SceneBrowser::INK, true, LEFT_ANCHOR, 0.0)
            for index in 0..<11 |list|:
                digit: i64 = Sheet::key_label(index)
                label: mutable dstr = []
                if digit == Sheet::DELETE:
                    dstr_append_cstr(&label, "del")
                else:
                    dstr_append_i64(&label, digit)
                button(list, Sheet::key_rectangle(index), bytes_view(label), 18.0, false, true)
            submit: dstr = SceneBrowser::said("Submit")
            button(list, Sheet::submit_box(), bytes_view(submit), 18.0, false, true)

    # _draw: the sheet, inside the frame Browser's page uses.
    def sheet(list: mutable Display::DisplayList&, state: Sheet::Workbook&):
        can Memory.Allocate, Abort.Panic:
            rect(list, Sheet::Rectangle{x: 0.0, y: 0.0, width: Browser::SCREEN_W, height: Browser::SCREEN_H}, WHITE,
                SceneBrowser::EDGE)
            chips(list, state)
            headers(list, state)
            rows(list, state)
            sums(list, state)
            panel(list, state)
            SceneBrowser::pointer_at(list, BrowserGame::frame(), state.pointer)

    def verdict_words(game: SheetGame::Session&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if game.verdict == SheetGame::RIGHT:
                dstr_append_cstr(out, "Right: ")
                dstr_append_i64(out, game.sheet.puzzle.answer)
                dstr_append_cstr(out, ", in ")
                dstr_append_i64(out, game.sheet.clicks)
                dstr_append_cstr(out, " clicks (par ")
                dstr_append_i64(out, game.par)
                dstr_append_cstr(out, ")")
            elif game.verdict == SheetGame::OVER_PAR:
                dstr_append_cstr(out, "Right, but ")
                dstr_append_i64(out, game.sheet.clicks)
                dstr_append_cstr(out, " clicks against a par of ")
                dstr_append_i64(out, game.par)
            else:
                dstr_append_cstr(out, "No: the answer was ")
                dstr_append_i64(out, game.sheet.puzzle.answer)

    # The status line: what RungTask's message says in each phase.
    def message(game: SheetGame::Session&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if game.phase == SheetGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif game.phase == SheetGame::DONE:
                dstr_append_i64(out, game.ladder.wins)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, game.ladder.trial)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, game.ladder.best_rung)
            elif game.phase == SheetGame::JUDGED:
                verdict_words(game, out)
            else:
                SheetText::question(out, &game.sheet.puzzle)

    def facts(game: SheetGame::Session&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_cstr(out, "rung ")
            dstr_append_i64(out, game.ladder.rung)
            dstr_append_cstr(out, "  ")
            dstr_append_i64(out, game.ladder.trial)
            dstr_append_cstr(out, "/")
            dstr_append_i64(out, game.ladder.total)
            dstr_append_cstr(out, "   clicks ")
            dstr_append_i64(out, game.sheet.clicks)
            dstr_append_cstr(out, "   par ")
            dstr_append_i64(out, game.par)

    def kind_words(kind: i64) -> cstr:
        names: array[cstr, 6] = ["look up", "find the highest", "sum a category", "count over a bar", "find the wrong total",
            "correct the wrong total"]
        return names[kind.usize()]

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Sheet::Grade = Sheet::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.rows)
            dstr_append_cstr(out, " rows; ")
            for index in 0..<level.kind_count |out, level|:
                dstr_append_cstr(out, ", ") if index > 0
                dstr_append_cstr(out, kind_words(level.kinds[index.usize()]))
            dstr_append_cstr(out, ".  Par allows ")
            dstr_append_i64(out, py_round_half_even(level.slack * 200.0))
            dstr_append_cstr(out, "% of the reference's clicks for slips, at least three.")

    def render(list: mutable Display::DisplayList&, game: SheetGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            title: dstr = SceneBrowser::said("Spreadsheet")
            SceneBrowser::line(list, bytes_view(title), 648.0, 22.0, ink, true)
            status: mutable dstr = []
            message(game, &status)
            SceneBrowser::line(list, bytes_view(status), 614.0, 14.0, ink, false)
            footnote: dstr = SceneBrowser::said("click   wheel or Up/Down: scroll   digits, Backspace, Enter: answer   Esc: menu")
            SceneBrowser::line(list, bytes_view(footnote), 26.0, 12.0, ink, false)
            return if game.phase != SheetGame::PLAYING and game.phase != SheetGame::JUDGED
            known: mutable dstr = []
            facts(game, &known)
            SceneBrowser::line(list, bytes_view(known), 588.0, 12.0, ink, false)
            sheet(list, &game.sheet)
            if game.phase == SheetGame::JUDGED:
                SceneVerdict::put(list, BrowserGame::WIDTH, BrowserGame::HEIGHT, 1.0, 1.0, game.verdict == SheetGame::RIGHT,
                    bytes_view(status), 60.0, 16.0)
