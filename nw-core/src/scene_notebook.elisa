include "tasks/notebook_game.elisa"
include "scene_hidden_rule.elisa"

module SceneNotebook:
    const LEFT: f64 = 27.36
    const BOTTOM: f64 = 179.0
    const WIDTH: f64 = 857.28
    const HEIGHT: f64 = 389.0
    const CENTER: f64 = 456.0
    const CARD_W: f64 = WIDTH * 0.46
    const PAPER_W: f64 = WIDTH * 0.5
    const PAPER_X: f64 = LEFT + PAPER_W
    const PAPER_TOP: f64 = BOTTOM + HEIGHT - 14.0 * 2.4
    const CARD_Y: f64 = BOTTOM + HEIGHT * 0.5
    const BUTTON_H: f64 = HEIGHT * 0.13
    const BUTTON_Y: f64 = CARD_Y - HEIGHT * 0.06 - BUTTON_H
    const FADED: u32 = 0x8c8c8cff

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Notebook::Grade = Notebook::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.facts)
            dstr_append_cstr(out, " codes, up to ")
            dstr_append_i64(out, level.hold)
            dstr_append_cstr(out, " waiting at once, at least ")
            dstr_append_i64(out, level.gap + 1)
            dstr_append_cstr(out, " cards before each is asked; ")
            dstr_append_i64(out, level.lines)
            dstr_append_cstr(out, " notebook lines.")
            if level.noise > 0:
                dstr_append_cstr(out, "  With cards not needed")
                if level.updates > 0:
                    dstr_append_cstr(out, ", codes that change")
                dstr_append_cstr(out, ".")
            if level.lines < level.hold:
                dstr_append_cstr(out, "  Some will have to be kept in your head.")

    def answer_box(index: i64, choices: i64) -> SceneHiddenRule::Rect:
        width: f64 = (CARD_W - (choices - 1).f64() * 10.0) / choices.f64()
        return SceneHiddenRule::Rect{x: LEFT + index.f64() * (width + 10.0), y: BUTTON_Y, w: width, h: BUTTON_H}

    def next_box() -> SceneHiddenRule::Rect:
        return SceneHiddenRule::Rect{x: LEFT + CARD_W * 0.3, y: BUTTON_Y, w: CARD_W * 0.4, h: BUTTON_H}

    def line_spacing(lines: i64) -> f64:
        return (PAPER_TOP - BOTTOM) / (lines if lines > 5 else 5).f64()

    def write_box(index: i64, lines: i64) -> SceneHiddenRule::Rect:
        row: f64 = line_spacing(lines)
        width: f64 = PAPER_W * 0.2
        return SceneHiddenRule::Rect{x: PAPER_X + PAPER_W - width - 10.0,
            y: PAPER_TOP - (index + 1).f64() * row + row * 0.15, w: width, h: row * 0.62}

    def hit(run: NotebookGame::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return NotebookGame::START if run.phase == NotebookGame::READY or run.phase == NotebookGame::DONE
            return -1 if run.phase != NotebookGame::PLAYING or Notebook::over(&run.play)
            card: Notebook::Card = run.play.dealt.cards[run.play.at.usize()]
            level: Notebook::Grade = run.play.dealt.level
            if card.kind == Notebook::QUESTION:
                for index in 0..<level.choices |x, y, level|:
                    box: SceneHiddenRule::Rect = answer_box(index, level.choices)
                    return index if SceneHiddenRule::contains(&box, x, y)
            else:
                next: SceneHiddenRule::Rect = next_box()
                return NotebookGame::NEXT if SceneHiddenRule::contains(&next, x, y)
                for index in 0..<level.lines |x, y, level|:
                    box: SceneHiddenRule::Rect = write_box(index, level.lines)
                    return NotebookGame::WRITE + index if SceneHiddenRule::contains(&box, x, y)
            return -1

    def box(list: mutable Display::DisplayList&, rect: SceneHiddenRule::Rect&, fill: u32, ink: u32):
        can Memory.Allocate, Abort.Panic:
            if fill != 0.u32():
                Display::draw_rect(list, rect.x, rect.y, rect.w, rect.h, fill)
            Display::draw_box(list, rect.x, rect.y, rect.w, rect.h, ink, 2.0)

    def card_text(card: Notebook::Card&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            Notebook::name(card.key, out)
            if card.kind == Notebook::QUESTION:
                dstr_append_cstr(out, "?")
                return
            dstr_append_cstr(out, " is now " if card.kind == Notebook::UPDATE else ": ")
            dstr_append_i64(out, card.code)
            if card.kind == Notebook::NOISE:
                dstr_append_cstr(out, "   (not needed)")

    def button(list: mutable Display::DisplayList&, rect: SceneHiddenRule::Rect&, label: sview,
               size: f64, ink: u32, fill: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            box(list, rect, fill, ink)
            SceneHiddenRule::text(list, label, rect.x + rect.w / 2.0, rect.y + rect.h / 2.0, size,
                ink, Display::ANCHOR_CENTER_CENTER, bold)

    def cards(list: mutable Display::DisplayList&, run: NotebookGame::Run&, ink: u32, dark: bool):
        can Memory.Allocate, Abort.Panic:
            back: u32 = 0x2e323aff if dark else 0xe8ebf0ff
            panel: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT, y: CARD_Y, w: CARD_W, h: HEIGHT * 0.5}
            box(list, &panel, back, ink)
            return if Notebook::over(&run.play)
            size: f64 = CARD_W * 0.05
            card: Notebook::Card = run.play.dealt.cards[run.play.at.usize()]
            position: mutable dstr = []
            dstr_append_cstr(&position, "card ")
            dstr_append_i64(&position, run.play.at + 1)
            dstr_append_cstr(&position, " of ")
            dstr_append_i64(&position, run.play.dealt.count)
            SceneHiddenRule::text(list, bytes_view(position), LEFT + 12.0, CARD_Y + panel.h - size * 0.9,
                size * 0.5, ink, Display::ANCHOR_LEFT_CENTER)
            words: mutable dstr = []
            card_text(&card, &words)
            SceneHiddenRule::text(list, bytes_view(words), LEFT + CARD_W / 2.0, CARD_Y + panel.h / 2.0, size,
                FADED if card.kind == Notebook::NOISE else ink, Display::ANCHOR_CENTER_CENTER, true)
            if card.kind == Notebook::QUESTION:
                choices: i64 = run.play.dealt.level.choices
                for index in 0..<choices |list, card, choices, size, ink, back|:
                    rect: SceneHiddenRule::Rect = answer_box(index, choices)
                    label: mutable dstr = []
                    dstr_append_i64(&label, index + 1)
                    dstr_append_cstr(&label, ": ")
                    dstr_append_i64(&label, card.choices[index.usize()])
                    button(list, &rect, bytes_view(label), size * 0.8, ink, back, true)
            else:
                rect: SceneHiddenRule::Rect = next_box()
                button(list, &rect, "Next (Enter)", size * 0.7, ink, back, true)
            if run.last >= 0 and run.phase == NotebookGame::PLAYING:
                SceneHiddenRule::text(list, "last answer: right" if run.last == 1 else "last answer: wrong",
                    LEFT + CARD_W / 2.0, BUTTON_Y - size, size * 0.55, ink)

    def paper(list: mutable Display::DisplayList&, run: NotebookGame::Run&, ink: u32, dark: bool):
        can Memory.Allocate, Abort.Panic:
            panel: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: PAPER_X, y: BOTTOM, w: PAPER_W, h: HEIGHT}
            box(list, &panel, 0x3a382eff if dark else 0xfaf6e2ff, ink)
            SceneHiddenRule::text(list, "Notebook", PAPER_X + PAPER_W / 2.0, BOTTOM + HEIGHT - 14.0,
                14.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            lines: i64 = run.play.dealt.level.lines
            row: f64 = line_spacing(lines)
            size: f64 = SceneHiddenRule::minimum(16.0, row * 0.32)
            writable: bool = run.phase == NotebookGame::PLAYING and not Notebook::over(&run.play) and
                run.play.dealt.cards[run.play.at.usize()].kind != Notebook::QUESTION
            for index in 0..<lines |list, run, row, size, writable, ink, lines|:
                y: f64 = PAPER_TOP - (index + 1).f64() * row
                Display::draw_line(list, PAPER_X + 8.0, y + 2.0, PAPER_X + PAPER_W - 8.0, y + 2.0, 1.0, 0x96aad2ff)
                number: mutable dstr = []
                dstr_append_i64(&number, index + 1)
                SceneHiddenRule::text(list, bytes_view(number), PAPER_X + 14.0, y + row * 0.45,
                    size * 0.8, FADED, Display::ANCHOR_LEFT_CENTER)
                note: Notebook::Note = run.play.lines[index.usize()]
                if note.code != 0:
                    words: mutable dstr = []
                    Notebook::name(note.key, &words)
                    dstr_append_cstr(&words, " ")
                    dstr_append_i64(&words, note.code)
                    SceneHiddenRule::text(list, bytes_view(words), PAPER_X + 14.0 + size * 2.0,
                        y + row * 0.45, size, ink, Display::ANCHOR_LEFT_CENTER)
                if writable:
                    rect: SceneHiddenRule::Rect = write_box(index, lines)
                    button(list, &rect, "Write", SceneHiddenRule::minimum(size * 0.8, row * 0.25), ink, 0.u32(), false)

    def render(list: mutable Display::DisplayList&, run: NotebookGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            SceneHiddenRule::text(list, "Notebook", CENTER, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            SceneHiddenRule::text(list, "Write: copy the card onto a line (Shift+1-8)   Next (Enter)   answer 1-4   Esc: menu",
                CENTER, 26.0, 12.0, ink)
            message: mutable dstr = []
            if run.phase == NotebookGame::READY:
                dstr_append_cstr(&message, "Press Space or click to start")
            elif run.phase == NotebookGame::DONE:
                dstr_append_i64(&message, run.passed_count)
                dstr_append_cstr(&message, " of ")
                dstr_append_i64(&message, run.trial)
                dstr_append_cstr(&message, " passed   highest rung passed ")
                dstr_append_i64(&message, run.best_rung)
            elif run.phase == NotebookGame::JUDGED:
                dstr_append_i64(&message, run.play.right)
                dstr_append_cstr(&message, " of ")
                dstr_append_i64(&message, run.play.dealt.level.facts)
                dstr_append_cstr(&message, " answered right")
            else:
                dstr_append_cstr(&message, "Keep what you will be asked for")
            SceneHiddenRule::text(list, bytes_view(message), CENTER, 614.0, 14.0, ink)
            return if run.phase == NotebookGame::READY or run.phase == NotebookGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, run.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, run.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, run.total)
            dstr_append_cstr(&facts, "   questions ")
            dstr_append_i64(&facts, run.play.given)
            dstr_append_cstr(&facts, " of ")
            dstr_append_i64(&facts, run.play.dealt.level.facts)
            dstr_append_cstr(&facts, "   right so far ")
            dstr_append_i64(&facts, run.play.right)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, run.play.dealt.level.lines)
            dstr_append_cstr(&facts, " lines")
            SceneHiddenRule::text(list, bytes_view(facts), CENTER, 588.0, 12.0, ink)
            cards(list, run, ink, dark)
            paper(list, run, ink, dark)
            if run.phase == NotebookGame::FLAGGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, false, "Out of time", 60.0, 16.0)
            elif run.phase == NotebookGame::JUDGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.play.right == run.play.dealt.level.facts,
                    bytes_view(message), 60.0, 16.0)
