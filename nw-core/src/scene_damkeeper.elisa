include "./tasks/damkeeper_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./geometry.elisa"

module SceneDamKeeper:
    const LEFT: f64 = 27.36
    const WIDTH: f64 = 857.28
    const BOTTOM: f64 = 179.0
    const WORLD_LEFT: f64 = -30.0
    const WORLD_RIGHT: f64 = 124.0
    const WORLD_H: f64 = 60.0
    const SCALE: f64 = WIDTH / (WORLD_RIGHT - WORLD_LEFT)
    const DEPTH: f64 = 16.0
    const WATER_TOP: u32 = 0x60aadeff
    const CENTER: u32 = Display::ANCHOR_CENTER_CENTER

    const CARD: i64 = 0
    const BODY: i64 = 1
    const TEXT: i64 = 2
    const TOP: i64 = 3

    def x(world: f64) -> f64:
        return LEFT + (world - WORLD_LEFT) * SCALE

    def y(world: f64) -> f64:
        return BOTTOM + world * SCALE

    def bed(k: i64) -> f64:
        return 34.0 - k.f64() * 11.0

    def span(k: i64, n: i64) -> f64:
        return k.f64() * (DamKeeper::VALLEY / n.f64())

    def dam(k: i64, n: i64) -> f64:
        return span(k + 1, n) - 2.0

    def fraction(value: f64, period: f64) -> f64:
        can Abort.Panic:
            return value - floor(value / period) * period

    def hit(session: DamKeeperGame::Session&, px: f64, py: f64) -> i64:
        can Abort.Panic:
            return DamKeeperGame::START if session.phase == DamKeeperGame::READY or session.phase == DamKeeperGame::DONE
            return -1 if session.phase != DamKeeperGame::PLAYING
            n: i64 = session.run.valley.level.dams
            for k in 0..<n |px, py, n|:
                gx: f64 = x(dam(k, n))
                gy: f64 = y(bed(k) + DEPTH * 0.5)
                if px > gx - 3.0 * SCALE and px < gx + 3.0 * SCALE and py > gy - DEPTH * 0.6 * SCALE and py < gy + DEPTH * 0.6 * SCALE:
                    return 2 * k + (0 if py > gy else 1)
            return -1

    def quad(list: mutable Display::DisplayList&, coords: f64[8], fill: u32):
        can Abort.Panic, Memory.Allocate:
            Display::begin_polygon(list, 4, x(coords[0]), y(coords[1]), fill)
            for j in 0..<4 |list, coords|:
                Display::polygon_point(list, x(coords[(2 * j).usize()]), y(coords[(2 * j + 1).usize()]))

    def gradient(list: mutable Display::DisplayList&, left: f64, base: f64, w: f64, h: f64, sky: bool):
        can Abort.Panic, Memory.Allocate:
            # Source band colors use Python's rounding of each RGB channel.
            sky_colours: u32[20] = [0xc2d4e7ff, 0xbcd0e5ff, 0xb8cde4ff, 0xb2c9e2ff, 0xaec5e0ff,
                0xa8c2deff, 0xa4bedcff, 0x9ebadaff, 0x9ab7d9ff, 0x94b3d7ff,
                0x90afd5ff, 0x8aabd3ff, 0x86a8d2ff, 0x80a4d0ff, 0x7ca0ceff,
                0x769dccff, 0x7299caff, 0x6c95c8ff, 0x6892c7ff, 0x628ec5ff]
            water_colours: u32[6] = [0x24599cff, 0x2e68a8ff, 0x3a77b4ff, 0x4485c0ff, 0x5094ccff, 0x5aa3d8ff]
            bands: i64 = 20 if sky else 6
            step: f64 = h / bands.f64()
            for j in 0..<bands |list, left, base, w, step, sky, sky_colours, water_colours|:
                colour: u32 = sky_colours[j.usize()] if sky else water_colours[j.usize()]
                Display::draw_rect(list, left, base + j.f64() * step, w, step + 1.0, colour)

    def terrain(list: mutable Display::DisplayList&, n: i64, dark: bool):
        can Abort.Panic, Memory.Allocate:
            frame: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT - 6.0, y: BOTTOM - 6.0, w: WIDTH + 12.0, h: WORLD_H * SCALE + 12.0}
            shadows: u32[3] = [55.u32(), 33.u32(), 22.u32()] if dark else [0x18223c11, 0x18223c0a, 0x18223c06]
            for j in 0..<3 |list, frame, shadows|:
                spread: f64 = j.f64() * 2.0
                shadow: SceneHiddenRule::Rect = ScenePolish::spread_box(&frame, spread, 4.0)
                ScenePolish::rounded(list, &shadow, 14.0 + spread, shadows[j.usize()])
            ScenePolish::rounded(list, &frame, 14.0, 0x3c465aff)
            gradient(list, LEFT, BOTTOM, WIDTH, WORLD_H * SCALE, true)
            Display::draw_rect(list, LEFT, y(WORLD_H - 16.0), -WORLD_LEFT * SCALE, 16.0 * SCALE, 0x505a783c)
            ridge_x: f64[10] = [0.0, 12.0, 26.0, 40.0, 55.0, 70.0, 86.0, 100.0, 112.0, WORLD_RIGHT]
            ridge_y: f64[10] = [30.0, 46.0, 38.0, 50.0, 36.0, 44.0, 30.0, 34.0, 24.0, 20.0]
            for k in 0..<9 |list, ridge_x, ridge_y|:
                i: usize = k.usize()
                j: usize = (k + 1).usize()
                quad(list, [ridge_x[i], 0.0, ridge_x[i], ridge_y[i], ridge_x[j], ridge_y[j], ridge_x[j], 0.0], 0x96a0c4ff)
            for k in 0..<n |list, n|:
                lo: f64 = span(k, n)
                Display::draw_rect(list, x(lo), BOTTOM, (span(k + 1, n) - lo) * SCALE, bed(k) * SCALE, 0x7a6c60ff)
            Display::draw_rect(list, x(DamKeeper::VALLEY), BOTTOM, (WORLD_RIGHT - DamKeeper::VALLEY) * SCALE, 6.0 * SCALE, 0x96ba6eff)
            houses: f64[4] = [104.0, 110.0, 116.0, 120.0]
            roofs: u32[4] = [0xd25a46ff, 0x5a78beff, 0xe6b45aff, 0x9664aaff]
            for k in 0..<4 |list, houses, roofs|:
                hx: f64 = houses[k.usize()]
                Display::draw_rect(list, x(hx - 1.8), y(6.0), 3.6 * SCALE, 3.0 * SCALE, 0xf4ecdcff)
                Display::draw_triangle(list, x(hx - 2.2), y(9.0), x(hx + 2.2), y(9.0), x(hx), y(11.0), roofs[k.usize()])
            for k in 0..<n |list, n|:
                px: f64 = dam(k, n)
                py: f64 = bed(k)
                quad(list, [px - 1.5, py, px + 3.5, py - 4.0, px + 3.5, py + DEPTH + 2.0, px - 0.5, py + DEPTH + 2.0], 0xc8c6c0ff)

    def weather(list: mutable Display::DisplayList&, run: DamKeeper::Run&, layer: i64):
        can Abort.Panic, Memory.Allocate:
            level: DamKeeper::Grade = run.valley.level
            for i in 0..<level.storms |list, run, level, layer|:
                storm: DamKeeper::Storm = run.valley.storms[i.usize()]
                front: f64 = DamKeeper::storm_front(storm, run.t)
                back: f64 = front - storm.width
                if front < WORLD_LEFT or back > DamKeeper::VALLEY + 10.0:
                    continue
                lo: f64 = DamKeeper::max(back, 0.0 if level.hidden else WORLD_LEFT + 4.0)
                hi: f64 = DamKeeper::min(front, WORLD_RIGHT - 4.0)
                if hi <= lo:
                    continue
                cy: f64 = WORLD_H - 6.0
                for k in 0..<(((hi - lo) / 4.0).i64() + 1) |list, run, layer, lo, hi, cy|:
                    cx: f64 = lo + k.f64() * 4.0 + 2.0
                    break if cx > hi
                    cloud_y: f64 = cy + sin(k.f64() * 1.3) * 1.2
                    if layer == BODY:
                        Display::draw_circle(list, x(cx), y(cloud_y), 3.4 * SCALE, 0x5a6074ff)
                    elif layer == TEXT:
                        Display::draw_circle(list, x(cx - 1.0), y(cloud_y + 1.2), 2.4 * SCALE, 0x787e92ff)
                    elif cx >= 0.0:
                        for j in 0..<3 |list, run, cx, cy, k|:
                            rx: f64 = cx - 1.0 + j.f64()
                            ry: f64 = cy - 3.0 - fraction(run.t * 30.0 + j.f64() * 9.0 + k.f64() * 5.0, 22.0)
                            Display::draw_line(list, x(rx), y(ry), x(rx - 0.4), y(ry - 2.2), 1.0, 0xc8dcffaa)

    def reservoir(list: mutable Display::DisplayList&, run: DamKeeper::Run&, k: i64, layer: i64):
        can Abort.Panic, Memory.Allocate:
            n: i64 = run.valley.level.dams
            lo: f64 = span(k, n)
            hi: f64 = span(k + 1, n)
            floor_y: f64 = bed(k)
            dam_x: f64 = dam(k, n)
            water: f64 = run.water[k.usize()]
            depth: f64 = DEPTH * DamKeeper::min(1.0, water / 100.0)
            px: f64 = x(lo + 1.0)
            py: f64 = y(floor_y)
            w: f64 = (dam_x - lo - 0.5) * SCALE
            if layer == CARD:
                gradient(list, px, py, w, DamKeeper::max(1.0, depth * SCALE), false)
                return
            if layer == BODY:
                for j in 0..<(w / (3.0 * SCALE)).i64() |list, run, px, py, w, depth|:
                    wx: f64 = px + j.f64() * 3.0 * SCALE + fraction(run.t * 8.0, 3.0) * SCALE
                    if wx < px + w - 2.0 * SCALE:
                        Display::draw_arc(list, wx, py + depth * SCALE, 0.8 * SCALE, 0.0, 180.0, 0xdcf0ffff)
                return
            gx: f64 = dam_x + 1.0
            gy: f64 = floor_y + 2.0
            flow: f64 = DamKeeper::outflow(run, k)
            jx: f64 = dam_x + 3.5
            jy: f64 = floor_y + 1.0
            share: f64 = flow / DamKeeper::FLOW
            if layer == TEXT:
                mx: f64 = dam_x - 0.6
                Display::draw_line(list, x(mx - 2.5), y(floor_y + DEPTH), x(mx), y(floor_y + DEPTH), 2.0, 0xf0463cff)
                low: f64 = y(floor_y + DEPTH * (DamKeeper::LOW / 100.0))
                Display::draw_line(list, x(mx - 2.5), low, x(mx), low, 2.0, 0xfabe3cff)
                percent: mutable dstr = []
                dstr_append_i64(&percent, water.i64())
                dstr_append_cstr(&percent, "%")
                colour: u32 = 0xdc3c32ff if water > 85.0 or water < DamKeeper::LOW + 5.0 else 0x1e2846ff
                Display::draw_text_weight(list, bytes_view(percent), x((lo + hi) / 2.0), y(floor_y + DEPTH + 2.2),
                    DamKeeper::max(9.0, 1.6 * SCALE), colour, CENTER, true)
                if flow > 0.0:
                    right: f64 = jx + 4.0 + 4.0 * share
                    quad(list, [jx, jy + 0.6, jx, jy - (0.4 + share), right, jy - 4.0,
                        right, jy - (3.0 - share * 2.0)], 0xd2ecffff)
                name: mutable dstr = []
                dstr_append_i64(&name, k + 1)
                Display::draw_text_weight(list, bytes_view(name), x(gx), y(gy + 13.6), DamKeeper::max(8.0, 1.3 * SCALE), 0x28283cff, CENTER, true)
                return
            for j in 0..<DamKeeper::NOTCHES |list, run, k, gx, gy|:
                colour: u32 = 0x5adcffff if j < run.gate[k.usize()] else 0x5a606eff
                Display::draw_circle(list, x(gx), y(gy + 3.0 + j.f64() * 2.4), 0.8 * SCALE, colour)
            if flow > 0.0:
                for j in 0..<4 |list, run, jx, jy, share|:
                    ph: f64 = fraction(run.t * 1.5 + j.f64() * 0.25, 1.0)
                    alpha: u32 = (200.0 * (1.0 - ph)).u32()
                    Display::draw_circle(list, x(jx + 2.0 + 6.0 * ph), y(jy - 3.5 * ph),
                        (0.4 + 0.5 * share) * SCALE, 0xffffff00 | alpha)

    def foam(list: mutable Display::DisplayList&, run: DamKeeper::Run&):
        can Abort.Panic, Memory.Allocate:
            n: i64 = run.valley.level.dams
            for k in 1..<n |list, run, n|:
                amount: f64 = DamKeeper::in_pipe(run, k)
                if amount > 0.05:
                    ax: f64 = dam(k - 1, n) + 6.0
                    bx: f64 = span(k, n) + 2.0
                    ay: f64 = bed(k - 1) - 3.5
                    by: f64 = bed(k) + 1.0
                    for j in 0..<DamKeeper::min(10.0, 2.0 + amount).i64() |list, run, ax, bx, ay, by|:
                        ph: f64 = fraction(run.t * 0.25 + j.f64() / 10.0, 1.0)
                        Display::draw_circle(list, x(ax + (bx - ax) * ph), y(ay + (by - ay) * ph), 0.6 * SCALE, 0xa0d2f5ff)

    def river(list: mutable Display::DisplayList&, run: DamKeeper::Run&, layer: i64):
        can Abort.Panic, Memory.Allocate:
            level: DamKeeper::Grade = run.valley.level
            gate: f64 = dam(level.dams - 1, level.dams)
            rx: f64 = x(gate + 4.0)
            rw: f64 = (WORLD_RIGHT - gate - 5.0) * SCALE
            fy: f64 = y(5.0)
            if layer == TOP:
                Display::draw_line(list, rx, fy, rx + rw, fy, 2.0, 0xf03c32ff)
            elif layer == CARD:
                depth: f64 = 4.0 * DamKeeper::min(1.4, run.town / level.flood)
                flooded: bool = run.town > level.flood
                Display::draw_rect(list, rx, y(1.0), rw, DamKeeper::max(1.0, depth * SCALE), 0xdc5046ff if flooded else WATER_TOP)
                if flooded:
                    ScenePolish::glow(list, rx + rw / 2.0, fy, 8.0 * SCALE, 0xff503cff, 90)

    def clock_bar(list: mutable Display::DisplayList&, run: DamKeeper::Run&, layer: i64):
        can Abort.Panic, Memory.Allocate:
            share: f64 = DamKeeper::max(0.0, 1.0 - run.t / DamKeeper::SECONDS)
            if layer == CARD or (layer == BODY and share > 0.02):
                bar: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT, y: y(WORLD_H + 0.8),
                    w: WIDTH if layer == CARD else WIDTH * share, h: 1.4 * SCALE}
                ScenePolish::rounded(list, &bar, 0.7 * SCALE, 0xc8ccd6ff if layer == CARD else 0x5a96f0ff)

    def valley(list: mutable Display::DisplayList&, run: DamKeeper::Run&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            n: i64 = run.valley.level.dams
            terrain(list, n, dark)
            for layer in 0..<4 |list, run, n|:
                if layer != TOP:
                    weather(list, run, layer)
                for k in 0..<n |list, run, layer|:
                    reservoir(list, run, k, layer)
                if layer == BODY:
                    foam(list, run)
                river(list, run, layer)
                clock_bar(list, run, layer)
                if layer == TEXT:
                    Display::draw_text(list, "no forecast" if run.valley.level.hidden else "forecast",
                        x(WORLD_LEFT / 2.0), y(WORLD_H - 17.5), DamKeeper::max(8.0, 1.3 * SCALE), 0x283250c8, CENTER)

    def message(session: DamKeeperGame::Session&, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            result: i64 = session.run.result
            if session.phase == DamKeeperGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif session.phase == DamKeeperGame::DONE:
                dstr_append_i64(out, session.passed)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, session.trial)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, session.best)
            elif result == DamKeeper::OVERTOPPED or result == DamKeeper::TOO_LOW:
                dstr_append_cstr(out, "Dam " if result == DamKeeper::OVERTOPPED else "Reservoir ")
                dstr_append_i64(out, session.run.fault_dam + 1)
                dstr_append_cstr(out, " overtopped" if result == DamKeeper::OVERTOPPED else " ran too low")
            elif result == DamKeeper::FLOODED:
                dstr_append_cstr(out, "The town flooded")
            elif result == DamKeeper::PASSED:
                dstr_append_cstr(out, "Through every storm, the town dry")
            else:
                dstr_append_cstr(out, "Make room before the rain; never flood the town")

    def render(list: mutable Display::DisplayList&, session: DamKeeperGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Dam Keeper", 456.0, 648.0, 22.0, ink, CENTER, true)
            Display::draw_text(list, "Q W E: open gates 1-3 a notch   A S D: shut a notch   (or click a gate)   Esc: menu",
                456.0, 26.0, 12.0, ink, CENTER)
            status: mutable dstr = []
            message(session, &status)
            Display::draw_text(list, bytes_view(status), 456.0, 614.0, 14.0, ink, CENTER)
            return if session.phase == DamKeeperGame::READY or session.phase == DamKeeperGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, DamKeeper::max(0.0, DamKeeper::SECONDS - session.run.t).i64())
            dstr_append_cstr(&facts, " s left")
            Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink, CENTER)
            valley(list, &session.run, dark)
            if session.phase == DamKeeperGame::JUDGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.run.result == DamKeeper::PASSED, bytes_view(status), 60.0, 16.0)

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: DamKeeper::Grade = DamKeeper::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.dams)
            dstr_append_cstr(out, " dams, ")
            dstr_append_i64(out, level.storms)
            dstr_append_cstr(out, " storm(s).")
            if level.stiff > 0.0:
                dstr_append_cstr(out, "  Gates are slow to move.")
            if level.hidden:
                dstr_append_cstr(out, "  No forecast.")
