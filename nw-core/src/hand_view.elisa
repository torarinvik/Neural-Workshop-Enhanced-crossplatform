include "./rooms_view.elisa"

module HandView:
    const WIDTH: f64 = 1000.0
    const HEIGHT: f64 = 640.0
    const VIEW_SCALE: f64 = 389.0 / HEIGHT
    const VIEW_LEFT: f64 = (912.0 - VIEW_SCALE * WIDTH) / 2.0
    const VIEW_BOTTOM: f64 = 179.0
    const PRESS: i64 = 12
    const RELEASE: i64 = 13
    const KEYS: i64 = 14
    const LATCH: f64 = 0.25

    struct Pointer:
        x: mutable f64
        y: mutable f64
        down: mutable bool

    struct Lens:
        camera: RoomsView::Camera
        focal: f64
        cx: f64
        cy: f64

    def clamp(value: f64, low: f64, high: f64) -> f64:
        return low if value < low
        return high if value > high
        return value

    def absolute(value: f64) -> f64:
        return -value if value < 0.0 else value

    def initialize() -> Pointer:
        return Pointer{x: WIDTH / 2.0, y: HEIGHT / 2.0, down: false}

    def place(hand: mutable Pointer&, x: f64, y: f64):
        hand.x <- clamp(x, 0.0, WIDTH)
        hand.y <- clamp(y, 0.0, HEIGHT)

    def move(hand: mutable Pointer&, port: i64):
        return if port < 0 or port >= PRESS
        delta: RoomsView::Point = displacement(port)
        place(hand, hand.x + delta.x, hand.y + delta.y)

    def toward(hand: Pointer&, x: f64, y: f64, tolerance: f64 = 3.0) -> i64:
        dx: f64 = x - hand.x
        dy: f64 = y - hand.y
        ax: f64 = absolute(dx)
        ay: f64 = absolute(dy)
        return -1 if ax <= tolerance and ay <= tolerance
        horizontal: bool = ax >= ay
        direction: i64 = (3 if dx > 0.0 else 2) if horizontal else (0 if dy > 0.0 else 1)
        distance: f64 = (ax if horizontal else ay) + tolerance
        return direction * 3 + (0 if distance >= 80.0 else (1 if distance >= 20.0 else 2))

    def lens(eye: RoomsView::Vec, look: RoomsView::Vec, focal: f64, cx: f64, cy: f64) -> Lens:
        can Abort.Panic:
            forward: RoomsView::Vec = RoomsView::unit(RoomsView::sub(look, eye))
            right: RoomsView::Vec = RoomsView::unit(RoomsView::cross(forward, RoomsView::vec(0.0, 1.0, 0.0)))
            camera: RoomsView::Camera = RoomsView::Camera{eye: eye, forward: forward, right: right,
                up: RoomsView::cross(right, forward)}
            return Lens{camera: camera, focal: focal, cx: cx, cy: cy}

    def see(view: Lens&, point: RoomsView::Vec) -> RoomsView::Vec:
        delta: RoomsView::Vec = RoomsView::sub(point, view.camera.eye)
        depth: f64 = RoomsView::dot(delta, view.camera.forward)
        return RoomsView::vec(0.0, 0.0, depth) if depth < 0.05
        scale: f64 = view.focal / depth
        return RoomsView::vec(view.cx + RoomsView::dot(delta, view.camera.right) * scale,
            view.cy + RoomsView::dot(delta, view.camera.up) * scale, depth)

    struct Intersection:
        valid: bool
        point: RoomsView::Vec

    def displacement(port: i64) -> RoomsView::Point:
        direction: i64 = port / 3
        index: i64 = port % 3
        length: f64 = 80.0 if index == 0 else (20.0 if index == 1 else 5.0)
        dx: f64 = -length if direction == 2 else (length if direction == 3 else 0.0)
        dy: f64 = length if direction == 0 else (-length if direction == 1 else 0.0)
        return RoomsView::Point{x: dx, y: dy}

    def on_plane(view: Lens&, x: f64, y: f64, point: RoomsView::Vec, normal: RoomsView::Vec) -> Intersection:
        can Abort.Panic:
            horizontal: RoomsView::Vec = RoomsView::mul(view.camera.right, (x - view.cx) / view.focal)
            vertical: RoomsView::Vec = RoomsView::mul(view.camera.up, (y - view.cy) / view.focal)
            ray: RoomsView::Vec = RoomsView::unit(RoomsView::add(RoomsView::add(view.camera.forward, horizontal), vertical))
            denominator: f64 = RoomsView::dot(ray, normal)
            return Intersection{valid: false, point: zeroed} if absolute(denominator) < 0.000001
            distance: f64 = RoomsView::dot(RoomsView::sub(point, view.camera.eye), normal) / denominator
            return Intersection{valid: false, point: zeroed} if distance <= 0.0
            return Intersection{valid: true, point: RoomsView::add(view.camera.eye, RoomsView::mul(ray, distance))}
