# The menu screens: one layout, every menu.
#
# The original has exactly one Menu class (neural_workshop/ui/menu.py) and
# every menu screen in the game is an instance of it -- the task menu, the
# N-back mode chooser, sounds, images, user, the options list. So this is not
# "a" menu scene; porting the class ports all of them, and a specific screen
# becomes a list of option strings rather than new layout code.
#
# Measured with scripts/extract_menu.py against the real class rather than read
# off its source, for the same retina reason as the title screen.
#
# One trap worth naming: Menu.build_chrome computes `self.bgcolor` and NOTHING
# EVER READS IT. The background a menu actually shows comes from
# `window.clear()`, i.e. the GL clear colour window.py set from
# BLACK_BACKGROUND -- the same rule as every other screen. Porting `bgcolor`
# because it looks authoritative would invert the menu background on one of the
# two themes.

const MENU_TITLE_SIZE: f64 = 18.0
const MENU_CHOICE_SIZE: f64 = 12.0
const MENU_FOOTNOTE_SIZE: f64 = 12.0

# Rows advance by 3/2 of the choice font, and the block starts at 8/10 of the
# window height. The title sits at 9/10, the footnote 35 above the bottom.
const MENU_ROW_STEP: f64 = MENU_CHOICE_SIZE * 3.0 / 2.0
const MENU_ROWS_TOP: f64 = REFERENCE_HEIGHT * 8.0 / 10.0
const MENU_TITLE_Y: f64 = REFERENCE_HEIGHT * 9.0 / 10.0
const MENU_FOOTNOTE_Y: f64 = 35.0
const MENU_ROW_X: f64 = REFERENCE_WIDTH / 8.0

# The selection marker: a triangle pointing at the highlighted row, its tip at
# w/9 and its base at w/10.
const MENU_MARKER_BASE_X: f64 = REFERENCE_WIDTH / 10.0
const MENU_MARKER_TIP_X: f64 = REFERENCE_WIDTH / 9.0

# `[1] * 3` in the original -- very nearly black, not white. It is invisible on
# the black theme, and that is the original's behaviour, not a porting slip.
def menu_marker_color() -> u32:
    return rgba(1, 1, 1, 255)

def menu_color_background(black_background: bool) -> u32:
    if black_background:
        return rgba(0, 0, 0, 255)
    return rgba(255, 255, 255, 255)

# textcolor = (255 * BLACK_BACKGROUND,)*3 + (255,): the INVERSE of the theme,
# so a menu reads as ink on the window's own paper.
def menu_color_text(black_background: bool) -> u32:
    if black_background:
        return rgba(255, 255, 255, 255)
    return rgba(0, 0, 0, 255)

def menu_default_footnote() -> sview:
    return "Esc: cancel     ← → or Space: modify option     Enter: apply"

# How many rows fit: six tenths of the window divided by the row step, capped
# at the number of options, and never less than one.
def menu_page_size(option_count: i64) -> i64:
    can Abort.Panic:
        room: f64 = (REFERENCE_HEIGHT * 6.0 / 10.0) / MENU_ROW_STEP
        limit: mutable f64 = option_count.f64()
        if room < limit:
            limit <- room
        fitted: i64 = limit.i64()
        if fitted < 1:
            return 1
        return fitted

# The first option shown, for a menu laid out fresh at `selpos` -- which is what
# `relayout` does: reset to the top, then move the selection there in one step.
# Reproduces move_selection's second guard; the first cannot fire from zero.
def menu_scroll_top(selpos: i64, page_size: i64, option_count: i64) -> i64:
    can Abort.Panic:
        if 0 <= selpos - page_size + 1 and 0 != option_count - page_size:
            upper: mutable i64 = selpos + 1
            if option_count < upper:
                upper <- option_count
            top: i64 = upper - page_size + 1
            if top < 0:
                return 0
            return top
        return 0

# `get ... else` rather than a bare index: the row walk below is bounded by the
# same count, so an out-of-range read is a logic error, not a player input --
# and a blank row is a far better failure than a panic mid-frame.
def menu_option_at(options: darray[sview]&, index: i64) -> sview:
    can Abort.Panic:
        return get options[index.usize()] else ""

def menu_row_y(row: i64) -> f64:
    return MENU_ROWS_TOP - row.f64() * MENU_ROW_STEP

# Paint a menu. `options` are the row texts already formatted by the caller --
# the "name: value" column shaping is menu content, not menu layout.
def render_menu_frame(list: mutable DisplayList&, title: sview, footnote: sview, options: darray[sview]&, selpos: i64, black_background: bool):
    can Memory.Allocate, Abort.Panic:
        ink: u32 = menu_color_text(black_background)
        count: i64 = options.count.i64()
        page_size: i64 = menu_page_size(count)
        top: i64 = menu_scroll_top(selpos, page_size, count)

        draw_rect(list, 0.0, 0.0, REFERENCE_WIDTH, REFERENCE_HEIGHT, menu_color_background(black_background))
        draw_text(list, title, REFERENCE_WIDTH / 2.0, MENU_TITLE_Y, MENU_TITLE_SIZE, ink, ANCHOR_CENTER_CENTER)
        draw_text(list, footnote, REFERENCE_WIDTH / 2.0, MENU_FOOTNOTE_Y, MENU_FOOTNOTE_SIZE, ink, ANCHOR_CENTER_CENTER)

        # update_labels, exactly: an ellipsis row stands in for the scrolled-off
        # top, and one for the tail. When the top row is an ellipsis the option
        # UNDER it is not drawn -- the ellipsis takes its slot rather than being
        # inserted before it -- and when the tail does not need one the last row
        # can simply stay empty. Both are load-bearing: they are what makes the
        # row a player is looking at land where the marker points.
        row: mutable i64 = 0
        if top != 0:
            draw_text(list, "...", MENU_ROW_X, menu_row_y(0), MENU_CHOICE_SIZE, ink, ANCHOR_LEFT_CENTER)
            row <- 1
        ending: mutable i64 = 0
        if top + page_size < count:
            ending <- 1
        while row < page_size - ending and row + top < count |row, list, ink, options, top|:
            draw_text(list, menu_option_at(options, row + top), MENU_ROW_X, menu_row_y(row), MENU_CHOICE_SIZE, ink, ANCHOR_LEFT_CENTER)
            row <- row + 1
        if ending == 1:
            draw_text(list, "...", MENU_ROW_X, menu_row_y(row), MENU_CHOICE_SIZE, ink, ANCHOR_LEFT_CENTER)

        # The marker last, over the rows, at the selected row's position.
        marker_y: f64 = menu_row_y(selpos - top)
        begin_polygon(list, 3, menu_marker_color())
        polygon_point(list, MENU_MARKER_BASE_X, marker_y + MENU_CHOICE_SIZE / 2.0)
        polygon_point(list, MENU_MARKER_TIP_X, marker_y)
        polygon_point(list, MENU_MARKER_BASE_X, marker_y - MENU_CHOICE_SIZE / 2.0)

        emit_marker(list, "frame-end")
