# The menu screens: one layout, every menu.
#
# The original has exactly one Menu class (neural_workshop/ui/menu.py) and
# every menu screen in the game is an instance of it -- the task menu, the
# N-back mode chooser, sounds, images, user, the options list. So this is not
# "a" menu scene; porting the class ports all of them, and a specific screen
# becomes a list of option strings rather than new layout code.
#
# Measured with scripts/extract_menu.py against the real class rather than read
# off its source, for the same retina reason as the title screen.
#
# One trap worth naming: Menu.build_chrome computes `self.bgcolor` and NOTHING
# EVER READS IT. The background a menu actually shows comes from
# `window.clear()`, i.e. the GL clear colour window.py set from
# BLACK_BACKGROUND -- the same rule as every other screen. Porting `bgcolor`
# because it looks authoritative would invert the menu background on one of the
# two themes.

const MENU_TITLE_SIZE: f64 = 18.0
const MENU_CHOICE_SIZE: f64 = 12.0
const MENU_FOOTNOTE_SIZE: f64 = 12.0

# Rows advance by 3/2 of the choice font, and the block starts at 8/10 of the
# window height. The title sits at 9/10, the footnote 35 above the bottom.
const MENU_ROW_STEP: f64 = MENU_CHOICE_SIZE * 3.0 / 2.0
const MENU_ROWS_TOP: f64 = Display::REFERENCE_HEIGHT * 8.0 / 10.0
const MENU_TITLE_Y: f64 = Display::REFERENCE_HEIGHT * 9.0 / 10.0
const MENU_FOOTNOTE_Y: f64 = 35.0
const MENU_ROW_X: f64 = Display::REFERENCE_WIDTH / 8.0

# The selection marker: a triangle pointing at the highlighted row, its tip at
# w/9 and its base at w/10.
const MENU_MARKER_BASE_X: f64 = Display::REFERENCE_WIDTH / 10.0
const MENU_MARKER_TIP_X: f64 = Display::REFERENCE_WIDTH / 9.0

# `[1] * 3` in the original -- very nearly black, not white. It is invisible on
# the black theme, and that is the original's behaviour, not a porting slip.
def menu_marker_color() -> u32:
    return Display::rgba(1, 1, 1, 255)

def menu_color_background(black_background: bool) -> u32:
    if black_background:
        return Display::rgba(0, 0, 0, 255)
    return Display::rgba(255, 255, 255, 255)

# textcolor = (255 * BLACK_BACKGROUND,)*3 + (255,): the INVERSE of the theme,
# so a menu reads as ink on the window's own paper.
def menu_color_text(black_background: bool) -> u32:
    if black_background:
        return Display::rgba(255, 255, 255, 255)
    return Display::rgba(0, 0, 0, 255)

def menu_default_footnote() -> sview:
    return "Esc: cancel     ← → or Space: modify option     Enter: apply"

# How many rows fit: six tenths of the window divided by the row step, capped
# at the number of options, and never less than one.
def menu_page_size(option_count: i64) -> i64:
    can Abort.Panic:
        room: f64 = (Display::REFERENCE_HEIGHT * 6.0 / 10.0) / MENU_ROW_STEP
        limit: mutable f64 = option_count.f64()
        if room < limit:
            limit <- room
        fitted: i64 = limit.i64()
        if fitted < 1:
            return 1
        return fitted

# `get ... else` rather than a bare index: the row walk below is bounded by the
# same count, so an out-of-range read is a logic error, not a player input --
# and a blank row is a far better failure than a panic mid-frame.
def menu_option_at(options: darray[sview]&, index: i64) -> sview:
    can Abort.Panic:
        return get options[index.usize()] else ""

# Where a menu laid out fresh at `requested` actually settles. `relayout` resets
# to the top and then moves the selection there in one step, and move_selection
# does three things in order: clamp, scroll, and -- this is the part that is easy
# to miss -- STEP OFF a spacer row and start again.
#
# The skip is why this returns both numbers instead of just the scroll offset.
# Asking for a spacer does not leave the selection on it: the original walks on
# in the direction of travel, and the scroll guards then run again for the new
# row. Requesting row 20 of a 24-row menu with spacers settles on row 21 AND
# scrolls to 1, and no amount of reasoning about row 20 predicts that.
#
# The first and last rows are exempt from the skip even when they are spacers,
# which is the original's own guard: there is nowhere further to walk.
struct MenuLayout:
    selpos: i64
    top: i64

def menu_is_spacer(text: sview) -> bool:
    can Abort.Panic:
        return sview_len(text) == 0.usize()

def menu_layout(requested: i64, page_size: i64, options: darray[sview]&) -> MenuLayout:
    can Abort.Panic:
        count: i64 = options.count.i64()
        if count <= 0:
            return MenuLayout{selpos: 0, top: 0}

        # The recursive call passes `1 if steps > 0 else -1`, and `steps` on the
        # first call is the requested index itself.
        direction: mutable i64 = -1
        if requested > 0:
            direction <- 1

        sel: mutable i64 = requested
        if sel > count - 1:
            sel <- count - 1
        if sel < 0:
            sel <- 0

        top: mutable i64 = 0
        # Bounded by the row count: each pass either settles or steps one row.
        guard: mutable i64 = 0
        while guard <= count |guard, sel, top, count, page_size, options, direction|:
            guard <- guard + 1
            if top >= sel and top != 0:
                top <- sel - 1
                if top < 0:
                    top <- 0
            if top <= sel - page_size + 1 and top != count - page_size:
                upper: mutable i64 = sel + 1
                if count < upper:
                    upper <- count
                moved: i64 = upper - page_size + 1
                top <- moved
                if top < 0:
                    top <- 0
            if sel == 0 or sel == count - 1:
                break
            if not menu_is_spacer(menu_option_at(options, sel)):
                break
            sel <- sel + direction
            if sel > count - 1:
                sel <- count - 1
            if sel < 0:
                sel <- 0
        return MenuLayout{selpos: sel, top: top}

def menu_row_y(row: i64) -> f64:
    return MENU_ROWS_TOP - row.f64() * MENU_ROW_STEP

# Paint a menu. `options` are the row texts already formatted by the caller --
# the "name: value" column shaping is menu content, not menu layout.
def render_menu_frame(list: mutable Display::DisplayList&, title: sview, footnote: sview, options: darray[sview]&, selpos: i64, black_background: bool):
    can Memory.Allocate, Abort.Panic:
        ink: u32 = menu_color_text(black_background)
        count: i64 = options.count.i64()
        page_size: i64 = menu_page_size(count)
        settled: MenuLayout = menu_layout(selpos, page_size, options)
        top: i64 = settled.top

        Display::draw_rect(list, 0.0, 0.0, Display::REFERENCE_WIDTH, Display::REFERENCE_HEIGHT, menu_color_background(black_background))
        Display::draw_text(list, title, Display::REFERENCE_WIDTH / 2.0, MENU_TITLE_Y, MENU_TITLE_SIZE, ink, Display::ANCHOR_CENTER_CENTER)
        Display::draw_text(list, footnote, Display::REFERENCE_WIDTH / 2.0, MENU_FOOTNOTE_Y, MENU_FOOTNOTE_SIZE, ink, Display::ANCHOR_CENTER_CENTER)

        # update_labels, exactly: an ellipsis row stands in for the scrolled-off
        # top, and one for the tail. When the top row is an ellipsis the option
        # UNDER it is not drawn -- the ellipsis takes its slot rather than being
        # inserted before it -- and when the tail does not need one the last row
        # can simply stay empty. Both are load-bearing: they are what makes the
        # row a player is looking at land where the marker points.
        row: mutable i64 = 0
        if top != 0:
            Display::draw_text(list, "...", MENU_ROW_X, menu_row_y(0), MENU_CHOICE_SIZE, ink, Display::ANCHOR_LEFT_CENTER)
            row <- 1
        ending: mutable i64 = 0
        if top + page_size < count:
            ending <- 1
        # A spacer row (the original's BLANK_LINE) still CONSUMES a slot -- the
        # rows below it keep their positions -- but nothing is drawn for it. The
        # original sets the label's text to "" and pyglet draws nothing; here the
        # command is simply not emitted, which is the same picture and one fewer
        # thing for four shells to no-op on.
        while row < page_size - ending and row + top < count |row, list, ink, options, top|:
            text: sview = menu_option_at(options, row + top)
            if sview_len(text) > 0.usize():
                Display::draw_text(list, text, MENU_ROW_X, menu_row_y(row), MENU_CHOICE_SIZE, ink, Display::ANCHOR_LEFT_CENTER)
            row <- row + 1
        if ending == 1:
            Display::draw_text(list, "...", MENU_ROW_X, menu_row_y(row), MENU_CHOICE_SIZE, ink, Display::ANCHOR_LEFT_CENTER)

        # The marker last, over the rows, at the selected row's position.
        marker_y: f64 = menu_row_y(settled.selpos - top)
        Display::begin_polygon(list, 3, MENU_MARKER_BASE_X, marker_y + MENU_CHOICE_SIZE / 2.0, menu_marker_color())
        Display::polygon_point(list, MENU_MARKER_BASE_X, marker_y + MENU_CHOICE_SIZE / 2.0)
        Display::polygon_point(list, MENU_MARKER_TIP_X, marker_y)
        Display::polygon_point(list, MENU_MARKER_BASE_X, marker_y - MENU_CHOICE_SIZE / 2.0)

        Display::emit_marker(list, "frame-end")
