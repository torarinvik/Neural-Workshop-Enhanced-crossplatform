# The board the stimuli appear on, and one stimulus on it.
#
# Port of neural_workshop/ui/field.py -- Field's grid and crosshair, the 3D
# cube stage's own frame, and Visual's flat square, sprite and glyph.
#
# The FIELD is a square five eighths of the window's height -- 0.85 of it when
# the board is expanded -- centred twenty above the middle, or dead centre when
# expanded. Cells come off board.elisa's own layout, so a cell is where the
# model says it is and not where a second arithmetic here would put it.
#
# The grid is ruled and NOT boxed: `range(1, n)`, so the outer edges carry no
# line. The CROSSHAIR is shown only when crosshairs are on, the board is not
# 3D, the game is not paused, `position1` is played, and variable N-Back is
# off -- four conditions, all of them the reference's, because a crosshair in
# variable mode would mark a centre the stimuli do not use.
#
# The six-faced perspective cubes are here too, at the bottom -- they were very
# nearly left to a shell on the grounds that they are stimulus art, and that
# was wrong: they are forty polygons and lines of ordinary arithmetic, so a
# shell owning them would be a shell owning a picture the core can describe.
# The GLOW that eases in over 0.24s is not here, because it is a clock.
#
# NOTE: needs elisacore_math, geometry, board and display included first.

module SceneField:

    def grid_color(black_background: bool) -> u32:
        return Display::rgba(64, 64, 64, 255) if black_background else Display::rgba(192, 192, 192, 255)

    def room_color(black_background: bool) -> u32:
        return Display::rgba(0, 0, 0, 255) if black_background else Display::rgba(7, 11, 20, 255)

    struct Paint:
        grid: mutable u32
        black: mutable bool
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> Paint:
        return Paint{grid: grid_color(black_background),
                     black: black_background,
                     width: width, height: height, sx: sx, sy: sy}

    struct Field:
        size: mutable f64
        centre_x: mutable f64
        centre_y: mutable f64
        left: mutable f64
        bottom: mutable f64
        right: mutable f64
        top: mutable f64

    # `int(window.height * (0.85 if expanded else 0.625))`. x1..y2 are each
    # rounded from the CENTRE, not derived from one another -- which for an
    # integer size is the same number, but says what the reference says.
    def field_of(width: f64, height: f64, expanded: bool) -> Field:
        can Abort.Panic:
            size: f64 = (height * (0.85 if expanded else 0.625)).i64().f64()
            centre_x: f64 = Geometry::width_center(width).f64()
            centre_y: f64 = Geometry::height_center(height).f64() if expanded else Geometry::from_height_center(height, 20.0).f64()
            return Field{size: size, centre_x: centre_x, centre_y: centre_y,
                         left: (centre_x - size / 2.0).i64().f64(),
                         bottom: (centre_y - size / 2.0).i64().f64(),
                         right: (centre_x + size / 2.0).i64().f64(),
                         top: (centre_y + size / 2.0).i64().f64()}

    def put_line(list: mutable Display::DisplayList&, paint: Paint&,
                 x1: f64, y1: f64, x2: f64, y2: f64, thickness: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_line(list, x1 / paint.sx, y1 / paint.sy,
                               x2 / paint.sx, y2 / paint.sy,
                               thickness / paint.sx, color)

    # One vertical and one horizontal line at every interior division, in that
    # order, division by division.
    def put_grid(list: mutable Display::DisplayList&, paint: Paint&,
                 field: Field&, n: i64):
        can Memory.Allocate, Abort.Panic:
            for index in 1..<n |list, paint, field, n|:
                share: f64 = index.f64() / n.f64()
                x: f64 = py_round_half_even(field.left + field.size * share).f64()
                y: f64 = py_round_half_even(field.bottom + field.size * share).f64()
                put_line(list, paint, x, field.bottom, x, field.top, 1.0, paint.grid)
                put_line(list, paint, field.left, y, field.right, y, 1.0, paint.grid)

    def put_ring(list: mutable Display::DisplayList&, paint: Paint&,
                 field: Field&, offset: f64, thickness: f64, alpha: i64):
        can Memory.Allocate, Abort.Panic:
            shade: u32 = Display::rgba(105, 135, 175, alpha)
            x1: f64 = field.left + offset
            y1: f64 = field.bottom + offset
            x2: f64 = field.right - offset
            y2: f64 = field.top - offset
            put_line(list, paint, x1, y1, x2, y1, thickness, shade)
            put_line(list, paint, x2, y1, x2, y2, thickness, shade)
            put_line(list, paint, x2, y2, x1, y2, thickness, shade)
            put_line(list, paint, x1, y2, x1, y1, thickness, shade)

    # The 3D stage: a dark room, then a DOUBLE frame -- two rings at different
    # insets, widths and alphas, which is what groups every cube into one
    # matchable pattern rather than six separate things.
    def put_cube_stage(list: mutable Display::DisplayList&, paint: Paint&,
                       field: Field&):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, field.left / paint.sx,
                               field.bottom / paint.sy,
                               field.size / paint.sx, field.size / paint.sy,
                               room_color(paint.black))
            wanted: i64 = (field.size * 0.015).i64()
            inset: i64 = wanted if wanted > 5 else 5
            put_ring(list, paint, field, 0.0, 3.0, 220)
            put_ring(list, paint, field, inset.f64(), 1.0, 100)

    # A small cross at the field's centre, one `scale_to_height(8)` arm each way.
    def put_crosshair(list: mutable Display::DisplayList&, paint: Paint&,
                      field: Field&):
        can Memory.Allocate, Abort.Panic:
            arm: f64 = Geometry::scale_to_height(paint.height, 8.0).f64()
            put_line(list, paint, field.centre_x - arm, field.centre_y,
                     field.centre_x + arm, field.centre_y, 1.0, paint.grid)
            put_line(list, paint, field.centre_x, field.centre_y - arm,
                     field.centre_x, field.centre_y + arm, 1.0, paint.grid)

    def crosshair_wanted(crosshairs: bool, grid_3d: bool, paused: bool,
                         has_position: bool, variable: bool) -> bool:
        return crosshairs and not grid_3d and not paused and has_position and not variable

    def cell_px(field: Field&, n: i64) -> f64:
        return field.size / n.f64()

    struct Point:
        x: mutable i64
        y: mutable i64

    # Pixel centre of a stimulus. A 3D board, and any position with no cell of
    # its own, sit at the field's own centre.
    def centre_of(field: Field&, n: i64, include_center: bool, grid_3d: bool,
                  position: i64) -> Point:
        can Memory.Allocate, Abort.Panic:
            middle: Point = Point{x: field.centre_x.i64(), y: field.centre_y.i64()}
            middle return if grid_3d
            cell: Cell = position_cell(position, n, include_center)
            middle return if cell.pid == 0
            step: f64 = cell_px(field, n)
            return Point{x: py_round_half_even(field.centre_x - field.size / 2.0 + step * (cell.col.f64() + 0.5)),
                         y: py_round_half_even(field.centre_y - field.size / 2.0 + step * (cell.row.f64() + 0.5))}

    # A stimulus's own side: the cell, less a sixteenth when the squares
    # animate or are drawn in the old flat style, and never under four pixels.
    def stimulus_size(field: Field&, n: i64, shrunk: bool) -> i64:
        wanted: i64 = (cell_px(field, n) * (0.9375 if shrunk else 1.0)).i64()
        return wanted if wanted > 4 else 4

    # The glyph face is a share of the CELL, not of the stimulus, and never
    # under eight.
    def glyph_size(field: Field&, n: i64) -> i64:
        wanted: i64 = (cell_px(field, n) * 0.45).i64()
        return wanted if wanted > 8 else 8

    # `_rounded_rect_vertices_py`: forty vertices, ten degrees apart, corner by
    # corner. `int()` truncates a non-negative product, so it floors.
    def rounded_x(index: i64, lx: i64, rx: i64, cr: i64) -> i64:
        can Abort.Panic:
            quarter: i64 = index / 10
            step: i64 = index % 10
            degrees: f64 = (step * 10).f64() if quarter == 0 or quarter == 1 else (90 - step * 10).f64()
            turn: f64 = degrees_to_radians(degrees)
            if quarter == 0 or quarter == 3:
                return lx + (cr.f64() * (1.0 - cos(turn))).i64()
            return rx - (cr.f64() * (1.0 - sin(turn))).i64()

    def rounded_y(index: i64, by: i64, ty: i64, cr: i64) -> i64:
        can Abort.Panic:
            half: i64 = index % 20
            degrees: f64 = (half * 10).f64() if half < 10 else (90 - (half - 10) * 10).f64()
            turn: f64 = degrees_to_radians(degrees)
            drop: i64 = (cr.f64() * (1.0 - sin(turn))).i64()
            return by + drop if index < 20 else ty - drop

    # The flat square of the Jaeggi layout, two pixels in from the stimulus on
    # every side -- sharp-cornered, or a forty-vertex rounded rectangle whose
    # corner radius is a fifth of the stimulus.
    def put_old_style_square(list: mutable Display::DisplayList&, paint: Paint&,
                             centre_x: i64, centre_y: i64, size: i64,
                             sharp: bool, color: u32):
        can Memory.Allocate, Abort.Panic:
            lx: i64 = centre_x - size / 2 + 2
            rx: i64 = centre_x + size / 2 - 2
            by: i64 = centre_y - size / 2 + 2
            ty: i64 = centre_y + size / 2 - 2
            if sharp:
                Display::begin_polygon(list, 4, lx.f64() / paint.sx, by.f64() / paint.sy, color)
                Display::polygon_point(list, lx.f64() / paint.sx, by.f64() / paint.sy)
                Display::polygon_point(list, rx.f64() / paint.sx, by.f64() / paint.sy)
                Display::polygon_point(list, rx.f64() / paint.sx, ty.f64() / paint.sy)
                Display::polygon_point(list, lx.f64() / paint.sx, ty.f64() / paint.sy)
                return
            cr: i64 = size / 5
            Display::begin_polygon(list, 40, rounded_x(0, lx, rx, cr).f64() / paint.sx,
                                   rounded_y(0, by, ty, cr).f64() / paint.sy, color)
            for index in 0..<40 |list, paint, lx, rx, by, ty, cr|:
                Display::polygon_point(list, rounded_x(index, lx, rx, cr).f64() / paint.sx,
                                       rounded_y(index, by, ty, cr).f64() / paint.sy)

    # A sprite stimulus: placed by its BOTTOM-LEFT corner, scaled so its width
    # is the stimulus size.
    def put_sprite(list: mutable Display::DisplayList&, paint: Paint&,
                   asset: i64, image_width: i64, image_height: i64,
                   centre_x: i64, centre_y: i64, size: i64, color: u32):
        can Memory.Allocate, Abort.Panic:
            wide: i64 = image_width if image_width > 1 else 1
            Display::draw_sprite(list, asset.u32(),
                                 (centre_x - size / 2).f64() / paint.sx,
                                 (centre_y - size / 2).f64() / paint.sy,
                                 size.f64() / wide.f64() / paint.sx, 0.0,
                                 image_width, image_height, color)

    # A letter or a number in the cell, lifted FOUR PIXELS -- a fixed nudge
    # that does not scale, because it corrects the face's own baseline rather
    # than a share of anything.
    def put_glyph(list: mutable Display::DisplayList&, paint: Paint&,
                  text: sview, centre_x: i64, centre_y: i64,
                  field: Field&, n: i64, color: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, centre_x.f64() / paint.sx,
                                      (centre_y + 4).f64() / paint.sy,
                                      glyph_size(field, n).f64() / paint.sy,
                                      color, Display::ANCHOR_CENTER_CENTER, true)

    # The variable-N label sits at the field's centre when position is played,
    # and a whole cell lower when it is not -- so it does not land on top of
    # the square it is describing.
    def put_variable(list: mutable Display::DisplayList&, paint: Paint&,
                     text: sview, field: Field&, n: i64, has_position: bool,
                     color: u32):
        can Memory.Allocate, Abort.Panic:
            y: i64 = field.centre_y.i64() + 4 if has_position else field.centre_y.i64() - cell_px(field, n).i64() + 4
            Display::draw_text_weight(list, text, field.centre_x / paint.sx,
                                      y.f64() / paint.sy,
                                      glyph_size(field, n).f64() / paint.sy,
                                      color, Display::ANCHOR_CENTER_CENTER, true)

    # ------------------------------------------------------------
    # The 3D pattern: six-faced perspective cubes on the stage above
    # ------------------------------------------------------------
    #
    # One cube is a square ring seen from slightly off-centre: an OUTER square,
    # an INSIDE square pushed a little right and up, and the four trapezia
    # between them. Five and six are the plane across the opening and the
    # recessed back, and their very different projected sizes are what stop a
    # front face and a back face reading as the same picture.
    #
    # The active face is drawn in three layers -- a wash, an inset fill and a
    # smaller specular -- while every other face is a single flat colour. That
    # is what makes one face unmistakable without moving any geometry, which
    # matters because the pattern has to be recognisable at a glance and must
    # not shift between trials.
    #
    # `int()` in `_lit` truncates a product that is never negative, so it
    # floors; face 5's shade of 1.06 can push a channel over 255, which is why
    # the clamp is there and not decoration.

    struct Pt:
        x: mutable f64
        y: mutable f64

    def face_light(index: i64) -> f64:
        return 0.18 if index == 0 else (0.10 if index == 1 else (0.04 if index == 2 else (0.12 if index == 3 else (0.22 if index == 4 else 0.08))))

    def face_shade(index: i64) -> f64:
        return 1.00 if index == 0 else (0.82 if index == 1 else (0.64 if index == 2 else (0.88 if index == 3 else (1.06 if index == 4 else 0.56))))

    def inactive_color(index: i64) -> u32:
        return Display::rgba(31, 47, 72, 255) if index == 0 else (Display::rgba(24, 38, 61, 255) if index == 1 else (Display::rgba(16, 28, 47, 255) if index == 2 else Display::rgba(27, 42, 65, 255)))

    # `min(255, int(c + (255 - c) * amount))` lifted, then `max(0, min(255,
    # int(c * shade)))` shaded. Two truncations, not one.
    def lit_channel(channel: i64, amount: f64, shade: f64) -> i64:
        lifted: i64 = (channel.f64() + (255 - channel).f64() * amount).i64()
        capped: i64 = lifted if lifted < 255 else 255
        shaded: i64 = (capped.f64() * shade).i64()
        return 0 if shaded < 0 else (255 if shaded > 255 else shaded)

    struct Lit:
        r: mutable i64
        g: mutable i64
        b: mutable i64

    def lit_of(base: Rgba&, amount: f64, shade: f64) -> Lit:
        return Lit{r: lit_channel(base.r, amount, shade),
                   g: lit_channel(base.g, amount, shade),
                   b: lit_channel(base.b, amount, shade)}

    def lit_rgba(shade: Lit&, alpha: i64) -> u32:
        return Display::rgba(shade.r, shade.g, shade.b, alpha)

    # grid.decode_3d_pattern / decode_3d_colors: a 1-based id read off as
    # digits, base six for the faces and base eight for the colours, least
    # significant cube first.
    def pattern_face(position: i64, index: i64) -> i64:
        value: mutable i64 = position - 1 if position > 1 else 0
        for _step in 0..<index |value|:
            value <- value / 6
        return value % 6

    def pattern_color(color: i64, index: i64) -> i64:
        value: mutable i64 = color - 1 if color > 1 else 0
        for _step in 0..<index |value|:
            value <- value / 8
        return value % 8 + 1

    def put_quad(list: mutable Display::DisplayList&, paint: Paint&,
                 quad: darray[Pt]&, color: u32):
        can Memory.Allocate, Abort.Panic:
            first: Pt = get quad[0.usize()] else Pt{x: 0.0, y: 0.0}
            Display::begin_polygon(list, 4, first.x / paint.sx, first.y / paint.sy, color)
            for step in 0..<4 |list, paint, quad|:
                point: Pt = get quad[step.usize()] else Pt{x: 0.0, y: 0.0}
                Display::polygon_point(list, point.x / paint.sx, point.y / paint.sy)

    # Every point pulled `amount` of the way towards the quad's own centre.
    def inset_quad(quad: darray[Pt]&, amount: f64) -> darray[Pt]:
        can Memory.Allocate, Abort.Panic:
            sum_x: mutable f64 = 0.0
            sum_y: mutable f64 = 0.0
            for step in 0..<4 |quad, sum_x, sum_y|:
                point: Pt = get quad[step.usize()] else Pt{x: 0.0, y: 0.0}
                sum_x <- sum_x + point.x
                sum_y <- sum_y + point.y
            middle_x: f64 = sum_x / 4.0
            middle_y: f64 = sum_y / 4.0
            out: mutable darray[Pt] = []
            for step in 0..<4 |quad, out, middle_x, middle_y, amount|:
                point: Pt = get quad[step.usize()] else Pt{x: 0.0, y: 0.0}
                out.push(Pt{x: point.x + (middle_x - point.x) * amount,
                            y: point.y + (middle_y - point.y) * amount})
            return out

    def quad_of(a: Pt, b: Pt, c: Pt, d: Pt) -> darray[Pt]:
        can Memory.Allocate:
            out: mutable darray[Pt] = []
            out.push(a)
            out.push(b)
            out.push(c)
            out.push(d)
            return out

    # The four segments around a quad, closed.
    def put_quad_edges(list: mutable Display::DisplayList&, paint: Paint&,
                       quad: darray[Pt]&, thickness: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            for step in 0..<4 |list, paint, quad, thickness, color|:
                one: Pt = get quad[step.usize()] else Pt{x: 0.0, y: 0.0}
                two: Pt = get quad[((step + 1) % 4).usize()] else Pt{x: 0.0, y: 0.0}
                put_line(list, paint, one.x, one.y, two.x, two.y, thickness, color)

    # One cube. `highlighted` is the lit face, 0..5, or -1 for the whole thing
    # lit -- which is what a colour-only pattern draws.
    def put_pattern_cube(list: mutable Display::DisplayList&, paint: Paint&,
                         cx: f64, cy: f64, size: f64, highlighted: i64,
                         color_id: i64):
        can Memory.Allocate, Abort.Panic:
            half: f64 = size * 0.43
            inner: f64 = size * 0.17
            # A small offset avoids sterile symmetry and strengthens perspective.
            ix: f64 = size * 0.025
            iy: f64 = size * 0.035
            o0: Pt = Pt{x: cx - half, y: cy + half}
            o1: Pt = Pt{x: cx + half, y: cy + half}
            o2: Pt = Pt{x: cx + half, y: cy - half}
            o3: Pt = Pt{x: cx - half, y: cy - half}
            i0: Pt = Pt{x: cx - inner + ix, y: cy + inner + iy}
            i1: Pt = Pt{x: cx + inner + ix, y: cy + inner + iy}
            i2: Pt = Pt{x: cx + inner + ix, y: cy - inner + iy}
            i3: Pt = Pt{x: cx - inner + ix, y: cy - inner + iy}
            outer: darray[Pt] = quad_of(o0, o1, o2, o3)
            inside: darray[Pt] = quad_of(i0, i1, i2, i3)
            base: Rgba = get_3d_color(color_id)
            lit: Lit = lit_of(&base, 0.16, 1.0) if highlighted < 0 else lit_of(&base, face_light(highlighted), face_shade(highlighted))

            # Shadow grounds each cube without obscuring neighbouring tiles.
            Display::draw_rect(list, (cx - half + size * 0.025) / paint.sx,
                               (cy - half - size * 0.035) / paint.sy,
                               half * 2.0 / paint.sx, half * 2.0 / paint.sy,
                               Display::rgba(0, 0, 0, 95))

            for index in 0..<4 |list, paint, outer, inside, base, lit, highlighted|:
                side: darray[Pt] = face_quad(&outer, &inside, index)
                if highlighted < 0 or index == highlighted:
                    face_lit: Lit = lit_of(&base, face_light(index), face_shade(index)) if highlighted < 0 else lit
                    put_quad(list, paint, &side, lit_rgba(&face_lit, 105))
                    fill: darray[Pt] = inset_quad(&side, 0.07)
                    put_quad(list, paint, &fill, lit_rgba(&face_lit, 245))
                    bright: Lit = Lit{r: face_lit.r + 12 if face_lit.r + 12 < 255 else 255,
                                      g: face_lit.g + 12 if face_lit.g + 12 < 255 else 255,
                                      b: face_lit.b + 12 if face_lit.b + 12 < 255 else 255}
                    specular: darray[Pt] = inset_quad(&side, 0.16)
                    put_quad(list, paint, &specular, lit_rgba(&bright, 70))
                else:
                    put_quad(list, paint, &side, inactive_color(index))

            # Back is the recessed square; front is a translucent plane across
            # the opening.
            if highlighted < 0 or highlighted == 5:
                back_lit: Lit = lit_of(&base, face_light(5), face_shade(5)) if highlighted < 0 else lit
                put_quad(list, paint, &inside, lit_rgba(&back_lit, 120))
                back_fill: darray[Pt] = inset_quad(&inside, 0.08)
                put_quad(list, paint, &back_fill, lit_rgba(&back_lit, 250))
            else:
                put_quad(list, paint, &inside, Display::rgba(5, 9, 17, 255))

            if highlighted < 0 or highlighted == 4:
                front_lit: Lit = lit_of(&base, face_light(4), face_shade(4)) if highlighted < 0 else lit
                put_quad(list, paint, &outer, lit_rgba(&front_lit, 40))
                glass: darray[Pt] = inset_quad(&outer, 0.045)
                put_quad(list, paint, &glass, lit_rgba(&front_lit, 70))

            edge: u32 = Display::rgba(225, 238, 255, 255)
            inner_edge: u32 = Display::rgba(145, 175, 210, 235)
            put_quad_edges(list, paint, &outer, thick_at_least(3.0, size * 0.018), edge)
            put_quad_edges(list, paint, &inside, thick_at_least(2.0, size * 0.012), inner_edge)
            # The four struts, each joining a corner of the opening to the
            # matching corner of the back.
            for step in 0..<4 |list, paint, outer, inside, size|:
                one: Pt = get outer[step.usize()] else Pt{x: 0.0, y: 0.0}
                two: Pt = get inside[step.usize()] else Pt{x: 0.0, y: 0.0}
                put_line(list, paint, one.x, one.y, two.x, two.y,
                         thick_at_least(1.5, size * 0.008), inner_edge)

            active: darray[Pt] = outer if highlighted < 0 or highlighted == 4 else (inside if highlighted == 5 else face_quad(&outer, &inside, highlighted))
            put_quad_edges(list, paint, &active, thick_at_least(4.0, size * 0.024),
                           Display::rgba(255, 255, 255, 255))

    def thick_at_least(floor: f64, wanted: f64) -> f64:
        return floor if floor > wanted else wanted

    # The four trapezia, in the reference's own winding: the top and right run
    # outer-outer-inside-inside, the bottom and left run the other way about.
    def face_quad(outer: darray[Pt]&, inside: darray[Pt]&, index: i64) -> darray[Pt]:
        can Memory.Allocate, Abort.Panic:
            o0: Pt = get outer[0.usize()] else Pt{x: 0.0, y: 0.0}
            o1: Pt = get outer[1.usize()] else Pt{x: 0.0, y: 0.0}
            o2: Pt = get outer[2.usize()] else Pt{x: 0.0, y: 0.0}
            o3: Pt = get outer[3.usize()] else Pt{x: 0.0, y: 0.0}
            i0: Pt = get inside[0.usize()] else Pt{x: 0.0, y: 0.0}
            i1: Pt = get inside[1.usize()] else Pt{x: 0.0, y: 0.0}
            i2: Pt = get inside[2.usize()] else Pt{x: 0.0, y: 0.0}
            i3: Pt = get inside[3.usize()] else Pt{x: 0.0, y: 0.0}
            quad_of(o0, o1, i1, i0) return if index == 0
            quad_of(o1, o2, i2, i1) return if index == 1
            quad_of(o3, i3, i2, o2) return if index == 2
            return quad_of(o0, i0, i3, o3)

    # The whole pattern: `count` cubes on a square-ish grid inside the stage,
    # with the last row centred when it is short. A position of zero or less
    # lights every face, which is what a COLOUR-only pattern looks like.
    def put_3d_pattern(list: mutable Display::DisplayList&, paint: Paint&,
                       field: Field&, position: i64, color_id: i64, count: i64):
        can Memory.Allocate, Abort.Panic:
            cubes: i64 = count if count > 1 else 1
            color_only: bool = position <= 0
            cols: i64 = ceil(sqrt(cubes.f64())).i64()
            rows: i64 = ceil(cubes.f64() / cols.f64()).i64()
            wanted: i64 = (field.size * 0.035).i64()
            gap: f64 = (wanted if wanted > 10 else 10).f64()
            usable: f64 = field.size - gap * 2.0
            wide: f64 = (usable - gap * (cols - 1).f64()) / cols.f64()
            high: f64 = (usable - gap * (rows - 1).f64()) / rows.f64()
            tile: f64 = wide if wide < high else high
            total_w: f64 = cols.f64() * tile + (cols - 1).f64() * gap
            total_h: f64 = rows.f64() * tile + (rows - 1).f64() * gap
            start_x: f64 = field.centre_x - total_w / 2.0
            start_y: f64 = field.centre_y + total_h / 2.0
            for index in 0..<cubes |list, paint, cubes, cols, gap, tile, start_x, start_y, color_only, position, color_id|:
                row: i64 = index / cols
                col: i64 = index % cols
                # Centre the final incomplete row.
                left_in_row: i64 = cubes - row * cols
                row_count: i64 = cols if cols < left_in_row else left_in_row
                row_offset: f64 = (cols - row_count).f64() * (tile + gap) / 2.0
                cx: f64 = start_x + row_offset + col.f64() * (tile + gap) + tile / 2.0
                cy: f64 = start_y - row.f64() * (tile + gap) - tile / 2.0
                put_pattern_cube(list, paint, cx, cy, tile,
                                 -1 if color_only else pattern_face(position, index),
                                 pattern_color(color_id, index))
