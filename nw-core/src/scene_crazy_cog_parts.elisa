include "./scene_hand.elisa"
include "./tasks/crazy_cog_game.elisa"

module SceneCrazyCog:
    const PI: f64 = 3.141592653589793

    struct Plane:
        scale: f64
        x: f64
        y: f64
        alpha: i64

    def depth(run: CrazyCog::Run&, z: i64) -> Plane:
        d: i64 = z - run.layer
        k: f64 = pow(0.84, d.f64()) if d >= 0 else 1.0 - 0.05 * d.f64()
        alpha: i64 = 255 if d == 0 or run.machine.level.layers == 1 else (40 if d < 0 else CrazyCog::max_i(80, 200 - 40 * d))
        return Plane{scale: k, x: 640.0 * (1.0 - k), y: 470.0 * (1.0 - k), alpha: alpha}

    def point(x: f64, y: f64) -> RoomsView::Vec:
        return RoomsView::Vec{x: x, y: y, z: 1.0}

    def at(p: Plane, x: f64, y: f64) -> RoomsView::Vec:
        return point(p.x + p.scale * x, p.y + p.scale * y)

    def polar(p: RoomsView::Vec, radius: f64, turn: f64) -> RoomsView::Vec:
        return point(p.x + radius * cos(turn), p.y + radius * sin(turn))

    def opacity(color: u32, alpha: i64) -> u32:
        return (color & 0xffffff00.u32()) | alpha.u32()

    def rect(list: mutable Display::DisplayList&, p: RoomsView::Vec, w: f64, h: f64, color: u32):
        can Abort.Panic, Memory.Allocate:
            x: f64 = fmax(0.0, p.x)
            y: f64 = fmax(0.0, p.y)
            width: f64 = fmin(1000.0, p.x + w) - x
            height: f64 = fmin(640.0, p.y + h) - y
            if width > 0.0 and height > 0.0:
                Display::draw_rect(list, SceneHand::x(x), SceneHand::y(y), width * SceneHand::SCALE, height * SceneHand::SCALE, color)

    def disc(list: mutable Display::DisplayList&, p: RoomsView::Vec, r: f64, color: u32):
        can Abort.Panic, Memory.Allocate:
            if p.x - r >= 0.0 and p.x + r <= 1000.0 and p.y - r >= 0.0 and p.y + r <= 640.0:
                Display::draw_circle(list, SceneHand::x(p.x), SceneHand::y(p.y), r * SceneHand::SCALE, color)
            else:
                oval(list, p, r, r, color)

    def oval(list: mutable Display::DisplayList&, p: RoomsView::Vec, rx: f64, ry: f64, color: u32):
        can Abort.Panic, Memory.Allocate:
            vertices: mutable RoomsView::Vec[32] = zeroed
            for i in 0..<24 |p, rx, ry, vertices|:
                angle: f64 = 2.0 * PI * i.f64() / 24.0
                vertices[i.usize()] <- point(p.x + rx * cos(angle), p.y + ry * sin(angle))
            SceneHand::polygon(list, &vertices, 24, color)

    def shape(list: mutable Display::DisplayList&, a: RoomsView::Vec, b: RoomsView::Vec, c: RoomsView::Vec,
              color: u32, d: RoomsView::Vec = zeroed):
        can Abort.Panic, Memory.Allocate:
            vertices: mutable RoomsView::Vec[32] = zeroed
            vertices[0] <- a
            vertices[1] <- b
            vertices[2] <- c
            vertices[3] <- d
            SceneHand::polygon(list, &vertices, 4 if d.z > 0.0 else 3, color)

    def metal(r: i64) -> u32:
        return 0xd6aa46ff if r == 22
        return 0xbec4ceff if r == 30
        return 0xc46e46ff if r == 40
        return 0x96a078ff if r == 52
        return 0x7882a0ff if r == 66
        return 0xb4b4b4ff

    def teeth(r: f64) -> i64:
        return CrazyCog::max_i(8, py_round_half_even(2.0 * PI * r / 9.0))

    def cog(list: mutable Display::DisplayList&, p: RoomsView::Vec, r: f64, turn: f64,
            color: u32, alpha: i64 = 255, ghost: bool = false, count: i64 = 0):
        can Abort.Panic, Memory.Allocate:
            n: i64 = count if count > 0 else teeth(r)
            body: f64 = r - fmin(7.0, r * 0.22)
            rim: u32 = color if ghost else opacity(ScenePolish::mix_rgb(color, 0x000000ff, 0.35), alpha)
            face: u32 = color if ghost else opacity(color, alpha)
            half: f64 = PI / n.f64() * 0.5
            for i in 0..<n |list, p, r, turn, n, body, rim, half|:
                a: f64 = turn + 2.0 * PI * i.f64() / n.f64()
                shape(list, polar(p, body - 1.0, a - half * 1.3), polar(p, r, a - half * 0.7),
                    polar(p, r, a + half * 0.7), rim, polar(p, body - 1.0, a + half * 1.3))
            disc(list, p, body, rim)
            disc(list, p, body - 2.5, face)
            return if ghost
            disc(list, point(p.x - body * 0.15, p.y + body * 0.15), body * 0.75,
                opacity(ScenePolish::mix_rgb(color, 0xffffffff, 0.15), alpha))
            if r >= 30.0:
                holes: i64 = 5 if r >= 52.0 else 4
                shade: u32 = opacity(ScenePolish::mix_rgb(color, 0x000000ff, 0.6), alpha)
                for i in 0..<holes |list, p, body, turn, holes, shade|:
                    disc(list, polar(p, body * 0.55, turn + 2.0 * PI * i.f64() / holes.f64()), body * 0.18, shade)
            hub: f64 = fmax(5.0, r * 0.2)
            disc(list, p, hub, rim)
            disc(list, p, 3.0, opacity(0x1e1e1eff, alpha))
            SceneHand::line(list, p, polar(p, hub, turn), 2.0, opacity(0xf0f0f0ff, alpha))

    def arrow(list: mutable Display::DisplayList&, p: RoomsView::Vec, radius: f64, way: f64, color: u32):
        can Abort.Panic, Memory.Allocate:
            for i in 0..<9 |list, p, radius, way, color|:
                a: f64 = PI * 0.25 + way * i.f64() / 9.0 * PI * 1.2
                b: f64 = PI * 0.25 + way * (i + 1).f64() / 9.0 * PI * 1.2
                SceneHand::line(list, polar(p, radius, a), polar(p, radius, b), 3.0, color)
            end: f64 = PI * 0.25 + way * PI * 1.2
            e: RoomsView::Vec = polar(p, radius, end)
            tx: f64 = -sin(end) * way
            ty: f64 = cos(end) * way
            back: RoomsView::Vec = point(e.x - tx * 3.0, e.y - ty * 3.0)
            shape(list, point(e.x + tx * 9.0, e.y + ty * 9.0), polar(back, 6.0, end), polar(back, -6.0, end), color)

    def chain(list: mutable Display::DisplayList&, run: CrazyCog::Run&, link: CrazyCog::Link, p: Plane):
        can Abort.Panic, Memory.Allocate:
            a: RoomsView::Vec = at(p, link.first.x, link.first.y)
            b: RoomsView::Vec = at(p, link.second.x, link.second.y)
            r: f64 = link.first.r * p.scale
            s: f64 = link.second.r * p.scale
            d: f64 = sqrt((b.x - a.x) * (b.x - a.x) + (b.y - a.y) * (b.y - a.y))
            return if d <= fabs(r - s)
            heading: f64 = atan2(b.y - a.y, b.x - a.x)
            beta: f64 = acos((r - s) / d)
            index: i64 = CrazyCog::at_peg(run, link.first)
            movement: f64 = run.wheels[index.usize()].angle * link.first.r if index >= 0 else 0.0
            for i in 0..<2 |list, a, b, r, s, p, heading, beta, movement|:
                side: f64 = -1.0 if i == 0 else 1.0
                angle: f64 = heading + beta * side
                start: RoomsView::Vec = polar(a, r, angle)
                end: RoomsView::Vec = polar(b, s, angle)
                SceneHand::line(list, start, end, 5.0, opacity(0x282422ff, p.alpha))
                dx: f64 = end.x - start.x
                dy: f64 = end.y - start.y
                span: f64 = sqrt(dx * dx + dy * dy)
                offset: mutable f64 = movement * side - 14.0 * floor(movement * side / 14.0)
                while offset < span |offset, span, start, dx, dy, list, p|:
                    disc(list, point(start.x + dx * offset / span, start.y + dy * offset / span), 2.2, opacity(0x9696a0ff, p.alpha))
                    offset <- offset + 14.0
            shade: u32 = opacity(0x282422ff, (p.alpha.f64() * 0.35).i64())
            disc(list, a, r + 1.5, shade)
            disc(list, b, s + 1.5, shade)
