# Whole numbers of any size, and exact rationals over them.
#
# What CPython's `int` and `fractions.Fraction` do, to the extent
# neural_workshop/algebra.py and expressions.py need them -- which is further
# than it looks. The top rung of the algebra ladder is six five-digit primes
# multiplied together: the box the answer hides in is about 10^28, the
# remainder-theorem recombination runs to 10^33 on the way, and `randrange`
# over that box draws a hundred-odd bits. None of it fits in sixty-four.
#
# The magnitude is base-10 digits, most significant first, on the algorithms
# decimal.elisa uses for its coefficient -- and NINETY-SIX of them rather than
# that module's two hundred and fifty-six. The width is not thrift: a
# polynomial holds sixteen of these rationals inline, an expression holds
# several polynomials, and a builder holds several expressions, so a magnitude
# four times too wide is a stack frame four times too wide and the optimiser
# spends minutes on one function. Ninety-six carries the widest thing here --
# two thirty-four digit numbers multiplied -- with room over.
#
# What is added over the digits is the SIGN, and that is where the two
# languages part company: Python's `//` floors toward minus infinity and its
# `%` takes the sign of the DIVISOR, so `-7 // 2` is -4 and `-7 % 2` is 1.
# Truncating instead gives -3 and -1, and every congruence on the ladder would
# come out wrong by a modulus.

const BIG_DIGITS: i64 = 96

# An unsigned magnitude as base-10 digits, most significant first. Invariant:
# count >= 1, no leading zeros, and zero is exactly one 0 digit -- the same
# invariant CPython's own decimal string carries.
struct Mag:
    count: mutable i64
    d: mutable u8[96]

def mag_zero() -> Mag:
    return Mag{count: 1, d: zeroed}

def mag_get(value: Mag&, index: i64) -> i64:
    can Abort.Panic:
        return 0 if index < 0 or index >= value.count
        return value.d[index.usize()].i64()

def mag_set(value: mutable Mag&, index: i64, digit: i64):
    can Abort.Panic:
        if index >= 0 and index < BIG_DIGITS:
            value.d[index.usize()] <- digit.u8()

def mag_is_zero(value: Mag&) -> bool:
    can Abort.Panic:
        return value.count == 1 and mag_get(value, 0) == 0

def mag_copy(target: mutable Mag&, source: Mag&):
    can Abort.Panic:
        target.count <- source.count
        for index in 0..<source.count |target, source|:
            mag_set(target, index, mag_get(source, index))

def mag_set_zero(target: mutable Mag&):
    can Abort.Panic:
        target.count <- 1
        mag_set(target, 0, 0)

def mag_trim(value: mutable Mag&):
    can Abort.Panic:
        lead: mutable i64 = 0
        while lead + 1 < value.count and mag_get(value, lead) == 0 |lead, value|:
            lead <- lead + 1
        return if lead == 0
        for index in 0..<(value.count - lead) |value, lead|:
            mag_set(value, index, mag_get(value, index + lead))
        value.count <- value.count - lead

def mag_set_i64(target: mutable Mag&, value: i64):
    can Abort.Panic:
        if value == 0:
            mag_set_zero(target)
            return
        digits: mutable i64 = 0
        held: mutable i64 = value
        while held > 0 |held, digits|:
            held <- held / 10
            digits <- digits + 1
        target.count <- digits
        held <- value
        for step in 0..<digits |target, held, digits|:
            mag_set(target, digits - 1 - step, held % 10)
            held <- held / 10

def mag_cmp(left: Mag&, right: Mag&) -> i64:
    can Abort.Panic:
        return -1 if left.count < right.count
        return 1 if left.count > right.count
        for index in 0..<left.count |left, right|:
            a: i64 = mag_get(left, index)
            b: i64 = mag_get(right, index)
            -1 return if a < b
            1 return if a > b
        return 0

def mag_append_digit(value: mutable Mag&, digit: i64) -> bool:
    can Abort.Panic:
        if mag_is_zero(value):
            mag_set(value, 0, digit)
            return true
        false return if value.count + 1 > BIG_DIGITS
        mag_set(value, value.count, digit)
        value.count <- value.count + 1
        return true

def mag_add(out: mutable Mag&, left: Mag&, right: Mag&) -> bool:
    can Abort.Panic:
        length: i64 = left.count if left.count > right.count else right.count
        false return if length + 1 > BIG_DIGITS
        total_length: i64 = length + 1
        carry: mutable i64 = 0
        for index in 0..<length |carry, out, left, right, total_length|:
            a: i64 = mag_get(left, left.count - 1 - index) if index < left.count else 0
            b: i64 = mag_get(right, right.count - 1 - index) if index < right.count else 0
            total: i64 = a + b + carry
            mag_set(out, total_length - 1 - index, total % 10)
            carry <- total / 10
        mag_set(out, 0, carry)
        out.count <- total_length
        mag_trim(out)
        return true

# left - right, which the callers only ever ask for with left >= right.
def mag_sub(out: mutable Mag&, left: Mag&, right: Mag&) -> bool:
    can Abort.Panic:
        false return if mag_cmp(left, right) < 0
        borrow: mutable i64 = 0
        for index in 0..<left.count |borrow, out, left, right|:
            a: i64 = mag_get(left, left.count - 1 - index)
            b: i64 = mag_get(right, right.count - 1 - index) if index < right.count else 0
            difference: mutable i64 = a - b - borrow
            if difference < 0:
                difference <- difference + 10
                borrow <- 1
            else:
                borrow <- 0
            mag_set(out, left.count - 1 - index, difference)
        out.count <- left.count
        mag_trim(out)
        return true

def mag_mul(out: mutable Mag&, left: Mag&, right: Mag&) -> bool:
    can Abort.Panic:
        if mag_is_zero(left) or mag_is_zero(right):
            mag_set_zero(out)
            return true
        total_length: i64 = left.count + right.count
        false return if total_length > BIG_DIGITS
        # Column sums stay far inside i64: at most 9*9*96.
        columns: mutable i64[96] = zeroed
        for index in 0..<left.count |columns, left, right|:
            a: i64 = mag_get(left, left.count - 1 - index)
            for inner in 0..<right.count |columns, right, index, a|:
                columns[(index + inner).usize()] <- columns[(index + inner).usize()] + a * mag_get(right, right.count - 1 - inner)
        carry: mutable i64 = 0
        for position in 0..<total_length |carry, columns|:
            total: i64 = columns[position.usize()] + carry
            columns[position.usize()] <- total % 10
            carry <- total / 10
        out.count <- total_length
        for write in 0..<total_length |out, columns, total_length|:
            mag_set(out, write, columns[(total_length - 1 - write).usize()])
        mag_trim(out)
        return true

def mag_divmod(quotient: mutable Mag&, remainder: mutable Mag&, numerator: Mag&, divisor: Mag&) -> bool:
    can Abort.Panic:
        false return if mag_is_zero(divisor)
        mag_set_zero(remainder)
        quotient.count <- numerator.count
        for index in 0..<numerator.count |quotient, remainder, numerator, divisor|:
            false return if not mag_append_digit(remainder, mag_get(numerator, index))
            digit: mutable i64 = 0
            while mag_cmp(remainder, divisor) >= 0 |digit, remainder, divisor|:
                scratch: mutable Mag = mag_zero()
                false return if not mag_sub(&scratch, remainder, divisor)
                mag_copy(remainder, &scratch)
                digit <- digit + 1
            mag_set(quotient, index, digit)
        mag_trim(quotient)
        return true

module Big:

    # Sign-and-magnitude. Zero is always positive, so there is one of it.
    struct Int:
        negative: mutable bool
        mag: mutable Mag

    def zero() -> Int:
        return Int{negative: false, mag: mag_zero()}

    def is_zero(value: Int&) -> bool:
        return mag_is_zero(&value.mag)

    def normalise(value: mutable Int&):
        value.negative <- false if mag_is_zero(&value.mag)

    def set_i64(out: mutable Int&, value: i64):
        can Abort.Panic:
            out.negative <- value < 0
            mag_set_i64(&out.mag, value if value >= 0 else 0 - value)
            normalise(out)

    def from_i64(value: i64) -> Int:
        can Abort.Panic:
            out: mutable Int = zero()
            set_i64(&out, value)
            return out

    def copy(out: mutable Int&, source: Int&):
        can Abort.Panic:
            out.negative <- source.negative
            mag_copy(&out.mag, &source.mag)

    def negate(out: mutable Int&, source: Int&):
        can Abort.Panic:
            copy(out, source)
            out.negative <- not out.negative
            normalise(out)

    # -1, 0 or 1.
    def cmp(left: Int&, right: Int&) -> i64:
        can Abort.Panic:
            left_zero: bool = is_zero(left)
            right_zero: bool = is_zero(right)
            return 0 if left_zero and right_zero
            return -1 if left_zero and not right.negative
            return 1 if left_zero
            return 1 if right_zero and not left.negative
            return -1 if right_zero
            return -1 if left.negative and not right.negative
            return 1 if right.negative and not left.negative
            size: i64 = mag_cmp(&left.mag, &right.mag)
            return 0 - size if left.negative
            return size

    def cmp_i64(left: Int&, right: i64) -> i64:
        can Abort.Panic:
            held: Int = from_i64(right)
            return cmp(left, &held)

    # Magnitudes only, so the sign rules live in one place each.
    def add_mag(out: mutable Int&, left: Int&, right: Int&, flip: bool) -> bool:
        can Abort.Panic:
            scratch: mutable Mag = mag_zero()
            same_sign: bool = left.negative == (right.negative != flip)
            if same_sign:
                false return if not mag_add(&scratch, &left.mag, &right.mag)
                mag_copy(&out.mag, &scratch)
                out.negative <- left.negative
                normalise(out)
                return true
            order: i64 = mag_cmp(&left.mag, &right.mag)
            if order >= 0:
                false return if not mag_sub(&scratch, &left.mag, &right.mag)
                out.negative <- left.negative
            else:
                false return if not mag_sub(&scratch, &right.mag, &left.mag)
                out.negative <- right.negative != flip
            mag_copy(&out.mag, &scratch)
            normalise(out)
            return true

    def add(out: mutable Int&, left: Int&, right: Int&) -> bool:
        return add_mag(out, left, right, false)

    def sub(out: mutable Int&, left: Int&, right: Int&) -> bool:
        return add_mag(out, left, right, true)

    def mul(out: mutable Int&, left: Int&, right: Int&) -> bool:
        can Abort.Panic:
            scratch: mutable Mag = mag_zero()
            false return if not mag_mul(&scratch, &left.mag, &right.mag)
            mag_copy(&out.mag, &scratch)
            out.negative <- left.negative != right.negative
            normalise(out)
            return true

    def add_i64(out: mutable Int&, left: Int&, right: i64) -> bool:
        can Abort.Panic:
            held: Int = from_i64(right)
            return add(out, left, &held)

    def mul_i64(out: mutable Int&, left: Int&, right: i64) -> bool:
        can Abort.Panic:
            held: Int = from_i64(right)
            return mul(out, left, &held)

    # `divmod` as Python spells it: the quotient FLOORS toward minus infinity
    # and the remainder takes the sign of the divisor, so the remainder of a
    # negative number by a positive modulus is positive. Truncation would give
    # the other answer and every congruence on the ladder would be out by a
    # modulus.
    def divmod_floor(quotient: mutable Int&, remainder: mutable Int&, left: Int&, right: Int&) -> bool:
        can Abort.Panic:
            false return if is_zero(right)
            q_mag: mutable Mag = mag_zero()
            r_mag: mutable Mag = mag_zero()
            false return if not mag_divmod(&q_mag, &r_mag, &left.mag, &right.mag)
            mag_copy(&quotient.mag, &q_mag)
            mag_copy(&remainder.mag, &r_mag)
            quotient.negative <- left.negative != right.negative
            remainder.negative <- left.negative
            normalise(quotient)
            normalise(remainder)
            # Truncated so far. Floor it: when the signs differed and something
            # was left over, the quotient is one lower and the remainder swings
            # across to the divisor's side.
            return true if mag_is_zero(&r_mag) or left.negative == right.negative
            one: Int = from_i64(1)
            lowered: mutable Int = zero()
            false return if not sub(&lowered, quotient, &one)
            copy(quotient, &lowered)
            shifted: mutable Int = zero()
            false return if not add(&shifted, remainder, right)
            copy(remainder, &shifted)
            return true

    # `value % modulus` for a positive i64 modulus, which is what every
    # congruence here asks for. The digits are base ten, so the remainder falls
    # out of one left-to-right pass.
    def mod_i64(value: Int&, modulus: i64) -> i64:
        can Abort.Panic:
            0 return if modulus <= 0
            held: mutable i64 = 0
            for index in 0..<value.mag.count |held, value, modulus|:
                held <- (held * 10 + mag_get(&value.mag, index)) % modulus
            return held if not value.negative or held == 0
            return modulus - held

    def is_i64(value: Int&) -> bool:
        return value.mag.count <= 18

    def to_i64(value: Int&) -> i64:
        can Abort.Panic:
            held: mutable i64 = 0
            for index in 0..<value.mag.count |held, value|:
                held <- held * 10 + mag_get(&value.mag, index)
            return 0 - held if value.negative
            return held

    def is_one(value: Int&) -> bool:
        can Abort.Panic:
            return not value.negative and value.mag.count == 1 and mag_get(&value.mag, 0) == 1

    # Euclid on the magnitudes, so the answer is never negative -- which is
    # what `math.gcd` gives and what a fraction wants to divide through by.
    def gcd(out: mutable Int&, left: Int&, right: Int&) -> bool:
        can Abort.Panic:
            a: mutable Mag = mag_zero()
            b: mutable Mag = mag_zero()
            mag_copy(&a, &left.mag)
            mag_copy(&b, &right.mag)
            while not mag_is_zero(&b) |a, b|:
                q: mutable Mag = mag_zero()
                r: mutable Mag = mag_zero()
                break if not mag_divmod(&q, &r, &a, &b)
                mag_copy(&a, &b)
                mag_copy(&b, &r)
            mag_copy(&out.mag, &a)
            out.negative <- false
            return true

    # In place, magnitude only: what `bit_length` walks.
    def halve(value: mutable Mag&):
        can Abort.Panic:
            carry: mutable i64 = 0
            for index in 0..<value.count |value, carry|:
                held: i64 = carry * 10 + mag_get(value, index)
                mag_set(value, index, held / 2)
                carry <- held % 2
            mag_trim(value)

    def double_in_place(value: mutable Mag&) -> bool:
        can Abort.Panic:
            scratch: mutable Mag = mag_zero()
            false return if not mag_add(&scratch, value, value)
            mag_copy(value, &scratch)
            return true

    # `int.bit_length()`: zero for zero, and the magnitude's otherwise.
    def bit_length(value: Int&) -> i64:
        can Abort.Panic:
            0 return if is_zero(value)
            rest: mutable Mag = mag_zero()
            mag_copy(&rest, &value.mag)
            bits: mutable i64 = 0
            while not mag_is_zero(&rest) |rest, bits|:
                halve(&rest)
                bits <- bits + 1
            return bits

    # `getrandbits(k)`, which CPython assembles out of 32-bit draws.
    #
    # The words come off the generator LEAST significant first, and only the
    # last one is shifted down to the width still wanted -- so the draws have
    # to be taken in that order and the number put together afterwards, from
    # the top.
    const MOST_WORDS: i64 = 16

    def getrandbits(out: mutable Int&, k: i64, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            set_i64(out, 0)
            true return if k <= 0
            if k <= 32:
                set_i64(out, (mt_genrand_uint32(rng).u64() >> (32 - k).u64()).i64())
                return true
            words: i64 = (k - 1) / 32 + 1
            false return if words > MOST_WORDS
            held: mutable darray[i64] = Ints::zeros(MOST_WORDS)
            left: mutable i64 = k
            for index in 0..<words |held, left, rng|:
                drawn: mutable u64 = mt_genrand_uint32(rng).u64()
                drawn <- drawn >> (32 - left).u64() if left < 32
                Ints::put(&held, index, drawn.i64())
                left <- left - 32
            step: mutable Int = zero()
            for back in 0..<words |out, held, step, words|:
                index: i64 = words - 1 - back
                false return if not mul_i64(&step, out, 4294967296)
                copy(out, &step)
                false return if not add_i64(&step, out, Ints::at_ref(&held, index))
                copy(out, &step)
            return true

    # `_randbelow_with_getrandbits`: a uniform value in [0, n) by rejection on
    # the bit length of n. CPython uses n.bit_length() and not (n-1)'s, so for
    # a power of two it draws one bit more than it needs and rejects half.
    def randbelow(out: mutable Int&, n: Int&, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            set_i64(out, 0)
            true return if is_zero(n) or n.negative
            k: i64 = bit_length(n)
            false return if not getrandbits(out, k, rng)
            while cmp(out, n) >= 0 |out, k, n, rng|:
                break if not getrandbits(out, k, rng)
            return true

    # The digits, most significant first, into a caller's buffer; the count is
    # returned and a minus sign is written where there is one.
    def to_text(value: Int&, out: mutable darray[u8]&) -> i64:
        can Abort.Panic:
            at: mutable i64 = 0
            if value.negative:
                Bytes::put(out, 0, 45.u8())
                at <- 1
            for index in 0..<value.mag.count |out, value, at|:
                Bytes::put(out, at + index, (48 + mag_get(&value.mag, index)).u8())
            return at + value.mag.count

    # A run of ASCII digits, with no sign; what the parser hands over.
    def from_digits(out: mutable Int&, text: mutable darray[u8]&, first: i64, count: i64) -> bool:
        can Abort.Panic:
            out.negative <- false
            mag_set_zero(&out.mag)
            for index in 0..<count |out, text, first|:
                digit: i64 = Bytes::at_ref(text, first + index).i64() - 48
                false return if digit < 0 or digit > 9
                false return if not mag_append_digit(&out.mag, digit)
            mag_trim(&out.mag)
            return true

# Exact rationals, normalised the way `fractions.Fraction` normalises: the
# denominator is positive and the two share no factor, so equality is equality
# of the pair and no comparison has to cross-multiply.
module Q:

    struct Frac:
        num: mutable Big::Int
        den: mutable Big::Int

    def zero() -> Frac:
        can Abort.Panic:
            return Frac{num: Big::from_i64(0), den: Big::from_i64(1)}

    def copy(out: mutable Frac&, source: Frac&):
        can Abort.Panic:
            Big::copy(&out.num, &source.num)
            Big::copy(&out.den, &source.den)

    def normalise(value: mutable Frac&) -> bool:
        can Abort.Panic:
            false return if Big::is_zero(&value.den)
            if value.den.negative:
                flipped: mutable Big::Int = Big::zero()
                Big::negate(&flipped, &value.num)
                Big::copy(&value.num, &flipped)
                Big::negate(&flipped, &value.den)
                Big::copy(&value.den, &flipped)
            if Big::is_zero(&value.num):
                Big::set_i64(&value.den, 1)
                return true
            common: mutable Big::Int = Big::zero()
            false return if not Big::gcd(&common, &value.num, &value.den)
            true return if Big::is_one(&common)
            q: mutable Big::Int = Big::zero()
            r: mutable Big::Int = Big::zero()
            false return if not Big::divmod_floor(&q, &r, &value.num, &common)
            Big::copy(&value.num, &q)
            false return if not Big::divmod_floor(&q, &r, &value.den, &common)
            Big::copy(&value.den, &q)
            return true

    def set_i64(out: mutable Frac&, value: i64):
        can Abort.Panic:
            Big::set_i64(&out.num, value)
            Big::set_i64(&out.den, 1)

    def from_i64(value: i64) -> Frac:
        can Abort.Panic:
            out: mutable Frac = zero()
            set_i64(&out, value)
            return out

    def from_pair(out: mutable Frac&, num: i64, den: i64) -> bool:
        can Abort.Panic:
            Big::set_i64(&out.num, num)
            Big::set_i64(&out.den, den)
            return normalise(out)

    def from_big(out: mutable Frac&, value: Big::Int&):
        can Abort.Panic:
            Big::copy(&out.num, value)
            Big::set_i64(&out.den, 1)

    def is_zero(value: Frac&) -> bool:
        return Big::is_zero(&value.num)

    def is_integer(value: Frac&) -> bool:
        return Big::is_one(&value.den)

    def is_negative(value: Frac&) -> bool:
        return value.num.negative

    def abs_of(out: mutable Frac&, source: Frac&):
        can Abort.Panic:
            copy(out, source)
            out.num.negative <- false

    def negate(out: mutable Frac&, source: Frac&):
        can Abort.Panic:
            Big::negate(&out.num, &source.num)
            Big::copy(&out.den, &source.den)

    def add(out: mutable Frac&, left: Frac&, right: Frac&) -> bool:
        can Abort.Panic:
            one: mutable Big::Int = Big::zero()
            two: mutable Big::Int = Big::zero()
            false return if not Big::mul(&one, &left.num, &right.den)
            false return if not Big::mul(&two, &right.num, &left.den)
            top: mutable Big::Int = Big::zero()
            false return if not Big::add(&top, &one, &two)
            bottom: mutable Big::Int = Big::zero()
            false return if not Big::mul(&bottom, &left.den, &right.den)
            Big::copy(&out.num, &top)
            Big::copy(&out.den, &bottom)
            return normalise(out)

    def sub(out: mutable Frac&, left: Frac&, right: Frac&) -> bool:
        can Abort.Panic:
            flipped: mutable Frac = zero()
            negate(&flipped, right)
            return add(out, left, &flipped)

    def mul(out: mutable Frac&, left: Frac&, right: Frac&) -> bool:
        can Abort.Panic:
            top: mutable Big::Int = Big::zero()
            bottom: mutable Big::Int = Big::zero()
            false return if not Big::mul(&top, &left.num, &right.num)
            false return if not Big::mul(&bottom, &left.den, &right.den)
            Big::copy(&out.num, &top)
            Big::copy(&out.den, &bottom)
            return normalise(out)

    def div(out: mutable Frac&, left: Frac&, right: Frac&) -> bool:
        can Abort.Panic:
            false return if is_zero(right)
            top: mutable Big::Int = Big::zero()
            bottom: mutable Big::Int = Big::zero()
            false return if not Big::mul(&top, &left.num, &right.den)
            false return if not Big::mul(&bottom, &left.den, &right.num)
            Big::copy(&out.num, &top)
            Big::copy(&out.den, &bottom)
            return normalise(out)

    # Both are normalised, so this is equality of the pair.
    def equal(left: Frac&, right: Frac&) -> bool:
        can Abort.Panic:
            return Big::cmp(&left.num, &right.num) == 0 and Big::cmp(&left.den, &right.den) == 0

    def cmp(left: Frac&, right: Frac&) -> i64:
        can Abort.Panic:
            one: mutable Big::Int = Big::zero()
            two: mutable Big::Int = Big::zero()
            0 return if not Big::mul(&one, &left.num, &right.den)
            0 return if not Big::mul(&two, &right.num, &left.den)
            return Big::cmp(&one, &two)

    # `value ** power` for a whole non-negative power, by repeated multiplying,
    # which is what `Fraction.__pow__` reduces to here.
    def power(out: mutable Frac&, base: Frac&, exponent: i64) -> bool:
        can Abort.Panic:
            set_i64(out, 1)
            step: mutable Frac = zero()
            for _each in 0..<exponent |out, step, base|:
                false return if not mul(&step, out, base)
                copy(out, &step)
            return true

    # `str(value.numerator)` when it is whole, else `'%d/%d'`, which is what
    # both `_number`s in the reference come down to.
    def to_text(value: Frac&, out: mutable darray[u8]&) -> i64:
        can Abort.Panic:
            at: mutable i64 = Big::to_text(&value.num, out)
            return at if is_integer(value)
            Bytes::put(out, at, 47.u8())
            below: mutable darray[u8] = Bytes::zeros(320)
            span: i64 = Big::to_text(&value.den, &below)
            for index in 0..<span |out, below, at|:
                Bytes::put(out, at + 1 + index, Bytes::at_ref(&below, index))
            return at + 1 + span
