include "./tasks/railyard_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./verdict.elisa"
include "./geometry.elisa"

module SceneRailYard:
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const PI: f64 = 3.141592653589793

    struct Frame:
        x: f64
        y: f64
        size: f64
        height: f64

    def frame() -> Frame:
        can Abort.Panic:
            bottom: f64 = Verdict::above_the_band(HEIGHT, Geometry::from_bottom_edge(HEIGHT, 58.0).f64()).f64()
            height: f64 = fmax(40.0, Geometry::from_top_edge(HEIGHT, 116.0).f64() - bottom)
            size: f64 = fmin(WIDTH * 0.94 / RailYard::WORLD_W, height * 0.92 / RailYard::WORLD_H)
            return Frame{x: (WIDTH - RailYard::WORLD_W * size) / 2.0, y: bottom, size: size, height: height}

    def at(area: Frame, x: f64, y: f64) -> RailYard::Point:
        return RailYard::Point{x: area.x + x * area.size, y: area.y + y * area.size}

    def portal_node(layout: RailYard::Layout&, portal: i64) -> RailYard::Node:
        can Abort.Panic:
            return layout.nodes[layout.segments[layout.starts[portal.usize()].usize()].start.usize()]

    def hit(session: RailYardGame::Session&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return RailYardGame::START if session.phase == RailYardGame::READY or session.phase == RailYardGame::DONE
            return -1 if session.phase != RailYardGame::PLAYING
            area: Frame = frame()
            layout: RailYard::Layout& = &session.yard.yard.layout
            switches: i64 = (1 << session.yard.yard.level.depth) - 1
            best: mutable f64 = (4.5 * area.size) * (4.5 * area.size)
            port: mutable i64 = -1
            for i in 0..<switches |layout, area, x, y, best, port|:
                node: RailYard::Node = layout.nodes[i.usize()]
                p: RailYard::Point = at(area, node.point.x, node.point.y)
                dx: f64 = p.x - x
                dy: f64 = p.y - y
                d: f64 = dx * dx + dy * dy
                if d < best:
                    port <- i
                    best <- d
            for i in 0..<session.yard.yard.level.portals |layout, area, x, y, best, port|:
                node: RailYard::Node = portal_node(layout, i)
                p: RailYard::Point = at(area, node.point.x + 3.0, node.point.y + 6.5)
                dx: f64 = p.x - x
                dy: f64 = p.y - y
                d: f64 = dx * dx + dy * dy
                if d < best:
                    port <- RailYard::MOST_SWITCHES + i
                    best <- d
            return port

    def station_colour(index: i64) -> u32:
        can Abort.Panic:
            colours: u32[16] = [0xe85448ff, 0xf6a22cff, 0xeece34ff, 0x7cc652ff,
                0x26a87aff, 0x2cbaccff, 0x3e82e8ff, 0x7c64deff, 0xbe5cd4ff, 0xe85ca2ff,
                0xa47040ff, 0x76808cff, 0xfc8870ff, 0xb6de68ff, 0x68caf2ff, 0xac8ef4ff]
            return colours[index.usize()]

    def label(list: mutable Display::DisplayList&, value: sview, p: RailYard::Point, size: f64, colour: u32, bold: bool = false):
        can Abort.Panic, Memory.Allocate:
            Display::draw_text_weight(list, value, p.x, p.y, size, colour, Display::ANCHOR_CENTER_CENTER, bold)

    def station_label(list: mutable Display::DisplayList&, index: i64, p: RailYard::Point, size: f64, colour: u32):
        can Abort.Panic, Memory.Allocate:
            letters: sview[16] = ["A", "B", "C", "D", "E", "F", "G", "H",
                "I", "J", "K", "L", "M", "N", "O", "P"]
            label(list, letters[index.usize()], p, size, colour, true)

    def track(list: mutable Display::DisplayList&, area: Frame, segment: RailYard::Segment&, layer: i64):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            if layer == 1:
                d: mutable f64 = 1.0
                while d < segment.length |list, area, segment, s, d|:
                    pos: RailYard::Position = RailYard::position(segment, d)
                    nx: f64 = -sin(pos.heading) * 1.7
                    ny: f64 = cos(pos.heading) * 1.7
                    a: RailYard::Point = at(area, pos.point.x - nx, pos.point.y - ny)
                    b: RailYard::Point = at(area, pos.point.x + nx, pos.point.y + ny)
                    Display::draw_line(list, a.x, a.y, b.x, b.y, fmax(1.0, 0.75 * s), 0x70543aff)
                    d <- d + 2.4
                return
            for j in 1..<segment.point_count |list, area, segment, layer, s|:
                p: RailYard::Point = segment.points[(j - 1).usize()]
                q: RailYard::Point = segment.points[j.usize()]
                if layer == 0:
                    a: RailYard::Point = at(area, p.x, p.y)
                    b: RailYard::Point = at(area, q.x, q.y)
                    Display::draw_line(list, a.x, a.y, b.x, b.y, 3.6 * s, 0xaca292ff)
                    Display::draw_circle(list, b.x, b.y, 1.8 * s, 0xaca292ff)
                else:
                    h: f64 = atan2(q.y - p.y, q.x - p.x)
                    for rail in 0..<2 |list, area, p, q, h, s|:
                        side: f64 = -0.8 if rail == 0 else 0.8
                        nx: f64 = -sin(h) * side
                        ny: f64 = cos(h) * side
                        a: RailYard::Point = at(area, p.x + nx, p.y + ny)
                        b: RailYard::Point = at(area, q.x + nx, q.y + ny)
                        Display::draw_line(list, a.x, a.y, b.x, b.y, fmax(1.0, 0.38 * s), 0xd6dae4ff)

    def rounded(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, radius: f64, colour: u32):
        can Abort.Panic, Memory.Allocate:
            rect: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: x, y: y, w: w, h: h}
            ScenePolish::rounded(list, &rect, radius, colour)

    # The largest layout needs 403 samples, including station clearances.
    struct Clearance:
        points: RailYard::Point[403]
        count: mutable i64

    def reserve(points: mutable Clearance&, p: RailYard::Point):
        can Abort.Panic:
            points.points[points.count.usize()] <- p
            points.count <- points.count + 1

    def clearance(yard: RailYard::Yard&) -> Clearance:
        can Abort.Panic:
            result: mutable Clearance = zeroed
            for i in 0..<yard.layout.segment_count |yard, result|:
                seg: RailYard::Segment& = &yard.layout.segments[i.usize()]
                d: mutable f64 = 0.0
                while d <= seg.length |seg, d, result|:
                    reserve(&result, RailYard::position(seg, d).point)
                    d <- d + 3.0
            for i in 0..<yard.layout.node_count |yard, result|:
                node: RailYard::Node = yard.layout.nodes[i.usize()]
                reserve(&result, node.point)
                if node.kind == RailYard::STATION:
                    reserve(&result, RailYard::Point{x: node.point.x + 4.0, y: node.point.y})
                    reserve(&result, RailYard::Point{x: node.point.x + 8.0, y: node.point.y})
            return result

    def clear(points: Clearance&, x: f64, y: f64, radius: f64) -> bool:
        can Abort.Panic:
            for i in 0..<points.count |points, x, y, radius|:
                p: RailYard::Point = points.points[i.usize()]
                dx: f64 = x - p.x
                dy: f64 = y - p.y
                return false if dx * dx + dy * dy <= radius * radius
            return true

    def stone(list: mutable Display::DisplayList&, p: RailYard::Point, rx: f64, ry: f64):
        can Abort.Panic, Memory.Allocate:
            Display::begin_polygon(list, 20, p.x + rx, p.y, 0x96968cff)
            for i in 0..<20 |list, p, rx, ry|:
                angle: f64 = 2.0 * PI * i.f64() / 20.0
                Display::polygon_point(list, p.x + rx * cos(angle), p.y + ry * sin(angle))

    def vegetation(list: mutable Display::DisplayList&, area: Frame, yard: RailYard::Yard&):
        can Abort.Panic, Memory.Allocate:
            occupied: Clearance = clearance(yard)
            draw: mutable MT19937 = zeroed
            mt_seed_int(&draw, (yard.layout.node_count * 131 + yard.level.depth).u64())
            petals: u32[4] = [0xfaf078ff, 0xfafafaff, 0xf0a0c8ff, 0xb4c8ffff]
            highlights: mutable RailYard::Point[260] = zeroed
            radii: mutable f64[260] = zeroed
            colours: mutable u32[260] = zeroed
            trees: mutable i64 = 0
            for _ in 0..<260 |list, area, occupied, draw, petals, highlights, radii, colours, trees|:
                x: f64 = py_uniform(&draw, 2.0, RailYard::WORLD_W - 2.0)
                y: f64 = py_uniform(&draw, 2.0, RailYard::WORLD_H - 2.0)
                kind: f64 = py_random(&draw)
                p: RailYard::Point = at(area, x, y)
                if kind < 0.45 and clear(&occupied, x, y, 6.0):
                    r: f64 = py_uniform(&draw, 1.8, 3.2) * area.size
                    shade: f64 = py_uniform(&draw, 0.0, 0.25)
                    leaf: u32 = ScenePolish::mix_rgb(0x2e703aff, 0x184628ff, shade)
                    Display::draw_circle(list, p.x + r * 0.25, p.y - r * 0.3, r, 0x14281446)
                    Display::draw_circle(list, p.x, p.y, r, leaf)
                    highlights[trees.usize()] <- RailYard::Point{x: p.x - r * 0.3, y: p.y + r * 0.3}
                    radii[trees.usize()] <- r * 0.45
                    colours[trees.usize()] <- ScenePolish::mix_rgb(leaf, 0xffffffff, 0.2)
                    trees <- trees + 1
                elif kind < 0.6 and clear(&occupied, x, y, 3.0):
                    stone(list, p, area.size * py_uniform(&draw, 0.8, 1.4), area.size * 0.7)
                elif kind < 0.85 and clear(&occupied, x, y, 2.5):
                    colour: u32 = petals[py_randbelow(&draw, 4.u64()).usize()]
                    Display::draw_circle(list, p.x, p.y, fmax(1.2, area.size * 0.35), colour)
            for i in 0..<trees |list, highlights, radii, colours|:
                p: RailYard::Point = highlights[i.usize()]
                Display::draw_circle(list, p.x, p.y, radii[i.usize()], colours[i.usize()])

    def scenery(list: mutable Display::DisplayList&, area: Frame, yard: RailYard::Yard&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            w: f64 = RailYard::WORLD_W * s
            h: f64 = RailYard::WORLD_H * s
            low: u32 = 0x345432ff if dark else 0x689c54ff
            high: u32 = 0x486e40ff if dark else 0x8ec06eff
            panel: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: area.x - 6.0, y: area.y - 6.0, w: w + 12.0, h: h + 12.0}
            ScenePolish::shadow(list, &panel, 18.0, 4.0, dark)
            ScenePolish::rounded(list, &panel, 18.0, ScenePolish::mix_rgb(low, 0x000000ff, 0.25))
            for band in 0..<20 |list, area, w, h, low, high|:
                Display::draw_rect(list, area.x, area.y + h * band.f64() / 20.0, w, h / 20.0 + 1.0,
                    ScenePolish::mix_rgb(low, high, (band.f64() + 0.5) / 20.0))
            vegetation(list, area, yard)
            for layer in 0..<3 |list, area, yard|:
                for i in 0..<yard.layout.segment_count |list, area, yard, layer|:
                    track(list, area, &yard.layout.segments[i.usize()], layer)
            for i in 0..<yard.layout.node_count |list, area, yard, s|:
                node: RailYard::Node = yard.layout.nodes[i.usize()]
                x: f64 = node.point.x
                y: f64 = node.point.y
                if node.kind == RailYard::STATION:
                    colour: u32 = station_colour(node.index)
                    p: RailYard::Point = at(area, x + 1.0, y - 2.6)
                    roof: RailYard::Point = at(area, x + 0.4, y + 1.6)
                    shadows: u32[3] = [0x1428141e, 0x14281412, 0x1428140c]
                    for layer in 0..<3 |list, p, s, shadows|:
                        spread: f64 = layer.f64()
                        rounded(list, p.x - spread, p.y - 2.0 - spread, 9.0 * s + spread * 2.0,
                            5.2 * s + spread * 2.0, s * 0.8 + spread, shadows[layer.usize()])
                    rounded(list, p.x, p.y, 9.0 * s, 5.2 * s, s * 0.8, 0xece6d8ff)
                    rounded(list, roof.x, roof.y, 10.2 * s, 1.8 * s, s * 0.5, colour)
                    station_label(list, node.index, at(area, x + 5.5, y - 0.6), fmax(7.0, s * 2.4),
                        ScenePolish::mix_rgb(colour, 0x000000ff, 0.35))
                elif node.kind == RailYard::PORTAL:
                    center: RailYard::Point = at(area, x - 1.0, y)
                    tunnel(list, center, 5.2 * s, 0x787068ff)
                    tunnel(list, center, 3.6 * s, 0x16161cff)
                elif node.kind == RailYard::SWITCH and node.index < 9:
                    value: mutable dstr = []
                    dstr_append_i64(&value, node.index + 1)
                    label(list, bytes_view(value), at(area, x - 2.2, y + 4.4), fmax(7.0, s * 1.9), 0xffffffe6, true)

    def tunnel(list: mutable Display::DisplayList&, p: RailYard::Point, r: f64, colour: u32):
        can Abort.Panic, Memory.Allocate:
            Display::begin_polygon(list, 17, p.x, p.y - r, colour)
            for i in 0..<17 |list, p, r|:
                angle: f64 = (i.f64() / 16.0 - 0.5) * PI
                Display::polygon_point(list, p.x + r * cos(angle), p.y + r * sin(angle))

    def controls(list: mutable Display::DisplayList&, area: Frame, run: RailYard::Run&):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            switches: i64 = (1 << run.yard.level.depth) - 1
            for i in 0..<switches |list, area, run, s|:
                node: RailYard::Node = run.yard.layout.nodes[i.usize()]
                points: RailYard::Points = run.points[i.usize()]
                moving: bool = points.moving > 0.0
                colour: u32 = 0xff8028ff if moving else 0xffd640ff
                seg: RailYard::Segment& = &run.yard.layout.segments[node.out[points.target.usize()].usize()]
                center: RailYard::Point = at(area, node.point.x, node.point.y)
                previous: mutable RailYard::Point = center
                reach: i64 = fmin(7.0, seg.length * 0.5).i64()
                for d in 1..<(reach + 1) |list, area, seg, previous, colour, s|:
                    pos: RailYard::Position = RailYard::position(seg, d.f64())
                    p: RailYard::Point = at(area, pos.point.x, pos.point.y)
                    Display::draw_line(list, previous.x, previous.y, p.x, p.y, 1.3 * s, colour)
                    previous <- p
                Display::draw_circle(list, center.x, center.y, 2.2 * s, 0x282c38ff)
                Display::draw_circle(list, center.x, center.y, 1.5 * s, colour)
                if moving:
                    share: f64 = 1.0 - points.moving / run.yard.level.throw_seconds
                    ScenePolish::arc(list, center.x, center.y, 3.0 * s, PI / 2.0, -2.0 * PI * share, fmax(2.0, 0.6 * s), colour)
            for i in 0..<run.yard.level.portals |list, area, run, s|:
                node: RailYard::Node = portal_node(&run.yard.layout, i)
                lamp: RailYard::Point = at(area, node.point.x + 3.0, node.point.y + 6.5)
                base: RailYard::Point = at(area, node.point.x + 3.0, node.point.y + 2.0)
                colour: u32 = 0x3cdc6eff if run.signals[i.usize()] else 0xec4038ff
                Display::draw_line(list, base.x, base.y, lamp.x, lamp.y, fmax(1.5, 0.5 * s), 0x3c3e46ff)
                ScenePolish::glow(list, lamp.x, lamp.y, 3.6 * s, colour, 150)
                Display::draw_circle(list, lamp.x, lamp.y, 1.9 * s, 0x1e1e24ff)
                Display::draw_circle(list, lamp.x, lamp.y, 1.4 * s, colour)
                queue: mutable i64 = 0
                for j in 0..<run.yard.level.trains |list, area, run, s, i, node, queue|:
                    plan: RailYard::TrainPlan = run.yard.plans[j.usize()]
                    if run.trains[j.usize()].state == RailYard::WAITING and plan.portal == i:
                        p: RailYard::Point = at(area, node.point.x - 2.5 + queue.f64() * 2.4, node.point.y - 6.0)
                        Display::draw_circle(list, p.x, p.y, s, station_colour(plan.station))
                        queue <- queue + 1

    def train_point(area: Frame, pos: RailYard::Position, dx: f64, dy: f64) -> RailYard::Point:
        ca: f64 = cos(pos.heading)
        sa: f64 = sin(pos.heading)
        return at(area, pos.point.x + dx * ca - dy * sa, pos.point.y + dx * sa + dy * ca)

    def train_shape(list: mutable Display::DisplayList&, area: Frame, pos: RailYard::Position, xs: f64[5], ys: f64[5], count: i64, colour: u32):
        can Abort.Panic, Memory.Allocate:
            first: RailYard::Point = train_point(area, pos, xs[0], ys[0])
            Display::begin_polygon(list, count, first.x, first.y, colour)
            for i in 0..<count |list, area, pos, xs, ys|:
                p: RailYard::Point = train_point(area, pos, xs[i.usize()], ys[i.usize()])
                Display::polygon_point(list, p.x, p.y)

    def trains(list: mutable Display::DisplayList&, area: Frame, run: RailYard::Run&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            count: i64 = run.yard.level.trains
            chip: f64 = fmin(WIDTH * 0.94 * 0.8 / count.f64(), area.height * 0.05)
            cy: f64 = area.y + area.height - chip * 0.7
            for i in 0..<count |list, area, run, dark, s, count, chip, cy|:
                train: RailYard::Train = run.trains[i.usize()]
                plan: RailYard::TrainPlan = run.yard.plans[i.usize()]
                colour: u32 = station_colour(plan.station)
                if train.state == RailYard::RUNNING or train.state == RailYard::LOST:
                    pos: RailYard::Position = RailYard::position(&run.yard.layout.segments[train.segment.usize()], train.distance)
                    length: f64 = RailYard::TRAIN_LENGTH * (1.75 if plan.express else 1.3)
                    if train.state == RailYard::RUNNING:
                        for k in 0..<4 |list, area, run, i, s, pos, length|:
                            back: f64 = length + 1.0 + k.f64() * 1.6
                            wobble: f64 = sin(run.elapsed * 6.0 + k.f64() + i.f64()) * 0.5
                            p: RailYard::Point = train_point(area, pos, -back + length * 0.75, 2.0 + k.f64() * 0.9 + wobble)
                            Display::draw_circle(list, p.x, p.y, (0.9 + k.f64() * 0.45) * s, 0xebebf000.u32() | (150 - k * 38).u32())
                    train_shape(list, area, pos, [-length + 0.5, 0.5, 0.5, -length + 0.5, 0.0],
                        [-2.35, -2.35, 1.15, 1.15, 0.0], 4, 0x141e1450)
                    train_shape(list, area, pos, [-length, 0.0, 0.9, 0.0, -length], [-1.75, -1.75, 0.0, 1.75, 1.75],
                        5, ScenePolish::mix_rgb(colour, 0x000000ff, 0.3))
                    train_shape(list, area, pos, [-length + 0.35, -0.2, 0.5, -0.2, -length + 0.35],
                        [-1.4, -1.4, 0.0, 1.4, 1.4], 5, colour)
                    if plan.express:
                        train_shape(list, area, pos, [-length + 0.4, -0.3, -0.3, -length + 0.4, 0.0],
                            [-0.25, -0.25, 0.25, 0.25, 0.0], 4, 0xffffffff)
                    train_shape(list, area, pos, [-2.0, -0.7, -0.7, -2.0, 0.0], [-1.0, -1.0, 1.0, 1.0, 0.0], 4, 0xe6f4ffff)
                    station_label(list, plan.station, train_point(area, pos, -length * 0.55, 0.0), fmax(7.0, s * 1.8), 0xffffffff)
                center: RailYard::Point = RailYard::Point{x: WIDTH / 2.0 + chip * (i.f64() - (count - 1).f64() / 2.0), y: cy}
                if train.state == RailYard::DUE or train.state == RailYard::WAITING:
                    ScenePolish::ring(list, center.x, center.y, chip * 0.32, 2.0, colour, 32)
                else:
                    failed: bool = train.state == RailYard::WRONG or train.state == RailYard::LOST
                    muted: u32 = 0x969eb0ff if dark else 0x70788aff
                    Display::draw_circle(list, center.x, center.y, chip * 0.34, muted if failed else colour)
                    if failed or train.state == RailYard::RIGHT:
                        label(list, "×" if failed else "✓", center, chip * (0.36 if failed else 0.32), 0xffffffff, true)
            if run.result == RailYard::COLLISION or run.result == RailYard::DERAILMENT:
                p: RailYard::Point = at(area, run.crash.x, run.crash.y)
                Display::draw_star(list, p.x, p.y, 6.0 * s, 2.6 * s, 10, 0.0, 0xffaa28ff)
                Display::draw_star(list, p.x, p.y, 3.6 * s, 1.4 * s, 8, 0.0, 0xfff0a0ff)

    def verdict(run: RailYard::Run&, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            if run.result == RailYard::COLLISION:
                dstr_append_cstr(out, "Trains ")
                dstr_append_i64(out, run.first_train + 1)
                dstr_append_cstr(out, " and ")
                dstr_append_i64(out, run.second_train + 1)
                dstr_append_cstr(out, " collided")
            elif run.result == RailYard::DERAILMENT:
                dstr_append_cstr(out, "Train ")
                dstr_append_i64(out, run.first_train + 1)
                dstr_append_cstr(out, " derailed on points that were still moving")
            elif run.result != RailYard::LIVE:
                timed: bool = run.result == RailYard::TIMEOUT or run.result == RailYard::CLEAR_AT_TIMEOUT
                dstr_append_cstr(out, "Time: ") if timed
                dstr_append_i64(out, run.right)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, run.yard.level.trains)
                dstr_append_cstr(out, " trains home" if timed else " trains at their own station")

    def render(list: mutable Display::DisplayList&, session: RailYardGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            label(list, "Rail Yard", RailYard::Point{x: 456.0, y: 648.0}, 22.0, ink, true)
            label(list, "click points to throw them (1-9)   click a signal (Q, W)   Esc: menu",
                RailYard::Point{x: 456.0, y: 26.0}, 12.0, ink)
            caption: mutable dstr = []
            verdict(&session.yard, &caption)
            status: mutable dstr = []
            if session.phase == RailYardGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == RailYardGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == RailYardGame::JUDGED:
                status <- caption
            else:
                dstr_append_cstr(&status, "Every train to the station of its colour")
            label(list, bytes_view(status), RailYard::Point{x: 456.0, y: 614.0}, 14.0, ink)
            if session.phase == RailYardGame::PLAYING or session.phase == RailYardGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   home ")
                dstr_append_i64(&facts, session.yard.right)
                dstr_append_cstr(&facts, " of ")
                dstr_append_i64(&facts, session.yard.yard.level.trains)
                dstr_append_cstr(&facts, "   ")
                dstr_append_i64(&facts, fmax(0.0, session.yard.yard.seconds - session.yard.elapsed).i64())
                dstr_append_cstr(&facts, " s left")
                label(list, bytes_view(facts), RailYard::Point{x: 456.0, y: 588.0}, 12.0, ink)
                area: Frame = frame()
                scenery(list, area, &session.yard.yard, dark)
                controls(list, area, &session.yard)
                trains(list, area, &session.yard, dark)
            if caption.count > 0:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, RailYardGame::passed_verdict(session.verdict),
                    bytes_view(caption), 60.0, 16.0)

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: RailYard::Grade = RailYard::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, 1 << level.depth)
            dstr_append_cstr(out, " stations, ")
            dstr_append_i64(out, level.trains)
            dstr_append_cstr(out, " trains, ")
            dstr_append_cstr(out, "one tunnel." if level.portals == 1 else "two tunnels.")
            if level.throw_seconds > 0.0:
                tenths: i64 = (RailYard::round_decimal(level.throw_seconds, 10.0) * 10.0).i64()
                dstr_append_cstr(out, "  Points take ")
                dstr_append_i64(out, tenths / 10)
                dstr_append_cstr(out, ".")
                dstr_append_i64(out, tenths % 10)
                dstr_append_cstr(out, " s to throw.")
            dstr_append_cstr(out, "  Express trains catch up.") if level.express > 0.0
