include "./tasks/balance_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"

module SceneBalance:
    const CX: f64 = 456.0
    const WIDTH: f64 = 857.28
    const SCALE: f64 = WIDTH / Balance::TRACK
    const LEFT: f64 = CX - WIDTH / 2.0
    const BOTTOM: f64 = 179.0
    const WORLD_H: f64 = 12.0
    const GROUND: f64 = 2.0
    const RAD: f64 = 0.017453292519943295

    def clamp_unit(value: f64) -> f64:
        return 0.0 if value < 0.0 else (1.0 if value > 1.0 else value)

    def gradient(list: mutable Display::DisplayList&, height: f64, low: u32, high: u32, bands: i64):
        can Memory.Allocate, Abort.Panic:
            step: f64 = height / bands.f64()
            for band in 0..<bands |list, step, low, high, bands|:
                colour: u32 = ScenePolish::mix_rgb(low, high, (band.f64() + 0.5) / bands.f64())
                Display::draw_rect(list, LEFT, BOTTOM + band.f64() * step, WIDTH, step + 1.0, colour)

    def scenery(list: mutable Display::DisplayList&, course: Balance::Course&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            area: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT, y: BOTTOM, w: WIDTH, h: WORLD_H * SCALE}
            frame: SceneHiddenRule::Rect = ScenePolish::spread_box(&area, 6.0)
            ScenePolish::card_face(list, &frame, 14.0, 0x3c2846ff, 0.u32(), 0.u32(), dark)
            gradient(list, WORLD_H * SCALE, 0xfaa05aff, 0x463278ff, 24)
            sun_x: f64 = LEFT + Balance::TRACK * 0.7 * SCALE
            sun_y: f64 = BOTTOM + 4.2 * SCALE
            ScenePolish::glow(list, sun_x, sun_y, 4.0 * SCALE, 0xffc878ff, 110)
            Display::draw_circle(list, sun_x, sun_y, 1.4 * SCALE, 0xffd68cff)
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, (course.level.count * 7 + course.gust_seed % 97).u64())
            x: mutable f64 = 0.0
            ground_y: f64 = BOTTOM + GROUND * SCALE
            while x < Balance::TRACK |list, rng, x, ground_y|:
                size: f64 = Balance::uniform(&rng, 2.5, 6.0)
                w: f64 = size if size < Balance::TRACK - x else Balance::TRACK - x
                h: f64 = Balance::uniform(&rng, 1.0, 3.2) * SCALE
                px: f64 = LEFT + x * SCALE
                Display::begin_polygon(list, 4, px, ground_y, 0x78465aff)
                Display::polygon_point(list, px, ground_y)
                Display::polygon_point(list, px + w * 0.15 * SCALE, ground_y + h)
                Display::polygon_point(list, px + w * 0.85 * SCALE, ground_y + h)
                Display::polygon_point(list, px + w * SCALE, ground_y)
                x <- x + (w + Balance::uniform(&rng, 0.5, 3.0))
            gradient(list, GROUND * SCALE, 0x96603cff, 0xc48450ff, 6)
            rail: f64 = BOTTOM + (GROUND - 0.35) * SCALE
            for i in 0..<45 |list, rail|:
                Display::draw_rect(list, LEFT + i.f64() * SCALE / 1.5, rail - 0.2 * SCALE, 0.3 * SCALE, 0.35 * SCALE, 0x5a3c28ff)
            Display::draw_rect(list, LEFT, rail, WIDTH, 0.12 * SCALE, 0xc8c8d2ff)
            for end in 0..<2 |list|:
                px: f64 = LEFT if end == 0 else LEFT + WIDTH - 0.6 * SCALE
                Display::draw_rect(list, px, BOTTOM + (GROUND - 0.4) * SCALE, 0.6 * SCALE, 0.9 * SCALE, 0xc83c32ff)

    def flags(list: mutable Display::DisplayList&, run: Balance::Trial&):
        can Memory.Allocate, Abort.Panic:
            hues: u32[6] = [0xec4850ff, 0x3c96ecff, 0xfac432ff, 0x5ac878ff, 0xb464e6ff, 0xf0823cff]
            y: f64 = BOTTOM + GROUND * SCALE
            for i in 0..<run.course.level.count |list, run, hues, y|:
                x: f64 = LEFT + run.course.flags[i.usize()] * SCALE
                hue: u32 = hues[i.usize()]
                active: bool = i == run.flag
                if active:
                    ScenePolish::glow(list, x, y + 3.2 * SCALE, 1.8 * SCALE, hue, 110)
                Display::draw_line(list, x, y, x, y + 3.6 * SCALE, 2.0, 0xe6dcd2ff)
                wave: f64 = sin(run.time * 4.0 + i.f64()) * 0.15 * SCALE
                Display::draw_triangle(list, x, y + 3.6 * SCALE, x, y + 2.8 * SCALE,
                    x + 1.1 * SCALE, y + 3.2 * SCALE + wave, 0x5ad278ff if i < run.flag else hue)
                if active:
                    Display::draw_box(list, x - 0.8 * SCALE, y - 0.2 * SCALE, 1.6 * SCALE, 0.3 * SCALE, hue, 2.0)
                    if run.still > 0.0:
                        ScenePolish::arc(list, x, y + 3.2 * SCALE, 0.9 * SCALE, 90.0 * RAD, 360.0 * RAD * run.still, 3.0, 0x78f096ff)
                label: mutable dstr = []
                dstr_append_i64(&label, i + 1)
                Display::draw_text_weight(list, bytes_view(label), x - 0.4 * SCALE, y + 3.6 * SCALE,
                    0.5 * SCALE, 0xffffffe6, Display::ANCHOR_CENTER_CENTER, true)

    def wrap(x: f64, span: f64) -> f64:
        return x - floor(x / span) * span

    def wind(list: mutable Display::DisplayList&, run: Balance::Trial&):
        can Memory.Allocate, Abort.Panic:
            return if run.course.level.gusts == 0.0
            gust: f64 = Balance::gust(run)
            direction: f64 = -1.0 if gust < 0.0 else 1.0
            stroke: f64 = direction * 1.2 * SCALE * clamp_unit(Balance::magnitude(gust))
            for i in 0..<10 |list, run, gust, stroke|:
                x: f64 = LEFT + wrap(i.f64() * 3.3 + run.time * gust * 6.0, Balance::TRACK) * SCALE
                y: f64 = BOTTOM + (GROUND + 0.5 + wrap(i.f64() * 1.7, 7.0)) * SCALE
                Display::draw_line(list, x, y, x - stroke, y, 1.0, 0xffe6c878)
            weed: f64 = LEFT + wrap(run.time * gust * 2.5 + 7.0, Balance::TRACK) * SCALE
            ScenePolish::arc(list, weed, BOTTOM + (GROUND + 0.4) * SCALE, 0.4 * SCALE, 0.0, 360.0 * RAD, 2.0, 0x966e3cff)

    def cart(list: mutable Display::DisplayList&, run: Balance::Trial&):
        can Memory.Allocate, Abort.Panic:
            x: f64 = LEFT + run.x * SCALE
            y: f64 = BOTTOM + GROUND * SCALE
            pivot: f64 = y + 0.8 * SCALE
            pole: f64 = Balance::length(run) * 1.7 * SCALE
            tx: f64 = x + sin(run.theta) * pole
            ty: f64 = pivot + cos(run.theta) * pole
            ScenePolish::glow(list, tx, ty, 1.6 * SCALE, 0xffd278ff, 120)
            base: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: x - 1.1 * SCALE, y: y, w: 2.2 * SCALE, h: 0.8 * SCALE}
            ScenePolish::rounded(list, &base, 0.15 * SCALE, 0xc44036ff)
            Display::draw_rect(list, base.x, y + 0.6 * SCALE, base.w, 0.12 * SCALE, 0xface50ff)
            spin: f64 = -run.x / 0.3
            for side in 0..<2 |list, x, y, spin|:
                wheel: f64 = x + (0.65 if side == 1 else -0.65) * SCALE
                Display::draw_circle(list, wheel, y, 0.32 * SCALE, 0x282832ff)
                Display::draw_line(list, wheel, y, wheel + cos(spin) * 0.28 * SCALE,
                    y + sin(spin) * 0.28 * SCALE, 2.0, 0xdcdce6ff)
            if run.pushing != 0:
                for i in 0..<3 |list, run, x, y|:
                    px: f64 = x - run.pushing.f64() * (1.3 + 0.3 * i.f64()) * SCALE
                    Display::draw_circle(list, px, y + 0.1 * SCALE, (0.15 + 0.06 * i.f64()) * SCALE,
                        0xe6c8a000 | (160 - 40 * i).u32())
            danger: f64 = Balance::magnitude(run.theta) / Balance::FALLEN
            Display::draw_line(list, x, pivot, tx, ty, 0.16 * SCALE, ScenePolish::mix_rgb(0xf0e6d2ff, 0xff503cff, clamp_unit(danger)))
            for i in 1..<4 |list, x, pivot, tx, ty|:
                f: f64 = i.f64() / 4.0
                Display::draw_circle(list, x + (tx - x) * f, pivot + (ty - pivot) * f, 0.1 * SCALE, 0xc83c32ff)
            Display::draw_circle(list, tx, ty, 0.32 * SCALE, 0xffe296ff)
            gauge(list, x, y + 0.4 * SCALE, run.theta, danger)

    def gauge(list: mutable Display::DisplayList&, x: f64, y: f64, theta: f64, danger: f64):
        can Memory.Allocate, Abort.Panic:
            r: f64 = 0.55 * SCALE
            Display::begin_polygon(list, 17, x, y, 0x281e28ff)
            Display::polygon_point(list, x, y)
            for i in 0..<16 |list, x, y, r|:
                a: f64 = (55.0 + 70.0 * i.f64() / 15.0) * RAD
                Display::polygon_point(list, x + cos(a) * r, y + sin(a) * r)
            a: f64 = 90.0 * RAD - theta
            Display::draw_line(list, x, y, x + cos(a) * 0.5 * SCALE, y + sin(a) * 0.5 * SCALE, 2.0,
                ScenePolish::mix_rgb(0x78f096ff, 0xff463cff, clamp_unit(danger * 1.3)))

    def paint_trial(list: mutable Display::DisplayList&, run: Balance::Trial&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            scenery(list, &run.course, dark)
            wind(list, run)
            flags(list, run)
            cart(list, run)
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT, y: BOTTOM + (WORLD_H + 0.3) * SCALE,
                w: WIDTH, h: 0.6 * SCALE}
            ScenePolish::rounded(list, &box, 0.3 * SCALE, 0xc8bed2ff)
            share: f64 = clamp_unit(1.0 - run.time / run.course.level.seconds)
            if share > 0.02:
                fill: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: box.x, y: box.y, w: WIDTH * share, h: box.h}
                ScenePolish::rounded(list, &fill, 0.3 * SCALE, ScenePolish::mix_rgb(0xec5040ff, 0x3cbe78ff, clamp_unit(share * 1.6)))

    def render(list: mutable Display::DisplayList&, session: BalanceGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Balance", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Left / Right: push the cart   stop under the lit flag   Esc: menu",
                CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            msg: mutable dstr = []
            if session.phase == BalanceGame::READY:
                dstr_append_cstr(&msg, "Press Space or click to start")
            elif session.phase == BalanceGame::DONE:
                dstr_append_i64(&msg, session.passed_count)
                dstr_append_cstr(&msg, " of ")
                dstr_append_i64(&msg, session.trial)
                dstr_append_cstr(&msg, " passed   highest rung passed ")
                dstr_append_i64(&msg, session.best_rung)
            elif session.phase == BalanceGame::JUDGED:
                Balance::result_text(&session.run, &msg)
            else:
                dstr_append_cstr(&msg, "Keep the pole up; stop under each lit flag")
            Display::draw_text(list, bytes_view(msg), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if session.phase >= BalanceGame::JUDGED and session.run.result != Balance::PENDING:
                verdict: mutable dstr = []
                Balance::result_text(&session.run, &verdict)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.run.result == Balance::PASSED, bytes_view(verdict), 60.0, 16.0)
            return if session.phase == BalanceGame::READY or session.phase == BalanceGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.total)
            dstr_append_cstr(&facts, "   flag ")
            count: i64 = session.run.course.level.count
            dstr_append_i64(&facts, session.run.flag + 1 if session.run.flag < count else count)
            dstr_append_cstr(&facts, " of ")
            dstr_append_i64(&facts, count)
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            paint_trial(list, &session.run, dark)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Balance::Grade = Balance::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.count)
            dstr_append_cstr(out, " flags, a ")
            dstr_append_fixed(out, level.length, 1)
            dstr_append_cstr(out, " m pole.")
            if level.gusts != 0.0:
                dstr_append_cstr(out, "  Gusts.")
            if level.changes:
                dstr_append_cstr(out, "  The pole changes length partway.")
