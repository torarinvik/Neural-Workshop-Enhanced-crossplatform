include "./drshape_deal.elisa"
include "../tone_pcm.elisa"

module DrShapeAudio:
    const RATE: i64 = TonePcm::RATE
    const SINE: i64 = 0
    const FLUTE: i64 = 1
    const ORGAN: i64 = 2
    const GLASS: i64 = 3
    const CLARINET: i64 = 4
    const PLUCK: i64 = 5
    const BELL: i64 = 6
    const WOOD: i64 = 7
    const PAD: i64 = 8
    const BRASS: i64 = 9
    const METAL: i64 = 10
    const CHIRP: i64 = 11
    const GROWL: i64 = 12
    const SQUARE: i64 = 13
    const SUB: i64 = 14
    const ALIEN: i64 = 15
    const ZAP: i64 = 16
    const HISS: i64 = 17
    const SPARE: i64 = 6
    const PATCH_COUNT: i64 = 10
    const PI_OVER_FOUR: f64 = 0.7853981633974483

    struct Tap:
        delay: f64
        gain: f64
        pan: f64

    struct Patch:
        name: mutable i64
        partials: mutable TonePcm::Partial[7]
        count: mutable i64
        attack: mutable f64
        decay: mutable f64
        sustain: mutable f64
        release: mutable f64
        fm_ratio: mutable f64
        fm_index: mutable f64
        fm_decay: mutable f64
        vibrato_rate: mutable f64
        vibrato_depth: mutable f64
        tremolo_rate: mutable f64
        tremolo_depth: mutable f64
        glide: mutable f64
        glide_time: mutable f64
        noise: mutable f64
        drive: mutable f64
        fold: mutable f64
        ring_ratio: mutable f64
        ring_mix: mutable f64
        taps: mutable Tap[2]
        tap_count: mutable i64

    def add(p: mutable Patch&, ratio: f64, gain: f64 = 1.0, decay: f64 = 0.0):
        can Abort.Panic:
            p.partials[p.count.usize()] <- TonePcm::Partial{ratio: ratio, gain: gain, decay: decay}
            p.count <- p.count + 1

    def envelope(p: mutable Patch&, attack: f64, decay: f64, sustain: f64, release: f64):
        p.attack <- attack
        p.decay <- decay
        p.sustain <- sustain
        p.release <- release

    def fm(p: mutable Patch&, ratio: f64, index: f64, decay: f64):
        p.fm_ratio <- ratio
        p.fm_index <- index
        p.fm_decay <- decay

    def j(rng: mutable MT19937&, lo: f64 = 0.9, hi: f64 = 1.1) -> f64:
        can Abort.Panic:
            return py_uniform(rng, lo, hi)

    def saw(p: mutable Patch&, n: i64, decay: f64 = 0.0):
        can Abort.Panic:
            for i in 1..<(n + 1) |p, decay|:
                r: f64 = i.f64()
                add(p, r, 1.0 / r, decay * r)

    def base_patch(p: mutable Patch&, name: i64, rng: mutable MT19937&):
        can Abort.Panic:
            if name == SINE:
                add(p, 1.0)
                envelope(p, 0.01, 2.5 * j(rng), 0.3, 0.2)
            elif name == FLUTE:
                add(p, 1.0)
                add(p, 2.0, 0.15)
                add(p, 3.0, 0.05)
                envelope(p, 0.06, 0.5, 0.7, 0.15)
                p.vibrato_rate <- 5.0 * j(rng)
                p.vibrato_depth <- 0.004
                p.noise <- 0.07 * j(rng)
            elif name == ORGAN:
                add(p, 1.0)
                add(p, 2.0, 0.6 * j(rng))
                add(p, 3.0, 0.4 * j(rng))
                add(p, 4.0, 0.25)
                add(p, 6.0, 0.15)
                add(p, 8.0, 0.1 * j(rng))
                envelope(p, 0.015, 0.0, 1.0, 0.08)
            elif name == CLARINET:
                add(p, 1.0)
                add(p, 3.0, 0.55 * j(rng))
                add(p, 5.0, 0.33)
                add(p, 7.0, 0.2 * j(rng))
                add(p, 9.0, 0.12)
                envelope(p, 0.04, 0.8, 0.8, 0.1)
            elif name == BRASS:
                saw(p, 7)
                fm(p, 1.0, 1.5 * j(rng), 3.0)
                envelope(p, 0.04, 1.0, 0.6, 0.1)
                p.glide <- -0.03
                p.glide_time <- 0.05
            elif name == PLUCK:
                saw(p, 6, 1.5 * j(rng))
                envelope(p, 0.003, 4.0 * j(rng), 0.0, 0.1)
            elif name == BELL:
                add(p, 1.0)
                add(p, 2.76 * j(rng, 0.97, 1.03), 0.5, 1.0)
                add(p, 5.4 * j(rng, 0.97, 1.03), 0.25, 2.0)
                ratio: f64 = 3.5 * j(rng, 0.97, 1.03)
                fm(p, ratio, 3.0 * j(rng), 2.5)
                envelope(p, 0.002, 1.8 * j(rng), 0.0, 0.4)
            elif name == GLASS:
                add(p, 1.0)
                add(p, 2.32 * j(rng, 0.97, 1.03), 0.6, 0.8)
                add(p, 4.25 * j(rng, 0.97, 1.03), 0.4, 1.6)
                add(p, 6.63, 0.25, 2.5)
                envelope(p, 0.005, 1.2 * j(rng), 0.0, 0.5)
            elif name == WOOD:
                add(p, 1.0)
                add(p, 3.9 * j(rng, 0.95, 1.05), 0.5, 6.0)
                add(p, 9.2 * j(rng, 0.95, 1.05), 0.25, 12.0)
                envelope(p, 0.002, 9.0 * j(rng), 0.0, 0.05)
            elif name == PAD:
                add(p, 1.0, 0.7)
                add(p, 1.004 + 0.006 * py_random(rng), 0.7)
                add(p, 2.0, 0.3)
                add(p, 0.5, 0.3)
                envelope(p, 0.15, 0.3, 0.8, 0.3)
                p.tremolo_rate <- 3.0 * j(rng)
                p.tremolo_depth <- 0.3
            elif name == GROWL:
                add(p, 1.0)
                fm(p, 0.5, 4.0 * j(rng), 0.5)
                envelope(p, 0.02, 1.5, 0.5, 0.1)
                p.drive <- 2.5 * j(rng)
            elif name == CHIRP:
                add(p, 1.0)
                add(p, 2.0, 0.3)
                envelope(p, 0.005, 5.0 * j(rng), 0.0, 0.08)
                p.glide <- 1.0 if py_choice_index(rng, 2) == 0 else -0.5
                p.glide_time <- 0.04 * j(rng)
            elif name == METAL:
                add(p, 1.0)
                add(p, 1.41, 0.8, 1.0)
                add(p, 2.83, 0.5, 2.0)
                add(p, 4.1 * j(rng, 0.97, 1.03), 0.4, 3.0)
                envelope(p, 0.002, 2.5 * j(rng), 0.0, 0.3)
                p.ring_ratio <- 2.7 * j(rng)
                p.ring_mix <- 0.5
            elif name == SQUARE:
                for i in 0..<5 |p|:
                    r: f64 = (2 * i + 1).f64()
                    add(p, r, 1.0 / r)
                envelope(p, 0.005, 1.0, 0.6, 0.05)
            elif name == SUB:
                add(p, 0.5)
                add(p, 1.0, 0.5)
                envelope(p, 0.01, 2.0, 0.3, 0.1)
                p.drive <- 1.5
            elif name == ALIEN:
                add(p, 1.0)
                add(p, 1.5, 0.4)
                ratio: f64 = j(rng, 0.3, 3.3)
                fm(p, ratio, j(rng, 2.0, 8.0), 1.0)
                envelope(p, 0.01, 1.5, 0.5, 0.15)
                p.vibrato_rate <- 9.0 * j(rng)
                p.vibrato_depth <- 0.03
                p.fold <- 2.2 * j(rng)
            elif name == ZAP:
                add(p, 1.0)
                fm(p, 7.1 * j(rng), 6.0, 6.0)
                envelope(p, 0.002, 10.0 * j(rng), 0.0, 0.05)
                p.glide <- 2.0
                p.glide_time <- 0.03
            elif name == HISS:
                envelope(p, 0.005, 8.0 * j(rng), 0.0, 0.05)
                p.noise <- 1.0

    def make_patch(name: i64, rng: mutable MT19937&, wild: f64) -> Patch:
        can Abort.Panic:
            p: mutable Patch = zeroed
            base_patch(&p, name, rng)
            if wild > 0.0:
                if py_random(rng) < wild * 0.5:
                    p.vibrato_rate <- j(rng, 3.0, 12.0)
                    p.vibrato_depth <- j(rng, 0.005, 0.04)
                if py_random(rng) < wild * 0.4:
                    p.tremolo_rate <- j(rng, 2.0, 14.0)
                    p.tremolo_depth <- j(rng, 0.2, 0.7)
                if py_random(rng) < wild * 0.3:
                    p.drive <- j(rng, 1.5, 4.0)
                if py_random(rng) < wild * 0.25:
                    p.fold <- j(rng, 1.5, 3.0)
                if py_random(rng) < wild * 0.3:
                    p.ring_ratio <- j(rng, 0.5, 4.0)
                    p.ring_mix <- j(rng, 0.3, 0.8)
                if py_random(rng) < wild * 0.3:
                    p.glide <- j(rng, -0.6, 1.2)
                    p.glide_time <- j(rng, 0.02, 0.1)
                if py_random(rng) < wild * 0.3:
                    p.tap_count <- py_randint(rng, 1, 2)
                    for i in 0..<p.tap_count |p, rng|:
                        delay: f64 = j(rng, 0.1, 0.3) * (i + 1).f64()
                        pan: f64 = -1.0 if py_choice_index(rng, 2) == 0 else -0.5
                        p.taps[i.usize()] <- Tap{delay: delay, gain: 0.45 / (i + 1).f64(), pan: pan}
                if py_random(rng) < wild * 0.2:
                    p.noise <- j(rng, 0.05, 0.3)
            p.name <- name
            return p

    struct Bank:
        patches: mutable Patch[13]
        count: mutable i64

    def patches(level: DrShape::Grade&, rng: mutable MT19937&) -> Bank:
        can Memory.Allocate, Abort.Panic:
            out: mutable Bank = zeroed
            out.count <- PATCH_COUNT
            chosen: darray[i64] = py_sample_range(rng, 0, level.instruments - 1, DrShape::TINTS)
            taken: mutable i64 = 0
            for i in 0..<DrShape::TINTS |out, level, rng, chosen, taken|:
                name: i64 = get chosen[i.usize()] else 0
                taken <- taken | (1 << name)
                out.patches[i.usize()] <- make_patch(name, rng, level.wild)
            if level.echo_voice:
                alternatives: mutable i64[17] = zeroed
                count: mutable i64 = 0
                for i in 0..<level.instruments |alternatives, count, taken|:
                    if (taken & (1 << i)) == 0:
                        alternatives[count.usize()] <- i
                        count <- count + 1
                echo: darray[i64] = py_sample_range(rng, 0, count - 1, DrShape::TINTS)
                for i in 0..<DrShape::TINTS |echo, alternatives, out, rng, level|:
                    selected: i64 = get echo[i.usize()] else 0
                    out.patches[(i + DrShape::TINTS).usize()] <- make_patch(alternatives[selected.usize()], rng, level.wild)
            else:
                for i in 0..<DrShape::TINTS |out|:
                    out.patches[(i + DrShape::TINTS).usize()] <- out.patches[i.usize()]
            for i in SPARE..<PATCH_COUNT |out, rng, level|:
                name: i64 = py_choice_index(rng, level.instruments)
                out.patches[i.usize()] <- make_patch(name, rng, level.wild)
            return out

    def add_noise_patches(bank: mutable Bank&, rng: mutable MT19937&):
        can Abort.Panic:
            names: i64[6] = [HISS, ZAP, CHIRP, WOOD, METAL, ALIEN]
            for i in PATCH_COUNT..<(PATCH_COUNT + 3) |bank, rng, names|:
                name: i64 = names[py_choice_index(rng, 6).usize()]
                bank.patches[i.usize()] <- make_patch(name, rng, 1.0)
            bank.count <- PATCH_COUNT + 3

    struct Source:
        left: i64
        right: i64
        gain: f64
        pan: f64
        fixed: bool

    def reflection(tap: Tap, mid: f64, left_lag: i64, right_lag: i64, rate: i64) -> Source:
        can Abort.Panic:
            delay: i64 = py_round_half_even(tap.delay * rate.f64())
            return Source{left: delay + right_lag, right: delay + left_lag, gain: tap.gain, pan: mid * tap.pan, fixed: true}

    def mix_source(output: mutable darray[f64]&, frames: i64, buf: darray[f64]&, base: i64, qlo: i64, qhi: i64,
            duration_samples: f64, note: DrShapeDeal::Note&, source: Source):
        can Abort.Panic:
            angle: f64 = (source.pan + 1.0) * PI_OVER_FOUR
            first: f64 = (note.pan + 1.0) * PI_OVER_FOUR
            last: f64 = (note.pan2 + 1.0) * PI_OVER_FOUR
            fixed_gain: f64 = source.gain * 0.5 * (note.gain + note.gain2)
            for side in 0..<2 |source, note, angle, first, last, fixed_gain, base, frames, qlo, qhi, duration_samples, buf, output|:
                lag: i64 = source.left if side == 0 else source.right
                offset: i64 = qlo - base + lag
                past: i64 = qhi - base + lag
                begin: i64 = offset if offset > 0 else 0
                end: i64 = past if past < frames else frames
                g0: f64 = (cos(first) if side == 0 else sin(first)) * note.gain
                g1: f64 = (cos(last) if side == 0 else sin(last)) * note.gain2
                gf: f64 = (cos(angle) if side == 0 else sin(angle)) * fixed_gain
                for i in begin..<end |base, lag, qlo, duration_samples, source, g0, g1, gf, buf, output, side|:
                    q: i64 = base + i - lag
                    position: f64 = q.f64() / duration_samples
                    gain: f64 = gf if source.fixed else g0 + (g1 - g0) * (1.0 if position > 1.0 else position)
                    at: usize = (2 * i + side).usize()
                    output[at] <- output[at] + gain * buf[(q - qlo).usize()]

    def mix(output: mutable darray[f64]&, frames: i64, begin: f64, end: f64, rate: i64, p: Patch&, note: DrShapeDeal::Note&):
        can Memory.Allocate, Abort.Panic:
            return if note.t >= end
            span: f64 = note.dur + p.release
            room_delay: f64[5] = [0.043, 0.071, 0.113, 0.167, 0.231]
            room_gain: f64[5] = [0.55, 0.45, 0.35, 0.25, 0.18]
            room_pan: f64[5] = [-0.7, 0.6, -0.3, 0.8, -0.9]
            reach: mutable f64 = 0.231 if note.room != 0.0 else 0.0
            for i in 0..<p.tap_count |p, reach|:
                delay: f64 = p.taps[i.usize()].delay
                reach <- delay if delay > reach
            return if note.t + (span + reach) <= begin
            base: i64 = floor((begin - note.t) * rate.f64() + 0.5 + 0.000000001).i64()
            stop: i64 = (span * rate.f64()).i64()
            mid: f64 = 0.5 * (note.pan + note.pan2)
            lag: i64 = py_round_half_even(0.0006 * DrShape::magnitude(mid) * rate.f64())
            left_lag: i64 = lag if mid > 0.0 else 0
            right_lag: i64 = lag if mid <= 0.0 else 0
            sources: mutable Source[8] = zeroed
            sources[0] <- Source{left: left_lag, right: right_lag, gain: 1.0, pan: 0.0, fixed: false}
            for i in 0..<p.tap_count |sources, p, mid, left_lag, right_lag, rate|:
                sources[(i + 1).usize()] <- reflection(p.taps[i.usize()], mid, left_lag, right_lag, rate)
            count: mutable i64 = 1 + p.tap_count
            if note.room != 0.0:
                for i in 0..<5 |sources, note, count, room_delay, room_gain, room_pan, mid, left_lag, right_lag, rate|:
                    k: usize = i.usize()
                    tap: Tap = Tap{delay: room_delay[k], gain: room_gain[k] * note.room, pan: room_pan[k]}
                    sources[(count + i).usize()] <- reflection(tap, mid, left_lag, right_lag, rate)
                count <- count + 5
            top: mutable i64 = lag
            for i in 1..<count |sources, top|:
                source: Source = sources[i.usize()]
                top <- source.left if source.left > top
                top <- source.right if source.right > top
            qlo: i64 = base - top if base > top else 0
            qhi: i64 = stop if stop < base + frames else base + frames
            return if qhi <= qlo

            partials: mutable TonePcm::Partial[6] = zeroed
            extra: mutable TonePcm::Partial = zeroed
            live: mutable i64 = 0
            sum: mutable f64 = 0.0
            brightness: f64 = pow(note.bright, 0.7)
            for i in 0..<p.count |p, note, partials, extra, live, sum, brightness|:
                part: TonePcm::Partial = p.partials[i.usize()]
                continue if part.ratio * note.freq >= RATE.f64() * 0.42
                gain: f64 = part.gain if part.ratio < 1.5 else part.gain * brightness
                filtered: TonePcm::Partial = TonePcm::Partial{ratio: part.ratio, gain: gain, decay: part.decay}
                if live < 6:
                    partials[live.usize()] <- filtered
                    live <- live + 1
                else:
                    extra <- filtered
                sum <- sum + DrShape::magnitude(gain)
            kernel: TonePcm::Patch = TonePcm::Patch{partials: partials, count: live, attack: p.attack, decay: p.decay,
                release: p.release, sustain: p.sustain, tremolo_rate: p.tremolo_rate, tremolo_depth: p.tremolo_depth}
            tone: TonePcm::Note = TonePcm::Note{onset: note.t, duration: note.dur, frequency: note.freq, pan: note.pan,
                end_pan: note.pan2, gain: note.gain, end_gain: note.gain2,
                vibrato_rate: p.vibrato_rate, vibrato_depth: p.vibrato_depth, noise: p.noise,
                glide: p.glide, glide_time: p.glide_time, seed: note.seed}
            fx: TonePcm::Modulation = TonePcm::Modulation{fm_ratio: p.fm_ratio, fm_index: p.fm_index * (0.4 + 0.6 * note.bright),
                fm_decay: p.fm_decay, drive: p.drive, ring_ratio: p.ring_ratio, ring_mix: p.ring_mix, extra_partial: extra}
            norm: f64 = 1.0 / sum if sum > 0.0 else 1.0
            wave: f64 = TonePcm::TAU * note.freq
            duration_samples: f64 = note.dur * rate.f64()
            span_samples: f64 = duration_samples if duration_samples > 1.0 else 1.0
            region audio_scratch(524288):
                in audio_scratch:
                    buf: mutable darray[f64] = []
                    _ = buf.reserve((qhi - qlo).usize())
                    for q in qlo..<qhi |buf, norm, wave, kernel, tone, fx, p|:
                        buf.push(TonePcm::sample(&kernel, norm, wave, &tone, q, &fx, p.fold))
                    for i in 0..<count |output, frames, buf, base, qlo, qhi, span_samples, note, sources|:
                        mix_source(output, frames, &buf, base, qlo, qhi, span_samples, note, sources[i.usize()])

    def write(notes: darray[DrShapeDeal::Note]&, bank: Bank&, begin: f64, end: f64, dest: mutable u8&, capacity: i64,
            rate: i64 = RATE) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 0 if rate <= 0 or not (end > begin) or capacity < 4
            requested: f64 = (end - begin) * rate.f64()
            return 0 if requested > (capacity / 4).f64() + 0.5
            frames: i64 = py_round_half_even(requested)
            return 0 if frames <= 0 or frames > capacity / 4
            stereo: mutable darray[f64] = TonePcm::empty(frames)
            for i in 0..<notes.count |notes, stereo, frames, begin, end, rate, bank|:
                n: DrShapeDeal::Note = notes[i]
                if n.voice >= 0 and n.voice < bank.count:
                    mix(&stereo, frames, begin, end, rate, &bank.patches[n.voice.usize()], &n)
            return TonePcm::write(stereo, frames, dest)
