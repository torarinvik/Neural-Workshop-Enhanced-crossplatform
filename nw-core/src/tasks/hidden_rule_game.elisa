include "./hidden_rule_reference.elisa"

module HiddenRuleGame:
    const READY: i64 = 0
    const TESTING: i64 = 1
    const EXAMINING: i64 = 2
    const JUDGED: i64 = 3
    const DONE: i64 = 4
    const FEEDBACK_MS: i64 = 3000
    const TEST: i64 = 6
    const EXAM: i64 = 7
    const LIT: i64 = 8
    const DARK: i64 = 9
    const START: i64 = 10

    struct Run:
        start_rung: mutable i64
        trials: mutable i64
        adaptive: mutable bool
        rng: mutable MT19937
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        level: mutable HiddenRule::Grade
        dealt: mutable HiddenRule::Deal
        round: mutable HiddenRule::Round
        item: mutable i64[6]
        form: mutable i64
        atoms: mutable i64[3]
        par: mutable f64
        passed: mutable bool
        feedback_until_ms: mutable i64
        answered: mutable i64
        passed_count: mutable i64
        best_rung: mutable i64
        total_cost: mutable i64

    def allowed_rung(rung: i64) -> bool:
        return (rung >= 1 and rung <= 4) or rung == 6 or rung == 8 or rung == 10 or rung == 12 or rung == 13 or rung == 16 or rung == 19 or rung == 25 or rung == 30

    def allowed_trials(trials: i64) -> bool:
        return trials == 1 or trials == 3 or trials == 5 or trials == 8 or trials == 12

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64) -> Run:
        can Abort.Panic:
            start: i64 = rung if rung > 0 else 1
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            return Run{start_rung: start, trials: trials, adaptive: adaptive, rng: rng,
                rung: start, trial: 0, phase: READY, level: HiddenRule::grade(start),
                dealt: zeroed, round: zeroed, item: zeroed, form: 0, atoms: zeroed,
                par: 0.0, passed: false, feedback_until_ms: 0,
                answered: 0, passed_count: 0, best_rung: 0, total_cost: 0}

    def next_trial(run: mutable Run&):
        can Memory.Allocate, Memory.Release, Abort.Panic:
            if run.trial >= run.trials:
                run.phase <- DONE
                return
            region scratch(8388608):
                in scratch:
                    level: HiddenRule::Grade = HiddenRule::grade(run.rung)
                    world: HiddenRule::Space = HiddenRule::build(&level)
                    rng: mutable MT19937 = run.rng
                    dealt: mutable HiddenRule::Deal = zeroed
                    HiddenRule::deal(&level, &world, &rng, &dealt)
                    reference: mutable HiddenRule::Round = zeroed
                    HiddenRuleReference::play(&level, &world, &dealt, &reference)
                    run.par <- HiddenRuleReference::par(&level, &reference)
                    run.form <- Ints::at_view(&world.rules, dealt.rule * 4)
                    for slot in 0..<3 |slot, run, world, dealt|:
                        run.atoms[slot.usize()] <- Ints::at_view(&world.rules, dealt.rule * 4 + slot + 1)
                    run.level <- level
                    run.rng <- rng
                    run.dealt <- dealt
                destroy scratch
            run.round <- zeroed
            run.item <- zeroed
            run.trial <- run.trial + 1
            run.phase <- TESTING

    def reset(run: mutable Run&):
        run.phase <- READY
        run.rung <- run.start_rung
        run.trial <- 0
        run.answered <- 0
        run.passed_count <- 0
        run.best_rung <- 0
        run.total_cost <- 0

    def start(run: mutable Run&) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if run.phase != READY and run.phase != DONE
            reset(run)
            next_trial(run)
            return true

    def item_index(run: Run&) -> i64:
        can Abort.Panic:
            index: mutable i64 = 0
            for feature in 0..<run.level.features |feature, run, index|:
                slot: usize = feature.usize()
                index <- index * run.level.values[slot] + run.item[slot]
            return index

    def choose(run: mutable Run&, feature: i64, value: i64) -> bool:
        can Abort.Panic:
            return false if run.phase != TESTING or feature < 0 or feature >= run.level.features
            slot: usize = feature.usize()
            count: i64 = run.level.values[slot]
            return false if value >= count
            run.item[slot] <- (run.item[slot] + 1) % count if value < 0 else value
            return true

    def begin_exam(run: mutable Run&) -> bool:
        return false if run.phase != TESTING or not HiddenRule::start_exam(&run.round)
        run.phase <- EXAMINING
        return true

    def test(run: mutable Run&) -> bool:
        can Abort.Panic:
            return false if run.phase != TESTING
            item: i64 = item_index(run)
            return false if HiddenRule::test(&run.round, &run.level, &run.dealt, item) < 0
            if run.round.test_count == HiddenRule::BUDGET:
                _ = begin_exam(run)
            return true

    def answer(run: mutable Run&, call: bool, now_ms: i64) -> bool:
        can Abort.Panic:
            return false if run.phase != EXAMINING or not HiddenRule::answer(&run.round, &run.level, &run.dealt, call)
            if run.round.over:
                cost: i64 = HiddenRule::cost(&run.round, &run.level)
                run.passed <- cost.f64() <= run.par + 0.000000001
                run.answered <- run.answered + 1
                run.total_cost <- run.total_cost + cost
                if run.passed:
                    run.passed_count <- run.passed_count + 1
                    run.best_rung <- run.level.rung if run.level.rung > run.best_rung
                if run.adaptive:
                    if run.passed:
                        run.rung <- run.rung + 1
                    elif run.rung > 1:
                        run.rung <- run.rung - 1
                run.feedback_until_ms <- now_ms + FEEDBACK_MS
                run.phase <- JUDGED
            return true

    def steer(run: mutable Run&, port: i64, now_ms: i64) -> bool:
        can Abort.Panic:
            if port >= 0 and port < TEST:
                return choose(run, port, -1)
            return test(run) if port == TEST
            return begin_exam(run) if port == EXAM
            return answer(run, port == LIT, now_ms) if port == LIT or port == DARK
            return false

    def advance(run: mutable Run&, now_ms: i64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if run.phase != JUDGED or now_ms < run.feedback_until_ms
            next_trial(run)
            return true

    def mean_cost(run: Run&) -> f64:
        return run.total_cost.f64() / run.answered.f64() if run.answered > 0 else 0.0
