# Polynomials with exact rational coefficients, written down and read back.
#
# Port of neural_workshop/expressions.py (GPL-2.0-or-later), which is what the
# algebra ladder computes in and what a player's typed answer goes through.
#
# A monomial is the reference's tuple of `(name, power)` pairs, alphabetically
# sorted with the zero powers dropped. Here it is the four powers themselves --
# of x, y, z and n -- and the pair sequence is derived where it is needed,
# which is in the two places the ORDER shows: `render`, which sorts by total
# degree and then alphabetically, and the near-miss search in algebra.py, which
# sorts by `str(mono)`. Alphabetical order is n, x, y, z, and not the order
# `NAMES` lists them in, which matters for both.
#
# The exactness is not fussiness. A rung's answer is compared with `==` against
# what the player typed, so `1/3 + 1/6` has to BE `1/2` and not 0.4999999999.
#
# MOST_TERMS is a cap this port has and the reference does not. Nothing on the
# ladder comes near it -- the widest answer dealt is ten terms, from a cubic in
# two letters -- and an expression that would exceed it fails the way a
# division by a polynomial does, which every caller already catches.

module Expressions:

    const NAME_X: i64 = 0
    const NAME_Y: i64 = 1
    const NAME_Z: i64 = 2
    const NAME_N: i64 = 3
    const NAME_COUNT: i64 = 4

    const MOST_TERMS: i64 = 24

    # Alphabetical order, which is the order `_mono` sorts pairs into: n, x, y,
    # z. Not the order `NAMES` lists them in.
    def alpha_name(at: i64) -> i64:
        return NAME_N if at == 0
        return NAME_X if at == 1
        return NAME_Y if at == 2
        return NAME_Z

    def name_letter(name: i64) -> i64:
        return 120 if name == NAME_X
        return 121 if name == NAME_Y
        return 122 if name == NAME_Z
        return 110

    def name_of_letter(letter: i64) -> i64:
        return NAME_X if letter == 120
        return NAME_Y if letter == 121
        return NAME_Z if letter == 122
        return NAME_N if letter == 110
        return -1

    struct Poly:
        count: mutable i64
        power: mutable i64[96]
        coefficient: mutable Q::Frac[24]

    def zero() -> Poly:
        can Abort.Panic:
            out: mutable Poly = Poly{count: 0, power: zeroed, coefficient: zeroed}
            for term in 0..<MOST_TERMS |out|:
                out.coefficient[term.usize()] <- Q::zero()
            return out

    def clear(out: mutable Poly&):
        out.count <- 0

    def copy(out: mutable Poly&, source: Poly&):
        can Abort.Panic:
            out.count <- source.count
            for term in 0..<source.count |out, source|:
                for name in 0..<NAME_COUNT |out, source, term|:
                    out.power[(term * NAME_COUNT + name).usize()] <- source.power[(term * NAME_COUNT + name).usize()]
                Q::copy(&out.coefficient[term.usize()], &source.coefficient[term.usize()])

    def power_at(value: Poly&, term: i64, name: i64) -> i64:
        return value.power[(term * NAME_COUNT + name).usize()]

    def total_degree(value: Poly&, term: i64) -> i64:
        held: mutable i64 = 0
        for name in 0..<NAME_COUNT |held, value, term|:
            held <- held + power_at(value, term, name)
        return held

    # The term whose monomial is `powers`, or -1.
    def find(value: Poly&, powers: mutable darray[i64]&) -> i64:
        can Abort.Panic:
            for term in 0..<value.count |value, powers|:
                same: mutable bool = true
                for name in 0..<NAME_COUNT |value, powers, term, same|:
                    same <- false if power_at(value, term, name) != Ints::at_ref(powers, name)
                term return if same
            return -1

    # Add `value` to the coefficient of `powers`, appending the term where
    # there is none yet. False when the cap is reached.
    def accumulate(out: mutable Poly&, powers: mutable darray[i64]&, value: Q::Frac&) -> bool:
        can Abort.Panic:
            at: i64 = find(out, powers)
            if at >= 0:
                held: mutable Q::Frac = Q::zero()
                false return if not Q::add(&held, &out.coefficient[at.usize()], value)
                Q::copy(&out.coefficient[at.usize()], &held)
                return true
            false return if out.count >= MOST_TERMS
            for name in 0..<NAME_COUNT |out, powers|:
                out.power[(out.count * NAME_COUNT + name).usize()] <- Ints::at_ref(powers, name)
            Q::copy(&out.coefficient[out.count.usize()], value)
            out.count <- out.count + 1
            return true

    # `Poly.__init__` keeps only the terms whose coefficient is not zero, which
    # is what makes equality equality of the written form.
    def prune(out: mutable Poly&):
        can Abort.Panic:
            kept: mutable i64 = 0
            for term in 0..<out.count |out, kept|:
                continue if Q::is_zero(&out.coefficient[term.usize()])
                if kept != term:
                    for name in 0..<NAME_COUNT |out, kept, term|:
                        out.power[(kept * NAME_COUNT + name).usize()] <- out.power[(term * NAME_COUNT + name).usize()]
                    Q::copy(&out.coefficient[kept.usize()], &out.coefficient[term.usize()])
                kept <- kept + 1
            out.count <- kept

    def set_constant(out: mutable Poly&, value: Q::Frac&):
        can Memory.Allocate, Abort.Panic:
            clear(out)
            powers: mutable darray[i64] = Ints::zeros(NAME_COUNT)
            accumulate(out, &powers, value)
            prune(out)

    def set_constant_i64(out: mutable Poly&, value: i64):
        can Memory.Allocate, Abort.Panic:
            held: Q::Frac = Q::from_i64(value)
            set_constant(out, &held)

    def set_variable(out: mutable Poly&, name: i64):
        can Memory.Allocate, Abort.Panic:
            clear(out)
            powers: mutable darray[i64] = Ints::zeros(NAME_COUNT)
            Ints::put(&powers, name, 1)
            one: Q::Frac = Q::from_i64(1)
            accumulate(out, &powers, &one)

    def is_zero(value: Poly&) -> bool:
        return value.count == 0

    def is_constant(value: Poly&) -> bool:
        for term in 0..<value.count |value|:
            false return if total_degree(value, term) != 0
        return true

    # The constant, which is zero unless this IS a constant. False where the
    # reference raises, which is a caller asking the wrong question.
    def constant_value(out: mutable Q::Frac&, value: Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            false return if not is_constant(value)
            Q::set_i64(out, 0)
            powers: mutable darray[i64] = Ints::zeros(NAME_COUNT)
            at: i64 = find(value, &powers)
            return true if at < 0
            Q::copy(out, &value.coefficient[at.usize()])
            return true

    def equal(left: Poly&, right: Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            false return if left.count != right.count
            powers: mutable darray[i64] = Ints::zeros(NAME_COUNT)
            for term in 0..<left.count |left, right, powers|:
                for name in 0..<NAME_COUNT |left, powers, term|:
                    Ints::put(&powers, name, power_at(left, term, name))
                at: i64 = find(right, &powers)
                false return if at < 0
                false return if not Q::equal(&left.coefficient[term.usize()], &right.coefficient[at.usize()])
            return true

    def add(out: mutable Poly&, left: Poly&, right: Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            held: mutable Poly = zero()
            copy(&held, left)
            powers: mutable darray[i64] = Ints::zeros(NAME_COUNT)
            for term in 0..<right.count |held, right, powers|:
                for name in 0..<NAME_COUNT |right, powers, term|:
                    Ints::put(&powers, name, power_at(right, term, name))
                false return if not accumulate(&held, &powers, &right.coefficient[term.usize()])
            prune(&held)
            copy(out, &held)
            return true

    def negate(out: mutable Poly&, source: Poly&):
        can Abort.Panic:
            copy(out, source)
            for term in 0..<out.count |out|:
                flipped: mutable Q::Frac = Q::zero()
                Q::negate(&flipped, &out.coefficient[term.usize()])
                Q::copy(&out.coefficient[term.usize()], &flipped)

    def sub(out: mutable Poly&, left: Poly&, right: Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            flipped: mutable Poly = zero()
            negate(&flipped, right)
            return add(out, left, &flipped)

    def mul(out: mutable Poly&, left: Poly&, right: Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            held: mutable Poly = zero()
            powers: mutable darray[i64] = Ints::zeros(NAME_COUNT)
            product: mutable Q::Frac = Q::zero()
            for one in 0..<left.count |held, left, right, powers, product|:
                for two in 0..<right.count |held, left, right, powers, product, one|:
                    for name in 0..<NAME_COUNT |left, right, powers, one, two|:
                        Ints::put(&powers, name, power_at(left, one, name) + power_at(right, two, name))
                    false return if not Q::mul(&product, &left.coefficient[one.usize()], &right.coefficient[two.usize()])
                    false return if not accumulate(&held, &powers, &product)
            prune(&held)
            copy(out, &held)
            return true

    # Division by a constant only, which is what the reference allows.
    def div(out: mutable Poly&, left: Poly&, right: Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            value: mutable Q::Frac = Q::zero()
            false return if not constant_value(&value, right)
            false return if Q::is_zero(&value)
            held: mutable Poly = zero()
            copy(&held, left)
            for term in 0..<held.count |held, value|:
                quotient: mutable Q::Frac = Q::zero()
                false return if not Q::div(&quotient, &held.coefficient[term.usize()], &value)
                Q::copy(&held.coefficient[term.usize()], &quotient)
            prune(&held)
            copy(out, &held)
            return true

    def power(out: mutable Poly&, base: Poly&, exponent: i64) -> bool:
        can Memory.Allocate, Abort.Panic:
            false return if exponent < 0
            held: mutable Poly = zero()
            set_constant_i64(&held, 1)
            step: mutable Poly = zero()
            for _each in 0..<exponent |held, step, base|:
                false return if not mul(&step, &held, base)
                copy(&held, &step)
            copy(out, &held)
            return true

    # Values for the four letters, and which of them were given.
    struct Assign:
        value: mutable Q::Frac[4]
        given: mutable i64[4]

    def new_assign() -> Assign:
        can Abort.Panic:
            out: mutable Assign = Assign{value: zeroed, given: zeroed}
            for name in 0..<NAME_COUNT |out|:
                out.value[name.usize()] <- Q::zero()
            return out

    def assign(out: mutable Assign&, name: i64, value: Q::Frac&):
        can Abort.Panic:
            Q::copy(&out.value[name.usize()], value)
            out.given[name.usize()] <- 1

    # The value with every variable replaced. False where the reference raises
    # for a letter it was given no value for.
    def evaluate(out: mutable Q::Frac&, value: Poly&, at: Assign&) -> bool:
        can Abort.Panic:
            total: mutable Q::Frac = Q::from_i64(0)
            for term in 0..<value.count |total, value, at|:
                held: mutable Q::Frac = Q::zero()
                Q::copy(&held, &value.coefficient[term.usize()])
                for name in 0..<NAME_COUNT |held, value, at, term|:
                    step: i64 = power_at(value, term, name)
                    continue if step == 0
                    false return if at.given[name.usize()] == 0
                    lifted: mutable Q::Frac = Q::zero()
                    false return if not Q::power(&lifted, &at.value[name.usize()], step)
                    product: mutable Q::Frac = Q::zero()
                    false return if not Q::mul(&product, &held, &lifted)
                    Q::copy(&held, &product)
                summed: mutable Q::Frac = Q::zero()
                false return if not Q::add(&summed, &total, &held)
                Q::copy(&total, &summed)
            Q::copy(out, &total)
            return true

    # --- writing one down -------------------------------------------------

    # `_order`: highest total degree first, then alphabetical. Reading order.
    #
    # The tail of the key is the pair sequence with the powers NEGATED, so a
    # bigger power on the same letter comes first; and a monomial that runs out
    # of letters first sorts before one that carries on, which is what
    # comparing a shorter tuple against a longer one does.
    def order_cmp(value: Poly&, left: i64, right: i64) -> i64:
        one: i64 = total_degree(value, left)
        two: i64 = total_degree(value, right)
        return -1 if one > two
        return 1 if one < two
        at_left: mutable i64 = 0
        at_right: mutable i64 = 0
        answer: mutable i64 = 0
        settled: mutable bool = false
        for _step in 0..<(NAME_COUNT * 2) |value, left, right, at_left, at_right, answer, settled|:
            break if settled
            while at_left < NAME_COUNT and power_at(value, left, alpha_name(at_left)) == 0 |at_left, value, left|:
                at_left <- at_left + 1
            while at_right < NAME_COUNT and power_at(value, right, alpha_name(at_right)) == 0 |at_right, value, right|:
                at_right <- at_right + 1
            if at_left >= NAME_COUNT and at_right >= NAME_COUNT:
                settled <- true
                continue
            if at_left >= NAME_COUNT:
                answer <- -1
                settled <- true
                continue
            if at_right >= NAME_COUNT:
                answer <- 1
                settled <- true
                continue
            if at_left != at_right:
                answer <- -1 if at_left < at_right else 1
                settled <- true
                continue
            power_left: i64 = power_at(value, left, alpha_name(at_left))
            power_right: i64 = power_at(value, right, alpha_name(at_right))
            if power_left != power_right:
                answer <- -1 if power_left > power_right else 1
                settled <- true
                continue
            at_left <- at_left + 1
            at_right <- at_right + 1
        return answer

    # The terms in reading order, as indices.
    def sorted_terms(value: Poly&, out: mutable darray[i64]&):
        can Abort.Panic:
            for term in 0..<value.count |out|:
                Ints::put(out, term, term)
            for index in 1..<value.count |out, value|:
                held: i64 = Ints::at_ref(out, index)
                at: mutable i64 = index - 1
                placing: mutable bool = true
                while placing and at >= 0 |out, value, at, placing, held|:
                    if order_cmp(value, Ints::at_ref(out, at), held) > 0:
                        Ints::put(out, at + 1, Ints::at_ref(out, at))
                        at <- at - 1
                    else:
                        placing <- false
                Ints::put(out, at + 1, held)

    def write_i64(out: mutable darray[u8]&, at: i64, value: i64) -> i64:
        can Abort.Panic:
            held: mutable i64 = value
            if held == 0:
                Bytes::put(out, at, 48.u8())
                return at + 1
            digits: mutable darray[u8] = Bytes::zeros(24)
            span: mutable i64 = 0
            while held > 0 |held, digits, span|:
                Bytes::put(&digits, span, (48 + held % 10).u8())
                held <- held / 10
                span <- span + 1
            for index in 0..<span |out, digits, at, span|:
                Bytes::put(out, at + index, Bytes::at_ref(&digits, span - 1 - index))
            return at + span

    def render_mono(value: Poly&, term: i64, out: mutable darray[u8]&, at: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            here: mutable i64 = at
            for step in 0..<NAME_COUNT |value, term, out, here|:
                name: i64 = alpha_name(step)
                held: i64 = power_at(value, term, name)
                continue if held == 0
                Bytes::put(out, here, name_letter(name).u8())
                here <- here + 1
                continue if held == 1
                Bytes::put(out, here, 94.u8())
                here <- here + 1
                here <- write_i64(out, here, held)
            return here

    # The polynomial as a person would write it. Signs are folded into the
    # joins, so it reads `3x^2 - x + 4` rather than `3x^2 + -1x + 4`. Display
    # only -- nothing is ever compared as a string.
    def render(value: Poly&, out: mutable darray[u8]&) -> i64:
        can Memory.Allocate, Abort.Panic:
            if value.count == 0:
                Bytes::put(out, 0, 48.u8())
                return 1
            order: mutable darray[i64] = Ints::zeros(MOST_TERMS)
            sorted_terms(value, &order)
            one: Q::Frac = Q::from_i64(1)
            at: mutable i64 = 0
            for index in 0..<value.count |value, order, out, at, one|:
                term: i64 = Ints::at_ref(&order, index)
                negative: bool = Q::is_negative(&value.coefficient[term.usize()])
                if index == 0:
                    if negative:
                        Bytes::put(out, at, 45.u8())
                        at <- at + 1
                else:
                    Bytes::put(out, at, 32.u8())
                    Bytes::put(out, at + 1, 45.u8() if negative else 43.u8())
                    Bytes::put(out, at + 2, 32.u8())
                    at <- at + 3
                size: mutable Q::Frac = Q::zero()
                Q::abs_of(&size, &value.coefficient[term.usize()])
                body: i64 = total_degree(value, term)
                if body != 0 and Q::equal(&size, &one):
                    at <- render_mono(value, term, out, at)
                    continue
                text: mutable darray[u8] = Bytes::zeros(352)
                span: i64 = Q::to_text(&size, &text)
                for step in 0..<span |out, text, at|:
                    Bytes::put(out, at + step, Bytes::at_ref(&text, step))
                at <- at + span
                at <- render_mono(value, term, out, at) if body != 0
            return at

    # `str(mono)` -- Python's own repr of the tuple of pairs, which is what the
    # near-miss search in algebra.py sorts its monomials by. An odd key, but it
    # is the key, and a one-pair tuple carries a trailing comma.
    def mono_repr(value: Poly&, term: i64, out: mutable darray[u8]&) -> i64:
        can Abort.Panic:
            Bytes::put(out, 0, 40.u8())
            at: mutable i64 = 1
            written: mutable i64 = 0
            for step in 0..<NAME_COUNT |value, term, out, at, written|:
                name: i64 = alpha_name(step)
                held: i64 = power_at(value, term, name)
                continue if held == 0
                if written > 0:
                    Bytes::put(out, at, 44.u8())
                    Bytes::put(out, at + 1, 32.u8())
                    at <- at + 2
                Bytes::put(out, at, 40.u8())
                Bytes::put(out, at + 1, 39.u8())
                Bytes::put(out, at + 2, name_letter(name).u8())
                Bytes::put(out, at + 3, 39.u8())
                Bytes::put(out, at + 4, 44.u8())
                Bytes::put(out, at + 5, 32.u8())
                at <- write_i64(out, at + 6, held)
                Bytes::put(out, at, 41.u8())
                at <- at + 1
                written <- written + 1
            if written == 1:
                Bytes::put(out, at, 44.u8())
                at <- at + 1
            Bytes::put(out, at, 41.u8())
            return at + 1

    # --- reading one in ---------------------------------------------------

    const TOK_NUMBER: i64 = 0
    const TOK_NAME: i64 = 1
    const TOK_PLUS: i64 = 2
    const TOK_MINUS: i64 = 3
    const TOK_STAR: i64 = 4
    const TOK_SLASH: i64 = 5
    const TOK_CARET: i64 = 6
    const TOK_POWER: i64 = 7
    const TOK_OPEN: i64 = 8
    const TOK_CLOSE: i64 = 9

    const MOST_TOKENS: i64 = 256

    struct Reader:
        count: mutable i64
        at: mutable i64
        kind: mutable darray[i64]
        value: mutable darray[i64]
        start: mutable darray[i64]
        span: mutable darray[i64]
        text: mutable darray[u8]
        length: mutable i64

    def new_reader() -> Reader:
        can Memory.Allocate, Abort.Panic:
            return Reader{count: 0, at: 0, kind: Ints::zeros(MOST_TOKENS),
                          value: Ints::zeros(MOST_TOKENS), start: Ints::zeros(MOST_TOKENS),
                          span: Ints::zeros(MOST_TOKENS), text: Bytes::zeros(512), length: 0}

    def is_space(byte: i64) -> bool:
        return byte == 32 or byte == 9 or byte == 10 or byte == 13 or byte == 11 or byte == 12

    def is_digit(byte: i64) -> bool:
        return byte >= 48 and byte <= 57

    def lower_of(byte: i64) -> i64:
        return byte + 32 if byte >= 65 and byte <= 90
        return byte

    # `_scan`, which is `\s*(\d+|[a-z]|\*\*|[-+*/^()])` matched at a position at
    # a time. The regex swallows the space BEFORE its token, so a run of spaces
    # followed by something unreadable fails at the run's start; the caller then
    # steps over one space and tries again, and the error is finally raised on
    # the character that could not be read.
    def scan(out: mutable Reader&, text: mutable darray[u8]&, length: i64) -> bool:
        can Abort.Panic:
            out.count <- 0
            out.at <- 0
            out.length <- length
            false return if length > 512
            for index in 0..<length |out, text|:
                Bytes::put(&out.text, index, lower_of(Bytes::at_ref(text, index).i64()).u8())
            at: mutable i64 = 0
            while at < length |at, out, length|:
                look: mutable i64 = at
                while look < length and is_space(Bytes::at_ref(&out.text, look).i64()) |look, out, length|:
                    look <- look + 1
                if look >= length:
                    false return if not is_space(Bytes::at_ref(&out.text, at).i64())
                    at <- at + 1
                    continue
                byte: i64 = Bytes::at_ref(&out.text, look).i64()
                false return if out.count >= MOST_TOKENS
                if is_digit(byte):
                    span: mutable i64 = 0
                    while look + span < length and is_digit(Bytes::at_ref(&out.text, look + span).i64()) |span, out, look, length|:
                        span <- span + 1
                    Ints::put(&out.kind, out.count, TOK_NUMBER)
                    Ints::put(&out.start, out.count, look)
                    Ints::put(&out.span, out.count, span)
                    out.count <- out.count + 1
                    at <- look + span
                    continue
                if byte >= 97 and byte <= 122:
                    Ints::put(&out.kind, out.count, TOK_NAME)
                    Ints::put(&out.value, out.count, byte)
                    out.count <- out.count + 1
                    at <- look + 1
                    continue
                if byte == 42 and look + 1 < length and Bytes::at_ref(&out.text, look + 1).i64() == 42:
                    Ints::put(&out.kind, out.count, TOK_POWER)
                    out.count <- out.count + 1
                    at <- look + 2
                    continue
                kind: mutable i64 = -1
                kind <- TOK_PLUS if byte == 43
                kind <- TOK_MINUS if byte == 45
                kind <- TOK_STAR if byte == 42
                kind <- TOK_SLASH if byte == 47
                kind <- TOK_CARET if byte == 94
                kind <- TOK_OPEN if byte == 40
                kind <- TOK_CLOSE if byte == 41
                if kind < 0:
                    # The regex matched nothing here. Step over a space and try
                    # again; anything else is unreadable.
                    false return if not is_space(Bytes::at_ref(&out.text, at).i64())
                    at <- at + 1
                    continue
                Ints::put(&out.kind, out.count, kind)
                out.count <- out.count + 1
                at <- look + 1
            return true

    def peek(reader: mutable Reader&) -> i64:
        can Abort.Panic:
            return -1 if reader.at >= reader.count
            return Ints::at_ref(&reader.kind, reader.at)

    # `read_base`, `read_power`, `read_factor`, `read_term` and
    # `read_expression` call one another in a ring -- a bracket sends the
    # smallest thing back to the largest -- and they are written in the order
    # the descent goes DOWN in rather than in the order it can be read in.
    def read_base(reader: mutable Reader&, out: mutable Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            false return if reader.at >= reader.count
            kind: i64 = Ints::at_ref(&reader.kind, reader.at)
            index: i64 = reader.at
            reader.at <- reader.at + 1
            if kind == TOK_OPEN:
                false return if not read_expression(reader, out)
                false return if peek(reader) != TOK_CLOSE
                reader.at <- reader.at + 1
                return true
            if kind == TOK_NUMBER:
                held: mutable Big::Int = Big::zero()
                false return if not Big::from_digits(&held, &reader.text, Ints::at_ref(&reader.start, index), Ints::at_ref(&reader.span, index))
                value: mutable Q::Frac = Q::zero()
                Q::from_big(&value, &held)
                set_constant(out, &value)
                return true
            if kind == TOK_NAME:
                name: i64 = name_of_letter(Ints::at_ref(&reader.value, index))
                # A letter this ladder does not use is a wrong answer and not a
                # crash, which is what the caller's except clause is for.
                false return if name < 0
                set_variable(out, name)
                return true
            return false

    def read_power(reader: mutable Reader&, out: mutable Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            false return if not read_base(reader, out)
            kind: i64 = peek(reader)
            return true if kind != TOK_CARET and kind != TOK_POWER
            reader.at <- reader.at + 1
            # Right-associative, and the exponent may carry a sign, so that
            # x^-1 is refused for being negative rather than for being
            # unreadable.
            exponent: mutable Poly = zero()
            false return if not read_factor(reader, &exponent)
            value: mutable Q::Frac = Q::zero()
            false return if not constant_value(&value, &exponent)
            false return if not Q::is_integer(&value) or Q::is_negative(&value)
            false return if not Big::is_i64(&value.num)
            lifted: mutable Poly = zero()
            false return if not power(&lifted, out, Big::to_i64(&value.num))
            copy(out, &lifted)
            return true

    # A signed power. The sign is stripped HERE and not in `read_base`, which
    # is the difference between `-x^2` meaning what everyone means by it and
    # meaning `(-x)^2`. Parsed the other way round the two agree at x = 0 and
    # nowhere else, so a rung asking for a coefficient would mark a right
    # answer wrong and look like a generator fault.
    def read_factor(reader: mutable Reader&, out: mutable Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            kind: i64 = peek(reader)
            if kind == TOK_MINUS:
                reader.at <- reader.at + 1
                inner: mutable Poly = zero()
                false return if not read_factor(reader, &inner)
                negate(out, &inner)
                return true
            if kind == TOK_PLUS:
                reader.at <- reader.at + 1
                return read_factor(reader, out)
            return read_power(reader, out)

    # `3x`, `2(x+1)`, `(x+1)(x-1)` -- what people write.
    def implicit(reader: mutable Reader&) -> bool:
        kind: i64 = peek(reader)
        return kind == TOK_OPEN or kind == TOK_NUMBER or kind == TOK_NAME

    def read_term(reader: mutable Reader&, out: mutable Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            false return if not read_factor(reader, out)
            running: mutable bool = true
            while running |running, reader, out|:
                kind: i64 = peek(reader)
                if kind == TOK_STAR or kind == TOK_SLASH:
                    reader.at <- reader.at + 1
                    right: mutable Poly = zero()
                    false return if not read_factor(reader, &right)
                    held: mutable Poly = zero()
                    if kind == TOK_STAR:
                        false return if not mul(&held, out, &right)
                    else:
                        false return if not div(&held, out, &right)
                    copy(out, &held)
                    continue
                if implicit(reader):
                    right: mutable Poly = zero()
                    false return if not read_factor(reader, &right)
                    held: mutable Poly = zero()
                    false return if not mul(&held, out, &right)
                    copy(out, &held)
                    continue
                running <- false
            return true

    def read_expression(reader: mutable Reader&, out: mutable Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            false return if not read_term(reader, out)
            running: mutable bool = true
            while running |running, reader, out|:
                kind: i64 = peek(reader)
                if kind != TOK_PLUS and kind != TOK_MINUS:
                    running <- false
                    continue
                reader.at <- reader.at + 1
                right: mutable Poly = zero()
                false return if not read_term(reader, &right)
                held: mutable Poly = zero()
                if kind == TOK_PLUS:
                    false return if not add(&held, out, &right)
                else:
                    false return if not sub(&held, out, &right)
                copy(out, &held)
            return true

    # Read the text as a polynomial. Empty input is an error rather than zero:
    # a player who has typed nothing has not answered nought, they have not
    # answered.
    def parse(out: mutable Poly&, text: mutable darray[u8]&, length: i64, reader: mutable Reader&) -> bool:
        can Memory.Allocate, Abort.Panic:
            blank: mutable bool = true
            for index in 0..<length |text, blank|:
                blank <- false if not is_space(Bytes::at_ref(text, index).i64())
            false return if blank
            false return if not scan(reader, text, length)
            false return if reader.count == 0
            false return if not read_expression(reader, out)
            return reader.at >= reader.count
