include "../pyrandom.elisa"
include "../rooms_view.elisa"

module DrShape:
    const POLYGON: i64 = 0
    const STAR: i64 = 1
    const SPIRAL: i64 = 2
    const SPACE: i64 = 3
    const COIL: i64 = 4
    const BRANCH: i64 = 5
    const CURVE: i64 = 6
    const PRISM: i64 = 7
    const PYRAMID: i64 = 8
    const SOLID: i64 = 9

    const SEE: i64 = 0
    const HEAR: i64 = 1
    const SING: i64 = 2
    const ECHO: i64 = 3
    const SCENE: i64 = 4
    const HEAR_SCENE: i64 = 5
    const MOST: i64 = 6

    const FORWARD: i64 = 0
    const YAW: i64 = 1
    const PITCH: i64 = 2
    const ROLL: i64 = 3
    const PUSH: i64 = 4
    const POP: i64 = 5
    const MAX_OPS: i64 = 72
    const MAX_STROKES: i64 = 18
    const RADIANS: f64 = 0.017453292519943295

    struct Mode:
        kind: i64
        weight: f64

    struct Grade:
        rung: i64
        families: i64[7]
        family_count: i64
        candidates: i64
        keep: bool
        turn: i64
        mirror: bool
        near: bool
        colours: i64
        modes: Mode[6]
        mode_count: i64
        echo_key: bool
        echo_voice: bool
        floor: bool
        each_side: bool
        tumble: bool
        chorus: bool
        overload: f64
        wild: f64
        instruments: i64
        choose: f64
        tempo: f64

    def mode(kind: i64, weight: f64) -> Mode:
        return Mode{kind: kind, weight: weight}

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        burden: f64 = 0.25 + 0.075 * (r - 23).f64()
        over: f64 = 0.0 if r < 23 else (burden if burden < 1.0 else 1.0)
        families: mutable i64[7] = [COIL, SPACE, CURVE, PRISM, PYRAMID, SOLID, BRANCH]
        family_count: mutable i64 = 7 if r >= 23 else 6
        if r < 5:
            families <- [POLYGON, STAR, SPIRAL, 0, 0, 0, 0]
            family_count <- 2 if r < 3 else 3
        elif r < 11:
            families <- [SPACE, CURVE, PRISM, 0, 0, 0, 0]
            family_count <- 2 if r < 8 else 3
        none: Mode = mode(SEE, 0.0)
        modes: mutable Mode[6] = [mode(SCENE, 0.2), mode(HEAR_SCENE, 0.15), mode(SEE, 0.2),
            mode(HEAR, 0.15), mode(SING, 0.15), mode(ECHO, 0.15)]
        mode_count: mutable i64 = 6
        if r < 3:
            modes <- [mode(SEE, 1.0), none, none, none, none, none]
            mode_count <- 1
        elif r < 8:
            modes <- [mode(SEE, 0.7), mode(ECHO if r < 5 else SING, 0.3), none, none, none, none]
            mode_count <- 2
        elif r < 14:
            modes <- [mode(SEE, 0.6), mode(SING, 0.2), mode(ECHO, 0.2), none, none, none]
            mode_count <- 3
        elif r < 17:
            modes <- [mode(HEAR, 0.5), mode(SING, 0.25), mode(ECHO, 0.25), none, none, none]
            mode_count <- 3
        elif r < 20:
            modes <- [mode(SEE, 0.5), mode(HEAR, 0.15), mode(SING, 0.15), mode(ECHO, 0.2), none, none]
            mode_count <- 4
        elif r < 23:
            modes <- [mode(SCENE, 0.5), mode(SEE, 0.2), mode(SING, 0.15), mode(ECHO, 0.15), none, none]
            mode_count <- 4
        near: bool = (r >= 8 and r < 14) or r >= 17
        turning: bool = (r >= 17 and r < 20) or r >= 23
        seconds: f64 = 11.0 - 0.15 * (r - 23).f64()
        return Grade{rung: r, families: families, family_count: family_count,
            candidates: 3 if r < 3 else (4 if r < 11 else (5 if r < 23 else 6)),
            keep: r < 3, turn: 0 if r < 3 else (1 if r < 5 else 2),
            mirror: near, near: near, colours: 1 if r < 8 else (2 if r < 11 else 3),
            modes: modes, mode_count: mode_count, echo_key: r >= 8, echo_voice: r >= 11,
            floor: r >= 17, each_side: r >= 23, tumble: turning, chorus: turning,
            overload: over, wild: 0.0 if r < 5 else (0.2 if r < 11 else (0.45 if r < 23 else 0.6 + 0.4 * over)),
            instruments: 4 if r < 5 else (9 if r < 11 else (15 if r < 23 else 17)),
            choose: 14.0 if r < 11 else (12.0 if r < 23 else (seconds if seconds > 8.0 else 8.0)),
            tempo: 1.0 if r < 23 else 1.0 + 0.6 * over}

    struct Op:
        kind: i64
        value: f64

    struct Program:
        ops: mutable Op[MAX_OPS]
        count: mutable i64

    struct Segment:
        a: RoomsView::Vec
        b: RoomsView::Vec

    struct Path:
        segments: mutable Segment[MAX_STROKES]
        count: mutable i64

    struct Turtle:
        pos: mutable RoomsView::Vec
        head: mutable RoomsView::Vec
        left: mutable RoomsView::Vec
        up: mutable RoomsView::Vec

    def append(program: mutable Program&, kind: i64, value: f64 = 0.0):
        can Abort.Panic:
            program.ops[program.count.usize()] <- Op{kind: kind, value: value}
            program.count <- program.count + 1

    def grow(program: mutable Program&, rng: mutable MT19937&, depth: i64, size: f64, a: f64, b: f64, shrink: f64):
        can Abort.Panic:
            append(program, FORWARD, size)
            return if depth == 0
            twist: f64 = 60.0 + 30.0 * py_choice_index(rng, 3).f64()
            append(program, PUSH)
            append(program, YAW, a)
            append(program, PITCH, b / 2.0)
            grow(program, rng, depth - 1, size * shrink, a, b, shrink)
            append(program, POP)
            append(program, PUSH)
            append(program, ROLL, twist)
            append(program, YAW, -b)
            grow(program, rng, depth - 1, size * shrink, a, b, shrink)
            append(program, POP)

    def make_program(family: i64, rng: mutable MT19937&) -> Program:
        can Abort.Panic:
            out: mutable Program = zeroed
            if family == POLYGON or family == STAR:
                sides: i64[5] = [3, 4, 5, 6, 8]
                stars: i64[6] = [5, 7, 7, 8, 9, 9]
                strides: i64[6] = [2, 2, 3, 3, 2, 4]
                pick: usize = py_choice_index(rng, 5 if family == POLYGON else 6).usize()
                n: i64 = sides[pick] if family == POLYGON else stars[pick]
                degrees: f64 = (360.0 if family == POLYGON else 360.0 * strides[pick].f64()) / n.f64()
                for i in 0..<n |out, degrees|:
                    append(&out, FORWARD, 1.0)
                    append(&out, YAW, degrees)
            elif family == SPIRAL:
                n: i64 = py_randint(rng, 6, 10)
                angles: f64[4] = [60.0, 72.0, 90.0, 120.0]
                angle: f64 = angles[py_choice_index(rng, 4).usize()]
                growth: f64 = py_uniform(rng, 1.12, 1.3)
                for i in 0..<n |out, angle, growth|:
                    append(&out, FORWARD, pow(growth, i.f64()))
                    append(&out, YAW, angle)
            elif family == SPACE:
                n: i64 = py_randint(rng, 4, 7)
                yaws: f64[6] = [-120.0, -90.0, -60.0, 60.0, 90.0, 120.0]
                for i in 0..<n |out, rng, yaws|:
                    append(&out, YAW, yaws[py_choice_index(rng, 6).usize()])
                    append(&out, PITCH, -90.0 + 30.0 * py_choice_index(rng, 7).f64())
                    append(&out, FORWARD, 1.0 + 0.5 * py_choice_index(rng, 3).f64())
            elif family == COIL:
                yaws: f64[5] = [-90.0, -60.0, 60.0, 90.0, 120.0]
                pitches: f64[4] = [-45.0, -30.0, 30.0, 45.0]
                rolls: f64[4] = [60.0, 72.0, 90.0, 120.0]
                n: i64 = py_randint(rng, 2, 3)
                motif: mutable Program = zeroed
                for i in 0..<n |motif, rng, yaws, pitches|:
                    append(&motif, YAW, yaws[py_choice_index(rng, 5).usize()])
                    append(&motif, PITCH, pitches[py_choice_index(rng, 4).usize()])
                    append(&motif, FORWARD, 1.0 + 0.5 * py_choice_index(rng, 2).f64())
                reps: i64 = py_randint(rng, 3, 5)
                roll: f64 = rolls[py_choice_index(rng, 4).usize()]
                for i in 0..<reps |out, motif, roll|:
                    for j in 0..<motif.count |out, motif|:
                        op: Op = motif.ops[j.usize()]
                        append(&out, op.kind, op.value)
                    append(&out, ROLL, roll)
            elif family == BRANCH:
                a_values: f64[3] = [25.0, 30.0, 40.0]
                b_values: f64[3] = [20.0, 35.0, 45.0]
                a: f64 = a_values[py_choice_index(rng, 3).usize()]
                b: f64 = b_values[py_choice_index(rng, 3).usize()]
                depth: i64 = 2 + py_choice_index(rng, 2)
                shrink: f64 = py_uniform(rng, 0.55, 0.7)
                append(&out, PITCH, 90.0)
                grow(&out, rng, depth, 1.0, a, b, shrink)
            return out

    def bend(program: mutable Program&, rng: mutable MT19937&):
        can Abort.Panic:
            spots: mutable i64[MAX_OPS] = zeroed
            count: mutable i64 = 0
            for i in 0..<program.count |program, spots, count|:
                if program.ops[i.usize()].kind <= PITCH:
                    spots[count.usize()] <- i
                    count <- count + 1
            return if count == 0
            at: usize = spots[py_choice_index(rng, count).usize()].usize()
            op: Op = program.ops[at]
            factors: f64[3] = [0.5, 1.6, 2.0]
            offsets: f64[4] = [-60.0, -45.0, 45.0, 60.0]
            value: f64 = op.value * factors[py_choice_index(rng, 3).usize()] if op.kind == FORWARD else op.value + offsets[py_choice_index(rng, 4).usize()]
            program.ops[at] <- Op{kind: op.kind, value: value}

    def rotate_pair(a: mutable RoomsView::Vec&, b: mutable RoomsView::Vec&, degrees: f64):
        c: f64 = cos(degrees * RADIANS)
        s: f64 = sin(degrees * RADIANS)
        first: RoomsView::Vec = RoomsView::add(RoomsView::mul(a[0], c), RoomsView::mul(b[0], s))
        b[0] <- RoomsView::sub(RoomsView::mul(b[0], c), RoomsView::mul(a[0], s))
        a[0] <- first

    def magnitude(x: f64) -> f64:
        return -x if x < 0.0 else x

    struct Points:
        values: mutable RoomsView::Vec[2 * MAX_STROKES]
        count: mutable i64

    def add_point(points: mutable Points&, value: RoomsView::Vec):
        can Abort.Panic:
            for i in 0..<points.count |points, value|:
                diff: RoomsView::Vec = RoomsView::sub(value, points.values[i.usize()])
                return if magnitude(diff.x) + magnitude(diff.y) + magnitude(diff.z) < 0.000001
            points.values[points.count.usize()] <- value
            points.count <- points.count + 1

    struct Normalisation:
        centre: RoomsView::Vec
        factor: f64

    def normalisation(path: Path&) -> Normalisation:
        can Abort.Panic:
            return Normalisation{centre: zeroed, factor: 1.0} if path.count == 0
            points: mutable Points = zeroed
            for i in 0..<path.count |points, path|:
                edge: Segment = path.segments[i.usize()]
                add_point(&points, edge.a)
                add_point(&points, edge.b)
            sum: mutable RoomsView::Vec = zeroed
            for i in 0..<points.count |points, sum|:
                sum <- RoomsView::add(sum, points.values[i.usize()])
            centre: RoomsView::Vec = RoomsView::mul(sum, 1.0 / points.count.f64())
            far: mutable f64 = 0.0
            for i in 0..<points.count |points, centre, far|:
                diff: RoomsView::Vec = RoomsView::sub(points.values[i.usize()], centre)
                distance: f64 = sqrt(RoomsView::dot(diff, diff))
                far <- distance if distance > far
            return Normalisation{centre: centre, factor: 1.0 / far if far > 0.0 else 1.0}

    def normal_point(p: RoomsView::Vec, fit: Normalisation) -> RoomsView::Vec:
        return RoomsView::mul(RoomsView::sub(p, fit.centre), fit.factor)

    def normalise(path: mutable Path&, fit: Normalisation):
        can Abort.Panic:
            for i in 0..<path.count |path, fit|:
                edge: Segment = path.segments[i.usize()]
                path.segments[i.usize()] <- Segment{a: normal_point(edge.a, fit), b: normal_point(edge.b, fit)}

    def trace(program: Program&) -> Path:
        can Abort.Panic:
            out: mutable Path = zeroed
            turtle: mutable Turtle = Turtle{pos: RoomsView::vec(0.0, 0.0, 0.0),
                head: RoomsView::vec(1.0, 0.0, 0.0), left: RoomsView::vec(0.0, 1.0, 0.0),
                up: RoomsView::vec(0.0, 0.0, 1.0)}
            saved_poses: mutable Turtle[3] = zeroed
            depth: mutable i64 = 0
            for i in 0..<program.count |out, turtle, saved_poses, depth, program|:
                op: Op = program.ops[i.usize()]
                if op.kind == FORWARD:
                    next: RoomsView::Vec = RoomsView::add(turtle.pos, RoomsView::mul(turtle.head, op.value))
                    out.segments[out.count.usize()] <- Segment{a: turtle.pos, b: next}
                    out.count <- out.count + 1
                    turtle.pos <- next
                elif op.kind == YAW:
                    rotate_pair(&turtle.head, &turtle.left, op.value)
                elif op.kind == PITCH:
                    rotate_pair(&turtle.head, &turtle.up, op.value)
                elif op.kind == ROLL:
                    rotate_pair(&turtle.left, &turtle.up, op.value)
                elif op.kind == PUSH:
                    saved_poses[depth.usize()] <- turtle
                    depth <- depth + 1
                elif op.kind == POP:
                    depth <- depth - 1
                    turtle <- saved_poses[depth.usize()]
            normalise(&out, normalisation(&out))
            return out

    const TAU: f64 = 6.283185307179586
    const KNOT: i64 = 0
    const LISSA: i64 = 1
    const HELIX: i64 = 2
    const TETRA: i64 = 0
    const CUBE: i64 = 1
    const OCTA: i64 = 2

    struct Params:
        program: mutable Program
        kind: mutable i64
        n: mutable i64
        a: mutable f64
        b: mutable f64
        c: mutable f64
        twist: mutable f64
        taper: mutable f64
        height: mutable f64
        lean: mutable f64
        stretch: mutable RoomsView::Vec

    struct Face:
        vertices: mutable RoomsView::Vec[6]
        count: mutable i64
        tint: mutable i64

    struct Form:
        path: mutable Path
        tints: mutable i64[MAX_STROKES]
        faces: mutable Face[8]
        face_count: mutable i64

    def draw_params(family: i64, rng: mutable MT19937&) -> Params:
        can Abort.Panic:
            params: mutable Params = zeroed
            if family <= BRANCH:
                params.program <- make_program(family, rng)
            elif family == CURVE:
                params.kind <- py_choice_index(rng, 3)
                if params.kind == KNOT:
                    knot_a: f64[4] = [2.0, 3.0, 2.0, 3.0]
                    knot_b: f64[4] = [3.0, 2.0, 5.0, 4.0]
                    choice: usize = py_choice_index(rng, 4).usize()
                    params.a <- knot_a[choice]
                    params.b <- knot_b[choice]
                elif params.kind == LISSA:
                    pool: mutable f64[4] = [1.0, 2.0, 3.0, 4.0]
                    a: usize = py_choice_index(rng, 4).usize()
                    params.a <- pool[a]
                    pool[a] <- pool[3]
                    b: usize = py_choice_index(rng, 3).usize()
                    params.b <- pool[b]
                    pool[b] <- pool[2]
                    params.c <- pool[py_choice_index(rng, 2).usize()]
                else:
                    params.a <- 1.5 + 0.5 * py_choice_index(rng, 3).f64()
                    params.b <- 1.0 if py_choice_index(rng, 2) == 0 else -1.0
                params.n <- py_randint(rng, 11, 14) if params.kind == HELIX else py_randint(rng, 12, 15)
            elif family == PRISM:
                heights: f64[3] = [0.6, 1.0, 1.5]
                params.n <- py_randint(rng, 3, 6)
                params.twist <- 15.0 * py_choice_index(rng, 3).f64()
                params.taper <- 0.55 if py_choice_index(rng, 3) == 2 else 1.0
                params.height <- heights[py_choice_index(rng, 3).usize()]
            elif family == PYRAMID:
                leans: f64[3] = [0.0, 0.5, 0.9]
                params.n <- py_randint(rng, 3, 6)
                params.lean <- leans[py_choice_index(rng, 3).usize()]
                params.height <- 1.0 if py_choice_index(rng, 2) == 0 else 1.6
            elif family == SOLID:
                sizes: f64[3] = [0.6, 1.0, 1.6]
                params.kind <- py_choice_index(rng, 3)
                sx: f64 = sizes[py_choice_index(rng, 3).usize()]
                sy: f64 = sizes[py_choice_index(rng, 3).usize()]
                sz: f64 = sizes[py_choice_index(rng, 2).usize()]
                params.stretch <- RoomsView::vec(sx, sy, sz)
            return params

    def edge(path: mutable Path&, a: RoomsView::Vec, b: RoomsView::Vec):
        can Abort.Panic:
            path.segments[path.count.usize()] <- Segment{a: a, b: b}
            path.count <- path.count + 1

    def closed_edges(path: mutable Path&, vertices: RoomsView::Vec[6], n: i64):
        can Abort.Panic:
            for i in 0..<n |path, vertices, n|:
                edge(path, vertices[i.usize()], vertices[((i + 1) % n).usize()])

    def face(form: mutable Form&, vertices: RoomsView::Vec[6], n: i64):
        can Abort.Panic:
            form.faces[form.face_count.usize()] <- Face{vertices: vertices, count: n, tint: 0}
            form.face_count <- form.face_count + 1

    def ring(n: i64, radius: f64, y: f64, twist: f64 = 0.0) -> RoomsView::Vec[6]:
        can Abort.Panic:
            out: mutable RoomsView::Vec[6] = zeroed
            for i in 0..<n |out, n, radius, y, twist|:
                angle: f64 = TAU * i.f64() / n.f64() + twist
                out[i.usize()] <- RoomsView::vec(radius * cos(angle), y, radius * sin(angle))
            return out

    def prism(form: mutable Form&, bottom: RoomsView::Vec[6], top: RoomsView::Vec[6], n: i64):
        can Abort.Panic:
            closed_edges(&form.path, bottom, n)
            for i in 0..<n |form, bottom, top|:
                edge(&form.path, bottom[i.usize()], top[i.usize()])
            closed_edges(&form.path, top, n)
            face(form, bottom, n)
            face(form, top, n)
            for i in 0..<n |form, bottom, top, n|:
                j: usize = ((i + 1) % n).usize()
                k: usize = i.usize()
                corners: RoomsView::Vec[6] = [bottom[k], bottom[j], top[j], top[k], zeroed, zeroed]
                face(form, corners, 4)

    def tip(form: mutable Form&, bottom: RoomsView::Vec[6], n: i64, apex: RoomsView::Vec):
        can Abort.Panic:
            for i in 0..<n |form, bottom, apex|:
                edge(&form.path, bottom[i.usize()], apex)
            for i in 0..<n |form, bottom, n, apex|:
                corners: RoomsView::Vec[6] = [bottom[i.usize()], bottom[((i + 1) % n).usize()], apex, zeroed, zeroed, zeroed]
                face(form, corners, 3)

    def curve_point(p: Params&, index: i64) -> RoomsView::Vec:
        t: f64 = TAU * index.f64() / p.n.f64()
        if p.kind == KNOT:
            r: f64 = cos(p.b * t) + 2.2
            return RoomsView::vec(r * cos(p.a * t), r * sin(p.a * t), -sin(p.b * t) * 1.3)
        if p.kind == LISSA:
            return RoomsView::vec(sin(p.a * t + TAU / 4.0), sin(p.b * t), sin(p.c * t + TAU / 8.0))
        fraction: f64 = index.f64() / p.n.f64()
        angle: f64 = TAU * (p.a * p.b) * fraction
        return RoomsView::vec(cos(angle), 2.4 * fraction - 1.2, sin(angle))

    def stretch_point(p: RoomsView::Vec, scale: RoomsView::Vec) -> RoomsView::Vec:
        return RoomsView::vec(p.x * scale.x, p.y * scale.y, p.z * scale.z)

    def stretch(form: mutable Form&, scale: RoomsView::Vec):
        can Abort.Panic:
            for i in 0..<form.path.count |form, scale|:
                stroke: Segment = form.path.segments[i.usize()]
                form.path.segments[i.usize()] <- Segment{a: stretch_point(stroke.a, scale), b: stretch_point(stroke.b, scale)}
            for i in 0..<form.face_count |form, scale|:
                poly: mutable Face& = &form.faces[i.usize()]
                for j in 0..<poly.count |poly, scale|:
                    poly.vertices[j.usize()] <- stretch_point(poly.vertices[j.usize()], scale)

    def make_solid(form: mutable Form&, kind: i64):
        can Abort.Panic:
            if kind == CUBE:
                bottom: RoomsView::Vec[6] = [RoomsView::vec(-1.0, -1.0, -1.0), RoomsView::vec(1.0, -1.0, -1.0),
                    RoomsView::vec(1.0, -1.0, 1.0), RoomsView::vec(-1.0, -1.0, 1.0), zeroed, zeroed]
                top: RoomsView::Vec[6] = [RoomsView::vec(-1.0, 1.0, -1.0), RoomsView::vec(1.0, 1.0, -1.0),
                    RoomsView::vec(1.0, 1.0, 1.0), RoomsView::vec(-1.0, 1.0, 1.0), zeroed, zeroed]
                prism(form, bottom, top, 4)
            elif kind == OCTA:
                bottom: RoomsView::Vec[6] = [RoomsView::vec(1.0, 0.0, 0.0), RoomsView::vec(0.0, 0.0, 1.0),
                    RoomsView::vec(-1.0, 0.0, 0.0), RoomsView::vec(0.0, 0.0, -1.0), zeroed, zeroed]
                closed_edges(&form.path, bottom, 4)
                tip(form, bottom, 4, RoomsView::vec(0.0, 1.2, 0.0))
                tip(form, bottom, 4, RoomsView::vec(0.0, -1.2, 0.0))
            else:
                bottom: RoomsView::Vec[6] = ring(3, 1.0, -0.5)
                closed_edges(&form.path, bottom, 3)
                face(form, bottom, 3)
                tip(form, bottom, 3, RoomsView::vec(0.0, 1.1, 0.0))

    def build(family: i64, p: Params&) -> Form:
        can Abort.Panic:
            out: mutable Form = zeroed
            if family <= BRANCH:
                out.path <- trace(&p.program)
                return out
            if family == CURVE:
                for i in 0..<p.n |p, out|:
                    next: i64 = i + 1 if p.kind == HELIX else (i + 1) % p.n
                    edge(&out.path, curve_point(p, i), curve_point(p, next))
            elif family == PRISM:
                h: f64 = p.height / 2.0
                bottom: RoomsView::Vec[6] = ring(p.n, 1.0, -h)
                top: RoomsView::Vec[6] = ring(p.n, p.taper, h, p.twist * RADIANS)
                prism(&out, bottom, top, p.n)
            elif family == PYRAMID:
                bottom: RoomsView::Vec[6] = ring(p.n, 1.0, -0.6)
                closed_edges(&out.path, bottom, p.n)
                face(&out, bottom, p.n)
                tip(&out, bottom, p.n, RoomsView::vec(p.lean, p.height - 0.6, 0.0))
            elif family == SOLID:
                make_solid(&out, p.kind)
                stretch(&out, p.stretch)
            fit: Normalisation = normalisation(&out.path)
            normalise(&out.path, fit)
            for i in 0..<out.face_count |out, fit|:
                poly: mutable Face& = &out.faces[i.usize()]
                for j in 0..<poly.count |poly, fit|:
                    poly.vertices[j.usize()] <- normal_point(poly.vertices[j.usize()], fit)
            return out

    def nudge(family: i64, p: mutable Params&, rng: mutable MT19937&):
        can Abort.Panic:
            if family <= BRANCH:
                bend(&p.program, rng)
            elif family == CURVE:
                if p.kind == KNOT:
                    knot_a: f64[4] = [2.0, 3.0, 2.0, 3.0]
                    knot_b: f64[4] = [3.0, 2.0, 5.0, 4.0]
                    remaining: mutable i64 = py_choice_index(rng, 3)
                    for i in 0..<4 |p, knot_a, knot_b, remaining|:
                        a: f64 = knot_a[i.usize()]
                        b: f64 = knot_b[i.usize()]
                        continue if a == p.a and b == p.b
                        if remaining == 0:
                            p.a <- a
                            p.b <- b
                            break
                        remaining <- remaining - 1
                elif p.kind == LISSA:
                    axis: i64 = py_choice_index(rng, 3)
                    remaining: mutable i64 = py_choice_index(rng, 2)
                    for i in 1..<6 |p, axis, remaining|:
                        value: f64 = i.f64()
                        continue if value == p.a or value == p.b or value == p.c
                        if remaining == 0:
                            p.a <- value if axis == 0
                            p.b <- value if axis == 1
                            p.c <- value if axis == 2
                            break
                        remaining <- remaining - 1
                else:
                    increments: f64[3] = [-0.5, 0.5, 1.0]
                    p.a <- p.a + increments[py_choice_index(rng, 3).usize()]
            elif family == PRISM:
                changed: i64 = py_choice_index(rng, 4)
                if changed == 0:
                    p.n <- p.n + (1 if p.n < 6 else -1)
                elif changed == 1:
                    p.twist <- 30.0 if p.twist != 30.0 else 0.0
                elif changed == 2:
                    p.taper <- 0.55 if p.taper == 1.0 else 1.0
                else:
                    p.height <- 0.6 if p.height != 0.6 else 1.5
            elif family == PYRAMID:
                if py_random(rng) < 0.5:
                    p.n <- p.n + (1 if p.n < 6 else -1)
                else:
                    p.lean <- 0.9 if p.lean < 0.5 else 0.0
            elif family == SOLID:
                s: RoomsView::Vec = p.stretch
                p.stretch <- RoomsView::vec(s.y, s.x * 1.6 if s.x < 1.5 else 0.6, s.z)

    const TINTS: i64 = 3
    const RANDOM_STYLE: i64 = -1
    const RUNS: i64 = 0
    const CYCLE: i64 = 1
    const SHUFFLED: i64 = 2

    def pick_mode(level: Grade&, rng: mutable MT19937&) -> i64:
        can Abort.Panic:
            total: mutable f64 = 0.0
            for i in 0..<level.mode_count |level, total|:
                total <- total + level.modes[i.usize()].weight
            roll: mutable f64 = py_random(rng) * total
            for i in 0..<level.mode_count |level, roll|:
                entry: Mode = level.modes[i.usize()]
                roll <- roll - entry.weight
                return entry.kind if roll <= 0.0
            return level.modes[(level.mode_count - 1).usize()].kind

    def colour(form: mutable Form&, count: i64, rng: mutable MT19937&, style: i64 = RANDOM_STYLE):
        can Memory.Allocate, Abort.Panic:
            n: i64 = form.path.count
            colours: i64 = count if count < n else n
            if colours <= 1:
                for i in 0..<n |form|:
                    form.tints[i.usize()] <- 0
                for i in 0..<form.face_count |form|:
                    form.faces[i.usize()].tint <- 0
                return
            chosen: i64 = py_choice_index(rng, 3) if style == RANDOM_STYLE else style
            if chosen == RUNS:
                cuts: darray[i64] = py_sample_range(rng, 1, n - 1, colours - 1)
                for i in 0..<n |form, cuts|:
                    tint: mutable i64 = 0
                    for cut in cuts |i, tint|:
                        tint <- tint + 1 if i >= cut
                    form.tints[i.usize()] <- tint
            elif chosen == CYCLE:
                for i in 0..<n |form, colours|:
                    form.tints[i.usize()] <- i % colours
            else:
                for i in 0..<n |form, colours, rng|:
                    form.tints[i.usize()] <- i if i < colours else py_choice_index(rng, colours)
                i: mutable i64 = n - 1
                while i > 0 |form, rng, i|:
                    target: usize = py_choice_index(rng, i + 1).usize()
                    value: i64 = form.tints[target]
                    form.tints[target] <- form.tints[i.usize()]
                    form.tints[i.usize()] <- value
                    i <- i - 1
            for i in 0..<form.face_count |form, colours, rng|:
                form.faces[i.usize()].tint <- py_choice_index(rng, colours)

    def exchanged(value: i64, a: i64, b: i64) -> i64:
        return b if value == a else (a if value == b else value)

    def recolour(form: mutable Form&, rng: mutable MT19937&):
        can Memory.Allocate, Abort.Panic:
            mask: mutable i64 = 0
            for i in 0..<form.path.count |form, mask|:
                mask <- mask | (1 << form.tints[i.usize()])
            used: mutable i64[TINTS] = zeroed
            count: mutable i64 = 0
            for i in 0..<TINTS |mask, used, count|:
                if (mask & (1 << i)) != 0:
                    used[count.usize()] <- i
                    count <- count + 1
            return if count < 2
            if py_random(rng) >= 0.5:
                colour(form, count, rng)
                return
            first: usize = py_choice_index(rng, count).usize()
            a: i64 = used[first]
            used[first] <- used[(count - 1).usize()]
            b: i64 = used[py_choice_index(rng, count - 1).usize()]
            for i in 0..<form.path.count |form, a, b|:
                form.tints[i.usize()] <- exchanged(form.tints[i.usize()], a, b)
            for i in 0..<form.face_count |form, a, b|:
                form.faces[i.usize()].tint <- exchanged(form.faces[i.usize()].tint, a, b)

    struct Matrix:
        x: RoomsView::Vec
        y: RoomsView::Vec
        z: RoomsView::Vec

    def apply(m: Matrix, v: RoomsView::Vec) -> RoomsView::Vec:
        return RoomsView::vec(RoomsView::dot(m.x, v), RoomsView::dot(m.y, v), RoomsView::dot(m.z, v))

    def matmul(a: Matrix, b: Matrix) -> Matrix:
        t: Matrix = Matrix{x: RoomsView::vec(b.x.x, b.y.x, b.z.x),
            y: RoomsView::vec(b.x.y, b.y.y, b.z.y), z: RoomsView::vec(b.x.z, b.y.z, b.z.z)}
        return Matrix{x: apply(t, a.x), y: apply(t, a.y), z: apply(t, a.z)}

    def axis_turn(axis: RoomsView::Vec, angle: f64) -> Matrix:
        length: f64 = sqrt(RoomsView::dot(axis, axis))
        n: RoomsView::Vec = RoomsView::mul(axis, 1.0 / length) if length > 0.0 else axis
        c: f64 = cos(angle)
        s: f64 = sin(angle)
        t: f64 = 1.0 - c
        x: f64 = n.x
        y: f64 = n.y
        z: f64 = n.z
        return Matrix{x: RoomsView::vec(t * x * x + c, t * x * y - s * z, t * x * z + s * y),
            y: RoomsView::vec(t * x * y + s * z, t * y * y + c, t * y * z - s * x),
            z: RoomsView::vec(t * x * z - s * y, t * y * z + s * x, t * z * z + c)}

    def random_turn(rng: mutable MT19937&) -> Matrix:
        can Abort.Panic:
            u: f64 = py_random(rng)
            v: f64 = TAU * py_random(rng)
            t: f64 = TAU * py_random(rng)
            a: f64 = sqrt(1.0 - u)
            b: f64 = sqrt(u)
            w: f64 = a * sin(v)
            x: f64 = a * cos(v)
            y: f64 = b * sin(t)
            z: f64 = b * cos(t)
            return Matrix{x: RoomsView::vec(1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y - z * w), 2.0 * (x * z + y * w)),
                y: RoomsView::vec(2.0 * (x * y + z * w), 1.0 - 2.0 * (x * x + z * z), 2.0 * (y * z - x * w)),
                z: RoomsView::vec(2.0 * (x * z - y * w), 2.0 * (y * z + x * w), 1.0 - 2.0 * (x * x + y * y))}

    def direction(path: Path&, index: i64) -> RoomsView::Vec:
        can Abort.Panic:
            edge: Segment = path.segments[index.usize()]
            return RoomsView::sub(edge.b, edge.a)

    def handedness(path: Path&) -> f64:
        can Abort.Panic:
            twist: mutable f64 = 0.0
            for i in 0..<(path.count - 2) |twist, path|:
                twist <- twist + RoomsView::dot(RoomsView::cross(direction(path, i), direction(path, i + 1)), direction(path, i + 2))
            return twist

    const DISTANCES: i64 = MAX_STROKES * (2 * MAX_STROKES - 1)

    struct Distance:
        tag: i64
        value: f64

    struct Signature:
        distances: mutable Distance[DISTANCES]
        count: mutable i64

    def add_distance(out: mutable Signature&, entry: Distance):
        can Abort.Panic:
            index: mutable i64 = out.count
            while index > 0 |out, entry, index|:
                prior: Distance = out.distances[(index - 1).usize()]
                break if prior.tag < entry.tag or (prior.tag == entry.tag and prior.value <= entry.value)
                out.distances[index.usize()] <- prior
                index <- index - 1
            out.distances[index.usize()] <- entry
            out.count <- out.count + 1

    def distance(a: RoomsView::Vec, b: RoomsView::Vec) -> f64:
        delta: RoomsView::Vec = RoomsView::sub(a, b)
        return sqrt(RoomsView::dot(delta, delta))

    def signature(path: Path&) -> Signature:
        can Abort.Panic:
            points: mutable Points = zeroed
            for i in 0..<path.count |points, path|:
                e: Segment = path.segments[i.usize()]
                add_point(&points, e.a)
                add_point(&points, e.b)
            out: mutable Signature = zeroed
            for i in 0..<points.count |points, out|:
                for j in (i + 1)..<points.count |points, i, out|:
                    length: f64 = distance(points.values[i.usize()], points.values[j.usize()])
                    add_distance(&out, Distance{tag: 0, value: length})
            return out

    struct ColourPoint:
        tag: i64
        point: RoomsView::Vec

    def centroid(face: Face&) -> RoomsView::Vec:
        can Abort.Panic:
            total: mutable RoomsView::Vec = zeroed
            for i in 0..<face.count |total, face|:
                total <- RoomsView::add(total, face.vertices[i.usize()])
            return RoomsView::mul(total, 1.0 / face.count.f64())

    def colour_signature(form: Form&) -> Signature:
        can Abort.Panic:
            items: mutable ColourPoint[MAX_STROKES + 8] = zeroed
            for i in 0..<form.path.count |form, items|:
                k: usize = i.usize()
                e: Segment = form.path.segments[k]
                items[k] <- ColourPoint{tag: form.tints[k], point: RoomsView::mul(RoomsView::add(e.a, e.b), 0.5)}
            for i in 0..<form.face_count |form, items|:
                f: Face& = &form.faces[i.usize()]
                items[(form.path.count + i).usize()] <- ColourPoint{tag: 10 + f.tint, point: centroid(f)}
            count: i64 = form.path.count + form.face_count
            out: mutable Signature = zeroed
            for i in 0..<count |count, items, out|:
                a: ColourPoint = items[i.usize()]
                add_distance(&out, Distance{tag: a.tag * 16, value: 0.0})
                for j in (i + 1)..<count |a, items, out|:
                    b: ColourPoint = items[j.usize()]
                    tag: i64 = a.tag * 16 + b.tag + 1 if a.tag <= b.tag else b.tag * 16 + a.tag + 1
                    add_distance(&out, Distance{tag: tag, value: distance(a.point, b.point)})
            return out

    def signature_gap(a: Signature&, b: Signature&) -> f64:
        can Abort.Panic:
            return 100.0 if a.count != b.count
            gap: mutable f64 = 0.0
            for i in 0..<a.count |a, b, gap|:
                x: Distance = a.distances[i.usize()]
                y: Distance = b.distances[i.usize()]
                return 100.0 if x.tag != y.tag
                delta: f64 = magnitude(x.value - y.value)
                gap <- delta if delta > gap
            return gap

    def distinct(a: Form&, b: Form&, margin: f64 = 0.12, size_a: f64 = 1.0, size_b: f64 = 1.0) -> bool:
        can Abort.Panic:
            return true if magnitude(log(size_a / size_b)) > 0.3 or a.path.count != b.path.count
            sa: Signature = signature(&a.path)
            sb: Signature = signature(&b.path)
            gap: f64 = signature_gap(&sa, &sb)
            return true if gap > margin
            return false if gap > 0.02
            ha: f64 = handedness(&a.path)
            hb: f64 = handedness(&b.path)
            return true if magnitude(ha) > 0.08 and (ha > 0.0) != (hb > 0.0)
            ca: Signature = colour_signature(a)
            cb: Signature = colour_signature(b)
            return signature_gap(&ca, &cb) > 0.02
