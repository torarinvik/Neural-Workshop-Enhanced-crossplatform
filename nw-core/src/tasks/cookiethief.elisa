# Cookie Thief: a jar, a door that only ever opens, and somebody coming.
#
# Port of neural_workshop/cookiethief.py (GPL-2.0-or-later). Every grab lifts
# the door two ways: a FLOOR that never falls (cookies already gone) and a
# NOISE that a quiet beat takes back off. She comes when the door reads past a
# trigger the thief is never shown, or when her patience runs out.
#
# ## The ordering that is the whole task
#
# `beat` asks the door AFTER the grab has landed, so she arrives on the grab
# that opened it -- not the one after. That is what makes the fatal press the
# press itself, and it is why a rung with no warning cannot be played by
# watching the doorway. Reordering those two lines gives a game that is still
# playable and is a different game.
#
# The idle rule has the same character. `idle` is computed BEFORE the noise is
# taken off, so the beat that finishes clearing the pace is a beat that DID
# something; the first beat with nothing left to settle is the one that starts
# counting as standing there. The reference records that without the clause the
# rule fought the game -- waiting is how a fast hand buys its next grab, and the
# top rungs need exactly four quiet beats, so the thief walked off mid-plan one
# cookie short on every rung above the sixth.
#
# ## Random-stream fidelity
#
#   generate  randrange(spread)           the trigger
#             randrange(slack + 1)        the deadline
#             if the rung has decoys:
#                 shuffle(range(3, ...))  then a greedy non-adjacent pick
#                 choice((SISTER, DOG))   per decoy, in SORTED beat order
#
# The decoy draw runs over `sorted(picked)`, not over the shuffled order, so
# the shuffle decides WHICH beats and the sort decides the order the two
# choice() draws happen in. Picking in shuffled order would consume the same
# number of values and assign them to different decoys.

module CookieThief:
    const SAFE: i64 = 100
    const GOLD_BEATS: i64 = 6
    const GOLD_GAP: i64 = 3
    const GOLD_REACH: i64 = 2
    const CAUGHT_COST: i64 = 2
    const SETTLE: i64 = 4
    const GRADE_COUNT: i64 = 10

    # Ports.
    const GRAB: i64 = 0
    const LEAVE: i64 = 1
    const LUNGE: i64 = 2
    const WAIT: i64 = 3

    # Phases.
    const AWAY: i64 = 0
    const COMING: i64 = 1
    const WATCHING: i64 = 2
    const GONE: i64 = 3

    # Who is in the doorway.
    const NOBODY: i64 = 0
    const MOTHER: i64 = 1
    const SISTER: i64 = 2
    const DOG: i64 = 3

    struct Grade:
        quota: mutable i64
        notice: mutable i64
        opening: mutable i64
        settling: mutable i64
        spread: mutable i64
        warn: mutable i64
        visit: mutable i64
        patience: mutable i64
        slack: mutable i64
        gold: mutable i64
        decoys: mutable i64

    # Ten rungs. Each adds one thing. The WARNING only ever gets shorter -- six
    # beats down to none, running out for good at the sixth rung. Below that the
    # doorway can be watched; above it the door is the only warning there is, and
    # it is a range rather than a number.
    def grade_at(level: i64) -> Grade:
        can Abort.Panic:
            index: mutable i64 = level - 1
            index <- 0 if index < 0 else index
            index <- GRADE_COUNT - 1 if index > GRADE_COUNT - 1 else index
            g: mutable Grade = zeroed
            if index == 0:
                g.quota <- 1
                g.notice <- 8
                g.opening <- 0
                g.settling <- 40
                g.spread <- 60
                g.warn <- 6
                g.visit <- 5
                g.patience <- 26
                g.slack <- 6
            elif index == 1:
                g.quota <- 4
                g.notice <- 8
                g.opening <- 0
                g.settling <- 40
                g.spread <- 60
                g.warn <- 5
                g.visit <- 5
                g.patience <- 26
                g.slack <- 6
            elif index == 2:
                g.quota <- 7
                g.notice <- 6
                g.opening <- 4
                g.settling <- 24
                g.spread <- 55
                g.warn <- 4
                g.visit <- 5
                g.patience <- 30
                g.slack <- 6
            elif index == 3:
                g.quota <- 9
                g.notice <- 6
                g.opening <- 5
                g.settling <- 22
                g.spread <- 50
                g.warn <- 3
                g.visit <- 6
                g.patience <- 32
                g.slack <- 6
            elif index == 4:
                g.quota <- 11
                g.notice <- 5
                g.opening <- 5
                g.settling <- 20
                g.spread <- 48
                g.warn <- 2
                g.visit <- 6
                g.patience <- 34
                g.slack <- 6
            elif index == 5:
                g.quota <- 11
                g.notice <- 5
                g.opening <- 5
                g.settling <- 20
                g.spread <- 46
                g.warn <- 0
                g.visit <- 6
                g.patience <- 34
                g.slack <- 6
            elif index == 6:
                g.quota <- 12
                g.notice <- 5
                g.opening <- 6
                g.settling <- 18
                g.spread <- 42
                g.warn <- 0
                g.visit <- 7
                g.patience <- 36
                g.slack <- 6
            elif index == 7:
                g.quota <- 12
                g.notice <- 5
                g.opening <- 6
                g.settling <- 18
                g.spread <- 40
                g.warn <- 0
                g.visit <- 7
                g.patience <- 36
                g.slack <- 5
                g.gold <- 6
            elif index == 8:
                g.quota <- 13
                g.notice <- 5
                g.opening <- 7
                g.settling <- 16
                g.spread <- 36
                g.warn <- 0
                g.visit <- 8
                g.patience <- 38
                g.slack <- 5
                g.gold <- 6
                g.decoys <- 1
            else:
                g.quota <- 14
                g.notice <- 5
                g.opening <- 8
                g.settling <- 14
                g.spread <- 30
                g.warn <- 0
                g.visit <- 8
                g.patience <- 40
                g.slack <- 5
                g.gold <- 8
                g.decoys <- 2
            return g

    # The door reading she certainly comes at.
    def limit(g: Grade&) -> i64:
        return SAFE + g.spread

    # Cookies he can take without ever hurrying, at worst. A quiet beat takes the
    # noise back off but never the gap in the jar, so this is the hard ceiling on a
    # round however patient anybody is.
    def room(g: Grade&) -> i64:
        can Abort.Panic:
            value: i64 = (SAFE - 1 - g.opening) / g.notice
            return 0 if value < 0 else value

    # Is there anything to react to at all? True and the rung can be played by
    # watching the doorway; false and the grab that brings her is a grab she is
    # already looking at.
    def reactive(g: Grade&) -> bool:
        return g.warn > 0

    def beats_of(g: Grade&) -> i64:
        can Abort.Panic:
            warn: i64 = 1 if g.warn < 1 else g.warn
            return g.patience + g.slack + warn + g.visit + 4

    struct Setup:
        trigger: mutable i64
        deadline: mutable i64
        decoy_at: mutable darray[i64]
        decoy_who: mutable darray[i64]
        decoy_n: mutable i64

    struct Thief:
        jar: mutable i64
        eaten: mutable i64
        caught: mutable i64
        pace: mutable i64
        beat: mutable i64
        phase: mutable i64
        who: mutable i64
        until: mutable i64
        gold_from: mutable i64
        gold_taken: mutable bool
        reaching: mutable i64
        took: mutable i64
        noisy: mutable bool
        seen: mutable bool
        left: mutable bool
        still: mutable i64

    def Thief() -> Thief:
        can Abort.Panic:
            t: mutable Thief = zeroed
            t.phase <- AWAY
            t.who <- NOBODY
            t.gold_from <- -1
            return t

    # How far open the door is: the jar's floor plus the noise on top. Every term
    # is on the screen -- the floor is the cookies already gone and never falls;
    # the noise is how quick he has been, and that does.
    def door(t: Thief&, g: Grade&) -> i64:
        return t.jar * g.notice + t.pace

    def floor_of(t: Thief&, g: Grade&) -> i64:
        return t.jar * g.notice

    # What the door would read if he took one right now. Nothing about the trigger,
    # the deadline or the decoys goes into it, which is what makes it safe to shape
    # with: it says how far one more cookie would open the door and nothing at all
    # about where she is.
    def after_a_grab(t: Thief&, g: Grade&) -> i64:
        return door(t, g) + g.notice + g.opening

    def certain(t: Thief&, g: Grade&) -> bool:
        return after_a_grab(t, g) >= limit(g)

    def safe(t: Thief&, g: Grade&) -> bool:
        return after_a_grab(t, g) < SAFE

    def gold_on_offer(t: Thief&) -> bool:
        return t.gold_from >= 0 and not t.gold_taken and t.beat < t.gold_from + GOLD_BEATS

    def committed(t: Thief&) -> bool:
        return t.reaching > 0

    # Deal one round. Deterministic in `seed`.
    def generate(level: i64, seed: i64) -> Setup:
        can Memory.Allocate, Abort.Panic:
            g: Grade = grade_at(level)
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())

            setup: mutable Setup = zeroed
            setup.decoy_at <- Ints::zeros(g.decoys + 1)
            setup.decoy_who <- Ints::zeros(g.decoys + 1)
            setup.trigger <- SAFE + py_randbelow(&rng, g.spread.u64()).i64()
            setup.deadline <- g.patience + py_randbelow(&rng, (g.slack + 1).u64()).i64()

            if g.decoys > 0:
                # Kept clear of each other, so a figure in the doorway is always
                # ONE figure and always resolves before the next thing happens.
                gap: i64 = (1 if g.warn < 1 else g.warn) + 2
                high: mutable i64 = setup.deadline - gap
                high <- 4 if high < 4 else high
                span: i64 = high - 3
                floors: mutable darray[i64] = Ints::zeros(span + 1)
                fill: mutable i64 = 0
                while fill < span |fill, span, floors|:
                    Ints::put(&floors, fill, 3 + fill)
                    fill <- fill + 1
                py_shuffle_i64_prefix(&rng, &floors, span)

                picked: mutable darray[i64] = Ints::zeros(g.decoys + 1)
                picked_n: mutable i64 = 0
                scan: mutable i64 = 0
                while scan < span and picked_n < g.decoys |scan, span, floors, picked, picked_n, gap|:
                    at: i64 = Ints::at(floors, scan)
                    clear: mutable bool = true
                    other: mutable i64 = 0
                    while other < picked_n |other, picked_n, picked, at, clear, gap|:
                        delta: i64 = at - Ints::at(picked, other)
                        magnitude: i64 = delta if delta >= 0 else 0 - delta
                        clear <- false if magnitude <= gap
                        other <- other + 1
                    if clear:
                        Ints::put(&picked, picked_n, at)
                        picked_n <- picked_n + 1
                    scan <- scan + 1

                # sorted(picked): the shuffle decides WHICH beats, and the sort
                # decides the order the choice() draws happen in. Drawing in
                # shuffled order consumes the same values and assigns them to
                # different decoys.
                Ints::sort_prefix(&picked, picked_n)
                take: mutable i64 = 0
                while take < picked_n |take, picked_n, picked, setup, rng|:
                    Ints::put(&setup.decoy_at, take, Ints::at(picked, take))
                    Ints::put(&setup.decoy_who, take, SISTER if py_choice_index(&rng, 2) == 0 else DOG)
                    take <- take + 1
                setup.decoy_n <- picked_n
            return setup

    # Do the thing, now. Whether it was seen is the beat's business: the cookie is
    # in the count on the beat it was asked for and his hand is back at his side.
    # Nothing is queued and nothing is in flight, which is the difference between
    # this and every earlier version of the task -- there is one thing a thief can
    # be wrong about and it is WHETHER to press, never WHEN the press arrives.
    def press(t: mutable Thief&, port: i64, setup: Setup&, g: Grade&) -> bool:
        can Abort.Panic:
            # Both hands at the back of the counter. This is the whole cost of the
            # golden one and it is why it is worth anything.
            false return if committed(t)
            if port == GRAB:
                t.jar <- t.jar + 1
                t.eaten <- t.eaten + 1
                t.pace <- t.pace + g.opening
                t.took <- 1
                t.noisy <- true
                if g.gold != 0 and t.gold_from < 0 and t.jar >= g.quota - GOLD_GAP:
                    t.gold_from <- t.beat
                return true
            if port == LEAVE:
                t.left <- true
                return true
            if port == LUNGE and gold_on_offer(t):
                t.gold_taken <- true
                t.reaching <- GOLD_REACH
                t.pace <- t.pace + g.opening
                t.noisy <- true
                return true
            return false

    def figure(t: mutable Thief&, g: Grade&):
        can Abort.Panic:
            return if t.phase == AWAY or t.phase == GONE
            return if t.beat < t.until
            if t.phase == COMING:
                if t.who == MOTHER:
                    t.phase <- WATCHING
                    t.until <- t.beat + g.visit
                else:
                    t.phase <- AWAY
                    t.who <- NOBODY
            elif t.phase == WATCHING:
                t.phase <- GONE

    # Does anybody arrive this beat? SHE wins over a decoy, because a round in
    # which the real one was hidden behind a false one is a round nobody could have
    # played. With no warning she does not stand in the doorway first: she is
    # looking on the beat she arrives, and the grab that opened the door that far
    # is one she saw.
    def arrive(t: mutable Thief&, setup: Setup&, g: Grade&):
        can Abort.Panic:
            return if t.phase != AWAY
            if door(t, g) >= setup.trigger or t.beat >= setup.deadline:
                t.who <- MOTHER
                if g.warn != 0:
                    t.phase <- COMING
                    t.until <- t.beat + g.warn
                else:
                    t.phase <- WATCHING
                    t.until <- t.beat + g.visit
                return
            index: mutable i64 = 0
            arrived: mutable bool = false
            while index < setup.decoy_n and not arrived |index, setup, t, g, arrived|:
                if Ints::at(setup.decoy_at, index) == t.beat:
                    t.phase <- COMING
                    t.who <- Ints::at(setup.decoy_who, index)
                    # Visible for a beat even on the rungs with no warning at all,
                    # or there would be nothing to tell apart.
                    t.until <- t.beat + (1 if g.warn < 1 else g.warn)
                    arrived <- true
                index <- index + 1

    # One beat of the kitchen: the door moves, and she may be behind it.
    #
    # The ORDER is the whole of the timing. Whatever he did has already happened --
    # press did it -- so the door is asked AFTER the grab, and she arrives on
    # the grab that opened it.
    def beat(t: mutable Thief&, setup: Setup&, g: Grade&) -> i64:
        can Abort.Panic:
            t.beat <- t.beat + 1
            if t.reaching != 0:
                t.reaching <- t.reaching - 1
                t.pace <- t.pace + g.opening
                t.noisy <- true
                if t.reaching == 0:
                    t.eaten <- t.eaten + g.gold
                    t.took <- g.gold
            figure(t, g)
            arrive(t, setup, g)
            t.seen <- t.phase == WATCHING and t.noisy
            if t.seen:
                t.caught <- t.caught + 1
            # Asked BEFORE the noise is taken off rather than after, so the beat
            # that finishes clearing it is a beat that did something. It is the
            # beat after that one, the first with nothing left to settle, that
            # starts counting as standing there.
            idle: bool = not t.noisy and t.pace == 0 and t.jar != 0 and t.phase == AWAY
            if not t.noisy:
                reduced: i64 = t.pace - g.settling
                t.pace <- 0 if reduced < 0 else reduced
            t.still <- t.still + 1 if idle else 0
            took: i64 = t.took
            t.took <- 0
            t.noisy <- false
            return took

    def over(t: Thief&, g: Grade&) -> bool:
        can Abort.Panic:
            return t.left or t.phase == GONE or t.still >= SETTLE or t.beat >= beats_of(g)

    def cleared(t: Thief&, g: Grade&) -> bool:
        return t.eaten >= g.quota and t.caught == 0

    # What the round was worth, which is not whether it was won. The verdict is a
    # bar -- the quota, cleanly -- and the haul is the margin: every cookie counts,
    # including the ones past the quota, and every grab she saw costs CAUGHT_COST.
    def haul(t: Thief&) -> i64:
        return t.eaten - CAUGHT_COST * t.caught
