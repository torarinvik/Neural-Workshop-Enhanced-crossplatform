include "../pyrandom.elisa"

module Triage:
    const OPEN: i64 = 0
    const SWAP: i64 = 1
    const DONE: i64 = 2
    const MAX_CARDS: i64 = 8

    struct Grade:
        rung: i64
        cards: i64
        shortest: i64
        longest: i64
        tight: f64
        traps: bool
        hidden: bool

    struct Card:
        row: mutable u64
        length: mutable i64
        pays: mutable i64
        cost: mutable i64

    struct Deal:
        level: mutable Grade
        cards: mutable Card[MAX_CARDS]
        budget: mutable i64

    struct Round:
        rows: mutable u64[MAX_CARDS]
        turned: mutable i64
        solved: mutable i64
        active: mutable i64
        used: mutable i64
        value: mutable i64
        ended: mutable bool

    struct Move:
        kind: i64
        at: i64

    def minimum(a: i64, b: i64) -> i64:
        return a if a < b else b

    def budget_share(rung: i64) -> f64:
        can Abort.Panic:
            # Python rounds the multiplication in 0.05 * (rung - 1) before
            # subtracting it. Preserve those values at budget half-way ties.
            shares: f64[21] = [
                1.3, 1.25, 1.2, 1.15, 1.1, 1.05, 1.0,
                0.95, 0.9, 0.8500000000000001, 0.8, 0.75, 0.7, 0.65,
                0.6, 0.55, 0.5, 0.44999999999999996, 0.4, 0.35, 0.30000000000000004]
            return 0.3 if rung > 21
            return shares[(rung - 1).usize()]

    def grade(rung: i64) -> Grade:
        can Abort.Panic:
            r: i64 = rung if rung > 0 else 1
            longest: i64 = minimum(9, 3 + (r - 1) / 2)
            return Grade{rung: r, cards: minimum(MAX_CARDS, 2 + (r - 1) / 3),
                shortest: minimum(longest, 3 + (r - 1) / 6), longest: longest,
                tight: budget_share(r), traps: r >= 8, hidden: r >= 12}

    # Each digit occupies four bits, starting from the least significant end.
    def digit(row: u64, at: i64) -> u64:
        return (row >> (at * 4).u64()) & 15.u64()

    def exchange(row: u64, a: i64, b: i64) -> u64:
        digits: u64 = digit(row, a) ^ digit(row, b)
        return row ^ (digits << (a * 4).u64()) ^ (digits << (b * 4).u64())

    def inversions(row: u64, length: i64) -> i64:
        cost: mutable i64 = 0
        for i in 0..<length |row, length, cost|:
            for j in (i + 1)..<length |row, i, cost|:
                cost <- cost + 1 if digit(row, i) > digit(row, j)
        return cost

    def deal(rung: i64, seed: i64, output: mutable Deal&):
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            level: Grade = grade(rung)
            output.level <- level
            turning: i64 = 1 if level.hidden else 0
            total: mutable i64 = 0
            cheapest: mutable i64 = 37
            for i in 0..<level.cards |rng, level, output, turning, total, cheapest|:
                length: i64 = py_randint(&rng, level.shortest, level.longest)
                row: mutable u64 = 0x987654321.u64()
                cost: mutable i64 = 0
                while cost == 0 |cost, row, rng, length|:
                    index: mutable i64 = length - 1
                    while index > 0 |index, rng, row|:
                        other: i64 = py_randbelow(&rng, (index + 1).u64()).i64()
                        row <- exchange(row, index, other)
                        index <- index - 1
                    cost <- inversions(row, length)
                pays: i64 = py_randint(&rng, 1, 12) if level.traps else cost + py_randint(&rng, 0, 2)
                output.cards[i.usize()] <- Card{row: row, length: length, pays: pays, cost: cost}
                total <- total + cost + turning
                cheapest <- minimum(cheapest, cost + turning)
            target: f64 = level.tight * total.f64()
            whole: i64 = target.i64()
            fraction: f64 = target - whole.f64()
            rounded: i64 = whole + 1 if fraction > 0.5 or (fraction == 0.5 and whole % 2 != 0) else whole
            output.budget <- rounded if rounded > cheapest else cheapest

    def all_cards(dealt: Deal&) -> i64:
        return (1 << dealt.level.cards.u64()) - 1

    def reset(dealt: Deal&, play: mutable Round&):
        can Abort.Panic:
            play.turned <- 0 if dealt.level.hidden else all_cards(dealt)
            play.solved <- 0
            play.active <- -1
            play.used <- 0
            play.value <- 0
            play.ended <- false
            for i in 0..<dealt.level.cards |dealt, play|:
                play.rows[i.usize()] <- dealt.cards[i.usize()].row

    def over(dealt: Deal&, play: Round&) -> bool:
        return play.ended or play.used >= dealt.budget or play.solved == all_cards(dealt)

    def apply(dealt: Deal&, play: mutable Round&, action: Move) -> bool:
        can Abort.Panic:
            if action.kind == DONE:
                play.ended <- true
                return true
            return false if over(dealt, play)
            if action.kind == OPEN:
                return false if action.at < 0 or action.at >= dealt.level.cards
                bit: i64 = 1 << action.at.u64()
                return false if (play.solved & bit) != 0
                if (play.turned & bit) == 0:
                    play.turned <- play.turned | bit
                    play.used <- play.used + 1
                play.active <- action.at
                return true
            return false if action.kind != SWAP or play.active < 0
            card: Card = dealt.cards[play.active.usize()]
            return false if action.at < 0 or action.at >= card.length - 1
            row: u64 = exchange(play.rows[play.active.usize()], action.at, action.at + 1)
            play.rows[play.active.usize()] <- row
            play.used <- play.used + 1
            if inversions(row, card.length) == 0:
                play.solved <- play.solved | (1 << play.active.u64())
                play.value <- play.value + card.pays
                play.active <- -1
            return true

    def best(dealt: Deal&) -> i64:
        can Abort.Panic:
            value: mutable i64 = 0
            turning: i64 = 1 if dealt.level.hidden else 0
            for subset in 1..<(all_cards(dealt) + 1) |dealt, turning, value|:
                cost: mutable i64 = 0
                pays: mutable i64 = 0
                for i in 0..<dealt.level.cards |subset, dealt, turning, cost, pays|:
                    if (subset & (1 << i.u64())) != 0:
                        card: Card = dealt.cards[i.usize()]
                        cost <- cost + card.cost + turning
                        pays <- pays + card.pays
                if cost <= dealt.budget and pays > value:
                    value <- pays
            return value

    def reference_move(dealt: Deal&, play: Round&) -> Move:
        can Abort.Panic:
            left: i64 = dealt.budget - play.used
            if play.active >= 0:
                row: u64 = play.rows[play.active.usize()]
                length: i64 = dealt.cards[play.active.usize()].length
                if inversions(row, length) <= left:
                    for i in 0..<(length - 1) |row|:
                        return Move{kind: SWAP, at: i} if digit(row, i) > digit(row, i + 1)
            chosen: mutable i64 = -1
            rate: mutable f64 = 0.0
            for i in 0..<dealt.level.cards |dealt, play, left, chosen, rate|:
                bit: i64 = 1 << i.u64()
                if (play.solved & bit) == 0:
                    card: Card = dealt.cards[i.usize()]
                    visible: bool = (play.turned & bit) != 0
                    estimate: f64 = (card.length * (card.length - 1)).f64() / 4.0 + 1.0
                    cost: f64 = inversions(play.rows[i.usize()], card.length).f64() if visible else estimate
                    if (visible and cost <= left.f64()) or (not visible and left >= 2):
                        candidate: f64 = card.pays.f64() / cost
                        if candidate > rate:
                            rate <- candidate
                            chosen <- i
            return Move{kind: OPEN, at: chosen} if chosen >= 0
            return Move{kind: DONE, at: 0}

    def par(dealt: Deal&) -> f64:
        can Abort.Panic:
            play: mutable Round = zeroed
            reset(dealt, &play)
            while not over(dealt, &play) |dealt, play|:
                action: Move = reference_move(dealt, &play)
                _ = apply(dealt, &play, action)
            reference: f64 = play.value.f64()
            rung: i64 = dealt.level.rung
            return reference - (0.5 * (20 - rung).f64() / 19.0) * reference if rung <= 20
            fraction: f64 = 0.08 * (rung - 20).f64() if rung < 30 else 0.8
            return reference + fraction * (best(dealt).f64() - reference)
