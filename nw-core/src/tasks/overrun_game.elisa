# Stateful common-v1 controller for the source Overrun task.
#
# The source task accepts a sentence pool from its shell.  The browser port
# uses the source's complete offline seed fallback, represented as a fixed
# pool here. The two seed lines outside the source Overrun length band are
# omitted exactly as `Overrun.pool()` omits them. The persistent controller owns
# only scalar/fixed-array state;
# every source `Overrun::OverrunWave`, `Overrun::OverrunPool`, and darray is rebuilt inside a
# temporary region and copied back before that region is destroyed.

module OverrunGame:

    const MAX_WORDS: i64 = 24
    const MAX_LETTERS: i64 = 64
    const MAX_WAVES: i64 = 64
    const POOL_SENTENCES: i64 = 68
    const POOL_WORDS: i64 = 553
    const POOL_LETTERS: i64 = 2082

    const PHASE_READY: i64 = 0
    const PHASE_TYPING: i64 = 1
    const PHASE_SETTLED: i64 = 2
    const PHASE_DONE: i64 = 3

    const ACTION_START: i64 = 0
    const ACTION_WRITE: i64 = 1
    const ACTION_ERASE: i64 = 2

    const INFO_PHASE: i64 = 0
    const INFO_RUNG: i64 = 1
    const INFO_TRIAL: i64 = 2
    const INFO_TOTAL_WAVES: i64 = 3
    const INFO_WORD_COUNT: i64 = 4
    const INFO_LENGTH: i64 = 5
    const INFO_LETTERS: i64 = 6
    const INFO_CLEARED: i64 = 7
    const INFO_TYPED_COUNT: i64 = 8
    const INFO_DRIFT_MILLI: i64 = 9
    const INFO_LIVES: i64 = 10
    const INFO_LANDED: i64 = 11
    const INFO_MISSED: i64 = 12
    const INFO_SECONDS_MS: i64 = 13
    const INFO_UNTIL_MS: i64 = 14
    const INFO_VERDICT: i64 = 15
    const INFO_RESULT_COUNT: i64 = 16
    const INFO_WPM: i64 = 17
    const INFO_BEST_RUNG: i64 = 18
    const INFO_STOCKED: i64 = 19
    const INFO_CLOCK_MS: i64 = 20

    const VALUE_WORD_START: i64 = 0
    const VALUE_WORD_LENGTH: i64 = 1
    const VALUE_LETTER_START: i64 = 2
    const VALUE_WAVE_LETTER: i64 = 3
    const VALUE_TYPED_LETTER: i64 = 4
    const VALUE_RESULT_RUNG: i64 = 100
    const VALUE_RESULT_DONE: i64 = 101
    const VALUE_RESULT_WORDS: i64 = 102
    const VALUE_RESULT_TOOK_MS: i64 = 103

    struct OverrunGameRun:
        rng: mutable MT19937
        start_rung: mutable i64
        total_waves: mutable i64
        adaptive: mutable bool
        coach: mutable bool
        rung: mutable i64
        trial: mutable i64
        word_count: mutable i64
        length: mutable i64
        letters: mutable i64
        cleared: mutable i64
        typed_count: mutable i64
        word_start: mutable i64[MAX_WORDS]
        word_length: mutable i64[MAX_WORDS]
        letter_start: mutable i64[MAX_WORDS]
        letter: mutable i64[MAX_LETTERS]
        typed: mutable i64[MAX_LETTERS]
        drift: mutable f64
        lives: mutable i64
        landed: mutable i64
        missed: mutable i64
        seconds: mutable f64
        started_at: mutable f64
        until: mutable f64
        phase: mutable i64
        verdict: mutable i64
        result_count: mutable i64
        result_rung: mutable i64[MAX_WAVES]
        result_done: mutable i64[MAX_WAVES]
        result_words: mutable i64[MAX_WAVES]
        result_took: mutable f64[MAX_WAVES]
        clock_ms: mutable i64

    def allowed_rung(value: i64) -> bool:
        can Abort.Panic:
            return value >= 1 and value <= Overrun::GRADE_COUNT

    def allowed_waves(value: i64) -> bool:
        can Abort.Panic:
            return value == 3 or value == 5 or value == 8 or value == 12 or value == 20 or value == 30

    # These are the offline seed sentences from neural_workshop.sentences.
    # They are deliberately kept in source order: the source seed bank uses
    # this order, and the MT19937 deal index is therefore reproducible.
    def word_of(sentence: i64, slot: i64) -> sview:
        can Abort.Panic:
            if sentence == 0:
                if slot == 0: return sview("the", 0, -1)
                if slot == 1: return sview("black", 0, -1)
