    def build_pool() -> Overrun::OverrunPool:
        can Memory.Allocate, Abort.Panic:
            words: mutable darray[i64] = Ints::zeros(POOL_SENTENCES)
            word_at: mutable darray[i64] = Ints::zeros(POOL_SENTENCES)
            word_length: mutable darray[i64] = Ints::zeros(POOL_WORDS)
            letter_at: mutable darray[i64] = Ints::zeros(POOL_WORDS)
            letters: mutable darray[i64] = Ints::zeros(POOL_LETTERS)
            global_word: mutable i64 = 0
            global_letter: mutable i64 = 0
            sentence: mutable i64 = 0
            while sentence < POOL_SENTENCES |sentence, words, word_at, word_length, letter_at, letters, global_word, global_letter|:
                count: i64 = word_count_of(sentence)
                Ints::put(&words, sentence, count)
                Ints::put(&word_at, sentence, global_word)
                slot: mutable i64 = 0
                while slot < count |slot, sentence, words, word_at, word_length, letter_at, letters, global_word, global_letter|:
                    word: sview = word_of(sentence, slot)
                    width: i64 = sview_len(word).i64()
                    Ints::put(&word_length, global_word, width)
                    Ints::put(&letter_at, global_word, global_letter)
                    at: mutable i64 = 0
                    while at < width |at, word, letters, global_letter, slot, sentence, word_length, letter_at|:
                        Ints::put(&letters, global_letter, sview_at(word, at.usize()).i64() - 97)
                        at <- at + 1
                        global_letter <- global_letter + 1
                    slot <- slot + 1
                    global_word <- global_word + 1
                sentence <- sentence + 1
            return Overrun::OverrunPool{count: POOL_SENTENCES, words: words, word_at: word_at,
                                 word_length: word_length, letter_at: letter_at,
                                 letter: letters}

    def copy_wave_to_source(run: OverrunGameRun&, wave: mutable Overrun::OverrunWave&):
        can Abort.Panic:
            wave.word_count <- run.word_count
            wave.grade <- run.rung - 1 if run.rung > 0 else 0
            wave.length <- run.length
            wave.letters <- run.letters
            at: mutable i64 = 0
            while at < MAX_WORDS |at, run, wave|:
                Ints::put(&wave.word_start, at, run.word_start[at.usize()])
                Ints::put(&wave.word_length, at, run.word_length[at.usize()])
                Ints::put(&wave.letter_start, at, run.letter_start[at.usize()])
                at <- at + 1
            at <- 0
            while at < MAX_LETTERS |at, run, wave|:
                Ints::put(&wave.letter, at, run.letter[at.usize()])
                at <- at + 1

    def copy_wave_from_source(run: mutable OverrunGameRun&, wave: Overrun::OverrunWave&):
        can Abort.Panic:
            run.word_count <- wave.word_count
            run.length <- wave.length
            run.letters <- wave.letters
            at: mutable i64 = 0
            while at < MAX_WORDS |at, run, wave|:
                run.word_start[at.usize()] <- Ints::at(wave.word_start, at)
                run.word_length[at.usize()] <- Ints::at(wave.word_length, at)
                run.letter_start[at.usize()] <- Ints::at(wave.letter_start, at)
                at <- at + 1
            at <- 0
            while at < MAX_LETTERS |at, run, wave|:
                run.letter[at.usize()] <- Ints::at(wave.letter, at)
                at <- at + 1

    def copy_run_to_source(run: OverrunGameRun&, source: mutable Overrun::OverrunRun&):
        can Abort.Panic:
            source.start_rung <- run.start_rung
            source.total_waves <- run.total_waves
            source.adaptive <- run.adaptive
            source.coach <- run.coach
            source.rung <- run.rung
            source.trial <- run.trial
            source.cleared <- run.cleared
            source.typed_count <- run.typed_count
            source.drift <- run.drift
            source.lives <- run.lives
            source.landed <- run.landed
            source.missed <- run.missed
            source.seconds <- run.seconds
            source.started_at <- run.started_at
            source.until <- run.until
            source.phase <- run.phase
            source.verdict <- run.verdict
            source.result_count <- run.result_count
            at: mutable i64 = 0
            while at < MAX_LETTERS |at, run, source|:
                Ints::put(&source.typed, at, run.typed[at.usize()])
                at <- at + 1
            at <- 0
            while at < MAX_WAVES |at, run, source|:
                Ints::put(&source.result_rung, at, run.result_rung[at.usize()])
                Ints::put(&source.result_done, at, run.result_done[at.usize()])
                Ints::put(&source.result_words, at, run.result_words[at.usize()])
                Floats::put(&source.result_took, at, run.result_took[at.usize()])
                at <- at + 1

    def copy_run_from_source(run: mutable OverrunGameRun&, source: Overrun::OverrunRun&):
        can Abort.Panic:
            run.rung <- source.rung
            run.trial <- source.trial
            run.cleared <- source.cleared
            run.typed_count <- source.typed_count
            run.drift <- source.drift
            run.lives <- source.lives
            run.landed <- source.landed
            run.missed <- source.missed
            run.seconds <- source.seconds
            run.started_at <- source.started_at
            run.until <- source.until
            run.phase <- source.phase
            run.verdict <- source.verdict
            run.result_count <- source.result_count
            at: mutable i64 = 0
            while at < MAX_LETTERS |at, run, source|:
                run.typed[at.usize()] <- Ints::at(source.typed, at)
                at <- at + 1
            at <- 0
            while at < MAX_WAVES |at, run, source|:
                run.result_rung[at.usize()] <- Ints::at(source.result_rung, at)
                run.result_done[at.usize()] <- Ints::at(source.result_done, at)
                run.result_words[at.usize()] <- Ints::at(source.result_words, at)
                run.result_took[at.usize()] <- Floats::at(source.result_took, at)
                at <- at + 1

    def source_start(run: mutable OverrunGameRun&, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            region source(134217728):
                in source:
                    source_run: mutable Overrun::OverrunRun = Overrun::new_run()
                    wave: mutable Overrun::OverrunWave = Overrun::new_wave()
                    pool: mutable Overrun::OverrunPool = build_pool()
                    copy_run_to_source(run, &source_run)
                    Overrun::start_run(&source_run, &wave, &pool,
                        now_ms.f64() / 1000.0, &run.rng)
                    copy_run_from_source(run, &source_run)
                    copy_wave_from_source(run, &wave)
                destroy source

    def source_update(run: mutable OverrunGameRun&, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            elapsed: mutable i64 = now_ms - run.clock_ms
            elapsed <- 0 if elapsed < 0
            region source(134217728):
                in source:
                    source_run: mutable Overrun::OverrunRun = Overrun::new_run()
                    wave: mutable Overrun::OverrunWave = Overrun::new_wave()
                    pool: mutable Overrun::OverrunPool = build_pool()
                    copy_run_to_source(run, &source_run)
                    copy_wave_to_source(run, &wave)
                    Overrun::update(&source_run, &wave, &pool,
                        elapsed.f64() / 1000.0, now_ms.f64() / 1000.0,
                        &run.rng)
                    copy_run_from_source(run, &source_run)
                    copy_wave_from_source(run, &wave)
                destroy source
            run.clock_ms <- now_ms

    def source_write(run: mutable OverrunGameRun&, key: i64, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            region source(134217728):
                in source:
                    source_run: mutable Overrun::OverrunRun = Overrun::new_run()
                    wave: mutable Overrun::OverrunWave = Overrun::new_wave()
                    copy_run_to_source(run, &source_run)
                    copy_wave_to_source(run, &wave)
                    Overrun::write(&source_run, &wave, key, now_ms.f64() / 1000.0)
                    copy_run_from_source(run, &source_run)
                    copy_wave_from_source(run, &wave)
                destroy source

    def source_erase(run: mutable OverrunGameRun&):
        can Memory.Allocate, Abort.Panic:
            region source(134217728):
                in source:
                    source_run: mutable Overrun::OverrunRun = Overrun::new_run()
                    copy_run_to_source(run, &source_run)
                    Overrun::erase(&source_run)
                    copy_run_from_source(run, &source_run)
                destroy source

    def clear_arrays(run: mutable OverrunGameRun&):
        can Abort.Panic:
            at: mutable i64 = 0
            while at < MAX_WORDS |at, run|:
                run.word_start[at.usize()] <- 0
                run.word_length[at.usize()] <- 0
                run.letter_start[at.usize()] <- 0
                at <- at + 1
            at <- 0
            while at < MAX_LETTERS |at, run|:
                run.letter[at.usize()] <- 0
                run.typed[at.usize()] <- 0
                at <- at + 1
            at <- 0
            while at < MAX_WAVES |at, run|:
                run.result_rung[at.usize()] <- 0
                run.result_done[at.usize()] <- 0
                run.result_words[at.usize()] <- 0
                run.result_took[at.usize()] <- 0.0
                at <- at + 1

    def initialize(run: mutable OverrunGameRun&, rung: i64, waves: i64,
                   adaptive: bool, unused_d: i64, unused_e: i64,
                   unused_f: i64, seed: i64):
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            run.rng <- rng
            run.start_rung <- rung
            run.total_waves <- waves
            run.adaptive <- adaptive
            run.coach <- false
            run.rung <- rung
            run.trial <- 0
            run.word_count <- 0
            run.length <- 0
            run.letters <- 0
            run.cleared <- 0
            run.typed_count <- 0
            run.drift <- 0.0
            run.lives <- Overrun::START_LIVES
            run.landed <- 0
            run.missed <- 0
            run.seconds <- 0.0
            run.started_at <- 0.0
            run.until <- 0.0
            run.phase <- PHASE_READY
            run.verdict <- -1
            run.result_count <- 0
            run.clock_ms <- 0
            clear_arrays(run)

    def apply(run: mutable OverrunGameRun&, action: i64, value: i64, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            if action == ACTION_START:
                return 2 if run.phase != PHASE_READY and run.phase != PHASE_DONE
                source_start(run, now_ms)
                run.clock_ms <- now_ms
                return 1
            if action == ACTION_WRITE:
                return 2 if value < 0 or value > 25 or run.phase != PHASE_TYPING
                source_write(run, value, now_ms)
                run.clock_ms <- now_ms
                return 1
            if action == ACTION_ERASE:
                return 2 if run.phase != PHASE_TYPING
                source_erase(run)
                run.clock_ms <- now_ms
                return 1
            return -6

    def advance(run: mutable OverrunGameRun&, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            before_phase: i64 = run.phase
            before_trial: i64 = run.trial
            before_drift: f64 = run.drift
            source_update(run, now_ms)
            return 1 if run.phase != before_phase or run.trial != before_trial or run.drift != before_drift
            return 2

    def info(run: OverrunGameRun&, field: i64) -> i64:
        can Abort.Panic:
            if field == INFO_PHASE: return run.phase
            elif field == INFO_RUNG: return run.rung
            elif field == INFO_TRIAL: return run.trial
            elif field == INFO_TOTAL_WAVES: return run.total_waves
            elif field == INFO_WORD_COUNT: return run.word_count
            elif field == INFO_LENGTH: return run.length
            elif field == INFO_LETTERS: return run.letters
            elif field == INFO_CLEARED: return run.cleared
            elif field == INFO_TYPED_COUNT: return run.typed_count
            elif field == INFO_DRIFT_MILLI: return py_round_half_even(run.drift * 1000.0)
            elif field == INFO_LIVES: return run.lives
            elif field == INFO_LANDED: return run.landed
            elif field == INFO_MISSED: return run.missed
            elif field == INFO_SECONDS_MS: return py_round_half_even(run.seconds * 1000.0)
            elif field == INFO_UNTIL_MS: return py_round_half_even(run.until * 1000.0)
            elif field == INFO_VERDICT: return run.verdict
            elif field == INFO_RESULT_COUNT: return run.result_count
            elif field == INFO_WPM: return py_round_half_even(Overrun::words_a_minute(run.landed.f64(), run.seconds))
            elif field == INFO_BEST_RUNG:
                best: mutable i64 = 0
                at: mutable i64 = 0
                while at < run.result_count |at, run, best|:
                    best <- run.result_rung[at.usize()] if run.result_done[at.usize()] != 0 and run.result_rung[at.usize()] > best
                    at <- at + 1
                return best
            elif field == INFO_STOCKED: return 0
            elif field == INFO_CLOCK_MS: return run.clock_ms
            return -1

    def value(run: OverrunGameRun&, field: i64, at: i64) -> i64:
        can Abort.Panic:
            return -1 if at < 0
            if field == VALUE_WORD_START: return run.word_start[at.usize()] if at < run.word_count else -1
            if field == VALUE_WORD_LENGTH: return run.word_length[at.usize()] if at < run.word_count else -1
            if field == VALUE_LETTER_START: return run.letter_start[at.usize()] if at < run.word_count else -1
            if field == VALUE_WAVE_LETTER: return run.letter[at.usize()] if at < run.letters else -1
            if field == VALUE_TYPED_LETTER: return run.typed[at.usize()] if at < run.typed_count else -1
            if field == VALUE_RESULT_RUNG: return run.result_rung[at.usize()] if at < run.result_count else -1
            if field == VALUE_RESULT_DONE: return run.result_done[at.usize()] if at < run.result_count else -1
            if field == VALUE_RESULT_WORDS: return run.result_words[at.usize()] if at < run.result_count else -1
            if field == VALUE_RESULT_TOOK_MS: return py_round_half_even(run.result_took[at.usize()] * 1000.0) if at < run.result_count else -1
            return -1

    def render(run: OverrunGameRun&, black_background: bool, width: f64, height: f64,
               list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            words: mutable darray[sview] = []
            starts: mutable darray[i64] = []
            at: mutable i64 = 0
            while at < run.word_count |at, run, words, starts|:
                text: mutable dstr = []
                first: i64 = run.letter_start[at.usize()]
                step: mutable i64 = 0
                while step < run.word_length[at.usize()] |step, text, run, first|:
                    text.push((97 + run.letter[(first + step).usize()]).u8())
                    step <- step + 1
                words.push(bytes_view(text))
                starts.push(run.word_start[at.usize()])
                at <- at + 1
            typed: mutable dstr = []
            at <- 0
            while at < run.typed_count |at, typed, run|:
                typed.push((97 + run.typed[at.usize()]).u8())
                at <- at + 1
            message: mutable dstr = []
            if run.phase == PHASE_READY:
                dstr_append_cstr(&message, "Press Space to start")
            elif run.phase == PHASE_TYPING:
                dstr_append_cstr(&message, "")
            elif run.phase == PHASE_SETTLED:
                dstr_append_cstr(&message, "Clear — a life back" if run.verdict == 1 else "The line ran out")
            else:
                dstr_append_cstr(&message, "OverrunGameRun complete")
            verdict_text: mutable dstr = []
            if run.verdict == 1:
                dstr_append_cstr(&verdict_text, "Clear — a life back")
            elif run.verdict == 0:
                dstr_append_cstr(&verdict_text, "The line ran out")
            missing: sview = sview("Using built-in seed sentences", 0, -1)
            paint: mutable SceneOverrun::OverrunPaint = SceneOverrun::paint_of(
                black_background, width, height, 1.0, 1.0)
            SceneOverrun::render(list, &paint, run.phase, run.word_count > 0,
                &words, &starts, run.length, run.letters, run.seconds,
                run.cleared, bytes_view(typed), run.drift, run.lives, false,
                missing, run.trial, run.total_waves, bytes_view(message),
                run.verdict, bytes_view(verdict_text))
