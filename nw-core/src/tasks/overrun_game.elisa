    def word_count_of(sentence: i64) -> i64:
        can Abort.Panic:
            if sentence == 0: return 7
            if sentence == 1: return 9
            if sentence == 2: return 8
            if sentence == 3: return 7
            if sentence == 4: return 7
            if sentence == 5: return 9
            if sentence == 6: return 7
            if sentence == 7: return 9
            if sentence == 8: return 7
            if sentence == 9: return 7
            if sentence == 10: return 9
