include "./errands.elisa"

module ErrandShop:
    # errands.py's ErrandShop: Browser's shop as an app below the strip.
    # Checking out places an order, shows its confirmation and empties the
    # cart, rather than ending anything. Python's orders are unbounded; here
    # MOST_ORDERS are kept, far past what a round's clicks reach, and a full
    # list takes no more.
    const MOST_ORDERS: i64 = 32

    struct Order:
        number: i64
        total: i64
        items: BrowserPages::Cart

    struct Shop:
        session: mutable BrowserSession::Session
        numbers: mutable i64[8]
        order_count: mutable i64
        orders: mutable Order[32]

    def start(dealt: Browser::Deal&, numbers: i64[8]) -> Shop:
        return Shop{session: BrowserSession::start(dealt, Errands::STRIP), numbers: numbers, order_count: 0, orders: zeroed}

    # elements: the confirmation of an order, or Browser's page.
    def elements(shop: Shop&) -> BrowserPages::Layout:
        can Memory.Allocate, Abort.Panic:
            page: BrowserPages::Action = shop.session.page
            return BrowserSession::elements(&shop.session) if page.kind != BrowserPages::PLACED
            order: Order = shop.orders[page.index.usize()]
            out: mutable BrowserPages::Layout = zeroed
            none: BrowserPages::Action = BrowserPages::action(BrowserPages::NONE)
            BrowserPages::add(&out, 40.0, 20.0, 920.0, 44.0, BrowserPages::TITLE,
                BrowserPages::says(BrowserPages::SAYS_ORDER_PLACED, 0, 0), none)
            BrowserPages::add(&out, 40.0, 90.0, 600.0, 34.0, BrowserPages::TEXT,
                BrowserPages::says(BrowserPages::SAYS_ORDER_NUMBER, order.number, 0), none)
            BrowserPages::add(&out, 40.0, 130.0, 600.0, 34.0, BrowserPages::TEXT,
                BrowserPages::says(BrowserPages::SAYS_TOTAL_CHARGED, order.total, 0), none)
            y: mutable f64 = 180.0
            for slot in 0..<order.items.count |out, order, y, none|:
                BrowserPages::add(&out, 40.0, y, 600.0, 34.0, BrowserPages::MUTED,
                    BrowserPages::says(BrowserPages::SAYS_NAME, order.items.items[slot.usize()], 0), none)
                y <- y + 40.0
            BrowserPages::add(&out, 40.0, y + 20.0, 300.0, 36.0, BrowserPages::LINK,
                BrowserPages::says(BrowserPages::SAYS_CONTINUE, 0, 0), BrowserPages::action(BrowserPages::HOME))
            return out

    def max_scroll(shop: Shop&) -> f64:
        can Memory.Allocate, Abort.Panic:
            shown: BrowserPages::Layout = elements(shop)
            return BrowserSession::max_scroll_of(&shop.session, &shown)

    def target_at(shop: Shop&, x: f64, y: f64) -> BrowserPages::Action:
        can Memory.Allocate, Abort.Panic:
            shown: BrowserPages::Layout = elements(shop)
            return BrowserSession::target_in(&shop.session, &shown, x, y)

    def wheel(shop: mutable Shop&, way: i64):
        can Memory.Allocate, Abort.Panic:
            BrowserSession::wheel_within(&shop.session, way, max_scroll(shop))

    # do: Check out places an order; everything else is Browser's.
    def act(shop: mutable Shop&, action: BrowserPages::Action):
        can Abort.Panic:
            if action.kind != BrowserPages::CHECKOUT:
                BrowserSession::act(&shop.session, action)
                return
            cart: BrowserPages::Cart = shop.session.cart
            return if cart.count == 0 or shop.order_count >= MOST_ORDERS
            total: mutable i64 = 0
            slot: mutable i64 = 0
            while slot < cart.count |total, slot, cart, shop|:
                product: Browser::Product = shop.session.deal.products[cart.items[slot.usize()].usize()]
                total <- total + product.price + product.shipping
                slot <- slot + 1
            number: i64 = shop.numbers[(shop.order_count % Errands::NUMBERS).usize()]
            shop.orders[shop.order_count.usize()] <- Order{number: number, total: total, items: cart}
            shop.order_count <- shop.order_count + 1
            shop.session.cart <- zeroed
            BrowserSession::go(&shop.session, BrowserPages::indexed(BrowserPages::PLACED, shop.order_count - 1))
