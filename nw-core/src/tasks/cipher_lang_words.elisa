include "./cipher_lang_code.elisa"

extend CipherLang:
    def rule_words(op: i64) -> cstr:
        return "reverse" if op == REV
        return "swap neighbours" if op == SWAP
        return "running sum" if op == PREFIX
        return "differences" if op == DIFF
        return "sort" if op == SORT
        return "add the last input" if op == MEM
        return "reverse each half" if op == MIRROR
        return "evens first, then odds" if op == WEAVE
        return "deal into evens and odds" if op == UNWEAVE
        return "count each run" if op == RUNS
        return "add each to its mirror" if op == FOLD
        return "drop repeats" if op == DEDUPE
        return "double each" if op == DOUBLE
        return "keep every other" if op == HALVE
        return "its sum is even" if op == SUMEVEN
        return "it starts lower than it ends" if op == RISES
        return "the run count is even" if op == TPARITY
        return "every symbol is the same" if op == SAME
        return "it reads the same both ways" if op == PAL
        return "it is already in order" if op == SORTED
        return "out = %d*this + %d*before + %d" if op == CONV
        return "multiply by %d and add %d" if op == AFFINE
        return "rotate right %d" if op == ROT
        return "add %d to each" if op == SHIFT
        return "multiply each by %d" if op == MUL
        return "add %d more each run" if op == TSHIFT
        return "add %d at odd places" if op == ODDSHIFT
        return "xor each with %d" if op == XOR
        return "read every %d-th place, wrapping round" if op == STRIDE
        return "multiply each by %d in GF(k)" if op == GF
        return "it starts with %d" if op == FIRST
        return "it ends with %d" if op == LAST
        return "it has a %d" if op == HAS
        return "it has an even number of %ds" if op == EVENS
        return "the last answer started with %d" if op == ECHO
        return ""

    def write_rule_words(out: mutable dstr&, program: darray[Node]&, entry: i64):
        can Abort.Panic, Memory.Allocate:
            node: Node& = &program[entry.usize()]
            op: i64 = node.op
            if op == SUB or op == PERM:
                dstr_append_cstr(out, "substitute " if op == SUB else "shuffle positions ")
                for symbol in node.args:
                    dstr_append_i64(out, symbol)
            elif op == FEISTEL:
                dstr_append_cstr(out, "a Feistel round of (")
                write_rule_words(out, program, node.children[0])
                dstr_append_cstr(out, ")")
            elif op < SEQ:
                words: sview = sview(rule_words(op), 0, -1)
                length: i64 = sview_len(words).i64()
                arg: mutable usize = 0
                skip: mutable bool = false
                for i in 0..<length |out, words, node, arg, skip|:
                    if skip:
                        skip <- false
                    elif sview_at(words, i.usize()) == 37.u8():
                        dstr_append_i64(out, node.args[arg])
                        arg <- arg + 1.usize()
                        skip <- true
                    else:
                        out.push(sview_at(words, i.usize()))
            elif op == SEQ:
                if node.children.count == 0.usize():
                    dstr_append_cstr(out, "nothing")
                for i in 0..<node.children.count.i64() |out, program, node|:
                    dstr_append_cstr(out, ", then ") if i > 0
                    write_rule_words(out, program, node.children[i.usize()])
            elif op == IF:
                dstr_append_cstr(out, "if ")
                write_rule_words(out, program, node.children[0])
                dstr_append_cstr(out, ": ")
                write_rule_words(out, program, node.children[1])
                dstr_append_cstr(out, "; else ")
                write_rule_words(out, program, node.children[2])
            elif op == ALT or op == EXCEPT:
                if op == ALT:
                    dstr_append_cstr(out, "on even runs ")
                write_rule_words(out, program, node.children[0])
                dstr_append_cstr(out, "; on odd runs " if op == ALT else "; but when every symbol is the same: ")
                write_rule_words(out, program, node.children[1])
            elif op == PROG:
                dstr_append_cstr(out, "symbols ")
                for i in 0..<node.args.count.i64() |out, node|:
                    dstr_append_cstr(out, ", ") if i > 0
                    dstr_append_i64(out, node.args[i.usize()])
                dstr_append_cstr(out, " are instructions (")
                for i in 0..<node.children.count.i64() |out, program, node|:
                    dstr_append_cstr(out, "; ") if i > 0
                    dstr_append_i64(out, node.args[i.usize()])
                    dstr_append_cstr(out, ": ")
                    write_rule_words(out, program, node.children[i.usize()])
                dstr_append_cstr(out, "), applied in turn to the rest")
            else:
                dstr_append_cstr(out, "in turn ")
                for i in 1..<node.children.count.i64() |out, program, node|:
                    dstr_append_cstr(out, " / ") if i > 1
                    write_rule_words(out, program, node.children[i.usize()])
                dstr_append_cstr(out, "; moving on after every input where ")
                write_rule_words(out, program, node.children[0])
