include "./hidden_wiring_reference.elisa"

module HiddenWiringGame:
    const READY: i64 = 0
    const LOOKING: i64 = 1
    const EXAMINING: i64 = 2
    const JUDGED: i64 = 3
    const DONE: i64 = 4
    const FEEDBACK_MS: i64 = 4000
    const LOOK: i64 = 8
    const EXAM: i64 = 9
    const ANSWER: i64 = 10
    const START: i64 = 11

    struct Run:
        start_rung: mutable i64
        trials: mutable i64
        adaptive: mutable bool
        rng: mutable MT19937
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        level: mutable HiddenWiring::Grade
        dealt: mutable HiddenWiring::Deal
        round: mutable HiddenWiring::Round
        setting: mutable i64
        par: mutable f64
        passed: mutable bool
        feedback_until_ms: mutable i64
        answered: mutable i64
        passed_count: mutable i64
        best_rung: mutable i64

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 3 or rung == 5 or rung == 7 or rung == 10 or rung == 12 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_trials(trials: i64) -> bool:
        return trials == 1 or trials == 3 or trials == 5 or trials == 8 or trials == 12

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64) -> Run:
        can Abort.Panic:
            start: i64 = rung if rung > 0 else 1
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            return Run{start_rung: start, trials: trials, adaptive: adaptive, rng: rng,
                rung: start, trial: 0, phase: READY, level: HiddenWiring::grade(start),
                dealt: zeroed, round: zeroed, setting: 0,
                par: 0.0, passed: false, feedback_until_ms: 0,
                answered: 0, passed_count: 0, best_rung: 0}

    def next_trial(run: mutable Run&):
        can Memory.Allocate, Memory.Release, Abort.Panic:
            if run.trial >= run.trials:
                run.phase <- DONE
                return
            region scratch(8388608):
                in scratch:
                    level: HiddenWiring::Grade = HiddenWiring::grade(run.rung)
                    gates: darray[HiddenWiring::Gate] = HiddenWiring::space(&level)
                    rng: mutable MT19937 = run.rng
                    dealt: mutable HiddenWiring::Deal = zeroed
                    HiddenWiring::deal(&level, &gates, &rng, &dealt)
                    reference: mutable HiddenWiring::Round = zeroed
                    HiddenWiringReference::play(&level, &gates, &dealt, &reference)
                    run.par <- HiddenWiringReference::par(&level, &reference)
                    run.level <- level
                    run.rng <- rng
                    run.dealt <- dealt
                destroy scratch
            run.round <- zeroed
            run.setting <- 0
            run.trial <- run.trial + 1
            run.phase <- LOOKING

    def reset(run: mutable Run&):
        run.phase <- READY
        run.rung <- run.start_rung
        run.trial <- 0
        run.answered <- 0
        run.passed_count <- 0
        run.best_rung <- 0

    def start(run: mutable Run&) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if run.phase != READY and run.phase != DONE
            reset(run)
            next_trial(run)
            return true

    def flip(run: mutable Run&, switch: i64) -> bool:
        return false if (run.phase != LOOKING and run.phase != EXAMINING) or switch < 0 or switch >= run.level.switches
        run.setting <- run.setting ^ (1 << switch.u64())
        return true

    def begin_exam(run: mutable Run&) -> bool:
        return false if run.phase != LOOKING
        run.round.examining <- true
        run.phase <- EXAMINING
        return true

    def look(run: mutable Run&) -> bool:
        can Abort.Panic:
            return false if run.phase != LOOKING
            return false if HiddenWiring::look(&run.round, &run.level, &run.dealt, run.setting) < 0
            if run.round.looks == HiddenWiring::budget(&run.level):
                _ = begin_exam(run)
            return true

    def answer(run: mutable Run&, now_ms: i64) -> bool:
        can Abort.Panic:
            return false if run.phase != EXAMINING or not HiddenWiring::answer(&run.round, &run.level, &run.dealt, run.setting)
            if run.round.answered == run.dealt.questions:
                cost: i64 = HiddenWiring::cost(&run.round, &run.level)
                run.passed <- cost.f64() <= run.par + 0.000000001
                run.answered <- run.answered + 1
                if run.passed:
                    run.passed_count <- run.passed_count + 1
                    run.best_rung <- run.level.rung if run.level.rung > run.best_rung
                if run.adaptive:
                    if run.passed:
                        run.rung <- run.rung + 1
                    elif run.rung > 1:
                        run.rung <- run.rung - 1
                run.feedback_until_ms <- now_ms + FEEDBACK_MS
                run.phase <- JUDGED
            return true

    def steer(run: mutable Run&, port: i64, now_ms: i64) -> bool:
        can Abort.Panic:
            return flip(run, port) if port >= 0 and port < LOOK
            return look(run) if port == LOOK
            return begin_exam(run) if port == EXAM
            return answer(run, now_ms) if port == ANSWER
            return false

    def advance(run: mutable Run&, now_ms: i64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if run.phase != JUDGED or now_ms < run.feedback_until_ms
            next_trial(run)
            return true
