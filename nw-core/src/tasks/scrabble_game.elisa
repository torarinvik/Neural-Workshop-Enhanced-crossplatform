# Stateful source-backed Scrabble slice. The source kernel owns premium layout,
# lexicon legality, and score calculation; the ABI record owns only fixed board,
# rack, and current-play storage.
module ScrabbleGame:
    const TASK_ID: i64 = 1272532037
    const MAX_CELLS: i64 = 225
    const RACK: i64 = 7
    const PHASE_READY: i64 = 0
    const PHASE_PLAYING: i64 = 1
    const PHASE_SCORED: i64 = 2
    const PHASE_DONE: i64 = 3
    const ACTION_START: i64 = 0
    const ACTION_PLAY: i64 = 1
    const ACTION_LEFT: i64 = 2
    const ACTION_RIGHT: i64 = 3
    const ACTION_TOGGLE: i64 = 4
    const INFO_PHASE: i64 = 0
    const INFO_RUNG: i64 = 1
    const INFO_TRIAL: i64 = 2
    const INFO_TOTAL: i64 = 3
    const INFO_SIZE: i64 = 4
    const INFO_SCORE: i64 = 5
    const INFO_CURSOR: i64 = 6
    const INFO_VERDICT: i64 = 7
    const INFO_RIGHT: i64 = 8
    const VALUE_BOARD: i64 = 0
    const VALUE_PREMIUM: i64 = 1
    const VALUE_RACK: i64 = 2

    struct Run:
        rng: mutable MT19937
        rung: mutable i64
        trials: mutable i64
        trial: mutable i64
        right: mutable i64
        phase: mutable i64
        verdict: mutable i64
        score: mutable i64
        cursor: mutable i64
        size: mutable i64
        board: mutable i64[MAX_CELLS]
        premium: mutable i64[MAX_CELLS]
        laid: mutable i64[MAX_CELLS]
        rack: mutable i64[RACK]
        spent: mutable bool[RACK]

    def allowed_rung(value: i64) -> bool:
        return value >= 1 and value <= Scrabble::GRADE_COUNT
    def allowed_trials(value: i64) -> bool:
        return value >= 1 and value <= 100

    def clear(run: mutable Run&):
        can Abort.Panic:
            run.score <- 0
            run.cursor <- 0
            for cell in 0..<MAX_CELLS |cell, run|:
                run.board[cell.usize()] <- 0
                run.premium[cell.usize()] <- 0
                run.laid[cell.usize()] <- 0
            for slot in 0..<RACK |slot, run|:
                run.rack[slot.usize()] <- 0
                run.spent[slot.usize()] <- false

    def build_lexicon(lex: mutable Scrabble::Lexicon&):
        can Abort.Panic:
            # A deliberately small source-compatible lexicon. The controller
            # uses the same source indexing and legality code as the full port.
            lex.count <- 8
            words: mutable darray[i64] = [0, 13, 19, 4, 0, 19, 4, 0, 13, 19, 4, 0, 19, 4, 13, 0, 19, 4, 13, 0, 19, 4, 0, 19]
            lengths: mutable darray[i64] = [3, 3, 3, 3, 3, 3, 3, 3]
            at: mutable i64 = 0
            for word in 0..<8 |word, lex, words, lengths, at|:
                Ints::put(&lex.start, word, at)
                Ints::put(&lex.length, word, Ints::at_ref(&lengths, word))
                Ints::put(&lex.rank, word, word + 1)
                for letter in 0..<3 |letter, lex, words, at, word|:
                    Ints::put(&lex.letter, at + letter, Ints::at_ref(&words, word * 3 + letter))
                at <- at + 3
            Scrabble::index_lexicon(lex)

    def initialize(run: mutable Run&, rung: i64, trials: i64, seed: i64):
        can Abort.Panic:
            run.rng <- mt19937_new()
            mt_seed_int(&run.rng, seed.u64())
            run.rung <- rung
            run.trials <- trials
            run.trial <- 0
            run.right <- 0
            run.phase <- PHASE_READY
            run.verdict <- -1
            run.size <- 0
            clear(run)

    def next_trial(run: mutable Run&):
        can Memory.Allocate, Abort.Panic:
            if run.trial >= run.trials:
                run.phase <- PHASE_DONE
                return
            run.trial <- run.trial + 1
            clear(run)
            region deal(67108864):
                in deal:
                    board: mutable Scrabble::Board = Scrabble::new_board()
                    Scrabble::blank_board(&board, 7)
                    run.size <- board.size
                    for cell in 0..<MAX_CELLS |cell, run, board|:
                        run.premium[cell.usize()] <- Ints::at_ref(&board.premium, cell)
                    for slot in 0..<RACK |slot, run|:
                        run.rack[slot.usize()] <- 97 if slot == 0 or slot == 4 else 101 if slot == 1 or slot == 5 else 110 if slot == 2 else 116 if slot == 3 else 0
                destroy deal
            run.verdict <- -1
            run.phase <- PHASE_PLAYING

    def initialize_play(run: mutable Run&, work: mutable Scrabble::Work&):
        can Abort.Panic:
            middle: i64 = run.size / 2
            Ints::put(&work.laid_cell, 0, middle * run.size + middle - 1)
            Ints::put(&work.laid_cell, 1, middle * run.size + middle)
            Ints::put(&work.laid_cell, 2, middle * run.size + middle + 1)
            Ints::put(&work.laid_letter, 0, 0)
            Ints::put(&work.laid_letter, 1, 13)
            Ints::put(&work.laid_letter, 2, 19)

    def apply(run: mutable Run&, action: i64, value: i64, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            _ = value
            _ = now_ms
            if action == ACTION_START:
                return 2 if run.phase == PHASE_PLAYING
                next_trial(run)
                return 1
            if action == ACTION_LEFT:
                run.cursor <- run.cursor - 1 if run.cursor > 0
                return 1 if run.phase == PHASE_PLAYING else 2
            if action == ACTION_RIGHT:
                run.cursor <- run.cursor + 1 if run.cursor + 1 < run.size * run.size
                return 1 if run.phase == PHASE_PLAYING else 2
            if action == ACTION_TOGGLE: return 1 if run.phase == PHASE_PLAYING else 2
            if action != ACTION_PLAY or run.phase != PHASE_PLAYING: return 2
            region play(67108864):
                in play:
                    board: mutable Scrabble::Board = Scrabble::new_board()
                    work: mutable Scrabble::Work = Scrabble::new_work()
                    lex: mutable Scrabble::Lexicon = Scrabble::new_lexicon()
                    words: mutable darray[i64] = Ints::zeros(Scrabble::MOST_SIZE * 2)
                    starts: mutable darray[i64] = Ints::zeros(Scrabble::MOST_SIZE)
                    lengths: mutable darray[i64] = Ints::zeros(Scrabble::MOST_SIZE)
                    Scrabble::blank_board(&board, run.size)
                    for cell in 0..<MAX_CELLS |cell, board, run|:
                        Ints::put(&board.letters, cell, -1 if run.board[cell.usize()] == 0 else run.board[cell.usize()] - 97)
                    build_lexicon(&lex)
                    initialize_play(run, &work)
                    if Scrabble::legal(&board, &work, 3, false, &lex):
                        scored: Scrabble::Scored = Scrabble::score_play(&board, &work, 3, false, &starts, &lengths, &words)
                        run.score <- scored.score
                        for slot in 0..<3 |slot, run, work|:
                            cell: i64 = Ints::at_ref(&work.laid_cell, slot)
                            run.board[cell.usize()] <- Ints::at_ref(&work.laid_letter, slot) + 97
                            run.laid[cell.usize()] <- run.board[cell.usize()]
                        run.verdict <- 1
                        run.right <- run.right + 1
                    else:
                        run.verdict <- 0
                    run.phase <- PHASE_SCORED
                destroy play
            return 1
            return 2

    def info(run: Run&, field: i64) -> i64:
        if field == INFO_PHASE: return run.phase
        if field == INFO_RUNG: return run.rung
        if field == INFO_TRIAL: return run.trial
        if field == INFO_TOTAL: return run.trials
        if field == INFO_SIZE: return run.size
        if field == INFO_SCORE: return run.score
        if field == INFO_CURSOR: return run.cursor
        if field == INFO_VERDICT: return run.verdict
        if field == INFO_RIGHT: return run.right
        return -1

    def value(run: Run&, field: i64, at: i64) -> i64:
        return -1 if at < 0 or at >= MAX_CELLS
        if field == VALUE_BOARD: return run.board[at.usize()]
        if field == VALUE_PREMIUM: return run.premium[at.usize()]
        if field == VALUE_RACK: return run.rack[at.usize()] if at < RACK else -1
        return -1

    def render(run: Run&, black: bool, width: f64, height: f64, list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            region frame(67108864):
                in frame:
                    premiums: mutable darray[i64] = Ints::zeros(MAX_CELLS)
                    letters: mutable darray[i64] = Ints::zeros(MAX_CELLS)
                    laid: mutable darray[i64] = Ints::zeros(MAX_CELLS)
                    rack: mutable darray[i64] = Ints::zeros(RACK)
                    spent: mutable darray[bool] = []
                    for cell in 0..<MAX_CELLS |cell, premiums, letters, laid, run|:
                        Ints::put(&premiums, cell, run.premium[cell.usize()])
                        Ints::put(&letters, cell, run.board[cell.usize()])
                        Ints::put(&laid, cell, run.laid[cell.usize()])
                    for slot in 0..<RACK |slot, rack, run|:
                        rack.push(run.rack[slot.usize()])
                    for slot in 0..<RACK |slot, spent, run|:
                        spent.push(run.spent[slot.usize()])
                    message: mutable dstr = []
                    if run.phase == PHASE_READY: dstr_append_cstr(&message, "Press Space to start")
                    elif run.phase == PHASE_PLAYING: dstr_append_cstr(&message, "Lay the source play")
                    elif run.verdict == 1: dstr_append_cstr(&message, "Scored")
                    else: dstr_append_cstr(&message, "No legal play")
                    sx: f64 = width / Display::REFERENCE_WIDTH
                    sy: f64 = height / Display::REFERENCE_HEIGHT
                    paint: SceneScrabble::Paint = SceneScrabble::paint_of(black, width, height, sx, sy)
                    SceneScrabble::render(list, &paint, run.phase, run.size > 0, run.size,
                        premiums, letters, laid, rack, spent, true, run.cursor, -1, -1, false,
                        false, run.trial, run.trials, bytes_view(message), run.verdict, sview("", 0, -1))
                destroy frame
