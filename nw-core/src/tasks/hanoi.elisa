# Tower of Hanoi: rebuild the tower on another peg.
#
# Port of the portable half of neural_workshop/ui/hanoi.py (GPL-2.0-or-later).
# The task has no core module in the reference -- its rules live in the UI file
# alongside the drawing -- so what is here is the rules, the adaptive ladder and
# the scoring, and the drawing stays where every other task's drawing is.
#
# It is the one task in the workshop where "perfect" is a FORMULA rather than a
# search: the minimum is 2^n - 1, so a solve can be scored green against an
# exact optimum with nothing to solve for.

module Hanoi:

    # Three disks is seven moves, a child's puzzle; twelve is 4095 and a siege.
    # The ceiling is VISUAL, not logical: disk widths step by widest/16, and
    # past twelve neighbouring disks stop being tellable apart at a glance --
    # which is the one judgement this game needs the eye to make.
    const SMALLEST_TOWER: i64 = 3
    const LARGEST_TOWER: i64 = 12

    # How efficient a solve has to be before an adaptive run adds a disk, and
    # how far below that it falls before one is taken away. Efficiency is the
    # minimum move count over the moves used.
    const GROW_AT: f64 = 0.8
    const SHRINK_AT: f64 = 0.5

    const PEGS: i64 = 3

    def minimum_moves(disks: i64) -> i64:
        can Abort.Panic:
            return (1 << disks) - 1

    def clamped(disks: i64) -> i64:
        can Abort.Panic:
            return SMALLEST_TOWER if disks < SMALLEST_TOWER else (LARGEST_TOWER if disks > LARGEST_TOWER else disks)

    # The three pegs as one flat table: `height[peg]` disks, and
    # `disk[peg * LARGEST_TOWER + at]` bottom-first. Disks are named by SIZE, so
    # a peg reads bottom to top and the top disk is the last one.
    struct Board:
        disks: mutable i64
        height: mutable darray[i64]
        disk: mutable darray[i64]

    # The starting position: every disk on the first peg, size order, biggest
    # at the bottom.
    def fresh_pegs(disks: i64) -> Board:
        can Memory.Allocate, Abort.Panic:
            out: mutable Board = Board{disks: disks, height: Ints::zeros(PEGS),
                                       disk: Ints::zeros(PEGS * LARGEST_TOWER)}
            for at in 0..<disks |out, disks|:
                Ints::put(&out.disk, at, disks - at)
            Ints::put(&out.height, 0, disks)
            return out

    def top_of(board: mutable Board&, peg: i64) -> i64:
        can Abort.Panic:
            height: i64 = Ints::at_ref(&board.height, peg)
            return -1 if height <= 0
            return Ints::at_ref(&board.disk, peg * LARGEST_TOWER + height - 1)

    # Whether the top of `source` may go onto `target`.
    def can_move(board: mutable Board&, source: i64, target: i64) -> bool:
        can Abort.Panic:
            false return if source < 0 or source >= PEGS or target < 0 or target >= PEGS
            false return if source == target
            lifted: i64 = top_of(board, source)
            false return if lifted < 0
            resting: i64 = top_of(board, target)
            return true if resting < 0 else lifted < resting

    def apply_move(board: mutable Board&, source: i64, target: i64) -> bool:
        can Abort.Panic:
            false return if not can_move(board, source, target)
            from_height: i64 = Ints::at_ref(&board.height, source)
            lifted: i64 = Ints::at_ref(&board.disk, source * LARGEST_TOWER + from_height - 1)
            Ints::put(&board.height, source, from_height - 1)
            to_height: i64 = Ints::at_ref(&board.height, target)
            Ints::put(&board.disk, target * LARGEST_TOWER + to_height, lifted)
            Ints::put(&board.height, target, to_height + 1)
            return true

    # The tower is rebuilt somewhere it did NOT start -- pegs one and two only.
    def solved(board: mutable Board&) -> bool:
        can Abort.Panic:
            for peg in 1..<PEGS |board|:
                true return if Ints::at_ref(&board.height, peg) == board.disks
            return false

    # What one solve is worth: the minimum over the moves used, capped at one so
    # a solve can never score better than perfect.
    def efficiency(par: i64, moves: i64) -> f64:
        can Abort.Panic:
            worst: i64 = par if par > moves else moves
            return 0.0 if worst <= 0
            return par.f64() / worst.f64()

    # The next tower size an adaptive run asks for.
    def next_disks(disks: i64, eff: f64) -> i64:
        can Abort.Panic:
            return clamped(disks + 1) if eff >= GROW_AT
            return clamped(disks - 1) if eff < SHRINK_AT
            return clamped(disks)

    # `int(round(100 * mean))` -- Python's round is round-half-even, and the
    # score is reported as a whole percent.
    def efficiency_percent(total: f64, rounds: i64) -> i64:
        can Abort.Panic:
            return 0 if rounds <= 0
            return py_round_half_even(100.0 * total / rounds.f64())

    # The classic recursive solution, as the (source, target) moves that walk
    # it. Exactly 2^n - 1 of them, which is what makes the par a formula.
    def solve(disks: i64, source: i64, spare: i64, target: i64, moves: mutable darray[i64]&, count: mutable i64&):
        can Abort.Panic:
            return if disks <= 0
            solve(disks - 1, source, target, spare, moves, count)
            Ints::put(moves, count * 2, source)
            Ints::put(moves, count * 2 + 1, target)
            count <- count + 1
            solve(disks - 1, spare, source, target, moves, count)
