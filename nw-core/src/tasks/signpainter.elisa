include "../strings.elisa"
include "../hand_view.elisa"
include "../pymath.elisa"
include "../pyrandom.elisa"
include "./drshape_deal.elisa"

module SignPainter:
    const RED: i64 = HandView::KEYS
    const DIP: i64 = RED + 4
    const PORTS: i64 = DIP + 1
    const WIDTH: f64 = 9.0
    const HEIGHT: f64 = 3.6
    const SAMPLE_STEP: f64 = 0.25

    const OUTLINE: i64 = 0
    const CORNERS: i64 = 1
    const NO_GUIDE: i64 = 2

    const BRUSH: i64 = 0
    const SMUDGE: i64 = 1
    const DONE: i64 = 2
    const DRY: i64 = 3
    const SPLASH: i64 = 4

    const LIVE: i64 = 0
    const PAINTED: i64 = 1
    const MESS: i64 = 2
    const WRONG_COLOUR: i64 = 3
    const DRIED: i64 = 4

    struct Grade:
        rung: i64
        length: i64
        brush: f64
        colour: bool
        guide: i64
        load: i64
        swing: f64
        drag: f64
        seconds: f64

    struct Glyph:
        vertices: RoomsView::Point[9]
        ends: i64[3]
        strokes: i64

    struct Sign:
        level: Grade
        word: sview
        colour: i64
        points: mutable RoomsView::Point[384]
        ends: mutable i64[15]
        corners: mutable RoomsView::Point[45]
        point_count: mutable i64
        stroke_count: mutable i64
        corner_count: mutable i64
        seconds: mutable f64
        seed: mutable i64
        valid: mutable bool

    struct Run:
        sign: Sign
        hand: mutable HandView::Pointer
        stroke: mutable i64
        point: mutable i64
        colour: mutable i64
        paint: mutable i64
        smudges: mutable i64
        brush: mutable RoomsView::Point
        has_brush: mutable bool
        smudged_now: mutable bool
        sound_at: mutable f64
        time: mutable f64
        result: mutable i64
        audible: bool
        notes: mutable darray[DrShapeDeal::Note]

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        top: f64 = (r - 20).f64() if r > 20 else 0.0
        brush: f64 = 0.34 if r < 7 else (0.28 if r < 13 else (0.24 if r < 20 else fmax(0.16, 0.23 - 0.002 * top)))
        seconds: f64 = 0.9 if r < 7 else (0.75 if r < 13 else (0.65 if r < 20 else fmax(0.36, 0.6 - 0.008 * top)))
        load: i64 = 0 if r < 7 else (26 if r < 20 else (12 if r >= 44 else 24 - (r - 20) / 2))
        swing: f64 = 0.0 if r < 10 else (9.0 if r < 20 else fmin(22.0, 10.0 + 0.4 * top))
        return Grade{rung: r, length: 0 if r < 10 else (1 if r < 16 else 2), brush: brush,
            colour: r >= 4, guide: OUTLINE if r < 7 else (CORNERS if r < 13 else NO_GUIDE),
            load: load, swing: swing, drag: 0.0 if r < 16 else 0.08, seconds: seconds}

    def position(x: f64, y: f64) -> RoomsView::Point:
        return RoomsView::Point{x: x, y: y}

    # Each path begins where the preceding path ended in the vertex array.
    # Coordinates are the Python reference's two-by-three letter grid.
    def glyph(letter: u8) -> Glyph:
        if letter == 73.u8(): # I
            return Glyph{vertices: [position(1.0, 3.0), position(1.0, 0.0), zeroed, zeroed, zeroed,
                zeroed, zeroed, zeroed, zeroed], ends: [2, 0, 0], strokes: 1}
        if letter == 76.u8(): # L
            return Glyph{vertices: [position(0.0, 3.0), position(0.0, 0.0), position(2.0, 0.0), zeroed, zeroed,
                zeroed, zeroed, zeroed, zeroed], ends: [3, 0, 0], strokes: 1}
        if letter == 84.u8(): # T
            return Glyph{vertices: [position(0.0, 3.0), position(2.0, 3.0), position(1.0, 3.0), position(1.0, 0.0), zeroed,
                zeroed, zeroed, zeroed, zeroed], ends: [2, 4, 0], strokes: 2}
        if letter == 86.u8(): # V
            return Glyph{vertices: [position(0.0, 3.0), position(1.0, 0.0), position(2.0, 3.0), zeroed, zeroed,
                zeroed, zeroed, zeroed, zeroed], ends: [3, 0, 0], strokes: 1}
        if letter == 78.u8(): # N
            return Glyph{vertices: [position(0.0, 0.0), position(0.0, 3.0), position(2.0, 0.0), position(2.0, 3.0), zeroed,
                zeroed, zeroed, zeroed, zeroed], ends: [4, 0, 0], strokes: 1}
        if letter == 90.u8(): # Z
            return Glyph{vertices: [position(0.0, 3.0), position(2.0, 3.0), position(0.0, 0.0), position(2.0, 0.0), zeroed,
                zeroed, zeroed, zeroed, zeroed], ends: [4, 0, 0], strokes: 1}
        if letter == 77.u8(): # M
            return Glyph{vertices: [position(0.0, 0.0), position(0.0, 3.0), position(1.0, 1.5), position(2.0, 3.0), position(2.0, 0.0),
                zeroed, zeroed, zeroed, zeroed], ends: [5, 0, 0], strokes: 1}
        if letter == 87.u8(): # W
            return Glyph{vertices: [position(0.0, 3.0), position(0.5, 0.0), position(1.0, 1.5), position(1.5, 0.0), position(2.0, 3.0),
                zeroed, zeroed, zeroed, zeroed], ends: [5, 0, 0], strokes: 1}
        if letter == 69.u8(): # E
            return Glyph{vertices: [position(2.0, 3.0), position(0.0, 3.0), position(0.0, 0.0), position(2.0, 0.0), position(0.0, 1.5),
                position(1.5, 1.5), zeroed, zeroed, zeroed], ends: [4, 6, 0], strokes: 2}
        if letter == 70.u8(): # F
            return Glyph{vertices: [position(2.0, 3.0), position(0.0, 3.0), position(0.0, 0.0), position(0.0, 1.5), position(1.5, 1.5),
                zeroed, zeroed, zeroed, zeroed], ends: [3, 5, 0], strokes: 2}
        if letter == 72.u8(): # H
            return Glyph{vertices: [position(0.0, 3.0), position(0.0, 0.0), position(2.0, 3.0), position(2.0, 0.0), position(0.0, 1.5),
                position(2.0, 1.5), zeroed, zeroed, zeroed], ends: [2, 4, 6], strokes: 3}
        if letter == 88.u8(): # X
            return Glyph{vertices: [position(0.0, 3.0), position(2.0, 0.0), position(2.0, 3.0), position(0.0, 0.0), zeroed,
                zeroed, zeroed, zeroed, zeroed], ends: [2, 4, 0], strokes: 2}
        if letter == 65.u8(): # A
            return Glyph{vertices: [position(0.0, 0.0), position(1.0, 3.0), position(2.0, 0.0), position(0.5, 1.5), position(1.5, 1.5),
                zeroed, zeroed, zeroed, zeroed], ends: [3, 5, 0], strokes: 2}
        if letter == 75.u8(): # K
            return Glyph{vertices: [position(0.0, 3.0), position(0.0, 0.0), position(2.0, 3.0), position(0.0, 1.5), position(2.0, 0.0),
                zeroed, zeroed, zeroed, zeroed], ends: [2, 5, 0], strokes: 2}
        if letter == 89.u8(): # Y
            return Glyph{vertices: [position(0.0, 3.0), position(1.0, 1.5), position(2.0, 3.0), position(1.0, 1.5), position(1.0, 0.0),
                zeroed, zeroed, zeroed, zeroed], ends: [3, 5, 0], strokes: 2}
        if letter == 79.u8(): # O
            return Glyph{vertices: [position(0.5, 3.0), position(1.5, 3.0), position(2.0, 2.3), position(2.0, 0.7), position(1.5, 0.0),
                position(0.5, 0.0), position(0.0, 0.7), position(0.0, 2.3), position(0.5, 3.0)], ends: [9, 0, 0], strokes: 1}
        return zeroed

    def word_for(level: Grade&, draw: mutable MT19937&) -> sview:
        can Abort.Panic:
            if level.length == 0:
                words: sview[8] = ["IT", "AT", "INN", "ALE", "HAY", "TEA", "HAT", "WAX"]
                return words[py_randbelow(draw, 8.u64()).usize()]
            if level.length == 1:
                medium: sview[7] = ["EXIT", "TENT", "MILK", "MINE", "TAXI", "FEET", "HALT"]
                return medium[py_randbelow(draw, 7.u64()).usize()]
            long: sview[5] = ["ANVIL", "HOTEL", "KNIFE", "MELON", "WHEAT"]
            return long[py_randbelow(draw, 5.u64()).usize()]

    def colour_name(colour: i64) -> sview:
        return "red" if colour == 0
        return "green" if colour == 1
        return "blue" if colour == 2
        return "yellow"

    def lay_out(sign: mutable Sign&):
        can Abort.Panic:
            width: f64 = 2.8 * sview_len(sign.word).f64() - 0.8
            size: f64 = fmin(1.0, (WIDTH - 1.0) / width)
            left: f64 = (WIDTH - size * width) / 2.0
            low: f64 = (HEIGHT - 3.0 * size) / 2.0
            for i in 0..<sview_len(sign.word).i64() |sign, size, left, low|:
                letter: Glyph = glyph(sview_at(sign.word, i.usize()))
                ox: f64 = left + 2.8 * size * i.f64()
                start: mutable i64 = 0
                for line in 0..<letter.strokes |sign, letter, start, ox, low, size|:
                    end: i64 = letter.ends[line.usize()]
                    a: mutable RoomsView::Point = position(ox + letter.vertices[start.usize()].x * size,
                        low + letter.vertices[start.usize()].y * size)
                    sign.points[sign.point_count.usize()] <- a
                    sign.point_count <- sign.point_count + 1
                    sign.corners[sign.corner_count.usize()] <- a
                    sign.corner_count <- sign.corner_count + 1
                    for j in (start + 1)..<end |sign, letter, a, ox, low, size|:
                        b: RoomsView::Point = position(ox + letter.vertices[j.usize()].x * size,
                            low + letter.vertices[j.usize()].y * size)
                        sign.corners[sign.corner_count.usize()] <- b
                        sign.corner_count <- sign.corner_count + 1
                        dx: f64 = b.x - a.x
                        dy: f64 = b.y - a.y
                        steps: i64 = fmax(1.0, py_round_half_even(py_hypot(dx, dy) / SAMPLE_STEP).f64()).i64()
                        for k in 1..<(steps + 1) |sign, a, dx, dy, steps|:
                            sign.points[sign.point_count.usize()] <- position(a.x + dx * k.f64() / steps.f64(),
                                a.y + dy * k.f64() / steps.f64())
                            sign.point_count <- sign.point_count + 1
                        a <- b
                    sign.ends[sign.stroke_count.usize()] <- sign.point_count
                    sign.stroke_count <- sign.stroke_count + 1
                    start <- end

    def build(level: Grade, draw: mutable MT19937&) -> Sign:
        can Abort.Panic:
            word: sview = word_for(&level, draw)
            colour: i64 = py_randbelow(draw, 4.u64()).i64() if level.colour else -1
            sign: mutable Sign = Sign{level: level, word: word, colour: colour, points: zeroed,
                ends: zeroed, corners: zeroed, point_count: 0, stroke_count: 0, corner_count: 0,
                seconds: 0.0, seed: 0, valid: true}
            lay_out(&sign)
            sign.seconds <- 8.0 + sign.point_count.f64() * level.seconds + 1.2 * sign.stroke_count.f64()
            sign.seed <- py_randbelow(draw, 1073741824.u64()).i64()
            return sign

    def refilled(level: Grade&) -> i64:
        return level.load if level.load != 0 else 1000000

    def begin(sign: Sign, audible: bool = true) -> Run:
        return Run{sign: sign, hand: HandView::initialize(), stroke: 0, point: 0,
            colour: -1 if sign.level.colour else 0, paint: refilled(&sign.level), smudges: 0,
            brush: zeroed, has_brush: false, smudged_now: false, sound_at: 0.0,
            time: 0.0, result: LIVE, audible: audible, notes: []}

    def swing(run: Run&) -> f64:
        return run.sign.level.swing * (3.141592653589793 / 180.0) * sin(run.time * 1.25)

    def world(run: Run&, u: f64, v: f64, out: f64 = 0.0) -> RoomsView::Vec:
        angle: f64 = swing(run)
        offset: f64 = u - WIDTH / 2.0
        return RoomsView::vec(offset * cos(angle) + out * sin(angle), v, offset * -sin(angle) + out * cos(angle))

    def view() -> HandView::Lens:
        can Abort.Panic:
            return HandView::lens(RoomsView::vec(0.0, 1.8, 10.0), RoomsView::vec(0.0, 1.8, 0.0), 900.0, 500.0, 290.0)

    def see(run: Run&, u: f64, v: f64, out: f64 = 0.0) -> RoomsView::Vec:
        can Abort.Panic:
            camera: HandView::Lens = view()
            return HandView::see(&camera, world(run, u, v, out))

    def under(run: Run&) -> HandView::Intersection:
        can Abort.Panic:
            angle: f64 = swing(run)
            camera: HandView::Lens = view()
            normal: RoomsView::Vec = RoomsView::vec(sin(angle), 0.0, cos(angle))
            hit: HandView::Intersection = HandView::on_plane(&camera, run.hand.x, run.hand.y, zeroed, normal)
            return hit if not hit.valid
            right: RoomsView::Vec = RoomsView::vec(cos(angle), 0.0, -sin(angle))
            return HandView::Intersection{valid: true,
                point: RoomsView::vec(RoomsView::dot(hit.point, right) + WIDTH / 2.0, hit.point.y, 0.0)}

    def stroke_start(sign: Sign&, stroke: i64) -> i64:
        can Abort.Panic:
            return 0 if stroke == 0 else sign.ends[(stroke - 1).usize()]

    def note(run: mutable Run&, duration: f64, frequency: f64, voice: i64, gain: f64):
        can Abort.Panic, Memory.Allocate:
            return if not run.audible
            run.notes.push(DrShapeDeal::Note{t: run.time, dur: duration, freq: frequency, voice: voice,
                gain: gain, gain2: gain, pan: 0.0, pan2: 0.0, bright: 0.8, seed: 1 + run.notes.count.i64(), who: -1, room: 0.0})

    def act(run: mutable Run&, port: i64):
        can Abort.Panic, Memory.Allocate:
            if port < HandView::PRESS:
                HandView::move(&run.hand, port)
            elif port == HandView::PRESS:
                if run.result == LIVE and not run.hand.down:
                    hit: HandView::Intersection = under(run)
                    run.hand.down <- true
                    run.brush <- position(hit.point.x, hit.point.y)
                    run.has_brush <- hit.valid
                    run.smudged_now <- false
            elif port == HandView::RELEASE:
                run.hand.down <- false
                run.has_brush <- false
            elif run.result == LIVE and not run.hand.down:
                if port < DIP:
                    run.colour <- port - RED
                elif port == DIP:
                    run.paint <- refilled(&run.sign.level)
                    note(run, 0.15, 600.0, SPLASH, 0.4)

    def from_segment(p: RoomsView::Point, a: RoomsView::Point, b: RoomsView::Point) -> f64:
        vx: f64 = b.x - a.x
        vy: f64 = b.y - a.y
        d2: f64 = vx * vx + vy * vy
        u: f64 = 0.0 if d2 < 0.000000001 else HandView::clamp(((p.x - a.x) * vx + (p.y - a.y) * vy) / d2, 0.0, 1.0)
        return py_hypot(p.x - a.x - u * vx, p.y - a.y - u * vy)

    def smudge(run: mutable Run&, verdict: i64):
        can Abort.Panic, Memory.Allocate:
            run.smudges <- run.smudges + 1
            run.smudged_now <- true
            note(run, 0.25, 120.0, SMUDGE, 0.5)
            run.result <- verdict if run.smudges >= 3

    def paint_point(run: mutable Run&):
        can Abort.Panic, Memory.Allocate:
            run.point <- run.point + 1
            run.paint <- run.paint - 1
            if run.time >= run.sound_at:
                run.sound_at <- run.time + 0.1
                note(run, 0.12, 240.0 + 20.0 * run.point.f64(), BRUSH, 0.25)
            if stroke_start(&run.sign, run.stroke) + run.point >= run.sign.ends[run.stroke.usize()]:
                run.stroke <- run.stroke + 1
                run.point <- 0
                note(run, 0.1, 880.0, DONE, 0.3)
                run.result <- PAINTED if run.stroke >= run.sign.stroke_count

    def paint_at(run: mutable Run&, hit: RoomsView::Vec, dt: f64):
        can Abort.Panic, Memory.Allocate:
            drag: f64 = run.sign.level.drag
            k: f64 = fmin(1.0, dt / drag) if run.has_brush and drag > 0.0 else 1.0
            p: RoomsView::Point = position(run.brush.x + (hit.x - run.brush.x) * k,
                run.brush.y + (hit.y - run.brush.y) * k) if run.has_brush and drag > 0.0 else position(hit.x, hit.y)
            run.brush <- p
            run.has_brush <- true
            return if p.x < 0.0 or p.x > WIDTH or p.y < 0.0 or p.y > HEIGHT or run.smudged_now
            if run.paint <= 0 or run.colour < 0:
                if run.time >= run.sound_at:
                    run.sound_at <- run.time + 0.3
                    note(run, 0.08, 900.0, DRY, 0.3)
                return
            index: i64 = stroke_start(&run.sign, run.stroke) + run.point
            goal: RoomsView::Point = run.sign.points[index.usize()]
            radius: f64 = run.sign.level.brush
            if run.point > 0 and from_segment(p, run.sign.points[(index - 1).usize()], goal) > 2.5 * radius:
                smudge(run, MESS)
            elif run.sign.colour >= 0 and run.colour != run.sign.colour:
                smudge(run, WRONG_COLOUR)
            elif py_hypot(p.x - goal.x, p.y - goal.y) <= radius:
                paint_point(run)

    def step(run: mutable Run&, dt: f64):
        can Abort.Panic, Memory.Allocate:
            return if run.result != LIVE
            run.time <- run.time + dt
            if run.hand.down and run.stroke < run.sign.stroke_count:
                hit: HandView::Intersection = under(run)
                paint_at(run, hit.point, dt) if hit.valid
            run.result <- DRIED if run.result == LIVE and run.time >= run.sign.seconds

    def pilot(run: Run&) -> i64:
        can Abort.Panic:
            return -1 if run.result != LIVE or run.stroke >= run.sign.stroke_count
            want: i64 = run.sign.colour if run.sign.colour >= 0 else 0
            if run.colour != want or run.paint <= 0:
                return HandView::RELEASE if run.hand.down
                return RED + want if run.colour != want else DIP
            index: i64 = stroke_start(&run.sign, run.stroke) + run.point
            if not run.hand.down:
                pickup: RoomsView::Point = run.sign.points[(index - (1 if run.point > 0 else 0)).usize()]
                q: RoomsView::Vec = see(run, pickup.x, pickup.y)
                port: i64 = HandView::toward(&run.hand, q.x, q.y, 3.0)
                return port if port >= 0 else HandView::PRESS
            return HandView::RELEASE if run.smudged_now
            goal: RoomsView::Point = run.sign.points[index.usize()]
            q: RoomsView::Vec = see(run, goal.x, goal.y)
            return HandView::toward(&run.hand, q.x, q.y, 2.6)

    def reference_wins(sign: Sign) -> bool:
        can Abort.Panic, Memory.Allocate:
            run: mutable Run = begin(sign, false)
            while run.result == LIVE |run|:
                act(&run, pilot(&run))
                step(&run, 1.0 / 60.0)
            return run.result == PAINTED

    def deal(rung: i64, draw: mutable MT19937&) -> Sign:
        can Abort.Panic, Memory.Allocate:
            level: Grade = grade(rung)
            for _ in 0..<80 |level, draw|:
                rng: mutable MT19937 = zeroed
                mt_seed_int(&rng, py_getrandbits(draw, 32))
                sign: Sign = build(level, &rng)
                return sign if reference_wins(sign)
            return empty(level)

    def empty(level: Grade) -> Sign:
        return Sign{level: level, word: "", colour: -1, points: zeroed, ends: zeroed,
            corners: zeroed, point_count: 0, stroke_count: 0, corner_count: 0,
            seconds: 0.0, seed: 0, valid: false}
