include "./emotionfaces_game.elisa"
include "./missing_word_game.elisa"

module EmotionFacesHost:
    const START: i64 = ReadingQuiz::PORTS

    struct Run:
        session: mutable EmotionFacesGame::Session
        corpus: mutable EmotionFaces::Corpus
        resources: mutable Arena
        loaded: mutable bool

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Run:
        return Run{session: EmotionFacesGame::initialize(rung, total, adaptive, seed), corpus: zeroed,
            resources: zeroed, loaded: false}

    def import_questions(run: mutable Run&, text: sview) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if run.loaded or run.session.phase != EmotionFacesGame::READY
            run.corpus <- EmotionFaces::from_question_cache(&run.resources, text) can Global{Read,Write}
            run.loaded <- true
            return true

    def start(run: mutable Run&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            if not run.loaded:
                _ = import_questions(run, "") can Global{Read,Write}
            return EmotionFacesGame::start(&run.session, &run.corpus, now) can Global{Read,Write}

    def pointer(run: mutable Run&, x: f64, y: f64, kind: i64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            if kind == 1 and (run.session.phase == EmotionFacesGame::READY or run.session.phase == EmotionFacesGame::DONE):
                return start(run, now) can Global{Read,Write}
            return EmotionFacesGame::pointer(&run.session, x, y, kind)

    def face_input(run: mutable Run&, now: f64, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if not EmotionFacesGame::valid_time(&run.session, now)
            return (start(run, now) can Global{Read,Write}) if port == START
            return (EmotionFacesGame::advance(&run.session, &run.corpus, now, true) can Global{Read,Write}) if port == -1
            return EmotionFacesGame::choose(&run.session, port)

    def clear_controls(run: mutable Run&) -> bool:
        changed: bool = run.session.hand.down
        run.session.hand.down <- false
        return changed

    def reconfigure(run: mutable Run&, rung: i64, rounds: i64, adaptive: bool) -> bool:
        can Abort.Panic, Memory.Release:
            return false if run.session.phase != EmotionFacesGame::READY and run.session.phase != EmotionFacesGame::DONE
            return false if not MissingWordGame::allowed_rung(rung) or not MissingWordGame::allowed_total(rounds)
            EmotionFacesGame::close(&run.session) can Global{Read,Write}
            run.session.start_rung <- rung
            run.session.rung <- rung
            run.session.total <- rounds
            run.session.adaptive <- adaptive
            run.session.trial <- 0
            run.session.wins <- 0
            run.session.best_rung <- 0
            return true

    def close(run: mutable Run&):
        can Abort.Panic, Memory.Release:
            EmotionFacesGame::close(&run.session) can Global{Read,Write}
            arena_free(&run.resources) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}
            run.corpus <- zeroed
            run.loaded <- false

    def info(run: Run&, field: i64) -> i64:
        can Abort.Panic:
            return run.session.phase if field == 0
            return run.session.rung if field == 1
            return run.session.trial if field == 2
            return run.session.total if field == 3
            return run.session.wins if field == 4
            return run.session.best_rung if field == 5
            return run.session.start_rung if field == 6
            return (1 if run.session.adaptive else 0) if field == 7
            return run.session.run.result if field == 8
            return py_round_half_even(run.session.run.time * 1000.0) if field == 9
            return run.session.run.index if field == 10
            return run.session.run.right if field == 11
            return run.session.run.wrong if field == 12
            return -1
