include "./stagehand.elisa"
include "../tone_pcm.elisa"

module StagehandAudio:
    struct Instrument:
        patch: TonePcm::Patch
        fm_ratio: f64
        fm_index: f64
        fm_decay: f64
        drive: f64
        noise: f64
        glide: f64
        glide_time: f64

    def bell() -> Instrument:
        partials: TonePcm::Partial[6] = [
            TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
            TonePcm::Partial{ratio: 2.6994507188250134, gain: 0.5, decay: 1.0},
            TonePcm::Partial{ratio: 5.512568530767664, gain: 0.25, decay: 2.0},
            zeroed,
            zeroed,
            zeroed]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 3, attack: 0.002,
            decay: 1.7983566313530988, release: 0.4, sustain: 0.0, tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 3.5553926699850886, fm_index: 2.853041415443653, fm_decay: 2.5,
            drive: 0.0, noise: 0.0, glide: 0.0, glide_time: 0.0}

    def growl() -> Instrument:
        partials: TonePcm::Partial[6] = [
            TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
            zeroed,
            zeroed,
            zeroed,
            zeroed,
            zeroed]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 1, attack: 0.02,
            decay: 1.5, release: 0.1, sustain: 0.5, tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 0.5, fm_index: 4.3648274175114, fm_decay: 0.5,
            drive: 2.723913743529675, noise: 0.0, glide: 0.0, glide_time: 0.0}

    def flute() -> Instrument:
        partials: TonePcm::Partial[6] = [
            TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
            TonePcm::Partial{ratio: 2.0, gain: 0.15, decay: 0.0},
            TonePcm::Partial{ratio: 3.0, gain: 0.05, decay: 0.0},
            zeroed,
            zeroed,
            zeroed]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 3, attack: 0.06,
            decay: 0.5, release: 0.15, sustain: 0.7, tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 0.0, fm_index: 0.0, fm_decay: 0.0,
            drive: 0.0, noise: 0.07061920915414334, glide: 0.0, glide_time: 0.0}

    def glass() -> Instrument:
        partials: TonePcm::Partial[6] = [
            TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
            TonePcm::Partial{ratio: 2.2832578940914505, gain: 0.6, decay: 0.8},
            TonePcm::Partial{ratio: 4.148807338728832, gain: 0.4, decay: 1.6},
            TonePcm::Partial{ratio: 6.63, gain: 0.25, decay: 2.5},
            zeroed,
            zeroed]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 4, attack: 0.005,
            decay: 1.1750539782265634, release: 0.5, sustain: 0.0, tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 0.0, fm_index: 0.0, fm_decay: 0.0,
            drive: 0.0, noise: 0.0, glide: 0.0, glide_time: 0.0}

    def brass() -> Instrument:
        partials: TonePcm::Partial[6] = [
            TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
            TonePcm::Partial{ratio: 2.0, gain: 0.5, decay: 0.0},
            TonePcm::Partial{ratio: 3.0, gain: 0.3333333333333333, decay: 0.0},
            TonePcm::Partial{ratio: 4.0, gain: 0.25, decay: 0.0},
            TonePcm::Partial{ratio: 5.0, gain: 0.2, decay: 0.0},
            TonePcm::Partial{ratio: 6.0, gain: 0.16666666666666666, decay: 0.0}]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 6, attack: 0.04,
            decay: 1.0, release: 0.1, sustain: 0.6, tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 1.0, fm_index: 1.5368705084669108, fm_decay: 3.0,
            drive: 0.0, noise: 0.0, glide: -0.03, glide_time: 0.05}

    def pluck() -> Instrument:
        partials: TonePcm::Partial[6] = [
            TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 1.5880020251284992},
            TonePcm::Partial{ratio: 2.0, gain: 0.5, decay: 3.1760040502569984},
            TonePcm::Partial{ratio: 3.0, gain: 0.3333333333333333, decay: 4.764006075385497},
            TonePcm::Partial{ratio: 4.0, gain: 0.25, decay: 6.352008100513997},
            TonePcm::Partial{ratio: 5.0, gain: 0.2, decay: 7.940010125642496},
            TonePcm::Partial{ratio: 6.0, gain: 0.16666666666666666, decay: 9.528012150770994}]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 6, attack: 0.003,
            decay: 4.257563233855782, release: 0.1, sustain: 0.0, tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 0.0, fm_index: 0.0, fm_decay: 0.0,
            drive: 0.0, noise: 0.0, glide: 0.0, glide_time: 0.0}

    def wood() -> Instrument:
        partials: TonePcm::Partial[6] = [
            TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
            TonePcm::Partial{ratio: 3.831294778284933, gain: 0.5, decay: 6.0},
            TonePcm::Partial{ratio: 8.878781240010541, gain: 0.25, decay: 12.0},
            zeroed,
            zeroed,
            zeroed]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 3, attack: 0.002,
            decay: 9.271682051471737, release: 0.05, sustain: 0.0, tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 0.0, fm_index: 0.0, fm_decay: 0.0,
            drive: 0.0, noise: 0.0, glide: 0.0, glide_time: 0.0}

    def play_cue(stereo: mutable darray[f64]&, frames: i64, begin: f64, end: f64,
                instrument: Instrument, cue: Stagehand::Cue):
        can Abort.Panic:
            parts: mutable TonePcm::Partial[6] = zeroed
            count: mutable i64 = 0
            bright: f64 = pow(0.8, 0.7)
            for i in 0..<instrument.patch.count |instrument, cue, bright, parts, count|:
                part: TonePcm::Partial = instrument.patch.partials[i.usize()]
                if part.ratio * cue.pitch < 0.42 * TonePcm::RATE.f64():
                    parts[count.usize()] <- TonePcm::Partial{ratio: part.ratio,
                        gain: part.gain if part.ratio < 1.5 else part.gain * bright, decay: part.decay}
                    count <- count + 1
            source: TonePcm::Patch = instrument.patch
            voice: TonePcm::Patch = TonePcm::Patch{partials: parts, count: count, attack: source.attack,
                decay: source.decay, release: source.release, sustain: source.sustain, tremolo_rate: 0.0, tremolo_depth: 0.0}
            overtone: TonePcm::Partial = TonePcm::Partial{ratio: 7.0, gain: 0.14285714285714285 * bright, decay: 0.0} if cue.voice == Stagehand::BUZZ and 7.0 * cue.pitch < 0.42 * TonePcm::RATE.f64() else zeroed
            fx: TonePcm::Modulation = TonePcm::Modulation{fm_ratio: instrument.fm_ratio,
                fm_index: instrument.fm_index * (0.4 + 0.6 * 0.8), fm_decay: instrument.fm_decay, drive: instrument.drive, ring_ratio: 0.0, ring_mix: 0.0, extra_partial: overtone}
            note: TonePcm::Note = TonePcm::Note{onset: cue.time, duration: cue.duration, frequency: cue.pitch,
                pan: 0.0, end_pan: 0.0, gain: cue.gain, end_gain: cue.gain, vibrato_rate: 4.737964627091892 if cue.voice == Stagehand::WHISTLE else 0.0,
                vibrato_depth: 0.004 if cue.voice == Stagehand::WHISTLE else 0.0, noise: instrument.noise, glide: instrument.glide, glide_time: instrument.glide_time, seed: cue.seed}
            TonePcm::mix_note(stereo, frames, begin, end, &voice, &note, fx)

    def render(run: Stagehand::Run&, begin: f64, end: f64, dest: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 0 if not (end > begin and end - begin <= 120.0)
            frames: i64 = py_round_half_even((end - begin) * TonePcm::RATE.f64())
            return 0 if frames < 1 or frames > capacity / TonePcm::FRAME_BYTES
            instruments: Instrument[7] = [bell(), growl(), flute(), glass(), brass(), pluck(), wood()]
            stereo: mutable darray[f64] = TonePcm::empty(frames)
            for i in 0..<run.notes.count.i64() |run, begin, end, stereo, frames, instruments|:
                cue: Stagehand::Cue = get run.notes[i.usize()] else zeroed
                instrument: Instrument = instruments[cue.voice.usize()]
                continue if cue.time >= end or cue.time + (cue.duration + instrument.patch.release) <= begin
                play_cue(&stereo, frames, begin, end, instrument, cue)
            return TonePcm::write(stereo, frames, dest)
