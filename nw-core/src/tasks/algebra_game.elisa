# Stateful controller for the source-backed Algebra task.
#
# Answers are parsed and graded by the exact source kernel.
module AlgebraGame:
    const TASK_ID: i64 = 4281979399
    const MAX_ASKED: i64 = 512
    const MAX_TYPED: i64 = 512
    const MAX_WORKING: i64 = 2048
    const PHASE_READY: i64 = 0
    const PHASE_WORKING: i64 = 1
    const PHASE_JUDGED: i64 = 2
    const PHASE_DONE: i64 = 3
    const ACTION_START: i64 = 0
    const ACTION_WRITE: i64 = 1
    const ACTION_BACKSPACE: i64 = 2
    const ACTION_SUBMIT: i64 = 3
    const ACTION_START_CLOCK: i64 = 4
    const INFO_PHASE: i64 = 0
    const INFO_LEVEL: i64 = 1
    const INFO_TRIAL: i64 = 2
    const INFO_TOTAL: i64 = 3
    const INFO_ASKED: i64 = 4
    const INFO_TYPED: i64 = 5
    const INFO_TYPED_LENGTH: i64 = 6
    const INFO_VERDICT: i64 = 7
    const INFO_RIGHT: i64 = 8
    const INFO_CANDIDATES: i64 = 9
    const VALUE_ASKED: i64 = 0
    const VALUE_TYPED: i64 = 1
    const VALUE_ANSWER: i64 = 2
    const INFO_ANSWER_LENGTH: i64 = 10
    const INFO_WORKING_LENGTH: i64 = 11
    const VALUE_WORKING: i64 = 3

    struct AlgebraRun:
        rng: mutable MT19937
        level: mutable i64
        start_level: mutable i64
        best_level: mutable i64
        answered: mutable i64
        total_ms: mutable i64
        started_ms: mutable i64
        clock_pending: mutable bool
        generation_failed: mutable bool
        show_working: mutable bool
        adaptive: mutable bool
        trials: mutable i64
        trial: mutable i64
        right: mutable i64
        phase: mutable i64
        verdict: mutable i64
        question_seed: mutable i64
        asked_n: mutable i64
        typed_n: mutable i64
        typed_value: mutable i64
        typed_negative: mutable bool
        wants: mutable i64
        candidates: mutable f64
        answer_n: mutable i64
        working_n: mutable i64
        working_text: mutable u8[MAX_WORKING]
        answer_text: mutable u8[MAX_ASKED]
        typed: mutable u8[MAX_TYPED]
        asked: mutable u8[MAX_ASKED]

    def allowed_level(value: i64) -> bool:
        return value >= 1 and value <= Algebra::GRADE_COUNT
    def allowed_trials(value: i64) -> bool:
        return value >= 1 and value <= 100

    def clear_text(run: mutable AlgebraRun&):
        can Abort.Panic:
            run.asked_n <- 0
            run.typed_n <- 0
            run.typed_value <- 0
            run.typed_negative <- false
            run.answer_n <- 0
            run.working_n <- 0
            run.candidates <- 0.0
            run.wants <- Algebra::WANT_NOTHING
            for at in 0..<MAX_ASKED |at, run|:
                run.asked[at.usize()] <- 0

    def generate(run: mutable AlgebraRun&, seed: i64) -> bool:
        can Memory.Allocate, Abort.Panic, Global.Read:
            made: mutable bool = false
            region generation(67108864):
                in generation:
                    problem: mutable Algebra::Problem = Algebra::new_problem()
                    grade: Algebra::AlgebraGrade = Algebra::grade_of(run.level)
                    rng: mutable MT19937 = mt19937_new()
                    mt_seed_int(&rng, seed.u64())
                    if Algebra::build_one(&problem, &grade, &rng):
                        problem.grade <- grade
                        problem.dealt <- true
                        run.wants <- problem.wants
                        run.working_n <- problem.working.count.i64() if problem.working.count.i64() < MAX_WORKING else MAX_WORKING
                        for at in 0..<run.working_n |at, run, problem|:
                            run.working_text[at.usize()] <- Bytes::at_ref(&problem.working, at)
                        answer: mutable darray[u8] = Bytes::zeros(MAX_ASKED)
                        run.answer_n <- Q::to_text(&problem.answer, &answer) if problem.answer_kind == Algebra::NUMBER else Expressions::render(&problem.answer_poly, &answer)
                        for at in 0..<run.answer_n |at, run, answer|:
                            run.answer_text[at.usize()] <- Bytes::at_ref(&answer, at)
                        space: mutable darray[u8] = Bytes::zeros(MAX_ASKED)
                        digits: i64 = Big::to_text(&problem.space, &space)
                        leading: mutable f64 = 0.0
                        count: i64 = digits if digits < 15 else 15
                        for at in 0..<count |at, space, leading|:
                            leading <- leading * 10.0 + (Bytes::at_ref(&space, at).i64() - 48).f64()
                        run.candidates <- log10(leading) + (digits - count).f64() if leading > 0.0 else 0.0
                        run.asked_n <- problem.asked_n if problem.asked_n < MAX_ASKED else MAX_ASKED
                        for at in 0..<MAX_ASKED |at, run, problem|:
                            run.asked[at.usize()] <- Bytes::at_ref(&problem.asked, at) if at < run.asked_n
                        made <- run.asked_n > 0
                    destroy generation
            return made

    def next_trial(run: mutable AlgebraRun&, seed: i64, now_ms: i64):
        can Memory.Allocate, Abort.Panic, Global.Read:
            if run.trial >= run.trials:
                run.phase <- PHASE_DONE
                return
            run.trial <- run.trial + 1
            clear_text(run)
            run.verdict <- -1
            run.question_seed <- seed
            run.generation_failed <- not generate(run, seed)
            run.phase <- PHASE_DONE if run.generation_failed else PHASE_WORKING
            if not run.generation_failed:
                run.started_ms <- now_ms
                run.clock_pending <- true

    def initialize(run: mutable AlgebraRun&, level: i64, trials: i64, seed: i64):
        can Abort.Panic:
            run.rng <- mt19937_new()
            mt_seed_int(&run.rng, seed.u64())
            run.level <- level
            run.start_level <- level
            run.best_level <- 0
            run.answered <- 0
            run.total_ms <- 0
            run.started_ms <- 0
            run.clock_pending <- false
            run.generation_failed <- false
            run.show_working <- true
            run.adaptive <- false
            run.trials <- trials
            run.trial <- 0
            run.right <- 0
            run.phase <- PHASE_READY
            run.verdict <- -1
            run.question_seed <- 0
            clear_text(run)

    def configure(run: mutable AlgebraRun&, show_working: bool, adaptive: bool):
        run.show_working <- show_working
        run.adaptive <- adaptive

    def write(run: mutable AlgebraRun&, code: i64) -> i64:
        can Abort.Panic:
            return 2 if run.phase != PHASE_WORKING or run.typed_n >= MAX_TYPED
            letter: i64 = code + 32 if code == 88 or code == 89 else code
            allowed: bool = (letter >= 48 and letter <= 57) or letter == 120 or letter == 121 or letter == 32 or code == 40 or code == 41 or code == 42 or code == 43 or code == 45 or code == 47 or code == 94
            return 2 if not allowed
            return 2 if code == 32 and (run.typed_n == 0 or run.typed[(run.typed_n - 1).usize()] == 32.u8())
            run.typed[run.typed_n.usize()] <- letter.u8()
            run.typed_n <- run.typed_n + 1
            return 1

    def erase(run: mutable AlgebraRun&) -> i64:
        can Abort.Panic:
            return 2 if run.phase != PHASE_WORKING or run.typed_n == 0
            run.typed_n <- run.typed_n - 1
            return 1

    def grade_answer(run: mutable AlgebraRun&) -> bool:
        can Memory.Allocate, Abort.Panic, Global.Read:
            correct: mutable bool = false
            region grading(67108864):
                in grading:
                    problem: mutable Algebra::Problem = Algebra::new_problem()
                    grade: Algebra::AlgebraGrade = Algebra::grade_of(run.level)
                    rng: mutable MT19937 = mt19937_new()
                    mt_seed_int(&rng, run.question_seed.u64())
                    if Algebra::build_one(&problem, &grade, &rng):
                        problem.grade <- grade
                        problem.dealt <- true
                        typed: mutable darray[u8] = Bytes::zeros(MAX_TYPED)
                        for at in 0..<run.typed_n |at, run, typed|:
                            Bytes::put(&typed, at, run.typed[at.usize()])
                        reader: mutable Expressions::Reader = Expressions::new_reader()
                        work: mutable Expressions::Poly = Expressions::zero()
                        correct <- Algebra::correct(&problem, &typed, run.typed_n, &reader, &work)
                    destroy grading
            return correct

    def apply(run: mutable AlgebraRun&, action: i64, value: i64, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Global.Read:
            if action == ACTION_START_CLOCK:
                return 2 if run.phase != PHASE_WORKING or not run.clock_pending or now_ms < 0
                run.started_ms <- now_ms
                run.clock_pending <- false
                return 1
            run.clock_pending <- false
            if action == ACTION_START:
                return 2 if run.phase == PHASE_WORKING
                if run.phase == PHASE_JUDGED and run.trial >= run.trials:
                    run.phase <- PHASE_DONE
                    return 1
                if run.phase == PHASE_DONE:
                    run.trial <- 0
                    run.right <- 0
                    run.level <- run.start_level
                    run.best_level <- 0
                    run.answered <- 0
                    run.total_ms <- 0
                    run.generation_failed <- false
                next_trial(run, py_randrange(&run.rng, 0, 1073741824), now_ms)
                return 1
            if action == ACTION_WRITE: return write(run, value)
            if action == ACTION_BACKSPACE: return erase(run)
            if action == ACTION_SUBMIT:
                return 2 if run.phase != PHASE_WORKING or run.typed_n == 0
                run.verdict <- 1 if grade_answer(run) else 0
                run.answered <- run.answered + 1
                elapsed: i64 = now_ms - run.started_ms if now_ms >= run.started_ms else 0
                run.total_ms <- run.total_ms + elapsed if elapsed <= 9223372036854775807 - run.total_ms else 9223372036854775807
                run.right <- run.right + 1 if run.verdict == 1 else run.right
                run.best_level <- run.level if run.verdict == 1 and run.level > run.best_level else run.best_level
                if run.adaptive:
                    if run.verdict == 1 and run.level < Algebra::GRADE_COUNT: run.level <- run.level + 1
                    elif run.verdict == 0 and run.level > 1: run.level <- run.level - 1
                run.phase <- PHASE_JUDGED
                return 1
            return 2

    # Legacy numeric snapshot: expression text is available through VALUE_TYPED.
    def numeric_text(run: AlgebraRun&) -> i64:
        can Abort.Panic:
            result: mutable i64 = 0
            negative: mutable bool = false
            for at in 0..<run.typed_n |at, run, result, negative|:
                code: i64 = run.typed[at.usize()].i64()
                if at == 0 and code == 45:
                    negative <- true
                    continue
                return 0 if code < 48 or code > 57
                digit: i64 = code - 48
                return 0 if result > 922337203685477580 or (result == 922337203685477580 and digit > 7)
                result <- result * 10 + digit
            return 0 - result if negative else result

    def info(run: AlgebraRun&, field: i64) -> i64:
        can Abort.Panic:
            if field == INFO_PHASE: return run.phase
            if field == INFO_LEVEL: return run.level
            if field == INFO_TRIAL: return run.trial
            if field == INFO_TOTAL: return run.trials
            if field == INFO_ASKED: return run.asked_n
            if field == INFO_TYPED: return numeric_text(run)
            if field == INFO_TYPED_LENGTH: return run.typed_n
            if field == INFO_VERDICT: return run.verdict
            if field == INFO_RIGHT: return run.right
            if field == INFO_CANDIDATES: return (run.candidates * 1000.0).i64()
            if field == INFO_ANSWER_LENGTH: return run.answer_n if run.phase == PHASE_JUDGED else 0
            if field == INFO_WORKING_LENGTH: return run.working_n if run.phase == PHASE_JUDGED and run.show_working else 0
            if field == 12: return 1 if run.show_working else 0
            if field == 13: return 1 if run.adaptive else 0
            if field == 14: return run.best_level
            if field == 15: return run.answered
            if field == 16: return run.total_ms / 1000
            return -1


    def value(run: AlgebraRun&, field: i64, at: i64) -> i64:
        return -1 if at < 0
        if field == VALUE_ASKED: return -1 if at >= run.asked_n else run.asked[at.usize()].i64()
        if field == VALUE_TYPED: return -1 if at >= run.typed_n else run.typed[at.usize()].i64()
        if field == VALUE_ANSWER: return -1 if run.phase != PHASE_JUDGED or at >= run.answer_n else run.answer_text[at.usize()].i64()
        if field == VALUE_WORKING: return -1 if run.phase != PHASE_JUDGED or not run.show_working or at >= run.working_n else run.working_text[at.usize()].i64()
        return -1

    def append_text(out: mutable dstr&, run: AlgebraRun&):
        can Memory.Allocate, Abort.Panic:
            for at in 0..<run.asked_n |at, out, run|:
                out.push(run.asked[at.usize()])

    def render(run: AlgebraRun&, black: bool, width: f64, height: f64, list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            asked: mutable dstr = []
            typed: mutable dstr = []
            working: mutable dstr = []
            if run.phase == PHASE_JUDGED:
                for at in 0..<run.working_n |at, working, run|:
                    working.push(run.working_text[at.usize()])
            if run.phase == PHASE_WORKING or run.phase == PHASE_JUDGED:
                append_text(&asked, run)
                for at in 0..<run.typed_n |at, typed, run|:
                    typed.push(run.typed[at.usize()])
            message: mutable dstr = []
            if run.phase == PHASE_READY: dstr_append_cstr(&message, "Press Space to start")
            elif run.phase == PHASE_JUDGED:
                if run.verdict == 1: dstr_append_cstr(&message, "Right")
                else:
                    dstr_append_cstr(&message, "No - it was ")
                    for at in 0..<run.answer_n |at, message, run|:
                        message.push(run.answer_text[at.usize()])
            elif run.phase == PHASE_DONE:
                if run.generation_failed: dstr_append_cstr(&message, "No problem could be built at this level")
                else:
                    dstr_append_i64(&message, run.right)
                    dstr_append_cstr(&message, " of ")
                    dstr_append_i64(&message, run.answered)
                    dstr_append_cstr(&message, " right, highest level ")
                    dstr_append_i64(&message, run.best_level)
            else:
                name: cstr = "one and one" if run.level == 1 else "take away" if run.level == 2 else "times before plus" if run.level == 3 else "below zero" if run.level == 4 else "exact halves" if run.level == 5 else "find the letter" if run.level == 6 else "open the brackets" if run.level == 7 else "clock arithmetic" if run.level == 8 else "collect the powers" if run.level == 9 else "three clocks at once" if run.level == 10 else "two letters, cubed" if run.level == 11 else "six clocks at once"
                dstr_append_cstr(&message, name)
            wants: mutable sview = sview("", 0, -1)
            if run.wants == Algebra::WANT_X: wants <- sview("x = ?", 0, -1)
            elif run.wants == Algebra::WANT_SMALLEST_X: wants <- sview("smallest x >= 0", 0, -1)
            elif run.wants == Algebra::WANT_SMALLEST_N: wants <- sview("smallest n >= 0", 0, -1)
            elif run.wants == Algebra::WANT_EXPAND: wants <- sview("expand and collect", 0, -1)
            sx: f64 = width / Display::REFERENCE_WIDTH
            sy: f64 = height / Display::REFERENCE_HEIGHT
            paint: SceneAlgebra::AlgebraPaint = SceneAlgebra::paint_of(black, width, height, sx, sy)
            SceneAlgebra::render(list, &paint, run.phase, run.asked_n > 0,
                                 bytes_view(asked), wants,
                                 bytes_view(working), bytes_view(typed), run.candidates,
                                 run.phase == PHASE_JUDGED and run.show_working, run.trial, run.trials,
                                 bytes_view(message))
