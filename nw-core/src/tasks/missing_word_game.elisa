include "./missing_word_run.elisa"

module MissingWordGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = MissingWord::PORTS
    const FEEDBACK: f64 = 4.0
    const NEUTRAL: i64 = -1

    struct Corpus:
        sentences: Passages::Bank
        passages: Passages::Bank
        pairs: Passages::Index
        known: Passages::Index
        sources: MissingWord::Sources
        vocabulary: MissingWord::Vocabulary

    def cache_corpus(passage_text: sview, sentence_text: sview, lexicon_text: sview) -> Corpus:
        can Memory.Allocate, Abort.Panic:
            passages: Passages::Bank = Passages::read(passage_text, true) if sview_len(passage_text) > 4096.usize() else PassageSeed::passages()
            sentences: Passages::Bank = Passages::read(sentence_text, false) if sview_len(sentence_text) > 4096.usize() else PassageSeed::sentences()
            ranked: MissingWord::Vocabulary = MissingWord::vocabulary(lexicon_text)
            words: mutable darray[Passages::Word] = []
            _ = words.reserve(ranked.ordered.count)
            for entry in ranked.ordered:
                words.push(entry.word)
            rows: mutable darray[Passages::Row] = []
            rows.push(Passages::Row{start: 0, stop: words.count.i64()})
            bank: Passages::Bank = Passages::Bank{words: words, sentences: rows, passages: []}
            known: Passages::Index = Passages::known(&bank)
            return Corpus{sentences: sentences, passages: passages, pairs: Passages::index(&sentences, &passages),
                known: known, sources: MissingWord::sources(&sentences, &passages, &known), vocabulary: ranked}

    struct Session:
        rng: mutable MT19937
        start_rung: mutable i64
        total: mutable i64
        adaptive: mutable bool
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        run: mutable MissingWord::Run
        last_tick: mutable f64
        deadline: mutable f64
        wins: mutable i64
        best_rung: mutable i64
        owner: mutable Arena
        unavailable: mutable bool

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Session:
        rng: mutable MT19937 = zeroed
        magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
        mt_seed_int(&rng, magnitude)
        initial: i64 = rung if rung > 0 else 1
        return Session{rng: rng, start_rung: initial, total: total, adaptive: adaptive,
            rung: initial, trial: 0, phase: READY, run: zeroed, last_tick: 0.0, deadline: 0.0,
            wins: 0, best_rung: 0, owner: zeroed, unavailable: false}

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 10 or total == 20

    def reconfigure(session: mutable Session&, rung: i64, total: i64, adaptive: bool) -> bool:
        can Memory.Release, Abort.Panic:
            return false if session.phase != READY and session.phase != DONE
            return false if not allowed_rung(rung) or not allowed_total(total)
            session.start_rung <- rung
            session.rung <- rung
            session.total <- total
            session.adaptive <- adaptive
            session.phase <- READY
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            release_missing_word_arena(&session.owner) can Global{Read,Write}
            session.run <- zeroed
            session.unavailable <- false
            return true

    def release_missing_word_arena(owner: mutable Arena&):
        can Memory.Release, Abort.Panic:
            arena_free(owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}

    def close(session: mutable Session&):
        can Memory.Release, Abort.Panic:
            release_missing_word_arena(&session.owner) can Global{Read,Write}
            session.run <- zeroed
            session.phase <- READY
            session.unavailable <- false

    def next_trial(session: mutable Session&, corpus: Corpus&, now: f64):
        can Memory.Allocate, Memory.Release, Abort.Panic:
            session.last_tick <- now
            if session.trial >= session.total:
                session.phase <- DONE
                return
            deal: MissingWord::Candidate = MissingWord::deal(MissingWord::grade(session.rung), &session.rng,
                &corpus.sources, &corpus.vocabulary, &corpus.sentences, &corpus.passages, &corpus.pairs, &corpus.known)
            release_missing_word_arena(&session.owner) can Global{Read,Write}
            session.unavailable <- not deal.valid
            if not deal.valid:
                session.run <- zeroed
                session.phase <- READY
                return
            owner: mutable Arena& = &session.owner
            in owner:
                session.run <- MissingWord::start(deal.machine)
            session.trial <- session.trial + 1
            session.phase <- PLAYING

    def valid_time(session: Session&, now: f64) -> bool:
        return now >= session.last_tick and now <= 9007199254740.0

    def start(session: mutable Session&, corpus: Corpus&, now: f64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if not valid_time(session, now)
            return false if session.total <= 0 or (session.phase != READY and session.phase != DONE)
            session.rung <- session.start_rung
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            next_trial(session, corpus, now) can Global{Read,Write}
            return session.phase == PLAYING

    def input(session: mutable Session&, corpus: Corpus&, port: i64) -> bool:
        can Memory.Allocate, Abort.Panic:
            return false if session.phase != PLAYING or port < 0 or port >= MissingWord::PORTS
            owner: mutable Arena& = &session.owner
            MissingWord::reserve_input(&session.run, owner, port) can Global{Read,Write}
            in owner:
                MissingWord::act(&session.run, &corpus.sources, &corpus.vocabulary, port)
            return true

    def clear_controls(session: mutable Session&) -> bool:
        changed: bool = session.run.hand.down
        session.run.hand.down <- false
        return changed

    # Reference framebuffer coordinates, bottom-left origin. Kind 0 moves,
    # 1 presses or starts a run, and 2 releases the left button.
    def pointer(session: mutable Session&, corpus: Corpus&, x: f64, y: f64, kind: i64, now: f64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            if kind == 1 and (session.phase == READY or session.phase == DONE):
                return start(session, corpus, now) can Global{Read,Write}
            return false if session.phase != PLAYING or kind < 0 or kind > 2
            HandView::place(&session.run.hand, (x - HandView::VIEW_LEFT) / HandView::VIEW_SCALE,
                (y - HandView::VIEW_BOTTOM) / HandView::VIEW_SCALE)
            if kind != 0:
                _ = input(session, corpus, HandView::PRESS if kind == 1 else HandView::RELEASE) can Global{Read,Write}
            return true

    def judge(session: mutable Session&, now: f64):
        passed: bool = session.run.result == MissingWord::MENDED
        if passed:
            session.wins <- session.wins + 1
            session.best_rung <- session.rung if session.rung > session.best_rung
        if session.adaptive:
            session.rung <- session.rung + 1 if passed and session.rung < 9223372036854775807
            session.rung <- session.rung - 1 if not passed and session.rung > 1
        session.deadline <- now + FEEDBACK
        session.phase <- JUDGED

    def advance(session: mutable Session&, corpus: Corpus&, now: f64, stepped: bool = false) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if not valid_time(session, now)
            if session.phase == JUDGED:
                return false if not stepped and now < session.deadline
                next_trial(session, corpus, now) can Global{Read,Write}
                return true
            return false if session.phase != PLAYING
            dt: f64 = fmin(0.1, now - session.last_tick)
            session.last_tick <- now
            steps: i64 = fmax(1.0, ceil(dt / (1.0 / 120.0))).i64()
            quantum: f64 = dt / steps.f64()
            for _ in 0..<steps |session, quantum|:
                MissingWord::step(&session.run, quantum)
                break if session.run.result != MissingWord::LIVE
            if session.run.result != MissingWord::LIVE:
                judge(session, now)
            return true

    def agent_event(session: mutable Session&, corpus: Corpus&, now: f64, port: i64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if not valid_time(session, now)
            return (start(session, corpus, now) can Global{Read,Write}) if port == START
            return (advance(session, corpus, now, true) can Global{Read,Write}) if port == NEUTRAL
            return input(session, corpus, port) can Global{Read,Write}

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return session.wins if field == 4
            return session.best_rung if field == 5
            return session.start_rung if field == 6
            return (1 if session.adaptive else 0) if field == 7
            return session.run.result if field == 8
            return py_round_half_even(session.run.t * 1000.0) if field == 9
            return (1 if session.unavailable else 0) if field == 10
            return session.run.machine.count if field == 11
            return -1
