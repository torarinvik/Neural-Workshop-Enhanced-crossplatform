include "./falls.elisa"

module FallsGame:
    const READY: i64 = 0
    const CHOOSING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const FLAGGED: i64 = 4
    const FEEDBACK_MS: i64 = 2800
    const MAX_TRIALS: i64 = 40

    struct Result:
        rung: i64
        passed: bool

    struct Run:
        rng: mutable MT19937
        start_rung: i64
        total: i64
        adaptive: bool
        rung: mutable i64
        phase: mutable i64
        trial: mutable i64
        started_ms: mutable i64
        deadline_ms: mutable i64
        puzzle: mutable Falls::Puzzle
        chosen: mutable i64
        scored: mutable i64
        passed: mutable i64
        best: mutable i64
        results: mutable Result[MAX_TRIALS]
        think_capacity: mutable f64
        think_refill: mutable f64
        think_left: mutable f64
        forfeits: mutable i64
        verdict_published: mutable bool

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 8 or rung == 12 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 5 or total == 10 or total == 20 or total == 40

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Run:
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
            return Run{rng: rng, start_rung: rung, total: total, adaptive: adaptive, rung: rung,
                phase: READY, trial: 0, started_ms: 0, deadline_ms: 0, puzzle: zeroed,
                chosen: -1, scored: 0, passed: 0, best: 0, results: zeroed,
                think_capacity: 0.0, think_refill: 0.0, think_left: 0.0, forfeits: 0, verdict_published: false}

    def next_trial(run: mutable Run&, now_ms: i64) -> bool:
        can Abort.Panic:
            run.chosen <- -1
            run.verdict_published <- false
            if run.trial >= run.total:
                run.phase <- DONE
                run.puzzle <- zeroed
                return true
            seed: i64 = py_randbelow(&run.rng, 1073741824.u64()).i64()
            run.puzzle <- Falls::deal(run.rung, seed)
            if run.puzzle.choices == 0:
                run.phase <- READY
                return false
            run.trial <- run.trial + 1
            run.started_ms <- now_ms
            run.phase <- CHOOSING
            return true

    def start(run: mutable Run&, now_ms: i64) -> bool:
        can Abort.Panic:
            return false if (run.phase != READY and run.phase != DONE) or now_ms < 0
            return false if run.total < 1 or run.total > MAX_TRIALS
            run.rung <- run.start_rung if run.start_rung > 0 else 1
            run.trial <- 0
            run.scored <- 0
            run.passed <- 0
            run.best <- 0
            run.think_left <- run.think_capacity
            run.forfeits <- 0
            return next_trial(run, now_ms)

    def choose(run: mutable Run&, index: i64, now_ms: i64) -> bool:
        can Abort.Panic:
            return false if run.phase != CHOOSING or index < 0 or index >= run.puzzle.choices
            return false if now_ms < run.started_ms or now_ms > 9223372036854775807 - FEEDBACK_MS
            passed: bool = index == run.puzzle.answer
            run.results[run.scored.usize()] <- Result{rung: run.rung, passed: passed}
            run.scored <- run.scored + 1
            if passed:
                run.passed <- run.passed + 1
                run.best <- run.rung if run.rung > run.best
            if run.adaptive:
                run.rung <- run.rung + 1 if passed and run.rung < 9223372036854775807
                run.rung <- run.rung - 1 if not passed and run.rung > 1
            run.chosen <- index
            run.deadline_ms <- now_ms + FEEDBACK_MS
            run.phase <- JUDGED
            return true

    def advance(run: mutable Run&, now_ms: i64) -> bool:
        can Abort.Panic:
            return false if run.phase != JUDGED or now_ms < run.deadline_ms
            return next_trial(run, now_ms)


    def configure_think(run: mutable Run&, capacity: f64, refill: f64) -> bool:
        return false if run.phase != READY or not (capacity >= 0.0 and capacity <= 1.7976931348623157e308)
        return false if not (refill >= 0.0 and refill <= 1.7976931348623157e308)
        run.think_capacity <- capacity
        run.think_refill <- refill if refill < capacity else capacity
        run.think_left <- capacity
        return true

    def step(run: mutable Run&, elapsed_seconds: f64) -> bool:
        can Abort.Panic:
            return false if not (elapsed_seconds > 0.0 and elapsed_seconds <= 1.7976931348623157e308)
            if run.phase == CHOOSING:
                if run.think_capacity > 0.0:
                    run.think_left <- run.think_left - elapsed_seconds
                    if run.think_left <= 0.000000001:
                        run.think_left <- 0.0
                        run.forfeits <- run.forfeits + 1
                        run.phase <- FLAGGED
                return true
            if run.phase == JUDGED and not run.verdict_published:
                run.verdict_published <- true
                return true
            if run.phase == JUDGED or run.phase == FLAGGED:
                # Stepped input carries its own monotonic time from zero.
                _ = next_trial(run, 0)
                if run.phase == CHOOSING:
                    room: f64 = run.think_capacity - run.think_left
                    run.think_left <- run.think_left + (run.think_refill if run.think_refill < room else room)
                return true
            return false
