# Stateful controller for the Count task.
#
# Counting owns deterministic shape generation; this controller owns the
# persistent run RNG, generated round, typed answer, timing, adaptation,
# verdict, and result summary. The fixed Run record deliberately contains no
# region-backed containers so it can safely live behind a common-API handle.

module CountingGame:

    const PHASE_READY: i64 = 0
    const PHASE_SHOWING: i64 = 1
    const PHASE_HIDDEN: i64 = 2
    const PHASE_FEEDBACK: i64 = 3
    const PHASE_DONE: i64 = 4

    const ACTION_START: i64 = 0
    const ACTION_DIGIT: i64 = 1
    const ACTION_BACKSPACE: i64 = 2
    const ACTION_SUBMIT: i64 = 3

    const INFO_PHASE: i64 = 0
    const INFO_KIND: i64 = 1
    const INFO_COUNT: i64 = 2
    const INFO_TRIAL: i64 = 3
    const INFO_TOTAL_TRIALS: i64 = 4
    const INFO_CORRECT: i64 = 5
    const INFO_ANSWER: i64 = 6
    const INFO_ANSWER_LENGTH: i64 = 7
    const INFO_SHOWN_COUNT: i64 = 8
    const INFO_VERDICT: i64 = 9
    const INFO_ADAPTIVE: i64 = 10
    const INFO_DEADLINE_MS: i64 = 11
    const INFO_SHOW_ANSWER: i64 = 12
    const INFO_EXPOSURE_MS: i64 = 13
    const INFO_TOTAL_ERROR: i64 = 14
    const INFO_SHAPE_COUNT: i64 = 15

    struct CountingRun:
        rng: mutable MT19937
        shapes: mutable Counting::CountShape[60]
        shape_count: mutable i64
        kind: mutable i64
        start_count: mutable i64
        total_trials: mutable i64
        exposure_ms: mutable i64
        adaptive: mutable bool
        show_answer: mutable bool
        count: mutable i64
        shown_count: mutable i64
        trial: mutable i64
        correct: mutable i64
        total_error: mutable i64
        answer: mutable i64
        answer_length: mutable i64
        phase: mutable i64
        verdict: mutable i64
        shown_at_ms: mutable i64
        deadline_ms: mutable i64

    def allowed_start_count(value: i64) -> bool:
        can Abort.Panic:
            return value == 2 or value == 4 or value == 6 or value == 8 or value == 10 or value == 12 or value == 16 or value == 20 or value == 25 or value == 30 or value == 40 or value == 50 or value == 60

    def allowed_trials(value: i64) -> bool:
        can Abort.Panic:
            return value == 5 or value == 10 or value == 15 or value == 20 or value == 30 or value == 50 or value == 80 or value == 100

    def allowed_exposure(value: i64) -> bool:
        can Abort.Panic:
            return value == 0 or value == 200 or value == 350 or value == 500 or value == 750 or value == 1000 or value == 2000 or value == 4000

    def initialize(run: mutable CountingRun&, kind: i64, start_count: i64,
                   total_trials: i64, exposure_ms: i64, adaptive: bool,
                   show_answer: bool, seed: i64):
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            run.rng <- rng
            run.shape_count <- 0
            run.kind <- kind
            run.start_count <- start_count
            run.total_trials <- total_trials
            run.exposure_ms <- exposure_ms
            run.adaptive <- adaptive
            run.show_answer <- show_answer
            run.count <- start_count
            run.shown_count <- 0
            run.trial <- 0
            run.correct <- 0
            run.total_error <- 0
            run.answer <- 0
            run.answer_length <- 0
            run.phase <- PHASE_READY
            run.verdict <- -1
            run.shown_at_ms <- 0
            run.deadline_ms <- 0

    # Deal in the same order as Counting::generate: for MIXED, choose the
    # shape kind first, then consume that shape generator's exact CPython RNG
    # draws. Copying into the fixed controller array lets the run survive the
    # temporary render/deal arena without retaining its allocation.
    def deal(run: mutable CountingRun&):
        can Abort.Panic:
            run.shape_count <- 0
            for index in 0..<run.shown_count |index, run|:
                drawn_kind: i64 = py_choice_index(&run.rng, 4.u64()).i64() if run.kind == Counting::MIXED else run.kind
                shape: Counting::CountShape = Counting::random_shape(drawn_kind, &run.rng)
                run.shapes[index.usize()] <- shape
                run.shape_count <- run.shape_count + 1

    def next_trial(run: mutable CountingRun&, now_ms: i64):
        can Abort.Panic:
            if run.trial >= run.total_trials:
                run.phase <- PHASE_DONE
                run.shape_count <- 0
                run.deadline_ms <- 0
                return
            run.trial <- run.trial + 1
            run.answer <- 0
            run.answer_length <- 0
            run.shown_count <- run.count
            run.verdict <- -1
            run.shown_at_ms <- now_ms
            run.deadline_ms <- now_ms + run.exposure_ms
            run.phase <- PHASE_SHOWING
            deal(run)

    def start(run: mutable CountingRun&, now_ms: i64):
        can Abort.Panic:
            run.shape_count <- 0
            run.count <- run.start_count
            run.trial <- 0
            run.correct <- 0
            run.total_error <- 0
            run.answer <- 0
            run.answer_length <- 0
            run.phase <- PHASE_READY
            run.verdict <- -1
            run.deadline_ms <- 0
            next_trial(run, now_ms)

    def type_digit(run: mutable CountingRun&, digit: i64):
        can Abort.Panic:
            return if run.phase != PHASE_SHOWING and run.phase != PHASE_HIDDEN
            return if digit < 0 or digit > 9 or run.answer_length >= 3
            # Python appends then lstrips zeroes, retaining one zero when the
            # answer consists only of zeroes. This matters for 0, 01, and
            # repeated leading-zero edits even though legal counts start at 2.
            if run.answer_length == 0:
                run.answer <- digit
                run.answer_length <- 1
            elif run.answer == 0:
                run.answer <- digit
                run.answer_length <- 1
            else:
                run.answer <- run.answer * 10 + digit
                run.answer_length <- run.answer_length + 1

    def backspace(run: mutable CountingRun&):
        can Abort.Panic:
            return if run.answer_length <= 0
            run.answer <- run.answer / 10
            run.answer_length <- run.answer_length - 1
            if run.answer_length == 0:
                run.answer <- 0

    def submit_answer(run: mutable CountingRun&, now_ms: i64) -> i64:
        can Abort.Panic:
            return 2 if run.phase != PHASE_SHOWING and run.phase != PHASE_HIDDEN
            return 2 if run.answer_length == 0
            correct: bool = run.answer == run.shown_count
            run.verdict <- 1 if correct else 0
            if correct:
                run.correct <- run.correct + 1
            delta: i64 = run.shown_count - run.answer if correct else run.answer - run.shown_count
            run.total_error <- run.total_error + (delta if delta >= 0 else -delta)
            if run.adaptive:
                if correct:
                    run.count <- Counting::clamp_shapes(run.count + 1)
                else:
                    run.count <- Counting::clamp_shapes(run.count - 1)
            if run.show_answer:
                run.phase <- PHASE_FEEDBACK
                run.deadline_ms <- now_ms + 800
            else:
                # The reference immediately deals the next tangle when answer
                # feedback is disabled; no transient verdict is rendered.
                next_trial(run, now_ms)
            return 1

    def apply(run: mutable CountingRun&, action: i64, value: i64,
              now_ms: i64) -> i64:
        can Abort.Panic:
            if action == ACTION_START:
                return 2 if run.phase != PHASE_READY and run.phase != PHASE_DONE
                start(run, now_ms)
                return 1
            elif action == ACTION_DIGIT:
                return 2 if value < 0 or value > 9
                return 2 if run.phase != PHASE_SHOWING and run.phase != PHASE_HIDDEN
                return 2 if run.answer_length >= 3 and not (run.answer_length == 1 and run.answer == 0)
                type_digit(run, value)
                return 1
            elif action == ACTION_BACKSPACE:
                return 2 if run.answer_length == 0
                backspace(run)
                return 1
            elif action == ACTION_SUBMIT:
                return submit_answer(run, now_ms)
            return -6

    def advance(run: mutable CountingRun&, now_ms: i64) -> i64:
        can Abort.Panic:
            if run.phase == PHASE_SHOWING and run.exposure_ms > 0 and now_ms >= run.deadline_ms:
                run.phase <- PHASE_HIDDEN
                return 1
            elif run.phase == PHASE_FEEDBACK and now_ms >= run.deadline_ms:
                next_trial(run, now_ms)
                return 1
            return 2

    def info(run: CountingRun&, field: i64) -> i64:
        can Abort.Panic:
            if field == INFO_PHASE: return run.phase
            elif field == INFO_KIND: return run.kind
            elif field == INFO_COUNT: return run.count
            elif field == INFO_TRIAL: return run.trial
            elif field == INFO_TOTAL_TRIALS: return run.total_trials
            elif field == INFO_CORRECT: return run.correct
            elif field == INFO_ANSWER: return run.answer
            elif field == INFO_ANSWER_LENGTH: return run.answer_length
            elif field == INFO_SHOWN_COUNT: return run.shown_count
            elif field == INFO_VERDICT: return run.verdict
            elif field == INFO_ADAPTIVE: return 1 if run.adaptive else 0
            elif field == INFO_DEADLINE_MS: return run.deadline_ms
            elif field == INFO_SHOW_ANSWER: return 1 if run.show_answer else 0
            elif field == INFO_EXPOSURE_MS: return run.exposure_ms
            elif field == INFO_TOTAL_ERROR: return run.total_error
            elif field == INFO_SHAPE_COUNT: return run.shape_count
            return -1

    def append_feedback_text(out: mutable dstr&, run: CountingRun&):
        can Memory.Allocate, Abort.Panic:
            if run.verdict == 1:
                dstr_append_cstr(out, "Yes, ")
                dstr_append_i64(out, run.count)
            else:
                # Preserve the source UI's ordering: it adapts `count` before
                # composing this feedback label. Consequently the displayed
                # number is the next rung when adaptive mode is enabled.
                # This source quirk is intentionally retained for parity.
                dstr_append_cstr(out, "No — there were ")
                dstr_append_i64(out, run.count)

    def append_done_text(out: mutable dstr&, run: CountingRun&):
        can Memory.Allocate, Abort.Panic:
            accuracy: i64 = py_round_half_even(100.0 * run.correct.f64() / run.total_trials.f64())
            mean_tenths: i64 = py_round_half_even(10.0 * run.total_error.f64() / run.total_trials.f64())
            dstr_append_i64(out, accuracy)
            dstr_append_cstr(out, "% — ")
            dstr_append_i64(out, run.correct)
            dstr_append_cstr(out, " of ")
            dstr_append_i64(out, run.total_trials)
            dstr_append_cstr(out, ", average error ")
            dstr_append_i64(out, mean_tenths / 10)
            dstr_append_cstr(out, ".")
            dstr_append_i64(out, mean_tenths % 10)

    def render(run: CountingRun&, black_background: bool, width: f64,
               height: f64, list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            shapes: mutable darray[SceneCounting::CountRenderShape] = []
            for index in 0..<run.shape_count |index, run, shapes|:
                source: Counting::CountShape = run.shapes[index.usize()]
                shape: SceneCounting::CountRenderShape = SceneCounting::CountRenderShape{
                    kind: source.kind,
                    x1: source.x[0], y1: source.y[0],
                    x2: source.x[1], y2: source.y[1],
                    x3: source.x[2], y3: source.y[2],
                    radius: source.radius,
                }
                shapes.push(shape)
            paint: mutable SceneCounting::CountPaint = SceneCounting::paint_of(
                black_background, width, height, 1.0, 1.0)
            typed: mutable dstr = []
            if run.answer_length > 0:
                dstr_append_i64(&typed, run.answer)
            message: mutable dstr = []
            if run.phase == PHASE_READY:
                dstr_append_cstr(&message, "Press Space to start")
            elif run.phase == PHASE_SHOWING or run.phase == PHASE_HIDDEN:
                dstr_append_cstr(&message, "How many?")
            elif run.phase == PHASE_FEEDBACK:
                append_feedback_text(&message, run)
            else:
                append_done_text(&message, run)
            verdict_message: mutable dstr = []
            if run.verdict >= 0:
                append_feedback_text(&verdict_message, run)
            SceneCounting::render(list, &paint, run.phase, &shapes,
                bytes_view(typed), run.trial, run.total_trials, run.correct,
                bytes_view(message), run.verdict, bytes_view(verdict_message))
