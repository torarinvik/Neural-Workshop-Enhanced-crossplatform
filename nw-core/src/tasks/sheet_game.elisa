include "./sheet_text.elisa"
include "./browser_game.elisa"

module SheetGame:
    # ui/sheet.py on ui/browser.py and ui/rungtask.py: a run of questions
    # on a ladder, each judged when Submit takes an answer -- right, in no
    # more clicks than par.
    const READY: i64 = BrowserGame::READY
    const PLAYING: i64 = BrowserGame::PLAYING
    const JUDGED: i64 = BrowserGame::JUDGED
    const DONE: i64 = BrowserGame::DONE
    const FEEDBACK: f64 = BrowserGame::FEEDBACK
    const START: i64 = BrowserSession::PORTS

    # How a question ended.
    const LIVE: i64 = 0
    const RIGHT: i64 = 1
    const OVER_PAR: i64 = 2
    const WRONG: i64 = 3
    # How many fields info reports.
    const INFO_FIELDS: i64 = 16

    struct Ladder:
        start_rung: mutable i64
        total: mutable i64
        adaptive: mutable bool
        rung: mutable i64
        trial: mutable i64
        wins: mutable i64
        best_rung: mutable i64

    struct Session:
        rng: mutable MT19937
        ladder: mutable Ladder
        phase: mutable i64
        time: mutable f64
        deadline: mutable f64
        sheet: mutable Sheet::Workbook
        par: mutable i64
        verdict: mutable i64

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = zeroed
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            initial: i64 = rung if rung > 0 else 1
            ladder: Ladder = Ladder{start_rung: initial, total: trials, adaptive: adaptive, rung: initial, trial: 0, wins: 0,
                best_rung: 0}
            return Session{rng: rng, ladder: ladder, phase: READY, time: 0.0, deadline: 0.0, sheet: zeroed, par: 0,
                verdict: LIVE}

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 10 or total == 20

    def valid_time(session: Session&, now: f64) -> bool:
        return now >= session.time and now <= 9007199254740.0

    # _next_trial: the next question, or the end of the run.
    def next_trial(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            session.time <- now
            if session.ladder.trial >= session.ladder.total:
                session.phase <- DONE
                return true
            puzzle: Sheet::Puzzle = Sheet::deal(session.ladder.rung, &session.rng)
            session.sheet <- Sheet::start(puzzle)
            session.par <- Sheet::par(&session.sheet.puzzle)
            session.verdict <- LIVE
            session.ladder.trial <- session.ladder.trial + 1
            session.phase <- PLAYING
            return true

    def start(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if (session.phase != READY and session.phase != DONE) or session.ladder.total < 1
            return false if not valid_time(session, now)
            session.ladder.rung <- session.ladder.start_rung
            session.ladder.trial <- 0
            session.ladder.wins <- 0
            session.ladder.best_rung <- 0
            return next_trial(session, now)

    # _after: a submitted answer is judged; anything else waits.
    def after(session: mutable Session&, now: f64):
        can Abort.Panic:
            return if not session.sheet.submitted
            right: bool = session.sheet.answer == session.sheet.puzzle.answer
            passed: bool = right and session.sheet.clicks <= session.par
            session.verdict <- RIGHT if passed else (OVER_PAR if right else WRONG)
            ladder: mutable Ladder = session.ladder
            if passed:
                ladder.wins <- ladder.wins + 1
                ladder.best_rung <- ladder.rung if ladder.rung > ladder.best_rung
            if ladder.adaptive:
                ladder.rung <- ladder.rung + 1 if passed and ladder.rung < 9223372036854775807
                ladder.rung <- ladder.rung - 1 if not passed and ladder.rung > 1
            session.ladder <- ladder
            session.deadline <- now + FEEDBACK
            session.phase <- JUDGED

    # steer: one agent port.
    def steer(session: mutable Session&, port: i64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if session.phase != PLAYING or port < 0 or port >= BrowserSession::PORTS
            return false if not valid_time(session, now)
            session.time <- now
            Sheet::steer(&session.sheet, port)
            after(session, now)
            return true

    # A click at a display point, y up; outside the page it does nothing.
    def click(session: mutable Session&, x: f64, y: f64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if session.phase != PLAYING or not valid_time(session, now)
            at: BrowserGame::Frame = BrowserGame::frame()
            page_x: f64 = (x - at.left) / at.scale
            page_y: f64 = (at.top - y) / at.scale
            return false if page_x < 0.0 or page_x > Browser::SCREEN_W or page_y < 0.0 or page_y > Browser::SCREEN_H
            session.time <- now
            Sheet::click_at(&session.sheet, page_x, page_y)
            after(session, now)
            return true

    def press(session: mutable Session&, x: f64, y: f64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return start(session, now) if session.phase == READY or session.phase == DONE
            return click(session, x, y, now)

    def scroll(session: mutable Session&, way: i64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if session.phase != PLAYING
            Sheet::wheel(&session.sheet, way)
            return true

    # A keypad key from the keyboard: a digit 0-9, Sheet::DELETE for
    # Backspace, or -1 for Enter; each counts as a click.
    def type_key(session: mutable Session&, digit: i64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if session.phase != PLAYING or not valid_time(session, now)
            return false if digit < -1 or digit > Sheet::DELETE
            session.time <- now
            Sheet::press(&session.sheet, Sheet::action(Sheet::SUBMIT, 0) if digit == -1 else Sheet::action(Sheet::KEY, digit))
            after(session, now)
            return true

    # One agent event: START begins a run, -1 is a frame (it moves the
    # clock during a question and steps past a verdict), and anything else
    # is a port.
    def agent_input(session: mutable Session&, now: f64, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if not valid_time(session, now)
            return start(session, now) if port == START
            return steer(session, port, now) if port != -1
            return advance(session, now, true) if session.phase == JUDGED
            return false if session.phase != PLAYING
            session.time <- now
            return true

    def advance(session: mutable Session&, now: f64, stepped: bool = false) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if not valid_time(session, now)
            return false if session.phase != JUDGED
            return false if not stepped and now < session.deadline
            return next_trial(session, now)

    def reconfigure(session: mutable Session&, rung: i64, total: i64, adaptive: bool) -> bool:
        return false if session.phase != READY and session.phase != DONE
        return false if not allowed_rung(rung) or not allowed_total(total)
        session.ladder <- Ladder{start_rung: rung, total: total, adaptive: adaptive, rung: rung, trial: 0, wins: 0, best_rung: 0}
        session.phase <- READY
        return true

    def close(session: mutable Session&):
        session.phase <- READY
        session.sheet <- zeroed

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            return session.phase if field == 0
            return session.ladder.rung if field == 1
            return session.ladder.trial if field == 2
            return session.ladder.total if field == 3
            return session.ladder.wins if field == 4
            return session.ladder.best_rung if field == 5
            return session.ladder.start_rung if field == 6
            return (1 if session.ladder.adaptive else 0) if field == 7
            return session.verdict if field == 8
            return session.sheet.clicks if field == 9
            return session.par if field == 10
            return Sheet::typed_value(&session.sheet) if field == 11
            return session.sheet.typed_count if field == 12
            return py_round_half_even(session.sheet.pointer.x) if field == 13
            return py_round_half_even(session.sheet.pointer.y) if field == 14
            return session.sheet.scroll if field == 15
            return -1
