# Mr. Time: how long ago was that, and can you do it again on cue?
#
# Port of the portable half of neural_workshop/ui/mrtime.py
# (GPL-2.0-or-later).
#
# Two halves that are not the same skill. RECALL asks how long ago the shape
# appeared, answered by typing; PRODUCE shows a duration and asks for it to be
# clicked when that much time has gone by. `both` SHUFFLES the two rather than
# alternating -- alternating would be a pattern to learn instead of a task to
# do, since a player who knows the next one is a production trial has already
# started counting when the shape lands.
#
# The ladder is precision: every rung asks the same question and marks it
# harder, and what changes is the band an answer has to land in. The band is a
# SHARE of the interval rather than a fixed number of milliseconds, because
# human interval timing obeys Weber's law -- the spread of repeated estimates
# grows roughly in proportion to what is being timed -- so a fixed band would
# make a half-second trial and an eight-second trial two different tasks.
#
# The typed answer is parsed EXACTLY. The field holds at most twelve
# characters, so the value is an integer of at most eleven digits over a power
# of ten of at most eleven -- both under 2^53, so the single f64 division is
# the correctly-rounded result of the exact quotient, which is what CPython's
# `float(text)` gives.
#
extern ceil(x: f64) -> f64

module MrTime:

    const MIN_RUNG: i64 = 1
    const MAX_RUNG: i64 = 6

    const KIND_COUNT: i64 = 6

    const MODE_RECALL: i64 = 0
    const MODE_PRODUCE: i64 = 1
    const MODE_BOTH: i64 = 2

    # Shortest duration the produce half will ever ask for. A target of nothing
    # is not a duration to lay down, it is a reaction test, and Reflex is
    # already that.
    const MIN_PRODUCE: f64 = 0.3

    # How long a settled trial holds its verdict before the next is dealt.
    const FEEDBACK_SECONDS: f64 = 1.2

    # Longest an unanswered produce trial waits past its target before it is
    # marked as never answered. Without it a run can hang on a player who has
    # walked away, and a stepped driver would tick for ever.
    const LATE_GRACE: f64 = 2.0

    # Most characters the answer field will take. Six significant figures of a
    # gap measured in seconds is already past every rung.
    const MAX_ANSWER: i64 = 12

    # Floating-point slack when comparing an error against its band, so an
    # answer that is exactly on the edge is not refused by the last bit.
    const EPSILON: f64 = 0.000000001

    const TAU: f64 = 6.283185307179586

    const PHASE_READY: i64 = 0
    const PHASE_SHOWING: i64 = 1
    const PHASE_WAITING: i64 = 2
    const PHASE_ASKING: i64 = 3
    const PHASE_COUNTING: i64 = 4
    const PHASE_FEEDBACK: i64 = 5
    const PHASE_DONE: i64 = 6

    # Common-v1 actions.  The text field deliberately has separate point and
    # digit actions: the host can reject malformed payloads before they reach
    # the exact parser below, while the source's leading-zero and one-point
    # rules remain in one place.
    const ACTION_START: i64 = 0
    const ACTION_DIGIT: i64 = 1
    const ACTION_POINT: i64 = 2
    const ACTION_BACKSPACE: i64 = 3
    const ACTION_SUBMIT: i64 = 4
    const ACTION_ACT: i64 = 5

    const INFO_PHASE: i64 = 0
    const INFO_MODE: i64 = 1
    const INFO_START_RUNG: i64 = 2
    const INFO_RUNG: i64 = 3
    const INFO_TRIAL: i64 = 4
    const INFO_TOTAL_TRIALS: i64 = 5
    const INFO_CORRECT: i64 = 6
    const INFO_TRIAL_MODE: i64 = 7
    const INFO_ANSWER_COUNT: i64 = 8
    const INFO_TARGET_MS: i64 = 9
    const INFO_INTERVAL_MS: i64 = 10
    const INFO_VERDICT: i64 = 11
    const INFO_RESULT_COUNT: i64 = 12
    const INFO_ADAPTIVE: i64 = 13
    const INFO_DEADLINE_MS: i64 = 14
    const INFO_FEEDBACK_UNTIL_MS: i64 = 15
    const INFO_MAX_GAP_MS: i64 = 16
    const INFO_FLASH_MS: i64 = 17
    const INFO_APPEARED_AT_MS: i64 = 18
    const INFO_ASK_AT_MS: i64 = 19

    const MOST_TRIALS: i64 = 128

    # The answer field's alphabet: 0..9 are digits, 10 is the decimal point.
    const POINT: i64 = 10

    # One step of the precision ladder. `share` is the whole of the difficulty:
    # an answer counts when it lands within that fraction of the interval.
    def rung_per_second(number: i64) -> f64:
        can Abort.Panic:
            return 1.0 if number <= 1
            return 10.0 if number == 2
            return 100.0 if number == 3
            return 1000.0 if number == 4
            return 1000000.0 if number == 5
            return 1000000000.0

    # The short unit printed beside a target. Kept with the task's ladder so
    # every screen formats the same rung in the same way.
    def rung_short(number: i64) -> cstr:
        can Abort.Panic:
            ring: i64 = rung_at(number)
            return "s" if ring == 1
            return "ds" if ring == 2
            return "cs" if ring == 3
            return "ms" if ring == 4
            return "µs" if ring == 5
            return "ns"

    # Append a target in its rung's unit. Below ten units the reference keeps
    # two decimals; at ten and above it rounds once and groups thousands.
    def quantity(out: mutable dstr&, seconds: f64, rung: i64):
        can Memory.Allocate, Abort.Panic:
            reach: f64 = seconds if seconds >= 0.0 else 0.0 - seconds
            value: f64 = reach * rung_per_second(rung)
            if value < 10.0:
                dstr_append_fixed(out, value, 2)
            else:
                append_grouped(out, py_round_half_even(value))
            out.push(32.u8())
            dstr_append_cstr(out, rung_short(rung))

    # `'{:,}'.format(value)` -- a comma every three digits from the right.
    def append_grouped(out: mutable dstr&, value: i64):
        can Memory.Allocate, Abort.Panic:
            digits: mutable dstr = []
            dstr_append_i64(&digits, value)
            span: i64 = digits.count.i64()
            for index in 0..<span |out, digits, span|:
                if index > 0 and (span - index) % 3 == 0:
                    out.push(44.u8())
                out.push(Bytes::at_ref(&digits, index))

    def rung_share(number: i64) -> f64:
        can Abort.Panic:
            return 0.25 if number <= 1
            return 0.10 if number == 2
            return 0.04 if number == 3
            return 0.015 if number == 4
            return 0.005 if number == 5
            return 0.002

    # The rung `number` names, counting from one and clamped to the ladder.
    def rung_at(number: i64) -> i64:
        can Abort.Panic:
            capped: i64 = MAX_RUNG if number > MAX_RUNG else number
            return MIN_RUNG if capped < MIN_RUNG else capped

    # How far off an answer may be, in seconds, at rung `number`.
    def tolerance(interval: f64, number: i64) -> f64:
        can Abort.Panic:
            magnitude: f64 = interval if interval >= 0.0 else 0.0 - interval
            return magnitude * rung_share(rung_at(number))

    # --- where a shape may be drawn --------------------------------------

    struct TaskMrTimeCanvas:
        left: f64
        bottom: f64
        width: f64
        height: f64

    # The floor is the verdict band's ceiling, so the shape cannot reach into
    # the strip the agent boundary reads a verdict out of. The margin is folded
    # in BEFORE that call rather than after, because a shape is placed by its
    # centre and drawn outwards.
    def canvas(window_width: f64, window_height: f64) -> TaskMrTimeCanvas:
        can Abort.Panic:
            width: f64 = window_width * 0.78
            bottom: f64 = Verdict::above_the_band(window_height, Geometry::from_bottom_edge(window_height, 176.0).f64()).f64()
            top: f64 = Geometry::from_top_edge(window_height, 104.0).f64()
            floor: f64 = Geometry::scale_to_height(window_height, 80.0).f64()
            span: f64 = top - bottom
            height: f64 = floor if floor > span else span
            return TaskMrTimeCanvas{left: (window_width - width) / 2.0, bottom: bottom,
                          width: width, height: height}

    # The shape one trial shows, in fractions of the drawing area. Held as
    # fractions rather than pixels for the reason every other task here holds
    # them that way: a resize mid-trial must redraw the same picture at the new
    # size instead of a different one.
    struct Mark:
        kind: mutable i64
        x: mutable f64
        y: mutable f64
        radius: mutable f64
        turn: mutable f64

    def radius_pixels(mark: Mark&, view: TaskMrTimeCanvas&) -> f64:
        can Abort.Panic:
            shorter: f64 = view.width if view.width < view.height else view.height
            return mark.radius * shorter

    def centre_x(mark: Mark&, view: TaskMrTimeCanvas&) -> f64:
        can Abort.Panic:
            return view.left + mark.x * view.width

    def centre_y(mark: Mark&, view: TaskMrTimeCanvas&) -> f64:
        can Abort.Panic:
            return view.bottom + mark.y * view.height

    # One shape, placed a whole radius clear of the drawing area's edge.
    def random_mark(rng: mutable MT19937&) -> Mark:
        can Abort.Panic:
            radius: f64 = py_uniform(rng, 0.10, 0.20)
            kind: i64 = py_randbelow(rng, KIND_COUNT.u64()).i64()
            x: f64 = py_uniform(rng, radius, 1.0 - radius)
            y: f64 = py_uniform(rng, radius, 1.0 - radius)
            return Mark{kind: kind, x: x, y: y, radius: radius, turn: py_uniform(rng, 0.0, TAU)}

    # --- a run -----------------------------------------------------------

    struct MrTimeRun:
        rng: mutable MT19937
        mode: mutable i64
        start_rung: mutable i64
        total_trials: mutable i64
        max_gap_ms: mutable i64
        flash_ms: mutable i64
        adaptive: mutable bool
        rung: mutable i64
        trial: mutable i64
        correct: mutable i64
        trial_mode: mutable i64
        mark: mutable Mark
        answer_count: mutable i64
        answer: mutable i64[MAX_ANSWER]
        appeared_at: mutable f64
        ask_at: mutable f64
        deadline: mutable f64
        feedback_until: mutable f64
        target: mutable f64
        interval: mutable f64
        phase: mutable i64
        verdict: mutable i64
        result_count: mutable i64
        result_mode: mutable i64[MOST_TRIALS]
        result_interval: mutable f64[MOST_TRIALS]
        result_answered: mutable f64[MOST_TRIALS]
        result_has_answer: mutable i64[MOST_TRIALS]
        result_band: mutable f64[MOST_TRIALS]
        result_rung: mutable i64[MOST_TRIALS]

    def new_run() -> MrTimeRun:
        can Memory.Allocate, Abort.Panic:
            return MrTimeRun{rng: mt19937_new(), mode: MODE_RECALL, start_rung: 1, total_trials: 0, max_gap_ms: 0,
                       flash_ms: 0, adaptive: false, rung: 1, trial: 0, correct: 0,
                       trial_mode: MODE_RECALL,
                       mark: Mark{kind: 0, x: 0.0, y: 0.0, radius: 0.0, turn: 0.0},
                       answer_count: 0, answer: zeroed,
                       appeared_at: 0.0, ask_at: 0.0, deadline: 0.0, feedback_until: 0.0,
                       target: 0.0, interval: 0.0, phase: PHASE_READY, verdict: -1,
                       result_count: 0, result_mode: zeroed,
                       result_interval: zeroed,
                       result_answered: zeroed,
                       result_has_answer: zeroed,
                       result_band: zeroed,
                       result_rung: zeroed}

    # Which half this trial is. `both` shuffles rather than alternates.
    def deal_mode(run: mutable MrTimeRun&, rng: mutable MT19937&) -> i64:
        can Abort.Panic:
            if run.mode == MODE_BOTH:
                # rng.choice((RECALL, PRODUCE)) -- recall is index 0.
                return MODE_PRODUCE if py_randbelow(rng, 2.u64()).i64() == 1 else MODE_RECALL
            return MODE_PRODUCE if run.mode == MODE_PRODUCE else MODE_RECALL

    def reset(run: mutable MrTimeRun&):
        can Abort.Panic:
            run.answer_count <- 0
            run.trial <- 0
            run.correct <- 0
            run.result_count <- 0
            run.phase <- PHASE_READY
            run.rung <- rung_at(run.start_rung)
            run.verdict <- -1

    def finish(run: mutable MrTimeRun&):
        can Abort.Panic:
            run.phase <- PHASE_DONE

    def next_trial(run: mutable MrTimeRun&, now: f64, rng: mutable MT19937&):
        can Abort.Panic:
            if run.trial >= run.total_trials:
                finish(run)
                return
            run.trial <- run.trial + 1
            run.answer_count <- 0
            run.mark <- random_mark(rng)
            run.trial_mode <- deal_mode(run, rng)
            run.verdict <- -1
            run.appeared_at <- now
            if run.trial_mode == MODE_PRODUCE:
                # A whole number of the rung's units, so the duration on screen
                # is the duration being marked rather than a rounding of it --
                # and at least one unit, because rung one rounds a third of a
                # second to no seconds at all.
                per: f64 = rung_per_second(rung_at(run.rung))
                raw: f64 = py_uniform(rng, 0.0, run.max_gap_ms.f64() / 1000.0)
                rounded: i64 = py_round_half_even(raw * per)
                units: mutable i64 = 1 if rounded < 1 else rounded
                if units.f64() / per < MIN_PRODUCE:
                    units <- ceil(MIN_PRODUCE * per).i64()
                run.target <- units.f64() / per
                run.interval <- run.target
                run.deadline <- now + run.target + LATE_GRACE
                run.phase <- PHASE_COUNTING
            else:
                run.target <- 0.0
                # The gap is the "0 to n" the options name; the flash in front
                # of it is fixed, so the interval asked about is the two
                # together and only one of them is hidden.
                gap: f64 = py_uniform(rng, 0.0, run.max_gap_ms.f64() / 1000.0)
                run.ask_at <- now + run.flash_ms.f64() / 1000.0 + gap
                run.interval <- 0.0
                run.phase <- PHASE_SHOWING

    def start_run(run: mutable MrTimeRun&, now: f64, rng: mutable MT19937&):
        can Abort.Panic:
            reset(run)
            next_trial(run, now, rng)

    # Common-v1 owns a Run in a malloc'ed slot rather than in the temporary
    # region used by the differential sweep.  Initialise the persistent RNG and
    # scalar state here; the fixed arrays are already part of the inline record,
    # so no region-backed aggregate is copied into the persistent slot.
    def initialize(run: mutable MrTimeRun&, mode: i64, start_rung: i64,
                   total_trials: i64, max_gap_ms: i64, flash_ms: i64,
                   adaptive: bool, seed: i64):
        can Memory.Allocate, Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            run.mode <- mode
            run.start_rung <- start_rung
            run.total_trials <- total_trials
            run.max_gap_ms <- max_gap_ms
            run.flash_ms <- flash_ms
            run.adaptive <- adaptive
            run.rng <- rng
            run.mark <- Mark{kind: 0, x: 0.0, y: 0.0, radius: 0.0, turn: 0.0}
            run.appeared_at <- 0.0
            run.ask_at <- 0.0
            run.deadline <- 0.0
            run.feedback_until <- 0.0
            run.target <- 0.0
            run.interval <- 0.0
            reset(run)

    def scene_phase(phase: i64) -> i64:
        can Abort.Panic:
            return SceneMrTime::PHASE_READY if phase == PHASE_READY
            return SceneMrTime::PHASE_SHOWING if phase == PHASE_SHOWING
            return SceneMrTime::PHASE_WATCHING if phase == PHASE_WAITING
            return SceneMrTime::PHASE_ASKING if phase == PHASE_ASKING
            return SceneMrTime::PHASE_COUNTING if phase == PHASE_COUNTING
            return SceneMrTime::PHASE_SETTLED if phase == PHASE_FEEDBACK
            return SceneMrTime::PHASE_DONE

    def append_typed(out: mutable dstr&, run: MrTimeRun&):
        can Memory.Allocate, Abort.Panic:
            for at in 0..<run.answer_count |at, run|:
                digit: i64 = run.answer[at.usize()]
                if digit == POINT:
                    out.push(46.u8())
                else:
                    dstr_append_i64(out, digit)

    def append_verdict(out: mutable dstr&, run: MrTimeRun&):
        can Memory.Allocate, Abort.Panic:
            # The last result is the settled trial. Keep its unit at the
            # current pre-adaptation rung, exactly as the native screen does.
            if run.result_count <= 0:
                dstr_append_cstr(out, "Never answered")
                return
            at: i64 = run.result_count - 1
            has_answer: bool = run.result_has_answer[at.usize()] != 0
            if not has_answer:
                dstr_append_cstr(out, "Never answered")
                return
            answered: f64 = run.result_answered[at.usize()]
            interval: f64 = run.result_interval[at.usize()]
            delta: f64 = answered - interval
            if delta == 0.0:
                dstr_append_cstr(out, "Exactly")
                return
            size: mutable dstr = []
            quantity(&size, delta, run.result_rung[at.usize()])
            dstr_append_sview(out, bytes_view(size))
            dstr_append_cstr(out, " ")
            if run.result_mode[at.usize()] == MODE_PRODUCE:
                dstr_append_cstr(out, "late" if delta > 0.0 else "early")
            else:
                dstr_append_cstr(out, "over" if delta > 0.0 else "under")
            right: bool = run.verdict == 1
            if not right:
                dstr_append_cstr(out, " — it was ")
                dstr_append_fixed(out, interval, 3)
                dstr_append_cstr(out, " s")

    def append_message(out: mutable dstr&, run: mutable MrTimeRun&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == PHASE_READY:
                dstr_append_cstr(out, "Press Space to start")
            elif run.phase == PHASE_SHOWING or run.phase == PHASE_WAITING:
                dstr_append_cstr(out, "Watch")
            elif run.phase == PHASE_ASKING:
                dstr_append_cstr(out, "How long ago?")
            elif run.phase == PHASE_COUNTING:
                dstr_append_cstr(out, "Wait for it")
            elif run.phase == PHASE_FEEDBACK:
                append_verdict(out, run)
            else:
                tally: MrTimeScore = score(run)
                dstr_append_i64(out, tally.accuracy)
                dstr_append_cstr(out, "% — ")
                dstr_append_i64(out, tally.correct)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, tally.trials)
                dstr_append_cstr(out, ", typically ")
                dstr_append_fixed(out, tally.weber * 100.0, 1)
                dstr_append_cstr(out, "% out, best rung ")
                dstr_append_i64(out, tally.best_rung)

    def apply(run: mutable MrTimeRun&, action: i64, value: i64, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            now: f64 = now_ms.f64() / 1000.0
            if action == ACTION_START:
                return 2 if run.phase != PHASE_READY and run.phase != PHASE_DONE
                start_run(run, now, &run.rng)
                return 1
            elif action == ACTION_DIGIT:
                return 2 if value < 0 or value > 9 or run.phase != PHASE_ASKING
                type_digit(run, value)
                return 1
            elif action == ACTION_POINT:
                return 2 if run.phase != PHASE_ASKING
                type_point(run)
                return 1
            elif action == ACTION_BACKSPACE:
                return 2 if run.phase != PHASE_ASKING
                backspace(run)
                return 1
            elif action == ACTION_SUBMIT:
                before: i64 = run.result_count
                submit_answer(run, now)
                return 1 if run.result_count != before else 2
            elif action == ACTION_ACT:
                before: i64 = run.result_count
                act_now(run, now)
                return 1 if run.result_count != before else 2
            return -6

    def advance(run: mutable MrTimeRun&, now_ms: i64) -> i64:
        can Abort.Panic:
            before: i64 = run.phase
            update(run, now_ms.f64() / 1000.0, &run.rng)
            return 1 if run.phase != before else 2

    def info(run: MrTimeRun&, field: i64) -> i64:
        can Abort.Panic:
            if field == INFO_PHASE: return run.phase
            elif field == INFO_MODE: return run.mode
            elif field == INFO_START_RUNG: return run.start_rung
            elif field == INFO_RUNG: return run.rung
            elif field == INFO_TRIAL: return run.trial
            elif field == INFO_TOTAL_TRIALS: return run.total_trials
            elif field == INFO_CORRECT: return run.correct
            elif field == INFO_TRIAL_MODE: return run.trial_mode
            elif field == INFO_ANSWER_COUNT: return run.answer_count
            elif field == INFO_TARGET_MS: return (run.target * 1000.0).i64()
            elif field == INFO_INTERVAL_MS: return (run.interval * 1000.0).i64()
            elif field == INFO_VERDICT: return run.verdict
            elif field == INFO_RESULT_COUNT: return run.result_count
            elif field == INFO_ADAPTIVE: return 1 if run.adaptive else 0
            elif field == INFO_DEADLINE_MS: return (run.deadline * 1000.0).i64()
            elif field == INFO_FEEDBACK_UNTIL_MS: return (run.feedback_until * 1000.0).i64()
            elif field == INFO_MAX_GAP_MS: return run.max_gap_ms
            elif field == INFO_FLASH_MS: return run.flash_ms
            elif field == INFO_APPEARED_AT_MS: return (run.appeared_at * 1000.0).i64()
            elif field == INFO_ASK_AT_MS: return (run.ask_at * 1000.0).i64()
            return -1

    def render(run: mutable MrTimeRun&, black_background: bool, width: f64,
               height: f64, list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            message: mutable dstr = []
            verdict_text: mutable dstr = []
            typed: mutable dstr = []
            append_message(&message, run)
            if run.phase == PHASE_ASKING:
                append_typed(&typed, run)
            if run.phase == PHASE_FEEDBACK:
                append_verdict(&verdict_text, run)
            sx: f64 = width / Display::REFERENCE_WIDTH
            sy: f64 = height / Display::REFERENCE_HEIGHT
            paint: SceneMrTime::MrTimePaint = SceneMrTime::paint_of(
                black_background, width, height, sx, sy)
            SceneMrTime::render(list, &paint, scene_phase(run.phase),
                mark_showing(run), run.mark.kind, run.mark.x, run.mark.y,
                run.mark.radius, run.mark.turn, run.rung, run.target,
                bytes_view(typed), run.trial, run.total_trials, run.correct,
                bytes_view(message), run.verdict, bytes_view(verdict_text))

    # Put the question up and FREEZE the interval it asks about. Frozen here
    # rather than read again at submit, so that thinking about the answer and
    # typing it are free -- otherwise the task would be timing the answer as
    # well as asking for one, and a slow typist would be marked for their hands.
    def ask(run: mutable MrTimeRun&, now: f64):
        can Abort.Panic:
            run.interval <- now - run.appeared_at
            run.phase <- PHASE_ASKING

    # --- answering -------------------------------------------------------

    def type_digit(run: mutable MrTimeRun&, digit: i64):
        can Abort.Panic:
            return if run.phase != PHASE_ASKING or run.answer_count >= MAX_ANSWER
            return if digit < 0 or digit > 9
            lone_zero: bool = run.answer_count == 1 and run.answer[0] == 0
            if lone_zero and digit != 0:
                run.answer[0] <- digit
            else:
                return if lone_zero
                run.answer[run.answer_count.usize()] <- digit
                run.answer_count <- run.answer_count + 1

    # Add the decimal point, if the answer has not got one already.
    def type_point(run: mutable MrTimeRun&):
        can Abort.Panic:
            return if run.phase != PHASE_ASKING or run.answer_count >= MAX_ANSWER
            for at in 0..<run.answer_count |run|:
                return if run.answer[at.usize()] == POINT
            # `(self.answer_text or '0') + '.'` -- an empty field grows a
            # leading zero rather than starting with the point.
            if run.answer_count == 0:
                run.answer[0] <- 0
                run.answer_count <- 1
            run.answer[run.answer_count.usize()] <- POINT
            run.answer_count <- run.answer_count + 1

    def backspace(run: mutable MrTimeRun&):
        can Abort.Panic:
            return if run.phase != PHASE_ASKING or run.answer_count == 0
            run.answer_count <- run.answer_count - 1

    struct Answer:
        given: bool
        seconds: f64

    # The typed answer as seconds, or nothing when there is not one yet.
    #
    # Exact: at most eleven digits over a power of ten of at most eleven, both
    # well under 2^53, so one f64 division is the correctly-rounded quotient --
    # which is what `float(text)` gives.
    def answer_seconds(run: mutable MrTimeRun&) -> Answer:
        can Abort.Panic:
            none: Answer = Answer{given: false, seconds: 0.0}
            none return if run.answer_count == 0
            # `text in ('.', '0.')` -- the two fields that hold no number.
            if run.answer_count == 1 and run.answer[0] == POINT:
                return none
            if run.answer_count == 2 and run.answer[0] == 0 and run.answer[1] == POINT:
                return none
            numerator: mutable i64 = 0
            scale: mutable i64 = 1
            seen_point: mutable bool = false
            for at in 0..<run.answer_count |run, numerator, scale, seen_point|:
                digit: i64 = run.answer[at.usize()]
                if digit == POINT:
                    seen_point <- true
                else:
                    numerator <- numerator * 10 + digit
                    scale <- scale * 10 if seen_point
            return Answer{given: true, seconds: numerator.f64() / scale.f64()}

    def adapt(run: mutable MrTimeRun&, right: bool):
        can Abort.Panic:
            return if not run.adaptive
            run.rung <- rung_at(run.rung + 1) if right else rung_at(run.rung - 1)

    # Score the trial closed, paint it, and pause on it.
    def settle(run: mutable MrTimeRun&, answered: Answer&, now: f64):
        can Abort.Panic:
            band: f64 = tolerance(run.interval, run.rung)
            gap: f64 = answered.seconds - run.interval
            magnitude: f64 = gap if gap >= 0.0 else 0.0 - gap
            right: bool = answered.given and magnitude <= band + EPSILON
            run.result_mode[run.result_count.usize()] <- run.trial_mode
            run.result_interval[run.result_count.usize()] <- run.interval
            run.result_answered[run.result_count.usize()] <- answered.seconds
            run.result_has_answer[run.result_count.usize()] <- 1 if answered.given else 0
            run.result_band[run.result_count.usize()] <- band
            run.result_rung[run.result_count.usize()] <- run.rung
            run.result_count <- run.result_count + 1
            run.correct <- run.correct + 1 if right
            run.phase <- PHASE_FEEDBACK
            run.feedback_until <- now + FEEDBACK_SECONDS
            run.verdict <- 1 if right else 0
            # The ladder moves AFTER the verdict is painted, so the line under
            # it still names the unit the trial was actually marked in.
            adapt(run, right)

    # Mark the typed answer against the interval. Recall trials only.
    def submit_answer(run: mutable MrTimeRun&, now: f64):
        can Abort.Panic:
            return if run.phase != PHASE_ASKING
            answered: Answer = answer_seconds(run)
            return if not answered.given
            settle(run, &answered, now)

    # Take the produce trial's action: this is the moment claimed.
    def act_now(run: mutable MrTimeRun&, now: f64):
        can Abort.Panic:
            return if run.phase != PHASE_COUNTING
            claimed: Answer = Answer{given: true, seconds: now - run.appeared_at}
            settle(run, &claimed, now)

    # Whether the shape is on screen this frame.
    def mark_showing(run: mutable MrTimeRun&) -> bool:
        can Abort.Panic:
            return run.phase == PHASE_SHOWING or run.phase == PHASE_COUNTING

    # Whether (x, y) is on the shape, for a click that claims a moment.
    def mark_at(run: mutable MrTimeRun&, x: f64, y: f64, window_width: f64, window_height: f64) -> bool:
        can Abort.Panic:
            false return if not mark_showing(run)
            view: TaskMrTimeCanvas = canvas(window_width, window_height)
            return py_hypot(x - centre_x(&run.mark, &view), y - centre_y(&run.mark, &view)) <= radius_pixels(&run.mark, &view)

    def update(run: mutable MrTimeRun&, now: f64, rng: mutable MT19937&):
        can Abort.Panic:
            if run.phase == PHASE_SHOWING and now - run.appeared_at >= run.flash_ms.f64() / 1000.0:
                # The shape goes away. The question is still to come.
                run.phase <- PHASE_WAITING
            # NOT `elif`: a gap of zero asks on the tick the shape goes.
            if run.phase == PHASE_WAITING and now >= run.ask_at:
                ask(run, now)
            else:
                if run.phase == PHASE_COUNTING and now >= run.deadline:
                    never: Answer = Answer{given: false, seconds: 0.0}
                    settle(run, &never, now)
                else:
                    if run.phase == PHASE_FEEDBACK and now >= run.feedback_until:
                        next_trial(run, now, rng)

    struct MrTimeScore:
        trials: i64
        correct: i64
        accuracy: i64
        weber: f64
        mean_error_ms: f64
        best_rung: i64

    # `weber` is the mean of |error| / interval over the trials that were
    # answered, which is the number this task exists to measure: comparable
    # across runs that dealt different intervals, and written in the same units
    # as the rung shares, so it says directly which rung a player belongs on.
    def score(run: mutable MrTimeRun&) -> MrTimeScore:
        can Abort.Panic:
            share_total: mutable f64 = 0.0
            share_count: mutable i64 = 0
            error_total: mutable f64 = 0.0
            error_count: mutable i64 = 0
            best_rung: mutable i64 = 0
            for at in 0..<run.result_count |run, share_total, share_count, error_total, error_count, best_rung|:
                rung: i64 = run.result_rung[at.usize()]
                best_rung <- rung if rung > best_rung
                continue if run.result_has_answer[at.usize()] == 0
                interval: f64 = run.result_interval[at.usize()]
                gap: f64 = run.result_answered[at.usize()] - interval
                magnitude: f64 = gap if gap >= 0.0 else 0.0 - gap
                error_total <- error_total + magnitude
                error_count <- error_count + 1
                if interval > 0.0:
                    share_total <- share_total + magnitude / interval
                    share_count <- share_count + 1
            accuracy: mutable i64 = 0
            accuracy <- py_round_half_even(100.0 * run.correct.f64() / run.result_count.f64()) if run.result_count != 0
            weber: mutable f64 = 0.0
            weber <- share_total / share_count.f64() if share_count != 0
            mean_error: mutable f64 = 0.0
            mean_error <- 1000.0 * error_total / error_count.f64() if error_count != 0
            return MrTimeScore{trials: run.result_count, correct: run.correct, accuracy: accuracy,
                         weber: weber, mean_error_ms: mean_error, best_rung: best_rung}
