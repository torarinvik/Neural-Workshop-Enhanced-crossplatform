include "./manual.elisa"

module ManualText:
    # The words manual.py writes for each step, its control names, and
    # what ui/manual.py says is wrong when a round is judged.
    def name(out: mutable dstr&, letter: u8, index: i64):
        can Memory.Allocate, Abort.Panic:
            out.push(letter)
            dstr_append_i64(out, index + 1)

    def switch_name(out: mutable dstr&, index: i64):
        can Memory.Allocate, Abort.Panic:
            name(out, 83.u8(), index)

    def knob_name(out: mutable dstr&, index: i64):
        can Memory.Allocate, Abort.Panic:
            name(out, 75.u8(), index)

    def button_name(out: mutable dstr&, index: i64):
        can Memory.Allocate, Abort.Panic:
            name(out, 80.u8(), index)

    def lamp_name(out: mutable dstr&, index: i64):
        can Memory.Allocate, Abort.Panic:
            name(out, 76.u8(), index)

    def colour_word(colour: i64) -> cstr:
        return "green" if colour == Manual::GREEN
        return "red" if colour == Manual::RED
        return "off"

    # _plain's words, lower case.
    def plain(out: mutable dstr&, made: Manual::Plain):
        can Memory.Allocate, Abort.Panic:
            if made.kind == Manual::SET:
                dstr_append_cstr(out, "turn switch ")
                switch_name(out, made.index)
                dstr_append_cstr(out, " on" if made.value == 1 else " off")
            elif made.kind == Manual::FLIP:
                dstr_append_cstr(out, "flip switch ")
                switch_name(out, made.index)
            elif made.kind == Manual::KNOB:
                dstr_append_cstr(out, "turn knob ")
                knob_name(out, made.index)
                dstr_append_cstr(out, " to ")
                dstr_append_i64(out, made.value)
            else:
                dstr_append_cstr(out, "press button ")
                button_name(out, made.index)
                if made.value != 1:
                    out.push(32.u8())
                    dstr_append_i64(out, made.value)
                    dstr_append_cstr(out, " times")

    # A step's words, as the procedure lists them.
    def step(out: mutable dstr&, made: Manual::Step&):
        can Memory.Allocate, Abort.Panic:
            kind: i64 = made.kind
            if kind <= Manual::PRESS:
                words: mutable dstr = []
                plain(&words, made.yes)
                # _sentence: a capital first letter and a full stop.
                for at in 0..<words.count.i64() |out, words|:
                    byte: u8 = words[at.usize()]
                    out.push(byte - 32.u8() if at == 0 else byte)
                out.push(46.u8())
            elif kind == Manual::IF:
                dstr_append_cstr(out, "If lamp ")
                lamp_name(out, made.lamp)
                dstr_append_cstr(out, " is ")
                dstr_append_cstr(out, colour_word(made.colour))
                dstr_append_cstr(out, ", ")
                plain(out, made.yes)
                dstr_append_cstr(out, "; otherwise ")
                plain(out, made.no)
                out.push(46.u8())
            elif kind == Manual::COUNT:
                dstr_append_cstr(out, "Press button ")
                button_name(out, made.first)
                dstr_append_cstr(out, " as many times as the display shows now (none if it shows 0).")
            elif kind == Manual::COPY:
                if made.on_knobs:
                    dstr_append_cstr(out, "Turn knob ")
                    knob_name(out, made.second)
                    dstr_append_cstr(out, " to where knob ")
                    knob_name(out, made.first)
                    dstr_append_cstr(out, " points.")
                else:
                    dstr_append_cstr(out, "Set switch ")
                    switch_name(out, made.second)
                    dstr_append_cstr(out, " the same as switch ")
                    switch_name(out, made.first)
                    out.push(46.u8())
            elif kind == Manual::UNTIL:
                dstr_append_cstr(out, "If lamp ")
                lamp_name(out, made.lamp)
                dstr_append_cstr(out, " is not ")
                dstr_append_cstr(out, colour_word(made.colour))
                dstr_append_cstr(out, ", press button ")
                button_name(out, made.first)
                dstr_append_cstr(out, " until it is.")
            elif kind == Manual::RECALL:
                if made.on_knobs:
                    dstr_append_cstr(out, "Turn knob ")
                    knob_name(out, made.first)
                    dstr_append_cstr(out, " back to where it pointed at the start.")
                else:
                    dstr_append_cstr(out, "Set switch ")
                    switch_name(out, made.first)
                    dstr_append_cstr(out, " back the way it was at the start.")
            else:
                dstr_append_cstr(out, "If the display shows an ")
                dstr_append_cstr(out, "even" if made.even else "odd")
                dstr_append_cstr(out, " number, skip the next step.")

    # The procedure: "n.  words" per step, one to a line.
    def procedure(out: mutable dstr&, dealt: Manual::Deal&):
        can Memory.Allocate, Abort.Panic:
            for index in 0..<dealt.step_count |out, dealt|:
                out.push(10.u8()) if index > 0
                dstr_append_i64(out, index + 1)
                dstr_append_cstr(out, ".  ")
                step(out, &dealt.steps[index.usize()])

    # mistakes(), joined by ", ": every control not where the procedure
    # leaves it. Empty when the round is right.
    def mistakes(out: mutable dstr&, have: Manual::Panel&, want: Manual::Panel&):
        can Memory.Allocate, Abort.Panic:
            level: Manual::Grade = have.level
            for index in 0..<level.switches |out, have, want|:
                if have.switches[index.usize()] != want.switches[index.usize()]:
                    dstr_append_cstr(out, ", ") if out.count > 0
                    switch_name(out, index)
            for index in 0..<level.knobs |out, have, want|:
                if have.knobs[index.usize()] != want.knobs[index.usize()]:
                    dstr_append_cstr(out, ", ") if out.count > 0
                    knob_name(out, index)
            for index in 0..<level.buttons |out, have, want|:
                if have.presses[index.usize()] != want.presses[index.usize()]:
                    dstr_append_cstr(out, ", ") if out.count > 0
                    button_name(out, index)
                    dstr_append_cstr(out, " pressed ")
                    dstr_append_i64(out, have.presses[index.usize()])
                    dstr_append_cstr(out, " times, not ")
                    dstr_append_i64(out, want.presses[index.usize()])
