include "./ints.elisa"

module CipherLang:
    const REV: i64 = 0
    const SWAP: i64 = 1
    const ROT: i64 = 2
    const SHIFT: i64 = 3
    const MUL: i64 = 4
    const AFFINE: i64 = 5
    const SUB: i64 = 6
    const PERM: i64 = 7
    const PREFIX: i64 = 8
    const DIFF: i64 = 9
    const SORT: i64 = 10
    const CONV: i64 = 11
    const TSHIFT: i64 = 12
    const MEM: i64 = 13
    const MIRROR: i64 = 14
    const WEAVE: i64 = 15
    const UNWEAVE: i64 = 16
    const RUNS: i64 = 17
    const ODDSHIFT: i64 = 18
    const XOR: i64 = 19
    const GF: i64 = 20
    const FEISTEL: i64 = 21
    const FOLD: i64 = 22
    const STRIDE: i64 = 23
    const DEDUPE: i64 = 24
    const DOUBLE: i64 = 25
    const HALVE: i64 = 26
    const FIRST: i64 = 27
    const LAST: i64 = 28
    const HAS: i64 = 29
    const EVENS: i64 = 30
    const SUMEVEN: i64 = 31
    const RISES: i64 = 32
    const TPARITY: i64 = 33
    const ECHO: i64 = 34
    const SAME: i64 = 35
    const PAL: i64 = 36
    const SORTED: i64 = 37
    const SEQ: i64 = 38
    const IF: i64 = 39
    const ALT: i64 = 40
    const EXCEPT: i64 = 41
    const PROG: i64 = 42
    const META: i64 = 43

    # Program entries refer to children by index, so sharing a subtree keeps
    # its identity while each occurrence still contributes its own meta trigger.
    struct Node:
        op: i64
        args: darray[i64]
        children: darray[i64]

    struct State:
        runs: i64
        last_in: darray[i64]
        last_out: darray[i64]
        meta: mutable i64

    struct Sample:
        given: darray[i64]
        result: darray[i64]

    def modulo(value: i64, modulus: i64) -> i64:
        r: i64 = value % modulus
        return r + modulus if r < 0 else r

    def gf_mul(left: i64, right: i64, k: i64) -> i64:
        a: mutable i64 = left
        b: mutable i64 = right
        poly: i64 = 7 if k == 4 else 11
        result: mutable i64 = 0
        while b > 0 |a, b, k, poly, result|:
            result <- result ^ a if (b & 1) != 0
            b <- b >> 1
            a <- a << 1
            a <- a ^ poly if (a & k) != 0
        return result

    def uniform(row: darray[i64]&) -> bool:
        can Abort.Panic:
            return false if row.count == 0.usize()
            for value in row:
                return false if value != row[0]
            return true

    def test(node: Node&, row: darray[i64]&, state: State&) -> bool:
        can Abort.Panic:
            n: i64 = row.count.i64()
            return false if n == 0
            op: i64 = node.op
            first: i64 = row[0]
            last: i64 = row[(n - 1).usize()]
            return first == node.args[0] if op == FIRST
            return last == node.args[0] if op == LAST
            return first < last if op == RISES
            return state.runs % 2 == 0 if op == TPARITY
            return uniform(row) if op == SAME
            return state.last_out.count > 0.usize() and state.last_out[0] == node.args[0] if op == ECHO
            if op == PAL or op == SORTED:
                for i in 0..<(n - 1) |op, row, n|:
                    value: i64 = row[i.usize()]
                    if (op == PAL and value != row[(n - 1 - i).usize()]) or (op == SORTED and value > row[(i + 1).usize()]):
                        return false
                return true
            total: mutable i64 = 0
            for value in row:
                total <- total + (value if op == SUMEVEN else (1 if value == node.args[0] else 0))
            return total > 0 if op == HAS else total % 2 == 0

    def positional(node: Node&, row: darray[i64]&, i: i64) -> i64:
        can Abort.Panic:
            n: i64 = row.count.i64()
            op: i64 = node.op
            half: i64 = n / 2
            even: i64 = (n + 1) / 2
            return n - 1 - i if op == REV
            return (i ^ 1) if op == SWAP and (i ^ 1) < n
            return modulo(i - node.args[0], n) if op == ROT
            return node.args[i.usize()] if op == PERM and node.args.count == row.count
            return half - 1 - i if op == MIRROR and i < half
            return half + n - 1 - i if op == MIRROR
            return (2 * i if i < even else 2 * (i - even) + 1) if op == WEAVE
            return (i / 2 if i % 2 == 0 else even + i / 2) if op == UNWEAVE
            return modulo(i * node.args[0], n) if op == STRIDE
            return i

    def sliced(row: darray[i64]&, first: i64, stop: i64) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            part: mutable darray[i64] = []
            for i in first..<stop |part, row|:
                part.push(row[i.usize()])
            return part

    def resized(op: i64, row: darray[i64]&) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            result: mutable darray[i64] = []
            for i in 0..<row.count.i64() |op, row, result|:
                value: i64 = row[i.usize()]
                continue if op == HALVE and i % 2 != 0
                continue if op == DEDUPE and i > 0 and value == row[(i - 1).usize()]
                result.push(value)
                result.push(value) if op == DOUBLE
            return result

    def transformed(node: Node&, row: darray[i64]&, state: State&, at: i64, k: i64, prefix: i64, consecutive: i64) -> i64:
        can Abort.Panic:
            op: i64 = node.op
            v: i64 = row[at.usize()]
            previous: i64 = row[(at - 1).usize()] if at > 0 else 0
            return modulo(v + node.args[0], k) if op == SHIFT or (op == ODDSHIFT and at % 2 != 0)
            return modulo(v * node.args[0], k) if op == MUL
            return modulo(v * node.args[0] + node.args[1], k) if op == AFFINE
            return node.args[v.usize()] if op == SUB
            return prefix if op == PREFIX
            return modulo(v - previous, k) if op == DIFF
            return modulo(v * node.args[0] + previous * node.args[1] + node.args[2], k) if op == CONV
            return modulo(v + modulo(state.runs, k) * node.args[0], k) if op == TSHIFT
            return modulo(v + state.last_in[at.usize()], k) if op == MEM and at < state.last_in.count.i64()
            return consecutive % k if op == RUNS
            return v ^ node.args[0] if op == XOR
            return gf_mul(v, node.args[0], k) if op == GF
            return modulo(v + row[(row.count.i64() - 1 - at).usize()], k) if op == FOLD
            return row[positional(node, row, at).usize()]

    def primitive(program: darray[Node]&, node: Node&, row: darray[i64]&, k: i64, state: State&) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            n: i64 = row.count.i64()
            return [] if n == 0
            op: i64 = node.op
            return resized(op, row) if op >= DEDUPE and op <= HALVE
            if op == SORT:
                sorted: mutable darray[i64] = sliced(row, 0, n)
                Ints::sort_prefix(&sorted, n)
                return sorted
            if op == FEISTEL:
                half: i64 = n / 2
                right: mutable darray[i64] = sliced(row, half, 2 * half)
                f: darray[i64] = run(program, node.children[0], &right, k, state)
                size: i64 = half if half < f.count.i64() else f.count.i64()
                for i in 0..<size |row, right, f, k|:
                    right.push(modulo(row[i.usize()] + f[i.usize()], k))
                right.push(row[(n - 1).usize()]) if n % 2 != 0
                return right
            result: mutable darray[i64] = []
            prefix: mutable i64 = 0
            consecutive: mutable i64 = 0
            for i in 0..<n |node, row, state, k, result, prefix, consecutive|:
                value: i64 = row[i.usize()]
                prefix <- modulo(prefix + value, k)
                consecutive <- consecutive + 1 if i > 0 and row[(i - 1).usize()] == value else 1
                result.push(transformed(node, row, state, i, k, prefix, consecutive))
            return result

    def program_row(program: darray[Node]&, node: Node&, row: darray[i64]&, k: i64, state: State&) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            # Later declarations for the same symbol replace earlier ones.
            commands: mutable i64[8] = [-1, -1, -1, -1, -1, -1, -1, -1]
            for i in 0..<node.args.count.i64() |node, commands|:
                commands[node.args[i.usize()].usize()] <- node.children[i.usize()]
            data: mutable darray[i64] = []
            for symbol in row:
                data.push(symbol) if commands[symbol.usize()] < 0
            for symbol in row:
                command: i64 = commands[symbol.usize()]
                if command >= 0 and data.count > 0.usize():
                    data <- primitive(program, &program[command.usize()], &data, k, state)
            return data

    def run(program: darray[Node]&, entry: i64, row: darray[i64]&, k: i64, state: State&) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            node: Node& = &program[entry.usize()]
            op: i64 = node.op
            return primitive(program, node, row, k, state) if op <= HALVE
            return program_row(program, node, row, k, state) if op == PROG
            if op == SEQ:
                value: mutable darray[i64] = sliced(row, 0, row.count.i64())
                for child in node.children:
                    value <- run(program, child, &value, k, state)
                return value
            branch: mutable i64 = 0
            if op == IF:
                branch <- 1 if test(&program[node.children[0].usize()], row, state) else 2
            elif op == ALT:
                branch <- state.runs % 2
            elif op == EXCEPT:
                branch <- 1 if uniform(row) else 0
            elif op == META:
                branch <- 1 + state.meta % (node.children.count.i64() - 1)
            return run(program, node.children[branch.usize()], row, k, state)

    def meta_bump(program: darray[Node]&, entry: i64, row: darray[i64]&, state: State&) -> i64:
        can Abort.Panic:
            node: Node& = &program[entry.usize()]
            return 0 if node.op < SEQ or node.op == PROG
            total: mutable i64 = 1 if node.op == META and test(&program[node.children[0].usize()], row, state) else 0
            start: i64 = 1 if node.op == META or node.op == IF else 0
            for i in start..<node.children.count.i64() |program, node, row, state, total|:
                total <- total + meta_bump(program, node.children[i.usize()], row, state)
            return total

    def advance(program: darray[Node]&, entry: i64, state: State&, given: darray[i64]&, result: darray[i64]&) -> State:
        can Abort.Panic, Memory.Allocate:
            return State{runs: state.runs + 1, last_in: sliced(given, 0, given.count.i64()),
                last_out: sliced(result, 0, result.count.i64()), meta: state.meta + meta_bump(program, entry, given, state)}

    def replay(program: darray[Node]&, entry: i64, log: darray[Sample]&, k: i64) -> State:
        can Abort.Panic, Memory.Allocate:
            state: mutable State = zeroed
            for sample in log:
                result: darray[i64] = run(program, entry, &sample.given, k, &state)
                state <- advance(program, entry, &state, &sample.given, &result)
            return state
