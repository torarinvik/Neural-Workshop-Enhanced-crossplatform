include "./forms_fill.elisa"

module FormsGame:
    # ui/forms.py: a run of forms on a ladder, each judged when its last
    # page is sent -- passed when every value is the card's and the keys,
    # with a penalty for each page sent back, come to no more than par.
    # Keys arrive as forms.py's keys; agent ports are ui/forms.py's KEYS.
    const READY: i64 = 0
    const FILLING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const FEEDBACK: f64 = 3.0
    const START: i64 = FormsFill::PORTS

    # How a form ended.
    const LIVE: i64 = 0
    const RIGHT: i64 = 1
    const WRONG: i64 = 2
    # How many fields info reports.
    const INFO_FIELDS: i64 = 15

    struct Ladder:
        start_rung: mutable i64
        total: mutable i64
        adaptive: mutable bool
        rung: mutable i64
        trial: mutable i64
        wins: mutable i64
        best_rung: mutable i64

    struct Session:
        rng: mutable MT19937
        ladder: mutable Ladder
        phase: mutable i64
        time: mutable f64
        deadline: mutable f64
        form: mutable FormsFill::Filling
        par: mutable f64
        verdict: mutable i64

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = zeroed
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            initial: i64 = rung if rung > 0 else 1
            ladder: Ladder = Ladder{start_rung: initial, total: trials, adaptive: adaptive, rung: initial, trial: 0, wins: 0,
                best_rung: 0}
            return Session{rng: rng, ladder: ladder, phase: READY, time: 0.0, deadline: 0.0, form: zeroed, par: 0.0,
                verdict: LIVE}

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 2 or rung == 4 or rung == 6 or rung == 8 or rung == 10 or rung == 12 or rung == 14 or rung == 16 or rung == 18 or rung == 20 or rung == 25

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 8 or total == 12

    def valid_time(session: Session&, now: f64) -> bool:
        return now >= session.time and now <= 9007199254740.0

    def live(session: Session&) -> bool:
        return session.phase == FILLING or session.phase == JUDGED

    # _next_trial: the next form and its par, or the end of the run.
    def next_trial(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            session.time <- now
            if session.ladder.trial >= session.ladder.total:
                # The last form stays: its verdict stays up, as _finish
                # leaves the label.
                session.phase <- DONE
                return true
            session.ladder.trial <- session.ladder.trial + 1
            dealt: Forms::Deal = Forms::deal(session.ladder.rung, &session.rng)
            session.form <- FormsFill::start(dealt)
            session.par <- FormsFill::par(dealt)
            session.verdict <- LIVE
            session.phase <- FILLING
            return true

    def start(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if (session.phase != READY and session.phase != DONE) or session.ladder.total < 1
            return false if not valid_time(session, now)
            session.ladder.rung <- session.ladder.start_rung
            session.ladder.trial <- 0
            session.ladder.wins <- 0
            session.ladder.best_rung <- 0
            return next_trial(session, now)

    # _judge: the last page is sent.
    def judge(session: mutable Session&, now: f64):
        can Abort.Panic, Memory.Allocate:
            mistakes: i64 = FormsFill::wrong(&session.form).count
            passed: bool = mistakes == 0 and FormsFill::spent(&session.form).f64() <= session.par + 0.000000001
            session.verdict <- RIGHT if passed else WRONG
            ladder: mutable Ladder = session.ladder
            if passed:
                ladder.wins <- ladder.wins + 1
                ladder.best_rung <- ladder.rung if ladder.rung > ladder.best_rung
            if ladder.adaptive:
                ladder.rung <- ladder.rung + 1 if passed and ladder.rung < 9223372036854775807
                ladder.rung <- ladder.rung - 1 if not passed and ladder.rung > 1
            session.ladder <- ladder
            session.deadline <- now + FEEDBACK
            session.phase <- JUDGED

    # One key, as forms.py names it: a character's byte or a named key.
    def key(session: mutable Session&, pressed: i64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if session.phase != FILLING or not valid_time(session, now)
            return false if pressed == Forms::NO_KEY or pressed < Forms::DOWN or pressed > 126
            session.time <- now
            FormsFill::press(&session.form, pressed)
            judge(session, now) if session.form.sent
            return true

    # A character typed: letters, digits and forms.py's SYMBOLS only.
    def typed(session: mutable Session&, byte: i64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            letter: bool = (byte >= 97 and byte <= 122) or (byte >= 65 and byte <= 90) or (byte >= 48 and byte <= 57)
            symbol: bool = byte == 32 or byte == 64 or byte == 46 or byte == 45 or byte == 47
            return false if not letter and not symbol
            return key(session, byte, now)

    def steer(session: mutable Session&, port: i64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if port < 0 or port >= FormsFill::PORTS
            return key(session, FormsFill::port_key(port), now)

    # A primary press: the run's start, or the field row under the
    # pointer (-1 for none), which takes the focus for one key.
    def press(session: mutable Session&, row: i64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return start(session, now) if session.phase == READY or session.phase == DONE
            return false if session.phase != FILLING or row < 0 or not valid_time(session, now)
            session.time <- now
            FormsFill::focus_on(&session.form, row)
            return true

    # One agent event: START begins a run, -1 is a frame (it steps past a
    # verdict), and anything else is a port.
    def agent_input(session: mutable Session&, now: f64, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if not valid_time(session, now)
            return start(session, now) if port == START
            return steer(session, port, now) if port != -1
            return advance(session, now, true) if session.phase == JUDGED
            return false if session.phase != FILLING
            session.time <- now
            return true

    def advance(session: mutable Session&, now: f64, stepped: bool = false) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if not valid_time(session, now)
            return false if session.phase != JUDGED
            return false if not stepped and now < session.deadline
            return next_trial(session, now)

    def reconfigure(session: mutable Session&, rung: i64, total: i64, adaptive: bool) -> bool:
        return false if session.phase != READY and session.phase != DONE
        return false if not allowed_rung(rung) or not allowed_total(total)
        session.ladder <- Ladder{start_rung: rung, total: total, adaptive: adaptive, rung: rung, trial: 0, wins: 0, best_rung: 0}
        session.phase <- READY
        return true

    def close(session: mutable Session&):
        session.phase <- READY
        session.form <- zeroed

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic, Memory.Allocate:
            return session.phase if field == 0
            return session.ladder.rung if field == 1
            return session.ladder.trial if field == 2
            return session.ladder.total if field == 3
            return session.ladder.wins if field == 4
            return session.ladder.best_rung if field == 5
            return session.ladder.start_rung if field == 6
            return (1 if session.ladder.adaptive else 0) if field == 7
            return session.verdict if field == 8
            on: bool = live(session)
            return (session.form.keys if on else 0) if field == 9
            return (session.form.bounced if on else 0) if field == 10
            return (session.form.page if on else 0) if field == 11
            return (FormsFill::focused(&session.form) if on else -1) if field == 12
            return (FormsFill::spent(&session.form) if on else 0) if field == 13
            return ((session.par * 10.0 + 0.5).i64() if on else 0) if field == 14
            return -1
