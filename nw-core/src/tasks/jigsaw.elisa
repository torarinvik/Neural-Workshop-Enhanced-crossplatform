include "../jigsaw_photo_assets.elisa"
include "../jigsaw_layout.elisa"

# Jigsaw Puzzle: put a scrambled photograph back together.
#
# Port of the portable half of neural_workshop/ui/jigsaw.py
# (GPL-2.0-or-later). The photograph library belongs to the shell, so a puzzle
# here is a permutation and a grid; what the tiles show is not what the task
# decides anything on.
#
# The score is not just finishing. Any scramble can be solved in a KNOWABLE
# minimum number of swaps -- one less than the length of each cycle of the
# shuffle, summed -- and the run reports how close to that minimum each
# solution came. Swapping tiles about at random finishes eventually; seeing
# where each tile goes before touching it finishes at the minimum, and the gap
# between the two is what is measured.
#
# Two details carry it:
#
#   * `scramble` REDRAWS the identity away rather than patching it away.
#     Swapping a pair into an almost-sorted shuffle would bias small grids
#     toward one-swap puzzles.
#   * the minimum is EXACT -- n minus the number of cycles in the permutation,
#     not a bound on it -- which is why green can mean "the fewest swaps this
#     scramble could be undone in" rather than "close enough".

module Jigsaw:

    const SMALLEST_SIDE: i64 = 2
    const LARGEST_SIDE: i64 = 10

    # How efficient a solution has to be before an adaptive run grows the grid,
    # and how far below that it falls before the grid shrinks. Efficiency is
    # the minimum number of swaps over the number used, so one is perfect.
    const GROW_AT: f64 = 0.7
    const SHRINK_AT: f64 = 0.45

    const FEEDBACK_SECONDS: f64 = 1.6

    const PIECE_OPTION_BASE: i64 = 2500

    def tile_limit(video: bool) -> i64:
        return JigsawPhotoAssets::MAX_VIDEO_TILES if video else JigsawPhotoAssets::MAX_PHOTO_TILES
    const MOST_PUZZLES: i64 = 64

    const PHASE_READY: i64 = 0
    const PHASE_SOLVING: i64 = 1
    const PHASE_SOLVED: i64 = 2
    const PHASE_DONE: i64 = 3

    def clamped(side: i64) -> i64:
        can Abort.Panic:
            capped: i64 = LARGEST_SIDE if side > LARGEST_SIDE else side
            return SMALLEST_SIDE if capped < SMALLEST_SIDE else capped

    # Round sqrt(pieces * aspect) using the half-integer boundaries.
    def bounded_pieces(pieces: i64, video: bool) -> i64:
        limit: i64 = tile_limit(video)
        return limit if pieces > limit else pieces

    def piece_columns(pieces: i64, video: bool = false) -> i64:
        numerator: i64 = bounded_pieces(pieces, video) * (16 if video else 4)
        denominator: i64 = 3 if video else 1
        columns: mutable i64 = 1
        while numerator > denominator * (2 * columns + 1) * (2 * columns + 1) |columns, numerator, denominator|:
            columns <- columns + 1
        return columns

    def piece_rows(pieces: i64, columns: i64, video: bool = false) -> i64:
        rows: i64 = (bounded_pieces(pieces, video) + columns - 1) / columns
        return JigsawPhotoAssets::VIDEO_HEIGHT if video and rows > JigsawPhotoAssets::VIDEO_HEIGHT else rows

    def piece_count(pieces: i64, video: bool = false) -> i64:
        columns: i64 = piece_columns(pieces, video)
        return columns * piece_rows(pieces, columns, video)

    def allowed_pieces(pieces: i64) -> bool:
        return pieces >= 2

    def adjacent_piece_grid(pieces: i64, delta: i64, video: bool = false) -> i64:
        can Abort.Panic:
            count: i64 = piece_count(pieces, video)
            next: mutable i64 = count + delta
            limit: i64 = tile_limit(video)
            while next > 2 and next < limit and piece_count(next, video) != next |next, delta, video, limit|:
                next <- next + delta
            return next if next >= 2 and next <= limit and piece_count(next, video) == next else pieces

    def is_solved(order: mutable darray[i64]&, count: i64) -> bool:
        can Abort.Panic:
            for position in 0..<count |order, position|:
                false return if Ints::at_ref(order, position) != position
            return true

    # A shuffle of the grid's tiles, never the solved one. `order[position]` is
    # the tile shown at `position`.
    def scramble(order: mutable darray[i64]&, side: i64, rng: mutable MT19937&, rows: i64 = 0):
        can Abort.Panic:
            count: i64 = side * (rows if rows > 0 else side)
            for position in 0..<count |order|:
                Ints::put(order, position, position)
            # The identity always passes the test, so the shuffle runs at least
            # once -- and again for as long as it lands back on the identity.
            while is_solved(order, count) |order, count, rng|:
                py_shuffle_i64_prefix(rng, order, count)

    # The fewest swaps that sort `order`. Each cycle of length n needs n - 1
    # swaps, so the total is the size of the grid minus the number of cycles.
    # This is the par a solution is measured against.
    def minimum_swaps(order: mutable darray[i64]&, count: i64, seen: mutable darray[i64]&) -> i64:
        can Abort.Panic:
            for at in 0..<count |seen|:
                Ints::put(seen, at, 0)
            cycles: mutable i64 = 0
            for start in 0..<count |order, seen, cycles|:
                continue if Ints::at_ref(seen, start) != 0
                cycles <- cycles + 1
                position: mutable i64 = start
                while Ints::at_ref(seen, position) == 0 |order, seen, position|:
                    Ints::put(seen, position, 1)
                    position <- Ints::at_ref(order, position)
            return count - cycles

    # --- layout ----------------------------------------------------------

    struct JigsawKernelCanvas:
        left: f64
        bottom: f64
        width: f64
        height: f64

    struct Square:
        left: f64
        bottom: f64
        size: f64

    struct Rect:
        left: f64
        bottom: f64
        width: f64
        height: f64

    # Left, bottom, width, height of the room the board may use.
    def canvas(window_width: f64, window_height: f64) -> JigsawKernelCanvas:
        can Abort.Panic:
            top: f64 = Geometry::from_top_edge(window_height, 96.0).f64()
            bottom: f64 = Verdict::above_the_band(window_height, Geometry::from_bottom_edge(window_height, 56.0).f64()).f64()
            span: f64 = top - bottom
            return JigsawKernelCanvas{left: window_width * 0.04, bottom: bottom,
                          width: window_width * 0.92,
                          height: 40.0 if span < 40.0 else span}

    # Left, bottom and size of the puzzle square. With the preview on, the
    # board leaves a quarter of the width to its right for the finished
    # picture -- the lid of the box.
    def board_rect(window_width: f64, window_height: f64, preview: bool) -> Square:
        can Abort.Panic:
            view: JigsawKernelCanvas = canvas(window_width, window_height)
            room: f64 = view.width * (0.72 if preview else 1.0)
            size: f64 = view.height if view.height < room else room
            return Square{left: view.left + (room - size) / 2.0,
                          bottom: view.bottom + (view.height - size) / 2.0, size: size}

    def preview_rect(window_width: f64, window_height: f64) -> Square:
        can Abort.Panic:
            view: JigsawKernelCanvas = canvas(window_width, window_height)
            by_width: f64 = view.width * 0.24
            by_height: f64 = view.height * 0.5
            size: f64 = by_height if by_height < by_width else by_width
            return Square{left: view.left + view.width - size,
                          bottom: view.bottom + view.height - size, size: size}

    # Tiles are laid TOP-DOWN: position 0 is the top-left corner, so a row is
    # measured down from the board's top edge rather than up from its bottom.
    def tile_rect(window_width: f64, window_height: f64, preview: bool, side: i64, position: i64, rows: i64 = 0) -> Rect:
        can Abort.Panic:
            board: Square = board_rect(window_width, window_height, preview)
            height_count: i64 = rows if rows > 0 else side
            spans: JigsawLayout::TileSpans = JigsawLayout::spans(board.size, side, height_count)
            row: f64 = (position / side).f64()
            column: f64 = (position % side).f64()
            left: f64 = board.left + column * (spans.width + spans.seam)
            top: f64 = board.bottom + board.size - row * (spans.height + spans.seam)
            return Rect{left: left, bottom: top - spans.height, width: spans.width, height: spans.height}

    def tile_at(window_width: f64, window_height: f64, preview: bool, side: i64, x: f64, y: f64, rows: i64 = 0, video: bool = false) -> i64:
        can Abort.Panic:
            view: JigsawKernelCanvas = canvas(window_width, window_height)
            aspect: f64 = 4.0 / 3.0 if video else 1.0
            room: f64 = view.width * (0.72 if preview else 1.0)
            width: f64 = room if room < view.height * aspect else view.height * aspect
            height: f64 = width / aspect
            left: f64 = view.left + (room - width) / 2.0
            bottom: f64 = view.bottom + (view.height - height) / 2.0
            return -1 if width <= 0.0 or x < left or x > left + width or y < bottom or y > bottom + height
            height_count: i64 = rows if rows > 0 else side
            spans: JigsawLayout::TileSpans = JigsawLayout::spans_for(width, height, side, height_count)
            column: i64 = ((x - left) / (spans.width + spans.seam)).i64()
            row: i64 = ((bottom + height - y) / (spans.height + spans.seam)).i64()
            return (height_count - 1 if row >= height_count else row) * side + (side - 1 if column >= side else column)

    # --- a run -----------------------------------------------------------

    struct JigsawKernelRun:
        video: mutable bool
        start_side: mutable i64
        start_pieces: mutable i64
        pieces: mutable i64
        trial_rows: mutable i64
        total_puzzles: mutable i64
        adaptive: mutable bool
        preview: mutable bool
        side: mutable i64
        trial_side: mutable i64
        puzzle: mutable i64
        order: mutable darray[i64]
        seen: mutable darray[i64]
        par: mutable i64
        swaps: mutable i64
        picked: mutable i64
        started_at: mutable f64
        feedback_until: mutable f64
        phase: mutable i64
        verdict: mutable i64
        result_count: mutable i64
        result_side: mutable darray[i64]
        result_pieces: mutable darray[i64]
        result_efficiency: mutable darray[f64]
        result_took: mutable darray[f64]

    def new_run(tile_capacity: i64 = LARGEST_SIDE * LARGEST_SIDE) -> JigsawKernelRun:
        can Memory.Allocate, Abort.Panic:
            return JigsawKernelRun{video: false, start_side: SMALLEST_SIDE, start_pieces: 0, pieces: 0, trial_rows: SMALLEST_SIDE, total_puzzles: 0, adaptive: false,
                       preview: false, side: SMALLEST_SIDE, trial_side: SMALLEST_SIDE,
                       puzzle: 0, order: Ints::zeros(tile_capacity), seen: Ints::zeros(tile_capacity),
                       par: 0, swaps: 0, picked: -1, started_at: 0.0, feedback_until: 0.0,
                       phase: PHASE_READY, verdict: -1, result_count: 0,
                       result_side: Ints::zeros(MOST_PUZZLES),
                       result_pieces: Ints::zeros(MOST_PUZZLES),
                       result_efficiency: Floats::zeros(MOST_PUZZLES),
                       result_took: Floats::zeros(MOST_PUZZLES)}

    def reset(run: mutable JigsawKernelRun&):
        can Abort.Panic:
            run.puzzle <- 0
            run.result_count <- 0
            run.picked <- -1
            run.phase <- PHASE_READY
            run.verdict <- -1

    def finish(run: mutable JigsawKernelRun&):
        can Abort.Panic:
            run.phase <- PHASE_DONE

    def next_puzzle(run: mutable JigsawKernelRun&, now: f64, rng: mutable MT19937&):
        can Abort.Panic:
            if run.puzzle >= run.total_puzzles:
                finish(run)
                return
            run.puzzle <- run.puzzle + 1
            run.trial_side <- piece_columns(run.pieces, run.video) if run.pieces > 0 else run.side
            run.trial_rows <- piece_rows(run.pieces, run.trial_side, run.video) if run.pieces > 0 else run.trial_side
            deal(run, now, rng)

    def deal(run: mutable JigsawKernelRun&, now: f64, rng: mutable MT19937&):
        can Abort.Panic:
            scramble(&run.order, run.trial_side, rng, run.trial_rows)
            run.par <- minimum_swaps(&run.order, run.trial_side * run.trial_rows, &run.seen)
            run.swaps <- 0
            run.picked <- -1
            run.verdict <- -1
            run.started_at <- now
            run.phase <- PHASE_SOLVING

    def start_run(run: mutable JigsawKernelRun&, now: f64, rng: mutable MT19937&):
        can Abort.Panic:
            reset(run)
            run.side <- run.start_side if run.start_pieces > 0 else clamped(run.start_side)
            run.pieces <- run.start_pieces
            next_puzzle(run, now, rng)

    def solved(run: mutable JigsawKernelRun&, now: f64):
        can Abort.Panic:
            took: f64 = now - run.started_at
            divisor: i64 = run.swaps if run.swaps > run.par else run.par
            efficiency: f64 = run.par.f64() / divisor.f64()
            Ints::put(&run.result_side, run.result_count, run.trial_side)
            Ints::put(&run.result_pieces, run.result_count, run.trial_side * run.trial_rows)
            Floats::put(&run.result_efficiency, run.result_count, efficiency)
            Floats::put(&run.result_took, run.result_count, took)
            run.result_count <- run.result_count + 1
            if run.adaptive and run.pieces > 0:
                if efficiency >= GROW_AT:
                    run.pieces <- adjacent_piece_grid(run.pieces, 1, run.video)
                elif efficiency < SHRINK_AT:
                    run.pieces <- adjacent_piece_grid(run.pieces, -1, run.video)
                run.side <- piece_columns(run.pieces, run.video)
            elif run.adaptive:
                if efficiency >= GROW_AT:
                    run.side <- clamped(run.side + 1)
                else:
                    if efficiency < SHRINK_AT:
                        run.side <- clamped(run.side - 1)
            run.phase <- PHASE_SOLVED
            run.feedback_until <- now + FEEDBACK_SECONDS
            # Green means the fewest swaps this scramble could be undone in,
            # which is exact.
            run.verdict <- 1 if run.swaps <= run.par else 0

    # First click marks a tile; the second swaps the two.
    #
    # A position off the end of the board is refused. A click cannot produce
    # one, but a caller driving the task directly can, and a swap against an
    # index nothing is at would corrupt the permutation rather than fail.
    def pick(run: mutable JigsawKernelRun&, position: i64, now: f64):
        can Abort.Panic:
            count: i64 = run.trial_side * run.trial_rows
            return if run.phase != PHASE_SOLVING or position < 0 or position >= count
            if run.picked < 0:
                run.picked <- position
            else:
                if run.picked == position:
                    run.picked <- -1
                else:
                    held: i64 = Ints::at_ref(&run.order, run.picked)
                    Ints::put(&run.order, run.picked, Ints::at_ref(&run.order, position))
                    Ints::put(&run.order, position, held)
                    run.swaps <- run.swaps + 1
                    run.picked <- -1
                    if is_solved(&run.order, count):
                        solved(run, now)

    def update(run: mutable JigsawKernelRun&, now: f64, rng: mutable MT19937&):
        can Abort.Panic:
            if run.phase == PHASE_SOLVED and now >= run.feedback_until:
                next_puzzle(run, now, rng)

    struct JigsawScore:
        puzzles: i64
        efficiency: i64
        mean_seconds: f64
        best_side: i64
        most_pieces: i64

    # How the run went, on both of its axes. Efficiency is reported beside the
    # time because they trade against each other: swapping fast and loose
    # finishes sooner and scores lower.
    def score(run: mutable JigsawKernelRun&) -> JigsawScore:
        can Abort.Panic:
            total_efficiency: mutable f64 = 0.0
            total_seconds: mutable f64 = 0.0
            best_side: mutable i64 = 0
            most_pieces: mutable i64 = 0
            for at in 0..<run.result_count |run, total_efficiency, total_seconds, best_side, most_pieces|:
                total_efficiency <- total_efficiency + Floats::at_ref(&run.result_efficiency, at)
                total_seconds <- total_seconds + Floats::at_ref(&run.result_took, at)
                side: i64 = Ints::at_ref(&run.result_side, at)
                best_side <- side if side > best_side
                pieces: i64 = Ints::at_ref(&run.result_pieces, at)
                most_pieces <- pieces if pieces > most_pieces
            efficiency: mutable i64 = 0
            mean_seconds: mutable f64 = 0.0
            if run.result_count > 0:
                efficiency <- py_round_half_even(100.0 * total_efficiency / run.result_count.f64())
                mean_seconds <- total_seconds / run.result_count.f64()
            return JigsawScore{puzzles: run.result_count, efficiency: efficiency,
                         mean_seconds: mean_seconds, best_side: best_side, most_pieces: most_pieces}
