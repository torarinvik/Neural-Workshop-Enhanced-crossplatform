include "./sheet.elisa"

module SheetText:
    # The words sheet.py and ui/sheet.py put on screen.

    def question(out: mutable dstr&, puzzle: Sheet::Puzzle&):
        can Memory.Allocate, Abort.Panic:
            if puzzle.kind == Sheet::LOOKUP:
                dstr_append_cstr(out, "What is the Total for the ")
                Sheet::item_text(&puzzle.rows[puzzle.subject.usize()], out)
                dstr_append_cstr(out, "?")
            elif puzzle.kind == Sheet::MAX:
                dstr_append_cstr(out, "Which row has the highest Total? Type its ID.")
            elif puzzle.kind == Sheet::SUM:
                dstr_append_cstr(out, "What do the Totals of the ")
                dstr_append_cstr(out, Sheet::category_name(puzzle.subject))
                dstr_append_cstr(out, " rows add up to?")
            elif puzzle.kind == Sheet::COUNT:
                dstr_append_cstr(out, "How many ")
                dstr_append_cstr(out, Sheet::category_name(puzzle.subject))
                dstr_append_cstr(out, " rows have a Qty over ")
                dstr_append_i64(out, puzzle.bar)
                dstr_append_cstr(out, "?")
            elif puzzle.kind == Sheet::WRONG:
                dstr_append_cstr(out, "One row's Total is not Qty times Price. Type its ID.")
            else:
                dstr_append_cstr(out, "One row's Total is not Qty times Price. Type the Total it should have.")

    # The status bar under the sum buttons.
    def status(out: mutable dstr&, state: Sheet::Workbook&):
        can Memory.Allocate, Abort.Panic:
            if state.stat < 0:
                dstr_append_cstr(out, "pick a Sum button to see the visible rows added up")
                return
            figures: Sheet::Stats = Sheet::stats(state)
            dstr_append_cstr(out, Sheet::column_label(state.stat))
            dstr_append_cstr(out, " of visible rows:  sum ")
            dstr_append_i64(out, figures.sum)
            dstr_append_cstr(out, "   count ")
            dstr_append_i64(out, figures.count)
            dstr_append_cstr(out, "   largest ")
            dstr_append_i64(out, figures.largest)

    # A cell as drawn: the row's value in a column.
    def cell(out: mutable dstr&, row: Sheet::Row&, column: i64):
        can Memory.Allocate, Abort.Panic:
            if column == Sheet::ITEM:
                Sheet::item_text(row, out)
            elif column == Sheet::CATEGORY:
                dstr_append_cstr(out, Sheet::category_name(row.category))
            else:
                dstr_append_i64(out, Sheet::value(row, column))

    def typed(out: mutable dstr&, state: Sheet::Workbook&):
        can Memory.Allocate, Abort.Panic:
            for at in 0..<state.typed_count |out, state|:
                dstr_append_i64(out, state.typed[at.usize()])
