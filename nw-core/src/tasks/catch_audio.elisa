include "./catch.elisa"
include "../tone_pcm.elisa"

module CatchAudio:
    struct Cue:
        note: TonePcm::Note
        voice: i64

    def pluck() -> TonePcm::Patch:
        can Abort.Panic:
            parts: mutable TonePcm::Partial[6] = zeroed
            for i in 0..<6 |parts|:
                ratio: f64 = (i + 1).f64()
                parts[i.usize()] <- TonePcm::Partial{ratio: ratio,
                    gain: (1.0 / ratio) * (1.0 if i == 0 else 0.928901697685371),
                    decay: 1.3903092732337203 * ratio}
            return TonePcm::Patch{partials: parts, count: 6, attack: 0.003, decay: 4.277946989549786,
                release: 0.1, sustain: 0.0, tremolo_rate: 0.0, tremolo_depth: 0.0}

    def flute(frequency: f64) -> TonePcm::Patch:
        parts: TonePcm::Partial[6] = [
            TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
            TonePcm::Partial{ratio: 2.0, gain: 0.15 * 0.6993681904144294, decay: 0.0},
            TonePcm::Partial{ratio: 3.0, gain: 0.05 * 0.6993681904144294, decay: 0.0},
            zeroed, zeroed, zeroed]
        safe: f64 = 0.42 * TonePcm::RATE.f64()
        count: i64 = 3 if 3.0 * frequency < safe else (2 if 2.0 * frequency < safe else 1)
        return TonePcm::Patch{partials: parts, count: count, attack: 0.06, decay: 0.5,
            sustain: 0.7, release: 0.15, tremolo_rate: 0.0, tremolo_depth: 0.0}

    def wood() -> TonePcm::Patch:
        parts: TonePcm::Partial[6] = [
            TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
            TonePcm::Partial{ratio: 3.797806204565837, gain: 0.5 * 0.6155722066724582, decay: 6.0},
            TonePcm::Partial{ratio: 9.240690887272274, gain: 0.25 * 0.6155722066724582, decay: 12.0},
            zeroed, zeroed, zeroed]
        return TonePcm::Patch{partials: parts, count: 3, attack: 0.002, decay: 8.765919299786542,
            sustain: 0.0, release: 0.05, tremolo_rate: 0.0, tremolo_depth: 0.0}

    def append(cues: mutable darray[Cue]&, cue: Cue):
        can Memory.Allocate, Abort.Panic:
            cues.push(cue)
            at: mutable i64 = cues.count.i64() - 1
            while at > 0 |cues, at, cue|:
                prev: Cue = cues[(at - 1).usize()]
                break if prev.note.onset <= cue.note.onset
                cues[at.usize()] <- prev
                at <- at - 1
            cues[at.usize()] <- cue

    def plain(onset: f64, duration: f64, frequency: f64, pan: f64, gain: f64, seed: i64) -> TonePcm::Note:
        return TonePcm::Note{onset: onset, duration: duration, frequency: frequency, pan: pan, end_pan: pan,
            gain: gain, end_gain: gain, vibrato_rate: 0.0, vibrato_depth: 0.0, noise: 0.0, glide: 0.0, glide_time: 0.0, seed: seed}

    def schedule(court: Catch::Court&, begin: f64, end: f64) -> darray[Cue]:
        can Memory.Allocate, Abort.Panic:
            cues: mutable darray[Cue] = []
            seed: mutable i64 = 0
            walls: bool = court.level.walls
            for i in 0..<court.level.count |court, begin, end, cues, seed, walls|:
                ball: Catch::Ball = court.balls[i.usize()]
                break if ball.t0 >= end
                seed <- seed + 1
                if ball.t0 + (0.08 + 0.1) > begin:
                    note: TonePcm::Note = plain(ball.t0, 0.08, 330.0, ball.x0 / Catch::HALF, 0.35, seed)
                    append(&cues, Cue{note: note, voice: 0})
                step: mutable f64 = 0.06
                while step < ball.flight |ball, step, seed, begin, end, cues, walls|:
                    onset: f64 = ball.t0 + step
                    seed <- seed + 1
                    if onset < end and onset + (0.09 + 0.15) > begin:
                        p: Catch::Position = Catch::where(ball, onset, walls)
                        next: Catch::Position = Catch::where(ball, onset + 0.08, walls)
                        note: TonePcm::Note = TonePcm::Note{onset: onset, duration: 0.09, frequency: 500.0 + 60.0 * p.y,
                            pan: p.x / Catch::HALF, end_pan: next.x / Catch::HALF,
                            gain: 0.06 + 0.3 * (1.0 - p.z / Catch::LONG), end_gain: 0.06 + 0.3 * (1.0 - next.z / Catch::LONG),
                            vibrato_rate: 5.45603427188925, vibrato_depth: 0.004, noise: 0.07626958481883091,
                            glide: 0.0, glide_time: 0.0, seed: seed}
                        append(&cues, Cue{note: note, voice: 1})
                    step <- step + 0.08
                seed <- seed + 1
                landing: f64 = ball.t0 + ball.flight
                thud: f64 = landing + 0.06
                if thud < end and thud + (0.12 + 0.05) > begin:
                    p: Catch::Position = Catch::where(ball, landing, walls)
                    note: TonePcm::Note = plain(thud, 0.12, 110.0, p.x / Catch::HALF, 0.45, seed)
                    append(&cues, Cue{note: note, voice: 2})
            return cues

    def render(court: Catch::Court&, begin: f64, end: f64, dest: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 0 if not (begin >= 0.0 and end > begin and end - begin <= 60.0)
            frames: i64 = py_round_half_even((end - begin) * TonePcm::RATE.f64())
            return 0 if frames < 1 or frames > capacity / TonePcm::FRAME_BYTES
            stereo: mutable darray[f64] = TonePcm::empty(frames)
            cues: darray[Cue] = schedule(court, begin, end)
            pop: TonePcm::Patch = pluck()
            thud: TonePcm::Patch = wood()
            for i in 0..<cues.count.i64() |cues, begin, end, stereo, frames, pop, thud|:
                cue: Cue = cues[i.usize()]
                if cue.voice == 0:
                    TonePcm::mix_note(&stereo, frames, begin, end, &pop, &cue.note)
                elif cue.voice == 2:
                    TonePcm::mix_note(&stereo, frames, begin, end, &thud, &cue.note)
                else:
                    whistle: TonePcm::Patch = flute(cue.note.frequency)
                    TonePcm::mix_note(&stereo, frames, begin, end, &whistle, &cue.note)
            return TonePcm::write(stereo, frames, dest)
