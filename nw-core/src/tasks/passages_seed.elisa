tient\nhospital\nteacher\nstudent\nlesson\nclass\nexam\ngrade\npencil\nchalk\ndrum\nflute\nhorn\nstring\ndance\nstage\nactor\nplay\nscene\npaint\nbrush\ncanvas\nimage\npicture\nphotograph\ncamera\nfilm\nharvest\nplough\ncrop\ngrain\nflour\noven\nthread\nneedle\ncoat\nshirt\ndress\nshoe\nhat\nglove\nbelt\nbutton\nclock\nwatch\nbell\nalarm\nsignal\nflag\nmark\nsign\nsymbol\ncode\nmessage\ntravel\njourney\nmap\nguide\nroute\ndistance\nspeed\ndirection\nnation\npeople\ntribe\nparent\nmother\nfather\nbrother\nsister\nson\ndaughter\nuncle\naunt\ncousin\nnephew\nniece\nhusband\nwife\nwidow\norphan\nwalked\na\nsat\nruns\nhours\nbeard\nwe\nnear\ncame\nworks\nin\non\nstreet\ngoes\nbehind\nbuilt\nsang\noutside\nhe\nfell\nmy\nwrote\nto\nkept\nkey\nburned\nuntil\nof\nan\nit\nstood\nlearned\nflew\nwent\nup\nagain\npocket\nis\ngave\nat\nby\nlost\nleaves\nstands\nevery\nclear\nturns\nreaches\ntold\nstories\nacross\nput\ngrew\ngrey\nstones\nworked\nsaw\nbecame\nhills\nheld\nhands\nwar\nfind\npictures\nran\nfarmer\nasked\nturned\nnothing\nstation\ncarried\nstairs\ncoast\nopened\nlooked\ncross\nbirds", false, true)

    struct Corpus:
        bank: Passages::Bank
        pairs: Passages::Index
        known: Passages::Index

    def corpus(bank: Passages::Bank, sentences: Passages::Bank, vocabulary: Passages::Bank) -> Corpus:
        can Memory.Allocate, Abort.Panic:
            return Corpus{bank: bank, pairs: Passages::index(&sentences, &bank), known: Passages::known(&vocabulary)}

    def offline() -> Corpus:
        can Memory.Allocate, Abort.Panic:
            return corpus(passages(), sentences(), vocabulary())
