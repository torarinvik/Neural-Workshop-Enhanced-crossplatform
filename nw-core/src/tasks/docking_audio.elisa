include "./docking.elisa"
include "./drshape_audio.elisa"

module DockingAudio:
    def render(run: Docking::Run&, begin: f64, end: f64, output: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 0 if not (end > begin) or capacity < 4
            requested: f64 = (end - begin) * TonePcm::RATE.f64()
            return 0 if requested > (capacity / 4).f64() + 0.5
            frames: i64 = py_round_half_even(requested)
            return 0 if frames <= 0 or frames > capacity / 4
            stereo: mutable darray[f64] = TonePcm::empty(frames)
            if (run.result == Docking::CLEAR or run.result == Docking::CONTACT) and run.t < end:
                passed: bool = run.result == Docking::CLEAR
                voice: i64 = 1 if passed else 2
                gain: f64 = 0.3 if passed else 0.5
                rng: mutable MT19937 = zeroed
                mt_seed_int(&rng, (voice + 1).u64())
                patch: DrShapeAudio::Patch = DrShapeAudio::make_patch(DrShapeAudio::BELL if passed else DrShapeAudio::GROWL, &rng, 0.0)
                note: DrShapeDeal::Note = DrShapeDeal::Note{t: run.t, dur: 0.4 if passed else 0.5,
                    freq: 880.0 if passed else 90.0, pan: 0.0, pan2: 0.0, gain: gain, gain2: gain,
                    bright: 0.8, voice: voice, seed: 1, who: -1, room: 0.0}
                DrShapeAudio::mix(&stereo, frames, begin, end, TonePcm::RATE, &patch, &note)
            return TonePcm::write(stereo, frames, output)
