include "./signals_reference.elisa"

module SignalsGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const FLAGGED: i64 = 4
    const SEND: i64 = Signals::MOST_OBJECTS
    const START: i64 = SEND + Signals::GLYPHS
    const FEEDBACK_MS: i64 = 2800

    struct Session:
        rng: mutable MT19937
        start_rung: i64
        trials: i64
        adaptive: bool
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        game: mutable Signals::Game
        par: mutable f64
        won: mutable bool
        passed: mutable i64
        best: mutable i64
        last_ms: mutable i64
        deadline: mutable i64
        think_capacity: mutable f64
        think_refill: mutable f64
        think_left: mutable f64
        stepped_seconds: mutable f64
        verdict_published: mutable bool
        forfeits: mutable i64

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 8 or rung == 12 or rung == 16 or rung == 20 or rung == 21 or rung == 25 or rung == 30

    def allowed_total(trials: i64) -> bool:
        return trials == 1 or trials == 3 or trials == 5 or trials == 8

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = zeroed
            mt_seed_int(&rng, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
            initial: i64 = rung if rung > 0 else 1
            return Session{rng: rng, start_rung: initial, trials: trials, adaptive: adaptive,
                rung: initial, trial: 0, phase: READY, game: zeroed, par: 0.0, won: false,
                passed: 0, best: 0, last_ms: 0, deadline: 0,
                think_capacity: 0.0, think_refill: 0.0, think_left: 0.0,
                stepped_seconds: 0.0, verdict_published: false, forfeits: 0}

    def next_trial(session: mutable Session&, now: i64):
        can Memory.Allocate, Memory.Release, Abort.Panic:
            session.last_ms <- now
            if session.trial >= session.trials:
                session.phase <- DONE
                session.game <- zeroed
                return
            seed: i64 = py_randbelow(&session.rng, 1073741824.u64()).i64()
            # The deal and game contain only inline data. The RNG's temporary
            # shuffle and sample arrays can be freed immediately.
            region scratch(65536):
                in scratch:
                    dealt: Signals::Deal = Signals::deal(session.rung, seed)
                    session.game <- Signals::initialize(dealt)
                    session.par <- SignalsReference::par(&dealt)
            session.trial <- session.trial + 1
            session.phase <- PLAYING

    def judge(session: mutable Session&, now: i64):
        session.won <- session.game.score.f64() >= session.par - 0.000000001
        if session.won:
            session.passed <- session.passed + 1
            session.best <- session.rung if session.rung > session.best
        if session.adaptive:
            session.rung <- session.rung + 1 if session.won and session.rung < 9223372036854775807
            session.rung <- session.rung - 1 if not session.won and session.rung > 1
        session.verdict_published <- false
        session.phase <- JUDGED
        session.deadline <- now + FEEDBACK_MS

    def event(session: mutable Session&, port: i64, now: i64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if now < session.last_ms or now > 9223372036854775807 - FEEDBACK_MS
            if port == START:
                return false if (session.phase != READY and session.phase != DONE) or session.trials < 1
                session.rung <- session.start_rung
                session.trial <- 0
                session.passed <- 0
                session.best <- 0
                session.forfeits <- 0
                session.think_left <- session.think_capacity
                next_trial(session, now)
                return true
            return false if session.phase != PLAYING or port < 0 or port >= START
            exchange: Signals::Exchange& = &session.game.deal.exchanges[session.game.at.usize()]
            if port < SEND:
                return false if exchange.role != Signals::LISTEN or port >= session.game.deal.level.objects
                _ = Signals::pick(&session.game, port)
            else:
                return false if exchange.role != Signals::SPEAK
                _ = Signals::say(&session.game, port - SEND)
            session.last_ms <- now
            if session.game.at == session.game.deal.level.exchanges:
                judge(session, now)
            return true

    def advance(session: mutable Session&, now: i64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if session.phase != JUDGED or now < session.deadline or now > 9223372036854775807 - FEEDBACK_MS
            next_trial(session, now)
            return true

    def configure_think(session: mutable Session&, capacity: f64, refill: f64) -> bool:
        return false if session.phase != READY or not (capacity >= 0.0 and capacity <= 1.7976931348623157e308)
        return false if not (refill >= 0.0 and refill <= 1.7976931348623157e308)
        session.think_capacity <- capacity
        session.think_refill <- (refill if refill < capacity else capacity)
        session.think_left <- capacity
        return true

    def step(session: mutable Session&, elapsed_seconds: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
            now: f64 = session.stepped_seconds + elapsed_seconds
            return false if not (elapsed_seconds > 0.0 and now <= 9007199254740.0)
            return false if session.phase == READY or session.phase == DONE
            session.stepped_seconds <- now
            if session.phase == PLAYING:
                if session.think_capacity > 0.0:
                    session.think_left <- session.think_left - elapsed_seconds
                    if session.think_left <= 0.000000001:
                        session.think_left <- 0.0
                        session.phase <- FLAGGED
                        session.forfeits <- session.forfeits + 1
                return true
            if session.phase == JUDGED and not session.verdict_published:
                session.verdict_published <- true
                return true
            # The stepped boundary displays one verdict frame before dealing again.
            next_trial(session, session.last_ms)
            if session.phase == PLAYING:
                room: f64 = session.think_capacity - session.think_left
                session.think_left <- session.think_left + (room if room < session.think_refill else session.think_refill)
            return true

    def info(session: Session&, field: i64) -> i64:
        return session.phase if field == 0
        return session.rung if field == 1
        return session.trial if field == 2
        return session.trials if field == 3
        return session.game.at if field == 4
        return (1 if session.won else 0) if field == 5 and session.phase == JUDGED
        return session.passed if field == 6
        return session.best if field == 7
        return session.deadline if field == 8 and session.phase == JUDGED
        return session.game.score if field == 9
        return session.game.deal.level.exchanges if field == 10
        return session.game.deal.exchanges[session.game.at.usize()].role if field == 11 and session.phase == PLAYING
        return session.forfeits if field == 12
        return -1
