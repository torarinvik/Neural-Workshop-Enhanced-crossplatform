include "./toneofvoice.elisa"
include "./reading_quiz_audio.elisa"

module ToneOfVoiceAudio:
    # toneofvoice.mix: the quiz's notes, and over them each item's voice
    # twice (a gap between) with the hiss behind it; stereo 16-bit PCM.
    def render(run: ReadingQuiz::Run&, level: ToneOfVoice::Grade, voices: darray[darray[f64]]&, starts: darray[f64]&,
            begin: f64, end: f64, output: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            written: i64 = ReadingQuizAudio::render(run, begin, end, output, capacity)
            frames: i64 = written / 4
            return written if frames <= 0
            out: mutable darray[f64] = []
            for _ in 0..<frames |out|:
                out.push(0.0)
            rate: f64 = ToneOfVoice::RATE.f64()
            heard: i64 = starts.count.i64()
            for k in 0..<heard |out, frames, voices, starts, level, begin, heard, rate|:
                continue if k >= voices.count.i64()
                src: darray[f64]& = &voices[k.usize()]
                n: i64 = src.count.i64()
                start: f64 = starts[k.usize()]
                for hearing in 0..<2 |out, frames, src, n, start, level, begin, heard, rate, k|:
                    at: f64 = start + ToneOfVoice::LEAD + (0.0 if hearing == 0 else n.f64() / rate + ToneOfVoice::GAP)
                    a: i64 = py_round_half_even((at - begin) * rate)
                    lo: i64 = a if a > 0 else 0
                    hi: i64 = a + n if a + n < frames else frames
                    for i in lo..<hi |out, src, a|:
                        out[i.usize()] <- out[i.usize()] + src[(i - a).usize()]
                    if level.hiss > 0.0 and hi > lo:
                        # _hiss(k + 7 * len(starts), n): the same noise both times.
                        noise: mutable MT19937 = zeroed
                        mt_seed_int(&noise, (k + 7 * heard).u64())
                        for j in 0..<(hi - a) |noise, out, lo, a, level|:
                            value: f64 = py_uniform(&noise, -1.0, 1.0)
                            if a + j >= lo:
                                out[(a + j).usize()] <- out[(a + j).usize()] + level.hiss * value
            for i in 0..<frames |out, output|:
                v: f64 = out[i.usize()]
                s: i64 = ((1.0 if v > 1.0 else (-1.0 if v < -1.0 else v)) * 30000.0).i64()
                for c in 0..<2 |output, s, i|:
                    offset: usize = (4 * i + 2 * c).usize()
                    pcm: i64 = (output[offset].i64() | (output[offset + 1.usize()].i64() << 8)) & 65535
                    signed: i64 = pcm - 65536 if pcm >= 32768 else pcm
                    sum: i64 = signed + s
                    clamped: i64 = 32767 if sum > 32767 else (-32767 if sum < -32767 else sum)
                    bits: i64 = clamped & 65535
                    output[offset] <- (bits & 255).u8()
                    output[offset + 1.usize()] <- (bits >> 8).u8()
            return written
