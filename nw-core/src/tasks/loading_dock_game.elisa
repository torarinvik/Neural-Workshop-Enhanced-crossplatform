include "./loading_dock_audio.elisa"

module LoadingDockGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = LoadingDock::PORTS
    const CLEAR: i64 = START + 1
    const DRIVE_DOWN: i64 = CLEAR + 1
    const DRIVE_UP: i64 = DRIVE_DOWN + 8
    const LAST_ACTION: i64 = DRIVE_UP + 7
    const SUBSTEP: f64 = 1.0 / 120.0

    struct TrialResult:
        rung: i64
        verdict: i64

    struct Session:
        rng: mutable MT19937
        start_rung: i64
        total: i64
        adaptive: bool
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        owner: mutable Arena
        run: mutable LoadingDock::Run
        last_tick: mutable f64
        deadline: mutable f64
        audio_elapsed: mutable f64
        heard_to: mutable f64
        passed: mutable i64
        best: mutable i64
        deal_failed: mutable bool
        verdict_published: mutable bool
        results: mutable TrialResult[20]
        held: mutable i64
        pulse: mutable i64

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
            initial: i64 = rung if rung > 0 else 1
            return Session{rng: rng, start_rung: initial, total: total, adaptive: adaptive,
                rung: initial, trial: 0, phase: READY, owner: zeroed, run: zeroed, last_tick: 0.0,
                deadline: 0.0, audio_elapsed: 0.0, heard_to: 0.0, passed: 0, best: 0,
                deal_failed: false, verdict_published: false, results: zeroed, held: 0, pulse: 0}

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 10 or total == 20

    def release_trial(owner: mutable Arena&):
        can Memory.Release, Abort.Panic:
            arena_free(owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}

    def make_trial(owner: mutable Arena&, rng: mutable MT19937&, rung: i64) -> LoadingDock::Run:
        can Memory.Allocate, Abort.Panic:
            in owner:
                dock: LoadingDock::Dock = LoadingDock::deal(rung, rng)
                run: mutable LoadingDock::Run = LoadingDock::initialize(dock, true)
                _ = run.notes.reserve(64.usize())
                return run

    def next_trial(session: mutable Session&, now: f64):
        can Memory.Allocate, Memory.Release, Abort.Panic:
            session.last_tick <- now
            session.audio_elapsed <- 0.0
            session.heard_to <- 0.0
            session.verdict_published <- false
            session.held <- 0
            session.pulse <- 0
            if session.trial >= session.total:
                session.phase <- DONE
                return
            release_trial(&session.owner) can Global{Read,Write}
            session.run <- make_trial(&session.owner, &session.rng, session.rung)
            session.deal_failed <- not session.run.dock.valid
            if session.deal_failed:
                session.phase <- READY
                return
            session.trial <- session.trial + 1
            session.phase <- PLAYING

    def start(session: mutable Session&, now: f64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if session.phase != READY and session.phase != DONE
            return false if not allowed_total(session.total) or not (now >= 0.0 and now <= 9007199254740.0)
            session.rung <- session.start_rung
            session.passed <- 0
            session.best <- 0
            session.trial <- 0
            session.results <- zeroed
            next_trial(session, now) can Global{Read,Write}
            return session.phase == PLAYING

    def close(session: mutable Session&):
        can Memory.Release, Abort.Panic:
            release_trial(&session.owner) can Global{Read,Write}
            session.phase <- READY
            session.run <- zeroed

    def apply(owner: mutable Arena&, run: mutable LoadingDock::Run&, port: i64):
        can Memory.Allocate, Abort.Panic:
            in owner:
                LoadingDock::act(run, port)

    def clear_controls(session: mutable Session&) -> bool:
        can Abort.Panic:
            changed: bool = session.held != 0 or session.pulse != 0 or session.run.hand.down
            session.held <- 0
            session.pulse <- 0
            session.run.hand.down <- false
            session.run.pressed <- -1
            if session.phase == PLAYING:
                if session.run.drag == LoadingDock::FROM_SHELF:
                    session.run.empty_until[session.run.drag_slot.usize()] <- 0.0
                elif session.run.drag == LoadingDock::FROM_FORK:
                    session.run.carried[session.run.carried_count.usize()] <- session.run.drag_kind
                    session.run.carried_count <- session.run.carried_count + 1
                session.run.drag <- LoadingDock::NO_DRAG
            return changed

    def drive_key(session: mutable Session&, index: i64, down: bool) -> bool:
        return false if session.phase != PLAYING or index < 0 or index >= 8
        bit: i64 = 1 << index
        held: i64 = (session.held | bit) if down else (session.held & (255 - bit))
        return false if held == session.held
        session.held <- held
        return true

    def input(session: mutable Session&, action: i64, now: f64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return (start(session, now) can Global{Read,Write}) if action == START
            return clear_controls(session) if action == CLEAR
            if action >= DRIVE_DOWN and action <= LAST_ACTION:
                return drive_key(session, action - (DRIVE_DOWN if action < DRIVE_UP else DRIVE_UP), action < DRIVE_UP)
            return false if session.phase != PLAYING or session.run.result != LoadingDock::PENDING or action < 0 or action >= START
            if action >= LoadingDock::FWD:
                session.pulse <- 1 << (action - LoadingDock::FWD)
            else:
                apply(&session.owner, &session.run, action)
            return true

    def pointer_event(session: mutable Session&, x: f64, y: f64, kind: i64, now: f64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            if kind == 1 and (session.phase == READY or session.phase == DONE):
                return start(session, now) can Global{Read,Write}
            return false if session.phase != PLAYING or session.run.result != LoadingDock::PENDING or kind < 0 or kind > 2
            HandView::place(&session.run.hand, (x - HandView::VIEW_LEFT) / HandView::VIEW_SCALE, (y - HandView::VIEW_BOTTOM) / HandView::VIEW_SCALE)
            if kind != 0:
                apply(&session.owner, &session.run, HandView::PRESS if kind == 1 else HandView::RELEASE)
            return true

    def judge(session: mutable Session&, now: f64):
        session.results[(session.trial - 1).usize()] <- TrialResult{rung: session.rung, verdict: session.run.result}
        passed: bool = session.run.result == LoadingDock::SUCCESS
        if passed:
            session.passed <- session.passed + 1
            session.best <- session.rung if session.rung > session.best
        if session.adaptive:
            session.rung <- session.rung + 1 if passed and session.rung < 9223372036854775807
            session.rung <- session.rung - 1 if not passed and session.rung > 1
        session.phase <- JUDGED
        session.deadline <- now + 2.5

    def simulate(owner: mutable Arena&, run: mutable LoadingDock::Run&, dt: f64, mask: i64):
        can Memory.Allocate, Abort.Panic:
            ratio: f64 = dt / SUBSTEP
            whole: i64 = ratio.i64()
            steps: i64 = whole + 1 if ratio > whole.f64() else (1 if whole == 0 else whole)
            in owner:
                for _index in 0..<steps |run, dt, steps, mask|:
                    LoadingDock::tick(run, dt / steps.f64(), mask)
                    break if run.result != LoadingDock::PENDING

    def tick(session: mutable Session&, now: f64, agent: bool):
        can Memory.Allocate, Abort.Panic:
            dt: f64 = HandView::clamp(now - session.last_tick, 0.0, 0.1)
            prior: f64 = session.run.time
            session.last_tick <- now
            physical: i64 = (session.held | (session.held >> 4)) & 15
            mask: i64 = session.pulse if agent or session.pulse != 0 else physical
            session.pulse <- 0
            simulate(&session.owner, &session.run, dt, mask)
            session.audio_elapsed <- prior + dt if prior + dt > session.run.time else session.run.time
            if session.run.result != LoadingDock::PENDING:
                judge(session, now)

    def advance(session: mutable Session&, now: f64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if not (now >= session.last_tick and now <= 9007199254740.0)
            if session.phase == JUDGED:
                if now < session.deadline:
                    end: f64 = session.run.time + 0.9
                    return false if session.audio_elapsed >= end
                    session.audio_elapsed <- HandView::clamp(session.audio_elapsed + now - session.last_tick, 0.0, end)
                    session.last_tick <- now
                    return true
                next_trial(session, now) can Global{Read,Write}
                return true
            return false if session.phase != PLAYING
            tick(session, now, false)
            return true

    def agent_event(session: mutable Session&, now: f64, port: i64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if not (now >= session.last_tick and now <= 9007199254740.0)
            return (start(session, now) can Global{Read,Write}) if port == START
            if port >= 0 and port < START:
                return input(session, port, now) can Global{Read,Write}
            return false if port != -1
            if session.phase == JUDGED and session.verdict_published:
                next_trial(session, now) can Global{Read,Write}
                return true
            return false if session.phase != PLAYING
            tick(session, now, true)
            session.verdict_published <- session.phase == JUDGED
            return true

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            active: bool = session.phase == PLAYING or session.phase == JUDGED
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return py_round_half_even(session.run.time * 1000.0) if field == 4 and active
            return session.run.carried_count if field == 5 and active
            return session.run.dock.level.trucks if field == 6 and active
            return session.run.result if field == 7 and session.phase == JUDGED
            return session.passed if field == 8
            return session.best if field == 9
            return py_round_half_even(session.deadline * 1000.0) if field == 10 and session.phase == JUDGED
            return session.run.dock.level.kinds if field == 11 and active
            return session.run.camera if field == 12 and active
            return 1 if field == 13 and session.deal_failed
            return 0 if field == 13
            return -1

    def result_field(session: Session&, trial_index: i64, field: i64) -> i64:
        can Abort.Panic:
            return -1 if trial_index < 0 or trial_index >= session.trial
            result: TrialResult = session.results[trial_index.usize()]
            return -1 if result.verdict == LoadingDock::PENDING
            return result.rung if field == 0
            return result.verdict if field == 1
            return -1

    def audio_window(session: mutable Session&, dest: mutable u8&, capacity: i64, speaker: bool = false) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 0 if session.phase != PLAYING and session.phase != JUDGED
            elapsed: f64 = session.audio_elapsed - session.heard_to
            available: i64 = capacity / TonePcm::FRAME_BYTES
            return 0 if elapsed <= 0.0 or available < 1
            frames: i64 = py_round_half_even(elapsed * TonePcm::RATE.f64())
            return 0 if frames < 1
            end: f64 = session.audio_elapsed if frames <= available else session.heard_to + available.f64() / TonePcm::RATE.f64()
            lag: f64 = 0.15 if speaker else 0.0
            length: i64 = LoadingDockAudio::render(&session.run, session.heard_to - lag, end - lag, dest, capacity)
            session.heard_to <- end if length > 0
            return length
