include "../pyrandom.elisa"
include "../strings.elisa"
include "../pymath.elisa"

module Desktop:
    # desktop.py: a small computer to operate. Windows hold controls, a
    # card lists the settings to reach and the files to move, and every
    # click or drag costs one. Everything is in logical units on a 1000
    # by 640 screen, origin at the top left.
    const SCREEN_W: i64 = 1000
    const SCREEN_H: i64 = 640
    const TASKBAR_H: i64 = 40
    const WORK_H: i64 = 600
    const TITLE_H: i64 = 30
    const MENU_H: i64 = 26
    const TAB_H: i64 = 28
    const ROW_H: i64 = 36
    const APPLY_H: i64 = 38
    const WINDOW_W: i64 = 440
    const NOTE_W: i64 = 220
    const DIALOG_W: i64 = 400
    const ITEM_W: i64 = 160
    const ITEM_H: i64 = 30
    const GRID: i64 = 5
    const START_X: i64 = 500
    const START_Y: i64 = 320
    # A press and release closer than this is a click, not a drag.
    const STILL: i64 = 3
    const EXPLORER_W: i64 = 600
    const EXPLORER_H: i64 = 400
    const LIST_H: i64 = 26
    const CONTEXT_W: i64 = 150
    const MOST_TABS: i64 = 4
    const COLUMNS: i64 = 5
    const ICON_W: i64 = 84
    const ICON_H: i64 = 84
    const ICONS_PER_COLUMN: i64 = 6
    const TILE_W: i64 = 104
    const TILE_H: i64 = 84

    # The places down the explorer's side, and the first seven folders.
    const HOME: i64 = 0
    const DESKTOP_DIR: i64 = 1
    const DOCUMENTS: i64 = 2
    const TRASH: i64 = 6
    const PLACE_COUNT: i64 = 7

    # Control kinds, in KINDS order.
    const TOGGLE: i64 = 0
    const CHOICE: i64 = 1
    const SLIDER: i64 = 2
    const DROPDOWN: i64 = 3
    const COLOUR: i64 = 4
    const STEPPER: i64 = 5

    # File kinds.
    const FOLDER: i64 = 0
    const DOC: i64 = 1
    const SHEET: i64 = 2
    const IMAGE: i64 = 3
    const MUSIC: i64 = 4

    # Window kinds.
    const APP: i64 = 0
    const NOTE: i64 = 1
    const EXPLORER: i64 = 2

    # Explorer toolbar buttons, in TOOLS order.
    const BACK: i64 = 0
    const UP: i64 = 1
    const CUT: i64 = 2
    const COPY: i64 = 3
    const PASTE: i64 = 4
    const DELETE: i64 = 5
    const VIEW: i64 = 6

    const LABEL_COUNT: i64 = 60
    const TITLE_COUNT: i64 = 12
    const DIALOG_COUNT: i64 = 18
    const FOLDER_NAME_COUNT: i64 = 24
    const FILE_WORD_COUNT: i64 = 30
    const COLOUR_COUNT: i64 = 8
    const NOTE_TEXT_COUNT: i64 = 6

    struct Grade:
        rung: i64
        windows: i64
        tabs: i64
        per_tab: i64
        rows: i64
        kind_count: i64
        dialogs: i64
        submenus: bool
        depends: i64
        applies: i64
        hiding: Hiding
        files: Files
        goals: i64
        factor: f64
        slack: f64

    # Popups, and windows that start minimised, closed, as notes or off
    # the edge of the screen.
    struct Hiding:
        popups: i64
        minimised: i64
        closed: i64
        notes: i64
        offscreen: i64

    # The explorer and the files on the card.
    struct Files:
        explorer: bool
        moves: i64
        deletes: i64
        restores: i64
        depth: i64
        desktop_files: i64
        ex_tabs: i64
        pinned: i64
        explorer_closed: bool
        copies: i64
        list_view: bool
        hide_card: bool

    def imin(one: i64, two: i64) -> i64:
        return one if one < two else two

    def imax(one: i64, two: i64) -> i64:
        return one if one > two else two

    def grade(rung: i64) -> Grade:
        can Abort.Panic:
            r: i64 = imax(1, rung)
            per_tab: i64 = imin(8, 1 + r / 2)
            windows: i64 = 1 if r < 11 else imin(6, 2 + (r - 11) / 3)
            # KINDS[:min(4, r)], then colour from 7 and stepper from 9.
            kinds: i64 = imin(4, r) + (1 if r >= 7 else 0) + (1 if r >= 9 else 0)
            hiding: Hiding = Hiding{popups: 0 if r < 10 else imin(4, 1 + (r - 10) / 5),
                minimised: 0 if r < 12 else imin(windows - 1, 1 + (r - 12) / 4),
                closed: 0 if r < 18 else imin(2, 1 + (r - 18) / 6), notes: 0 if r < 14 else (1 if r < 20 else 2),
                offscreen: 0 if r < 17 else 1}
            files: Files = Files{explorer: r >= 6, moves: 0 if r < 6 else imin(8, 1 + (r - 6) / 3),
                deletes: 0 if r < 14 else imin(3, 1 + (r - 14) / 6), restores: 0 if r < 18 else imin(3, 1 + (r - 18) / 8),
                depth: 1 if r < 9 else (2 if r < 16 else imin(8, 3 + (r - 16) / 4)), desktop_files: 0 if r < 14 else 3,
                ex_tabs: 1 if r < 12 else 2, pinned: 5 if r < 18 else 2, explorer_closed: r >= 15,
                copies: 0 if r < 10 else imin(3, 1 + (r - 10) / 6), list_view: r >= 16, hide_card: r >= 24}
            factor: f64 = fmax(1.0, 2.0 - (r - 1).f64() / 11.0) if r <= 20 else 1.0 / (1.0 + 0.01 * (r - 20).f64())
            return Grade{rung: r, windows: windows, tabs: 1 if r < 5 else (2 if r < 10 else 3), per_tab: per_tab,
                rows: per_tab if r < 6 else (3 if r < 8 else (4 if r < 13 else 2)), kind_count: kinds,
                dialogs: 0 if r < 8 else (1 if r < 12 else (2 if r < 19 else 3)), submenus: r >= 19,
                depends: 0 if r < 15 else imin(4, 1 + (r - 15) / 3), applies: 0 if r < 16 else (1 if r < 19 else 2),
                hiding: hiding, files: files, goals: 1 if r <= 2 else imin(14, r / 2 + 1), factor: factor,
                slack: 2.0 if r < 12 else 0.0}

    # level.kinds[index]: KINDS[:min(4, rung)], then colour, then stepper.
    def kind_at(level: Grade&, index: i64) -> i64:
        plain: i64 = imin(4, level.rung)
        return index if index < plain
        return COLOUR if index == plain and level.rung >= 7
        return STEPPER

    def label_name(index: i64) -> cstr:
        names: array[cstr, 60] = ["Sound", "Wi-Fi", "Bluetooth", "Night mode", "Brightness", "Volume", "Font", "Theme",
            "Sync", "Backup", "Alerts", "Zoom", "Grid", "Snap", "Autosave", "Contrast", "Cursor", "Speed", "Quality", "Format",
            "Privacy", "Updates", "Mouse", "Keys", "Power", "Sleep", "Timer", "Echo", "Bass", "Treble", "Shadow", "Border",
            "Margin", "Spacing", "Accent", "Rulers", "Hints", "Lock", "Repeat", "Shuffle", "Captions", "Filter", "Tint",
            "Scale", "Paper", "Copies", "Duplex", "Layout", "Corners", "Motion", "Focus", "Halo", "Ink", "Pitch", "Tempo",
            "Depth", "Glow", "Hue", "Grain", "Blur"]
        return names[index.usize()]

    def title_name(index: i64) -> cstr:
        names: array[cstr, 12] = ["Settings", "Audio", "Display", "Network", "Editor", "Printer", "Mail", "Clock", "Files",
            "Camera", "Music", "Maps"]
        return names[index.usize()]

    def tab_name(index: i64) -> cstr:
        names: array[cstr, 4] = ["General", "Advanced", "Extra", "View"]
        return names[index.usize()]

    def menu_name(index: i64) -> cstr:
        names: array[cstr, 3] = ["Edit", "Tools", "View"]
        return names[index.usize()]

    def dialog_name(index: i64) -> cstr:
        names: array[cstr, 18] = ["Preferences", "Options", "Format", "Filters", "Colours", "Behaviour", "Network", "Storage",
            "Startup", "Privacy", "Fonts", "Export", "Sharing", "Layout", "Accounts", "Sounds", "Shortcuts", "Language"]
        return names[index.usize()]

    def word_name(index: i64) -> cstr:
        names: array[cstr, 6] = ["Off", "Low", "Mid", "High", "Auto", "Max"]
        return names[index.usize()]

    def colour_name(index: i64) -> cstr:
        names: array[cstr, 8] = ["red", "orange", "yellow", "green", "teal", "blue", "purple", "pink"]
        return names[index.usize()]

    # COLOURS' swatch, as 0xrrggbbff.
    def colour_rgba(index: i64) -> u32:
        swatches: array[u32, 8] = [0xd6403aff.u32(), 0xec8828ff.u32(), 0xecc828ff.u32(), 0x3ca050ff.u32(), 0x1e9696ff.u32(),
            0x346edcff.u32(), 0x8250beff.u32(), 0xe26eaaff.u32()]
        return swatches[index.usize()]

    def note_text(index: i64) -> cstr:
        names: array[cstr, 6] = ["Call the bank", "Milk, eggs", "Meeting at 3", "Back up photos", "Water plants", "Pay rent"]
        return names[index.usize()]

    def place_name(index: i64) -> cstr:
        names: array[cstr, 7] = ["Home", "Desktop", "Documents", "Downloads", "Music", "Pictures", "Trash"]
        return names[index.usize()]

    def tool_name(index: i64) -> cstr:
        names: array[cstr, 7] = ["Back", "Up", "Cut", "Copy", "Paste", "Delete", "View"]
        return names[index.usize()]

    def tool_width(index: i64) -> i64:
        widths: i64[7] = [52, 40, 44, 48, 56, 62, 52]
        return widths[index.usize()]

    def folder_name(index: i64) -> cstr:
        names: array[cstr, 24] = ["Work", "Old", "2023", "2024", "Trips", "Taxes", "Drafts", "Projects", "School", "Recipes",
            "Archive", "Family", "Mixes", "Invoices", "Backup", "Ideas", "Garden", "Car", "Clients", "Scans", "Live", "Covers",
            "Notes", "Misc"]
        return names[index.usize()]

    def file_word(index: i64) -> cstr:
        names: array[cstr, 30] = ["budget", "report", "notes", "letter", "plan", "photo", "song", "invoice", "resume", "draft",
            "list", "map", "poster", "recipe", "scan", "memo", "beach", "party", "demo", "score", "lease", "quote", "agenda",
            "cover", "sketch", "intro", "payslip", "ticket", "garden", "minutes"]
        return names[index.usize()]

    # EXTENSIONS[kind][index].
    def extension(kind: i64, index: i64) -> cstr:
        return (".txt" if index == 0 else ".doc") if kind == DOC
        return ".xls" if kind == SHEET
        return (".png" if index == 0 else ".jpg") if kind == IMAGE
        return ".mp3"

    def extension_count(kind: i64) -> i64:
        return 2 if kind == DOC or kind == IMAGE else 1

    # HOLDS[place]: what a folder in each place mostly holds.
    def holds_count(place: i64) -> i64:
        return 2 if place == 2 else (4 if place == 3 else (1 if place == 4 or place == 5 else 3))

    def holds_at(place: i64, index: i64) -> i64:
        downloads: i64[4] = [DOC, SHEET, IMAGE, MUSIC]
        desk: i64[3] = [DOC, IMAGE, SHEET]
        return (DOC if index == 0 else SHEET) if place == 2
        return downloads[index.usize()] if place == 3
        return MUSIC if place == 4
        return IMAGE if place == 5
        return desk[index.usize()]
