include "./tuner_audio.elisa"

module TunerGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = Tuner::PORTS
    const UPDATE: i64 = -1
    const FEEDBACK: f64 = 2.5
    const SUBSTEP: f64 = 1.0 / 120.0
    const LISTEN: i64 = 4
    const FIND: i64 = 5

    struct Session:
        rng: mutable MT19937
        start_rung: i64
        total: i64
        adaptive: bool
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        owner: mutable Arena
        run: mutable Tuner::Run
        audio: mutable TunerAudio::Audio
        heard_to: mutable f64
        last_tick: mutable f64
        deadline: mutable f64
        message: mutable i64
        control: mutable i64
        passed: mutable i64
        best: mutable i64
        verdict_published: mutable bool

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = zeroed
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            initial: i64 = rung if rung > 0 else 1
            return Session{rng: rng, start_rung: initial, total: total, adaptive: adaptive, rung: initial,
                trial: 0, phase: READY, owner: zeroed, run: zeroed, audio: zeroed,
                heard_to: 0.0, last_tick: 0.0, deadline: 0.0, message: LISTEN, control: 0,
                passed: 0, best: 0, verdict_published: false}

    def release_owner(owner: mutable Arena&):
        can Memory.Release, Abort.Panic:
            arena_free(owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}

    def release(session: mutable Session&):
        can Memory.Release, Abort.Panic:
            release_owner(&session.owner) can Global{Read,Write}
            session.run <- zeroed
            session.audio <- zeroed

    def make_run(owner: mutable Arena&, rung: i64, seed: i64, clips: darray[Tuner::Clip]&) -> Tuner::Run:
        can Memory.Allocate, Abort.Panic:
            in owner:
                radio: Tuner::Radio = Tuner::deal(rung, seed, clips)
                return Tuner::initialize(&radio, true)

    def make_audio(owner: mutable Arena&, radio: Tuner::Radio&) -> TunerAudio::Audio:
        can Memory.Allocate, Abort.Panic:
            in owner:
                return TunerAudio::prepare_tunes(radio)

    def next_trial(session: mutable Session&, now: f64, clips: darray[Tuner::Clip]&) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            release(session) can Global{Read,Write}
            session.last_tick <- now
            session.heard_to <- 0.0
            session.control <- 0
            session.message <- LISTEN
            session.verdict_published <- false
            if session.trial >= session.total:
                session.phase <- DONE
                return true
            seed: i64 = py_randbelow(&session.rng, 1073741824.u64()).i64()
            session.run <- make_run(&session.owner, session.rung, seed, clips)
            if session.run.radio.heard.bank == Tuner::TUNES:
                session.audio <- make_audio(&session.owner, &session.run.radio)
            session.trial <- session.trial + 1
            session.phase <- PLAYING
            return true

    def valid_time(session: Session&, now: f64) -> bool:
        return now >= session.last_tick and now <= 9007199254740.0

    def start(session: mutable Session&, now: f64, clips: darray[Tuner::Clip]&) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if session.phase != READY and session.phase != DONE
            return false if session.total <= 0 or not valid_time(session, now)
            session.rung <- session.start_rung
            session.trial <- 0
            session.passed <- 0
            session.best <- 0
            return next_trial(session, now, clips) can Global{Read,Write}

    def close(session: mutable Session&):
        can Memory.Release, Abort.Panic:
            release(session) can Global{Read,Write}
            session.phase <- READY

    def tune(session: mutable Session&, dial: f64) -> bool:
        return false if session.phase != PLAYING or session.run.result != Tuner::PENDING or dial != dial
        session.run.dial <- Tuner::clamp(dial, 0.0, Tuner::DIAL)
        return true

    def replay(owner: mutable Arena&, run: mutable Tuner::Run&) -> bool:
        can Memory.Allocate, Abort.Panic:
            in owner:
                return Tuner::replay(run)

    def step(owner: mutable Arena&, run: mutable Tuner::Run&, dt: f64, steps: i64, control: i64):
        can Memory.Allocate, Abort.Panic:
            in owner:
                for i in 0..<steps |run, dt, steps, control|:
                    Tuner::step(run, dt / steps.f64(), control)
                    break if run.result != Tuner::PENDING

    def event(session: mutable Session&, port: i64) -> bool:
        can Memory.Allocate, Abort.Panic:
            return false if session.phase != PLAYING or session.run.result != Tuner::PENDING
            if port == Tuner::LOCK:
                return Tuner::press(&session.run)
            if port == Tuner::REPLAY:
                return replay(&session.owner, &session.run)
            if port >= Tuner::DOWN and port <= Tuner::FINE_UP:
                session.control <- 1 << port
                return true
            return false

    def tick(session: mutable Session&, now: f64, held: i64):
        can Memory.Allocate, Abort.Panic:
            if session.message == LISTEN and Tuner::on(&session.run):
                session.message <- FIND
            if session.run.message != 0:
                session.message <- session.run.message
                session.run.message <- 0
            dt: f64 = Tuner::clamp(now - session.last_tick, 0.0, 0.1)
            session.last_tick <- now
            control: i64 = session.control if session.control != 0 else held
            session.control <- 0
            whole: i64 = ceil(dt / SUBSTEP).i64()
            steps: i64 = whole if whole > 0 else 1
            step(&session.owner, &session.run, dt, steps, control)
            if session.run.result != Tuner::PENDING:
                if session.run.result == Tuner::WON:
                    session.passed <- session.passed + 1
                    session.best <- session.rung if session.rung > session.best
                    session.rung <- session.rung + 1 if session.adaptive and session.rung < 9223372036854775807
                else:
                    session.rung <- session.rung - 1 if session.adaptive and session.rung > 1
                session.phase <- JUDGED
                session.deadline <- now + FEEDBACK

    def advance(session: mutable Session&, now: f64, held: i64, clips: darray[Tuner::Clip]&) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if not valid_time(session, now)
            if session.phase == PLAYING:
                tick(session, now, held)
                return true
            if session.phase == JUDGED and now >= session.deadline:
                return next_trial(session, now, clips) can Global{Read,Write}
            return false

    def agent_event(session: mutable Session&, now: f64, port: i64, clips: darray[Tuner::Clip]&) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if not valid_time(session, now)
            return (start(session, now, clips) can Global{Read,Write}) if port == START
            return event(session, port) if port >= 0
            return false if port != UPDATE
            if session.phase == PLAYING:
                tick(session, now, 0)
                session.verdict_published <- session.phase == JUDGED
                return true
            if session.phase == JUDGED:
                return (next_trial(session, now, clips) can Global{Read,Write}) if session.verdict_published
                session.verdict_published <- true
                return true
            return false

    def audio_window(session: mutable Session&, dest: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 0 if session.phase != PLAYING and session.phase != JUDGED
            return 0 if session.audio.stations.count.i64() != session.run.radio.count
            requested: i64 = capacity / TonePcm::FRAME_BYTES
            available: i64 = requested if requested <= 16384 else 16384
            elapsed: f64 = session.run.t - session.heard_to
            return 0 if elapsed <= 0.0 or available < 1
            frames: i64 = py_round_half_even(elapsed * TunerAudio::RATE.f64())
            return 0 if frames < 1
            end: f64 = session.run.t if frames <= available else session.heard_to + available.f64() / TunerAudio::RATE.f64()
            count: mutable i64 = 0
            region mix_work(262144):
                in mix_work:
                    count <- TunerAudio::mix(&session.run, &session.audio, session.heard_to, end, dest, capacity)
            session.heard_to <- end if count > 0
            return count

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 10 or total == 20

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            active: bool = session.phase == PLAYING or session.phase == JUDGED
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return py_round_half_even(session.run.t * 1000.0) if field == 4 and active
            return py_round_half_even(session.run.dial * 1000.0) if field == 5 and active
            return session.run.radio.count if field == 6 and active
            return session.run.result if field == 7 and session.phase == JUDGED
            return session.passed if field == 8
            return session.best if field == 9
            return py_round_half_even(session.deadline * 1000.0) if field == 10 and session.phase == JUDGED
            return 1 if field == 11 and active and Tuner::on(&session.run)
            return 0 if field == 11 and active
            return session.message if field == 12 and active
            return -1
