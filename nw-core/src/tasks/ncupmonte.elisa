# N-Cup Monte: watch the ball, track the cups, click the right one.
#
# Port of the portable half of neural_workshop/ui/ncupmonte.py
# (GPL-2.0-or-later). The animation is the shell's; what is here is the deal,
# the swap plan, the permutation the swaps leave behind, and the adaptive
# ladder.
#
# `order[slot]` is which CUP sits in that slot. A swap exchanges two SLOTS'
# contents, and the ball is a cup id fixed for the whole round -- so following
# the ball is following where its cup ended up, which is the task.

module NCupMonte:

    const FEWEST_CUPS: i64 = 3

    const PHASE_READY: i64 = 0
    const PHASE_REVEAL: i64 = 1
    const PHASE_SHUFFLE: i64 = 2
    const PHASE_GUESS: i64 = 3
    const PHASE_RESULT: i64 = 4

    const MOST_CUPS: i64 = 64

    def clamp_cups(cups: i64, most: i64) -> i64:
        can Abort.Panic:
            lifted: i64 = FEWEST_CUPS if cups < FEWEST_CUPS else cups
            return most if lifted > most else lifted

    struct NCupMonteTable:
        cups: mutable i64
        most_cups: mutable i64
        adaptive: mutable bool
        swap_count: mutable i64
        phase: mutable i64
        # Which cup sits in each slot.
        order: mutable darray[i64]
        # The cup the ball is under, for the whole round.
        ball: mutable i64
        guess: mutable i64
        # The planned swaps, two slots each.
        swaps: mutable darray[i64]
        swap_n: mutable i64
        swap_at: mutable i64

    def new_table(start_cups: i64, most_cups: i64, adaptive: bool, swap_count: i64) -> NCupMonteTable:
        can Memory.Allocate, Abort.Panic:
            ceiling: i64 = start_cups if most_cups < start_cups else most_cups
            return NCupMonteTable{cups: clamp_cups(start_cups, ceiling), most_cups: ceiling,
                         adaptive: adaptive, swap_count: swap_count, phase: PHASE_READY,
                         order: Ints::zeros(MOST_CUPS), ball: 0, guess: -1,
                         swaps: Ints::zeros(2 * (MOST_CUPS + 256)), swap_n: 0, swap_at: 0}

    # Cups back in slot order: slot i holds cup i.
    def place_cups(table: mutable NCupMonteTable&):
        can Abort.Panic:
            for slot in 0..<table.cups |table|:
                Ints::put(&table.order, slot, slot)

    def start_round(table: mutable NCupMonteTable&, rng: mutable MT19937&):
        can Abort.Panic:
            place_cups(table)
            table.ball <- py_randbelow(rng, table.cups.u64()).i64()
            table.guess <- -1
            table.swap_n <- 0
            table.swap_at <- 0
            table.phase <- PHASE_REVEAL

    # More cups means more swaps: the plan is `swap_count + cups`, at least one.
    def plan_swaps(table: mutable NCupMonteTable&, rng: mutable MT19937&):
        can Memory.Allocate, Abort.Panic:
            count: mutable i64 = table.swap_count + table.cups
            count <- 1 if count < 1
            table.swap_n <- 0
            table.swap_at <- 0
            for _swap in 0..<count |table, rng|:
                pair: darray[i64] = py_sample_range(rng, 0, table.cups - 1, 2)
                Ints::put(&table.swaps, table.swap_n * 2, Ints::at(pair, 0))
                Ints::put(&table.swaps, table.swap_n * 2 + 1, Ints::at(pair, 1))
                table.swap_n <- table.swap_n + 1
            table.phase <- PHASE_SHUFFLE

    # One swap lands: the two SLOTS exchange cups. The reference does this when
    # the animation reaches its end, so the permutation is the same whether or
    # not anything was drawn.
    def settle_swap(table: mutable NCupMonteTable&):
        can Abort.Panic:
            return if table.swap_at >= table.swap_n
            a: i64 = Ints::at_ref(&table.swaps, table.swap_at * 2)
            b: i64 = Ints::at_ref(&table.swaps, table.swap_at * 2 + 1)
            held: i64 = Ints::at_ref(&table.order, a)
            Ints::put(&table.order, a, Ints::at_ref(&table.order, b))
            Ints::put(&table.order, b, held)
            table.swap_at <- table.swap_at + 1
            table.phase <- PHASE_GUESS if table.swap_at >= table.swap_n

    def settle_all(table: mutable NCupMonteTable&):
        can Abort.Panic:
            while table.swap_at < table.swap_n |table|:
                settle_swap(table)

    # Which cup a slot is showing.
    def cup_in_slot(table: mutable NCupMonteTable&, slot: i64) -> i64:
        can Abort.Panic:
            return -1 if slot < 0 or slot >= table.cups
            return Ints::at_ref(&table.order, slot)

    def choose_cup(table: mutable NCupMonteTable&, cup: i64) -> bool:
        can Abort.Panic:
            false return if table.phase != PHASE_GUESS
            table.guess <- cup
            table.phase <- PHASE_RESULT
            caught: bool = cup == table.ball
            if table.adaptive:
                table.cups <- clamp_cups(table.cups + 1, table.most_cups) if caught
                table.cups <- clamp_cups(table.cups - 1, table.most_cups) if not caught
            place_cups(table)
            return caught
