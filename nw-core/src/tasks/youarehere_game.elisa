# Stateful 3D Maze controller.
#
# The maze generator and the first-person rules stay in the source-backed
# Maze/YouAreHere modules. This adapter retains the generated workspace as
# well as the layout: unlike the flat Maze controller, the 3D renderer must
# ray-cast the exact winning deal rather than regenerate a second copy.

module YouAreHereGame:

    const PHASE_READY: i64 = 0
    const PHASE_WALKING: i64 = 1
    const PHASE_SOLVED: i64 = 2
    const PHASE_DONE: i64 = 3
    const PHASE_UNAVAILABLE: i64 = 4

    const ACTION_START: i64 = 0
    const ACTION_AHEAD: i64 = 1
    const ACTION_BACK: i64 = 2
    const ACTION_LEFT: i64 = 3
    const ACTION_RIGHT: i64 = 4
    const ACTION_RESTART: i64 = 5

    const INFO_PHASE: i64 = 0
    const INFO_RUNG: i64 = 1
    const INFO_TRIAL: i64 = 2
    const INFO_TOTAL_TRIALS: i64 = 3
    const INFO_PLAYER: i64 = 4
    const INFO_FACING: i64 = 5
    const INFO_STEPS: i64 = 6
    const INFO_HELD: i64 = 7
    const INFO_VERDICT: i64 = 8
    const INFO_WIDTH: i64 = 9
    const INFO_HEIGHT: i64 = 10
    const INFO_MINIMUM: i64 = 11
    const INFO_DOOR_COUNT: i64 = 12
    const INFO_START: i64 = 13
    const INFO_WAY_OUT: i64 = 14
    const INFO_SOLVED_COUNT: i64 = 15
    const INFO_TOTAL_PAR: i64 = 16
    const INFO_TOTAL_STEPS: i64 = 17
    const INFO_BEST_RUNG: i64 = 18
    const INFO_ADAPTIVE: i64 = 19
    const INFO_SHOW_MARKS: i64 = 20

    const CELL_WALL: i64 = 0
    const CELL_DOOR: i64 = 1
    const CELL_KEY: i64 = 2

    const MAX_ROOMS: i64 = 18
    const MAX_DOORS: i64 = 6
    const GENERATION_ATTEMPTS: i64 = 150
    const COLUMNS: i64 = 180
    const FOV: f64 = 1.5707963267948966

    struct Run:
        start_rung: mutable i64
        rung: mutable i64
        total_trials: mutable i64
        adaptive: mutable bool
        show_marks: mutable bool
        rng: mutable MT19937
        maze: mutable Maze::Layout
        deal_seed: mutable i64
        pose: mutable YouAreHere::Pose
        held: mutable i64
        steps: mutable i64
        par: mutable i64
        phase: mutable i64
        verdict: mutable i64
        trial: mutable i64
        started_at_ms: mutable i64
        taken_seconds: mutable i64
        solved_count: mutable i64
        total_par: mutable i64
        total_steps: mutable i64
        best_rung: mutable i64

    def clamp_rung(value: i64) -> i64:
        can Abort.Panic:
            return 1 if value < 1 else (Maze::GRADE_COUNT if value > Maze::GRADE_COUNT else value)

    def initialize(run: mutable Run&, start_rung: i64, total_trials: i64,
                   adaptive: bool, show_marks: bool, seed: i64):
        can Memory.Allocate, Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            run.start_rung <- clamp_rung(start_rung)
            run.rung <- run.start_rung
            run.total_trials <- 1 if total_trials < 1 else total_trials
            run.adaptive <- adaptive
            run.show_marks <- show_marks
            run.rng <- rng
            run.maze <- Maze::blank()
            run.deal_seed <- 0
            run.pose <- YouAreHere::Pose{cell: 0, facing: 0}
            run.held <- 0
            run.steps <- 0
            run.par <- 0
            run.phase <- PHASE_READY
            run.verdict <- -1
            run.trial <- 0
            run.started_at_ms <- 0
            run.taken_seconds <- 0
            run.solved_count <- 0
            run.total_par <- 0
            run.total_steps <- 0
            run.best_rung <- 0

    def next_trial(run: mutable Run&, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            if run.trial >= run.total_trials:
                run.phase <- PHASE_DONE
                run.verdict <- -1
                return
            run.trial <- run.trial + 1
            deal_seed: i64 = py_randbelow(&run.rng, 1073741824.u64()).i64()
            region deal(67108864):
                in deal:
                    work: mutable Maze::Work = Maze::work_new(MAX_ROOMS, MAX_DOORS)
                    maze: mutable Maze::Layout = Maze::generate(&work, run.rung, deal_seed, GENERATION_ATTEMPTS)
                    run.maze <- maze
                    run.deal_seed <- deal_seed
                    if not maze.ok:
                        run.phase <- PHASE_UNAVAILABLE
                        run.verdict <- -1
                    else:
                        sweep: mutable YouAreHere::Sweep = YouAreHere::sweep_new(&work)
                        run.par <- YouAreHere::par(&work, &maze, &sweep)
                        run.pose <- YouAreHere::Pose{cell: maze.start,
                                                     facing: YouAreHere::facing_at(&work, &maze)}
                        run.held <- Maze::picked_up(&maze, maze.start, 0)
                        run.steps <- 0
                        run.started_at_ms <- now_ms
                        run.taken_seconds <- 0
                        run.verdict <- -1
                        run.phase <- PHASE_WALKING
                destroy deal

    def start_run(run: mutable Run&, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            run.rung <- clamp_rung(run.start_rung)
            run.trial <- 0
            run.solved_count <- 0
            run.total_par <- 0
            run.total_steps <- 0
            run.best_rung <- 0
            run.phase <- PHASE_READY
            run.verdict <- -1
            next_trial(run, now_ms)

    def settle(run: mutable Run&, now_ms: i64):
        can Abort.Panic:
            elapsed: mutable i64 = now_ms - run.started_at_ms
            elapsed <- 0 if elapsed < 0
            run.taken_seconds <- elapsed / 1000
            run.solved_count <- run.solved_count + 1
            run.total_par <- run.total_par + run.par
            run.total_steps <- run.total_steps + run.steps
            run.best_rung <- run.rung if run.rung > run.best_rung
            run.verdict <- 1 if run.steps <= run.par else 0
            if run.adaptive:
                if run.steps * 4 <= run.par * 5:
                    run.rung <- clamp_rung(run.rung + 1)
                elif run.steps > run.par * 2:
                    run.rung <- clamp_rung(run.rung - 1)
            run.phase <- PHASE_SOLVED

    def apply(run: mutable Run&, action: i64, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            if action == ACTION_START:
                if run.phase == PHASE_READY or run.phase == PHASE_DONE:
                    start_run(run, now_ms)
                    return 1
                if run.phase == PHASE_SOLVED:
                    next_trial(run, now_ms)
                    return 1
                return 2
            if action == ACTION_RESTART:
                return 2 if run.phase != PHASE_WALKING
                region restart(67108864):
                    in restart:
                        work: mutable Maze::Work = Maze::work_new(MAX_ROOMS, MAX_DOORS)
                        maze: mutable Maze::Layout = Maze::generate(&work, run.rung, run.deal_seed, GENERATION_ATTEMPTS)
                        run.pose <- YouAreHere::Pose{cell: maze.start,
                                                     facing: YouAreHere::facing_at(&work, &maze)}
                        run.held <- Maze::picked_up(&maze, maze.start, 0)
                        run.steps <- 0
                    destroy restart
                return 1
            if action < ACTION_AHEAD or action > ACTION_RIGHT:
                return -6
            return 2 if run.phase != PHASE_WALKING
            region motion(67108864):
                in motion:
                    work: mutable Maze::Work = Maze::work_new(MAX_ROOMS, MAX_DOORS)
                    rebuilt: mutable Maze::Layout = Maze::generate(&work, run.rung, run.deal_seed, GENERATION_ATTEMPTS)
                    moved: YouAreHere::Step = YouAreHere::after(&work, &rebuilt,
                                                                run.pose, run.held,
                                                                action - ACTION_AHEAD)
                    run.pose <- YouAreHere::Pose{cell: moved.cell, facing: moved.facing}
                    run.held <- moved.held
                    run.steps <- run.steps + YouAreHere::costs(action - ACTION_AHEAD, moved.moved)
                    if run.pose.cell == run.maze.way_out:
                        settle(run, now_ms)
                destroy motion
            return 1

    def info(run: Run&, field: i64) -> i64:
        can Abort.Panic:
            if field == INFO_PHASE: return run.phase
            if field == INFO_RUNG: return run.rung
            if field == INFO_TRIAL: return run.trial
            if field == INFO_TOTAL_TRIALS: return run.total_trials
            if field == INFO_PLAYER: return run.pose.cell
            if field == INFO_FACING: return run.pose.facing
            if field == INFO_STEPS: return run.steps
            if field == INFO_HELD: return run.held
            if field == INFO_VERDICT: return run.verdict
            if field == INFO_WIDTH: return run.maze.width
            if field == INFO_HEIGHT: return run.maze.height
            if field == INFO_MINIMUM: return run.par
            if field == INFO_DOOR_COUNT: return run.maze.door_count
            if field == INFO_START: return run.maze.start
            if field == INFO_WAY_OUT: return run.maze.way_out
            if field == INFO_SOLVED_COUNT: return run.solved_count
            if field == INFO_TOTAL_PAR: return run.total_par
            if field == INFO_TOTAL_STEPS: return run.total_steps
            if field == INFO_BEST_RUNG: return run.best_rung
            if field == INFO_ADAPTIVE: return 1 if run.adaptive else 0
            if field == INFO_SHOW_MARKS: return 1 if run.show_marks else 0
            return -1

    def cell(run: Run&, field: i64, at: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return -1 if at < 0 or at >= run.maze.width * run.maze.height
            if field == CELL_WALL:
                region probe(67108864):
                    in probe:
                        work: mutable Maze::Work = Maze::work_new(MAX_ROOMS, MAX_DOORS)
                        maze: mutable Maze::Layout = Maze::generate(&work, run.rung, run.deal_seed, GENERATION_ATTEMPTS)
                        answer: i64 = 0 if Ints::at(work.open_flag, at) == 1 else 1
                        return answer
                    destroy probe
            if field == CELL_DOOR:
                colour: mutable i64 = 0
                while colour < run.maze.door_count and colour < MAX_DOORS |colour, run, at|:
                    return colour + 1 if run.maze.doors[colour.usize()] == at
                    colour <- colour + 1
                return 0
            if field == CELL_KEY:
                colour: mutable i64 = 0
                while colour < run.maze.door_count and colour < MAX_DOORS |colour, run, at|:
                    return colour + 1 if run.maze.keys[colour.usize()] == at
                    colour <- colour + 1
            return 0

    def render(run: Run&, black_background: bool, width: f64, height: f64,
               list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            region frame(67108864):
                in frame:
                    work: mutable Maze::Work = Maze::work_new(MAX_ROOMS, MAX_DOORS)
                    rebuilt: mutable Maze::Layout = Maze::generate(&work, run.rung, run.deal_seed, GENERATION_ATTEMPTS)
                    walls: mutable darray[i64] = []
                    doors: mutable darray[i64] = []
                    keys: mutable darray[i64] = []
                    if rebuilt.ok:
                        for at in 0..<(run.maze.width * run.maze.height) |run, walls, work|:
                            walls.push(at) if Ints::at(work.open_flag, at) != 1
                        for colour in 0..<run.maze.door_count |run, doors, keys|:
                            doors.push(run.maze.doors[colour.usize()])
                            keys.push(run.maze.keys[colour.usize()])
                    distances: mutable darray[f64] = Floats::zeros(COLUMNS)
                    sight_cells: mutable darray[i64] = Ints::zeros(COLUMNS)
                    sight_sides: mutable darray[i64] = Ints::zeros(COLUMNS)
                    sights: mutable darray[SceneYouAreHere::Sight] = []
                    motes: mutable YouAreHere::Motes = YouAreHere::motes_new()
                    if run.maze.ok and (run.phase == PHASE_WALKING or run.phase == PHASE_SOLVED):
                        YouAreHere::look(&work, &rebuilt, run.pose, COLUMNS, FOV,
                                         &distances, &sight_cells, &sight_sides)
                        for column in 0..<COLUMNS |column, sights, distances, sight_cells, sight_sides|:
                            sights.push(SceneYouAreHere::Sight{distance: Floats::at_ref(&distances, column),
                                                               cell: Ints::at_ref(&sight_cells, column),
                                                               side: Ints::at_ref(&sight_sides, column)})
                        YouAreHere::motes(&work, &rebuilt, run.pose, run.held, FOV, &motes)
                    scene_motes: mutable darray[SceneYouAreHere::Mote] = []
                    for at in 0..<motes.count |at, scene_motes, motes|:
                        scene_motes.push(SceneYouAreHere::Mote{what: Ints::at_ref(&motes.what, at),
                                                               which: Ints::at_ref(&motes.which, at),
                                                               across: Floats::at_ref(&motes.across, at),
                                                               distance: Floats::at_ref(&motes.distance, at)})
                    sx: f64 = width / Display::REFERENCE_WIDTH
                    sy: f64 = height / Display::REFERENCE_HEIGHT
                    paint: SceneYouAreHere::Paint = SceneYouAreHere::paint_of(black_background, width, height, sx, sy)
                    message: mutable dstr = []
                    if run.phase == PHASE_READY:
                        dstr_append_cstr(&message, "Press Space to start")
                    elif run.phase == PHASE_SOLVED:
                        dstr_append_cstr(&message, "Out in ")
                        dstr_append_i64(&message, run.steps)
                        dstr_append_cstr(&message, " steps — minimum ")
                        dstr_append_i64(&message, run.par)
                    elif run.phase == PHASE_DONE:
                        dstr_append_cstr(&message, "3D mazes complete")
                    elif run.phase == PHASE_UNAVAILABLE:
                        dstr_append_cstr(&message, "3D Maze unavailable")
                    else:
                        dstr_append_cstr(&message, "Find the way out")
                    SceneYouAreHere::render(list, &paint, run.phase, run.maze.ok,
                                            run.maze.width, run.maze.height, &walls,
                                            &doors, &keys, run.maze.start, run.maze.way_out,
                                            run.held, &sights, &scene_motes, run.show_marks,
                                            run.steps, run.par, run.trial,
                                            run.total_trials, bytes_view(message),
                                            run.verdict, bytes_view(message))
                destroy frame

    def dispose(run: mutable Run&):
        can Abort.Panic:
            return
