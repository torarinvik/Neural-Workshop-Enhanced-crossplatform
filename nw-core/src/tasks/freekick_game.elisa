include "./freekick.elisa"
include "./drshape_audio.elisa"

# The Free Kick screen's run of rounds, on ClockedTask's clock: every advance
# steps the round in hundred-and-twentieths of a second with the agent's dial
# port for that frame if one came, else the first of the held keys in the
# reference's order -- Left, Right, Up, Down, A, D, W, S. The kick (Space, or
# port 8) is an event: it strikes the ball at once.
module FreeKickGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = FreeKick::PORTS
    const FEEDBACK: f64 = 2.5

    struct Session:
        rng: mutable MT19937
        start_rung: mutable i64
        total: mutable i64
        adaptive: mutable bool
        rung: mutable i64
        trial: mutable i64
        wins: mutable i64
        best_rung: mutable i64
        phase: mutable i64
        time: mutable f64
        deadline: mutable f64
        run: mutable FreeKick::Run
        owner: mutable Arena
        held_keys: mutable i64
        pulse: mutable i64

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64) -> Session:
        rng: mutable MT19937 = zeroed
        magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
        mt_seed_int(&rng, magnitude)
        initial: i64 = FreeKick::grade(rung).rung
        return Session{rng: rng, start_rung: initial, total: trials, adaptive: adaptive,
            rung: initial, trial: 0, wins: 0, best_rung: 0, phase: READY, time: 0.0,
            deadline: 0.0, run: zeroed, owner: zeroed, held_keys: 0, pulse: -1}

    def close(session: mutable Session&):
        can Abort.Panic, Memory.Release:
            session.run <- zeroed
            session.phase <- READY
            session.held_keys <- 0
            session.pulse <- -1
            arena_free(&session.owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(trials: i64) -> bool:
        return trials == 1 or trials == 3 or trials == 5 or trials == 10 or trials == 20

    def reconfigure(session: mutable Session&, rung: i64, trials: i64, adaptive: bool) -> bool:
        can Abort.Panic, Memory.Release:
            return false if session.phase != READY and session.phase != DONE
            return false if not allowed_rung(rung) or not allowed_total(trials)
            close(session) can Global{Read,Write}
            session.start_rung <- rung
            session.rung <- rung
            session.total <- trials
            session.adaptive <- adaptive
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            return true

    def next_trial(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            session.time <- now
            session.pulse <- -1
            if session.trial >= session.total:
                session.phase <- DONE
                return true
            # The deal plays each pitch it tries through to its end with the
            # autopilot, and all of that is let go with the scratch region.
            region scratch(16777216):
                in scratch:
                    p: FreeKick::Pitch = FreeKick::deal(session.rung, &session.rng)
                    if not p.valid:
                        session.phase <- DONE
                        return false
                    keys: i64 = session.held_keys
                    close(session) can Global{Read,Write}
                    session.held_keys <- keys
                    owner: mutable Arena& = &session.owner
                    in owner:
                        session.run <- FreeKick::begin(p)
            session.trial <- session.trial + 1
            session.phase <- PLAYING
            return true

    def valid_time(session: Session&, now: f64) -> bool:
        return now >= session.time and now <= 9007199254740.0

    def start(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if (session.phase != READY and session.phase != DONE) or session.total < 1
            return false if not valid_time(session, now)
            session.rung <- session.start_rung
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            return next_trial(session, now) can Global{Read,Write}

    # The kick: room for its flight (a point every 1/120 s for at most four
    # seconds, the first and the crossing) and its two notes is reserved in
    # the session's arena first, so that the pushes never reallocate into a
    # region that is let go after this event.
    def strike(session: mutable Session&) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if session.run.struck or session.run.result != FreeKick::LIVE
            _ = arena_da_reserve[FreeKick::Point](&session.owner, &session.run.path, 500.usize()) can Global{Read,Write}
            _ = arena_da_reserve[DrShapeDeal::Note](&session.owner, &session.run.notes,
                session.run.notes.count + 2.usize()) can Global{Read,Write}
            FreeKick::strike(&session.run)
            return true

    # ClockedTask.steer: the kick acts at once; every other port is a dial
    # control for the frame it is sent in.
    def input(session: mutable Session&, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if session.phase != PLAYING or port < 0 or port >= FreeKick::PORTS
            return (strike(session) can Global{Read,Write}) if port == FreeKick::KICK
            session.pulse <- port
            return true

    # A primary click starts a run; Free Kick takes no other pointer input.
    # Kind 1 is a press.
    def pointer(session: mutable Session&, x: f64, y: f64, kind: i64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            if kind == 1 and (session.phase == READY or session.phase == DONE):
                return (start(session, now) can Global{Read,Write})
            return false

    # FreeKick._held: the first port in the reference's order with a key down.
    def held(session: Session&) -> i64:
        keys: i64 = session.held_keys
        for bit in 0..<8 |keys|:
            return bit if (keys & (1 << bit)) != 0
        return -1

    def judge(session: mutable Session&, now: f64):
        passed: bool = session.run.result == FreeKick::IN_RING
        if passed:
            session.wins <- session.wins + 1
            session.best_rung <- session.rung if session.rung > session.best_rung
        if session.adaptive:
            session.rung <- session.rung + 1 if passed and session.rung < 9223372036854775807
            session.rung <- session.rung - 1 if not passed and session.rung > 1
        session.deadline <- now + FEEDBACK
        session.phase <- JUDGED

    def advance(session: mutable Session&, now: f64, stepped: bool = false) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if not valid_time(session, now)
            if session.phase == JUDGED:
                return false if not stepped and now < session.deadline
                return next_trial(session, now) can Global{Read,Write}
            return false if session.phase != PLAYING
            dt: f64 = fmin(0.1, now - session.time)
            session.time <- now
            control: i64 = session.pulse if session.pulse >= 0 else held(session)
            session.pulse <- -1
            steps: i64 = fmax(1.0, ceil(dt / (1.0 / 120.0))).i64()
            quantum: f64 = dt / steps.f64()
            for _ in 0..<steps |session, quantum, control|:
                FreeKick::step(&session.run, quantum, control)
                break if session.run.result != FreeKick::LIVE
            if session.run.result != FreeKick::LIVE:
                judge(session, now)
            return true

    def agent_event(session: mutable Session&, now: f64, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if not valid_time(session, now)
            return (start(session, now) can Global{Read,Write}) if port == START
            return (advance(session, now, true) can Global{Read,Write}) if port == -1
            return (input(session, port) can Global{Read,Write})

    # Left 1, Right 2, Up 4, Down 8, A 16, D 32, W 64, S 128: bit k holds
    # port k.
    def hold_key(session: mutable Session&, key_bit: i64, down: bool) -> bool:
        return false if key_bit <= 0 or key_bit > 128 or (key_bit & (key_bit - 1)) != 0
        return false if down and session.phase != PLAYING
        before: i64 = session.held_keys
        session.held_keys <- before | key_bit if down else before & (255 ^ key_bit)
        return session.held_keys != before

    def clear_controls(session: mutable Session&) -> bool:
        changed: bool = session.held_keys != 0 or session.pulse >= 0
        session.held_keys <- 0
        session.pulse <- -1
        return changed

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return session.wins if field == 4
            return session.best_rung if field == 5
            return session.start_rung if field == 6
            return (1 if session.adaptive else 0) if field == 7
            return session.run.result if field == 8
            return py_round_half_even(session.run.t * 1000.0) if field == 9
            return py_round_half_even(session.run.kick.aim * 1000.0) if field == 10
            return py_round_half_even(session.run.kick.lift * 1000.0) if field == 11
            return py_round_half_even(session.run.kick.curl * 1000.0) if field == 12
            return py_round_half_even(session.run.kick.power * 1000.0) if field == 13
            return session.held_keys if field == 14
            return (1 if session.run.struck else 0) if field == 15
            return py_round_half_even(session.run.miss * 1000.0) if field == 16
            return py_round_half_even(FreeKick::ball(&session.run).z * 1000.0) if field == 17
            return -1
