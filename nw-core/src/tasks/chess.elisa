# Chess: a position with exactly one mate in one, and nine other ways to be
# wrong about it.
#
# Port of the portable half of neural_workshop/chess.py (GPL-2.0-or-later).
#
# WHAT IS NOT HERE, and why. Everything chess.py knows about chess it asks
# `python-chess` for: `mating_moves` walks `board.legal_moves`, `_transformed`
# reflects a motif and mirrors the colours, `_add_decoy` sets a piece and asks
# whether the position is still valid and still has exactly one mate, and
# `validate` re-derives the whole promise from the FEN. That is a third-party
# bitboard engine, and porting it is not porting this program -- it is also not
# optional detail: `mates[0]` takes the FIRST of the legal moves that mate, so
# the engine's move ORDER is part of the answer, and a re-derived generator
# that produced the same SET would still deal a different puzzle.
#
# The engine is a dependency the shell supplies, the way the word corpus is for
# the crossword and the media pool is for concentration. It is not in this
# checkout, so the half that depends on it is not merely unported but
# undifferenceable, and saying so is worth more than a transcription nobody
# checked.
#
# WHAT IS HERE is `generate`'s own arithmetic, which touches no chess at all:
# how many candidates a rung asks for, how many decoys it wants and how long it
# will try for them, and -- the part that decides which puzzle a player
# actually sees -- the sort, the half taken, and the draw from it. The easy
# rungs take the SPARSEST half of what was found and the hard rungs the
# densest, off one stable sort by how many legal moves the position allows.

module Chess:

    # Rungs, and the densest a rung ever gets: at level ten as many as fourteen
    # independently checked decoys surround the mating pattern.
    const MOST_LEVELS: i64 = 10
    const MOST_DECOYS: i64 = 14
    const DECOY_RUNGS: i64 = 9

    # Candidates sampled before one is chosen, and the ceiling on how many
    # positions are dealt looking for them.
    const MOST_ATTEMPTS: i64 = 64
    const MOST_CANDIDATES: i64 = 8

    def clamp_level(level: i64) -> i64:
        held: i64 = level if level < MOST_LEVELS else MOST_LEVELS
        return 1 if held < 1 else held

    # How many candidates a rung samples before choosing between them.
    def candidates_wanted(level: i64) -> i64:
        return 2 + clamp_level(level) / 3

    # How many decoys a rung adds. The first two levels stay sparse; the count
    # is spread evenly over the nine steps above level one and rounded.
    def decoys_wanted(level: i64) -> i64:
        can Abort.Panic:
            wanted: i64 = py_round_half_even((level - 1).f64() * MOST_DECOYS.f64() / DECOY_RUNGS.f64())
            return 0 if wanted < 0 else wanted

    # How long it will try for them. A decoy that cannot be placed without
    # changing the answer is dropped rather than forced, so the budget is
    # attempts and not placements.
    def decoy_attempts(level: i64) -> i64:
        can Abort.Panic:
            return decoys_wanted(level) * 10 + 8

    # Which of the sampled candidates a rung shows.
    #
    # `alternatives` is how many legal moves the position allows, which is what
    # makes a mate-in-one hard to see rather than hard to play. The candidates
    # are sorted by it -- a STABLE sort, so equal densities keep the order they
    # were dealt in -- and the easy rungs take the sparse half while the hard
    # ones take the dense half. An odd count leaves the middle candidate in
    # both halves, which is what `count / 2` rounded down does and is left
    # alone here.
    #
    # `found` is what the engine handed back, one entry a candidate that came
    # out legal and uniquely mating; `ids` names them so the caller can say
    # which one was chosen. Returns the id, or -1 when nothing was dealt.
    def select(ids: mutable darray[i64]&, alternatives: mutable darray[i64]&, found: i64,
               level: i64, rng: mutable MT19937&) -> i64:
        can Abort.Panic:
            return -1 if found <= 0
            # `list.sort(key=...)`, which is stable.
            for index in 1..<found |ids, alternatives|:
                id_key: i64 = Ints::at_ref(ids, index)
                key: i64 = Ints::at_ref(alternatives, index)
                at: mutable i64 = index - 1
                placing: mutable bool = true
                while placing and at >= 0 |ids, alternatives, at, placing, key|:
                    held: i64 = Ints::at_ref(alternatives, at)
                    if held > key:
                        Ints::put(alternatives, at + 1, held)
                        Ints::put(ids, at + 1, Ints::at_ref(ids, at))
                        at <- at - 1
                    else:
                        placing <- false
                Ints::put(alternatives, at + 1, key)
                Ints::put(ids, at + 1, id_key)
            half: i64 = found / 2
            span: i64 = 1 if half < 1 else half
            first: i64 = 0 if clamp_level(level) <= 3 else found - span
            return Ints::at_ref(ids, first + py_choice_index(rng, span))
