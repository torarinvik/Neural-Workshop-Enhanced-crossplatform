include "./rover_reference.elisa"

module RoverGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = Rover::PORTS
    const FEEDBACK: f64 = 2.5

    struct Session:
        rng: mutable MT19937
        start_rung: mutable i64
        total: mutable i64
        adaptive: mutable bool
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        storage: mutable Arena
        run: mutable Rover::Run
        last_tick: mutable f64
        deadline: mutable f64
        wins: mutable i64
        best_rung: mutable i64
        held_keys: mutable i64
        pulse: mutable i64

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Session:
        rng: mutable MT19937 = zeroed
        magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
        mt_seed_int(&rng, magnitude)
        initial: i64 = rung if rung > 0 else 1
        return Session{rng: rng, start_rung: initial, total: total, adaptive: adaptive,
            rung: initial, trial: 0, phase: READY, storage: zeroed, run: zeroed, last_tick: 0.0, deadline: 0.0,
            wins: 0, best_rung: 0, held_keys: 0, pulse: Rover::NEUTRAL}

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 10 or total == 20

    def reconfigure(session: mutable Session&, rung: i64, total: i64, adaptive: bool) -> bool:
        return false if session.phase != READY and session.phase != DONE
        return false if not allowed_rung(rung) or not allowed_total(total)
        session.start_rung <- rung
        session.rung <- rung
        session.total <- total
        session.adaptive <- adaptive
        session.phase <- READY
        session.trial <- 0
        session.wins <- 0
        session.best_rung <- 0
        session.run.result <- Rover::LIVE
        return true

    def close(session: mutable Session&):
        can Memory.Release, Abort.Panic, Global.Read, Global.Write:
            arena_free(&session.storage)
            session.run <- zeroed

    def install(session: mutable Session&, ground: Rover::Ground&):
        can Memory.Allocate, Abort.Panic, Global.Read, Global.Write:
            run: mutable Rover::Run& = &session.run
            count: usize = ground.delays.count
            _ = arena_da_reserve(&session.storage, &run.ground.delays, count)
            run.ground.delays.count <- count
            for i in 0..<count |run, ground|:
                run.ground.delays[i] <- ground.delays[i]
            run.ground <- Rover::Ground{level: ground.level, waves: ground.waves, rocks: ground.rocks,
                flags: ground.flags, delays: run.ground.delays, seconds: ground.seconds}
            _ = arena_da_reserve(&session.storage, &run.history, Rover::HISTORY_CAPACITY.usize())
            run.history.count <- 1.usize()
            state: Rover::State = zeroed
            run.history[0] <- Rover::Observation{at: 0.0, state: state}
            run.history_next <- 1
            run.history_count <- 1
            run.state <- state
            run.t <- 0.0
            run.queued <- 0
            run.reached <- 0
            run.result <- Rover::LIVE
            run.cue_count <- 0

    def next_trial(session: mutable Session&, now: f64):
        can Memory.Allocate, Memory.Release, Abort.Panic, Global.Read, Global.Write:
            session.last_tick <- now
            session.pulse <- Rover::NEUTRAL
            if session.trial >= session.total:
                session.phase <- DONE
                return
            region scratch(2097152):
                in scratch:
                    ground: Rover::Ground = RoverReference::deal(session.rung, &session.rng)
                    if ground.seconds <= 0.0:
                        session.phase <- READY
                        session.run.result <- Rover::LIVE
                        return
                    install(session, &ground)
            session.trial <- session.trial + 1
            session.phase <- PLAYING

    def valid_time(session: Session&, now: f64) -> bool:
        return now >= session.last_tick and now <= 9007199254740.0

    def start(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
            return false if not valid_time(session, now)
            return false if session.total <= 0 or (session.phase != READY and session.phase != DONE)
            session.rung <- session.start_rung
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            next_trial(session, now)
            return session.phase == PLAYING

    def steer(session: mutable Session&, port: i64) -> bool:
        can Abort.Panic:
            return false if session.phase != PLAYING or port < 0 or port >= Rover::PORTS
            session.pulse <- port
            return true

    # Up, Down, Left, Right, then W, S, A, D. The aliases remain
    # independent when one physical key is released.
    def key(session: mutable Session&, slot: i64, down: bool) -> bool:
        return false if slot < 0 or slot >= 8
        bit: i64 = 1 << slot
        before: i64 = session.held_keys
        session.held_keys <- (before | bit) if down else (before & ~bit)
        return session.held_keys != before

    def clear_keys(session: mutable Session&) -> bool:
        changed: bool = session.held_keys != 0
        session.held_keys <- 0
        return changed

    def control(session: Session&) -> i64:
        can Abort.Panic:
            return session.pulse if session.pulse != Rover::NEUTRAL
            held: i64 = session.held_keys | (session.held_keys >> 4)
            for port in 0..<Rover::PORTS |held|:
                return port if ((held >> port) & 1) != 0
            return Rover::NEUTRAL

    def judge(session: mutable Session&, now: f64):
        passed: bool = session.run.result == Rover::CLEAR
        if passed:
            session.wins <- session.wins + 1
            session.best_rung <- session.rung if session.rung > session.best_rung
        if session.adaptive:
            session.rung <- session.rung + 1 if passed and session.rung < 9223372036854775807
            session.rung <- session.rung - 1 if not passed and session.rung > 1
        session.deadline <- now + FEEDBACK
        session.phase <- JUDGED

    def advance(session: mutable Session&, now: f64, stepped: bool = false) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
            return false if not valid_time(session, now)
            if session.phase == JUDGED:
                return false if not stepped and now < session.deadline
                next_trial(session, now)
                return true
            return false if session.phase != PLAYING
            dt: f64 = fmin(0.1, now - session.last_tick)
            session.last_tick <- now
            port: i64 = control(session)
            session.pulse <- Rover::NEUTRAL
            steps: i64 = fmax(1.0, ceil(dt / (1.0 / 120.0))).i64()
            quantum: f64 = dt / steps.f64()
            if port != Rover::NEUTRAL:
                _ = arena_da_reserve(&session.storage, &session.run.queue, (session.run.queued + steps).usize())
            for _ in 0..<steps |session, port, quantum|:
                Rover::step(&session.run, quantum, port)
                break if session.run.result != Rover::LIVE
            if session.run.result != Rover::LIVE:
                judge(session, now)
            return true

    def agent_event(session: mutable Session&, now: f64, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
            return false if not valid_time(session, now)
            return start(session, now) if port == START
            return advance(session, now, true) if port == Rover::NEUTRAL
            return steer(session, port)

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            visible: bool = session.phase == PLAYING or session.phase == JUDGED
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return session.wins if field == 4
            return session.best_rung if field == 5
            return session.start_rung if field == 6
            return (1 if session.adaptive else 0) if field == 7
            return session.run.result if field == 8
            return -1 if field < 9 or field > 19
            return 0 if not visible
            run: Rover::Run& = &session.run
            return run.reached if field == 9
            return run.ground.level.flags if field == 10
            return run.queued if field == 11
            return py_round_half_even(run.t * 1000.0) if field == 12
            return py_round_half_even(Rover::delay_at(&run.ground, run.t) * 1000.0) if field == 13
            return py_round_half_even(run.state.x * 1000.0) if field == 14
            return py_round_half_even(run.state.z * 1000.0) if field == 15
            observed: Rover::State = Rover::seen(run)
            return py_round_half_even(observed.x * 1000.0) if field == 16
            return py_round_half_even(observed.z * 1000.0) if field == 17
            return py_round_half_even(observed.heading * 1000.0) if field == 18
            return py_round_half_even(observed.v * 1000.0)
