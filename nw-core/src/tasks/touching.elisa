include "../pyrandom.elisa"
include "../pymath.elisa"

module Touching:
    const WORLD: f64 = 100.0
    const TAU: f64 = 6.283185307179586

    struct Grade:
        rung: i64
        sizes: bool
        squares: bool
        count: i64
        margin: f64
        thick: bool

    struct Shape:
        square: bool
        x: mutable f64
        y: mutable f64
        r: f64
        turn: f64
        filled: bool

    struct Point:
        x: f64
        y: f64

    struct Puzzle:
        level: Grade
        seed: i64
        shapes: mutable Shape[6]
        count: mutable i64
        answer: mutable i64

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        margin: f64 = 2.0 - 0.05 * (r - 13).f64() if r >= 13 else 2.5
        return Grade{rung: r, sizes: r >= 4, squares: (r >= 7 and r < 10) or r >= 13,
            count: 0 if r < 10 else (3 + r % 2 if r < 16 else (4 + (r - 16) / 3 if r < 22 else 6)),
            margin: 6.0 if r < 4 else (3.5 if r < 7 else (margin if margin > 1.2 else 1.2)),
            thick: r >= 13}

    def abs_f(value: f64) -> f64:
        return -value if value < 0.0 else value

    def minimum(a: f64, b: f64) -> f64:
        return a if a < b else b

    def uniform(rng: mutable MT19937&, a: f64, b: f64) -> f64:
        return a + (b - a) * py_random(rng)

    def corners(s: Shape) -> Point[4]:
        can Abort.Panic:
            c: f64 = cos(s.turn)
            d: f64 = sin(s.turn)
            u: f64[4] = [-1.0, 1.0, 1.0, -1.0]
            v: f64[4] = [-1.0, -1.0, 1.0, 1.0]
            points: mutable Point[4] = zeroed
            for i in 0..<4 |points, u, v, s, c, d|:
                k: usize = i.usize()
                points[k] <- Point{x: s.x + s.r * (u[k] * c - v[k] * d), y: s.y + s.r * (u[k] * d + v[k] * c)}
            return points

    def segment_distance(p: Point, a: Point, b: Point) -> f64:
        can Abort.Panic:
            dx: f64 = b.x - a.x
            dy: f64 = b.y - a.y
            t: f64 = ((p.x - a.x) * dx + (p.y - a.y) * dy) / (dx * dx + dy * dy)
            along: f64 = 0.0 if t < 0.0 else minimum(1.0, t)
            return py_hypot(p.x - a.x - along * dx, p.y - a.y - along * dy)

    def inside_square(p: Point, s: Shape) -> bool:
        c: f64 = cos(-s.turn)
        d: f64 = sin(-s.turn)
        x: f64 = p.x - s.x
        y: f64 = p.y - s.y
        return abs_f(x * c - y * d) <= s.r and abs_f(x * d + y * c) <= s.r

    def side(p: Point, q: Point, r: Point) -> f64:
        return (q.x - p.x) * (r.y - p.y) - (q.y - p.y) * (r.x - p.x)

    def crosses(a: Point, b: Point, c: Point, d: Point) -> bool:
        return side(c, d, a) * side(c, d, b) < -1e-9 and side(a, b, c) * side(a, b, d) < -1e-9

    def circle_square(circle: Shape, square: Shape) -> f64:
        can Abort.Panic:
            points: Point[4] = corners(square)
            center: Point = Point{x: circle.x, y: circle.y}
            distance: mutable f64 = segment_distance(center, points[0.usize()], points[1.usize()])
            for i in 1..<4 |points, center, distance|:
                distance <- minimum(distance, segment_distance(center, points[i.usize()], points[((i + 1) % 4).usize()]))
            return -(distance + circle.r) if inside_square(center, square) else distance - circle.r

    def gap(a: Shape, b: Shape) -> f64:
        can Abort.Panic:
            if not a.square and not b.square:
                return py_hypot(a.x - b.x, a.y - b.y) - a.r - b.r
            if not a.square:
                return circle_square(a, b)
            if not b.square:
                return circle_square(b, a)
            pa: Point[4] = corners(a)
            pb: Point[4] = corners(b)
            best: mutable f64 = segment_distance(pb[0.usize()], pa[0.usize()], pa[1.usize()])
            deep: mutable bool = false
            for i in 0..<4 |pa, pb, a, b, best, deep|:
                k: usize = i.usize()
                next: usize = ((i + 1) % 4).usize()
                deep <- deep or inside_square(pa[k], b) or inside_square(pb[k], a)
                for j in 0..<4 |pa, pb, k, next, best, deep|:
                    l: usize = j.usize()
                    best <- minimum(best, segment_distance(pb[l], pa[k], pa[next]))
                    best <- minimum(best, segment_distance(pa[l], pb[k], pb[next]))
                    deep <- deep or crosses(pa[k], pa[next], pb[l], pb[((j + 1) % 4).usize()])
            return -best if deep else best

    def place(a: Shape, b: Shape, want: f64, angle: f64) -> Shape:
        can Abort.Panic:
            lo: mutable f64 = 0.0
            hi: mutable f64 = WORLD
            x: f64 = cos(angle)
            y: f64 = sin(angle)
            candidate: mutable Shape = b
            for _step in 0..<80 |a, x, y, want, candidate, lo, hi|:
                mid: f64 = (lo + hi) / 2.0
                candidate.x <- a.x + mid * x
                candidate.y <- a.y + mid * y
                if gap(a, candidate) < want:
                    lo <- mid
                else:
                    hi <- mid
            candidate.x <- a.x + hi * x
            candidate.y <- a.y + hi * y
            return candidate

    def fits(s: Shape) -> bool:
        reach: f64 = s.r * (1.42 if s.square else 1.0)
        return reach + 3.0 < s.x and s.x < WORLD - reach - 3.0 and reach + 3.0 < s.y and s.y < WORLD * 0.62 - reach - 3.0

    def shape(level: Grade, rng: mutable MT19937&) -> Shape:
        square: bool = level.squares and py_random(rng) < 0.5
        radius: f64 = uniform(rng, 8.0, 14.0) if level.sizes else 11.0
        turn: f64 = uniform(rng, 0.0, 1.6)
        filled: bool = level.thick and py_random(rng) < 0.4
        return Shape{square: square, x: WORLD / 2.0, y: WORLD * 0.31,
            r: radius * 0.7 if level.count > 0 else radius, turn: turn, filled: filled}

    def relation(distance: f64) -> i64:
        return 1 if abs_f(distance) < 0.001 else (0 if distance > 0.0 else 2)

    def pair(puzzle: mutable Puzzle&, rng: mutable MT19937&) -> bool:
        can Abort.Panic:
            m: f64 = puzzle.level.margin
            want: i64 = py_randbelow(rng, 3.u64()).i64()
            a: mutable Shape = shape(puzzle.level, rng)
            b: mutable Shape = shape(puzzle.level, rng)
            angle: f64 = uniform(rng, 0.0, TAU)
            # The Python dictionary evaluates both random margins before indexing.
            apart: f64 = uniform(rng, m, 3.0 * m)
            overlap: f64 = -uniform(rng, m, 3.0 * m)
            b <- place(a, b, apart if want == 0 else (overlap if want == 2 else 0.0), angle)
            dx: f64 = WORLD / 2.0 - (a.x + b.x) / 2.0
            dy: f64 = WORLD * 0.31 - (a.y + b.y) / 2.0
            a.x <- a.x + dx
            a.y <- a.y + dy
            b.x <- b.x + dx
            b.y <- b.y + dy
            return false if not fits(a) or not fits(b) or relation(gap(a, b)) != want
            puzzle.shapes[0.usize()] <- a
            puzzle.shapes[1.usize()] <- b
            puzzle.count <- 2
            puzzle.answer <- want
            return true

    def group(puzzle: mutable Puzzle&, rng: mutable MT19937&) -> bool:
        can Abort.Panic:
            level: Grade = puzzle.level
            first: mutable Shape = shape(level, rng)
            first.x <- uniform(rng, 15.0, WORLD - 15.0)
            first.y <- uniform(rng, 12.0, 50.0)
            puzzle.shapes[0.usize()] <- first
            m: f64 = level.margin
            for i in 1..<level.count |puzzle, level, rng, m|:
                s: Shape = shape(level, rng)
                base: Shape = puzzle.shapes[py_randbelow(rng, i.u64()).usize()]
                roll: f64 = py_random(rng)
                amount: f64 = 0.0 if roll < 0.45 else (uniform(rng, m, 3.0 * m) if roll < 0.8 else -uniform(rng, m, 2.5 * m))
                placed: Shape = place(base, s, amount, uniform(rng, 0.0, TAU))
                return false if not fits(placed)
                puzzle.shapes[i.usize()] <- placed
            pairs: mutable i64 = 0
            for i in 0..<level.count |puzzle, pairs, m|:
                for j in 0..<i |i, puzzle, pairs, m|:
                    distance: f64 = abs_f(gap(puzzle.shapes[i.usize()], puzzle.shapes[j.usize()]))
                    if distance < 0.001:
                        pairs <- pairs + 1
                    elif distance < m * 0.95:
                        return false
            return false if pairs > 5
            puzzle.count <- level.count
            puzzle.answer <- pairs
            return true

    def deal(rung: i64, seed: i64) -> Puzzle:
        can Abort.Panic:
            level: Grade = grade(rung)
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
            puzzle: mutable Puzzle = Puzzle{level: level, seed: seed, shapes: zeroed, count: 0, answer: -1}
            for _attempt in 0..<400 |level, puzzle, rng|:
                accepted: bool = pair(&puzzle, &rng) if level.count == 0 else group(&puzzle, &rng)
                return puzzle if accepted
            return puzzle
