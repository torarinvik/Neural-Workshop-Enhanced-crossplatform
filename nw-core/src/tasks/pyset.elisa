# CPython's set, for non-negative int keys, in the one respect that matters:
# ITERATION ORDER.
#
# A Python `set` iterates in the slot order of its open-addressed table, which
# is a pure function of the insertion sequence and the resize schedule. That is
# not an implementation detail we may ignore: several task generators build a
# set, turn it into a list, and SHUFFLE it. A different iteration order gives a
# different shuffle for the same seed, and the whole deal diverges.
#
# So this is setobject.c -- probe loop, linear-probe window, perturb shift and
# growth rule -- and nothing else.
#
# Add AND discard. A discarded entry becomes a DUMMY marker rather than an empty
# one, and the distinction is not cosmetic:
#
#   * probing continues past a dummy (an empty slot ends the probe, a dummy does
#     not), so a key that collided past the discarded one is still findable;
#   * `used` drops but `fill` does NOT, because
#   * a later add SKIPS the dummy and inserts at the first EMPTY slot, bumping
#     `fill` again. Dummies are never refilled.
#
# That last rule is the one worth stating, because the plausible alternative --
# reuse the dummy, as a hand-written table would -- is wrong in a way nothing
# local reveals. Reusing it leaves `fill` low, the table misses its
# `fill * 5 >= mask * 3` resize, and every subsequent iteration order differs.
# Minimised from `add 8; discard 8; add 24; add 11; add 28; add 23`, where a real
# set resizes to 32 slots and a reusing model stays at 8.
#
# The rules above were derived by validating a model against a real `set` over
# 8000 randomised add/discard sequences, not from reading them off; see
# test/pyset_diff.py, which is that check kept as a suite.
#
# Where a set is only asked about MEMBERSHIP, or is run through `sorted()`, the
# order is not observable and a flat array is the right port. Reach for this
# only where the reference genuinely iterates.
#
# Differentially tested against a real `set` by every suite that uses it.

module PySet:
    # setobject.c constants.
    const MINSIZE: i64 = 8
    # Slot sentinels. Keys are non-negative, so negatives are free for these.
    const EMPTY: i64 = -1
    const DUMMY: i64 = -2
    const LINEAR_PROBES: i64 = 9
    const PERTURB_SHIFT: i64 = 5

    struct Table:
        # -1 marks an unused slot, which is why keys must be non-negative.
        slots: mutable darray[i64]
        mask: mutable i64
        fill: mutable i64
        used: mutable i64
        # Scratch for resize: the live keys in old slot order.
        snap: mutable darray[i64]
        snap_n: mutable i64

    # `capacity` sizes the backing arrays once; the table never allocates again,
    # so a caller must pass a bound on the number of inserts (a resize needs
    # room for `snap` too). Rounded up to a power of two at or above MINSIZE.
    def new(capacity: i64) -> Table:
        can Memory.Allocate, Abort.Panic:
            size: mutable i64 = MINSIZE
            while size < capacity * 4 |size, capacity|:
                size <- size * 2
            table: mutable Table = zeroed
            table.slots <- Ints::zeros(size)
            table.snap <- Ints::zeros(size)
            table.mask <- MINSIZE - 1
            table.fill <- 0
            table.used <- 0
            table.snap_n <- 0
            slot: mutable i64 = 0
            while slot < size |slot, size, table|:
                Ints::put(&table.slots, slot, -1)
                slot <- slot + 1
            return table

    def reset(table: mutable Table&):
        can Abort.Panic:
            table.mask <- MINSIZE - 1
            table.fill <- 0
            table.used <- 0
            table.snap_n <- 0
            slot: mutable i64 = 0
            while slot < table.slots.count.i64() |slot, table|:
                Ints::put(&table.slots, slot, -1)
                slot <- slot + 1

    def contains(table: Table&, key: i64) -> bool:
        can Abort.Panic:
            mask: i64 = table.mask
            index: mutable i64 = key & mask
            perturb: mutable i64 = key
            # 0 still looking, 1 present, 2 absent.
            verdict: mutable i64 = 0
            while verdict == 0 |verdict, index, perturb, mask, table, key|:
                probes: i64 = LINEAR_PROBES if index + LINEAR_PROBES <= mask else 0
                slot: mutable i64 = index
                step: mutable i64 = 0
                while step <= probes and verdict == 0 |step, probes, slot, table, key, verdict|:
                    entry: i64 = Ints::at(table.slots, slot)
                    if entry == EMPTY:
                        verdict <- 2
                    elif entry == key:
                        verdict <- 1
                    else:
                        # A DUMMY lands here too: it is not the key and not the end
                        # of the probe, so the scan continues past it.
                        slot <- slot + 1
                        step <- step + 1
                if verdict == 0:
                    perturb <- perturb >> PERTURB_SHIFT
                    index <- (index * 5 + 1 + perturb) & mask
            return verdict == 1

    # set_insert_clean: no equality tests, because the table is known not to
    # hold the key. Used only from the resize path.
    def insert_clean(table: mutable Table&, key: i64):
        can Abort.Panic:
            mask: i64 = table.mask
            index: mutable i64 = key & mask
            perturb: mutable i64 = key
            placed: mutable bool = false
            while not placed |placed, index, perturb, mask, table, key|:
                if Ints::at(table.slots, index) == EMPTY:
                    Ints::put(&table.slots, index, key)
                    placed <- true
                else:
                    if index + LINEAR_PROBES <= mask:
                        slot: mutable i64 = index
                        step: mutable i64 = 0
                        while step < LINEAR_PROBES and not placed |step, slot, table, key, placed|:
                            slot <- slot + 1
                            if Ints::at(table.slots, slot) == EMPTY:
                                Ints::put(&table.slots, slot, key)
                                placed <- true
                            else:
                                step <- step + 1
                    if not placed:
                        perturb <- perturb >> PERTURB_SHIFT
                        index <- (index * 5 + 1 + perturb) & mask

    # set_table_resize: the old table is walked in SLOT order and re-inserted,
    # so the new order is a function of the old one and not of the original
    # insertion sequence.
    def resize(table: mutable Table&, minused: i64):
        can Abort.Panic:
            newsize: mutable i64 = MINSIZE
            while newsize <= minused |newsize, minused|:
                newsize <- newsize * 2
            table.snap_n <- 0
            slot: mutable i64 = 0
            while slot <= table.mask |slot, table|:
                key: i64 = Ints::at(table.slots, slot)
                if key >= 0:
                    Ints::put(&table.snap, table.snap_n, key)
                    table.snap_n <- table.snap_n + 1
                slot <- slot + 1
            table.mask <- newsize - 1
            blank: mutable i64 = 0
            while blank < newsize |blank, newsize, table|:
                Ints::put(&table.slots, blank, -1)
                blank <- blank + 1
            index: mutable i64 = 0
            while index < table.snap_n |index, table|:
                PySet::insert_clean(table, Ints::at(table.snap, index))
                index <- index + 1
            table.fill <- table.used

    def add(table: mutable Table&, key: i64):
        can Abort.Panic:
            mask: i64 = table.mask
            index: mutable i64 = key & mask
            perturb: mutable i64 = key
            vacancy: mutable i64 = -1
            present: mutable bool = false
            while vacancy < 0 and not present |vacancy, present, index, perturb, mask, table, key|:
                probes: i64 = LINEAR_PROBES if index + LINEAR_PROBES <= mask else 0
                slot: mutable i64 = index
                step: mutable i64 = 0
                while step <= probes and vacancy < 0 and not present |step, probes, slot, table, key, vacancy, present|:
                    entry: i64 = Ints::at(table.slots, slot)
                    # ONLY an empty slot is a vacancy. A dummy is skipped and never
                    # refilled -- see the header; refilling it would hold `fill` down
                    # and skip the resize that decides every later iteration order.
                    if entry == EMPTY:
                        vacancy <- slot
                    elif entry == key:
                        present <- true
                    else:
                        slot <- slot + 1
                        step <- step + 1
                if vacancy < 0 and not present:
                    perturb <- perturb >> PERTURB_SHIFT
                    index <- (index * 5 + 1 + perturb) & mask
            return if present
            table.fill <- table.fill + 1
            table.used <- table.used + 1
            Ints::put(&table.slots, vacancy, key)
            return if table.fill * 5 < mask * 3
            # CPython grows to `used * 2` above 50000 live entries; nothing here
            # gets within two orders of magnitude of that.
            PySet::resize(table, table.used * 4)

    # Remove `key` if present. The slot becomes a DUMMY rather than an EMPTY, so a
    # key that probed past it is still reachable; `used` drops and `fill` holds.
    def discard(table: mutable Table&, key: i64):
        can Abort.Panic:
            mask: i64 = table.mask
            index: mutable i64 = key & mask
            perturb: mutable i64 = key
            # 0 still looking, 1 removed, 2 absent.
            verdict: mutable i64 = 0
            while verdict == 0 |verdict, index, perturb, mask, table, key|:
                probes: i64 = LINEAR_PROBES if index + LINEAR_PROBES <= mask else 0
                slot: mutable i64 = index
                step: mutable i64 = 0
                while step <= probes and verdict == 0 |step, probes, slot, table, key, verdict|:
                    entry: i64 = Ints::at(table.slots, slot)
                    if entry == EMPTY:
                        verdict <- 2
                    elif entry == key:
                        Ints::put(&table.slots, slot, DUMMY)
                        table.used <- table.used - 1
                        verdict <- 1
                    else:
                        slot <- slot + 1
                        step <- step + 1
                if verdict == 0:
                    perturb <- perturb >> PERTURB_SHIFT
                    index <- (index * 5 + 1 + perturb) & mask

    # `set(other)` -- CPython's set_merge onto an EMPTY target.
    #
    # Which of its two paths runs decides the iteration order, so both are here:
    #
    #   1. pre-resize the target when `(fill + other.used) * 5 >= mask * 3`, to
    #      `(used + other.used) * 2`;
    #   2. copy the entries WHOLESALE only when the target is empty, the masks
    #      now MATCH, and the source carries no dummies;
    #   3. otherwise insert one by one in the source's iteration order, which
    #      rehashes into a differently shaped table and generally reorders.
    #
    # Both paths are reachable in practice and they disagree. Sokoban's three
    # goal cells 27, 35 and 43 take path 2 and keep their order; its five goal
    # cells 64, 65, 45, 46, 55 take path 3 -- the source is already at mask 31
    # while the pre-resized target lands at mask 15 -- and come out reordered as
    # 64, 65, 55, 45, 46. Assuming either path alone gets one of those wrong.
    #
    # Modelled and checked against real `set(frozenset(...))` over 3000 random
    # key sets before being written here.
    def copy_from(from_table: Table&, to_table: mutable Table&):
        can Abort.Panic:
            PySet::reset(to_table)
            if (to_table.fill + from_table.used) * 5 >= to_table.mask * 3:
                PySet::resize(to_table, (to_table.used + from_table.used) * 2)
            if to_table.fill == 0 and to_table.mask == from_table.mask and from_table.fill == from_table.used:
                slot: mutable i64 = 0
                while slot <= from_table.mask |slot, from_table, to_table|:
                    Ints::put(&to_table.slots, slot, Ints::at(from_table.slots, slot))
                    slot <- slot + 1
                to_table.fill <- from_table.fill
                to_table.used <- from_table.used
            else:
                scan: mutable i64 = 0
                while scan <= from_table.mask |scan, from_table, to_table|:
                    key: i64 = Ints::at(from_table.slots, scan)
                    PySet::add(to_table, key) if key >= 0
                    scan <- scan + 1

    # The set's keys in ITERATION order -- the whole reason this file exists.
    # `out` is filled from slot 0 up and its live count returned.
    def to_list(table: Table&, out: mutable darray[i64]&) -> i64:
        can Abort.Panic:
            count: mutable i64 = 0
            slot: mutable i64 = 0
            while slot <= table.mask |slot, table, out, count|:
                key: i64 = Ints::at(table.slots, slot)
                if key >= 0:
                    Ints::put(out, count, key)
                    count <- count + 1
                slot <- slot + 1
            return count

# CPython's set again, but keyed by 2-TUPLES of small non-negative ints -- the
# `(x, y)` points `go` keeps in sets and then reads positionally through
# `rng.choice(tuple(boundary))`.
#
# Everything about the table is the same; what changes is that the slot comes
# from the TUPLE HASH rather than from the key, so key and hash are no longer the
# same number. Keys are stored encoded as `x * STRIDE + y` and the hash is
# recomputed from that encoding, which keeps one array instead of two.
#
# The hash is CPython's xxHash-derived tuplehash. It was checked against
# `hash((x, y))` for every point in 0..11 squared, and the whole table against
# real `set` behaviour over 4000 random add/discard sequences, before being
# written here.
module PyPoint:
    const STRIDE: i64 = 32
    const XXPRIME_1: u64 = 11400714785074694791
    const XXPRIME_2: u64 = 14029467366897019727
    const XXPRIME_5: u64 = 2870177450012600261

    def encode(x: i64, y: i64) -> i64:
        return x * STRIDE + y

    def decode_x(key: i64) -> i64:
        return key / STRIDE

    def decode_y(key: i64) -> i64:
        return key % STRIDE

    # `acc` rotated left by 31, which is CPython's _PyHASH_XXROTATE.
    def rotate(value: u64) -> u64:
        return (value << 31.u64()) | (value >> 33.u64())

    # tuplehash for a 2-tuple of non-negative ints. A small int hashes to itself,
    # so the lane IS the coordinate.
    def hash_of(x: i64, y: i64) -> u64:
        acc: mutable u64 = XXPRIME_5
        acc <- acc + x.u64() * XXPRIME_2
        acc <- PyPoint::rotate(acc)
        acc <- acc * XXPRIME_1
        acc <- acc + y.u64() * XXPRIME_2
        acc <- PyPoint::rotate(acc)
        acc <- acc * XXPRIME_1
        return acc + (2.u64() ^ (XXPRIME_5 ^ 3527539.u64()))

    def hash_of_key(key: i64) -> u64:
        return PyPoint::hash_of(PyPoint::decode_x(key), PyPoint::decode_y(key))

    struct PointTable:
        slots: mutable darray[i64]
        mask: mutable i64
        fill: mutable i64
        used: mutable i64
        snap: mutable darray[i64]
        snap_n: mutable i64

    def new(capacity: i64) -> PointTable:
        can Memory.Allocate, Abort.Panic:
            size: mutable i64 = PySet::MINSIZE
            while size < capacity * 4 |size, capacity|:
                size <- size * 2
            table: mutable PointTable = zeroed
            table.slots <- Ints::zeros(size)
            table.snap <- Ints::zeros(size)
            table.mask <- PySet::MINSIZE - 1
            table.fill <- 0
            table.used <- 0
            table.snap_n <- 0
            slot: mutable i64 = 0
            while slot < size |slot, size, table|:
                Ints::put(&table.slots, slot, PySet::EMPTY)
                slot <- slot + 1
            return table

    def reset(table: mutable PointTable&):
        can Abort.Panic:
            table.mask <- PySet::MINSIZE - 1
            table.fill <- 0
            table.used <- 0
            table.snap_n <- 0
            slot: mutable i64 = 0
            while slot < table.slots.count.i64() |slot, table|:
                Ints::put(&table.slots, slot, PySet::EMPTY)
                slot <- slot + 1

    def contains(table: PointTable&, x: i64, y: i64) -> bool:
        can Abort.Panic:
            key: i64 = PyPoint::encode(x, y)
            mask: i64 = table.mask
            hash_value: u64 = PyPoint::hash_of(x, y)
            index: mutable i64 = (hash_value & mask.u64()).i64()
            perturb: mutable u64 = hash_value
            verdict: mutable i64 = 0
            while verdict == 0 |verdict, index, perturb, mask, table, key|:
                probes: i64 = PySet::LINEAR_PROBES if index + PySet::LINEAR_PROBES <= mask else 0
                slot: mutable i64 = index
                step: mutable i64 = 0
                while step <= probes and verdict == 0 |step, probes, slot, table, key, verdict|:
                    entry: i64 = Ints::at(table.slots, slot)
                    if entry == PySet::EMPTY:
                        verdict <- 2
                    elif entry == key:
                        verdict <- 1
                    else:
                        slot <- slot + 1
                        step <- step + 1
                if verdict == 0:
                    perturb <- perturb >> PySet::PERTURB_SHIFT.u64()
                    index <- ((index * 5 + 1).u64() + perturb).i64() & mask
            return verdict == 1

    def insert_clean(table: mutable PointTable&, key: i64):
        can Abort.Panic:
            mask: i64 = table.mask
            hash_value: u64 = PyPoint::hash_of_key(key)
            index: mutable i64 = (hash_value & mask.u64()).i64()
            perturb: mutable u64 = hash_value
            placed: mutable bool = false
            while not placed |placed, index, perturb, mask, table, key|:
                probes: i64 = PySet::LINEAR_PROBES if index + PySet::LINEAR_PROBES <= mask else 0
                slot: mutable i64 = index
                step: mutable i64 = 0
                while step <= probes and not placed |step, probes, slot, table, key, placed|:
                    if Ints::at(table.slots, slot) == PySet::EMPTY:
                        Ints::put(&table.slots, slot, key)
                        placed <- true
                    else:
                        slot <- slot + 1
                        step <- step + 1
                if not placed:
                    perturb <- perturb >> PySet::PERTURB_SHIFT.u64()
                    index <- ((index * 5 + 1).u64() + perturb).i64() & mask

    def resize(table: mutable PointTable&, minused: i64):
        can Abort.Panic:
            newsize: mutable i64 = PySet::MINSIZE
            while newsize <= minused |newsize, minused|:
                newsize <- newsize * 2
            table.snap_n <- 0
            slot: mutable i64 = 0
            while slot <= table.mask |slot, table|:
                key: i64 = Ints::at(table.slots, slot)
                if key >= 0:
                    Ints::put(&table.snap, table.snap_n, key)
                    table.snap_n <- table.snap_n + 1
                slot <- slot + 1
            table.mask <- newsize - 1
            blank: mutable i64 = 0
            while blank < newsize |blank, newsize, table|:
                Ints::put(&table.slots, blank, PySet::EMPTY)
                blank <- blank + 1
            index: mutable i64 = 0
            while index < table.snap_n |index, table|:
                PyPoint::insert_clean(table, Ints::at(table.snap, index))
                index <- index + 1
            table.fill <- table.used

    def add(table: mutable PointTable&, x: i64, y: i64):
        can Abort.Panic:
            key: i64 = PyPoint::encode(x, y)
            mask: i64 = table.mask
            hash_value: u64 = PyPoint::hash_of(x, y)
            index: mutable i64 = (hash_value & mask.u64()).i64()
            perturb: mutable u64 = hash_value
            vacancy: mutable i64 = -1
            present: mutable bool = false
            while vacancy < 0 and not present |vacancy, present, index, perturb, mask, table, key|:
                probes: i64 = PySet::LINEAR_PROBES if index + PySet::LINEAR_PROBES <= mask else 0
                slot: mutable i64 = index
                step: mutable i64 = 0
                while step <= probes and vacancy < 0 and not present |step, probes, slot, table, key, vacancy, present|:
                    entry: i64 = Ints::at(table.slots, slot)
                    if entry == PySet::EMPTY:
                        vacancy <- slot
                    elif entry == key:
                        present <- true
                    else:
                        slot <- slot + 1
                        step <- step + 1
                if vacancy < 0 and not present:
                    perturb <- perturb >> PySet::PERTURB_SHIFT.u64()
                    index <- ((index * 5 + 1).u64() + perturb).i64() & mask
            return if present
            table.fill <- table.fill + 1
            table.used <- table.used + 1
            Ints::put(&table.slots, vacancy, key)
            return if table.fill * 5 < mask * 3
            PyPoint::resize(table, table.used * 4)

    def discard(table: mutable PointTable&, x: i64, y: i64):
        can Abort.Panic:
            key: i64 = PyPoint::encode(x, y)
            mask: i64 = table.mask
            hash_value: u64 = PyPoint::hash_of(x, y)
            index: mutable i64 = (hash_value & mask.u64()).i64()
            perturb: mutable u64 = hash_value
            verdict: mutable i64 = 0
            while verdict == 0 |verdict, index, perturb, mask, table, key|:
                probes: i64 = PySet::LINEAR_PROBES if index + PySet::LINEAR_PROBES <= mask else 0
                slot: mutable i64 = index
                step: mutable i64 = 0
                while step <= probes and verdict == 0 |step, probes, slot, table, key, verdict|:
                    entry: i64 = Ints::at(table.slots, slot)
                    if entry == PySet::EMPTY:
                        verdict <- 2
                    elif entry == key:
                        Ints::put(&table.slots, slot, PySet::DUMMY)
                        table.used <- table.used - 1
                        verdict <- 1
                    else:
                        slot <- slot + 1
                        step <- step + 1
                if verdict == 0:
                    perturb <- perturb >> PySet::PERTURB_SHIFT.u64()
                    index <- ((index * 5 + 1).u64() + perturb).i64() & mask

    # The encoded keys in ITERATION order -- the whole reason this exists.
    def to_list(table: PointTable&, out: mutable darray[i64]&) -> i64:
        can Abort.Panic:
            count: mutable i64 = 0
            slot: mutable i64 = 0
            while slot <= table.mask |slot, table, out, count|:
                key: i64 = Ints::at(table.slots, slot)
                if key >= 0:
                    Ints::put(out, count, key)
                    count <- count + 1
                slot <- slot + 1
            return count
