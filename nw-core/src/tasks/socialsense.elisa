include "./reading_quiz.elisa"

module SocialSense:
    # socialsense.py: everyday situations, each with a question and three
    # answers; from rung 13 two questions about the same situation.
    const ITEMS: i64 = 12
    # LADDER flattened: feel, describe | want, need | why, others_feel,
    # happens | next.
    const KINDS: i64 = 8

    struct Grade:
        rung: i64
        kinds: i64
        pairs: bool
        pace: ReadingQuiz::Pace

    struct Question:
        kind: dstr
        prompt: dstr
        ask: dstr
        options: darray[dstr]
        answer: i64

    # The questions of one prompt that ask at least two different things.
    struct Situation:
        questions: mutable darray[Question]

    struct Corpus:
        pools: mutable darray[Question][8]
        situations: mutable darray[Situation]

    struct Round:
        level: Grade
        quiz: ReadingQuiz::Round

    struct Deck:
        cards: mutable darray[i64]
        taken: mutable i64

    def kind_name(kind: i64) -> cstr:
        return "feel" if kind == 0
        return "describe" if kind == 1
        return "want" if kind == 2
        return "need" if kind == 3
        return "why" if kind == 4
        return "others_feel" if kind == 5
        return "happens" if kind == 6
        return "next" if kind == 7
        return ""

    def grade(requested: i64) -> Grade:
        rung: i64 = requested if requested > 0 else 1
        steps: i64 = 1 + (rung - 1) / 3
        kinds: i64 = 2 if steps <= 1 else (4 if steps == 2 else (7 if steps == 3 else 8))
        return Grade{rung: rung, kinds: kinds, pairs: rung >= 13, pace: ReadingQuiz::reading_pace(rung, 2.2, 4.5, 5.0, 2.0)}

    def same_prompt(left: dstr, right: dstr) -> bool:
        can Abort.Panic:
            return false if left.count != right.count
            for i in 0..<left.count.i64() |left, right|:
                return false if left[i.usize()] != right[i.usize()]
            return true

    def seen_prompt(items: darray[ReadingQuiz::Item]&, prompt: dstr) -> bool:
        can Abort.Panic:
            for item in items:
                return true if same_prompt(item.prompt, prompt)
            return false

    # Python's str ordering: by code point, which UTF-8 bytes keep.
    def compare_text(left: dstr&, right: dstr&) -> i64:
        can Abort.Panic:
            shorter: i64 = left.count.i64() if left.count < right.count else right.count.i64()
            for i in 0..<shorter |left, right|:
                a: u8 = left[i.usize()]
                b: u8 = right[i.usize()]
                return -1 if a < b
                return 1 if a > b
            return -1 if left.count < right.count
            return 1 if left.count > right.count
            return 0

    # The Question namedtuple's ordering: kind, prompt, ask, options, answer.
    def compare_question(left: Question&, right: Question&) -> i64:
        can Abort.Panic:
            order: mutable i64 = compare_text(&left.kind, &right.kind)
            return order if order != 0
            order <- compare_text(&left.prompt, &right.prompt)
            return order if order != 0
            order <- compare_text(&left.ask, &right.ask)
            return order if order != 0
            shorter: i64 = left.options.count.i64() if left.options.count < right.options.count else right.options.count.i64()
            for i in 0..<shorter |left, right, order|:
                order <- compare_text(&left.options[i.usize()], &right.options[i.usize()])
                return order if order != 0
            return -1 if left.options.count < right.options.count
            return 1 if left.options.count > right.options.count
            return -1 if left.answer < right.answer
            return 1 if left.answer > right.answer
            return 0

    def situation_less(left: Situation&, right: Situation&) -> bool:
        can Abort.Panic:
            shorter: i64 = left.questions.count.i64() if left.questions.count < right.questions.count else right.questions.count.i64()
            for i in 0..<shorter |left, right|:
                order: i64 = compare_question(&left.questions[i.usize()], &right.questions[i.usize()])
                return order < 0 if order != 0
            return left.questions.count < right.questions.count

    # sorted(): a stable merge sort of the situation indices.
    def sort_situations(situations: darray[Situation]&) -> darray[i64]:
        can Memory.Allocate, Abort.Panic:
            order: mutable darray[i64] = ReadingQuiz::indices_of(situations.count.i64())
            count: i64 = order.count.i64()
            width: mutable i64 = 1
            while width < count |order, width, count, situations|:
                merged: mutable darray[i64] = []
                start: mutable i64 = 0
                while start < count |order, merged, start, width, count, situations|:
                    middle: i64 = start + width if start + width < count else count
                    end: i64 = start + 2 * width if start + 2 * width < count else count
                    i: mutable i64 = start
                    j: mutable i64 = middle
                    while i < middle or j < end |order, merged, i, j, middle, end, situations|:
                        if j >= end:
                            merged.push(order[i.usize()])
                            i <- i + 1
                        elif i >= middle:
                            merged.push(order[j.usize()])
                            j <- j + 1
                        elif situation_less(&situations[order[j.usize()].usize()], &situations[order[i.usize()].usize()]):
                            merged.push(order[j.usize()])
                            j <- j + 1
                        else:
                            merged.push(order[i.usize()])
                            i <- i + 1
                    start <- end
                order <- merged
                width <- width * 2
            return order

    def shuffled_deck(count: i64, draw: mutable MT19937&) -> Deck:
        can Memory.Allocate, Abort.Panic:
            cards: mutable darray[i64] = ReadingQuiz::indices_of(count)
            py_shuffle_i64(draw, &cards)
            return Deck{cards: cards, taken: 0}

    def take(deck: mutable Deck&) -> i64:
        can Abort.Panic:
            count: i64 = deck.cards.count.i64()
            return -1 if count == 0
            card: i64 = deck.cards[(deck.taken % count).usize()]
            deck.taken <- deck.taken + 1
            return card

    def one_question(question: Question&, level: Grade, draw: mutable MT19937&) -> ReadingQuiz::Item:
        can Memory.Allocate, Abort.Panic:
            steps: darray[ReadingQuiz::Step] = [ReadingQuiz::shuffled_step(question.ask, &question.options, question.answer, draw)]
            return ReadingQuiz::reading_item(question.prompt, steps, level.pace, "A situation")

    # {o.ask: o for o in pair}: the first two asks, each with its last
    # question, shuffled, and a step for each.
    def pair_item(situation: Situation&, level: Grade, draw: mutable MT19937&) -> ReadingQuiz::Item:
        can Memory.Allocate, Abort.Panic:
            chosen: mutable darray[i64] = []
            for index in 0..<situation.questions.count.i64() |situation, chosen|:
                question: Question = situation.questions[index.usize()]
                placed: mutable bool = false
                for slot in 0..<chosen.count.i64() |chosen, situation, question, placed, index|:
                    if same_prompt(situation.questions[chosen[slot.usize()].usize()].ask, question.ask):
                        chosen[slot.usize()] <- index
                        placed <- true
                chosen.push(index) if not placed
            picked: mutable darray[i64] = [chosen[0], chosen[1]]
            py_shuffle_i64(draw, &picked)
            steps: mutable darray[ReadingQuiz::Step] = []
            for index in picked:
                question: Question = situation.questions[index.usize()]
                steps.push(ReadingQuiz::shuffled_step(question.ask, &question.options, question.answer, draw))
            first: Question = situation.questions[picked[0].usize()]
            return ReadingQuiz::reading_item(first.prompt, steps, level.pace, "A situation")

    def build(level: Grade, draw: mutable MT19937&, corpus: Corpus&) -> Round:
        can Memory.Allocate, Abort.Panic:
            kinds: mutable darray[i64] = []
            for kind in 0..<level.kinds |kinds, corpus|:
                kinds.push(kind) if corpus.pools[kind.usize()].count > 0.usize()
            pools: mutable Deck[8] = zeroed
            for kind in kinds:
                pools[kind.usize()] <- shuffled_deck(corpus.pools[kind.usize()].count.i64(), draw)
            return zeroed if kinds.count == 0.usize()
            # The situations are always shuffled, paired rung or not.
            pairs: mutable Deck = shuffled_deck(corpus.situations.count.i64(), draw)
            order: mutable darray[i64] = []
            for i in 0..<ITEMS |order, kinds|:
                order.push(kinds[(i % kinds.count.i64()).usize()])
            py_shuffle_i64(draw, &order)
            offered: mutable darray[ReadingQuiz::Item] = []
            spent: mutable bool[8] = zeroed
            for kind in order:
                kept: mutable ReadingQuiz::Item = zeroed
                fresh: mutable bool = false
                limit: i64 = 1 if spent[kind.usize()] else 400
                for _ in 0..<limit |kept, fresh, kind, level, pools, pairs, corpus, draw, offered|:
                    break if fresh
                    got: mutable ReadingQuiz::Item = zeroed
                    if level.pairs:
                        card: i64 = take(&pairs)
                        if card >= 0:
                            got <- pair_item(&corpus.situations[card.usize()], level, draw)
                    else:
                        card: i64 = take(&pools[kind.usize()])
                        if card >= 0:
                            got <- one_question(&corpus.pools[kind.usize()][card.usize()], level, draw)
                    if got.steps.count > 0.usize():
                        kept <- got if kept.steps.count == 0.usize()
                        if not seen_prompt(&offered, got.prompt):
                            kept <- got
                            fresh <- true
                spent[kind.usize()] <- true if not fresh
                offered.push(kept) if kept.steps.count > 0.usize()
            return zeroed if offered.count.i64() < ITEMS
            # ceil(0.7 * 12)
            quiz: ReadingQuiz::Round = ReadingQuiz::assemble(offered, 9)
            return Round{level: level, quiz: quiz}

    def deal(level: Grade, draw: mutable MT19937&, corpus: Corpus&) -> Round:
        can Memory.Allocate, Abort.Panic:
            for _ in 0..<40 |level, draw, corpus|:
                next: mutable MT19937 = zeroed
                mt_seed_int(&next, py_getrandbits(draw, 32))
                round: Round = build(level, &next, corpus)
                # The reference player answers every question immediately, so
                # every assembled round clears the score and time checks.
                return round if round.quiz.items.count > 0.usize()
            return zeroed
