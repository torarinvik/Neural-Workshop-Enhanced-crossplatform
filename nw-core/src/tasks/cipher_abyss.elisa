include "../hand_view.elisa"

module CipherAbyss:
    const SYMBOLS: i64 = 8
    const SYMBOL: i64 = HandView::KEYS
    const DELETE: i64 = SYMBOL + SYMBOLS
    const RUN: i64 = DELETE + 1
    const TEST: i64 = DELETE + 2
    const NEXT_BLOCK: i64 = DELETE + 3
    const PREV_BLOCK: i64 = DELETE + 4
    const ADD_BLOCK: i64 = DELETE + 5
    const UNDO_BLOCK: i64 = DELETE + 6
    const CHECK: i64 = DELETE + 7
    const SUBMIT: i64 = DELETE + 8
    const PREDICT: i64 = DELETE + 9
    const SCROLL_UP: i64 = DELETE + 10
    const SCROLL_DOWN: i64 = DELETE + 11
    const MARK: i64 = DELETE + 12
    const NUMBERS: i64 = DELETE + 13
    const SORT: i64 = DELETE + 14
    const PORTS: i64 = DELETE + 15

    struct Grade:
        rung: i64
        stage: i64
        step: i64
        symbols: i64
        length: i64
        budget: i64
        tests: i64
        seconds: f64

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        stage: i64 = 11 if r >= 40 else (10 if r >= 28 else (r + 2) / 3)
        index: usize = (stage - 1).usize()
        start: i64 = 40 if stage == 11 else 3 * (stage - 1) + 1
        step: i64 = r - start
        symbols_by_stage: i64[11] = [2, 3, 3, 4, 4, 5, 4, 4, 5, 6, 6]
        lengths: i64[11] = [4, 5, 5, 6, 6, 7, 6, 6, 6, 6, 7]
        budgets: i64[11] = [8, 8, 9, 9, 9, 9, 9, 9, 10, 10, 10]
        k: mutable i64 = 8 if stage == 7 and step == 2 else symbols_by_stage[index]
        length: mutable i64 = lengths[index]
        budget: mutable i64 = budgets[index] - (min(2, step / 2) if stage < 10 else min(4, step / 3))
        tests: mutable i64 = 3 if stage < 9 else 4
        if stage == 1 and step < 2:
            length <- 3 if step == 0
            budget <- 8
            tests <- 2
        elif stage == 2:
            length <- 4 + min(step, 1)
        elif stage == 10:
            length <- length + min(2, step / 4)
        elif stage == 11:
            k <- min(SYMBOLS, 6 + step / 20)
            length <- min(12, 7 + step / 8)
            budget <- max(4, 10 - step / 6)
            tests <- min(6, 4 + step / 30)
        return Grade{rung: r, stage: stage, step: step, symbols: k, length: length, budget: budget,
            tests: tests, seconds: fmin(1200.0, 300.0 + 30.0 * r.f64())}

    def min(a: i64, b: i64) -> i64:
        return a if a < b else b

    def max(a: i64, b: i64) -> i64:
        return a if a > b else b

    def plain(g: Grade) -> bool:
        return g.stage == 1 and g.step < 2

    def stage_name(g: Grade) -> cstr:
        return "patterns" if g.stage == 1
        return "transformations" if g.stage == 2
        return "conditions" if g.stage == 3
        return "composition" if g.stage == 4
        return "state" if g.stage == 5
        return "hidden language" if g.stage == 6
        return "cryptography" if g.stage == 7
        return "rules that change rules" if g.stage == 8
        return "nested" if g.stage == 9
        return "adversarial" if g.stage == 10
        return "open-ended"
