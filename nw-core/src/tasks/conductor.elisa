include "../hand_view.elisa"
include "../pymath.elisa"
include "../pyrandom.elisa"
include "./drshape_deal.elisa"

module Conductor:
    const LOUDER: i64 = HandView::KEYS
    const SOFTER: i64 = LOUDER + 1
    const PORTS: i64 = LOUDER + 2

    const ENTER: i64 = 0
    const CUT: i64 = 1
    const LOUD: i64 = 2
    const SOFT: i64 = 3
    const BEAT: i64 = 4
    const CLICK: i64 = 5

    const ALL: i64 = 0
    const BARS: i64 = 1
    const START: i64 = 2

    const DRUM: i64 = 0
    const STRINGS: i64 = 1
    const WIND: i64 = 2
    const BRASS: i64 = 3
    const SLIP: i64 = 4
    const DONE: i64 = 5

    const LIVE: i64 = 0
    const BRAVO: i64 = 1
    const FELL_APART: i64 = 2

    struct Grade:
        rung: i64
        beats: i64
        cues: i64
        period: f64
        moment: f64
        numbers: i64
        strict: bool
        bend: f64
        slips: i64

    struct Cue:
        beat: i64
        kind: i64
        section: i64

    struct Piece:
        level: Grade
        times: darray[f64]
        cues: darray[Cue]
        key: i64
        seed: i64

    struct Run:
        piece: Piece
        playing: mutable bool[4]
        hand: mutable HandView::Pointer
        loud: mutable i64
        beaten: mutable darray[bool]
        done: mutable darray[bool]
        slips: mutable i64
        fall: mutable f64
        last_y: mutable f64
        next: mutable i64
        judged: mutable i64
        flash: mutable f64
        time: mutable f64
        end: f64
        result: mutable i64
        audible: bool
        notes: mutable darray[DrShapeDeal::Note]

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        top: i64 = r - 20 if r > 20 else 0
        beats: i64 = 8 if r < 4 else (12 if r < 10 else (16 if r < 20 else 20 + 2 * (top / 2)))
        cues: i64 = 1 if r < 4 else (2 if r < 7 else (3 if r < 13 else (4 if r < 20 else 5 + top / 3)))
        period: f64 = 1.0 if r < 4 else (0.85 if r < 10 else (0.7 if r < 16 else (0.62 if r < 20 else fmax(0.42, 0.6 - 0.006 * top.f64()))))
        moment: f64 = 0.3 if r < 4 else (0.24 if r < 10 else (0.19 if r < 20 else fmax(0.1, 0.18 - 0.003 * top.f64())))
        bend: f64 = 0.0 if r < 16 else (0.18 if r < 20 else fmin(0.3, 0.2 + 0.005 * top.f64()))
        numbers: i64 = ALL if r < 7 else (BARS if r < 13 else START)
        slips: i64 = 3 if r < 7 else (2 if r < 13 else (1 if r < 20 else 0))
        return Grade{rung: r, beats: beats, cues: cues, period: period, moment: moment,
            numbers: numbers, strict: r >= 10, bend: bend, slips: slips}

    def start_sections() -> bool[4]:
        return [true, false, false, true]

    def select_cue(level: Grade, beat: i64, draw: mutable MT19937&, playing: mutable bool[4]&) -> Cue:
        can Abort.Panic:
            players: mutable i64 = 0
            for s in 0..<4 |playing, players|:
                players <- players + 1 if playing[s.usize()]
            kinds: mutable i64[4] = zeroed
            n: mutable i64 = 0
            if players < 4:
                kinds[n.usize()] <- ENTER
                n <- n + 1
            if level.rung >= 7 and players > 1:
                kinds[n.usize()] <- CUT
                n <- n + 1
            if level.rung >= 4:
                kinds[n.usize()] <- LOUD
                kinds[(n + 1).usize()] <- SOFT
                n <- n + 2
            kind: i64 = kinds[py_randbelow(draw, n.u64()).usize()]
            section: mutable i64 = -1
            if kind == ENTER or kind == CUT:
                choices: mutable i64[4] = zeroed
                count: mutable i64 = 0
                for s in 0..<4 |choices, count, playing, kind|:
                    if playing[s.usize()] == (kind == CUT):
                        choices[count.usize()] <- s
                        count <- count + 1
                section <- choices[py_randbelow(draw, count.u64()).usize()]
                playing[section.usize()] <- kind == ENTER
            return Cue{beat: beat, kind: kind, section: section}

    def build(level: Grade, draw: mutable MT19937&) -> Piece:
        can Abort.Panic, Memory.Allocate:
            time: mutable f64 = 2.0
            wave: f64 = 6.28 * py_random(draw)
            times: mutable darray[f64] = []
            for k in 0..<level.beats |times, time, level, wave|:
                times.push(time)
                time <- time + level.period * (1.0 + level.bend * sin(wave + k.f64() * 0.45))
            beats: mutable darray[i64] = py_sample_range(draw, 3, level.beats, level.cues)
            for i in 1..<beats.count.i64() |beats|:
                beat: i64 = beats[i.usize()]
                j: mutable i64 = i
                while j > 0 and beats[(j - 1).usize()] > beat |beats, j, beat|:
                    beats[j.usize()] <- beats[(j - 1).usize()]
                    j <- j - 1
                beats[j.usize()] <- beat
            playing: mutable bool[4] = start_sections()
            cues: mutable darray[Cue] = []
            for beat in beats:
                cues.push(select_cue(level, beat, draw, &playing))
            key: i64 = py_randbelow(draw, 12.u64()).i64()
            seed: i64 = py_randbelow(draw, 1073741824.u64()).i64()
            return Piece{level: level, times: times, cues: cues, key: key, seed: seed}

    def lens() -> HandView::Lens:
        can Abort.Panic:
            return HandView::lens(RoomsView::vec(0.0, 4.5, 3.0), RoomsView::vec(0.0, 0.5, -7.0), 600.0, 500.0, 250.0)

    def seat(section: i64) -> RoomsView::Vec:
        return RoomsView::vec(-4.5, 0.0, -5.0) if section == 0
        return RoomsView::vec(0.0, 0.0, -7.0) if section == 1
        return RoomsView::vec(4.5, 0.0, -5.0) if section == 2
        return RoomsView::vec(0.0, 0.8, -10.0)

    def spot(section: i64) -> RoomsView::Vec:
        can Abort.Panic:
            view: HandView::Lens = lens()
            q: RoomsView::Vec = HandView::see(&view, seat(section))
            return RoomsView::vec(q.x, q.y + 30.0, q.z)

    def begin(piece: Piece, audible: bool = true) -> Run:
        can Abort.Panic, Memory.Allocate:
            beaten: mutable darray[bool] = []
            done: mutable darray[bool] = []
            for _ in 0..<piece.times.count.i64() |beaten|:
                beaten.push(false)
            for _ in 0..<piece.cues.count.i64() |done|:
                done.push(false)
            hand: HandView::Pointer = HandView::initialize()
            end: f64 = piece.times[piece.times.count - 1.usize()] + 1.5
            return Run{piece: piece, playing: start_sections(), hand: hand, loud: 1, beaten: beaten, done: done,
                slips: 0, fall: 0.0, last_y: hand.y, next: 0, judged: 0, flash: -1.0, time: 0.0,
                end: end, result: LIVE, audible: audible, notes: []}

    def note(run: mutable Run&, duration: f64, pitch: f64, voice: i64, gain: f64, pan: f64 = 0.0):
        can Abort.Panic, Memory.Allocate:
            return if not run.audible
            run.notes.push(DrShapeDeal::Note{t: run.time, dur: duration, freq: pitch, voice: voice,
                gain: gain, gain2: gain, pan: pan, pan2: pan, bright: 0.8, seed: 1 + run.notes.count.i64(), who: -1, room: 0.0})

    def near_beat(run: Run&) -> i64:
        can Abort.Panic:
            # Judged beats are already outside the window.
            for k in run.judged..<run.piece.times.count.i64() |run|:
                beat: f64 = run.piece.times[k.usize()]
                return k if fabs(run.time - beat) <= run.piece.level.moment
                break if beat > run.time
            return -1

    def cue_at(piece: Piece&, k: i64) -> i64:
        can Abort.Panic:
            for j in 0..<piece.cues.count.i64() |piece, k|:
                beat: i64 = piece.cues[j.usize()].beat
                return j if beat == k + 1
                break if beat > k + 1
            return -1

    def shown_beat(run: Run&) -> i64:
        k: i64 = run.next
        how: i64 = run.piece.level.numbers
        return k if k >= 1 and (how == ALL or (how == BARS and (k - 1) % 4 == 0) or (how == START and k <= 4))
        return 0

    def slip(run: mutable Run&):
        can Abort.Panic, Memory.Allocate:
            run.slips <- run.slips + 1
            note(run, 0.15, 110.0, SLIP, 0.4)
            run.result <- FELL_APART if run.slips > run.piece.level.slips

    def mark(run: mutable Run&, action: i64, section: i64 = -1):
        can Abort.Panic, Memory.Allocate:
            k: i64 = near_beat(run)
            if k < 0:
                slip(run) if action != BEAT or run.piece.level.strict
                return
            if action == BEAT:
                run.beaten[k.usize()] <- true
                return
            j: i64 = cue_at(&run.piece, k)
            if j < 0 or run.done[j.usize()]:
                slip(run)
                return
            cue: Cue = run.piece.cues[j.usize()]
            valid: bool = cue.kind == action if action != CLICK else ((cue.kind == ENTER or cue.kind == CUT) and cue.section == section)
            if not valid:
                slip(run)
                return
            run.done[j.usize()] <- true
            run.beaten[k.usize()] <- true
            run.flash <- run.time
            if cue.kind == ENTER or cue.kind == CUT:
                run.playing[section.usize()] <- cue.kind == ENTER
            elif cue.kind == LOUD:
                run.loud <- run.loud + 1 if run.loud < 2
            else:
                run.loud <- run.loud - 1 if run.loud > 0

    def press(run: mutable Run&):
        can Abort.Panic, Memory.Allocate:
            return if run.result != LIVE or run.hand.down
            run.hand.down <- true
            for section in 0..<4 |run|:
                q: RoomsView::Vec = spot(section)
                if py_hypot(run.hand.x - q.x, run.hand.y - q.y) <= 70.0:
                    mark(run, CLICK, section)
                    return

    def act(run: mutable Run&, port: i64):
        can Abort.Panic, Memory.Allocate:
            if port < HandView::PRESS:
                HandView::move(&run.hand, port)
            elif port == HandView::RELEASE:
                run.hand.down <- false
            elif port == HandView::PRESS:
                press(run)
            elif run.result == LIVE and (port == LOUDER or port == SOFTER):
                mark(run, LOUD if port == LOUDER else SOFT)

    def sound_beat(run: mutable Run&, k: i64):
        can Abort.Panic, Memory.Allocate:
            return if not run.audible
            gain: f64 = 0.25 if run.loud == 0 else (0.4 if run.loud == 1 else 0.6)
            note(run, 0.08, 110.0 if k % 4 == 0 else 150.0, DRUM, 0.5 if run.playing[3] else 0.25)
            scale: i64[8] = [0, 4, 7, 12, 7, 4, 0, -5]
            base: f64 = 220.0 * pow(2.0, (run.piece.key + scale[(k % 8).usize()]).f64() / 12.0)
            length: f64 = run.piece.level.period * 0.9
            note(run, length, base, STRINGS, gain, -0.6) if run.playing[0]
            note(run, length, base * 2.0, WIND, gain, 0.0) if run.playing[1]
            note(run, length, base * 0.5, BRASS, gain, 0.6) if run.playing[2]

    def step(run: mutable Run&, dt: f64):
        can Abort.Panic, Memory.Allocate:
            return if run.result != LIVE
            run.time <- run.time + dt
            dy: f64 = run.hand.y - run.last_y
            run.last_y <- run.hand.y
            if dy < 0.0:
                before: f64 = run.fall
                run.fall <- run.fall - dy
                mark(run, BEAT) if before < 40.0 and run.fall >= 40.0
            elif dy > 0.0:
                run.fall <- 0.0
            n: i64 = run.piece.times.count.i64()
            while run.next < n and run.piece.times[run.next.usize()] <= run.time |run, n|:
                k: i64 = run.next
                run.next <- k + 1
                sound_beat(run, k)
            moment: f64 = run.piece.level.moment
            while run.judged < n and run.piece.times[run.judged.usize()] + moment < run.time |run, n, moment|:
                k: i64 = run.judged
                run.judged <- k + 1
                j: i64 = cue_at(&run.piece, k)
                if (j >= 0 and not run.done[j.usize()]) or not run.beaten[k.usize()]:
                    slip(run)
                return if run.result != LIVE
            if run.time >= run.end:
                note(run, 0.5, 660.0, DONE, 0.5)
                run.result <- BRAVO

    def pilot(run: Run&) -> i64:
        can Abort.Panic:
            return -1 if run.result != LIVE
            return HandView::RELEASE if run.hand.down
            for k in run.judged..<run.piece.times.count.i64() |run|:
                beat: f64 = run.piece.times[k.usize()]
                continue if run.beaten[k.usize()] or beat + run.piece.level.moment * 0.5 <= run.time
                now: bool = run.time >= beat - 0.02
                j: i64 = cue_at(&run.piece, k)
                if j >= 0 and not run.done[j.usize()]:
                    cue: Cue = run.piece.cues[j.usize()]
                    if cue.kind == ENTER or cue.kind == CUT:
                        at: RoomsView::Vec = spot(cue.section)
                        direction: i64 = HandView::toward(&run.hand, at.x, at.y, 10.0)
                        return direction if direction >= 0 else (HandView::PRESS if now else -1)
                    return (LOUDER if cue.kind == LOUD else SOFTER) if now else -1
                return 3 if now
                return 0 if run.hand.y < 400.0 or run.fall > 0.0
                return -1
            return -1

    def reference_wins(piece: Piece) -> bool:
        can Abort.Panic, Memory.Allocate:
            run: mutable Run = begin(piece, false)
            while run.result == LIVE |run|:
                act(&run, pilot(&run))
                step(&run, 1.0 / 60.0)
            return run.result == BRAVO

    def deal(rung: i64, draw: mutable MT19937&) -> Piece:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            level: Grade = grade(rung)
            # Copy accepted arrays before releasing the candidate arena.
            times: mutable darray[f64] = []
            cues: mutable darray[Cue] = []
            key: mutable i64 = 0
            seed: mutable i64 = 0
            accepted: mutable bool = false
            _ = times.reserve(level.beats.usize())
            _ = cues.reserve(level.cues.usize())
            for _ in 0..<level.beats |times|:
                times.push(0.0)
            for _ in 0..<level.cues |cues|:
                cues.push(Cue{beat: 0, kind: 0, section: -1})
            for _ in 0..<80 |level, draw, times, cues, key, seed, accepted|:
                region candidate(65536):
                    in candidate:
                        rng: mutable MT19937 = zeroed
                        mt_seed_int(&rng, py_getrandbits(draw, 32))
                        piece: Piece = build(level, &rng)
                        if reference_wins(piece):
                            for i in 0..<level.beats |times, piece|:
                                times[i.usize()] <- piece.times[i.usize()]
                            for j in 0..<level.cues |cues, piece|:
                                cues[j.usize()] <- piece.cues[j.usize()]
                            key <- piece.key
                            seed <- piece.seed
                            accepted <- true
                break if accepted
            return Piece{level: level, times: times if accepted else [], cues: cues if accepted else [], key: key, seed: seed}
