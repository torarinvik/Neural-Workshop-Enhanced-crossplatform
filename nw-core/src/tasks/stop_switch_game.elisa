include "./stop_switch.elisa"
include "../strings.elisa"

module StopSwitchGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = 2

    struct Run:
        rng: mutable MT19937
        start_rung: i64
        total: i64
        adaptive: bool
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        block: mutable StopSwitch::Block
        index: mutable i64
        hits: mutable i64
        marks: mutable i64
        showing: mutable bool
        ring: mutable bool
        shown_at: mutable f64
        deadline: mutable f64
        passed: mutable bool
        passed_count: mutable i64
        best_rung: mutable i64
        agent_clock: mutable f64
        agent_judged_seen: mutable bool

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 6 or total == 10 or total == 20

    def public_stimulus(run: Run&, field: i64) -> i64:
        can Abort.Panic:
            return -1 if run.phase != PLAYING or run.index >= run.block.level.count
            item: StopSwitch::Stimulus = run.block.stimuli[run.index.usize()]
            return item.rule if field == 9 and (run.showing or run.block.level.prepared)
            return -1 if not run.showing
            return item.shape if field == 10
            return item.colour if field == 11
            return item.side if field == 12
            return -1

    def info(run: Run&, field: i64) -> i64:
        can Abort.Panic:
            return (run.phase) if field == 0
            return (run.rung) if field == 1
            return (run.trial) if field == 2
            return (run.total) if field == 3
            return (run.index) if field == 4
            return (run.hits) if field == 5
            return (run.marks) if field == 6
            return (1 if run.showing else 0) if field == 7
            return (1 if run.ring and run.showing else 0) if field == 8
            return public_stimulus(run, field) if field >= 9 and field <= 12
            return run.block.level.count if field == 13
            return run.passed_count if field == 14
            return run.best_rung if field == 15
            return round_half_even(run.deadline * 1000.0) if field == 16
            return -1

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Run:
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            start: i64 = rung if rung > 0 else 1
            return Run{rng: rng, start_rung: start, total: total, adaptive: adaptive,
                rung: start, trial: 0, phase: READY, block: zeroed, index: 0, hits: 0, marks: 0,
                showing: false, ring: false, shown_at: 0.0, deadline: 0.0,
                passed: false, passed_count: 0, best_rung: 0, agent_clock: 0.0, agent_judged_seen: false}

    def queue(run: mutable Run&, now: f64):
        run.shown_at <- now + StopSwitch::GAP
        run.showing <- false
        run.ring <- false

    def next_block(run: mutable Run&, now: f64):
        can Abort.Panic:
            run.index <- 0
            run.marks <- 0
            run.hits <- 0
            if run.trial >= run.total:
                run.phase <- DONE
                return
            seed: i64 = py_randbelow(&run.rng, 1073741824.u64()).i64()
            StopSwitch::deal(run.rung, seed, &run.block)
            run.trial <- run.trial + 1
            run.phase <- PLAYING
            queue(run, now)

    def start(run: mutable Run&, now: f64) -> bool:
        can Abort.Panic:
            return false if run.phase != READY and run.phase != DONE
            run.rung <- run.start_rung
            run.trial <- 0
            run.passed_count <- 0
            run.best_rung <- 0
            next_block(run, now)
            return true

    def settle(run: mutable Run&, key: i64, now: f64):
        can Abort.Panic:
            stimulus: StopSwitch::Stimulus = run.block.stimuli[run.index.usize()]
            if StopSwitch::correct(stimulus, key, now - run.shown_at, &run.block.level):
                run.marks <- run.marks | (1 << run.index.u64())
                run.hits <- run.hits + 1
            run.index <- run.index + 1
            if run.index < run.block.level.count:
                queue(run, now)
                return
            run.passed <- run.hits.f64() >= run.block.level.needed * run.index.f64() - 0.000000001
            if run.passed:
                run.passed_count <- run.passed_count + 1
                run.best_rung <- run.rung if run.rung > run.best_rung
            if run.adaptive:
                if run.passed:
                    run.rung <- run.rung + 1 if run.rung < 9223372036854775807
                elif run.rung > 1:
                    run.rung <- run.rung - 1
            run.showing <- false
            run.deadline <- now + 2.5
            run.phase <- JUDGED

    def steer(run: mutable Run&, key: i64, now: f64) -> bool:
        can Abort.Panic:
            return start(run, now) if key == START
            return false if run.phase != PLAYING or not run.showing or key < 0 or key > 1
            settle(run, key, now)
            return true

    def advance(run: mutable Run&, now: f64) -> bool:
        can Abort.Panic:
            if run.phase == JUDGED:
                return false if now < run.deadline
                next_block(run, now)
                return true
            return false if run.phase != PLAYING
            if not run.showing:
                return false if now < run.shown_at
                run.showing <- true
                return true
            elapsed: f64 = now - run.shown_at
            if elapsed >= run.block.level.window:
                run.ring <- false
                settle(run, -1, now)
                return true
            if not run.ring and run.block.stimuli[run.index.usize()].stop and elapsed >= run.block.level.stop_delay:
                run.ring <- true
                return true
            return false

    def agent_event(run: mutable Run&, now: f64, port: i64) -> bool:
        can Abort.Panic:
            return false if not (now >= run.agent_clock and now <= 9007199254740.0)
            return false if port < -1 or port > START
            run.agent_clock <- now
            if port == START:
                run.agent_judged_seen <- false if run.phase == READY or run.phase == DONE
                return start(run, now)
            return steer(run, port, now) if port >= 0
            return false if run.phase == DONE
            if run.phase == JUDGED and run.agent_judged_seen:
                run.agent_judged_seen <- false
                next_block(run, now)
            else:
                if run.phase == PLAYING:
                    _ = advance(run, now)
                # Keep the verdict for the frame that publishes its outcome.
                run.agent_judged_seen <- run.phase == JUDGED
            return true
