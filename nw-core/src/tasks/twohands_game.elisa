# Stateful common-v1 controller for the source Two Hands task.
#
# The source generator and physics already live in TwoHands.  This adapter
# keeps the common-ABI record durable by storing only bounded scalar state and
# the generated hazard/sky data.  Source Road indexes and darrays are rebuilt
# in a temporary region for each operation and never escape that region.

module TwoHandsGame:

    const MAX_HAZARDS: i64 = 64
    const MAX_SKY: i64 = 224
    const MAX_RESULTS: i64 = 64
    const SUB: i64 = 4
    const VERDICT_MS: i64 = 1200
    const NUDGE_MILLI: i64 = 100000
    const MILLION: i64 = 1000000
    const REFERENCE_WIDTH: f64 = 912.0
    const REFERENCE_HEIGHT: f64 = 684.0

    const PHASE_READY: i64 = 0
    const PHASE_SETTING: i64 = 1
    const PHASE_RUNNING: i64 = 2
    const PHASE_SCORED: i64 = 3
    const PHASE_DONE: i64 = 4

    const ACTION_START: i64 = 0
    const ACTION_PORT: i64 = 1
    # Keyboard-only aliases keep the common key mapper payload-free. Explicit
    # action events still use ACTION_PORT with the source port in `value`.
    const ACTION_LEFT: i64 = 2
    const ACTION_RIGHT: i64 = 3
    const ACTION_JUMP: i64 = 4
    const ACTION_FASTER: i64 = 5
    const ACTION_SLOWER: i64 = 6

    const INFO_PHASE: i64 = 0
    const INFO_RUNG: i64 = 1
    const INFO_TRIAL: i64 = 2
    const INFO_TOTAL_TRIALS: i64 = 3
    const INFO_ROAD_ROWS: i64 = 4
    const INFO_ROAD_LENGTH: i64 = 5
    const INFO_HAZARDS: i64 = 6
    const INFO_CAR_AT: i64 = 7
    const INFO_CAR_LANE_MILLI: i64 = 8
    const INFO_CAR_CROSSING: i64 = 9
    const INFO_CAR_AIR: i64 = 10
    const INFO_CAR_SPEED: i64 = 11
    const INFO_CAR_TICKS: i64 = 12
    const INFO_CAR_PASSED: i64 = 13
    const INFO_CAR_CLIPPED: i64 = 14
    const INFO_CAR_HIT: i64 = 15
    const INFO_ROAD_CLOCK: i64 = 16
    const INFO_ROAD_PAR: i64 = 17
    const INFO_SHOT: i64 = 18
    const INFO_TARGETS: i64 = 19
    const INFO_POINTS: i64 = 20
    const INFO_VERDICT: i64 = 21
    const INFO_UNTIL_MS: i64 = 22
    const INFO_BEAT_AT_MS: i64 = 23
    const INFO_CLOCK_MS: i64 = 24
    const INFO_RESULT_COUNT: i64 = 25
    const INFO_CLEAN: i64 = 26
    const INFO_TAKEN: i64 = 27
    const INFO_BEST_RUNG: i64 = 28
    const INFO_START_RUNG: i64 = 29
    const INFO_BEAT_MS: i64 = 30
    const INFO_SET_MS: i64 = 31
    const INFO_ADAPTIVE: i64 = 32
    const INFO_CROSS_X_MILLI: i64 = 33
    const INFO_CROSS_Y_MILLI: i64 = 34
    const INFO_LOADED: i64 = 35

    const VALUE_HAZARD_AT: i64 = 0
    const VALUE_HAZARD_LANE: i64 = 1
    const VALUE_HAZARD_KIND: i64 = 2
    const VALUE_TARGET_AT: i64 = 3
    const VALUE_TARGET_ACROSS_MILLI: i64 = 4
    const VALUE_TARGET_UP_MILLI: i64 = 5
    const VALUE_TARGET_DOWNED: i64 = 6
    const VALUE_RESULT_RUNG: i64 = 100
    const VALUE_RESULT_CLEARED: i64 = 101
    const VALUE_RESULT_POINTS: i64 = 102
    const VALUE_RESULT_SHOT: i64 = 103

    struct TwoHandsRun:
        rng: mutable MT19937
        start_rung: mutable i64
        rung: mutable i64
        total_trials: mutable i64
        beat_ms: mutable i64
        set_ms: mutable i64
        adaptive: mutable bool
        trial: mutable i64
        phase: mutable i64
        verdict: mutable i64
        clock_us: mutable i64
        until_us: mutable i64
        beat_at_us: mutable i64

        road_rung: mutable i64
        road_length: mutable i64
        road_start: mutable i64
        road_clock: mutable i64
        road_par: mutable i64
        hazard_n: mutable i64
        hazard_at: mutable i64[MAX_HAZARDS]
        hazard_lane: mutable i64[MAX_HAZARDS]
        hazard_kind: mutable i64[MAX_HAZARDS]
        sky_n: mutable i64
        sky_at: mutable i64[MAX_SKY]
        sky_across: mutable f64[MAX_SKY]
        sky_up: mutable f64[MAX_SKY]
        sky_drift: mutable f64[MAX_SKY]

        ride_at: mutable i64
        ride_lane: mutable i64
        ride_into: mutable i64
        ride_cross: mutable i64
        ride_air: mutable i64
        ride_speed: mutable i64
        ride_ticks: mutable i64
        ride_hit: mutable bool
        ride_passed: mutable i64
        ride_clipped: mutable i64
        ride_points: mutable i64

        cross_x: mutable f64
        cross_y: mutable f64
        downed: mutable i64[MAX_SKY]
        shot: mutable i64
        owed_hit: mutable bool
        points: mutable i64
        taken: mutable i64
        result_count: mutable i64
        result_rung: mutable i64[MAX_RESULTS]
        result_cleared: mutable i64[MAX_RESULTS]
        result_points: mutable i64[MAX_RESULTS]
        result_shot: mutable i64[MAX_RESULTS]
        clean: mutable i64
        best_rung: mutable i64

    def allowed_rung(value: i64) -> bool:
        can Abort.Panic:
            return value >= 1 and value <= TwoHands::GRADE_COUNT

    def allowed_trials(value: i64) -> bool:
        can Abort.Panic:
            return value == 1 or value == 2 or value == 3 or value == 5 or value == 8 or value == 10 or value == 15 or value == 20

    def allowed_beat_ms(value: i64) -> bool:
        can Abort.Panic:
            return value == 150 or value == 250 or value == 400 or value == 600 or value == 900 or value == 1400

    def allowed_set_ms(value: i64) -> bool:
        can Abort.Panic:
            return value == 0 or value == 400 or value == 800 or value == 1200 or value == 2000 or value == 3000

    def clamped_rung(value: i64) -> i64:
        can Abort.Panic:
            return 1 if value < 1 else (TwoHands::GRADE_COUNT if value > TwoHands::GRADE_COUNT else value)

    def clear_road(run: mutable TwoHandsRun&):
        can Abort.Panic:
            run.road_rung <- 0
            run.road_length <- 0
            run.road_start <- 0
            run.road_clock <- 0
            run.road_par <- 0
            run.hazard_n <- 0
            run.sky_n <- 0
            run.ride_at <- 0
            run.ride_lane <- 0
            run.ride_into <- 0
            run.ride_cross <- 0
            run.ride_air <- 0
            run.ride_speed <- 1
            run.ride_ticks <- 0
            run.ride_hit <- false
            run.ride_passed <- 0
            run.ride_clipped <- 0
            run.ride_points <- 0
            run.shot <- 0
            run.owed_hit <- false
            for at in 0..<MAX_HAZARDS |at, run|:
                run.hazard_at[at.usize()] <- 0
                run.hazard_lane[at.usize()] <- 0
                run.hazard_kind[at.usize()] <- 0
            for at in 0..<MAX_SKY |at, run|:
                run.sky_at[at.usize()] <- 0
                run.sky_across[at.usize()] <- 0.0
                run.sky_up[at.usize()] <- 0.0
                run.sky_drift[at.usize()] <- 0.0
                run.downed[at.usize()] <- 0

    def clear_results(run: mutable TwoHandsRun&):
        can Abort.Panic:
            run.result_count <- 0
            run.clean <- 0
            run.taken <- 0
            run.best_rung <- 0
            for at in 0..<MAX_RESULTS |at, run|:
                run.result_rung[at.usize()] <- 0
                run.result_cleared[at.usize()] <- 0
                run.result_points[at.usize()] <- 0
                run.result_shot[at.usize()] <- 0

    def reset(run: mutable TwoHandsRun&):
        can Abort.Panic:
            run.rung <- clamped_rung(run.start_rung)
            run.trial <- 0
            run.phase <- PHASE_READY
            run.verdict <- -1
            run.clock_us <- 0
            run.until_us <- 0
            run.beat_at_us <- 0
            run.cross_x <- 0.5
            run.cross_y <- 0.5
            run.points <- 0
            clear_road(run)
            clear_results(run)

    def copy_ride_from_source(run: mutable TwoHandsRun&, ride: TwoHands::TwoHandsRide&):
        can Abort.Panic:
            run.ride_at <- ride.at
            run.ride_lane <- ride.lane
            run.ride_into <- ride.into
            run.ride_cross <- ride.cross
            run.ride_air <- ride.air
            run.ride_speed <- ride.speed
            run.ride_ticks <- ride.ticks
            run.ride_hit <- ride.hit
            run.ride_passed <- ride.passed
            run.ride_clipped <- ride.clipped
            run.ride_points <- ride.points

    def copy_ride_to_source(run: TwoHandsRun&) -> TwoHands::TwoHandsRide:
        can Abort.Panic:
            ride: mutable TwoHands::TwoHandsRide = zeroed
            ride.at <- run.ride_at
            ride.lane <- run.ride_lane
            ride.into <- run.ride_into
            ride.cross <- run.ride_cross
            ride.air <- run.ride_air
            ride.speed <- run.ride_speed
            ride.ticks <- run.ride_ticks
            ride.hit <- run.ride_hit
            ride.passed <- run.ride_passed
            ride.clipped <- run.ride_clipped
            ride.points <- run.ride_points
            return ride

    def copy_road_from_source(run: mutable TwoHandsRun&, road: TwoHands::TwoHandsRoad&,
                              rung: i64):
        can Abort.Panic:
            run.road_rung <- rung
            run.road_length <- road.length
            run.road_start <- road.start
            run.road_clock <- road.clock
            run.road_par <- road.par
            run.hazard_n <- road.haz_n
            run.sky_n <- road.sky_n
            for at in 0..<MAX_HAZARDS |at, run, road|:
                run.hazard_at[at.usize()] <- 0
                run.hazard_lane[at.usize()] <- 0
                run.hazard_kind[at.usize()] <- 0
            for at in 0..<road.haz_n |at, run, road|:
                run.hazard_at[at.usize()] <- Ints::at(road.haz_at, at)
                run.hazard_lane[at.usize()] <- Ints::at(road.haz_lane, at)
                run.hazard_kind[at.usize()] <- Ints::at(road.haz_kind, at)
            for at in 0..<MAX_SKY |at, run, road|:
                run.sky_at[at.usize()] <- 0
                run.sky_across[at.usize()] <- 0.0
                run.sky_up[at.usize()] <- 0.0
                run.sky_drift[at.usize()] <- 0.0
                run.downed[at.usize()] <- 0
            for at in 0..<road.sky_n |at, run, road|:
                run.sky_at[at.usize()] <- Ints::at(road.sky_at, at)
                run.sky_across[at.usize()] <- Floats::at(road.sky_across, at)
                run.sky_up[at.usize()] <- Floats::at(road.sky_up, at)
                run.sky_drift[at.usize()] <- Floats::at(road.sky_drift, at)

    # Rebuild the source mark/head/tail indexes from the compact persistent
    # hazard list.  The source build function is also the single authority for
    # overlap indexing, so the controller never duplicates that rule.
    def source_road(run: TwoHandsRun&) -> TwoHands::TwoHandsRoad:
        can Memory.Allocate, Abort.Panic:
            road: mutable TwoHands::TwoHandsRoad = TwoHands::TwoHandsRoad()
            grade: TwoHands::TwoHandsGrade = TwoHands::grade_of(run.road_rung)
            haz_at: mutable darray[i64] = Ints::zeros(MAX_HAZARDS)
            haz_lane: mutable darray[i64] = Ints::zeros(MAX_HAZARDS)
            haz_kind: mutable darray[i64] = Ints::zeros(MAX_HAZARDS)
            for at in 0..<run.hazard_n |at, run, haz_at, haz_lane, haz_kind|:
                Ints::put(&haz_at, at, run.hazard_at[at.usize()])
                Ints::put(&haz_lane, at, run.hazard_lane[at.usize()])
                Ints::put(&haz_kind, at, run.hazard_kind[at.usize()])
            TwoHands::build(&road, grade, haz_at, haz_lane, haz_kind,
                            run.hazard_n, run.road_start, run.road_clock)
            road.par <- run.road_par
            road.sky_n <- run.sky_n
            for at in 0..<run.sky_n |at, run, road|:
                Ints::put(&road.sky_at, at, run.sky_at[at.usize()])
                Floats::put(&road.sky_across, at, run.sky_across[at.usize()])
                Floats::put(&road.sky_up, at, run.sky_up[at.usize()])
                Floats::put(&road.sky_drift, at, run.sky_drift[at.usize()])
            return road

    def deal_trial(run: mutable TwoHandsRun&, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            seed: i64 = py_randrange(&run.rng, 0, 1073741824)
            region scratch(268435456):
                in scratch:
                    road: mutable TwoHands::TwoHandsRoad = TwoHands::TwoHandsRoad()
                    solver: mutable TwoHands::TwoHandsSolver = TwoHands::TwoHandsSolver()
                    TwoHands::generate(run.rung, seed, &road, &solver)
                    copy_road_from_source(run, &road, run.rung)
                    ride: TwoHands::TwoHandsRide = TwoHands::start_ride(&road)
                    copy_ride_from_source(run, &ride)
                destroy scratch
            run.trial <- run.trial + 1
            run.shot <- 0
            run.owed_hit <- false
            run.cross_x <- 0.5
            run.cross_y <- 0.5
            run.verdict <- -1
            run.clock_us <- now_ms * 1000
            run.until_us <- run.clock_us + run.set_ms * 1000
            run.beat_at_us <- run.until_us
            run.phase <- PHASE_SETTING

    def next_trial(run: mutable TwoHandsRun&, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            if run.trial >= run.total_trials:
                run.phase <- PHASE_DONE
                run.verdict <- -1
                clear_road(run)
                return
            deal_trial(run, now_ms)

    def start(run: mutable TwoHandsRun&, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            reset(run)
            next_trial(run, now_ms)

    def ride_lane(run: TwoHandsRun&) -> f64:
        can Abort.Panic:
            return 0.0 if run.road_rung <= 0
            grade: TwoHands::TwoHandsGrade = TwoHands::grade_of(run.road_rung)
            return run.ride_lane.f64() if run.ride_cross == 0
            share: f64 = (grade.swerve - run.ride_cross + 1).f64() / (grade.swerve + 1).f64()
            return run.ride_lane.f64() + (run.ride_into - run.ride_lane).f64() * share

    def target_aloft(run: TwoHandsRun&, at: i64, index: i64) -> bool:
        can Abort.Panic:
            start: i64 = run.sky_at[index.usize()]
            return start <= at and at < start + TwoHands::ALOFT

    def target_across(run: TwoHandsRun&, at: i64, index: i64) -> f64:
        can Abort.Panic:
            part: mutable f64 = (at - run.sky_at[index.usize()]).f64() / TwoHands::ALOFT.f64()
            part <- 0.0 if part < 0.0
            part <- 1.0 if part > 1.0
            value: mutable f64 = run.sky_across[index.usize()] + run.sky_drift[index.usize()] * part
            value <- 0.0 if value < 0.0
            value <- 1.0 if value > 1.0
            return value

    def loaded(run: TwoHandsRun&) -> bool:
        can Memory.Allocate, Abort.Panic:
            result: mutable bool = false
            if run.road_length <= 0:
                return false
            region scratch(67108864):
                in scratch:
                    road: mutable TwoHands::TwoHandsRoad = source_road(run)
                    downed: mutable darray[i64] = Ints::zeros(MAX_SKY)
                    for at in 0..<MAX_SKY |at, run, downed|:
                        Ints::put(&downed, at, run.downed[at.usize()])
                    result <- TwoHands::sighted(&road, run.ride_at,
                                                run.cross_x, run.cross_y,
                                                downed) >= 0
                destroy scratch
            return result

    def fire(run: mutable TwoHandsRun&, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 2 if run.phase != PHASE_RUNNING
            found: mutable i64 = -1
            region scratch(67108864):
                in scratch:
                    road: mutable TwoHands::TwoHandsRoad = source_road(run)
                    downed: mutable darray[i64] = Ints::zeros(MAX_SKY)
                    for at in 0..<MAX_SKY |at, run, downed|:
                        Ints::put(&downed, at, run.downed[at.usize()])
                    found <- TwoHands::sighted(&road, run.ride_at,
                                               run.cross_x, run.cross_y,
                                               downed)
                destroy scratch
            if found < 0:
                return 2
            run.downed[found.usize()] <- 1
            run.shot <- run.shot + 1
            run.points <- run.points + 1
            run.owed_hit <- true
            return 1

    def press(run: mutable TwoHandsRun&, port: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 2 if run.phase != PHASE_RUNNING
            return 2 if port < TwoHands::HOLD or port >= TwoHands::PORTS
            if port >= TwoHands::AIM_LEFT:
                return fire(run, run.clock_us / 1000) if port == TwoHands::FIRE else 2
            return 2 if port == TwoHands::HOLD
            before_lane: i64 = run.ride_lane
            before_into: i64 = run.ride_into
            before_cross: i64 = run.ride_cross
            before_air: i64 = run.ride_air
            before_speed: i64 = run.ride_speed
            region scratch(67108864):
                in scratch:
                    road: mutable TwoHands::TwoHandsRoad = source_road(run)
                    ride: mutable TwoHands::TwoHandsRide = copy_ride_to_source(run)
                    after: TwoHands::TwoHandsRide = TwoHands::wheel_press(ride, port, road.grade)
                    copy_ride_from_source(run, &after)
                destroy scratch
            changed: bool = before_lane != run.ride_lane or before_into != run.ride_into or before_cross != run.ride_cross or before_air != run.ride_air or before_speed != run.ride_speed
            return 1 if changed else 2

    def nudge(run: mutable TwoHandsRun&, port: i64) -> i64:
        can Abort.Panic:
            return 2 if run.phase != PHASE_RUNNING
            if port == TwoHands::AIM_LEFT:
                run.cross_x <- 0.0 if run.cross_x < 0.100001 else run.cross_x - 0.10
            elif port == TwoHands::AIM_RIGHT:
                run.cross_x <- 1.0 if run.cross_x > 0.899999 else run.cross_x + 0.10
            elif port == TwoHands::AIM_UP:
                run.cross_y <- 1.0 if run.cross_y > 0.899999 else run.cross_y + 0.10
            elif port == TwoHands::AIM_DOWN:
                run.cross_y <- 0.0 if run.cross_y < 0.100001 else run.cross_y - 0.10
            else:
                return 2
            return 1

    def pointer(run: mutable TwoHandsRun&, x_millionths: i64, y_millionths: i64,
                pressed: bool) -> i64:
        can Memory.Allocate, Abort.Panic:
            outside: bool = x_millionths < 0 or x_millionths > MILLION or y_millionths < 0 or y_millionths > MILLION
            return 2 if outside
            return 2 if run.phase == PHASE_READY or run.phase == PHASE_DONE
            run.cross_x <- x_millionths.f64() / MILLION.f64()
            run.cross_y <- y_millionths.f64() / MILLION.f64()
            if pressed:
                return fire(run, run.clock_us / 1000)
            return 1

    def settle(run: mutable TwoHandsRun&, now_ms: i64):
        can Abort.Panic:
            home: i64 = 1 if not run.ride_hit and run.ride_at >= run.road_length else 0
            slot: i64 = run.result_count
            if slot < MAX_RESULTS:
                run.result_rung[slot.usize()] <- run.rung
                run.result_cleared[slot.usize()] <- home
                run.result_points[slot.usize()] <- run.ride_points
                run.result_shot[slot.usize()] <- run.shot
                run.result_count <- slot + 1
            run.clean <- run.clean + 1 if home != 0 else run.clean
            run.points <- run.points + run.ride_points
            run.taken <- run.taken + run.shot
            run.best_rung <- run.rung if run.rung > run.best_rung else run.best_rung
            if run.adaptive and run.result_count > 0:
                window: i64 = 4 if run.result_count >= 4 else run.result_count
                first: i64 = run.result_count - window
                wins: mutable i64 = 0
                for at in first..<run.result_count |at, run, wins|:
                    wins <- wins + 1 if run.result_cleared[at.usize()] != 0 else wins
                share: i64 = wins * 100 / window
                if share >= 75:
                    run.rung <- clamped_rung(run.rung + 1)
                elif share < 40:
                    run.rung <- clamped_rung(run.rung - 1)
            run.verdict <- home
            run.phase <- PHASE_SCORED
            run.clock_us <- now_ms * 1000
            run.until_us <- run.clock_us + VERDICT_MS * 1000

    def source_tick(run: mutable TwoHandsRun&) -> bool:
        can Memory.Allocate, Abort.Panic:
            over_now: mutable bool = false
            region scratch(67108864):
                in scratch:
                    road: mutable TwoHands::TwoHandsRoad = source_road(run)
                    ride: mutable TwoHands::TwoHandsRide = copy_ride_to_source(run)
                    after: mutable TwoHands::TwoHandsRide = TwoHands::advance(ride, &road)
                    copy_ride_from_source(run, &after)
                    over_now <- TwoHands::over(after, &road)
                destroy scratch
            return over_now

    def advance(run: mutable TwoHandsRun&, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            now_us: i64 = now_ms * 1000
            return 2 if now_us < run.clock_us
            run.clock_us <- now_us
            if run.phase == PHASE_READY or run.phase == PHASE_DONE or run.phase == PHASE_SCORED:
                return 2
            if run.phase == PHASE_SETTING:
                if now_us >= run.until_us:
                    run.phase <- PHASE_RUNNING
                    run.beat_at_us <- now_us + run.beat_ms * 1000
                    return 1
                return 2
            return 2 if run.phase != PHASE_RUNNING or now_us < run.beat_at_us
            run.beat_at_us <- now_us + run.beat_ms * 1000
            over_now: bool = source_tick(run)
            if over_now:
                settle(run, now_ms)
            return 1

    def grade_name(rung: i64) -> sview:
        can Abort.Panic:
            if rung == 1: return sview("a clear road", 0, -1)
            if rung == 2: return sview("one at a time", 0, -1)
            if rung == 3: return sview("and one beside it", 0, -1)
            if rung == 4: return sview("something to jump", 0, -1)
            if rung == 5: return sview("the long haul", 0, -1)
            if rung == 6: return sview("cones and rubble", 0, -1)
            if rung == 7: return sview("a road that pays", 0, -1)
            if rung == 8: return sview("the wide swerve", 0, -1)
            if rung == 9: return sview("the long night", 0, -1)
            return sview("both hands", 0, -1)

    def append_message(out: mutable dstr&, run: TwoHandsRun&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == PHASE_READY:
                dstr_append_cstr(out, "Press Space to start")
            elif run.phase == PHASE_SETTING:
                dstr_append_cstr(out, "Road ahead")
            elif run.phase == PHASE_RUNNING:
                dstr_append_cstr(out, "Go")
            elif run.phase == PHASE_SCORED:
                if run.verdict == 1:
                    dstr_append_cstr(out, "Home in ")
                    dstr_append_i64(out, run.ride_ticks)
                    dstr_append_cstr(out, " of ")
                    dstr_append_i64(out, run.road_clock)
                    dstr_append_cstr(out, " ticks, ")
                    dstr_append_i64(out, run.ride_passed)
                    dstr_append_cstr(out, " past, ")
                    dstr_append_i64(out, run.shot)
                    dstr_append_cstr(out, " shot")
                elif run.ride_at < run.road_length and run.road_clock != 0 and run.ride_ticks >= run.road_clock:
                    dstr_append_cstr(out, "Out of time ")
                    dstr_append_i64(out, run.road_length / SUB - run.ride_at / SUB)
                    dstr_append_cstr(out, " rows short")
                else:
                    dstr_append_cstr(out, "Hit one after ")
                    dstr_append_i64(out, run.ride_at / SUB)
                    dstr_append_cstr(out, " rows, ")
                    dstr_append_i64(out, run.ride_passed)
                    dstr_append_cstr(out, " past, ")
                    dstr_append_i64(out, run.shot)
                    dstr_append_cstr(out, " shot")
            else:
                dstr_append_i64(out, run.clean)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, run.total_trials)
                dstr_append_cstr(out, " roads driven, ")
                dstr_append_i64(out, run.points)
                dstr_append_cstr(out, " points, ")
                dstr_append_i64(out, run.taken)
                dstr_append_cstr(out, " out of the sky, highest rung ")
                dstr_append_i64(out, run.best_rung)

    def append_asked(out: mutable dstr&, run: TwoHandsRun&):
        can Memory.Allocate, Abort.Panic:
            return if run.road_length <= 0
            grade: TwoHands::TwoHandsGrade = TwoHands::grade_of(run.road_rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, run.rung)
            dstr_append_cstr(out, ", ")
            dstr_append_sview(out, grade_name(run.road_rung))
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, run.road_length / SUB)
            dstr_append_cstr(out, " rows, ")
            dstr_append_i64(out, run.hazard_n)
            dstr_append_cstr(out, " in the way, ")
            dstr_append_i64(out, run.sky_n)
            dstr_append_cstr(out, " in the sky, ")
            dstr_append_i64(out, run.road_clock)
            dstr_append_cstr(out, " ticks against a best line of ")
            dstr_append_i64(out, run.road_par)
            dstr_append_cstr(out, ". The swerve takes ")
            dstr_append_i64(out, grade.swerve)
            dstr_append_cstr(out, " ticks and covers both lanes for all of them; a jump clears the flat ones for ")
            dstr_append_i64(out, grade.hang)
            dstr_append_cstr(out, ".")

    def info(run: TwoHandsRun&, field: i64) -> i64:
        can Abort.Panic:
            if field == INFO_PHASE: return run.phase
            if field == INFO_RUNG: return run.rung
            if field == INFO_TRIAL: return run.trial
            if field == INFO_TOTAL_TRIALS: return run.total_trials
            if field == INFO_ROAD_ROWS: return run.road_length / SUB
            if field == INFO_ROAD_LENGTH: return run.road_length
            if field == INFO_HAZARDS: return run.hazard_n
            if field == INFO_CAR_AT: return run.ride_at
            if field == INFO_CAR_LANE_MILLI: return (ride_lane(run) * MILLION.f64()).i64()
            if field == INFO_CAR_CROSSING: return run.ride_cross
            if field == INFO_CAR_AIR: return run.ride_air
            if field == INFO_CAR_SPEED: return run.ride_speed
            if field == INFO_CAR_TICKS: return run.ride_ticks
            if field == INFO_CAR_PASSED: return run.ride_passed
            if field == INFO_CAR_CLIPPED: return run.ride_clipped
            if field == INFO_CAR_HIT: return 1 if run.ride_hit else 0
            if field == INFO_ROAD_CLOCK: return run.road_clock
            if field == INFO_ROAD_PAR: return run.road_par
            if field == INFO_SHOT: return run.shot
            if field == INFO_TARGETS: return run.sky_n
            if field == INFO_POINTS: return run.points + run.ride_points
            if field == INFO_VERDICT: return run.verdict
            if field == INFO_UNTIL_MS: return run.until_us / 1000
            if field == INFO_BEAT_AT_MS: return run.beat_at_us / 1000
            if field == INFO_CLOCK_MS: return run.clock_us / 1000
            if field == INFO_RESULT_COUNT: return run.result_count
            if field == INFO_CLEAN: return run.clean
            if field == INFO_TAKEN: return run.taken
            if field == INFO_BEST_RUNG: return run.best_rung
            if field == INFO_START_RUNG: return run.start_rung
            if field == INFO_BEAT_MS: return run.beat_ms
            if field == INFO_SET_MS: return run.set_ms
            if field == INFO_ADAPTIVE: return 1 if run.adaptive else 0
            if field == INFO_CROSS_X_MILLI: return (run.cross_x * MILLION.f64()).i64()
            if field == INFO_CROSS_Y_MILLI: return (run.cross_y * MILLION.f64()).i64()
            if field == INFO_LOADED: return 1 if loaded(run) else 0
            return -1

    def value(run: TwoHandsRun&, field: i64, at: i64) -> i64:
        can Abort.Panic:
            if field == VALUE_HAZARD_AT or field == VALUE_HAZARD_LANE or field == VALUE_HAZARD_KIND:
                return -1 if at < 0 or at >= run.hazard_n else (
                    run.hazard_at[at.usize()] if field == VALUE_HAZARD_AT else
                    (run.hazard_lane[at.usize()] if field == VALUE_HAZARD_LANE else run.hazard_kind[at.usize()]))
            if field >= VALUE_TARGET_AT and field <= VALUE_TARGET_DOWNED:
                return -1 if at < 0 or at >= run.sky_n else (
                    run.sky_at[at.usize()] if field == VALUE_TARGET_AT else
                    ((run.sky_across[at.usize()] * MILLION.f64()).i64() if field == VALUE_TARGET_ACROSS_MILLI else
                    ((run.sky_up[at.usize()] * MILLION.f64()).i64() if field == VALUE_TARGET_UP_MILLI else run.downed[at.usize()])))
            if field >= VALUE_RESULT_RUNG and field <= VALUE_RESULT_SHOT:
                return -1 if at < 0 or at >= run.result_count else (
                    run.result_rung[at.usize()] if field == VALUE_RESULT_RUNG else
                    (run.result_cleared[at.usize()] if field == VALUE_RESULT_CLEARED else
                    (run.result_points[at.usize()] if field == VALUE_RESULT_POINTS else run.result_shot[at.usize()])))
            return -1

    def render(run: TwoHandsRun&, black_background: bool, width: f64, height: f64,
               list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            hazards: mutable darray[SceneTwoHands::TwoHandsHazard] = []
            sky: mutable darray[SceneTwoHands::TwoHandsTarget] = []
            grade: TwoHands::TwoHandsGrade = TwoHands::grade_of(run.road_rung if run.road_rung > 0 else run.rung)
            if run.road_length > 0:
                for index in 0..<run.hazard_n |index, run, hazards|:
                    ahead: f64 = (run.hazard_at[index.usize()] + TwoHands::CAR - 1 - run.ride_at).f64() / SUB.f64()
                    if ahead >= -0.6 and ahead <= 14.0:
                        hazards.push(SceneTwoHands::TwoHandsHazard{ahead: ahead,
                            lane: run.hazard_lane[index.usize()].f64(),
                            kind: run.hazard_kind[index.usize()]})
                for index in 0..<run.sky_n |index, run, sky|:
                    if target_aloft(run, run.ride_at, index):
                        sky.push(SceneTwoHands::TwoHandsTarget{
                            across: target_across(run, run.ride_at, index),
                            up: run.sky_up[index.usize()],
                            downed: run.downed[index.usize()] != 0})
            lane: f64 = ride_lane(run)
            air_lift: mutable f64 = 0.0
            if run.ride_air != 0:
                part: f64 = 1.0 - (run.ride_air.f64() - 0.5) / grade.hang.f64()
                curve: mutable f64 = 1.0 - (2.0 * part - 1.0) * (2.0 * part - 1.0)
                curve <- 0.0 if curve < 0.0
                air_lift <- curve
            road_rows: i64 = run.road_length / SUB
            road_share: mutable f64 = run.ride_at.f64() / run.road_length.f64() if run.road_length > 0 else 0.0
            clock_share: mutable f64 = run.ride_ticks.f64() / run.road_clock.f64() if run.road_clock > 0 else 0.0
            road_share <- 1.0 if road_share > 1.0
            clock_share <- 1.0 if clock_share > 1.0
            sx: f64 = width / REFERENCE_WIDTH
            sy: f64 = height / REFERENCE_HEIGHT
            paint: SceneTwoHands::TwoHandsPaint = SceneTwoHands::paint_of(black_background, width, height, sx, sy)
            message: mutable dstr = []
            append_message(&message, run)
            asked: mutable dstr = []
            append_asked(&asked, run)
            verdict_text: mutable dstr = []
            if run.phase == PHASE_SCORED:
                dstr_append_sview(&verdict_text, bytes_view(message))
            SceneTwoHands::render(list, &paint, run.phase, run.road_length > 0,
                run.ride_at, hazards, lane, air_lift, run.ride_air != 0, sky,
                run.cross_x, run.cross_y, loaded(run), road_share, clock_share,
                run.ride_speed, grade.top, run.ride_at / SUB, road_rows,
                run.ride_ticks, run.road_clock, run.points + run.ride_points,
                run.shot, run.sky_n, bytes_view(asked), run.trial,
                run.total_trials, bytes_view(message), run.verdict,
                bytes_view(verdict_text))

    def initialize(run: mutable TwoHandsRun&, rung: i64, trials: i64, beat_ms: i64,
                   set_ms: i64, adaptive: bool, unused: i64, seed: i64):
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            run.rng <- rng
            run.start_rung <- rung
            run.total_trials <- trials
            run.beat_ms <- beat_ms
            run.set_ms <- set_ms
            run.adaptive <- adaptive
            reset(run)

    def apply(run: mutable TwoHandsRun&, action: i64, value: i64, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            if action == ACTION_START:
                if run.phase == PHASE_READY or run.phase == PHASE_DONE:
                    start(run, now_ms)
                    return 1
                if run.phase == PHASE_SCORED:
                    return 2 if now_ms * 1000 < run.until_us
                    next_trial(run, now_ms)
                    return 1
                return 2
            if action == ACTION_PORT:
                return 2 if value < TwoHands::HOLD or value >= TwoHands::PORTS
                return nudge(run, value) if value >= TwoHands::AIM_LEFT else press(run, value)
            if action == ACTION_LEFT: return press(run, TwoHands::LEFT)
            if action == ACTION_RIGHT: return press(run, TwoHands::RIGHT)
            if action == ACTION_JUMP: return press(run, TwoHands::JUMP)
            if action == ACTION_FASTER: return press(run, TwoHands::FASTER)
            if action == ACTION_SLOWER: return press(run, TwoHands::SLOWER)
            return -6
