include "./full_stop_game.elisa"
include "./passage_corpus.elisa"

module FullStopHost:
    struct Run:
        session: mutable FullStopGame::Session
        resources: mutable Arena
        corpus: mutable PassageSeed::Corpus
        loaded: mutable bool

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64) -> Run:
        return Run{session: FullStopGame::initialize(rung, trials, adaptive, seed),
            resources: zeroed, corpus: zeroed, loaded: false}

    def import_caches(run: mutable Run&, passages: sview, sentences: sview, lexicon: sview) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if run.loaded or run.session.phase != FullStopGame::READY
            owner: mutable Arena& = &run.resources
            in owner:
                run.corpus <- PassageSeed::from_cache(passages, sentences, lexicon)
            if run.corpus.bank.passages.count.i64() == 0:
                FullStopGame::release_full_stop_arena(&run.resources) can Global{Read,Write}
                run.corpus <- zeroed
                return false
            run.loaded <- true
            return true

    def start(run: mutable Run&, now: f64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            if not run.loaded:
                _ = import_caches(run, "", "", "") can Global{Read,Write}
            return FullStopGame::start(&run.session, &run.corpus, now) can Global{Read,Write}

    def close(run: mutable Run&):
        can Memory.Release, Abort.Panic:
            FullStopGame::close(&run.session) can Global{Read,Write}
            FullStopGame::release_full_stop_arena(&run.resources) can Global{Read,Write}
            run.loaded <- false
            run.corpus <- zeroed

    def pointer(run: mutable Run&, x: f64, y: f64, kind: i64, now: f64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            if kind == 1 and (run.session.phase == FullStopGame::READY or run.session.phase == FullStopGame::DONE):
                return start(run, now) can Global{Read,Write}
            return FullStopGame::pointer(&run.session, &run.corpus, x, y, kind, now) can Global{Read,Write}

    def agent_event(run: mutable Run&, now: f64, port: i64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return (start(run, now) can Global{Read,Write}) if port == FullStopGame::START
            return FullStopGame::agent_event(&run.session, &run.corpus, now, port) can Global{Read,Write}
