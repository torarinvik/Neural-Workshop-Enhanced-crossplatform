# Marble Maze: tilt a tray, roll marbles to the cup, miss the holes.
#
# Port of neural_workshop/marblemaze.py -- THE GENERATOR AND ITS CERTIFICATE,
# not the dynamics. The reference's `Simulation` is a wrapper around MuJoCo, a
# native rigid-body engine it imports at module scope; porting that is porting
# MuJoCo, which is a different job from porting this module and is not
# something a browser or a phone build could carry anyway. Everything else --
# the maze, the wall strips, the holes, the certificate, the marble placement
# and the coach's potential field -- is plain arithmetic and is all here.
#
# What that leaves out, precisely: `Simulation`, `_mjcf` (which exists only to
# feed it), and `Marble`'s per-tick integration. What it leaves in is the whole
# of what makes a tray a tray, including the part that decides whether a dealt
# tray is winnable at all.
#
# The float question here has a different answer from twohands'. `math.hypot`
# is used eleven times and most are comparisons -- but `_sweep` SEEDS its
# distance field with `hypot(di, dj) * pitch`, so that one is a value that
# every distance downstream inherits. Swapping CPython's hypot for a naive
# `sqrt(a*a + b*b)` in the reference moved field cells in all 64 trays
# measured, so `py_hypot` is used throughout. See src/pymath.elisa.
#
# NOTE: needs elisacore_math, pyrandom and pymath included by the driver.

module MarbleMaze:
    const BOARD_MARGIN: f64 = 0.004
    const WALL_SHARE: f64 = 0.11
    const MARBLE_RADIUS: f64 = 0.0075
    const HOLE_WALL_CLEARANCE: f64 = MARBLE_RADIUS * 0.40
    const SPEED_CAP: f64 = 1.0
    const POTENTIAL_QUANTUM: f64 = 0.025
    # MARBLE_RADIUS / 2.5
    const SWEEP_PITCH: f64 = 0.003
    const START_CLEARANCE: f64 = 2.0
    const GRADE_COUNT: i64 = 16

    struct MarbleGrade:
        cols: mutable i64
        rows: mutable i64
        slack: mutable f64
        braid: mutable f64
        holes: mutable i64
        hole_scale: mutable f64
        margin_scale: mutable f64
        marbles: mutable i64
        seconds: mutable f64

    def clamped_rung(rung: i64) -> i64:
        can Abort.Panic:
            out: mutable i64 = rung
            out <- 1 if out < 1
            out <- GRADE_COUNT if out > GRADE_COUNT
            return out

    def grade_of(rung: i64) -> MarbleGrade:
        can Abort.Panic:
            index: i64 = clamped_rung(rung) - 1
            g: mutable MarbleGrade = zeroed
            if index == 0:
                g.cols <- 4
                g.rows <- 4
                g.slack <- 3.40
                g.braid <- 0.00
                g.holes <- 0
                g.hole_scale <- 2.0
                g.margin_scale <- 1.60
                g.marbles <- 1
                g.seconds <- 45.0
            if index == 1:
                g.cols <- 4
                g.rows <- 4
                g.slack <- 3.45
                g.braid <- 0.00
                g.holes <- 1
                g.hole_scale <- 2.0
                g.margin_scale <- 1.40
                g.marbles <- 1
                g.seconds <- 45.0
            if index == 2:
                g.cols <- 5
                g.rows <- 4
                g.slack <- 3.40
                g.braid <- 0.10
                g.holes <- 3
                g.hole_scale <- 2.0
                g.margin_scale <- 1.30
                g.marbles <- 1
                g.seconds <- 50.0
            if index == 3:
                g.cols <- 5
                g.rows <- 5
                g.slack <- 3.25
                g.braid <- 0.10
                g.holes <- 5
                g.hole_scale <- 1.9
                g.margin_scale <- 1.20
                g.marbles <- 1
                g.seconds <- 55.0
            if index == 4:
                g.cols <- 5
                g.rows <- 5
                g.slack <- 3.30
                g.braid <- 0.05
                g.holes <- 4
                g.hole_scale <- 1.9
                g.margin_scale <- 1.30
                g.marbles <- 2
                g.seconds <- 70.0
            if index == 5:
                g.cols <- 6
                g.rows <- 5
                g.slack <- 3.10
                g.braid <- 0.15
                g.holes <- 7
                g.hole_scale <- 1.8
                g.margin_scale <- 1.10
                g.marbles <- 1
                g.seconds <- 60.0
            if index == 6:
                g.cols <- 6
                g.rows <- 6
                g.slack <- 3.125
                g.braid <- 0.15
                g.holes <- 8
                g.hole_scale <- 1.8
                g.margin_scale <- 1.15
                g.marbles <- 2
                g.seconds <- 78.0
            if index == 7:
                g.cols <- 7
                g.rows <- 6
                g.slack <- 2.95
                g.braid <- 0.20
                g.holes <- 11
                g.hole_scale <- 1.7
                g.margin_scale <- 1.00
                g.marbles <- 1
                g.seconds <- 65.0
            if index == 8:
                g.cols <- 7
                g.rows <- 6
                g.slack <- 3.025
                g.braid <- 0.10
                g.holes <- 9
                g.hole_scale <- 1.7
                g.margin_scale <- 1.15
                g.marbles <- 3
                g.seconds <- 95.0
            if index == 9:
                g.cols <- 8
                g.rows <- 7
                g.slack <- 2.825
                g.braid <- 0.20
                g.holes <- 14
                g.hole_scale <- 1.6
                g.margin_scale <- 0.95
                g.marbles <- 1
                g.seconds <- 72.0
            if index == 10:
                g.cols <- 8
                g.rows <- 7
                g.slack <- 2.85
                g.braid <- 0.15
                g.holes <- 13
                g.hole_scale <- 1.6
                g.margin_scale <- 1.00
                g.marbles <- 2
                g.seconds <- 90.0
            if index == 11:
                g.cols <- 9
                g.rows <- 8
                g.slack <- 2.70
                g.braid <- 0.25
                g.holes <- 18
                g.hole_scale <- 1.5
                g.margin_scale <- 0.90
                g.marbles <- 1
                g.seconds <- 80.0
            if index == 12:
                g.cols <- 9
                g.rows <- 8
                g.slack <- 2.775
                g.braid <- 0.10
                g.holes <- 14
                g.hole_scale <- 1.5
                g.margin_scale <- 1.05
                g.marbles <- 4
                g.seconds <- 120.0
            if index == 13:
                g.cols <- 10
                g.rows <- 9
                g.slack <- 2.575
                g.braid <- 0.25
                g.holes <- 24
                g.hole_scale <- 1.4
                g.margin_scale <- 0.85
                g.marbles <- 1
                g.seconds <- 88.0
            if index == 14:
                g.cols <- 11
                g.rows <- 9
                g.slack <- 2.55
                g.braid <- 0.30
                g.holes <- 30
                g.hole_scale <- 1.4
                g.margin_scale <- 0.80
                g.marbles <- 2
                g.seconds <- 110.0
            if index == 15:
                g.cols <- 12
                g.rows <- 10
                g.slack <- 2.425
                g.braid <- 0.30
                g.holes <- 38
                g.hole_scale <- 1.3
                g.margin_scale <- 0.75
                g.marbles <- 3
                g.seconds <- 140.0
            return g

    const MOST_CELLS: i64 = 120
    const MOST_WALLS: i64 = 512
    const MOST_HOLES: i64 = 64

    # North, south, west, east as (dcol, drow), with their opposites.
    def step_col(d: i64) -> i64:
        can Abort.Panic:
            return -1 if d == 2 else (1 if d == 3 else 0)

    def step_row(d: i64) -> i64:
        can Abort.Panic:
            return 1 if d == 0 else (-1 if d == 1 else 0)

    def opposite(d: i64) -> i64:
        can Abort.Panic:
            return 1 if d == 0 else (0 if d == 1 else (3 if d == 2 else 2))

    # A perfect maze by recursive backtracking, iterative because a 12x10 tray is
    # 120 cells deep in the worst case. `opened[cell * 4 + d]` is a doorway.
    def carve(cols: i64, rows: i64, rng: mutable MT19937&, opened: mutable darray[i64]&) can[Memory.Allocate, Abort.Panic]:
        total: i64 = cols * rows
        wipe: mutable i64 = 0
        while wipe < total * 4 |wipe, opened|:
            Ints::put(opened, wipe, 0)
            wipe <- wipe + 1
        seen: mutable darray[i64] = Ints::zeros(MOST_CELLS)
        visit_stack: mutable darray[i64] = Ints::zeros(MOST_CELLS + 1)
        pick_d: mutable darray[i64] = Ints::zeros(4)
        pick_cell: mutable darray[i64] = Ints::zeros(4)
        start: i64 = py_randrange(rng, 0, total)
        Ints::put(&seen, start, 1)
        Ints::put(&visit_stack, 0, start)
        depth: mutable i64 = 1
        while depth > 0 |depth, cols, rows, rng, opened, seen, visit_stack, pick_d, pick_cell|:
            cell: i64 = Ints::at(visit_stack, depth - 1)
            col: i64 = cell % cols
            row: i64 = cell / cols
            count: mutable i64 = 0
            d: mutable i64 = 0
            while d < 4 |d, col, row, cols, rows, seen, pick_d, pick_cell, count|:
                a: i64 = col + step_col(d)
                b: i64 = row + step_row(d)
                if a >= 0 and a < cols and b >= 0 and b < rows and Ints::at(seen, b * cols + a) == 0:
                    Ints::put(&pick_d, count, d)
                    Ints::put(&pick_cell, count, b * cols + a)
                    count <- count + 1
                d <- d + 1
            if count == 0:
                depth <- depth - 1
            else:
                choice: i64 = py_choice_index(rng, count)
                way: i64 = Ints::at(pick_d, choice)
                next_cell: i64 = Ints::at(pick_cell, choice)
                Ints::put(opened, cell * 4 + way, 1)
                Ints::put(opened, next_cell * 4 + opposite(way), 1)
                Ints::put(&seen, next_cell, 1)
                Ints::put(&visit_stack, depth, next_cell)
                depth <- depth + 1

    # Open `share` of the dead ends into loops, in place. A perfect maze has
    # exactly one route and so exactly one decision per junction, which is no
    # decision at all.
    def braid(opened: mutable darray[i64]&, cols: i64, rows: i64, share: f64, rng: mutable MT19937&) can[Memory.Allocate, Abort.Panic]:
        if share <= 0.0:
            return
        total: i64 = cols * rows
        ends: mutable darray[i64] = Ints::zeros(MOST_CELLS)
        count: mutable i64 = 0
        cell: mutable i64 = 0
        while cell < total |cell, opened, ends, count|:
            doors: i64 = Ints::at_ref(opened, cell * 4) + Ints::at_ref(opened, cell * 4 + 1) + Ints::at_ref(opened, cell * 4 + 2) + Ints::at_ref(opened, cell * 4 + 3)
            if doors == 1:
                Ints::put(&ends, count, cell)
                count <- count + 1
            cell <- cell + 1
        py_shuffle_i64_prefix(rng, &ends, count)
        wanted: i64 = py_round_half_even(count.f64() * share)
        pick_d: mutable darray[i64] = Ints::zeros(4)
        pick_cell: mutable darray[i64] = Ints::zeros(4)
        at: mutable i64 = 0
        while at < wanted |at, wanted, ends, cols, rows, opened, rng, pick_d, pick_cell|:
            here: i64 = Ints::at(ends, at)
            col: i64 = here % cols
            row: i64 = here / cols
            shut: mutable i64 = 0
            d: mutable i64 = 0
            while d < 4 |d, col, row, cols, rows, opened, here, pick_d, pick_cell, shut|:
                a: i64 = col + step_col(d)
                b: i64 = row + step_row(d)
                if a >= 0 and a < cols and b >= 0 and b < rows and Ints::at_ref(opened, here * 4 + d) == 0:
                    Ints::put(&pick_d, shut, d)
                    Ints::put(&pick_cell, shut, b * cols + a)
                    shut <- shut + 1
                d <- d + 1
            if shut > 0:
                choice: i64 = py_choice_index(rng, shut)
                way: i64 = Ints::at(pick_d, choice)
                next_cell: i64 = Ints::at(pick_cell, choice)
                Ints::put(opened, here * 4 + way, 1)
                Ints::put(opened, next_cell * 4 + opposite(way), 1)
            at <- at + 1

    # Doorway-counting distance from `source`, for choosing a far cup.
    def cell_distances(opened: darray[i64], cols: i64, rows: i64, source: i64, far: mutable darray[i64]&) can[Memory.Allocate, Abort.Panic]:
        total: i64 = cols * rows
        wipe: mutable i64 = 0
        while wipe < total |wipe, far|:
            Ints::put(far, wipe, -1)
            wipe <- wipe + 1
        queue: mutable darray[i64] = Ints::zeros(MOST_CELLS)
        Ints::put(far, source, 0)
        Ints::put(&queue, 0, source)
        count: mutable i64 = 1
        at: mutable i64 = 0
        while at < count |at, count, queue, opened, cols, rows, far|:
            cell: i64 = Ints::at(queue, at)
            at <- at + 1
            col: i64 = cell % cols
            row: i64 = cell / cols
            d: mutable i64 = 0
            while d < 4 |d, cell, col, row, cols, rows, opened, far, queue, count|:
                if Ints::at(opened, cell * 4 + d) == 1:
                    a: i64 = col + step_col(d)
                    b: i64 = row + step_row(d)
                    next_cell: i64 = b * cols + a
                    if Ints::at_ref(far, next_cell) < 0:
                        Ints::put(far, next_cell, Ints::at_ref(far, cell) + 1)
                        Ints::put(&queue, count, next_cell)
                        count <- count + 1
                d <- d + 1

    struct Walls:
        x0: mutable darray[f64]
        y0: mutable darray[f64]
        x1: mutable darray[f64]
        y1: mutable darray[f64]
        count: mutable i64

    struct Holes:
        x: mutable darray[f64]
        y: mutable darray[f64]
        radius: mutable darray[f64]
        home: mutable darray[i64]
        count: mutable i64

    def Walls() -> Walls:
        can Memory.Allocate, Abort.Panic:
            out: mutable Walls = zeroed
            out.x0 <- Floats::zeros(MOST_WALLS)
            out.y0 <- Floats::zeros(MOST_WALLS)
            out.x1 <- Floats::zeros(MOST_WALLS)
            out.y1 <- Floats::zeros(MOST_WALLS)
            return out

    def Holes() -> Holes:
        can Memory.Allocate, Abort.Panic:
            out: mutable Holes = zeroed
            out.x <- Floats::zeros(MOST_HOLES)
            out.y <- Floats::zeros(MOST_HOLES)
            out.radius <- Floats::zeros(MOST_HOLES)
            out.home <- Ints::zeros(MOST_HOLES)
            return out

    def wall_between(opened: darray[i64], cols: i64, rows: i64, col: i64, row: i64, d: i64) -> bool:
        can Abort.Panic:
            if col < 0 or col >= cols or row < 0 or row >= rows:
                return false
            return Ints::at(opened, (row * cols + col) * 4 + d) == 0

    # Turn doorway flags into the boxes the marble actually hits. Runs of collinear
    # wall are merged: a 12x10 tray goes from about 240 strips to about 90.
    def wall_strips(opened: darray[i64], cols: i64, rows: i64, cell: f64, thick: f64, ox: f64, oy: f64, out: mutable Walls&):
        can Abort.Panic:
            half: f64 = thick / 2.0
            out.count <- 0
            # Horizontal walls: for each lattice row, the runs of columns whose
            # cell below (or the boundary) is closed off upward.
            line: mutable i64 = 0
            while line <= rows |line, cols, rows, opened, cell, half, ox, oy, out|:
                run_start: mutable i64 = -1
                col: mutable i64 = 0
                while col <= cols |col, line, cols, rows, opened, cell, half, ox, oy, out, run_start|:
                    solid: mutable bool = false
                    if col < cols:
                        if line == 0 or line == rows:
                            solid <- true
                        else:
                            solid <- wall_between(opened, cols, rows, col, line - 1, 0)
                    if solid and run_start < 0:
                        run_start <- col
                    if not solid and run_start >= 0:
                        slot: i64 = out.count
                        Floats::put(&out.x0, slot, ox + run_start.f64() * cell - half)
                        Floats::put(&out.y0, slot, oy + line.f64() * cell - half)
                        Floats::put(&out.x1, slot, ox + col.f64() * cell + half)
                        Floats::put(&out.y1, slot, oy + line.f64() * cell + half)
                        out.count <- slot + 1
                        run_start <- -1
                    col <- col + 1
                line <- line + 1
            # Vertical walls, the same sweep turned ninety degrees.
            column: mutable i64 = 0
            while column <= cols |column, cols, rows, opened, cell, half, ox, oy, out|:
                run_start: mutable i64 = -1
                row: mutable i64 = 0
                while row <= rows |row, column, cols, rows, opened, cell, half, ox, oy, out, run_start|:
                    solid: mutable bool = false
                    if row < rows:
                        if column == 0 or column == cols:
                            solid <- true
                        else:
                            solid <- wall_between(opened, cols, rows, column - 1, row, 3)
                    if solid and run_start < 0:
                        run_start <- row
                    if not solid and run_start >= 0:
                        slot: i64 = out.count
                        Floats::put(&out.x0, slot, ox + column.f64() * cell - half)
                        Floats::put(&out.y0, slot, oy + run_start.f64() * cell - half)
                        Floats::put(&out.x1, slot, ox + column.f64() * cell + half)
                        Floats::put(&out.y1, slot, oy + row.f64() * cell + half)
                        out.count <- slot + 1
                        run_start <- -1
                    row <- row + 1
                column <- column + 1

    # --- certifying a tray ---

    const MOST_GRID: i64 = 65536

    struct MarbleField:
        x0: mutable f64
        y0: mutable f64
        pitch: mutable f64
        cols: mutable i64
        rows: mutable i64
        # Row-major. `known` is 0 where the marble's centre may not be, which is
        # the reference's `None` -- a real distance of 0.0 exists at the cup, so
        # the two cannot be folded into one array.
        dist: mutable darray[f64]
        known: mutable darray[i64]
        free: mutable darray[i64]

    def MarbleField() -> MarbleField:
        can Memory.Allocate, Abort.Panic:
            out: mutable MarbleField = zeroed
            out.dist <- Floats::zeros(MOST_GRID)
            out.known <- Ints::zeros(MOST_GRID)
            out.free <- Ints::zeros(MOST_GRID)
            return out

    # Every grid point the marble's centre may legally occupy: at least `radius`
    # from every wall box, outside every pit by its own radius, and inside the
    # tray. A point that fails is not merely bad, it is unreachable, so the sweep
    # that follows can be a plain shortest path over what is left.
    def free_grid(walls: Walls&, holes: Holes&, radius: f64, pitch: f64, width: f64, depth: f64, field: mutable MarbleField&):
        can Abort.Panic:
            x0: f64 = radius
            y0: f64 = radius
            raw_cols: i64 = ((width - 2.0 * radius) / pitch).i64() + 1
            raw_rows: i64 = ((depth - 2.0 * radius) / pitch).i64() + 1
            cols: i64 = 2 if raw_cols < 2 else raw_cols
            rows: i64 = 2 if raw_rows < 2 else raw_rows
            field.x0 <- x0
            field.y0 <- y0
            field.pitch <- pitch
            field.cols <- cols
            field.rows <- rows
            wipe: mutable i64 = 0
            while wipe < cols * rows |wipe, field|:
                Ints::put(&field.free, wipe, 1)
                wipe <- wipe + 1
            wall: mutable i64 = 0
            while wall < walls.count |wall, walls, radius, pitch, x0, y0, cols, rows, field|:
                # Expand the box by the marble radius and strike out what it
                # covers: a centre inside the expanded box is a marble overlapping.
                wx0: f64 = Floats::at(walls.x0, wall)
                wy0: f64 = Floats::at(walls.y0, wall)
                wx1: f64 = Floats::at(walls.x1, wall)
                wy1: f64 = Floats::at(walls.y1, wall)
                raw_lo_i: i64 = floor((wx0 - radius - x0) / pitch).i64()
                raw_hi_i: i64 = ceil((wx1 + radius - x0) / pitch).i64()
                raw_lo_j: i64 = floor((wy0 - radius - y0) / pitch).i64()
                raw_hi_j: i64 = ceil((wy1 + radius - y0) / pitch).i64()
                lo_i: i64 = 0 if raw_lo_i < 0 else raw_lo_i
                hi_i: i64 = cols - 1 if raw_hi_i > cols - 1 else raw_hi_i
                lo_j: i64 = 0 if raw_lo_j < 0 else raw_lo_j
                hi_j: i64 = rows - 1 if raw_hi_j > rows - 1 else raw_hi_j
                j: mutable i64 = lo_j
                while j <= hi_j |j, hi_j, lo_i, hi_i, y0, x0, pitch, wx0, wy0, wx1, wy1, radius, cols, field|:
                    y: f64 = y0 + j.f64() * pitch
                    if y >= wy0 - radius and y <= wy1 + radius:
                        base: i64 = j * cols
                        i: mutable i64 = lo_i
                        while i <= hi_i |i, hi_i, x0, pitch, wx0, wx1, radius, base, field|:
                            x: f64 = x0 + i.f64() * pitch
                            if x >= wx0 - radius and x <= wx1 + radius:
                                Ints::put(&field.free, base + i, 0)
                            i <- i + 1
                    j <- j + 1
                wall <- wall + 1
            hole: mutable i64 = 0
            while hole < holes.count |hole, holes, pitch, x0, y0, cols, rows, field|:
                if Ints::at(holes.home, hole) == 0:
                    hx: f64 = Floats::at(holes.x, hole)
                    hy: f64 = Floats::at(holes.y, hole)
                    reach: f64 = Floats::at(holes.radius, hole)
                    raw_lo_i: i64 = floor((hx - reach - x0) / pitch).i64()
                    raw_hi_i: i64 = ceil((hx + reach - x0) / pitch).i64()
                    raw_lo_j: i64 = floor((hy - reach - y0) / pitch).i64()
                    raw_hi_j: i64 = ceil((hy + reach - y0) / pitch).i64()
                    lo_i: i64 = 0 if raw_lo_i < 0 else raw_lo_i
                    hi_i: i64 = cols - 1 if raw_hi_i > cols - 1 else raw_hi_i
                    lo_j: i64 = 0 if raw_lo_j < 0 else raw_lo_j
                    hi_j: i64 = rows - 1 if raw_hi_j > rows - 1 else raw_hi_j
                    j: mutable i64 = lo_j
                    while j <= hi_j |j, hi_j, lo_i, hi_i, x0, y0, pitch, hx, hy, reach, cols, field|:
                        y: f64 = y0 + j.f64() * pitch
                        base: i64 = j * cols
                        i: mutable i64 = lo_i
                        while i <= hi_i |i, hi_i, x0, pitch, hx, hy, reach, base, y, field|:
                            x: f64 = x0 + i.f64() * pitch
                            if py_hypot(x - hx, y - hy) < reach:
                                Ints::put(&field.free, base + i, 0)
                            i <- i + 1
                        j <- j + 1
                hole <- hole + 1

    const MOST_QUEUE: i64 = 262144

    # Geodesic distance to the cup over the free grid, in metres. Eight-connected
    # Dijkstra with true costs, so the field is a metric rather than a staircase --
    # which matters, because the coach leans on it being 1-Lipschitz.
    #
    # The reference's queue holds `(distance, index)` TUPLES, so ties break by
    # index. Every entry it ever pushes is distinct under that order -- a push
    # happens only on a strict improvement -- so the pop sequence is fixed and any
    # correct priority queue reproduces it. This is a plain binary queue comparing
    # the pair in the same order.
    struct Queue:
        key: mutable darray[f64]
        at: mutable darray[i64]
        count: mutable i64

    def Queue() -> Queue:
        can Memory.Allocate, Abort.Panic:
            out: mutable Queue = zeroed
            out.key <- Floats::zeros(MOST_QUEUE)
            out.at <- Ints::zeros(MOST_QUEUE)
            return out

    def queue_less(queue: Queue&, a: i64, b: i64) -> bool:
        can Abort.Panic:
            ka: f64 = Floats::at(queue.key, a)
            kb: f64 = Floats::at(queue.key, b)
            if ka < kb:
                return true
            if ka > kb:
                return false
            return Ints::at(queue.at, a) < Ints::at(queue.at, b)

    def queue_swap(queue: mutable Queue&, a: i64, b: i64):
        can Abort.Panic:
            k: f64 = Floats::at_ref(&queue.key, a)
            v: i64 = Ints::at_ref(&queue.at, a)
            Floats::put(&queue.key, a, Floats::at_ref(&queue.key, b))
            Ints::put(&queue.at, a, Ints::at_ref(&queue.at, b))
            Floats::put(&queue.key, b, k)
            Ints::put(&queue.at, b, v)

    def queue_push(queue: mutable Queue&, key: f64, at: i64):
        can Abort.Panic:
            slot: mutable i64 = queue.count
            if slot >= MOST_QUEUE:
                return
            Floats::put(&queue.key, slot, key)
            Ints::put(&queue.at, slot, at)
            queue.count <- slot + 1
            rising: mutable bool = true
            while rising and slot > 0 |rising, slot, queue|:
                parent: i64 = (slot - 1) / 2
                if queue_less(queue, slot, parent):
                    queue_swap(queue, slot, parent)
                    slot <- parent
                else:
                    rising <- false

    def queue_pop(queue: mutable Queue&) -> i64:
        can Abort.Panic:
            top: i64 = Ints::at_ref(&queue.at, 0)
            queue.count <- queue.count - 1
            if queue.count > 0:
                Floats::put(&queue.key, 0, Floats::at_ref(&queue.key, queue.count))
                Ints::put(&queue.at, 0, Ints::at_ref(&queue.at, queue.count))
                slot: mutable i64 = 0
                sinking: mutable bool = true
                while sinking |sinking, slot, queue|:
                    left: i64 = slot * 2 + 1
                    right: i64 = slot * 2 + 2
                    small: mutable i64 = slot
                    small <- left if left < queue.count and queue_less(queue, left, small)
                    small <- right if right < queue.count and queue_less(queue, right, small)
                    if small == slot:
                        sinking <- false
                    else:
                        queue_swap(queue, slot, small)
                        slot <- small
            return top

    def queue_key(queue: Queue&) -> f64:
        can Abort.Panic:
            return Floats::at(queue.key, 0)

    def sweep(field: mutable MarbleField&, target_x: f64, target_y: f64, queue: mutable Queue&):
        can Abort.Panic:
            cols: i64 = field.cols
            rows: i64 = field.rows
            pitch: f64 = field.pitch
            wipe: mutable i64 = 0
            while wipe < cols * rows |wipe, field|:
                Ints::put(&field.known, wipe, 0)
                wipe <- wipe + 1
            queue.count <- 0
            ti: i64 = py_round_half_even((target_x - field.x0) / pitch)
            tj: i64 = py_round_half_even((target_y - field.y0) / pitch)
            # The cup's own grid point is usually struck out -- it is a hole, and
            # its rim is inside the marble's exclusion. Seed from the free ring
            # around it instead, at their true distance from the cup's centre.
            span: i64 = ceil(0.03 / pitch).i64()
            dj: mutable i64 = -span
            while dj <= span |dj, span, ti, tj, cols, rows, pitch, field, queue|:
                di: mutable i64 = -span
                while di <= span |di, span, dj, ti, tj, cols, rows, pitch, field, queue|:
                    i: i64 = ti + di
                    j: i64 = tj + dj
                    if i >= 0 and i < cols and j >= 0 and j < rows and Ints::at_ref(&field.free, j * cols + i) == 1:
                        gap: f64 = py_hypot(di.f64(), dj.f64()) * pitch
                        if gap <= span.f64() * pitch:
                            at: i64 = j * cols + i
                            if Ints::at_ref(&field.known, at) == 0 or gap < Floats::at_ref(&field.dist, at):
                                Floats::put(&field.dist, at, gap)
                                Ints::put(&field.known, at, 1)
                                queue_push(queue, gap, at)
                    di <- di + 1
                dj <- dj + 1
            diag: f64 = sqrt(2.0) * pitch
            straight: f64 = pitch
            while queue.count > 0 |queue, field, cols, rows, diag, straight|:
                far: f64 = queue_key(queue)
                at: i64 = queue_pop(queue)
                # A stale entry: something better reached this cell after it was
                # queued.
                if Ints::at_ref(&field.known, at) == 0 or far <= Floats::at_ref(&field.dist, at):
                    i: i64 = at % cols
                    j: i64 = at / cols
                    d: mutable i64 = 0
                    while d < 8 |d, i, j, at, far, cols, rows, diag, straight, field, queue|:
                        di: i64 = neighbour_di(d)
                        dj: i64 = neighbour_dj(d)
                        step: f64 = straight if d < 4 else diag
                        a: i64 = i + di
                        b: i64 = j + dj
                        if a >= 0 and a < cols and b >= 0 and b < rows:
                            next_at: i64 = b * cols + a
                            if Ints::at_ref(&field.free, next_at) == 1:
                                through: f64 = far + step
                                if Ints::at_ref(&field.known, next_at) == 0 or through < Floats::at_ref(&field.dist, next_at) - 1e-12:
                                    Floats::put(&field.dist, next_at, through)
                                    Ints::put(&field.known, next_at, 1)
                                    queue_push(queue, through, next_at)
                        d <- d + 1

    # The reference's neighbour order: the four straights, then the four diagonals.
    def neighbour_di(d: i64) -> i64:
        can Abort.Panic:
            if d == 0:
                return 1
            if d == 1:
                return -1
            if d == 2:
                return 0
            if d == 3:
                return 0
            if d == 4:
                return 1
            if d == 5:
                return 1
            if d == 6:
                return -1
            return -1

    def neighbour_dj(d: i64) -> i64:
        can Abort.Panic:
            if d == 0:
                return 0
            if d == 1:
                return 0
            if d == 2:
                return 1
            if d == 3:
                return -1
            if d == 4:
                return 1
            if d == 5:
                return -1
            if d == 6:
                return 1
            return -1

    # Distance at exactly this point, or "unreachable". What certification asks:
    # `at` widens by a ring to stay useful for a marble pressed against a wall, and
    # that widening would let a start point one cell inside a sealed pocket borrow
    # its neighbour's answer.
    def field_strict(field: MarbleField&, x: f64, y: f64, found: mutable bool&) -> f64:
        can Abort.Panic:
            i: i64 = py_round_half_even((x - field.x0) / field.pitch)
            j: i64 = py_round_half_even((y - field.y0) / field.pitch)
            found <- false
            if i < 0 or i >= field.cols or j < 0 or j >= field.rows:
                return 0.0
            at: i64 = j * field.cols + i
            if Ints::at(field.known, at) == 0:
                return 0.0
            found <- true
            return Floats::at(field.dist, at)

    # Distance to the cup from (x, y), or nothing off the free space. A marble
    # resting hard against a wall rounds to a cell its centre may not occupy;
    # widening by one ring costs eight lookups and stops the coach going blind
    # exactly when the player is doing the sensible thing.
    def field_at(field: MarbleField&, x: f64, y: f64, found: mutable bool&) -> f64:
        can Abort.Panic:
            i: i64 = py_round_half_even((x - field.x0) / field.pitch)
            j: i64 = py_round_half_even((y - field.y0) / field.pitch)
            found <- false
            if i < 0 or i >= field.cols or j < 0 or j >= field.rows:
                return 0.0
            at: i64 = j * field.cols + i
            if Ints::at(field.known, at) == 1:
                found <- true
                return Floats::at(field.dist, at)
            have: mutable bool = false
            best: mutable f64 = 0.0
            dj: mutable i64 = -1
            while dj <= 1 |dj, i, j, field, have, best|:
                di: mutable i64 = -1
                while di <= 1 |di, dj, i, j, field, have, best|:
                    a: i64 = i + di
                    b: i64 = j + dj
                    if a >= 0 and a < field.cols and b >= 0 and b < field.rows:
                        near_at: i64 = b * field.cols + a
                        if Ints::at(field.known, near_at) == 1:
                            near: f64 = Floats::at(field.dist, near_at)
                            if not have or near < best:
                                have <- true
                                best <- near
                    di <- di + 1
                dj <- dj + 1
            found <- have
            return best

    # The coach's potential: the distance field, quantised so that one action moves
    # it by at most one step.
    def potential_at(field: MarbleField&, x: f64, y: f64, found: mutable bool&) -> i64:
        can Abort.Panic:
            have: mutable bool = false
            got: f64 = field_at(field, x, y, &have)
            found <- have
            if not have:
                return 0
            return (got / POTENTIAL_QUANTUM).i64()

    # --- dealing ---

    const MOST_MARBLES: i64 = 8

    struct MarbleTray:
        built: mutable bool
        rung: mutable i64
        cols: mutable i64
        rows: mutable i64
        width: mutable f64
        depth: mutable f64
        cell: mutable f64
        thickness: mutable f64
        height: mutable f64
        walls: mutable Walls
        holes: mutable Holes
        start_x: mutable darray[f64]
        start_y: mutable darray[f64]
        start_n: mutable i64
        home_x: mutable f64
        home_y: mutable f64
        home_r: mutable f64
        seconds: mutable f64
        field: mutable MarbleField
        route: mutable f64

    def MarbleTray() -> MarbleTray:
        can Memory.Allocate, Abort.Panic:
            out: mutable MarbleTray = zeroed
            out.walls <- Walls()
            out.holes <- Holes()
            out.field <- MarbleField()
            out.start_x <- Floats::zeros(MOST_MARBLES)
            out.start_y <- Floats::zeros(MOST_MARBLES)
            return out

    # Whether a marble may START here -- a stricter test than legality. The free
    # grid rules out points within a hole's radius, so a start taken straight off
    # it can sit exactly on a rim: legal, not over the hole, and a millimetre from
    # being over it.
    def clear_of_pits(holes: Holes&, x: f64, y: f64) -> bool:
        can Abort.Panic:
            hole: mutable i64 = 0
            clear: mutable bool = true
            while hole < holes.count and clear |hole, holes, x, y, clear|:
                if Ints::at(holes.home, hole) == 0:
                    room: f64 = Floats::at(holes.radius, hole) + MARBLE_RADIUS * START_CLEARANCE
                    clear <- false if py_hypot(x - Floats::at(holes.x, hole), y - Floats::at(holes.y, hole)) < room
                hole <- hole + 1
            return clear

    # Check the actual merged wall rectangles, including diagonal corner
    # neighbours. The corridor bound is sufficient for pit-side passage, but
    # the home cup is centred in a cell and needs this exact geometry check.
    def circle_clear_of_walls(walls: Walls&, x: f64, y: f64, radius: f64) -> bool:
        can Abort.Panic:
            wall: mutable i64 = 0
            clear: mutable bool = true
            while wall < walls.count and clear |wall, walls, x, y, radius, clear|:
                x0: f64 = Floats::at(walls.x0, wall)
                y0: f64 = Floats::at(walls.y0, wall)
                x1: f64 = Floats::at(walls.x1, wall)
                y1: f64 = Floats::at(walls.y1, wall)
                dx: f64 = x0 - x if x < x0 else (x - x1 if x > x1 else 0.0)
                dy: f64 = y0 - y if y < y0 else (y - y1 if y > y1 else 0.0)
                clear <- false if py_hypot(dx, dy) - radius < HOLE_WALL_CLEARANCE - 1e-12
                wall <- wall + 1
            return clear

    # Bite holes out of the corridors, each one still passable. The test is
    # analytic and local, which is what lets the placement be greedy.
    #
    # Holes go in CELLS, offset across the corridor, and never in the cell a marble
    # starts in or the one the cup is in.
    def place_holes(g: MarbleGrade, opened: darray[i64], walls: Walls&, cols: i64, rows: i64, cell: f64, corridor: f64, width: f64, depth: f64, ox: f64, oy: f64, start_cell: i64, home_cell: i64, from_start: darray[i64], from_home: darray[i64], rng: mutable MT19937&, out: mutable Holes&) can[Memory.Allocate, Abort.Panic]:
        out.count <- 0
        radius: f64 = MARBLE_RADIUS * g.hole_scale
        margin: f64 = MARBLE_RADIUS * g.margin_scale
        half: f64 = corridor / 2.0
        # Keep each circular opening inside the corridor, clear of the nearest
        # wall, while leaving the required marble passage on the far side.
        least: f64 = radius + margin + MARBLE_RADIUS - half
        wall_safe: f64 = half - radius - HOLE_WALL_CLEARANCE
        varied: f64 = half + radius * 0.55
        most: f64 = wall_safe if wall_safe < varied else varied
        if least > most:
            return
        total: i64 = cols * rows
        candidates: mutable darray[i64] = Ints::zeros(MOST_CELLS)
        count: mutable i64 = 0
        cell_index: mutable i64 = 0
        while cell_index < total |cell_index, total, start_cell, home_cell, candidates, count|:
            if cell_index != start_cell and cell_index != home_cell:
                Ints::put(&candidates, count, cell_index)
                count <- count + 1
            cell_index <- cell_index + 1
        py_shuffle_i64_prefix(rng, &candidates, count)
        # Prefer the route: a hole in a cul-de-sac nobody visits is not a hazard,
        # it is scenery. A cell lies on SOME shortest route exactly when the two
        # distances through it add up to the whole journey.
        whole: i64 = Ints::at(from_start, home_cell)
        order: mutable darray[i64] = Ints::zeros(MOST_CELLS)
        ordered: mutable i64 = 0
        scan: mutable i64 = 0
        while scan < count |scan, count, candidates, from_start, from_home, whole, order, ordered|:
            here: i64 = Ints::at(candidates, scan)
            if Ints::at(from_start, here) + Ints::at(from_home, here) == whole:
                Ints::put(&order, ordered, here)
                ordered <- ordered + 1
            scan <- scan + 1
        rest: mutable i64 = 0
        while rest < count |rest, count, candidates, from_start, from_home, whole, order, ordered|:
            here: i64 = Ints::at(candidates, rest)
            if Ints::at(from_start, here) + Ints::at(from_home, here) != whole:
                Ints::put(&order, ordered, here)
                ordered <- ordered + 1
            rest <- rest + 1
        place: mutable i64 = 0
        while place < ordered and out.count < g.holes |place, ordered, order, cols, cell, ox, oy, opened, least, most, radius, width, depth, walls, rng, out|:
            here: i64 = Ints::at(order, place)
            col: i64 = here % cols
            row: i64 = here / cols
            cx: f64 = ox + (col.f64() + 0.5) * cell
            cy: f64 = oy + (row.f64() + 0.5) * cell
            # Offset across whichever axis the cell's corridor runs.
            vertical: bool = Ints::at(opened, here * 4) == 1 or Ints::at(opened, here * 4 + 1) == 1
            span: f64 = py_uniform(rng, least, most)
            sign: f64 = 1.0 if py_choice_index(rng, 2) == 1 else -1.0
            offset: f64 = span * sign
            hx: f64 = cx + offset if vertical else cx
            hy: f64 = cy if vertical else cy + offset
            inside: bool = hx > radius and hx < width - radius and hy > radius and hy < depth - radius
            if inside and circle_clear_of_walls(walls, hx, hy, radius):
                crowded: mutable bool = false
                other: mutable i64 = 0
                while other < out.count and not crowded |other, out, hx, hy, radius, crowded|:
                    room: f64 = radius + Floats::at(out.radius, other) + MARBLE_RADIUS * 1.4
                    crowded <- true if py_hypot(hx - Floats::at(out.x, other), hy - Floats::at(out.y, other)) < room
                    other <- other + 1
                if not crowded:
                    slot: i64 = out.count
                    Floats::put(&out.x, slot, hx)
                    Floats::put(&out.y, slot, hy)
                    Floats::put(&out.radius, slot, radius)
                    Ints::put(&out.home, slot, 0)
                    out.count <- slot + 1
            place <- place + 1

    # Line the marbles up along the route, furthest from the cup first. The rest
    # are found by WALKING THE ROUTE DOWN from it, which is what puts them nose to
    # tail in the same corridor rather than scattered over the tray -- they share
    # one pair of knobs, and a tilt that serves one should at least point the rest
    # the right way.
    #
    # Returns false when the route ran out before every marble had a place on it:
    # a shorter tray than the rung wanted is a worse tray, so it is rejected.
    def place_marbles(g: MarbleGrade, field: MarbleField&, cell: f64, holes: Holes&, out_x: mutable darray[f64]&, out_y: mutable darray[f64]&, out_n: mutable i64&) -> bool:
        can Abort.Panic:
            want: i64 = 1 if g.marbles < 1 else g.marbles
            best_at: mutable i64 = -1
            best_far: mutable f64 = 0.0
            at: mutable i64 = 0
            while at < field.cols * field.rows |at, field, holes, best_at, best_far|:
                if Ints::at(field.known, at) == 1:
                    far: f64 = Floats::at(field.dist, at)
                    if best_at < 0 or far > best_far:
                        x: f64 = field.x0 + (at % field.cols).f64() * field.pitch
                        y: f64 = field.y0 + (at / field.cols).f64() * field.pitch
                        if clear_of_pits(holes, x, y):
                            best_at <- at
                            best_far <- far
                at <- at + 1
            if best_at < 0:
                return false
            out_n <- 1
            Floats::put(out_x, 0, field.x0 + (best_at % field.cols).f64() * field.pitch)
            Floats::put(out_y, 0, field.y0 + (best_at / field.cols).f64() * field.pitch)
            walker: mutable i64 = best_at
            # A marble and a half apart along the route, or a whole cell, whichever
            # is longer: close enough to be one queue, far enough that they are not
            # already touching when the tray is dealt.
            spacing: mutable f64 = cell if cell > MARBLE_RADIUS * 3.0 else MARBLE_RADIUS * 3.0
            placed: mutable i64 = 1
            while placed < want |placed, want, field, holes, walker, spacing, out_x, out_y, out_n|:
                walked: mutable f64 = 0.0
                stuck: mutable bool = true
                stepping: mutable bool = true
                while stepping and walked < spacing |stepping, walked, spacing, field, walker, stuck|:
                    here: f64 = Floats::at(field.dist, walker)
                    i: i64 = walker % field.cols
                    j: i64 = walker / field.cols
                    step_to: mutable i64 = -1
                    step_dist: mutable f64 = 0.0
                    dj: mutable i64 = -1
                    while dj <= 1 |dj, i, j, field, here, step_to, step_dist|:
                        di: mutable i64 = -1
                        while di <= 1 |di, dj, i, j, field, here, step_to, step_dist|:
                            a: i64 = i + di
                            b: i64 = j + dj
                            if (di != 0 or dj != 0) and a >= 0 and a < field.cols and b >= 0 and b < field.rows:
                                near_at: i64 = b * field.cols + a
                                if Ints::at(field.known, near_at) == 1:
                                    near: f64 = Floats::at(field.dist, near_at)
                                    if near < here:
                                        if step_to < 0 or near < step_dist:
                                            step_to <- near_at
                                            step_dist <- near
                            di <- di + 1
                        dj <- dj + 1
                    if step_to < 0:
                        stepping <- false
                    else:
                        walked <- walked + py_hypot((step_to % field.cols - i).f64(), (step_to / field.cols - j).f64()) * field.pitch
                        walker <- step_to
                        stuck <- false
                if stuck:
                    return false
                spot_x: f64 = field.x0 + (walker % field.cols).f64() * field.pitch
                spot_y: f64 = field.y0 + (walker / field.cols).f64() * field.pitch
                if clear_of_pits(holes, spot_x, spot_y):
                    Floats::put(out_x, placed, spot_x)
                    Floats::put(out_y, placed, spot_y)
                    placed <- placed + 1
                    out_n <- placed
                else:
                    # Walk on rather than park a marble on a rim. The spacing is a
                    # preference and the clearance is not, so the spacing gives.
                    shrunk: f64 = spacing * 0.6
                    spacing <- MARBLE_RADIUS * 2.5 if shrunk < MARBLE_RADIUS * 2.5 else shrunk
            return true

    def par_seconds(tray: MarbleTray&) -> f64:
        can Abort.Panic:
            pace: f64 = SPEED_CAP * 0.25
            return tray.route / pace + 2.5 * tray.start_n.f64()

    # Sweep the tray and hand back the distance-to-cup field. The certificate and
    # the coach's yardstick are the same computation on purpose: a separate "is it
    # winnable" check maintained beside a separate "how far is it" field is two
    # functions that must agree while being edited apart.
    def certify(walls: Walls&, holes: Holes&, home_x: f64, home_y: f64, width: f64, depth: f64, field: mutable MarbleField&, queue: mutable Queue&):
        can Abort.Panic:
            free_grid(walls, holes, MARBLE_RADIUS, SWEEP_PITCH, width, depth, field)
            sweep(field, home_x, home_y, queue)

    struct MarbleWork:
        opened: mutable darray[i64]
        from_start: mutable darray[i64]
        from_home: mutable darray[i64]
        pits: mutable Holes
        spare: mutable Holes
        picks: mutable darray[i64]
        queue: mutable Queue

    def MarbleWork() -> MarbleWork:
        can Memory.Allocate, Abort.Panic:
            out: mutable MarbleWork = zeroed
            out.opened <- Ints::zeros(MOST_CELLS * 4)
            out.from_start <- Ints::zeros(MOST_CELLS)
            out.from_home <- Ints::zeros(MOST_CELLS)
            out.pits <- Holes()
            out.spare <- Holes()
            out.picks <- Ints::zeros(MOST_CELLS)
            out.queue <- Queue()
            return out

    # One attempt at a tray. False is the reference's `Unbuildable`: a tray that
    # cannot be certified, or one whose route is not worth walking.
    def build(g: MarbleGrade, rung: i64, rng: mutable MT19937&, work: mutable MarbleWork&, tray: mutable MarbleTray&) -> bool:
        can Memory.Allocate, Abort.Panic:
            cols: i64 = g.cols
            rows: i64 = g.rows
            # The tray is built OUTWARDS from the corridor the rung asked for,
            # rather than the corridor being whatever is left after dividing a
            # fixed tray: a denser maze is a bigger board, which is how one would
            # actually be made, and it keeps every physical constant meaning what
            # it says.
            corridor: f64 = 2.0 * MARBLE_RADIUS * g.slack
            cell: f64 = corridor / (1.0 - WALL_SHARE)
            thickness: f64 = cell - corridor
            if corridor <= 2.0 * MARBLE_RADIUS:
                return false
            width: f64 = cols.f64() * cell + 2.0 * BOARD_MARGIN
            depth: f64 = rows.f64() * cell + 2.0 * BOARD_MARGIN
            ox: f64 = (width - cols.f64() * cell) / 2.0
            oy: f64 = (depth - rows.f64() * cell) / 2.0
            carve(cols, rows, rng, &work.opened)
            braid(&work.opened, cols, rows, g.braid, rng)
            wall_strips(work.opened, cols, rows, cell, thickness, ox, oy, &tray.walls)
            # Start in a corner-ish cell, cup as far from it as the DOORWAYS allow
            # -- furthest-by-doorways rather than furthest-by-ruler, because the
            # route is what the player walks.
            Ints::put(&work.picks, 0, 0)
            Ints::put(&work.picks, 1, cols - 1)
            Ints::put(&work.picks, 2, (rows - 1) * cols)
            Ints::put(&work.picks, 3, rows * cols - 1)
            start_cell: i64 = Ints::at(work.picks, py_choice_index(rng, 4))
            cell_distances(work.opened, cols, rows, start_cell, &work.from_start)
            reach: mutable i64 = 0
            scan: mutable i64 = 0
            while scan < cols * rows |scan, cols, rows, work, reach|:
                here: i64 = Ints::at_ref(&work.from_start, scan)
                reach <- here if scan == 0 or here > reach
                scan <- scan + 1
            far_count: mutable i64 = 0
            pick: mutable i64 = 0
            while pick < cols * rows |pick, cols, rows, work, reach, far_count|:
                if Ints::at_ref(&work.from_start, pick) >= reach - 1:
                    Ints::put(&work.picks, far_count, pick)
                    far_count <- far_count + 1
                pick <- pick + 1
            home_cell: i64 = Ints::at(work.picks, py_choice_index(rng, far_count))
            home_x: f64 = ox + ((home_cell % cols).f64() + 0.5) * cell
            home_y: f64 = oy + ((home_cell / cols).f64() + 0.5) * cell
            capped: f64 = corridor * 0.42 if corridor * 0.42 < MARBLE_RADIUS * 2.1 else MARBLE_RADIUS * 2.1
            cup_cap: f64 = corridor * 0.40 if corridor * 0.40 < MARBLE_RADIUS * 2.1 else MARBLE_RADIUS * 2.1
            home_r: f64 = MARBLE_RADIUS * 1.5 if MARBLE_RADIUS * 1.5 > cup_cap else cup_cap
            if not circle_clear_of_walls(tray.walls, home_x, home_y, home_r):
                return false
            # Distance FROM THE CUP, which is what every placement below wants.
            cell_distances(work.opened, cols, rows, home_cell, &work.from_home)
            place_holes(g, work.opened, tray.walls, cols, rows, cell, corridor, width, depth, ox, oy, start_cell, home_cell, work.from_start, work.from_home, rng, &work.pits)
            # How long a route this tray owes the player. Without a bar here the
            # upper rungs deal EASIER trays than the lower ones, and silently: many
            # holes sever a tray into pockets, the certificate still passes because
            # the marble is placed in the pocket the cup is in, and "inhuman" deals
            # a marble twelve centimetres from home.
            owed: f64 = 0.45 * Ints::at_ref(&work.from_start, home_cell).f64() * cell
            fill_holes(&tray.holes, work.pits, home_x, home_y, home_r)
            certify(&tray.walls, &tray.holes, home_x, home_y, width, depth, &tray.field, &work.queue)
            have_starts: mutable bool = false
            route: mutable f64 = 0.0
            relax: mutable i64 = 0
            settled: mutable bool = false
            while relax < 4 and not settled |relax, settled, g, cell, tray, work, rng, owed, home_x, home_y, home_r, width, depth, have_starts, route|:
                # Marbles are placed OUT OF THE CERTIFIED FIELD, not out of the
                # maze's cells: it already knows every legal place a marble may
                # stand and how far each is from home.
                have_starts <- place_marbles(g, &tray.field, cell, &tray.holes, &tray.start_x, &tray.start_y, &tray.start_n)
                route <- 0.0
                if have_starts:
                    spot: mutable i64 = 0
                    while spot < tray.start_n |spot, tray, route|:
                        found: mutable bool = false
                        got: f64 = field_strict(&tray.field, Floats::at_ref(&tray.start_x, spot), Floats::at_ref(&tray.start_y, spot), &found)
                        # `field.strict(x, y) or 0.0` -- an unreachable start and a
                        # start sitting exactly on the cup both read as zero.
                        here: f64 = got if found else 0.0
                        route <- here if spot == 0 or here > route
                        spot <- spot + 1
                if have_starts and route >= owed:
                    settled <- true
                else:
                    if work.pits.count == 0:
                        return false
                    # Give a quarter of the holes back and sweep again, rather than
                    # rerolling the whole maze: the maze is rarely the problem and
                    # rebuilding it throws away a good one to fix a bad scattering.
                    quarter: i64 = work.pits.count / 4
                    drop: i64 = 1 if quarter < 1 else quarter
                    raw_keep: i64 = work.pits.count - drop
                    keep: i64 = 0 if raw_keep < 0 else raw_keep
                    chosen: darray[i64] = py_sample_range(rng, 0, work.pits.count - 1, keep)
                    copy_sampled(&work.spare, work.pits, chosen, keep)
                    copy_holes(&work.pits, work.spare)
                    fill_holes(&tray.holes, work.pits, home_x, home_y, home_r)
                    certify(&tray.walls, &tray.holes, home_x, home_y, width, depth, &tray.field, &work.queue)
                    relax <- relax + 1
            if not settled:
                return false
            tray.built <- true
            tray.rung <- rung
            tray.cols <- cols
            tray.rows <- rows
            tray.width <- width
            tray.depth <- depth
            tray.cell <- cell
            tray.thickness <- thickness
            tray.height <- 0.008 if cell * 0.30 < 0.008 else cell * 0.30
            tray.home_x <- home_x
            tray.home_y <- home_y
            tray.home_r <- home_r
            tray.seconds <- g.seconds
            tray.route <- route
            return true

    def fill_holes(out: mutable Holes&, pits: Holes&, home_x: f64, home_y: f64, home_r: f64):
        can Abort.Panic:
            # `holes = pits + (cup,)` -- the cup last, which is where every
            # `hole.home` test expects to find it.
            index: mutable i64 = 0
            while index < pits.count |index, pits, out|:
                Floats::put(&out.x, index, Floats::at(pits.x, index))
                Floats::put(&out.y, index, Floats::at(pits.y, index))
                Floats::put(&out.radius, index, Floats::at(pits.radius, index))
                Ints::put(&out.home, index, 0)
                index <- index + 1
            Floats::put(&out.x, pits.count, home_x)
            Floats::put(&out.y, pits.count, home_y)
            Floats::put(&out.radius, pits.count, home_r)
            Ints::put(&out.home, pits.count, 1)
            out.count <- pits.count + 1

    def copy_sampled(out: mutable Holes&, pits: Holes&, chosen: darray[i64], count: i64):
        can Abort.Panic:
            index: mutable i64 = 0
            while index < count |index, count, chosen, pits, out|:
                from_slot: i64 = Ints::at(chosen, index)
                Floats::put(&out.x, index, Floats::at(pits.x, from_slot))
                Floats::put(&out.y, index, Floats::at(pits.y, from_slot))
                Floats::put(&out.radius, index, Floats::at(pits.radius, from_slot))
                Ints::put(&out.home, index, 0)
                index <- index + 1
            out.count <- count

    def copy_holes(out: mutable Holes&, source: Holes&):
        can Abort.Panic:
            index: mutable i64 = 0
            while index < source.count |index, source, out|:
                Floats::put(&out.x, index, Floats::at(source.x, index))
                Floats::put(&out.y, index, Floats::at(source.y, index))
                Floats::put(&out.radius, index, Floats::at(source.radius, index))
                Ints::put(&out.home, index, Ints::at(source.home, index))
                index <- index + 1
            out.count <- source.count

    # Build one certified tray. Certified means a Dijkstra sweep found the cup from
    # every marble's starting point over the free space, with the holes already
    # bitten out. A tray that fails is DISCARDED and another rolled rather than
    # repaired: repairing means removing the hole that sealed it, and the hole that
    # sealed it is usually the interesting one.
    #
    # `tray.built` is false when all `attempts` failed. The reference then falls
    # back down the ladder with a FRESH SYSTEM SEED, which is not reproducible and
    # so is not modelled -- a sweep that ever reaches it would be testing the
    # operating system's entropy rather than this port.
    def deal(rung_in: i64, seed: i64, attempts: i64, work: mutable MarbleWork&, tray: mutable MarbleTray&):
        can Memory.Allocate, Abort.Panic:
            rung: i64 = clamped_rung(rung_in)
            g: MarbleGrade = grade_of(rung)
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            tray.built <- false
            attempt: mutable i64 = 0
            while attempt < attempts and not tray.built |attempt, attempts, g, rung, rng, work, tray|:
                _ = build(g, rung, &rng, work, tray)
                attempt <- attempt + 1
