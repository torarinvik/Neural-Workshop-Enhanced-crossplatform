include "./shadow_play.elisa"
include "./drshape_audio.elisa"

module ShadowPlayGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = ShadowPlay::PORTS
    const UPDATE: i64 = -1
    const SUBSTEP: f64 = 1.0 / 120.0
    const FEEDBACK: f64 = 2.5
    const DRAG: f64 = 0.012

    struct Session:
        rng: mutable MT19937
        start_rung: i64
        total: i64
        adaptive: bool
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        owner: mutable Arena
        run: mutable ShadowPlay::Run
        voices: DrShapeAudio::Bank
        heard_to: mutable f64
        last_tick: mutable f64
        deadline: mutable f64
        control: mutable i64
        passed: mutable i64
        best: mutable i64
        verdict_published: mutable bool

    def voices() -> DrShapeAudio::Bank:
        can Abort.Panic:
            rng: mutable MT19937 = zeroed
            mt_seed_int(&rng, 1.u64())
            bank: mutable DrShapeAudio::Bank = zeroed
            bank.count <- 2
            bank.patches[0] <- DrShapeAudio::make_patch(DrShapeAudio::SINE, &rng, 0.0)
            mt_seed_int(&rng, 2.u64())
            bank.patches[1] <- DrShapeAudio::make_patch(DrShapeAudio::BELL, &rng, 0.0)
            return bank

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = zeroed
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            initial: i64 = rung if rung >= 1 else 1
            return Session{rng: rng, start_rung: initial, total: total, adaptive: adaptive,
                rung: initial, trial: 0, phase: READY, owner: zeroed, run: zeroed, voices: voices(),
                heard_to: 0.0, last_tick: 0.0, deadline: 0.0, control: 0, passed: 0, best: 0, verdict_published: false}

    def release(session: mutable Session&):
        can Abort.Panic, Memory.Release:
            arena_free(&session.owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}
            session.run <- zeroed

    def next_trial(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            release(session) can Global{Read,Write}
            session.last_tick <- now
            session.heard_to <- 0.0
            session.control <- 0
            session.verdict_published <- false
            if session.trial >= session.total:
                session.phase <- DONE
                return true
            seed: i64 = py_randbelow(&session.rng, 1073741824.u64()).i64()
            setup: ShadowPlay::Setup = ShadowPlay::deal(session.rung, seed)
            if setup.rod.count == 0:
                session.phase <- DONE
                return false
            session.run <- ShadowPlay::initialize(&setup, true)
            session.trial <- session.trial + 1
            session.phase <- PLAYING
            return true

    def valid_time(session: Session&, now: f64) -> bool:
        return now >= session.last_tick and now <= 9007199254740.0

    def start(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if session.phase != READY and session.phase != DONE
            return false if session.total <= 0 or not valid_time(session, now)
            session.rung <- session.start_rung
            session.trial <- 0
            session.passed <- 0
            session.best <- 0
            return next_trial(session, now) can Global{Read,Write}

    def close(session: mutable Session&):
        can Abort.Panic, Memory.Release:
            release(session) can Global{Read,Write}
            session.phase <- READY

    def drag(session: mutable Session&, dx: f64, dy: f64, rolling: bool) -> bool:
        return false if session.phase != PLAYING or not (dx >= -10000.0 and dx <= 10000.0 and dy >= -10000.0 and dy <= 10000.0)
        if rolling:
            ShadowPlay::rotate(&session.run, 2, -dx * DRAG)
        else:
            ShadowPlay::rotate(&session.run, 1, dx * DRAG)
            ShadowPlay::rotate(&session.run, 0, -dy * DRAG)
        return true

    def step_owned(owner: mutable Arena&, run: mutable ShadowPlay::Run&, dt: f64, steps: i64, controls: i64):
        can Abort.Panic, Memory.Allocate:
            in owner:
                for i in 0..<steps |run, dt, steps, controls|:
                    ShadowPlay::step(run, dt / steps.f64(), controls)
                    break if run.result != ShadowPlay::PENDING

    def tick(session: mutable Session&, now: f64, held: i64):
        can Abort.Panic, Memory.Allocate:
            dt: f64 = DrShapeDeal::clamp(now - session.last_tick, 0.0, 0.1)
            session.last_tick <- now
            controls: i64 = session.control if session.control != 0 else held
            session.control <- 0
            whole: i64 = ceil(dt / SUBSTEP).i64()
            step_owned(&session.owner, &session.run, dt, whole if whole > 0 else 1, controls)
            return if session.run.result == ShadowPlay::PENDING
            if session.run.result == ShadowPlay::WON:
                session.passed <- session.passed + 1
                session.best <- session.rung if session.rung > session.best
                session.rung <- session.rung + 1 if session.adaptive and session.rung < 9223372036854775807
            else:
                session.rung <- session.rung - 1 if session.adaptive and session.rung > 1
            session.phase <- JUDGED
            session.deadline <- now + FEEDBACK

    def advance(session: mutable Session&, now: f64, held: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if not valid_time(session, now)
            if session.phase == PLAYING:
                tick(session, now, held)
                return true
            if session.phase == JUDGED and now >= session.deadline:
                return next_trial(session, now) can Global{Read,Write}
            return false

    def agent_event(session: mutable Session&, now: f64, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if not valid_time(session, now)
            return (start(session, now) can Global{Read,Write}) if port == START
            if port >= 0 and port < ShadowPlay::PORTS and session.phase == PLAYING:
                session.control <- 1 << port
                return true
            return false if port != UPDATE
            if session.phase == PLAYING:
                tick(session, now, 0)
                session.verdict_published <- session.phase == JUDGED
                return true
            if session.phase == JUDGED:
                return (next_trial(session, now) can Global{Read,Write}) if session.verdict_published
                session.verdict_published <- true
                return true
            return false

    def audio_window(session: mutable Session&, dest: mutable u8&, capacity: i64) -> i64:
        can Abort.Panic, Memory.Allocate:
            return 0 if session.phase != PLAYING and session.phase != JUDGED
            return 0 if session.run.notes.count == 0.usize()
            requested: i64 = capacity / TonePcm::FRAME_BYTES
            available: i64 = requested if requested < 8192 else 8192
            elapsed: f64 = session.run.t - session.heard_to
            return 0 if elapsed <= 0.0 or available < 1
            frames: i64 = py_round_half_even(elapsed * TonePcm::RATE.f64())
            return 0 if frames < 1
            end: f64 = session.run.t if frames <= available else session.heard_to + available.f64() / TonePcm::RATE.f64()
            count: mutable i64 = 0
            region mix_work(262144):
                in mix_work:
                    count <- DrShapeAudio::write(&session.run.notes, &session.voices, session.heard_to, end, dest, capacity)
            session.heard_to <- end if count > 0
            return count

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 10 or total == 20

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            active: bool = session.phase == PLAYING or session.phase == JUDGED
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return py_round_half_even(session.run.t * 1000.0) if field == 4 and active
            return py_round_half_even(ShadowPlay::closeness(&session.run) * 1000.0) if field == 5 and active
            return session.run.setup.level.axes if field == 6 and active
            return session.run.result if field == 7 and session.phase == JUDGED
            return session.passed if field == 8
            return session.best if field == 9
            return py_round_half_even(session.deadline * 1000.0) if field == 10 and session.phase == JUDGED
            return py_round_half_even(session.run.fit_since * 1000.0) if field == 11 and active and session.run.fit_since >= 0.0
            return 1 if field == 12 and active and session.run.setup.level.floor
            return 0 if field == 12 and active
            return -1
