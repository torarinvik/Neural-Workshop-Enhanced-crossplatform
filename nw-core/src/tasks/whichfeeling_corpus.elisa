include "./whichfeeling.elisa"

extend WhichFeeling:
    def label_index(name: sview) -> i64:
        can Abort.Panic:
            for label in 0..<LABELS |name|:
                return label if sview_eq(name, sview(label_name(label), 0, -1))
            return -1

    def text_of(text: sview) -> dstr:
        can Abort.Panic, Memory.Allocate:
            result: mutable dstr = []
            dstr_append_sview(&result, text)
            return result

    def put(corpus: mutable Corpus&, label: i64, text: cstr):
        can Abort.Panic, Memory.Allocate:
            words: mutable dstr = []
            dstr_append_cstr(&words, text)
            corpus.by_label[label.usize()].push(Comment{text: words, label: label})

    # emotiondata.SEED_COMMENTS, for when no comment file is there.
    def seed_comments() -> Corpus:
        can Abort.Panic, Memory.Allocate:
            corpus: mutable Corpus = zeroed
            put(&corpus, 6, "Thank you so much, this saved my whole afternoon.")
            put(&corpus, 13, "I cannot believe they cancelled the show again. Ridiculous.")
            put(&corpus, 23, "Wait, so the butler was the father all along?")
            put(&corpus, 1, "That is the funniest thing I have read all week.")
            put(&corpus, 22, "I am so sorry for your loss. Thinking of you.")
            put(&corpus, 20, "My hands are shaking, the interview is in an hour.")
            put(&corpus, 0, "You did an amazing job on that build, seriously.")
            put(&corpus, 4, "I really wish I had one of those.")
            put(&corpus, 25, "Oh, now I get why the code kept failing.")
            put(&corpus, 11, "Phew, the test came back negative.")
            put(&corpus, 21, "I should never have said that to her.")
            put(&corpus, 16, "That is disgusting, who eats that?")
            put(&corpus, 24, "How did they even get the piano up there?")
            put(&corpus, 9, "Things will get better next season, I am sure of it.")
            put(&corpus, 10, "I finished my first marathon today!")
            put(&corpus, 12, "This is a scam and they knew it. Furious.")
            put(&corpus, 8, "I love you guys, best community ever.")
            put(&corpus, 17, "That was so embarrassing, I tripped on stage.")
            put(&corpus, 5, "We won the cup!!! I am losing my mind!")
            put(&corpus, 18, "Honestly that would scare me to death.")
            put(&corpus, 14, "I was hoping for more from the sequel.")
            put(&corpus, 15, "I do not think that is fair to the players at all.")
            put(&corpus, 2, "Yes, exactly, that is how it should be done.")
            put(&corpus, 3, "Take care of yourself and drink some water.")
            put(&corpus, 7, "So happy for you both!")
            put(&corpus, 26, "Wow, I did not see that ending coming.")
            put(&corpus, 19, "My dog died this morning. He was fourteen.")
            put(&corpus, 27, "The store opens at nine on weekdays.")
            return corpus

    # emotiondata.comments(): goemotions.tsv, a label, a tab and the text
    # on each line (lines read as Python reads text: "\r\n" and "\r" end
    # them too); lines without a tab are skipped, and labels the task does
    # not ask about are kept out. An empty file gives the seed comments.
    def from_comment_cache(owner: mutable Arena&, text: sview) -> Corpus:
        can Memory.Allocate, Abort.Panic:
            corpus: mutable Corpus = zeroed
            any: mutable bool = false
            size: i64 = sview_len(text).i64()
            start: mutable i64 = 0
            i: mutable i64 = 0
            in owner:
                while i <= size |corpus, any, size, start, i, text|:
                    code: u8 = 10.u8() if i == size else sview_at(text, i.usize())
                    if code == 10.u8() or code == 13.u8():
                        tab: mutable i64 = -1
                        for j in start..<i |tab, text|:
                            tab <- j if tab < 0 and sview_at(text, j.usize()) == 9.u8()
                        if tab >= 0:
                            any <- true
                            label: i64 = label_index(string_view_slice(text, start, tab))
                            if label >= 0:
                                corpus.by_label[label.usize()].push(Comment{text: text_of(string_view_slice(text, tab + 1, i)), label: label})
                        if code == 13.u8() and i + 1 < size and sview_at(text, (i + 1).usize()) == 10.u8():
                            i <- i + 1
                        start <- i + 1
                    i <- i + 1
                return corpus if any
                return seed_comments()
