include "../pyrandom.elisa"

module StopSwitch:
    const SHAPE: i64 = 0
    const COLOUR: i64 = 1
    const OPPOSITE: i64 = 2
    const GAP: f64 = 0.6

    struct Grade:
        rung: i64
        count: i64
        window: f64
        stops: f64
        stop_delay: f64
        rules: i64
        prepared: bool
        incongruent: f64
        needed: f64

    struct Stimulus:
        shape: i64
        colour: i64
        side: i64
        rule: i64
        stop: bool

    struct Block:
        level: mutable Grade
        stimuli: mutable Stimulus[20]

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        window: mutable f64 = 0.9
        delay: mutable f64 = 0.2
        if r < 4:
            window <- 1.5 - 0.2 * (r - 1).f64()
            delay <- 0.0
        elif r < 7:
            window <- 1.0
            delay <- 0.1 + 0.05 * (r - 4).f64()
        elif r < 20:
            if r >= 16:
                window <- 0.8 - 0.03 * (r - 16).f64()
                delay <- 0.25
        else:
            window <- 0.45 if r >= 30 else 0.68 - 0.025 * (r - 20).f64()
            delay <- 0.35 if r >= 30 else 0.25 + 0.01 * (r - 20).f64()
        return Grade{rung: r, count: 12 if r < 4 else (16 if r < 10 else 20),
            window: window, stops: 0.0 if r < 4 else (0.25 if r < 20 else 0.3),
            stop_delay: delay, rules: 1 if r < 10 else (2 if r < 20 else 3),
            prepared: r < 16, incongruent: 0.7 if r >= 16 else 0.5,
            needed: 0.85 if r < 20 else 0.9}

    def other_rule(rng: mutable MT19937&, rules: i64, current: i64) -> i64:
        can Abort.Panic:
            next: i64 = py_randbelow(rng, (rules - 1).u64()).i64()
            return next + 1 if next >= current else next

    def deal(rung: i64, seed: i64, block: mutable Block&):
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            level: Grade = grade(rung)
            block.level <- level
            rule: mutable i64 = py_randbelow(&rng, level.rules.u64()).i64()
            left: mutable i64 = py_randint(&rng, 4, 6)
            for k in 0..<level.count |level, block, rng, rule, left|:
                if k > 0:
                    if level.rung >= 10 and level.rung < 13:
                        left <- left - 1
                        if left == 0:
                            rule <- other_rule(&rng, level.rules, rule)
                            left <- py_randint(&rng, 4, 6)
                    elif level.rung >= 13 and py_random(&rng) < 0.3:
                        rule <- other_rule(&rng, level.rules, rule)
                side: i64 = py_randbelow(&rng, 2.u64()).i64() * 2 - 1 if level.rung >= 7 else 0
                shape: i64 = py_randbelow(&rng, 2.u64()).i64()
                colour: i64 = shape if py_random(&rng) >= level.incongruent else 1 - shape
                stop: bool = k > 0 and py_random(&rng) < level.stops
                block.stimuli[k.usize()] <- Stimulus{shape: shape, colour: colour, side: side, rule: rule, stop: stop}

    def answer(stimulus: Stimulus) -> i64:
        return stimulus.shape if stimulus.rule == SHAPE
        return stimulus.colour if stimulus.rule == COLOUR
        return 1 if stimulus.side < 0 else 0

    def correct(stimulus: Stimulus, key: i64, reaction: f64, level: Grade&) -> bool:
        return key == -1 if stimulus.stop
        return key == answer(stimulus) and reaction <= level.window
