include "./sonar_reference.elisa"

module SonarGame:
    const READY: i64 = 0
    const SEARCHING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const FLAGGED: i64 = 4
    const PING: i64 = 4
    const DIG: i64 = 5
    const START: i64 = 6
    const FEEDBACK_MS: i64 = 1800

    struct Session:
        rng: mutable MT19937
        start_rung: i64
        total: i64
        adaptive: bool
        phase: mutable i64
        rung: mutable i64
        trial: mutable i64
        cursor: mutable i64
        board: mutable Sonar::Round
        par: mutable f64
        passed: mutable bool
        wins: mutable i64
        best_rung: mutable i64
        total_cost: mutable f64
        started_ms: mutable i64
        elapsed_ms: mutable i64
        deadline_ms: mutable i64
        scored: mutable i64
        forfeits: mutable i64
        agent_seconds: mutable f64
        think_capacity: mutable f64
        think_refill: mutable f64
        think_left: mutable f64
        agent_mode: mutable bool
        verdict_published: mutable bool
        has_verdict: mutable bool

    def allowed_rung(rung: i64) -> bool:
        return (rung >= 1 and rung <= 6) or rung == 8 or rung == 10 or rung == 12 or rung == 15 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 8 or total == 12 or total == 20

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = zeroed
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            initial: i64 = rung if rung > 0 else 1
            return Session{rng: rng, start_rung: initial, total: total, adaptive: adaptive,
                phase: READY, rung: initial, trial: 0, cursor: 0, board: zeroed, par: 0.0,
                passed: false, wins: 0, best_rung: 0, total_cost: 0.0, started_ms: 0,
                elapsed_ms: 0, deadline_ms: 0, scored: 0, forfeits: 0, agent_seconds: 0.0,
                think_capacity: 0.0, think_refill: 0.0, think_left: 0.0,
                agent_mode: false, verdict_published: false, has_verdict: false}

    def next_trial(session: mutable Session&, now_ms: i64):
        can Abort.Panic:
            if session.trial >= session.total:
                session.phase <- DONE
                return
            dealt: Sonar::Deal = Sonar::deal(session.rung, &session.rng)
            session.board <- Sonar::initialize(dealt)
            session.par <- SonarReference::par(&dealt)
            side: i64 = dealt.level.side
            session.cursor <- (side / 2) * side + side / 2
            session.trial <- session.trial + 1
            session.started_ms <- now_ms
            session.elapsed_ms <- 0
            session.deadline_ms <- 0
            session.passed <- false
            session.has_verdict <- false
            session.verdict_published <- false
            session.phase <- SEARCHING

    def start(session: mutable Session&, now_ms: i64) -> bool:
        can Abort.Panic:
            return false if session.total <= 0 or (session.phase != READY and session.phase != DONE)
            session.rung <- session.start_rung
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            session.total_cost <- 0.0
            session.scored <- 0
            session.forfeits <- 0
            session.think_left <- session.think_capacity
            next_trial(session, now_ms)
            return true

    def judge(session: mutable Session&, now_ms: i64):
        passed: bool = session.board.found and session.board.cost.f64() <= session.par + 1e-9
        session.passed <- passed
        session.has_verdict <- true
        session.scored <- session.scored + 1
        session.total_cost <- session.total_cost + session.board.cost.f64()
        session.elapsed_ms <- now_ms - session.started_ms
        session.deadline_ms <- now_ms + FEEDBACK_MS
        if passed:
            session.wins <- session.wins + 1
            session.best_rung <- session.rung if session.rung > session.best_rung
        if session.adaptive:
            session.rung <- session.rung + 1 if passed and session.rung < 9223372036854775807
            session.rung <- session.rung - 1 if not passed and session.rung > 1
        session.phase <- JUDGED

    def move_cursor(session: mutable Session&, port: i64):
        can Abort.Panic:
            side: i64 = session.board.dealt.level.side
            cursor: i64 = session.cursor
            x: i64 = cursor % side
            y: i64 = cursor / side
            session.cursor <- cursor - side if port == 0 and y > 0
            session.cursor <- cursor + side if port == 1 and y + 1 < side
            session.cursor <- cursor - 1 if port == 2 and x > 0
            session.cursor <- cursor + 1 if port == 3 and x + 1 < side

    def input(session: mutable Session&, port: i64, cell: i64, now_ms: i64) -> bool:
        can Abort.Panic:
            return false if now_ms < session.started_ms or now_ms > 9007199254740991
            return start(session, now_ms) if port == START
            return false if session.phase != SEARCHING or port < 0 or port > DIG
            if port < PING:
                move_cursor(session, port)
                return true
            target: i64 = session.cursor if cell == -1 else cell
            return false if not Sonar::can_probe(&session.board, target)
            session.cursor <- target
            if port == PING:
                _ = Sonar::ping(&session.board, target)
            else:
                _ = Sonar::dig(&session.board, target)
            if session.board.over:
                judge(session, now_ms)
            return true

    def advance(session: mutable Session&, now_ms: i64, stepped: bool = false) -> bool:
        can Abort.Panic:
            return false if now_ms < session.started_ms or now_ms > 9007199254740991
            return false if session.phase != JUDGED or (not stepped and now_ms < session.deadline_ms)
            next_trial(session, now_ms)
            return true

    def mean_cost(session: Session&) -> f64:
        return session.total_cost / session.scored.f64() if session.scored > 0 else 0.0

    def configure_think(session: mutable Session&, capacity: f64, refill: f64) -> bool:
        return false if session.phase != READY or not (capacity >= 0.0 and capacity <= 1.7976931348623157e308)
        return false if not (refill >= 0.0 and refill <= 1.7976931348623157e308)
        session.agent_mode <- true
        session.think_capacity <- capacity
        session.think_refill <- refill if refill < capacity else capacity
        session.think_left <- capacity
        return true

    def agent_action(session: mutable Session&, port: i64) -> bool:
        can Abort.Panic:
            return false if not session.agent_mode
            return input(session, port, -1, (session.agent_seconds * 1000.0).i64())

    def step(session: mutable Session&, elapsed_seconds: f64) -> bool:
        can Abort.Panic:
            next: f64 = session.agent_seconds + elapsed_seconds
            return false if not session.agent_mode or not (elapsed_seconds > 0.0 and next <= 9007199254740.0)
            return false if session.phase == READY or session.phase == DONE
            session.agent_seconds <- next
            if session.phase == SEARCHING:
                if session.think_capacity > 0.0:
                    session.think_left <- session.think_left - elapsed_seconds
                    if session.think_left <= 0.000000001:
                        session.think_left <- 0.0
                        session.forfeits <- session.forfeits + 1
                        session.phase <- FLAGGED
                return true
            if session.phase == JUDGED and not session.verdict_published:
                session.verdict_published <- true
                return true
            next_trial(session, (next * 1000.0).i64())
            if session.phase == SEARCHING:
                room: f64 = session.think_capacity - session.think_left
                session.think_left <- session.think_left + (session.think_refill if session.think_refill < room else room)
            return true

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return session.board.dealt.level.side if field == 4
            return session.cursor if field == 5
            return session.board.actions if field == 6
            return session.board.cost if field == 7
            return (session.par * 2.0).i64() if field == 8
            return session.wins if field == 9
            return session.best_rung if field == 10
            return (1 if session.passed else 0) if field == 11 and session.has_verdict
            return session.deadline_ms if field == 12 and session.phase == JUDGED
            return session.elapsed_ms if field == 13 and session.has_verdict
            return session.forfeits if field == 14
            return -1
