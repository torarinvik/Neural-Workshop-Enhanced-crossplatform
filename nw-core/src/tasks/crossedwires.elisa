# Crossed Wires: keys that do not do what they say.
#
# Port of neural_workshop/crossedwires.py (GPL-2.0-or-later). A marker on a
# wrapped grid, a row of keys, and a wiring between them that is never drawn
# and never hinted at. The player has to identify the wiring by pressing keys
# and watching what moves, while spending a budget that only allows a few
# presses beyond what someone who already knew it would spend.
#
# ## Two things a port can quietly get wrong
#
# `dead` is drawn ONLY when the rung kills a key: `rng.randrange(keys) if
# grade.dies else -1`. Drawing it unconditionally and discarding it on rungs
# without a dead key would consume one value too many and change every wiring
# from rung 1 to rung 8, which all have dies == 0.
#
# The CROSSED family retries: shuffle, and keep it only if some key moved. Each
# rejected shuffle has consumed a full Fisher-Yates pass, so the retry has to be
# a retry and not a filter applied after the fact.
#
# ## Random-stream fidelity
#
#   deal   randrange(across), randrange(down)      the start
#          per target, RETRYING until far enough:
#              randrange(across), randrange(down)
#          wirings(family)                          see below
#          randrange(1, keys)                       the drift turn
#          randrange(keys)                          the dead key, ONLY if dies
#
#   wirings  steady    nothing
#            turned    randrange(1, keys)
#            mirrored  randrange(keys)
#            crossed   shuffle(range(keys)), retried until not the identity

module CrossedWires:
    const DEAD: i64 = -1
    const STEADY: i64 = 0
    const TURNED: i64 = 1
    const MIRRORED: i64 = 2
    const CROSSED: i64 = 3
    const GRADE_COUNT: i64 = 12

    # The eight ways, clockwise from north, on a grid whose y grows upwards. Rungs
    # with four keys use every OTHER one, so the four are the square directions
    # rather than a lopsided half of the ring.
    def way_dx(index: i64) -> i64:
        return 0 if index == 0 else (1 if index == 1 else (1 if index == 2 else (1 if index == 3 else (0 if index == 4 else (-1 if index == 5 else (-1 if index == 6 else -1))))))

    def way_dy(index: i64) -> i64:
        return 1 if index == 0 else (1 if index == 1 else (0 if index == 2 else (-1 if index == 3 else (-1 if index == 4 else (-1 if index == 5 else (0 if index == 6 else 1))))))

    # WAYS for a rung: every way with eight keys, every other one with four.
    def way_for(keys: i64, wired: i64) -> i64:
        return wired if keys == 8 else wired * 2

    struct CrossedWiresGrade:
        keys: mutable i64
        family: mutable i64
        across: mutable i64
        down: mutable i64
        targets: mutable i64
        spare: mutable i64
        drift: mutable i64
        dies: mutable i64

    def grade_at(level_number: i64) -> CrossedWiresGrade:
        can Abort.Panic:
            index: mutable i64 = level_number - 1
            index <- 0 if index < 0 else index
            index <- GRADE_COUNT - 1 if index > GRADE_COUNT - 1 else index
            g: mutable CrossedWiresGrade = zeroed
            g.drift <- 0
            g.dies <- 0
            if index == 0:
                g.keys <- 4
                g.family <- STEADY
                g.across <- 11
                g.down <- 11
                g.targets <- 3
                g.spare <- 12
            elif index == 1:
                g.keys <- 4
                g.family <- TURNED
                g.across <- 11
                g.down <- 11
                g.targets <- 3
                g.spare <- 8
            elif index == 2:
                g.keys <- 4
                g.family <- MIRRORED
                g.across <- 11
                g.down <- 11
                g.targets <- 4
                g.spare <- 5
            elif index == 3:
                g.keys <- 4
                g.family <- CROSSED
                g.across <- 13
                g.down <- 13
                g.targets <- 4
                g.spare <- 3
            elif index == 4:
                g.keys <- 4
                g.family <- CROSSED
                g.across <- 13
                g.down <- 13
                g.targets <- 5
                g.spare <- 2
            elif index == 5:
                g.keys <- 8
                g.family <- TURNED
                g.across <- 13
                g.down <- 13
                g.targets <- 5
                g.spare <- 6
            elif index == 6:
                g.keys <- 8
                g.family <- CROSSED
                g.across <- 13
                g.down <- 13
                g.targets <- 5
                g.spare <- 5
            elif index == 7:
                g.keys <- 8
                g.family <- CROSSED
                g.across <- 15
                g.down <- 15
                g.targets <- 6
                g.spare <- 4
            elif index == 8:
                g.keys <- 8
                g.family <- CROSSED
                g.across <- 15
                g.down <- 15
                g.targets <- 6
                g.spare <- 6
                g.drift <- 25
            elif index == 9:
                g.keys <- 8
                g.family <- CROSSED
                g.across <- 15
                g.down <- 15
                g.targets <- 6
                g.spare <- 6
                g.drift <- 15
            elif index == 10:
                g.keys <- 8
                g.family <- CROSSED
                g.across <- 17
                g.down <- 17
                g.targets <- 7
                g.spare <- 5
                g.drift <- 9
                g.dies <- 25
            else:
                g.keys <- 8
                g.family <- CROSSED
                g.across <- 17
                g.down <- 17
                g.targets <- 8
                g.spare <- 6
                g.drift <- 6
                g.dies <- 20
            return g

    # Roughly how much a rung asks, for putting rungs in order. Two axes and one
    # dial, ranked rather than added: more keys outranks everything, then how often
    # the ring turns as turns-per-hundred-presses (so "never" sorts BELOW "rarely"
    # rather than above it), then the trip length and how little is spare.
    def pressure(g: CrossedWiresGrade&, field: i64) -> i64:
        return g.keys if field == 0 else ((100 / g.drift if g.drift != 0 else 0) if field == 1 else (g.targets if field == 2 else 0 - g.spare))

    # Presses from here to there for a player who knew the wiring. Wrapped both
    # ways, so the shorter way round always counts. With eight keys a diagonal
    # covers both axes at once and the cost is the LARGER of the two; with four it
    # is their sum.
    def gap(hx: i64, hy: i64, tx: i64, ty: i64, across: i64, down: i64, keys: i64) -> i64:
        can Abort.Panic:
            side_a: i64 = ((hx - tx) % across + across) % across
            side_b: i64 = ((tx - hx) % across + across) % across
            rise_a: i64 = ((hy - ty) % down + down) % down
            rise_b: i64 = ((ty - hy) % down + down) % down
            side: i64 = side_a if side_a < side_b else side_b
            rise: i64 = rise_a if rise_a < rise_b else rise_b
            if keys == 8:
                return side if side > rise else rise
            return side + rise

    # A wiring with every key's direction moved `by` round the ring. A dead key
    # stays dead.
    def turned(wiring: mutable darray[i64]&, by: i64, keys: i64, out: mutable darray[i64]&):
        can Abort.Panic:
            index: mutable i64 = 0
            while index < keys |index, keys, wiring, out, by|:
                way: i64 = get wiring[index.usize()] else 0
                if way == DEAD:
                    Ints::put(out, index, DEAD)
                else:
                    Ints::put(out, index, ((way + by) % keys + keys) % keys)
                index <- index + 1

    # A wiring drawn from `family`. The families are NESTED -- every turn is a
    # permutation and so is every mirror -- so this draws from the family named
    # rather than from everything at or below it, which is what makes a rung's name
    # mean something.
    def wirings(rng: mutable MT19937&, family: i64, keys: i64, out: mutable darray[i64]&):
        can Memory.Allocate, Abort.Panic:
            if family == STEADY:
                key: mutable i64 = 0
                while key < keys |key, keys, out|:
                    Ints::put(out, key, key)
                    key <- key + 1
                return
            if family == TURNED:
                about: i64 = py_randrange(rng, 1, keys)
                key: mutable i64 = 0
                while key < keys |key, keys, out, about|:
                    Ints::put(out, key, (key + about) % keys)
                    key <- key + 1
                return
            if family == MIRRORED:
                about: i64 = py_randbelow(rng, keys.u64()).i64()
                key: mutable i64 = 0
                while key < keys |key, keys, out, about|:
                    Ints::put(out, key, ((about - key) % keys + keys) % keys)
                    key <- key + 1
                return
            # CROSSED: shuffle, and keep it only if some key moved. A rejected
            # shuffle has already consumed a full Fisher-Yates pass, so this must
            # retry rather than filter after the fact.
            settled: mutable bool = false
            while not settled |settled, keys, out, rng|:
                key: mutable i64 = 0
                while key < keys |key, keys, out|:
                    Ints::put(out, key, key)
                    key <- key + 1
                py_shuffle_i64_prefix(rng, out, keys)
                moved: mutable bool = false
                check: mutable i64 = 0
                while check < keys |check, keys, out, moved|:
                    moved <- true if (get out[check.usize()] else 0) != check
                    check <- check + 1
                settled <- moved

    # Presses added back for a rung that kills a key partway through. `shortest` is
    # worked out with every direction available, so on such a rung it UNDERSTATES
    # the trip -- the shortest way somewhere with seven of eight directions is
    # sometimes longer than with all eight. Without this even a player who knew the
    # wiring would miss the odd target, and a rung the ceiling cannot clear is a
    # broken rung rather than a hard one.
    def limp(g: CrossedWiresGrade&) -> i64:
        return g.keys / 2 if g.dies != 0 else 0

    struct Bout:
        start_x: mutable i64
        start_y: mutable i64
        goals_x: mutable darray[i64]
        goals_y: mutable darray[i64]
        goal_n: mutable i64
        wiring: mutable darray[i64]
        turn: mutable i64
        dead: mutable i64
        budget: mutable i64
        shortest: mutable i64

    # A round at `level_number`. Nothing here needs searching for: the wiring is
    # drawn from the rung's family, the targets are drawn far enough apart to be
    # worth walking to, and the budget follows from the distance between them -- so
    # a deal is one draw and never a hunt.
    def deal(level_number: i64, seed: i64) -> Bout:
        can Memory.Allocate, Abort.Panic:
            g: CrossedWiresGrade = grade_at(level_number)
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())

            bout: mutable Bout = zeroed
            bout.goals_x <- Ints::zeros(g.targets + 1)
            bout.goals_y <- Ints::zeros(g.targets + 1)
            bout.wiring <- Ints::zeros(g.keys + 1)
            bout.goal_n <- g.targets

            bout.start_x <- py_randbelow(&rng, g.across.u64()).i64()
            bout.start_y <- py_randbelow(&rng, g.down.u64()).i64()

            least: mutable i64 = (g.across if g.across < g.down else g.down) / 3
            least <- 2 if least < 2 else least

            here_x: mutable i64 = bout.start_x
            here_y: mutable i64 = bout.start_y
            target: mutable i64 = 0
            while target < g.targets |target, g, rng, bout, here_x, here_y, least|:
                spot_x: mutable i64 = 0
                spot_y: mutable i64 = 0
                far: mutable bool = false
                while not far |far, g, rng, spot_x, spot_y, here_x, here_y, least|:
                    spot_x <- py_randbelow(&rng, g.across.u64()).i64()
                    spot_y <- py_randbelow(&rng, g.down.u64()).i64()
                    far <- gap(here_x, here_y, spot_x, spot_y, g.across, g.down, g.keys) >= least
                Ints::put(&bout.goals_x, target, spot_x)
                Ints::put(&bout.goals_y, target, spot_y)
                here_x <- spot_x
                here_y <- spot_y
                target <- target + 1

            shortest: mutable i64 = 0
            here_x <- bout.start_x
            here_y <- bout.start_y
            walk: mutable i64 = 0
            while walk < g.targets |walk, g, bout, here_x, here_y, shortest|:
                next_x: i64 = Ints::at(bout.goals_x, walk)
                next_y: i64 = Ints::at(bout.goals_y, walk)
                shortest <- shortest + gap(here_x, here_y, next_x, next_y, g.across, g.down, g.keys)
                here_x <- next_x
                here_y <- next_y
                walk <- walk + 1
            bout.shortest <- shortest

            wirings(&rng, g.family, g.keys, &bout.wiring)
            bout.turn <- py_randrange(&rng, 1, g.keys)
            # ONLY drawn when the rung kills a key. Drawing unconditionally would
            # consume one value too many on every rung with dies == 0.
            bout.dead <- py_randbelow(&rng, g.keys.u64()).i64() if g.dies != 0 else -1
            bout.budget <- shortest + g.spare + limp(&g)
            return bout

    # ------------------------------------------------------------
    # Playing
    # ------------------------------------------------------------

    struct CrossedWiresBench:
        at_x: mutable i64
        at_y: mutable i64
        goal_at: mutable i64
        presses: mutable i64
        reached: mutable i64
        wasted: mutable i64

    def CrossedWiresBench(bout: Bout&) -> CrossedWiresBench:
        can Abort.Panic:
            bench: mutable CrossedWiresBench = zeroed
            bench.at_x <- bout.start_x
            bench.at_y <- bout.start_y
            return bench

    def goal_index(bench: CrossedWiresBench&, bout: Bout&) -> i64:
        return bench.goal_at if bench.goal_at < bout.goal_n - 1 else bout.goal_n - 1

    def bench_gap(bench: CrossedWiresBench&, bout: Bout&, g: CrossedWiresGrade&) -> i64:
        can Abort.Panic:
            which: i64 = goal_index(bench, bout)
            return gap(bench.at_x, bench.at_y, Ints::at(bout.goals_x, which), Ints::at(bout.goals_y, which), g.across, g.down, g.keys)

    def over(bench: CrossedWiresBench&, bout: Bout&) -> bool:
        return bout.budget - bench.presses <= 0 or bench.reached >= bout.goal_n

    # The wiring as it stands, drift and dead key and all. Recomputed from the
    # press count rather than mutated, so a round is a pure function of its bout
    # and the keys pressed -- which is what lets a replay be exact.
    def wiring_now(bench: CrossedWiresBench&, bout: mutable Bout&, g: CrossedWiresGrade&, out: mutable darray[i64]&):
        can Abort.Panic:
            key: mutable i64 = 0
            while key < g.keys |key, g, bout, out|:
                Ints::put(out, key, Ints::at(bout.wiring, key))
                key <- key + 1
            if g.drift != 0:
                turned(out, bout.turn * (bench.presses / g.drift), g.keys, out)
            if g.dies != 0 and bench.presses >= g.dies and bout.dead >= 0:
                Ints::put(out, bout.dead, DEAD)

    # Press one key. Returns the step the marker actually took, encoded as
    # dx * 4 + dy + 2 so a single i64 carries both.
    def press(bench: mutable CrossedWiresBench&, bout: mutable Bout&, g: CrossedWiresGrade&, keyed: i64, scratch: mutable darray[i64]&) -> i64:
        can Abort.Panic:
            # (0, 0) packed, NOT a raw 0: the encoding is dx * 4 + dy + 2, so
            # "did not move" is 2. Returning 0 here would be the packing of
            # (0, -2), a step that does not exist.
            2 return if over(bench, bout)
            2 return if keyed < 0 or keyed >= g.keys
            wiring_now(bench, bout, g, scratch)
            wired: i64 = get scratch[keyed.usize()] else 0
            went_x: mutable i64 = 0
            went_y: mutable i64 = 0
            if wired != DEAD:
                way: i64 = way_for(g.keys, wired)
                went_x <- way_dx(way)
                went_y <- way_dy(way)
            was: i64 = bench_gap(bench, bout, g)
            bench.at_x <- ((bench.at_x + went_x) % g.across + g.across) % g.across
            bench.at_y <- ((bench.at_y + went_y) % g.down + g.down) % g.down
            bench.presses <- bench.presses + 1
            if bench_gap(bench, bout, g) >= was:
                bench.wasted <- bench.wasted + 1
            which: i64 = goal_index(bench, bout)
            if bench.at_x == Ints::at(bout.goals_x, which) and bench.at_y == Ints::at(bout.goals_y, which):
                bench.reached <- bench.reached + 1
                bench.goal_at <- bench.goal_at + 1
            return went_x * 4 + went_y + 2

    # Every direction and the gap it would leave, best first. Python sorts the
    # `(cost, direction)` pairs, so insertion keeps both the cost order and the
    # lower direction as the stable tie-break.
    def ranked(bench: CrossedWiresBench&, bout: Bout&, g: CrossedWiresGrade&, costs: mutable darray[i64]&, directions: mutable darray[i64]&) -> i64:
        can Abort.Panic:
            found: mutable i64 = 0
            which: mutable i64 = 0
            target: i64 = goal_index(bench, bout)
            goal_x: i64 = Ints::at(bout.goals_x, target)
            goal_y: i64 = Ints::at(bout.goals_y, target)
            while which < g.keys |which, found, costs, directions, bench, g, goal_x, goal_y|:
                way: i64 = way_for(g.keys, which)
                moved_x: i64 = way_dx(way)
                moved_y: i64 = way_dy(way)
                next_x: i64 = ((bench.at_x + moved_x) % g.across + g.across) % g.across
                next_y: i64 = ((bench.at_y + moved_y) % g.down + g.down) % g.down
                cost: i64 = gap(next_x, next_y, goal_x, goal_y, g.across, g.down, g.keys)
                slot: mutable i64 = found
                while slot > 0 and Ints::at_ref(costs, slot - 1) > cost |slot, costs, cost, found|:
                    Ints::put(costs, slot, Ints::at_ref(costs, slot - 1))
                    Ints::put(directions, slot, Ints::at_ref(directions, slot - 1))
                    slot <- slot - 1
                Ints::put(costs, slot, cost)
                Ints::put(directions, slot, which)
                found <- found + 1
                which <- which + 1
            return found

    # The directions that strictly shorten the current gap, still best first.
    def helpful(bench: CrossedWiresBench&, bout: Bout&, g: CrossedWiresGrade&, costs: mutable darray[i64]&, directions: mutable darray[i64]&, out: mutable darray[i64]&) -> i64:
        can Abort.Panic:
            found: i64 = ranked(bench, bout, g, costs, directions)
            was: i64 = bench_gap(bench, bout, g)
            useful: mutable i64 = 0
            for at in 0..<found |at, costs, directions, was, out, useful|:
                if Ints::at_ref(costs, at) < was:
                    Ints::put(out, useful, Ints::at_ref(directions, at))
                    useful <- useful + 1
            return useful

    # Press keys at random until the budget runs out. The reference uses a
    # fresh Random for the player, separate from the one that dealt the bout.
    def play_random(bench: mutable CrossedWiresBench&, bout: mutable Bout&, g: CrossedWiresGrade&, rng: mutable MT19937&) -> i64:
        can Memory.Allocate, Abort.Panic:
            scratch: mutable darray[i64] = Ints::zeros(g.keys + 1)
            while not over(bench, bout) |bench, bout, g, rng, scratch|:
                keyed: i64 = py_randrange(rng, 0, g.keys)
                press(bench, bout, g, keyed, scratch)
            return bench.reached

    # Play while knowing the wiring. This establishes the ceiling without
    # planning around drift or the key that will later die.
    def play_oracle(bench: mutable CrossedWiresBench&, bout: mutable Bout&, g: CrossedWiresGrade&) -> i64:
        can Memory.Allocate, Abort.Panic:
            scratch: mutable darray[i64] = Ints::zeros(g.keys + 1)
            costs: mutable darray[i64] = Ints::zeros(g.keys + 1)
            directions: mutable darray[i64] = Ints::zeros(g.keys + 1)
            while not over(bench, bout) |bench, bout, g, scratch, costs, directions|:
                found: i64 = ranked(bench, bout, g, costs, directions)
                wiring_now(bench, bout, g, scratch)
                pressed: mutable i64 = -1
                rank: mutable i64 = 0
                while rank < found and pressed < 0 |rank, found, pressed, directions, scratch, g|:
                    want: i64 = Ints::at(directions, rank)
                    key: mutable i64 = 0
                    while key < g.keys and pressed < 0 |key, g, pressed, want, scratch|:
                        pressed <- key if Ints::at(scratch, key) == want
                        key <- key + 1
                    rank <- rank + 1
                pressed <- 0 if pressed < 0
                press(bench, bout, g, pressed, scratch)
            return bench.reached

    # Learn one direction per key while moving. `seen == -2` is Python's
    # missing dict entry; `DEAD == -1` remains an observed dead key.
    def play_learner(bench: mutable CrossedWiresBench&, bout: mutable Bout&, g: CrossedWiresGrade&, rng: mutable MT19937&, relearn: bool) -> i64:
        can Memory.Allocate, Abort.Panic:
            scratch: mutable darray[i64] = Ints::zeros(g.keys + 1)
            costs: mutable darray[i64] = Ints::zeros(g.keys + 1)
            directions: mutable darray[i64] = Ints::zeros(g.keys + 1)
            useful: mutable darray[i64] = Ints::zeros(g.keys + 1)
            seen: mutable darray[i64] = Ints::zeros(g.keys + 1)
            order: mutable darray[i64] = Ints::zeros(g.keys + 1)
            for key in 0..<g.keys |key, seen|:
                Ints::put(&seen, key, -2)
            seen_n: mutable i64 = 0
            while not over(bench, bout) |bench, bout, g, rng, scratch, costs, directions, useful, seen, order, seen_n, relearn|:
                useful_n: i64 = helpful(bench, bout, g, costs, directions, useful)
                pressed: mutable i64 = -1
                wanted_at: mutable i64 = 0
                while wanted_at < useful_n and pressed < 0 |wanted_at, useful_n, pressed, useful, order, seen, seen_n|:
                    want: i64 = Ints::at(useful, wanted_at)
                    known_at: mutable i64 = 0
                    while known_at < seen_n and pressed < 0 |known_at, seen_n, pressed, want, useful, order, seen|:
                        key: i64 = Ints::at(order, known_at)
                        pressed <- key if Ints::at(seen, key) == want
                        known_at <- known_at + 1
                    wanted_at <- wanted_at + 1
                if pressed < 0:
                    blind_n: mutable i64 = 0
                    for key in 0..<g.keys |key, seen, order, seen_n, blind_n|:
                        if Ints::at(seen, key) == -2:
                            Ints::put(&order, seen_n + blind_n, key)
                            blind_n <- blind_n + 1
                    if blind_n > 0:
                        picked: i64 = py_choice_index(rng, blind_n)
                        pressed <- Ints::at(order, seen_n + picked)
                    else:
                        pressed <- py_randrange(rng, 0, g.keys)
                expected: i64 = Ints::at(seen, pressed)
                went: i64 = press(bench, bout, g, pressed, scratch)
                found: mutable i64 = DEAD
                if went != 2:
                    way: mutable i64 = 0
                    while way < g.keys |way, g, went, found|:
                        if way_dx(way_for(g.keys, way)) * 4 + way_dy(way_for(g.keys, way)) + 2 == went:
                            found <- way
                        way <- way + 1
                if not relearn:
                    if expected == -2:
                        Ints::put(&order, seen_n, pressed)
                        seen_n <- seen_n + 1
                        Ints::put(&seen, pressed, found)
                else:
                    if expected != -2 and expected != found:
                        for key in 0..<g.keys |key, seen|:
                            Ints::put(&seen, key, -2)
                        seen_n <- 0
                    if expected == -2 or (expected != -2 and expected != found):
                        Ints::put(&order, seen_n, pressed)
                        seen_n <- seen_n + 1
                    Ints::put(&seen, pressed, found)
            return bench.reached
