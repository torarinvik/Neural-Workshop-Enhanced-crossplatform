\t589\t\nhospital\t590\t\nteacher\t591\t\nstudent\t592\t\nlesson\t593\t\nclass\t594\t\nexam\t595\t\ngrade\t596\t\npencil\t597\t\nchalk\t598\t\ndrum\t599\t\nflute\t600\t\nhorn\t601\t\nstring\t602\t\ndance\t603\t\nstage\t604\t\nactor\t605\t\nplay\t606\t\nscene\t607\t\npaint\t608\t\nbrush\t609\t\ncanvas\t610\t\nimage\t611\t\npicture\t612\t\nphotograph\t613\t\ncamera\t614\t\nfilm\t615\t\nharvest\t616\t\nplough\t617\t\ncrop\t618\t\ngrain\t619\t\nflour\t620\t\noven\t621\t\nthread\t622\t\nneedle\t623\t\ncoat\t624\t\nshirt\t625\t\ndress\t626\t\nshoe\t627\t\nhat\t628\t\nglove\t629\t\nbelt\t630\t\nbutton\t631\t\nclock\t632\t\nwatch\t633\t\nbell\t634\t\nalarm\t635\t\nsignal\t636\t\nflag\t637\t\nmark\t638\t\nsign\t639\t\nsymbol\t640\t\ncode\t641\t\nmessage\t642\t\ntravel\t643\t\njourney\t644\t\nmap\t645\t\nguide\t646\t\nroute\t647\t\ndistance\t648\t\nspeed\t649\t\ndirection\t650\t\nnation\t651\t\npeople\t652\t\ntribe\t653\t\nparent\t654\t\nmother\t655\t\nfather\t656\t\nbrother\t657\t\nsister\t658\t\nson\t659\t\ndaughter\t660\t\nuncle\t661\t\naunt\t662\t\ncousin\t663\t\nnephew\t664\t\nniece\t665\t\nhusband\t666\t\nwife\t667\t\nwidow\t668\t\norphan\t669\t\n", 0, -1)

    struct ScrabbleIndexStats:
        words: mutable i64
        letters: mutable i64
        ranked_rows: mutable i64
        valid: mutable bool

    def inspect(text: sview, rank_limit: i64, max_length: i64) -> ScrabbleIndexStats:
        can Abort.Panic:
            stats: mutable ScrabbleIndexStats = ScrabbleIndexStats{words: 0, letters: 0, ranked_rows: 0, valid: true}
            total: i64 = sview_len(text).i64()
            at: mutable i64 = 0
            while at < total |text, total, at, rank_limit, max_length, stats|:
                row: CrosswordLexicon::CrosswordIndexRow = CrosswordLexicon::row_at(text, at, total)
                if not row.valid:
                    stats.valid <- false
                    return stats
                stats.ranked_rows <- stats.ranked_rows + 1 if row.rank < rank_limit
                if row.rank < rank_limit and row.word_length >= 2 and row.word_length <= max_length:
                    stats.words <- stats.words + 1
                    stats.letters <- stats.letters + row.word_length
                at <- row.next
            return stats

    def sort_entries(lex: mutable Scrabble::ScrabbleLexiconData&):
        can Memory.Allocate, Abort.Panic:
            starts: mutable darray[i64] = Ints::zeros(lex.count)
            lengths: mutable darray[i64] = Ints::zeros(lex.count)
            ranks: mutable darray[i64] = Ints::zeros(lex.count)
            width: mutable i64 = 1
            while width < lex.count |lex, starts, lengths, ranks, width|:
                begin: mutable i64 = 0
                while begin < lex.count |lex, starts, lengths, ranks, width, begin|:
                    middle: i64 = begin + width if begin + width < lex.count else lex.count
                    end: i64 = middle + width if middle + width < lex.count else lex.count
                    left: mutable i64 = begin
                    right: mutable i64 = middle
                    for dest in begin..<end |lex, starts, lengths, ranks, left, right, middle, end|:
                        take_left: bool = left < middle and (right >= end or Ints::at_ref(&lex.rank, left) <= Ints::at_ref(&lex.rank, right))
                        source: i64 = left if take_left else right
                        left <- left + 1 if take_left
                        right <- right + 1 if not take_left
                        Ints::put(&starts, dest, Ints::at_ref(&lex.start, source))
                        Ints::put(&lengths, dest, Ints::at_ref(&lex.length, source))
                        Ints::put(&ranks, dest, Ints::at_ref(&lex.rank, source))
                    begin <- end
                for index in 0..<lex.count |lex, starts, lengths, ranks|:
                    Ints::put(&lex.start, index, Ints::at_ref(&starts, index))
                    Ints::put(&lex.length, index, Ints::at_ref(&lengths, index))
                    Ints::put(&lex.rank, index, Ints::at_ref(&ranks, index))
                width <- width * 2

    # The caller validates input and allocates the returned capacities first.
    def load(text: sview, rank_limit: i64, max_length: i64, lex: mutable Scrabble::ScrabbleLexiconData&):
        can Memory.Allocate, Abort.Panic:
            total: i64 = sview_len(text).i64()
            at: mutable i64 = 0
            letters: mutable i64 = 0
            previous_rank: mutable i64 = 0
            unsorted: mutable bool = false
            lex.count <- 0
            while at < total |text, total, at, rank_limit, max_length, lex, letters, previous_rank, unsorted|:
                row: CrosswordLexicon::CrosswordIndexRow = CrosswordLexicon::row_at(text, at, total)
                if row.rank < rank_limit and row.word_length >= 2 and row.word_length <= max_length:
                    index: i64 = lex.count
                    unsorted <- true if row.rank < previous_rank
                    previous_rank <- row.rank
                    Ints::put(&lex.start, index, letters)
                    Ints::put(&lex.length, index, row.word_length)
                    Ints::put(&lex.rank, index, row.rank)
                    for digit in 0..<row.word_length |text, row, lex, letters|:
                        Ints::put(&lex.letter, letters + digit, sview_at(text, (row.word_at + digit).usize()).i64() - 97)
                    letters <- letters + row.word_length
                    lex.count <- lex.count + 1
                at <- row.next
            if unsorted: sort_entries(lex)
            Scrabble::index_lexicon(lex)
