# Import the shared source word index for Scrabble. Unlike Crossword,
# two-letter words are eligible and clues are not required.
module ScrabbleLexicon:
    # Generated from wordlist.SEED_WORDS in source order; ranks are one-based.
    def seed_text() -> sview:
        return sview("the\t1\t\nand\t2\t\nthat\t3\t\nfor\t4\t\nwith\t5\t\nwas\t6\t\nnot\t7\t\nthis\t8\t\nare\t9\t\nfrom\t10\t\nwhich\t11\t\nhave\t12\t\nhis\t13\t\nbut\t14\t\nyou\t15\t\nwere\t16\t\nthey\t17\t\nhad\t18\t\nall\t19\t\none\t20\t\nhas\t21\t\ntheir\t22\t\nwill\t23\t\nbeen\t24\t\ncan\t25\t\nthere\t26\t\nother\t27\t\nwould\t28\t\nher\t29\t\nmore\t30\t\nmay\t31\t\nwhen\t32\t\nits\t33\t\nthese\t34\t\nnew\t35\t\nshe\t36\t\nsuch\t37\t\nwho\t38\t\ntime\t39\t\nthan\t40\t\nany\t41\t\nwhat\t42\t\nsome\t43\t\nalso\t44\t\nabout\t45\t\nonly\t46\t\ninto\t47\t\nout\t48\t\ntwo\t49\t\nthem\t50\t\nhim\t51\t\nfirst\t52\t\nsaid\t53\t\nsee\t54\t\nstate\t55\t\nunder\t56\t\nshould\t57\t\nmade\t58\t\ncould\t59\t\nafter\t60\t\nthen\t61\t\nover\t62\t\nbetween\t63\t\nmost\t64\t\nyour\t65\t\nwork\t66\t\nwhere\t67\t\neach\t68\t\nmany\t69\t\nnow\t70\t\nlike\t71\t\nvery\t72\t\nupon\t73\t\nmust\t74\t\nthose\t75\t\nown\t76\t\nwell\t77\t\ngreat\t78\t\nyear\t79\t\nmuch\t80\t\nbeing\t81\t\nboth\t82\t\nbecause\t83\t\nsame\t84\t\nwater\t85\t\nwhile\t86\t\nlong\t87\t\nmake\t88\t\neven\t89\t\npart\t90\t\nright\t91\t\nthrough\t92\t\nyears\t93\t\nmen\t94\t\ngeneral\t95\t\nlife\t96\t\nform\t97\t\ngood\t98\t\nnational\t99\t\nnever\t100\t\nlittle\t101\t\nknow\t102\t\ndown\t103\t\nstill\t104\t\nlast\t105\t\nused\t106\t\nplace\t107\t\nfound\t108\t\nhigh\t109\t\ndoes\t110\t\nday\t111\t\nnumber\t112\t\ncome\t113\t\nduring\t114\t\nbefore\t115\t\nsmall\t116\t\nsince\t117\t\nagainst\t118\t\ncourse\t119\t\nthree\t120\t\nsystem\t121\t\nwithout\t122\t\nhere\t123\t\nanother\t124\t\npublic\t125\t\nthought\t126\t\ngiven\t127\t\nmight\t128\t\nonce\t129\t\nname\t130\t\ntoo\t131\t\ntook\t132\t\nthink\t133\t\noften\t134\t\ncase\t135\t\ngroup\t136\t\nsay\t137\t\nearly\t138\t\nimportant\t139\t\nseveral\t140\t\nwant\t141\t\nbecome\t142\t\nsocial\t143\t\npossible\t144\t\norder\t145\t\nleft\t146\t\narea\t147\t\nfact\t148\t\nper\t149\t\nsecond\t150\t\nlocal\t151\t\nthough\t152\t\nhimself\t153\t\npolitical\t154\t\npower\t15