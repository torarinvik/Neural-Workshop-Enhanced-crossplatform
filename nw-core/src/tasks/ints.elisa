# Bounds-checked flat integer and float buffers.
#
# These began life inside maze.elisa as `maze_at` / `maze_put` / `maze_zeros`,
# and then every later task module reached across for them -- ninarow,
# inthedark and crossedwires all called `maze_*` helpers while having nothing
# to do with mazes. That is the usual sign that a helper is in the wrong file:
# the prefix stopped describing what the function does and started describing
# where it happened to be written.
#
# Two readers rather than one, because a `darray[T]` parameter and a
# `mutable darray[T]&` parameter are different types and the by-value reader
# cannot take a reference. `at` is for owned buffers, `at_ref` for borrowed
# ones; the alternative is every caller remembering which kind it holds.
module Ints:
    def at(values: darray[i64], index: i64) -> i64:
        can Abort.Panic:
            return get values[index.usize()] else 0

    def at_ref(values: mutable darray[i64]&, index: i64) -> i64:
        can Abort.Panic:
            return get values[index.usize()] else 0

    # Read-only borrowed buffers, including a field borrowed from an immutable
    # aggregate. This is intentionally separate from `at_ref`: the compiler
    # must not manufacture a mutable borrow merely to perform a bounds-checked
    # read.
    def at_view(values: darray[i64]&, index: i64) -> i64:
        can Abort.Panic:
            return get values[index.usize()] else 0

    # Silently ignores an out-of-range index rather than panicking: the callers
    # are generators that clamp their own sizes, and a panic here would turn a
    # sizing bug into a crash a long way from its cause.
    def put(values: mutable darray[i64]&, index: i64, value: i64):
        can Abort.Panic:
            if index >= 0 and index < values.count.i64():
                values[index.usize()] <- value

    # Ascending sort of the first `count` entries, in place. Insertion sort
    # because the callers sort a handful of picked beats or cells, where the
    # constant factor beats an O(n log n) with a stack.
    #
    # This lives here rather than in pyrandom: `sorted()` is not a random
    # operation, and putting it beside the MT19937 reimplementation because a
    # caller happens to sort right after shuffling is how pyrandom would end up
    # owning half the standard library.
    def sort_prefix(values: mutable darray[i64]&, count: i64):
        can Abort.Panic:
            index: mutable i64 = 1
            while index < count |index, count, values|:
                # Qualified even though we are INSIDE Ints: an unqualified
                # `put` here resolves to the std IndexMap's put, not this
                # module's. A module does not shadow a global of the same name.
                held: i64 = Ints::at_ref(values, index)
                slot: mutable i64 = index
                while slot > 0 and Ints::at_ref(values, slot - 1) > held |slot, values, held|:
                    Ints::put(values, slot, Ints::at_ref(values, slot - 1))
                    slot <- slot - 1
                Ints::put(values, slot, held)
                index <- index + 1

    def zeros(count: i64) -> darray[i64]:
        can Memory.Allocate, Abort.Panic:
            values: mutable darray[i64] = []
            for _index in 0..<count |values|:
                values.push(0)
            return values

module Floats:
    def at(values: darray[f64], index: i64) -> f64:
        can Abort.Panic:
            return get values[index.usize()] else 0.0

    def zeros(count: i64) -> darray[f64]:
        can Memory.Allocate, Abort.Panic:
            values: mutable darray[f64] = []
            for _index in 0..<count |values|:
                values.push(0.0)
            return values

    def at_ref(values: mutable darray[f64]&, index: i64) -> f64:
        can Abort.Panic:
            return get values[index.usize()] else 0.0

    # Out-of-range writes are ignored, for the same reason Ints::put ignores
    # them: the callers clamp their own sizes.
    def put(values: mutable darray[f64]&, index: i64, value: f64):
        can Abort.Panic:
            if index >= 0 and index < values.count.i64():
                values[index.usize()] <- value

# The same two operations over bytes, for buffers that are written by index
# rather than grown -- see the note in tasks/syllogism.elisa about why growing
# a struct's container field through a helper is not available.
module Bytes:
    def at(values: darray[u8], index: i64) -> u8:
        can Abort.Panic:
            return get values[index.usize()] else 0.u8()

    def zeros(count: i64) -> darray[u8]:
        can Memory.Allocate, Abort.Panic:
            values: mutable darray[u8] = []
            for _index in 0..<count |values|:
                values.push(0.u8())
            return values

    def at_ref(values: mutable darray[u8]&, index: i64) -> u8:
        can Abort.Panic:
            return get values[index.usize()] else 0.u8()

    def put(values: mutable darray[u8]&, index: i64, value: u8):
        can Abort.Panic:
            if index >= 0 and index < values.count.i64():
                values[index.usize()] <- value
