include "../hand_view.elisa"
include "../pymath.elisa"
include "../pyrandom.elisa"
include "./drshape_deal.elisa"

# nightwatch.py: a dark warehouse, one torch, and somebody at the safe.
# Click every thief before one reaches it; the floor may be wider than the
# view, and Left and Right, held, turn you along it.
module NightWatch:
    const LEFT: i64 = HandView::KEYS
    const RIGHT: i64 = HandView::KEYS + 1
    const PORTS: i64 = HandView::KEYS + 2
    const SAFE_X: f64 = 0.0
    const SAFE_Z: f64 = 3.0
    const DEEP: f64 = 6.0
    const PAN: f64 = 5.0
    const SEEN: f64 = 4.6
    const STEP: i64 = 0
    const KEYS_: i64 = 1
    const MEOW: i64 = 2
    const CAUGHT: i64 = 3
    const WRONG: i64 = 4
    const ALARM: i64 = 5
    const RED: i64 = 0
    const GREEN: i64 = 1
    const BLUE: i64 = 2
    const YELLOW: i64 = 3
    const WHITE: i64 = 4
    const GREY: i64 = 5
    const THIEF: i64 = 0
    const GUARD: i64 = 1
    const CAT: i64 = 2
    const MOST: i64 = 20
    const LIVE: i64 = 0
    const CAUGHT_ALL: i64 = 1
    const NO_WHISTLE: i64 = 2
    const WRONG_ONE: i64 = 3
    const ROBBED: i64 = 4
    const DAWN: i64 = 5

    struct Grade:
        rung: i64
        thieves: i64
        others: i64
        half: f64
        cross: f64
        beam: f64
        fixed: bool
        telling: bool
        weave: f64
        strikes: i64
        seconds: f64

    struct Walker:
        kind: i64
        colour: i64
        enters: f64
        start_x: f64
        start_z: f64
        goal_x: f64
        goal_z: f64
        speed: f64
        phase: f64

    struct Night:
        level: Grade
        thief: i64
        guard: i64
        walkers: Walker[20]
        count: i64
        seed: i64
        valid: bool

    struct Run:
        night: Night
        hand: mutable HandView::Pointer
        cam: mutable f64
        gone: mutable bool[20]
        caught: mutable i64
        strikes: mutable i64
        blasts: mutable i64
        step_at: mutable f64[20]
        left_until: mutable f64
        right_until: mutable f64
        wrong: mutable i64
        time: mutable f64
        result: mutable i64
        audible: bool
        notes: mutable darray[DrShapeDeal::Note]

    # Python's min(a, b) and max(a, b): the first unless the second is
    # strictly beyond it, which decides the sign of a zero.
    def pmin(a: f64, b: f64) -> f64:
        return b if b < a else a

    def pmax(a: f64, b: f64) -> f64:
        return b if b > a else a

    # Separate libm calls, as Python makes them.
    @inline(never)
    def sine(angle: f64) -> f64:
        return sin(angle)

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 1 else 1
        top: i64 = r - 20 if r > 20 else 0
        thieves: i64 = 2 if r < 4 else (3 if r < 10 else (4 if r < 20 else (5 + top / 6 if 5 + top / 6 < 12 else 12)))
        cross: f64 = 16.0 if r < 4 else (14.0 if r < 10 else (12.0 if r < 20 else fmax(6.0, 11.0 - 0.08 * top.f64())))
        gap: f64 = 0.55 * cross
        return Grade{rung: r, thieves: thieves,
            others: 0 if r < 4 else (2 if r < 10 else (3 if r < 20 else (4 + top / 8 if 4 + top / 8 < 8 else 8))),
            half: 4.4 if r < 7 else (8.0 if r < 16 else 12.0), cross: cross,
            beam: 150.0 if r < 10 else (115.0 if r < 20 else fmax(60.0, 105.0 - 0.8 * top.f64())),
            fixed: r < 10, telling: r < 13, weave: 0.0 if r < 16 else 1.2,
            strikes: 3 if r < 10 else (2 if r < 20 else 1),
            seconds: 2.0 + thieves.f64() * gap + cross + 2.0}

    def build(level: Grade, draw: mutable MT19937&) -> Night:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            thief: mutable i64 = RED
            guard: mutable i64 = BLUE
            if not level.fixed:
                pair: darray[i64] = py_sample_range(draw, 0, 4, 2)
                thief <- pair[0]
                guard <- pair[1]
            walkers: mutable Walker[20] = zeroed
            count: mutable i64 = 0
            gap: f64 = 0.55 * level.cross
            for k in 0..<level.thieves |walkers, count, draw, level, gap, thief|:
                side: f64 = -1.0 if py_choice_index(draw, 2) == 0 else 1.0
                sx: f64 = side * level.half
                sz: f64 = py_uniform(draw, 0.8, DEEP - 0.8)
                far: f64 = py_hypot(sx - SAFE_X, sz - SAFE_Z)
                enters: f64 = 2.0 + k.f64() * gap + py_uniform(draw, 0.0, 0.3 * gap)
                walkers[count.usize()] <- Walker{kind: THIEF, colour: thief, enters: enters, start_x: sx, start_z: sz,
                    goal_x: SAFE_X, goal_z: SAFE_Z, speed: far / level.cross, phase: py_uniform(draw, 0.0, 6.28)}
                count <- count + 1
            for k in 0..<level.others |walkers, count, draw, level, guard|:
                kind: i64 = GUARD if k % 2 == 0 else CAT
                side: f64 = -1.0 if py_choice_index(draw, 2) == 0 else 1.0
                z: f64 = py_uniform(draw, 0.8, DEEP - 0.8)
                enters: f64 = py_uniform(draw, 0.0, level.seconds * 0.7)
                goal_z: f64 = py_uniform(draw, 0.8, DEEP - 0.8)
                walkers[count.usize()] <- Walker{kind: kind, colour: guard if kind == GUARD else GREY, enters: enters,
                    start_x: side * level.half, start_z: z, goal_x: -side * level.half, goal_z: goal_z,
                    speed: (2.0 * level.half / level.cross) * (1.0 if kind == GUARD else 1.7),
                    phase: py_uniform(draw, 0.0, 6.28)}
                count <- count + 1
            return Night{level: level, thief: thief, guard: guard, walkers: walkers, count: count,
                seed: py_randbelow(draw, 1073741824.u64()).i64(), valid: true}

    def begin(night: Night, audible: bool = true) -> Run:
        step_at: mutable f64[20] = zeroed
        for k in 0..<night.count |step_at, night|:
            step_at[k.usize()] <- night.walkers[k.usize()].enters
        return Run{night: night, hand: HandView::initialize(), cam: 0.0, gone: zeroed, caught: 0, strikes: 0,
            blasts: night.level.thieves + 3, step_at: step_at, left_until: -1.0, right_until: -1.0, wrong: GUARD,
            time: 0.0, result: LIVE, audible: audible, notes: []}

    def holding(run: Run&, port: i64) -> bool:
        return (run.right_until if port == RIGHT else run.left_until) >= run.time

    # How far the view can turn either way.
    def room(run: Run&) -> f64:
        return 0.0 if run.night.level.half <= SEEN
        return run.night.level.half - SEEN + 0.6

    def view(run: Run&) -> HandView::Lens:
        can Abort.Panic:
            return HandView::lens(RoomsView::vec(run.cam, 2.3, 11.5), RoomsView::vec(run.cam, 0.9, 3.0), 760.0, 500.0, 300.0)

    struct Spot:
        x: f64
        y: f64
        u: f64
        valid: bool

    # Walker k on the floor now, if they are in the building (z < 0 if not).
    def where(run: Run&, k: i64) -> Spot:
        can Abort.Panic:
            w: Walker = run.night.walkers[k.usize()]
            return Spot{x: 0.0, y: 0.0, u: 0.0, valid: false} if run.gone[k.usize()] or run.time < w.enters
            dx: f64 = w.goal_x - w.start_x
            dz: f64 = w.goal_z - w.start_z
            far: f64 = py_hypot(dx, dz)
            went: f64 = pmin(far, (run.time - w.enters) * w.speed)
            f: f64 = went / far
            x: mutable f64 = w.start_x + dx * f
            z: mutable f64 = w.start_z + dz * f
            if w.kind == THIEF and run.night.level.weave != 0.0:
                bend: f64 = run.night.level.weave * sine(3.141592653589793 * f) * sine(w.phase + 1.3 * (run.time - w.enters))
                bent_x: f64 = x - dz / far * bend
                z <- z + dx / far * bend
                x <- bent_x
                z <- pmax(0.4, pmin(DEEP - 0.4, z))
            return Spot{x: x, y: z, u: 0.0, valid: true}

    def arrived(run: Run&, k: i64) -> bool:
        can Abort.Panic:
            w: Walker = run.night.walkers[k.usize()]
            far: f64 = py_hypot(w.goal_x - w.start_x, w.goal_z - w.start_z)
            return (run.time - w.enters) * w.speed >= far

    def height(run: Run&, k: i64) -> f64:
        can Abort.Panic:
            return 0.3 if run.night.walkers[k.usize()].kind == CAT else 1.0

    # Where walker k's middle is on the screen, and how big a unit of them
    # is there.
    def spot(run: Run&, k: i64) -> Spot:
        can Abort.Panic:
            at: Spot = where(run, k)
            return at if not at.valid
            camera: HandView::Lens = view(run)
            q: RoomsView::Vec = HandView::see(&camera, RoomsView::vec(at.x, height(run, k), at.y))
            return Spot{x: 0.0, y: 0.0, u: 0.0, valid: false} if q.z < 0.05
            return Spot{x: q.x, y: q.y, u: 760.0 / q.z, valid: true}

    def lit(run: Run&, k: i64) -> bool:
        can Abort.Panic:
            q: Spot = spot(run, k)
            return q.valid and py_hypot(q.x - run.hand.x, q.y - run.hand.y) <= run.night.level.beam + 0.3 * q.u

    def under(run: Run&) -> i64:
        can Abort.Panic:
            best: mutable i64 = -1
            nearest: mutable f64 = 0.0
            for k in 0..<run.night.count |run, best, nearest|:
                q: Spot = spot(run, k)
                continue if not q.valid
                wide: f64 = (0.45 if run.night.walkers[k.usize()].kind != CAT else 0.4) * q.u
                tall: f64 = height(run, k) * q.u
                if fabs(run.hand.x - q.x) <= wide + 4.0 and fabs(run.hand.y - q.y) <= tall + 4.0:
                    d: f64 = py_hypot(run.hand.x - q.x, run.hand.y - q.y)
                    if best < 0 or d < nearest:
                        best <- k
                        nearest <- d
            return best

    def note(run: mutable Run&, duration: f64, frequency: f64, voice: i64, gain: f64, pan: f64 = 0.0):
        can Abort.Panic, Memory.Allocate:
            return if not run.audible
            side: f64 = pmax(-1.0, pmin(1.0, pan))
            run.notes.push(DrShapeDeal::Note{t: run.time, dur: duration, freq: frequency, voice: voice,
                gain: gain, gain2: gain, pan: side, pan2: side, bright: 0.8, seed: 1 + run.notes.count.i64(), who: -1, room: 0.0})

    def pan_of(run: Run&, k: i64) -> f64:
        can Abort.Panic:
            at: Spot = where(run, k)
            return 0.0 if not at.valid
            return pmax(-1.0, pmin(1.0, (at.x - run.cam) / SEEN))

    def press(run: mutable Run&):
        can Abort.Panic, Memory.Allocate:
            run.hand.down <- true
            k: i64 = under(run)
            run.blasts <- run.blasts - 1
            if k < 0:
                note(run, 0.15, 1200.0, KEYS_, 0.3)
                run.result <- NO_WHISTLE if run.blasts <= 0
                return
            w: Walker = run.night.walkers[k.usize()]
            if w.kind == THIEF:
                run.gone[k.usize()] <- true
                run.caught <- run.caught + 1
                # The pan is taken once the thief is gone: centred.
                note(run, 0.3, 880.0, CAUGHT, 0.55, pan_of(run, k))
                run.result <- CAUGHT_ALL if run.caught >= run.night.level.thieves
            else:
                run.strikes <- run.strikes + 1
                note(run, 0.3, 130.0, WRONG, 0.5)
                if run.strikes >= run.night.level.strikes:
                    run.wrong <- w.kind
                    run.result <- WRONG_ONE
                elif run.blasts <= 0:
                    run.result <- NO_WHISTLE

    def release(run: mutable Run&):
        run.hand.down <- false

    # Ports 0-13 act; Left and Right latch, as HandRun.controls does when
    # they arrive as a step's control.
    def act(run: mutable Run&, port: i64):
        can Abort.Panic, Memory.Allocate:
            if port >= 0 and port < HandView::PRESS:
                HandView::move(&run.hand, port)
            elif port == HandView::PRESS:
                press(run)
            elif port == HandView::RELEASE:
                release(run)
            elif port == LEFT:
                run.left_until <- run.time + HandView::LATCH
            elif port == RIGHT:
                run.right_until <- run.time + HandView::LATCH

    def step(run: mutable Run&, dt: f64):
        can Abort.Panic, Memory.Allocate:
            return if run.result != LIVE
            run.time <- run.time + dt
            turn: f64 = ((1 if holding(run, RIGHT) else 0) - (1 if holding(run, LEFT) else 0)).f64() * PAN * dt
            width: f64 = room(run)
            run.cam <- pmax(-width, pmin(width, run.cam + turn))
            for k in 0..<run.night.count |run|:
                w: Walker = run.night.walkers[k.usize()]
                continue if run.gone[k.usize()] or run.time < w.enters
                if arrived(run, k):
                    if w.kind == THIEF:
                        note(run, 0.6, 196.0, ALARM, 0.6)
                        run.result <- ROBBED
                        return
                    run.gone[k.usize()] <- true
                    continue
                if run.time >= run.step_at[k.usize()]:
                    quick: bool = w.kind == CAT
                    run.step_at[k.usize()] <- run.time + (0.9 if quick else 0.48)
                    away: f64 = fabs(where(run, k).x - run.cam)
                    gain: f64 = 0.42 / (1.0 + 0.12 * away)
                    if quick:
                        note(run, 0.18, 700.0, MEOW, gain, pan_of(run, k))
                    elif w.kind == GUARD and run.night.level.telling:
                        note(run, 0.07, 1500.0, KEYS_, gain, pan_of(run, k))
                    else:
                        note(run, 0.06, 150.0, STEP, gain, pan_of(run, k))
            run.result <- DAWN if run.time >= run.night.level.seconds

    # The reference player: go to the thief nearest the safe, turn until
    # they are in view, put the torch on them, click.
    def pilot(run: Run&) -> i64:
        can Abort.Panic:
            return -1 if run.result != LIVE
            return HandView::RELEASE if run.hand.down
            best: mutable i64 = -1
            nearest: mutable f64 = 0.0
            at_x: mutable f64 = 0.0
            for k in 0..<run.night.count |run, best, nearest, at_x|:
                at: Spot = where(run, k)
                continue if run.night.walkers[k.usize()].kind != THIEF or not at.valid
                d: f64 = py_hypot(at.x - SAFE_X, at.y - SAFE_Z)
                if best < 0 or d < nearest:
                    best <- k
                    nearest <- d
                    at_x <- at.x
            return -1 if best < 0
            lean: f64 = at_x - run.cam
            if fabs(lean) > 3.2 and fabs(run.cam + (0.5 if lean >= 0.0 else -0.5)) <= room(run):
                port: i64 = RIGHT if lean > 0.0 else LEFT
                return port if not holding(run, port)
            q: Spot = spot(run, best)
            return -1 if not q.valid
            return HandView::PRESS if under(run) == best
            return HandView::toward(&run.hand, q.x, q.y, 6.0)

    def reference_passes(night: Night) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            run: mutable Run = begin(night, false)
            while run.result == LIVE |run|:
                act(&run, pilot(&run))
                step(&run, 1.0 / 60.0)
            return run.result == CAUGHT_ALL

    def deal(rung: i64, draw: mutable MT19937&) -> Night:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            level: Grade = grade(rung)
            for _ in 0..<80 |level, draw|:
                rng: mutable MT19937 = zeroed
                mt_seed_int(&rng, py_getrandbits(draw, 32))
                night: Night = build(level, &rng)
                return night if reference_passes(night)
            return zeroed

    # The orders, as the reference words them.
    def colour(index: i64) -> cstr:
        return "red" if index == RED else ("green" if index == GREEN else ("blue" if index == BLUE else
            ("yellow" if index == YELLOW else ("white" if index == WHITE else "grey"))))
