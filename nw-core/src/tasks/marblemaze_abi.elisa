# Stable byte serialization for a Marble Maze tray generated by the shared core.
# All host exports use this one layout so a native physics/render host consumes
# the exact certified board the browser receives rather than reimplementing deal().
module MarbleBoardABI:
    const MAGIC: u32 = 826496845       # "MWC1" little-endian (format v1)
    const VERSION: u32 = 1

    def append_u32(out: mutable darray[u8]&, value: u32) -> void:
        can Memory.Allocate, Abort.Panic:
            out.push((value & 255.u32()).u8())
            out.push(((value >> 8.u32()) & 255.u32()).u8())
            out.push(((value >> 16.u32()) & 255.u32()).u8())
            out.push(((value >> 24.u32()) & 255.u32()).u8())

    def append_f32(out: mutable darray[u8]&, value: f64) -> void:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                holder: f32[1] = zeroed
                holder[0] <- value.f32()
                bytes: u8[4] = zeroed
                memcpy((&bytes[0]).cast[mutable void&], (&holder[0]).cast[void&], 4.usize())
                out.push(bytes[0])
                out.push(bytes[1])
                out.push(bytes[2])
                out.push(bytes[3])

    def encode(rung: i64, seed: i64) -> darray[u8]:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            work: mutable MarbleMaze::MarbleWork = MarbleMaze::MarbleWork()
            tray: mutable MarbleMaze::MarbleTray = MarbleMaze::MarbleTray()
            MarbleMaze::deal(rung, seed, 24, &work, &tray)
            out: mutable darray[u8] = []
            append_u32(&out, MAGIC)
            append_u32(&out, VERSION)
            append_u32(&out, 1.u32() if tray.built else 0.u32())
            append_u32(&out, tray.rung.u32())
            append_u32(&out, tray.cols.u32())
            append_u32(&out, tray.rows.u32())
            append_f32(&out, tray.width)
            append_f32(&out, tray.depth)
            append_f32(&out, tray.cell)
            append_f32(&out, tray.thickness)
            append_f32(&out, tray.height)
            append_f32(&out, tray.home_x)
            append_f32(&out, tray.home_y)
            append_f32(&out, tray.home_r)
            append_f32(&out, tray.seconds)
            append_f32(&out, tray.route)
            append_u32(&out, tray.walls.count.u32())
            wall: mutable i64 = 0
            while wall < tray.walls.count |wall, tray, out|:
                append_f32(&out, Floats::at(tray.walls.x0, wall))
                append_f32(&out, Floats::at(tray.walls.y0, wall))
                append_f32(&out, Floats::at(tray.walls.x1, wall))
                append_f32(&out, Floats::at(tray.walls.y1, wall))
                wall <- wall + 1
            append_u32(&out, tray.holes.count.u32())
            hole: mutable i64 = 0
            while hole < tray.holes.count |hole, tray, out|:
                append_f32(&out, Floats::at(tray.holes.x, hole))
                append_f32(&out, Floats::at(tray.holes.y, hole))
                append_f32(&out, Floats::at(tray.holes.radius, hole))
                append_u32(&out, Ints::at(tray.holes.home, hole).u32())
                hole <- hole + 1
            append_u32(&out, tray.start_n.u32())
            start: mutable i64 = 0
            while start < tray.start_n |start, tray, out|:
                append_f32(&out, Floats::at(tray.start_x, start))
                append_f32(&out, Floats::at(tray.start_y, start))
                start <- start + 1
            return out

    def write(dest: i64, capacity: i64, rung: i64, seed: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            return 0 if dest <= 0 or capacity <= 0
            encoded: darray[u8] = encode(rung, seed)
            length: i64 = encoded.count.i64()
            return 0 if length <= 0 or length > capacity
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            return length
