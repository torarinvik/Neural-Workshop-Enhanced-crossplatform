include "./reading_quiz.elisa"

module WhichFeeling:
    # whichfeeling.py: what the writer of a GoEmotions comment feels, the
    # other answers nearer the right one as the rungs climb.
    const ITEMS: i64 = 10
    # GOOD (12), BAD (11) and OPEN (4) in the reference's order, then
    # neutral.
    const LABELS: i64 = 28
    const NEUTRAL: i64 = 27

    struct Grade:
        rung: i64
        options: i64
        near: i64
        neutral: bool
        plain: bool
        seconds: f64
        need: i64

    struct Comment:
        text: dstr
        label: i64

    struct Corpus:
        by_label: mutable darray[Comment][28]

    struct Round:
        level: Grade
        quiz: ReadingQuiz::Round

    def label_name(label: i64) -> cstr:
        return "admiration" if label == 0
        return "amusement" if label == 1
        return "approval" if label == 2
        return "caring" if label == 3
        return "desire" if label == 4
        return "excitement" if label == 5
        return "gratitude" if label == 6
        return "joy" if label == 7
        return "love" if label == 8
        return "optimism" if label == 9
        return "pride" if label == 10
        return "relief" if label == 11
        return "anger" if label == 12
        return "annoyance" if label == 13
        return "disappointment" if label == 14
        return "disapproval" if label == 15
        return "disgust" if label == 16
        return "embarrassment" if label == 17
        return "fear" if label == 18
        return "grief" if label == 19
        return "nervousness" if label == 20
        return "remorse" if label == 21
        return "sadness" if label == 22
        return "confusion" if label == 23
        return "curiosity" if label == 24
        return "realization" if label == 25
        return "surprise" if label == 26
        return "neutral" if label == NEUTRAL
        return ""

    # PLAIN: joy, gratitude, love, amusement, anger, sadness, fear, disgust.
    def plain_label(index: i64) -> i64:
        return 7 if index == 0
        return 6 if index == 1
        return 8 if index == 2
        return 1 if index == 3
        return 12 if index == 4
        return 22 if index == 5
        return 18 if index == 6
        return 16

    # kind_of: GOOD, BAD, or OPEN for anything else, neutral included.
    def kind_start(label: i64) -> i64:
        return 0 if label < 12
        return 12 if label < 23
        return 23

    def kind_end(label: i64) -> i64:
        return 12 if label < 12
        return 23 if label < 23
        return 27

    def in_kind(label: i64, of: i64) -> bool:
        return label >= kind_start(of) and label < kind_end(of)

    def grade(requested: i64) -> Grade:
        r: i64 = requested if requested > 0 else 1
        options: i64 = 2 if r < 3 else (3 if r < 5 else (4 if r < 11 else (6 if r < 14 else 8)))
        near: i64 = 0 if r < 5 else (1 if r < 8 else options - 1)
        raw: f64 = 16.0 - 0.6 * (r - 1).f64()
        raw_seconds: f64 = raw if raw > 4.0 else 4.0
        # round(x, 1): the seconds sit nowhere near a half tenth.
        seconds: f64 = floor(raw_seconds * 10.0 + 0.5) / 10.0
        # need_for(10, 1 / options) against ceil(skill * 10).
        chance_need: i64 = 9 if options == 2 else (7 if options == 3 else (6 if options == 4 else (5 if options == 6 else 4)))
        skill_need: i64 = 8 if r < 8 else (7 if r < 11 else 6)
        need: i64 = chance_need if chance_need > skill_need else skill_need
        return Grade{rung: r, options: options, near: near, neutral: r >= 11, plain: r < 5, seconds: seconds, need: need}

    def without(list: darray[i64]&, label: i64) -> bool:
        can Abort.Panic:
            for item in list:
                return false if item == label
            return true

    def item_of(level: Grade, comment: Comment&, truth: i64, draw: mutable MT19937&) -> ReadingQuiz::Item:
        can Memory.Allocate, Abort.Panic:
            same: mutable darray[i64] = []
            if truth == NEUTRAL:
                for label in 0..<NEUTRAL |same|:
                    same.push(label)
            else:
                for label in kind_start(truth)..<kind_end(truth) |same, truth|:
                    same.push(label) if label != truth
            far: mutable darray[i64] = []
            for label in 0..<NEUTRAL |far, truth|:
                far.push(label) if label != truth and not in_kind(label, truth)
            others: mutable darray[i64] = []
            if level.near >= level.options - 1:
                pool: mutable darray[i64] = same
                pool.push(NEUTRAL) if level.neutral and truth != NEUTRAL
                py_shuffle_i64(draw, &pool)
                for i in 0..<pool.count.i64() |others, pool, level|:
                    others.push(pool[i.usize()]) if i < level.options - 1
            else:
                py_shuffle_i64(draw, &same)
                py_shuffle_i64(draw, &far)
                for i in 0..<same.count.i64() |others, same, level|:
                    others.push(same[i.usize()]) if i < level.near
                if level.options >= 3 and not (truth >= 23 and truth < NEUTRAL):
                    opens: mutable darray[i64] = []
                    for label in 23..<NEUTRAL |opens, others|:
                        opens.push(label) if without(&others, label)
                    others.push(opens[py_choice_index(draw, opens.count.i64()).usize()])
                room: i64 = level.options - 1 - others.count.i64()
                added: mutable i64 = 0
                fresh: mutable darray[i64] = []
                for label in far |fresh, others|:
                    fresh.push(label) if without(&others, label)
                for label in fresh |others, added, room|:
                    if added < room:
                        others.push(label)
                        added <- added + 1
            return zeroed if others.count.i64() < level.options - 1
            opts: mutable darray[i64] = []
            for i in 0..<(level.options - 1) |opts, others|:
                opts.push(others[i.usize()])
            opts.push(truth)
            py_shuffle_i64(draw, &opts)
            words: mutable darray[dstr] = []
            answer: mutable i64 = 0
            for i in 0..<opts.count.i64() |words, opts, answer, truth|:
                word: mutable dstr = []
                dstr_append_cstr(&word, label_name(opts[i.usize()]))
                words.push(word)
                answer <- i if opts[i.usize()] == truth
            ask: mutable dstr = []
            dstr_append_cstr(&ask, "What does the writer feel?")
            prompt: mutable dstr = []
            dstr_append_cstr(&prompt, "“")
            for byte in comment.text |prompt|:
                prompt.push(byte)
            dstr_append_cstr(&prompt, "”")
            steps: darray[ReadingQuiz::Step] = [ReadingQuiz::Step{ask: ask, options: words, answer: answer, wide: false, values: []}]
            return ReadingQuiz::Item{prompt: prompt, steps: steps, seconds: level.seconds, title: "A comment", truth: [], tolerance: 0.0, scored: false}

    def build(level: Grade, draw: mutable MT19937&, corpus: Corpus&) -> Round:
        can Memory.Allocate, Abort.Panic:
            labels: mutable darray[i64] = []
            if level.plain:
                for i in 0..<8 |labels, corpus|:
                    label: i64 = plain_label(i)
                    labels.push(label) if corpus.by_label[label.usize()].count > 0.usize()
            else:
                for label in 0..<NEUTRAL |labels, corpus|:
                    labels.push(label) if corpus.by_label[label.usize()].count > 0.usize()
            labels.push(NEUTRAL) if level.neutral and corpus.by_label[NEUTRAL.usize()].count > 0.usize()
            return zeroed if labels.count == 0.usize()
            items: mutable darray[ReadingQuiz::Item] = []
            for _ in 0..<ITEMS |items, labels, level, draw, corpus|:
                truth: i64 = labels[py_choice_index(draw, labels.count.i64()).usize()]
                pool: darray[Comment] = corpus.by_label[truth.usize()]
                comment: Comment = pool[py_choice_index(draw, pool.count.i64()).usize()]
                item: ReadingQuiz::Item = item_of(level, &comment, truth, draw)
                return zeroed if item.steps.count == 0.usize()
                items.push(item)
            return Round{level: level, quiz: ReadingQuiz::Round{items: items, need: level.need}}

    def deal(level: Grade, draw: mutable MT19937&, corpus: Corpus&) -> Round:
        can Memory.Allocate, Abort.Panic:
            for _ in 0..<40 |level, draw, corpus|:
                next: mutable MT19937 = zeroed
                mt_seed_int(&next, py_getrandbits(draw, 32))
                round: Round = build(level, &next, corpus)
                # The reference player answers every comment immediately, so
                # every built round clears the score and time checks.
                return round if round.quiz.items.count > 0.usize()
            return zeroed
