# Stateful Numberology run controller.
#
# Numberology's source task is a typed, generated sequence puzzle.  The
# generator remains in `tasks/numberology.elisa`; this adapter owns the
# cross-call lifecycle, the typed answer buffer, the session result count, and
# the display strings consumed by SceneNumberology.  The browser therefore
# cannot replace a generated answer with a canned table entry.

module NumberologyGame:

    const MAX_TERMS: i64 = 64
    const MAX_TYPED_DIGITS: i64 = 31

    const PHASE_READY: i64 = 0
    const PHASE_WORKING: i64 = 1
    const PHASE_JUDGED: i64 = 2
    const PHASE_DONE: i64 = 3

    const ACTION_START: i64 = 0
    const ACTION_WRITE: i64 = 1
    const ACTION_BACKSPACE: i64 = 2
    const ACTION_SUBMIT: i64 = 3

    const INFO_PHASE: i64 = 0
    const INFO_LEVEL: i64 = 1
    const INFO_TRIAL: i64 = 2
    const INFO_TOTAL_TRIALS: i64 = 3
    const INFO_SHOWN: i64 = 4
    const INFO_ANSWER: i64 = 5
    const INFO_TYPED_VALUE: i64 = 6
    const INFO_TYPED_LENGTH: i64 = 7
    const INFO_VERDICT: i64 = 8
    const INFO_ADAPTIVE: i64 = 9
    const INFO_RIGHT: i64 = 10
    const INFO_RULE: i64 = 11
    const INFO_COMPLEXITY: i64 = 12
    const INFO_NEXT_LEVEL: i64 = 13

    struct NumberologyRun:
        rng: mutable MT19937
        start_level: mutable i64
        level: mutable i64
        total_trials: mutable i64
        adaptive: mutable bool
        generation_failed: mutable bool
        trial: mutable i64
        shown: mutable i64
        answer: mutable i64
        rule_id: mutable i64
        rule_a: mutable i64
        rule_b: mutable i64
        rule_c: mutable i64
        complexity: mutable i64
        phase: mutable i64
        verdict: mutable i64
        typed_value: mutable i64
        typed_negative: mutable bool
        typed_length: mutable i64
        typed_digits: mutable i64[31]
        terms: mutable i64[64]
        text_pointer: mutable i64
        text_capacity: mutable i64
        text_length: mutable i64
        answer_start: mutable i64
        typed_pointer: mutable i64
        typed_capacity: mutable i64
        right: mutable i64

    def clamp_level(value: i64) -> i64:
        can Abort.Panic:
            return 1 if value < 1 else value

    def clamp_trials(value: i64) -> i64:
        can Abort.Panic:
            return 1 if value < 1 else value

    def allowed_trials(value: i64) -> bool:
        can Abort.Panic:
            return value == 1 or value == 2 or value == 3 or value == 5 or value == 6 or value == 8 or value == 10 or value == 15

    def clear_typed(run: mutable NumberologyRun&):
        can Abort.Panic:
            run.typed_value <- 0
            run.typed_negative <- false
            run.typed_length <- 0
            for at in 0..<MAX_TYPED_DIGITS |at, run|:
                run.typed_digits[at.usize()] <- 0

    def clear_puzzle(run: mutable NumberologyRun&):
        can Abort.Panic:
            run.shown <- 0
            run.text_length <- 0
            run.answer_start <- 0
            run.answer <- -1
            run.rule_id <- 0
            run.rule_a <- 0
            run.rule_b <- 0
            run.rule_c <- 0
            run.complexity <- 0
            for at in 0..<MAX_TERMS |at, run|:
                run.terms[at.usize()] <- 0

    # Heap buffers survive the generation region and grow with actual data.
    # They are released by dispose at the end of the run's lifetime.
    def reserve_text(run: mutable NumberologyRun&, needed: i64) -> bool:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            return true if needed <= run.text_capacity
            return false if needed <= 0 or needed > 1073741823
            capacity: mutable i64 = 256 if run.text_capacity == 0 else run.text_capacity
            while capacity < needed |capacity, needed|:
                return false if capacity > 536870911
                capacity <- capacity * 2
            trusted Unsafe.PointerCast:
                old: mutable heap void&? = run.text_pointer.uintptr().cast[mutable heap void&?]
                raw: mutable heap void&? = realloc(old, capacity.usize())
                return false if raw == null
                run.text_pointer <- raw.uintptr().i64()
            run.text_capacity <- capacity
            return true

    def reserve_typed(run: mutable NumberologyRun&, needed: i64) -> bool:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            return true if needed <= run.typed_capacity
            return false if needed <= 0 or needed > 1073741823
            capacity: mutable i64 = 32 if run.typed_capacity == 0 else run.typed_capacity
            while capacity < needed |capacity, needed|:
                return false if capacity > 536870911
                capacity <- capacity * 2
            trusted Unsafe.PointerCast:
                old: mutable heap void&? = run.typed_pointer.uintptr().cast[mutable heap void&?]
                raw: mutable heap void&? = realloc(old, capacity.usize())
                return false if raw == null
                run.typed_pointer <- raw.uintptr().i64()
            run.typed_capacity <- capacity
            return true

    def byte_at(pointer: i64, at: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                data: heap u8& = pointer.uintptr().cast[heap u8&]
                return data[at.usize()].i64()

    def dispose(run: mutable NumberologyRun&):
        can Memory.Release, Abort.Panic, Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                free(run.text_pointer.uintptr().cast[heap void&]) if run.text_pointer != 0
                free(run.typed_pointer.uintptr().cast[heap void&]) if run.typed_pointer != 0
            run.text_pointer <- 0
            run.typed_pointer <- 0
            run.text_capacity <- 0
            run.typed_capacity <- 0

    # Legacy scalar readers return zero for values outside i64; the exact
    # decimal bytes remain available through value() and the display list.
    def scalar(pointer: i64, first: i64, length: i64, negative: bool) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            result: mutable i64 = 0
            for at in first..<(first + length) |at, pointer, result|:
                digit: i64 = byte_at(pointer, at) - 48
                return 0 if digit < 0 or digit > 9
                return 0 if result < -922337203685477580 or (result == -922337203685477580 and digit > 8)
                result <- result * 10 - digit
            return result if negative else (0 if result == -9223372036854775807 - 1 else 0 - result)

    def decimal_digits(value: i64) -> i64:
        can Abort.Panic:
            remaining: mutable i64 = value
            digits: mutable i64 = 1
            while remaining >= 10 |remaining, digits|:
                remaining <- remaining / 10
                digits <- digits + 1
            return digits

    # Reserve before opening the scratch arena. Allocating persistent text on
    # top of that arena would keep the entire arena pinned until run disposal.
    def text_bound(level: i64) -> i64:
        can Abort.Panic:
            shown: i64 = Numberology::sequence_length(level, 0)
            degree: i64 = 1 + level / 18
            digits: i64 = decimal_digits(shown + 1)
            order_digits: i64 = decimal_digits(shown + 1)
            return 0 if degree > 1073741823 / digits or shown > 1073741823 / (order_digits + 2)
            per: i64 = (degree + 1) * digits + shown * (order_digits + 2) + 32
            return 0 if per <= 0 or shown + 1 > 1073741823 / per
            return (shown + 1) * per

    def scalar_fits(pointer: i64, first: i64, length: i64, negative: bool) -> bool:
        can Abort.Panic, Unsafe.PointerCast:
            return false if length <= 0
            result: mutable i64 = 0
            for at in first..<(first + length) |at, pointer, result|:
                digit: i64 = byte_at(pointer, at) - 48
                return false if digit < 0 or digit > 9
                return false if result < -922337203685477580 or (result == -922337203685477580 and digit > 8)
                result <- result * 10 - digit
            return negative or result != -9223372036854775807 - 1

    def generate_puzzle(run: mutable NumberologyRun&, deal_seed: i64) -> bool:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            bound: i64 = text_bound(run.level)
            return false if bound <= 0 or not reserve_text(run, bound)
            generated: mutable bool = false
            region generation(268435456):
                in generation:
                    puzzle: mutable NumberologyExact::NumberologyExactPuzzle = NumberologyExact::generate(run.level, deal_seed)
                    length: i64 = puzzle.text.count.i64()
                    if length > 0 and length <= run.text_capacity:
                        trusted Unsafe.PointerCast:
                            target: mutable heap u8& = run.text_pointer.uintptr().cast[mutable heap u8&]
                            memcpy(target.cast[mutable void&], (&puzzle.text[0]).cast[void&], length.usize())
                        run.text_length <- length
                        run.answer_start <- 0
                        for at in 0..<length |at, run, puzzle|:
                            run.answer_start <- at + 1 if Bytes::at_ref(&puzzle.text, at) == 10.u8()
                        run.shown <- puzzle.shown
                        run.rule_id <- puzzle.rule_id
                        run.rule_a <- puzzle.rule_a
                        run.rule_b <- puzzle.rule_b
                        run.rule_c <- puzzle.rule_c
                        run.complexity <- puzzle.complexity
                        generated <- run.shown >= 4 and run.answer_start < length
                    destroy generation
            return generated

    def start_run(run: mutable NumberologyRun&, now_ms: i64):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            run.level <- clamp_level(run.start_level)
            run.generation_failed <- false
            run.trial <- 0
            run.right <- 0
            run.verdict <- -1
            clear_typed(run)
            clear_puzzle(run)
            next_trial(run, now_ms)

    def next_trial(run: mutable NumberologyRun&, now_ms: i64):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            if run.trial >= run.total_trials:
                if run.adaptive and run.right == run.total_trials and run.total_trials > 0:
                    run.start_level <- run.level + 1
                run.phase <- PHASE_DONE
                run.verdict <- -1
                clear_typed(run)
                return
            run.trial <- run.trial + 1
            deal_seed: i64 = py_randbelow(&run.rng, 1073741824.u64()).i64()
            clear_puzzle(run)
            clear_typed(run)
            run.verdict <- -1
            if generate_puzzle(run, deal_seed):
                run.phase <- PHASE_WORKING
            else:
                run.generation_failed <- true
                run.phase <- PHASE_DONE

    def initialize(run: mutable NumberologyRun&, start_level: i64, total_trials: i64,
                   adaptive: bool, seed: i64):
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            run.rng <- rng
            run.text_pointer <- 0
            run.text_capacity <- 0
            run.text_length <- 0
            run.answer_start <- 0
            run.typed_pointer <- 0
            run.typed_capacity <- 0
            run.start_level <- clamp_level(start_level)
            run.level <- run.start_level
            run.total_trials <- clamp_trials(total_trials)
            run.adaptive <- adaptive
            run.generation_failed <- false
            run.trial <- 0
            run.right <- 0
            run.phase <- PHASE_READY
            run.verdict <- -1
            clear_typed(run)
            clear_puzzle(run)

    def append_typed(out: mutable dstr&, run: NumberologyRun&):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            if run.typed_negative: dstr_append_cstr(out, "-")
            for at in 0..<run.typed_length |at, out, run|:
                out.push(byte_at(run.typed_pointer, at).u8())

    def append_asked(out: mutable dstr&, run: NumberologyRun&):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            for at in 0..<run.answer_start |at, out, run|:
                byte: i64 = byte_at(run.text_pointer, at)
                if byte == 10: dstr_append_cstr(out, ",   ")
                else: out.push(byte.u8())
            dstr_append_cstr(out, "?")

    def append_answer(out: mutable dstr&, run: NumberologyRun&):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            for at in run.answer_start..<run.text_length |at, out, run|:
                out.push(byte_at(run.text_pointer, at).u8())

    def append_rule(out: mutable dstr&, run: NumberologyRun&):
        can Memory.Allocate, Abort.Panic:
            if run.rule_id == Numberology::RULE_ADD_CONST:
                dstr_append_cstr(out, "Add ")
                dstr_append_i64(out, run.rule_a)
                dstr_append_cstr(out, " each time")
            elif run.rule_id == Numberology::RULE_ADD_SAME:
                dstr_append_cstr(out, "Add the same number each time")
            elif run.rule_id == Numberology::RULE_MUL_OFFSET:
                dstr_append_cstr(out, "Multiply, then add the offset")
            elif run.rule_id == Numberology::RULE_POLYNOMIAL:
                dstr_append_cstr(out, "Evaluate a degree-")
                dstr_append_i64(out, run.rule_a)
                dstr_append_cstr(out, " polynomial at consecutive integers")
            elif run.rule_id == Numberology::RULE_ALTERNATING:
                dstr_append_cstr(out, "Add alternating, growing steps")
            elif run.rule_id == Numberology::RULE_RECURRENCE:
                dstr_append_cstr(out, "order-")
                dstr_append_i64(out, run.rule_a)
                dstr_append_cstr(out, " recurrence with degree-")
                dstr_append_i64(out, run.rule_b)
                dstr_append_cstr(out, " polynomial and ")
                dstr_append_i64(out, run.rule_c)
                dstr_append_cstr(out, " periodic layers")

    def append_message(out: mutable dstr&, run: NumberologyRun&):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            if run.phase == PHASE_READY:
                dstr_append_cstr(out, "Press Space to start")
            elif run.phase == PHASE_WORKING:
                dstr_append_cstr(out, "Difficulty ")
                dstr_append_i64(out, run.level)
            elif run.phase == PHASE_JUDGED:
                if run.verdict == 1:
                    dstr_append_cstr(out, "Right")
                else:
                    dstr_append_cstr(out, "No — the answer was ")
                    append_answer(out, run)
            else:
                if run.generation_failed:
                    dstr_append_cstr(out, "Could not generate a sequence at this level")
                elif run.right == run.total_trials and run.total_trials > 0:
                    if run.adaptive:
                        dstr_append_cstr(out, "Perfect session — next level ")
                        dstr_append_i64(out, run.start_level)
                    else:
                        dstr_append_cstr(out, "Perfect session — level ")
                        dstr_append_i64(out, run.level)
                else:
                    dstr_append_i64(out, run.right)
                    dstr_append_cstr(out, " of ")
                    dstr_append_i64(out, run.total_trials)
                    dstr_append_cstr(out, " correct — level stays at ")
                    dstr_append_i64(out, run.level)

    def write_digit(run: mutable NumberologyRun&, code: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            return 2 if run.phase != PHASE_WORKING
            if code == 45:
                return 2 if run.typed_length != 0 or run.typed_negative
                run.typed_negative <- true
                return 1
            return 2 if code < 48 or code > 57
            return 2 if not reserve_typed(run, run.typed_length + 1)
            trusted Unsafe.PointerCast:
                text: mutable heap u8& = run.typed_pointer.uintptr().cast[mutable heap u8&]
                text[run.typed_length.usize()] <- code.u8()
            run.typed_length <- run.typed_length + 1
            return 1

    def erase(run: mutable NumberologyRun&) -> i64:
        can Abort.Panic:
            return 2 if run.phase != PHASE_WORKING or (run.typed_length == 0 and not run.typed_negative)
            if run.typed_length > 0: run.typed_length <- run.typed_length - 1
            else: run.typed_negative <- false
            return 1

    def matches(run: NumberologyRun&) -> bool:
        can Abort.Panic, Unsafe.PointerCast:
            return false if run.typed_length == 0
            typed_at: mutable i64 = 0
            while typed_at < run.typed_length - 1 and byte_at(run.typed_pointer, typed_at) == 48 |typed_at, run|:
                typed_at <- typed_at + 1
            answer_at: mutable i64 = run.answer_start
            answer_negative: bool = byte_at(run.text_pointer, answer_at) == 45
            answer_at <- answer_at + 1 if answer_negative
            length: i64 = run.typed_length - typed_at
            return false if length != run.text_length - answer_at
            zero: bool = length == 1 and byte_at(run.typed_pointer, typed_at) == 48
            return false if not zero and run.typed_negative != answer_negative
            for at in 0..<length |at, run, typed_at, answer_at|:
                return false if byte_at(run.typed_pointer, typed_at + at) != byte_at(run.text_pointer, answer_at + at)
            return true

    def submit_answer(run: mutable NumberologyRun&) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return 2 if run.phase != PHASE_WORKING or (run.typed_length == 0 and not run.typed_negative)
            run.verdict <- 1 if matches(run) else 0
            run.right <- run.right + 1 if run.verdict == 1 else run.right
            run.phase <- PHASE_JUDGED
            return 1

    def apply(run: mutable NumberologyRun&, action: i64, value: i64, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            if action == ACTION_START:
                return 2 if run.phase == PHASE_WORKING
                if run.phase == PHASE_JUDGED:
                    next_trial(run, now_ms)
                else:
                    if run.phase == PHASE_DONE:
                        run.start_level <- clamp_level(run.start_level)
                    else:
                        run.start_level <- clamp_level(run.start_level)
                    start_run(run, now_ms)
                return 1
            elif action == ACTION_WRITE:
                return write_digit(run, value)
            elif action == ACTION_BACKSPACE:
                return erase(run)
            elif action == ACTION_SUBMIT:
                return submit_answer(run)
            return -6

    def info(run: NumberologyRun&, field: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            if field == INFO_PHASE: return run.phase
            if field == INFO_LEVEL: return run.level
            if field == INFO_TRIAL: return run.trial
            if field == INFO_TOTAL_TRIALS: return run.total_trials
            if field == INFO_SHOWN: return run.shown
            if field == INFO_ANSWER:
                return -1 if run.text_length <= run.answer_start
                neg: bool = byte_at(run.text_pointer, run.answer_start) == 45
                return scalar(run.text_pointer, run.answer_start + (1 if neg else 0), run.text_length - run.answer_start - (1 if neg else 0), neg)
            if field == INFO_TYPED_VALUE: return scalar(run.typed_pointer, 0, run.typed_length, run.typed_negative)
            if field == INFO_TYPED_LENGTH: return run.typed_length
            if field == INFO_VERDICT: return run.verdict
            if field == INFO_ADAPTIVE: return 1 if run.adaptive else 0
            if field == INFO_RIGHT: return run.right
            if field == INFO_RULE: return run.rule_id
            if field == INFO_COMPLEXITY: return run.complexity
            if field == INFO_NEXT_LEVEL: return run.start_level
            if field == 14: return run.answer_start
            if field == 15: return run.text_length - run.answer_start if run.phase == PHASE_JUDGED else 0
            if field == 16: return run.typed_length
            if field == 17:
                return 0 if run.text_length <= run.answer_start
                neg: bool = byte_at(run.text_pointer, run.answer_start) == 45
                return 1 if scalar_fits(run.text_pointer, run.answer_start + (1 if neg else 0), run.text_length - run.answer_start - (1 if neg else 0), neg) else 0
            if field == 18: return 1 if scalar_fits(run.typed_pointer, 0, run.typed_length, run.typed_negative) else 0
            if field == 19: return 1 if run.generation_failed else 0
            if field == 20: return 1 if run.typed_negative else 0
            return -1

    def term(run: NumberologyRun&, at: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return -1 if at < 0 or at >= run.shown
            start: mutable i64 = 0
            row: mutable i64 = 0
            while row < at |row, at, start, run|:
                while start < run.answer_start and byte_at(run.text_pointer, start) != 10 |start, run|: start <- start + 1
                start <- start + 1
                row <- row + 1
            end: mutable i64 = start
            while end < run.answer_start and byte_at(run.text_pointer, end) != 10 |end, run|: end <- end + 1
            neg: bool = byte_at(run.text_pointer, start) == 45
            return scalar(run.text_pointer, start + (1 if neg else 0), end - start - (1 if neg else 0), neg)

    def value(run: NumberologyRun&, field: i64, at: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return -1 if at < 0
            if field == 0: return -1 if at >= run.answer_start else byte_at(run.text_pointer, at)
            if field == 1: return -1 if at >= run.typed_length else byte_at(run.typed_pointer, at)
            if field == 2: return -1 if run.phase != PHASE_JUDGED or at >= run.text_length - run.answer_start else byte_at(run.text_pointer, run.answer_start + at)
            return -1

    def render(run: NumberologyRun&, black_background: bool, width: f64, height: f64,
               list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            asked: mutable dstr = []
            rule: mutable dstr = []
            typed: mutable dstr = []
            message: mutable dstr = []
            verdict_text: mutable dstr = []
            if run.phase == PHASE_WORKING or run.phase == PHASE_JUDGED:
                append_asked(&asked, run)
                append_typed(&typed, run)
            if run.phase == PHASE_JUDGED:
                append_rule(&rule, run)
                dstr_append_cstr(&verdict_text, "Right" if run.verdict == 1 else "No")
            append_message(&message, run)
            sx: f64 = width / Display::REFERENCE_WIDTH
            sy: f64 = height / Display::REFERENCE_HEIGHT
            paint: SceneNumberology::NumberologyPaint = SceneNumberology::paint_of(
                black_background, width, height, sx, sy)
            SceneNumberology::render(list, &paint, run.phase,
                run.shown > 0, bytes_view(asked), bytes_view(rule),
                bytes_view(typed), run.trial, run.total_trials,
                bytes_view(message), run.verdict, bytes_view(verdict_text))
