# Stateful Numberology run controller.
#
# Numberology's source task is a typed, generated sequence puzzle.  The
# generator remains in `tasks/numberology.elisa`; this adapter owns the
# cross-call lifecycle, the typed answer buffer, the session result count, and
# the display strings consumed by SceneNumberology.  The browser therefore
# cannot replace a generated answer with a canned table entry.

module NumberologyGame:

    const MAX_TERMS: i64 = 64
    const MAX_TYPED_DIGITS: i64 = 31

    const PHASE_READY: i64 = 0
    const PHASE_WORKING: i64 = 1
    const PHASE_JUDGED: i64 = 2
    const PHASE_DONE: i64 = 3

    const ACTION_START: i64 = 0
    const ACTION_WRITE: i64 = 1
    const ACTION_BACKSPACE: i64 = 2
    const ACTION_SUBMIT: i64 = 3

    const INFO_PHASE: i64 = 0
    const INFO_LEVEL: i64 = 1
    const INFO_TRIAL: i64 = 2
    const INFO_TOTAL_TRIALS: i64 = 3
    const INFO_SHOWN: i64 = 4
    const INFO_ANSWER: i64 = 5
    const INFO_TYPED_VALUE: i64 = 6
    const INFO_TYPED_LENGTH: i64 = 7
    const INFO_VERDICT: i64 = 8
    const INFO_ADAPTIVE: i64 = 9
    const INFO_RIGHT: i64 = 10
    const INFO_RULE: i64 = 11
    const INFO_COMPLEXITY: i64 = 12
    const INFO_NEXT_LEVEL: i64 = 13

    struct NumberologyRun:
        rng: mutable MT19937
        start_level: mutable i64
        level: mutable i64
        total_trials: mutable i64
        adaptive: mutable bool
        trial: mutable i64
        shown: mutable i64
        answer: mutable i64
        rule_id: mutable i64
        rule_a: mutable i64
        rule_b: mutable i64
        rule_c: mutable i64
        complexity: mutable i64
        phase: mutable i64
        verdict: mutable i64
        typed_value: mutable i64
        typed_negative: mutable bool
        typed_length: mutable i64
        typed_digits: mutable i64[31]
        terms: mutable i64[64]
        right: mutable i64

    def clamp_level(value: i64) -> i64:
        can Abort.Panic:
            return 1 if value < 1 else value

    def clamp_trials(value: i64) -> i64:
        can Abort.Panic:
            return 1 if value < 1 else value

    def allowed_trials(value: i64) -> bool:
        can Abort.Panic:
            return value == 1 or value == 2 or value == 3 or value == 5 or value == 6 or value == 8 or value == 10 or value == 15

    def clear_typed(run: mutable NumberologyRun&):
        can Abort.Panic:
            run.typed_value <- 0
            run.typed_negative <- false
            run.typed_length <- 0
            for at in 0..<MAX_TYPED_DIGITS |at, run|:
                run.typed_digits[at.usize()] <- 0

    def clear_puzzle(run: mutable NumberologyRun&):
        can Abort.Panic:
            run.shown <- 0
            run.answer <- -1
            run.rule_id <- 0
            run.rule_a <- 0
            run.rule_b <- 0
            run.rule_c <- 0
            run.complexity <- 0
            for at in 0..<MAX_TERMS |at, run|:
                run.terms[at.usize()] <- 0

    # Copy the generated darray before leaving the temporary generation region.
    # The fixed arrays are the only state retained between ABI calls.
    def generate_puzzle(run: mutable NumberologyRun&, deal_seed: i64) -> bool:
        can Memory.Allocate, Abort.Panic:
            generated: mutable bool = false
            region generation(134217728):
                in generation:
                    puzzle: Numberology::SeqPuzzle = Numberology::generate(
                        run.level, deal_seed, 0)
                    run.shown <- puzzle.shown if puzzle.shown < MAX_TERMS else MAX_TERMS
                    run.answer <- puzzle.answer
                    run.rule_id <- puzzle.rule_id
                    run.rule_a <- puzzle.rule_a
                    run.rule_b <- puzzle.rule_b
                    run.rule_c <- puzzle.rule_c
                    run.complexity <- puzzle.complexity
                    at: mutable i64 = 0
                    while at < MAX_TERMS |at, run, puzzle|:
                        run.terms[at.usize()] <- Ints::at(puzzle.terms, at) if at < run.shown else 0
                        at <- at + 1
                    generated <- run.shown >= 4
                destroy generation
            return generated

    def start_run(run: mutable NumberologyRun&, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            run.level <- clamp_level(run.start_level)
            run.trial <- 0
            run.right <- 0
            run.verdict <- -1
            clear_typed(run)
            clear_puzzle(run)
            next_trial(run, now_ms)

    def next_trial(run: mutable NumberologyRun&, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            if run.trial >= run.total_trials:
                if run.adaptive and run.right == run.total_trials and run.total_trials > 0:
                    run.start_level <- run.level + 1
                run.phase <- PHASE_DONE
                run.verdict <- -1
                clear_typed(run)
                return
            run.trial <- run.trial + 1
            deal_seed: i64 = py_randbelow(&run.rng, 1073741824.u64()).i64()
            clear_puzzle(run)
            clear_typed(run)
            run.verdict <- -1
            if generate_puzzle(run, deal_seed):
                run.phase <- PHASE_WORKING
            else:
                run.phase <- PHASE_DONE

    def initialize(run: mutable NumberologyRun&, start_level: i64, total_trials: i64,
                   adaptive: bool, seed: i64):
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            run.rng <- rng
            run.start_level <- clamp_level(start_level)
            run.level <- run.start_level
            run.total_trials <- clamp_trials(total_trials)
            run.adaptive <- adaptive
            run.trial <- 0
            run.right <- 0
            run.phase <- PHASE_READY
            run.verdict <- -1
            clear_typed(run)
            clear_puzzle(run)

    def append_typed(out: mutable dstr&, run: NumberologyRun&):
        can Memory.Allocate, Abort.Panic:
            return if run.typed_length <= 0
            if run.typed_negative:
                dstr_append_cstr(out, "-")
            for at in 0..<run.typed_length |at, out, run|:
                out.push((48 + run.typed_digits[at.usize()]).u8())

    def append_asked(out: mutable dstr&, run: NumberologyRun&):
        can Memory.Allocate, Abort.Panic:
            at: mutable i64 = 0
            while at < run.shown |at, out, run|:
                dstr_append_i64(out, run.terms[at.usize()])
                dstr_append_cstr(out, ",   ")
                at <- at + 1
            dstr_append_cstr(out, "?")

    def append_rule(out: mutable dstr&, run: NumberologyRun&):
        can Memory.Allocate, Abort.Panic:
            if run.rule_id == Numberology::RULE_ADD_CONST:
                dstr_append_cstr(out, "Add ")
                dstr_append_i64(out, run.rule_a)
                dstr_append_cstr(out, " each time")
            elif run.rule_id == Numberology::RULE_ADD_SAME:
                dstr_append_cstr(out, "Add the same number each time")
            elif run.rule_id == Numberology::RULE_MUL_OFFSET:
                dstr_append_cstr(out, "Multiply, then add the offset")
            elif run.rule_id == Numberology::RULE_POLYNOMIAL:
                dstr_append_cstr(out, "Evaluate a degree-")
                dstr_append_i64(out, run.rule_a)
                dstr_append_cstr(out, " polynomial at consecutive integers")
            elif run.rule_id == Numberology::RULE_ALTERNATING:
                dstr_append_cstr(out, "Add alternating, growing steps")
            elif run.rule_id == Numberology::RULE_RECURRENCE:
                dstr_append_cstr(out, "order-")
                dstr_append_i64(out, run.rule_a)
                dstr_append_cstr(out, " recurrence with degree-")
                dstr_append_i64(out, run.rule_b)
                dstr_append_cstr(out, " polynomial and ")
                dstr_append_i64(out, run.rule_c)
                dstr_append_cstr(out, " periodic layers")

    def append_message(out: mutable dstr&, run: NumberologyRun&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == PHASE_READY:
                dstr_append_cstr(out, "Press Space to start")
            elif run.phase == PHASE_WORKING:
                dstr_append_cstr(out, "Difficulty ")
                dstr_append_i64(out, run.level)
            elif run.phase == PHASE_JUDGED:
                if run.verdict == 1:
                    dstr_append_cstr(out, "Right")
                else:
                    dstr_append_cstr(out, "No — the answer was ")
                    dstr_append_i64(out, run.answer)
            else:
                if run.right == run.total_trials and run.total_trials > 0:
                    if run.adaptive:
                        dstr_append_cstr(out, "Perfect session — next level ")
                        dstr_append_i64(out, run.start_level)
                    else:
                        dstr_append_cstr(out, "Perfect session — level ")
                        dstr_append_i64(out, run.level)
                else:
                    dstr_append_i64(out, run.right)
                    dstr_append_cstr(out, " of ")
                    dstr_append_i64(out, run.total_trials)
                    dstr_append_cstr(out, " correct — level stays at ")
                    dstr_append_i64(out, run.level)

    def write_digit(run: mutable NumberologyRun&, code: i64) -> i64:
        can Abort.Panic:
            return 2 if run.phase != PHASE_WORKING
            if code == 45:
                return 2 if run.typed_length != 0 or run.typed_negative
                run.typed_negative <- true
                return 1
            return 2 if code < 48 or code > 57
            return 2 if run.typed_length >= MAX_TYPED_DIGITS
            digit: i64 = code - 48
            # The Elisa source kernel is i64. Keep the overflow guard in a
            # form that is valid for both compiler stages: evaluating
            # `I64_MAX - digit` in the Stage0 wasm backend can lose the
            # endpoint refinement and reject ordinary first digits. The
            # quotient/remainder split is equivalent for digit ∈ [0, 9] and
            # never constructs an out-of-range intermediate.
            return 2 if run.typed_value > 922337203685477580
            return 2 if run.typed_value == 922337203685477580 and digit > 7
            run.typed_digits[run.typed_length.usize()] <- digit
            run.typed_length <- run.typed_length + 1
            run.typed_value <- run.typed_value * 10 + digit
            return 1

    def erase(run: mutable NumberologyRun&) -> i64:
        can Abort.Panic:
            return 2 if run.phase != PHASE_WORKING or (run.typed_length == 0 and not run.typed_negative)
            if run.typed_length > 0:
                run.typed_length <- run.typed_length - 1
                run.typed_digits[run.typed_length.usize()] <- 0
                value: mutable i64 = 0
                at: mutable i64 = 0
                while at < run.typed_length |at, run, value|:
                    value <- value * 10 + run.typed_digits[at.usize()]
                    at <- at + 1
                run.typed_value <- value
            else:
                run.typed_negative <- false
            return 1

    def submit_answer(run: mutable NumberologyRun&) -> i64:
        can Abort.Panic:
            return 2 if run.phase != PHASE_WORKING or run.typed_length <= 0
            submitted: i64 = run.typed_value if not run.typed_negative else 0 - run.typed_value
            run.verdict <- 1 if submitted == run.answer else 0
            run.right <- run.right + 1 if run.verdict == 1 else run.right
            run.phase <- PHASE_JUDGED
            return 1

    def apply(run: mutable NumberologyRun&, action: i64, value: i64, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            if action == ACTION_START:
                return 2 if run.phase == PHASE_WORKING
                if run.phase == PHASE_JUDGED:
                    next_trial(run, now_ms)
                else:
                    if run.phase == PHASE_DONE:
                        run.start_level <- clamp_level(run.start_level)
                    else:
                        run.start_level <- clamp_level(run.start_level)
                    start_run(run, now_ms)
                return 1
            elif action == ACTION_WRITE:
                return write_digit(run, value)
            elif action == ACTION_BACKSPACE:
                return erase(run)
            elif action == ACTION_SUBMIT:
                return submit_answer(run)
            return -6

    def info(run: NumberologyRun&, field: i64) -> i64:
        can Abort.Panic:
            if field == INFO_PHASE: return run.phase
            if field == INFO_LEVEL: return run.level
            if field == INFO_TRIAL: return run.trial
            if field == INFO_TOTAL_TRIALS: return run.total_trials
            if field == INFO_SHOWN: return run.shown
            if field == INFO_ANSWER: return run.answer
            if field == INFO_TYPED_VALUE: return run.typed_value if not run.typed_negative else 0 - run.typed_value
            if field == INFO_TYPED_LENGTH: return run.typed_length
            if field == INFO_VERDICT: return run.verdict
            if field == INFO_ADAPTIVE: return 1 if run.adaptive else 0
            if field == INFO_RIGHT: return run.right
            if field == INFO_RULE: return run.rule_id
            if field == INFO_COMPLEXITY: return run.complexity
            if field == INFO_NEXT_LEVEL: return run.start_level
            return -1

    def term(run: NumberologyRun&, at: i64) -> i64:
        can Abort.Panic:
            return -1 if at < 0 or at >= run.shown else run.terms[at.usize()]

    def render(run: NumberologyRun&, black_background: bool, width: f64, height: f64,
               list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            asked: mutable dstr = []
            rule: mutable dstr = []
            typed: mutable dstr = []
            message: mutable dstr = []
            verdict_text: mutable dstr = []
            if run.phase == PHASE_WORKING or run.phase == PHASE_JUDGED:
                append_asked(&asked, run)
                append_typed(&typed, run)
            if run.phase == PHASE_JUDGED:
                append_rule(&rule, run)
                dstr_append_cstr(&verdict_text, "Right" if run.verdict == 1 else "No")
            append_message(&message, run)
            sx: f64 = width / Display::REFERENCE_WIDTH
            sy: f64 = height / Display::REFERENCE_HEIGHT
            paint: SceneNumberology::NumberologyPaint = SceneNumberology::paint_of(
                black_background, width, height, sx, sy)
            SceneNumberology::render(list, &paint, run.phase,
                run.shown > 0, bytes_view(asked), bytes_view(rule),
                bytes_view(typed), run.trial, run.total_trials,
                bytes_view(message), run.verdict, bytes_view(verdict_text))
