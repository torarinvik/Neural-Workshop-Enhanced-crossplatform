include "./heavier.elisa"

module HeavierGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = Heavier::PORTS
    const FEEDBACK: f64 = 2.5
    const NEUTRAL: i64 = -1

    struct Session:
        rng: mutable MT19937
        start_rung: mutable i64
        total: mutable i64
        adaptive: mutable bool
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        run: mutable Heavier::Run
        last_tick: mutable f64
        deadline: mutable f64
        wins: mutable i64
        best_rung: mutable i64
        held_keys: mutable i64
        pulse: mutable i64
        pointer_lane: mutable i64

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Session:
        rng: mutable MT19937 = zeroed
        magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
        mt_seed_int(&rng, magnitude)
        initial: i64 = rung if rung > 0 else 1
        return Session{rng: rng, start_rung: initial, total: total, adaptive: adaptive,
            rung: initial, trial: 0, phase: READY, run: zeroed, last_tick: 0.0, deadline: 0.0,
            wins: 0, best_rung: 0, held_keys: 0, pulse: NEUTRAL, pointer_lane: NEUTRAL}

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 10 or total == 20

    def reconfigure(session: mutable Session&, rung: i64, total: i64, adaptive: bool) -> bool:
        return false if session.phase != READY and session.phase != DONE
        return false if not allowed_rung(rung) or not allowed_total(total)
        session.start_rung <- rung
        session.rung <- rung
        session.total <- total
        session.adaptive <- adaptive
        session.phase <- READY
        session.trial <- 0
        session.wins <- 0
        session.best_rung <- 0
        session.run <- zeroed
        _ = clear_controls(session)
        return true

    def next_trial(session: mutable Session&, now: f64):
        can Abort.Panic:
            session.last_tick <- now
            session.pulse <- NEUTRAL
            if session.trial >= session.total:
                session.phase <- DONE
                return
            deal: Heavier::Deal = Heavier::deal(session.rung, &session.rng)
            if not deal.valid:
                session.run <- zeroed
                session.phase <- READY
                return
            session.run <- Heavier::start(deal.round)
            session.trial <- session.trial + 1
            session.phase <- PLAYING

    def valid_time(session: Session&, now: f64) -> bool:
        return now >= session.last_tick and now <= 9007199254740.0

    def start(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic:
            return false if not valid_time(session, now)
            return false if session.total <= 0 or (session.phase != READY and session.phase != DONE)
            session.rung <- session.start_rung
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            next_trial(session, now)
            return session.phase == PLAYING

    def steer(session: mutable Session&, port: i64) -> bool:
        can Abort.Panic:
            return false if session.phase != PLAYING or port < 0 or port >= Heavier::PORTS
            if port >= Heavier::FIRST_PICK:
                return Heavier::answer(&session.run, port - Heavier::FIRST_PICK)
            return false if port >= session.run.round.level.crates
            session.pulse <- port
            return true

    def key(session: mutable Session&, crate: i64, down: bool) -> bool:
        return false if crate < 0 or crate >= Heavier::FIRST_PICK
        bit: i64 = 1 << crate
        before: i64 = session.held_keys
        session.held_keys <- (before | bit) if down else (before & ~bit)
        return session.held_keys != before

    def pointer(session: mutable Session&, crate: i64) -> bool:
        return false if crate < NEUTRAL or crate >= Heavier::FIRST_PICK
        changed: bool = session.pointer_lane != crate
        session.pointer_lane <- crate
        return changed

    def clear_controls(session: mutable Session&) -> bool:
        changed: bool = session.held_keys != 0 or session.pointer_lane != NEUTRAL
        session.held_keys <- 0
        session.pointer_lane <- NEUTRAL
        return changed

    def held(session: Session&) -> i64:
        can Abort.Panic:
            n: i64 = session.run.round.level.crates
            keys: i64 = session.held_keys
            for port in 0..<n |keys|:
                return port if ((keys >> port) & 1) != 0
            return session.pointer_lane if session.pointer_lane < n else NEUTRAL

    def judge(session: mutable Session&, now: f64):
        passed: bool = session.run.result == Heavier::CLEAR
        if passed:
            session.wins <- session.wins + 1
            session.best_rung <- session.rung if session.rung > session.best_rung
        if session.adaptive:
            session.rung <- session.rung + 1 if passed and session.rung < 9223372036854775807
            session.rung <- session.rung - 1 if not passed and session.rung > 1
        session.deadline <- now + FEEDBACK
        session.phase <- JUDGED

    def advance(session: mutable Session&, now: f64, stepped: bool = false) -> bool:
        can Abort.Panic:
            return false if not valid_time(session, now)
            if session.phase == JUDGED:
                return false if not stepped and now < session.deadline
                next_trial(session, now)
                return true
            return false if session.phase != PLAYING
            dt: f64 = fmin(0.1, now - session.last_tick)
            session.last_tick <- now
            port: i64 = session.pulse if session.pulse != NEUTRAL else held(session)
            session.pulse <- NEUTRAL
            steps: i64 = fmax(1.0, ceil(dt / (1.0 / 120.0))).i64()
            quantum: f64 = dt / steps.f64()
            for _ in 0..<steps |session, port, quantum|:
                Heavier::step(&session.run, quantum, port)
                break if session.run.result != Heavier::LIVE
            if session.run.result != Heavier::LIVE:
                judge(session, now)
            return true

    def agent_event(session: mutable Session&, now: f64, port: i64) -> bool:
        can Abort.Panic:
            return false if not valid_time(session, now)
            return start(session, now) if port == START
            return advance(session, now, true) if port == NEUTRAL
            return steer(session, port)


    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return session.wins if field == 4
            return session.best_rung if field == 5
            return session.start_rung if field == 6
            return (1 if session.adaptive else 0) if field == 7
            return session.run.result if field == 8
            return py_round_half_even(session.run.t * 1000.0) if field == 9
            return session.run.board if field == 10
            return session.run.right if field == 11
            return session.run.round.level.crates if field == 12
            return held(session) if field == 13
            if field >= 14 and field < 18:
                return py_round_half_even(session.run.x[(field - 14).usize()] * 1000.0)
            return -1
