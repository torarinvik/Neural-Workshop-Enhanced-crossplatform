include "../pyrandom.elisa"
include "../pymath.elisa"

module Browser:
    # browser.py: a drawn web shop, a shopping list, and a pointer to do it
    # with. A round deals a small shop -- departments, product lists that
    # sort and run over pages, a page per product, a cart -- and a goal on
    # a card: *buy the cheapest kettle that is in stock*. Everything here is
    # in screen units of a 1000 by 640 window whose y runs down.
    const SCREEN_W: f64 = 1000.0
    const SCREEN_H: f64 = 640.0
    # The page area: everything below the toolbar.
    const VIEW_TOP: f64 = 74.0
    const SCROLL: f64 = 120.0
    const PER_PAGE: i64 = 8
    const ROW_H: i64 = 44
    const LIST_TOP: i64 = 110
    const KIND_COUNT: i64 = 8
    const BRAND_COUNT: i64 = 14
    const SHOP_COUNT: i64 = 5
    # The most departments, products per department, and things to buy.
    const MOST_DEPARTMENTS: i64 = 5
    const MOST_PRODUCTS: i64 = 120
    const MOST_BUYS: i64 = 3

    # What a goal asks for.
    const NAMED: i64 = 0
    const CHEAPEST: i64 = 1
    const CHEAPEST_IN_STOCK: i64 = 2
    const LOWEST_TOTAL: i64 = 3
    const RATED: i64 = 4
    const BEST_RATED: i64 = 5

    # List orders.
    const FEATURED: i64 = 0
    const BY_PRICE: i64 = 1
    const BY_RATING: i64 = 2

    struct Grade:
        rung: i64
        departments: i64
        products: i64
        # What the goals ask for: the first `criteria_count` entries.
        criteria_count: i64
        criteria: i64[4]
        buys: i64
        sorting: bool
        stock: bool
        shipping: bool
        paged: bool
        stale: bool
        # The share of the thorough shopper's extra clicks par allows.
        slack: f64

    struct Product:
        product: mutable i64
        department: mutable i64
        # The name is BRANDS[brand], a space, the first letter of
        # KINDS[kind], and number.
        brand: mutable i64
        kind: mutable i64
        number: mutable i64
        price: mutable i64
        # The price the lists show, out of date from rung 18.
        listed: mutable i64
        rating: mutable f64
        stock: mutable bool
        shipping: mutable i64

    struct Deal:
        seed: mutable i64
        level: mutable Grade
        shop: mutable i64
        # KINDS index of each department.
        kinds: mutable i64[5]
        product_count: mutable i64
        products: mutable Product[120]
        # The deal on the home page.
        featured: mutable i64
        goal_count: mutable i64
        goal_criteria: mutable i64[3]
        goal_departments: mutable i64[3]
        targets: mutable i64[3]

    def kind_name(kind: i64) -> cstr:
        return "Kettles" if kind == 0
        return "Lamps" if kind == 1
        return "Chairs" if kind == 2
        return "Backpacks" if kind == 3
        return "Headphones" if kind == 4
        return "Tents" if kind == 5
        return "Blenders" if kind == 6
        return "Desks"

    # A kind in a sentence: lower case, without the plural s.
    def kind_singular(kind: i64) -> cstr:
        return "kettle" if kind == 0
        return "lamp" if kind == 1
        return "chair" if kind == 2
        return "backpack" if kind == 3
        return "headphone" if kind == 4
        return "tent" if kind == 5
        return "blender" if kind == 6
        return "desk"

    def kind_lower(kind: i64) -> cstr:
        return "kettles" if kind == 0
        return "lamps" if kind == 1
        return "chairs" if kind == 2
        return "backpacks" if kind == 3
        return "headphones" if kind == 4
        return "tents" if kind == 5
        return "blenders" if kind == 6
        return "desks"

    # The first letter of a kind: Backpacks and Blenders share theirs.
    def kind_letter(kind: i64) -> i64:
        letters: i64[8] = [75, 76, 67, 66, 72, 84, 66, 68]
        return letters[kind.usize()]

    def brand_name(brand: i64) -> cstr:
        names: array[cstr, 14] = ["Brava", "Norde", "Kelto", "Vimra", "Ostra", "Lumio", "Pexa", "Quill", "Rayo", "Sorn",
            "Tavo", "Ulma", "Wendt", "Zephi"]
        return names[brand.usize()]

    def shop_name(shop: i64) -> cstr:
        return "brightmart" if shop == 0
        return "cornerstore" if shop == 1
        return "goodshelf" if shop == 2
        return "homeline" if shop == 3
        return "shopwise"

    def shop_title(shop: i64) -> cstr:
        return "Brightmart" if shop == 0
        return "Cornerstore" if shop == 1
        return "Goodshelf" if shop == 2
        return "Homeline" if shop == 3
        return "Shopwise"

    def grade(requested: i64) -> Grade:
        r: i64 = requested if requested > 0 else 1
        criteria: mutable i64[4] = [NAMED, 0, 0, 0]
        count: mutable i64 = 1
        if r >= 12:
            criteria <- [CHEAPEST_IN_STOCK, LOWEST_TOTAL, RATED, BEST_RATED]
            count <- 4
        elif r >= 9:
            criteria[0] <- LOWEST_TOTAL
        elif r >= 6:
            criteria[0] <- CHEAPEST_IN_STOCK
        elif r >= 3:
            criteria[0] <- CHEAPEST
        departments: i64 = 1 + (r - 1) / 4
        products: i64 = 1 + r
        late: f64 = 0.3 - 0.025 * (r - 20).f64()
        slack: f64 = (1.0 - 0.7 * (r - 1).f64() / 19.0) if r <= 20 else (late if late > 0.05 else 0.05)
        return Grade{rung: r, departments: departments if departments < 5 else 5,
            products: products if products < 24 else 24, criteria_count: count, criteria: criteria,
            buys: 1 if r < 15 else (2 if r < 21 else 3), sorting: r >= 3, stock: r >= 6,
            shipping: r >= 9, paged: r >= 12, stale: r >= 18, slack: slack}

    # _score: what a criterion ranks a product by, smallest first.
    def score(criterion: i64, product: Product&) -> f64:
        return (product.price + product.shipping).f64() if criterion == LOWEST_TOTAL
        return -product.rating if criterion == BEST_RATED
        return product.price.f64()

    # Whether a criterion keeps a product at all.
    def eligible(criterion: i64, product: Product&) -> bool:
        return true if criterion == CHEAPEST
        return product.stock and product.rating >= 4.0 if criterion == RATED
        return product.stock

    # matches: the products a criterion picks from a department, best
    # first. Python's sort is stable, so ties keep their list order.
    def matches(dealt: Deal&, criterion: i64, department: i64) -> darray[i64]:
        can Memory.Allocate, Abort.Panic:
            ranked: mutable darray[i64] = []
            for index in 0..<dealt.product_count |ranked, dealt, criterion, department|:
                product: Product = dealt.products[index.usize()]
                continue if product.department != department or not eligible(criterion, &product)
                ranked.push(index)
                j: mutable i64 = ranked.count.i64() - 1
                while j > 0 and score(criterion, &dealt.products[ranked[(j - 1).usize()].usize()]) > score(criterion, &product) |j, ranked, dealt, criterion, product, index|:
                    ranked[j.usize()] <- ranked[(j - 1).usize()]
                    ranked[(j - 1).usize()] <- index
                    j <- j - 1
            return ranked

    # The products of one department, in list order.
    def in_department(dealt: Deal&, department: i64) -> darray[i64]:
        can Memory.Allocate, Abort.Panic:
            found: mutable darray[i64] = []
            for index in 0..<dealt.product_count |found, dealt, department|:
                found.push(index) if dealt.products[index.usize()].department == department
            return found

    def same_name(one: Product&, two: Product&) -> bool:
        return one.brand == two.brand and one.number == two.number and kind_letter(one.kind) == kind_letter(two.kind)

    # _try_deal: one attempt, false when its goals have no single answer.
    def try_deal(level: Grade, seed: i64, draw: mutable MT19937&, out: mutable Deal&) -> bool:
        can Memory.Allocate, Abort.Panic:
            picked: darray[i64] = py_sample_range(draw, 0, KIND_COUNT - 1, level.departments)
            out.seed <- seed
            out.level <- level
            out.product_count <- 0
            for department in 0..<level.departments |out, picked|:
                out.kinds[department.usize()] <- picked[department.usize()]
            for department in 0..<level.departments |out, draw, level|:
                for _ in 0..<level.products |out, draw, level, department|:
                    made: mutable Product = zeroed
                    made.product <- out.product_count
                    made.department <- department
                    made.kind <- out.kinds[department.usize()]
                    unique: mutable bool = false
                    while not unique |unique, made, out, draw|:
                        made.brand <- py_choice_index(draw, BRAND_COUNT)
                        made.number <- py_randint(draw, 1, 99)
                        unique <- true
                        for index in 0..<out.product_count |unique, made, out|:
                            unique <- false if same_name(&out.products[index.usize()], &made)
                    made.price <- py_randint(draw, 12, 240)
                    made.listed <- made.price
                    if level.stale and py_random(draw) < 0.3:
                        sign: i64 = -1 if py_choice_index(draw, 2) == 0 else 1
                        moved: i64 = made.price + sign * py_randint(draw, 5, 40)
                        made.listed <- moved if moved > 5 else 5
                    made.rating <- py_round_decimal(py_uniform(draw, 1.5, 5.0), 10.0)
                    made.stock <- py_random(draw) < 0.65 if level.stock else true
                    shipping: i64[5] = [0, 5, 9, 15, 25]
                    made.shipping <- shipping[py_choice_index(draw, 5).usize()] if level.shipping else 0
                    out.products[out.product_count.usize()] <- made
                    out.product_count <- out.product_count + 1
            wanted: i64 = level.buys if level.buys < level.departments else level.departments
            shopped: darray[i64] = py_sample_range(draw, 0, level.departments - 1, wanted)
            out.goal_count <- 0
            for department in shopped |out, draw, level|:
                criterion: i64 = level.criteria[py_choice_index(draw, level.criteria_count).usize()]
                target: mutable i64 = 0
                if criterion == NAMED:
                    items: darray[i64] = in_department(out, department)
                    target <- items[py_choice_index(draw, items.count.i64()).usize()]
                else:
                    ranked: darray[i64] = matches(out, criterion, department)
                    return false if ranked.count == 0.usize()
                    best: Product = out.products[ranked[0].usize()]
                    if ranked.count > 1.usize():
                        return false if score(criterion, &best) == score(criterion, &out.products[ranked[1].usize()])
                    target <- ranked[0]
                    # Often enough, the list's own order is the trap.
                    return false if level.stale and best.listed == best.price and py_random(draw) < 0.5
                out.goal_criteria[out.goal_count.usize()] <- criterion
                out.goal_departments[out.goal_count.usize()] <- department
                out.targets[out.goal_count.usize()] <- target
                out.goal_count <- out.goal_count + 1
            out.featured <- py_randrange(draw, 0, out.product_count)
            out.shop <- py_choice_index(draw, SHOP_COUNT)
            return true

    # deal: a seed from the run's generator, then attempts until one has a
    # single answer per goal. Python gives up after 500; so does this, with
    # an empty deal.
    def deal(rung: i64, run: mutable MT19937&) -> Deal:
        can Memory.Allocate, Abort.Panic:
            seed: i64 = py_randrange(run, 0, 1073741824)
            return deal_seeded(grade(rung), seed)

    def deal_seeded(level: Grade, seed: i64) -> Deal:
        can Memory.Allocate, Abort.Panic:
            draw: mutable MT19937 = zeroed
            mt_seed_int(&draw, seed.u64())
            out: mutable Deal = zeroed
            for _ in 0..<500 |draw, out, level, seed|:
                return out if try_deal(level, seed, &draw, &out)
            return zeroed
