include "./errands_par.elisa"

module ErrandsText:
    # The words errands.py and ui/errands.py put on screen: each mail's
    # sender, subject, body and time, wrap(), the claims, and the verdict.
    const WRAP: i64 = 86

    def sender(out: mutable dstr&, mail: Errands::Mail&):
        can Memory.Allocate, Abort.Panic:
            kind: i64 = mail.kind
            if kind == Errands::POLICY or kind == Errands::PAID:
                dstr_append_cstr(out, "Accounts")
            elif kind == Errands::NEWSLETTER:
                dstr_append_cstr(out, "Newsletter")
            else:
                dstr_append_cstr(out, Errands::person_name(mail.person))

    def subject(out: mutable dstr&, mail: Errands::Mail&):
        can Memory.Allocate, Abort.Panic:
            kind: i64 = mail.kind
            if kind == Errands::RECEIPT:
                dstr_append_cstr(out, "Receipt to claim")
            elif kind == Errands::POLICY:
                dstr_append_cstr(out, "Which category? (please keep)")
            elif kind == Errands::ORDER:
                dstr_append_cstr(out, "Order for ")
                dstr_append_cstr(out, Errands::reason_words(mail.reason))
            elif kind == Errands::CHANGE:
                dstr_append_cstr(out, "Change of plan")
            elif kind == Errands::NEWSLETTER:
                dstr_append_cstr(out, "This week: 20% off everything")
            elif kind == Errands::LUNCH:
                dstr_append_cstr(out, "Lunch?")
            elif kind == Errands::PAID:
                dstr_append_cstr(out, "Claim #")
                dstr_append_i64(out, mail.number)
                dstr_append_cstr(out, " paid")
            else:
                dstr_append_cstr(out, "Done: last week's order")

    def two_digits(out: mutable dstr&, value: i64):
        can Memory.Allocate, Abort.Panic:
            out.push(48.u8()) if value < 10
            dstr_append_i64(out, value)

    def time(out: mutable dstr&, mail: Errands::Mail&):
        can Memory.Allocate, Abort.Panic:
            two_digits(out, mail.minutes / 60)
            out.push(58.u8())
            two_digits(out, mail.minutes % 60)

    # What an ORDER or CHANGE asks for.
    def wanted(out: mutable dstr&, dealt: Errands::Deal&, mail: Errands::Mail&):
        can Memory.Allocate, Abort.Panic:
            if mail.kind == Errands::ORDER and mail.changed:
                if mail.decoy < 0:
                    dstr_append_cstr(out, "two of them")
                else:
                    # Products are dealt department by department.
                    first: i64 = mail.decoy * dealt.shop.level.products
                    BrowserText::phrase_for(out, &dealt.shop, Browser::CHEAPEST, mail.decoy, first)
                return
            BrowserText::phrase(out, &dealt.shop, mail.goal)

    def claim_words(out: mutable dstr&, dealt: Errands::Deal&, mail: Errands::Mail&):
        can Memory.Allocate, Abort.Panic:
            return if dealt.level.policy
            dstr_append_cstr(out, " File the expense under ")
            dstr_append_cstr(out, Errands::category_name(dealt.categories[mail.goal.usize()]))
            dstr_append_cstr(out, ".")

    def policy_body(out: mutable dstr&, dealt: Errands::Deal&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_cstr(out, "When you claim for something you bought, use the category for its kind:\n\n")
            department: mutable i64 = 0
            while department < dealt.shop.level.departments |out, dealt, department|:
                out.push(10.u8()) if department > 0
                kind: i64 = dealt.shop.kinds[department.usize()]
                dstr_append_cstr(out, Browser::kind_name(kind))
                dstr_append_cstr(out, ": ")
                dstr_append_cstr(out, Errands::category_name(Errands::category_of(kind)))
                department <- department + 1
            dstr_append_cstr(out, "\n\nAnything else: Office.\n\n-- Accounts")

    def mail_body(out: mutable dstr&, dealt: Errands::Deal&, mail: Errands::Mail&):
        can Memory.Allocate, Abort.Panic:
            kind: i64 = mail.kind
            if kind == Errands::RECEIPT:
                dstr_append_cstr(out, "Hi -- I paid for this with the team card. Could you file an expense claim for it under ")
                dstr_append_cstr(out, Errands::category_name(dealt.receipt.category))
                dstr_append_cstr(out, "?\n\nOrder #")
                dstr_append_i64(out, dealt.receipt.number)
                dstr_append_cstr(out, "\nTotal charged: $")
                dstr_append_i64(out, dealt.receipt.amount)
                dstr_append_cstr(out, "\n\nThanks, ")
                dstr_append_cstr(out, Errands::person_name(mail.person))
            elif kind == Errands::POLICY:
                policy_body(out, dealt)
            elif kind == Errands::ORDER:
                dstr_append_cstr(out, "Hi -- could you order ")
                wanted(out, dealt, mail)
                dstr_append_cstr(out, " from ")
                dstr_append_cstr(out, Browser::shop_name(dealt.shop.shop))
                dstr_append_cstr(out, ".example? Buy it as an order of its own and claim it back.")
                claim_words(out, dealt, mail)
                dstr_append_cstr(out, "\n\nThanks, ")
                dstr_append_cstr(out, Errands::person_name(mail.person))
            elif kind == Errands::CHANGE:
                dstr_append_cstr(out, "Sorry -- scrap my last request. Instead please order ")
                wanted(out, dealt, mail)
                dstr_append_cstr(out, ", on its own as before, and claim it back.")
                claim_words(out, dealt, mail)
                dstr_append_cstr(out, "\n\n")
                dstr_append_cstr(out, Errands::person_name(mail.person))
            elif kind == Errands::NEWSLETTER:
                dstr_append_cstr(out, "Big savings all week in every department. Offer ends Sunday. You are receiving this because you signed up.")
            elif kind == Errands::LUNCH:
                dstr_append_cstr(out, "Anyone up for lunch at one? The usual place.\n\n")
                dstr_append_cstr(out, Errands::person_name(mail.person))
            elif kind == Errands::PAID:
                dstr_append_cstr(out, "Your expense claim #")
                dstr_append_i64(out, mail.number)
                dstr_append_cstr(out, " has been paid. Nothing more to do.\n\n-- Accounts")
            else:
                dstr_append_cstr(out, "Thanks for ordering the chairs last week -- all arrived, nothing more needed.\n\n")
                dstr_append_cstr(out, Errands::person_name(mail.person))

    # wrap: the body's lines, as (start, end) byte pairs into `text`. A
    # line is words joined by single spaces, so it is always a slice.
    def wrap(text: dstr&) -> darray[i64]:
        can Memory.Allocate, Abort.Panic:
            lines: mutable darray[i64] = []
            length: i64 = text.count.i64()
            start: mutable i64 = 0
            while start <= length |lines, start, text, length|:
                stop: mutable i64 = start
                while stop < length and text[stop.usize()] != 10.u8() |stop, text, length|:
                    stop <- stop + 1
                line_start: mutable i64 = start
                line_end: mutable i64 = start
                word: mutable i64 = start
                while word <= stop |word, lines, line_start, line_end, text, stop, start|:
                    word_end: mutable i64 = word
                    while word_end < stop and text[word_end.usize()] != 32.u8() |word_end, text, stop|:
                        word_end <- word_end + 1
                    if line_end > line_start and (line_end - line_start) + 1 + (word_end - word) > WRAP:
                        lines.push(line_start)
                        lines.push(line_end)
                        line_start <- word
                    line_end <- word_end
                    word <- word_end + 1
                lines.push(line_start)
                lines.push(line_end)
                start <- stop + 1
            return lines

    def digits(out: mutable dstr&, typed: ErrandsOffice::Digits&):
        can Memory.Allocate, Abort.Panic:
            for at in 0..<typed.count |out, typed|:
                dstr_append_i64(out, typed.digits[at.usize()])

    def claim(out: mutable dstr&, filed: ErrandsOffice::Claim&):
        can Memory.Allocate, Abort.Panic:
            out.push(35.u8())
            digits(out, &filed.order)
            dstr_append_cstr(out, "  $")
            digits(out, &filed.amount)
            dstr_append_cstr(out, "  ")
            dstr_append_cstr(out, Errands::category_name(filed.category))

    def notice(what: i64) -> cstr:
        return "Claim filed." if what == ErrandsOffice::FILED
        return "Fill in every part of the claim first." if what == ErrandsOffice::INCOMPLETE
        return ""

    # mistakes(), joined by "; " as the verdict shows them.
    def mistakes(out: mutable dstr&, found: ErrandsPar::Mistakes&):
        can Memory.Allocate, Abort.Panic:
            if found.wrong_buys:
                dstr_append_cstr(out, "the wrong things were bought")
                return
            for index in 0..<found.missing_count |out, found|:
                dstr_append_cstr(out, "; ") if index > 0
                dstr_append_cstr(out, "no right claim for order ")
                digits(out, &found.missing[index.usize()])
            if found.extra > 0:
                dstr_append_cstr(out, "; ") if found.missing_count > 0
                dstr_append_i64(out, found.extra)
                dstr_append_cstr(out, " claim(s) that should not be there")
