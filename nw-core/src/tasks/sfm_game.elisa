include "./sfm.elisa"

module ShapeFromMotionGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = ShapeFromMotion::MAX_CHOICES
    const FEEDBACK: f64 = 2.5

    struct Run:
        start_rung: i64
        total: i64
        adaptive: bool
        rng: mutable MT19937
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        puzzle: mutable ShapeFromMotion::Puzzle
        cloud: mutable ShapeFromMotion::Cloud
        now: mutable f64
        started_at: mutable f64
        deadline: mutable f64
        chosen: mutable i64
        passed: mutable i64
        best: mutable i64
        verdict_published: mutable bool

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 12 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 6 or total == 12 or total == 24 or total == 40

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Run:
        can Abort.Panic:
            start_rung: i64 = rung if rung > 0 else 1
            result: mutable Run = Run{start_rung: start_rung, total: total, adaptive: adaptive,
                rng: zeroed, rung: start_rung, trial: 0, phase: READY, puzzle: zeroed, cloud: zeroed,
                now: 0.0, started_at: 0.0, deadline: 0.0, chosen: -1, passed: 0, best: 0, verdict_published: false}
            mt_seed_int(&result.rng, ShapeFromMotion::seed_magnitude(seed))
            return result

    def next_trial(run: mutable Run&, now: f64) -> bool:
        can Abort.Panic:
            run.now <- now
            if run.trial >= run.total:
                run.phase <- DONE
                return true
            seed: i64 = py_randbelow(&run.rng, 1073741824.u64()).i64()
            run.puzzle <- ShapeFromMotion::deal(run.rung, seed)
            run.trial <- run.trial + 1
            run.started_at <- now
            run.chosen <- -1
            run.verdict_published <- false
            run.phase <- PLAYING
            ShapeFromMotion::update(&run.puzzle, 0.0, &run.cloud)
            return true

    def valid_time(run: Run&, now: f64) -> bool:
        return now >= run.now and now <= 1.7976931348623157e308

    def start(run: mutable Run&, now: f64) -> bool:
        can Abort.Panic:
            return false if not valid_time(run, now) or run.total <= 0
            return false if run.phase != READY and run.phase != DONE
            run.trial <- 0
            run.rung <- run.start_rung
            run.passed <- 0
            run.best <- 0
            return next_trial(run, now)

    def choose(run: mutable Run&, index: i64, now: f64) -> bool:
        can Abort.Panic:
            return false if run.phase != PLAYING or index < 0 or index >= run.puzzle.count or not valid_time(run, now)
            run.now <- now
            ShapeFromMotion::update(&run.puzzle, now - run.started_at, &run.cloud)
            run.chosen <- index
            if index == run.puzzle.answer:
                run.passed <- run.passed + 1
                run.best <- run.rung if run.rung > run.best
                run.rung <- run.rung + 1 if run.adaptive and run.rung < 9223372036854775807
            else:
                run.rung <- run.rung - 1 if run.adaptive and run.rung > 1
            run.deadline <- now + FEEDBACK
            run.phase <- JUDGED
            return true

    def animate(run: mutable Run&, now: f64) -> bool:
        can Abort.Panic:
            run.now <- now
            ShapeFromMotion::update(&run.puzzle, now - run.started_at, &run.cloud)
            return true

    def advance(run: mutable Run&, now: f64) -> bool:
        can Abort.Panic:
            return false if not valid_time(run, now)
            return animate(run, now) if run.phase == PLAYING
            return next_trial(run, now) if run.phase == JUDGED and now >= run.deadline
            return false

    def agent_event(run: mutable Run&, now: f64, action: i64) -> bool:
        can Abort.Panic:
            return false if not valid_time(run, now)
            return start(run, now) if action == START
            return choose(run, action, now) if action >= 0
            return animate(run, now) if run.phase == PLAYING
            if run.phase == JUDGED:
                return next_trial(run, now) if run.verdict_published
                run.now <- now
                run.verdict_published <- true
                return true
            return false
