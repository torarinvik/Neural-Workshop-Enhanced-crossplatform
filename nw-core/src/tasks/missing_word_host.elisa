include "./missing_word_game.elisa"

module MissingWordHost:
    struct Run:
        session: mutable MissingWordGame::Session
        resources: mutable Arena
        corpus: mutable MissingWordGame::Corpus
        loaded: mutable bool

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64) -> Run:
        return Run{session: MissingWordGame::initialize(rung, trials, adaptive, seed),
            resources: zeroed, corpus: zeroed, loaded: false}

    def import_missing_word_caches(run: mutable Run&, passages: sview, sentences: sview, lexicon: sview) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if run.loaded or run.session.phase != MissingWordGame::READY
            owner: mutable Arena& = &run.resources
            in owner:
                run.corpus <- MissingWordGame::cache_corpus(passages, sentences, lexicon)
            if run.corpus.passages.passages.count == 0.usize() or run.corpus.sentences.sentences.count == 0.usize() or
                run.corpus.vocabulary.ordered.count == 0.usize():
                MissingWordGame::release_missing_word_arena(&run.resources) can Global{Read,Write}
                run.corpus <- zeroed
                return false
            run.loaded <- true
            return true

    def start(run: mutable Run&, now: f64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            if not run.loaded:
                _ = import_missing_word_caches(run, "", "", "") can Global{Read,Write}
            return false if not run.loaded
            return MissingWordGame::start(&run.session, &run.corpus, now) can Global{Read,Write}

    def close(run: mutable Run&):
        can Memory.Release, Abort.Panic:
            MissingWordGame::close(&run.session) can Global{Read,Write}
            MissingWordGame::release_missing_word_arena(&run.resources) can Global{Read,Write}
            run.loaded <- false
            run.corpus <- zeroed

    def pointer(run: mutable Run&, x: f64, y: f64, kind: i64, now: f64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            if kind == 1 and (run.session.phase == MissingWordGame::READY or run.session.phase == MissingWordGame::DONE):
                return start(run, now) can Global{Read,Write}
            return MissingWordGame::pointer(&run.session, &run.corpus, x, y, kind, now) can Global{Read,Write}

    def agent_event(run: mutable Run&, now: f64, port: i64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return (start(run, now) can Global{Read,Write}) if port == MissingWordGame::START
            return MissingWordGame::agent_event(&run.session, &run.corpus, now, port) can Global{Read,Write}
