# Count: a tangle of shapes, and how many of them there are.
#
# Port of the portable half of neural_workshop/ui/counting.py
# (GPL-2.0-or-later). The drawing is the shell's; what is here is the tangle
# itself, in fractions of the drawing area, which is what the reference's
# generators produce and what a count is taken from.

extern cos(x: f64) -> f64
extern sin(x: f64) -> f64

module Counting:

    const LINES: i64 = 0
    const CIRCLES: i64 = 1
    const TRIANGLES: i64 = 2
    const RECTANGLES: i64 = 3
    const MIXED: i64 = 4

    # The kinds MIXED draws from, in this order -- `rng.choice` indexes them.
    const MIXED_COUNT: i64 = 4

    # Most shapes a trial will ever show, however well the player does, and
    # fewest, so a wrong answer cannot make the task trivial.
    const MAX_SHAPES: i64 = 60
    const MIN_SHAPES: i64 = 2

    # Shortest line worth counting, as a fraction of the drawing area. Two edge
    # points can land close together, and the stub that makes is a dot.
    const MIN_LINE_SPAN: f64 = 0.3

    # Attempts at a long-enough chord before the fallback is drawn.
    const LINE_TRIES: i64 = 20

    # math.tau, to the bit.
    const TAU: f64 = 6.283185307179586

    # A shape as the count sees it: a kind, up to three points, and a radius
    # for the circles. Lines and rectangles use two points, triangles three.
    struct Shape:
        kind: mutable i64
        points: mutable i64
        x: mutable f64[3]
        y: mutable f64[3]
        radius: mutable f64

    struct Tangle:
        count: mutable i64
        shapes: mutable darray[Shape]

    def new_tangle() -> Tangle:
        can Memory.Allocate, Abort.Panic:
            blank: Shape = zeroed
            out: mutable darray[Shape] = []
            for _slot in 0..<MAX_SHAPES |out, blank|:
                out.push(blank)
            return Tangle{count: 0, shapes: out}

    # A point on one edge of the drawing area. The four edges in the
    # reference's order: bottom, right, top, left.
    def perimeter_x(side: i64, along: f64) -> f64:
        can Abort.Panic:
            return along if side == 0
            return 1.0 if side == 1
            return along if side == 2
            return 0.0

    def perimeter_y(side: i64, along: f64) -> f64:
        can Abort.Panic:
            return 0.0 if side == 0
            return along if side == 1
            return 1.0 if side == 2
            return along

    # A chord from one edge to ANOTHER, ends drawn back inside.
    #
    # Spanning the area is what makes the lines cross each other instead of
    # huddling, and starting from the edges keeps every one inside it -- a line
    # from a centre and a length runs off the canvas and over the labels.
    def random_line(rng: mutable MT19937&) -> Shape:
        can Abort.Panic:
            out: mutable Shape = zeroed
            out.kind <- LINES
            out.points <- 2
            for _attempt in 0..<LINE_TRIES |rng, out|:
                first: i64 = py_randbelow(rng, 4.u64()).i64()
                second: i64 = (first + 1 + py_randbelow(rng, 3.u64()).i64()) % 4
                start_along: f64 = py_uniform(rng, 0.0, 1.0)
                start_x: f64 = perimeter_x(first, start_along)
                start_y: f64 = perimeter_y(first, start_along)
                end_along: f64 = py_uniform(rng, 0.0, 1.0)
                end_x: f64 = perimeter_x(second, end_along)
                end_y: f64 = perimeter_y(second, end_along)
                head: f64 = py_uniform(rng, 0.02, 0.16)
                far_end: f64 = 1.0 - py_uniform(rng, 0.02, 0.16)
                span_x: f64 = end_x - start_x
                span_y: f64 = end_y - start_y
                ax: f64 = start_x + span_x * head
                ay: f64 = start_y + span_y * head
                bx: f64 = start_x + span_x * far_end
                by: f64 = start_y + span_y * far_end
                if py_hypot(ax - bx, ay - by) >= MIN_LINE_SPAN:
                    out.x[0] <- ax
                    out.y[0] <- ay
                    out.x[1] <- bx
                    out.y[1] <- by
                    return out
            out.x[0] <- 0.05
            out.y[0] <- 0.5
            out.x[1] <- 0.95
            out.y[1] <- 0.5
            return out

    def random_circle(rng: mutable MT19937&) -> Shape:
        can Abort.Panic:
            out: mutable Shape = zeroed
            out.kind <- CIRCLES
            out.points <- 1
            radius: f64 = py_uniform(rng, 0.06, 0.18)
            out.radius <- radius
            out.x[0] <- py_uniform(rng, radius, 1.0 - radius)
            out.y[0] <- py_uniform(rng, radius, 1.0 - radius)
            return out

    # Size FIRST, so the centre can be kept a whole radius from the edge and no
    # vertex lands outside the drawing area.
    def random_triangle(rng: mutable MT19937&) -> Shape:
        can Abort.Panic:
            out: mutable Shape = zeroed
            out.kind <- TRIANGLES
            out.points <- 3
            size: f64 = py_uniform(rng, 0.07, 0.17)
            centre_x: f64 = py_uniform(rng, size, 1.0 - size)
            centre_y: f64 = py_uniform(rng, size, 1.0 - size)
            turn: f64 = py_uniform(rng, 0.0, TAU)
            for corner in 0..<3 |out, size, centre_x, centre_y, turn|:
                angle: f64 = turn + corner.f64() * TAU / 3.0
                out.x[corner.usize()] <- centre_x + size * cos(angle)
                out.y[corner.usize()] <- centre_y + size * sin(angle)
            return out

    def random_rectangle(rng: mutable MT19937&) -> Shape:
        can Abort.Panic:
            out: mutable Shape = zeroed
            out.kind <- RECTANGLES
            out.points <- 2
            width: f64 = py_uniform(rng, 0.08, 0.26)
            height: f64 = py_uniform(rng, 0.08, 0.26)
            left: f64 = py_uniform(rng, 0.0, 1.0 - width)
            bottom: f64 = py_uniform(rng, 0.0, 1.0 - height)
            out.x[0] <- left
            out.y[0] <- bottom
            out.x[1] <- left + width
            out.y[1] <- bottom + height
            return out

    def random_shape(kind: i64, rng: mutable MT19937&) -> Shape:
        can Abort.Panic:
            return random_circle(rng) if kind == CIRCLES
            return random_triangle(rng) if kind == TRIANGLES
            return random_rectangle(rng) if kind == RECTANGLES
            return random_line(rng)

    # `count` shapes of the configured kind. MIXED draws a kind per shape, so
    # the choice is part of the stream and not a setting applied afterwards.
    def generate(out: mutable Tangle&, kind: i64, count: i64, rng: mutable MT19937&):
        can Abort.Panic:
            out.count <- 0
            for _index in 0..<count |out, kind, rng|:
                drawn: i64 = py_choice_index(rng, MIXED_COUNT) if kind == MIXED else kind
                out.shapes[out.count.usize()] <- random_shape(drawn, rng)
                out.count <- out.count + 1

    def clamp_shapes(count: i64) -> i64:
        can Abort.Panic:
            lifted: i64 = MIN_SHAPES if count < MIN_SHAPES else count
            return MAX_SHAPES if lifted > MAX_SHAPES else lifted
