# Stateful controller for the source Lookout task.
#
# Lookout's portable kernel already contains the source's difficult parts:
# non-rewinding scatter, shuffled minimum-coverage cue selection, morphs that
# genuinely change identity, drought-forced matches, and signal-detection
# scoring.  The kernel's LookoutRun/Flock values use arena-backed darrays, however,
# so they cannot cross a common-v1 ABI call.  This adapter keeps the durable
# state in fixed WASM-owned arrays and materializes a source LookoutRun/Flock only for
# the duration of one controller operation.  Every scalar and array is copied
# back before the temporary region is destroyed.

module LookoutGame:

    const MAX_SHAPES: i64 = 30
    const MAX_CUES: i64 = 256
    const REFERENCE_WIDTH: f64 = 912.0
    const REFERENCE_HEIGHT: f64 = 684.0

    const PHASE_READY: i64 = 0
    const PHASE_WATCHING: i64 = 1
    const PHASE_FEEDBACK: i64 = 2
    const PHASE_DONE: i64 = 3

    const WATCH_COLOR: i64 = 0
    const WATCH_FORM: i64 = 1
    const WATCH_BOTH: i64 = 2

    const CHANNEL_COLOR: i64 = 0
    const CHANNEL_FORM: i64 = 1

    const ACTION_START: i64 = 0
    const ACTION_COLOR: i64 = 1
    const ACTION_FORM: i64 = 2

    const INFO_PHASE: i64 = 0
    const INFO_WATCHING: i64 = 1
    const INFO_START_COUNT: i64 = 2
    const INFO_COUNT: i64 = 3
    const INFO_SPEED: i64 = 4
    const INFO_MORPH_MS: i64 = 5
    const INFO_TOTAL_CUES: i64 = 6
    const INFO_ADAPTIVE: i64 = 7
    const INFO_CUE_NUMBER: i64 = 8
    const INFO_CUE_COLOR: i64 = 9
    const INFO_CUE_FORM: i64 = 10
    const INFO_HITS: i64 = 11
    const INFO_MISSES: i64 = 12
    const INFO_FALSE_ALARMS: i64 = 13
    const INFO_REACTION_COUNT: i64 = 14
    const INFO_MEAN_MS: i64 = 15
    const INFO_VERDICT: i64 = 16
    const INFO_CLOCK_MS: i64 = 17
    const INFO_UNTIL_MS: i64 = 18
    const INFO_LAST_REACTION_MS: i64 = 19
    const INFO_SHAPE_COUNT: i64 = 20

    const VALUE_X: i64 = 0
    const VALUE_Y: i64 = 1
    const VALUE_VX: i64 = 2
    const VALUE_VY: i64 = 3
    const VALUE_COLOR: i64 = 4
    const VALUE_FORM: i64 = 5
    const VALUE_NEXT_MORPH_MS: i64 = 6

    struct LookoutRun:
        rng: mutable MT19937
        start_count: mutable i64
        watching: mutable i64
        speed_percent: mutable i64
        morph_ms: mutable i64
        total_cues: mutable i64
        adaptive: mutable bool
        speed: mutable f64
        morph_gap: mutable f64
        shape_count: mutable i64
        cue_number: mutable i64
        cue_color: mutable i64
        cue_form: mutable i64
        cued_at_ms: mutable i64
        seen_at: mutable f64[2]
        seen_set: mutable i64[2]
        hits: mutable i64
        misses: mutable i64
        false_alarms: mutable i64
        reaction_count: mutable i64
        reaction_times: mutable f64[256]
        phase: mutable i64
        until_ms: mutable i64
        verdict: mutable i64
        clock_ms: mutable i64
        last_reaction_ms: mutable i64
        message_kind: mutable i64
        message_channel: mutable i64
        x: mutable f64[30]
        y: mutable f64[30]
        vx: mutable f64[30]
        vy: mutable f64[30]
        color: mutable i64[30]
        form: mutable i64[30]
        next_morph_ms: mutable i64[30]

    def allowed_count(value: i64) -> bool:
        can Abort.Panic:
            return value == 3 or value == 4 or value == 5 or value == 6 or value == 8 or value == 10 or value == 12 or value == 15 or value == 20 or value == 25 or value == 30

    def allowed_watching(value: i64) -> bool:
        can Abort.Panic:
            return value == WATCH_COLOR or value == WATCH_FORM or value == WATCH_BOTH

    def allowed_speed(value: i64) -> bool:
        can Abort.Panic:
            return value == 8 or value == 12 or value == 16 or value == 22 or value == 30 or value == 40 or value == 55 or value == 75

    def allowed_morph_ms(value: i64) -> bool:
        can Abort.Panic:
            return value == 800 or value == 1200 or value == 2000 or value == 3000 or value == 5000 or value == 8000

    def allowed_cues(value: i64) -> bool:
        can Abort.Panic:
            return value == 5 or value == 10 or value == 15 or value == 20 or value == 30 or value == 50

    def clear_shapes(run: mutable LookoutRun&):
        can Abort.Panic:
            run.shape_count <- 0
            for at in 0..<MAX_SHAPES |at, run|:
                run.x[at.usize()] <- 0.0
                run.y[at.usize()] <- 0.0
                run.vx[at.usize()] <- 0.0
                run.vy[at.usize()] <- 0.0
                run.color[at.usize()] <- 0
                run.form[at.usize()] <- 0
                run.next_morph_ms[at.usize()] <- 0

    def clear_score(run: mutable LookoutRun&):
        can Abort.Panic:
            run.cue_number <- 0
            run.cue_color <- 0
            run.cue_form <- 0
            run.cued_at_ms <- 0
            run.hits <- 0
            run.misses <- 0
            run.false_alarms <- 0
            run.reaction_count <- 0
            run.phase <- PHASE_READY
            run.until_ms <- 0
            run.verdict <- -1
            run.clock_ms <- 0
            run.last_reaction_ms <- 0
            run.message_kind <- 0
            run.message_channel <- CHANNEL_COLOR
            for channel in 0..<2 |channel, run|:
                run.seen_at[channel.usize()] <- 0.0
                run.seen_set[channel.usize()] <- 0
            for at in 0..<MAX_CUES |at, run|:
                run.reaction_times[at.usize()] <- 0.0

    def copy_source_config(run: LookoutRun&, source: mutable Lookout::LookoutSourceRun&):
        can Abort.Panic:
            source.watching <- run.watching
            source.speed <- run.speed
            source.morph_gap <- run.morph_gap
            source.total_cues <- run.total_cues
            source.adaptive <- run.adaptive
            source.start_count <- run.start_count

    def copy_to_source(run: LookoutRun&, source: mutable Lookout::LookoutSourceRun&):
        can Abort.Panic:
            Lookout::adapter_load(source,
                run.watching, run.speed, run.morph_gap, run.total_cues,
                run.adaptive, run.start_count, run.shape_count,
                run.cue_number, run.cue_color, run.cue_form,
                run.cued_at_ms.f64() / 1000.0, run.hits, run.misses,
                run.false_alarms, run.reaction_count, run.phase,
                run.until_ms.f64() / 1000.0, run.verdict,
                &run.seen_at, &run.seen_set, &run.reaction_times)

    def copy_from_source(run: mutable LookoutRun&, source: Lookout::LookoutSourceRun&):
        can Abort.Panic:
            Lookout::adapter_save(source, &run.shape_count, &run.cue_number,
                &run.cue_color, &run.cue_form, &run.cued_at_ms, &run.hits,
                &run.misses, &run.false_alarms, &run.reaction_count,
                &run.phase, &run.until_ms, &run.verdict,
                &run.seen_at, &run.seen_set, &run.reaction_times)

    def copy_to_flock(run: LookoutRun&, flock: mutable Lookout::LookoutSourceFlock&):
        can Abort.Panic:
            flock.count <- run.shape_count
            for at in 0..<MAX_SHAPES |at, run, flock|:
                Floats::put(&flock.x, at, run.x[at.usize()])
                Floats::put(&flock.y, at, run.y[at.usize()])
                Floats::put(&flock.vx, at, run.vx[at.usize()])
                Floats::put(&flock.vy, at, run.vy[at.usize()])
                Ints::put(&flock.color, at, run.color[at.usize()])
                Ints::put(&flock.form, at, run.form[at.usize()])
                Floats::put(&flock.next_morph, at, run.next_morph_ms[at.usize()].f64() / 1000.0)

    def copy_from_flock(run: mutable LookoutRun&, flock: Lookout::LookoutSourceFlock&):
        can Abort.Panic:
            run.shape_count <- flock.count
            for at in 0..<MAX_SHAPES |at, run, flock|:
                run.x[at.usize()] <- flock.x[at.usize()]
                run.y[at.usize()] <- flock.y[at.usize()]
                run.vx[at.usize()] <- flock.vx[at.usize()]
                run.vy[at.usize()] <- flock.vy[at.usize()]
                run.color[at.usize()] <- flock.color[at.usize()]
                run.form[at.usize()] <- flock.form[at.usize()]
                run.next_morph_ms[at.usize()] <- (flock.next_morph[at.usize()] * 1000.0).i64()

    def start(run: mutable LookoutRun&, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            clear_shapes(run)
            clear_score(run)
            region scratch(268435456):
                in scratch:
                    source: mutable Lookout::LookoutSourceRun = Lookout::new_run()
                    flock: mutable Lookout::LookoutSourceFlock = Lookout::new_flock()
                    copy_to_source(run, &source)
                    Lookout::start_run(&source, &flock, REFERENCE_WIDTH,
                        REFERENCE_HEIGHT, now_ms.f64() / 1000.0, &run.rng)
                    copy_from_source(run, &source)
                    copy_from_flock(run, &flock)
                destroy scratch
            run.clock_ms <- now_ms

    def advance(run: mutable LookoutRun&, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 2 if run.phase == PHASE_READY or run.phase == PHASE_DONE
            delta: i64 = now_ms - run.clock_ms
            bounded: i64 = 100 if delta > 100 else (0 if delta < 0 else delta)
            before_misses: i64 = run.misses
            region scratch(268435456):
                in scratch:
                    source: mutable Lookout::LookoutSourceRun = Lookout::new_run()
                    flock: mutable Lookout::LookoutSourceFlock = Lookout::new_flock()
                    copy_to_source(run, &source)
                    copy_to_flock(run, &flock)
                    Lookout::update(&source, &flock, bounded.f64() / 1000.0,
                        REFERENCE_WIDTH, REFERENCE_HEIGHT,
                        now_ms.f64() / 1000.0, &run.rng)
                    copy_from_source(run, &source)
                    copy_from_flock(run, &flock)
                destroy scratch
            run.clock_ms <- now_ms
            if run.misses > before_misses:
                run.message_kind <- 3
                run.message_channel <- CHANNEL_COLOR
                run.last_reaction_ms <- 0
            return 1 if run.phase != PHASE_WATCHING or bounded > 0 else 2

    def answer(run: mutable LookoutRun&, channel: i64, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 2 if run.phase != PHASE_WATCHING
            return 2 if channel != CHANNEL_COLOR and channel != CHANNEL_FORM
            return 2 if run.watching == WATCH_COLOR and channel != CHANNEL_COLOR
            return 2 if run.watching == WATCH_FORM and channel != CHANNEL_FORM
            seen_at_ms: i64 = (run.seen_at[channel.usize()] * 1000.0).i64()
            before_hits: i64 = run.hits
            before_false: i64 = run.false_alarms
            before_misses: i64 = run.misses
            region scratch(268435456):
                in scratch:
                    source: mutable Lookout::LookoutSourceRun = Lookout::new_run()
                    flock: mutable Lookout::LookoutSourceFlock = Lookout::new_flock()
                    copy_to_source(run, &source)
                    copy_to_flock(run, &flock)
                    Lookout::answer(&source, &flock, channel, REFERENCE_WIDTH,
                        REFERENCE_HEIGHT, now_ms.f64() / 1000.0, &run.rng)
                    copy_from_source(run, &source)
                    copy_from_flock(run, &flock)
                destroy scratch
            run.clock_ms <- now_ms
            run.message_channel <- channel
            if run.hits > before_hits:
                run.message_kind <- 1
                run.last_reaction_ms <- now_ms - seen_at_ms
            elif run.false_alarms > before_false:
                run.message_kind <- 2
                run.last_reaction_ms <- 0
            elif run.misses > before_misses:
                run.message_kind <- 3
                run.last_reaction_ms <- 0
            return 1 if run.phase == PHASE_FEEDBACK else 2

    def mean_ms(run: LookoutRun&) -> i64:
        can Abort.Panic:
            return 0 if run.reaction_count <= 0
            total: mutable f64 = 0.0
            for at in 0..<run.reaction_count |at, run, total|:
                total <- total + run.reaction_times[at.usize()]
            return py_round_half_even(total * 1000.0 / run.reaction_count.f64())

    def info(run: LookoutRun&, field: i64) -> i64:
        can Abort.Panic:
            if field == INFO_PHASE: return run.phase
            if field == INFO_WATCHING: return run.watching
            if field == INFO_START_COUNT: return run.start_count
            if field == INFO_COUNT: return run.shape_count
            if field == INFO_SPEED: return run.speed_percent
            if field == INFO_MORPH_MS: return run.morph_ms
            if field == INFO_TOTAL_CUES: return run.total_cues
            if field == INFO_ADAPTIVE: return 1 if run.adaptive else 0
            if field == INFO_CUE_NUMBER: return run.cue_number
            if field == INFO_CUE_COLOR: return run.cue_color
            if field == INFO_CUE_FORM: return run.cue_form
            if field == INFO_HITS: return run.hits
            if field == INFO_MISSES: return run.misses
            if field == INFO_FALSE_ALARMS: return run.false_alarms
            if field == INFO_REACTION_COUNT: return run.reaction_count
            if field == INFO_MEAN_MS: return mean_ms(run)
            if field == INFO_VERDICT: return run.verdict
            if field == INFO_CLOCK_MS: return run.clock_ms
            if field == INFO_UNTIL_MS: return run.until_ms
            if field == INFO_LAST_REACTION_MS: return run.last_reaction_ms
            if field == INFO_SHAPE_COUNT: return run.shape_count
            return -1

    def value(run: LookoutRun&, field: i64, at: i64) -> i64:
        can Abort.Panic:
            return -1 if at < 0 or at >= run.shape_count
            if field == VALUE_X: return (run.x[at.usize()] * 1000000.0).i64()
            if field == VALUE_Y: return (run.y[at.usize()] * 1000000.0).i64()
            if field == VALUE_VX: return (run.vx[at.usize()] * 1000000.0).i64()
            if field == VALUE_VY: return (run.vy[at.usize()] * 1000000.0).i64()
            if field == VALUE_COLOR: return run.color[at.usize()]
            if field == VALUE_FORM: return run.form[at.usize()]
            if field == VALUE_NEXT_MORPH_MS: return run.next_morph_ms[at.usize()]
            return -1

    def append_message(out: mutable dstr&, run: LookoutRun&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == PHASE_READY:
                dstr_append_cstr(out, "Press Space to start")
            elif run.phase == PHASE_WATCHING:
                dstr_append_cstr(out, "Watch for it")
            elif run.phase == PHASE_FEEDBACK:
                if run.message_kind == 1:
                    dstr_append_cstr(out, "Hit — ")
                    dstr_append_i64(out, run.last_reaction_ms)
                    dstr_append_cstr(out, " ms")
                elif run.message_kind == 2:
                    dstr_append_cstr(out, "No — not on screen")
                else:
                    dstr_append_cstr(out, "It slipped away")
            else:
                dstr_append_i64(out, run.hits)
                dstr_append_cstr(out, " hits, ")
                dstr_append_i64(out, run.misses)
                dstr_append_cstr(out, " slipped away, ")
                dstr_append_i64(out, run.false_alarms)
                dstr_append_cstr(out, " false alarms — ")
                dstr_append_i64(out, mean_ms(run))
                dstr_append_cstr(out, " ms average")

    def render(run: LookoutRun&, black_background: bool, width: f64,
               height: f64, list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            shapes: mutable darray[SceneLookout::Drifter] = []
            for at in 0..<run.shape_count |at, run, shapes|:
                shapes.push(SceneLookout::Drifter{x: run.x[at.usize()],
                    y: run.y[at.usize()], color: run.color[at.usize()],
                    form: run.form[at.usize()]})
            sx: f64 = width / REFERENCE_WIDTH
            sy: f64 = height / REFERENCE_HEIGHT
            paint: SceneLookout::LookoutPaint = SceneLookout::paint_of(
                black_background, width, height, sx, sy)
            message: mutable dstr = []
            append_message(&message, run)
            verdict_text: mutable dstr = []
            if run.verdict == 1:
                dstr_append_i64(&verdict_text, run.last_reaction_ms)
                dstr_append_cstr(&verdict_text, " ms")
            elif run.verdict == 0:
                dstr_append_cstr(&verdict_text, "Miss")
            SceneLookout::render(list, &paint, run.phase, run.watching,
                &shapes, run.cue_color, run.cue_form, run.cue_number,
                run.total_cues, bytes_view(message), run.verdict,
                bytes_view(verdict_text))

    def initialize(run: mutable LookoutRun&, start_count: i64, watching: i64,
                   speed: i64, morph_ms: i64, total_cues: i64,
                   adaptive: bool, seed: i64):
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            run.rng <- rng
            run.start_count <- start_count
            run.watching <- watching
            run.speed_percent <- speed
            run.morph_ms <- morph_ms
            run.total_cues <- total_cues
            run.adaptive <- adaptive
            run.speed <- speed.f64() / 100.0
            run.morph_gap <- morph_ms.f64() / 1000.0
            clear_shapes(run)
            clear_score(run)

    def apply(run: mutable LookoutRun&, action: i64, value: i64, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            if action == ACTION_START:
                return 2 if run.phase != PHASE_READY and run.phase != PHASE_DONE
                start(run, now_ms)
                return 1
            if action == ACTION_COLOR:
                return answer(run, CHANNEL_COLOR, now_ms)
            if action == ACTION_FORM:
                return answer(run, CHANNEL_FORM, now_ms)
            return -6
