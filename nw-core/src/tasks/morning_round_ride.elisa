include "./morning_round_rules.elisa"

module MorningRoundRide:
    const LIVE: i64 = 0
    const CLEAR: i64 = 1
    const TIMEOUT: i64 = 2
    const COMPLAINTS: i64 = 3
    const THREE_FALLS: i64 = 4
    const UNDELIVERED: i64 = 0
    const DELIVERED: i64 = 1
    const WRONG: i64 = 2
    const MISSED: i64 = 3

    const CHIME: i64 = 0
    const SHOUT: i64 = 1
    const HORN: i64 = 2
    const THUD: i64 = 3
    const CRASH: i64 = 4
    const WHOOSH: i64 = 5
    const BELL: i64 = 6

    const LEFT_FRONT: f64 = 470.0
    const RIGHT_FRONT: f64 = 730.0
    const HOUSE_LENGTH: f64 = 104.0
    const PAPER_SPEED: f64 = 640.0
    const COOLDOWN: f64 = 0.15
    const RIDER_RADIUS: f64 = 13.0
    const STEER_SPEED: f64 = 230.0
    const ACCEL: f64 = 160.0
    const FALL: f64 = 1.4

    struct Paper:
        x: f64
        d: f64
        side: i64
        speed: f64

    struct Cue:
        t: f64
        duration: f64
        frequency: f64
        voice: i64
        gain: f64
        pan: f64

    struct Run:
        street: MorningRoundRules::Street
        t: mutable f64
        s: mutable f64
        x: mutable f64
        speed: mutable f64
        papers: mutable i64
        flying: mutable Paper[4]
        flying_count: mutable i64
        got: mutable i64[96]
        known: mutable bool[96]
        known_count: mutable i64
        passed: mutable i64
        falls: mutable i64
        down_until: mutable f64
        hit: mutable bool[96]
        last_throw: mutable f64
        mistakes: mutable i64
        result: mutable i64
        cues: mutable Cue[288]
        cue_count: mutable i64

    def start(street: MorningRoundRules::Street) -> Run:
        return Run{street: street, t: 0.0, s: 0.0, x: 600.0, speed: street.layout.level.speed, papers: street.papers,
            flying: zeroed, flying_count: 0, got: zeroed, known: zeroed, known_count: 0, passed: 0, falls: 0, down_until: -1.0,
            hit: zeroed, last_throw: -9.0, mistakes: 0, result: LIVE, cues: zeroed, cue_count: 0}

    def riding(run: Run&) -> bool:
        return run.t >= run.street.layout.level.brief

    def rulebook_open(run: Run&) -> bool:
        return not run.street.layout.level.memorise or not riding(run)

    def block_at(run: Run&, d: f64) -> i64:
        can Abort.Panic:
            for b in 0..<run.street.layout.level.blocks |run, d|:
                return b if d < run.street.layout.blocks[b.usize()].end + MorningRound::CROSSING / 2.0
            return run.street.layout.level.blocks - 1

    def thing_d(run: Run&, thing: MorningRound::Thing) -> f64:
        return thing.d - thing.speed * fmax(0.0, run.t - run.street.layout.level.brief)

    def front(side: i64) -> f64:
        return LEFT_FRONT if side < 0 else RIGHT_FRONT

    def note(run: mutable Run&, duration: f64, frequency: f64, voice: i64, gain: f64, pan: f64 = 0.0):
        can Abort.Panic:
            run.cues[run.cue_count.usize()] <- Cue{t: run.t, duration: duration, frequency: frequency, voice: voice, gain: gain, pan: pan}
            run.cue_count <- run.cue_count + 1

    def throw(run: mutable Run&, side: i64) -> bool:
        can Abort.Panic:
            return false if not riding(run) or run.result != LIVE or run.t < run.down_until
            return false if run.papers <= 0 or run.t - run.last_throw < COOLDOWN
            run.papers <- run.papers - 1
            run.last_throw <- run.t
            run.flying[run.flying_count.usize()] <- Paper{x: run.x, d: run.s, side: side, speed: run.speed}
            run.flying_count <- run.flying_count + 1
            note(run, 0.05, 900.0, WHOOSH, 0.15, 0.6 * side.f64())
            return true

    def mistake(run: mutable Run&):
        run.mistakes <- run.mistakes + 1
        run.result <- COMPLAINTS if run.mistakes > run.street.layout.level.slack and run.result == LIVE

    def remember(run: mutable Run&, i: usize):
        can Abort.Panic:
            if not run.known[i]:
                run.known[i] <- true
                run.known_count <- run.known_count + 1

    def land(run: mutable Run&, side: i64, d: f64):
        can Abort.Panic:
            pan: f64 = 0.7 * side.f64()
            for i in 0..<run.street.layout.count |run, side, d, pan|:
                h: MorningRound::House = run.street.layout.houses[i.usize()]
                continue if h.side != side or fabs(d - h.d) > HOUSE_LENGTH / 2.0
                if run.got[i.usize()] != UNDELIVERED:
                    note(run, 0.06, 160.0, THUD, 0.2, pan)
                    return
                if MorningRoundRules::pick(run.street.want, i):
                    run.got[i.usize()] <- DELIVERED
                    note(run, 0.35, 990.0, CHIME, 0.45, pan)
                else:
                    run.got[i.usize()] <- WRONG
                    note(run, 0.4, 150.0, SHOUT, 0.5, pan)
                    mistake(run)
                remember(run, i.usize())
                return
            note(run, 0.06, 160.0, THUD, 0.2, pan)

    def fly(run: mutable Run&, dt: f64):
        can Abort.Panic:
            count: mutable i64 = 0
            for i in 0..<run.flying_count |run, dt, count|:
                p: Paper = run.flying[i.usize()]
                x: f64 = p.x + p.side.f64() * PAPER_SPEED * dt
                d: f64 = p.d + p.speed * dt
                if (x - front(p.side)) * p.side.f64() >= 0.0:
                    land(run, p.side, d)
                else:
                    run.flying[count.usize()] <- Paper{x: x, d: d, side: p.side, speed: p.speed}
                    count <- count + 1
            run.flying_count <- count

    def pass_houses(run: mutable Run&):
        can Abort.Panic:
            while run.passed < run.street.layout.count |run|:
                i: usize = run.passed.usize()
                h: MorningRound::House = run.street.layout.houses[i]
                break if run.s <= h.d + HOUSE_LENGTH
                run.passed <- run.passed + 1
                continue if run.got[i] != UNDELIVERED
                remember(run, i)
                if MorningRoundRules::pick(run.street.want, h.i):
                    run.got[i] <- MISSED
                    note(run, 0.45, 300.0, HORN, 0.45, 0.7 * h.side.f64())
                    mistake(run)

    def crash(run: mutable Run&):
        can Abort.Panic:
            return if run.t < run.down_until
            for i in 0..<run.street.traffic.count |run|:
                continue if run.hit[i.usize()]
                thing: MorningRound::Thing = run.street.traffic.things[i.usize()]
                reach: f64 = thing.radius + RIDER_RADIUS
                if fabs(thing_d(run, thing) - run.s) < reach and fabs(thing.x - run.x) < reach:
                    run.hit[i.usize()] <- true
                    run.falls <- run.falls + 1
                    run.down_until <- run.t + FALL
                    note(run, 0.5, 110.0, CRASH, 0.6)
                    run.result <- THREE_FALLS if run.falls >= 3
                    return

    def finish(run: mutable Run&):
        can Abort.Panic:
            run.passed <- run.street.layout.count
            for i in 0..<run.street.layout.count |run|:
                if run.got[i.usize()] == UNDELIVERED and MorningRoundRules::pick(run.street.want, i):
                    run.got[i.usize()] <- MISSED
                    mistake(run)
            if run.result == LIVE:
                run.result <- CLEAR
                note(run, 0.6, 1320.0, BELL, 0.5)

    def step(run: mutable Run&, dt: f64, port: i64):
        can Abort.Panic:
            return if run.result != LIVE
            run.t <- run.t + dt
            if run.t >= run.street.seconds:
                run.result <- TIMEOUT
                return
            return if not riding(run)
            if run.t >= run.down_until:
                if port == MorningRound::LEFT:
                    run.x <- run.x - STEER_SPEED * dt
                elif port == MorningRound::RIGHT:
                    run.x <- run.x + STEER_SPEED * dt
                elif port == MorningRound::FASTER:
                    run.speed <- run.speed + ACCEL * dt
                elif port == MorningRound::SLOWER:
                    run.speed <- run.speed - ACCEL * dt
                run.x <- fmax(MorningRound::LANE_LEFT, fmin(MorningRound::LANE_RIGHT, run.x))
                base: f64 = run.street.layout.level.speed
                run.speed <- fmax(0.6 * base, fmin(1.6 * base, run.speed))
                run.s <- run.s + run.speed * dt
            fly(run, dt)
            crash(run)
            pass_houses(run)
            if run.result == LIVE and run.s >= run.street.layout.length and run.flying_count == 0:
                finish(run)
