include "./drshape_audio.elisa"
include "./glove.elisa"

# Glove's sound: the knock of a catch or the growl of a miss, on the
# reference's three patches (wood, bell, growl, each seeded k + 1).
module GloveAudio:
    def patches() -> DrShapeAudio::Bank:
        can Abort.Panic:
            bank: mutable DrShapeAudio::Bank = zeroed
            bank.count <- 3
            voices: i64[3] = [DrShapeAudio::WOOD, DrShapeAudio::BELL, DrShapeAudio::GROWL]
            draw: mutable MT19937 = zeroed
            for i in 0..<bank.count |bank, draw, voices|:
                mt_seed_int(&draw, (i + 1).u64())
                bank.patches[i.usize()] <- DrShapeAudio::make_patch(voices[i.usize()], &draw, 0.0)
            return bank

    def render(run: Glove::Run&, bank: DrShapeAudio::Bank&, begin: f64, end: f64, output: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return DrShapeAudio::write(&run.notes, bank, begin, end, output, capacity)
