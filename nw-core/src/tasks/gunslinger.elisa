include "../hand_view.elisa"
include "../strings.elisa"

module Gunslinger:
    const COCK: i64 = HandView::KEYS
    const PORTS: i64 = COCK + 1
    const REACH: f64 = 0.28
    const BULLETS: i64 = 6
    const LEATHER: i64 = 0
    const BANG: i64 = 1
    const CLICK: i64 = 2
    const BELL: i64 = 3
    const CROW: i64 = 4
    const WIND: i64 = 5
    const THUD: i64 = 6

    const PENDING: i64 = 0
    const QUICKER: i64 = 1
    const HAT_OFF: i64 = 2
    const FIRST: i64 = 3
    const WRONG_MAN: i64 = 4
    const WRONG_PART: i64 = 5
    const TOO_SLOW: i64 = 6

    struct Grade:
        rung: i64
        men: i64
        quick: f64
        word: bool
        cock: bool
        feints: i64
        others: bool
        hat: bool
        sway: f64
        pace: f64
        beside: bool
        dust: bool

    struct Man:
        x: f64
        z: f64
        hat: i64
        stride: f64
        rate: f64
        phase: f64

    struct Reach:
        time: f64
        who: i64
        real: bool

    struct Duel:
        level: Grade
        valid: mutable bool
        men: mutable Man[6]
        foe: mutable i64
        hat: mutable bool
        notice: mutable dstr
        reaches: mutable Reach[6]
        reach_count: mutable i64
        draw_at: mutable f64
        seed: mutable i64

    struct Box:
        left: f64
        bottom: f64
        right: f64
        top: f64

    struct Target:
        valid: bool
        hat: Box
        body: Box

    struct Shot:
        time: f64
        point: RoomsView::Point

    struct Cue:
        time: f64
        duration: f64
        pitch: f64
        voice: i64
        gain: f64
        pan: f64
        seed: i64

    struct Run:
        duel: Duel
        hand: mutable HandView::Pointer
        time: mutable f64
        cocked: mutable bool
        bullets: mutable i64
        shots: mutable Shot[6]
        shot_count: mutable i64
        hatless: mutable i64
        hat_at: mutable f64[6]
        reach_no: mutable i64
        extra: mutable MT19937
        extra_at: mutable f64
        fell: mutable i64
        fell_at: mutable f64
        notes: mutable darray[Cue]
        record_audio: bool
        result: mutable i64

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        top: i64 = r - 20 if r >= 20 else 0
        return Grade{rung: r, men: 1 if r < 7 else (2 if r < 10 else (3 if r < 16 else (4 + top / 4 if top < 8 else 6))),
            quick: 3.0 if r < 4 else (2.2 if r < 7 else (1.8 if r < 10 else (1.5 if r < 13 else (1.3 if r < 16 else (1.1 if r < 20 else HandView::clamp(1.0 - 0.02 * top.f64(), 0.4, 1.0)))))),
            word: r < 4, cock: r >= 4, feints: 0 if r < 7 else (1 if r < 13 else (2 if r < 20 else (3 + top / 5 if top < 10 else 5))),
            others: r >= 10, hat: r >= 10,
            sway: 0.0 if r < 7 else (6.0 if r < 13 else (10.0 if r < 20 else HandView::clamp(12.0 + 0.5 * top.f64(), 12.0, 26.0))),
            pace: 0.0 if r < 13 else (0.8 if r < 20 else HandView::clamp(1.0 + 0.05 * top.f64(), 1.0, 2.2)),
            beside: r >= 13, dust: r >= 16}

    def hat_name(index: i64) -> cstr:
        return "red" if index == 0
        return "black" if index == 1
        return "white" if index == 2
        return "green" if index == 3
        return "brown" if index == 4
        return "blue"

    def uniform(rng: mutable MT19937&, low: f64, high: f64) -> f64:
        can Abort.Panic:
            return low + (high - low) * py_random(rng)

    def empty(level: Grade) -> Duel:
        can Memory.Allocate:
            return Duel{level: level, valid: false, men: zeroed, foe: 0, hat: false, notice: [],
                reaches: zeroed, reach_count: 0, draw_at: 0.0, seed: 0}

    def describe(duel: mutable Duel&, rng: mutable MT19937&):
        can Memory.Allocate, Abort.Panic:
            n: i64 = duel.level.men
            if n == 1:
                dstr_append_cstr(&duel.notice, "Fire when he draws. Shoot his hat off." if duel.hat else "Fire when he draws, not before.")
                return
            foe: i64 = duel.foe
            if duel.level.dust and py_random(rng) < 0.4:
                dstr_append_cstr(&duel.notice, "Your man is the one who draws")
            elif duel.level.beside and py_random(rng) < 0.6:
                first: i64 = -1 if foe > 0 else 1
                count: i64 = 2 if foe > 0 and foe + 1 < n else 1
                pick: i64 = py_choice_index(rng, count)
                side: i64 = first if pick == 0 else 1
                dstr_append_cstr(&duel.notice, "Your man stands to the left of the " if side > 0 else "Your man stands to the right of the ")
                dstr_append_cstr(&duel.notice, hat_name(duel.men[(foe + side).usize()].hat))
                dstr_append_cstr(&duel.notice, " hat")
            else:
                dstr_append_cstr(&duel.notice, "Your man wears the ")
                dstr_append_cstr(&duel.notice, hat_name(duel.men[foe.usize()].hat))
                dstr_append_cstr(&duel.notice, " hat")
            dstr_append_cstr(&duel.notice, ". Shoot his hat off." if duel.hat else ". Fire when he draws.")

    def separated(duel: Duel&, time: f64) -> bool:
        can Abort.Panic:
            for k in 0..<duel.reach_count |duel, time|:
                return false if HandView::absolute(time - duel.reaches[k.usize()].time) <= 0.9
            return true

    def build(level: Grade, seed: i64) -> Duel:
        can Memory.Allocate, Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
            duel: mutable Duel = empty(level)
            n: i64 = level.men
            hats: darray[i64] = py_sample_range(&rng, 0, 5, n)
            xs: mutable f64[6] = zeroed
            for k in 0..<n |n, rng, xs|:
                xs[k.usize()] <- (k.f64() - (n - 1).f64() / 2.0) * (9.0 / n.f64()) + uniform(&rng, -0.5, 0.5)
            near: f64 = 9.0 if level.rung < 7 else (11.0 if level.rung < 13 else 14.0)
            far: f64 = 11.0 if level.rung < 7 else (16.0 if level.rung < 13 else 21.0)
            for k in 0..<n |duel, rng, hats, xs, near, far, level|:
                z: f64 = uniform(&rng, near, far)
                rate: f64 = uniform(&rng, 0.5, 1.0)
                phase: f64 = uniform(&rng, 0.0, 6.28)
                duel.men[k.usize()] <- Man{x: xs[k.usize()], z: z, hat: get hats[k.usize()] else 0,
                    stride: level.pace, rate: rate, phase: phase}
            duel.foe <- py_choice_index(&rng, n)
            duel.hat <- level.hat and py_random(&rng) < 0.5
            describe(&duel, &rng)
            duel.draw_at <- uniform(&rng, 3.0, 6.0) + 1.2 * level.feints.f64()
            for _k in 0..<level.feints |duel, level, rng, n|:
                time: f64 = uniform(&rng, 1.0, duel.draw_at - 1.0)
                continue if not separated(&duel, time)
                who: mutable i64 = duel.foe
                if level.others and py_random(&rng) >= 0.4:
                    pick: i64 = py_choice_index(&rng, n - 1)
                    who <- pick + (1 if pick >= duel.foe else 0)
                slot: mutable i64 = duel.reach_count
                while slot > 0 and duel.reaches[(slot - 1).usize()].time > time |duel, slot, time|:
                    duel.reaches[slot.usize()] <- duel.reaches[(slot - 1).usize()]
                    slot <- slot - 1
                duel.reaches[slot.usize()] <- Reach{time: time, who: who, real: false}
                duel.reach_count <- duel.reach_count + 1
            duel.reaches[duel.reach_count.usize()] <- Reach{time: duel.draw_at, who: duel.foe, real: true}
            duel.reach_count <- duel.reach_count + 1
            duel.seed <- py_randbelow(&rng, (1 << 30).u64()).i64()
            duel.valid <- true
            return duel

    def initialize(duel: Duel, record_audio: bool = true) -> Run:
        can Memory.Allocate, Abort.Panic:
            extra: mutable MT19937 = mt19937_new()
            mt_seed_int(&extra, duel.seed.u64())
            return Run{duel: duel, hand: HandView::initialize(), time: 0.0, cocked: not duel.level.cock,
                bullets: BULLETS, shots: zeroed, shot_count: 0, hatless: 0, hat_at: zeroed, reach_no: 0,
                extra: extra, extra_at: 0.8, fell: -1, fell_at: 0.0, notes: [], record_audio: record_audio, result: PENDING}

    def view(run: Run&) -> HandView::Lens:
        can Abort.Panic:
            x: f64 = 1.2 * sin(run.time * 0.5) if run.duel.level.dust else 0.0
            return HandView::lens(RoomsView::vec(x, 1.6, 0.0), RoomsView::vec(x * 0.5, 1.3, -18.0), 900.0, 500.0, 300.0)

    def stands(run: Run&, index: i64) -> RoomsView::Vec:
        man: Man = run.duel.men[index.usize()]
        return RoomsView::vec(man.x + man.stride * sin(run.time * man.rate + man.phase), 0.0, -man.z)

    def arm(run: Run&, index: i64) -> f64:
        can Abort.Panic:
            best: mutable f64 = 0.0
            for k in 0..<run.duel.reach_count |run, index, best|:
                reach: Reach = run.duel.reaches[k.usize()]
                continue if reach.who != index or run.time < reach.time
                u: f64 = (run.time - reach.time) / REACH
                v: f64 = HandView::clamp(u, 0.0, 1.0) if reach.real else (0.55 * (u if u < 1.0 else 2.0 - u) if u < 2.0 else 0.0)
                best <- v if v > best
            return best

    def drawn(run: Run&) -> bool:
        return run.time >= run.duel.draw_at

    def sway(run: Run&) -> RoomsView::Point:
        a: f64 = run.duel.level.sway
        return RoomsView::Point{x: a * sin(run.time * 2.3 + 1.0), y: a * sin(run.time * 3.1)}

    def aim(run: Run&) -> RoomsView::Point:
        offset: RoomsView::Point = sway(run)
        return RoomsView::Point{x: run.hand.x + offset.x, y: run.hand.y + offset.y}

    def boxes(run: Run&, index: i64) -> Target:
        can Abort.Panic:
            p: RoomsView::Vec = stands(run, index)
            lens: HandView::Lens = view(run)
            feet: RoomsView::Vec = HandView::see(&lens, p)
            top: RoomsView::Vec = HandView::see(&lens, RoomsView::vec(p.x, 1.85, p.z))
            return zeroed if feet.z < 0.05 or top.z < 0.05
            scale: f64 = lens.focal / feet.z
            left: f64 = feet.x - 0.3 * scale
            right: f64 = feet.x + 0.3 * scale
            hat: mutable Box = Box{left: left, bottom: top.y, right: right, top: top.y + 0.3 * scale}
            if (run.hatless & (1 << index)) != 0:
                hat <- Box{left: 0.0, bottom: 0.0, right: -1.0, top: -1.0}
            return Target{valid: true, hat: hat, body: Box{left: left, bottom: feet.y, right: right, top: top.y}}

    def contains(box: Box, point: RoomsView::Point) -> bool:
        return box.left <= point.x and point.x <= box.right and box.bottom <= point.y and point.y <= box.top

    def note(run: mutable Run&, time: f64, duration: f64, pitch: f64, voice: i64, gain: f64, pan: f64 = 0.0):
        can Memory.Allocate, Abort.Panic:
            return if not run.record_audio
            index: mutable i64 = run.notes.count.i64()
            cue: Cue = Cue{time: time, duration: duration, pitch: pitch, voice: voice, gain: gain,
                pan: HandView::clamp(pan, -1.0, 1.0), seed: index + 1}
            run.notes.push(cue)
            while index > 0 |run, index, time|:
                prev: Cue = get run.notes[(index - 1).usize()] else zeroed
                break if prev.time <= time
                run.notes[index.usize()] <- prev
                index <- index - 1
            run.notes[index.usize()] <- cue

    def shoot(run: mutable Run&) -> RoomsView::Point:
        can Memory.Allocate, Abort.Panic:
            point: RoomsView::Point = aim(run)
            run.shots[run.shot_count.usize()] <- Shot{time: run.time, point: point}
            run.shot_count <- run.shot_count + 1
            note(run, run.time, 0.35, 70.0, BANG, 0.8)
            return point

    def fire(run: mutable Run&):
        can Memory.Allocate, Abort.Panic:
            if not run.cocked or run.bullets <= 0:
                note(run, run.time, 0.04, 500.0, CLICK, 0.3)
                return
            run.cocked <- not run.duel.level.cock
            run.bullets <- run.bullets - 1
            point: RoomsView::Point = shoot(run)
            nearest: mutable f64 = 1e9
            index: mutable i64 = -1
            hit_hat: mutable bool = false
            for k in 0..<run.duel.level.men |run, point, nearest, index, hit_hat|:
                depth: f64 = run.duel.men[k.usize()].z
                continue if depth >= nearest
                target: Target = boxes(run, k)
                continue if not target.valid
                hat: bool = contains(target.hat, point)
                if hat or contains(target.body, point):
                    nearest <- depth
                    index <- k
                    hit_hat <- hat
            if index < 0:
                if run.bullets <= 0:
                    note(run, run.time, 0.04, 500.0, CLICK, 0.3)
            elif index == run.duel.foe and hit_hat:
                run.hatless <- run.hatless | (1 << index)
                run.hat_at[index.usize()] <- run.time
                run.result <- HAT_OFF if run.duel.hat
            else:
                run.fell <- index
                run.fell_at <- run.time
                run.result <- WRONG_MAN if index != run.duel.foe else (WRONG_PART if run.duel.hat else QUICKER)

    def press(run: mutable Run&):
        can Memory.Allocate, Abort.Panic:
            return if run.result != PENDING or run.hand.down
            run.hand.down <- true
            if drawn(run):
                fire(run)
            else:
                _ = shoot(run)
                run.result <- FIRST

    def cock_hammer(run: mutable Run&):
        can Memory.Allocate, Abort.Panic:
            return if run.result != PENDING or run.cocked
            run.cocked <- true
            note(run, run.time, 0.05, 900.0, CLICK, 0.4)

    def act(run: mutable Run&, port: i64):
        can Memory.Allocate, Abort.Panic:
            if port >= 0 and port < HandView::PRESS:
                HandView::move(&run.hand, port)
            elif port == HandView::PRESS:
                press(run)
            elif port == HandView::RELEASE:
                run.hand.down <- false
            elif port == COCK:
                cock_hammer(run)

    def tick(run: mutable Run&, dt: f64):
        can Memory.Allocate, Abort.Panic:
            return if run.result != PENDING
            run.time <- run.time + dt
            while run.reach_no < run.duel.reach_count |run|:
                reach: Reach = run.duel.reaches[run.reach_no.usize()]
                break if reach.time > run.time
                run.reach_no <- run.reach_no + 1
                lens: HandView::Lens = view(run)
                q: RoomsView::Vec = HandView::see(&lens, stands(run, reach.who))
                pan: f64 = (q.x - 500.0) / 500.0 if q.z >= 0.05 else 0.0
                note(run, run.time, 0.12, 260.0 if reach.real else 240.0, LEATHER, 0.55 if reach.real else 0.4, pan)
                if reach.real:
                    note(run, run.time + REACH, 0.05, 800.0, CLICK, 0.35, pan)
            if run.duel.level.rung >= 4 and run.time >= run.extra_at:
                run.extra_at <- run.time + uniform(&run.extra, 0.9, 2.6)
                roll: f64 = py_random(&run.extra)
                if roll < 0.4:
                    pan: f64 = uniform(&run.extra, -1.0, 1.0)
                    note(run, run.time, 1.2, 180.0, WIND, 0.15, pan)
                elif run.duel.level.dust and roll < 0.7:
                    note(run, run.time, 0.8, 392.0, BELL, 0.3)
                elif run.duel.level.dust:
                    pan: f64 = uniform(&run.extra, -1.0, 1.0)
                    note(run, run.time, 0.25, 520.0, CROW, 0.25, pan)
            if run.time >= run.duel.draw_at + run.duel.level.quick:
                note(run, run.time, 0.35, 80.0, BANG, 0.9)
                note(run, run.time + 0.1, 0.3, 60.0, THUD, 0.6)
                run.result <- TOO_SLOW

    def dust(run: Run&) -> f64:
        amount: f64 = sin(run.time * 0.9 + 2.0) if run.duel.level.dust else 0.0
        return amount * amount * 0.55 if amount > 0.0 else 0.0

    def pilot(run: Run&) -> i64:
        can Abort.Panic:
            return -1 if run.result != PENDING
            return HandView::RELEASE if run.hand.down
            return COCK if not run.cocked
            target: Target = boxes(run, run.duel.foe)
            box: Box = target.hat if run.duel.hat else target.body
            offset: RoomsView::Point = sway(run)
            port: i64 = HandView::toward(&run.hand, (box.left + box.right) / 2.0 - offset.x,
                (box.bottom + box.top) / 2.0 - offset.y)
            return port if port >= 0
            return HandView::PRESS if drawn(run) else -1

    def passed(result: i64) -> bool:
        return result == QUICKER or result == HAT_OFF

    def play(duel: Duel) -> i64:
        can Memory.Allocate, Abort.Panic:
            run: mutable Run = initialize(duel, false)
            while run.result == PENDING |run|:
                act(&run, pilot(&run))
                tick(&run, 1.0 / 60.0)
            return run.result

    def deal(rung: i64, draw: mutable MT19937&) -> Duel:
        can Memory.Allocate, Abort.Panic:
            level: Grade = grade(rung)
            for _attempt in 0..<60 |level, draw|:
                duel: Duel = build(level, py_getrandbits(draw, 32).i64())
                return duel if passed(play(duel))
            return empty(level)

    def result_text(result: i64) -> sview:
        return "You were the quicker" if result == QUICKER
        return "His hat is off and so is he" if result == HAT_OFF
        return "You fired first" if result == FIRST
        return "You shot the wrong man" if result == WRONG_MAN
        return "The notice said his hat" if result == WRONG_PART
        return "Too slow: he shot you" if result == TOO_SLOW
        return ""
