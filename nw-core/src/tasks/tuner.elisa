include "../pyrandom.elisa"
include "../pymath.elisa"

module Tuner:
    const DOWN: i64 = 0
    const UP: i64 = 1
    const FINE_DOWN: i64 = 2
    const FINE_UP: i64 = 3
    const LOCK: i64 = 4
    const REPLAY: i64 = 5
    const PORTS: i64 = 6
    const DIAL: f64 = 100.0
    const LEAD: f64 = 0.2
    const BEAT: f64 = 0.2
    const TAIL_TIME: f64 = 0.3
    const GAP: f64 = 0.35
    const QUIET: f64 = 0.15
    const TAU: f64 = 6.283185307179586
    const MAX_STATIONS: i64 = 9
    const TUNES: i64 = 0
    const ESC50: i64 = 1
    const PENDING: i64 = 0
    const WON: i64 = 1
    const WRONG: i64 = -1
    const TIMED_OUT: i64 = -2
    const NO_SIGNAL: i64 = 1
    const LOCKING: i64 = 2
    const LOST_LOCK: i64 = 3

    struct Grade:
        rung: i64
        stations: i64
        width: f64
        lamps: bool
        same_group: bool
        shifted: bool
        backward: bool
        drift: f64
        fade: bool
        near_miss: i64
        seconds: f64
        hold: f64

    def clamp(value: f64, low: f64, high: f64) -> f64:
        return low if value < low else (high if value > high else value)

    def magnitude(value: f64) -> f64:
        return -value if value < 0.0 else value

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        top: i64 = r - 20 if r >= 20 else 0
        count: i64 = 9 if top >= 9 else 6 + top / 3
        return Grade{rung: r, stations: 3 if r < 4 else (4 if r < 7 else (5 if r < 16 else count)),
            width: 3.5 if r < 4 else (2.5 if r < 10 else (2.0 if r < 20 else clamp(1.9 - 0.05 * top.f64(), 1.3, 1.9))),
            lamps: r < 4, same_group: r >= 7, shifted: r >= 10, backward: r >= 10,
            drift: 0.0 if r < 13 else (4.0 if r < 20 else clamp(4.5 + 0.3 * top.f64(), 4.5, 8.0)),
            fade: r >= 16, near_miss: 0 if r < 16 else (1 if r < 24 else 2),
            seconds: 40.0 if r < 20 else clamp(38.0 - top.f64(), 25.0, 38.0),
            hold: 1.0 if r < 13 else 2.0}

    struct Clip:
        row: i64
        label: i64
        duration: f64

    struct Tune:
        degrees: mutable i64[5]
        rhythm: i64
        root: f64
        voice: i64

    struct Sound:
        bank: i64
        tune: mutable Tune
        row: i64
        label: i64
        group: i64
        raw_length: f64
        speed: mutable f64
        backward: mutable bool

    struct Bank:
        sounds: mutable Sound[MAX_STATIONS]
        count: mutable i64
        target: mutable i64

    struct Station:
        at: f64
        sound: Sound
        phase: f64
        drift_rate: f64
        drift_phase: f64
        fade_rate: f64
        fade_phase: f64

    struct Radio:
        level: Grade
        stations: mutable Station[MAX_STATIONS]
        count: i64
        target: i64
        heard: Sound
        listen: f64
        start: f64
        seed: i64

    def length(sound: Sound) -> f64:
        return sound.raw_length / sound.speed

    def rhythm(index: i64) -> i64[5]:
        return [1, 1, 1, 1, 2] if index == 0
        return [2, 1, 1, 2, 1] if index == 1
        return [1, 1, 2, 1, 1] if index == 2
        return [1, 2, 1, 1, 2] if index == 3
        return [2, 2, 1, 1, 1] if index == 4
        return [1, 1, 1, 2, 2]

    def rhythm_length(index: i64) -> f64:
        return (6.0 if index == 0 or index == 2 else 7.0) * BEAT + TAIL_TIME

    def tune_key(values: i64[5]) -> i64:
        can Abort.Panic:
            key: mutable i64 = 0
            for i in 0..<5 |values, key|:
                key <- key * 9 + values[i.usize()]
            return key

    def seen(values: darray[i64]&, key: i64) -> bool:
        can Abort.Panic:
            for value in values |key|:
                return true if value == key
            return false

    def sequence(rng: mutable MT19937&) -> i64[5]:
        can Abort.Panic:
            moves: i64[7] = [-3, -2, -1, 1, 2, 3, 4]
            out: mutable i64[5] = zeroed
            while true |rng, moves, out|:
                out[0] <- py_choice_index(rng, 8)
                mask: mutable i64 = 1 << out[0]
                count: mutable i64 = 1
                for i in 1..<5 |rng, moves, out, mask, count|:
                    next: i64 = out[(i - 1).usize()] + moves[py_choice_index(rng, 7).usize()]
                    degree: i64 = clamp(next.f64(), 0.0, 8.0).i64()
                    bit: i64 = 1 << degree
                    count <- count + 1 if (mask & bit) == 0
                    mask <- mask | bit
                    out[i.usize()] <- degree
                return out if count >= 4
            return out

    def alternate(bank: mutable Bank&, near: Bank&, level: Grade&, rng: mutable MT19937&):
        can Memory.Allocate, Abort.Panic:
            others: mutable darray[i64] = []
            for i in 0..<bank.count |bank, others|:
                if i != bank.target:
                    others.push(i)
            py_shuffle_i64(rng, &others)
            offset: i64 = 1 if level.backward else 0
            if level.backward and others.count > 0.usize():
                at: usize = (get others[0] else 0).usize()
                bank.sounds[at] <- bank.sounds[bank.target.usize()]
                bank.sounds[at].backward <- true
            count: i64 = near.count if near.count < others.count.i64() - offset else others.count.i64() - offset
            for i in 0..<count |others, bank, near, offset|:
                at: usize = (get others[(offset + i).usize()] else 0).usize()
                bank.sounds[at] <- near.sounds[i.usize()]

    def tune_bank(level: Grade&, rng: mutable MT19937&) -> Bank:
        can Memory.Allocate, Abort.Panic:
            bank: mutable Bank = zeroed
            bank.count <- level.stations
            voices: mutable darray[i64] = [0, 1, 2, 3, 4, 5, 6, 7]
            rhythms: mutable darray[i64] = [0, 1, 2, 3, 4, 5]
            py_shuffle_i64(rng, &voices)
            py_shuffle_i64(rng, &rhythms)
            keys: mutable darray[i64] = []
            for i in 0..<bank.count |bank, level, voices, rhythms, keys, rng|:
                degrees: mutable i64[5] = sequence(rng)
                while seen(&keys, tune_key(degrees)) |keys, rng, degrees|:
                    degrees <- sequence(rng)
                keys.push(tune_key(degrees))
                group: i64 = 0 if level.same_group else i
                voice: i64 = get voices[(group % 8).usize()] else 0
                beat_pattern: i64 = get rhythms[(i % 6).usize()] else 0
                root: f64 = 220.0 * pow(2.0, py_choice_index(rng, 7).f64() / 12.0)
                bank.sounds[i.usize()] <- Sound{bank: TUNES, tune: Tune{degrees: degrees, rhythm: beat_pattern, root: root, voice: voice},
                    row: -1, label: i, group: group, raw_length: rhythm_length(beat_pattern), speed: 1.0, backward: false}
            bank.target <- py_choice_index(rng, bank.count)
            target: Sound = bank.sounds[bank.target.usize()]
            twins: mutable Bank = zeroed
            twins.count <- level.near_miss
            moves: i64[4] = [-2, -1, 1, 2]
            for i in 0..<twins.count |twins, target, keys, rng, moves|:
                sibling: mutable Sound = target
                while seen(&keys, tune_key(sibling.tune.degrees)) |keys, sibling, rng, moves|:
                    at: usize = py_choice_index(rng, 5).usize()
                    next: i64 = sibling.tune.degrees[at] + moves[py_choice_index(rng, 4).usize()]
                    sibling.tune.degrees[at] <- clamp(next.f64(), 0.0, 8.0).i64()
                keys.push(tune_key(sibling.tune.degrees))
                twins.sounds[i.usize()] <- sibling
            alternate(&bank, &twins, level, rng)
            return bank

    def clip_sound(clip: Clip) -> Sound:
        return Sound{bank: ESC50, tune: zeroed, row: clip.row, label: clip.label, group: clip.label / 10,
            raw_length: clip.duration if clip.duration < 3.5 else 3.5, speed: 1.0, backward: false}

    def labels_in_group(labels: darray[i64]&, group: i64) -> darray[i64]:
        can Memory.Allocate, Abort.Panic:
            out: mutable darray[i64] = []
            for label in labels |out, group|:
                if label / 10 == group:
                    out.push(label)
            return out

    def esc_bank(level: Grade&, rng: mutable MT19937&, clips: darray[Clip]&) -> Bank:
        can Memory.Allocate, Abort.Panic:
            out: mutable Bank = zeroed
            labels: mutable darray[i64] = []
            for label in 0..<50 |clips, labels|:
                for i in 0..<clips.count |clips, labels, label|:
                    clip: Clip = clips[i]
                    if clip.label == label:
                        labels.push(label)
                        break
            return out if labels.count == 0.usize()
            groups: mutable darray[i64] = [0, 1, 2, 3, 4]
            py_shuffle_i64(rng, &groups)
            chosen: mutable darray[i64] = []
            if level.same_group:
                for group in groups |labels, chosen, level|:
                    current: darray[i64] = labels_in_group(&labels, group)
                    if current.count > chosen.count:
                        chosen <- current
                    break if current.count.i64() >= level.stations
                py_shuffle_i64(rng, &chosen)
            else:
                wanted: i64 = level.stations if level.stations < labels.count.i64() else labels.count.i64()
                while chosen.count.i64() < wanted |groups, labels, chosen, wanted, rng|:
                    for group in groups |labels, chosen, wanted, rng|:
                        remaining: mutable darray[i64] = []
                        for label in labels |remaining, chosen, group|:
                            if label / 10 == group and not seen(&chosen, label):
                                remaining.push(label)
                        if remaining.count > 0.usize() and chosen.count.i64() < wanted:
                            at: usize = py_choice_index(rng, remaining.count.i64()).usize()
                            chosen.push(get remaining[at] else 0)
            out.count <- level.stations if level.stations < chosen.count.i64() else chosen.count.i64()
            out.target <- py_choice_index(rng, out.count)
            for i in 0..<out.count |out, clips, rng, chosen|:
                label: i64 = get chosen[i.usize()] else 0
                rows: mutable darray[i64] = []
                for j in 0..<clips.count |rows, clips, label|:
                    if clips[j].label == label:
                        rows.push(j.i64())
                at: usize = (get rows[py_choice_index(rng, rows.count.i64()).usize()] else 0).usize()
                out.sounds[i.usize()] <- clip_sound(clips[at])
            matches: mutable darray[i64] = []
            target: Sound = out.sounds[out.target.usize()]
            for i in 0..<clips.count |clips, matches, target|:
                c: Clip = clips[i]
                if c.label == target.label and c.row != target.row:
                    matches.push(i.i64())
            py_shuffle_i64(rng, &matches)
            near: mutable Bank = zeroed
            near.count <- matches.count.i64() if matches.count.i64() < level.near_miss else level.near_miss
            for i in 0..<near.count |near, matches, clips|:
                at: usize = (get matches[i.usize()] else 0).usize()
                near.sounds[i.usize()] <- clip_sound(clips[at])
            alternate(&out, &near, level, rng)
            return out

    def build(level: Grade&, rng: mutable MT19937&, clips: darray[Clip]&) -> Radio:
        can Memory.Allocate, Abort.Panic:
            bank: mutable Bank = esc_bank(level, rng, clips) if clips.count > 0.usize() else tune_bank(level, rng)
            return zeroed if bank.count <= 0
            spacing: f64 = 84.0 / bank.count.f64()
            stations: mutable Station[MAX_STATIONS] = zeroed
            for i in 0..<bank.count |bank, spacing, stations, rng|:
                at: f64 = 8.0 + spacing * (i.f64() + 0.5) + py_uniform(rng, -0.2, 0.2) * spacing
                phase: f64 = py_uniform(rng, 0.0, 2.0)
                drift_rate: f64 = py_uniform(rng, 0.18, 0.32)
                drift_phase: f64 = py_uniform(rng, 0.0, TAU)
                fade_rate: f64 = py_uniform(rng, 0.25, 0.45)
                fade_phase: f64 = py_uniform(rng, 0.0, TAU)
                stations[i.usize()] <- Station{at: at, sound: bank.sounds[i.usize()], phase: phase,
                    drift_rate: drift_rate, drift_phase: drift_phase, fade_rate: fade_rate, fade_phase: fade_phase}
            heard: mutable Sound = bank.sounds[bank.target.usize()]
            if level.shifted:
                low: f64 = py_uniform(rng, 0.78, 0.88)
                high: f64 = py_uniform(rng, 1.14, 1.28)
                speed: f64 = low if py_choice_index(rng, 2) == 0 else high
                heard.speed <- py_round_half_even(speed * 1000.0).f64() / 1000.0
            listen: f64 = LEAD + length(heard) + 0.5
            start: mutable f64 = py_uniform(rng, 4.0, DIAL - 4.0)
            while magnitude(start - stations[bank.target.usize()].at) < 20.0 |start, stations, bank, rng|:
                start <- py_uniform(rng, 4.0, DIAL - 4.0)
            return Radio{level: level[0], stations: stations, count: bank.count, target: bank.target, heard: heard,
                listen: listen, start: start, seed: py_choice_index(rng, 1048576)}

    struct GainFrame:
        time: f64
        levels: mutable f64[MAX_STATIONS + 1]

    struct Run:
        radio: Radio
        t: mutable f64
        dial: mutable f64
        lock_since: mutable f64
        replay_until: mutable f64
        message: mutable i64
        result: mutable i64
        end: f64
        plays: mutable darray[f64]
        gains: mutable darray[GainFrame]
        capture: bool

    def initialize(radio: Radio&, capture: bool) -> Run:
        can Memory.Allocate, Abort.Panic:
            note: mutable darray[f64] = []
            gain: mutable darray[GainFrame] = []
            if capture:
                note.push(LEAD)
                gain.push(GainFrame{time: 0.0, levels: zeroed})
            return Run{radio: radio[0], t: 0.0, dial: radio.start, lock_since: -1.0,
                replay_until: LEAD + length(radio.heard), message: 0, result: PENDING,
                end: radio.listen + radio.level.seconds, plays: note, gains: gain, capture: capture}

    def on(run: Run&) -> bool:
        return run.t >= run.radio.listen

    def where(radio: Radio&, index: i64, t: f64) -> f64:
        can Abort.Panic:
            s: Station = radio.stations[index.usize()]
            return s.at if radio.level.drift == 0.0
            return s.at + radio.level.drift * sin(s.drift_rate * t + s.drift_phase)

    def strength(radio: Radio&, index: i64, dial: f64, t: f64) -> f64:
        can Abort.Panic:
            offset: f64 = (dial - where(radio, index, t)) / radio.level.width
            gain: f64 = exp(-(offset * offset))
            return gain if not radio.level.fade
            s: Station = radio.stations[index.usize()]
            return gain * (0.55 + 0.45 * sin(s.fade_rate * t + s.fade_phase))

    def signal(run: Run&) -> f64:
        can Abort.Panic:
            return 0.0 if not on(run)
            best: mutable f64 = 0.0
            for i in 0..<run.radio.count |run, best|:
                g: f64 = strength(&run.radio, i, run.dial, run.t)
                best <- g if g > best
            return best

    def nearest(run: Run&) -> i64:
        can Abort.Panic:
            closest: mutable i64 = 0
            distance: mutable f64 = 200.0
            for i in 0..<run.radio.count |run, closest, distance|:
                d: f64 = magnitude(run.dial - where(&run.radio, i, run.t))
                if d < distance:
                    closest <- i
                    distance <- d
            return closest

    def press(run: mutable Run&) -> bool:
        can Abort.Panic:
            return false if run.result != PENDING or not on(run) or run.lock_since >= 0.0
            k: i64 = nearest(run)
            if magnitude(run.dial - where(&run.radio, k, run.t)) > run.radio.level.width:
                run.message <- NO_SIGNAL
            elif k != run.radio.target:
                run.result <- WRONG
            else:
                run.lock_since <- run.t
                run.message <- LOCKING
            return true

    def replay(run: mutable Run&) -> bool:
        can Memory.Allocate, Abort.Panic:
            return false if run.result != PENDING or not on(run) or run.t < run.replay_until
            start: f64 = run.t + 0.05
            if run.capture:
                run.plays.push(start)
            run.replay_until <- start + length(run.radio.heard)
            return true

    def levels(run: Run&) -> GainFrame:
        can Abort.Panic:
            out: mutable GainFrame = GainFrame{time: run.t, levels: zeroed}
            return out if not on(run)
            quiet: f64 = QUIET if run.t < run.replay_until else 1.0
            sum: mutable f64 = 0.0
            for i in 0..<run.radio.count |run, quiet, sum, out|:
                gain: f64 = strength(&run.radio, i, run.dial, run.t)
                sum <- sum + gain
                out.levels[i.usize()] <- gain * quiet
            hiss: f64 = 1.0 - sum if sum < 1.0 else 0.0
            out.levels[run.radio.count.usize()] <- (0.05 + 0.4 * hiss) * quiet
            return out

    def step(run: mutable Run&, dt: f64, controls: i64):
        can Memory.Allocate, Abort.Panic:
            return if run.result != PENDING
            run.t <- run.t + dt
            coarse: f64 = (22.0 if (controls & 2) != 0 else 0.0) - (22.0 if (controls & 1) != 0 else 0.0)
            fine: f64 = (4.0 if (controls & 8) != 0 else 0.0) - (4.0 if (controls & 4) != 0 else 0.0)
            run.dial <- clamp(run.dial + (coarse + fine) * dt, 0.0, DIAL)
            if run.capture:
                run.gains.push(levels(run))
            if run.lock_since >= 0.0:
                distance: f64 = magnitude(run.dial - where(&run.radio, run.radio.target, run.t))
                if distance > run.radio.level.width * 0.8:
                    run.lock_since <- -1.0
                    run.message <- LOST_LOCK
                elif run.t - run.lock_since >= run.radio.level.hold:
                    run.result <- WON
                    return
            run.result <- TIMED_OUT if run.t >= run.end

    def autopilot(run: Run&) -> i64:
        can Abort.Panic:
            return 0 if not on(run)
            d: f64 = where(&run.radio, run.radio.target, run.t) - run.dial
            delta: f64 = magnitude(d)
            width: f64 = run.radio.level.width
            port: i64 = (2 if d > 0.0 else 1) if delta > 2.5 else ((8 if d > 0.0 else 4) if delta > 0.15 * width else 0)
            return port | (16 if run.lock_since < 0.0 and delta < 0.4 * width else 0)

    def solvable(radio: Radio&) -> bool:
        can Memory.Allocate, Abort.Panic:
            run: mutable Run = initialize(radio, false)
            while run.result == PENDING |run|:
                controls: i64 = autopilot(&run)
                if (controls & 16) != 0:
                    _ = press(&run)
                step(&run, 1.0 / 60.0, controls)
            return run.result == WON

    def deal(rung: i64, seed: i64, clips: darray[Clip]&) -> Radio:
        can Memory.Allocate, Abort.Panic:
            rng: mutable MT19937 = zeroed
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            level: Grade = grade(rung)
            first: mutable Radio = zeroed
            for attempt in 0..<30 |first, level, rng, clips|:
                radio: Radio = build(&level, &rng, clips)
                if attempt == 0:
                    first <- radio
                return radio if radio.count == 0 or solvable(&radio)
            return first
