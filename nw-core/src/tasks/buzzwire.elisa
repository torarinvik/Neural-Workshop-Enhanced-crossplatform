        return g

def bz_hand_speed(g: BzGrade) -> f64:
    can Abort.Panic:
        return g.thrust / (1e-9 if g.drag < 1e-9 else g.drag)

def bz_clearance(g: BzGrade) -> f64:
    can Abort.Panic:
        return g.hole - BZ_WIRE_RADIUS

def bz_ticks_per_clearance(g: BzGrade, hz: f64) -> f64:
    can Abort.Panic:
        step: f64 = bz_hand_speed(g) / hz
        if step > 0.0:
            return bz_clearance(g) / step
        return 1.0 / 0.0

def bz_tremor_wander(g: BzGrade) -> f64:
    can Abort.Panic:
        if g.tremor <= 0.0:
            return 0.0
        return g.tremor * sqrt(g.tremor_tau / g.drag)

# --- the wire ---

const BZ_FINE: i64 = 601
const BZ_LEAD_STEPS: i64 = 12
const BZ_RAW_POINTS: i64 = 625
const BZ_MOST_POINTS: i64 = 2048

struct BzWire:
    px: mutable darray[f64]
    py: mutable darray[f64]
    pz: mutable darray[f64]
    tx: mutable darray[f64]
    ty: mutable darray[f64]
    tz: mutable darray[f64]
    arcs: mutable darray[f64]
    count: mutable i64
    span: mutable f64
    length: mutable f64
    radius: mutable f64
    beads: mutable i64

def bz_wire_new() -> BzWire:
    can Memory.Allocate, Abort.Panic:
        wire: mutable BzWire = zeroed
        wire.px <- Floats::zeros(BZ_MOST_POINTS)
        wire.py <- Floats::zeros(BZ_MOST_POINTS)
        wire.pz <- Floats::zeros(BZ_MOST_POINTS)
        wire.tx <- Floats::zeros(BZ_MOST_POINTS)
        wire.ty <- Floats::zeros(BZ_MOST_POINTS)
        wire.tz <- Floats::zeros(BZ_MOST_POINTS)
        wire.arcs <- Floats::zeros(BZ_MOST_POINTS)
        return wire

def bz_point(wire: BzWire&, index: i64) -> Vec3:
    can Abort.Panic:
        return vec3(Floats::at(wire.px, index), Floats::at(wire.py, index), Floats::at(wire.pz, index))

def bz_tangent(wire: BzWire&, index: i64) -> Vec3:
    can Abort.Panic:
        return vec3(Floats::at(wire.tx, index), Floats::at(wire.ty, index), Floats::at(wire.tz, index))

def bz_spacing(wire: BzWire&) -> f64:
    can Abort.Panic:
        gaps: i64 = wire.count - 1
        return wire.length / (1 if gaps < 1 else gaps).f64()

def bz_index_at(wire: BzWire&, arc: f64) -> i64:
    can Abort.Panic:
        step: f64 = bz_spacing(wire)
        if step <= 0.0:
            return 0
        raw: i64 = (arc / step).i64()
        top: i64 = wire.count - 2
        out: mutable i64 = raw
        out <- top if out > top
        out <- 0 if out < 0
        return out

# Where the wire is at arc length `arc`, and which way it runs.
def bz_at_point(wire: BzWire&, arc: f64) -> Vec3:
    can Abort.Panic:
        index: i64 = bz_index_at(wire, arc)
        step: f64 = bz_spacing(wire)
        blend: mutable f64 = 0.0
        if step > 0.0:
            blend <- (arc - Floats::at(wire.arcs, index)) / step
            blend <- 0.0 if blend < 0.0
            blend <- 1.0 if blend > 1.0
        return v_lerp(bz_point(wire, index), bz_point(wire, index + 1), blend)

def bz_at_tangent(wire: BzWire&, arc: f64) -> Vec3:
    can Abort.Panic:
        index: i64 = bz_index_at(wire, arc)
        step: f64 = bz_spacing(wire)
        blend: mutable f64 = 0.0
        if step > 0.0:
            blend <- (arc - Floats::at(wire.arcs, index)) / step
            blend <- 0.0 if blend < 0.0
            blend <- 1.0 if blend > 1.0
        return v_unit(v_lerp(bz_tangent(wire, index), bz_tangent(wire, index + 1), blend))

def bz_bead_at(wire: BzWire&, arc: f64) -> i64:
    can Abort.Panic:
        if wire.length <= 0.0:
            return 0
        share: mutable f64 = arc / wire.length
        share <- 0.0 if share < 0.0
        share <- 1.0 if share > 1.0
        raw: i64 = (share * wire.beads.f64()).i64()
        return wire.beads if raw > wire.beads else raw

# One action moves the loop along the wire by at most `top_speed * dt` and a
# contact may push it as much again, so BEAD_MARGIN times that, at the slowest
# tick allowed, is the closest two beads may sit. Then no action crosses two.
def bz_bead_count(g: BzGrade, wire_length: f64) -> i64:
    can Abort.Panic:
        furthest: f64 = 2.0 * g.top_speed / BZ_SLOWEST_HZ
        closest: f64 = BZ_BEAD_MARGIN * furthest
        if closest <= 0.0:
            return BZ_BEADS_WANTED
        raw: i64 = (wire_length / closest).i64()
        out: mutable i64 = raw
        out <- BZ_BEADS_WANTED if out > BZ_BEADS_WANTED
        out <- 4 if out < 4
        return out

# Amplitudes for one lateral axis, as a COSINE series -- every term has zero
# slope at both ends, so the wire arrives at each post running straight along
# its own axis without anything having to be done to it.
#
# `rng.choice((-1.0, 1.0))` draws BEFORE `rng.uniform(0.45, 1.0)`, because
# Python evaluates the product left to right.
def bz_series(rng: mutable MT19937&, g: BzGrade, out: mutable darray[f64]&) -> i64:
    can Abort.Panic:
        k: mutable i64 = 1
        while k <= g.waves |k, g, rng, out|:
            sign: f64 = 1.0 if py_choice_index(rng, 2) == 1 else -1.0
            size: f64 = 0.45 + (1.0 - 0.45) * py_random(rng)
            Floats::put(out, k - 1, sign * size / pow(k.f64(), g.slope))
            k <- k + 1
        return g.waves

# `sum(w * cos(k * pi * share) ...)` -- left to right from zero, which is what
# fixes the rounding of the accumulation.
def bz_offset(weights: darray[f64], count: i64, share: f64) -> f64:
    can Abort.Panic:
        total: mutable f64 = 0.0
        k: mutable i64 = 1
        while k <= count |k, count, weights, share, total|:
            total <- total + Floats::at(weights, k - 1) * cos(k.f64() * BZ_PI * share)
            k <- k + 1
        return total

# Bend a fresh wire for `rung`. A sum of harmonics with random phases, one
# series per lateral axis, with straight leads grown onto each end and the
# whole thing resampled at even steps of arc length.
def bz_deal(rung: i64, seed: i64, wire: mutable BzWire&) -> BzGrade:
    can Memory.Allocate, Abort.Panic:
        g: BzGrade = bz_grade_of(rung)
        rng: mutable MT19937 = mt19937_new()
        mt_seed_int(&rng, seed.u64())
        up: mutable darray[f64] = Floats::zeros(16)
        out: mutable darray[f64] = Floats::zeros(16)
        _ = bz_series(&rng, g, &up)
        _ = bz_series(&rng, g, &out)
        # Normalise each series to the swing this rung asked for, so the slope
        # changes the SHAPE and only the shape.
        peak_up: mutable f64 = 0.0
        peak_out: mutable f64 = 0.0
        probe: mutable i64 = 0
        while probe < BZ_FINE |probe, up, out, g, peak_up, peak_out|:
            t: f64 = probe.f64() / 600.0
            raw_up: f64 = bz_offset(up, g.waves, t)
            raw_out: f64 = bz_offset(out, g.waves, t)
            size_up: f64 = -raw_up if raw_up < 0.0 else raw_up
            size_out: f64 = -raw_out if raw_out < 0.0 else raw_out
            peak_up <- size_up if size_up > peak_up
            peak_out <- size_out if size_out > peak_out
            probe <- probe + 1
        # `max(...) or 1.0` -- a flat series would divide by nothing.
        peak_up <- 1.0 if peak_up == 0.0
        peak_out <- 1.0 if peak_out == 0.0
        gain_up: f64 = g.swing / peak_up
        # Squarer than it is tall, like a real one.
        gain_out: f64 = g.swing * 0.78 / peak_out
        # `raw`, with the two leads grown on. The near lead runs TOWARDS the
        # curve and the far one away from it, and neither repeats the tip.
        rx: mutable darray[f64] = Floats::zeros(BZ_RAW_POINTS)
        ry: mutable darray[f64] = Floats::zeros(BZ_RAW_POINTS)
        rz: mutable darray[f64] = Floats::zeros(BZ_RAW_POINTS)
        curve: mutable i64 = 0
        while curve < BZ_FINE |curve, up, out, g, gain_up, gain_out, rx, ry, rz|:
            t: f64 = curve.f64() / 600.0
            Floats::put(&rx, BZ_LEAD_STEPS + curve, g.span * (t - 0.5))
            Floats::put(&ry, BZ_LEAD_STEPS + curve, bz_offset(up, g.waves, t) * gain_up)
            Floats::put(&rz, BZ_LEAD_STEPS + curve, bz_offset(out, g.waves, t) * gain_out)
            curve <- curve + 1
        head_tip: Vec3 = vec3(Floats::at(rx, BZ_LEAD_STEPS), Floats::at(ry, BZ_LEAD_STEPS), Floats::at(rz, BZ_LEAD_STEPS))
        head_in: Vec3 = vec3(Floats::at(rx, BZ_LEAD_STEPS + 1), Floats::at(ry, BZ_LEAD_STEPS + 1), Floats::at(rz, BZ_LEAD_STEPS + 1))
        head_away: Vec3 = v_unit(v_sub(head_tip, head_in))
        last: i64 = BZ_LEAD_STEPS + BZ_FINE - 1
        tail_tip: Vec3 = vec3(Floats::at(rx, last), Floats::at(ry, last), Floats::at(rz, last))
        tail_in: Vec3 = vec3(Floats::at(rx, last - 1), Floats::at(ry, last - 1), Floats::at(rz, last - 1))
        tail_away: Vec3 = v_unit(v_sub(tail_tip, tail_in))
        lead: mutable i64 = 0
        while lead < BZ_LEAD_STEPS |lead, head_tip, head_away, tail_tip, tail_away, last, rx, ry, rz|:
            # `range(steps, 0, -1)` at the start, `range(1, steps + 1)` at the
            # end, so both leads come back in the wire's own order.
            near_step: i64 = BZ_LEAD_STEPS - lead
            near: Vec3 = v_add(head_tip, v_scale(head_away, BZ_LEAD * near_step.f64() / BZ_LEAD_STEPS.f64()))
            Floats::put(&rx, lead, near.x)
            Floats::put(&ry, lead, near.y)
            Floats::put(&rz, lead, near.z)
            far_step: i64 = lead + 1
            far: Vec3 = v_add(tail_tip, v_scale(tail_away, BZ_LEAD * far_step.f64() / BZ_LEAD_STEPS.f64()))
            Floats::put(&rx, last + far_step, far.x)
            Floats::put(&ry, last + far_step, far.y)
            Floats::put(&rz, last + far_step, far.z)
            lead <- lead + 1
        # Resample at even steps of arc length: everything downstream wants
        # even spacing, and a curve sampled evenly in its parameter is not.
        runs: mutable darray[f64] = Floats::zeros(BZ_RAW_POINTS)
        Floats::put(&runs, 0, 0.0)
        walk: mutable i64 = 1
        while walk < BZ_RAW_POINTS |walk, rx, ry, rz, runs|:
            before: Vec3 = vec3(Floats::at(rx, walk - 1), Floats::at(ry, walk - 1), Floats::at(rz, walk - 1))
            after: Vec3 = vec3(Floats::at(rx, walk), Floats::at(ry, walk), Floats::at(rz, walk))
            Floats::put(&runs, walk, Floats::at(runs, walk - 1) + v_length(v_sub(after, before)))
            walk <- walk + 1
        total: f64 = Floats::at(runs, BZ_RAW_POINTS - 1)
        raw_samples: i64 = (total / 0.22).i64()
        samples: i64 = 120 if raw_samples < 120 else raw_samples
        cursor: mutable i64 = 0
        take: mutable i64 = 0
        while take <= samples |take, samples, total, runs, rx, ry, rz, cursor, wire|:
            want: f64 = total * take.f64() / samples.f64()
            while cursor < BZ_RAW_POINTS - 2 and Floats::at(runs, cursor + 1) < want |cursor, runs, want|:
                cursor <- cursor + 1
            run: f64 = Floats::at(runs, cursor + 1) - Floats::at(runs, cursor)
            blend: f64 = 0.0 if run <= 0.0 else (want - Floats::at(runs, cursor)) / run
            here: Vec3 = v_lerp(vec3(Floats::at(rx, cursor), Floats::at(ry, cursor), Floats::at(rz, cursor)), vec3(Floats::at(rx, cursor + 1), Floats::at(ry, cursor + 1), Floats::at(rz, cursor + 1)), blend)
            Floats::put(&wire.px, take, here.x)
            Floats::put(&wire.py, take, here.y)
            Floats::put(&wire.pz, take, here.z)
            take <- take + 1
        wire.count <- samples + 1
        spot: mutable i64 = 0
        while spot < wire.count |spot, wire|:
            low: i64 = 0 if spot - 1 < 0 else spot - 1
            high: i64 = wire.count - 1 if spot + 1 > wire.count - 1 else spot + 1
            way: Vec3 = v_unit(v_sub(bz_point(wire, high), bz_point(wire, low)))
            Floats::put(&wire.tx, spot, way.x)
            Floats::put(&wire.ty, spot, way.y)
            Floats::put(&wire.tz, spot, way.z)
            spot <- spot + 1
        Floats::put(&wire.arcs, 0, 0.0)
        along: mutable i64 = 1
        while along < wire.count |along, wire|:
            Floats::put(&wire.arcs, along, Floats::at(wire.arcs, along - 1) + v_length(v_sub(bz_point(wire, along), bz_point(wire, along - 1))))
            along <- along + 1
        wire.span <- g.span
        wire.length <- Floats::at(wire.arcs, wire.count - 1)
        wire.radius <- BZ_WIRE_RADIUS
        wire.beads <- bz_bead_count(g, wire.length)
        return g

# --- where the loop is looking from ---

# Right, up and forward for this rung's camera, as world vectors. Lives here
# rather than in the screen because the ports are NAMED in it -- "left" means
# left as drawn.
def bz_camera_forward(g: BzGrade) -> Vec3:
    can Abort.Panic:
        angle: f64 = g.view * BZ_DEG_TO_RAD
        return v_unit(vec3(sin(angle), -0.36, -cos(angle)))

def bz_camera_right(g: BzGrade) -> Vec3:
    can Abort.Panic:
        return v_unit(v_cross(bz_camera_forward(g), vec3(0.0, 1.0, 0.0)))

def bz_camera_up(g: BzGrade) -> Vec3:
    can Abort.Panic:
        return v_unit(v_cross(bz_camera_right(g), bz_camera_forward(g)))

# The eleven ports, in the order the boundary hands them out.
const BZ_UP: i64 = 0
const BZ_DOWN: i64 = 1
const BZ_LEFT: i64 = 2
const BZ_RIGHT: i64 = 3
const BZ_IN: i64 = 4
const BZ_OUT: i64 = 5
const BZ_TILT_UP: i64 = 6
const BZ_TILT_DOWN: i64 = 7
const BZ_TILT_LEFT: i64 = 8
const BZ_TILT_RIGHT: i64 = 9
const BZ_GRIP: i64 = 10
const BZ_PORTS: i64 = 11

def bz_push_vector(g: BzGrade, port: i64) -> Vec3:
    can Abort.Panic:
        if port == BZ_UP:
            return bz_camera_up(g)
        if port == BZ_DOWN:
            return v_scale(bz_camera_up(g), -1.0)
        if port == BZ_LEFT:
            return v_scale(bz_camera_right(g), -1.0)
        if port == BZ_RIGHT:
            return bz_camera_right(g)
        if port == BZ_IN:
            return bz_camera_forward(g)
        return v_scale(bz_camera_forward(g), -1.0)

# --- contact ---

# Nearest and furthest points of an ellipse from the origin: coarse samples,
# then a ternary search on the sample either side of the maximum. The furthest
# point decides whether a trial buzzes, and a one-percent sampling error is a
# fault the player did not commit.
struct BzReach:
    near: mutable f64
    far: mutable f64
    angle: mutable f64

def bz_ellipse_at(offset_long: f64, offset_wide: f64, semi_long: f64, semi_wide: f64, angle: f64) -> f64:
    can Abort.Panic:
        x: f64 = offset_long + semi_long * cos(angle)
        y: f64 = offset_wide + semi_wide * sin(angle)
        return x * x + y * y

def bz_ellipse_reach(offset_long: f64, offset_wide: f64, semi_long: f64, semi_wide: f64) -> BzReach:
    can Abort.Panic:
        step: f64 = 2.0 * BZ_PI / BZ_ARC_SAMPLES.f64()
        best_far: mutable f64 = -1.0
        far_angle: mutable f64 = 0.0
        best_near: mutable f64 = 1.0 / 0.0
        probe: mutable i64 = 0
        while probe < BZ_ARC_SAMPLES |probe, step, offset_long, offset_wide, semi_long, semi_wide, best_far, far_angle, best_near|:
            angle: f64 = probe.f64() * step
            value: f64 = bz_ellipse_at(offset_long, offset_wide, semi_long, semi_wide, angle)
            if value > best_far:
                best_far <- value
                far_angle <- angle
            best_near <- value if value < best_near
            probe <- probe + 1
        low: mutable f64 = far_angle - step
        high: mutable f64 = far_angle + step
        turn: mutable i64 = 0
        while turn < 24 |turn, low, high, offset_long, offset_wide, semi_long, semi_wide|:
            third: f64 = (high - low) / 3.0
            one: f64 = low + third
            two: f64 = high - third
            if bz_ellipse_at(offset_long, offset_wide, semi_long, semi_wide, one) < bz_ellipse_at(offset_long, offset_wide, semi_long, semi_wide, two):
                low <- one
            else:
                high <- two
            turn <- turn + 1
        settled: f64 = (low + high) / 2.0
        refined: f64 = bz_ellipse_at(offset_long, offset_wide, semi_long, semi_wide, settled)
        out: mutable BzReach = zeroed
        out.near <- sqrt(best_near)
        out.far <- sqrt(refined if refined > best_far else best_far)
        out.angle <- settled
        return out

const BZ_MOST_CROSSINGS: i64 = 64

struct BzCrossings:
    px: mutable darray[f64]
    py: mutable darray[f64]
    pz: mutable darray[f64]
    tx: mutable darray[f64]
    ty: mutable darray[f64]
    tz: mutable darray[f64]
    arc: mutable darray[f64]
    square: mutable darray[f64]
    count: mutable i64

def bz_crossings_new() -> BzCrossings:
    can Memory.Allocate, Abort.Panic:
        out: mutable BzCrossings = zeroed
        out.px <- Floats::zeros(BZ_MOST_CROSSINGS)
        out.py <- Floats::zeros(BZ_MOST_CROSSINGS)
        out.pz <- Floats::zeros(BZ_MOST_CROSSINGS)
        out.tx <- Floats::zeros(BZ_MOST_CROSSINGS)
        out.ty <- Floats::zeros(BZ_MOST_CROSSINGS)
        out.tz <- Floats::zeros(BZ_MOST_CROSSINGS)
        out.arc <- Floats::zeros(BZ_MOST_CROSSINGS)
        out.square <- Floats::zeros(BZ_MOST_CROSSINGS)
        return out

# Every place the wire cuts the loop's plane, near `arc`. Only a window of the
# wire is examined: a crossing a metre away is not something the loop can be
# touching, and walking the whole polyline every frame would not fit in a
# frame's budget.
def bz_crossings(wire: BzWire&, centre: Vec3, axis: Vec3, arc: f64, reach: f64, found: mutable BzCrossings&):
    can Abort.Panic:
        found.count <- 0
        span: f64 = reach + 4.0
        step: f64 = bz_spacing(wire)
        if step <= 0.0:
            return
        raw_first: i64 = ((arc - span) / step).i64()
        first: i64 = 0 if raw_first < 0 else raw_first
        raw_last: i64 = ((arc + span) / step).i64() + 1
        top: i64 = wire.count - 2
        last: i64 = top if raw_last > top else raw_last
        before: mutable f64 = v_dot(v_sub(bz_point(wire, first), centre), axis)
        index: mutable i64 = first
        while index <= last |index, last, wire, centre, axis, step, before, found|:
            after: f64 = v_dot(v_sub(bz_point(wire, index + 1), centre), axis)
            if (before <= 0.0 and after > 0.0) or (before >= 0.0 and after < 0.0):
                gap: f64 = before - after
                size: f64 = -gap if gap < 0.0 else gap
                blend: mutable f64 = 0.0 if size < 1e-12 else before / gap
                blend <- 1.0 if blend > 1.0
                blend <- 0.0 if blend < 0.0
                point: Vec3 = v_lerp(bz_point(wire, index), bz_point(wire, index + 1), blend)
                tangent: Vec3 = v_unit(v_lerp(bz_tangent(wire, index), bz_tangent(wire, index + 1), blend))
                slot: i64 = found.count
                if slot < BZ_MOST_CROSSINGS:
                    Floats::put(&found.px, slot, point.x)
                    Floats::put(&found.py, slot, point.y)
                    Floats::put(&found.pz, slot, point.z)
                    Floats::put(&found.tx, slot, tangent.x)
                    Floats::put(&found.ty, slot, tangent.y)
                    Floats::put(&found.tz, slot, tangent.z)
                    Floats::put(&found.arc, slot, Floats::at(wire.arcs, index) + blend * step)
                    lean: f64 = v_dot(tangent, axis)
                    size_lean: f64 = -lean if lean < 0.0 else lean
                    Floats::put(&found.square, slot, BZ_MIN_COS if size_lean < BZ_MIN_COS else size_lean)
                    found.count <- slot + 1
            before <- after
            index <- index + 1

struct BzContact:
    found: mutable bool
    depth: mutable f64
    escape: mutable Vec3
    arc: mutable f64
    outside: mutable bool
    jammed: mutable bool

# Whether the wire touches the loop at this crossing, and how hard.
#
# In the loop's own plane the wire's tube cuts an ELLIPSE: half a wire thick
# across, and `radius / square` long, stretched along the direction the wire
# leans. The loop is an annulus in that same plane. Three cases: wholly inside
# the hole (threaded cleanly), wholly outside the metal (some other part of the
# wire passing by), or a touch.
def bz_crossing_contact(crossings_at: BzCrossings&, slot: i64, centre: Vec3, axis: Vec3, hole: f64, radius: f64, rim: f64) -> BzContact:
    can Abort.Panic:
        out: mutable BzContact = zeroed
        out.found <- false
        point: Vec3 = vec3(Floats::at(crossings_at.px, slot), Floats::at(crossings_at.py, slot), Floats::at(crossings_at.pz, slot))
        tangent: Vec3 = vec3(Floats::at(crossings_at.tx, slot), Floats::at(crossings_at.ty, slot), Floats::at(crossings_at.tz, slot))
        square: f64 = Floats::at(crossings_at.square, slot)
        offset: Vec3 = v_sub(point, centre)
        # In-plane frame: `along` is the direction the wire leans, which is the
        # ellipse's long axis by construction.
        leaning: Vec3 = v_sub(tangent, v_scale(axis, v_dot(tangent, axis)))
        along: mutable Vec3 = zeroed
        if v_length(leaning) < 1e-9:
            # Dead square to the loop: the ellipse is a circle, so any in-plane
            # direction will do and the choice cannot matter.
            along <- v_unit(v_sub(offset, v_scale(axis, v_dot(offset, axis))))
            if v_length(v_sub(along, vec3(1.0, 0.0, 0.0))) < 1e-9:
                along <- v_unit(v_cross(axis, vec3(0.0, 1.0, 0.0)))
        else:
            along <- v_unit(leaning)
        wide: Vec3 = v_unit(v_cross(axis, along))
        semi_long: f64 = radius / square
        semi_wide: f64 = radius
        long_off: f64 = v_dot(offset, along)
        wide_off: f64 = v_dot(offset, wide)
        reach: BzReach = bz_ellipse_reach(long_off, wide_off, semi_long, semi_wide)
        outer: f64 = hole + rim
        if reach.near > outer:
            return out
        if reach.far < hole:
            return out
        out.found <- true
        out.arc <- Floats::at(crossings_at.arc, slot)
        if reach.far - hole <= outer - reach.near:
            # The inside of the hole is the closer wall to escape past.
            deep: Vec3 = v_add(v_scale(along, long_off + semi_long * cos(reach.angle)), v_scale(wide, wide_off + semi_wide * sin(reach.angle)))
            out.depth <- reach.far - hole
            out.escape <- v_unit(deep)
            out.outside <- false
            out.jammed <- semi_long >= hole
            return out
        # The wire is against the outside of the loop: back the loop off.
        outward: Vec3 = v_sub(offset, v_scale(axis, v_dot(offset, axis)))
        out.depth <- outer - reach.near
        out.escape <- v_scale(v_unit(outward), -1.0) if v_length(outward) > 1e-9 else wide
        out.outside <- true
        out.jammed <- false
        return out

# --- the wrist ---

def bz_axis_of(yaw: f64, pitch: f64) -> Vec3:
    can Abort.Panic:
        flat: f64 = cos(pitch)
        return vec3(flat * cos(yaw), sin(pitch), -flat * sin(yaw))

def bz_yaw_of(axis: Vec3) -> f64:
    can Abort.Panic:
        unit_axis: Vec3 = v_unit(axis)
        return atan2(-unit_axis.z, unit_axis.x)

def bz_pitch_of(axis: Vec3) -> f64:
    can Abort.Panic:
        unit_axis: Vec3 = v_unit(axis)
        held: mutable f64 = unit_axis.y
        held <- -1.0 if held < -1.0
        held <- 1.0 if held > 1.0
        return asin(held)

# An angle difference brought into (-pi, pi].
def bz_wrap(angle: f64) -> f64:
    can Abort.Panic:
        out: mutable f64 = angle
        while out > BZ_PI |out|:
            out <- out - 2.0 * BZ_PI
        while out <= -BZ_PI |out|:
            out <- out + 2.0 * BZ_PI
        return out

# --- the hand ---

struct BzHand:
    centre: mutable Vec3
    velocity: mutable Vec3
    yaw: mutable f64
    pitch: mutable f64
    yaw_rate: mutable f64
    pitch_rate: mutable f64
    # The tremor: an Ornstein-Uhlenbeck process on ACCELERATION, so it has a
    # correlation time rather than being white noise that averages away inside
    # one frame.
    drift: mutable Vec3
    arc: mutable f64
    touches: mutable i64
    scraping: mutable bool
    quiet: mutable f64
    home: mutable bool
    rng: mutable MT19937
    gauss: mutable GaussCache
    work: mutable BzCrossings

def bz_hand_new(wire: BzWire&, seed: i64) -> BzHand:
    can Memory.Allocate, Abort.Panic:
        hand: mutable BzHand = zeroed
        hand.rng <- mt19937_new()
        mt_seed_int(&hand.rng, seed.u64())
        hand.work <- bz_crossings_new()
        hand.centre <- bz_at_point(wire, BZ_THREADED_AT)
        hand.velocity <- vec3(0.0, 0.0, 0.0)
        tangent: Vec3 = bz_at_tangent(wire, BZ_THREADED_AT)
        hand.yaw <- bz_yaw_of(tangent)
        hand.pitch <- bz_pitch_of(tangent)
        hand.arc <- BZ_THREADED_AT
        return hand

def bz_hand_axis(hand: BzHand&) -> Vec3:
    can Abort.Panic:
        return bz_axis_of(hand.yaw, hand.pitch)

def bz_beads_left(hand: BzHand&, wire: BzWire&) -> i64:
    can Abort.Panic:
        return wire.beads - bz_bead_at(wire, hand.arc)

# How far off the wire's centre the loop is sitting, in cm. Nothing in the
# physics reads it -- it is for the screen's gauge and for the pilot.
#
# A loop with NO crossing at all reads as fully off centre rather than as
# perfectly centred: a gauge that reads "dead centre" when it means "cannot
# find the wire" is the kind of instrument that gets believed.
def bz_offset_of(hand: mutable BzHand&, wire: BzWire&, g: BzGrade) -> f64:
    can Abort.Panic:
        bz_crossings(wire, hand.centre, bz_hand_axis(hand), hand.arc, g.hole + BZ_RIM, &hand.work)
        if hand.work.count == 0:
            return g.hole
        best: mutable f64 = 0.0
        slot: mutable i64 = 0
        while slot < hand.work.count |slot, hand, best|:
            here: Vec3 = vec3(Floats::at(hand.work.px, slot), Floats::at(hand.work.py, slot), Floats::at(hand.work.pz, slot))
            gap: f64 = v_length(v_sub(here, hand.centre))
            if slot == 0 or gap < best:
                best <- gap
            slot <- slot + 1
        return best

# Advance the tremor one tick, exactly rather than by Euler. An OU process has
# a closed-form update over any step, so the tremor a run feels is the same
# whether it is driven at thirty ticks a second or at two hundred.
def bz_shiver(hand: mutable BzHand&, g: BzGrade, dt: f64):
    can Abort.Panic:
        if g.tremor <= 0.0:
            hand.drift <- vec3(0.0, 0.0, 0.0)
            return
        tau: f64 = 1e-3 if g.tremor_tau < 1e-3 else g.tremor_tau
        keep: f64 = exp(-dt / tau)
        span: f64 = 1.0 - keep * keep
        kick: f64 = g.tremor * sqrt(0.0 if span < 0.0 else span)
        # Three draws, in x, y, z order -- and `py_gauss` only consumes
        # randomness on every other one, so the count matters.
        x: f64 = hand.drift.x * keep + kick * py_gauss(&hand.rng, &hand.gauss, 0.0, 1.0)
        y: f64 = hand.drift.y * keep + kick * py_gauss(&hand.rng, &hand.gauss, 0.0, 1.0)
        z: f64 = hand.drift.z * keep + kick * py_gauss(&hand.rng, &hand.gauss, 0.0, 1.0)
        hand.drift <- vec3(x, y, z)

# Roll the wrist, or let it follow the wire by itself.
def bz_turn(hand: mutable BzHand&, wire: BzWire&, g: BzGrade, dt: f64, pitch_push: f64, yaw_push: f64, grip: bool):
    can Abort.Panic:
        if g.twist <= 0.0:
            # The bottom half of the ladder aims the loop for you, with a lag.
            # The four tilt ports are still there and still do nothing.
            tangent: Vec3 = bz_at_tangent(wire, hand.arc)
            want_yaw: f64 = bz_yaw_of(tangent)
            want_pitch: f64 = bz_pitch_of(tangent)
            raw: f64 = BZ_ALIGN_RATE * dt
            blend: f64 = 1.0 if raw > 1.0 else raw
            hand.yaw <- hand.yaw + bz_wrap(want_yaw - hand.yaw) * blend
            hand.pitch <- hand.pitch + (want_pitch - hand.pitch) * blend
            hand.yaw_rate <- 0.0
            hand.pitch_rate <- 0.0
            return
        damp: f64 = g.drag * (BZ_GRIP_DRAG if grip else 1.0)
        pitch_want: f64 = 0.0 if grip else pitch_push
        yaw_want: f64 = 0.0 if grip else yaw_push
        hand.pitch_rate <- hand.pitch_rate + (g.twist * pitch_want - damp * hand.pitch_rate) * dt
        hand.yaw_rate <- hand.yaw_rate + (g.twist * yaw_want - damp * hand.yaw_rate) * dt
        hand.pitch_rate <- -g.top_twist if hand.pitch_rate < -g.top_twist else (g.top_twist if hand.pitch_rate > g.top_twist else hand.pitch_rate)
        hand.yaw_rate <- -g.top_twist if hand.yaw_rate < -g.top_twist else (g.top_twist if hand.yaw_rate > g.top_twist else hand.yaw_rate)
        hand.pitch <- hand.pitch + hand.pitch_rate * dt
        hand.yaw <- hand.yaw + hand.yaw_rate * dt
        size: f64 = -hand.pitch if hand.pitch < 0.0 else hand.pitch
        if size > BZ_TILT_LIMIT:
            hand.pitch <- copysign(BZ_TILT_LIMIT, hand.pitch)
            hand.pitch_rate <- 0.0

# The worst thing the loop is touching, or nothing.
def bz_deepest(hand: mutable BzHand&, wire: BzWire&, g: BzGrade) -> BzContact:
    can Abort.Panic:
        axis: Vec3 = bz_hand_axis(hand)
        bz_crossings(wire, hand.centre, axis, hand.arc, g.hole + BZ_RIM, &hand.work)
        worst: mutable BzContact = zeroed
        worst.found <- false
        slot: mutable i64 = 0
        while slot < hand.work.count |slot, hand, wire, g, axis, worst|:
            hit: BzContact = bz_crossing_contact(&hand.work, slot, hand.centre, axis, g.hole, wire.radius, BZ_RIM)
            if hit.found and (not worst.found or hit.depth > worst.depth):
                worst <- hit
            slot <- slot + 1
        return worst

# Push the loop back out of the wire, and say if that was fresh. A hard
# constraint rather than a bounce: the loop is projected onto the outside of
# the constraint and the part of its velocity heading into it is removed, all
# but BOUNCE of it. A wrist turned somewhere the wire will not admit is put
# back where it was, because the wire is in the way of the TURN as much as of
# the move.
def bz_settle(hand: mutable BzHand&, wire: BzWire&, g: BzGrade, dt: f64, was: Vec3, held_yaw: f64, held_pitch: f64) -> bool:
    can Abort.Panic:
        hit: mutable BzContact = bz_deepest(hand, wire, g)
        if not hit.found:
            hand.quiet <- hand.quiet + dt
            hand.scraping <- false if hand.quiet >= BZ_QUIET_SECONDS
            return false
        hand.quiet <- 0.0
        if hit.jammed:
            hand.yaw <- held_yaw
            hand.pitch <- held_pitch
            hand.yaw_rate <- 0.0
            hand.pitch_rate <- 0.0
            hit <- bz_deepest(hand, wire, g)
        if hit.found:
            hand.centre <- v_add(hand.centre, v_scale(hit.escape, hit.depth))
            into: f64 = v_dot(hand.velocity, hit.escape)
            if into < 0.0:
                hand.velocity <- v_add(hand.velocity, v_scale(hit.escape, -into * (1.0 + BZ_BOUNCE)))
            again: BzContact = bz_deepest(hand, wire, g)
            if again.found:
                # Still stuck after one projection: the tick asked for
                # something the wire simply does not allow, so it does not
                # happen at all.
                hand.centre <- was
                hand.velocity <- vec3(0.0, 0.0, 0.0)
        fresh: bool = not hand.scraping
        hand.scraping <- true
        hand.touches <- hand.touches + 1 if fresh
        return fresh

# Re-read how far along the wire the loop has got, BY CONTINUITY rather than by
# proximity: of the crossings the loop's plane has, the one that was the
# threading point is the one nearest where it was last tick. Nearest to the
# loop's centre instead would jump between the two halves of a hairpin.
def bz_locate(hand: mutable BzHand&, wire: BzWire&, g: BzGrade):
    can Abort.Panic:
        bz_crossings(wire, hand.centre, bz_hand_axis(hand), hand.arc, g.hole + BZ_RIM, &hand.work)
        reach: f64 = g.hole + BZ_RIM
        want: mutable f64 = 0.0
        best: mutable f64 = 0.0
        any_threaded: mutable bool = false
        slot: mutable i64 = 0
        while slot < hand.work.count |slot, hand, reach, want, best, any_threaded|:
            here: Vec3 = vec3(Floats::at(hand.work.px, slot), Floats::at(hand.work.py, slot), Floats::at(hand.work.pz, slot))
            if v_length(v_sub(here, hand.centre)) <= reach:
                arc: f64 = Floats::at(hand.work.arc, slot)
                gap: f64 = arc - hand.arc
                size: f64 = -gap if gap < 0.0 else gap
                if not any_threaded or size < best:
                    any_threaded <- true
                    best <- size
                    want <- arc
            slot <- slot + 1
        if not any_threaded:
            # Off the wire. WHICH END matters, and only one answer to that
            # question is allowed to pay a green: the safe reading of a bad
            # moment is not "the wire is finished".
            if hand.arc >= wire.length - BZ_LEAD * 0.5:
                hand.home <- true
                hand.arc <- wire.length
            else:
                held: mutable f64 = hand.arc
                held <- wire.length if held > wire.length
                held <- BZ_THREADED_AT if held < BZ_THREADED_AT
                hand.arc <- held
                hand.centre <- bz_at_point(wire, hand.arc)
                hand.velocity <- vec3(0.0, 0.0, 0.0)
            return
        # A safety rail rather than a rule of the game: speed and the contact
        # projection are both bounded, so this cannot bind.
        cap: f64 = 2.0 * g.top_speed / BZ_SLOWEST_HZ
        low: f64 = hand.arc - cap
        high: f64 = hand.arc + cap
        settled: mutable f64 = want
        settled <- low if settled < low
        settled <- high if settled > high
        hand.arc <- settled
        hand.home <- true if hand.arc >= wire.length - 1e-6

struct BzStep:
    arc: mutable f64
    buzzed: mutable bool
    scraping: mutable bool
    home: mutable bool

# Integrate one frame and settle whatever it ran into. Semi-implicit Euler:
# the velocity is updated first and the position from the NEW velocity.
def bz_advance(hand: mutable BzHand&, wire: BzWire&, g: BzGrade, dt_in: f64, has_push: bool, push: Vec3, twist_pitch: f64, twist_yaw: f64, grip: bool) -> BzStep:
    can Abort.Panic:
        step: mutable BzStep = zeroed
        dt: mutable f64 = dt_in
        dt <- 0.0 if dt < 0.0
        dt <- 1.0 / BZ_SLOWEST_HZ if dt > 1.0 / BZ_SLOWEST_HZ
        if dt <= 0.0 or hand.home:
            step.arc <- hand.arc
            step.buzzed <- false
            step.scraping <- hand.scraping
            step.home <- hand.home
            return step
        bz_shiver(hand, g, dt)
        drag: f64 = g.drag * (BZ_GRIP_DRAG if grip else 1.0)
        accel: mutable Vec3 = vec3(hand.drift.x - drag * hand.velocity.x, hand.drift.y - drag * hand.velocity.y - g.sag, hand.drift.z - drag * hand.velocity.z)
        if has_push and not grip:
            accel <- v_add(accel, v_scale(push, g.thrust))
        speed: mutable Vec3 = v_add(hand.velocity, v_scale(accel, dt))
        fast: f64 = v_length(speed)
        speed <- v_scale(speed, g.top_speed / fast) if fast > g.top_speed
        hand.velocity <- speed
        was: Vec3 = hand.centre
        hand.centre <- v_add(hand.centre, v_scale(speed, dt))
        held_yaw: f64 = hand.yaw
        held_pitch: f64 = hand.pitch
        bz_turn(hand, wire, g, dt, twist_pitch, twist_yaw, grip)
        buzzed: bool = bz_settle(hand, wire, g, dt, was, held_yaw, held_pitch)
        bz_locate(hand, wire, g)
        step.arc <- hand.arc
        step.buzzed <- buzzed
        step.scraping <- hand.scraping
        step.home <- hand.home
        return step

# --- a hand that knows what it is doing ---
#
# The reference pilot. It exists to give a policy that can actually finish a
# wire through the same eleven ports a learner has, and to let the ladder be
# measured instead of guessed at. It reads the true state, which is exactly
# what makes it a yardstick rather than a competitor.

const BZ_PILOT_GAIN: f64 = 8.0
const BZ_PILOT_BRAKE: f64 = 12.0
const BZ_PILOT_CRUISE: f64 = 0.72
const BZ_PILOT_CRAWL: f64 = 0.18
const BZ_TILT_SLACK: f64 = 0.10
const BZ_TILT_LEAD: f64 = 0.16

# How far in front of itself the pilot reads the wire, in cm. Only the HEADING
# is taken from up there, never the position.
def bz_look_ahead(g: BzGrade) -> f64:
    can Abort.Panic:
        raw: f64 = 2.2 * bz_clearance(g)
        out: mutable f64 = raw
        out <- 2.4 if out > 2.4
        out <- 0.55 if out < 0.55
        return out

# One port, chosen by a controller that can see everything.
#
# The demand is split in two and keeping the halves apart is what makes it work
# at all. SIDEWAYS it steers at the wire's own centreline HERE, at the loop's
# own station, so it is never trying to be anywhere but in the middle of its
# hole. FORWARDS it runs along the heading a little way up the wire, so it
# leans into a bend before arriving in one.
def bz_pilot_port(hand: mutable BzHand&, wire: BzWire&, g: BzGrade) -> i64:
    can Abort.Panic:
        raw_ahead: f64 = hand.arc + bz_look_ahead(g)
        ahead: f64 = wire.length if raw_ahead > wire.length else raw_ahead
        tangent: Vec3 = bz_at_tangent(wire, ahead)
        room: f64 = 1e-6 if bz_clearance(g) < 1e-6 else bz_clearance(g)
        raw_risk: f64 = bz_offset_of(hand, wire, g) / room
        risk: f64 = 1.0 if raw_risk > 1.0 else raw_risk
        if g.twist > 0.0:
            want_yaw: f64 = bz_yaw_of(tangent)
            want_pitch: f64 = bz_pitch_of(tangent)
            off_yaw: f64 = bz_wrap(want_yaw - hand.yaw) - hand.yaw_rate * BZ_TILT_LEAD
            off_pitch: f64 = (want_pitch - hand.pitch) - hand.pitch_rate * BZ_TILT_LEAD
            size_yaw: f64 = -off_yaw if off_yaw < 0.0 else off_yaw
            size_pitch: f64 = -off_pitch if off_pitch < 0.0 else off_pitch
            worst: f64 = size_pitch if size_pitch > size_yaw else size_yaw
            # A wrist badly out of line beats anything else: past about sixty
            # degrees no amount of steering helps, because the hole stops
            # admitting the wire at all.
            if worst > BZ_TILT_SLACK and (risk < 0.7 or worst > 3.0 * BZ_TILT_SLACK):
                if size_pitch > size_yaw:
                    return BZ_TILT_UP if off_pitch > 0.0 else BZ_TILT_DOWN
                return BZ_TILT_LEFT if off_yaw > 0.0 else BZ_TILT_RIGHT
        # Slow for the edge and slow for the bend, both the same instinct a
        # person has: speed is only ever spent to beat the clock.
        here: Vec3 = bz_at_point(wire, hand.arc)
        running: Vec3 = bz_at_tangent(wire, hand.arc)
        raw_bend: f64 = 1.0 - v_dot(running, tangent)
        bend: f64 = 0.0 if raw_bend < 0.0 else raw_bend
        pace: mutable f64 = BZ_PILOT_CRUISE - (BZ_PILOT_CRUISE - BZ_PILOT_CRAWL) * risk
        slack: f64 = 1.0 - 6.0 * bend
        pace <- pace * (0.3 if slack < 0.3 else slack)
        cruise: f64 = bz_hand_speed(g) * pace
        # Sideways: whatever it takes to sit in the middle of the hole.
        off_centre: Vec3 = v_sub(here, hand.centre)
        sideways: Vec3 = v_sub(off_centre, v_scale(running, v_dot(off_centre, running)))
        wanted: mutable Vec3 = v_add(v_scale(tangent, cruise), v_scale(sideways, BZ_PILOT_GAIN))
        fast: f64 = v_length(wanted)
        wanted <- v_scale(wanted, g.top_speed / fast) if fast > g.top_speed
        # The plant already takes `drag * v` off every tick, so a demand that
        # did not put it back would always fall short of what it asked for.
        # Deliberately NOT corrected for the drift: the tremor is a force
        # inside the arm and nothing on screen carries it.
        demand: Vec3 = v_add(v_add(v_scale(v_sub(wanted, hand.velocity), BZ_PILOT_BRAKE), v_scale(hand.velocity, g.drag)), vec3(0.0, g.sag, 0.0))
        if v_length(demand) < g.thrust * 0.04:
            return BZ_GRIP
        best: mutable i64 = BZ_GRIP
        score: mutable f64 = 0.0
        port: mutable i64 = 0
        while port < 6 |port, g, demand, best, score|:
            value: f64 = v_dot(bz_push_vector(g, port), demand)
            if value > score:
                best <- port
                score <- value
            port <- port + 1
        return best

# Drive one wire with the reference pilot. Returns the run's outcome; `hand`
# carries the rest.
struct BzRun:
    ticks: mutable i64
    touches: mutable i64
    home: mutable bool
    arc: mutable f64
    beads_left: mutable i64

def bz_fly(wire: BzWire&, g: BzGrade, hand: mutable BzHand&, hz: f64, seconds: f64, ports_out: mutable darray[i64]&, most_ports: i64) -> BzRun:
    can Abort.Panic:
        dt: f64 = 1.0 / hz
        limit: i64 = (seconds * hz).i64()
        tick: mutable i64 = 0
        while tick < limit and not hand.home |tick, limit, hand, wire, g, dt, ports_out, most_ports|:
            port: i64 = bz_pilot_port(hand, wire, g)
            Ints::put(ports_out, tick, port) if tick < most_ports
            has_push: bool = port < 6
            push: Vec3 = bz_push_vector(g, port) if has_push else vec3(0.0, 0.0, 0.0)
            twist_pitch: mutable f64 = 0.0
            twist_yaw: mutable f64 = 0.0
            twist_pitch <- 1.0 if port == BZ_TILT_UP
            twist_pitch <- -1.0 if port == BZ_TILT_DOWN
            twist_yaw <- 1.0 if port == BZ_TILT_LEFT
            twist_yaw <- -1.0 if port == BZ_TILT_RIGHT
            _ = bz_advance(hand, wire, g, dt, has_push, push, twist_pitch, twist_yaw, port == BZ_GRIP)
            tick <- tick + 1
        out: mutable BzRun = zeroed
        out.ticks <- tick
        out.touches <- hand.touches
        out.home <- hand.home
        out.arc <- hand.arc
        out.beads_left <- bz_beads_left(hand, wire)
        return out
