            g.view <- 16.0
        if index == 5:
            g.span <- 34.0
            g.waves <- 4
            g.swing <- 5.4
            g.slope <- 1.70
            g.hole <- 0.62
            g.sag <- 6.8
            g.tremor <- 3.20
