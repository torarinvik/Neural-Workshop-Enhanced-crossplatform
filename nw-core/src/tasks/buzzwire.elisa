            g.top_twist <- 1.43
            g.touches <- 2
            g.seconds <- 34.0
            g.view <- 24.0
        if index == 7:
            g.span <- 33.0
            g.waves <- 6
            g.swing <- 5.3
            g.slope <- 1.42
            g.hole <- 0.49
            g.sag <- 7.7
            g.tremor <- 4.00
