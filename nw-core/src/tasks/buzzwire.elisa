            g.top_speed <- 4.43
            g.twist <- 0.0
            g.top_twist <- 0.00
            g.touches <- 4
            g.seconds <- 22.0
            g.view <- 8.0
        if index == 3:
            g.span <- 32.0
            g.waves <- 3
            g.swing <- 5.1
            g.slope <- 2.10
            g.hole <- 0.80
            g.sag <- 5.8
