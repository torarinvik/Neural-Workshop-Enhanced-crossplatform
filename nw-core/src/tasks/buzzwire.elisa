# Buzz Wire: thread a loop along a bent rod without touching it.
#
# Port of neural_workshop/buzzwire.py. Three-dimensional and float-heavy end to
# end, which makes it the first module here whose faithfulness rests on
# arithmetic rather than on container order. Four things were settled by
# MEASUREMENT before a line of it was written:
#
# 1. libm agrees. sin, cos, exp, atan2, sqrt, asin and pow all go through the
#    platform's libm on both sides -- CPython's `math` is a thin wrapper -- and
#    over 300 random arguments each, every one matched CPython bit for bit.
#    So the transcendentals are not a hazard here; the ARITHMETIC AROUND them
#    is, which is why operation order is followed literally throughout.
#
# 2. `math.radians` is the exception, and not for a libm reason: CPython
#    multiplies by a precomputed `pi/180`, so `x * pi / 180.0` -- two roundings
#    -- comes out different for a third of arguments. The constant is inlined.
#
# 3. FP contraction had to go. See elisa-core `-fstrict-fp`; scripts/env.sh
#    turns it on for the whole port. Nearly every line below is `a + b * c`.
#
# 4. `random.gauss` keeps half a draw in its pocket. See `py_gauss`.
#
# NOTE: needs elisacore_math (sqrt, sin, cos, exp, log, asin, atan2, pow,
# copysign, fabs) included by the driver, as every task module here does.

const BZ_WIRE_RADIUS: f64 = 0.15
const BZ_RIM: f64 = 0.28
const BZ_MIN_COS: f64 = 0.10
const BZ_ARC_SAMPLES: i64 = 32
const BZ_THREADED_AT: f64 = 1.1
const BZ_LEAD: f64 = 2.2
const BZ_BEADS_WANTED: i64 = 40
const BZ_BEAD_MARGIN: f64 = 2.5
const BZ_SLOWEST_HZ: f64 = 30.0
const BZ_GRIP_DRAG: f64 = 6.0
const BZ_ALIGN_RATE: f64 = 9.0
const BZ_BOUNCE: f64 = 0.15
const BZ_QUIET_SECONDS: f64 = 0.06
const BZ_TILT_LIMIT: f64 = 1.15
const BZ_PI: f64 = 3.141592653589793
# CPython's `math.radians` multiplies by ONE precomputed constant.
const BZ_DEG_TO_RAD: f64 = 0.017453292519943295

# --- vectors ---
#
# Plain triples of doubles, as in the reference, where the comment records that
# a NamedTuple with operators measured about three times the cost.
struct Vec3:
    x: mutable f64
    y: mutable f64
    z: mutable f64

def vec3(x: f64, y: f64, z: f64) -> Vec3:
    can Abort.Panic:
        out: mutable Vec3 = zeroed
        out.x <- x
        out.y <- y
        out.z <- z
        return out

def v_add(a: Vec3, b: Vec3) -> Vec3:
    can Abort.Panic:
        return vec3(a.x + b.x, a.y + b.y, a.z + b.z)

def v_sub(a: Vec3, b: Vec3) -> Vec3:
    can Abort.Panic:
        return vec3(a.x - b.x, a.y - b.y, a.z - b.z)

def v_scale(a: Vec3, k: f64) -> Vec3:
    can Abort.Panic:
        return vec3(a.x * k, a.y * k, a.z * k)

def v_dot(a: Vec3, b: Vec3) -> f64:
    can Abort.Panic:
        return a.x * b.x + a.y * b.y + a.z * b.z

def v_cross(a: Vec3, b: Vec3) -> Vec3:
    can Abort.Panic:
        return vec3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x)

def v_length(a: Vec3) -> f64:
    can Abort.Panic:
        return sqrt(a.x * a.x + a.y * a.y + a.z * a.z)

def v_unit(a: Vec3) -> Vec3:
    can Abort.Panic:
        size: f64 = v_length(a)
        if size < 1e-12:
            return vec3(1.0, 0.0, 0.0)
        return vec3(a.x / size, a.y / size, a.z / size)

def v_lerp(a: Vec3, b: Vec3, t: f64) -> Vec3:
    can Abort.Panic:
        return vec3(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t)

# --- the ladder ---

struct BzGrade:
    span: mutable f64
    waves: mutable i64
    swing: mutable f64
    slope: mutable f64
    hole: mutable f64
    sag: mutable f64
    tremor: mutable f64
    tremor_tau: mutable f64
    thrust: mutable f64
    drag: mutable f64
    top_speed: mutable f64
    twist: mutable f64
    top_twist: mutable f64
    touches: mutable i64
    seconds: mutable f64
    view: mutable f64

const BZ_GRADE_COUNT: i64 = 12

def bz_clamped_rung(rung: i64) -> i64:
    can Abort.Panic:
        out: mutable i64 = rung
        out <- 1 if out < 1
        out <- BZ_GRADE_COUNT if out > BZ_GRADE_COUNT
        return out

def bz_grade_of(rung: i64) -> BzGrade:
    can Abort.Panic:
        index: i64 = bz_clamped_rung(rung) - 1
        g: mutable BzGrade = zeroed
        if index == 0:
            g.span <- 26.0
            g.waves <- 1
            g.swing <- 4.2
            g.slope <- 3.00
            g.hole <- 1.20
            g.sag <- 0.0
