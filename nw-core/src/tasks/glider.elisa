include "../pyrandom.elisa"
include "../pymath.elisa"
include "../strings.elisa"

module Glider:
    const WIDTH: f64 = 100.0
    const HEIGHT: f64 = 60.0
    const X: f64 = 22.0
    const SIZE: f64 = 1.6
    const WALL: f64 = 6.0
    const TAU: f64 = 6.283185307179586
    const PENDING: i64 = 0
    const PASSED: i64 = 1
    const FLOOR: i64 = 2
    const ROOF: i64 = 3
    const COLLISION: i64 = 4

    struct Grade:
        rung: i64
        gap: f64
        speed: f64
        spacing: f64
        count: i64
        slide: f64
        gust: f64
        lift: f64
        sink: f64
        damp: f64

    struct Wall:
        x: f64
        centre: f64
        phase: f64

    struct Course:
        level: Grade
        walls: mutable Wall[10]
        gust_seed: mutable i64

    struct Point:
        time: f64
        y: f64

    struct Run:
        course: Course
        time: mutable f64
        y: mutable f64
        vy: mutable f64
        lifting: mutable bool
        passed: mutable i64
        result: mutable i64
        hit: mutable i64
        trail: mutable Point[24]
        trail_next: mutable i64
        trail_count: mutable i64

    def grade(rung: i64) -> Grade:
        r: i64 = 1 if rung < 1 else rung
        top: i64 = 0 if r < 20 else r - 20
        gap: f64 = 26.0 if r < 4 else (20.0 if r < 7 else (18.0 if r < 20 else (12.0 if top >= 13 else 17.0 - 0.4 * top.f64())))
        speed: f64 = 18.0 if r < 7 else (26.0 if r < 20 else (40.0 if top >= 13 else 27.0 + top.f64()))
        gust: f64 = 0.0 if r < 13 else (14.0 + (r - 13).f64() * 0.5 if r < 20 else (18 + top).f64())
        return Grade{rung: r, gap: gap, speed: speed, spacing: 42.0 if r < 4 else 34.0,
            count: 6 if r < 7 else (8 if r < 20 else 10), slide: 0.0 if r < 10 else 7.0,
            gust: gust, lift: 70.0 if r < 16 else 52.0, sink: 45.0 if r < 16 else 34.0, damp: 1.6 if r < 16 else 1.0}

    def trial(course: Course) -> Run:
        return Run{course: course, time: 0.0, y: HEIGHT / 2.0, vy: 0.0,
            lifting: false, passed: 0, result: PENDING, hit: 0, trail: zeroed, trail_next: 0, trail_count: 0}

    def gust(course: Course&, time: f64) -> f64:
        return 0.0 if course.level.gust == 0.0
        key: f64 = (course.gust_seed % 97).f64()
        return course.level.gust * (sin(time * 0.9 + key) * 0.6 + sin(time * 2.3 + key * 0.7) * 0.4)

    def wall_x(course: Course&, wall: Wall, time: f64) -> f64:
        return wall.x - course.level.speed * time

    def gap_centre(course: Course&, wall: Wall, time: f64) -> f64:
        return wall.centre + course.level.slide * sin(time * 1.3 + wall.phase)

    def step(run: mutable Run&, dt: f64, lift: bool):
        can Abort.Panic:
            return if run.result != PENDING
            run.time <- run.time + dt
            run.lifting <- lift
            course: Course& = &run.course
            level: Grade = course.level
            acc: f64 = (level.lift if lift else -level.sink) + gust(course, run.time) - level.damp * run.vy
            run.vy <- run.vy + acc * dt
            run.y <- run.y + run.vy * dt
            if (run.time * 20.0).i64() != ((run.time - dt) * 20.0).i64():
                run.trail[run.trail_next.usize()] <- Point{time: run.time, y: run.y}
                run.trail_next <- (run.trail_next + 1) % 24
                run.trail_count <- run.trail_count + 1 if run.trail_count < 24
            if run.y - SIZE < 0.0 or run.y + SIZE > HEIGHT:
                run.result <- FLOOR if run.y < HEIGHT / 2.0 else ROOF
                return
            passed: mutable i64 = 0
            for i in 0..<level.count |passed, level, course, run|:
                wall: Wall = course.walls[i.usize()]
                x: f64 = wall_x(course, wall, run.time)
                if x + WALL / 2.0 < X - SIZE:
                    passed <- passed + 1
                elif x - X < WALL / 2.0 + SIZE and X - x < WALL / 2.0 + SIZE:
                    delta: f64 = run.y - gap_centre(course, wall, run.time)
                    margin: f64 = level.gap / 2.0 - SIZE
                    if delta > margin or -delta > margin:
                        run.result <- COLLISION
                        run.hit <- i + 1
                        return
            run.passed <- passed
            run.result <- PASSED if passed == level.count

    def pilot(run: Run&) -> bool:
        can Abort.Panic:
            course: Course& = &run.course
            target: mutable f64 = run.y
            for i in 0..<course.level.count |course, run, target|:
                wall: Wall = course.walls[i.usize()]
                x: f64 = wall_x(course, wall, run.time)
                if x + WALL / 2.0 >= X - SIZE:
                    eta: f64 = (x - X) / course.level.speed
                    look: f64 = 0.0 if eta < 0.0 else (0.3 if eta > 0.3 else eta)
                    target <- gap_centre(course, wall, run.time + look)
                    break
            sink_y: f64 = run.y + run.vy * 0.25 - 0.5 * course.level.sink * 0.25 * 0.25
            return sink_y < target

    def deal(rung: i64, seed: i64) -> Course:
        can Abort.Panic:
            level: Grade = grade(rung)
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
            first: mutable Course = zeroed
            low: f64 = level.gap / 2.0 + level.slide + 4.0
            high: f64 = HEIGHT - level.gap / 2.0 - level.slide - 4.0
            for attempt in 0..<30 |rng, level, first, low, high|:
                course: mutable Course = Course{level: level, walls: zeroed, gust_seed: 0}
                x: mutable f64 = WIDTH + 10.0
                centre: mutable f64 = HEIGHT / 2.0
                for i in 0..<level.count |course, x, centre, low, high, level, rng|:
                    draw: f64 = centre + (-16.0 + 32.0 * py_random(&rng))
                    centre <- low if draw < low else (high if draw > high else draw)
                    course.walls[i.usize()] <- Wall{x: x, centre: centre, phase: TAU * py_random(&rng)}
                    x <- x + level.spacing * (0.9 + (1.15 - 0.9) * py_random(&rng))
                course.gust_seed <- py_randbelow(&rng, 1048576.u64()).i64()
                first <- course if attempt == 0
                run: mutable Run = trial(course)
                while run.result == PENDING |run|:
                    lift: bool = pilot(&run)
                    step(&run, 1.0 / 60.0, lift)
                return course if run.result == PASSED
            return first

    def result_text(run: Run&, text: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.result == PASSED:
                dstr_append_cstr(text, "Through all ")
                dstr_append_i64(text, run.passed)
                dstr_append_cstr(text, " walls")
            elif run.result == COLLISION:
                dstr_append_cstr(text, "Hit wall ")
                dstr_append_i64(text, run.hit)
            elif run.result == FLOOR or run.result == ROOF:
                dstr_append_cstr(text, "Hit the canyon floor" if run.result == FLOOR else "Hit the canyon roof")
