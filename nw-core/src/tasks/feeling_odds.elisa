module FeelingOdds:
    # feelings.need_for and its binomial: how many right of n a guesser
    # at a given chance reaches no more than a ceiling (3%) of the time.
    def comb(n: i64, k: i64) -> f64:
        result: mutable i64 = 1
        for i in 0..<k |result, n|:
            result <- result * (n - i) / (i + 1)
        return result.f64()

    def need_within(n: i64, chance: f64, ceiling: f64) -> i64:
        for need in 0..<(n + 1) |n, chance, ceiling|:
            p: mutable f64 = 0.0
            for j in need..<(n + 1) |p, n, chance|:
                p <- p + comb(n, j) * pow(chance, j.f64()) * pow(1.0 - chance, (n - j).f64())
            return need if p <= ceiling
        return n

    def need_for(n: i64, chance: f64) -> i64:
        return need_within(n, chance, 0.03)
