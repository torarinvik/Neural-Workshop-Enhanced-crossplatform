# Syllogisms: read the premises, put them together, say what follows.
#
# Port of neural_workshop/syllogism.py. Seven families of question -- parity,
# order, two direction families, categorical, one made of relations about
# relations, and one made of other questions joined by connectives -- plus the
# read-back verifier that parses the printed lines and solves them again.
#
# Three things shape this port and are worth stating up front.
#
# 1. THE NAMES ARE A COSTUME. `things()` takes exactly ONE number from the
#    caller's stream and starts a second stream off it, so the same seed deals
#    the same premises with the same answer whether the things are called
#    `harbour` and `beetle` or `vartok` and `misoosk`. That is what lets the
#    word data be a bundled table rather than a dependency of the reasoning.
#
# 2. THE WORD DATA IS BUNDLED, not read. The reference draws names from a
#    12.7 MB frequency index fetched into the user's Application Support
#    directory -- data a browser or a phone build cannot reach. Two derived
#    tables are compiled in instead (see scripts/words.py): the 3,450-word noun
#    pool, and the 7,159 real English words the syllable machine could invent
#    by accident. The second is small for a reason worth knowing: `nonsense()`
#    checks against 142,000 words, but can only ever spell 2.55 million
#    strings, and only 7,159 of those are words. Nothing else can ever be
#    rejected, so nothing else needs carrying.
#
# 3. DICTS HERE ARE INSERTION-ORDERED, NOT HASHED. `_askable`, `_which` and
#    the binary family group results in dicts and then either `sorted(...)`
#    them -- alphabetically, deterministic -- or iterate them in insertion
#    order. No string hashing is involved, so none is modelled.
#
# NOTE: needs elisacore_math, pyrandom, pymath, strings and syllogism_words
# included by the driver.

# --- families ---
const SY_PARITY: i64 = 0
const SY_ORDER: i64 = 1
const SY_PLANE: i64 = 2
const SY_SPACE: i64 = 3
const SY_CATEGORICAL: i64 = 4
const SY_META: i64 = 5
const SY_BINARY: i64 = 6

def sy_axes(family: i64) -> i64:
    can Abort.Panic:
        if family == SY_PLANE:
            return 2
        if family == SY_SPACE:
            return 3
        return 1

def sy_has_axes(family: i64) -> bool:
    can Abort.Panic:
        return family == SY_PLANE or family == SY_SPACE

# --- the four categorical forms, in the order they are offered ---
const SY_ALL: i64 = 0
const SY_NONE: i64 = 1
const SY_SOME: i64 = 2
const SY_SOME_NOT: i64 = 3
const SY_NOTHING: i64 = 4

def sy_opposite_form(form: i64) -> i64:
    can Abort.Panic:
        if form == SY_ALL:
            return SY_SOME_NOT
        if form == SY_SOME_NOT:
            return SY_ALL
        if form == SY_NONE:
            return SY_SOME
        return SY_NONE

# COMPASS = (('north', 'south'), ('east', 'west'), ('above', 'below'))
def sy_compass(axis: i64, which: i64) -> cstr:
    can Abort.Panic:
        if axis == 0:
            return "north" if which == 0 else "south"
        if axis == 1:
            return "east" if which == 0 else "west"
        return "above" if which == 0 else "below"

struct SyGrade:
    family: mutable i64
    items: mutable i64
    extra: mutable i64
    negate: mutable bool
    inner_count: mutable i64
    inner: mutable i64[3]

const SY_GRADE_COUNT: i64 = 12

def sy_grade_of(rung: i64) -> SyGrade:
    can Abort.Panic:
        index: mutable i64 = rung - 1
        index <- 0 if index < 0
        index <- SY_GRADE_COUNT - 1 if index > SY_GRADE_COUNT - 1
        g: mutable SyGrade = zeroed
        g.items <- 4
        if index == 0:
            g.family <- SY_PARITY
            g.items <- 6
        if index == 1:
            g.family <- SY_ORDER
            g.items <- 6
        if index == 2:
            g.family <- SY_PARITY
            g.items <- 7
            g.extra <- 1
        if index == 3:
            g.family <- SY_ORDER
            g.items <- 7
            g.extra <- 1
            g.negate <- true
        if index == 4:
            g.family <- SY_CATEGORICAL
            g.items <- 3
        if index == 5:
            g.family <- SY_PLANE
            g.items <- 5
        if index == 6:
            g.family <- SY_ORDER
            g.items <- 9
            g.extra <- 1
            g.negate <- true
        if index == 7:
            g.family <- SY_CATEGORICAL
            g.items <- 4
        if index == 8:
            g.family <- SY_SPACE
            g.items <- 6
        if index == 9:
            g.family <- SY_META
            g.items <- 8
            g.extra <- 1
            g.inner_count <- 1
            g.inner[0] <- SY_ORDER
        if index == 10:
            g.family <- SY_BINARY
            g.inner_count <- 2
            g.inner[0] <- SY_PARITY
            g.inner[1] <- SY_ORDER
        if index == 11:
            g.family <- SY_BINARY
            g.negate <- true
            g.inner_count <- 3
            g.inner[0] <- SY_ORDER
            g.inner[1] <- SY_PLANE
            g.inner[2] <- SY_PARITY
        return g

# A grade for one part of a question made of several. Negation survives only
# into the two families where a negative has exactly one reading.
def sy_sub_grade(g: SyGrade, family: i64, items: i64, extra: i64) -> SyGrade:
    can Abort.Panic:
        out: mutable SyGrade = zeroed
        out.family <- family
        out.items <- items
        out.extra <- extra
        out.negate <- g.negate and (family == SY_PARITY or family == SY_ORDER)
        return out

# --- how many options each family offers ---
def sy_option_count(family: i64) -> i64:
    can Abort.Panic:
        if family == SY_PLANE:
            return 9
        if family == SY_SPACE:
            return 27
        if family == SY_CATEGORICAL:
            return 5
        return 3

# `itertools.product((1, 0, -1), repeat=axes)` is lexicographic with axis 0
# most significant, so the option index is a base-3 numeral read that way.
def sy_option_part(index: i64, axis: i64, axes: i64) -> i64:
    can Abort.Panic:
        divisor: mutable i64 = 1
        step: mutable i64 = axes - 1 - axis
        while step > 0 |step, divisor|:
            divisor <- divisor * 3
            step <- step - 1
        digit: i64 = (index / divisor) % 3
        if digit == 0:
            return 1
        if digit == 1:
            return 0
        return -1

# `'north and east'`, or `'the same place'`.
def sy_append_direction(out: mutable dstr&, part0: i64, part1: i64, part2: i64, axes: i64):
    can Memory.Allocate, Abort.Panic:
        said: mutable i64 = 0
        axis: mutable i64 = 0
        while axis < axes |axis, axes, part0, part1, part2, out, said|:
            part: i64 = part0 if axis == 0 else (part1 if axis == 1 else part2)
            if part != 0:
                dstr_append_cstr(out, " and ") if said > 0
                dstr_append_cstr(out, sy_compass(axis, 0 if part > 0 else 1))
                said <- said + 1
            axis <- axis + 1
        dstr_append_cstr(out, "the same place") if said == 0

def sy_sign(value: i64) -> i64:
    can Abort.Panic:
        return 1 if value > 0 else (-1 if value < 0 else 0)

const SY_UNTOLD: i64 = -1

# The label for a direction family's option index, as text.
def sy_option_text(family: i64, index: i64) -> dstr:
    can Memory.Allocate, Abort.Panic:
        out: mutable dstr = []
        if family == SY_PARITY:
            dstr_append_cstr(&out, "the same" if index == 0 else ("the opposite" if index == 1 else "cannot be told"))
            return out
        if family == SY_ORDER:
            dstr_append_cstr(&out, "more" if index == 0 else ("less" if index == 1 else "cannot be told"))
            return out
        if family == SY_META:
            dstr_append_cstr(&out, "the same" if index == 0 else ("different" if index == 1 else "cannot be told"))
            return out
        if family == SY_BINARY:
            dstr_append_cstr(&out, "true" if index == 0 else ("false" if index == 1 else "cannot be told"))
            return out
        axes: i64 = sy_axes(family)
        sy_append_direction(&out, sy_option_part(index, 0, axes), sy_option_part(index, 1, axes), sy_option_part(index, 2, axes), axes)
        return out

# The option index a direction VALUE lands on, which is the same base-3 numeral
# read backwards.
def sy_direction_index(part0: i64, part1: i64, part2: i64, axes: i64) -> i64:
    can Abort.Panic:
        index: mutable i64 = 0
        axis: mutable i64 = 0
        while axis < axes |axis, axes, part0, part1, part2, index|:
            part: i64 = sy_sign(part0 if axis == 0 else (part1 if axis == 1 else part2))
            digit: i64 = 0 if part > 0 else (1 if part == 0 else 2)
            index <- index * 3 + digit
            axis <- axis + 1
        return index

# --- the names ---
#
# Names live as offsets into one flat byte buffer, so a name is an sview and
# nothing is copied to pass one around.
#
# The buffer is PRE-SIZED and written by index rather than grown with `push`.
# That is not a micro-optimisation: handing a container field of a struct ref
# to a helper that grows it is rejected by region inference ("cannot infer
# region parameter"), and the obvious compiler fix is unsound -- see
# elisa-core docs/REGION_FIELD_FORWARD_GAP.md, which records the measurement.
# Writing an element needs no region, so this shape sidesteps it entirely, and
# it is what every other module in this port already does.
const SY_MOST_NAMES: i64 = 48
const SY_NAME_BYTES: i64 = 1024

struct SyNames:
    bytes: mutable darray[u8]
    used: mutable i64
    start: mutable darray[i64]
    length: mutable darray[i64]
    count: mutable i64

def SyNames() -> SyNames:
    can Memory.Allocate, Abort.Panic:
        out: mutable SyNames = zeroed
        out.bytes <- Bytes::zeros(SY_NAME_BYTES)
        out.start <- Ints::zeros(SY_MOST_NAMES)
        out.length <- Ints::zeros(SY_MOST_NAMES)
        return out

def sy_names_reset(names: mutable SyNames&):
    can Abort.Panic:
        names.used <- 0
        names.count <- 0

def sy_names_push(names: mutable SyNames&, word: sview):
    can Abort.Panic:
        slot: i64 = names.count
        length: i64 = sview_len(word).i64()
        Ints::put(&names.start, slot, names.used)
        index: mutable i64 = 0
        while index < length |index, length, word, names|:
            Bytes::put(&names.bytes, names.used + index, sview_at(word, index.usize()))
            index <- index + 1
        names.used <- names.used + length
        Ints::put(&names.length, slot, length)
        names.count <- slot + 1

def sy_name(names: SyNames&, index: i64) -> sview:
    can Abort.Panic:
        start: i64 = Ints::at(names.start, index)
        return string_view_slice(bytes_view(names.bytes), start, start + Ints::at(names.length, index))

# Binary search of the bundled "words the syllable machine could invent by
# accident" table. See the module header for why 7,159 is the whole of it.
def sy_is_taken(word: sview) -> bool:
    can Abort.Panic:
        low: mutable i64 = 0
        high: mutable i64 = SY_TAKEN_COUNT - 1
        found: mutable bool = false
        while low <= high and not found |low, high, word, found|:
            mid: i64 = (low + high) / 2
            other: sview = sview(sy_taken_at(mid), 0, -1)
            order: i64 = sy_compare(word, other)
            if order == 0:
                found <- true
            else:
                if order < 0:
                    high <- mid - 1
                else:
                    low <- mid + 1
        return found

# Byte-wise ordering, which for these lowercase ASCII words is Python's own.
def sy_compare(left: sview, right: sview) -> i64:
    can Abort.Panic:
        left_len: i64 = sview_len(left).i64()
        right_len: i64 = sview_len(right).i64()
        shortest: i64 = left_len if left_len < right_len else right_len
        index: mutable i64 = 0
        answer: mutable i64 = 2
        while index < shortest and answer == 2 |index, shortest, left, right, answer|:
            a: i64 = sview_at(left, index.usize()).i64()
            b: i64 = sview_at(right, index.usize()).i64()
            if a < b:
                answer <- -1
            if a > b:
                answer <- 1
            index <- index + 1
        if answer != 2:
            return answer
        if left_len < right_len:
            return -1
        if left_len > right_len:
            return 1
        return 0

# `count` made-up words, no two of them opening alike. Distinct first two
# letters on purpose: the difficulty is meant to be in putting the premises
# together, not in telling `vartok` from `vartop` at a glance.
def sy_nonsense(rng: mutable MT19937&, count: i64, names: mutable SyNames&) -> bool:
    can Memory.Allocate, Abort.Panic:
        sy_names_reset(names)
        used: mutable darray[i64] = Ints::zeros(1024)
        used_n: mutable i64 = 0
        attempt: mutable i64 = 0
        while attempt < 400 * count and names.count < count |attempt, count, rng, names, used, used_n|:
            word: mutable dstr = []
            dstr_append_cstr(&word, sy_onset(py_choice_index(rng, 16)))
            dstr_append_cstr(&word, sy_nucleus(py_choice_index(rng, 8)))
            dstr_append_cstr(&word, sy_coda(py_choice_index(rng, 13)))
            head: i64 = sy_head_key(bytes_view(word))
            seen: mutable bool = false
            scan: mutable i64 = 0
            while scan < used_n |scan, used_n, used, head, seen|:
                seen <- true if Ints::at(used, scan) == head
                scan <- scan + 1
            if not seen:
                # The second syllable is drawn AFTER the duplicate-opening
                # test, so a rejected word still costs the one draw and no
                # more. Getting that order wrong shifts the whole stream.
                if py_random(rng) < 0.55:
                    dstr_append_cstr(&word, sy_onset(py_choice_index(rng, 16)))
                    dstr_append_cstr(&word, sy_nucleus(py_choice_index(rng, 8)))
                    dstr_append_cstr(&word, sy_coda(py_choice_index(rng, 13)))
                size: i64 = word.count.i64()
                if size >= 4 and size <= 8 and not sy_is_taken(bytes_view(word)):
                    Ints::put(&used, used_n, head)
                    used_n <- used_n + 1
                    sy_names_push(names, bytes_view(word))
            attempt <- attempt + 1
        return names.count >= count

def sy_head_key(word: sview) -> i64:
    can Abort.Panic:
        if sview_len(word).i64() < 2:
            return sview_at(word, 0.usize()).i64() * 256
        return sview_at(word, 0.usize()).i64() * 256 + sview_at(word, 1.usize()).i64()

def sy_onset(index: i64) -> cstr:
    can Abort.Panic:
        if index < 8:
            if index < 4:
                return "b" if index == 0 else ("d" if index == 1 else ("f" if index == 2 else "g"))
            return "h" if index == 4 else ("j" if index == 5 else ("k" if index == 6 else "l"))
        if index < 12:
            return "m" if index == 8 else ("n" if index == 9 else ("p" if index == 10 else "r"))
        return "s" if index == 12 else ("t" if index == 13 else ("v" if index == 14 else "z"))

def sy_nucleus(index: i64) -> cstr:
    can Abort.Panic:
        if index < 4:
            return "a" if index == 0 else ("e" if index == 1 else ("i" if index == 2 else "o"))
        return "u" if index == 4 else ("ai" if index == 5 else ("ee" if index == 6 else "oo"))

def sy_coda(index: i64) -> cstr:
    can Abort.Panic:
        if index < 4:
            return "" if index == 0 else ("l" if index == 1 else ("m" if index == 2 else "n"))
        if index < 8:
            return "r" if index == 4 else ("s" if index == 5 else ("k" if index == 6 else "p"))
        if index < 11:
            return "t" if index == 8 else ("v" if index == 9 else "sk")
        return "st" if index == 11 else "nd"

# `count` things to reason about, no two of them opening alike.
#
# EXACTLY ONE NUMBER is taken from the caller's stream whichever way this goes,
# and the words are drawn from a second stream started off it. That is what
# makes the naming a costume rather than a variable: the same seed deals the
# same premises, with the same answer, whether the things are called `harbour`
# and `beetle` or `vartok` and `misoosk`.
def sy_things(rng: mutable MT19937&, count: i64, made_up: bool, names: mutable SyNames&):
    can Memory.Allocate, Abort.Panic:
        words: mutable MT19937 = mt19937_new()
        mt_seed_int(&words, py_randrange(rng, 0, 4294967296).u64())
        # The pool has to be forty times what the question needs before it is
        # drawn from at all, so the distinct-openings rule never turns into a
        # search.
        pool: i64 = 0 if made_up else SY_NOUN_COUNT
        if pool < 40 * count:
            _ = sy_nonsense(&words, count, names)
            return
        sy_names_reset(names)
        used: mutable darray[i64] = Ints::zeros(1024)
        used_n: mutable i64 = 0
        attempt: mutable i64 = 0
        while attempt < 400 * count and names.count < count |attempt, count, words, names, used, used_n, pool|:
            word: sview = sview(sy_noun_at(py_randrange(&words, 0, pool)), 0, -1)
            head: i64 = sy_head_key(word)
            seen: mutable bool = false
            scan: mutable i64 = 0
            while scan < used_n |scan, used_n, used, head, seen|:
                seen <- true if Ints::at(used, scan) == head
                scan <- scan + 1
            if not seen:
                Ints::put(&used, used_n, head)
                used_n <- used_n + 1
                sy_names_push(names, word)
            attempt <- attempt + 1
        # The reference falls back to invented names on the same `words`
        # stream, already part-consumed, rather than a fresh one.
        if names.count < count:
            _ = sy_nonsense(&words, count, names)

# `a` or `an`, for a name printed after it. The rule is about the SOUND rather
# than the spelling, and with made-up names the question never came up: it is
# "a idiot" that gave it away.
def sy_article(word: sview) -> cstr:
    can Memory.Allocate, Abort.Panic:
        if sy_starts_any(word, 0):
            return "an"
        if sy_starts_any(word, 1):
            return "a"
        first: u8 = sview_at(word, 0.usize())
        vowel: bool = first == 97 or first == 101 or first == 105 or first == 111 or first == 117
        return "an" if vowel else "a"

# SOUNDS_VOWEL (which = 0) and SOUNDS_CONSONANT (which = 1), as prefixes so
# that `union` covers `unions`.
def sy_starts_any(word: sview, which: i64) -> bool:
    can Memory.Allocate, Abort.Panic:
        count: i64 = 5 if which == 0 else 10
        index: mutable i64 = 0
        found: mutable bool = false
        while index < count and not found |index, count, which, word, found|:
            prefix: cstr = sy_sound_prefix(which, index)
            found <- true if sview_starts_with(word, sview(prefix, 0, -1))
            index <- index + 1
        return found

def sy_sound_prefix(which: i64, index: i64) -> cstr:
    can Abort.Panic:
        if which == 0:
            if index < 3:
                return "hour" if index == 0 else ("honest" if index == 1 else "honor")
            return "honour" if index == 3 else "heir"
        if index < 4:
            return "uni" if index == 0 else ("use" if index == 1 else ("usu" if index == 2 else "uti"))
        if index < 8:
            return "uto" if index == 4 else ("ura" if index == 5 else ("ute" if index == 6 else "eu"))
        return "ewe" if index == 8 else "one"

# One categorical line about two named things.
def sy_append_says(out: mutable dstr&, form: i64, subject: sview, other: sview):
    can Memory.Allocate, Abort.Panic:
        if form == SY_ALL:
            dstr_append_cstr(out, "every ")
            dstr_append_sview(out, subject)
            dstr_append_cstr(out, " is ")
        if form == SY_NONE:
            dstr_append_cstr(out, "no ")
            dstr_append_sview(out, subject)
            dstr_append_cstr(out, " is ")
        if form == SY_SOME:
            dstr_append_cstr(out, "at least one ")
            dstr_append_sview(out, subject)
            dstr_append_cstr(out, " is ")
        if form == SY_SOME_NOT:
            dstr_append_cstr(out, "at least one ")
            dstr_append_sview(out, subject)
            dstr_append_cstr(out, " is not ")
        dstr_append_cstr(out, sy_article(other))
        dstr_append_cstr(out, " ")
        dstr_append_sview(out, other)

# --- the premises, as a graph ---
#
# An edge means different things per family and one shape carries all of them:
# for an order `right` is more than `left`; for a parity the value is 0 for the
# same and 1 for the opposite; for a direction `right` stands one step `value`
# away from `left`.
const SY_MOST_EDGES: i64 = 32
const SY_MOST_ITEMS: i64 = 16

struct SyWeb:
    grade: mutable SyGrade
    items: mutable i64
    left: mutable darray[i64]
    right: mutable darray[i64]
    value0: mutable darray[i64]
    value1: mutable darray[i64]
    value2: mutable darray[i64]
    edges: mutable i64
    # Where each item sits: a rank, a parity, or a point. Every edge is read
    # off this, which is what makes the premises consistent without anything
    # having to check them.
    place0: mutable darray[i64]
    place1: mutable darray[i64]
    place2: mutable darray[i64]
    # Which piece of the web each item is in. Two pieces is what makes
    # `cannot be told` an answer.
    part: mutable darray[i64]

def SyWeb() -> SyWeb:
    can Memory.Allocate, Abort.Panic:
        out: mutable SyWeb = zeroed
        out.left <- Ints::zeros(SY_MOST_EDGES)
        out.right <- Ints::zeros(SY_MOST_EDGES)
        out.value0 <- Ints::zeros(SY_MOST_EDGES)
        out.value1 <- Ints::zeros(SY_MOST_EDGES)
        out.value2 <- Ints::zeros(SY_MOST_EDGES)
        out.place0 <- Ints::zeros(SY_MOST_ITEMS)
        out.place1 <- Ints::zeros(SY_MOST_ITEMS)
        out.place2 <- Ints::zeros(SY_MOST_ITEMS)
        out.part <- Ints::zeros(SY_MOST_ITEMS)
        return out

def sy_edge_value(web: SyWeb&, edge: i64, axis: i64) -> i64:
    can Abort.Panic:
        if axis == 0:
            return Ints::at(web.value0, edge)
        if axis == 1:
            return Ints::at(web.value1, edge)
        return Ints::at(web.value2, edge)

def sy_place(web: SyWeb&, item: i64, axis: i64) -> i64:
    can Abort.Panic:
        if axis == 0:
            return Ints::at(web.place0, item)
        if axis == 1:
            return Ints::at(web.place1, item)
        return Ints::at(web.place2, item)

def sy_place_put(web: mutable SyWeb&, item: i64, axis: i64, value: i64):
    can Abort.Panic:
        Ints::put(&web.place0, item, value) if axis == 0
        Ints::put(&web.place1, item, value) if axis == 1
        Ints::put(&web.place2, item, value) if axis == 2

# `count` items in one piece or two, never a piece of one: a piece of one item
# is an item no premise mentions, and a word that appears nowhere gives the
# answer away without any reasoning at all.
#
# Returns the size of the first group; the shuffled node order is in `nodes`.
def sy_split(rng: mutable MT19937&, count: i64, parts: i64, nodes: mutable darray[i64]&) -> i64:
    can Abort.Panic:
        index: mutable i64 = 0
        while index < count |index, count, nodes|:
            Ints::put(nodes, index, index)
            index <- index + 1
        py_shuffle_i64_prefix(rng, nodes, count)
        if parts < 2 or count < 5:
            return count
        return py_randint(rng, 2, count - 2)

# One premise's worth of movement. For a direction family it re-rolls until
# something moves, which costs a draw per rejected roll.
def sy_step(rng: mutable MT19937&, family: i64, out: mutable darray[i64]&):
    can Abort.Panic:
        if family == SY_PARITY:
            Ints::put(out, 0, py_randint(rng, 0, 1))
            return
        axes: i64 = sy_axes(family)
        rolling: mutable bool = true
        while rolling |rolling, axes, rng, out|:
            any_move: mutable bool = false
            axis: mutable i64 = 0
            while axis < axes |axis, axes, rng, out, any_move|:
                got: i64 = py_randint(rng, -1, 1)
                Ints::put(out, axis, got)
                any_move <- true if got != 0
                axis <- axis + 1
            rolling <- false if any_move

def sy_joined(web: SyWeb&, one: i64, two: i64) -> bool:
    can Abort.Panic:
        edge: mutable i64 = 0
        found: mutable bool = false
        while edge < web.edges and not found |edge, web, one, two, found|:
            left: i64 = Ints::at(web.left, edge)
            right: i64 = Ints::at(web.right, edge)
            found <- true if (left == one and right == two) or (left == two and right == one)
            edge <- edge + 1
        return found

def sy_add_edge(web: mutable SyWeb&, left: i64, right: i64, v0: i64, v1: i64, v2: i64):
    can Abort.Panic:
        slot: i64 = web.edges
        Ints::put(&web.left, slot, left)
        Ints::put(&web.right, slot, right)
        Ints::put(&web.value0, slot, v0)
        Ints::put(&web.value1, slot, v1)
        Ints::put(&web.value2, slot, v2)
        web.edges <- slot + 1

# A web of premises for `grade`, in `parts` pieces. False when there were not
# enough unjoined pairs to hang the extra premises off.
#
# THE NUMBER OF PRINTED PREMISES DOES NOT DEPEND ON THE NUMBER OF PIECES, and
# that is the whole reason `extra` moves with `parts`: a rung where two pieces
# mean one line fewer is a rung where counting the lines answers the question.
def sy_grow(rng: mutable MT19937&, g: SyGrade, parts: i64, names: mutable SyNames&, made_up: bool, have_names: bool, web: mutable SyWeb&) -> bool:
    can Memory.Allocate, Abort.Panic:
        if not have_names:
            sy_things(rng, g.items, made_up, names)
        web.grade <- g
        web.items <- g.items
        web.edges <- 0
        family: i64 = g.family
        nodes: mutable darray[i64] = Ints::zeros(SY_MOST_ITEMS)
        cut: i64 = sy_split(rng, g.items, parts, &nodes)
        group_count: i64 = 1 if cut >= g.items else 2
        wipe: mutable i64 = 0
        while wipe < g.items |wipe, g, web|:
            sy_place_put(web, wipe, 0, 0)
            sy_place_put(web, wipe, 1, 0)
            sy_place_put(web, wipe, 2, 0)
            wipe <- wipe + 1
        if family == SY_ORDER:
            ranks: mutable darray[i64] = Ints::zeros(SY_MOST_ITEMS)
            rank: mutable i64 = 0
            while rank < g.items |rank, g, ranks|:
                Ints::put(&ranks, rank, rank)
                rank <- rank + 1
            py_shuffle_i64_prefix(rng, &ranks, g.items)
            spot: mutable i64 = 0
            while spot < g.items |spot, g, ranks, web|:
                sy_place_put(web, spot, 0, Ints::at(ranks, spot))
                spot <- spot + 1
        axes: i64 = 1 if family == SY_PARITY else sy_axes(family)
        step: mutable darray[i64] = Ints::zeros(4)
        group: mutable i64 = 0
        while group < group_count |group, group_count, cut, g, nodes, family, axes, rng, web, step|:
            low: i64 = 0 if group == 0 else cut
            high: i64 = cut if group == 0 else g.items
            if family != SY_ORDER:
                first: i64 = Ints::at(nodes, low)
                axis: mutable i64 = 0
                while axis < axes |axis, axes, first, web|:
                    sy_place_put(web, first, axis, 0)
                    axis <- axis + 1
            position: mutable i64 = low + 1
            while position < high |position, low, high, nodes, family, axes, rng, web, step|:
                node: i64 = Ints::at(nodes, position)
                # Mostly hang it off the last one, which grows CHAINS rather
                # than stars: a star answers everything in two steps whatever
                # its size, and a rung called "six in a row" ought to be six
                # in a row.
                parent: mutable i64 = 0
                if py_random(rng) < 0.7:
                    parent <- Ints::at(nodes, position - 1)
                else:
                    parent <- Ints::at(nodes, low + py_choice_index(rng, position - low))
                if family == SY_ORDER:
                    if sy_place(web, node, 0) > sy_place(web, parent, 0):
                        sy_add_edge(web, parent, node, 1, 0, 0)
                    else:
                        sy_add_edge(web, node, parent, 1, 0, 0)
                else:
                    sy_step(rng, family, &step)
                    if family == SY_PARITY:
                        sy_place_put(web, node, 0, (sy_place(web, parent, 0) + Ints::at(step, 0)) % 2)
                    else:
                        axis: mutable i64 = 0
                        while axis < axes |axis, axes, node, parent, step, web|:
                            sy_place_put(web, node, axis, sy_place(web, parent, axis) + Ints::at(step, axis))
                            axis <- axis + 1
                    sy_add_edge(web, parent, node, Ints::at(step, 0), Ints::at(step, 1), Ints::at(step, 2))
                position <- position + 1
            group <- group + 1
        wanted: i64 = g.extra + group_count - 1
        if wanted > 0:
            # `itertools.combinations(sorted(group), 2)` over each group in
            # turn, keeping the pairs no edge already states.
            free_one: mutable darray[i64] = Ints::zeros(256)
            free_two: mutable darray[i64] = Ints::zeros(256)
            free_n: mutable i64 = 0
            sorted_group: mutable darray[i64] = Ints::zeros(SY_MOST_ITEMS)
            band: mutable i64 = 0
            while band < group_count |band, group_count, cut, g, nodes, sorted_group, web, free_one, free_two, free_n|:
                low: i64 = 0 if band == 0 else cut
                high: i64 = cut if band == 0 else g.items
                size: i64 = high - low
                copy: mutable i64 = 0
                while copy < size |copy, size, low, nodes, sorted_group|:
                    Ints::put(&sorted_group, copy, Ints::at(nodes, low + copy))
                    copy <- copy + 1
                Ints::sort_prefix(&sorted_group, size)
                a: mutable i64 = 0
                while a < size |a, size, sorted_group, web, free_one, free_two, free_n|:
                    b: mutable i64 = a + 1
                    while b < size |b, a, size, sorted_group, web, free_one, free_two, free_n|:
                        one: i64 = Ints::at(sorted_group, a)
                        two: i64 = Ints::at(sorted_group, b)
                        if not sy_joined(web, one, two):
                            Ints::put(&free_one, free_n, one)
                            Ints::put(&free_two, free_n, two)
                            free_n <- free_n + 1
                        b <- b + 1
                    a <- a + 1
                band <- band + 1
            if free_n < wanted:
                return false
            # The shuffle is over PAIRS, so the two arrays move together.
            order: mutable darray[i64] = Ints::zeros(256)
            fill: mutable i64 = 0
            while fill < free_n |fill, free_n, order|:
                Ints::put(&order, fill, fill)
                fill <- fill + 1
            py_shuffle_i64_prefix(rng, &order, free_n)
            take: mutable i64 = 0
            while take < wanted |take, wanted, order, free_one, free_two, family, web|:
                slot: i64 = Ints::at(order, take)
                one: i64 = Ints::at(free_one, slot)
                two: i64 = Ints::at(free_two, slot)
                if family == SY_ORDER:
                    if sy_place(web, two, 0) > sy_place(web, one, 0):
                        sy_add_edge(web, one, two, 1, 0, 0)
                    else:
                        sy_add_edge(web, two, one, 1, 0, 0)
                else:
                    if family == SY_PARITY:
                        sy_add_edge(web, one, two, (sy_place(web, two, 0) - sy_place(web, one, 0)) % 2, 0, 0)
                    else:
                        # A direction family's extra premise is not renderable
                        # exactly, so the reference declines the whole web.
                        return false
                take <- take + 1
        mark: mutable i64 = 0
        while mark < g.items |mark, g, cut, nodes, web|:
            Ints::put(&web.part, Ints::at(nodes, mark), 0 if mark < cut else 1)
            mark <- mark + 1
        return true

# --- reading it back ---

# `cannot be told` is one of the three options for the families that offer it,
# so it must use THAT index or the dict would grow two keys spelling the same
# thing. The direction families never offer it, so there it is a key of its own.
def sy_untold_label(family: i64) -> i64:
    can Abort.Panic:
        if family == SY_PARITY or family == SY_ORDER or family == SY_META or family == SY_BINARY:
            return 2
        return SY_UNTOLD

def sy_label_text(family: i64, label: i64) -> dstr:
    can Memory.Allocate, Abort.Panic:
        if label == SY_UNTOLD:
            out: mutable dstr = []
            dstr_append_cstr(&out, "cannot be told")
            return out
        return sy_option_text(family, label)

# Shortest path from `start` to `goal`, as premise numbers. `directed` follows
# an order UPWARDS only, which is what makes an order different from the
# others: two things in one piece of the web can still be incomparable.
#
# Writes the path into `path` and returns its length, or -1 when there is none.
# A length of 0 means start == goal.
def sy_route(web: SyWeb&, start: i64, goal: i64, directed: bool, path: mutable darray[i64]&) -> i64:
    can Memory.Allocate, Abort.Panic:
        if start == goal:
            return 0
        # `seen` holds each reached node's path, as a flat pool: one row of at
        # most SY_MOST_EDGES premise numbers per item.
        seen: mutable darray[i64] = Ints::zeros(SY_MOST_ITEMS)
        pool: mutable darray[i64] = Ints::zeros(SY_MOST_ITEMS * SY_MOST_EDGES)
        length: mutable darray[i64] = Ints::zeros(SY_MOST_ITEMS)
        frontier: mutable darray[i64] = Ints::zeros(SY_MOST_ITEMS)
        next_frontier: mutable darray[i64] = Ints::zeros(SY_MOST_ITEMS)
        Ints::put(&seen, start, 1)
        Ints::put(&length, start, 0)
        Ints::put(&frontier, 0, start)
        frontier_n: mutable i64 = 1
        answer: mutable i64 = -1
        while frontier_n > 0 and answer < 0 |frontier_n, web, goal, directed, seen, pool, length, frontier, next_frontier, path, answer|:
            next_n: mutable i64 = 0
            at: mutable i64 = 0
            while at < frontier_n and answer < 0 |at, frontier_n, web, goal, directed, seen, pool, length, frontier, next_frontier, next_n, path, answer|:
                node: i64 = Ints::at(frontier, at)
                number: mutable i64 = 0
                while number < web.edges and answer < 0 |number, web, node, goal, directed, seen, pool, length, next_frontier, next_n, path, answer|:
                    left: i64 = Ints::at(web.left, number)
                    right: i64 = Ints::at(web.right, number)
                    other: mutable i64 = -1
                    if left == node:
                        other <- right
                    else:
                        other <- left if right == node and not directed
                    if other >= 0 and Ints::at(seen, other) == 0:
                        was: i64 = Ints::at(length, node)
                        copy: mutable i64 = 0
                        while copy < was |copy, was, node, other, pool|:
                            Ints::put(&pool, other * SY_MOST_EDGES + copy, Ints::at(pool, node * SY_MOST_EDGES + copy))
                            copy <- copy + 1
                        Ints::put(&pool, other * SY_MOST_EDGES + was, number)
                        Ints::put(&length, other, was + 1)
                        Ints::put(&seen, other, 1)
                        if other == goal:
                            out: mutable i64 = 0
                            while out <= was |out, was, other, pool, path|:
                                Ints::put(path, out, Ints::at(pool, other * SY_MOST_EDGES + out))
                                out <- out + 1
                            answer <- was + 1
                        else:
                            Ints::put(&next_frontier, next_n, other)
                            next_n <- next_n + 1
                    number <- number + 1
                at <- at + 1
            shift: mutable i64 = 0
            while shift < next_n |shift, next_n, next_frontier, frontier|:
                Ints::put(&frontier, shift, Ints::at(next_frontier, shift))
                shift <- shift + 1
            frontier_n <- next_n
        return answer

# What `subject` is to `other`, and the premises that say so. Returns the label
# and writes the path; the path length comes back in `path_len`.
def sy_relation(web: SyWeb&, subject: i64, other: i64, path: mutable darray[i64]&, path_len: mutable i64&) -> i64:
    can Memory.Allocate, Abort.Panic:
        family: i64 = web.grade.family
        path_len <- 0
        if family == SY_ORDER:
            up: i64 = sy_route(web, other, subject, true, path)
            if up > 0:
                path_len <- up
                return 0
            down: i64 = sy_route(web, subject, other, true, path)
            if down > 0:
                path_len <- down
                return 1
            return sy_untold_label(family)
        if Ints::at(web.part, subject) != Ints::at(web.part, other):
            return sy_untold_label(family)
        walked: i64 = sy_route(web, other, subject, false, path)
        path_len <- walked if walked > 0
        if family == SY_PARITY:
            apart: i64 = (sy_place(web, subject, 0) - sy_place(web, other, 0)) % 2
            return 1 if apart != 0 else 0
        axes: i64 = sy_axes(family)
        return sy_direction_index(sy_place(web, subject, 0) - sy_place(web, other, 0), sy_place(web, subject, 1) - sy_place(web, other, 1), sy_place(web, subject, 2) - sy_place(web, other, 2), axes)

# What a reader that never composes two premises answers: the first line that
# names the thing asked about, and that line's relation, turned round if it
# has to be. This is the atmosphere effect written down.
def sy_surface(web: SyWeb&, order: darray[i64], subject: i64) -> i64:
    can Abort.Panic:
        family: i64 = web.grade.family
        at: mutable i64 = 0
        while at < web.edges |at, web, order, subject, family|:
            number: i64 = Ints::at(order, at)
            left: i64 = Ints::at(web.left, number)
            right: i64 = Ints::at(web.right, number)
            if subject == left or subject == right:
                if family == SY_ORDER:
                    return 0 if subject == right else 1
                if family == SY_PARITY:
                    return 0 if sy_edge_value(web, number, 0) == 0 else 1
                axes: i64 = sy_axes(family)
                if subject == right:
                    return sy_direction_index(sy_edge_value(web, number, 0), sy_edge_value(web, number, 1), sy_edge_value(web, number, 2), axes)
                return sy_direction_index(-sy_edge_value(web, number, 0), -sy_edge_value(web, number, 1), -sy_edge_value(web, number, 2), axes)
            at <- at + 1
        return sy_untold_label(family)

# Every pair worth asking about, grouped by its answer. A pair one premise
# states outright is not worth asking about, so it is not here; grouping by the
# answer and then picking a GROUP is what keeps one option from being right
# more often than the rest.
const SY_MOST_PAIRS: i64 = 512

struct SyAskable:
    subject: mutable darray[i64]
    other: mutable darray[i64]
    label: mutable darray[i64]
    path: mutable darray[i64]
    path_len: mutable darray[i64]
    count: mutable i64
    # The distinct labels, in the order they were first seen -- the dict's own
    # order, which is what `found[label]` and `len(found)` are read off.
    labels: mutable darray[i64]
    label_count: mutable i64

def SyAskable() -> SyAskable:
    can Memory.Allocate, Abort.Panic:
        out: mutable SyAskable = zeroed
        out.subject <- Ints::zeros(SY_MOST_PAIRS)
        out.other <- Ints::zeros(SY_MOST_PAIRS)
        out.label <- Ints::zeros(SY_MOST_PAIRS)
        out.path <- Ints::zeros(SY_MOST_PAIRS * SY_MOST_EDGES)
        out.path_len <- Ints::zeros(SY_MOST_PAIRS)
        out.labels <- Ints::zeros(64)
        return out

def sy_askable(web: SyWeb&, found: mutable SyAskable&):
    can Memory.Allocate, Abort.Panic:
        found.count <- 0
        found.label_count <- 0
        untold: i64 = sy_untold_label(web.grade.family)
        scratch: mutable darray[i64] = Ints::zeros(SY_MOST_EDGES)
        subject: mutable i64 = 0
        while subject < web.items |subject, web, found, untold, scratch|:
            other: mutable i64 = 0
            while other < web.items |other, subject, web, found, untold, scratch|:
                if other != subject and not sy_joined(web, subject, other):
                    walked: mutable i64 = 0
                    label: i64 = sy_relation(web, subject, other, &scratch, &walked)
                    # A pair one premise away is not worth asking about, but a
                    # pair nothing links is: proving a negative takes the lot.
                    if label == untold or walked >= 2:
                        slot: i64 = found.count
                        Ints::put(&found.subject, slot, subject)
                        Ints::put(&found.other, slot, other)
                        Ints::put(&found.label, slot, label)
                        Ints::put(&found.path_len, slot, walked)
                        copy: mutable i64 = 0
                        while copy < walked |copy, walked, slot, scratch, found|:
                            Ints::put(&found.path, slot * SY_MOST_EDGES + copy, Ints::at(scratch, copy))
                            copy <- copy + 1
                        found.count <- slot + 1
                        seen: mutable bool = false
                        scan: mutable i64 = 0
                        while scan < found.label_count |scan, found, label, seen|:
                            seen <- true if Ints::at_ref(&found.labels, scan) == label
                            scan <- scan + 1
                        if not seen:
                            Ints::put(&found.labels, found.label_count, label)
                            found.label_count <- found.label_count + 1
                other <- other + 1
            subject <- subject + 1

# Whether anything but `cannot be told` can be asked of this web. A piece of
# three items with an extra premise across it is a triangle, and a triangle
# states every pair outright: consistent, connected, and nothing left to ask.
def sy_usable(found: SyAskable&, family: i64) -> bool:
    can Abort.Panic:
        untold: i64 = sy_untold_label(family)
        at: mutable i64 = 0
        any_told: mutable bool = false
        while at < found.label_count |at, found, untold, any_told|:
            any_told <- true if Ints::at(found.labels, at) != untold
            at <- at + 1
        return any_told

# `sorted(found)` sorts the dict's keys, which are the label TEXTS, so the
# order is alphabetical over what is printed rather than over any index.
def sy_sorted_labels(family: i64, labels: darray[i64], count: i64, out: mutable darray[i64]&):
    can Memory.Allocate, Abort.Panic:
        copy: mutable i64 = 0
        while copy < count |copy, count, labels, out|:
            Ints::put(out, copy, Ints::at(labels, copy))
            copy <- copy + 1
        index: mutable i64 = 1
        while index < count |index, count, family, out|:
            held: i64 = Ints::at_ref(out, index)
            held_text: dstr = sy_label_text(family, held)
            at: mutable i64 = index - 1
            placing: mutable bool = true
            while placing and at >= 0 |placing, at, family, held, held_text, out|:
                other_text: dstr = sy_label_text(family, Ints::at_ref(out, at))
                if sy_compare(bytes_view(other_text), bytes_view(held_text)) > 0:
                    Ints::put(out, at + 1, Ints::at_ref(out, at))
                    at <- at - 1
                else:
                    placing <- false
            Ints::put(out, at + 1, held)
            index <- index + 1

# --- putting it into words ---

# A direction as a SENTENCE rather than as a label: `north of` and `below` do
# not take the same frame, and "hust is down of mailnet" is not English.
def sy_append_lies(out: mutable dstr&, subject: sview, family: i64, label: i64, other: sview):
    can Memory.Allocate, Abort.Panic:
        axes: i64 = sy_axes(family)
        part0: i64 = sy_option_part(label, 0, axes)
        part1: i64 = sy_option_part(label, 1, axes)
        part2: i64 = sy_option_part(label, 2, axes)
        if part0 == 0 and part1 == 0 and part2 == 0:
            dstr_append_sview(out, subject)
            dstr_append_cstr(out, " is in the same place as ")
            dstr_append_sview(out, other)
            return
        # The reference splits the LABEL on " and " and sorts the pieces into
        # the upright one (the third axis) and the flat ones, then picks one of
        # three frames. Three frames, not one with optional pieces: `north of`
        # and `below` do not take the same frame, and "hust is down of mailnet"
        # is not English.
        upright: bool = axes > 2 and part2 != 0
        flat: bool = part0 != 0 or part1 != 0
        dstr_append_sview(out, subject)
        dstr_append_cstr(out, " is ")
        if flat and upright:
            dstr_append_cstr(out, sy_compass(2, 0 if part2 > 0 else 1))
            dstr_append_cstr(out, " and to the ")
            sy_append_flat(out, part0, part1)
            dstr_append_cstr(out, " of ")
        else:
            if flat:
                dstr_append_cstr(out, "to the ")
                sy_append_flat(out, part0, part1)
                dstr_append_cstr(out, " of ")
            else:
                dstr_append_cstr(out, sy_compass(2, 0 if part2 > 0 else 1))
                dstr_append_cstr(out, " ")
        dstr_append_sview(out, other)

# `' and '.join(flat)` -- the north/south piece before the east/west one,
# which is the order the label was built in.
def sy_append_flat(out: mutable dstr&, part0: i64, part1: i64):
    can Memory.Allocate, Abort.Panic:
        said: mutable bool = false
        if part0 != 0:
            dstr_append_cstr(out, sy_compass(0, 0 if part0 > 0 else 1))
            said <- true
        if part1 != 0:
            dstr_append_cstr(out, " and ") if said
            dstr_append_cstr(out, sy_compass(1, 0 if part1 > 0 else 1))

# One premise, said one of the ways it can be said. Every branch that reads
# `rng.random()` costs a draw whether or not the grade negates, so the order
# below is the reference's exactly.
def sy_render(web: SyWeb&, number: i64, names: SyNames&, rng: mutable MT19937&) -> dstr:
    can Memory.Allocate, Abort.Panic:
        out: mutable dstr = []
        left: i64 = Ints::at(web.left, number)
        right: i64 = Ints::at(web.right, number)
        family: i64 = web.grade.family
        negate: bool = web.grade.negate and py_random(rng) < 0.5
        if family == SY_ORDER:
            if negate:
                if py_random(rng) < 0.5:
                    dstr_append_sview(&out, sy_name(names, left))
                    dstr_append_cstr(&out, " is not more than ")
                    dstr_append_sview(&out, sy_name(names, right))
                else:
                    dstr_append_sview(&out, sy_name(names, right))
                    dstr_append_cstr(&out, " is not less than ")
                    dstr_append_sview(&out, sy_name(names, left))
                return out
            if py_random(rng) < 0.5:
                dstr_append_sview(&out, sy_name(names, right))
                dstr_append_cstr(&out, " is more than ")
                dstr_append_sview(&out, sy_name(names, left))
            else:
                dstr_append_sview(&out, sy_name(names, left))
                dstr_append_cstr(&out, " is less than ")
                dstr_append_sview(&out, sy_name(names, right))
            return out
        if family == SY_PARITY:
            same: bool = sy_edge_value(web, number, 0) == 0
            dstr_append_sview(&out, sy_name(names, left))
            if negate:
                # With two ways to be and no third, "not the opposite of" says
                # "the same as" and nothing else. That is why the direction
                # families are not offered negation: there, "not north of"
                # says six other things.
                dstr_append_cstr(&out, " is not the ")
                dstr_append_cstr(&out, "opposite of " if same else "same as ")
            else:
                dstr_append_cstr(&out, " is the ")
                dstr_append_cstr(&out, "same as " if same else "opposite of ")
            dstr_append_sview(&out, sy_name(names, right))
            return out
        axes: i64 = sy_axes(family)
        label: i64 = sy_direction_index(sy_edge_value(web, number, 0), sy_edge_value(web, number, 1), sy_edge_value(web, number, 2), axes)
        sy_append_lies(&out, sy_name(names, right), family, label, sy_name(names, left))
        return out

# The answer as a sentence, for the working.
def sy_conclusion(family: i64, subject: sview, other: sview, label: i64) -> dstr:
    can Memory.Allocate, Abort.Panic:
        out: mutable dstr = []
        if label == sy_untold_label(family):
            dstr_append_cstr(&out, "nothing in the premises links ")
            dstr_append_sview(&out, subject)
            dstr_append_cstr(&out, " to ")
            dstr_append_sview(&out, other)
            return out
        if family == SY_PARITY:
            dstr_append_sview(&out, subject)
            dstr_append_cstr(&out, " is ")
            dstr_append_cstr(&out, "the same as " if label == 0 else "the opposite of ")
            dstr_append_sview(&out, other)
            return out
        if family == SY_ORDER:
            dstr_append_sview(&out, subject)
            dstr_append_cstr(&out, " is ")
            dstr_append_cstr(&out, "more" if label == 0 else "less")
            dstr_append_cstr(&out, " than ")
            dstr_append_sview(&out, other)
            return out
        sy_append_lies(&out, subject, family, label, other)
        return out

# Whether this deal should be one the surface reader gets right.
#
# NEVER when the answer is one that reader cannot give: it does not say
# `cannot be told`, because a reader that composes nothing never finds out
# that nothing composes. Otherwise one time in as many answers as it can give,
# which with the answers spread evenly over the options is exactly chance.
def sy_agreeable(rng: mutable MT19937&, family: i64, option_count: i64, label: i64) -> bool:
    can Abort.Panic:
        # `label in (UNTOLD, NOTHING)` -- for the categorical family the
        # option that means "nothing follows" is the fifth, not the third.
        if label == sy_untold_label(family) or (family == SY_CATEGORICAL and label == SY_NOTHING):
            return false
        return py_random(rng) < 1.0 / sy_sayable(family, option_count).f64()

# How many of these answers a reader that never composes can give: the options
# less `cannot be told` and `nothing follows`, neither of which it ever says.
# The direction families offer neither, so for them it is all of them.
def sy_sayable(family: i64, option_count: i64) -> i64:
    can Abort.Panic:
        unsayable: mutable i64 = 0
        unsayable <- 1 if sy_untold_label(family) != SY_UNTOLD
        unsayable <- 1 if family == SY_CATEGORICAL
        told: i64 = option_count - unsayable
        return 1 if told < 1 else told

# The question sentence for a chain family.
def sy_asked_chain(family: i64, subject: sview, other: sview) -> dstr:
    can Memory.Allocate, Abort.Panic:
        out: mutable dstr = []
        if family == SY_PARITY:
            dstr_append_cstr(&out, "Is ")
            dstr_append_sview(&out, subject)
            dstr_append_cstr(&out, " the same as ")
            dstr_append_sview(&out, other)
            dstr_append_cstr(&out, ", or the opposite?")
            return out
        if family == SY_ORDER:
            dstr_append_cstr(&out, "Is ")
            dstr_append_sview(&out, subject)
            dstr_append_cstr(&out, " more than ")
            dstr_append_sview(&out, other)
            dstr_append_cstr(&out, ", or less?")
            return out
        dstr_append_cstr(&out, "Which way is ")
        dstr_append_sview(&out, subject)
        dstr_append_cstr(&out, " from ")
        dstr_append_sview(&out, other)
        dstr_append_cstr(&out, "?")
        return out

# --- one dealt question ---
const SY_MOST_LINES: i64 = 40
const SY_TEXT_BYTES: i64 = 32768
const SY_MOST_WORKING: i64 = 64

struct SyQuestion:
    found: mutable bool
    family: mutable i64
    lines: mutable darray[i64]
    line_count: mutable i64
    # Pre-sized and written by index, for the reason in the SyNames note.
    text: mutable darray[u8]
    used: mutable i64
    asked_start: mutable i64
    asked_len: mutable i64
    working: mutable darray[i64]
    working_count: mutable i64
    options: mutable darray[i64]
    option_count: mutable i64
    answer: mutable i64
    surface: mutable i64
    steps: mutable i64
    decoys: mutable i64

# Every string a question prints goes into one buffer; `lines`, `working` and
# `options` hold (start, length) pairs into it. One buffer keeps the question a
# value that can be handed around without a web of separate allocations.
def SyQuestion() -> SyQuestion:
    can Memory.Allocate, Abort.Panic:
        out: mutable SyQuestion = zeroed
        out.text <- Bytes::zeros(SY_TEXT_BYTES)
        out.lines <- Ints::zeros(SY_MOST_LINES * 2)
        out.working <- Ints::zeros(SY_MOST_WORKING * 2)
        out.options <- Ints::zeros(32 * 2)
        return out

def sy_question_reset(q: mutable SyQuestion&):
    can Abort.Panic:
        q.used <- 0
        q.line_count <- 0
        q.working_count <- 0
        q.option_count <- 0
        q.found <- false

def sy_take_text(q: mutable SyQuestion&, text: dstr) -> i64:
    can Abort.Panic:
        start: i64 = q.used
        length: i64 = text.count.i64()
        index: mutable i64 = 0
        while index < length |index, length, text, q, start|:
            Bytes::put(&q.text, start + index, get text[index.usize()] else 0.u8())
            index <- index + 1
        q.used <- start + length
        return start

def sy_add_line(q: mutable SyQuestion&, text: dstr):
    can Memory.Allocate, Abort.Panic:
        slot: i64 = q.line_count
        Ints::put(&q.lines, slot * 2, sy_take_text(q, text))
        Ints::put(&q.lines, slot * 2 + 1, text.count.i64())
        q.line_count <- slot + 1

def sy_add_working(q: mutable SyQuestion&, text: dstr):
    can Memory.Allocate, Abort.Panic:
        slot: i64 = q.working_count
        Ints::put(&q.working, slot * 2, sy_take_text(q, text))
        Ints::put(&q.working, slot * 2 + 1, text.count.i64())
        q.working_count <- slot + 1

def sy_add_option(q: mutable SyQuestion&, text: dstr):
    can Memory.Allocate, Abort.Panic:
        slot: i64 = q.option_count
        Ints::put(&q.options, slot * 2, sy_take_text(q, text))
        Ints::put(&q.options, slot * 2 + 1, text.count.i64())
        q.option_count <- slot + 1

def sy_set_asked(q: mutable SyQuestion&, text: dstr):
    can Memory.Allocate, Abort.Panic:
        q.asked_start <- sy_take_text(q, text)
        q.asked_len <- text.count.i64()

def sy_slice(q: SyQuestion&, start: i64, length: i64) -> sview:
    can Abort.Panic:
        return string_view_slice(bytes_view(q.text), start, start + length)

def sy_line(q: SyQuestion&, index: i64) -> sview:
    can Abort.Panic:
        return sy_slice(q, Ints::at(q.lines, index * 2), Ints::at(q.lines, index * 2 + 1))

def sy_working_line(q: SyQuestion&, index: i64) -> sview:
    can Abort.Panic:
        return sy_slice(q, Ints::at(q.working, index * 2), Ints::at(q.working, index * 2 + 1))

def sy_option(q: SyQuestion&, index: i64) -> sview:
    can Abort.Panic:
        return sy_slice(q, Ints::at(q.options, index * 2), Ints::at(q.options, index * 2 + 1))

# `options.index(label) if label in options else 0`
def sy_index_of(family: i64, label: i64, option_count: i64) -> i64:
    can Abort.Panic:
        if label >= 0 and label < option_count:
            return label
        return 0

# A chosen pair, written out and measured.
def sy_dress(rng: mutable MT19937&, web: SyWeb&, names: SyNames&, label: i64, found: SyAskable&, keep: darray[i64], keep_n: i64, order: darray[i64], q: mutable SyQuestion&):
    can Memory.Allocate, Abort.Panic:
        g: SyGrade = web.grade
        family: i64 = g.family
        option_count: i64 = sy_option_count(family)
        # The LONGEST way round, among the pairs still standing: picked evenly,
        # a nine-premise rung mostly asks two-premise questions, because short
        # paths outnumber long ones badly.
        longest: mutable i64 = 0
        at: mutable i64 = 0
        while at < keep_n |at, keep_n, keep, found, longest|:
            here: i64 = Ints::at(found.path_len, Ints::at(keep, at))
            longest <- here if at == 0 or here > longest
            at <- at + 1
        best: mutable darray[i64] = Ints::zeros(SY_MOST_PAIRS)
        best_n: mutable i64 = 0
        scan: mutable i64 = 0
        while scan < keep_n |scan, keep_n, keep, found, longest, best, best_n|:
            slot: i64 = Ints::at(keep, scan)
            if Ints::at(found.path_len, slot) == longest:
                Ints::put(&best, best_n, slot)
                best_n <- best_n + 1
            scan <- scan + 1
        chosen: i64 = Ints::at(best, py_choice_index(rng, best_n))
        subject: i64 = Ints::at(found.subject, chosen)
        other: i64 = Ints::at(found.other, chosen)
        path_len: i64 = Ints::at(found.path_len, chosen)
        sy_question_reset(q)
        q.found <- true
        q.family <- family
        # WRITTEN ONCE: the working has to quote the lines the player was
        # shown, and a premise rendered twice is a premise said two ways.
        said_start: mutable darray[i64] = Ints::zeros(SY_MOST_EDGES)
        said_len: mutable darray[i64] = Ints::zeros(SY_MOST_EDGES)
        write: mutable i64 = 0
        while write < web.edges |write, web, order, names, rng, q, said_start, said_len|:
            number: i64 = Ints::at(order, write)
            text: dstr = sy_render(web, number, names, rng)
            Ints::put(&said_start, number, sy_take_text(q, text))
            Ints::put(&said_len, number, text.count.i64())
            write <- write + 1
        place: mutable i64 = 0
        while place < web.edges |place, web, order, said_start, said_len, q|:
            number: i64 = Ints::at(order, place)
            slot: i64 = q.line_count
            Ints::put(&q.lines, slot * 2, Ints::at(said_start, number))
            Ints::put(&q.lines, slot * 2 + 1, Ints::at(said_len, number))
            q.line_count <- slot + 1
            place <- place + 1
        sy_set_asked(q, sy_asked_chain(family, sy_name(names, subject), sy_name(names, other)))
        option: mutable i64 = 0
        while option < option_count |option, option_count, family, q|:
            sy_add_option(q, sy_option_text(family, option))
            option <- option + 1
        q.answer <- sy_index_of(family, label, option_count)
        q.surface <- sy_index_of(family, sy_surface(web, order, subject), option_count)
        # PROVING A NEGATIVE TAKES EVERY LINE: to be sure nothing links two
        # things you have to have read all of it.
        q.steps <- path_len if path_len > 0 else q.line_count
        q.decoys <- q.line_count - q.steps
        step: mutable i64 = 0
        while step < path_len |step, path_len, chosen, found, said_start, said_len, q|:
            number: i64 = Ints::at(found.path, chosen * SY_MOST_EDGES + step)
            slot: i64 = q.working_count
            Ints::put(&q.working, slot * 2, Ints::at(said_start, number))
            Ints::put(&q.working, slot * 2 + 1, Ints::at(said_len, number))
            q.working_count <- slot + 1
            step <- step + 1
        closing: mutable dstr = []
        dstr_append_cstr(&closing, "so ")
        dstr_append_dstr(&closing, sy_conclusion(family, sy_name(names, subject), sy_name(names, other), label))
        sy_add_working(q, closing)

# One question from an order, a parity or a direction.
#
# The answer wanted and whether the surface reader should get it are both
# decided BEFORE any web is built, and then webs are grown until one can supply
# both. Deciding either after the fact lets whatever the web happens to be good
# at set the odds.
def sy_chain_question(g: SyGrade, rng: mutable MT19937&, made_up: bool, names: mutable SyNames&, web: mutable SyWeb&, found: mutable SyAskable&, q: mutable SyQuestion&) -> bool:
    can Memory.Allocate, Abort.Panic:
        family: i64 = g.family
        option_count: i64 = sy_option_count(family)
        want: i64 = py_randrange(rng, 0, option_count)
        agree: bool = sy_agreeable(rng, family, option_count, want)
        keep: mutable darray[i64] = Ints::zeros(SY_MOST_PAIRS)
        order: mutable darray[i64] = Ints::zeros(SY_MOST_EDGES)
        sorted_labels: mutable darray[i64] = Ints::zeros(64)
        # `kept` is the fallback: the first usable web, with a label chosen off
        # its own sorted keys. It is dressed only if nothing better turns up.
        kept_web: mutable SyWeb = SyWeb()
        kept_names: mutable SyNames = SyNames()
        kept_found: mutable SyAskable = SyAskable()
        kept_order: mutable darray[i64] = Ints::zeros(SY_MOST_EDGES)
        kept_label: mutable i64 = -2
        attempt: mutable i64 = 0
        while attempt < 40 |attempt, g, family, option_count, want, agree, rng, made_up, names, web, found, q, keep, order, sorted_labels, kept_web, kept_names, kept_found, kept_order, kept_label|:
            parts: i64 = 1 if sy_has_axes(family) else (1 if py_choice_index(rng, 2) == 0 else 2)
            if sy_grow(rng, g, parts, names, made_up, false, web):
                sy_askable(web, found)
                if sy_usable(found, family):
                    fill: mutable i64 = 0
                    while fill < web.edges |fill, web, order|:
                        Ints::put(&order, fill, fill)
                        fill <- fill + 1
                    py_shuffle_i64_prefix(rng, &order, web.edges)
                    if kept_label == -2:
                        sy_sorted_labels(family, found.labels, found.label_count, &sorted_labels)
                        kept_label <- Ints::at(sorted_labels, py_choice_index(rng, found.label_count))
                        sy_copy_web(&kept_web, web)
                        sy_copy_names(&kept_names, names)
                        sy_copy_askable(&kept_found, found)
                        sy_copy_order(&kept_order, order, web.edges)
                    # `want not in found` -- the label has to be on offer.
                    present: mutable bool = false
                    look: mutable i64 = 0
                    while look < found.label_count |look, found, want, present|:
                        present <- true if Ints::at_ref(&found.labels, look) == want
                        look <- look + 1
                    if present:
                        keep_n: mutable i64 = 0
                        pick: mutable i64 = 0
                        while pick < found.count |pick, found, want, web, order, agree, keep, keep_n|:
                            if Ints::at_ref(&found.label, pick) == want:
                                got: i64 = sy_surface(web, order, Ints::at_ref(&found.subject, pick))
                                if (got == want) == agree:
                                    Ints::put(&keep, keep_n, pick)
                                    keep_n <- keep_n + 1
                            pick <- pick + 1
                        if keep_n > 0:
                            sy_dress(rng, web, names, want, found, keep, keep_n, order, q)
                            return true
            attempt <- attempt + 1
        if kept_label == -2:
            return false
        keep_n: mutable i64 = 0
        pick: mutable i64 = 0
        while pick < kept_found.count |pick, kept_found, kept_label, keep, keep_n|:
            if Ints::at_ref(&kept_found.label, pick) == kept_label:
                Ints::put(&keep, keep_n, pick)
                keep_n <- keep_n + 1
            pick <- pick + 1
        sy_dress(rng, &kept_web, &kept_names, kept_label, &kept_found, keep, keep_n, kept_order, q)
        return true

def sy_copy_web(out: mutable SyWeb&, web: SyWeb&):
    can Abort.Panic:
        out.grade <- web.grade
        out.items <- web.items
        out.edges <- web.edges
        index: mutable i64 = 0
        while index < web.edges |index, web, out|:
            Ints::put(&out.left, index, Ints::at(web.left, index))
            Ints::put(&out.right, index, Ints::at(web.right, index))
            Ints::put(&out.value0, index, Ints::at(web.value0, index))
            Ints::put(&out.value1, index, Ints::at(web.value1, index))
            Ints::put(&out.value2, index, Ints::at(web.value2, index))
            index <- index + 1
        item: mutable i64 = 0
        while item < web.items |item, web, out|:
            Ints::put(&out.place0, item, Ints::at(web.place0, item))
            Ints::put(&out.place1, item, Ints::at(web.place1, item))
            Ints::put(&out.place2, item, Ints::at(web.place2, item))
            Ints::put(&out.part, item, Ints::at(web.part, item))
            item <- item + 1

def sy_copy_names(out: mutable SyNames&, names: SyNames&):
    can Abort.Panic:
        out.used <- names.used
        out.count <- names.count
        index: mutable i64 = 0
        while index < names.used |index, names, out|:
            Bytes::put(&out.bytes, index, Bytes::at(names.bytes, index))
            index <- index + 1
        slot: mutable i64 = 0
        while slot < names.count |slot, names, out|:
            Ints::put(&out.start, slot, Ints::at(names.start, slot))
            Ints::put(&out.length, slot, Ints::at(names.length, slot))
            slot <- slot + 1

def sy_copy_askable(out: mutable SyAskable&, found: SyAskable&):
    can Abort.Panic:
        out.count <- found.count
        out.label_count <- found.label_count
        index: mutable i64 = 0
        while index < found.count |index, found, out|:
            Ints::put(&out.subject, index, Ints::at(found.subject, index))
            Ints::put(&out.other, index, Ints::at(found.other, index))
            Ints::put(&out.label, index, Ints::at(found.label, index))
            length: i64 = Ints::at(found.path_len, index)
            Ints::put(&out.path_len, index, length)
            step: mutable i64 = 0
            while step < length |step, length, index, found, out|:
                Ints::put(&out.path, index * SY_MOST_EDGES + step, Ints::at(found.path, index * SY_MOST_EDGES + step))
                step <- step + 1
            index <- index + 1
        label: mutable i64 = 0
        while label < found.label_count |label, found, out|:
            Ints::put(&out.labels, label, Ints::at(found.labels, label))
            label <- label + 1

def sy_copy_order(out: mutable darray[i64]&, order: darray[i64], count: i64):
    can Abort.Panic:
        index: mutable i64 = 0
        while index < count |index, count, order, out|:
            Ints::put(out, index, Ints::at(order, index))
            index <- index + 1

# --- all, none and at least one ---
#
# Decided by a fact about this fragment rather than by counting models: every
# universal premise is a condition on ONE THING AT A TIME, so a set of premises
# has a model exactly when every existential premise has a kind of thing no
# universal forbids. That is one pass over the 2^n kinds, and it is exact.
const SY_MOST_PREMISES: i64 = 8

struct SyStatements:
    form: mutable darray[i64]
    subject: mutable darray[i64]
    predicate: mutable darray[i64]
    count: mutable i64

def SyStatements(room: i64) -> SyStatements:
    can Memory.Allocate, Abort.Panic:
        out: mutable SyStatements = zeroed
        out.form <- Ints::zeros(room)
        out.subject <- Ints::zeros(room)
        out.predicate <- Ints::zeros(room)
        return out

def sy_statement_put(out: mutable SyStatements&, slot: i64, form: i64, subject: i64, predicate: i64):
    can Abort.Panic:
        Ints::put(&out.form, slot, form)
        Ints::put(&out.subject, slot, subject)
        Ints::put(&out.predicate, slot, predicate)

# Whether a universal premise rules this kind of thing out.
def sy_forbids(form: i64, subject: i64, predicate: i64, kind: i64) -> bool:
    can Abort.Panic:
        has_subject: bool = ((kind / sy_bit(subject)) % 2) == 1
        has_predicate: bool = ((kind / sy_bit(predicate)) % 2) == 1
        if form == SY_ALL:
            return has_subject and not has_predicate
        return has_subject and has_predicate

# Whether this kind of thing is a witness for an existential.
def sy_wants(form: i64, subject: i64, predicate: i64, kind: i64) -> bool:
    can Abort.Panic:
        has_subject: bool = ((kind / sy_bit(subject)) % 2) == 1
        has_predicate: bool = ((kind / sy_bit(predicate)) % 2) == 1
        if form == SY_SOME:
            return has_subject and has_predicate
        return has_subject and not has_predicate

def sy_bit(index: i64) -> i64:
    can Abort.Panic:
        out: mutable i64 = 1
        step: mutable i64 = 0
        while step < index |step, index, out|:
            out <- out * 2
            step <- step + 1
        return out

# Whether `count` terms can be arranged so all of these hold. The BOOLEAN
# reading: `every X is a Y` does not say there are any X, and the empty world
# satisfies every universal there is.
def sy_satisfiable(count: i64, statements: SyStatements&, extra_form: i64, extra_subject: i64, extra_predicate: i64) -> bool:
    can Memory.Allocate, Abort.Panic:
        kinds: i64 = sy_bit(count)
        allowed: mutable darray[i64] = Ints::zeros(kinds)
        allowed_n: mutable i64 = 0
        kind: mutable i64 = 0
        while kind < kinds |kind, kinds, statements, extra_form, extra_subject, extra_predicate, allowed, allowed_n|:
            forbidden: mutable bool = false
            at: mutable i64 = 0
            while at < statements.count and not forbidden |at, statements, kind, forbidden|:
                form: i64 = Ints::at(statements.form, at)
                if form == SY_ALL or form == SY_NONE:
                    forbidden <- true if sy_forbids(form, Ints::at(statements.subject, at), Ints::at(statements.predicate, at), kind)
                at <- at + 1
            if not forbidden and (extra_form == SY_ALL or extra_form == SY_NONE):
                forbidden <- sy_forbids(extra_form, extra_subject, extra_predicate, kind)
            if not forbidden:
                Ints::put(&allowed, allowed_n, kind)
                allowed_n <- allowed_n + 1
            kind <- kind + 1
        every: mutable bool = true
        at: mutable i64 = 0
        while at < statements.count and every |at, statements, allowed, allowed_n, every|:
            form: i64 = Ints::at(statements.form, at)
            if form == SY_SOME or form == SY_SOME_NOT:
                every <- sy_witnessed(form, Ints::at(statements.subject, at), Ints::at(statements.predicate, at), allowed, allowed_n)
            at <- at + 1
        if every and (extra_form == SY_SOME or extra_form == SY_SOME_NOT):
            every <- sy_witnessed(extra_form, extra_subject, extra_predicate, allowed, allowed_n)
        return every

def sy_witnessed(form: i64, subject: i64, predicate: i64, allowed: darray[i64], allowed_n: i64) -> bool:
    can Abort.Panic:
        at: mutable i64 = 0
        found: mutable bool = false
        while at < allowed_n and not found |at, allowed_n, allowed, form, subject, predicate, found|:
            found <- true if sy_wants(form, subject, predicate, Ints::at(allowed, at))
            at <- at + 1
        return found

# Whether `conclusion` holds wherever the premises do: deny it and see whether
# anything is left standing.
def sy_entails(count: i64, premises: SyStatements&, form: i64, subject: i64, predicate: i64) -> bool:
    can Memory.Allocate, Abort.Panic:
        return not sy_satisfiable(count, premises, sy_opposite_form(form), subject, predicate)

# The classic no-reasoning answer, and it is a real effect: negative premise,
# negative conclusion; particular premise, particular conclusion. It never
# answers `nothing follows`, which is what makes it worth measuring against.
def sy_atmosphere(premises: SyStatements&) -> i64:
    can Abort.Panic:
        negative: mutable bool = false
        particular: mutable bool = false
        at: mutable i64 = 0
        while at < premises.count |at, premises, negative, particular|:
            form: i64 = Ints::at(premises.form, at)
            negative <- true if form == SY_NONE or form == SY_SOME_NOT
            particular <- true if form == SY_SOME or form == SY_SOME_NOT
            at <- at + 1
        if negative:
            return SY_SOME_NOT if particular else SY_NONE
        return SY_SOME if particular else SY_ALL

# Every way to link `count` terms in a row with one premise each: four forms
# per link, and each link may be written either way round.
def sy_shape_count(count: i64) -> i64:
    can Abort.Panic:
        links: i64 = count - 1
        out: mutable i64 = 1
        step: mutable i64 = 0
        while step < links |step, links, out|:
            out <- out * 8
            step <- step + 1
        return out

# `itertools.product(FORMS, repeat=links)` outer, `product((0, 1), ...)` inner,
# so the shape index splits into a forms numeral and a turns numeral.
def sy_shape_at(count: i64, index: i64, out: mutable SyStatements&):
    can Abort.Panic:
        links: i64 = count - 1
        turn_span: mutable i64 = 1
        step: mutable i64 = 0
        while step < links |step, links, turn_span|:
            turn_span <- turn_span * 2
            step <- step + 1
        forms_index: i64 = index / turn_span
        turns_index: i64 = index % turn_span
        out.count <- links
        link: mutable i64 = 0
        while link < links |link, links, forms_index, turns_index, out|:
            form_divisor: mutable i64 = 1
            back: mutable i64 = 0
            while back < links - 1 - link |back, links, link, form_divisor|:
                form_divisor <- form_divisor * 4
                back <- back + 1
            form: i64 = (forms_index / form_divisor) % 4
            turn_divisor: mutable i64 = 1
            over: mutable i64 = 0
            while over < links - 1 - link |over, links, link, turn_divisor|:
                turn_divisor <- turn_divisor * 2
                over <- over + 1
            turn: i64 = (turns_index / turn_divisor) % 2
            sy_statement_put(out, link, form, link + turn, link + 1 - turn)
            link <- link + 1

# The five categorical answers sort by their TEXT, which is not their index:
# all, none, nothing follows, some, some not.
def sy_form_rank(form: i64) -> i64:
    can Abort.Panic:
        if form == SY_ALL:
            return 0
        if form == SY_NONE:
            return 1
        if form == SY_NOTHING:
            return 2
        if form == SY_SOME:
            return 3
        return 4

def sy_form_of_rank(rank: i64) -> i64:
    can Abort.Panic:
        if rank == 0:
            return SY_ALL
        if rank == 1:
            return SY_NONE
        if rank == 2:
            return SY_NOTHING
        if rank == 3:
            return SY_SOME
        return SY_SOME_NOT

# What `grade` offers for a categorical question: the four forms said about the
# two terms being asked, in the order they are ASKED about them -- which is not
# always the order they were introduced in, because whether a conclusion
# converts is half of what there is to get wrong here.
def sy_categorical_option(subject: sview, other: sview, index: i64) -> dstr:
    can Memory.Allocate, Abort.Panic:
        out: mutable dstr = []
        if index >= 4:
            dstr_append_cstr(&out, "nothing follows")
            return out
        sy_append_says(&out, index, subject, other)
        return out

# How many premises the conclusion still follows without. Counted by leaving
# each one out and asking again rather than by guessing from where it sits in
# the chain: a premise off the path can still be doing work.
def sy_spare(count: i64, premises: SyStatements&, label: i64, subject: i64, other: i64) -> i64:
    can Memory.Allocate, Abort.Panic:
        if label == SY_NOTHING:
            return 0
        without: mutable SyStatements = SyStatements(SY_MOST_PREMISES)
        spare: mutable i64 = 0
        drop: mutable i64 = 0
        while drop < premises.count |drop, premises, without, count, label, subject, other, spare|:
            kept: mutable i64 = 0
            at: mutable i64 = 0
            while at < premises.count |at, premises, drop, without, kept|:
                if at != drop:
                    sy_statement_put(&without, kept, Ints::at(premises.form, at), Ints::at(premises.subject, at), Ints::at(premises.predicate, at))
                    kept <- kept + 1
                at <- at + 1
            without.count <- kept
            if sy_satisfiable(count, &without, -1, 0, 0) and sy_entails(count, &without, label, subject, other):
                spare <- spare + 1
            drop <- drop + 1
        return spare

# Which answer this deal should have. Evenly over the five, UNLESS the
# atmosphere reader cannot be fooled at this pair -- which is not a quirk of
# the generator but the classical rules themselves: a valid conclusion is
# negative exactly when a premise is, and particular exactly when a premise is.
# Where that holds, the four forms are one answer between them and the only
# question left is whether anything follows at all, so it is asked as the coin
# it is.
def sy_which(rng: mutable MT19937&, count: i64, group_of: darray[i64], shapes: i64, present: darray[i64]) -> i64:
    can Memory.Allocate, Abort.Panic:
        # The labels present, in sorted-by-text order.
        sorted_labels: mutable darray[i64] = Ints::zeros(8)
        sorted_n: mutable i64 = 0
        rank: mutable i64 = 0
        while rank < 5 |rank, present, sorted_labels, sorted_n|:
            form: i64 = sy_form_of_rank(rank)
            if Ints::at(present, form) == 1:
                Ints::put(&sorted_labels, sorted_n, form)
                sorted_n <- sorted_n + 1
            rank <- rank + 1
        forms: mutable darray[i64] = Ints::zeros(8)
        forms_n: mutable i64 = 0
        at: mutable i64 = 0
        while at < sorted_n |at, sorted_n, sorted_labels, forms, forms_n|:
            label: i64 = Ints::at(sorted_labels, at)
            if label != SY_NOTHING:
                Ints::put(&forms, forms_n, label)
                forms_n <- forms_n + 1
            at <- at + 1
        premises: mutable SyStatements = SyStatements(SY_MOST_PREMISES)
        fooled: mutable bool = false
        walk: mutable i64 = 0
        while walk < forms_n and not fooled |walk, forms_n, forms, group_of, shapes, count, premises, fooled|:
            label: i64 = Ints::at(forms, walk)
            shape: mutable i64 = 0
            while shape < shapes and not fooled |shape, shapes, group_of, label, count, premises, fooled|:
                if Ints::at(group_of, shape) == label:
                    sy_shape_at(count, shape, &premises)
                    fooled <- true if sy_atmosphere(&premises) != label
                shape <- shape + 1
            walk <- walk + 1
        if fooled or forms_n == 0 or Ints::at(present, SY_NOTHING) == 0:
            return Ints::at(sorted_labels, py_choice_index(rng, sorted_n))
        if py_random(rng) < 0.5:
            return SY_NOTHING
        return Ints::at(forms, py_choice_index(rng, forms_n))

# Two or three premises about kinds of thing.
#
# THE PAIR ASKED ABOUT IS NOT ALWAYS THE TWO ENDS, and not always the way round
# they were introduced. Both matter: a premise off the path between them is a
# premise whose negative or particular form the atmosphere reader counts and
# should not, and a question asked backwards is the illicit conversion that
# "at least one X is not a Y" invites.
def sy_categorical_question(g: SyGrade, rng: mutable MT19937&, made_up: bool, names: mutable SyNames&, q: mutable SyQuestion&) -> bool:
    can Memory.Allocate, Abort.Panic:
        count: i64 = g.items
        sy_things(rng, count, made_up, names)
        # `ends` -- every pair more than one step apart, in row-major order.
        end_one: mutable darray[i64] = Ints::zeros(64)
        end_two: mutable darray[i64] = Ints::zeros(64)
        ends: mutable i64 = 0
        one: mutable i64 = 0
        while one < count |one, count, end_one, end_two, ends|:
            two: mutable i64 = 0
            while two < count |two, one, count, end_one, end_two, ends|:
                gap: i64 = one - two
                if (gap if gap > 0 else -gap) > 1:
                    Ints::put(&end_one, ends, one)
                    Ints::put(&end_two, ends, two)
                    ends <- ends + 1
                two <- two + 1
            one <- one + 1
        chosen_end: i64 = py_choice_index(rng, ends)
        subject: i64 = Ints::at(end_one, chosen_end)
        other: i64 = Ints::at(end_two, chosen_end)
        shapes: i64 = sy_shape_count(count)
        group_of: mutable darray[i64] = Ints::zeros(shapes)
        present: mutable darray[i64] = Ints::zeros(8)
        premises: mutable SyStatements = SyStatements(SY_MOST_PREMISES)
        any_found: mutable bool = false
        shape: mutable i64 = 0
        while shape < shapes |shape, shapes, count, subject, other, premises, group_of, present, any_found|:
            Ints::put(&group_of, shape, -1)
            sy_shape_at(count, shape, &premises)
            if sy_satisfiable(count, &premises, -1, 0, 0):
                holds: mutable i64 = 0
                first: mutable i64 = -1
                form: mutable i64 = 0
                while form < 4 |form, count, premises, subject, other, holds, first|:
                    if sy_entails(count, &premises, form, subject, other):
                        first <- form if holds == 0
                        holds <- holds + 1
                    form <- form + 1
                # Premises that force a term to pick out nothing entail more
                # than one form at once. Rare, and thrown away rather than
                # dealt with a second right answer.
                if holds <= 1:
                    label: i64 = first if holds == 1 else SY_NOTHING
                    Ints::put(&group_of, shape, label)
                    Ints::put(&present, label, 1)
                    any_found <- true
            shape <- shape + 1
        if not any_found:
            return false
        label: i64 = sy_which(rng, count, group_of, shapes, present)
        agree: bool = sy_agreeable(rng, SY_CATEGORICAL, 5, label)
        # `fitting or choices` -- fall back to the whole group when nothing in
        # it agrees the way the deal wanted.
        keep: mutable darray[i64] = Ints::zeros(shapes)
        keep_n: mutable i64 = 0
        all_n: mutable i64 = 0
        every: mutable darray[i64] = Ints::zeros(shapes)
        pick: mutable i64 = 0
        while pick < shapes |pick, shapes, group_of, label, count, premises, agree, keep, keep_n, every, all_n|:
            if Ints::at(group_of, pick) == label:
                Ints::put(&every, all_n, pick)
                all_n <- all_n + 1
                sy_shape_at(count, pick, &premises)
                if (sy_atmosphere(&premises) == label) == agree:
                    Ints::put(&keep, keep_n, pick)
                    keep_n <- keep_n + 1
            pick <- pick + 1
        taken: i64 = Ints::at(keep, py_choice_index(rng, keep_n)) if keep_n > 0 else Ints::at(every, py_choice_index(rng, all_n))
        sy_shape_at(count, taken, &premises)
        order: mutable darray[i64] = Ints::zeros(SY_MOST_PREMISES)
        fill: mutable i64 = 0
        while fill < premises.count |fill, premises, order|:
            Ints::put(&order, fill, fill)
            fill <- fill + 1
        py_shuffle_i64_prefix(rng, &order, premises.count)
        sy_question_reset(q)
        q.found <- true
        q.family <- SY_CATEGORICAL
        line: mutable i64 = 0
        while line < premises.count |line, premises, order, names, q|:
            at: i64 = Ints::at(order, line)
            said: mutable dstr = []
            sy_append_says(&said, Ints::at(premises.form, at), sy_name(names, Ints::at(premises.subject, at)), sy_name(names, Ints::at(premises.predicate, at)))
            sy_add_line(q, said)
            line <- line + 1
        asked: mutable dstr = []
        dstr_append_cstr(&asked, "What follows about ")
        dstr_append_sview(&asked, sy_name(names, subject))
        dstr_append_cstr(&asked, " and ")
        dstr_append_sview(&asked, sy_name(names, other))
        dstr_append_cstr(&asked, "?")
        sy_set_asked(q, asked)
        option: mutable i64 = 0
        while option < 5 |option, names, subject, other, q|:
            sy_add_option(q, sy_categorical_option(sy_name(names, subject), sy_name(names, other), option))
            option <- option + 1
        q.option_count <- 5
        q.answer <- label if label != SY_NOTHING else 4
        q.surface <- sy_atmosphere(&premises)
        spare: i64 = sy_spare(count, &premises, label, subject, other)
        q.steps <- premises.count - spare
        q.decoys <- spare
        # The working quotes the lines as shown, then says why.
        quote: mutable i64 = 0
        while quote < q.line_count |quote, q|:
            slot: i64 = q.working_count
            Ints::put(&q.working, slot * 2, Ints::at(q.lines, quote * 2))
            Ints::put(&q.working, slot * 2 + 1, Ints::at(q.lines, quote * 2 + 1))
            q.working_count <- slot + 1
            quote <- quote + 1
        sy_categorical_working(count, &premises, names, label, subject, other, q)
        return true

# Why. For `nothing follows` that means TWO WORLDS, not a shrug.
def sy_categorical_working(count: i64, premises: SyStatements&, names: SyNames&, label: i64, subject: i64, other: i64, q: mutable SyQuestion&):
    can Memory.Allocate, Abort.Panic:
        if label != SY_NOTHING:
            first: mutable dstr = []
            dstr_append_cstr(&first, "so ")
            sy_append_says(&first, label, sy_name(names, subject), sy_name(names, other))
            sy_add_working(q, first)
            second: mutable dstr = []
            dstr_append_cstr(&second, "and none of the other three follows")
            sy_add_working(q, second)
            return
        both: mutable darray[i64] = Ints::zeros(8)
        both_n: mutable i64 = 0
        form: mutable i64 = 0
        while form < 4 |form, count, premises, subject, other, both, both_n|:
            if sy_satisfiable(count, premises, form, subject, other):
                Ints::put(&both, both_n, form)
                both_n <- both_n + 1
            form <- form + 1
        if both_n >= 2:
            first: mutable dstr = []
            dstr_append_cstr(&first, "the premises are all still true when ")
            sy_append_says(&first, Ints::at(both, 0), sy_name(names, subject), sy_name(names, other))
            dstr_append_cstr(&first, ",")
            sy_add_working(q, first)
            second: mutable dstr = []
            dstr_append_cstr(&second, "and all still true when ")
            sy_append_says(&second, Ints::at(both, 1), sy_name(names, subject), sy_name(names, other))
            dstr_append_cstr(&second, ",")
            sy_add_working(q, second)
        closing: mutable dstr = []
        dstr_append_cstr(&closing, "so nothing follows about ")
        dstr_append_sview(&closing, sy_name(names, subject))
        dstr_append_cstr(&closing, " and ")
        dstr_append_sview(&closing, sy_name(names, other))
        sy_add_working(q, closing)

# --- relations about relations ---
#
# `_flat(found)` is the pairs in SORTED-LABEL order and then insertion order
# within each label, which is the order every index below is into.
const SY_MOST_GROUPS: i64 = 8192

struct SyMeta:
    # The flattened pairs: an index into the askable list, per flat position.
    flat: mutable darray[i64]
    flat_label: mutable darray[i64]
    flat_n: mutable i64
    # Ordered pairs of flat positions, with the meta label each falls under.
    one: mutable darray[i64]
    two: mutable darray[i64]
    group: mutable darray[i64]
    count: mutable i64
    present: mutable darray[i64]

def SyMeta() -> SyMeta:
    can Memory.Allocate, Abort.Panic:
        out: mutable SyMeta = zeroed
        out.flat <- Ints::zeros(SY_MOST_PAIRS)
        out.flat_label <- Ints::zeros(SY_MOST_PAIRS)
        out.one <- Ints::zeros(SY_MOST_GROUPS)
        out.two <- Ints::zeros(SY_MOST_GROUPS)
        out.group <- Ints::zeros(SY_MOST_GROUPS)
        out.present <- Ints::zeros(4)
        return out

def sy_flatten(family: i64, found: SyAskable&, meta: mutable SyMeta&):
    can Memory.Allocate, Abort.Panic:
        meta.flat_n <- 0
        sorted_labels: mutable darray[i64] = Ints::zeros(64)
        sy_sorted_labels(family, found.labels, found.label_count, &sorted_labels)
        at: mutable i64 = 0
        while at < found.label_count |at, found, sorted_labels, meta|:
            label: i64 = Ints::at(sorted_labels, at)
            pick: mutable i64 = 0
            while pick < found.count |pick, found, label, meta|:
                if Ints::at(found.label, pick) == label:
                    Ints::put(&meta.flat, meta.flat_n, pick)
                    Ints::put(&meta.flat_label, meta.flat_n, label)
                    meta.flat_n <- meta.flat_n + 1
                pick <- pick + 1
            at <- at + 1

# What the one-line reader makes of the two relations.
def sy_meta_surface(web: SyWeb&, order: darray[i64], found: SyAskable&, one: i64, two: i64) -> i64:
    can Abort.Panic:
        untold: i64 = sy_untold_label(web.grade.family)
        first: i64 = sy_surface(web, order, Ints::at(found.subject, one))
        second: i64 = sy_surface(web, order, Ints::at(found.subject, two))
        if first == untold or second == untold:
            return 2
        return 0 if first == second else 1

def sy_meta_groups(web: SyWeb&, found: SyAskable&, meta: mutable SyMeta&):
    can Abort.Panic:
        untold: i64 = sy_untold_label(web.grade.family)
        meta.count <- 0
        Ints::put(&meta.present, 0, 0)
        Ints::put(&meta.present, 1, 0)
        Ints::put(&meta.present, 2, 0)
        a: mutable i64 = 0
        while a < meta.flat_n |a, meta, found, untold|:
            b: mutable i64 = 0
            while b < meta.flat_n |b, a, meta, found, untold|:
                if b != a:
                    one: i64 = Ints::at(meta.flat, a)
                    two: i64 = Ints::at(meta.flat, b)
                    # The four items must be distinct: a pair sharing a name
                    # with the other is not two relations, it is one restated.
                    s1: i64 = Ints::at(found.subject, one)
                    o1: i64 = Ints::at(found.other, one)
                    s2: i64 = Ints::at(found.subject, two)
                    o2: i64 = Ints::at(found.other, two)
                    distinct: bool = s1 != o1 and s1 != s2 and s1 != o2 and o1 != s2 and o1 != o2 and s2 != o2
                    if distinct:
                        label_one: i64 = Ints::at(meta.flat_label, a)
                        label_two: i64 = Ints::at(meta.flat_label, b)
                        answer: mutable i64 = 0
                        if label_one == untold or label_two == untold:
                            answer <- 2
                        else:
                            answer <- 0 if label_one == label_two else 1
                        Ints::put(&meta.one, meta.count, a)
                        Ints::put(&meta.two, meta.count, b)
                        Ints::put(&meta.group, meta.count, answer)
                        Ints::put(&meta.present, answer, 1)
                        meta.count <- meta.count + 1
                b <- b + 1
            a <- a + 1

# `sorted(groups)` over the META labels: cannot be told, different, the same.
def sy_meta_sorted(present: darray[i64], out: mutable darray[i64]&) -> i64:
    can Abort.Panic:
        # cannot be told (2), different (1), the same (0) -- alphabetical.
        count: mutable i64 = 0
        rank: mutable i64 = 0
        while rank < 3 |rank, present, out, count|:
            label: i64 = 2 if rank == 0 else (1 if rank == 1 else 0)
            if Ints::at(present, label) == 1:
                Ints::put(out, count, label)
                count <- count + 1
            rank <- rank + 1
        return count

def sy_dress_meta(rng: mutable MT19937&, g: SyGrade, web: SyWeb&, names: SyNames&, found: SyAskable&, meta: SyMeta&, answer: i64, keep: darray[i64], keep_n: i64, order: darray[i64], q: mutable SyQuestion&):
    can Memory.Allocate, Abort.Panic:
        inner: i64 = web.grade.family
        picked: i64 = Ints::at(keep, py_choice_index(rng, keep_n))
        flat_one: i64 = Ints::at(meta.one, picked)
        flat_two: i64 = Ints::at(meta.two, picked)
        one: i64 = Ints::at(meta.flat, flat_one)
        two: i64 = Ints::at(meta.flat, flat_two)
        sy_question_reset(q)
        q.found <- true
        q.family <- SY_META
        said_start: mutable darray[i64] = Ints::zeros(SY_MOST_EDGES)
        said_len: mutable darray[i64] = Ints::zeros(SY_MOST_EDGES)
        write: mutable i64 = 0
        while write < web.edges |write, web, order, names, rng, q, said_start, said_len|:
            number: i64 = Ints::at(order, write)
            text: dstr = sy_render(web, number, names, rng)
            Ints::put(&said_start, number, sy_take_text(q, text))
            Ints::put(&said_len, number, text.count.i64())
            write <- write + 1
        place: mutable i64 = 0
        while place < web.edges |place, web, order, said_start, said_len, q|:
            number: i64 = Ints::at(order, place)
            slot: i64 = q.line_count
            Ints::put(&q.lines, slot * 2, Ints::at(said_start, number))
            Ints::put(&q.lines, slot * 2 + 1, Ints::at(said_len, number))
            q.line_count <- slot + 1
            place <- place + 1
        steps: mutable i64 = 0
        half: mutable i64 = 0
        while half < 2 |half, one, two, found, said_start, said_len, inner, names, meta, flat_one, flat_two, q, steps|:
            pair: i64 = one if half == 0 else two
            label: i64 = Ints::at(meta.flat_label, flat_one if half == 0 else flat_two)
            path_len: i64 = Ints::at(found.path_len, pair)
            step: mutable i64 = 0
            while step < path_len |step, path_len, pair, found, said_start, said_len, q|:
                number: i64 = Ints::at(found.path, pair * SY_MOST_EDGES + step)
                slot: i64 = q.working_count
                Ints::put(&q.working, slot * 2, Ints::at(said_start, number))
                Ints::put(&q.working, slot * 2 + 1, Ints::at(said_len, number))
                q.working_count <- slot + 1
                step <- step + 1
            said: mutable dstr = []
            dstr_append_cstr(&said, "so ")
            dstr_append_dstr(&said, sy_conclusion(inner, sy_name(names, Ints::at(found.subject, pair)), sy_name(names, Ints::at(found.other, pair)), label))
            sy_add_working(q, said)
            steps <- steps + (path_len if path_len > 0 else q.line_count)
            half <- half + 1
        closing: mutable dstr = []
        dstr_append_cstr(&closing, "so the two are ")
        dstr_append_dstr(&closing, sy_option_text(SY_META, answer))
        sy_add_working(q, closing)
        asked: mutable dstr = []
        dstr_append_cstr(&asked, "Is the way ")
        dstr_append_sview(&asked, sy_name(names, Ints::at(found.subject, one)))
        dstr_append_cstr(&asked, " stands to ")
        dstr_append_sview(&asked, sy_name(names, Ints::at(found.other, one)))
        dstr_append_cstr(&asked, " the same as the way ")
        dstr_append_sview(&asked, sy_name(names, Ints::at(found.subject, two)))
        dstr_append_cstr(&asked, " stands to ")
        dstr_append_sview(&asked, sy_name(names, Ints::at(found.other, two)))
        dstr_append_cstr(&asked, "?")
        sy_set_asked(q, asked)
        option: mutable i64 = 0
        while option < 3 |option, q|:
            sy_add_option(q, sy_option_text(SY_META, option))
            option <- option + 1
        q.answer <- answer
        q.surface <- sy_meta_surface(web, order, found, one, two)
        q.steps <- steps
        q.decoys <- q.line_count - steps if q.line_count > steps else 0

# Two relations out of one web, and whether they are the same kind.
def sy_meta_question(g: SyGrade, rng: mutable MT19937&, made_up: bool, names: mutable SyNames&, web: mutable SyWeb&, found: mutable SyAskable&, meta: mutable SyMeta&, q: mutable SyQuestion&) -> bool:
    can Memory.Allocate, Abort.Panic:
        inner: i64 = g.inner[0] if g.inner_count > 0 else SY_ORDER
        sub: SyGrade = sy_sub_grade(g, inner, g.items, g.extra)
        want: i64 = py_randrange(rng, 0, 3)
        agree: bool = sy_agreeable(rng, SY_META, 3, want)
        keep: mutable darray[i64] = Ints::zeros(SY_MOST_GROUPS)
        order: mutable darray[i64] = Ints::zeros(SY_MOST_EDGES)
        sorted_groups: mutable darray[i64] = Ints::zeros(8)
        kept_web: mutable SyWeb = SyWeb()
        kept_names: mutable SyNames = SyNames()
        kept_found: mutable SyAskable = SyAskable()
        kept_meta: mutable SyMeta = SyMeta()
        kept_order: mutable darray[i64] = Ints::zeros(SY_MOST_EDGES)
        kept_label: mutable i64 = -2
        attempt: mutable i64 = 0
        while attempt < 40 |attempt, g, sub, inner, want, agree, rng, made_up, names, web, found, meta, q, keep, order, sorted_groups, kept_web, kept_names, kept_found, kept_meta, kept_order, kept_label|:
            parts: i64 = 1 if sy_has_axes(inner) else (1 if py_choice_index(rng, 2) == 0 else 2)
            if sy_grow(rng, sub, parts, names, made_up, false, web):
                sy_askable(web, found)
                if sy_usable(found, inner):
                    sy_flatten(inner, found, meta)
                    if meta.flat_n >= 2:
                        sy_meta_groups(web, found, meta)
                        if meta.count > 0:
                            fill: mutable i64 = 0
                            while fill < web.edges |fill, web, order|:
                                Ints::put(&order, fill, fill)
                                fill <- fill + 1
                            py_shuffle_i64_prefix(rng, &order, web.edges)
                            if kept_label == -2:
                                group_n: i64 = sy_meta_sorted(meta.present, &sorted_groups)
                                kept_label <- Ints::at(sorted_groups, py_choice_index(rng, group_n))
                                sy_copy_web(&kept_web, web)
                                sy_copy_names(&kept_names, names)
                                sy_copy_askable(&kept_found, found)
                                sy_copy_meta(&kept_meta, meta)
                                sy_copy_order(&kept_order, order, web.edges)
                            if Ints::at_ref(&meta.present, want) == 1:
                                keep_n: mutable i64 = 0
                                pick: mutable i64 = 0
                                while pick < meta.count |pick, meta, want, web, order, found, agree, keep, keep_n|:
                                    if Ints::at_ref(&meta.group, pick) == want:
                                        one: i64 = Ints::at_ref(&meta.flat, Ints::at_ref(&meta.one, pick))
                                        two: i64 = Ints::at_ref(&meta.flat, Ints::at_ref(&meta.two, pick))
                                        if (sy_meta_surface(web, order, found, one, two) == want) == agree:
                                            Ints::put(&keep, keep_n, pick)
                                            keep_n <- keep_n + 1
                                    pick <- pick + 1
                                if keep_n > 0:
                                    sy_dress_meta(rng, g, web, names, found, meta, want, keep, keep_n, order, q)
                                    return true
            attempt <- attempt + 1
        if kept_label == -2:
            return false
        keep_n: mutable i64 = 0
        pick: mutable i64 = 0
        while pick < kept_meta.count |pick, kept_meta, kept_label, keep, keep_n|:
            if Ints::at_ref(&kept_meta.group, pick) == kept_label:
                Ints::put(&keep, keep_n, pick)
                keep_n <- keep_n + 1
            pick <- pick + 1
        sy_dress_meta(rng, g, &kept_web, &kept_names, &kept_found, &kept_meta, kept_label, keep, keep_n, kept_order, q)
        return true

def sy_copy_meta(out: mutable SyMeta&, meta: SyMeta&):
    can Abort.Panic:
        out.flat_n <- meta.flat_n
        out.count <- meta.count
        index: mutable i64 = 0
        while index < meta.flat_n |index, meta, out|:
            Ints::put(&out.flat, index, Ints::at(meta.flat, index))
            Ints::put(&out.flat_label, index, Ints::at(meta.flat_label, index))
            index <- index + 1
        slot: mutable i64 = 0
        while slot < meta.count |slot, meta, out|:
            Ints::put(&out.one, slot, Ints::at(meta.one, slot))
            Ints::put(&out.two, slot, Ints::at(meta.two, slot))
            Ints::put(&out.group, slot, Ints::at(meta.group, slot))
            slot <- slot + 1
        label: mutable i64 = 0
        while label < 3 |label, meta, out|:
            Ints::put(&out.present, label, Ints::at(meta.present, label))
            label <- label + 1

# --- questions made of other questions ---
#
# Three values, because `cannot be told` is one of them. An `and` with one
# false half is false whatever the other half is; an `exactly one` with an
# unsettled half is never settled. That asymmetry is most of what the top two
# rungs are about.
const SY_TRUE: i64 = 0
const SY_FALSE: i64 = 1
const SY_UNSETTLED: i64 = 2

const SY_AND: i64 = 0
const SY_OR: i64 = 1
const SY_EXACTLY_ONE: i64 = 2

def sy_kleene(op: i64, left: i64, right: i64) -> i64:
    can Abort.Panic:
        if op == SY_AND:
            if left == SY_FALSE or right == SY_FALSE:
                return SY_FALSE
            return SY_TRUE if left == SY_TRUE and right == SY_TRUE else SY_UNSETTLED
        if op == SY_OR:
            if left == SY_TRUE or right == SY_TRUE:
                return SY_TRUE
            return SY_FALSE if left == SY_FALSE and right == SY_FALSE else SY_UNSETTLED
        if left == SY_UNSETTLED or right == SY_UNSETTLED:
            return SY_UNSETTLED
        return SY_TRUE if left != right else SY_FALSE

# `sorted(truths, key=lambda v: (v is None, v))` puts False first, then True,
# then None -- which is not the option order (true, false, cannot be told).
def sy_truth_rank(value: i64) -> i64:
    can Abort.Panic:
        if value == SY_FALSE:
            return 0
        if value == SY_TRUE:
            return 1
        return 2

def sy_truth_of_rank(rank: i64) -> i64:
    can Abort.Panic:
        if rank == 0:
            return SY_FALSE
        if rank == 1:
            return SY_TRUE
        return SY_UNSETTLED

const SY_MOST_CLAIMS: i64 = 2048

struct SyPart:
    web: mutable SyWeb
    names: mutable SyNames
    found: mutable SyAskable
    order: mutable darray[i64]
    # One claim: which pair, which definite label is being claimed, and what
    # the web makes of it.
    claim_pair: mutable darray[i64]
    claim_label: mutable darray[i64]
    claim_value: mutable darray[i64]
    claim_count: mutable i64
    present: mutable darray[i64]

def SyPart() -> SyPart:
    can Memory.Allocate, Abort.Panic:
        out: mutable SyPart = zeroed
        out.web <- SyWeb()
        out.names <- SyNames()
        out.found <- SyAskable()
        out.order <- Ints::zeros(SY_MOST_EDGES)
        out.claim_pair <- Ints::zeros(SY_MOST_CLAIMS)
        out.claim_label <- Ints::zeros(SY_MOST_CLAIMS)
        out.claim_value <- Ints::zeros(SY_MOST_CLAIMS)
        out.present <- Ints::zeros(4)
        return out

# One sub-question: its premises, and every claim it settles.
#
# A claim is a DEFINITE sentence -- `cannot be told` is not something a premise
# says, it is something a reader works out -- so the claims are drawn from the
# family's definite answers only.
def sy_claims(rng: mutable MT19937&, g: SyGrade, family: i64, items: i64, pool: SyNames&, base: i64, part: mutable SyPart&) -> bool:
    can Memory.Allocate, Abort.Panic:
        untold: i64 = sy_untold_label(family)
        option_count: i64 = sy_option_count(family)
        attempt: mutable i64 = 0
        while attempt < 20 |attempt, rng, g, family, items, pool, base, part, untold, option_count|:
            parts: i64 = 1 if sy_has_axes(family) else (1 if py_choice_index(rng, 2) == 0 else 2)
            # A sub-question widens by a NAME rather than by a premise when it
            # falls into two pieces. Standing alone that would be a tell --
            # count the words, learn something -- but these are shuffled in
            # among another question's premises.
            wanted: i64 = items + parts - 1
            sub: SyGrade = sy_sub_grade(g, family, wanted, 0)
            sy_names_reset(&part.names)
            take: mutable i64 = 0
            while take < wanted |take, wanted, pool, base, part|:
                sy_names_push(&part.names, sy_name(pool, base + take))
                take <- take + 1
            if sy_grow(rng, sub, parts, &part.names, false, true, &part.web):
                sy_askable(&part.web, &part.found)
                if sy_usable(&part.found, family):
                    part.claim_count <- 0
                    Ints::put(&part.present, 0, 0)
                    Ints::put(&part.present, 1, 0)
                    Ints::put(&part.present, 2, 0)
                    # `for label, group in found.items()` -- INSERTION order,
                    # so the claim list follows the order labels were first
                    # seen, not their sorted order.
                    at: mutable i64 = 0
                    while at < part.found.label_count |at, part, family, untold, option_count|:
                        label: i64 = Ints::at_ref(&part.found.labels, at)
                        pick: mutable i64 = 0
                        while pick < part.found.count |pick, part, label, untold, option_count|:
                            if Ints::at_ref(&part.found.label, pick) == label:
                                claim: mutable i64 = 0
                                while claim < option_count |claim, part, label, claim, untold, option_count, pick|:
                                    if claim != untold:
                                        value: mutable i64 = SY_UNSETTLED
                                        if label != untold:
                                            value <- SY_TRUE if claim == label else SY_FALSE
                                        slot: i64 = part.claim_count
                                        Ints::put(&part.claim_pair, slot, pick)
                                        Ints::put(&part.claim_label, slot, claim)
                                        Ints::put(&part.claim_value, slot, value)
                                        Ints::put(&part.present, value, 1)
                                        part.claim_count <- slot + 1
                                    claim <- claim + 1
                            pick <- pick + 1
                        at <- at + 1
                    fill: mutable i64 = 0
                    while fill < part.web.edges |fill, part|:
                        Ints::put(&part.order, fill, fill)
                        fill <- fill + 1
                    return true
            attempt <- attempt + 1
        return false

const SY_MOST_SHAPES: i64 = 512

# Two or three claims, and what the connectives make of them.
def sy_binary_question(g: SyGrade, rng: mutable MT19937&, made_up: bool, pool: mutable SyNames&, parts: mutable darray[SyPart]&, q: mutable SyQuestion&) -> bool:
    can Memory.Allocate, Abort.Panic:
        families: i64 = g.inner_count
        size: i64 = 5
        sy_things(rng, (size + 1) * families, made_up, pool)
        number: mutable i64 = 0
        while number < families |number, families, g, size, rng, pool, parts|:
            if not sy_claims(rng, g, g.inner[number.usize()], size, pool, number * (size + 1), &parts[number.usize()]):
                return false
            number <- number + 1
        # `itertools.product(*keys)` over each part's truth values in
        # (False, True, None) order, crossed with every way of joining them.
        keys: mutable darray[i64] = Ints::zeros(12)
        key_n: mutable darray[i64] = Ints::zeros(4)
        part: mutable i64 = 0
        while part < families |part, families, parts, keys, key_n|:
            count: mutable i64 = 0
            rank: mutable i64 = 0
            while rank < 3 |rank, part, parts, keys, count|:
                value: i64 = sy_truth_of_rank(rank)
                if Ints::at_ref(&parts[part.usize()].present, value) == 1:
                    Ints::put(&keys, part * 3 + count, value)
                    count <- count + 1
                rank <- rank + 1
            Ints::put(&key_n, part, count)
            part <- part + 1
        combos: mutable i64 = 1
        span: mutable i64 = 0
        while span < families |span, families, key_n, combos|:
            combos <- combos * Ints::at(key_n, span)
            span <- span + 1
        ways: mutable i64 = 1
        link: mutable i64 = 0
        while link < families - 1 |link, families, ways|:
            ways <- ways * 3
            link <- link + 1
        shape_chosen: mutable darray[i64] = Ints::zeros(SY_MOST_SHAPES * 4)
        shape_way: mutable darray[i64] = Ints::zeros(SY_MOST_SHAPES * 4)
        shape_value: mutable darray[i64] = Ints::zeros(SY_MOST_SHAPES)
        shape_n: mutable i64 = 0
        present: mutable darray[i64] = Ints::zeros(4)
        combo: mutable i64 = 0
        while combo < combos |combo, combos, ways, families, keys, key_n, shape_chosen, shape_way, shape_value, shape_n, present|:
            way: mutable i64 = 0
            while way < ways |way, ways, combo, families, keys, key_n, shape_chosen, shape_way, shape_value, shape_n, present|:
                value: mutable i64 = 0
                step: mutable i64 = 0
                while step < families |step, families, combo, way, keys, key_n, shape_chosen, shape_way, shape_n, value|:
                    divisor: mutable i64 = 1
                    back: mutable i64 = step + 1
                    while back < families |back, families, key_n, divisor|:
                        divisor <- divisor * Ints::at(key_n, back)
                        back <- back + 1
                    digit: i64 = (combo / divisor) % Ints::at(key_n, step)
                    here: i64 = Ints::at(keys, step * 3 + digit)
                    Ints::put(&shape_chosen, shape_n * 4 + step, here)
                    if step == 0:
                        value <- here
                    else:
                        op_divisor: mutable i64 = 1
                        over: mutable i64 = step
                        while over < families - 1 |over, families, op_divisor|:
                            op_divisor <- op_divisor * 3
                            over <- over + 1
                        op: i64 = (way / op_divisor) % 3
                        Ints::put(&shape_way, shape_n * 4 + step - 1, op)
                        value <- sy_kleene(op, value, here)
                    step <- step + 1
                Ints::put(&shape_value, shape_n, value)
                Ints::put(&present, value, 1)
                shape_n <- shape_n + 1
                way <- way + 1
            combo <- combo + 1
        if shape_n == 0:
            return false
        want: i64 = py_randrange(rng, 0, 3)
        # `order` is the truth values present, in (False, True, None) order;
        # `want` is an OPTION index (true, false, cannot be told), so the two
        # orderings have to be kept apart.
        order: mutable darray[i64] = Ints::zeros(4)
        order_n: mutable i64 = 0
        rank: mutable i64 = 0
        while rank < 3 |rank, present, order, order_n|:
            value: i64 = sy_truth_of_rank(rank)
            if Ints::at(present, value) == 1:
                Ints::put(&order, order_n, value)
                order_n <- order_n + 1
            rank <- rank + 1
        wanted_value: i64 = SY_TRUE if want == 0 else (SY_FALSE if want == 1 else SY_UNSETTLED)
        value: mutable i64 = -1
        seek: mutable i64 = 0
        while seek < order_n |seek, order_n, order, wanted_value, value|:
            value <- Ints::at(order, seek) if Ints::at(order, seek) == wanted_value and value < 0
            seek <- seek + 1
        value <- Ints::at(order, py_choice_index(rng, order_n)) if value < 0
        sy_dress_binary(rng, g, parts, families, shape_chosen, shape_way, shape_value, shape_n, value, q)
        return true

# The one-line reader's answer to the whole thing: it reads each claim off a
# single premise and then combines them CORRECTLY, so what this measures is
# whether the composing is where the difficulty is, rather than whether the
# reader can compose at all.
def sy_binary_surface(parts: mutable darray[SyPart]&, families: i64, claims: darray[i64], way: darray[i64], way_base: i64) -> i64:
    can Abort.Panic:
        got: mutable i64 = 0
        step: mutable i64 = 0
        while step < families |step, families, parts, claims, way, way_base, got|:
            slot: i64 = Ints::at(claims, step)
            subject: i64 = Ints::at_ref(&parts[step.usize()].found.subject, Ints::at_ref(&parts[step.usize()].claim_pair, slot))
            read: i64 = sy_surface(&parts[step.usize()].web, parts[step.usize()].order, subject)
            untold: i64 = sy_untold_label(parts[step.usize()].web.grade.family)
            here: i64 = SY_UNSETTLED if read == untold else (SY_TRUE if read == Ints::at_ref(&parts[step.usize()].claim_label, slot) else SY_FALSE)
            if step == 0:
                got <- here
            else:
                got <- sy_kleene(Ints::at(way, way_base + step - 1), got, here)
            step <- step + 1
        return got

def sy_append_op(out: mutable dstr&, op: i64, left: dstr, right: dstr):
    can Memory.Allocate, Abort.Panic:
        if op == SY_EXACTLY_ONE:
            dstr_append_cstr(out, "exactly one of (")
            dstr_append_dstr(out, left)
            dstr_append_cstr(out, ") and (")
            dstr_append_dstr(out, right)
            dstr_append_cstr(out, ")")
            return
        dstr_append_cstr(out, "(")
        dstr_append_dstr(out, left)
        dstr_append_cstr(out, ") ")
        dstr_append_cstr(out, "and" if op == SY_AND else "or")
        dstr_append_cstr(out, " (")
        dstr_append_dstr(out, right)
        dstr_append_cstr(out, ")")

def sy_truth_text(value: i64) -> dstr:
    can Memory.Allocate, Abort.Panic:
        out: mutable dstr = []
        dstr_append_cstr(&out, "true" if value == SY_TRUE else ("false" if value == SY_FALSE else "cannot be told"))
        return out

# The claims picked, the premises shuffled together, the sum measured.
#
# THE CONNECTIVES ARE CHOSEN ALONG WITH THE CLAIMS, not before them, because
# they decide whether a misreading matters at all: an `or` with one true half
# is true however badly the other half is read, so the one-line reader gets the
# whole thing right by being wrong in a place that could not count.
def sy_dress_binary(rng: mutable MT19937&, g: SyGrade, parts: mutable darray[SyPart]&, families: i64, shape_chosen: darray[i64], shape_way: darray[i64], shape_value: darray[i64], shape_n: i64, value: i64, q: mutable SyQuestion&):
    can Memory.Allocate, Abort.Panic:
        sy_question_reset(q)
        q.found <- true
        q.family <- SY_BINARY
        # Each sub-question's premises are rendered into its own order first,
        # then the whole lot is shuffled together.
        said_start: mutable darray[i64] = Ints::zeros(4 * SY_MOST_EDGES)
        said_len: mutable darray[i64] = Ints::zeros(4 * SY_MOST_EDGES)
        line_start: mutable darray[i64] = Ints::zeros(SY_MOST_LINES)
        line_len: mutable darray[i64] = Ints::zeros(SY_MOST_LINES)
        lines: mutable i64 = 0
        part: mutable i64 = 0
        while part < families |part, families, parts, rng, q, said_start, said_len, line_start, line_len, lines|:
            edges: i64 = parts[part.usize()].web.edges
            fill: mutable i64 = 0
            while fill < edges |fill, edges, part, parts|:
                Ints::put(&parts[part.usize()].order, fill, fill)
                fill <- fill + 1
            py_shuffle_i64_prefix(rng, &parts[part.usize()].order, edges)
            write: mutable i64 = 0
            while write < edges |write, edges, part, parts, rng, q, said_start, said_len|:
                number: i64 = Ints::at_ref(&parts[part.usize()].order, write)
                text: dstr = sy_render(&parts[part.usize()].web, number, &parts[part.usize()].names, rng)
                Ints::put(&said_start, part * SY_MOST_EDGES + number, sy_take_text(q, text))
                Ints::put(&said_len, part * SY_MOST_EDGES + number, text.count.i64())
                write <- write + 1
            place: mutable i64 = 0
            while place < edges |place, edges, part, parts, said_start, said_len, line_start, line_len, lines|:
                number: i64 = Ints::at_ref(&parts[part.usize()].order, place)
                Ints::put(&line_start, lines, Ints::at(said_start, part * SY_MOST_EDGES + number))
                Ints::put(&line_len, lines, Ints::at(said_len, part * SY_MOST_EDGES + number))
                lines <- lines + 1
                place <- place + 1
            part <- part + 1
        agree: bool = sy_agreeable(rng, SY_BINARY, 3, sy_binary_option(value))
        # The shapes with this value, in the order they were built.
        keep: mutable darray[i64] = Ints::zeros(SY_MOST_SHAPES)
        keep_n: mutable i64 = 0
        scan: mutable i64 = 0
        while scan < shape_n |scan, shape_n, shape_value, value, keep, keep_n|:
            if Ints::at(shape_value, scan) == value:
                Ints::put(&keep, keep_n, scan)
                keep_n <- keep_n + 1
            scan <- scan + 1
        claims: mutable darray[i64] = Ints::zeros(4)
        best_shape: mutable i64 = -1
        best_claims: mutable darray[i64] = Ints::zeros(4)
        attempt: mutable i64 = 0
        while attempt < 40 |attempt, keep, keep_n, rng, parts, families, shape_chosen, shape_way, claims, best_shape, best_claims, value, agree|:
            shape: i64 = Ints::at(keep, py_choice_index(rng, keep_n))
            step: mutable i64 = 0
            while step < families |step, families, shape, shape_chosen, parts, rng, claims|:
                wanted: i64 = Ints::at(shape_chosen, shape * 4 + step)
                # The claims of this part with that truth value, in order.
                room: mutable darray[i64] = Ints::zeros(SY_MOST_CLAIMS)
                room_n: mutable i64 = 0
                pick: mutable i64 = 0
                while pick < parts[step.usize()].claim_count |pick, step, parts, wanted, room, room_n|:
                    if Ints::at_ref(&parts[step.usize()].claim_value, pick) == wanted:
                        Ints::put(&room, room_n, pick)
                        room_n <- room_n + 1
                    pick <- pick + 1
                Ints::put(&claims, step, Ints::at(room, py_choice_index(rng, room_n)))
                step <- step + 1
            if best_shape < 0:
                best_shape <- shape
                sy_copy_order(&best_claims, claims, families)
            if (sy_binary_surface(parts, families, claims, shape_way, shape * 4) == value) == agree:
                best_shape <- shape
                sy_copy_order(&best_claims, claims, families)
                attempt <- 40
            attempt <- attempt + 1
        # Shuffled ACROSS the sub-questions as well as inside them: which
        # premises talk to each other is part of the question.
        together: mutable darray[i64] = Ints::zeros(SY_MOST_LINES)
        fill: mutable i64 = 0
        while fill < lines |fill, lines, together|:
            Ints::put(&together, fill, fill)
            fill <- fill + 1
        py_shuffle_i64_prefix(rng, &together, lines)
        shown: mutable i64 = 0
        while shown < lines |shown, lines, together, line_start, line_len, q|:
            at: i64 = Ints::at(together, shown)
            slot: i64 = q.line_count
            Ints::put(&q.lines, slot * 2, Ints::at(line_start, at))
            Ints::put(&q.lines, slot * 2 + 1, Ints::at(line_len, at))
            q.line_count <- slot + 1
            shown <- shown + 1
        sentences: mutable darray[i64] = Ints::zeros(8)
        asked: mutable dstr = []
        steps: mutable i64 = 0
        held: mutable dstr = []
        step: mutable i64 = 0
        while step < families |step, families, parts, best_claims, best_shape, shape_chosen, shape_way, said_start, said_len, q, steps, held|:
            slot: i64 = Ints::at(best_claims, step)
            pair: i64 = Ints::at_ref(&parts[step.usize()].claim_pair, slot)
            claim: i64 = Ints::at_ref(&parts[step.usize()].claim_label, slot)
            subject: i64 = Ints::at_ref(&parts[step.usize()].found.subject, pair)
            other: i64 = Ints::at_ref(&parts[step.usize()].found.other, pair)
            sentence: dstr = sy_conclusion(parts[step.usize()].web.grade.family, sy_name(&parts[step.usize()].names, subject), sy_name(&parts[step.usize()].names, other), claim)
            path_len: i64 = Ints::at_ref(&parts[step.usize()].found.path_len, pair)
            walk: mutable i64 = 0
            while walk < path_len |walk, path_len, pair, step, parts, said_start, said_len, q|:
                number: i64 = Ints::at_ref(&parts[step.usize()].found.path, pair * SY_MOST_EDGES + walk)
                slot_out: i64 = q.working_count
                Ints::put(&q.working, slot_out * 2, Ints::at(said_start, step * SY_MOST_EDGES + number))
                Ints::put(&q.working, slot_out * 2 + 1, Ints::at(said_len, step * SY_MOST_EDGES + number))
                q.working_count <- slot_out + 1
                walk <- walk + 1
            note: mutable dstr = []
            dstr_append_cstr(&note, "so \"")
            dstr_append_dstr(&note, sentence)
            dstr_append_cstr(&note, "\" is ")
            dstr_append_dstr(&note, sy_truth_text(Ints::at(shape_chosen, best_shape * 4 + step)))
            sy_add_working(q, note)
            steps <- steps + (path_len if path_len > 0 else parts[step.usize()].web.edges)
            if step == 0:
                held <- sentence
            else:
                joined: mutable dstr = []
                sy_append_op(&joined, Ints::at(shape_way, best_shape * 4 + step - 1), held, sentence)
                held <- joined
            step <- step + 1
        dstr_append_cstr(&asked, "Is this true?  ")
        dstr_append_dstr(&asked, held)
        sy_set_asked(q, asked)
        steps <- steps + families - 1
        option: mutable i64 = 0
        while option < 3 |option, q|:
            sy_add_option(q, sy_option_text(SY_BINARY, option))
            option <- option + 1
        closing: mutable dstr = []
        dstr_append_cstr(&closing, "so the whole of it is ")
        dstr_append_dstr(&closing, sy_truth_text(value))
        sy_add_working(q, closing)
        q.answer <- sy_binary_option(value)
        q.surface <- sy_binary_option(sy_binary_surface(parts, families, best_claims, shape_way, best_shape * 4))
        q.steps <- steps
        q.decoys <- q.line_count - steps if q.line_count > steps else 0

# The option index for a truth value: true, false, cannot be told.
def sy_binary_option(value: i64) -> i64:
    can Abort.Panic:
        if value == SY_TRUE:
            return 0
        if value == SY_FALSE:
            return 1
        return 2

# --- read back off the page ---
#
# A generator that checks itself proves only that it is consistent. So the
# printed lines are parsed back into relations by something that never saw the
# web, and solved again. This catches what a self-check cannot: a negation
# rendered the wrong way round, a direction written in a frame that says
# something else, a premise the shuffle dropped.
#
# The reference does it with regular expressions; here it is a scanner over the
# same six frames, in the same order, because a frame that matches earlier wins.

struct SyScan:
    text: mutable sview
    at: mutable i64
    ok: mutable bool

def SyScan(text: sview) -> SyScan:
    can Abort.Panic:
        out: mutable SyScan = zeroed
        out.text <- text
        out.ok <- true
        return out

def sy_scan_done(scan: SyScan&) -> bool:
    can Abort.Panic:
        return scan.at >= sview_len(scan.text).i64()

# `\w+` -- letters, digits and underscore, which for these names is letters.
def sy_is_word_byte(byte: u8) -> bool:
    can Abort.Panic:
        code: i64 = byte.i64()
        return (code >= 97 and code <= 122) or (code >= 65 and code <= 90) or (code >= 48 and code <= 57) or code == 95

def sy_take_word(scan: mutable SyScan&) -> sview:
    can Abort.Panic:
        start: i64 = scan.at
        while not sy_scan_done(scan) and sy_is_word_byte(sview_at(scan.text, scan.at.usize())) |scan|:
            scan.at <- scan.at + 1
        if scan.at == start:
            scan.ok <- false
        return string_view_slice(scan.text, start, scan.at)

def sy_take_literal(scan: mutable SyScan&, word: cstr) -> bool:
    can Abort.Panic:
        wanted: sview = sview(word, 0, -1)
        length: i64 = sview_len(wanted).i64()
        if scan.at + length > sview_len(scan.text).i64():
            return false
        index: mutable i64 = 0
        same: mutable bool = true
        while index < length and same |index, length, wanted, scan, same|:
            same <- false if sview_at(scan.text, (scan.at + index).usize()) != sview_at(wanted, index.usize())
            index <- index + 1
        if same:
            scan.at <- scan.at + length
        return same

# The parsed premise. `family` is -1 when the line did not read back at all.
struct SyParsed:
    family: mutable i64
    left: mutable i64
    right: mutable i64
    value0: mutable i64
    value1: mutable i64
    value2: mutable i64
    axes: mutable i64
    form: mutable i64

# Names are interned as they are met, so a re-read works with indices while
# knowing nothing but what is printed.
def sy_intern(table: mutable SyNames&, word: sview) -> i64:
    can Abort.Panic:
        index: mutable i64 = 0
        while index < table.count |index, table, word|:
            if sview_eq(sy_name(table, index), word):
                return index
            index <- index + 1
        sy_names_push(table, word)
        return table.count - 1

# `north`/`south`/`east`/`west`/`above`/`below` to (axis, sign), or axis -1.
def sy_word_axis(word: sview) -> i64:
    can Abort.Panic:
        if sview_eq(word, sview("north", 0, -1)):
            return 0
        if sview_eq(word, sview("south", 0, -1)):
            return 1
        if sview_eq(word, sview("east", 0, -1)):
            return 2
        if sview_eq(word, sview("west", 0, -1)):
            return 3
        if sview_eq(word, sview("above", 0, -1)):
            return 4
        if sview_eq(word, sview("below", 0, -1)):
            return 5
        return -1

# One printed premise, back into what it says. The value is what the WORDS
# mean, not what built them, so a negation written wrongly reads back wrongly.
def sy_parse_line(text: sview, table: mutable SyNames&) -> SyParsed:
    can Memory.Allocate, Abort.Panic:
        out: mutable SyParsed = zeroed
        out.family <- -1
        # ORDER: `X is (not )?(more|less) than Y`
        scan: mutable SyScan = SyScan(text)
        left: sview = sy_take_word(&scan)
        if scan.ok and sy_take_literal(&scan, " is "):
            negated: bool = sy_take_literal(&scan, "not ")
            more_word: mutable bool = false
            less_word: mutable bool = false
            more_word <- sy_take_literal(&scan, "more than ")
            less_word <- sy_take_literal(&scan, "less than ") if not more_word
            if more_word or less_word:
                right: sview = sy_take_word(&scan)
                if scan.ok and sy_scan_done(&scan):
                    more: bool = more_word != negated
                    out.family <- SY_ORDER
                    out.value0 <- 1
                    out.axes <- 1
                    if more:
                        out.left <- sy_intern(table, right)
                        out.right <- sy_intern(table, left)
                    else:
                        out.left <- sy_intern(table, left)
                        out.right <- sy_intern(table, right)
                    return out
        # PARITY: `X is (not )?the (same as|opposite of) Y`
        scan <- SyScan(text)
        left2: sview = sy_take_word(&scan)
        if scan.ok and sy_take_literal(&scan, " is "):
            negated: bool = sy_take_literal(&scan, "not ")
            if sy_take_literal(&scan, "the "):
                same_word: mutable bool = sy_take_literal(&scan, "same as ")
                opposite_word: mutable bool = false
                opposite_word <- sy_take_literal(&scan, "opposite of ") if not same_word
                if same_word or opposite_word:
                    right: sview = sy_take_word(&scan)
                    if scan.ok and sy_scan_done(&scan):
                        same: bool = same_word != negated
                        out.family <- SY_PARITY
                        out.left <- sy_intern(table, left2)
                        out.right <- sy_intern(table, right)
                        out.value0 <- 0 if same else 1
                        out.axes <- 1
                        return out
        # STILL: `X is in the same place as Y` -- never a premise (a step is a
        # step) but a claim can say it.
        scan <- SyScan(text)
        right3: sview = sy_take_word(&scan)
        if scan.ok and sy_take_literal(&scan, " is in the same place as "):
            left3: sview = sy_take_word(&scan)
            if scan.ok and sy_scan_done(&scan):
                out.family <- SY_PLANE
                out.left <- sy_intern(table, left3)
                out.right <- sy_intern(table, right3)
                out.axes <- 2
                return out
        # FLAT: `X is ((above|below) and )?to the <flat> of Y`
        scan <- SyScan(text)
        right4: sview = sy_take_word(&scan)
        if scan.ok and sy_take_literal(&scan, " is "):
            up_axis: mutable i64 = -1
            if sy_take_literal(&scan, "above and "):
                up_axis <- 4
            else:
                up_axis <- 5 if sy_take_literal(&scan, "below and ") else -1
            if sy_take_literal(&scan, "to the "):
                first: sview = sy_take_word(&scan)
                second: mutable sview = first
                have_second: mutable bool = false
                if scan.ok and sy_take_literal(&scan, " and "):
                    second <- sy_take_word(&scan)
                    have_second <- true
                if scan.ok and sy_take_literal(&scan, " of "):
                    left4: sview = sy_take_word(&scan)
                    if scan.ok and sy_scan_done(&scan):
                        return sy_direction_parsed(table, left4, right4, sy_word_axis(first), sy_word_axis(second) if have_second else -1, up_axis)
        # UPRIGHT: `X is (above|below) Y`
        scan <- SyScan(text)
        right5: sview = sy_take_word(&scan)
        if scan.ok and sy_take_literal(&scan, " is "):
            only: mutable i64 = -1
            if sy_take_literal(&scan, "above "):
                only <- 4
            else:
                only <- 5 if sy_take_literal(&scan, "below ") else -1
            if only >= 0:
                left5: sview = sy_take_word(&scan)
                if scan.ok and sy_scan_done(&scan):
                    return sy_direction_parsed(table, left5, right5, -1, -1, only)
        # FORM: `(every|no|at least one) X is (not )?an? Y`
        scan <- SyScan(text)
        form: mutable i64 = -1
        if sy_take_literal(&scan, "every "):
            form <- SY_ALL
        if form < 0 and sy_take_literal(&scan, "no "):
            form <- SY_NONE
        if form < 0 and sy_take_literal(&scan, "at least one "):
            form <- SY_SOME
        if form >= 0:
            subject: sview = sy_take_word(&scan)
            if scan.ok and sy_take_literal(&scan, " is "):
                negated: bool = sy_take_literal(&scan, "not ")
                if sy_take_literal(&scan, "an ") or sy_take_literal(&scan, "a "):
                    predicate: sview = sy_take_word(&scan)
                    if scan.ok and sy_scan_done(&scan):
                        out.family <- SY_CATEGORICAL
                        out.left <- sy_intern(table, subject)
                        out.right <- sy_intern(table, predicate)
                        out.form <- SY_SOME_NOT if form == SY_SOME and negated else form
                        return out
        return out

# The direction frames all end here: the words that were read become a value,
# and the axis count is 3 only when something upright was said.
def sy_direction_parsed(table: mutable SyNames&, left: sview, right: sview, first_axis: i64, second_axis: i64, up_axis: i64) -> SyParsed:
    can Abort.Panic:
        out: mutable SyParsed = zeroed
        out.family <- -1
        value: mutable darray[i64] = Ints::zeros(3)
        axes: mutable i64 = 2
        slot: mutable i64 = 0
        while slot < 3 |slot, first_axis, second_axis, up_axis, value, axes, out|:
            word: i64 = first_axis if slot == 0 else (second_axis if slot == 1 else up_axis)
            if word >= 0:
                axis: i64 = word / 2
                sign: i64 = 1 if word % 2 == 0 else -1
                Ints::put(&value, axis, sign)
                axes <- axis + 1 if axis + 1 > axes else axes
            slot <- slot + 1
        if up_axis >= 0:
            axes <- 3
        out.family <- SY_PLANE if axes == 2 else SY_SPACE
        out.left <- sy_intern(table, left)
        out.right <- sy_intern(table, right)
        out.value0 <- Ints::at(value, 0)
        out.value1 <- Ints::at(value, 1)
        out.value2 <- Ints::at(value, 2)
        out.axes <- axes
        return out

# The parsed premises, grouped by which question they belong to. A direction
# premise with nothing vertical in it reads as FLAT whether it came from a flat
# question or an upright one, so the directions are banked together and padded
# to the widest of them.
struct SyBank:
    family: mutable darray[i64]
    left: mutable darray[i64]
    right: mutable darray[i64]
    value0: mutable darray[i64]
    value1: mutable darray[i64]
    value2: mutable darray[i64]
    count: mutable i64
    axes: mutable i64
    # Which families are present, and how many edges each has.
    present: mutable darray[i64]

def SyBank() -> SyBank:
    can Memory.Allocate, Abort.Panic:
        out: mutable SyBank = zeroed
        out.family <- Ints::zeros(SY_MOST_LINES)
        out.left <- Ints::zeros(SY_MOST_LINES)
        out.right <- Ints::zeros(SY_MOST_LINES)
        out.value0 <- Ints::zeros(SY_MOST_LINES)
        out.value1 <- Ints::zeros(SY_MOST_LINES)
        out.value2 <- Ints::zeros(SY_MOST_LINES)
        out.present <- Ints::zeros(8)
        return out

def sy_bank(parsed: darray[i64], count: i64, bank: mutable SyBank&):
    can Abort.Panic:
        # parsed is a flat run of SyParsed fields, eight per line.
        widest: mutable i64 = 0
        at: mutable i64 = 0
        while at < count |at, count, parsed, widest|:
            family: i64 = Ints::at(parsed, at * 8)
            if family == SY_PLANE or family == SY_SPACE:
                axes: i64 = Ints::at(parsed, at * 8 + 6)
                widest <- axes if axes > widest else widest
            at <- at + 1
        bank.axes <- widest
        bank.count <- 0
        slot: mutable i64 = 0
        while slot < 8 |slot, bank|:
            Ints::put(&bank.present, slot, 0)
            slot <- slot + 1
        line: mutable i64 = 0
        while line < count |line, count, parsed, widest, bank|:
            family: mutable i64 = Ints::at(parsed, line * 8)
            if family == SY_PLANE or family == SY_SPACE:
                family <- SY_PLANE if widest == 2 else SY_SPACE
            here: i64 = bank.count
            Ints::put(&bank.family, here, family)
            Ints::put(&bank.left, here, Ints::at(parsed, line * 8 + 1))
            Ints::put(&bank.right, here, Ints::at(parsed, line * 8 + 2))
            Ints::put(&bank.value0, here, Ints::at(parsed, line * 8 + 3))
            Ints::put(&bank.value1, here, Ints::at(parsed, line * 8 + 4))
            Ints::put(&bank.value2, here, Ints::at(parsed, line * 8 + 5))
            # The categorical form rides in value0 for that family.
            Ints::put(&bank.value0, here, Ints::at(parsed, line * 8 + 7)) if family == SY_CATEGORICAL
            Ints::put(&bank.present, family, Ints::at_ref(&bank.present, family) + 1)
            bank.count <- here + 1
            line <- line + 1

def sy_bank_families(bank: SyBank&) -> i64:
    can Abort.Panic:
        count: mutable i64 = 0
        family: mutable i64 = 0
        while family < 8 |family, bank, count|:
            count <- count + 1 if Ints::at(bank.present, family) > 0
            family <- family + 1
        return count

# Solve the parsed premises without ever having seen the web. Returns a label
# in the family's option space, or SY_UNTOLD.
def sy_reread(bank: SyBank&, family: i64, subject: i64, other: i64, names: i64) -> i64:
    can Memory.Allocate, Abort.Panic:
        if family == SY_ORDER:
            # `more` walks low-to-high from `other`; `less` the other way.
            want: mutable i64 = 0
            while want < 2 |want, bank, family, subject, other, names|:
                start: i64 = other if want == 0 else subject
                goal: i64 = subject if want == 0 else other
                if sy_order_reaches(bank, start, goal, names):
                    return want
                want <- want + 1
            return SY_UNTOLD
        seen: mutable darray[i64] = Ints::zeros(SY_MOST_NAMES)
        got0: mutable darray[i64] = Ints::zeros(SY_MOST_NAMES)
        got1: mutable darray[i64] = Ints::zeros(SY_MOST_NAMES)
        got2: mutable darray[i64] = Ints::zeros(SY_MOST_NAMES)
        frontier: mutable darray[i64] = Ints::zeros(SY_MOST_NAMES)
        next_frontier: mutable darray[i64] = Ints::zeros(SY_MOST_NAMES)
        Ints::put(&seen, other, 1)
        Ints::put(&frontier, 0, other)
        frontier_n: mutable i64 = 1
        while frontier_n > 0 |frontier_n, bank, family, seen, got0, got1, got2, frontier, next_frontier|:
            next_n: mutable i64 = 0
            at: mutable i64 = 0
            while at < frontier_n |at, frontier_n, bank, family, seen, got0, got1, got2, frontier, next_frontier, next_n|:
                node: i64 = Ints::at(frontier, at)
                edge: mutable i64 = 0
                while edge < bank.count |edge, bank, family, node, seen, got0, got1, got2, next_frontier, next_n|:
                    if Ints::at(bank.family, edge) == family:
                        side: mutable i64 = 0
                        while side < 2 |side, edge, bank, node, seen, got0, got1, got2, next_frontier, next_n|:
                            near: i64 = Ints::at(bank.left, edge) if side == 0 else Ints::at(bank.right, edge)
                            far: i64 = Ints::at(bank.right, edge) if side == 0 else Ints::at(bank.left, edge)
                            way: i64 = 1 if side == 0 else -1
                            if near == node and Ints::at(seen, far) == 0:
                                Ints::put(&got0, far, Ints::at(got0, node) + way * Ints::at(bank.value0, edge))
                                Ints::put(&got1, far, Ints::at(got1, node) + way * Ints::at(bank.value1, edge))
                                Ints::put(&got2, far, Ints::at(got2, node) + way * Ints::at(bank.value2, edge))
                                Ints::put(&seen, far, 1)
                                Ints::put(&next_frontier, next_n, far)
                                next_n <- next_n + 1
                            side <- side + 1
                    edge <- edge + 1
                at <- at + 1
            shift: mutable i64 = 0
            while shift < next_n |shift, next_n, next_frontier, frontier|:
                Ints::put(&frontier, shift, Ints::at(next_frontier, shift))
                shift <- shift + 1
            frontier_n <- next_n
        if Ints::at(seen, subject) == 0:
            return SY_UNTOLD
        if family == SY_PARITY:
            apart: i64 = Ints::at(got0, subject) % 2
            return 1 if apart != 0 else 0
        axes: i64 = sy_axes(family)
        return sy_direction_index(Ints::at(got0, subject), Ints::at(got1, subject), Ints::at(got2, subject), axes)

def sy_order_reaches(bank: SyBank&, start: i64, goal: i64, names: i64) -> bool:
    can Memory.Allocate, Abort.Panic:
        seen: mutable darray[i64] = Ints::zeros(SY_MOST_NAMES)
        frontier: mutable darray[i64] = Ints::zeros(SY_MOST_NAMES)
        next_frontier: mutable darray[i64] = Ints::zeros(SY_MOST_NAMES)
        Ints::put(&seen, start, 1)
        Ints::put(&frontier, 0, start)
        frontier_n: mutable i64 = 1
        found: mutable bool = false
        while frontier_n > 0 and not found |frontier_n, bank, goal, seen, frontier, next_frontier, found|:
            next_n: mutable i64 = 0
            at: mutable i64 = 0
            while at < frontier_n and not found |at, frontier_n, bank, goal, seen, frontier, next_frontier, next_n, found|:
                node: i64 = Ints::at(frontier, at)
                edge: mutable i64 = 0
                while edge < bank.count and not found |edge, bank, node, goal, seen, next_frontier, next_n, found|:
                    if Ints::at(bank.family, edge) == SY_ORDER and Ints::at(bank.left, edge) == node:
                        high: i64 = Ints::at(bank.right, edge)
                        if Ints::at(seen, high) == 0:
                            if high == goal:
                                found <- true
                            else:
                                Ints::put(&seen, high, 1)
                                Ints::put(&next_frontier, next_n, high)
                                next_n <- next_n + 1
                    edge <- edge + 1
                at <- at + 1
            shift: mutable i64 = 0
            while shift < next_n |shift, next_n, next_frontier, frontier|:
                Ints::put(&frontier, shift, Ints::at(next_frontier, shift))
                shift <- shift + 1
            frontier_n <- next_n
        return found

# A bracketed piece off the front of `text`, and what is left.
def sy_take_group(text: sview, rest_start: mutable i64&) -> sview:
    can Abort.Panic:
        length: i64 = sview_len(text).i64()
        if length == 0 or sview_at(text, 0.usize()) != 40.u8():
            rest_start <- length
            return text
        depth: mutable i64 = 0
        spot: mutable i64 = 0
        close: mutable i64 = -1
        while spot < length and close < 0 |spot, length, text, depth, close|:
            byte: u8 = sview_at(text, spot.usize())
            depth <- depth + 1 if byte == 40.u8()
            depth <- depth - 1 if byte == 41.u8()
            close <- spot if depth == 0
            spot <- spot + 1
        if close < 0:
            rest_start <- length
            return text
        rest_start <- close + 1
        return string_view_slice(text, 1, close)

# The printed question of a made-of-others rung, back into a tree. Nodes live
# in flat arrays: `op` is -1 for a leaf, whose text is the (start, length) pair.
const SY_MOST_TREE: i64 = 32

struct SyTree:
    op: mutable darray[i64]
    left: mutable darray[i64]
    right: mutable darray[i64]
    start: mutable darray[i64]
    length: mutable darray[i64]
    count: mutable i64
    ok: mutable bool

def SyTree() -> SyTree:
    can Memory.Allocate, Abort.Panic:
        out: mutable SyTree = zeroed
        out.op <- Ints::zeros(SY_MOST_TREE)
        out.left <- Ints::zeros(SY_MOST_TREE)
        out.right <- Ints::zeros(SY_MOST_TREE)
        out.start <- Ints::zeros(SY_MOST_TREE)
        out.length <- Ints::zeros(SY_MOST_TREE)
        return out

def sy_read_claim(whole: sview, start: i64, length: i64, tree: mutable SyTree&) -> i64:
    can Memory.Allocate, Abort.Panic:
        text: mutable sview = string_view_slice(whole, start, start + length)
        # `.strip()` -- only spaces occur here.
        low: mutable i64 = 0
        high: mutable i64 = sview_len(text).i64()
        while low < high and sview_at(text, low.usize()) == 32.u8() |low, high, text|:
            low <- low + 1
        while high > low and sview_at(text, (high - 1).usize()) == 32.u8() |low, high, text|:
            high <- high - 1
        text <- string_view_slice(text, low, high)
        base: i64 = start + low
        size: i64 = high - low
        if sview_starts_with(text, sview("exactly one of ", 0, -1)):
            after: i64 = 15
            rest_at: mutable i64 = 0
            left_view: sview = sy_take_group(string_view_slice(text, after, size), &rest_at)
            rest: sview = string_view_slice(text, after + rest_at, size)
            if not sview_starts_with(rest, sview(" and ", 0, -1)):
                tree.ok <- false
                return -1
            more_at: mutable i64 = 0
            right_view: sview = sy_take_group(string_view_slice(rest, 5, sview_len(rest).i64()), &more_at)
            left_node: i64 = sy_read_claim(whole, base + after + 1, sview_len(left_view).i64(), tree)
            right_node: i64 = sy_read_claim(whole, base + after + rest_at + 5 + 1, sview_len(right_view).i64(), tree)
            return sy_tree_push(tree, SY_EXACTLY_ONE, left_node, right_node, 0, 0)
        if size > 0 and sview_at(text, 0.usize()) == 40.u8():
            rest_at: mutable i64 = 0
            left_view: sview = sy_take_group(text, &rest_at)
            rest: sview = string_view_slice(text, rest_at, size)
            word: mutable i64 = -1
            width: mutable i64 = 0
            if sview_starts_with(rest, sview(" and ", 0, -1)):
                word <- SY_AND
                width <- 5
            if word < 0 and sview_starts_with(rest, sview(" or ", 0, -1)):
                word <- SY_OR
                width <- 4
            if word >= 0:
                more_at: mutable i64 = 0
                right_view: sview = sy_take_group(string_view_slice(rest, width, size - rest_at), &more_at)
                left_node: i64 = sy_read_claim(whole, base + 1, sview_len(left_view).i64(), tree)
                right_node: i64 = sy_read_claim(whole, base + rest_at + width + 1, sview_len(right_view).i64(), tree)
                return sy_tree_push(tree, word, left_node, right_node, 0, 0)
            return sy_read_claim(whole, base + 1, sview_len(left_view).i64(), tree)
        return sy_tree_push(tree, -1, 0, 0, base, size)

def sy_tree_push(tree: mutable SyTree&, op: i64, left: i64, right: i64, start: i64, length: i64) -> i64:
    can Abort.Panic:
        slot: i64 = tree.count
        if slot >= SY_MOST_TREE:
            tree.ok <- false
            return -1
        Ints::put(&tree.op, slot, op)
        Ints::put(&tree.left, slot, left)
        Ints::put(&tree.right, slot, right)
        Ints::put(&tree.start, slot, start)
        Ints::put(&tree.length, slot, length)
        tree.count <- slot + 1
        return slot

# Whether a claim sentence is true of the premises, or unsettled.
def sy_holds(bank: SyBank&, parsed: SyParsed, names: i64, ok: mutable bool&) -> i64:
    can Memory.Allocate, Abort.Panic:
        family: mutable i64 = parsed.family
        subject: mutable i64 = 0
        other: mutable i64 = 0
        said: mutable i64 = 0
        if family == SY_PLANE or family == SY_SPACE:
            family <- SY_PLANE if Ints::at(bank.present, SY_PLANE) > 0 else SY_SPACE
            if Ints::at(bank.present, family) == 0:
                return SY_UNSETTLED
            said <- sy_direction_index(parsed.value0, parsed.value1, parsed.value2, sy_axes(family))
            subject <- parsed.right
            other <- parsed.left
        else:
            if family == SY_ORDER:
                if Ints::at(bank.present, SY_ORDER) == 0:
                    return SY_UNSETTLED
                said <- 0
                subject <- parsed.right
                other <- parsed.left
            else:
                if Ints::at(bank.present, SY_PARITY) == 0:
                    return SY_UNSETTLED
                said <- 0 if parsed.value0 == 0 else 1
                subject <- parsed.left
                other <- parsed.right
        got: i64 = sy_reread(bank, family, subject, other, names)
        if got == SY_UNTOLD:
            return SY_UNSETTLED
        return SY_TRUE if got == said else SY_FALSE

def sy_value_of(whole: sview, tree: SyTree&, node: i64, bank: SyBank&, table: mutable SyNames&, ok: mutable bool&) -> i64:
    can Memory.Allocate, Abort.Panic:
        if node < 0:
            ok <- false
            return SY_UNSETTLED
        op: i64 = Ints::at(tree.op, node)
        if op < 0:
            text: sview = string_view_slice(whole, Ints::at(tree.start, node), Ints::at(tree.start, node) + Ints::at(tree.length, node))
            parsed: SyParsed = sy_parse_line(text, table)
            if parsed.family < 0:
                ok <- false
                return SY_UNSETTLED
            return sy_holds(bank, parsed, table.count, ok)
        left: i64 = sy_value_of(whole, tree, Ints::at(tree.left, node), bank, table, ok)
        right: i64 = sy_value_of(whole, tree, Ints::at(tree.right, node), bank, table, ok)
        return sy_kleene(op, left, right)

# The answer, worked out again from the printed page alone. Returns -2 where
# the page cannot be read back at all, which is a FAULT rather than a wrong
# answer, and is why `checks_out` treats it as one.
def sy_read_back(q: SyQuestion&, family: i64, bank: mutable SyBank&, table: mutable SyNames&) -> i64:
    can Memory.Allocate, Abort.Panic:
        sy_names_reset(table)
        parsed: mutable darray[i64] = Ints::zeros(SY_MOST_LINES * 8)
        line: mutable i64 = 0
        while line < q.line_count |line, q, table, parsed|:
            got: SyParsed = sy_parse_line(sy_line(q, line), table)
            if got.family < 0:
                return -2
            Ints::put(&parsed, line * 8, got.family)
            Ints::put(&parsed, line * 8 + 1, got.left)
            Ints::put(&parsed, line * 8 + 2, got.right)
            Ints::put(&parsed, line * 8 + 3, got.value0)
            Ints::put(&parsed, line * 8 + 4, got.value1)
            Ints::put(&parsed, line * 8 + 5, got.value2)
            Ints::put(&parsed, line * 8 + 6, got.axes)
            Ints::put(&parsed, line * 8 + 7, got.form)
            line <- line + 1
        sy_bank(parsed, q.line_count, bank)
        asked: sview = sy_slice(q, q.asked_start, q.asked_len)
        if family == SY_META:
            scan: mutable SyScan = SyScan(asked)
            if not sy_take_literal(&scan, "Is the way "):
                return -2
            first: sview = sy_take_word(&scan)
            if not sy_take_literal(&scan, " stands to "):
                return -2
            second: sview = sy_take_word(&scan)
            if not sy_take_literal(&scan, " the same as the way "):
                return -2
            third: sview = sy_take_word(&scan)
            if not sy_take_literal(&scan, " stands to "):
                return -2
            fourth: sview = sy_take_word(&scan)
            if not (sy_take_literal(&scan, "?") and sy_scan_done(&scan)) or sy_bank_families(bank) != 1:
                return -2
            inner: mutable i64 = -1
            look: mutable i64 = 0
            while look < 8 |look, bank, inner|:
                inner <- look if Ints::at(bank.present, look) > 0 and inner < 0
                look <- look + 1
            one: i64 = sy_reread(bank, inner, sy_find_name(table, first), sy_find_name(table, second), table.count)
            two: i64 = sy_reread(bank, inner, sy_find_name(table, third), sy_find_name(table, fourth), table.count)
            if one == SY_UNTOLD or two == SY_UNTOLD:
                return 2
            return 0 if one == two else 1
        if family == SY_BINARY:
            scan: mutable SyScan = SyScan(asked)
            if not sy_take_literal(&scan, "Is this true?"):
                return -2
            while not sy_scan_done(&scan) and sview_at(asked, scan.at.usize()) == 32.u8() |scan, asked|:
                scan.at <- scan.at + 1
            tree: mutable SyTree = SyTree()
            tree.ok <- true
            root: i64 = sy_read_claim(asked, scan.at, sview_len(asked).i64() - scan.at, &tree)
            if not tree.ok:
                return -2
            ok: mutable bool = true
            value: i64 = sy_value_of(asked, &tree, root, bank, table, &ok)
            if not ok:
                return -2
            return sy_binary_option(value)
        if family == SY_CATEGORICAL:
            scan: mutable SyScan = SyScan(asked)
            if not sy_take_literal(&scan, "What follows about "):
                return -2
            subject_word: sview = sy_take_word(&scan)
            if not sy_take_literal(&scan, " and "):
                return -2
            other_word: sview = sy_take_word(&scan)
            if not (sy_take_literal(&scan, "?") and sy_scan_done(&scan)):
                return -2
            if sy_bank_families(bank) != 1 or Ints::at(bank.present, SY_CATEGORICAL) == 0:
                return -2
            # The terms in the order the question and then the premises name
            # them, which is what the statement indices are into.
            terms: mutable darray[i64] = Ints::zeros(SY_MOST_NAMES)
            where: mutable darray[i64] = Ints::zeros(SY_MOST_NAMES)
            fill: mutable i64 = 0
            while fill < SY_MOST_NAMES |fill, where|:
                Ints::put(&where, fill, -1)
                fill <- fill + 1
            subject: i64 = sy_find_name(table, subject_word)
            other: i64 = sy_find_name(table, other_word)
            count: mutable i64 = 0
            Ints::put(&terms, count, subject)
            Ints::put(&where, subject, count)
            count <- count + 1
            Ints::put(&terms, count, other)
            Ints::put(&where, other, count)
            count <- count + 1
            edge: mutable i64 = 0
            while edge < bank.count |edge, bank, terms, where, count|:
                side: mutable i64 = 0
                while side < 2 |side, edge, bank, terms, where, count|:
                    word: i64 = Ints::at(bank.left, edge) if side == 0 else Ints::at(bank.right, edge)
                    if Ints::at_ref(&where, word) < 0:
                        Ints::put(&terms, count, word)
                        Ints::put(&where, word, count)
                        count <- count + 1
                    side <- side + 1
                edge <- edge + 1
            statements: mutable SyStatements = SyStatements(SY_MOST_LINES)
            at: mutable i64 = 0
            while at < bank.count |at, bank, where, statements|:
                sy_statement_put(&statements, at, Ints::at(bank.value0, at), Ints::at_ref(&where, Ints::at(bank.left, at)), Ints::at_ref(&where, Ints::at(bank.right, at)))
                at <- at + 1
            statements.count <- bank.count
            holds: mutable i64 = 0
            first: mutable i64 = -1
            form: mutable i64 = 0
            while form < 4 |form, count, statements, where, subject, other, holds, first|:
                if sy_entails(count, &statements, form, Ints::at_ref(&where, subject), Ints::at_ref(&where, other)):
                    first <- form if holds == 0
                    holds <- holds + 1
                form <- form + 1
            if holds != 1:
                return 4
            return first
        # The chain families.
        scan: mutable SyScan = SyScan(asked)
        subject_word: mutable sview = asked
        other_word: mutable sview = asked
        matched: mutable bool = false
        if family == SY_PARITY:
            if sy_take_literal(&scan, "Is "):
                subject_word <- sy_take_word(&scan)
                if sy_take_literal(&scan, " the same as "):
                    other_word <- sy_take_word(&scan)
                    matched <- sy_take_literal(&scan, ", or the opposite?") and sy_scan_done(&scan)
        if family == SY_ORDER:
            if sy_take_literal(&scan, "Is "):
                subject_word <- sy_take_word(&scan)
                if sy_take_literal(&scan, " more than "):
                    other_word <- sy_take_word(&scan)
                    matched <- sy_take_literal(&scan, ", or less?") and sy_scan_done(&scan)
        if family == SY_PLANE or family == SY_SPACE:
            if sy_take_literal(&scan, "Which way is "):
                subject_word <- sy_take_word(&scan)
                if sy_take_literal(&scan, " from "):
                    other_word <- sy_take_word(&scan)
                    matched <- sy_take_literal(&scan, "?") and sy_scan_done(&scan)
        if not matched:
            return -2
        # A flat question whose premises all read back flat is banked as PLANE;
        # the widest thing said is what decides.
        banked_family: mutable i64 = family
        if family == SY_PLANE or family == SY_SPACE:
            banked_family <- SY_SPACE if Ints::at(bank.present, SY_SPACE) > 0 else SY_PLANE
        if Ints::at(bank.present, banked_family) == 0:
            return -2
        got: i64 = sy_reread(bank, banked_family, sy_find_name(table, subject_word), sy_find_name(table, other_word), table.count)
        if got == SY_UNTOLD:
            untold: i64 = sy_untold_label(family)
            return untold if untold != SY_UNTOLD else -2
        # A direction read back at three axes has to be said in the question's
        # own option space, which may be two.
        if (family == SY_PLANE or family == SY_SPACE) and banked_family != family:
            return -2
        return got if got < sy_option_count(family) else -2

def sy_find_name(table: SyNames&, word: sview) -> i64:
    can Abort.Panic:
        index: mutable i64 = 0
        while index < table.count |index, table, word|:
            if sview_eq(sy_name(table, index), word):
                return index
            index <- index + 1
        return -1

# Whether the question survives being read back off its own page.
def sy_checks_out(q: SyQuestion&, family: i64, bank: mutable SyBank&, table: mutable SyNames&) -> bool:
    can Memory.Allocate, Abort.Panic:
        if q.answer < 0 or q.answer >= q.option_count:
            return false
        if q.surface < 0 or q.surface >= q.option_count:
            return false
        if q.steps < 1 or q.decoys < 0:
            return false
        # `len(set(options)) != len(options)` -- two options spelling the same
        # thing would make one of them unanswerable.
        one: mutable i64 = 0
        while one < q.option_count |one, q|:
            two: mutable i64 = one + 1
            while two < q.option_count |two, one, q|:
                if sview_eq(sy_option(q, one), sy_option(q, two)):
                    return false
                two <- two + 1
            one <- one + 1
        # A page that will not read back is a fault rather than a wrong answer,
        # and it is dealt again rather than handed over.
        return sy_read_back(q, family, bank, table) == q.answer

# --- dealing one ---

struct SyWork:
    names: mutable SyNames
    web: mutable SyWeb
    found: mutable SyAskable
    meta: mutable SyMeta
    pool: mutable SyNames
    parts: mutable darray[SyPart]
    bank: mutable SyBank
    table: mutable SyNames

def SyWork() -> SyWork:
    can Memory.Allocate, Abort.Panic:
        out: mutable SyWork = zeroed
        out.names <- SyNames()
        out.web <- SyWeb()
        out.found <- SyAskable()
        out.meta <- SyMeta()
        out.pool <- SyNames()
        out.parts <- []
        for _slot in 0..<3 |out|:
            out.parts.push(SyPart())
        out.bank <- SyBank()
        out.table <- SyNames()
        return out

# One question at `grade`, READ BACK before it is handed over. Up to twelve
# tries: a page that will not read back is dealt again rather than handed over,
# which is why the verifier is part of the generation path and not a test.
def sy_deal_one(g: SyGrade, rng: mutable MT19937&, made_up: bool, work: mutable SyWork&, q: mutable SyQuestion&) -> bool:
    can Memory.Allocate, Abort.Panic:
        attempt: mutable i64 = 0
        while attempt < 12 |attempt, g, rng, made_up, work, q|:
            if sy_build_one(g, rng, made_up, work, q):
                if sy_checks_out(q, g.family, &work.bank, &work.table):
                    return true
            attempt <- attempt + 1
        return false

def sy_build_one(g: SyGrade, rng: mutable MT19937&, made_up: bool, work: mutable SyWork&, q: mutable SyQuestion&) -> bool:
    can Memory.Allocate, Abort.Panic:
        family: i64 = g.family
        if family == SY_PARITY or family == SY_ORDER or family == SY_PLANE or family == SY_SPACE:
            return sy_chain_question(g, rng, made_up, &work.names, &work.web, &work.found, q)
        if family == SY_CATEGORICAL:
            return sy_categorical_question(g, rng, made_up, &work.names, q)
        if family == SY_META:
            return sy_meta_question(g, rng, made_up, &work.names, &work.web, &work.found, &work.meta, q)
        if family == SY_BINARY:
            return sy_binary_question(g, rng, made_up, &work.pool, &work.parts, q)
        return false

def sy_generate(level: i64, seed: i64, made_up: bool, work: mutable SyWork&, q: mutable SyQuestion&) -> bool:
    can Memory.Allocate, Abort.Panic:
        rng: mutable MT19937 = mt19937_new()
        mt_seed_int(&rng, seed.u64())
        return sy_deal_one(sy_grade_of(level), &rng, made_up, work, q)
