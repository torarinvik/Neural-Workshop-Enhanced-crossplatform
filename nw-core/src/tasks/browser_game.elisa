include "./browser_par.elisa"
include "../verdict.elisa"
include "../geometry.elisa"

module BrowserGame:
    # ui/browser.py on ui/rungtask.py: a run of shopping trips on a
    # ladder, each judged at checkout -- the right things, in no more
    # clicks than par.
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const FEEDBACK: f64 = 2.5
    const START: i64 = BrowserSession::PORTS
    # The window the page is drawn into, in display units.
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0

    # How a trip ended.
    const LIVE: i64 = 0
    const BOUGHT: i64 = 1
    const OVER_PAR: i64 = 2
    const WRONG: i64 = 3
    # How many fields info reports.
    const INFO_FIELDS: i64 = 16

    struct Session:
        rng: mutable MT19937
        start_rung: mutable i64
        total: mutable i64
        adaptive: mutable bool
        rung: mutable i64
        trial: mutable i64
        wins: mutable i64
        best_rung: mutable i64
        phase: mutable i64
        time: mutable f64
        deadline: mutable f64
        browser: mutable BrowserSession::Session
        par: mutable i64
        verdict: mutable i64

    # _frame: where the 1000 by 640 page sits in the window, y up.
    struct Frame:
        left: f64
        top: f64
        scale: f64

    def frame() -> Frame:
        can Abort.Panic:
            top: f64 = Geometry::from_top_edge(HEIGHT, 116.0).f64()
            bottom: f64 = Verdict::above_the_band(HEIGHT, Geometry::from_bottom_edge(HEIGHT, 58.0).f64()).f64()
            width: f64 = WIDTH * 0.94
            height: f64 = fmax(40.0, top - bottom)
            scale: f64 = fmin(width / Browser::SCREEN_W, height / Browser::SCREEN_H)
            left: f64 = (WIDTH - width) / 2.0 + (width - Browser::SCREEN_W * scale) / 2.0
            return Frame{left: left, top: bottom + height, scale: scale}

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = zeroed
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            initial: i64 = rung if rung > 0 else 1
            return Session{rng: rng, start_rung: initial, total: trials, adaptive: adaptive, rung: initial,
                trial: 0, wins: 0, best_rung: 0, phase: READY, time: 0.0, deadline: 0.0, browser: zeroed,
                par: 0, verdict: LIVE}

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 3 or rung == 6 or rung == 9 or rung == 12 or rung == 15 or rung == 18 or rung == 21 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 8 or total == 12

    def valid_time(session: Session&, now: f64) -> bool:
        return now >= session.time and now <= 9007199254740.0

    # _next_trial: the next shop, or the end of the run.
    def next_trial(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            session.time <- now
            if session.trial >= session.total:
                session.phase <- DONE
                return true
            dealt: Browser::Deal = Browser::deal(session.rung, &session.rng)
            if dealt.product_count == 0:
                session.phase <- READY
                return false
            session.browser <- BrowserSession::start(&dealt, 0.0)
            session.par <- BrowserPar::par(&dealt)
            session.verdict <- LIVE
            session.trial <- session.trial + 1
            session.phase <- PLAYING
            return true

    def start(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if (session.phase != READY and session.phase != DONE) or session.total < 1
            return false if not valid_time(session, now)
            session.rung <- session.start_rung
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            return next_trial(session, now)

    # _checkout and _judge.
    def checkout(session: mutable Session&, now: f64):
        can Abort.Panic:
            right: bool = BrowserSession::right(&session.browser)
            cheap: bool = session.browser.clicks <= session.par
            passed: bool = right and cheap
            session.verdict <- BOUGHT if passed else (OVER_PAR if right else WRONG)
            if passed:
                session.wins <- session.wins + 1
                session.best_rung <- session.rung if session.rung > session.best_rung
            if session.adaptive:
                session.rung <- session.rung + 1 if passed and session.rung < 9223372036854775807
                session.rung <- session.rung - 1 if not passed and session.rung > 1
            session.deadline <- now + FEEDBACK
            session.phase <- JUDGED

    # steer: one agent port.
    def steer(session: mutable Session&, port: i64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if session.phase != PLAYING or port < 0 or port >= BrowserSession::PORTS
            return false if not valid_time(session, now)
            session.time <- now
            BrowserSession::steer(&session.browser, port)
            checkout(session, now) if session.browser.checked_out
            return true

    # A click at a display point, y up; outside the page it does nothing.
    def click(session: mutable Session&, x: f64, y: f64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if session.phase != PLAYING or not valid_time(session, now)
            at: Frame = frame()
            page_x: f64 = (x - at.left) / at.scale
            page_y: f64 = (at.top - y) / at.scale
            return false if page_x < 0.0 or page_x > Browser::SCREEN_W or page_y < 0.0 or page_y > Browser::SCREEN_H
            session.time <- now
            _ = BrowserSession::click_at(&session.browser, page_x, page_y)
            checkout(session, now) if session.browser.checked_out
            return true

    def scroll(session: mutable Session&, way: i64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if session.phase != PLAYING
            BrowserSession::wheel(&session.browser, way)
            return true

    # Backspace: Back, counted as a click.
    def back(session: mutable Session&) -> bool:
        can Abort.Panic:
            return false if session.phase != PLAYING
            session.browser.clicks <- session.browser.clicks + 1
            BrowserSession::act(&session.browser, BrowserPages::action(BrowserPages::BACK))
            return true

    # A pointer press at a display point, y up: it starts a run when none
    # is under way and clicks the page during one.
    def press(session: mutable Session&, x: f64, y: f64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return start(session, now) if session.phase == READY or session.phase == DONE
            return click(session, x, y, now)

    # One agent event: START begins a run, -1 is a frame (it moves the
    # clock during a trip and steps past a verdict), and anything else is a
    # port.
    def agent_input(session: mutable Session&, now: f64, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if not valid_time(session, now)
            return start(session, now) if port == START
            return steer(session, port, now) if port != -1
            return advance(session, now, true) if session.phase == JUDGED
            return false if session.phase != PLAYING
            session.time <- now
            return true

    def advance(session: mutable Session&, now: f64, stepped: bool = false) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if not valid_time(session, now)
            return false if session.phase != JUDGED
            return false if not stepped and now < session.deadline
            return next_trial(session, now)

    def reconfigure(session: mutable Session&, rung: i64, total: i64, adaptive: bool) -> bool:
        return false if session.phase != READY and session.phase != DONE
        return false if not allowed_rung(rung) or not allowed_total(total)
        session.start_rung <- rung
        session.rung <- rung
        session.total <- total
        session.adaptive <- adaptive
        session.trial <- 0
        session.wins <- 0
        session.best_rung <- 0
        session.phase <- READY
        return true

    def close(session: mutable Session&):
        session.phase <- READY
        session.browser <- zeroed

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return session.wins if field == 4
            return session.best_rung if field == 5
            return session.start_rung if field == 6
            return (1 if session.adaptive else 0) if field == 7
            return session.verdict if field == 8
            return session.browser.clicks if field == 9
            return session.par if field == 10
            return session.browser.page.kind if field == 11
            return session.browser.cart.count if field == 12
            return py_round_half_even(session.browser.pointer.x) if field == 13
            return py_round_half_even(session.browser.pointer.y) if field == 14
            return py_round_half_even(session.browser.scroll) if field == 15
            return -1
