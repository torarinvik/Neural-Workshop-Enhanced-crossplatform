# Removals: who ends up in which van, after a walk of packs and swaps.
#
# Port of neural_workshop/removals.py (GPL-2.0-or-later). Everything in a round
# is a NODE, numbered so the kind reads off the number: vans first, then boxes,
# then things. A van holds itself, which is what lets a chain walk upwards and
# simply stop.
#
# ## Why there is no set emulation here
#
# The reference keeps `loose` as a Python `set` and ITERATES it -- `list(loose)`
# then `shuffle`, and two comprehensions whose result feeds `choice`. That order
# is normally a reason to reach for pyset.elisa. It is not one here, and the
# reason is arithmetic rather than luck:
#
#   `loose` holds node ids from `range(vans, size)`. The largest yard is
#   5 vans + 10 boxes + 8 things, so ids never exceed 22, while CPython's table
#   for that many entries is 128 slots (and 8 for the smallest yard, whose ids
#   stop at 6). Every id is therefore strictly less than the mask, `key & mask`
#   is the key, and slot order IS ascending numeric order -- before any discard
#   and after it, and for `loose - {thing}` too.
#
# Measured against a real `set` at all three yard shapes before relying on it,
# and the differential sweep re-checks it on every run. So `loose` is a
# membership array walked in ascending id order, which is exactly equivalent and
# does not need CPython's dummy slots (which discard WOULD have needed).
#
# ## What the dicts are
#
# `level` IS iterated in insertion order, and `kin` -- built from that walk --
# feeds `choice`, so insertion order is observable. It is kept as a dense
# lookup plus an insertion-ordered key list. `holder` is only ever looked up or
# turned into `sorted(chained)`, so it is a dense array alone. `_room` walks
# `level` inside an `any(...)`, whose answer does not depend on the order.
#
# ## Random-stream fidelity
#
# `_deal` draws in a fixed order, and `generate` may call it up to 200 times, so
# a single misplaced draw desynchronises every later attempt rather than one:
#   _deal     one `sample(item_ids, asks)`
#   _spines   one `shuffle(box_ids)`, then per asked thing a `random()` for the
#             extra hop, a `choice(vans)`, and per step a `random()` for sharing
#             plus a `choice(kin)`
#   anchors   one `choice(walk[:-1])` per asked thing
#   _spots    one `shuffle(range(depth))`
#   start     one `randrange(vans)` per non-van node
#   the walk  per step, either a chain move (`random()` for swap, then
#             `_swap_link`'s `choice(spare)`) or `_filler`

module Removals:
    const PACK: i64 = 0
    const SWAP: i64 = 1

    # A slot the walk never settled: it still holds whatever the unseen start put
    # there, which is a uniform draw over the vans and never shown.
    const UNKNOWN: i64 = -1

    # The most the screen can tell apart, and so the most the ladder may ask for.
    const MOST_VANS: i64 = 5
    const MOST_BOXES: i64 = 12
    const MOST_ITEMS: i64 = 8
    const MOST_NODES: i64 = 25
    const MOST_DEPTH: i64 = 40
    const GRADE_COUNT: i64 = 12

    const SWAP_SHARE: f64 = 0.3
    const SHARE: f64 = 0.45

    struct Grade:
        vans: mutable i64
        boxes: mutable i64
        items: mutable i64
        depth: mutable i64
        asks: mutable i64
        nest: mutable i64
        floor: mutable i64
        churn: mutable i64

    # Kindergarten to superhuman, exactly the reference's GRADES table.
    def grade_of(level_number: i64) -> Grade:
        can Abort.Panic:
            index: mutable i64 = level_number - 1
            index <- 0 if index < 0
            index <- GRADE_COUNT - 1 if index > GRADE_COUNT - 1
            #                        vans boxes items depth asks nest floor churn
            return Grade{vans: 2, boxes: 2, items: 3, depth: 6, asks: 1, nest: 2, floor: 4, churn: 0} if index == 0
            return Grade{vans: 2, boxes: 3, items: 4, depth: 8, asks: 1, nest: 2, floor: 5, churn: 0} if index == 1
            return Grade{vans: 3, boxes: 3, items: 4, depth: 10, asks: 2, nest: 2, floor: 7, churn: 1} if index == 2
            return Grade{vans: 3, boxes: 4, items: 5, depth: 12, asks: 2, nest: 3, floor: 8, churn: 1} if index == 3
            return Grade{vans: 3, boxes: 5, items: 5, depth: 14, asks: 2, nest: 3, floor: 9, churn: 2} if index == 4
            return Grade{vans: 3, boxes: 5, items: 6, depth: 16, asks: 3, nest: 3, floor: 10, churn: 2} if index == 5
            return Grade{vans: 4, boxes: 6, items: 6, depth: 18, asks: 3, nest: 3, floor: 12, churn: 3} if index == 6
            return Grade{vans: 4, boxes: 7, items: 7, depth: 22, asks: 3, nest: 4, floor: 13, churn: 3} if index == 7
            return Grade{vans: 4, boxes: 8, items: 7, depth: 26, asks: 3, nest: 4, floor: 15, churn: 4} if index == 8
            return Grade{vans: 4, boxes: 8, items: 8, depth: 30, asks: 4, nest: 4, floor: 17, churn: 4} if index == 9
            return Grade{vans: 5, boxes: 9, items: 8, depth: 34, asks: 4, nest: 5, floor: 17, churn: 5} if index == 10
            return Grade{vans: 5, boxes: 10, items: 8, depth: 40, asks: 5, nest: 5, floor: 19, churn: 6}

    # How many of each kind a round has. Node numbering is the whole trick: the kind
    # is readable from the number, and a van is its own holder.
    struct Yard:
        vans: mutable i64
        boxes: mutable i64
        items: mutable i64
        size: mutable i64

    def Yard(vans: i64, boxes: i64, items: i64) -> Yard:
        return Yard{vans: vans, boxes: boxes, items: items, size: vans + boxes + items}

    def is_van(yard: Yard&, node: i64) -> bool:
        return node >= 0 and node < yard.vans

    def is_box(yard: Yard&, node: i64) -> bool:
        return node >= yard.vans and node < yard.vans + yard.boxes

    def is_item(yard: Yard&, node: i64) -> bool:
        return node >= yard.vans + yard.boxes and node < yard.size

    # One move: `thing` is the node moved; `other` is the holder it goes into for a
    # pack, and the node it changes places with for a swap.
    struct Move:
        kind: mutable i64
        thing: mutable i64
        other: mutable i64

    # One removal: the moves, the yard behind them, and what it cost.
    struct Round:
        ok: mutable bool
        yard: mutable Yard
        move_kind: mutable darray[i64]
        move_thing: mutable darray[i64]
        move_other: mutable darray[i64]
        move_n: mutable i64
        # Where everything sat before the first move, vans mapped to themselves.
        # Never drawn and never hinted at, which is what makes a slot the walk
        # never settled a coin rather than a clue.
        start: mutable darray[i64]
        asked: mutable darray[i64]
        asked_n: mutable i64
        answers: mutable darray[i64]
        # Fewest trailing moves that pin the WEAKEST question.
        needed: mutable i64
        # Hops from thing to van on the SHORTEST chain asked about.
        nest: mutable i64
        # Moves that touched a chain and were then overridden.
        churn: mutable i64

    # Scratch for one generator run. Sized once from the largest rung, so nothing
    # here allocates per attempt -- `generate` may deal 200 times.
    struct Work:
        yard: mutable Yard
        # parent/start maps over nodes.
        parent: mutable darray[i64]
        start: mutable darray[i64]
        settled: mutable darray[i64]
        scratch: mutable darray[i64]
        # The designed chains. `holder_at[node]` is -1 when the node is on no chain.
        holder_at: mutable darray[i64]
        # `level` is ITERATED in insertion order (see the header), so it is a dense
        # lookup plus the keys in the order they were added.
        level_at: mutable darray[i64]
        level_order: mutable darray[i64]
        level_n: mutable i64
        # Two different free-lists share this buffer: the boxes not yet taken in
        # `_spines`, and the move slots not yet used in `_spots`. Both are popped
        # from the end, hence the shared shape -- and it must be sized for the
        # LARGER of them, the walk depth, not for the node count.
        free: mutable darray[i64]
        free_n: mutable i64
        # When each designed link is laid, and the inverse.
        spot_of: mutable darray[i64]
        laid_at: mutable darray[i64]
        # `loose` as membership + ascending walk (see the header).
        loose_in: mutable darray[i64]
        # Chain membership, for churn and the filler's box guard.
        chained_in: mutable darray[i64]
        # Reusable candidate lists.
        pick: mutable darray[i64]
        pick_n: mutable i64
        walk: mutable darray[i64]
        walk_n: mutable i64
        anchors_in: mutable darray[i64]
        moves_kind: mutable darray[i64]
        moves_thing: mutable darray[i64]
        moves_other: mutable darray[i64]
        moves_n: mutable i64
        asked: mutable darray[i64]
        asked_n: mutable i64
        last_touch: mutable darray[i64]

    def Work() -> Work:
        can Memory.Allocate, Abort.Panic:
            work: mutable Work = zeroed
            work.yard <- Yard(0, 0, 0)
            work.parent <- Ints::zeros(MOST_NODES)
            work.start <- Ints::zeros(MOST_NODES)
            work.settled <- Ints::zeros(MOST_NODES)
            work.scratch <- Ints::zeros(MOST_NODES)
            work.holder_at <- Ints::zeros(MOST_NODES)
            work.level_at <- Ints::zeros(MOST_NODES)
            work.level_order <- Ints::zeros(MOST_NODES)
            work.free <- Ints::zeros(MOST_DEPTH + 1)
            work.spot_of <- Ints::zeros(MOST_NODES)
            work.laid_at <- Ints::zeros(MOST_DEPTH + 1)
            work.loose_in <- Ints::zeros(MOST_NODES)
            work.chained_in <- Ints::zeros(MOST_NODES)
            work.pick <- Ints::zeros(MOST_NODES + MOST_DEPTH)
            work.walk <- Ints::zeros(MOST_NODES)
            work.anchors_in <- Ints::zeros(MOST_NODES)
            work.moves_kind <- Ints::zeros(MOST_DEPTH)
            work.moves_thing <- Ints::zeros(MOST_DEPTH)
            work.moves_other <- Ints::zeros(MOST_DEPTH)
            work.asked <- Ints::zeros(MOST_ITEMS)
            work.last_touch <- Ints::zeros(MOST_NODES)
            return work

    # --- reading a walk ------------------------------------------------------

    # Do what one move does, in place. Both verbs are POSITION-wise: a pack writes a
    # constant into one slot, a swap exchanges two. Neither looks at a value to
    # decide, which is why UNKNOWN flows through correctly with no special case --
    # an unknown thing swapped with a known one simply trades places with it.
    def enter(parent: mutable darray[i64]&, kind: i64, thing: i64, other: i64):
        can Abort.Panic:
            if kind == PACK:
                Ints::put(parent, thing, other)
            else:
                held: i64 = Ints::at_ref(parent, thing)
                Ints::put(parent, thing, Ints::at_ref(parent, other))
                Ints::put(parent, other, held)

    # `node`, then what holds it, and so on up to a van. Stops early -- and short of
    # a van -- at a slot nothing settled. The last entry is a van exactly when the
    # chain is whole.
    def chain(work: mutable Work&, parent: mutable darray[i64]&, node: i64) -> i64:
        can Abort.Panic:
            work.walk_n <- 0
            at: mutable i64 = node
            Ints::put(&work.walk, 0, at)
            work.walk_n <- 1
            while not is_van(work.yard, at) |work, at|:
                at <- Ints::at_ref(parent, at)
                break if at == UNKNOWN
                seen: mutable bool = false
                scan: mutable i64 = 0
                while scan < work.walk_n |scan, work, at, seen|:
                    seen <- true if Ints::at(work.walk, scan) == at
                    scan <- scan + 1
                break if seen
                Ints::put(&work.walk, work.walk_n, at)
                work.walk_n <- work.walk_n + 1
            return work.walk_n

    # Which van `node` is in, or UNKNOWN when that is open.
    def van_of(work: mutable Work&, parent: mutable darray[i64]&, node: i64) -> i64:
        can Abort.Panic:
            count: i64 = chain(work, parent, node)
            last: i64 = Ints::at(work.walk, count - 1)
            return last if is_van(work.yard, last) else UNKNOWN

    # Run the walk's last `window` moves from a map that knows only where the vans
    # are. Every slot that comes out UNKNOWN is one this tail never settled.
    def resting_tail(work: mutable Work&, out: mutable darray[i64]&, window: i64):
        can Abort.Panic:
            node: mutable i64 = 0
            while node < work.yard.size |node, work, out|:
                Ints::put(out, node, node if is_van(work.yard, node) else UNKNOWN)
                node <- node + 1
            first: i64 = work.moves_n - window
            index: mutable i64 = first if first > 0 else 0
            while index < work.moves_n |index, work, out|:
                enter(out, Ints::at(work.moves_kind, index), Ints::at(work.moves_thing, index), Ints::at(work.moves_other, index))
                index <- index + 1

    # Fewest trailing moves that pin which van `node` is in, or -1 when the whole
    # walk does not pin it -- a question that must not be asked.
    #
    # Exact rather than an estimate: a tail one move short leaves some link resting
    # on a slot the tail never settled, and that slot holds a uniform starting van.
    def span(work: mutable Work&, node: i64) -> i64:
        can Abort.Panic:
            window: mutable i64 = 0
            while window <= work.moves_n |window, work, node|:
                resting_tail(work, &work.scratch, window)
                return window if van_of(work, &work.scratch, node) != UNKNOWN
                window <- window + 1
            return -1

    # Moves that write to a chained node and are then written over: work a player
    # has to do and then throw away. Read off the WALK alone -- a move counts when a
    # later move writes the same node, so what makes it wasted is the walk and not
    # the intention behind it.
    def wasted(work: mutable Work&) -> i64:
        can Abort.Panic:
            node: mutable i64 = 0
            while node < work.yard.size |node, work|:
                Ints::put(&work.last_touch, node, -1)
                node <- node + 1
            index: mutable i64 = 0
            while index < work.moves_n |index, work|:
                Ints::put(&work.last_touch, Ints::at(work.moves_thing, index), index)
                Ints::put(&work.last_touch, Ints::at(work.moves_other, index), index) if Ints::at(work.moves_kind, index) == SWAP
                index <- index + 1
            total: mutable i64 = 0
            step: mutable i64 = 0
            while step < work.moves_n |step, work, total|:
                thing: i64 = Ints::at(work.moves_thing, step)
                other: i64 = Ints::at(work.moves_other, step)
                hit: mutable bool = Ints::at(work.chained_in, thing) == 1 and Ints::at(work.last_touch, thing) > step
                if Ints::at(work.moves_kind, step) == SWAP:
                    hit <- true if Ints::at(work.chained_in, other) == 1 and Ints::at(work.last_touch, other) > step
                total <- total + 1 if hit
                step <- step + 1
            return total

    # True when `maybe` is `node`, or sits somewhere inside it.
    def inside(work: Work&, parent: mutable darray[i64]&, node: i64, maybe: i64) -> bool:
        can Abort.Panic:
            at: mutable i64 = maybe
            seen: mutable i64 = 0
            verdict: mutable i64 = 0
            while verdict == 0 |verdict, at, seen, work, parent, node|:
                if at == node:
                    verdict <- 1
                elif is_van(work.yard, at) or at == UNKNOWN:
                    verdict <- 2
                else:
                    at <- Ints::at_ref(parent, at)
                    seen <- seen + 1
                    verdict <- 2 if seen > work.yard.size
            return verdict == 1

    # --- laying a walk -------------------------------------------------------

    # True when `want` more levels of boxes already stand under `node`.
    #
    # What makes sharing safe: a chain that reuses a box has to be able to FINISH
    # from there, so the question is never "is there a box at this level" but "is
    # there one deep enough to land on". Walks `level` inside an any(), whose answer
    # does not depend on the walk order.
    def room(work: Work&, node: i64, want: i64) -> bool:
        can Abort.Panic:
            true return if want <= 0
            held: i64 = Ints::at(work.level_at, node)
            below: i64 = (0 if held < 0 else held) + 1
            index: mutable i64 = 0
            found: mutable bool = false
            while index < work.level_n and not found |index, work, node, below, want, found|:
                box: i64 = Ints::at(work.level_order, index)
                if Ints::at(work.holder_at, box) == node and Ints::at(work.level_at, box) == below:
                    found <- true if room(work, box, want - 1)
                index <- index + 1
            return found

    # Design where the asked things finish, before any move is laid.
    #
    # Each chain is built DOWNWARDS from a van: a box to stand in the van, a box in
    # that, and so on to the depth the rung asks for, then the thing hangs off the
    # bottom. Fresh boxes are taken while enough remain to finish; past that a box
    # already standing at the right depth under the right holder must be reused, and
    # one is reused sometimes anyway. Sharing is what lets the top rung ask five
    # hops of ten boxes rather than twenty.
    #
    # Returns false when the boxes ran out.
    def spines(work: mutable Work&, grade: Grade&, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            node: mutable i64 = 0
            while node < work.yard.size |node, work|:
                Ints::put(&work.holder_at, node, -1)
                Ints::put(&work.level_at, node, -1)
                node <- node + 1
            work.level_n <- 0
            # `free = list(yard.box_ids())` then shuffle: box ids ascending.
            work.free_n <- 0
            box: mutable i64 = work.yard.vans
            while box < work.yard.vans + work.yard.boxes |box, work|:
                Ints::put(&work.free, work.free_n, box)
                work.free_n <- work.free_n + 1
                box <- box + 1
            py_shuffle_i64_prefix(rng, &work.free, work.free_n)

            which: mutable i64 = 0
            ok: mutable bool = true
            while which < work.asked_n and ok |which, work, grade, rng, ok|:
                item: i64 = Ints::at(work.asked, which)
                deep: mutable i64 = grade.nest
                # One extra hop, sometimes, when the boxes can pay for it.
                if work.free_n >= deep:
                    deep <- deep + 1 if py_random(rng) < 0.25
                # Vans that could still finish a chain this deep.
                work.pick_n <- 0
                van: mutable i64 = 0
                while van < work.yard.vans |van, work, deep|:
                    keep: bool = work.free_n >= deep - 1 or room(work, van, deep - 1)
                    if keep:
                        Ints::put(&work.pick, work.pick_n, van)
                        work.pick_n <- work.pick_n + 1
                    van <- van + 1
                if work.pick_n == 0:
                    ok <- false
                else:
                    at: mutable i64 = Ints::at(work.pick, py_choice_index(rng, work.pick_n))
                    step: mutable i64 = 1
                    while step < deep and ok |step, deep, at, work, grade, rng, ok|:
                        want: i64 = deep - step
                        # Boxes standing at this step under `at`, deep enough to
                        # land on. Built by walking `level` in INSERTION order,
                        # because `choice` reads this list positionally.
                        work.pick_n <- 0
                        scan: mutable i64 = 0
                        while scan < work.level_n |scan, work, step, at, want|:
                            kin: i64 = Ints::at(work.level_order, scan)
                            if Ints::at(work.level_at, kin) == step and Ints::at(work.holder_at, kin) == at:
                                if room(work, kin, want - 1):
                                    Ints::put(&work.pick, work.pick_n, kin)
                                    work.pick_n <- work.pick_n + 1
                            scan <- scan + 1
                        share: mutable bool = false
                        if work.pick_n > 0:
                            share <- true if work.free_n < want
                            share <- true if not share and py_random(rng) < SHARE
                        if share:
                            at <- Ints::at(work.pick, py_choice_index(rng, work.pick_n))
                        elif work.free_n >= want:
                            work.free_n <- work.free_n - 1
                            taken: i64 = Ints::at(work.free, work.free_n)
                            Ints::put(&work.holder_at, taken, at)
                            Ints::put(&work.level_at, taken, step)
                            Ints::put(&work.level_order, work.level_n, taken)
                            work.level_n <- work.level_n + 1
                            at <- taken
                        elif work.pick_n > 0:
                            at <- Ints::at(work.pick, py_choice_index(rng, work.pick_n))
                        else:
                            ok <- false
                        step <- step + 1
                    Ints::put(&work.holder_at, item, at) if ok
                which <- which + 1
            return ok

    # When each designed link is laid down.
    #
    # Every chain needs one link laid EARLY, because a question is pinned no further
    # back than its earliest link -- that link is its anchor, and putting anchors in
    # the first `depth - floor + 1` moves is what makes the rung's floor a
    # guarantee. The rest go anywhere, which matters: if every link were early the
    # whole tail would be filler on things nobody asks about, and a player would
    # learn to stop watching.
    def spots(work: mutable Work&, grade: Grade&, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            early: i64 = grade.depth - grade.floor + 1
            anchor_n: mutable i64 = 0
            chain_n: mutable i64 = 0
            node: mutable i64 = 0
            while node < work.yard.size |node, work, anchor_n, chain_n|:
                anchor_n <- anchor_n + 1 if Ints::at(work.anchors_in, node) == 1
                chain_n <- chain_n + 1 if Ints::at(work.chained_in, node) == 1
                node <- node + 1
            false return if anchor_n > early or chain_n > grade.depth

            # `free = list(range(depth))` then shuffle.
            work.free_n <- 0
            slot: mutable i64 = 0
            while slot < grade.depth |slot, work|:
                Ints::put(&work.free, work.free_n, slot)
                work.free_n <- work.free_n + 1
                slot <- slot + 1
            py_shuffle_i64_prefix(rng, &work.free, work.free_n)

            reset: mutable i64 = 0
            while reset < work.yard.size |reset, work|:
                Ints::put(&work.spot_of, reset, -1)
                reset <- reset + 1

            # Anchors first, in SORTED node order, each taking the first slot in the
            # shuffled list that is early enough.
            ok: mutable bool = true
            at: mutable i64 = 0
            while at < work.yard.size and ok |at, work, early, ok|:
                if Ints::at(work.anchors_in, at) == 1:
                    found: mutable i64 = -1
                    scan: mutable i64 = 0
                    while scan < work.free_n and found < 0 |scan, work, early, found|:
                        found <- scan if Ints::at(work.free, scan) < early
                        scan <- scan + 1
                    if found < 0:
                        ok <- false
                    else:
                        Ints::put(&work.spot_of, at, Ints::at(work.free, found))
                        # `free.remove(pick)` -- close the gap, order preserved.
                        shift: mutable i64 = found
                        while shift < work.free_n - 1 |shift, work|:
                            Ints::put(&work.free, shift, Ints::at(work.free, shift + 1))
                            shift <- shift + 1
                        work.free_n <- work.free_n - 1
                at <- at + 1
            false return if not ok

            # Then every remaining link, in sorted node order, popping from the END.
            link: mutable i64 = 0
            while link < work.yard.size |link, work|:
                if Ints::at(work.chained_in, link) == 1 and Ints::at(work.spot_of, link) < 0:
                    work.free_n <- work.free_n - 1
                    Ints::put(&work.spot_of, link, Ints::at(work.free, work.free_n))
                link <- link + 1
            return true

    # A swap that lands `thing` in `want`, if one is going spare.
    #
    # Chains would otherwise be built entirely out of packs and a player would learn
    # that a swap never carries an answer. Finds some other THING already sitting in
    # the holder we want and trades places with it. Both sides are things rather
    # than boxes, so neither can be inside the other and no loop can be made.
    #
    # `skip` is the node excluded from the candidate set -- the reference passes
    # `loose - {thing}`, whose iteration order is ascending exactly as `loose`'s is.
    def swap_link(work: mutable Work&, thing: i64, want: i64, skip: i64, rng: mutable MT19937&) -> i64:
        can Abort.Panic:
            work.pick_n <- 0
            node: mutable i64 = 0
            while node < work.yard.size |node, work, thing, want, skip|:
                if Ints::at(work.loose_in, node) == 1 and node != skip:
                    if node != thing and is_item(work.yard, node) and Ints::at(work.parent, node) == want:
                        Ints::put(&work.pick, work.pick_n, node)
                        work.pick_n <- work.pick_n + 1
                node <- node + 1
            return -1 if work.pick_n == 0
            return Ints::at(work.pick, py_choice_index(rng, work.pick_n))

    # A move that carries no answer, and disturbs no chain that does.
    #
    # Anything still loose may be packed or swapped, with two guards: a box a chain
    # runs through is only ever packed straight into a VAN, because that is the one
    # destination that cannot put a box inside itself; and any other pack is checked
    # against the yard as it actually stands. Between them nothing here makes a loop.
    #
    # Writes the move into slot `step` and returns true, or returns false when
    # nothing loose can move.
    def filler(work: mutable Work&, step: i64, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            # `movers = list(loose)` -- ascending -- then shuffle.
            move_n: mutable i64 = 0
            node: mutable i64 = 0
            while node < work.yard.size |node, work, move_n|:
                if Ints::at(work.loose_in, node) == 1:
                    Ints::put(&work.scratch, move_n, node)
                    move_n <- move_n + 1
                node <- node + 1
            py_shuffle_i64_prefix(rng, &work.scratch, move_n)

            index: mutable i64 = 0
            laid: mutable bool = false
            while index < move_n and not laid |index, move_n, work, step, rng, laid|:
                thing: i64 = Ints::at(work.scratch, index)
                # Other loose THINGS, ascending.
                work.pick_n <- 0
                mate: mutable i64 = 0
                while mate < work.yard.size |mate, work, thing|:
                    if Ints::at(work.loose_in, mate) == 1 and mate != thing and is_item(work.yard, mate):
                        Ints::put(&work.pick, work.pick_n, mate)
                        work.pick_n <- work.pick_n + 1
                    mate <- mate + 1
                swapped: mutable bool = false
                if is_item(work.yard, thing) and work.pick_n > 0:
                    if py_random(rng) < SWAP_SHARE:
                        Ints::put(&work.moves_kind, step, SWAP)
                        Ints::put(&work.moves_thing, step, thing)
                        Ints::put(&work.moves_other, step, Ints::at(work.pick, py_choice_index(rng, work.pick_n)))
                        swapped <- true
                if swapped:
                    laid <- true
                elif Ints::at(work.chained_in, thing) == 1 and is_box(work.yard, thing):
                    # A chained box goes straight into a van, or not at all -- the
                    # reference `continue`s to the next mover rather than falling
                    # through to the general pack.
                    work.pick_n <- 0
                    van: mutable i64 = 0
                    while van < work.yard.vans |van, work, thing|:
                        if Ints::at(work.parent, thing) != van:
                            Ints::put(&work.pick, work.pick_n, van)
                            work.pick_n <- work.pick_n + 1
                        van <- van + 1
                    if work.pick_n > 0:
                        Ints::put(&work.moves_kind, step, PACK)
                        Ints::put(&work.moves_thing, step, thing)
                        Ints::put(&work.moves_other, step, Ints::at(work.pick, py_choice_index(rng, work.pick_n)))
                        laid <- true
                else:
                    # Any holder that is not where it already sits and does not put
                    # it inside itself.
                    work.pick_n <- 0
                    spot: mutable i64 = 0
                    while spot < work.yard.vans + work.yard.boxes |spot, work, thing|:
                        if spot != Ints::at(work.parent, thing) and not inside(work, &work.parent, thing, spot):
                            Ints::put(&work.pick, work.pick_n, spot)
                            work.pick_n <- work.pick_n + 1
                        spot <- spot + 1
                    if work.pick_n > 0:
                        Ints::put(&work.moves_kind, step, PACK)
                        Ints::put(&work.moves_thing, step, thing)
                        Ints::put(&work.moves_other, step, Ints::at(work.pick, py_choice_index(rng, work.pick_n)))
                        laid <- true
                index <- index + 1
            return laid

    # One round at `grade`, designed from the ANSWERS backwards.
    #
    # Dealing a walk and keeping it when it happens to bury its answers deep enough
    # does not work: a random walk almost never nests anything, because packing at
    # random puts most things straight into a van and the chain the task is about
    # would be one hop long. So the chains are designed first, then laid at chosen
    # moments, and the rest of the walk is filler from whatever is still loose --
    # so the screen is busy with moves that matter and moves that do not, and never
    # says which is which.
    #
    # Nothing here is trusted: the construction proposes and `resting` disposes.
    # Every number on the round is measured off the finished walk.
    def deal(work: mutable Work&, grade: Grade&, rng: mutable MT19937&, out: mutable Round&) -> bool:
        can Memory.Allocate, Abort.Panic:
            out.ok <- false
            first_item: i64 = work.yard.vans + work.yard.boxes
            drawn: darray[i64] = py_sample_range(rng, first_item, work.yard.size - 1, grade.asks)
            false return if drawn.count.i64() != grade.asks
            work.asked_n <- 0
            for value in drawn |work|:
                Ints::put(&work.asked, work.asked_n, value)
                work.asked_n <- work.asked_n + 1
            Ints::sort_prefix(&work.asked, work.asked_n)

            false return if not spines(work, grade, rng)

            # `chained = set(holder)` -- the designed nodes. Only ever asked about
            # membership or walked in sorted order, so a flag array is exact.
            node: mutable i64 = 0
            while node < work.yard.size |node, work|:
                Ints::put(&work.chained_in, node, 1 if Ints::at(work.holder_at, node) >= 0 else 0)
                Ints::put(&work.anchors_in, node, 0)
                node <- node + 1

            # One anchor per asked thing, drawn from its designed chain minus the
            # van at the top.
            which: mutable i64 = 0
            while which < work.asked_n |which, work, rng|:
                item: i64 = Ints::at(work.asked, which)
                work.walk_n <- 0
                at: mutable i64 = item
                Ints::put(&work.walk, 0, at)
                work.walk_n <- 1
                while Ints::at(work.holder_at, at) >= 0 |at, work|:
                    at <- Ints::at(work.holder_at, at)
                    Ints::put(&work.walk, work.walk_n, at)
                    work.walk_n <- work.walk_n + 1
                chosen: i64 = Ints::at(work.walk, py_choice_index(rng, work.walk_n - 1))
                Ints::put(&work.anchors_in, chosen, 1)
                which <- which + 1

            false return if not spots(work, grade, rng)

            # Invert: which node is laid at each step.
            slot: mutable i64 = 0
            while slot <= grade.depth |slot, work|:
                Ints::put(&work.laid_at, slot, -1)
                slot <- slot + 1
            link: mutable i64 = 0
            while link < work.yard.size |link, work|:
                spot: i64 = Ints::at(work.spot_of, link)
                Ints::put(&work.laid_at, spot, link) if spot >= 0
                link <- link + 1

            # The unseen start: vans hold themselves, everything else a uniform van.
            place: mutable i64 = 0
            while place < work.yard.size |place, work, rng|:
                if is_van(work.yard, place):
                    Ints::put(&work.start, place, place)
                else:
                    Ints::put(&work.start, place, py_randrange(rng, 0, work.yard.vans))
                place <- place + 1
            copy: mutable i64 = 0
            while copy < work.yard.size |copy, work|:
                Ints::put(&work.parent, copy, Ints::at(work.start, copy))
                Ints::put(&work.loose_in, copy, 1 if copy >= work.yard.vans else 0)
                copy <- copy + 1

            work.moves_n <- 0
            step: mutable i64 = 0
            ok: mutable bool = true
            while step < grade.depth and ok |step, grade, work, rng, ok|:
                thing: i64 = Ints::at(work.laid_at, step)
                if thing >= 0:
                    want: i64 = Ints::at(work.holder_at, thing)
                    mate: mutable i64 = -1
                    if is_item(work.yard, thing):
                        if py_random(rng) < SWAP_SHARE:
                            mate <- swap_link(work, thing, want, thing, rng)
                    if mate >= 0:
                        Ints::put(&work.moves_kind, step, SWAP)
                        Ints::put(&work.moves_thing, step, thing)
                        Ints::put(&work.moves_other, step, mate)
                    elif inside(work, &work.parent, thing, want):
                        ok <- false
                    else:
                        Ints::put(&work.moves_kind, step, PACK)
                        Ints::put(&work.moves_thing, step, thing)
                        Ints::put(&work.moves_other, step, want)
                    Ints::put(&work.loose_in, thing, 0) if ok
                else:
                    ok <- false if not filler(work, step, rng)
                if ok:
                    work.moves_n <- work.moves_n + 1
                    enter(&work.parent, Ints::at(work.moves_kind, step), Ints::at(work.moves_thing, step), Ints::at(work.moves_other, step))
                step <- step + 1
            false return if not ok

            # Measured off the finished walk, never off the intention.
            resting_tail(work, &work.settled, work.moves_n)
            needed: mutable i64 = MOST_DEPTH + 1
            nest: mutable i64 = MOST_NODES
            scan: mutable i64 = 0
            while scan < work.asked_n |scan, work, needed, nest|:
                item: i64 = Ints::at(work.asked, scan)
                # A span of -1 means the whole walk does not pin this question;
                # `needed` then goes negative and the round is rejected below,
                # exactly as the reference's `min(spans) < 0` does.
                reach: i64 = span(work, item)
                needed <- reach if reach < needed
                hops: i64 = chain(work, &work.settled, item) - 1
                nest <- hops if hops < nest
                scan <- scan + 1
            false return if needed < 0

            # Where everything really finishes, from the real start.
            final: mutable i64 = 0
            while final < work.yard.size |final, work|:
                Ints::put(&work.scratch, final, Ints::at(work.start, final))
                final <- final + 1
            replay: mutable i64 = 0
            while replay < work.moves_n |replay, work|:
                enter(&work.scratch, Ints::at(work.moves_kind, replay), Ints::at(work.moves_thing, replay), Ints::at(work.moves_other, replay))
                replay <- replay + 1

            out.yard <- work.yard
            out.move_n <- work.moves_n
            out.asked_n <- work.asked_n
            copy_move: mutable i64 = 0
            while copy_move < work.moves_n |copy_move, work, out|:
                Ints::put(&out.move_kind, copy_move, Ints::at(work.moves_kind, copy_move))
                Ints::put(&out.move_thing, copy_move, Ints::at(work.moves_thing, copy_move))
                Ints::put(&out.move_other, copy_move, Ints::at(work.moves_other, copy_move))
                copy_move <- copy_move + 1
            copy_node: mutable i64 = 0
            while copy_node < work.yard.size |copy_node, work, out|:
                Ints::put(&out.start, copy_node, Ints::at(work.start, copy_node))
                copy_node <- copy_node + 1
            copy_ask: mutable i64 = 0
            while copy_ask < work.asked_n |copy_ask, work, out|:
                item: i64 = Ints::at(work.asked, copy_ask)
                Ints::put(&out.asked, copy_ask, item)
                Ints::put(&out.answers, copy_ask, van_of(work, &work.scratch, item))
                copy_ask <- copy_ask + 1
            out.needed <- needed
            out.nest <- nest
            out.churn <- wasted(work)
            out.ok <- true
            return true

    # A round at `level_number`, at or above that rung's floors.
    #
    # The depth and the span need no searching for -- every walk is laid so they
    # hold -- so the attempts go on the CHURN, and on the deals that simply do not
    # come out: a chain can run out of boxes, or want to put a box where it already
    # is. Failing to find a round that shuffles as well as it buries, the busiest of
    # the lot is handed back rather than the first one seen, which keeps the junior
    # axis honest without letting it outrank the other two.
    def generate(work: mutable Work&, level_number: i64, seed: i64, attempts: i64, out: mutable Round&, best: mutable Round&) -> bool:
        can Memory.Allocate, Abort.Panic:
            grade: Grade = grade_of(level_number)
            work.yard <- Yard(grade.vans, grade.boxes, grade.items)
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            best.ok <- false
            rounds: i64 = attempts if attempts > 1 else 1
            tries: mutable i64 = 0
            done: mutable bool = false
            while tries < rounds and not done |tries, rounds, work, grade, rng, out, best, done|:
                if deal(work, &grade, &rng, out):
                    if out.needed >= grade.floor and out.nest >= grade.nest:
                        if out.churn >= grade.churn:
                            done <- true
                        elif not best.ok or out.churn > best.churn:
                            round_copy(out, best)
                tries <- tries + 1
            return true if done
            return false if not best.ok
            round_copy(best, out)
            return true

    def round_copy(from_round: Round&, to_round: mutable Round&):
        can Abort.Panic:
            to_round.ok <- from_round.ok
            to_round.yard <- from_round.yard
            to_round.move_n <- from_round.move_n
            to_round.asked_n <- from_round.asked_n
            to_round.needed <- from_round.needed
            to_round.nest <- from_round.nest
            to_round.churn <- from_round.churn
            index: mutable i64 = 0
            while index < from_round.move_n |index, from_round, to_round|:
                Ints::put(&to_round.move_kind, index, Ints::at(from_round.move_kind, index))
                Ints::put(&to_round.move_thing, index, Ints::at(from_round.move_thing, index))
                Ints::put(&to_round.move_other, index, Ints::at(from_round.move_other, index))
                index <- index + 1
            node: mutable i64 = 0
            while node < from_round.yard.size |node, from_round, to_round|:
                Ints::put(&to_round.start, node, Ints::at(from_round.start, node))
                node <- node + 1
            ask: mutable i64 = 0
            while ask < from_round.asked_n |ask, from_round, to_round|:
                Ints::put(&to_round.asked, ask, Ints::at(from_round.asked, ask))
                Ints::put(&to_round.answers, ask, Ints::at(from_round.answers, ask))
                ask <- ask + 1

    def Round() -> Round:
        can Memory.Allocate, Abort.Panic:
            round: mutable Round = zeroed
            round.ok <- false
            round.yard <- Yard(0, 0, 0)
            round.move_kind <- Ints::zeros(MOST_DEPTH)
            round.move_thing <- Ints::zeros(MOST_DEPTH)
            round.move_other <- Ints::zeros(MOST_DEPTH)
            round.start <- Ints::zeros(MOST_NODES)
            round.asked <- Ints::zeros(MOST_ITEMS)
            round.answers <- Ints::zeros(MOST_ITEMS)
            return round

    # Score a player who recalls only the last `window` moves -- the foil this task
    # is built to defeat. It plays as well as anybody could from that much: where
    # the tail it can see already pins a thing's van it answers exactly, and where
    # it does not it holds no information whatever and must guess. Returns how many
    # questions it can be SURE of; everything else is one in `vans`, which is why
    # the certain ones are the whole story.
    def remembering(work: mutable Work&, round: Round&, window: i64) -> i64:
        can Abort.Panic:
            work.yard <- round.yard
            work.moves_n <- round.move_n
            index: mutable i64 = 0
            while index < round.move_n |index, round, work|:
                Ints::put(&work.moves_kind, index, Ints::at(round.move_kind, index))
                Ints::put(&work.moves_thing, index, Ints::at(round.move_thing, index))
                Ints::put(&work.moves_other, index, Ints::at(round.move_other, index))
                index <- index + 1
            resting_tail(work, &work.settled, window)
            sure: mutable i64 = 0
            ask: mutable i64 = 0
            while ask < round.asked_n |ask, round, work, sure|:
                sure <- sure + 1 if van_of(work, &work.settled, Ints::at(round.asked, ask)) != UNKNOWN
                ask <- ask + 1
            return sure
