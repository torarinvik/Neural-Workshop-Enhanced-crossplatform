# Reflex: click the shrinking targets before they vanish.
#
# Port of the portable half of neural_workshop/ui/reflex.py (GPL-2.0-or-later).
# The pictures and the placing are the shell's; what is here is the clock a
# target lives on, the adaptive life, and the run's score.

module Reflex:

    # Smallest a target is drawn before it counts as GONE. Below this it is a
    # few pixels and clicking it would be luck rather than reflex.
    const MIN_SCALE: f64 = 0.06

    # How the adaptive life changes per hit and per miss. Gentle enough that a
    # run of forty does not bottom out, and QUICKER TO EASE OFF than to tighten
    # -- which is what keeps it near the edge of what you can manage rather
    # than past it.
    const TIGHTEN_ON_HIT: f64 = 0.97
    const EASE_ON_MISS: f64 = 1.08

    # Bounds on the adaptive life. The floor is near human reaction time, so
    # reaching it means the task has nothing harder to offer.
    const MIN_LIFETIME: f64 = 0.30
    const MAX_LIFETIME_FACTOR: f64 = 2.5

    # Fraction of life left: 1 at spawn, 0 when it vanishes.
    def remaining(born: f64, lifetime: f64, now: f64) -> f64:
        can Abort.Panic:
            return 0.0 if lifetime <= 0.0
            left: f64 = 1.0 - (now - born) / lifetime
            return 0.0 if left < 0.0 else left

    def is_gone(born: f64, lifetime: f64, now: f64) -> bool:
        can Abort.Panic:
            return remaining(born, lifetime, now) <= MIN_SCALE

    # Whether a point is on the target at its CURRENT size. The side shrinks
    # towards the centre, so a target clear of an edge at spawn stays clear.
    def contains(centre_x: f64, centre_y: f64, side: f64, x: f64, y: f64) -> bool:
        can Abort.Panic:
            half: f64 = side / 2.0
            return x >= centre_x - half and x <= centre_x + half and y >= centre_y - half and y <= centre_y + half

    def adapt(lifetime: f64, base_lifetime: f64, hit: bool) -> f64:
        can Abort.Panic:
            if hit:
                tightened: f64 = lifetime * TIGHTEN_ON_HIT
                return MIN_LIFETIME if tightened < MIN_LIFETIME else tightened
            eased: f64 = lifetime * EASE_ON_MISS
            ceiling: f64 = base_lifetime * MAX_LIFETIME_FACTOR
            return ceiling if eased > ceiling else eased

    struct Run:
        adaptive: mutable bool
        base_lifetime: mutable f64
        lifetime: mutable f64
        hits: mutable i64
        misses: mutable i64
        # Reaction times in seconds, one per hit.
        reactions: mutable darray[f64]
        reaction_n: mutable i64

    def new_run(base_lifetime: f64, adaptive: bool, most_targets: i64) -> Run:
        can Memory.Allocate, Abort.Panic:
            return Run{adaptive: adaptive, base_lifetime: base_lifetime, lifetime: base_lifetime,
                       hits: 0, misses: 0, reactions: Floats::zeros(most_targets), reaction_n: 0}

    def score_hit(run: mutable Run&, reaction: f64):
        can Abort.Panic:
            run.hits <- run.hits + 1
            Floats::put(&run.reactions, run.reaction_n, reaction)
            run.reaction_n <- run.reaction_n + 1
            run.lifetime <- adapt(run.lifetime, run.base_lifetime, true) if run.adaptive

    def score_miss(run: mutable Run&):
        can Abort.Panic:
            run.misses <- run.misses + 1
            run.lifetime <- adapt(run.lifetime, run.base_lifetime, false) if run.adaptive

    def presented(run: mutable Run&) -> i64:
        can Abort.Panic:
            return run.hits + run.misses

    # `int(round(100 * hits / presented))` -- round-half-even, as Python's
    # round is, and 0 rather than a division by zero on an empty run.
    def accuracy(run: mutable Run&) -> i64:
        can Abort.Panic:
            shown: i64 = presented(run)
            return 0 if shown <= 0
            return py_round_half_even(100.0 * run.hits.f64() / shown.f64())

    # Mean reaction in whole milliseconds, the way the run is reported.
    def mean_ms(run: mutable Run&) -> i64:
        can Abort.Panic:
            return 0 if run.reaction_n <= 0
            total: mutable f64 = 0.0
            for at in 0..<run.reaction_n |run, total|:
                total <- total + Floats::at_ref(&run.reactions, at)
            return py_round_half_even(1000.0 * total / run.reaction_n.f64())
