include "./cipher_lang.elisa"
include "../strings.elisa"

extend CipherLang:
    def name(op: i64) -> cstr:
        return "rev" if op == REV
        return "swap" if op == SWAP
        return "rot" if op == ROT
        return "shift" if op == SHIFT
        return "mul" if op == MUL
        return "affine" if op == AFFINE
        return "sub" if op == SUB
        return "perm" if op == PERM
        return "prefix" if op == PREFIX
        return "diff" if op == DIFF
        return "sort" if op == SORT
        return "conv" if op == CONV
        return "tshift" if op == TSHIFT
        return "mem" if op == MEM
        return "mirror" if op == MIRROR
        return "weave" if op == WEAVE
        return "unweave" if op == UNWEAVE
        return "runs" if op == RUNS
        return "oddshift" if op == ODDSHIFT
        return "xor" if op == XOR
        return "gf" if op == GF
        return "feistel" if op == FEISTEL
        return "fold" if op == FOLD
        return "stride" if op == STRIDE
        return "dedupe" if op == DEDUPE
        return "double" if op == DOUBLE
        return "halve" if op == HALVE
        return "first" if op == FIRST
        return "last" if op == LAST
        return "has" if op == HAS
        return "evens" if op == EVENS
        return "sumeven" if op == SUMEVEN
        return "rises" if op == RISES
        return "tparity" if op == TPARITY
        return "echo" if op == ECHO
        return "same" if op == SAME
        return "pal" if op == PAL
        return "sorted" if op == SORTED
        return "seq" if op == SEQ
        return "if" if op == IF
        return "alt" if op == ALT
        return "except" if op == EXCEPT
        return "prog" if op == PROG
        return "meta"

    def write_code(text: mutable dstr&, program: darray[Node]&, entry: i64):
        can Abort.Panic, Memory.Allocate:
            node: Node& = &program[entry.usize()]
            if node.op == SEQ and node.children.count == 1.usize():
                write_code(text, program, node.children[0])
                return
            dstr_append_cstr(text, name(node.op))
            return if node.op < SEQ and node.args.count == 0.usize() and node.children.count == 0.usize()
            dstr_append_cstr(text, "(")
            if node.op >= SEQ or node.op == FEISTEL:
                for i in 0..<node.children.count.i64() |program, node, text|:
                    dstr_append_cstr(text, ",") if i > 0
                    if node.op == PROG:
                        dstr_append_i64(text, node.args[i.usize()])
                        dstr_append_cstr(text, ":")
                    write_code(text, program, node.children[i.usize()])
            else:
                table: bool = node.op == PERM or node.op == SUB
                dstr_append_cstr(text, "[") if table
                for i in 0..<node.args.count.i64() |text, node|:
                    dstr_append_cstr(text, ",") if i > 0
                    dstr_append_i64(text, node.args[i.usize()])
                dstr_append_cstr(text, "]") if table
            dstr_append_cstr(text, ")")

    def size(program: darray[Node]&, entry: i64) -> i64:
        can Abort.Panic:
            node: Node& = &program[entry.usize()]
            count: mutable i64 = (0 if node.op == SEQ else 1) + node.args.count.i64()
            for child in node.children:
                count <- count + size(program, child)
            return count

    def has_trait(program: darray[Node]&, entry: i64, stateful: bool) -> bool:
        can Abort.Panic:
            node: Node& = &program[entry.usize()]
            op: i64 = node.op
            if stateful:
                return true if op == TSHIFT or op == MEM or op == TPARITY or op == ECHO or op == ALT or op == META
            else:
                return true if op == PERM or op == FEISTEL
            for child in node.children:
                return true if has_trait(program, child, stateful)
            return false

    def uses_state(program: darray[Node]&, entry: i64) -> bool:
        can Abort.Panic:
            return has_trait(program, entry, true)

    def fixed_length(program: darray[Node]&, entry: i64) -> bool:
        can Abort.Panic:
            return has_trait(program, entry, false)

    def equal(program: darray[Node]&, a: i64, b: i64) -> bool:
        can Abort.Panic:
            return true if a == b
            left: Node& = &program[a.usize()]
            right: Node& = &program[b.usize()]
            return false if left.op != right.op or left.args.count != right.args.count or left.children.count != right.children.count
            for i in 0..<left.args.count.i64() |left, right|:
                return false if left.args[i.usize()] != right.args[i.usize()]
            for i in 0..<left.children.count.i64() |program, left, right|:
                return false if not equal(program, left.children[i.usize()], right.children[i.usize()])
            return true

    def add_node(program: mutable darray[Node]&, op: i64, args: darray[i64], children: darray[i64]) -> i64:
        can Abort.Panic, Memory.Allocate:
            index: i64 = program.count.i64()
            program.push(Node{op: op, args: args, children: children})
            return index

    def identity(node: Node, n: i64, k: i64) -> bool:
        can Abort.Panic:
            op: i64 = node.op
            return node.args[0] % n == 0 if op == ROT
            return node.args[0] % k == 0 if op == SHIFT or op == XOR or op == TSHIFT or op == ODDSHIFT
            return node.args[0] % k == 1 if op == MUL
            return false

    def append_canonical(program: mutable darray[Node]&, parts: mutable darray[i64]&, entry: i64, n: i64, k: i64):
        can Abort.Panic, Memory.Allocate:
            p: Node = program[entry.usize()]
            return if identity(p, n, k)
            if parts.count == 0.usize():
                parts.push(entry)
                return
            end: usize = parts.count - 1.usize()
            q: Node = program[parts[end].usize()]
            op: i64 = p.op
            if (q.op == op and (op == REV or op == SWAP)) or (q.op == WEAVE and op == UNWEAVE) or (q.op == UNWEAVE and op == WEAVE):
                _ = parts.pop()
                # Python also checks the newly exposed last step for identity.
                if parts.count > 0.usize() and identity(program[parts[parts.count - 1.usize()].usize()], n, k):
                    _ = parts.pop()
                return
            return if q.op == op and op == SORT
            if q.op != op or (op != ROT and op != SHIFT and op != TSHIFT and op != ODDSHIFT and op != MUL and op != XOR):
                parts.push(entry)
                return
            a: i64 = q.args[0]
            b: i64 = p.args[0]
            value: i64 = modulo(a + b, n) if op == ROT else (modulo(a * b, k) if op == MUL else (a ^ b if op == XOR else modulo(a + b, k)))
            if (op == MUL and value == 1) or (op != MUL and value == 0):
                _ = parts.pop()
            else:
                parts[end] <- add_node(program, op, [value], [])

    def canonical(program: mutable darray[Node]&, entry: i64, n: i64, k: i64) -> i64:
        can Abort.Panic, Memory.Allocate:
            node: Node = program[entry.usize()]
            op: i64 = node.op
            return entry if op < SEQ or op == PROG
            children: mutable darray[i64] = []
            if op == SEQ:
                for child in node.children:
                    normalized: i64 = canonical(program, child, n, k)
                    part: Node = program[normalized.usize()]
                    if part.op == SEQ:
                        for subpart in part.children:
                            append_canonical(program, &children, subpart, n, k)
                    else:
                        append_canonical(program, &children, normalized, n, k)
                return add_node(program, SEQ, [], children)
            offset: i64 = 1 if op == IF or op == META else 0
            if offset == 1:
                children.push(node.children[0])
            first: mutable i64 = -1
            same: mutable bool = true
            for i in offset..<node.children.count.i64() |program, node, children, n, k, first, same|:
                child: i64 = canonical(program, node.children[i.usize()], n, k)
                children.push(child)
                if first < 0:
                    first <- child
                else:
                    same <- same and equal(program, first, child)
            return first if same and first >= 0
            return add_node(program, op, [], children)
