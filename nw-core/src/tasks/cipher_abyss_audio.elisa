include "./cipher_abyss_run.elisa"
include "./drshape_audio.elisa"

module CipherAbyssAudio:
    def render(run: CipherAbyss::Run&, begin: f64, end: f64, output: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            bank: mutable DrShapeAudio::Bank = zeroed
            bank.count <- 7
            patches: i64[7] = [DrShapeAudio::BELL, DrShapeAudio::CHIRP, DrShapeAudio::GROWL,
                DrShapeAudio::BELL, DrShapeAudio::GROWL, DrShapeAudio::WOOD, DrShapeAudio::GROWL]
            made: mutable i64 = 0
            rng: mutable MT19937 = zeroed
            for i in 0..<run.notes.count.i64() |run, begin, end, bank, patches, made, rng|:
                cue: DrShapeDeal::Note = run.notes[i.usize()]
                continue if cue.t >= end or cue.t + (cue.dur + 0.4) <= begin
                bit: i64 = 1 << cue.voice
                if (made & bit) == 0:
                    mt_seed_int(&rng, (cue.voice + 1).u64())
                    bank.patches[cue.voice.usize()] <- DrShapeAudio::make_patch(patches[cue.voice.usize()], &rng, 0.0)
                    made <- made | bit
            return DrShapeAudio::write(&run.notes, &bank, begin, end, output, capacity)
