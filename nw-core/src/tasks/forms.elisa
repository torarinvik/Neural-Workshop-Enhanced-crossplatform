include "../pyrandom.elisa"
include "../strings.elisa"

module Forms:
    # forms.py: a card says who someone is, and a form asks for it field by
    # field, filled with the keyboard alone. Tab moves on, Enter sends the
    # page; a page with a mistake a form can check comes back marked and
    # costs the rung's penalty. Whether the values are the right person's
    # is checked when the last page goes.
    #
    # Python's typed text has no limit; here a value holds MOST_TYPED
    # bytes and further characters are dropped, far past any answer.
    const MOST_TYPED: i64 = 64
    const MOST_CARD: i64 = 24
    const COUNTRY_COUNT: i64 = 40
    const PLAN_COUNT: i64 = 4

    # The fields a form can ask, in the order it asks them.
    const FIRST: i64 = 0
    const LAST: i64 = 1
    const CITY: i64 = 2
    const EMAIL: i64 = 3
    const BORN: i64 = 4
    const PHONE: i64 = 5
    const COUNTRY: i64 = 6
    const PLAN: i64 = 7
    const NEWS: i64 = 8
    const WORK: i64 = 9
    const COMPANY: i64 = 10
    const KEY_COUNT: i64 = 11

    # Kinds of field.
    const TEXT: i64 = 0
    const DATE: i64 = 1
    const DIGITS: i64 = 2
    const CHOICE: i64 = 3
    const CHECK: i64 = 4
    const RADIO: i64 = 5

    # Keys that are not characters; a character is its byte.
    const BACKSPACE: i64 = -1
    const TAB: i64 = -2
    const ENTER: i64 = -3
    const UP: i64 = -4
    const DOWN: i64 = -5
    const NO_KEY: i64 = -9

    struct Grade:
        rung: i64
        dates: bool
        digits: bool
        choices: bool
        checks: bool
        fields: i64
        pages: i64
        letter: bool
        decoys: bool
        conditional: bool
        penalty: i64
        factor: f64
        slack: f64

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 1 else 1
        return Grade{rung: r, dates: r >= 4, digits: r >= 5, choices: r >= 6, checks: r >= 8,
            fields: 12 if 1 + r / 2 > 12 else 1 + r / 2, pages: 1 if r < 12 else (2 if r < 18 else 3), letter: r >= 14,
            decoys: r >= 16, conditional: r >= 10, penalty: 5 + r / 2,
            factor: fmax(1.0, 1.6 - 0.03 * (r - 1).f64()), slack: 4.0 if r < 12 else 2.0}

    def kind_of(key: i64) -> i64:
        return DATE if key == BORN
        return DIGITS if key == PHONE
        return CHOICE if key == COUNTRY
        return RADIO if key == PLAN
        return CHECK if key == NEWS or key == WORK
        return TEXT

    # A typed or dealt value.
    struct Text:
        bytes: mutable u8[64]
        count: mutable i64

    def push(text: mutable Text&, byte: u8):
        if text.count < MOST_TYPED:
            text.bytes[text.count.usize()] <- byte
            text.count <- text.count + 1

    def put(text: mutable Text&, words: cstr):
        can Memory.Allocate, Abort.Panic:
            spelled: mutable dstr = []
            dstr_append_cstr(&spelled, words)
            for byte in spelled |text|:
                push(text, byte)

    def put_number(text: mutable Text&, value: i64, width: i64):
        can Memory.Allocate, Abort.Panic:
            spelled: mutable dstr = []
            dstr_append_i64(&spelled, value)
            for _ in spelled.count.i64()..<width |text|:
                push(text, 48.u8())
            for byte in spelled |text|:
                push(text, byte)

    def append(text: mutable Text&, more: Text&):
        for at in 0..<more.count |text, more|:
            push(text, more.bytes[at.usize()])

    def lower(byte: u8) -> u8:
        return byte + 32.u8() if byte >= 65.u8() and byte <= 90.u8() else byte

    def lowered(text: Text) -> Text:
        out: mutable Text = text
        for at in 0..<text.count |out|:
            out.bytes[at.usize()] <- lower(out.bytes[at.usize()])
        return out

    def same_text(one: Text&, two: Text&) -> bool:
        return false if one.count != two.count
        for at in 0..<one.count |one, two|:
            return false if one.bytes[at.usize()] != two.bytes[at.usize()]
        return true

    def first_name(index: i64) -> cstr:
        names: array[cstr, 24] = ["Ada", "Ben", "Cleo", "Dan", "Eva", "Finn", "Gus", "Hana", "Ida", "Jon", "Kai", "Lena", "Mia", "Noor",
            "Omar", "Pia", "Rex", "Sara", "Tom", "Una", "Vic", "Wes", "Yara", "Zoe"]
        return names[index.usize()]

    def last_name(index: i64) -> cstr:
        names: array[cstr, 20] = ["Lee", "Berg", "Dahl", "Moe", "Holm", "Lund", "Ruiz", "Sato", "Klein", "Novak", "Okafor", "Park",
            "Quist", "Rossi", "Stone", "Tran", "Vega", "West", "Young", "Zhou"]
        return names[index.usize()]

    def month_name(month: i64) -> cstr:
        names: array[cstr, 12] = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October",
            "November", "December"]
        return names[(month - 1).usize()]

    def country_name(index: i64) -> cstr:
        names: array[cstr, 40] = ["Argentina", "Australia", "Austria", "Belgium", "Brazil", "Canada", "Chile", "China", "Colombia",
            "Croatia", "Denmark", "Egypt", "Estonia", "Finland", "France", "Germany", "Ghana", "Greece", "Iceland", "India",
            "Ireland", "Italy", "Japan", "Kenya", "Mexico", "Morocco", "Nepal", "Netherlands", "New Zealand", "Nigeria", "Norway",
            "Peru", "Poland", "Portugal", "Spain", "Sweden", "Switzerland", "Turkey", "Uganda", "Uruguay"]
        return names[index.usize()]

    def city_name(index: i64) -> cstr:
        names: array[cstr, 14] = ["Oslo", "Bergen", "Lyon", "Porto", "Turin", "Ghent", "Cork", "Graz", "Malmo", "Turku", "Split", "Delft",
            "Leeds", "Basel"]
        return names[index.usize()]

    def plan_name(index: i64) -> cstr:
        names: array[cstr, 4] = ["Basic", "Plus", "Pro", "Team"]
        return names[index.usize()]

    def domain_name(index: i64) -> cstr:
        names: array[cstr, 4] = ["mail.com", "post.net", "inbox.org", "web.io"]
        return names[index.usize()]

    def company_name(index: i64) -> cstr:
        names: array[cstr, 7] = ["Acme", "Brightside", "Copperleaf", "Dunmore", "Everglow", "Fairway", "Greystone"]
        return names[index.usize()]

    def option_count(key: i64) -> i64:
        return COUNTRY_COUNT if key == COUNTRY else (PLAN_COUNT if key == PLAN else 0)

    def option_name(key: i64, index: i64) -> cstr:
        return country_name(index) if key == COUNTRY else plan_name(index)

    def label(key: i64) -> cstr:
        labels: array[cstr, 11] = ["First name", "Last name", "City", "Email", "Date of birth", "Phone", "Country", "Plan",
            "Send me the newsletter", "I am signing up for a company", "Company name"]
        return labels[key.usize()]

    def hint(key: i64) -> cstr:
        return "DD/MM/YYYY" if key == BORN
        return "digits only" if key == PHONE
        return "type to search" if key == COUNTRY
        return ""

    # _person: who the card is about. `company` is -1 for none.
    struct Person:
        first: i64
        last: i64
        year: i64
        month: i64
        day: i64
        phone: i64
        domain: i64
        country: i64
        city: i64
        plan: i64
        news: bool
        company: i64

    def person(draw: mutable MT19937&) -> Person:
        can Abort.Panic:
            first: i64 = py_choice_index(draw, 24)
            last: i64 = py_choice_index(draw, 20)
            year: i64 = py_randint(draw, 1950, 2005)
            month: i64 = py_randint(draw, 1, 12)
            day: i64 = py_randint(draw, 1, 28)
            lead: i64 = py_randint(draw, 2, 9)
            phone: i64 = lead * 10000000 + py_randint(draw, 1000000, 9999999)
            domain: i64 = py_choice_index(draw, 4)
            country: i64 = py_randrange(draw, 0, COUNTRY_COUNT)
            city: i64 = py_choice_index(draw, 14)
            plan: i64 = py_randrange(draw, 0, PLAN_COUNT)
            news: bool = py_random(draw) < 0.5
            # random() first, then choice() only when it says so.
            has_company: bool = py_random(draw) < 0.6
            company: i64 = py_choice_index(draw, 7) if has_company else -1
            return Person{first: first, last: last, year: year, month: month, day: day, phone: phone, domain: domain,
                country: country, city: city, plan: plan, news: news, company: company}

    def name(out: mutable Text&, who: Person&):
        can Memory.Allocate, Abort.Panic:
            put(out, first_name(who.first))
            push(out, 32.u8())
            put(out, last_name(who.last))

    def email(out: mutable Text&, who: Person&):
        can Memory.Allocate, Abort.Panic:
            start: i64 = out.count
            put(out, first_name(who.first))
            push(out, 46.u8())
            put(out, last_name(who.last))
            for at in start..<out.count |out|:
                out.bytes[at.usize()] <- lower(out.bytes[at.usize()])
            push(out, 64.u8())
            put(out, domain_name(who.domain))

    def spoken_date(out: mutable Text&, who: Person&):
        can Memory.Allocate, Abort.Panic:
            put_number(out, who.day, 0)
            push(out, 32.u8())
            put(out, month_name(who.month))
            push(out, 32.u8())
            put_number(out, who.year, 0)

    def spoken_phone(out: mutable Text&, who: Person&):
        can Memory.Allocate, Abort.Panic:
            digits: mutable Text = zeroed
            put_number(&digits, who.phone, 0)
            put(out, "+47 ")
            for at in 0..<digits.count |out, digits|:
                push(out, 32.u8()) if at == 3 or at == 5
                push(out, digits.bytes[at.usize()])

    # What a text-like field must end up holding.
    def answer_text(who: Person&, key: i64) -> Text:
        can Memory.Allocate, Abort.Panic:
            out: mutable Text = zeroed
            if key == FIRST:
                put(&out, first_name(who.first))
            elif key == LAST:
                put(&out, last_name(who.last))
            elif key == CITY:
                put(&out, city_name(who.city))
            elif key == EMAIL:
                email(&out, who)
            elif key == BORN:
                put_number(&out, who.day, 2)
                push(&out, 47.u8())
                put_number(&out, who.month, 2)
                push(&out, 47.u8())
                put_number(&out, who.year, 4)
            elif key == PHONE:
                put(&out, "47")
                put_number(&out, who.phone, 0)
            elif key == COMPANY and who.company >= 0:
                put(&out, company_name(who.company))
            return out

    # What a list, radio or checkbox field must end up holding.
    def answer_index(who: Person&, key: i64) -> i64:
        return who.country if key == COUNTRY
        return who.plan if key == PLAN
        return (1 if who.news else 0) if key == NEWS
        return (1 if who.company >= 0 else 0) if key == WORK
        return 0

    struct Field:
        key: mutable i64
        page: mutable i64

    struct Deal:
        level: Grade
        who: Person
        field_count: mutable i64
        fields: mutable Field[11]
        card_count: mutable i64
        card: mutable Text[24]

    # The newest kinds first, so a rung always asks what it adds.
    def priority(key: i64) -> i64:
        order: i64[11] = [FIRST, WORK, COMPANY, COUNTRY, PLAN, NEWS, PHONE, BORN, LAST, EMAIL, CITY]
        for at in 0..<KEY_COUNT |order, key|:
            return at if order[at.usize()] == key
        return KEY_COUNT

    def in_pool(level: Grade&, key: i64) -> bool:
        return level.dates if key == BORN
        return level.digits if key == PHONE
        return level.choices if key == COUNTRY
        return level.checks if key == PLAN or key == NEWS
        return level.conditional if key == WORK or key == COMPANY
        return true

    def deal(rung: i64, draw: mutable MT19937&) -> Deal:
        can Memory.Allocate, Abort.Panic:
            level: Grade = grade(rung)
            who: Person = person(draw)
            # The rung's number of fields by priority, then a conditional
            # field only with its condition, in the order a form asks.
            taken: mutable bool[11] = zeroed
            count: mutable i64 = 0
            for rank in 0..<KEY_COUNT |taken, count, level|:
                for key in 0..<KEY_COUNT |taken, count, level, rank|:
                    if priority(key) == rank and in_pool(&level, key) and count < level.fields:
                        taken[key.usize()] <- true
                        count <- count + 1
            taken[COMPANY.usize()] <- false if not taken[WORK.usize()]
            out: mutable Deal = Deal{level: level, who: who, field_count: 0, fields: zeroed, card_count: 0, card: zeroed}
            for key in 0..<KEY_COUNT |out, taken|:
                if taken[key.usize()]:
                    out.fields[out.field_count.usize()] <- Field{key: key, page: 0}
                    out.field_count <- out.field_count + 1
            if level.pages > 1:
                per: i64 = (out.field_count + level.pages - 1) / level.pages
                for index in 0..<out.field_count |out, level, per|:
                    page: mutable i64 = imin(level.pages - 1, index / per)
                    if out.fields[index.usize()].key == COMPANY:
                        # A conditional field shares its condition's page.
                        for other in 0..<index |out, page|:
                            page <- out.fields[other.usize()].page if out.fields[other.usize()].key == WORK
                    out.fields[index.usize()].page <- page
            card(&out, draw)
            return out

    def imin(one: i64, two: i64) -> i64:
        return one if one < two else two

    def asks(dealt: Deal&, key: i64) -> bool:
        for at in 0..<dealt.field_count |dealt, key|:
            return true if dealt.fields[at.usize()].key == key
        return false

    def add_line(dealt: mutable Deal&, line: Text):
        if dealt.card_count < MOST_CARD:
            dealt.card[dealt.card_count.usize()] <- line
            dealt.card_count <- dealt.card_count + 1

    def fact(dealt: mutable Deal&, words: cstr, value: Text):
        can Memory.Allocate, Abort.Panic:
            line: mutable Text = zeroed
            put(&line, words)
            append(&line, &value)
            add_line(dealt, line)

    def said(words: cstr) -> Text:
        can Memory.Allocate, Abort.Panic:
            out: mutable Text = zeroed
            put(&out, words)
            return out

    # _card: the facts as a list, or from rung 14 as a letter.
    def card(dealt: mutable Deal&, draw: mutable MT19937&):
        can Memory.Allocate, Abort.Panic:
            who: Person = dealt.who
            if not dealt.level.letter:
                if asks(dealt, FIRST) or asks(dealt, LAST):
                    whole: mutable Text = zeroed
                    name(&whole, &who)
                    fact(dealt, "Name: ", whole)
                fact(dealt, "City: ", said(city_name(who.city))) if asks(dealt, CITY)
                if asks(dealt, EMAIL):
                    address: mutable Text = zeroed
                    email(&address, &who)
                    fact(dealt, "Email: ", address)
                if asks(dealt, BORN):
                    born: mutable Text = zeroed
                    spoken_date(&born, &who)
                    fact(dealt, "Born: ", born)
                if asks(dealt, PHONE):
                    number: mutable Text = zeroed
                    spoken_phone(&number, &who)
                    fact(dealt, "Phone: ", number)
                fact(dealt, "Country: ", said(country_name(who.country))) if asks(dealt, COUNTRY)
                fact(dealt, "Plan: ", said(plan_name(who.plan))) if asks(dealt, PLAN)
                fact(dealt, "Newsletter: ", said("yes" if who.news else "no")) if asks(dealt, NEWS)
                if asks(dealt, WORK):
                    fact(dealt, "Company: ", said(company_name(who.company) if who.company >= 0 else "none, signing up for myself"))
                return
            letter(dealt, &who, draw)

    def letter(dealt: mutable Deal&, who: Person&, draw: mutable MT19937&):
        can Memory.Allocate, Abort.Panic:
            words: mutable dstr = []
            dstr_append_cstr(&words, "Hello! I am ")
            whole: mutable Text = zeroed
            name(&whole, who)
            spell(&words, &whole)
            dstr_append_cstr(&words, " and I live in ")
            dstr_append_cstr(&words, city_name(who.city))
            dstr_append_cstr(&words, ", ")
            dstr_append_cstr(&words, country_name(who.country))
            dstr_append_cstr(&words, ".")
            wrap(dealt, &words)
            if dealt.level.decoys:
                sister: Person = person(draw)
                words <- []
                dstr_append_cstr(&words, "My sister ")
                dstr_append_cstr(&words, first_name(sister.first))
                dstr_append_cstr(&words, " was born on ")
                spoken: mutable Text = zeroed
                spoken_date(&spoken, &sister)
                spell(&words, &spoken)
                dstr_append_cstr(&words, "; her number is ")
                number: mutable Text = zeroed
                spoken_phone(&number, &sister)
                spell(&words, &number)
                dstr_append_cstr(&words, ".")
                wrap(dealt, &words)
            words <- []
            dstr_append_cstr(&words, "I was born on ")
            born: mutable Text = zeroed
            spoken_date(&born, who)
            spell(&words, &born)
            dstr_append_cstr(&words, ". Call me on ")
            phone: mutable Text = zeroed
            spoken_phone(&phone, who)
            spell(&words, &phone)
            dstr_append_cstr(&words, " or write to ")
            address: mutable Text = zeroed
            email(&address, who)
            spell(&words, &address)
            dstr_append_cstr(&words, ".")
            wrap(dealt, &words)
            words <- []
            dstr_append_cstr(&words, "I would like the ")
            dstr_append_cstr(&words, plan_name(who.plan))
            dstr_append_cstr(&words, " plan, and ")
            dstr_append_cstr(&words, "yes, send me the newsletter" if who.news else "no newsletter, thanks")
            dstr_append_cstr(&words, ".")
            wrap(dealt, &words)
            if dealt.level.decoys:
                words <- []
                dstr_append_cstr(&words, "(My sister wants the ")
                dstr_append_cstr(&words, plan_name((who.plan + 1) % PLAN_COUNT))
                dstr_append_cstr(&words, " plan, but she will sign up herself.)")
                wrap(dealt, &words)
            words <- []
            if who.company >= 0:
                dstr_append_cstr(&words, "I work for ")
                dstr_append_cstr(&words, company_name(who.company))
                dstr_append_cstr(&words, " and this is for the company.")
            else:
                dstr_append_cstr(&words, "This is just for me, not a company.")
            wrap(dealt, &words)

    def spell(out: mutable dstr&, text: Text&):
        can Memory.Allocate, Abort.Panic:
            for at in 0..<text.count |out, text|:
                out.push(text.bytes[at.usize()])

    # The letter's lines broken into rows of at most 38 characters.
    def wrap(dealt: mutable Deal&, line: dstr&):
        can Memory.Allocate, Abort.Panic:
            row: mutable Text = zeroed
            length: i64 = line.count.i64()
            at: mutable i64 = 0
            while at < length |dealt, line, row, length, at|:
                while at < length and line[at.usize()] == 32.u8() |line, length, at|:
                    at <- at + 1
                break if at >= length
                start: i64 = at
                while at < length and line[at.usize()] != 32.u8() |line, length, at|:
                    at <- at + 1
                if row.count + (at - start) + 1 > 38:
                    add_line(dealt, row)
                    row <- zeroed
                else:
                    push(&row, 32.u8()) if row.count > 0
                for byte in start..<at |row, line|:
                    push(&row, line[byte.usize()])
            add_line(dealt, row)
