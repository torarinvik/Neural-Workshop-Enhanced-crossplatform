# Stateful common-v1 adapter for Matrix Reasoning.
#
# The Ravens kernel owns generation, rule selection, near-miss construction,
# panel geometry, and the answer permutation.  This adapter owns the durable
# run boundary: it copies the generated panels and explanation facts out of a
# temporary generation region, then keeps the source UI's asking/hidden/
# feedback/done lifecycle between ABI calls.  The browser never supplies a
# puzzle or an answer; it only supplies the selected candidate.

module MatrixReasoningGame:

    const MAX_PANELS: i64 = Ravens::MOST_PANELS
    const MAX_CHOICES: i64 = Ravens::MOST_CHOICE_PANELS
    const MAX_FIGURES: i64 = Ravens::MOST_FIGURES
    const MAX_LINES: i64 = Ravens::MOST_SLOT_ATTRS

    const PHASE_READY: i64 = 0
    const PHASE_ASKING: i64 = 1
    const PHASE_HIDDEN: i64 = 2
    const PHASE_FEEDBACK: i64 = 3
    const PHASE_DONE: i64 = 4

    const ACTION_START: i64 = 0
    const ACTION_ANSWER: i64 = 1

    const INFO_PHASE: i64 = 0
    const INFO_LEVEL: i64 = 1
    const INFO_TRIAL: i64 = 2
    const INFO_TOTAL_TRIALS: i64 = 3
    const INFO_ACROSS: i64 = 4
    const INFO_CHOICES: i64 = 5
    const INFO_ANSWER: i64 = 6
    const INFO_PICKED: i64 = 7
    const INFO_CORRECT: i64 = 8
    const INFO_VERDICT: i64 = 9
    const INFO_EXPOSURE_MS: i64 = 10
    const INFO_ADAPTIVE: i64 = 11
    const INFO_FEEDBACK: i64 = 12
    const INFO_EXPLAIN: i64 = 13
    const INFO_COLOR: i64 = 14
    const INFO_TRIAL_LEVEL: i64 = 15
    const INFO_LINES: i64 = 16
    const INFO_HAS_PUZZLE: i64 = 17
    const INFO_ANSWERED: i64 = 18
    const INFO_MEAN_MS: i64 = 19
    const INFO_ASKED_AT_MS: i64 = 20
    const INFO_FEEDBACK_UNTIL_MS: i64 = 21

    const VALUE_GRID_COUNT: i64 = 0
    const VALUE_CHOICE_COUNT: i64 = 1
    const VALUE_SHAPE: i64 = 2
    const VALUE_FILL: i64 = 3
    const VALUE_ANGLE: i64 = 4
    const VALUE_PART: i64 = 5
    const VALUE_CX_MICRO: i64 = 6
    const VALUE_CY_MICRO: i64 = 7
    const VALUE_RADIUS_MICRO: i64 = 8
    const VALUE_LINE_PART: i64 = 9
    const VALUE_LINE_ATTR: i64 = 10
    const VALUE_LINE_KIND: i64 = 11
    const VALUE_LINE_PARAM: i64 = 12
    # Choice-panel attributes are diagnostic-only accessors used by the
    # controller/source differential.  The public state still exposes only
    # the answer index, never the answer through the ordinary state envelope.
    const VALUE_CHOICE_SHAPE: i64 = 13
    const VALUE_CHOICE_FILL: i64 = 14
    const VALUE_CHOICE_ANGLE: i64 = 15
    const VALUE_CHOICE_PART: i64 = 16
    const VALUE_CHOICE_CX_MICRO: i64 = 17
    const VALUE_CHOICE_CY_MICRO: i64 = 18
    const VALUE_CHOICE_RADIUS_MICRO: i64 = 19

    # The v1 option slots encode all source options without losing one to the
    # fixed six-slot ABI: e is a bit field (feedback bit 0, explanation bit 1),
    # while f remains the source colour-palette flag.
    const FEEDBACK_BIT: i64 = 1
    const EXPLAIN_BIT: i64 = 2

    const FEEDBACK_MS: i64 = 900
    const EXPLAIN_FEEDBACK_MS: i64 = 1600

    struct MatrixReasoningRun:
        rng: mutable MT19937
        start_level: mutable i64
        level: mutable i64
        total_trials: mutable i64
        exposure_ms: mutable i64
        adaptive: mutable bool
        feedback: mutable bool
        explain: mutable bool
        color: mutable bool
        trial: mutable i64
        trial_level: mutable i64
        correct: mutable i64
        answered: mutable i64
        total_time_ms: mutable i64
        phase: mutable i64
        verdict: mutable i64
        picked: mutable i64
        hovered: mutable i64
        asked_at_ms: mutable i64
        feedback_until_ms: mutable i64
        across: mutable i64
        choices: mutable i64
        answer: mutable i64
        has_puzzle: mutable bool
        palette: mutable i64
        lines: mutable i64
        grid_n: mutable i64
        choice_n: mutable i64
        grid_count: mutable i64[MAX_PANELS]
        choice_count: mutable i64[MAX_CHOICES]
        grid_shape: mutable i64[MAX_PANELS * MAX_FIGURES]
        choice_shape: mutable i64[MAX_CHOICES * MAX_FIGURES]
        grid_fill: mutable i64[MAX_PANELS * MAX_FIGURES]
        choice_fill: mutable i64[MAX_CHOICES * MAX_FIGURES]
        grid_angle: mutable i64[MAX_PANELS * MAX_FIGURES]
        choice_angle: mutable i64[MAX_CHOICES * MAX_FIGURES]
        grid_part: mutable i64[MAX_PANELS * MAX_FIGURES]
        choice_part: mutable i64[MAX_CHOICES * MAX_FIGURES]
        grid_cx: mutable f64[MAX_PANELS * MAX_FIGURES]
        choice_cx: mutable f64[MAX_CHOICES * MAX_FIGURES]
        grid_cy: mutable f64[MAX_PANELS * MAX_FIGURES]
        choice_cy: mutable f64[MAX_CHOICES * MAX_FIGURES]
        grid_radius: mutable f64[MAX_PANELS * MAX_FIGURES]
        choice_radius: mutable f64[MAX_CHOICES * MAX_FIGURES]
        line_part: mutable i64[MAX_LINES]
        line_attr: mutable i64[MAX_LINES]
        line_kind: mutable i64[MAX_LINES]
        line_param: mutable i64[MAX_LINES]

    def clamp_level(value: i64) -> i64:
        can Abort.Panic:
            return 1 if value < 1 else (Ravens::GRADE_COUNT if value > Ravens::GRADE_COUNT else value)

    def allowed_trials(value: i64) -> bool:
        can Abort.Panic:
            return value == 5 or value == 10 or value == 15 or value == 20 or value == 30 or value == 50 or value == 80 or value == 100

    def allowed_exposure(value: i64) -> bool:
        can Abort.Panic:
            return value == 0 or value == 10000 or value == 20000 or value == 30000 or value == 45000 or value == 60000

    def allowed_flags(value: i64) -> bool:
        can Abort.Panic:
            return value >= 0 and value <= 3

    def allowed_bool(value: i64) -> bool:
        can Abort.Panic:
            return value == 0 or value == 1

    def clear_panels(run: mutable MatrixReasoningRun&):
        can Abort.Panic:
            run.grid_n <- 0
            run.choice_n <- 0
            run.across <- 0
            run.choices <- 0
            run.answer <- -1
            run.palette <- 0
            run.lines <- 0
            run.has_puzzle <- false
            for panel in 0..<MAX_PANELS |panel, run|:
                run.grid_count[panel.usize()] <- 0
            for panel in 0..<MAX_CHOICES |panel, run|:
                run.choice_count[panel.usize()] <- 0

    def clear_run_arrays(run: mutable MatrixReasoningRun&):
        can Abort.Panic:
            for panel in 0..<MAX_PANELS |panel, run|:
                run.grid_count[panel.usize()] <- 0
                for at in 0..<MAX_FIGURES |panel, at, run|:
                    index: i64 = panel * MAX_FIGURES + at
                    run.grid_shape[index.usize()] <- 0
                    run.grid_fill[index.usize()] <- 0
                    run.grid_angle[index.usize()] <- 0
                    run.grid_part[index.usize()] <- 0
                    run.grid_cx[index.usize()] <- 0.0
                    run.grid_cy[index.usize()] <- 0.0
                    run.grid_radius[index.usize()] <- 0.0
            for panel in 0..<MAX_CHOICES |panel, run|:
                run.choice_count[panel.usize()] <- 0
                for at in 0..<MAX_FIGURES |panel, at, run|:
                    index: i64 = panel * MAX_FIGURES + at
                    run.choice_shape[index.usize()] <- 0
                    run.choice_fill[index.usize()] <- 0
                    run.choice_angle[index.usize()] <- 0
                    run.choice_part[index.usize()] <- 0
                    run.choice_cx[index.usize()] <- 0.0
                    run.choice_cy[index.usize()] <- 0.0
                    run.choice_radius[index.usize()] <- 0.0
            for at in 0..<MAX_LINES |at, run|:
                run.line_part[at.usize()] <- 0
                run.line_attr[at.usize()] <- 0
                run.line_kind[at.usize()] <- 0
                run.line_param[at.usize()] <- 0

    def copy_panel(run: mutable MatrixReasoningRun&, grid: bool, into: i64,
                   panels: mutable Ravens::Panels&, from_at: i64):
        can Abort.Panic:
            held: mutable i64 = Ints::at_ref(&panels.count, from_at)
            held <- MAX_FIGURES if held > MAX_FIGURES
            if grid:
                run.grid_count[into.usize()] <- held
                for at in 0..<held |run, panels, into, from_at, at|:
                    source: i64 = from_at * MAX_FIGURES + at
                    target: i64 = into * MAX_FIGURES + at
                    run.grid_shape[target.usize()] <- Ints::at_ref(&panels.shape, source)
                    run.grid_fill[target.usize()] <- Ints::at_ref(&panels.fill, source)
                    run.grid_angle[target.usize()] <- Ints::at_ref(&panels.angle, source)
                    run.grid_part[target.usize()] <- Ints::at_ref(&panels.part, source)
                    run.grid_cx[target.usize()] <- Floats::at_ref(&panels.cx, source)
                    run.grid_cy[target.usize()] <- Floats::at_ref(&panels.cy, source)
                    run.grid_radius[target.usize()] <- Floats::at_ref(&panels.radius, source)
                return
            run.choice_count[into.usize()] <- held
            for at in 0..<held |run, panels, into, from_at, at|:
                source: i64 = from_at * MAX_FIGURES + at
                target: i64 = into * MAX_FIGURES + at
                run.choice_shape[target.usize()] <- Ints::at_ref(&panels.shape, source)
                run.choice_fill[target.usize()] <- Ints::at_ref(&panels.fill, source)
                run.choice_angle[target.usize()] <- Ints::at_ref(&panels.angle, source)
                run.choice_part[target.usize()] <- Ints::at_ref(&panels.part, source)
                run.choice_cx[target.usize()] <- Floats::at_ref(&panels.cx, source)
                run.choice_cy[target.usize()] <- Floats::at_ref(&panels.cy, source)
                run.choice_radius[target.usize()] <- Floats::at_ref(&panels.radius, source)

    def copy_puzzle(run: mutable MatrixReasoningRun&, puzzle: mutable Ravens::Puzzle&):
        can Abort.Panic:
            clear_panels(run)
            run.across <- puzzle.across
            run.choices <- puzzle.offered.n
            run.answer <- puzzle.answer
            run.palette <- puzzle.palette
            run.grid_n <- puzzle.grid.n
            run.choice_n <- puzzle.offered.n
            run.lines <- puzzle.lines if puzzle.lines < MAX_LINES else MAX_LINES
            for panel in 0..<MAX_PANELS |panel, run, puzzle|:
                if panel < puzzle.grid.n:
                    copy_panel(run, true, panel, puzzle.grid, panel)
            for panel in 0..<MAX_CHOICES |panel, run, puzzle|:
                if panel < puzzle.offered.n:
                    copy_panel(run, false, panel, puzzle.offered, panel)
            for at in 0..<run.lines |at, run, puzzle|:
                run.line_part[at.usize()] <- Ints::at_ref(&puzzle.line_part, at)
                run.line_attr[at.usize()] <- Ints::at_ref(&puzzle.line_attr, at)
                run.line_kind[at.usize()] <- Ints::at_ref(&puzzle.line_kind, at)
                run.line_param[at.usize()] <- Ints::at_ref(&puzzle.line_param, at)
            run.has_puzzle <- puzzle.dealt and run.grid_n > 0 and run.choice_n > 0

    def deal_trial(run: mutable MatrixReasoningRun&) -> bool:
        can Memory.Allocate, Abort.Panic:
            clear_panels(run)
            seed: i64 = py_randbelow(&run.rng, 1073741824.u64()).i64()
            palettes: i64 = 2 if run.color else 1
            region deal_scratch(268435456):
                in deal_scratch:
                    deal_rng: mutable MT19937 = mt19937_new()
                    mt_seed_int(&deal_rng, seed.u64())
                    puzzle: mutable Ravens::Puzzle = Ravens::new_puzzle()
                    dealt: mutable Ravens::Dealt = Ravens::new_dealt()
                    offered: mutable Ravens::Panels = Ravens::new_panels(Ravens::MOST_CHOICE_PANELS)
                    made: bool = Ravens::generate(puzzle, dealt, offered, run.level,
                                                  palettes, Ravens::PATIENCE, &deal_rng)
                    if made:
                        copy_puzzle(run, &puzzle)
                destroy deal_scratch
            return run.has_puzzle

    def next_trial(run: mutable MatrixReasoningRun&, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            if run.trial >= run.total_trials:
                run.phase <- PHASE_DONE
                run.has_puzzle <- false
                run.verdict <- -1
                return
            run.trial <- run.trial + 1
            run.trial_level <- run.level
            made: mutable bool = false
            for _retry in 0..<4 |run, now_ms, made|:
                break if made
                made <- deal_trial(run)
            run.asked_at_ms <- now_ms
            run.feedback_until_ms <- 0
            run.picked <- -1
            run.hovered <- -1
            run.verdict <- -1
            run.phase <- PHASE_ASKING if made else PHASE_DONE

    def reset(run: mutable MatrixReasoningRun&):
        can Abort.Panic:
            run.level <- run.start_level
            run.trial <- 0
            run.trial_level <- run.level
            run.correct <- 0
            run.answered <- 0
            run.total_time_ms <- 0
            run.phase <- PHASE_READY
            run.verdict <- -1
            run.picked <- -1
            run.hovered <- -1
            run.asked_at_ms <- 0
            run.feedback_until_ms <- 0
            clear_panels(run)
            clear_run_arrays(run)

    def initialize(run: mutable MatrixReasoningRun&, start_level: i64, total_trials: i64,
                   exposure_ms: i64, adaptive: bool, flags: i64,
                   color: bool, seed: i64):
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            run.rng <- rng
            run.start_level <- clamp_level(start_level)
            run.level <- run.start_level
            run.total_trials <- total_trials
            run.exposure_ms <- exposure_ms
            run.adaptive <- adaptive
            run.feedback <- (flags & FEEDBACK_BIT) != 0
            run.explain <- (flags & EXPLAIN_BIT) != 0
            run.color <- color
            reset(run)

    def start_run(run: mutable MatrixReasoningRun&, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            reset(run)
            next_trial(run, now_ms)

    def apply(run: mutable MatrixReasoningRun&, action: i64, value: i64, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            if action == ACTION_START:
                return 2 if run.phase != PHASE_READY and run.phase != PHASE_DONE
                start_run(run, now_ms)
                return 1 if run.phase == PHASE_ASKING else 2
            if action == ACTION_ANSWER:
                return answer(run, value, now_ms)
            return -6

    def adapt(run: mutable MatrixReasoningRun&, right: bool):
        can Abort.Panic:
            return if not run.adaptive
            run.level <- clamp_level(run.level + (1 if right else -1))

    def answer(run: mutable MatrixReasoningRun&, choice: i64, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 2 if run.phase != PHASE_ASKING and run.phase != PHASE_HIDDEN
            return 2 if choice < 0 or choice >= run.choices
            right: bool = choice == run.answer
            run.picked <- choice
            run.hovered <- -1
            run.answered <- run.answered + 1
            run.correct <- run.correct + 1 if right
            run.total_time_ms <- run.total_time_ms + (now_ms - run.asked_at_ms if now_ms >= run.asked_at_ms else 0)
            adapt(run, right)
            if run.feedback:
                run.phase <- PHASE_FEEDBACK
                run.verdict <- 1 if right else 0
                run.feedback_until_ms <- now_ms + (EXPLAIN_FEEDBACK_MS if run.explain else FEEDBACK_MS)
                return 1
            next_trial(run, now_ms)
            return 1

    def advance(run: mutable MatrixReasoningRun&, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            if run.phase == PHASE_FEEDBACK and now_ms >= run.feedback_until_ms:
                next_trial(run, now_ms)
                return 1
            if run.phase == PHASE_ASKING and run.exposure_ms > 0 and now_ms >= run.asked_at_ms + run.exposure_ms:
                run.phase <- PHASE_HIDDEN
                return 1
            return 2

    def info(run: MatrixReasoningRun&, field: i64) -> i64:
        can Abort.Panic:
            if field == INFO_PHASE: return run.phase
            if field == INFO_LEVEL: return run.level
            if field == INFO_TRIAL: return run.trial
            if field == INFO_TOTAL_TRIALS: return run.total_trials
            if field == INFO_ACROSS: return run.across
            if field == INFO_CHOICES: return run.choices
            if field == INFO_ANSWER: return run.answer
            if field == INFO_PICKED: return run.picked
            if field == INFO_CORRECT: return run.correct
            if field == INFO_VERDICT: return run.verdict
            if field == INFO_EXPOSURE_MS: return run.exposure_ms
            if field == INFO_ADAPTIVE: return 1 if run.adaptive else 0
            if field == INFO_FEEDBACK: return 1 if run.feedback else 0
            if field == INFO_EXPLAIN: return 1 if run.explain else 0
            if field == INFO_COLOR: return 1 if run.color else 0
            if field == INFO_TRIAL_LEVEL: return run.trial_level
            if field == INFO_LINES: return run.lines
            if field == INFO_HAS_PUZZLE: return 1 if run.has_puzzle else 0
            if field == INFO_ANSWERED: return run.answered
            if field == INFO_MEAN_MS: return 0 if run.answered <= 0 else run.total_time_ms / run.answered
            if field == INFO_ASKED_AT_MS: return run.asked_at_ms
            if field == INFO_FEEDBACK_UNTIL_MS: return run.feedback_until_ms
            return -1

    def value(run: MatrixReasoningRun&, field: i64, at: i64) -> i64:
        can Abort.Panic:
            if field == VALUE_GRID_COUNT:
                return -1 if at < 0 or at >= run.grid_n else run.grid_count[at.usize()]
            if field == VALUE_CHOICE_COUNT:
                return -1 if at < 0 or at >= run.choice_n else run.choice_count[at.usize()]
            if field == VALUE_LINE_PART:
                return -1 if at < 0 or at >= run.lines else run.line_part[at.usize()]
            if field == VALUE_LINE_ATTR:
                return -1 if at < 0 or at >= run.lines else run.line_attr[at.usize()]
            if field == VALUE_LINE_KIND:
                return -1 if at < 0 or at >= run.lines else run.line_kind[at.usize()]
            if field == VALUE_LINE_PARAM:
                return -1 if at < 0 or at >= run.lines else run.line_param[at.usize()]
            if field == VALUE_CHOICE_SHAPE:
                return -1 if at < 0 or at >= MAX_CHOICES * MAX_FIGURES else run.choice_shape[at.usize()]
            if field == VALUE_CHOICE_FILL:
                return -1 if at < 0 or at >= MAX_CHOICES * MAX_FIGURES else run.choice_fill[at.usize()]
            if field == VALUE_CHOICE_ANGLE:
                return -1 if at < 0 or at >= MAX_CHOICES * MAX_FIGURES else run.choice_angle[at.usize()]
            if field == VALUE_CHOICE_PART:
                return -1 if at < 0 or at >= MAX_CHOICES * MAX_FIGURES else run.choice_part[at.usize()]
            if field == VALUE_CHOICE_CX_MICRO:
                return -1 if at < 0 or at >= MAX_CHOICES * MAX_FIGURES else (run.choice_cx[at.usize()] * 1000000.0).i64()
            if field == VALUE_CHOICE_CY_MICRO:
                return -1 if at < 0 or at >= MAX_CHOICES * MAX_FIGURES else (run.choice_cy[at.usize()] * 1000000.0).i64()
            if field == VALUE_CHOICE_RADIUS_MICRO:
                return -1 if at < 0 or at >= MAX_CHOICES * MAX_FIGURES else (run.choice_radius[at.usize()] * 1000000.0).i64()
            return -1 if at < 0 or at >= MAX_PANELS * MAX_FIGURES else (run.grid_shape[at.usize()] if field == VALUE_SHAPE else (run.grid_fill[at.usize()] if field == VALUE_FILL else (run.grid_angle[at.usize()] if field == VALUE_ANGLE else (run.grid_part[at.usize()] if field == VALUE_PART else ((run.grid_cx[at.usize()] * 1000000.0).i64() if field == VALUE_CX_MICRO else ((run.grid_cy[at.usize()] * 1000000.0).i64() if field == VALUE_CY_MICRO else ((run.grid_radius[at.usize()] * 1000000.0).i64() if field == VALUE_RADIUS_MICRO else -1)))))))

    def append_rule(out: mutable dstr&, kind: i64, param: i64):
        can Memory.Allocate, Abort.Panic:
            if kind == Ravens::RULE_PROGRESSION:
                dstr_append_cstr(out, "progression ")
                dstr_append_i64(out, param)
            elif kind == Ravens::RULE_DISTRIBUTE:
                dstr_append_cstr(out, "distribute three")
            elif kind == Ravens::RULE_ARITHMETIC:
                dstr_append_cstr(out, "arithmetic ")
                dstr_append_i64(out, param)
            elif kind == Ravens::RULE_SECOND_ORDER:
                dstr_append_cstr(out, "second order ")
                dstr_append_i64(out, param)
            elif kind == Ravens::RULE_LOGIC:
                dstr_append_cstr(out, "logic ")
                if param == Ravens::OP_OR:
                    dstr_append_cstr(out, "or")
                elif param == Ravens::OP_AND:
                    dstr_append_cstr(out, "and")
                else:
                    dstr_append_cstr(out, "xor")
            else:
                dstr_append_cstr(out, "constant")

    def append_notes(out: mutable dstr&, run: MatrixReasoningRun&):
        can Memory.Allocate, Abort.Panic:
            for at in 0..<run.lines |out, run, at|:
                if at > 0:
                    dstr_append_cstr(out, "   ·   ")
                dstr_append_cstr(out, "component ")
                dstr_append_i64(out, run.line_part[at.usize()] + 1)
                dstr_append_cstr(out, " attribute ")
                dstr_append_i64(out, run.line_attr[at.usize()])
                dstr_append_cstr(out, ": ")
                append_rule(out, run.line_kind[at.usize()], run.line_param[at.usize()])

    def panels_from_run(run: MatrixReasoningRun&, grid: mutable Ravens::Panels&, choices: mutable Ravens::Panels&):
        can Abort.Panic:
            grid.n <- run.grid_n
            choices.n <- run.choice_n
            for panel in 0..<run.grid_n |run, grid, panel|:
                held: i64 = run.grid_count[panel.usize()]
                Ints::put(&grid.count, panel, held)
                for at in 0..<held |run, grid, panel, at|:
                    source: i64 = panel * MAX_FIGURES + at
                    target: i64 = panel * Ravens::MOST_FIGURES + at
                    Ints::put(&grid.shape, target, run.grid_shape[source.usize()])
                    Ints::put(&grid.fill, target, run.grid_fill[source.usize()])
                    Ints::put(&grid.angle, target, run.grid_angle[source.usize()])
                    Ints::put(&grid.part, target, run.grid_part[source.usize()])
                    Floats::put(&grid.cx, target, run.grid_cx[source.usize()])
                    Floats::put(&grid.cy, target, run.grid_cy[source.usize()])
                    Floats::put(&grid.radius, target, run.grid_radius[source.usize()])
            for panel in 0..<run.choice_n |run, choices, panel|:
                held: i64 = run.choice_count[panel.usize()]
                Ints::put(&choices.count, panel, held)
                for at in 0..<held |run, choices, panel, at|:
                    source: i64 = panel * MAX_FIGURES + at
                    target: i64 = panel * Ravens::MOST_FIGURES + at
                    Ints::put(&choices.shape, target, run.choice_shape[source.usize()])
                    Ints::put(&choices.fill, target, run.choice_fill[source.usize()])
                    Ints::put(&choices.angle, target, run.choice_angle[source.usize()])
                    Ints::put(&choices.part, target, run.choice_part[source.usize()])
                    Floats::put(&choices.cx, target, run.choice_cx[source.usize()])
                    Floats::put(&choices.cy, target, run.choice_cy[source.usize()])
                    Floats::put(&choices.radius, target, run.choice_radius[source.usize()])

    def render(run: MatrixReasoningRun&, black_background: bool, width: f64, height: f64,
               list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            message: mutable dstr = []
            if run.phase == PHASE_READY:
                dstr_append_cstr(&message, "Press Space to start")
            elif run.phase == PHASE_ASKING or run.phase == PHASE_HIDDEN:
                dstr_append_cstr(&message, "Which one finishes the pattern?")
            elif run.phase == PHASE_FEEDBACK:
                if run.verdict == 1:
                    dstr_append_cstr(&message, "Right")
                else:
                    dstr_append_cstr(&message, "No — answer ")
                    dstr_append_i64(&message, run.answer + 1)
            else:
                dstr_append_i64(&message, run.correct)
                dstr_append_cstr(&message, " right of ")
                dstr_append_i64(&message, run.answered)
            notes: mutable dstr = []
            if run.explain and run.phase == PHASE_FEEDBACK:
                append_notes(&notes, run)
            verdict_text: mutable dstr = []
            if run.phase == PHASE_FEEDBACK:
                dstr_append_cstr(&verdict_text, "Right" if run.verdict == 1 else "Wrong")
            region frame_scratch(33554432):
                in frame_scratch:
                    grid: mutable Ravens::Panels = Ravens::new_panels(MAX_PANELS)
                    choices: mutable Ravens::Panels = Ravens::new_panels(MAX_CHOICES)
                    panels_from_run(run, &grid, &choices)
                    paint: mutable SceneRavens::RavensPaint = SceneRavens::paint_of(
                        black_background, width, height, width / Display::REFERENCE_WIDTH,
                        height / Display::REFERENCE_HEIGHT)
                    SceneRavens::render_live(list, &paint, run.phase, run.has_puzzle,
                        run.across, run.choices, run.answer, run.picked, run.hovered,
                        run.explain, &grid, &choices, bytes_view(notes), run.trial,
                        run.total_trials, run.correct, run.trial_level,
                        bytes_view(message), run.verdict if run.phase == PHASE_FEEDBACK else -1,
                        bytes_view(verdict_text))
                destroy frame_scratch
