# Maze: corridors, locked doors, and the exact fewest steps out.
#
# Port of neural_workshop/maze.py (GPL-2.0-or-later). A braided maze on a
# `2 * rooms + 1` grid, with coloured doors placed on cells that separate the
# start from the exit and a key for each, plus the exact minimum walk (a
# breadth-first search over `(cell, keys held)`) and the greedy foil the ladder
# grades planning by.
#
# ## Why this file carries a hash table
#
# `carve` returns a Python `set` of corridor cells and `dead_ends` iterates it.
# That order is not incidental: the dead-end list is shuffled and then sliced,
# so a different iteration order gives a different braid, a different maze and
# a different minimum for the same seed. The corridor set is therefore a
# PySet::Table (pyset.elisa), CPython's setobject.c for non-negative int keys,
# and not a flat array. It is differentially tested against a real `set` in
# maze_sweep/maze_diff.
#
# Everywhere else the reference's containers are order-insensitive: `dict`s are
# insertion-ordered and every set is only ever asked about membership or run
# through `sorted()`. Those become flat arrays here.
#
# ## Random-stream fidelity
#
# The generator draws from `random.Random(seed)` in a fixed order:
#   carve   two `randrange(rooms)`, then one `choice(fresh)` per carved edge
#   braid   one `shuffle(ends)`, then one `choice(walls)` per opened dead end
#   _deal   one `choice(sorted(open_cells))` for the start
#   _lock   one `randrange(low, high)` per door, one `choice(sorted(room))`
#           per key
# Every one of these is a `_randbelow` on the MT19937 stream, so pyrandom is
# the single point of contact and the order above is the whole contract.

extern rint(x: f64) -> f64

# The most doors the palette can tell apart, and so the most the ladder may
# ask for.
const MAZE_MOST_DOORS: i64 = 6
const MAZE_GRADE_COUNT: i64 = 15

# One rung of the ladder. `braid` is the share of dead ends opened back into
# the maze; `floor` the least minimum a maze may have; `planning` the least
# share of the walk that fetching keys nearest-first must throw away.
struct MazeGrade:
    rooms: i64
    doors: i64
    braid: f64
    floor: i64
    planning: f64

# Kindergarten to superhuman, exactly the reference's GRADES table.
def maze_grade(level_number: i64) -> MazeGrade:
    index: mutable i64 = level_number - 1
    index <- 0 if index < 0
    index <- MAZE_GRADE_COUNT - 1 if index > MAZE_GRADE_COUNT - 1
    if index == 0:
        return MazeGrade{rooms: 4, doors: 0, braid: 0.0, floor: 22, planning: 0.0}
    if index == 1:
        return MazeGrade{rooms: 5, doors: 0, braid: 0.2, floor: 29, planning: 0.0}
    if index == 2:
        return MazeGrade{rooms: 6, doors: 1, braid: 0.2, floor: 50, planning: 0.0}
    if index == 3:
        return MazeGrade{rooms: 7, doors: 2, braid: 0.25, floor: 72, planning: 0.0}
    if index == 4:
        return MazeGrade{rooms: 8, doors: 2, braid: 0.35, floor: 84, planning: 0.0}
    if index == 5:
        return MazeGrade{rooms: 9, doors: 3, braid: 0.35, floor: 113, planning: 0.0}
    if index == 6:
        return MazeGrade{rooms: 10, doors: 3, braid: 0.4, floor: 126, planning: 0.0}
    if index == 7:
        return MazeGrade{rooms: 11, doors: 4, braid: 0.4, floor: 155, planning: 0.02}
    if index == 8:
        return MazeGrade{rooms: 12, doors: 4, braid: 0.45, floor: 172, planning: 0.02}
    if index == 9:
        return MazeGrade{rooms: 13, doors: 5, braid: 0.45, floor: 199, planning: 0.03}
    if index == 10:
        return MazeGrade{rooms: 14, doors: 5, braid: 0.5, floor: 218, planning: 0.03}
    if index == 11:
        return MazeGrade{rooms: 15, doors: 6, braid: 0.5, floor: 249, planning: 0.05}
    if index == 12:
        return MazeGrade{rooms: 16, doors: 6, braid: 0.55, floor: 267, planning: 0.05}
    if index == 13:
        return MazeGrade{rooms: 17, doors: 6, braid: 0.55, floor: 283, planning: 0.05}
    return MazeGrade{rooms: 18, doors: 6, braid: 0.6, floor: 297, planning: 0.04}

# DIRECTIONS = ((0, -1), (0, 1), (-1, 0), (1, 0)). The order is load-bearing:
# it fixes the neighbour order of every breadth-first search, and so the
# discovery order that `separators` sorts stably by distance.
def maze_dir_dx(index: i64) -> i64:
    return 0 if index == 0 else (0 if index == 1 else (-1 if index == 2 else 1))

def maze_dir_dy(index: i64) -> i64:
    return -1 if index == 0 else (1 if index == 1 else 0)

# A generated maze. `ok` false is the reference's None.
struct Maze:
    ok: mutable bool
    width: mutable i64
    height: mutable i64
    start: mutable i64
    way_out: mutable i64
    door_count: mutable i64
    doors: mutable i64[6]
    keys: mutable i64[6]
    minimum: mutable i64
    greedy: mutable i64

def maze_blank() -> Maze:
    out: mutable Maze = zeroed
    return out

# ------------------------------------------------------------
# Bounds-checked flat-array access
#
# Elisa proves indexing inside `while i < count` but not across the helper
# boundaries this module is built from, so every access goes through these two.
# ------------------------------------------------------------

# ------------------------------------------------------------
# Workspace
#
# Everything the generator touches, sized once for the largest grid a caller
# will ask for and reused across attempts. Nothing here allocates after
# construction: buffers are fixed-capacity and their live length is a separate
# counter, so an attempt costs no arena.
# ------------------------------------------------------------

struct MazeWork:
    rooms: mutable i64
    width: mutable i64
    height: mutable i64
    cells: mutable i64
    span: mutable i64
    # CPython set of corridor cells -- see pyset.elisa for why the order matters.
    corridor: mutable PySet::Table
    # Grid state.
    open_flag: mutable darray[i64]
    open_list: mutable darray[i64]
    open_n: mutable i64
    adj: mutable darray[i64]
    adj_n: mutable darray[i64]
    # Breadth-first search: `stamp[c] == gen` marks a cell found this run.
    dist: mutable darray[i64]
    stamp: mutable darray[i64]
    gen: mutable i64
    blocked: mutable darray[i64]
    bgen: mutable i64
    order: mutable darray[i64]
    order_n: mutable i64
    # Carve.
    room_seen: mutable darray[i64]
    stack_x: mutable darray[i64]
    stack_y: mutable darray[i64]
    # Braid.
    ends: mutable darray[i64]
    ends_n: mutable i64
    # Separators and locking.
    from_start: mutable darray[i64]
    from_exit: mutable darray[i64]
    walk_order: mutable darray[i64]
    walk_n: mutable i64
    beads: mutable darray[i64]
    beads_n: mutable i64
    room: mutable darray[i64]
    room_n: mutable i64
    taken: mutable darray[i64]
    # Search over (cell, keys held).
    svisit: mutable darray[i64]
    sparent: mutable darray[i64]
    ssteps: mutable darray[i64]
    squeue: mutable darray[i64]
    sgen: mutable i64
    route: mutable darray[i64]
    route_n: mutable i64

# `rooms` is the largest lattice and `max_doors` the most doors any maze built
# in this workspace will carry; the (cell, keys held) search space is sized
# from them.
def maze_work_new(rooms: i64, max_doors: i64) -> MazeWork:
    can Memory.Allocate, Abort.Panic:
        width: i64 = 2 * rooms + 1
        cells: i64 = width * width
        span: i64 =
            for _door in 0..<max_doors |span=1| -> span:
                span <- span * 2
        states: i64 = cells * span
        work: mutable MazeWork = zeroed
        work.rooms <- rooms
        work.width <- width
        work.height <- width
        work.cells <- cells
        work.span <- span
        work.corridor <- PySet::new(cells)
        work.open_flag <- Ints::zeros(cells)
        work.open_list <- Ints::zeros(cells)
        work.adj <- Ints::zeros(cells * 4)
        work.adj_n <- Ints::zeros(cells)
        work.dist <- Ints::zeros(cells)
        work.stamp <- Ints::zeros(cells)
        work.blocked <- Ints::zeros(cells)
        work.order <- Ints::zeros(cells)
        work.room_seen <- Ints::zeros(rooms * rooms)
        work.stack_x <- Ints::zeros(rooms * rooms)
        work.stack_y <- Ints::zeros(rooms * rooms)
        work.ends <- Ints::zeros(cells)
        work.from_start <- Ints::zeros(cells)
        work.from_exit <- Ints::zeros(cells)
        work.walk_order <- Ints::zeros(cells)
        work.beads <- Ints::zeros(cells)
        work.room <- Ints::zeros(cells)
        work.taken <- Ints::zeros(cells)
        work.svisit <- Ints::zeros(states)
        work.sparent <- Ints::zeros(states)
        work.ssteps <- Ints::zeros(states)
        work.squeue <- Ints::zeros(states)
        work.route <- Ints::zeros(states)
        return work

# ------------------------------------------------------------
# CPython's set, for non-negative int keys
#
# setobject.c: open addressing, an initial run of LINEAR_PROBES + 1 consecutive
# slots per probe step, then the `i = i * 5 + 1 + perturb` jump. Keys hash to
# themselves. Nothing is ever deleted from a corridor set, so there are no
# dummy entries and `fill == used` always -- which is also why the resize path
# below is the simple `set_insert_clean` one.
# ------------------------------------------------------------

# ------------------------------------------------------------
# Geometry
# ------------------------------------------------------------

def maze_cell_of(width: i64, x: i64, y: i64) -> i64:
    return y * width + x

# The neighbour of `cell` in direction `index`, or -1 when it falls off the
# grid. This is `neighbours()` one step at a time.
def maze_neighbour(width: i64, height: i64, cell: i64, index: i64) -> i64:
    x: i64 = cell % width + maze_dir_dx(index)
    y: i64 = cell / width + maze_dir_dy(index)
    if x < 0 or x >= width or y < 0 or y >= height:
        return -1
    return y * width + x

# ------------------------------------------------------------
# Carving
# ------------------------------------------------------------

# The depth-first backtracker on a `rooms` by `rooms` lattice, chosen over the
# prettier algorithms on purpose: it makes long winding corridors and deep dead
# ends, which is what braiding and locking want. The corridor cells land in the
# workspace's CPython set in the reference's insertion order -- the first room,
# then a wall and a room per carved edge.
def maze_carve(work: mutable MazeWork&, rng: mutable MT19937&, rooms: i64):
    can Abort.Panic:
        width: i64 = 2 * rooms + 1
        work.rooms <- rooms
        work.width <- width
        work.height <- width
        work.cells <- width * width
        PySet::reset(&work.corridor)
        clear: mutable i64 = 0
        while clear < rooms * rooms |clear, rooms, work|:
            Ints::put(&work.room_seen, clear, 0)
            clear <- clear + 1

        here_x: i64 = py_randbelow(rng, rooms.u64()).i64()
        here_y: i64 = py_randbelow(rng, rooms.u64()).i64()
        Ints::put(&work.room_seen, here_y * rooms + here_x, 1)
        PySet::add(&work.corridor, maze_cell_of(width, 2 * here_x + 1, 2 * here_y + 1))
        Ints::put(&work.stack_x, 0, here_x)
        Ints::put(&work.stack_y, 0, here_y)
        depth: mutable i64 = 1

        while depth > 0 |depth, work, rng, rooms, width|:
            x: i64 = Ints::at(work.stack_x, depth - 1)
            y: i64 = Ints::at(work.stack_y, depth - 1)
            # The reference materialises the unvisited neighbours as a list and
            # calls rng.choice on it. choice() only takes an index from the
            # stream, so counting them and then walking to the chosen one is
            # the same draw without the list.
            fresh: mutable i64 = 0
            probe: mutable i64 = 0
            while probe < 4 |probe, x, y, rooms, work, fresh|:
                nx: i64 = x + maze_dir_dx(probe)
                ny: i64 = y + maze_dir_dy(probe)
                if nx >= 0 and nx < rooms and ny >= 0 and ny < rooms and Ints::at(work.room_seen, ny * rooms + nx) == 0:
                    fresh <- fresh + 1
                probe <- probe + 1
            if fresh == 0:
                depth <- depth - 1
            else:
                pick: i64 = py_choice_index(rng, fresh)
                seen_so_far: mutable i64 = 0
                chosen: mutable i64 = 0
                scan: mutable i64 = 0
                while scan < 4 |scan, x, y, rooms, work, seen_so_far, chosen, pick|:
                    nx: i64 = x + maze_dir_dx(scan)
                    ny: i64 = y + maze_dir_dy(scan)
                    if nx >= 0 and nx < rooms and ny >= 0 and ny < rooms and Ints::at(work.room_seen, ny * rooms + nx) == 0:
                        chosen <- scan if seen_so_far == pick
                        seen_so_far <- seen_so_far + 1
                    scan <- scan + 1
                next_x: i64 = x + maze_dir_dx(chosen)
                next_y: i64 = y + maze_dir_dy(chosen)
                Ints::put(&work.room_seen, next_y * rooms + next_x, 1)
                PySet::add(&work.corridor, maze_cell_of(width, x + next_x + 1, y + next_y + 1))
                PySet::add(&work.corridor, maze_cell_of(width, 2 * next_x + 1, 2 * next_y + 1))
                Ints::put(&work.stack_x, depth, next_x)
                Ints::put(&work.stack_y, depth, next_y)
                depth <- depth + 1

# Corridor cells with exactly one way out, in the corridor set's own iteration
# order -- the reason the corridor set is a PySet::Table.
def maze_dead_ends(work: mutable MazeWork&):
    can Abort.Panic:
        work.ends_n <- 0
        slot: mutable i64 = 0
        while slot <= work.corridor.mask |slot, work|:
            cell: i64 = Ints::at(work.corridor.slots, slot)
            if cell >= 0:
                links: mutable i64 = 0
                probe: mutable i64 = 0
                while probe < 4 |probe, cell, work, links|:
                    near: i64 = maze_neighbour(work.width, work.height, cell, probe)
                    if near >= 0 and PySet::contains(work.corridor, near):
                        links <- links + 1
                    probe <- probe + 1
                if links == 1:
                    Ints::put(&work.ends, work.ends_n, cell)
                    work.ends_n <- work.ends_n + 1
            slot <- slot + 1

# How many of the four walls around `cell` can be knocked out to join it to a
# corridor it could not reach before, and which one is the `pick`-th of them.
# Returns -1 when `pick` is past the end, which is how the count pass asks.
#
# The reference indexes `cell_of(width, x + dx, y + dy)` without a bounds test
# of its own; the guard on the cell two steps out keeps the one step out inside
# the grid, so no wrap is possible and the arithmetic is reproduced as written.
def maze_braid_wall(work: mutable MazeWork&, cell: i64, pick: i64) -> i64:
    can Abort.Panic:
        width: i64 = work.width
        height: i64 = work.height
        x: i64 = cell % width
        y: i64 = cell / width
        seen_so_far: mutable i64 = 0
        chosen: mutable i64 = -1
        probe: mutable i64 = 0
        while probe < 4 |probe, x, y, width, height, work, seen_so_far, chosen, pick|:
            dx: i64 = maze_dir_dx(probe)
            dy: i64 = maze_dir_dy(probe)
            if x + 2 * dx > 0 and x + 2 * dx < width - 1 and y + 2 * dy > 0 and y + 2 * dy < height - 1:
                wall: i64 = maze_cell_of(width, x + dx, y + dy)
                beyond: i64 = maze_cell_of(width, x + 2 * dx, y + 2 * dy)
                if not PySet::contains(work.corridor, wall) and PySet::contains(work.corridor, beyond):
                    chosen <- wall if seen_so_far == pick
                    seen_so_far <- seen_so_far + 1
            probe <- probe + 1
        return chosen if pick >= 0 else seen_so_far

# Open `share` of the dead ends back into the maze, in place. A dead end is
# opened by knocking out one of the walls around it, which joins it to a
# corridor it could not reach before and turns the carved tree into a graph
# with loops. That is what gives the walk a choice of route.
def maze_braid(work: mutable MazeWork&, rng: mutable MT19937&, share: f64):
    can Abort.Panic:
        return if share <= 0.0
        maze_dead_ends(work)
        py_shuffle_i64_prefix(rng, &work.ends, work.ends_n)
        # Python's round() is round-half-to-even, so libm rint, never round.
        take: i64 = rint(work.ends_n.f64() * share).i64()
        index: mutable i64 = 0
        while index < take and index < work.ends_n |index, take, work, rng|:
            cell: i64 = Ints::at(work.ends, index)
            walls: i64 = maze_braid_wall(work, cell, -1)
            if walls > 0:
                opened: i64 = maze_braid_wall(work, cell, py_choice_index(rng, walls))
                if opened >= 0:
                    PySet::add(&work.corridor, opened)
            index <- index + 1

# The corridor graph: for every open cell, the open cells next to it, in
# DIRECTIONS order.
def maze_adjacency(work: mutable MazeWork&):
    can Abort.Panic:
        cell: mutable i64 = 0
        while cell < work.cells |cell, work|:
            links: mutable i64 = 0
            if Ints::at(work.open_flag, cell) == 1:
                probe: mutable i64 = 0
                while probe < 4 |probe, cell, work, links|:
                    near: i64 = maze_neighbour(work.width, work.height, cell, probe)
                    if near >= 0 and Ints::at(work.open_flag, near) == 1:
                        Ints::put(&work.adj, cell * 4 + links, near)
                        links <- links + 1
                    probe <- probe + 1
            Ints::put(&work.adj_n, cell, links)
            cell <- cell + 1

# Freeze the corridor set into the flat grid the searches walk: an open flag
# per cell, the ascending cell list `sorted(open_cells)` produces, and the
# corridor graph.
def maze_realise(work: mutable MazeWork&):
    can Abort.Panic:
        cell: mutable i64 = 0
        while cell < work.cells |cell, work|:
            Ints::put(&work.open_flag, cell, 0)
            cell <- cell + 1
        slot: mutable i64 = 0
        while slot <= work.corridor.mask |slot, work|:
            key: i64 = Ints::at(work.corridor.slots, slot)
            if key >= 0:
                Ints::put(&work.open_flag, key, 1)
            slot <- slot + 1
        work.open_n <- 0
        scan: mutable i64 = 0
        while scan < work.cells |scan, work|:
            if Ints::at(work.open_flag, scan) == 1:
                Ints::put(&work.open_list, work.open_n, scan)
                work.open_n <- work.open_n + 1
            scan <- scan + 1
        maze_adjacency(work)

# ------------------------------------------------------------
# Walks
# ------------------------------------------------------------

# Steps from `start` to every cell it can walk to, refusing cells stamped in
# `blocked` when `use_blocked`. Leaves `dist` and `stamp` set and `order`
# holding the discovery order -- which is the reference's `found` dict, whose
# insertion order `separators` relies on.
def maze_distances(work: mutable MazeWork&, start: i64, use_blocked: bool):
    can Abort.Panic:
        work.gen <- work.gen + 1
        work.order_n <- 0
        return if start < 0 or start >= work.cells
        return if Ints::at(work.open_flag, start) != 1
        return if use_blocked and Ints::at(work.blocked, start) == work.bgen
        Ints::put(&work.stamp, start, work.gen)
        Ints::put(&work.dist, start, 0)
        Ints::put(&work.order, 0, start)
        work.order_n <- 1
        head: mutable i64 = 0
        while head < work.order_n |head, work, use_blocked|:
            cell: i64 = Ints::at(work.order, head)
            head <- head + 1
            step: i64 = Ints::at(work.dist, cell) + 1
            links: i64 = Ints::at(work.adj_n, cell)
            probe: mutable i64 = 0
            while probe < links |probe, links, cell, step, work, use_blocked|:
                near: i64 = Ints::at(work.adj, cell * 4 + probe)
                shut: bool = use_blocked and Ints::at(work.blocked, near) == work.bgen
                if Ints::at(work.stamp, near) != work.gen and not shut:
                    Ints::put(&work.stamp, near, work.gen)
                    Ints::put(&work.dist, near, step)
                    Ints::put(&work.order, work.order_n, near)
                    work.order_n <- work.order_n + 1
                probe <- probe + 1

def maze_reached(work: mutable MazeWork&, cell: i64) -> bool:
    can Abort.Panic:
        return Ints::at(work.stamp, cell) == work.gen

# Cells that every walk from `start` to `way_out` must pass, ordered by how far
# they are from the start. A cell on every route is passed by every route in
# the same place, so the separators lie along the way like beads on a thread,
# and that order is what lets a door be locked behind the one before it.
#
# Candidates are narrowed to the cells on some shortest route first -- two
# searches rather than one apiece -- and only then is each one actually removed
# and the maze re-walked.
def maze_separators(work: mutable MazeWork&, start: i64, way_out: i64):
    can Abort.Panic:
        work.beads_n <- 0
        maze_distances(work, start, false)
        return if not maze_reached(work, way_out)
        copy: mutable i64 = 0
        while copy < work.cells |copy, work|:
            gap: i64 = Ints::at(work.dist, copy) if maze_reached(work, copy) else -1
            Ints::put(&work.from_start, copy, gap)
            copy <- copy + 1
        work.walk_n <- work.order_n
        # `move` is a reserved word in Elisa; hence `carry`.
        carry: mutable i64 = 0
        while carry < work.order_n |carry, work|:
            Ints::put(&work.walk_order, carry, Ints::at(work.order, carry))
            carry <- carry + 1
        span: i64 = Ints::at(work.from_start, way_out)

        maze_distances(work, way_out, false)
        back_copy: mutable i64 = 0
        while back_copy < work.cells |back_copy, work|:
            gap: i64 = Ints::at(work.dist, back_copy) if maze_reached(work, back_copy) else -1
            Ints::put(&work.from_exit, back_copy, gap)
            back_copy <- back_copy + 1

        index: mutable i64 = 0
        while index < work.walk_n |index, work, start, way_out, span|:
            cell: i64 = Ints::at(work.walk_order, index)
            if cell != start and cell != way_out:
                back: mutable i64 = Ints::at(work.from_exit, cell)
                # from_exit.get(cell, span + 1): a cell the exit cannot reach
                # scores one past the span and so never qualifies.
                back <- span + 1 if back < 0
                if Ints::at(work.from_start, cell) + back == span:
                    work.bgen <- work.bgen + 1
                    Ints::put(&work.blocked, cell, work.bgen)
                    maze_distances(work, start, true)
                    if not maze_reached(work, way_out):
                        Ints::put(&work.beads, work.beads_n, cell)
                        work.beads_n <- work.beads_n + 1
            index <- index + 1

        # list.sort is stable, so equal distances keep discovery order.
        # Insertion sort reproduces that exactly.
        sorted_index: mutable i64 = 1
        while sorted_index < work.beads_n |sorted_index, work|:
            current: i64 = Ints::at(work.beads, sorted_index)
            key: i64 = Ints::at(work.from_start, current)
            slot: mutable i64 = sorted_index - 1
            while slot >= 0 and Ints::at(work.from_start, Ints::at(work.beads, slot)) > key |slot, work, key|:
                Ints::put(&work.beads, slot + 1, Ints::at(work.beads, slot))
                slot <- slot - 1
            Ints::put(&work.beads, slot + 1, current)
            sorted_index <- sorted_index + 1

# Place `count` doors along the way out and a key for each. Doors are drawn one
# from each equal share of the separator thread, so a maze does not lock three
# times in the last corridor; key i goes anywhere at all that the start can
# still reach with door i shut, which is what makes every maze solvable by
# construction and, measured, is also what makes it worth planning. Returns
# false for the reference's None.
def maze_lock(work: mutable MazeWork&, maze: mutable Maze&, rng: mutable MT19937&, start: i64, way_out: i64, count: i64) -> bool:
    can Abort.Panic:
        maze.door_count <- 0
        true return if count <= 0
        maze_separators(work, start, way_out)
        false return if work.beads_n < count

        index: mutable i64 = 0
        while index < count and index < MAZE_MOST_DOORS |index, count, work, rng, maze|:
            low: i64 = index * work.beads_n / count
            high: mutable i64 = (index + 1) * work.beads_n / count
            high <- low + 1 if high < low + 1
            maze.doors[index] <- Ints::at(work.beads, py_randrange(rng, low, high))
            index <- index + 1
        maze.door_count <- count

        clear: mutable i64 = 0
        while clear < work.cells |clear, work|:
            Ints::put(&work.taken, clear, 0)
            clear <- clear + 1
        Ints::put(&work.taken, start, 1)
        Ints::put(&work.taken, way_out, 1)
        mark: mutable i64 = 0
        while mark < count and mark < MAZE_MOST_DOORS |mark, count, work, maze|:
            Ints::put(&work.taken, maze.doors[mark], 1)
            mark <- mark + 1

        colour: mutable i64 = 0
        failed: mutable bool = false
        while colour < count and colour < MAZE_MOST_DOORS and not failed |colour, count, work, rng, maze, start, failed|:
            work.bgen <- work.bgen + 1
            Ints::put(&work.blocked, maze.doors[colour], work.bgen)
            maze_distances(work, start, true)
            # `room` is sorted before the draw, so the reachable set's own
            # order does not matter; walking the grid ascending is sorted().
            work.room_n <- 0
            scan: mutable i64 = 0
            while scan < work.cells |scan, work|:
                if maze_reached(work, scan) and Ints::at(work.taken, scan) == 0:
                    Ints::put(&work.room, work.room_n, scan)
                    work.room_n <- work.room_n + 1
                scan <- scan + 1
            if work.room_n == 0:
                failed <- true
            else:
                chosen: i64 = Ints::at(work.room, py_choice_index(rng, work.room_n))
                maze.keys[colour] <- chosen
                Ints::put(&work.taken, chosen, 1)
                colour <- colour + 1
        return not failed

# The key mask picking up whatever key sits on `cell` produces. The reference
# looks the cell up in a dict built from `enumerate(keys)`, so at most one bit
# is ever added and a later key on the same cell wins.
def maze_picked_up(maze: mutable Maze&, cell: i64, held: i64) -> i64:
    gained: mutable i64 = held
    colour: mutable i64 = 0
    while colour < maze.door_count and colour < MAZE_MOST_DOORS |colour, maze, cell, held, gained|:
        gained <- held | (1 << colour) if maze.keys[colour] == cell
        colour <- colour + 1
    return gained

# The colour of the door on `cell`, or -1 when there is none.
def maze_door_at(maze: mutable Maze&, cell: i64) -> i64:
    colour: mutable i64 = 0
    found: mutable i64 = -1
    while colour < maze.door_count and colour < MAZE_MOST_DOORS |colour, maze, cell, found|:
        found <- colour if maze.doors[colour] == cell
        colour <- colour + 1
    return found

# Breadth-first over (cell, keys held): the exact fewest steps out, and one
# walk of that length left in `work.route`. The key set is what makes this a
# search rather than a shortest path -- the same corridor is a different place
# depending on what you are carrying, and a walk that doubles back through it
# is not going in circles. -1 when there is no way out at all, which
# generation never produces and a hand-written maze might.
def maze_search(work: mutable MazeWork&, maze: mutable Maze&) -> i64:
    can Abort.Panic:
        span: mutable i64 =
            for _door in 0..<maze.door_count |span=1| -> span:
                span <- span * 2
        # The workspace was sized for at least this many key masks; the clamp
        # only guards a caller that under-sized it.
        span <- work.span if span > work.span
        work.sgen <- work.sgen + 1
        work.route_n <- 0
        first: i64 = maze.start * span + maze_picked_up(maze, maze.start, 0)
        Ints::put(&work.svisit, first, work.sgen)
        Ints::put(&work.sparent, first, -1)
        Ints::put(&work.ssteps, first, 0)
        Ints::put(&work.squeue, 0, first)
        tally: mutable i64 = 1
        head: mutable i64 = 0
        answer: mutable i64 = -1
        arrived: mutable bool = false
        while head < tally and not arrived |head, tally, arrived, answer, work, maze, span|:
            state: i64 = Ints::at(work.squeue, head)
            head <- head + 1
            cell: i64 = state / span
            held: i64 = state % span
            if cell == maze.way_out:
                arrived <- true
                answer <- Ints::at(work.ssteps, state)
                at: mutable i64 = state
                while at >= 0 |at, work, span|:
                    Ints::put(&work.route, work.route_n, at / span)
                    work.route_n <- work.route_n + 1
                    at <- Ints::at(work.sparent, at)
                # The walk is built backwards; the reference reverses it.
                left: mutable i64 = 0
                right: mutable i64 = work.route_n - 1
                while left < right |left, right, work|:
                    swapped: i64 = Ints::at(work.route, left)
                    Ints::put(&work.route, left, Ints::at(work.route, right))
                    Ints::put(&work.route, right, swapped)
                    left <- left + 1
                    right <- right - 1
            else:
                links: i64 = Ints::at(work.adj_n, cell)
                probe: mutable i64 = 0
                while probe < links |probe, links, cell, held, state, work, maze, span, tally|:
                    near: i64 = Ints::at(work.adj, cell * 4 + probe)
                    colour: i64 = maze_door_at(maze, near)
                    if colour < 0 or ((held >> colour) & 1) == 1:
                        ahead: i64 = near * span + maze_picked_up(maze, near, held)
                        if Ints::at(work.svisit, ahead) != work.sgen:
                            Ints::put(&work.svisit, ahead, work.sgen)
                            Ints::put(&work.sparent, ahead, state)
                            Ints::put(&work.ssteps, ahead, Ints::at(work.ssteps, state) + 1)
                            Ints::put(&work.squeue, tally, ahead)
                            tally <- tally + 1
                    probe <- probe + 1
        return answer

# What always heading for the nearest key it can still reach, and then for the
# way out, costs. Not a solver -- a foil. It is the walk of somebody who reads
# the maze one step at a time instead of planning the sweep, and the gap
# between it and the minimum is how much the planning is worth.
def maze_greedy_walk(work: mutable MazeWork&, maze: mutable Maze&) -> i64:
    can Abort.Panic:
        full: mutable i64 =
            for _door in 0..<maze.door_count |full=1| -> full:
                full <- full * 2
        full <- full - 1
        here: mutable i64 = maze.start
        held: mutable i64 = maze_picked_up(maze, maze.start, 0)
        steps: mutable i64 = 0
        answer: mutable i64 = -1
        settled: mutable bool = false
        leg: mutable i64 = 0
        while leg <= maze.door_count and not settled |leg, settled, answer, here, held, steps, work, maze, full|:
            work.bgen <- work.bgen + 1
            shut: mutable i64 = 0
            while shut < maze.door_count and shut < MAZE_MOST_DOORS |shut, maze, held, work|:
                if ((held >> shut) & 1) == 0:
                    Ints::put(&work.blocked, maze.doors[shut], work.bgen)
                shut <- shut + 1
            maze_distances(work, here, true)
            if maze_reached(work, maze.way_out) and held == full:
                answer <- steps + Ints::at(work.dist, maze.way_out)
                settled <- true
            else:
                best_gap: mutable i64 = -1
                best_cell: mutable i64 = -1
                want: mutable i64 = 0
                while want < maze.door_count and want < MAZE_MOST_DOORS |want, maze, held, work, best_gap, best_cell|:
                    target: i64 = maze.keys[want]
                    if ((held >> want) & 1) == 0 and maze_reached(work, target):
                        gap: i64 = Ints::at(work.dist, target)
                        # min() over the (distance, cell) pairs.
                        if best_gap < 0 or gap < best_gap or (gap == best_gap and target < best_cell):
                            best_gap <- gap
                            best_cell <- target
                    want <- want + 1
                if best_cell < 0:
                    if maze_reached(work, maze.way_out):
                        answer <- steps + Ints::at(work.dist, maze.way_out)
                    settled <- true
                else:
                    steps <- steps + best_gap
                    here <- best_cell
                    held <- maze_picked_up(maze, here, held)
            leg <- leg + 1
        return answer

# ------------------------------------------------------------
# Generation
# ------------------------------------------------------------

# One maze at `grade`, or `ok: false` when this one did not come out.
def maze_deal(work: mutable MazeWork&, rng: mutable MT19937&, grade: MazeGrade) -> Maze:
    can Abort.Panic:
        maze: mutable Maze = maze_blank()
        maze_carve(work, rng, grade.rooms)
        maze_braid(work, rng, grade.braid)
        maze_realise(work)
        maze.width <- work.width
        maze.height <- work.height

        start: i64 = Ints::at(work.open_list, py_choice_index(rng, work.open_n))
        maze_distances(work, start, false)
        # max(apart, key=lambda cell: (apart[cell], cell)) -- a total order, so
        # the dict's own order does not come into it.
        far_cell: mutable i64 = -1
        far_dist: mutable i64 = -1
        index: mutable i64 = 0
        while index < work.order_n |index, work, far_cell, far_dist|:
            cell: i64 = Ints::at(work.order, index)
            gap: i64 = Ints::at(work.dist, cell)
            if gap > far_dist or (gap == far_dist and cell > far_cell):
                far_dist <- gap
                far_cell <- cell
            index <- index + 1
        if far_cell == start:
            return maze

        maze.start <- start
        maze.way_out <- far_cell
        doors: i64 = grade.doors if grade.doors < MAZE_MOST_DOORS else MAZE_MOST_DOORS
        if not maze_lock(work, &maze, rng, start, far_cell, doors):
            return maze

        minimum: i64 = maze_search(work, &maze)
        if minimum < 0:
            # Cannot happen by construction.
            return maze
        maze.minimum <- minimum
        maze.greedy <- maze_greedy_walk(work, &maze)
        maze.ok <- true
        return maze

# How much of the walk taking the keys nearest-first throws away. Zero says the
# maze can be walked without looking further than the next key -- which is a
# maze, but not a plan.
def maze_planning_share(maze: mutable Maze&) -> f64:
    if maze.minimum <= 0:
        return 0.0
    return (maze.greedy - maze.minimum).f64() / maze.minimum.f64()

# Which attempt of `maze_generate` wins, or -1 when none of them did.
#
# The two axes are ranked, not merged: a maze that clears the step floor never
# loses to one that does not, whatever either is worth as a plan, and among
# those the planning floor picks. If none of them clears that too, the deepest
# of them is handed back rather than a shallower maze that happened to reward
# planning. Below the step floor, depth alone ranks.
def maze_winning_attempt(work: mutable MazeWork&, grade: MazeGrade, seed: i64, attempts: i64) -> i64:
    can Abort.Panic:
        rng: mutable MT19937 = mt19937_new()
        mt_seed_int(&rng, seed.u64())
        # Deep, but too straightforward.
        strong_at: mutable i64 = -1
        strong_min: mutable i64 = 0
        # Not deep enough either way.
        fallback_at: mutable i64 = -1
        fallback_min: mutable i64 = 0
        winner: mutable i64 = -1
        attempt: mutable i64 = 0
        while attempt < attempts and winner < 0 |attempt, winner, strong_at, strong_min, fallback_at, fallback_min, work, rng, grade|:
            maze: mutable Maze = maze_deal(work, &rng, grade)
            if maze.ok:
                if maze.minimum >= grade.floor:
                    if grade.planning == 0.0 or maze_planning_share(&maze) >= grade.planning:
                        # Long and worth planning: done.
                        winner <- attempt
                    else:
                        if strong_at < 0 or maze.minimum > strong_min:
                            strong_at <- attempt
                            strong_min <- maze.minimum
                else:
                    if fallback_at < 0 or maze.minimum > fallback_min:
                        fallback_at <- attempt
                        fallback_min <- maze.minimum
            attempt <- attempt + 1
        winner return if winner >= 0
        strong_at return if strong_at >= 0
        return fallback_at

# A maze at `level_number`, at or above that rung's floors. `ok: false` is the
# reference's ValueError -- no maze survived the attempts at all.
#
# The winning attempt is found first and then dealt again from a fresh stream,
# so the workspace is left holding exactly the maze that comes back: a caller
# that wants the corridors (to draw them, or to re-solve) reads them off
# `work` without a second generation pass having to agree with this one.
def maze_generate(work: mutable MazeWork&, level_number: i64, seed: i64, attempts: i64) -> Maze:
    can Abort.Panic:
        grade: MazeGrade = maze_grade(level_number)
        winner: i64 = maze_winning_attempt(work, grade, seed, attempts)
        answer: mutable Maze = maze_blank()
        answer return if winner < 0
        rng: mutable MT19937 = mt19937_new()
        mt_seed_int(&rng, seed.u64())
        replay: mutable i64 = 0
        while replay <= winner |replay, winner, answer, work, rng, grade|:
            answer <- maze_deal(work, &rng, grade)
            replay <- replay + 1
        return answer

# The key mask a walk over the first `count` cells of `cells` ends up carrying.
def maze_held_after(maze: mutable Maze&, cells: darray[i64], count: i64) -> i64:
    can Abort.Panic:
        held: mutable i64 = 0
        index: mutable i64 = 0
        while index < count |index, count, cells, maze, held|:
            held <- maze_picked_up(maze, Ints::at(cells, index), held)
            index <- index + 1
        return held
