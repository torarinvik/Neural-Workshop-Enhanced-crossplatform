# Stateful common-v1 controller for the source Pursuit task.
#
# Pursuit has ten source options while common-v1 carries six scalar option
# slots.  The first five slots are the source's most visible primary dials;
# slot f is a checked mixed-radix packet for size wobble, morph gap, seconds,
# rounds, and adaptive mode.  This keeps every original option representable
# without making the browser a second options authority.

module PursuitGame:

    const MAX_ROUNDS: i64 = 256
    const REFERENCE_WIDTH: f64 = 912.0
    const REFERENCE_HEIGHT: f64 = 684.0

    const PHASE_READY: i64 = 0
    const PHASE_CHASING: i64 = 1
    const PHASE_FEEDBACK: i64 = 2
    const PHASE_DONE: i64 = 3

    const ACTION_START: i64 = 0
    const ACTION_UP: i64 = 1
    const ACTION_DOWN: i64 = 2
    const ACTION_LEFT: i64 = 3
    const ACTION_RIGHT: i64 = 4

    const INFO_PHASE: i64 = 0
    const INFO_SPEED: i64 = 1
    const INFO_SURGE: i64 = 2
    const INFO_TURN_MS: i64 = 3
    const INFO_TURN_DEGREES: i64 = 4
    const INFO_SIZE: i64 = 5
    const INFO_WOBBLE: i64 = 6
    const INFO_MORPH_MS: i64 = 7
    const INFO_SECONDS: i64 = 8
    const INFO_TOTAL_ROUNDS: i64 = 9
    const INFO_ADAPTIVE: i64 = 10
    const INFO_ROUND: i64 = 11
    const INFO_MULTIPLIER: i64 = 12
    const INFO_ON_TIME_PPM: i64 = 13
    const INFO_RUN_TIME_MS: i64 = 14
    const INFO_OFF_SUM_PX: i64 = 15
    const INFO_OFF_SAMPLES: i64 = 16
    const INFO_UNTIL_MS: i64 = 17
    const INFO_VERDICT: i64 = 18
    const INFO_RESULT_COUNT: i64 = 19
    const INFO_ON_PERCENT: i64 = 20
    const INFO_MEAN_OFF_PX: i64 = 21
    const INFO_MOUSE_X: i64 = 22
    const INFO_MOUSE_Y: i64 = 23
    const INFO_CLOCK_MS: i64 = 24

    const VALUE_X: i64 = 0
    const VALUE_Y: i64 = 1
    const VALUE_HEADING: i64 = 2
    const VALUE_SURGE: i64 = 3
    const VALUE_RADIUS: i64 = 4
    const VALUE_FORM: i64 = 5
    const VALUE_COLOR: i64 = 6
    const VALUE_NEXT_TURN_MS: i64 = 7
    const VALUE_NEXT_SURGE_MS: i64 = 8
    const VALUE_NEXT_RESIZE_MS: i64 = 9
    const VALUE_NEXT_MORPH_MS: i64 = 10

    # Result rows share the value(field, at) ABI with quarry fields. Keep this
    # namespace disjoint: 0..10 are the current quarry, while 100+ are the
    # completed-round result table.
    const RESULT_SHARE_PPM: i64 = 100
    const RESULT_DRIFT_PX: i64 = 101
    const RESULT_MULTIPLIER_PPM: i64 = 102

    # Mixed-radix bases for f: wobble, morph gap, seconds, rounds, adaptive.
    const WOBBLE_COUNT: i64 = 7
    const MORPH_COUNT: i64 = 7
    const SECONDS_COUNT: i64 = 8
    const ROUNDS_COUNT: i64 = 8

    struct PursuitRun:
        rng: mutable MT19937
        speed_percent: mutable i64
        surge_percent: mutable i64
        turn_ms: mutable i64
        turn_degrees: mutable i64
        size: mutable i64
        packed_extra: mutable i64
        wobble_percent: mutable i64
        morph_ms: mutable i64
        seconds: mutable i64
        total_rounds: mutable i64
        adaptive: mutable bool
        speed: mutable f64
        surge_depth: mutable f64
        turn_gap: mutable f64
        sharpness: mutable f64
        base_radius: mutable f64
        wobble: mutable f64
        morph_gap: mutable f64
        round_number: mutable i64
        multiplier: mutable f64
        on_time: mutable f64
        run_time: mutable f64
        off_sum: mutable f64
        off_samples: mutable i64
        until_ms: mutable i64
        phase: mutable i64
        verdict: mutable i64
        mouse_x: mutable f64
        mouse_y: mutable f64
        clock_ms: mutable i64
        result_count: mutable i64
        result_share: mutable f64[256]
        result_drift: mutable f64[256]
        result_multiplier: mutable f64[256]
        quarry_x: mutable f64
        quarry_y: mutable f64
        quarry_heading: mutable f64
        quarry_surge: mutable f64
        quarry_radius: mutable f64
        quarry_form: mutable i64
        quarry_color: mutable i64
        quarry_next_turn_ms: mutable i64
        quarry_next_surge_ms: mutable i64
        quarry_next_resize_ms: mutable i64
        quarry_next_morph_ms: mutable i64

    def allowed_speed(value: i64) -> bool:
        can Abort.Panic:
            return value == 4 or value == 6 or value == 8 or value == 10 or value == 12 or value == 14 or value == 16 or value == 18 or value == 20 or value == 25 or value == 30 or value == 35 or value == 40 or value == 50 or value == 60 or value == 75 or value == 90

    def allowed_surge(value: i64) -> bool:
        can Abort.Panic:
            return value == 0 or value == 20 or value == 40 or value == 60 or value == 80 or value == 100 or value == 150 or value == 200 or value == 300

    def allowed_turn_ms(value: i64) -> bool:
        can Abort.Panic:
            return value == 200 or value == 300 or value == 400 or value == 600 or value == 900 or value == 1200 or value == 1600 or value == 2200 or value == 3000 or value == 5000

    def allowed_turn_degrees(value: i64) -> bool:
        can Abort.Panic:
            return value == 30 or value == 45 or value == 60 or value == 90 or value == 120 or value == 150 or value == 180

    def allowed_size(value: i64) -> bool:
        can Abort.Panic:
            return value == 10 or value == 13 or value == 16 or value == 19 or value == 22 or value == 26 or value == 31 or value == 38 or value == 46 or value == 60

    def allowed_packed(value: i64) -> bool:
        can Abort.Panic:
            return false if value < 0
            rest: mutable i64 = value
            rest <- rest / WOBBLE_COUNT
            rest <- rest / MORPH_COUNT
            rest <- rest / SECONDS_COUNT
            rest <- rest / ROUNDS_COUNT
            return rest <= 1

    def packed_wobble(value: i64) -> i64:
        can Abort.Panic:
            index: i64 = value % WOBBLE_COUNT
            return 0 if index == 0
            return 15 if index == 1
            return 30 if index == 2
            return 40 if index == 3
            return 55 if index == 4
            return 70 if index == 5
            return 85

    def packed_morph(value: i64) -> i64:
        can Abort.Panic:
            index: i64 = (value / WOBBLE_COUNT) % MORPH_COUNT
            return 0 if index == 0
            return 500 if index == 1
            return 900 if index == 2
            return 1400 if index == 3
            return 2000 if index == 4
            return 3000 if index == 5
            return 5000

    def packed_seconds(value: i64) -> i64:
        can Abort.Panic:
            index: i64 = (value / (WOBBLE_COUNT * MORPH_COUNT)) % SECONDS_COUNT
            return 10 if index == 0
            return 15 if index == 1
            return 20 if index == 2
            return 30 if index == 3
            return 45 if index == 4
            return 60 if index == 5
            return 90 if index == 6
            return 120

    def packed_rounds(value: i64) -> i64:
        can Abort.Panic:
            index: i64 = (value / (WOBBLE_COUNT * MORPH_COUNT * SECONDS_COUNT)) % ROUNDS_COUNT
            return 1 if index == 0
            return 2 if index == 1
            return 3 if index == 2
            return 5 if index == 3
            return 8 if index == 4
            return 10 if index == 5
            return 15 if index == 6
            return 20

    def packed_adaptive(value: i64) -> bool:
        can Abort.Panic:
            return ((value / (WOBBLE_COUNT * MORPH_COUNT * SECONDS_COUNT * ROUNDS_COUNT)) % 2) != 0

    def new_quarry(run: mutable PursuitRun&):
        can Abort.Panic:
            run.quarry_x <- 0.5
            run.quarry_y <- 0.5
            run.quarry_heading <- 0.0
            run.quarry_surge <- 1.0
            run.quarry_radius <- 0.0
            run.quarry_form <- 0
            run.quarry_color <- 0
            run.quarry_next_turn_ms <- 0
            run.quarry_next_surge_ms <- 0
            run.quarry_next_resize_ms <- 0
            run.quarry_next_morph_ms <- 0

    def clear_score(run: mutable PursuitRun&):
        can Abort.Panic:
            run.round_number <- 0
            run.multiplier <- 1.0
            run.on_time <- 0.0
            run.run_time <- 0.0
            run.off_sum <- 0.0
            run.off_samples <- 0
            run.until_ms <- 0
            run.phase <- PHASE_READY
            run.verdict <- -1
            run.clock_ms <- 0
            run.result_count <- 0
            new_quarry(run)
            for at in 0..<MAX_ROUNDS |at, run|:
                run.result_share[at.usize()] <- 0.0
                run.result_drift[at.usize()] <- 0.0
                run.result_multiplier[at.usize()] <- 0.0

    def copy_config(run: PursuitRun&, source: mutable Pursuit::PursuitSourceRun&):
        can Abort.Panic:
            source.speed <- run.speed
            source.surge_depth <- run.surge_depth
            source.turn_gap <- run.turn_gap
            source.sharpness <- run.sharpness
            source.base_radius <- run.base_radius
            source.wobble <- run.wobble
            source.morph_gap <- run.morph_gap
            source.seconds <- run.seconds.f64()
            source.total_rounds <- run.total_rounds
            source.adaptive <- run.adaptive

    def copy_to_source(run: PursuitRun&, source: mutable Pursuit::PursuitSourceRun&):
        can Abort.Panic:
            Pursuit::adapter_load(source, run.speed, run.surge_depth,
                run.turn_gap, run.sharpness, run.base_radius, run.wobble,
                run.morph_gap, run.seconds.f64(), run.total_rounds, run.adaptive,
                run.round_number, run.multiplier, run.on_time, run.run_time,
                run.off_sum, run.off_samples, run.until_ms.f64() / 1000.0,
                run.phase, run.verdict, run.mouse_x, run.mouse_y, run.result_count,
                &run.result_share, &run.result_drift, &run.result_multiplier,
                run.quarry_x, run.quarry_y, run.quarry_heading, run.quarry_surge,
                run.quarry_radius, run.quarry_form, run.quarry_color,
                run.quarry_next_turn_ms.f64() / 1000.0,
                run.quarry_next_surge_ms.f64() / 1000.0,
                run.quarry_next_resize_ms.f64() / 1000.0,
                run.quarry_next_morph_ms.f64() / 1000.0)

    def copy_from_source(run: mutable PursuitRun&, source: Pursuit::PursuitSourceRun&):
        can Abort.Panic:
            Pursuit::adapter_save(source, &run.round_number, &run.multiplier,
                &run.on_time, &run.run_time, &run.off_sum, &run.off_samples,
                &run.until_ms, &run.phase, &run.verdict, &run.mouse_x, &run.mouse_y,
                &run.result_count, &run.result_share, &run.result_drift,
                &run.result_multiplier, &run.quarry_x, &run.quarry_y,
                &run.quarry_heading, &run.quarry_surge, &run.quarry_radius,
                &run.quarry_form, &run.quarry_color, &run.quarry_next_turn_ms,
                &run.quarry_next_surge_ms, &run.quarry_next_resize_ms,
                &run.quarry_next_morph_ms)

    def start(run: mutable PursuitRun&, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            clear_score(run)
            region scratch(268435456):
                in scratch:
                    source: mutable Pursuit::PursuitSourceRun = Pursuit::new_run()
                    copy_to_source(run, &source)
                    Pursuit::adapter_start(&source, now_ms.f64() / 1000.0, &run.rng)
                    copy_from_source(run, &source)
                destroy scratch
            run.clock_ms <- now_ms

    def advance(run: mutable PursuitRun&, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 2 if run.phase == PHASE_READY or run.phase == PHASE_DONE
            delta: i64 = now_ms - run.clock_ms
            bounded: i64 = 100 if delta > 100 else (0 if delta < 0 else delta)
            before_phase: i64 = run.phase
            region scratch(268435456):
                in scratch:
                    source: mutable Pursuit::PursuitSourceRun = Pursuit::new_run()
                    copy_to_source(run, &source)
                    Pursuit::adapter_update(&source, bounded.f64() / 1000.0,
                        REFERENCE_WIDTH, REFERENCE_HEIGHT,
                        now_ms.f64() / 1000.0, &run.rng)
                    copy_from_source(run, &source)
                destroy scratch
            run.clock_ms <- now_ms
            return 1 if run.phase != before_phase or bounded > 0 else 2

    def pointer(run: mutable PursuitRun&, x_millionths: i64, y_millionths: i64) -> i64:
        can Abort.Panic:
            return 2 if x_millionths < 0 or x_millionths > 1000000 or y_millionths < 0 or y_millionths > 1000000
            run.mouse_x <- x_millionths.f64() * REFERENCE_WIDTH / 1000000.0
            run.mouse_y <- y_millionths.f64() * REFERENCE_HEIGHT / 1000000.0
            return 1

    def nudge(run: mutable PursuitRun&, dx: f64, dy: f64) -> i64:
        can Abort.Panic:
            region scratch(1048576):
                in scratch:
                    source: mutable Pursuit::PursuitSourceRun = Pursuit::new_run()
                    copy_to_source(run, &source)
                    Pursuit::adapter_nudge(&source, dx, dy, REFERENCE_WIDTH, REFERENCE_HEIGHT)
                    run.mouse_x <- source.mouse_x
                    run.mouse_y <- source.mouse_y
                destroy scratch
            return 1

    def current_on_percent(run: PursuitRun&) -> i64:
        can Abort.Panic:
            return 0 if run.run_time <= 0.0
            return py_round_half_even(1000000.0 * run.on_time / run.run_time)

    def total_on_percent(run: PursuitRun&) -> i64:
        can Abort.Panic:
            return 0 if run.result_count <= 0
            total: mutable f64 = 0.0
            for at in 0..<run.result_count |at, run, total|:
                total <- total + run.result_share[at.usize()]
            return py_round_half_even(100.0 * total / run.result_count.f64())

    def mean_off_px(run: PursuitRun&) -> i64:
        can Abort.Panic:
            return 0 if run.result_count <= 0
            total: mutable f64 = 0.0
            for at in 0..<run.result_count |at, run, total|:
                total <- total + run.result_drift[at.usize()]
            return py_round_half_even(total / run.result_count.f64())

    def info(run: PursuitRun&, field: i64) -> i64:
        can Abort.Panic:
            if field == INFO_PHASE: return run.phase
            if field == INFO_SPEED: return run.speed_percent
            if field == INFO_SURGE: return run.surge_percent
            if field == INFO_TURN_MS: return run.turn_ms
            if field == INFO_TURN_DEGREES: return run.turn_degrees
            if field == INFO_SIZE: return run.size
            if field == INFO_WOBBLE: return run.wobble_percent
            if field == INFO_MORPH_MS: return run.morph_ms
            if field == INFO_SECONDS: return run.seconds
            if field == INFO_TOTAL_ROUNDS: return run.total_rounds
            if field == INFO_ADAPTIVE: return 1 if run.adaptive else 0
            if field == INFO_ROUND: return run.round_number
            if field == INFO_MULTIPLIER: return (run.multiplier * 1000000.0).i64()
            if field == INFO_ON_TIME_PPM: return current_on_percent(run)
            if field == INFO_RUN_TIME_MS: return (run.run_time * 1000.0).i64()
            if field == INFO_OFF_SUM_PX: return run.off_sum.i64()
            if field == INFO_OFF_SAMPLES: return run.off_samples
            if field == INFO_UNTIL_MS: return run.until_ms
            if field == INFO_VERDICT: return run.verdict
            if field == INFO_RESULT_COUNT: return run.result_count
            if field == INFO_ON_PERCENT: return total_on_percent(run)
            if field == INFO_MEAN_OFF_PX: return mean_off_px(run)
            if field == INFO_MOUSE_X: return run.mouse_x.i64()
            if field == INFO_MOUSE_Y: return run.mouse_y.i64()
            if field == INFO_CLOCK_MS: return run.clock_ms
            return -1

    def value(run: PursuitRun&, field: i64, at: i64) -> i64:
        can Abort.Panic:
            if field == RESULT_SHARE_PPM or field == RESULT_DRIFT_PX or field == RESULT_MULTIPLIER_PPM:
                return -1 if at < 0 or at >= run.result_count
                if field == RESULT_SHARE_PPM:
                    return (run.result_share[at.usize()] * 1000000.0).i64()
                if field == RESULT_DRIFT_PX:
                    return (run.result_drift[at.usize()] * 1000000.0).i64()
                return (run.result_multiplier[at.usize()] * 1000000.0).i64()
            return -1 if at != 0
            if field == VALUE_X: return (run.quarry_x * 1000000.0).i64()
            if field == VALUE_Y: return (run.quarry_y * 1000000.0).i64()
            if field == VALUE_HEADING: return (run.quarry_heading * 1000000.0).i64()
            if field == VALUE_SURGE: return (run.quarry_surge * 1000000.0).i64()
            if field == VALUE_RADIUS: return (run.quarry_radius * 1000000.0).i64()
            if field == VALUE_FORM: return run.quarry_form
            if field == VALUE_COLOR: return run.quarry_color
            if field == VALUE_NEXT_TURN_MS: return run.quarry_next_turn_ms
            if field == VALUE_NEXT_SURGE_MS: return run.quarry_next_surge_ms
            if field == VALUE_NEXT_RESIZE_MS: return run.quarry_next_resize_ms
            if field == VALUE_NEXT_MORPH_MS: return run.quarry_next_morph_ms
            return -1

    def append_fixed(out: mutable dstr&, value: f64):
        can Memory.Allocate, Abort.Panic:
            dstr_append_fixed(out, value, 2)

    def append_message(out: mutable dstr&, run: PursuitRun&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == PHASE_READY:
                dstr_append_cstr(out, "Press Space to start")
            elif run.phase == PHASE_CHASING:
                dstr_append_cstr(out, "Stay on it")
            elif run.phase == PHASE_FEEDBACK:
                dstr_append_cstr(out, "On it ")
                dstr_append_i64(out, py_round_half_even(100.0 * run.on_time / run.run_time) if run.run_time > 0.0 else 0)
                dstr_append_cstr(out, "% of the time")
            else:
                dstr_append_cstr(out, "On target ")
                dstr_append_i64(out, total_on_percent(run))
                dstr_append_cstr(out, "% over ")
                dstr_append_i64(out, run.result_count)
                dstr_append_cstr(out, " rounds — difficulty settled at x")
                append_fixed(out, run.multiplier)

    def render(run: PursuitRun&, black_background: bool, width: f64,
               height: f64, list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            sx: f64 = width / REFERENCE_WIDTH
            sy: f64 = height / REFERENCE_HEIGHT
            paint: ScenePursuit::PursuitPaint = ScenePursuit::paint_of(
                black_background, width, height, sx, sy)
            message: mutable dstr = []
            append_message(&message, run)
            verdict_text: mutable dstr = []
            if run.phase == PHASE_FEEDBACK:
                append_message(&verdict_text, run)
            ScenePursuit::render(list, &paint, run.phase,
                run.phase == PHASE_CHASING or run.phase == PHASE_FEEDBACK,
                run.quarry_x, run.quarry_y, run.quarry_radius,
                run.quarry_form, run.quarry_color, run.adaptive,
                run.multiplier, run.round_number, run.total_rounds,
                bytes_view(message), run.verdict, bytes_view(verdict_text))

    def initialize(run: mutable PursuitRun&, speed: i64, surge: i64, turn_ms: i64,
                   turn_degrees: i64, size: i64, packed_extra: i64, seed: i64):
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            run.rng <- rng
            run.speed_percent <- speed
            run.surge_percent <- surge
            run.turn_ms <- turn_ms
            run.turn_degrees <- turn_degrees
            run.size <- size
            run.packed_extra <- packed_extra
            run.wobble_percent <- packed_wobble(packed_extra)
            run.morph_ms <- packed_morph(packed_extra)
            run.seconds <- packed_seconds(packed_extra)
            run.total_rounds <- packed_rounds(packed_extra)
            run.adaptive <- packed_adaptive(packed_extra)
            run.speed <- speed.f64() / 100.0
            run.surge_depth <- surge.f64() / 100.0
            run.turn_gap <- turn_ms.f64() / 1000.0
            run.sharpness <- Pursuit::radians(turn_degrees.f64())
            run.base_radius <- size.f64()
            run.wobble <- run.wobble_percent.f64() / 100.0
            run.morph_gap <- run.morph_ms.f64() / 1000.0
            run.mouse_x <- REFERENCE_WIDTH / 2.0
            run.mouse_y <- REFERENCE_HEIGHT / 2.0
            clear_score(run)

    def apply(run: mutable PursuitRun&, action: i64, value: i64, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            if action == ACTION_START:
                return 2 if run.phase != PHASE_READY and run.phase != PHASE_DONE
                start(run, now_ms)
                return 1
            if action == ACTION_UP: return nudge(run, 0.0, 1.0)
            if action == ACTION_DOWN: return nudge(run, 0.0, -1.0)
            if action == ACTION_LEFT: return nudge(run, -1.0, 0.0)
            if action == ACTION_RIGHT: return nudge(run, 1.0, 0.0)
            return -6
