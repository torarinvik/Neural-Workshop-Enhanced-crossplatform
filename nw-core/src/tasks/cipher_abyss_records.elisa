include "./cipher_abyss_run.elisa"
include "../pymath.elisa"
include "./cipher_lang_words.elisa"

extend CipherAbyss:
    struct Summary:
        bits: darray[f64]
        words: dstr
        best: i64
        standing: i64

    def summarize(program: darray[CipherLang::Node]&, rules: CipherLang::Rules&, run: Run&) -> Summary:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            bits: mutable darray[f64] = []
            best: mutable i64 = -1
            highest: mutable f64 = -1.0
            standing: mutable i64 = rules.hypotheses.count.i64()
            n: i64 = run.log.count.i64()
            _ = bits.reserve(n.usize())
            for i in 0..<n |bits|:
                bits.push(0.0)
            region scratch(1048576):
                in scratch:
                    player: mutable CipherLang::Mind = CipherLang::mind(run.machine.level, &rules.hypotheses, 0)
                    CipherLang::update(program, &player, &run.log)
                    standing <- player.alive.count.i64()
                    before: mutable i64 = rules.hypotheses.count.i64()
                    for i in 0..<n |player, bits, before, best, highest|:
                        after: i64 = max(1, player.history[(i + 1).usize()])
                        value: f64 = log2(before.f64() / after.f64()) if before > 0 else 0.0
                        bits[i.usize()] <- value
                        if value > highest:
                            highest <- value
                            best <- i
                        before <- after
            words: mutable dstr = []
            CipherLang::write_rule_words(&words, program, run.machine.rule)
            return Summary{bits: bits, words: words, best: best, standing: standing}

    def end_tones(run: mutable Run&, summary: Summary&):
        can Abort.Panic, Memory.Allocate:
            for i in 0..<summary.bits.count.i64() |run, summary|:
                bits: f64 = summary.bits[i.usize()]
                time: f64 = run.time + 0.4 + 0.28 * i.f64()
                if bits >= 0.5:
                    note(run, 0.22, 660.0 + 70.0 * fmin(bits, 6.0), CHIME, 0.3, 0.0, 0.8, time)
                else:
                    note(run, 0.26, 110.0, BUZZ, 0.22, 0.0, 0.8, time)

    def write_row(out: mutable dstr&, row: darray[i64]&):
        can Abort.Panic, Memory.Allocate:
            for i in 0..<row.count.i64() |out, row|:
                dstr_append_cstr(out, " ") if i > 0
                dstr_append_i64(out, row[i.usize()])

    def export_sample(out: mutable dstr&, sample: CipherLang::Sample&):
        can Abort.Panic, Memory.Allocate:
            write_row(out, &sample.given)
            dstr_append_cstr(out, " -> ")
            write_row(out, &sample.result)

    def notebook_text(out: mutable dstr&, program: darray[CipherLang::Node]&, run: Run&):
        can Abort.Panic, Memory.Allocate:
            level: Grade = run.machine.level
            dstr_append_cstr(out, "# The Cipher Abyss, rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, " (")
            dstr_append_cstr(out, stage_name(level))
            dstr_append_cstr(out, ")\n# symbols 0-")
            dstr_append_i64(out, level.symbols - 1)
            dstr_append_cstr(out, "; input -> output\n")
            for i in 0..<run.log.count.i64() |run, out|:
                dstr_append_cstr(out, " ") if i < 9
                dstr_append_i64(out, i + 1)
                dstr_append_cstr(out, "  ")
                export_sample(out, &run.log[i.usize()])
                dstr_append_cstr(out, "\n")
            for answer in run.answers:
                row: CipherLang::Sample = answer.sample
                dstr_append_cstr(out, "test ")
                export_sample(out, &row)
                dstr_append_cstr(out, "  right\n" if answer.correct else "  wrong\n")
            if run.result != LIVE:
                dstr_append_cstr(out, "# the machine: ")
                CipherLang::write_code(out, program, run.machine.rule)
                dstr_append_cstr(out, "\n")

    def kind_name(kind: i64) -> cstr:
        return "twins" if kind == CipherLang::TWINS
        return "invert" if kind == CipherLang::INVERT
        return "crack"

    def metrics(out: mutable dstr&, program: darray[CipherLang::Node]&, run: Run&, summary: Summary&):
        can Abort.Panic, Memory.Allocate:
            level: Grade = run.machine.level
            asked: i64 = run.answers.count.i64() + (1 if run.said_same >= 0 else 0)
            right: mutable i64 = 1 if run.said_same == 1 else 0
            for answer in run.answers:
                right <- right + 1 if answer.correct
            dstr_append_cstr(out, "{\"rung\":")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ",\"stage\":\"")
            dstr_append_cstr(out, stage_name(level))
            dstr_append_cstr(out, "\",\"kind\":\"")
            dstr_append_cstr(out, kind_name(run.machine.kind))
            dstr_append_cstr(out, "\",\"won\":")
            dstr_append_cstr(out, "true" if won(run.result) else "false")
            dstr_append_cstr(out, ",\"accuracy\":")
            if asked > 0:
                dstr_append_fixed(out, right.f64() / asked.f64(), 17)
            else:
                dstr_append_cstr(out, "null")
            dstr_append_cstr(out, ",\"questions\":")
            dstr_append_i64(out, asked)
            dstr_append_cstr(out, ",\"experiments\":")
            dstr_append_i64(out, run.log.count.i64())
            dstr_append_cstr(out, ",\"reference_experiments\":")
            dstr_append_i64(out, run.machine.plan.count.i64())
            dstr_append_cstr(out, ",\"bits\":[")
            bits: mutable f64 = 0.0
            for i in 0..<summary.bits.count.i64() |summary, out, bits|:
                value: f64 = summary.bits[i.usize()]
                bits <- bits + value
                dstr_append_cstr(out, ",") if i > 0
                dstr_append_fixed(out, py_round_decimal(value, 1000.0), 3)
            dstr_append_cstr(out, "],\"bits_per_experiment\":")
            dstr_append_fixed(out, py_round_decimal(bits / max(1, summary.bits.count.i64()).f64(), 1000.0), 3)
            dstr_append_cstr(out, ",\"rule\":\"")
            CipherLang::write_code(out, program, run.machine.rule)
            dstr_append_cstr(out, "\",\"rule_size\":")
            dstr_append_i64(out, CipherLang::size(program, run.machine.rule))
            if run.submitted >= 0:
                dstr_append_cstr(out, ",\"submitted\":\"")
                CipherLang::write_code(out, program, run.submitted)
                dstr_append_cstr(out, "\",\"submitted_size\":")
                dstr_append_i64(out, CipherLang::size(program, run.submitted))
            else:
                dstr_append_cstr(out, ",\"submitted\":null,\"submitted_size\":null")
            dstr_append_cstr(out, ",\"seconds\":")
            dstr_append_fixed(out, py_round_decimal(run.time, 100.0), 2)
            dstr_append_cstr(out, "}\n")
