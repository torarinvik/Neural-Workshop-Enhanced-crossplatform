# The Python cache writes question, answer, kind, and pipe-separated aliases.
extend TriviaGame:
    def index_bank(data: heap u8&, length: i64) -> Trivia::TriviaBank:
        can Memory.Allocate, Abort.Panic:
            raw: mutable darray[i64] = Ints::zeros(length)
            rows: mutable i64 = 1
            aliases_capacity: mutable i64 = 1
            for at in 0..<length |data, raw, rows, aliases_capacity|:
                byte: i64 = data[at.usize()].i64()
                Ints::put(&raw, at, byte)
                rows <- rows + 1 if byte == 10
                aliases_capacity <- aliases_capacity + 1 if byte == 124
            rows <- length / Trivia::QUESTION_SHORTEST + 1 if rows > length / Trivia::QUESTION_SHORTEST + 1
            rows <- 200000 if rows > 200000
            aliases_capacity <- rows * Trivia::ALIASES if aliases_capacity > rows * Trivia::ALIASES
            bank: mutable Trivia::TriviaBank = Trivia::new_bank(rows, length, rows * 2 + aliases_capacity)
            offsets: mutable darray[i64] = Ints::zeros(Trivia::ALIASES + 1)
            sizes: mutable darray[i64] = Ints::zeros(Trivia::ALIASES + 1)
            scratch: mutable darray[i64] = Ints::zeros(4096)
            start: mutable i64 = 0
            while start < length |start, length, raw, bank, offsets, sizes, scratch|:
                end: i64 = field_end(&raw, start, length, 10)
                stop: i64 = end - 1 if end > start and Ints::at_ref(&raw, end - 1) == 13 else end
                asked: i64 = start
                answer: i64 = field_end(&raw, asked, stop, 9) + 1
                kind: i64 = field_end(&raw, answer, stop, 9) + 1
                aliases: i64 = field_end(&raw, kind, stop, 9) + 1
                start <- end + 1
                continue if aliases > stop or field_end(&raw, aliases, stop, 9) != stop
                saved_kind: i64 = index_kind(&raw, kind, aliases - 1)
                continue if saved_kind < 0
                count: mutable i64 = 0
                at: mutable i64 = aliases
                while at < stop and count < Trivia::ALIASES + 1 |at, stop, count, raw, offsets, sizes|:
                    next: i64 = field_end(&raw, at, stop, 124)
                    if next > at:
                        Ints::put(&offsets, count, at)
                        Ints::put(&sizes, count, next - at)
                        count <- count + 1
                    at <- next + 1
                _ = Trivia::question_from(&bank, &raw, asked, answer - asked - 1,
                    answer, kind - answer - 1, &offsets, &sizes, count, &scratch, saved_kind)
            Trivia::index_kinds(&bank)
            return bank

    def index_kind(raw: mutable darray[i64]&, start: i64, end: i64) -> i64:
        can Abort.Panic:
            return Trivia::KIND_YEAR if index_kind_is(raw, start, end, sview("year", 0, -1))
            return Trivia::KIND_NUMBER if index_kind_is(raw, start, end, sview("number", 0, -1))
            return Trivia::KIND_NAME if index_kind_is(raw, start, end, sview("name", 0, -1))
            return Trivia::KIND_PHRASE if index_kind_is(raw, start, end, sview("phrase", 0, -1))
            return Trivia::KIND_WORD if index_kind_is(raw, start, end, sview("word", 0, -1))
            return -1

    def index_kind_is(raw: mutable darray[i64]&, start: i64, end: i64, name: sview) -> bool:
        can Abort.Panic:
            return false if sview_len(name).i64() != end - start
            for at in 0..<(end - start) |raw, start, name|:
                return false if Ints::at_ref(raw, start + at) != sview_at(name, at.usize()).i64()
            return true

    def field_end(raw: mutable darray[i64]&, start: i64, end: i64, delimiter: i64) -> i64:
        can Abort.Panic:
            for at in start..<end |raw, delimiter|:
                return at if Ints::at_ref(raw, at) == delimiter
            return end
