include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_json.elisa"
include "./cipher_abyss_library.elisa"

extend CipherAbyss:
    def read_library(out: mutable Library&, text: sview) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            region scratch(65536):
                in scratch:
                    parsed = json_parse_checked(&scratch, text) can Global{Read,Write}
                    return false if parsed.code != JsonErrorCode.OK
                    root = parsed.value
                    return false if not json_handle_is_object(root)
                    if not json_handle_has(root, "operators"):
                        out[0] <- zeroed
                        return true
                    entries: JsonValueHandle[scratch] = try json_handle_get(root, "operators") else json_handle_null(root)
                    return false if not json_handle_is_object(entries)
                    loaded: mutable Library = zeroed
                    for op in 0..<CipherLang::FIRST |loaded, entries|:
                        key: sview = sview(CipherLang::name(op), 0, -1)
                        value: JsonValueHandle[scratch] = try json_handle_get(entries, key) else json_handle_null(entries)
                        rung: f64 = try json_handle_as_number(value) else 0.0
                        if rung >= 1.0 and rung < 9223372036854775808.0:
                            integer: i64 = rung.i64()
                            loaded.rungs[op.usize()] <- integer if integer.f64() == rung
                    out[0] <- loaded
                    return true
            return false
