include "../strings.elisa"
include "./browser_pages.elisa"

module BrowserText:
    # The words of browser.py's shop, built where the pages only name them:
    # element text, the address bar, the tab title, and the goal.

    # A product's name: "Brava K12".
    def name(out: mutable dstr&, product: Browser::Product&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_cstr(out, Browser::brand_name(product.brand))
            out.push(32.u8())
            out.push(Browser::kind_letter(product.kind).u8())
            dstr_append_i64(out, product.number)

    # The same name in an address: "brava-k12".
    def slug(out: mutable dstr&, product: Browser::Product&):
        can Memory.Allocate, Abort.Panic:
            spelled: mutable dstr = []
            name(&spelled, product)
            for byte in spelled |out|:
                if byte == 32.u8():
                    out.push(45.u8())
                elif byte >= 65.u8() and byte <= 90.u8():
                    out.push(byte + 32.u8())
                else:
                    out.push(byte)

    def sort_words(sort: i64) -> cstr:
        return "Featured" if sort == Browser::FEATURED
        return "Price, low to high" if sort == Browser::BY_PRICE
        return "Rating, high to low"

    def notice_words(notice: i64) -> cstr:
        return "Added to the cart." if notice == BrowserPages::ADDED
        return "Sorry, this is out of stock." if notice == BrowserPages::SOLD_OUT
        return ""

    def dollars(out: mutable dstr&, amount: i64):
        can Memory.Allocate, Abort.Panic:
            out.push(36.u8())
            dstr_append_i64(out, amount)

    # What an element says.
    def words(out: mutable dstr&, dealt: Browser::Deal&, said: BrowserPages::Words):
        can Memory.Allocate, Abort.Panic:
            what: i64 = said.says
            if what == BrowserPages::SAYS_WELCOME:
                dstr_append_cstr(out, "Welcome to ")
                dstr_append_cstr(out, Browser::shop_title(said.first))
            elif what == BrowserPages::SAYS_SHOP_BY:
                dstr_append_cstr(out, "Shop by department")
            elif what == BrowserPages::SAYS_DEPARTMENT:
                dstr_append_cstr(out, Browser::kind_name(said.first))
            elif what == BrowserPages::SAYS_DEAL:
                dstr_append_cstr(out, "Today's deal: ")
                name(out, &dealt.products[said.first.usize()])
                dstr_append_cstr(out, ", ")
                dollars(out, dealt.products[said.first.usize()].listed)
            elif what == BrowserPages::SAYS_SORT:
                dstr_append_cstr(out, "Sort:")
            elif what == BrowserPages::SAYS_SORT_ORDER:
                dstr_append_cstr(out, sort_words(said.first))
            elif what == BrowserPages::SAYS_STALE:
                dstr_append_cstr(out, "List prices may be out of date")
            elif what == BrowserPages::SAYS_NAME:
                name(out, &dealt.products[said.first.usize()])
            elif what == BrowserPages::SAYS_DOLLARS:
                dollars(out, said.first)
            elif what == BrowserPages::SAYS_RATED:
                dstr_append_cstr(out, "rated ")
                dstr_append_fixed(out, dealt.products[said.first.usize()].rating, 1)
            elif what == BrowserPages::SAYS_PREVIOUS:
                dstr_append_cstr(out, "Previous page")
            elif what == BrowserPages::SAYS_PAGE_OF:
                dstr_append_cstr(out, "Page ")
                dstr_append_i64(out, said.first)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, said.second)
            elif what == BrowserPages::SAYS_NEXT:
                dstr_append_cstr(out, "Next page")
            elif what == BrowserPages::SAYS_PRICE:
                dstr_append_cstr(out, "Price: ")
                dollars(out, said.first)
            elif what == BrowserPages::SAYS_RATED_OUT_OF:
                dstr_append_cstr(out, "Rated ")
                dstr_append_fixed(out, dealt.products[said.first.usize()].rating, 1)
                dstr_append_cstr(out, " out of 5")
            elif what == BrowserPages::SAYS_IN_STOCK:
                dstr_append_cstr(out, "In stock")
            elif what == BrowserPages::SAYS_OUT_OF_STOCK:
                dstr_append_cstr(out, "Out of stock")
            elif what == BrowserPages::SAYS_SHIPPING:
                if said.first == 0:
                    dstr_append_cstr(out, "Shipping: free")
                else:
                    dstr_append_cstr(out, "Shipping: ")
                    dollars(out, said.first)
            elif what == BrowserPages::SAYS_ADD:
                dstr_append_cstr(out, "Add to cart")
            elif what == BrowserPages::SAYS_MORE:
                dstr_append_cstr(out, "More ")
                dstr_append_cstr(out, Browser::kind_lower(said.first))
            elif what == BrowserPages::SAYS_NOTICE:
                dstr_append_cstr(out, notice_words(said.first))
            elif what == BrowserPages::SAYS_YOUR_CART:
                dstr_append_cstr(out, "Your cart")
            elif what == BrowserPages::SAYS_CART_EMPTY:
                dstr_append_cstr(out, "The cart is empty.")
            elif what == BrowserPages::SAYS_REMOVE:
                dstr_append_cstr(out, "Remove")
            elif what == BrowserPages::SAYS_TOTAL:
                dstr_append_cstr(out, "Total with shipping: ")
                dollars(out, said.first)
            elif what == BrowserPages::SAYS_ORDER_PLACED:
                dstr_append_cstr(out, "Thank you -- order placed")
            elif what == BrowserPages::SAYS_ORDER_NUMBER:
                dstr_append_cstr(out, "Order number: ")
                dstr_append_i64(out, said.first)
            elif what == BrowserPages::SAYS_TOTAL_CHARGED:
                dstr_append_cstr(out, "Total charged: ")
                dollars(out, said.first)
            elif what == BrowserPages::SAYS_CONTINUE:
                dstr_append_cstr(out, "Continue shopping")
            else:
                dstr_append_cstr(out, "Check out")

    # address: the address bar for a page.
    def address(out: mutable dstr&, dealt: Browser::Deal&, page: BrowserPages::Action&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_cstr(out, Browser::shop_name(dealt.shop))
            dstr_append_cstr(out, ".example")
            if page.kind == BrowserPages::HOME:
                out.push(47.u8())
            elif page.kind == BrowserPages::LIST:
                out.push(47.u8())
                dstr_append_cstr(out, Browser::kind_lower(dealt.kinds[page.department.usize()]))
                if page.sort != Browser::FEATURED:
                    dstr_append_cstr(out, "?sort=")
                    dstr_append_cstr(out, "price" if page.sort == Browser::BY_PRICE else "rating")
                if page.number != 0:
                    dstr_append_cstr(out, "&page=" if page.sort != Browser::FEATURED else "?page=")
                    dstr_append_i64(out, page.number + 1)
            elif page.kind == BrowserPages::ITEM:
                dstr_append_cstr(out, "/item/")
                slug(out, &dealt.products[page.index.usize()])
            elif page.kind == BrowserPages::PLACED:
                dstr_append_cstr(out, "/placed")
            else:
                dstr_append_cstr(out, "/cart")

    # _page_title: the tab's words.
    def page_title(out: mutable dstr&, dealt: Browser::Deal&, page: BrowserPages::Action&):
        can Memory.Allocate, Abort.Panic:
            if page.kind == BrowserPages::HOME:
                dstr_append_cstr(out, Browser::shop_title(dealt.shop))
            elif page.kind == BrowserPages::LIST:
                dstr_append_cstr(out, Browser::kind_name(dealt.kinds[page.department.usize()]))
            elif page.kind == BrowserPages::ITEM:
                name(out, &dealt.products[page.index.usize()])
            elif page.kind == BrowserPages::PLACED:
                dstr_append_cstr(out, "Order placed")
            else:
                dstr_append_cstr(out, "Your cart")

    # phrase: one thing to buy, in words.
    def phrase(out: mutable dstr&, dealt: Browser::Deal&, goal: i64):
        can Memory.Allocate, Abort.Panic:
            phrase_for(out, dealt, dealt.goal_criteria[goal.usize()], dealt.goal_departments[goal.usize()],
                dealt.targets[goal.usize()])

    # phrase_for: any criterion in a department; `target` names the product
    # for NAMED.
    def phrase_for(out: mutable dstr&, dealt: Browser::Deal&, criterion: i64, department: i64, target: i64):
        can Memory.Allocate, Abort.Panic:
            kind: cstr = Browser::kind_singular(dealt.kinds[department.usize()])
            if criterion == Browser::NAMED:
                dstr_append_cstr(out, "the ")
                name(out, &dealt.products[target.usize()])
            elif criterion == Browser::CHEAPEST:
                dstr_append_cstr(out, "the cheapest ")
                dstr_append_cstr(out, kind)
            elif criterion == Browser::CHEAPEST_IN_STOCK:
                dstr_append_cstr(out, "the cheapest ")
                dstr_append_cstr(out, kind)
                dstr_append_cstr(out, " in stock")
            elif criterion == Browser::LOWEST_TOTAL:
                dstr_append_cstr(out, "the ")
                dstr_append_cstr(out, kind)
                dstr_append_cstr(out, " in stock with the lowest price plus shipping")
            elif criterion == Browser::RATED:
                dstr_append_cstr(out, "the cheapest ")
                dstr_append_cstr(out, kind)
                dstr_append_cstr(out, " in stock rated 4 or more")
            else:
                dstr_append_cstr(out, "the best-rated ")
                dstr_append_cstr(out, kind)
                dstr_append_cstr(out, " in stock")

    # goal_words: "Buy the cheapest kettle and the Brava L7, then check out."
    def goal_words(out: mutable dstr&, dealt: Browser::Deal&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_cstr(out, "Buy ")
            for goal in 0..<dealt.goal_count |out, dealt|:
                dstr_append_cstr(out, " and ") if goal > 0
                phrase(out, dealt, goal)
            dstr_append_cstr(out, ", then check out.")
