include "./bluff_reference.elisa"

module BluffGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const FLAGGED: i64 = 4
    const START: i64 = 2
    const FEEDBACK_MS: i64 = 3000

    struct Session:
        rng: mutable MT19937
        owner: mutable Arena
        start_rung: i64
        total: i64
        adaptive: bool
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        round: mutable Bluff::Match
        par: mutable f64
        verdict_value: mutable f64
        verdict_chips: mutable i64
        verdict_first: mutable i64
        verdict_later: mutable i64
        passed: mutable bool
        wins: mutable i64
        best_rung: mutable i64
        deadline_ms: mutable i64
        last_ms: mutable i64
        forfeits: mutable i64
        agent_seconds: mutable f64
        think_capacity: mutable f64
        think_refill: mutable f64
        think_left: mutable f64
        agent_mode: mutable bool
        verdict_published: mutable bool
        has_verdict: mutable bool

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 3 or rung == 5 or rung == 7 or rung == 10 or rung == 14 or rung == 18 or rung == 21 or rung == 25

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 8 or total == 12

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = zeroed
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            initial: i64 = rung if rung > 0 else 1
            return Session{rng: rng, owner: zeroed, start_rung: initial, total: total, adaptive: adaptive,
                rung: initial, trial: 0, phase: READY, round: zeroed, par: 0.0,
                verdict_value: 0.0, verdict_chips: 0, verdict_first: Bluff::STATION, verdict_later: Bluff::STATION,
                passed: false, wins: 0, best_rung: 0, deadline_ms: 0, last_ms: 0, forfeits: 0, agent_seconds: 0.0,
                think_capacity: 0.0, think_refill: 0.0, think_left: 0.0, agent_mode: false,
                verdict_published: false, has_verdict: false}

    def close(session: mutable Session&):
        can Abort.Panic, Memory.Release:
            arena_free(&session.owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}
            session.round <- zeroed
            session.phase <- READY

    def reconfigure(session: mutable Session&, rung: i64, total: i64, adaptive: bool) -> bool:
        can Abort.Panic, Memory.Release:
            return false if session.agent_mode or (session.phase != READY and session.phase != DONE)
            return false if not allowed_rung(rung) or not allowed_total(total)
            rng: MT19937 = session.rng
            close(session) can Global{Read,Write}
            session[0] <- initialize(rung, total, adaptive, 0)
            session.rng <- rng
            return true

    def deal_owned(owner: mutable Arena&, rung: i64, rng: mutable MT19937&) -> Bluff::Match:
        can Abort.Panic, Memory.Allocate:
            in owner:
                return Bluff::initialize(Bluff::deal(rung, rng))

    def next_trial(session: mutable Session&, now_ms: i64):
        can Abort.Panic, Memory.Allocate, Memory.Release:
            close(session) can Global{Read,Write}
            session.last_ms <- now_ms
            if session.trial >= session.total:
                session.phase <- DONE
                return
            session.round <- deal_owned(&session.owner, session.rung, &session.rng)
            region scratch(65536):
                in scratch:
                    session.par <- BluffReference::par(session.round.dealt)
            session.trial <- session.trial + 1
            session.deadline_ms <- 0
            session.verdict_published <- false
            session.has_verdict <- false
            session.phase <- PLAYING

    def start(session: mutable Session&, now_ms: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if session.total <= 0 or (session.phase != READY and session.phase != DONE)
            session.rung <- session.start_rung
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            session.forfeits <- 0
            session.think_left <- session.think_capacity
            next_trial(session, now_ms) can Global{Read,Write}
            return true

    def owned_act(owner: mutable Arena&, round: mutable Bluff::Match&, choice: i64) -> bool:
        can Abort.Panic, Memory.Allocate:
            in owner:
                return Bluff::act(round, choice)

    def judge(session: mutable Session&, now_ms: i64):
        session.verdict_value <- Bluff::value(&session.round)
        session.verdict_chips <- session.round.chips
        session.verdict_first <- session.round.dealt.first_kind
        session.verdict_later <- session.round.dealt.later_kind
        passed: bool = session.verdict_value >= session.par - 1e-9
        session.passed <- passed
        session.has_verdict <- true
        if passed:
            session.wins <- session.wins + 1
            session.best_rung <- session.rung if session.rung > session.best_rung
        if session.adaptive:
            session.rung <- session.rung + 1 if passed and session.rung < 9223372036854775807
            session.rung <- session.rung - 1 if not passed and session.rung > 1
        session.deadline_ms <- now_ms + FEEDBACK_MS
        session.phase <- JUDGED

    def input(session: mutable Session&, port: i64, now_ms: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if now_ms < session.last_ms or now_ms > 9007199254740991
            return start(session, now_ms) can Global{Read,Write} if port == START
            return false if session.phase != PLAYING
            return false if not owned_act(&session.owner, &session.round, port)
            session.last_ms <- now_ms
            if Bluff::over(&session.round):
                judge(session, now_ms)
            return true

    def advance(session: mutable Session&, now_ms: i64, stepped: bool = false) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if now_ms < session.last_ms or now_ms > 9007199254740991
            return false if session.agent_mode or session.phase != JUDGED or (not stepped and now_ms < session.deadline_ms)
            next_trial(session, now_ms) can Global{Read,Write}
            return true

    def configure_think(session: mutable Session&, capacity: f64, refill: f64) -> bool:
        return false if session.phase != READY or not (capacity >= 0.0 and capacity <= 1.7976931348623157e308)
        return false if not (refill >= 0.0 and refill <= 1.7976931348623157e308)
        session.agent_mode <- true
        session.think_capacity <- capacity
        session.think_refill <- refill if refill < capacity else capacity
        session.think_left <- capacity
        return true

    def agent_action(session: mutable Session&, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if not session.agent_mode
            return input(session, port, (session.agent_seconds * 1000.0).i64()) can Global{Read,Write}

    def step(session: mutable Session&, elapsed_seconds: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            next: f64 = session.agent_seconds + elapsed_seconds
            return false if not session.agent_mode or not (elapsed_seconds > 0.0 and next <= 9007199254740.0)
            return false if session.phase == READY or session.phase == DONE
            session.agent_seconds <- next
            if session.phase == PLAYING:
                if session.think_capacity > 0.0:
                    session.think_left <- session.think_left - elapsed_seconds
                    if session.think_left <= 0.000000001:
                        session.think_left <- 0.0
                        session.forfeits <- session.forfeits + 1
                        session.has_verdict <- false
                        session.phase <- FLAGGED
                return true
            if session.phase == JUDGED and not session.verdict_published:
                session.verdict_published <- true
                return true
            next_trial(session, (next * 1000.0).i64()) can Global{Read,Write}
            if session.phase == PLAYING:
                room: f64 = session.think_capacity - session.think_left
                session.think_left <- session.think_left + (session.think_refill if session.think_refill < room else room)
            return true

    def info(session: Session&, field: i64) -> i64:
        return session.phase if field == 0
        return session.rung if field == 1
        return session.trial if field == 2
        return session.total if field == 3
        return session.round.records.count.i64() if field == 4
        return session.round.chips if field == 5
        return session.wins if field == 6
        return session.best_rung if field == 7
        return session.start_rung if field == 8
        return 1 if field == 9 and session.adaptive
        return 0 if field == 9
        return session.forfeits if field == 10
        return -1
