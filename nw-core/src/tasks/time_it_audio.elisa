include "./time_it.elisa"
include "../tone_pcm.elisa"

module TimeItAudio:
    def pad() -> TonePcm::Patch:
        partials: mutable TonePcm::Partial[6] = zeroed
        partials[0] <- TonePcm::Partial{ratio: 1.0, gain: 0.7, decay: 0.0}
        partials[1] <- TonePcm::Partial{ratio: 1.0048061854646744, gain: 0.7, decay: 0.0}
        partials[2] <- TonePcm::Partial{ratio: 2.0, gain: 0.3 * TonePcm::BRIGHT_PARTIAL, decay: 0.0}
        partials[3] <- TonePcm::Partial{ratio: 0.5, gain: 0.3, decay: 0.0}
        return TonePcm::Patch{partials: partials, count: 4, attack: 0.15, decay: 0.3,
            release: 0.3, sustain: 0.8, tremolo_rate: 3.2084602421623396, tremolo_depth: 0.3}

    def render(shot: TimeIt::Shot&, begin: f64, end: f64, dest: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 0 if not (begin >= 0.0 and end > begin and end <= 9007199254740.0 and end - begin <= 30.0)
            frames: i64 = py_round_half_even((end - begin) * TonePcm::RATE.f64())
            return 0 if frames < 1 or frames > capacity / TonePcm::FRAME_BYTES
            stereo: mutable darray[f64] = TonePcm::empty(frames)
            patch: TonePcm::Patch = pad()
            onset: mutable f64 = 0.0
            while onset < end and onset <= shot.when |shot, begin, end, stereo, frames, patch, onset|:
                p: TimeIt::Point = TimeIt::position(shot, onset)
                break if p.x >= shot.left
                TonePcm::mix(&stereo, frames, begin, end, &patch, onset, 0.1, 110.0,
                    p.x / TimeIt::WIDTH * 2.0 - 1.0, 0.35)
                onset <- onset + 0.1
            return TonePcm::write(stereo, frames, dest)
