include "./kerbside_audio.elisa"

# The Kerbside screen's run of trials, on ClockedTask's clock: every advance
# steps the street in eighth-of-a-hundredth slices, with the agent's port
# for that frame if one came, else whatever the held keys say. Up or W walks
# forward, Down or S steps back; each of the four keys is held on its own.
module KerbsideGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = Kerbside::PORTS
    const FEEDBACK: f64 = 2.5

    struct Session:
        rng: mutable MT19937
        start_rung: mutable i64
        total: mutable i64
        adaptive: mutable bool
        rung: mutable i64
        trial: mutable i64
        wins: mutable i64
        best_rung: mutable i64
        phase: mutable i64
        time: mutable f64
        deadline: mutable f64
        run: mutable Kerbside::Run
        owner: mutable Arena
        held_keys: mutable i64
        pulse: mutable i64
        bank: mutable KerbsideAudio::Bank
        phases: mutable KerbsideAudio::Phases

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64) -> Session:
        rng: mutable MT19937 = zeroed
        magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
        mt_seed_int(&rng, magnitude)
        initial: i64 = Kerbside::grade(rung).rung
        return Session{rng: rng, start_rung: initial, total: trials, adaptive: adaptive,
            rung: initial, trial: 0, wins: 0, best_rung: 0, phase: READY, time: 0.0,
            deadline: 0.0, run: zeroed, owner: zeroed, held_keys: 0, pulse: -1, bank: zeroed, phases: zeroed}

    def close(session: mutable Session&):
        can Abort.Panic, Memory.Release:
            session.run <- zeroed
            session.bank <- zeroed
            session.phases <- zeroed
            session.phase <- READY
            session.held_keys <- 0
            session.pulse <- -1
            arena_free(&session.owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(trials: i64) -> bool:
        return trials == 1 or trials == 3 or trials == 5 or trials == 10 or trials == 20

    def reconfigure(session: mutable Session&, rung: i64, trials: i64, adaptive: bool) -> bool:
        can Abort.Panic, Memory.Release:
            return false if session.phase != READY and session.phase != DONE
            return false if not allowed_rung(rung) or not allowed_total(trials)
            close(session) can Global{Read,Write}
            session.start_rung <- rung
            session.rung <- rung
            session.total <- trials
            session.adaptive <- adaptive
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            return true

    # The dealt street, its run, the sound's tables and the tracks' phases,
    # all kept in the session's arena.
    def retain_trial(session: mutable Session&, street: Kerbside::Street&):
        can Memory.Allocate, Abort.Panic, Global.Read, Global.Write:
            owner: mutable Arena& = &session.owner
            cars: darray[Kerbside::Car] = arena_da_from_view[Kerbside::Car](owner, darray_view(street.cars))
            saved: Kerbside::Street = Kerbside::Street{level: street.level, cars: cars, vans: street.vans,
                van_a0: street.van_a0, van_b0: street.van_b0, van_a1: street.van_a1, van_b1: street.van_b1,
                seconds: street.seconds, seed: street.seed, valid: street.valid}
            in owner:
                session.run <- Kerbside::begin(saved)
                session.bank <- KerbsideAudio::bank()
                session.phases <- KerbsideAudio::phases(KerbsideAudio::tracks(&session.run))

    def next_trial(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            session.time <- now
            session.pulse <- -1
            if session.trial >= session.total:
                session.phase <- DONE
                return true
            region scratch(16777216):
                in scratch:
                    street: Kerbside::Street = Kerbside::deal(session.rung, &session.rng)
                    if not street.valid:
                        session.phase <- DONE
                        return false
                    keys: i64 = session.held_keys
                    close(session) can Global{Read,Write}
                    session.held_keys <- keys
                    retain_trial(session, &street) can Global{Read,Write}
            session.trial <- session.trial + 1
            session.phase <- PLAYING
            return true

    def valid_time(session: Session&, now: f64) -> bool:
        return now >= session.time and now <= 9007199254740.0

    def start(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if (session.phase != READY and session.phase != DONE) or session.total < 1
            return false if not valid_time(session, now)
            session.rung <- session.start_rung
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            return next_trial(session, now) can Global{Read,Write}

    # Room in the run's log and notes for this many more steps, so a step
    # never grows them outside the arena.
    def reserve_steps(session: mutable Session&, more: i64):
        can Abort.Panic, Memory.Allocate:
            owner: mutable Arena& = &session.owner
            run: mutable Kerbside::Run& = &session.run
            _ = arena_da_reserve[f64](owner, &run.times, run.times.count + more.usize()) can Global{Read,Write}
            _ = arena_da_reserve[f64](owner, &run.said_at, run.said_at.count + more.usize()) can Global{Read,Write}
            _ = arena_da_reserve[f64](owner, &run.stood, run.stood.count + more.usize()) can Global{Read,Write}
            _ = arena_da_reserve[DrShapeDeal::Note](owner, &run.notes, run.notes.count + more.usize()) can Global{Read,Write}

    # ClockedTask.steer: every Kerbside port is a control for the frame it
    # is sent in.
    def input(session: mutable Session&, port: i64) -> bool:
        return false if session.phase != PLAYING or port < 0 or port >= Kerbside::PORTS
        session.pulse <- port
        return true

    # A click starts a run, as Space does; the street takes no pointer.
    def pointer(session: mutable Session&, x: f64, y: f64, kind: i64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            if kind == 1 and (session.phase == READY or session.phase == DONE):
                return (start(session, now) can Global{Read,Write})
            return false

    # Kerbside._held: Up or W walks, else Down or S steps back.
    def held(session: Session&) -> i64:
        return Kerbside::FORWARD if (session.held_keys & 3) != 0
        return Kerbside::BACK if (session.held_keys & 12) != 0
        return -1

    def judge(session: mutable Session&, now: f64):
        passed: bool = session.run.result == Kerbside::ACROSS
        if passed:
            session.wins <- session.wins + 1
            session.best_rung <- session.rung if session.rung > session.best_rung
        if session.adaptive:
            session.rung <- session.rung + 1 if passed and session.rung < 9223372036854775807
            session.rung <- session.rung - 1 if not passed and session.rung > 1
        session.deadline <- now + FEEDBACK
        session.phase <- JUDGED

    def advance(session: mutable Session&, now: f64, stepped: bool = false) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if not valid_time(session, now)
            if session.phase == JUDGED:
                return false if not stepped and now < session.deadline
                return next_trial(session, now) can Global{Read,Write}
            return false if session.phase != PLAYING
            dt: f64 = fmin(0.1, now - session.time)
            session.time <- now
            control: i64 = session.pulse if session.pulse >= 0 else held(session)
            session.pulse <- -1
            steps: i64 = fmax(1.0, ceil(dt / (1.0 / 120.0))).i64()
            quantum: f64 = dt / steps.f64()
            reserve_steps(session, steps) can Global{Read,Write}
            for _ in 0..<steps |session, quantum, control|:
                Kerbside::step(&session.run, quantum, control)
                break if session.run.result != Kerbside::LIVE
            if session.run.result != Kerbside::LIVE:
                judge(session, now)
            return true

    def agent_event(session: mutable Session&, now: f64, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if not valid_time(session, now)
            return (start(session, now) can Global{Read,Write}) if port == START
            return (advance(session, now, true) can Global{Read,Write}) if port == -1
            return input(session, port)

    # Up (1), W (2), Down (4) and S (8), each held on its own.
    def hold_key(session: mutable Session&, key_bit: i64, down: bool) -> bool:
        return false if key_bit != 1 and key_bit != 2 and key_bit != 4 and key_bit != 8
        return false if down and session.phase != PLAYING
        before: i64 = session.held_keys
        session.held_keys <- before | key_bit if down else before & (15 ^ key_bit)
        return session.held_keys != before

    def clear_controls(session: mutable Session&) -> bool:
        changed: bool = session.held_keys != 0 or session.pulse >= 0
        session.held_keys <- 0
        session.pulse <- -1
        return changed

    # The audio the run has made, from its log, for begin to end.
    def audio(session: mutable Session&, begin: f64, end: f64, dest: mutable u8&, capacity: i64) -> i64:
        can Abort.Panic, Memory.Allocate:
            return 0 if session.phase != PLAYING and session.phase != JUDGED
            return KerbsideAudio::render(&session.run, &session.bank, &session.phases, begin, end, dest, capacity)

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return session.wins if field == 4
            return session.best_rung if field == 5
            return session.start_rung if field == 6
            return (1 if session.adaptive else 0) if field == 7
            return session.run.result if field == 8
            return py_round_half_even(session.run.t * 1000.0) if field == 9
            return session.run.street.level.lanes if field == 10
            return py_round_half_even(session.run.y * 1000.0) if field == 11
            return py_round_half_even(Kerbside::far_side(&session.run.street.level) * 1000.0) if field == 12
            return py_round_half_even(session.run.street.seconds * 1000.0) if field == 13
            return session.held_keys if field == 14
            return session.run.lane + 1 if field == 15 and session.run.result == Kerbside::HIT
            return 0 if field == 15
            return session.run.street.cars.count.i64() if field == 16
            return session.run.street.vans if field == 17
            return -1
