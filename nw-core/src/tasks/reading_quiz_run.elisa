include "./reading_quiz.elisa"

extend ReadingQuiz:
    const LIVE: i64 = 0
    const PASSED: i64 = 1
    const FAILED: i64 = 2
    const TICK: i64 = 0
    const RIGHT: i64 = 1
    const WRONG: i64 = 2
    const DONE: i64 = 3
    const MISS: i64 = 4

    struct Cue:
        time: f64
        duration: f64
        frequency: f64
        voice: i64
        gain: f64

    struct Run:
        round: Round
        index: mutable i64
        progress: mutable i64
        correct: mutable bool
        # A scored item's summed error so far.
        missed: mutable f64
        right: mutable i64
        wrong: mutable i64
        marks: mutable u64
        selected: mutable i64
        since: mutable f64
        time: mutable f64
        showing: mutable bool
        result: mutable i64
        cues: mutable darray[Cue]

    def begin(round: Round) -> Run:
        return Run{round: round, index: 0, progress: 0, correct: true, missed: 0.0, right: 0, wrong: 0, marks: 0.u64(), selected: -1, since: 0.0,
            time: 0.0, showing: false, result: LIVE, cues: []}

    def question(run: Run&) -> Item:
        can Abort.Panic:
            return zeroed if run.index >= run.round.items.count.i64()
            return run.round.items[run.index.usize()]

    def active_step(run: Run&) -> Step:
        can Abort.Panic:
            return zeroed if run.showing or run.result != LIVE
            item: Item = question(run)
            return zeroed if run.progress >= item.steps.count.i64()
            return item.steps[run.progress.usize()]

    def note(run: mutable Run&, duration: f64, frequency: f64, voice: i64, gain: f64):
        can Memory.Allocate, Abort.Panic:
            run.cues.push(Cue{time: run.time, duration: duration, frequency: frequency, voice: voice, gain: gain})

    def mark(run: mutable Run&, right: bool):
        can Memory.Allocate, Abort.Panic:
            run.showing <- true
            run.since <- run.time
            if right:
                run.marks <- run.marks | (1.u64() << run.index)
                run.right <- run.right + 1
                note(run, 0.3, 880.0, RIGHT, 0.4)
            else:
                run.wrong <- run.wrong + 1
                note(run, 0.35, 180.0, WRONG, 0.4)
            if run.wrong > run.round.items.count.i64() - run.round.need:
                run.result <- FAILED
                note(run, 0.5, 90.0, MISS, 0.5)

    def choose(run: mutable Run&, port: i64) -> bool:
        can Memory.Allocate, Abort.Panic:
            step: Step = active_step(run)
            return false if port < 0 or port >= step.options.count.i64()
            run.selected <- port
            run.progress <- run.progress + 1
            run.correct <- run.correct and port == step.answer
            item: Item = question(run)
            if item.scored:
                run.missed <- run.missed + fabs(step.values[port.usize()] - step.values[step.answer.usize()])
            note(run, 0.05, 600.0 + 40.0 * port.f64(), TICK, 0.2)
            if run.progress == item.steps.count.i64():
                run.correct <- run.missed <= item.tolerance + 0.000000001 if item.scored else run.correct
                mark(run, run.correct)
            return true

    def click(run: mutable Run&, x: f64, y: f64) -> bool:
        can Memory.Allocate, Abort.Panic:
            step: Step = active_step(run)
            for i in 0..<step.options.count.i64() |step, run, x, y|:
                box: Box = option_box(i, step.options.count.i64(), step.wide)
                if x >= box.x and x <= box.x + box.width and y >= box.y and y <= box.y + box.height:
                    return choose(run, i)
            return false

    def advance_quiz(run: mutable Run&, dt: f64):
        can Memory.Allocate, Abort.Panic:
            return if run.result != LIVE
            run.time <- run.time + dt
            item: Item = question(run)
            return if item.steps.count == 0.usize()
            if run.showing:
                if run.time - run.since >= SHOW:
                    run.showing <- false
                    run.index <- run.index + 1
                    run.progress <- 0
                    run.selected <- -1
                    run.correct <- true
                    run.missed <- 0.0
                    run.since <- run.time
                    if run.index == run.round.items.count.i64():
                        run.result <- PASSED
                        note(run, 0.6, 1320.0, DONE, 0.5)
                return
            if run.time - run.since >= item.seconds:
                run.selected <- -1
                run.progress <- item.steps.count.i64()
                run.correct <- false
                mark(run, false)

    def pilot(run: Run&) -> i64:
        can Abort.Panic:
            step: Step = active_step(run)
            return -1 if step.options.count == 0.usize()
            return step.answer
