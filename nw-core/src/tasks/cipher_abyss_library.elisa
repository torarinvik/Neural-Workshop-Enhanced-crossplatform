include "./cipher_abyss.elisa"
include "./cipher_lang_code.elisa"

extend CipherAbyss:
    struct Library:
        rungs: mutable i64[27]

    def operators(program: darray[CipherLang::Node]&, rule: i64) -> i64:
        can Abort.Panic:
            node: CipherLang::Node& = &program[rule.usize()]
            mask: mutable i64 = (1 << node.op) if node.op < CipherLang::FIRST else 0
            # Predicates are not operators. Their nodes have no children.
            for child in node.children:
                mask <- mask | operators(program, child)
            return mask

    def learn(library: mutable Library&, mask: i64, rung: i64):
        can Abort.Panic:
            for op in 0..<CipherLang::FIRST |library, mask, rung|:
                prior: i64 = library.rungs[op.usize()]
                if (mask & (1 << op)) != 0 and (prior == 0 or rung < prior):
                    library.rungs[op.usize()] <- rung

    def remembered(library: Library&, mask: i64, rung: i64) -> Library:
        can Abort.Panic:
            recalled: mutable Library = zeroed
            for op in 0..<CipherLang::FIRST |library, mask, rung, recalled|:
                prior: i64 = library.rungs[op.usize()]
                if (mask & (1 << op)) != 0 and prior > 0 and prior < rung:
                    recalled.rungs[op.usize()] <- prior
            return recalled

    def recall_text(out: mutable dstr&, recalled: Library&):
        can Abort.Panic, Memory.Allocate:
            # Operator codes in the alphabetical order used by the original.
            ordered: i64[27] = [CipherLang::AFFINE, CipherLang::CONV, CipherLang::DEDUPE, CipherLang::DIFF,
                CipherLang::DOUBLE, CipherLang::FEISTEL, CipherLang::FOLD, CipherLang::GF, CipherLang::HALVE,
                CipherLang::MEM, CipherLang::MIRROR, CipherLang::MUL, CipherLang::ODDSHIFT, CipherLang::PERM,
                CipherLang::PREFIX, CipherLang::REV, CipherLang::ROT, CipherLang::RUNS, CipherLang::SHIFT,
                CipherLang::SORT, CipherLang::STRIDE, CipherLang::SUB, CipherLang::SWAP, CipherLang::TSHIFT,
                CipherLang::UNWEAVE, CipherLang::WEAVE, CipherLang::XOR]
            earliest: mutable i64 = 0
            count: mutable i64 = 0
            for op in ordered:
                rung: i64 = recalled.rungs[op.usize()]
                continue if rung <= 0
                earliest <- rung if earliest == 0 or rung < earliest
                if count < 3:
                    dstr_append_cstr(out, "You met " if count == 0 else ", ")
                    dstr_append_cstr(out, CipherLang::name(op))
                count <- count + 1
            if count > 0:
                dstr_append_cstr(out, " at rung ")
                dstr_append_i64(out, earliest)

    def library_text(out: mutable dstr&, library: Library&):
        can Abort.Panic, Memory.Allocate:
            dstr_append_cstr(out, "{\"version\":1,\"operators\":{")
            comma: mutable bool = false
            for op in 0..<CipherLang::FIRST |out, library, comma|:
                rung: i64 = library.rungs[op.usize()]
                continue if rung <= 0
                dstr_append_cstr(out, ",") if comma
                dstr_append_cstr(out, "\"")
                dstr_append_cstr(out, CipherLang::name(op))
                dstr_append_cstr(out, "\":")
                dstr_append_i64(out, rung)
                comma <- true
            dstr_append_cstr(out, "}}\n")
