include "./cipher_abyss_controls.elisa"
include "./cipher_abyss_records.elisa"
include "./cipher_abyss_library.elisa"

module CipherAbyssGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = CipherAbyss::PORTS
    const FEEDBACK: f64 = 9.0

    struct Session:
        track_library: mutable bool
        library: mutable CipherAbyss::Library
        recalled: mutable CipherAbyss::Library
        tutorial: mutable bool
        rng: mutable MT19937
        start_rung: mutable i64
        total: mutable i64
        adaptive: mutable bool
        rung: mutable i64
        trial: mutable i64
        wins: mutable i64
        best_rung: mutable i64
        phase: mutable i64
        time: mutable f64
        deadline: mutable f64
        summary: mutable CipherAbyss::Summary
        run: mutable CipherAbyss::Run
        book: mutable CipherLang::Workshop
        owner: mutable Arena

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64, tutorial: bool = false, track_library: bool = false) -> Session:
        rng: mutable MT19937 = zeroed
        magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
        mt_seed_int(&rng, magnitude)
        initial: i64 = CipherAbyss::max(1, rung)
        return Session{track_library: track_library, library: zeroed, recalled: zeroed, tutorial: tutorial, rng: rng, start_rung: initial, total: trials, adaptive: adaptive,
            rung: initial, trial: 0, wins: 0, best_rung: 0, phase: READY, time: 0.0,
            deadline: 0.0, summary: zeroed, run: zeroed, book: zeroed, owner: zeroed}

    def close(session: mutable Session&):
        can Abort.Panic, Memory.Release:
            session.recalled <- zeroed
            session.summary <- zeroed
            session.run <- zeroed
            session.book <- zeroed
            session.phase <- READY
            arena_free(&session.owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(trials: i64) -> bool:
        return trials == 1 or trials == 3 or trials == 5 or trials == 10 or trials == 20

    def reconfigure(session: mutable Session&, rung: i64, trials: i64, adaptive: bool) -> bool:
        can Abort.Panic, Memory.Release:
            return false if session.phase != READY and session.phase != DONE
            return false if not allowed_rung(rung) or not allowed_total(trials)
            close(session) can Global{Read,Write}
            session.start_rung <- rung
            session.rung <- rung
            session.total <- trials
            session.adaptive <- adaptive
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            return true

    def next_trial(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            session.time <- now
            if session.trial >= session.total:
                session.phase <- DONE
                return true
            close(session) can Global{Read,Write}
            owner: mutable Arena& = &session.owner
            in owner:
                session.book <- CipherLang::workshop(CipherAbyss::grade(session.rung))
            dealt: CipherLang::Machine = CipherLang::deal(&session.book, &session.rng, owner) can Global{Read,Write}
            if dealt.rejected != 0:
                close(session) can Global{Read,Write}
                return false
            in owner:
                session.run <- CipherAbyss::begin(&session.book.program, &session.book.rules, dealt)
            rows: usize = (dealt.level.budget + dealt.tests.count.i64() + 1).usize()
            _ = arena_da_reserve[CipherLang::Sample](owner, &session.run.log, dealt.level.budget.usize()) can Global{Read,Write}
            _ = arena_da_reserve[CipherAbyss::Answer](owner, &session.run.answers, dealt.tests.count + 1.usize()) can Global{Read,Write}
            _ = arena_da_reserve[CipherLang::Probe](owner, &session.run.predictions, dealt.level.budget.usize()) can Global{Read,Write}
            _ = arena_da_reserve[i64](owner, &session.run.checked, rows) can Global{Read,Write}
            _ = arena_da_reserve[i64](owner, &session.run.marks, rows) can Global{Read,Write}
            session.trial <- session.trial + 1
            session.phase <- PLAYING
            return true

    def valid_time(session: Session&, now: f64) -> bool:
        return now >= session.time and now <= 9007199254740.0

    def start(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if (session.phase != READY and session.phase != DONE) or session.total < 1
            return false if not valid_time(session, now)
            session.rung <- session.start_rung
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            return next_trial(session, now) can Global{Read,Write}

    # Calls made inside an arena scope can return vectors backed by the
    # current event region. Copy data retained by the session into its arena.
    def keep_sample(owner: mutable Arena&, sample: CipherLang::Sample) -> CipherLang::Sample:
        can Abort.Panic, Memory.Allocate, Global.Read, Global.Write:
            given: darray[i64] = arena_da_from_view[i64](owner, darray_view(sample.given))
            result: darray[i64] = arena_da_from_view[i64](owner, darray_view(sample.result))
            return CipherLang::Sample{given: given, result: result}

    def keep_input(session: mutable Session&, runs: i64, answers: i64, nodes: i64, pending: bool):
        can Abort.Panic, Memory.Allocate, Global.Read, Global.Write:
            owner: mutable Arena& = &session.owner
            run: mutable CipherAbyss::Run& = &session.run
            if run.log.count.i64() > runs:
                sample: CipherLang::Sample = keep_sample(owner, run.log[runs.usize()])
                guess: CipherLang::Probe = run.predictions[runs.usize()]
                run.predictions[runs.usize()] <- CipherLang::Probe{values: arena_da_from_view[i64](owner, darray_view(guess.values))}
                run.log[runs.usize()] <- sample
                run.last <- sample
                if not run.testing:
                    run.state <- CipherLang::State{runs: run.state.runs, last_in: sample.given, last_out: sample.result, meta: run.state.meta}
            if run.answers.count.i64() > answers:
                answer: CipherAbyss::Answer = run.answers[answers.usize()]
                sample: CipherLang::Sample = keep_sample(owner, answer.sample)
                run.answers[answers.usize()] <- CipherAbyss::Answer{sample: sample, correct: answer.correct}
                if run.state.runs > 0:
                    run.last <- sample
                    run.state <- CipherLang::State{runs: run.state.runs, last_in: sample.given,
                        last_out: sample.result, meta: run.state.meta}
            if not pending and run.pending.count > 0.usize():
                run.pending <- arena_da_from_view[i64](owner, darray_view(run.pending))
            for i in nodes..<session.book.program.count.i64() |session, owner|:
                node: CipherLang::Node = session.book.program[i.usize()]
                args: darray[i64] = arena_da_from_view[i64](owner, darray_view(node.args))
                children: darray[i64] = arena_da_from_view[i64](owner, darray_view(node.children))
                session.book.program[i.usize()] <- CipherLang::Node{op: node.op, args: args, children: children}

    def input(session: mutable Session&, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if session.phase != PLAYING or session.run.result != CipherAbyss::LIVE or port < 0 or port >= CipherAbyss::PORTS
            owner: mutable Arena& = &session.owner
            if port >= HandView::PRESS:
                _ = arena_da_reserve[DrShapeDeal::Note](owner, &session.run.notes,
                    session.run.notes.count + (4 * session.run.machine.level.length + 8).usize()) can Global{Read,Write}
                _ = arena_da_reserve[i64](owner, &session.run.entry, session.run.entry.count + 1.usize()) can Global{Read,Write}
            if port == HandView::PRESS or port == CipherAbyss::ADD_BLOCK:
                _ = arena_da_reserve[CipherLang::Block](owner, &session.run.board,
                    session.run.board.count + 1.usize()) can Global{Read,Write}
            if port == HandView::PRESS or port == CipherAbyss::CHECK or port == CipherAbyss::SUBMIT:
                _ = arena_da_reserve[CipherLang::Node](owner, &session.book.program,
                    session.book.program.count + 2.usize() * session.run.board.count + 1.usize()) can Global{Read,Write}
            runs: i64 = session.run.log.count.i64()
            answers: i64 = session.run.answers.count.i64()
            nodes: i64 = session.book.program.count.i64()
            pending: bool = session.run.pending.count > 0.usize()
            in owner:
                CipherAbyss::act(&session.book.program, &session.run, port)
                keep_input(session, runs, answers, nodes, pending) can Global{Read,Write}
            return true

    # Reference framebuffer coordinates with a bottom-left origin.
    def pointer(session: mutable Session&, x: f64, y: f64, kind: i64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            if kind == 1 and (session.phase == READY or session.phase == DONE):
                return (start(session, now) can Global{Read,Write})
            return false if session.phase != PLAYING or kind < 0 or kind > 2
            HandView::place(&session.run.hand, (x - HandView::VIEW_LEFT) / HandView::VIEW_SCALE,
                (y - HandView::VIEW_BOTTOM) / HandView::VIEW_SCALE)
            return true if kind == 0 else (input(session, HandView::PRESS if kind == 1 else HandView::RELEASE) can Global{Read,Write})

    def judge(session: mutable Session&, now: f64):
        can Abort.Panic, Memory.Allocate, Memory.Release:
            owner: mutable Arena& = &session.owner
            _ = arena_da_reserve[DrShapeDeal::Note](owner, &session.run.notes,
                session.run.notes.count + session.run.log.count) can Global{Read,Write}
            in owner:
                summary: CipherAbyss::Summary = CipherAbyss::summarize(&session.book.program, &session.book.rules, &session.run)
                session.summary <- CipherAbyss::Summary{bits: (arena_da_from_view[f64](owner, darray_view(summary.bits)) can Global{Read,Write}),
                    words: (arena_da_from_view[u8](owner, darray_view(summary.words)) can Global{Read,Write}), best: summary.best, standing: summary.standing}
                CipherAbyss::end_tones(&session.run, &session.summary)
            session.tutorial <- false if session.run.machine.level.rung == 1
            passed: bool = CipherAbyss::won(session.run.result)
            if session.track_library:
                played_rung: i64 = session.run.machine.level.rung
                rule: i64 = session.run.machine.rule
                mask: i64 = CipherAbyss::operators(&session.book.program, rule)
                session.recalled <- CipherAbyss::remembered(&session.library, mask, played_rung)
                CipherAbyss::learn(&session.library, mask, played_rung) if passed
            if passed:
                session.wins <- session.wins + 1
                session.best_rung <- CipherAbyss::max(session.best_rung, session.rung)
            if session.adaptive:
                session.rung <- session.rung + 1 if passed and session.rung < 9223372036854775807
                session.rung <- session.rung - 1 if not passed and session.rung > 1
            session.deadline <- now + FEEDBACK
            session.phase <- JUDGED

    def advance(session: mutable Session&, now: f64, stepped: bool = false) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if not valid_time(session, now)
            if session.phase == JUDGED:
                return false if not stepped and now < session.deadline
                return next_trial(session, now) can Global{Read,Write}
            return false if session.phase != PLAYING
            dt: f64 = fmin(0.1, now - session.time)
            session.time <- now
            steps: i64 = fmax(1.0, ceil(dt / (1.0 / 120.0))).i64()
            quantum: f64 = dt / steps.f64()
            for _ in 0..<steps |session, quantum|:
                CipherAbyss::step(&session.run, quantum)
                break if session.run.result != CipherAbyss::LIVE
            if session.run.result != CipherAbyss::LIVE:
                judge(session, now) can Global{Read,Write}
            return true

    def agent_event(session: mutable Session&, now: f64, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if not valid_time(session, now)
            return (start(session, now) can Global{Read,Write}) if port == START
            return (advance(session, now, true) can Global{Read,Write}) if port == -1
            return (input(session, port) can Global{Read,Write})


    def clear_controls(session: mutable Session&) -> bool:
        changed: bool = session.run.hand.down
        session.run.hand.down <- false
        return changed

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return session.wins if field == 4
            return session.best_rung if field == 5
            return session.start_rung if field == 6
            return (1 if session.adaptive else 0) if field == 7
            return session.run.result if field == 8
            return py_round_half_even(session.run.time * 1000.0) if field == 9
            return session.run.machine.kind if field == 10
            return session.run.log.count.i64() if field == 11
            return session.run.test_no if field == 12
            return -1
