include "./reading_quiz.elisa"
include "./feeling_odds.elisa"

module WhyTheyFeel:
    # whytheyfeel.py: made-up stories, each built so one emotion follows
    # from it by appraisal theory; later rungs twist what people want and
    # ask what one person thinks another feels.
    const ITEMS: i64 = 10
    const EMOTIONS: i64 = 17
    const NAMES: i64 = 20
    const GOALS: i64 = 8
    # Emotions, in WORD's order.
    const JOY: i64 = 0
    const DISTRESS: i64 = 1

    struct Grade:
        rung: i64
        # The first `kinds` of happened, to come, turned out, own doing,
        # others' doing, and fortune.
        kinds: i64
        twist: f64
        depth: i64
        options: i64
        seconds: f64

    struct Corpus:
        unused: i64

    struct Round:
        level: Grade
        quiz: ReadingQuiz::Round

    struct Told:
        text: dstr
        question: dstr
        emotion: i64

    def grade(requested: i64) -> Grade:
        r: i64 = requested if requested > 0 else 1
        kinds: i64 = 1 if r < 3 else (2 if r < 5 else (3 if r < 7 else (5 if r < 9 else 6)))
        options: i64 = 2 if r < 3 else (3 if r < 5 else (4 if r < 7 else (5 if r < 9 else (6 if r < 12 else 8))))
        steps: i64 = 1 + (r - 15) / 5 if r >= 15 else 0
        raw: f64 = 30.0 - 1.0 * (r - 1).f64()
        return Grade{rung: r, kinds: kinds, twist: 0.5 if r >= 12 else 0.0, depth: steps if steps < 4 else 4,
            options: options, seconds: raw if raw > 8.0 else 8.0}

    # The emotions of the first `kinds` kinds run from 0 to here.
    def pool_end(kinds: i64) -> i64:
        return 2 if kinds == 1 else (4 if kinds == 2 else (6 if kinds == 3 else (9 if kinds == 4 else (13 if kinds == 5 else 17))))

    # GOALS (0-7) then TWISTS (8-11); fields: want, good, bad, wait,
    # sign_good, sign_bad, won, lost.
    def goal_text(goal: i64, field: i64) -> cstr:
        return "{P} hoped to get a place at the art school." if goal == 0 and field == 0
        return "The letter came: {P} was in." if goal == 0 and field == 1
        return "The letter came: {P} was not in." if goal == 0 and field == 2
        return "The letter has not come yet." if goal == 0 and field == 3
        return "A teacher said {P}'s drawings were the best she had seen." if goal == 0 and field == 4
        return "A friend heard that every place was already taken." if goal == 0 and field == 5
        return "{P} got into the art school" if goal == 0 and field == 6
        return "{P} was turned down by the art school" if goal == 0 and field == 7
        return "{P} wanted the last cherry pie at the bakery." if goal == 1 and field == 0
        return "{P} got the last cherry pie." if goal == 1 and field == 1
        return "The man in front of {P} bought the last cherry pie." if goal == 1 and field == 2
        return "There is a long queue in front of {P}." if goal == 1 and field == 3
        return "Nobody in the queue seems to want cherry pie." if goal == 1 and field == 4
        return "Everyone in the queue is pointing at the cherry pies." if goal == 1 and field == 5
        return "{P} got the last cherry pie" if goal == 1 and field == 6
        return "{P} missed the last cherry pie" if goal == 1 and field == 7
        return "{P} had planned a picnic for Saturday." if goal == 2 and field == 0
        return "Saturday came bright and dry, and the picnic went ahead." if goal == 2 and field == 1
        return "It poured all Saturday and the picnic was called off." if goal == 2 and field == 2
        return "Saturday is two days away." if goal == 2 and field == 3
        return "The forecast says sun all day." if goal == 2 and field == 4
        return "The forecast says heavy rain all day." if goal == 2 and field == 5
        return "{P}'s picnic went ahead" if goal == 2 and field == 6
        return "{P}'s picnic was rained off" if goal == 2 and field == 7
        return "{P} wanted to pass the driving test." if goal == 3 and field == 0
        return "{P} passed." if goal == 3 and field == 1
        return "{P} failed." if goal == 3 and field == 2
        return "{P} is in the waiting room before the test." if goal == 3 and field == 3
        return "In the practice drive {P} did not make a single mistake." if goal == 3 and field == 4
        return "In the practice drive {P} stalled three times." if goal == 3 and field == 5
        return "{P} passed the driving test" if goal == 3 and field == 6
        return "{P} failed the driving test" if goal == 3 and field == 7
        return "{P}'s cat had been missing for two days." if goal == 4 and field == 0
        return "The cat walked in through the back door." if goal == 4 and field == 1
        return "A neighbour found the cat's collar by the road; it was gone for good." if goal == 4 and field == 2
        return "There is still no sign of the cat." if goal == 4 and field == 3
        return "Someone saw a cat just like it two streets away." if goal == 4 and field == 4
        return "A fox has been seen in the gardens every night." if goal == 4 and field == 5
        return "{P}'s cat came home" if goal == 4 and field == 6
        return "{P}'s cat was lost for good" if goal == 4 and field == 7
        return "{P} had applied for the job at the museum." if goal == 5 and field == 0
        return "{P} got the job." if goal == 5 and field == 1
        return "The museum gave the job to someone else." if goal == 5 and field == 2
        return "The museum will decide on Friday." if goal == 5 and field == 3
        return "The interviewers laughed at all of {P}'s jokes." if goal == 5 and field == 4
        return "The interviewers kept checking their watches." if goal == 5 and field == 5
        return "{P} got the job at the museum" if goal == 5 and field == 6
        return "{P} did not get the job at the museum" if goal == 5 and field == 7
        return "{P} wanted to catch the last train home." if goal == 6 and field == 0
        return "{P} jumped on just as the doors closed." if goal == 6 and field == 1
        return "The train pulled out as {P} reached the platform." if goal == 6 and field == 2
        return "{P} is running for the station." if goal == 6 and field == 3
        return "The board says the train is five minutes late." if goal == 6 and field == 4
        return "The board says the train is on time, and it is two minutes away." if goal == 6 and field == 5
        return "{P} caught the last train" if goal == 6 and field == 6
        return "{P} missed the last train" if goal == 6 and field == 7
        return "{P}'s old dog was having an operation." if goal == 7 and field == 0
        return "The vet rang: the operation went well." if goal == 7 and field == 1
        return "The vet rang: the dog did not wake up." if goal == 7 and field == 2
        return "The operation is still going on." if goal == 7 and field == 3
        return "The vet said the dog was strong for its age." if goal == 7 and field == 4
        return "The vet said the dog's heart was weak." if goal == 7 and field == 5
        return "{P}'s dog came through the operation" if goal == 7 and field == 6
        return "{P}'s dog died in the operation" if goal == 7 and field == 7
        return "{P} had not trained all week and quietly hoped the match would be called off." if goal == 8 and field == 0
        return "A storm came in and the match was called off." if goal == 8 and field == 1
        return "The sky stayed clear and the match went ahead." if goal == 8 and field == 2
        return "The match is this afternoon." if goal == 8 and field == 3
        return "Thunder is rolling in." if goal == 8 and field == 4
        return "There is not a cloud in the sky." if goal == 8 and field == 5
        return "{P}'s match was called off" if goal == 8 and field == 6
        return "{P}'s match went ahead" if goal == 8 and field == 7
        return "{P} dreaded giving the speech at the wedding." if goal == 9 and field == 0
        return "The microphone broke, and nobody gave any speeches." if goal == 9 and field == 1
        return "The host handed {P} the microphone." if goal == 9 and field == 2
        return "The speeches are after dinner." if goal == 9 and field == 3
        return "The best man wants to do all the speaking himself." if goal == 9 and field == 4
        return "The host keeps looking at {P}." if goal == 9 and field == 5
        return "the speeches were cancelled" if goal == 9 and field == 6
        return "{P} had to give the speech" if goal == 9 and field == 7
        return "{P} wanted to stay home and hoped the party would be cancelled." if goal == 10 and field == 0
        return "The host fell ill and cancelled the party." if goal == 10 and field == 1
        return "The party is on, and everyone is asking whether {P} is coming." if goal == 10 and field == 2
        return "The host will decide this evening." if goal == 10 and field == 3
        return "The host sounds very ill on the phone." if goal == 10 and field == 4
        return "The host sounds full of energy." if goal == 10 and field == 5
        return "the party was cancelled" if goal == 10 and field == 6
        return "the party is on" if goal == 10 and field == 7
        return "{P} hoped to fail the trial for the choir, to have the evenings free." if goal == 11 and field == 0
        return "The choir master said {P} was not needed." if goal == 11 and field == 1
        return "The choir master said {P} was perfect and must join." if goal == 11 and field == 2
        return "The choir master is deciding now." if goal == 11 and field == 3
        return "The choir master winced while {P} sang." if goal == 11 and field == 4
        return "The choir master was smiling while {P} sang." if goal == 11 and field == 5
        return "{P} was left out of the choir" if goal == 11 and field == 6
        return "{P} was put in the choir" if goal == 11 and field == 7
        return ""

    def good_act(index: i64) -> cstr:
        return "handed in a lost wallet with all the money still in it" if index == 0
        return "stayed late to help a stranger fix a flat tyre" if index == 1
        return "owned up to breaking the window" if index == 2
        return "gave a seat on the bus to a tired old man" if index == 3
        return "spent the weekend cleaning up the river bank" if index == 4
        return ""

    def bad_act(index: i64) -> cstr:
        return "lied to the teacher to get a classmate in trouble" if index == 0
        return "kicked over a toddler's sandcastle for fun" if index == 1
        return "handed in a friend's homework as their own" if index == 2
        return "laughed at a boy who fell off his bike" if index == 3
        return "took money from the charity box" if index == 4
        return ""

    def name_of(index: i64) -> cstr:
        return "Ana" if index == 0
        return "Bo" if index == 1
        return "Cal" if index == 2
        return "Dee" if index == 3
        return "Eli" if index == 4
        return "Fen" if index == 5
        return "Gus" if index == 6
        return "Hana" if index == 7
        return "Ivo" if index == 8
        return "Jun" if index == 9
        return "Kit" if index == 10
        return "Lev" if index == 11
        return "Mira" if index == 12
        return "Nico" if index == 13
        return "Odi" if index == 14
        return "Pia" if index == 15
        return "Quin" if index == 16
        return "Rae" if index == 17
        return "Sol" if index == 18
        return "Tam" if index == 19
        return ""

    # WORD, in its order.
    def word(emotion: i64) -> cstr:
        return "happy" if emotion == 0
        return "sad" if emotion == 1
        return "hopeful" if emotion == 2
        return "worried" if emotion == 3
        return "relieved" if emotion == 4
        return "disappointed" if emotion == 5
        return "proud" if emotion == 6
        return "ashamed" if emotion == 7
        return "remorseful" if emotion == 8
        return "admiring" if emotion == 9
        return "disapproving" if emotion == 10
        return "grateful" if emotion == 11
        return "angry" if emotion == 12
        return "glad for them" if emotion == 13
        return "sorry for them" if emotion == 14
        return "resentful" if emotion == 15
        return "gloating" if emotion == 16
        return ""

    # COMPAT: emotions that would also fit a story built for the other.
    def compatible(a: i64, b: i64) -> bool:
        return true if (a == 0 and b == 4) or (a == 4 and b == 0)
        return true if (a == 0 and b == 6) or (a == 6 and b == 0)
        return true if (a == 0 and b == 11) or (a == 11 and b == 0)
        return true if (a == 0 and b == 13) or (a == 13 and b == 0)
        return true if (a == 0 and b == 16) or (a == 16 and b == 0)
        return true if (a == 1 and b == 5) or (a == 5 and b == 1)
        return true if (a == 1 and b == 8) or (a == 8 and b == 1)
        return true if (a == 1 and b == 12) or (a == 12 and b == 1)
        return true if (a == 1 and b == 14) or (a == 14 and b == 1)
        return true if (a == 1 and b == 7) or (a == 7 and b == 1)
        return true if (a == 1 and b == 15) or (a == 15 and b == 1)
        return true if (a == 1 and b == 3) or (a == 3 and b == 1)
        return true if (a == 7 and b == 8) or (a == 8 and b == 7)
        return true if (a == 11 and b == 9) or (a == 9 and b == 11)
        return true if (a == 12 and b == 10) or (a == 10 and b == 12)
        return true if (a == 12 and b == 15) or (a == 15 and b == 12)
        return true if (a == 10 and b == 15) or (a == 15 and b == 10)
        return false

    def good(emotion: i64) -> bool:
        return emotion == 0 or emotion == 2 or emotion == 4 or emotion == 6 or emotion == 9 or emotion == 11 or emotion == 13 or emotion == 16

    def put(out: mutable dstr&, words: cstr):
        can Abort.Panic, Memory.Allocate:
            dstr_append_cstr(out, words)

    # _fill: the template with every {P} replaced by the name.
    def fill(out: mutable dstr&, template: cstr, who: i64):
        can Abort.Panic, Memory.Allocate:
            view: sview = sview(template, 0, -1)
            size: i64 = sview_len(view).i64()
            i: mutable i64 = 0
            while i < size |out, view, size, i, who|:
                if i + 2 < size and sview_at(view, i.usize()) == 123.u8() and sview_at(view, (i + 1).usize()) == 80.u8() and sview_at(view, (i + 2).usize()) == 125.u8():
                    dstr_append_cstr(out, name_of(who))
                    i <- i + 3
                else:
                    out.push(sview_at(view, i.usize()))
                    i <- i + 1

    def goal(out: mutable dstr&, goal_index: i64, field: i64, who: i64):
        can Abort.Panic, Memory.Allocate:
            fill(out, goal_text(goal_index, field), who)

    def story(kind: i64, level: Grade, draw: mutable MT19937&) -> Told:
        can Abort.Panic, Memory.Allocate:
            people: darray[i64] = py_sample_range(draw, 0, NAMES - 1, 4)
            p: i64 = people[0]
            q: i64 = people[1]
            g: i64 = (GOALS + py_choice_index(draw, 4)) if py_random(draw) < level.twist else py_choice_index(draw, GOALS)
            good: bool = py_random(draw) < 0.5
            text: mutable dstr = []
            emotion: mutable i64 = 0
            if kind == 0:
                goal(&text, g, 0, p)
                put(&text, " ")
                goal(&text, g, 1 if good else 2, p)
                emotion <- JOY if good else DISTRESS
            elif kind == 1:
                goal(&text, g, 0, p)
                put(&text, " ")
                goal(&text, g, 3, p)
                put(&text, " ")
                goal(&text, g, 4 if good else 5, p)
                emotion <- 2 if good else 3
            elif kind == 2:
                goal(&text, g, 0, p)
                put(&text, " For days it looked as if it would go wrong. In the end: " if good else " For days it looked certain to go well. In the end: ")
                goal(&text, g, 1 if good else 2, p)
                emotion <- 4 if good else 5
            elif kind == 3:
                emotion <- 6 + py_choice_index(draw, 3)
                if emotion == 6:
                    put(&text, name_of(p))
                    put(&text, " ")
                    put(&text, good_act(py_choice_index(draw, 5)))
                    put(&text, ".")
                elif emotion == 7:
                    put(&text, name_of(p))
                    put(&text, " ")
                    put(&text, bad_act(py_choice_index(draw, 5)))
                    put(&text, ", and everyone saw.")
                else:
                    put(&text, name_of(p))
                    put(&text, " and ")
                    put(&text, name_of(q))
                    put(&text, " are close friends. ")
                    put(&text, name_of(p))
                    put(&text, " told a secret ")
                    put(&text, name_of(q))
                    put(&text, " had trusted ")
                    put(&text, name_of(p))
                    put(&text, " with, and now ")
                    put(&text, name_of(q))
                    put(&text, " will not speak to anyone.")
            elif kind == 4:
                emotion <- 9 + py_choice_index(draw, 4)
                if emotion == 9:
                    put(&text, name_of(p))
                    put(&text, " read in the paper that a stranger ")
                    put(&text, good_act(py_choice_index(draw, 5)))
                    put(&text, ".")
                elif emotion == 10:
                    put(&text, name_of(p))
                    put(&text, " watched a stranger who ")
                    put(&text, bad_act(py_choice_index(draw, 5)))
                    put(&text, ".")
                else:
                    goal(&text, g, 0, p)
                    put(&text, " ")
                    put(&text, name_of(q))
                    put(&text, " went out of their way to help, and because of that: " if emotion == 11 else " got in the way on purpose, and because of that: ")
                    goal(&text, g, 1 if emotion == 11 else 2, p)
            else:
                # Another's fortune: the news is about q.
                friend: bool = py_random(draw) < 0.5
                if friend:
                    put(&text, name_of(p))
                    put(&text, " and ")
                    put(&text, name_of(q))
                    put(&text, " have been best friends since school.")
                else:
                    put(&text, name_of(p))
                    put(&text, " cannot stand ")
                    put(&text, name_of(q))
                    put(&text, ", who once spread lies about ")
                    put(&text, name_of(p))
                    put(&text, ".")
                news: i64 = py_choice_index(draw, GOALS)
                put(&text, " ")
                put(&text, name_of(p))
                put(&text, " heard that ")
                goal(&text, news, 6 if good else 7, q)
                put(&text, ".")
                emotion <- (13 if good else 14) if friend else (15 if good else 16)
            question: mutable dstr = []
            put(&question, "How does ")
            put(&question, name_of(p))
            put(&question, " feel?")
            return Told{text: text, question: question, emotion: emotion}

    # believed: who has heard what about someone, and what one person
    # thinks another thinks they feel.
    def believed(level: Grade, draw: mutable MT19937&) -> Told:
        can Abort.Panic, Memory.Allocate:
            people: darray[i64] = py_sample_range(draw, 0, NAMES - 1, level.depth + 2)
            p: i64 = people[0]
            g: i64 = py_choice_index(draw, GOALS)
            true_good: bool = py_random(draw) < 0.5
            text: mutable dstr = []
            goal(&text, g, 0, p)
            put(&text, " ")
            goal(&text, g, 1 if true_good else 2, p)
            last: mutable bool = false
            for d in 1..<(level.depth + 1) |text, people, p, g, last, draw|:
                good: bool = py_random(draw) < 0.5
                last <- good
                clause: mutable dstr = []
                put(&clause, name_of(people[1]))
                put(&clause, " has heard that ")
                goal(&clause, g, 6 if good else 7, p)
                for k in 1..<d |clause, people|:
                    outer: mutable dstr = []
                    put(&outer, name_of(people[(k + 1).usize()]))
                    put(&outer, " thinks that ")
                    dstr_append_dstr(&outer, clause)
                    clause <- outer
                # clause[0].upper(): every clause starts with a name.
                put(&text, " ")
                dstr_append_dstr(&text, clause)
                put(&text, ".")
            inner: mutable dstr = []
            put(&inner, name_of(p))
            put(&inner, " feels")
            for k in 0..<(level.depth - 1) |inner, people|:
                outer: mutable dstr = []
                put(&outer, name_of(people[(k + 1).usize()]))
                put(&outer, " thinks ")
                dstr_append_dstr(&outer, inner)
                inner <- outer
            question: mutable dstr = []
            put(&question, "What does ")
            put(&question, name_of(people[level.depth.usize()]))
            put(&question, " think ")
            dstr_append_dstr(&question, inner)
            put(&question, "?")
            return Told{text: text, question: question, emotion: JOY if last else DISTRESS}

    def build(level: Grade, draw: mutable MT19937&, corpus: Corpus&) -> Round:
        can Memory.Allocate, Abort.Panic:
            end: i64 = pool_end(level.kinds)
            items: mutable darray[ReadingQuiz::Item] = []
            for _ in 0..<ITEMS |items, level, draw, end|:
                told: mutable Told = zeroed
                if level.depth > 0 and py_random(draw) < 0.5:
                    told <- believed(level, draw)
                else:
                    told <- story(py_choice_index(draw, level.kinds), level, draw)
                e: i64 = told.emotion
                near: mutable darray[i64] = []
                far: mutable darray[i64] = []
                for x in 0..<end |near, far, e|:
                    continue if x == e or compatible(e, x)
                    if good(x) == good(e):
                        near.push(x)
                    else:
                        far.push(x)
                py_shuffle_i64(draw, &near)
                py_shuffle_i64(draw, &far)
                order: mutable darray[i64] = []
                first: darray[i64] = near if level.rung >= 7 else far
                second: darray[i64] = far if level.rung >= 7 else near
                for x in first |order|:
                    order.push(x)
                for x in second |order|:
                    order.push(x)
                pick: mutable darray[i64] = []
                for x in order |pick, level|:
                    pick.push(x) if pick.count.i64() < level.options - 1
                if pick.count.i64() < level.options - 1:
                    extra: mutable darray[i64] = []
                    for x in 0..<EMOTIONS |extra, pick, e|:
                        taken: mutable bool = false
                        for y in pick |taken, x|:
                            taken <- taken or y == x
                        extra.push(x) if x != e and not compatible(e, x) and not taken
                    py_shuffle_i64(draw, &extra)
                    for x in extra |pick, level|:
                        pick.push(x) if pick.count.i64() < level.options - 1
                pick.push(e)
                py_shuffle_i64(draw, &pick)
                options: mutable darray[dstr] = []
                answer: mutable i64 = 0
                for i in 0..<pick.count.i64() |options, answer, pick, e|:
                    option: mutable dstr = []
                    put(&option, word(pick[i.usize()]))
                    options.push(option)
                    answer <- i if pick[i.usize()] == e
                truth: mutable dstr = []
                put(&truth, word(e))
                steps: darray[ReadingQuiz::Step] = [ReadingQuiz::Step{ask: told.question, options: options, answer: answer, wide: false, values: []}]
                items.push(ReadingQuiz::Item{prompt: told.text, steps: steps, seconds: level.seconds, title: "A story",
                    truth: truth, tolerance: 0.0, scored: false})
            chance_need: i64 = FeelingOdds::need_for(ITEMS, 1.0 / level.options.f64())
            # ceil(0.8 * 10)
            need: i64 = chance_need if chance_need > 8 else 8
            return Round{level: level, quiz: ReadingQuiz::Round{items: items, need: need}}

    def deal(level: Grade, draw: mutable MT19937&, corpus: Corpus&) -> Round:
        can Memory.Allocate, Abort.Panic:
            for _ in 0..<20 |level, draw, corpus|:
                next: mutable MT19937 = zeroed
                mt_seed_int(&next, py_getrandbits(draw, 32))
                round: Round = build(level, &next, corpus)
                # The reference player answers every story right away, so
                # every built round clears the score and time checks.
                return round if round.quiz.items.count > 0.usize()
            return zeroed

    # The stories are made here; there is nothing to import.
    def from_question_cache(owner: mutable Arena&, text: sview) -> Corpus:
        return zeroed
