include "./reading_quiz.elisa"

# badargument.py: does the conclusion follow from what is given? The
# arguments are made here (made-up words, real things, chains), with
# BIG-bench's fallacies and formal syllogisms from the question file.
module BadArgument:
    const ITEMS: i64 = 20
    # Kinds of item.
    const NONSENSE: i64 = 0
    const WORLD: i64 = 1
    const FALLACY: i64 = 2
    const FORMAL: i64 = 3
    const CHAIN: i64 = 4
    # Forms of argument.
    const MP: i64 = 0
    const MT: i64 = 1
    const AC: i64 = 2
    const DA: i64 = 3
    const BARBARA: i64 = 4
    const CELARENT: i64 = 5
    const MIDDLE: i64 = 6
    const CONVERT: i64 = 7
    const OFF: i64 = 8
    const WHOLE_CHAIN: i64 = 9
    const BROKEN: i64 = 10

    struct Grade:
        rung: i64
        kinds: i64[4]
        kind_count: i64
        forms: i64[8]
        form_count: i64
        name: bool
        pace: ReadingQuiz::Pace

    struct Question:
        prompt: dstr
        ask: dstr
        options: darray[dstr]
        answer: i64

    # The question file's two kinds: FALLACY - 2 and FORMAL - 2.
    struct Corpus:
        questions: mutable darray[Question][2]

    struct Round:
        level: Grade
        quiz: ReadingQuiz::Round

    struct Argument:
        text: dstr
        form: i64
        valid: bool
        made: bool

    struct Deck:
        cards: mutable darray[i64]
        taken: mutable i64

    def grade(requested: i64) -> Grade:
        can Abort.Panic:
            r: i64 = requested if requested > 0 else 1
            forms: mutable i64[8] = zeroed
            form_count: mutable i64 = 8
            if r == 1:
                forms[0] <- MP
                forms[1] <- BARBARA
                forms[2] <- OFF
                form_count <- 3
            elif r < 4:
                forms[0] <- MP
                forms[1] <- AC
                forms[2] <- DA
                forms[3] <- BARBARA
                forms[4] <- MIDDLE
                form_count <- 5
            else:
                for i in 0..<8 |forms|:
                    forms[i.usize()] <- i
            kinds: mutable i64[4] = zeroed
            kind_count: mutable i64 = 1
            if r < 4:
                kinds[0] <- NONSENSE
            elif r < 7:
                kinds[0] <- WORLD
            elif r < 13:
                kinds[0] <- WORLD
                kinds[1] <- WORLD
                kinds[2] <- FALLACY
                kind_count <- 3
            else:
                kinds[0] <- WORLD
                kinds[1] <- CHAIN
                kinds[2] <- FALLACY
                kinds[3] <- FORMAL
                kind_count <- 4
            return Grade{rung: r, kinds: kinds, kind_count: kind_count, forms: forms, form_count: form_count,
                         name: (r >= 10 and r < 13) or r >= 16, pace: ReadingQuiz::reading_pace(r, 1.8, 3.5, 6.0, 3.0)}

    def kind_name(kind: i64) -> cstr:
        return "nonsense" if kind == NONSENSE
        return "world" if kind == WORLD
        return "fallacy" if kind == FALLACY
        return "formal" if kind == FORMAL
        return "chain"

    def valid_form(form: i64) -> bool:
        return form == MP or form == MT or form == BARBARA or form == CELARENT

    # NAMES, and which of them FLAWS gives each form.
    def flaw_name(index: i64) -> cstr:
        return "it follows" if index == 0
        return "affirming the consequent" if index == 1
        return "denying the antecedent" if index == 2
        return "an undistributed middle" if index == 3
        return "an \"all\" turned round"

    def flaw_of(form: i64) -> i64:
        return 0 if valid_form(form) or form == WHOLE_CHAIN
        return 1 if form == AC
        return 2 if form == DA
        return 3 if form == MIDDLE or form == BROKEN
        return 4

    def nonsense_noun(index: i64) -> cstr:
        return "blickets" if index == 0
        return "daxes" if index == 1
        return "wugs" if index == 2
        return "feps" if index == 3
        return "toves" if index == 4
        return "zorbs" if index == 5
        return "glims" if index == 6
        return "snarps" if index == 7
        return "borogoves" if index == 8
        return "tulgeys" if index == 9
        return "mome raths" if index == 10
        return "jubjubs"

    def nonsense_adjective(index: i64) -> cstr:
        return "gimble" if index == 0
        return "mimsy" if index == 1
        return "frumious" if index == 2
        return "slithy" if index == 3
        return "uffish" if index == 4
        return "vorpal" if index == 5
        return "brillig" if index == 6
        return "manxome" if index == 7
        return "beamish" if index == 8
        return "tulgey"

    def thing(index: i64) -> cstr:
        return "stone" if index == 0
        return "card" if index == 1
        return "lamp" if index == 2
        return "box" if index == 3
        return "bell" if index == 4
        return "coin" if index == 5
        return "flag" if index == 6
        return "door"

    # CHAINS: (S, M, P) for chain 0-9; part 0, 1 or 2.
    def chain_term(which: i64, part: i64) -> cstr:
        return ("sparrows" if part == 0 else ("birds" if part == 1 else "animals")) if which == 0
        return ("salmon" if part == 0 else ("fish" if part == 1 else "animals")) if which == 1
        return ("cats" if part == 0 else ("mammals" if part == 1 else "animals")) if which == 2
        return ("roses" if part == 0 else ("flowers" if part == 1 else "plants")) if which == 3
        return ("oaks" if part == 0 else ("trees" if part == 1 else "plants")) if which == 4
        return ("ferns" if part == 0 else ("green plants" if part == 1 else "plants")) if which == 5
        return ("trucks" if part == 0 else ("vehicles" if part == 1 else "machines")) if which == 6
        return ("drills" if part == 0 else ("power tools" if part == 1 else "machines")) if which == 7
        return ("violins" if part == 0 else ("string instruments" if part == 1 else "instruments")) if which == 8
        return "trumpets" if part == 0 else ("brass instruments" if part == 1 else "instruments")

    # The P of each chain, as a number: animals 0, plants 1, machines 2,
    # instruments 3.
    def chain_kind(which: i64) -> i64:
        return 0 if which < 3
        return 1 if which < 6
        return 2 if which < 8
        return 3

    # LONG: four-level chains.
    def long_term(which: i64, part: i64) -> cstr:
        if which == 0:
            return "robins" if part == 0 else ("songbirds" if part == 1 else ("birds" if part == 2 else "animals"))
        if which == 1:
            return "kittens" if part == 0 else ("cats" if part == 1 else ("mammals" if part == 2 else "animals"))
        if which == 2:
            return "tulips" if part == 0 else ("flowers" if part == 1 else ("plants" if part == 2 else "living things"))
        return "cellos" if part == 0 else ("string instruments" if part == 1 else ("instruments" if part == 2 else "things made by people"))

    # RULES (true of the world) and FALSE_RULES: if, then, not-if, not-then.
    def rule_part(which: i64, believable: bool, part: i64) -> cstr:
        if which == 0:
            return "the glass falls onto the stone floor" if part == 0 else ((("it breaks" if believable else "it bounces back up whole")) if part == 1 else ("the glass does not fall" if part == 2 else ("it does not break" if believable else "it does not bounce back up whole")))
        if which == 1:
            return "the ice is left in the hot sun" if part == 0 else ((("it melts" if believable else "it grows bigger")) if part == 1 else ("the ice is not left in the sun" if part == 2 else ("it does not melt" if believable else "it does not grow bigger")))
        if which == 2:
            return "the kettle is switched on" if part == 0 else ((("the water gets hot" if believable else "the water freezes")) if part == 1 else ("the kettle is not switched on" if part == 2 else ("the water does not get hot" if believable else "the water does not freeze")))
        if which == 3:
            return "the plant gets no water for a month" if part == 0 else ((("it wilts" if believable else "it grows twice as tall")) if part == 1 else ("the plant gets water" if part == 2 else ("it does not wilt" if believable else "it does not grow twice as tall")))
        if which == 4:
            return "the phone battery runs out" if part == 0 else ((("the screen goes dark" if believable else "the screen gets brighter")) if part == 1 else ("the battery does not run out" if part == 2 else ("the screen does not go dark" if believable else "the screen does not get brighter")))
        return "it rains on the field" if part == 0 else ((("the grass gets wet" if believable else "the grass catches fire")) if part == 1 else ("it does not rain on the field" if part == 2 else ("the grass does not get wet" if believable else "the grass does not catch fire")))

    def capitalised(out: mutable dstr&, words: dstr&):
        can Abort.Panic, Memory.Allocate:
            for i in 0..<words.count.i64() |out, words|:
                c: u8 = words[i.usize()]
                out.push((c - 32.u8()) if i == 0 and c >= 97.u8() and c <= 122.u8() else c)

    def phrase(a: cstr, b: cstr, c: cstr) -> dstr:
        can Abort.Panic, Memory.Allocate:
            out: mutable dstr = []
            dstr_append_cstr(&out, a)
            dstr_append_cstr(&out, b)
            dstr_append_cstr(&out, c)
            return out

    # conditional(): the rule, what is given, and so what.
    def conditional(form: i64, p: dstr, q: dstr, np: dstr, nq: dstr) -> Argument:
        can Abort.Panic, Memory.Allocate:
            given: dstr = p if form == MP else (nq if form == MT else (q if form == AC else np))
            so: dstr = q if form == MP else (np if form == MT else (p if form == AC else nq))
            rule: mutable dstr = []
            dstr_append_cstr(&rule, "if ")
            dstr_append_dstr(&rule, p)
            dstr_append_cstr(&rule, ", ")
            dstr_append_dstr(&rule, q)
            text: mutable dstr = []
            capitalised(&text, &rule)
            dstr_append_cstr(&text, ".\n")
            capitalised(&text, &given)
            dstr_append_cstr(&text, ".\nSo ")
            dstr_append_dstr(&text, so)
            dstr_append_cstr(&text, ".")
            return Argument{text: text, form: form, valid: form == MP or form == MT, made: true}

    def are(out: mutable dstr&, quantifier: cstr, s: cstr, p: cstr):
        can Abort.Panic, Memory.Allocate:
            dstr_append_cstr(out, quantifier)
            dstr_append_cstr(out, " ")
            dstr_append_cstr(out, s)
            dstr_append_cstr(out, " are ")
            dstr_append_cstr(out, p)

    def categorical(form: i64, s: cstr, m: cstr, p: cstr) -> Argument:
        can Abort.Panic, Memory.Allocate:
            text: mutable dstr = []
            if form == BARBARA:
                are(&text, "All", m, p)
                dstr_append_cstr(&text, ".\n")
                are(&text, "All", s, m)
                dstr_append_cstr(&text, ".\nSo ")
                are(&text, "all", s, p)
            elif form == CELARENT:
                are(&text, "No", m, p)
                dstr_append_cstr(&text, ".\n")
                are(&text, "All", s, m)
                dstr_append_cstr(&text, ".\nSo ")
                are(&text, "no", s, p)
            elif form == MIDDLE:
                are(&text, "All", s, p)
                dstr_append_cstr(&text, ".\n")
                are(&text, "All", m, p)
                dstr_append_cstr(&text, ".\nSo ")
                are(&text, "all", s, m)
            else:
                are(&text, "All", s, m)
                dstr_append_cstr(&text, ".\nSo ")
                are(&text, "all", m, s)
            dstr_append_cstr(&text, ".")
            return Argument{text: text, form: form, valid: form == BARBARA or form == CELARENT, made: true}

    def conditional_form(form: i64) -> bool:
        return form == MP or form == MT or form == AC or form == DA

    def nonsense(form: i64, draw: mutable MT19937&) -> Argument:
        can Abort.Panic, Memory.Allocate:
            if conditional_form(form) or form == OFF:
                t: cstr = thing(py_choice_index(draw, 8))
                picked: darray[i64] = py_sample_range(draw, 0, 9, 3)
                a: cstr = nonsense_adjective(picked[0])
                b: cstr = nonsense_adjective(picked[1])
                c: cstr = nonsense_adjective(picked[2])
                p: mutable dstr = phrase("the ", t, " is ")
                dstr_append_cstr(&p, a)
                q: dstr = phrase("it is ", b, "")
                np: mutable dstr = phrase("the ", t, " is not ")
                dstr_append_cstr(&np, a)
                nq: dstr = phrase("it is not ", b, "")
                if form == OFF:
                    rule: mutable dstr = []
                    dstr_append_cstr(&rule, "if ")
                    dstr_append_dstr(&rule, p)
                    dstr_append_cstr(&rule, ", ")
                    dstr_append_dstr(&rule, q)
                    text: mutable dstr = []
                    capitalised(&text, &rule)
                    dstr_append_cstr(&text, ".\n")
                    capitalised(&text, &p)
                    dstr_append_cstr(&text, ".\nSo it is ")
                    dstr_append_cstr(&text, c)
                    dstr_append_cstr(&text, ".")
                    return Argument{text: text, form: OFF, valid: false, made: true}
                return conditional(form, p, q, np, nq)
            picked: darray[i64] = py_sample_range(draw, 0, 11, 3)
            return categorical(form, nonsense_noun(picked[0]), nonsense_noun(picked[1]), nonsense_noun(picked[2]))

    # worldly(): an argument about real things whose conclusion is true of the
    # world exactly when believable; made false when nothing fits.
    def worldly(form: i64, believable: bool, draw: mutable MT19937&) -> Argument:
        can Abort.Panic, Memory.Allocate:
            if conditional_form(form):
                which: i64 = py_choice_index(draw, 6)
                return conditional(form, phrase("", rule_part(which, believable, 0), ""), phrase("", rule_part(which, believable, 1), ""),
                    phrase("", rule_part(which, believable, 2), ""), phrase("", rule_part(which, believable, 3), ""))
            which: i64 = py_choice_index(draw, 10)
            others: mutable darray[i64] = []
            for c in 0..<10 |others, which|:
                others.push(c) if chain_kind(c) != chain_kind(which)
            other: i64 = others[py_choice_index(draw, others.count.i64()).usize()]
            s: cstr = chain_term(which, 0)
            m: cstr = chain_term(which, 1)
            p: cstr = chain_term(which, 2)
            if form == BARBARA:
                return categorical(form, s, m, p if believable else chain_term(other, 2))
            if form == CELARENT:
                return categorical(form, s, m, chain_term(other, 2) if believable else p)
            if form == MIDDLE:
                if believable:
                    return categorical(form, s, m, p)
                mids: mutable darray[i64] = []
                for c in 0..<10 |mids, which|:
                    mids.push(c) if chain_kind(c) == chain_kind(which) and c != which
                if mids.count == 0.usize():
                    _ = py_choice_index(draw, 1)
                    return zeroed
                mid: i64 = mids[py_choice_index(draw, mids.count.i64()).usize()]
                return categorical(form, s, chain_term(mid, 1), p)
            return zeroed if believable
            return categorical(form, s, m, p)

    def chain(valid: bool, draw: mutable MT19937&) -> Argument:
        can Abort.Panic, Memory.Allocate:
            which: i64 = py_choice_index(draw, 4)
            premises: mutable darray[dstr] = []
            for k in 0..<3 |premises, which|:
                line: mutable dstr = []
                are(&line, "All", long_term(which, k), long_term(which, k + 1))
                premises.push(line)
            form: mutable i64 = WHOLE_CHAIN
            if not valid:
                k: i64 = py_randrange(draw, 0, 3)
                turned: mutable dstr = []
                are(&turned, "All", long_term(which, k + 1), long_term(which, k))
                premises[k.usize()] <- turned
                form <- BROKEN
            order: mutable darray[i64] = ReadingQuiz::indices_of(3)
            py_shuffle_i64(draw, &order)
            text: mutable dstr = []
            for i in order:
                dstr_append_dstr(&text, premises[i.usize()])
                dstr_append_cstr(&text, ".\n")
            dstr_append_cstr(&text, "So ")
            are(&text, "all", long_term(which, 0), long_term(which, 3))
            dstr_append_cstr(&text, ".")
            return Argument{text: text, form: form, valid: valid, made: true}

    def words(text: cstr) -> dstr:
        can Abort.Panic, Memory.Allocate:
            out: mutable dstr = []
            dstr_append_cstr(&out, text)
            return out

    # quiz.step with keep_order: the answers as given, nothing drawn.
    def follows_step(answer: i64) -> ReadingQuiz::Step:
        can Abort.Panic, Memory.Allocate:
            options: darray[dstr] = [words("it follows"), words("it does not follow")]
            return ReadingQuiz::Step{ask: words("Does the conclusion follow?"), options: options, answer: answer, wide: false, values: []}

    def ask(level: Grade&, argument: Argument&, draw: mutable MT19937&) -> ReadingQuiz::Step:
        can Abort.Panic, Memory.Allocate:
            if level.name:
                names: mutable darray[dstr] = []
                for i in 0..<5 |names|:
                    names.push(words(flaw_name(i)))
                return ReadingQuiz::shuffled_step(words("What is wrong with it?"), &names, flaw_of(argument.form), draw)
            return follows_step(0 if argument.valid else 1)

    def same_prompt(left: dstr&, right: dstr&) -> bool:
        can Abort.Panic:
            return false if left.count != right.count
            for i in 0..<left.count.i64() |left, right|:
                return false if left[i.usize()] != right[i.usize()]
            return true

    def seen_prompt(items: darray[ReadingQuiz::Item]&, prompt: dstr&) -> bool:
        can Abort.Panic:
            for item in items:
                return true if same_prompt(&item.prompt, prompt)
            return false

    struct Made:
        item: ReadingQuiz::Item
        valid: bool

    def build(level: Grade, draw: mutable MT19937&, corpus: Corpus&) -> Round:
        can Memory.Allocate, Abort.Panic:
            # A source not fetched (and without written stand-ins) is left out.
            kinds: mutable darray[i64] = []
            for i in 0..<level.kind_count |kinds, level, corpus|:
                kind: i64 = level.kinds[i.usize()]
                kinds.push(kind) if (kind != FALLACY and kind != FORMAL) or corpus.questions[(kind - FALLACY).usize()].count > 0.usize()
            decks: mutable Deck[2] = zeroed
            for data in 0..<2 |decks, kinds, corpus, draw|:
                present: mutable bool = false
                for kind in kinds:
                    present <- true if kind == FALLACY + data
                if present:
                    cards: mutable darray[i64] = ReadingQuiz::indices_of(corpus.questions[data.usize()].count.i64())
                    py_shuffle_i64(draw, &cards)
                    decks[data.usize()] <- Deck{cards: cards, taken: 0}
            order: mutable darray[i64] = []
            for i in 0..<ITEMS |order, kinds|:
                order.push(kinds[(i % kinds.count.i64()).usize()])
            py_shuffle_i64(draw, &order)
            offered: mutable darray[ReadingQuiz::Item] = []
            spent: mutable bool[5] = zeroed
            turn: mutable i64 = 0
            for kind in order:
                chosen: mutable ReadingQuiz::Item = zeroed
                found: mutable bool = false
                fresh: mutable bool = false
                for _ in 0..<(1 if spent[kind.usize()] else 400) |draw, offered, kind, level, chosen, found, fresh, decks, corpus, turn|:
                    item: mutable ReadingQuiz::Item = zeroed
                    if kind == FALLACY or kind == FORMAL:
                        data: i64 = kind - FALLACY
                        pool: darray[Question]& = &corpus.questions[data.usize()]
                        deck: mutable Deck& = &decks[data.usize()]
                        question: Question = pool[deck.cards[(deck.taken % pool.count.i64()).usize()].usize()]
                        deck.taken <- deck.taken + 1
                        steps: darray[ReadingQuiz::Step] = [follows_step(question.answer)]
                        item <- ReadingQuiz::reading_item(question.prompt, steps, level.pace, "An argument")
                    else:
                        argument: mutable Argument = zeroed
                        if kind == CHAIN:
                            argument <- chain(py_random(draw) < 0.5, draw)
                        elif kind == NONSENSE:
                            argument <- nonsense(level.forms[py_choice_index(draw, level.form_count).usize()], draw)
                        else:
                            cell: i64 = turn % 4
                            valid: bool = cell < 2
                            believable: bool = cell % 2 == 0
                            forms: mutable darray[i64] = []
                            for f in 0..<level.form_count |forms, level, valid|:
                                form: i64 = level.forms[f.usize()]
                                forms.push(form) if valid_form(form) == valid
                            argument <- worldly(forms[py_choice_index(draw, forms.count.i64()).usize()], believable, draw)
                            continue if not argument.made
                            turn <- turn + 1
                        steps: darray[ReadingQuiz::Step] = [ask(&level, &argument, draw)]
                        item <- ReadingQuiz::reading_item(argument.text, steps, level.pace, "An argument")
                    if not found:
                        chosen <- item
                        found <- true
                    if not seen_prompt(&offered, &item.prompt):
                        chosen <- item
                        fresh <- true
                        break
                spent[kind.usize()] <- true if not fresh
                offered.push(chosen) if found
            return zeroed if offered.count.i64() != ITEMS
            quiz: ReadingQuiz::Round = ReadingQuiz::assemble(offered, 15)
            return Round{level: level, quiz: quiz}

    def deal(level: Grade, draw: mutable MT19937&, corpus: Corpus&) -> Round:
        can Memory.Allocate, Abort.Panic:
            for _ in 0..<40 |level, draw, corpus|:
                next: mutable MT19937 = zeroed
                mt_seed_int(&next, py_getrandbits(draw, 32))
                round: Round = build(level, &next, corpus)
                return round if round.quiz.items.count > 0.usize()
            return zeroed
