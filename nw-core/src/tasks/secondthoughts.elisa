include "../pymath.elisa"
include "./reading_quiz.elisa"

# secondthoughts.py: questions whose first answer is wrong. Every puzzle is
# made here with fresh numbers and names; the answer that comes to mind at
# once is always among the choices.
module SecondThoughts:
    const ITEMS: i64 = 10
    const KINDS: i64 = 10
    const RACE: i64 = 0
    const POND: i64 = 1
    const COIN: i64 = 2
    const COUNTS: i64 = 3
    const BAKERS: i64 = 4
    const PRICE: i64 = 5
    const DESCRIPTION: i64 = 6
    const HOSPITAL: i64 = 7
    const PERCENT: i64 = 8
    const TWO_TESTS: i64 = 9

    struct Grade:
        rung: i64
        kinds: i64
        pace: ReadingQuiz::Pace

    # Nothing is read from disk; the hosts keep the same shape as the other
    # quizzes, so the corpus is empty.
    struct Corpus:
        unused: i64

    struct Round:
        level: Grade
        quiz: ReadingQuiz::Round

    struct Puzzle:
        text: dstr
        ask: dstr
        options: darray[dstr]
        valid: bool

    # LADDER: rungs 1-3 four kinds, 4-6 seven, 7-12 nine, 13 and up all ten.
    def grade(requested: i64) -> Grade:
        rung: i64 = requested if requested > 0 else 1
        band: i64 = 1 + (rung - 1) / 3
        kinds: i64 = 4 if band <= 1 else (7 if band == 2 else (9 if band <= 4 else 10))
        return Grade{rung: rung, kinds: kinds, pace: ReadingQuiz::reading_pace(rung, 1.6, 3.2, 8.0, 4.0)}

    def kind_name(kind: i64) -> cstr:
        return "race" if kind == RACE
        return "pond" if kind == POND
        return "coin" if kind == COIN
        return "counts" if kind == COUNTS
        return "bakers" if kind == BAKERS
        return "price" if kind == PRICE
        return "description" if kind == DESCRIPTION
        return "hospital" if kind == HOSPITAL
        return "percent" if kind == PERCENT
        return "two_tests"

    def title(kind: i64) -> cstr:
        return "A test" if kind == COUNTS or kind == PERCENT
        return "Two tests" if kind == TWO_TESTS
        return "Think twice"

    def ordinal(k: i64) -> cstr:
        return "first" if k == 0
        return "second" if k == 1
        return "third" if k == 2
        return "fourth" if k == 3
        return "fifth" if k == 4
        return "sixth" if k == 5
        return "seventh" if k == 6
        return "eighth" if k == 7
        return "ninth" if k == 8
        return "tenth"

    def name_of(k: i64) -> cstr:
        return names_at(k)

    def names_at(index: i64) -> cstr:
        return "Alex" if index == 0
        return "Sam" if index == 1
        return "Robin" if index == 2
        return "Jamie" if index == 3
        return "Kim" if index == 4
        return "Noor" if index == 5
        return "Mika" if index == 6
        return "Ola" if index == 7
        return "Lee" if index == 8
        return "Sasha" if index == 9
        return "Toni" if index == 10
        return "Ari"

    def things_at(index: i64) -> cstr:
        return "lily pads" if index == 0
        return "mould" if index == 1
        return "algae" if index == 2
        return "moss"

    def wholes_at(index: i64) -> cstr:
        return "pond" if index == 0
        return "loaf" if index == 1
        return "lake" if index == 2
        return "stone"

    def people_at(index: i64) -> cstr:
        return "bakers" if index == 0
        return "machines" if index == 1
        return "painters" if index == 2
        return "printers"

    def verbs_at(index: i64) -> cstr:
        return "bake" if index == 0
        return "make" if index == 1
        return "paint" if index == 2
        return "print"

    def goods_at(index: i64) -> cstr:
        return "cakes" if index == 0
        return "widgets" if index == 1
        return "fences" if index == 2
        return "posters"

    def firsts_at(index: i64) -> cstr:
        return "bat" if index == 0
        return "pen" if index == 1
        return "cup" if index == 2
        return "book" if index == 3
        return "lamp"

    def seconds_at(index: i64) -> cstr:
        return "ball" if index == 0
        return "cap" if index == 1
        return "saucer" if index == 2
        return "bookmark" if index == 3
        return "bulb"

    def traits_at(index: i64) -> cstr:
        return "is outspoken and cares a great deal about fairness; at university she marched against discrimination" if index == 0
        return "spends every weekend on long mountain hikes and talks about little but rock and rope" if index == 1
        return "reads poetry on the train and fills notebooks with verses" if index == 2
        return "could take a radio apart at nine and builds robots in the garage" if index == 3
        return "never misses a match and knows every player's statistics" if index == 4
        return "grows tomatoes on the balcony and talks to every plant"

    def jobs_at(index: i64) -> cstr:
        return "a bank teller" if index == 0
        return "an accountant" if index == 1
        return "a nurse" if index == 2
        return "a teacher" if index == 3
        return "a dentist" if index == 4
        return "a lawyer"

    def extras_at(index: i64) -> cstr:
        return "active in the feminist movement" if index == 0
        return "a keen climber" if index == 1
        return "writes poems" if index == 2
        return "an electronics hobbyist" if index == 3
        return "a football fan" if index == 4
        return "a keen gardener"

    def places_at(index: i64) -> cstr:
        return "North" if index == 0
        return "South" if index == 1
        return "East" if index == 2
        return "West" if index == 3
        return "Harbour" if index == 4
        return "Hill"

    def text(words: cstr) -> dstr:
        can Abort.Panic, Memory.Allocate:
            out: mutable dstr = []
            dstr_append_cstr(&out, words)
            return out

    def number(value: i64) -> dstr:
        can Abort.Panic, Memory.Allocate:
            out: mutable dstr = []
            dstr_append_i64(&out, value)
            return out

    def same_text(left: dstr&, right: dstr&) -> bool:
        can Abort.Panic:
            return false if left.count != right.count
            for i in 0..<left.count.i64() |left, right|:
                return false if left[i.usize()] != right[i.usize()]
            return true

    # random.randrange(start, stop, step) for a positive step.
    def randrange_step(draw: mutable MT19937&, start: i64, stop: i64, step: i64) -> i64:
        can Abort.Panic:
            return start + step * py_randbelow(draw, ((stop - start + step - 1) / step).u64()).i64()

    # _make: the right answer first, the lure second, then the others not
    # already there; None unless at least three and all different; at most four.
    def make(words: dstr, ask: dstr, right: dstr, lure: dstr, others: darray[dstr]&) -> Puzzle:
        can Abort.Panic, Memory.Allocate:
            opts: mutable darray[dstr] = [right, lure]
            for other in others:
                opts.push(other) if not same_text(&other, &right) and not same_text(&other, &lure)
            count: i64 = opts.count.i64()
            return zeroed if count < 3
            for i in 0..<count |opts, count|:
                for j in (i + 1)..<count |opts, i|:
                    return zeroed if same_text(&opts[i.usize()], &opts[j.usize()])
            kept: mutable darray[dstr] = []
            for i in 0..<(4 if count > 4 else count) |kept, opts|:
                kept.push(opts[i.usize()])
            return Puzzle{text: words, ask: ask, options: kept, valid: true}

    def race(draw: mutable MT19937&) -> Puzzle:
        can Abort.Panic, Memory.Allocate:
            k: i64 = py_randrange(draw, 1, 7)
            words: mutable dstr = []
            dstr_append_cstr(&words, "You are running a race and overtake the runner in ")
            dstr_append_cstr(&words, ordinal(k))
            dstr_append_cstr(&words, " place.")
            others: darray[dstr] = [text(ordinal(k + 1)), text(ordinal(k - 2) if k >= 2 else "last")]
            return make(words, text("What place are you in now?"), text(ordinal(k)), text(ordinal(k - 1)), &others)

    def pond(draw: mutable MT19937&) -> Puzzle:
        can Abort.Panic, Memory.Allocate:
            n: i64 = randrange_step(draw, 10, 60, 2)
            which: i64 = py_choice_index(draw, 4)
            words: mutable dstr = []
            dstr_append_cstr(&words, "A patch of ")
            dstr_append_cstr(&words, things_at(which))
            dstr_append_cstr(&words, " doubles in size every day. It takes ")
            dstr_append_i64(&words, n)
            dstr_append_cstr(&words, " days to cover the whole ")
            dstr_append_cstr(&words, wholes_at(which))
            dstr_append_cstr(&words, ".")
            others: darray[dstr] = [number(n - 2), number(n / 4)]
            return make(words, text("How many days did it take to cover half of it?"), number(n - 1), number(n / 2), &others)

    def coin(draw: mutable MT19937&) -> Puzzle:
        can Abort.Panic, Memory.Allocate:
            k: i64 = py_randrange(draw, 4, 9)
            words: mutable dstr = []
            if py_random(draw) < 0.5:
                dstr_append_cstr(&words, "A fair coin has landed heads ")
                dstr_append_i64(&words, k)
                dstr_append_cstr(&words, " times in a row.")
                heads: darray[dstr] = [text("heads")]
                return make(words, text("On the next toss, which is more likely?"),
                    text("heads and tails are equally likely"), text("tails"), &heads)
            dstr_append_cstr(&words, "A fair die has not shown a six in its last ")
            dstr_append_i64(&words, 3 * k)
            dstr_append_cstr(&words, " rolls.")
            less: darray[dstr] = [text("less likely than usual")]
            return make(words, text("On the next roll, a six is..."), text("as likely as ever"),
                text("more likely than usual"), &less)

    def minutes(value: i64) -> dstr:
        can Abort.Panic, Memory.Allocate:
            out: mutable dstr = number(value)
            dstr_append_cstr(&out, " minutes")
            return out

    def bakers(draw: mutable MT19937&) -> Puzzle:
        can Abort.Panic, Memory.Allocate:
            who: i64 = py_choice_index(draw, 4)
            n: i64 = py_randrange(draw, 3, 9)
            ms: i64[6] = [5, 6, 8, 10, 12, 15]
            m: i64 = ms[py_choice_index(draw, 6).usize()]
            ks: i64[5] = [60, 80, 100, 120, 200]
            k: i64 = ks[py_choice_index(draw, 5).usize()]
            words: mutable dstr = number(n)
            dstr_append_cstr(&words, " ")
            dstr_append_cstr(&words, people_at(who))
            dstr_append_cstr(&words, " ")
            dstr_append_cstr(&words, verbs_at(who))
            dstr_append_cstr(&words, " ")
            dstr_append_i64(&words, n)
            dstr_append_cstr(&words, " ")
            dstr_append_cstr(&words, goods_at(who))
            dstr_append_cstr(&words, " in ")
            dstr_append_i64(&words, m)
            dstr_append_cstr(&words, " minutes.")
            ask: mutable dstr = []
            dstr_append_cstr(&ask, "How long do ")
            dstr_append_i64(&ask, k)
            dstr_append_cstr(&ask, " ")
            dstr_append_cstr(&ask, people_at(who))
            dstr_append_cstr(&ask, " take to ")
            dstr_append_cstr(&ask, verbs_at(who))
            dstr_append_cstr(&ask, " ")
            dstr_append_i64(&ask, k)
            dstr_append_cstr(&ask, " ")
            dstr_append_cstr(&ask, goods_at(who))
            dstr_append_cstr(&ask, "?")
            others: darray[dstr] = [minutes(m * k / n), minutes(k / n)]
            return make(words, ask, minutes(m), minutes(k), &others)

    # '%d.%02d' % divmod(cents, 100)
    def money(cents: i64) -> dstr:
        can Abort.Panic, Memory.Allocate:
            out: mutable dstr = number(cents / 100)
            dstr_append_cstr(&out, ".")
            dstr_append_cstr(&out, "0") if cents % 100 < 10
            dstr_append_i64(&out, cents % 100)
            return out

    def price(draw: mutable MT19937&) -> Puzzle:
        can Abort.Panic, Memory.Allocate:
            pair: i64 = py_choice_index(draw, 5)
            a: cstr = firsts_at(pair)
            b: cstr = seconds_at(pair)
            low: i64 = randrange_step(draw, 5, 50, 5)
            diff: i64 = randrange_step(draw, 100, 400, 50)
            total: i64 = 2 * low + diff
            words: mutable dstr = []
            dstr_append_cstr(&words, "A ")
            dstr_append_cstr(&words, a)
            dstr_append_cstr(&words, " and a ")
            dstr_append_cstr(&words, b)
            dstr_append_cstr(&words, " cost ")
            dstr_append_dstr(&words, money(total))
            dstr_append_cstr(&words, " together. The ")
            dstr_append_cstr(&words, a)
            dstr_append_cstr(&words, " costs ")
            dstr_append_dstr(&words, money(diff))
            dstr_append_cstr(&words, " more than the ")
            dstr_append_cstr(&words, b)
            dstr_append_cstr(&words, ".")
            ask: mutable dstr = []
            dstr_append_cstr(&ask, "How much does the ")
            dstr_append_cstr(&ask, b)
            dstr_append_cstr(&ask, " cost?")
            others: darray[dstr] = [money(total / 2), money(diff / 2)]
            return make(words, ask, money(low), money(total - diff), &others)

    def description(draw: mutable MT19937&) -> Puzzle:
        can Abort.Panic, Memory.Allocate:
            person: i64 = py_choice_index(draw, 6)
            name: cstr = name_of(py_choice_index(draw, 12))
            one: mutable dstr = text(name)
            dstr_append_cstr(&one, " is ")
            dstr_append_cstr(&one, jobs_at(person))
            both: mutable dstr = []
            dstr_append_dstr(&both, one)
            dstr_append_cstr(&both, " and ")
            dstr_append_cstr(&both, extras_at(person))
            words: mutable dstr = text(name)
            dstr_append_cstr(&words, " ")
            dstr_append_cstr(&words, traits_at(person))
            dstr_append_cstr(&words, ".")
            same: darray[dstr] = [text("both are equally likely")]
            if py_random(draw) < 0.5:
                return make(words, text("Which is more likely?"), one, both, &same)
            return make(words, text("Which is less likely?"), both, one, &same)

    def hospital(draw: mutable MT19937&) -> Puzzle:
        can Abort.Panic, Memory.Allocate:
            small: i64 = py_randrange(draw, 10, 20)
            big: i64 = py_randrange(draw, 40, 70)
            picked: darray[i64] = py_sample_range(draw, 0, 5, 2)
            first: cstr = places_at(picked[0])
            second: cstr = places_at(picked[1])
            words: mutable dstr = text(first)
            dstr_append_cstr(&words, " Hospital has about ")
            dstr_append_i64(&words, small)
            dstr_append_cstr(&words, " births a day, ")
            dstr_append_cstr(&words, second)
            dstr_append_cstr(&words, " Hospital about ")
            dstr_append_i64(&words, big)
            dstr_append_cstr(&words, ". About half of all babies are boys. For a year, each hospital counted the days on which more than 60% of the babies born were boys.")
            if py_random(draw) < 0.5:
                bigger: darray[dstr] = [text(second)]
                return make(words, text("Which hospital counted more such days?"), text(first), text("about the same"), &bigger)
            smaller: darray[dstr] = [text(first)]
            return make(words, text("Which hospital counted fewer such days?"), text(second), text("about the same"), &smaller)

    def of(part: i64, whole: i64) -> dstr:
        can Abort.Panic, Memory.Allocate:
            out: mutable dstr = number(part)
            dstr_append_cstr(&out, " of ")
            dstr_append_i64(&out, whole)
            return out

    def test_counts(draw: mutable MT19937&) -> Puzzle:
        can Abort.Panic, Memory.Allocate:
            sizes: i64[3] = [100, 200, 1000]
            n: i64 = sizes[py_choice_index(draw, 3).usize()]
            rates: i64[4] = [2, 4, 5, 10]
            ill: i64 = rates[py_choice_index(draw, 4).usize()] * n / 100
            return zeroed if ill < 5
            spread: i64 = ill / 5
            found: i64 = ill - py_randrange(draw, 0, (spread if spread > 1 else 1) + 1)
            falses: i64[4] = [5, 8, 10, 15]
            wrongly: mutable i64 = falses[py_choice_index(draw, 4).usize()] * (n - ill) / 100
            if wrongly <= found:
                wrongly <- found + py_randrange(draw, 2, 10)
            words: mutable dstr = text("Of ")
            dstr_append_i64(&words, n)
            dstr_append_cstr(&words, " people, ")
            dstr_append_i64(&words, ill)
            dstr_append_cstr(&words, " have an illness. A test comes out positive for ")
            dstr_append_i64(&words, found)
            dstr_append_cstr(&words, " of those ")
            dstr_append_i64(&words, ill)
            dstr_append_cstr(&words, ", and also for ")
            dstr_append_i64(&words, wrongly)
            dstr_append_cstr(&words, " of the ")
            dstr_append_i64(&words, n - ill)
            dstr_append_cstr(&words, " who are well.")
            others: darray[dstr] = [of(ill, n), of(wrongly, found + wrongly)]
            return make(words, text("Of the people who test positive, how many have the illness?"),
                of(found, found + wrongly), of(found, ill), &others)

    # '%g' for the few values these puzzles print: at most six significant
    # digits, no trailing zeros, no exponent (they are all between 0.01 and
    # 100).
    def append_g(out: mutable dstr&, value: f64):
        can Abort.Panic, Memory.Allocate:
            digits: mutable i64 = 0
            scaled: mutable f64 = value
            while scaled >= 10.0 |scaled, digits|:
                scaled <- scaled / 10.0
                digits <- digits + 1
            while scaled < 1.0 and value > 0.0 |scaled, digits|:
                scaled <- scaled * 10.0
                digits <- digits - 1
            places: i64 = 5 - digits
            fixed: mutable dstr = []
            dstr_append_fixed(&fixed, value, places if places > 0 else 0)
            length: mutable i64 = fixed.count.i64()
            dot: mutable bool = false
            for i in 0..<length |fixed, dot|:
                dot <- true if fixed[i.usize()] == 46.u8()
            if dot:
                while length > 0 and fixed[(length - 1).usize()] == 48.u8() |fixed, length|:
                    length <- length - 1
                length <- length - 1 if length > 0 and fixed[(length - 1).usize()] == 46.u8()
            for i in 0..<length |out, fixed|:
                out.push(fixed[i.usize()])

    # round(x, 1) as CPython does it for the values _pct sees.
    def round_tenth(value: f64) -> f64:
        return py_round_half_even(value * 10.0).f64() / 10.0

    def percent(x: f64) -> dstr:
        can Abort.Panic, Memory.Allocate:
            out: mutable dstr = text("about ")
            if x < 0.01:
                append_g(&out, round_tenth(100.0 * x))
            else:
                dstr_append_i64(&out, py_round_half_even(100.0 * x))
            dstr_append_cstr(&out, "%")
            return out

    def posterior(prior: f64, sens: f64, fp: f64, tests: i64) -> f64:
        a: mutable f64 = prior
        b: mutable f64 = 1.0 - prior
        for _ in 0..<tests |a, b, sens, fp|:
            a <- a * sens
            b <- b * fp
        return a / (a + b)

    def test_percent(draw: mutable MT19937&, tests: i64) -> Puzzle:
        can Abort.Panic, Memory.Allocate:
            once: f64[3] = [0.01, 0.02, 0.05]
            twice: f64[3] = [0.001, 0.002, 0.005]
            pick: i64 = py_choice_index(draw, 3)
            prior: f64 = once[pick.usize()] if tests == 1 else twice[pick.usize()]
            senses: f64[3] = [0.8, 0.9, 0.95]
            sens: f64 = senses[py_choice_index(draw, 3).usize()]
            wrongs: f64[3] = [0.05, 0.1, 0.2]
            fp: f64 = wrongs[py_choice_index(draw, 3 if tests == 1 else 2).usize()]
            post: f64 = posterior(prior, sens, fp, tests)
            return zeroed if (post - sens < 0.12 and sens - post < 0.12)
            words: mutable dstr = []
            append_g(&words, 100.0 * prior)
            dstr_append_cstr(&words, "% of people have an illness. A test finds it in ")
            append_g(&words, 100.0 * sens)
            dstr_append_cstr(&words, "% of those who have it, and wrongly finds it in ")
            append_g(&words, 100.0 * fp)
            dstr_append_cstr(&words, "% of those who do not. ")
            dstr_append_cstr(&words, "Someone tests positive." if tests == 1 else
                "Someone tests positive, and positive again on a second, independent test of the same kind.")
            others: darray[dstr] = [percent(prior), percent(1.0 - fp), percent(posterior(prior, sens, fp, tests + 1))]
            return make(words, text("How likely is it that they have the illness?"), percent(post), percent(sens), &others)

    def puzzle(kind: i64, draw: mutable MT19937&) -> Puzzle:
        can Abort.Panic, Memory.Allocate:
            return race(draw) if kind == RACE
            return pond(draw) if kind == POND
            return coin(draw) if kind == COIN
            return test_counts(draw) if kind == COUNTS
            return bakers(draw) if kind == BAKERS
            return price(draw) if kind == PRICE
            return description(draw) if kind == DESCRIPTION
            return hospital(draw) if kind == HOSPITAL
            return test_percent(draw, 1) if kind == PERCENT
            return test_percent(draw, 2)

    def seen_prompt(items: darray[ReadingQuiz::Item]&, prompt: dstr&) -> bool:
        can Abort.Panic:
            for item in items:
                return true if same_text(&item.prompt, prompt)
            return false

    # build(): quiz.mixed over the rung's kinds, each item a fresh puzzle with
    # its answers shuffled.
    def build(level: Grade, draw: mutable MT19937&, corpus: Corpus&) -> Round:
        can Memory.Allocate, Abort.Panic:
            order: mutable darray[i64] = []
            for i in 0..<ITEMS |order, level|:
                order.push(i % level.kinds)
            py_shuffle_i64(draw, &order)
            offered: mutable darray[ReadingQuiz::Item] = []
            spent: mutable bool[10] = zeroed
            for kind in order:
                chosen: mutable ReadingQuiz::Item = zeroed
                found: mutable bool = false
                fresh: mutable bool = false
                for _ in 0..<(1 if spent[kind.usize()] else 400) |draw, offered, kind, level, chosen, found, fresh|:
                    made: Puzzle = puzzle(kind, draw)
                    continue if not made.valid
                    step: ReadingQuiz::Step = ReadingQuiz::shuffled_step(made.ask, &made.options, 0, draw)
                    steps: darray[ReadingQuiz::Step] = [step]
                    item: ReadingQuiz::Item = ReadingQuiz::reading_item(made.text, steps, level.pace, title(kind))
                    if not found:
                        chosen <- item
                        found <- true
                    if not seen_prompt(&offered, &item.prompt):
                        chosen <- item
                        fresh <- true
                        break
                spent[kind.usize()] <- true if not fresh
                offered.push(chosen) if found
            return zeroed if offered.count.i64() != ITEMS
            quiz: ReadingQuiz::Round = ReadingQuiz::assemble(offered, 7)
            return Round{level: level, quiz: quiz}

    def deal(level: Grade, draw: mutable MT19937&, corpus: Corpus&) -> Round:
        can Memory.Allocate, Abort.Panic:
            for _ in 0..<40 |level, draw, corpus|:
                next: mutable MT19937 = zeroed
                mt_seed_int(&next, py_getrandbits(draw, 32))
                round: Round = build(level, &next, corpus)
                # The reference player answers every question at once, so
                # every assembled round passes its own play-through.
                return round if round.quiz.items.count > 0.usize()
            return zeroed

    # Nothing to import: the puzzles are all made here.
    def from_question_cache(owner: mutable Arena&, text: sview) -> Corpus:
        return zeroed
