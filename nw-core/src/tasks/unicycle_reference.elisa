include "./unicycle.elisa"

module UnicycleReference:
    const STEP: f64 = 1.0 / 30.0

    struct Deal:
        valid: bool
        track: Unicycle::Track

    def steer(track: Unicycle::Track&, b: Unicycle::Body&) -> i64:
        can Abort.Panic:
            here: f64 = Unicycle::ground(track, b.px)
            ledge: bool = (Unicycle::ground(track, b.px + 0.5) < here - 0.3 or
                Unicycle::ground(track, b.px + 1.0) < here - 0.3 or Unicycle::ground(track, b.px + 1.5) < here - 0.3)
            want: f64 = 1.4 if ledge else 2.2
            th: f64 = Unicycle::tilt(b)
            dx: f64 = b.qx - b.px
            dy: f64 = b.qy - b.py
            length: f64 = py_hypot(dx, dy)
            ln: f64 = length if length != 0.0 else 0.000000001
            rate: f64 = ((b.ux - b.vx) * dy - (b.uy - b.vy) * dx) / (ln * ln)
            target: f64 = fmax(-0.25, fmin(0.25, 0.12 * (want - b.ux)))
            u: f64 = 6.0 * (th - target) + 1.2 * rate
            lean: i64 = 1 if u < -0.15 else (-1 if u > 0.15 else 0)
            drive: i64 = 1 if th > 0.35 or (th >= -0.35 and b.ux < want - 0.2) else (
                -1 if th < -0.35 or b.ux > want + 0.3 else 0)
            return Unicycle::command(drive, lean)

    def play(track: Unicycle::Track) -> Unicycle::Run:
        can Abort.Panic:
            run: mutable Unicycle::Run = Unicycle::start(track)
            while run.result == Unicycle::LIVE |run|:
                port: i64 = steer(&run.track, &run.body)
                Unicycle::step(&run, STEP, port)
            return run

    def deal(rung: i64, rng: mutable MT19937&) -> Deal:
        can Abort.Panic:
            level: Unicycle::Grade = Unicycle::grade(rung)
            for _ in 0..<100 |level, rng|:
                track: mutable Unicycle::Track = Unicycle::build(level, rng)
                test: Unicycle::Run = play(track)
                if test.result == Unicycle::CLEAR:
                    track.seconds <- test.t * level.slack + 2.0
                    track.best <- test.t
                    if play(track).result == Unicycle::CLEAR:
                        return Deal{valid: true, track: track}
            return Deal{valid: false, track: zeroed}
