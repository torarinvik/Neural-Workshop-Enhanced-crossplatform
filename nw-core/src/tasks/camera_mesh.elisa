include "./camera.elisa"

module CameraMesh:
    const BOX: i64 = 0
    const BALL: i64 = 1
    const CYLINDER: i64 = 2
    const CONE: i64 = 3
    const PYRAMID: i64 = 4
    const RING: i64 = 5
    const FIELD: i64 = 6
    const OUTSIDE: i64 = 7
    const TAU: f64 = 6.283185307179586

    struct Vertex:
        position: RoomsView::Vec
        normal: RoomsView::Vec

    struct Mesh:
        vertices: mutable darray[Vertex]
        indices: mutable darray[u32]

    struct ProfilePoint:
        radius: f64
        height: f64

    struct Transform:
        translation: RoomsView::Vec
        scale: RoomsView::Vec
        cosine: f64
        sine: f64

    def mesh() -> Mesh:
        can Memory.Allocate:
            return Mesh{vertices: [], indices: []}

    def vertex(point: RoomsView::Vec, normal: RoomsView::Vec) -> Vertex:
        return Vertex{position: point, normal: normal}

    def triangle(result: mutable Mesh&, a: Vertex, b: Vertex, c: Vertex):
        can Memory.Allocate, Abort.Panic:
            ab: RoomsView::Vec = RoomsView::sub(b.position, a.position)
            ac: RoomsView::Vec = RoomsView::sub(c.position, a.position)
            mean: RoomsView::Vec = RoomsView::add(RoomsView::add(a.normal, b.normal), c.normal)
            reverse: bool = RoomsView::dot(RoomsView::cross(ab, ac), mean) < 0.0
            base: u32 = result.vertices.count.u32()
            result.vertices.push(a)
            result.vertices.push(c if reverse else b)
            result.vertices.push(b if reverse else c)
            result.indices.push(base)
            result.indices.push(base + 1.u32())
            result.indices.push(base + 2.u32())

    def quad(result: mutable Mesh&, a: RoomsView::Vec, b: RoomsView::Vec, c: RoomsView::Vec,
             d: RoomsView::Vec, normal: RoomsView::Vec):
        can Memory.Allocate, Abort.Panic:
            base: u32 = result.vertices.count.u32()
            result.vertices.push(vertex(a, normal))
            result.vertices.push(vertex(b, normal))
            result.vertices.push(vertex(c, normal))
            result.vertices.push(vertex(d, normal))
            indices: u32[6] = [0.u32(), 1.u32(), 2.u32(), 0.u32(), 2.u32(), 3.u32()]
            for index in indices |result, base|:
                result.indices.push(base + index)

    def cuboid(result: mutable Mesh&):
        can Memory.Allocate, Abort.Panic:
            a: RoomsView::Vec = RoomsView::vec(-0.42, 0.0, -0.42)
            b: RoomsView::Vec = RoomsView::vec(0.42, 0.0, -0.42)
            c: RoomsView::Vec = RoomsView::vec(0.42, 0.0, 0.42)
            d: RoomsView::Vec = RoomsView::vec(-0.42, 0.0, 0.42)
            up: RoomsView::Vec = RoomsView::vec(0.0, 1.0, 0.0)
            e: RoomsView::Vec = RoomsView::add(a, up)
            f: RoomsView::Vec = RoomsView::add(b, up)
            g: RoomsView::Vec = RoomsView::add(c, up)
            h: RoomsView::Vec = RoomsView::add(d, up)
            quad(result, h, g, f, e, up)
            quad(result, a, b, c, d, RoomsView::vec(0.0, -1.0, 0.0))
            quad(result, d, c, g, h, RoomsView::vec(0.0, 0.0, 1.0))
            quad(result, b, a, e, f, RoomsView::vec(0.0, 0.0, -1.0))
            quad(result, c, b, f, g, RoomsView::vec(1.0, 0.0, 0.0))
            quad(result, a, d, h, e, RoomsView::vec(-1.0, 0.0, 0.0))

    def lathe_vertex(profile: ProfilePoint, angle: f64, normal: RoomsView::Vec) -> Vertex:
        return vertex(RoomsView::vec(profile.radius * cos(angle), profile.height, profile.radius * sin(angle)), normal)

    def lathe_strip(result: mutable Mesh&, low: ProfilePoint, high: ProfilePoint, sides: i64, twist: f64):
        can Memory.Allocate, Abort.Panic:
            dr: f64 = high.radius - low.radius
            dy: f64 = high.height - low.height
            length: f64 = py_hypot(dr, dy)
            scale: f64 = length if length > 0.0 else 1.0
            nr: f64 = dy / scale
            ny: f64 = -dr / scale
            for side in 0..<sides |result, low, high, sides, twist, nr, ny|:
                a: f64 = twist + TAU * side.f64() / sides.f64()
                b: f64 = twist + TAU * (side + 1).f64() / sides.f64()
                ca: f64 = (a + b) / 2.0 if sides < 8 else a
                cb: f64 = ca if sides < 8 else b
                na: RoomsView::Vec = RoomsView::vec(nr * cos(ca), ny, nr * sin(ca))
                nb: RoomsView::Vec = RoomsView::vec(nr * cos(cb), ny, nr * sin(cb))
                p01: Vertex = lathe_vertex(low, b, nb)
                p10: Vertex = lathe_vertex(high, a, na)
                if low.radius > 0.000000001:
                    triangle(result, lathe_vertex(low, a, na), p10, p01)
                if high.radius > 0.000000001:
                    triangle(result, p01, p10, lathe_vertex(high, b, nb))

    def sphere_point(index: i64) -> ProfilePoint:
        angle: f64 = 3.141592653589793 * index.f64() / 16.0
        return ProfilePoint{radius: 0.5 * sin(angle), height: 0.5 - 0.5 * cos(angle)}

    def ring_vertex(u: f64, v: f64) -> Vertex:
        cu: f64 = cos(u)
        su: f64 = sin(u)
        cv: f64 = cos(v)
        sv: f64 = sin(v)
        r: f64 = 0.38 + 0.11 * cv
        return vertex(RoomsView::vec(r * cu, 0.49 + r * su, 0.11 * sv), RoomsView::vec(cu * cv, su * cv, sv))

    def ring_surface(result: mutable Mesh&):
        can Memory.Allocate, Abort.Panic:
            for i in 0..<28 |result|:
                u0: f64 = TAU * i.f64() / 28.0
                u1: f64 = TAU * (i + 1).f64() / 28.0
                for j in 0..<12 |result, u0, u1|:
                    v0: f64 = TAU * j.f64() / 12.0
                    v1: f64 = TAU * (j + 1).f64() / 12.0
                    a: Vertex = ring_vertex(u0, v0)
                    b: Vertex = ring_vertex(u1, v0)
                    c: Vertex = ring_vertex(u1, v1)
                    d: Vertex = ring_vertex(u0, v1)
                    triangle(result, a, b, c)
                    triangle(result, a, c, d)

    def ground(result: mutable Mesh&, half: f64, y: f64):
        can Memory.Allocate, Abort.Panic:
            quad(result, RoomsView::vec(-half, y, half), RoomsView::vec(half, y, half),
                RoomsView::vec(half, y, -half), RoomsView::vec(-half, y, -half), RoomsView::vec(0.0, 1.0, 0.0))

    def build(kind: i64, field: f64) -> Mesh:
        can Memory.Allocate, Abort.Panic:
            result: mutable Mesh = mesh()
            if kind == BOX:
                cuboid(&result)
            elif kind == BALL:
                for i in 0..<16 |result|:
                    lathe_strip(&result, sphere_point(i), sphere_point(i + 1), 28, 0.0)
            elif kind == CYLINDER:
                bottom: ProfilePoint = ProfilePoint{radius: 0.4, height: 0.0}
                top: ProfilePoint = ProfilePoint{radius: 0.4, height: 1.0}
                lathe_strip(&result, zeroed, bottom, 28, 0.0)
                lathe_strip(&result, bottom, top, 28, 0.0)
                lathe_strip(&result, top, ProfilePoint{radius: 0.0, height: 1.0}, 28, 0.0)
            elif kind == CONE or kind == PYRAMID:
                sides: i64 = 28 if kind == CONE else 4
                twist: f64 = 0.0 if kind == CONE else 0.7853981633974483
                bottom: ProfilePoint = ProfilePoint{radius: 0.48 if kind == CONE else 0.58, height: 0.0}
                lathe_strip(&result, zeroed, bottom, sides, twist)
                lathe_strip(&result, bottom, ProfilePoint{radius: 0.0, height: 1.0}, sides, twist)
            elif kind == RING:
                ring_surface(&result)
            elif kind == FIELD or kind == OUTSIDE:
                ground(&result, field if kind == FIELD else field * 6.0 + 60.0, 0.0 if kind == FIELD else -0.01)
            return result

    def colour(index: i64) -> RoomsView::Vec:
        palette: RoomsView::Vec[13] = [
            RoomsView::vec(0.86, 0.22, 0.20), RoomsView::vec(0.18, 0.46, 0.84), RoomsView::vec(0.95, 0.76, 0.18),
            RoomsView::vec(0.20, 0.64, 0.32), RoomsView::vec(0.58, 0.30, 0.72), RoomsView::vec(0.96, 0.52, 0.16),
            RoomsView::vec(0.10, 0.70, 0.74), RoomsView::vec(0.88, 0.40, 0.62), RoomsView::vec(0.45, 0.32, 0.20),
            RoomsView::vec(0.92, 0.92, 0.90), RoomsView::vec(0.22, 0.22, 0.26), RoomsView::vec(0.64, 0.80, 0.28),
            RoomsView::vec(0.62, 0.60, 0.56)]
        return palette[index.usize()]

    def transform(thing: Camera::Thing&) -> Transform:
        scale: f64 = thing.size
        angle: f64 = Camera::radians(thing.spin)
        return Transform{translation: RoomsView::vec(thing.x, 0.0, thing.z),
            scale: RoomsView::vec(scale * 1.6 if thing.occluder else scale, scale, scale * 0.9 if thing.occluder else scale),
            cosine: cos(angle), sine: sin(angle)}
