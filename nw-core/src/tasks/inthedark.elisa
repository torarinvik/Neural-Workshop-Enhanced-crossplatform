# In the Dark: rooms you can see, lamps you cannot.
#
# Port of neural_workshop/inthedark.py (GPL-2.0-or-later). A row of lamps is
# lit behind the player in colours never shown. Each room does one thing to the
# lamps -- paint one a colour, turn one to the next colour, swap two, copy one
# onto another -- and at the end the player is asked what colour some of them
# ended up.
#
# The design point is what a player CANNOT do: nothing on screen says what
# colour any lamp is, and because rooms are drawn from the operation alone, two
# runs with different lamps behind them draw exactly the same pixels and want
# different answers. A player reading only the screen is at chance BY
# CONSTRUCTION rather than by measurement.
#
# ## The floor is a proof, not a benchmark
#
# `trace` walks a lamp's history backwards: copy moves which lamp is being
# followed, swap exchanges it, turn shifts the value, paint fixes it and ends
# the chain. Until the chain reaches a paint the final colour is a BIJECTION
# applied to some lamp's unseen uniform start, so a player who remembers fewer
# than `needed` rooms holds no information at all. That is why the reference
# keeps `belief` -- the slow, obvious recomputation -- alongside it, and why
# this port keeps both: a fast derivation that nothing checks is a fast
# derivation nobody should trust. The sweep holds them against each other.
#
# ## Random-stream fidelity
#
# Per deal, in this order:
#   sample(range(lamps), asks)     the lamps asked about
#   per room, from the END backwards:
#       either randrange(colours)  when a chain is being closed by hand
#       or     choices(...)        one random() draw through the weight table
#   randrange(colours) per lamp    the unseen starting colours
#
# The rooms are laid BACKWARDS, which is the whole trick: dealing forwards and
# keeping walks that happened to bury their answers deep enough samples the
# wrong tail -- the reference measured the median walk pinning its weakest
# question four rooms from the end against a floor of twenty.

module InTheDark:
    const PAINT: i64 = 0
    const TURN: i64 = 1
    const SWAP: i64 = 2
    const COPY: i64 = 3

    const MOST_LAMPS: i64 = 6
    const MOST_COLOURS: i64 = 5
    const GRADE_COUNT: i64 = 12

    # How often each kind is dealt, before being shared out between the rooms of
    # that kind. Paint is the only kind that ends a chain, so its weight is the
    # dial between rounds that can be answered at all and rounds whose answer is
    # buried deep enough to be worth asking.
    def mix(kind: i64) -> i64:
        return 2 if kind == PAINT else (3 if kind == TURN else (3 if kind == SWAP else 2))

    struct InTheDarkGrade:
        lamps: mutable i64
        colours: mutable i64
        depth: mutable i64
        asks: mutable i64
        floor: mutable i64
        work: mutable f64

    # Kindergarten to superhuman. Every number in the reference was measured over
    # four hundred rounds a rung rather than guessed.
    def grade_at(level_number: i64) -> InTheDarkGrade:
        can Abort.Panic:
            index: mutable i64 = level_number - 1
            index <- 0 if index < 0 else index
            index <- GRADE_COUNT - 1 if index > GRADE_COUNT - 1 else index
            g: mutable InTheDarkGrade = zeroed
            if index == 0:
                g.lamps <- 2
                g.colours <- 2
                g.depth <- 6
                g.asks <- 1
                g.floor <- 4
                g.work <- 2.0
            elif index == 1:
                g.lamps <- 2
                g.colours <- 3
                g.depth <- 8
                g.asks <- 2
                g.floor <- 5
                g.work <- 2.5
            elif index == 2:
                g.lamps <- 3
                g.colours <- 3
                g.depth <- 10
                g.asks <- 2
                g.floor <- 7
                g.work <- 2.5
            elif index == 3:
                g.lamps <- 3
                g.colours <- 3
                g.depth <- 12
                g.asks <- 2
                g.floor <- 8
                g.work <- 3.0
            elif index == 4:
                g.lamps <- 4
                g.colours <- 3
                g.depth <- 14
                g.asks <- 3
                g.floor <- 9
                g.work <- 3.0
            elif index == 5:
                g.lamps <- 4
                g.colours <- 4
                g.depth <- 16
                g.asks <- 3
                g.floor <- 10
                g.work <- 3.5
            elif index == 6:
                g.lamps <- 5
                g.colours <- 4
                g.depth <- 18
                g.asks <- 3
                g.floor <- 12
                g.work <- 3.5
            elif index == 7:
                g.lamps <- 5
                g.colours <- 4
                g.depth <- 22
                g.asks <- 4
                g.floor <- 13
                g.work <- 3.5
            elif index == 8:
                g.lamps <- 6
                g.colours <- 4
                g.depth <- 26
                g.asks <- 4
                g.floor <- 15
                g.work <- 3.5
            elif index == 9:
                g.lamps <- 6
                g.colours <- 5
                g.depth <- 30
                g.asks <- 5
                g.floor <- 17
                g.work <- 4.0
            elif index == 10:
                g.lamps <- 6
                g.colours <- 5
                g.depth <- 34
                g.asks <- 5
                g.floor <- 18
                g.work <- 4.0
            else:
                g.lamps <- 6
                g.colours <- 5
                g.depth <- 40
                g.asks <- 6
                g.floor <- 20
                g.work <- 4.5
            return g

    # Every room that makes sense with this many lamps and colours, in the
    # reference's construction order -- paints, turns, swaps, copies. The order is
    # part of the random stream because choices() indexes into it.
    struct InTheDarkRooms:
        kind: mutable darray[i64]
        lamp: mutable darray[i64]
        other: mutable darray[i64]
        weight: mutable darray[f64]
        cum: mutable darray[f64]
        count: mutable i64

    def vocabulary(lamps: i64, colours: i64) -> InTheDarkRooms:
        can Memory.Allocate, Abort.Panic:
            cap: i64 = lamps * colours + lamps + lamps * lamps + lamps * lamps + 8
            rooms: mutable InTheDarkRooms = zeroed
            rooms.kind <- Ints::zeros(cap)
            rooms.lamp <- Ints::zeros(cap)
            rooms.other <- Ints::zeros(cap)
            rooms.count <- 0

            lamp: mutable i64 = 0
            while lamp < lamps |lamp, lamps, colours, rooms|:
                colour: mutable i64 = 0
                while colour < colours |colour, colours, lamp, rooms|:
                    Ints::put(&rooms.kind, rooms.count, PAINT)
                    Ints::put(&rooms.lamp, rooms.count, lamp)
                    Ints::put(&rooms.other, rooms.count, colour)
                    rooms.count <- rooms.count + 1
                    colour <- colour + 1
                lamp <- lamp + 1
            lamp <- 0
            while lamp < lamps |lamp, lamps, rooms|:
                Ints::put(&rooms.kind, rooms.count, TURN)
                Ints::put(&rooms.lamp, rooms.count, lamp)
                Ints::put(&rooms.other, rooms.count, 0)
                rooms.count <- rooms.count + 1
                lamp <- lamp + 1
            one: mutable i64 = 0
            while one < lamps |one, lamps, rooms|:
                other: mutable i64 = one + 1
                while other < lamps |other, lamps, one, rooms|:
                    Ints::put(&rooms.kind, rooms.count, SWAP)
                    Ints::put(&rooms.lamp, rooms.count, one)
                    Ints::put(&rooms.other, rooms.count, other)
                    rooms.count <- rooms.count + 1
                    other <- other + 1
                one <- one + 1
            dest: mutable i64 = 0
            while dest < lamps |dest, lamps, rooms|:
                source: mutable i64 = 0
                while source < lamps |source, lamps, dest, rooms|:
                    if source != dest:
                        Ints::put(&rooms.kind, rooms.count, COPY)
                        Ints::put(&rooms.lamp, rooms.count, dest)
                        Ints::put(&rooms.other, rooms.count, source)
                        rooms.count <- rooms.count + 1
                    source <- source + 1
                dest <- dest + 1

            # Share each kind's weight out evenly between the rooms of that kind.
            rooms.weight <- Floats::zeros(rooms.count + 1)
            rooms.cum <- Floats::zeros(rooms.count + 1)
            kind: mutable i64 = 0
            while kind < 4 |kind, rooms|:
                counted: mutable i64 = 0
                scan: mutable i64 = 0
                while scan < rooms.count |scan, rooms, kind, counted|:
                    counted <- counted + 1 if Ints::at(rooms.kind, scan) == kind
                    scan <- scan + 1
                if counted > 0:
                    share: f64 = mix(kind).f64() / counted.f64()
                    fill: mutable i64 = 0
                    while fill < rooms.count |fill, rooms, kind, share|:
                        if Ints::at(rooms.kind, fill) == kind:
                            rooms.weight[fill.usize()] <- share
                        fill <- fill + 1
                kind <- kind + 1
            return rooms

    # Do what a room does, to `cells`, in place.
    def enter(rooms: InTheDarkRooms&, index: i64, cells: mutable darray[i64]&, colours: i64):
        can Abort.Panic:
            kind: i64 = Ints::at(rooms.kind, index)
            lamp: i64 = Ints::at(rooms.lamp, index)
            other: i64 = Ints::at(rooms.other, index)
            if kind == PAINT:
                Ints::put(cells, lamp, other)
            elif kind == TURN:
                Ints::put(cells, lamp, ((get cells[lamp.usize()] else 0) + 1) % colours)
            elif kind == SWAP:
                held: i64 = get cells[lamp.usize()] else 0
                Ints::put(cells, lamp, get cells[other.usize()] else 0)
                Ints::put(cells, other, held)
            else:
                Ints::put(cells, lamp, get cells[other.usize()] else 0)

    # ------------------------------------------------------------
    # Walks
    #
    # A walk is stored as three parallel arrays rather than as indices into the
    # vocabulary, because _deal creates paint rooms directly when it closes a chain
    # by hand and those are not drawn from the table.
    # ------------------------------------------------------------

    struct InTheDarkWalk:
        kind: mutable darray[i64]
        lamp: mutable darray[i64]
        other: mutable darray[i64]
        count: mutable i64

    def in_the_dark_walk(depth: i64) -> InTheDarkWalk:
        can Memory.Allocate, Abort.Panic:
            walk: mutable InTheDarkWalk = zeroed
            walk.kind <- Ints::zeros(depth + 1)
            walk.lamp <- Ints::zeros(depth + 1)
            walk.other <- Ints::zeros(depth + 1)
            walk.count <- 0
            return walk

    def apply_step(walk: InTheDarkWalk&, index: i64, cells: mutable darray[i64]&, colours: i64):
        can Abort.Panic:
            kind: i64 = Ints::at(walk.kind, index)
            lamp: i64 = Ints::at(walk.lamp, index)
            other: i64 = Ints::at(walk.other, index)
            if kind == PAINT:
                Ints::put(cells, lamp, other)
            elif kind == TURN:
                Ints::put(cells, lamp, ((get cells[lamp.usize()] else 0) + 1) % colours)
            elif kind == SWAP:
                held: i64 = get cells[lamp.usize()] else 0
                Ints::put(cells, lamp, get cells[other.usize()] else 0)
                Ints::put(cells, other, held)
            else:
                Ints::put(cells, lamp, get cells[other.usize()] else 0)

    # The colours the lamps end up on, having started at `start`.
    def walk_run(walk: InTheDarkWalk&, start: darray[i64], lamps: i64, colours: i64, cells: mutable darray[i64]&):
        can Abort.Panic:
            copy: mutable i64 = 0
            while copy < lamps |copy, lamps, cells, start|:
                Ints::put(cells, copy, Ints::at(start, copy))
                copy <- copy + 1
            index: mutable i64 = 0
            while index < walk.count |index, walk, cells, colours|:
                apply_step(walk, index, cells, colours)
                index <- index + 1

    # Follow `lamp`'s colour backwards: how far back it is pinned, and how much
    # work happened on the way. NOT a simulation -- a dependency chain. Returns the
    # distance in `back_out` (-1 when no room pins it, which makes the question a
    # coin that must not be asked) and the work count in `work_out`.
    def trace(walk: InTheDarkWalk&, from_index: i64, lamp: i64, back_out: mutable i64&, work_out: mutable i64&):
        can Abort.Panic:
            slot: mutable i64 = lamp
            work: mutable i64 = 0
            back_out <- -1
            pinned_at: mutable i64 = -1
            step: mutable i64 = 0
            total: i64 = walk.count - from_index
            while step < total and pinned_at < 0 |step, total, walk, from_index, slot, work, pinned_at|:
                index: i64 = walk.count - 1 - step
                kind: i64 = Ints::at(walk.kind, index)
                room_lamp: i64 = Ints::at(walk.lamp, index)
                room_other: i64 = Ints::at(walk.other, index)
                if kind == PAINT and room_lamp == slot:
                    pinned_at <- step + 1
                elif kind == TURN and room_lamp == slot:
                    work <- work + 1
                elif kind == COPY and room_lamp == slot:
                    slot <- room_other
                    work <- work + 1
                elif kind == SWAP and (slot == room_lamp or slot == room_other):
                    slot <- room_other if slot == room_lamp else room_lamp
                    work <- work + 1
                step <- step + 1
            back_out <- pinned_at
            work_out <- work

    # Every colour `lamp` could still finish on, over all starting arrangements.
    # The slow, obvious reading of the question itd_trace answers in one pass --
    # kept for the same reason the reference keeps it: the sweep holds the two
    # against each other, and a singleton here is exactly a chain that reached a
    # paint there. Returns a bitmask over colours.
    def belief(walk: InTheDarkWalk&, lamp: i64, lamps: i64, colours: i64, cells: mutable darray[i64]&) -> i64:
        can Abort.Panic:
            seen: mutable i64 = 0
            arrangements: mutable i64 = 1
            power: mutable i64 = 0
            while power < lamps |power, lamps, colours, arrangements|:
                arrangements <- arrangements * colours
                power <- power + 1
            value: mutable i64 = 0
            while value < arrangements |value, arrangements, walk, lamp, lamps, colours, cells, seen|:
                place: mutable i64 = 0
                divisor: mutable i64 = 1
                while place < lamps |place, lamps, colours, cells, value, divisor|:
                    Ints::put(cells, place, (value / divisor) % colours)
                    divisor <- divisor * colours
                    place <- place + 1
                index: mutable i64 = 0
                while index < walk.count |index, walk, cells, colours|:
                    apply_step(walk, index, cells, colours)
                    index <- index + 1
                bit: mutable i64 = 1
                shift: mutable i64 = 0
                while shift < (get cells[lamp.usize()] else 0) |shift, bit|:
                    bit <- bit * 2
                    shift <- shift + 1
                seen <- seen | bit
                value <- value + 1
            return seen

    # Move the live chains back through one room, in place. `live` is a flag array
    # over lamps: the lamps the unanswered questions are resting on at this point
    # in the walk, read from the end.
    def backwards(kind: i64, lamp: i64, other: i64, live: mutable darray[i64]&):
        can Abort.Panic:
            if kind == PAINT:
                Ints::put(live, lamp, 0)
            elif kind == COPY and (get live[lamp.usize()] else 0) == 1:
                Ints::put(live, lamp, 0)
                Ints::put(live, other, 1)
            elif kind == SWAP:
                here: bool = (get live[lamp.usize()] else 0) == 1
                there: bool = (get live[other.usize()] else 0) == 1
                if here != there:
                    Ints::put(live, lamp if here else other, 0)
                    Ints::put(live, other if here else lamp, 1)

    # One room drawn from the vocabulary: never painting a lamp a question is
    # resting on when `use_spare`, and never repeating `avoid`.
    #
    # `avoid` is the room that will FOLLOW this one in the finished walk, and
    # refusing to repeat it is what stops a swap being undone by the very next
    # room. Such a pair is a no-op that itd_trace nonetheless counts as two rooms
    # of work, so leaving them in would let the work axis be paid in coin it did
    # not earn.
    def draw_room(rooms: mutable InTheDarkRooms&, rng: mutable MT19937&, live: mutable darray[i64]&, use_spare: bool, avoid: i64, allowed: mutable darray[i64]&) -> i64:
        can Abort.Panic:
            count: mutable i64 = 0
            running: mutable f64 = 0.0
            index: mutable i64 = 0
            while index < rooms.count |index, rooms, live, use_spare, avoid, allowed, count, running|:
                skip: mutable bool = index == avoid
                if use_spare and Ints::at(rooms.kind, index) == PAINT:
                    skip <- true if Ints::at_ref(live, Ints::at(rooms.lamp, index)) == 1
                if not skip:
                    # The cumulative sum is a running total in list order, so the
                    # floating-point rounding is part of the answer.
                    running <- running + (get rooms.weight[index.usize()] else 0.0)
                    rooms.cum[count.usize()] <- running
                    Ints::put(allowed, count, index)
                    count <- count + 1
                index <- index + 1
            0 return if count <= 0
            pick: i64 = py_choices_index(rng, rooms.cum, count)
            return Ints::at_ref(allowed, pick)

    # ------------------------------------------------------------
    # Dealing
    # ------------------------------------------------------------

    struct InTheDarkRound:
        lamps: mutable i64
        colours: mutable i64
        walk: mutable InTheDarkWalk
        start: mutable darray[i64]
        asked: mutable darray[i64]
        answers: mutable darray[i64]
        asks: mutable i64
        needed: mutable i64
        work: mutable f64

    # One round, built from the END so its floor is certain.
    #
    # Dealing forwards and keeping walks that happened to bury their answers deep
    # enough does not work: the reference measured the median walk pinning its
    # weakest question four rooms from the end against a floor of twenty, and seven
    # deals in eight asking about a lamp no room ever pinned. Both are the wrong
    # tail to sample from. So the walk is laid backwards, every question starts
    # resting on the lamp it asks about, and the questions are carried back through
    # each room as it is laid.
    def deal(grade: InTheDarkGrade, rng: mutable MT19937&, rooms: mutable InTheDarkRooms&, scratch: mutable darray[i64]&, live: mutable darray[i64]&, allowed: mutable darray[i64]&) -> InTheDarkRound:
        can Memory.Allocate, Abort.Panic:
            round: mutable InTheDarkRound = zeroed
            round.lamps <- grade.lamps
            round.colours <- grade.colours
            round.asks <- grade.asks
            round.asked <- py_sample_range(rng, 0, grade.lamps - 1, grade.asks)
            round.walk <- in_the_dark_walk(grade.depth)

            clear: mutable i64 = 0
            while clear < grade.lamps |clear, grade, live|:
                Ints::put(live, clear, 0)
                clear <- clear + 1
            mark: mutable i64 = 0
            while mark < grade.asks |mark, grade, live, round|:
                Ints::put(live, Ints::at(round.asked, mark), 1)
                mark <- mark + 1

            # Laid from the LAST room backwards.
            laid_kind: mutable darray[i64] = Ints::zeros(grade.depth + 1)
            laid_lamp: mutable darray[i64] = Ints::zeros(grade.depth + 1)
            laid_other: mutable darray[i64] = Ints::zeros(grade.depth + 1)
            previous: mutable i64 = -1

            step: mutable i64 = 0
            while step < grade.depth |step, grade, rng, rooms, live, allowed, laid_kind, laid_lamp, laid_other, previous|:
                left: i64 = grade.depth - step
                live_n: mutable i64 = 0
                count_lamp: mutable i64 = 0
                while count_lamp < grade.lamps |count_lamp, grade, live, live_n|:
                    live_n <- live_n + 1 if Ints::at_ref(live, count_lamp) == 1
                    count_lamp <- count_lamp + 1

                kind: mutable i64 = 0
                lamp: mutable i64 = 0
                other: mutable i64 = 0
                if left <= live_n:
                    # Only as many rooms left as questions still open: close one by
                    # hand, which is what makes every question answerable rather
                    # than merely likely to be. min(live) is the lowest live lamp.
                    lowest: mutable i64 = -1
                    scan: mutable i64 = 0
                    while scan < grade.lamps |scan, grade, live, lowest|:
                        if lowest < 0 and Ints::at_ref(live, scan) == 1:
                            lowest <- scan
                        scan <- scan + 1
                    kind <- PAINT
                    lamp <- 0 if lowest < 0 else lowest
                    other <- py_randbelow(rng, grade.colours.u64()).i64()
                    previous <- -1
                else:
                    deep: bool = step < grade.floor - 1
                    index: i64 = draw_room(rooms, rng, live, deep, previous, allowed)
                    kind <- Ints::at(rooms.kind, index)
                    lamp <- Ints::at(rooms.lamp, index)
                    other <- Ints::at(rooms.other, index)
                    previous <- index

                Ints::put(&laid_kind, step, kind)
                Ints::put(&laid_lamp, step, lamp)
                Ints::put(&laid_other, step, other)
                backwards(kind, lamp, other, live)
                step <- step + 1

            # reversed(laid): the walk runs first room to last.
            place: mutable i64 = 0
            while place < grade.depth |place, grade, round, laid_kind, laid_lamp, laid_other|:
                source: i64 = grade.depth - 1 - place
                Ints::put(&round.walk.kind, place, Ints::at(laid_kind, source))
                Ints::put(&round.walk.lamp, place, Ints::at(laid_lamp, source))
                Ints::put(&round.walk.other, place, Ints::at(laid_other, source))
                place <- place + 1
            round.walk.count <- grade.depth

            # The construction proposes and trace disposes: nothing above is
            # trusted, and the numbers are measured off the finished walk.
            needed: mutable i64 = 0
            work_total: mutable i64 = 0
            question: mutable i64 = 0
            while question < grade.asks |question, grade, round, needed, work_total|:
                back: mutable i64 = 0
                work: mutable i64 = 0
                trace(&round.walk, 0, Ints::at(round.asked, question), &back, &work)
                needed <- back if question == 0 or back < needed else needed
                work_total <- work_total + work
                question <- question + 1
            round.needed <- needed
            round.work <- work_total.f64() / grade.asks.f64()

            round.start <- Ints::zeros(grade.lamps + 1)
            draw: mutable i64 = 0
            while draw < grade.lamps |draw, grade, round, rng|:
                Ints::put(&round.start, draw, py_randbelow(rng, grade.colours.u64()).i64())
                draw <- draw + 1

            walk_run(&round.walk, round.start, grade.lamps, grade.colours, scratch)
            round.answers <- Ints::zeros(grade.asks + 1)
            answer: mutable i64 = 0
            while answer < grade.asks |answer, grade, round, scratch|:
                Ints::put(&round.answers, answer, get scratch[Ints::at(round.asked, answer).usize()] else 0)
                answer <- answer + 1
            return round

    # A round at `level_number`, at or above that rung's floors.
    #
    # The floor needs no searching for -- itd_deal lays every walk so that it holds
    # -- so the only axis left to shop for is the work. Failing to meet it, the
    # hardest-working round of the lot is handed back rather than the first seen,
    # which keeps the junior axis honest without letting it outrank the floor.
    def generate(level_number: i64, seed: i64, attempts_in: i64, scratch: mutable darray[i64]&, live: mutable darray[i64]&, allowed: mutable darray[i64]&) -> InTheDarkRound:
        can Memory.Allocate, Abort.Panic:
            grade: mutable InTheDarkGrade = grade_at(level_number)
            rooms: mutable InTheDarkRooms = vocabulary(grade.lamps, grade.colours)
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            attempts: i64 = 1 if attempts_in < 1 else attempts_in

            best: mutable InTheDarkRound = zeroed
            have_best: mutable bool = false
            attempt: mutable i64 = 0
            while attempt < attempts |attempt, attempts, grade, rng, rooms, scratch, live, allowed, best, have_best|:
                got: InTheDarkRound = deal(grade, &rng, &rooms, scratch, live, allowed)
                got return if got.work >= grade.work
                if not have_best or got.work > best.work:
                    best <- got
                    have_best <- true
                attempt <- attempt + 1
            return best
