# Stateful common-v1 adapter for Sudoku.
#
# The Sudoku kernel owns generation, uniqueness, rating, and the solution. This
# adapter owns only the state that must survive across ABI calls: the current
# filled grid, immutable givens, pencil masks, cursor, timing, and score. The
# generator's darrays are copied out of a temporary region before it is
# destroyed, so a later render or key event never follows a dangling puzzle.

module SudokuGame:

    const MAX_CELLS: i64 = Sudoku::MOST_CELLS

    const PHASE_READY: i64 = 0
    const PHASE_SOLVING: i64 = 1
    const PHASE_SOLVED: i64 = 2
    const PHASE_DONE: i64 = 3

    const ACTION_START: i64 = 0
    const ACTION_UP: i64 = 1
    const ACTION_DOWN: i64 = 2
    const ACTION_LEFT: i64 = 3
    const ACTION_RIGHT: i64 = 4
    const ACTION_WRITE: i64 = 5
    const ACTION_ERASE: i64 = 6
    const ACTION_PENCIL: i64 = 7

    const INFO_PHASE: i64 = 0
    const INFO_RUNG: i64 = 1
    const INFO_TRIAL: i64 = 2
    const INFO_TOTAL_TRIALS: i64 = 3
    const INFO_BOX: i64 = 4
    const INFO_SIZE: i64 = 5
    const INFO_CELLS: i64 = 6
    const INFO_CURSOR: i64 = 7
    const INFO_PENCIL: i64 = 8
    const INFO_MISTAKES: i64 = 9
    const INFO_VERDICT: i64 = 10
    const INFO_SHOW_CLASHES: i64 = 11
    const INFO_ADAPTIVE: i64 = 12
    const INFO_BLANKS: i64 = 13
    const INFO_HAS_PUZZLE: i64 = 14
    const INFO_TIER: i64 = 15
    const INFO_GUESSES: i64 = 16
    const INFO_SOLVED: i64 = 17
    const INFO_SLIPS: i64 = 18
    const INFO_BEST_RUNG: i64 = 19
    const INFO_SECONDS: i64 = 20
    const INFO_CLEAN: i64 = 21
    const INFO_TOTAL_SECONDS: i64 = 22

    const VALUE_GIVEN: i64 = 0
    const VALUE_SOLUTION: i64 = 1
    const VALUE_FILLED: i64 = 2
    const VALUE_MARKS: i64 = 3

    const MESSAGE_DEFAULT: i64 = 0
    const MESSAGE_PENCIL: i64 = 1
    const MESSAGE_WRITING: i64 = 2
    const MESSAGE_GIVEN: i64 = 3
    const MESSAGE_FULL: i64 = 4

    struct SudokuRun:
        rng: mutable MT19937
        start_rung: mutable i64
        options_row: mutable i64
        options_from_hub: mutable bool
        options_draft: mutable i64[4]
        rung: mutable i64
        total_trials: mutable i64
        show_clashes: mutable bool
        adaptive: mutable bool
        trial: mutable i64
        box: mutable i64
        size: mutable i64
        cells: mutable i64
        tier: mutable i64
        guesses: mutable i64
        phase: mutable i64
        verdict: mutable i64
        cursor: mutable i64
        pencil: mutable bool
        mistakes: mutable i64
        started_at_ms: mutable i64
        last_time_ms: mutable i64
        solved: mutable i64
        slips: mutable i64
        best_rung: mutable i64
        clean: mutable i64
        total_time_ms: mutable i64
        has_puzzle: mutable bool
        message_kind: mutable i64
        givens: mutable i64[MAX_CELLS]
        solution: mutable i64[MAX_CELLS]
        filled: mutable i64[MAX_CELLS]
        marks: mutable i64[MAX_CELLS]

    def clamp_rung(value: i64) -> i64:
        can Abort.Panic:
            return 1 if value < 1 else (Sudoku::GRADE_COUNT if value > Sudoku::GRADE_COUNT else value)

    def clamp_trials(value: i64) -> i64:
        can Abort.Panic:
            return 1 if value < 1 else value

    def allowed_trials(value: i64) -> bool:
        can Abort.Panic:
            return value == 1 or value == 2 or value == 3 or value == 5 or value == 8 or value == 10

    def allowed_flag(value: i64) -> bool:
        can Abort.Panic:
            return value == 0 or value == 1

    def clear_arrays(run: mutable SudokuRun&):
        can Abort.Panic:
            for cell in 0..<MAX_CELLS |cell, run|:
                run.givens[cell.usize()] <- 0
                run.solution[cell.usize()] <- 0
                run.filled[cell.usize()] <- 0
                run.marks[cell.usize()] <- 0

    def clear_current(run: mutable SudokuRun&):
        can Abort.Panic:
            for cell in 0..<MAX_CELLS |cell, run|:
                run.givens[cell.usize()] <- 0
                run.solution[cell.usize()] <- 0
                run.filled[cell.usize()] <- 0
                run.marks[cell.usize()] <- 0
            run.box <- 0
            run.size <- 0
            run.cells <- 0
            run.tier <- 0
            run.guesses <- 0
            run.cursor <- 0
            run.pencil <- false
            run.has_puzzle <- false

    def copy_puzzle(run: mutable SudokuRun&, puzzle: mutable Sudoku::SudokuPuzzle&):
        can Abort.Panic:
            run.box <- puzzle.box
            run.size <- puzzle.box * puzzle.box
            run.cells <- puzzle.cells
            run.tier <- puzzle.tier
            run.guesses <- puzzle.guesses
            for cell in 0..<MAX_CELLS |cell, run, puzzle|:
                given: i64 = Ints::at_ref(&puzzle.givens, cell) if cell < puzzle.cells else 0
                answer: i64 = Ints::at_ref(&puzzle.solution, cell) if cell < puzzle.cells else 0
                run.givens[cell.usize()] <- given
                run.solution[cell.usize()] <- answer
                run.filled[cell.usize()] <- given
                run.marks[cell.usize()] <- 0
            run.cursor <- 0
            for cell in 0..<run.cells |cell, run|:
                if run.givens[cell.usize()] == 0:
                    run.cursor <- cell
                    break
            run.pencil <- false
            run.has_puzzle <- run.cells > 0

    # The source UI calls the Python Random stream once for every deal and
    # passes that draw into sudoku.generate. Keeping this draw outside the
    # generator is what makes successive browser trials match CPython.
    def deal_trial(run: mutable SudokuRun&):
        can Memory.Allocate, Abort.Panic:
            seed: i64 = py_randbelow(&run.rng, 1073741824.u64()).i64()
            # Sudoku::generate owns a bounded region per rejection-sampling
            # attempt. This outer region only holds the copied result and the
            # fixed controller's source-facing scalar values.
            region deal_scratch(8 * 1024 * 1024):
                in deal_scratch:
                    puzzle: mutable Sudoku::SudokuPuzzle = Sudoku::generate(run.rung, seed, 0)
                    copy_puzzle(run, &puzzle)
                destroy deal_scratch
            run.verdict <- -1
            run.message_kind <- MESSAGE_DEFAULT
            run.mistakes <- 0
            run.started_at_ms <- 0
            run.last_time_ms <- 0
            run.phase <- PHASE_SOLVING if run.has_puzzle else PHASE_DONE

    def next_trial(run: mutable SudokuRun&, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            if run.trial >= run.total_trials:
                run.phase <- PHASE_DONE
                return
            run.trial <- run.trial + 1
            deal_trial(run)
            run.started_at_ms <- now_ms
            run.last_time_ms <- 0

    def reset(run: mutable SudokuRun&):
        can Abort.Panic:
            run.rung <- run.start_rung
            run.trial <- 0
            run.phase <- PHASE_READY
            run.verdict <- -1
            run.cursor <- 0
            run.pencil <- false
            run.mistakes <- 0
            run.started_at_ms <- 0
            run.last_time_ms <- 0
            run.solved <- 0
            run.slips <- 0
            run.best_rung <- 0
            run.clean <- 0
            run.total_time_ms <- 0
            run.message_kind <- MESSAGE_DEFAULT
            clear_current(run)

    def initialize(run: mutable SudokuRun&, start_rung: i64, total_trials: i64,
                   show_clashes: bool, adaptive: bool, seed: i64):
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            run.rng <- rng
            run.options_row <- -1
            run.options_from_hub <- false
            run.start_rung <- clamp_rung(start_rung)
            run.rung <- run.start_rung
            run.total_trials <- clamp_trials(total_trials)
            run.show_clashes <- show_clashes
            run.adaptive <- adaptive
            run.trial <- 0
            run.box <- 0
            run.size <- 0
            run.cells <- 0
            run.tier <- 0
            run.guesses <- 0
            run.phase <- PHASE_READY
            run.verdict <- -1
            run.cursor <- 0
            run.pencil <- false
            run.mistakes <- 0
            run.started_at_ms <- 0
            run.last_time_ms <- 0
            run.solved <- 0
            run.slips <- 0
            run.best_rung <- 0
            run.clean <- 0
            run.total_time_ms <- 0
            run.has_puzzle <- false
            run.message_kind <- MESSAGE_DEFAULT
            clear_arrays(run)

    def start_run(run: mutable SudokuRun&, now_ms: i64):
        can Memory.Allocate, Abort.Panic:
            reset(run)
            next_trial(run, now_ms)

    def move_cursor(run: mutable SudokuRun&, dr: i64, dc: i64):
        can Abort.Panic:
            return if run.phase != PHASE_SOLVING or not run.has_puzzle
            row: i64 = run.cursor / run.size
            col: i64 = run.cursor % run.size
            next_row: i64 = row + dr
            next_col: i64 = col + dc
            return if next_row < 0 or next_row >= run.size or next_col < 0 or next_col >= run.size
            run.cursor <- next_row * run.size + next_col

    def is_given(run: SudokuRun&, cell: i64) -> bool:
        can Abort.Panic:
            return cell >= 0 and cell < run.cells and run.givens[cell.usize()] != 0

    def settle(run: mutable SudokuRun&, now_ms: i64):
        can Abort.Panic:
            full: mutable bool = true
            for cell in 0..<run.cells |cell, run, full|:
                full <- false if run.filled[cell.usize()] == 0
            return if not full
            correct: mutable bool = true
            for cell in 0..<run.cells |cell, run, correct|:
                correct <- false if run.filled[cell.usize()] != run.solution[cell.usize()]
            if not correct:
                run.message_kind <- MESSAGE_FULL
                return
            elapsed: mutable i64 = now_ms - run.started_at_ms
            elapsed <- 0 if elapsed < 0
            run.last_time_ms <- elapsed
            run.solved <- run.solved + 1
            run.slips <- run.slips + run.mistakes
            run.clean <- run.clean + 1 if run.mistakes == 0
            run.total_time_ms <- run.total_time_ms + elapsed
            run.best_rung <- run.rung if run.rung > run.best_rung
            run.verdict <- 1 if run.mistakes == 0 else 0
            run.message_kind <- MESSAGE_DEFAULT
            if run.adaptive:
                if run.mistakes == 0:
                    run.rung <- clamp_rung(run.rung + 1)
                elif run.mistakes > 4:
                    run.rung <- clamp_rung(run.rung - 1)
            run.phase <- PHASE_SOLVED

    def write_value(run: mutable SudokuRun&, value: i64, now_ms: i64) -> i64:
        can Abort.Panic:
            return 2 if run.phase != PHASE_SOLVING or not run.has_puzzle
            return 2 if value < 1 or value > run.size
            if is_given(run, run.cursor):
                run.message_kind <- MESSAGE_GIVEN
                return 1
            if run.pencil:
                run.marks[run.cursor.usize()] <- run.marks[run.cursor.usize()] ^ (1 << (value - 1))
                return 1
            held: mutable i64 = value
            held <- 0 if run.filled[run.cursor.usize()] == value
            run.filled[run.cursor.usize()] <- held
            if held != 0:
                run.marks[run.cursor.usize()] <- 0
                run.mistakes <- run.mistakes + 1 if held != run.solution[run.cursor.usize()]
            settle(run, now_ms)
            return 1

    def erase(run: mutable SudokuRun&) -> i64:
        can Abort.Panic:
            return 2 if run.phase != PHASE_SOLVING or not run.has_puzzle
            return 2 if is_given(run, run.cursor)
            if run.pencil:
                run.marks[run.cursor.usize()] <- 0
            else:
                run.filled[run.cursor.usize()] <- 0
            return 1

    def apply(run: mutable SudokuRun&, action: i64, value: i64, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            if action == ACTION_START:
                if run.phase == PHASE_READY or run.phase == PHASE_DONE:
                    start_run(run, now_ms)
                    return 1
                if run.phase == PHASE_SOLVED:
                    next_trial(run, now_ms)
                    return 1
                return 2
            if action == ACTION_UP:
                return 2 if run.phase != PHASE_SOLVING
                move_cursor(run, -1, 0)
                return 1
            if action == ACTION_DOWN:
                return 2 if run.phase != PHASE_SOLVING
                move_cursor(run, 1, 0)
                return 1
            if action == ACTION_LEFT:
                return 2 if run.phase != PHASE_SOLVING
                move_cursor(run, 0, -1)
                return 1
            if action == ACTION_RIGHT:
                return 2 if run.phase != PHASE_SOLVING
                move_cursor(run, 0, 1)
                return 1
            if action == ACTION_WRITE:
                return write_value(run, value, now_ms)
            if action == ACTION_ERASE:
                return erase(run)
            if action == ACTION_PENCIL:
                return 2 if run.phase != PHASE_SOLVING
                run.pencil <- not run.pencil
                return 1
            return -6

    def blanks(run: SudokuRun&) -> i64:
        can Abort.Panic:
            count: mutable i64 = 0
            for cell in 0..<run.cells |cell, run, count|:
                count <- count + 1 if run.filled[cell.usize()] == 0
            return count

    def info(run: SudokuRun&, field: i64) -> i64:
        can Abort.Panic:
            if field == INFO_PHASE: return run.phase
            if field == INFO_RUNG: return run.rung
            if field == INFO_TRIAL: return run.trial
            if field == INFO_TOTAL_TRIALS: return run.total_trials
            if field == INFO_BOX: return run.box
            if field == INFO_SIZE: return run.size
            if field == INFO_CELLS: return run.cells
            if field == INFO_CURSOR: return run.cursor
            if field == INFO_PENCIL: return 1 if run.pencil else 0
            if field == INFO_MISTAKES: return run.mistakes
            if field == INFO_VERDICT: return run.verdict
            if field == INFO_SHOW_CLASHES: return 1 if run.show_clashes else 0
            if field == INFO_ADAPTIVE: return 1 if run.adaptive else 0
            if field == INFO_BLANKS: return blanks(run)
            if field == INFO_HAS_PUZZLE: return 1 if run.has_puzzle else 0
            if field == INFO_TIER: return run.tier
            if field == INFO_GUESSES: return run.guesses
            if field == INFO_SOLVED: return run.solved
            if field == INFO_SLIPS: return run.slips
            if field == INFO_BEST_RUNG: return run.best_rung
            if field == INFO_SECONDS: return run.last_time_ms / 1000
            if field == INFO_CLEAN: return run.clean
            if field == INFO_TOTAL_SECONDS: return run.total_time_ms / 1000
            return -1

    # This accessor is intentionally diagnostic: it exposes no new production
    # drawing or input path, and the browser does not call it. Focused smoke
    # tests use it to verify that the controller copied the source puzzle and
    # that the solution is not substituted by a shell-side fixture.
    def value(run: SudokuRun&, field: i64, at: i64) -> i64:
        can Abort.Panic:
            return -1 if at < 0 or at >= run.cells
            if field == VALUE_GIVEN: return run.givens[at.usize()]
            if field == VALUE_SOLUTION: return run.solution[at.usize()]
            if field == VALUE_FILLED: return run.filled[at.usize()]
            if field == VALUE_MARKS: return run.marks[at.usize()]
            return -1

    def append_grade(out: mutable dstr&, rung: i64):
        can Memory.Allocate, Abort.Panic:
            if rung == 1:
                dstr_append_cstr(out, "first squares")
            elif rung == 2:
                dstr_append_cstr(out, "gentle")
            elif rung == 3:
                dstr_append_cstr(out, "easy")
            elif rung == 4:
                dstr_append_cstr(out, "moderate")
            elif rung == 5:
                dstr_append_cstr(out, "tricky")
            elif rung == 6:
                dstr_append_cstr(out, "hard")
            elif rung == 7:
                dstr_append_cstr(out, "fiendish")
            elif rung == 8:
                dstr_append_cstr(out, "diabolical")
            elif rung == 9:
                dstr_append_cstr(out, "the sixteen")
            elif rung == 10:
                dstr_append_cstr(out, "sixteen hard")
            elif rung == 11:
                dstr_append_cstr(out, "inhuman")
            else:
                dstr_append_cstr(out, "superhuman")

    def append_technique(out: mutable dstr&, tier: i64):
        can Memory.Allocate, Abort.Panic:
            if tier == Sudoku::TIER_NAKED_SINGLE:
                dstr_append_cstr(out, "naked single")
            elif tier == Sudoku::TIER_HIDDEN_SINGLE:
                dstr_append_cstr(out, "hidden single")
            elif tier == Sudoku::TIER_LOCKED:
                dstr_append_cstr(out, "locked candidates")
            elif tier == Sudoku::TIER_NAKED_SUBSET:
                dstr_append_cstr(out, "naked subset")
            elif tier == Sudoku::TIER_HIDDEN_SUBSET:
                dstr_append_cstr(out, "hidden subset")
            elif tier == Sudoku::TIER_FISH:
                dstr_append_cstr(out, "fish")
            else:
                dstr_append_cstr(out, "search")

    def append_message(out: mutable dstr&, run: SudokuRun&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == PHASE_READY:
                dstr_append_cstr(out, "Press Space to start")
                return
            if run.phase == PHASE_SOLVING:
                if run.message_kind == MESSAGE_PENCIL:
                    dstr_append_cstr(out, "Pencilling")
                elif run.message_kind == MESSAGE_WRITING:
                    dstr_append_cstr(out, "Writing")
                elif run.message_kind == MESSAGE_GIVEN:
                    dstr_append_cstr(out, "That one came with the puzzle")
                elif run.message_kind == MESSAGE_FULL:
                    dstr_append_cstr(out, "Full, but not right yet")
                else:
                    append_grade(out, run.rung)
                    dstr_append_cstr(out, " — ")
                    append_technique(out, run.tier)
                    dstr_append_cstr(out, ", ")
                    dstr_append_i64(out, blanks(run))
                    dstr_append_cstr(out, " to fill")
                dstr_append_cstr(out, "     puzzle ")
                dstr_append_i64(out, run.trial)
                dstr_append_cstr(out, "/")
                dstr_append_i64(out, run.total_trials)
                dstr_append_cstr(out, "   ")
                dstr_append_i64(out, blanks(run))
                dstr_append_cstr(out, " left")
                if run.pencil:
                    dstr_append_cstr(out, "     pencil")
                return
            if run.phase == PHASE_SOLVED:
                dstr_append_cstr(out, "Solved in ")
                dstr_append_i64(out, run.last_time_ms / 1000)
                dstr_append_cstr(out, "s")
                if run.mistakes == 0:
                    dstr_append_cstr(out, ", no slips")
                else:
                    dstr_append_cstr(out, ", ")
                    dstr_append_i64(out, run.mistakes)
                    dstr_append_cstr(out, " slips")
                return
            dstr_append_i64(out, run.solved)
            dstr_append_cstr(out, " solved, ")
            dstr_append_i64(out, run.slips)
            dstr_append_cstr(out, " slips, highest rung ")
            dstr_append_i64(out, run.best_rung)

    def render(run: SudokuRun&, black_background: bool, width: f64, height: f64,
               list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            filled: mutable darray[i64] = Ints::zeros(MAX_CELLS)
            givens: mutable darray[i64] = Ints::zeros(MAX_CELLS)
            marks: mutable darray[i64] = Ints::zeros(MAX_CELLS)
            for cell in 0..<MAX_CELLS |cell, run, filled, givens, marks|:
                Ints::put(&filled, cell, run.filled[cell.usize()])
                Ints::put(&givens, cell, run.givens[cell.usize()])
                Ints::put(&marks, cell, run.marks[cell.usize()])
            message: mutable dstr = []
            append_message(&message, run)
            verdict_text: mutable dstr = []
            if run.verdict >= 0:
                dstr_append_sview(&verdict_text, bytes_view(message))
            sx: f64 = width / Display::REFERENCE_WIDTH
            sy: f64 = height / Display::REFERENCE_HEIGHT
            paint: mutable SceneSudoku::SudokuPaint = SceneSudoku::paint_of(
                black_background, width, height, sx, sy)
            SceneSudoku::render(list, &paint, &filled, &givens, &marks,
                run.box, run.phase, run.cursor, run.show_clashes, run.pencil,
                run.trial, run.total_trials, run.has_puzzle,
                bytes_view(message), run.verdict, bytes_view(verdict_text))

    def advance(run: SudokuRun&) -> i64:
        can Abort.Panic:
            return 2
