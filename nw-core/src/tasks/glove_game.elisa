include "./glove.elisa"
include "./drshape_audio.elisa"
include "../scene_lens.elisa"

# The Glove screen's run of innings, on ClockedTask's clock: every advance
# steps the inning in hundred-and-twentieths of a second with the agent's port
# for that frame if one came, else the first of the held keys in the
# reference's order -- Up or W, Down or S, Left or A, Right or D. The mouse,
# moved or dragged, carries the glove's picture with it.
module GloveGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = Glove::PORTS
    const FEEDBACK: f64 = 2.5

    struct Session:
        rng: mutable MT19937
        start_rung: mutable i64
        total: mutable i64
        adaptive: mutable bool
        rung: mutable i64
        trial: mutable i64
        wins: mutable i64
        best_rung: mutable i64
        phase: mutable i64
        time: mutable f64
        deadline: mutable f64
        run: mutable Glove::Run
        owner: mutable Arena
        held_keys: mutable i64
        pulse: mutable i64
        pointed: mutable bool
        mouse_x: mutable f64
        mouse_y: mutable f64

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64) -> Session:
        rng: mutable MT19937 = zeroed
        magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
        mt_seed_int(&rng, magnitude)
        initial: i64 = Glove::grade(rung).rung
        return Session{rng: rng, start_rung: initial, total: trials, adaptive: adaptive,
            rung: initial, trial: 0, wins: 0, best_rung: 0, phase: READY, time: 0.0,
            deadline: 0.0, run: zeroed, owner: zeroed, held_keys: 0, pulse: -1, pointed: false, mouse_x: 0.0, mouse_y: 0.0}

    def close(session: mutable Session&):
        can Abort.Panic, Memory.Release:
            session.run <- zeroed
            session.phase <- READY
            session.held_keys <- 0
            session.pulse <- -1
            arena_free(&session.owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(trials: i64) -> bool:
        return trials == 1 or trials == 3 or trials == 5 or trials == 10 or trials == 20

    def reconfigure(session: mutable Session&, rung: i64, trials: i64, adaptive: bool) -> bool:
        can Abort.Panic, Memory.Release:
            return false if session.phase != READY and session.phase != DONE
            return false if not allowed_rung(rung) or not allowed_total(trials)
            close(session) can Global{Read,Write}
            session.start_rung <- rung
            session.rung <- rung
            session.total <- trials
            session.adaptive <- adaptive
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            return true

    def next_trial(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            session.time <- now
            session.pulse <- -1
            if session.trial >= session.total:
                session.phase <- DONE
                return true
            region scratch(16777216):
                in scratch:
                    g: Glove::Game = Glove::deal(session.rung, &session.rng)
                    if not g.valid:
                        session.phase <- DONE
                        return false
                    keys: i64 = session.held_keys
                    close(session) can Global{Read,Write}
                    session.held_keys <- keys
                    owner: mutable Arena& = &session.owner
                    in owner:
                        session.run <- Glove::begin(g)
            session.trial <- session.trial + 1
            session.phase <- PLAYING
            return true

    def valid_time(session: Session&, now: f64) -> bool:
        return now >= session.time and now <= 9007199254740.0

    def start(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if (session.phase != READY and session.phase != DONE) or session.total < 1
            return false if not valid_time(session, now)
            session.rung <- session.start_rung
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            return next_trial(session, now) can Global{Read,Write}

    # Room for a note a step, in the session's arena, before steps push them.
    def reserve_notes(session: mutable Session&, more: i64):
        can Abort.Panic, Memory.Allocate:
            _ = arena_da_reserve[DrShapeDeal::Note](&session.owner, &session.run.notes,
                session.run.notes.count + more.usize()) can Global{Read,Write}

    # ClockedTask.steer: every Glove port is a control for the frame it
    # is sent in.
    def input(session: mutable Session&, port: i64) -> bool:
        return false if session.phase != PLAYING or port < 0 or port >= Glove::PORTS
        session.pulse <- port
        return true

    # A primary press starts an inning. During one, every move of the
    # pointer, pressed or not, carries the glove's picture by as much through
    # *lens*, the one the screen draws with: Glove._mouse. Reference
    # framebuffer coordinates with a bottom-left origin; kind 1 is a press, 0
    # a move, 2 a release.
    def pointer(session: mutable Session&, x: f64, y: f64, kind: i64, now: f64, lens: SceneLens::Lens) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            if kind == 1 and (session.phase == READY or session.phase == DONE):
                session.pointed <- true
                session.mouse_x <- x
                session.mouse_y <- y
                return (start(session, now) can Global{Read,Write})
            dx: f64 = x - session.mouse_x
            dy: f64 = y - session.mouse_y
            known: bool = session.pointed
            session.pointed <- true
            session.mouse_x <- x
            session.mouse_y <- y
            return false if kind != 0 or not known or session.phase != PLAYING or session.run.result != Glove::LIVE
            gx: f64 = session.run.glove_x
            gy: f64 = session.run.glove_y
            q: SceneLens::Seen = SceneLens::see(&lens, SceneLens::vec(gx, gy, 0.0))
            return false if not q.valid
            e: f64 = 0.01
            px: SceneLens::Seen = SceneLens::see(&lens, SceneLens::vec(gx + e, gy, 0.0))
            py: SceneLens::Seen = SceneLens::see(&lens, SceneLens::vec(gx, gy + e, 0.0))
            return false if not px.valid or not py.valid
            a: f64 = (px.x - q.x) / e
            b: f64 = (py.x - q.x) / e
            c: f64 = (px.y - q.y) / e
            d: f64 = (py.y - q.y) / e
            det: f64 = a * d - b * c
            return false if fabs(det) < 1e-6
            mx: mutable f64 = (d * dx - b * dy) / det
            my: mutable f64 = (a * dy - c * dx) / det
            # a view that barely sees a direction must not fling the glove
            cap: f64 = 0.25
            n: f64 = py_hypot(mx, my)
            if n > cap:
                mx <- mx * cap / n
                my <- my * cap / n
            Glove::shift(&session.run, mx, my)
            return true

    # Glove._held: the first port in the reference's order with a key down.
    def held(session: Session&) -> i64:
        keys: i64 = session.held_keys
        return Glove::UP if (keys & 3) != 0
        return Glove::DOWN if (keys & 12) != 0
        return Glove::LEFT if (keys & 48) != 0
        return Glove::RIGHT if (keys & 192) != 0
        return -1

    def judge(session: mutable Session&, now: f64):
        passed: bool = session.run.result == Glove::CAUGHT
        if passed:
            session.wins <- session.wins + 1
            session.best_rung <- session.rung if session.rung > session.best_rung
        if session.adaptive:
            session.rung <- session.rung + 1 if passed and session.rung < 9223372036854775807
            session.rung <- session.rung - 1 if not passed and session.rung > 1
        session.deadline <- now + FEEDBACK
        session.phase <- JUDGED

    def advance(session: mutable Session&, now: f64, stepped: bool = false) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if not valid_time(session, now)
            if session.phase == JUDGED:
                return false if not stepped and now < session.deadline
                return next_trial(session, now) can Global{Read,Write}
            return false if session.phase != PLAYING
            dt: f64 = fmin(0.1, now - session.time)
            session.time <- now
            control: i64 = session.pulse if session.pulse >= 0 else held(session)
            session.pulse <- -1
            steps: i64 = fmax(1.0, ceil(dt / (1.0 / 120.0))).i64()
            quantum: f64 = dt / steps.f64()
            reserve_notes(session, steps) can Global{Read,Write}
            for _ in 0..<steps |session, quantum, control|:
                Glove::step(&session.run, quantum, control)
                break if session.run.result != Glove::LIVE
            if session.run.result != Glove::LIVE:
                judge(session, now)
            return true

    def agent_event(session: mutable Session&, now: f64, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if not valid_time(session, now)
            return (start(session, now) can Global{Read,Write}) if port == START
            return (advance(session, now, true) can Global{Read,Write}) if port == -1
            return input(session, port)

    # Up 1, W 2, Down 4, S 8, Left 16, A 32, Right 64, D 128.
    def hold_key(session: mutable Session&, key_bit: i64, down: bool) -> bool:
        return false if key_bit <= 0 or key_bit > 128 or (key_bit & (key_bit - 1)) != 0
        return false if down and session.phase != PLAYING
        before: i64 = session.held_keys
        session.held_keys <- before | key_bit if down else before & (255 ^ key_bit)
        return session.held_keys != before

    def clear_controls(session: mutable Session&) -> bool:
        changed: bool = session.held_keys != 0 or session.pulse >= 0
        session.held_keys <- 0
        session.pulse <- -1
        return changed

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return session.wins if field == 4
            return session.best_rung if field == 5
            return session.start_rung if field == 6
            return (1 if session.adaptive else 0) if field == 7
            return session.run.result if field == 8
            return py_round_half_even(session.run.t * 1000.0) if field == 9
            return py_round_half_even(session.run.glove_x * 1000.0) if field == 10
            return py_round_half_even(session.run.glove_y * 1000.0) if field == 11
            return Glove::view(&session.run) if field == 12
            return session.run.caught if field == 13
            return session.run.missed if field == 14
            return session.held_keys if field == 15
            return session.run.next if field == 16
            return Glove::ball(&session.run) if field == 17
            return -1
