include "./passages_seed.elisa"
include "../pyrandom.elisa"
include "../pymath.elisa"

module MissingWord:
    const MISSING: i64 = 0
    const EXTRA: i64 = 1
    const MAX_ROWS: i64 = 6
    const FIRST_EXTRA: i64 = 9000

    struct Grade:
        rung: i64
        sentences: i64
        kinds: i64
        errors: i64
        hint: bool
        close: bool
        seconds: f64

    struct Token:
        id: i64
        text: Passages::Word

    struct Line:
        words: mutable Token[28]
        count: mutable i64

    struct Damage:
        kind: i64
        row: i64
        index: i64

    struct Machine:
        level: mutable Grade
        original: mutable Line[6]
        rows: mutable Line[6]
        damage: mutable Damage[13]
        count: mutable i64
        seed: mutable u64

    struct Candidate:
        valid: bool
        machine: Machine

    struct Sources:
        single: mutable darray[i64]
        passages: mutable darray[i64][6]
        common: mutable darray[Passages::Word]

    def grade(requested: i64) -> Grade:
        can Abort.Panic:
            rung: i64 = requested if requested > 0 else 1
            count: i64 = 1 if rung < 4 else (2 if rung < 10 else (3 if rung < 16 else (4 + (rung - 16) / 6 if rung < 28 else 6)))
            cap: i64 = 9 * count / 4
            errors: mutable i64 = 1 + (rung - 1) / 3 if rung <= 30 else 10 + (rung - 30) / 4
            errors <- cap if errors > cap
            base: f64 = (40 + 20 * errors + 5 * count).f64()
            seconds: f64 = base * fmax(0.25, 1.0 - 0.02 * (rung - 25).f64()) if rung > 25 and errors >= cap else base
            return Grade{rung: rung, sentences: count, kinds: 1 if rung < 7 else 2, errors: errors,
                hint: rung < 19, close: rung >= 13, seconds: py_round_decimal(seconds, 10.0)}

    def eligible_sentence(bank: Passages::Bank&, row: Passages::Row, known: Passages::Index&) -> bool:
        can Abort.Panic:
            length: i64 = row.stop - row.start
            return false if length < 6 or length > 12
            blank: Passages::Word = zeroed
            for i in row.start..<row.stop |bank, known, blank|:
                word: Passages::Word = bank.words[i.usize()]
                return false if word.capitals != 0.u64() or not Passages::contains(known, word, blank)
            return true

    def sources(sentences: Passages::Bank&, passages: Passages::Bank&, known: Passages::Index&) -> Sources:
        can Memory.Allocate, Abort.Panic:
            result: mutable Sources = zeroed
            for i in 0..<sentences.sentences.count.i64() |sentences, known, result|:
                row: Passages::Row = sentences.sentences[i.usize()]
                result.single.push(i) if eligible_sentence(sentences, row, known)
                if i < 20000:
                    for j in (row.start + 1)..<(row.stop - 1) |result, sentences|:
                        result.common.push(sentences.words[j.usize()])
            for i in 0..<passages.passages.count.i64() |passages, result|:
                row: Passages::Row = passages.passages[i.usize()]
                count: i64 = row.stop - row.start
                continue if count < 2 or count > MAX_ROWS
                valid: mutable bool = true
                for at in row.start..<row.stop |passages, valid|:
                    sentence: Passages::Row = passages.sentences[at.usize()]
                    length: i64 = sentence.stop - sentence.start
                    if length < 5 or length > 15:
                        valid <- false
                        break
                result.passages[(count - 1).usize()].push(i) if valid
            return result

    def same_word(a: Passages::Word, b: Passages::Word) -> bool:
        return a.low == b.low and a.high == b.high and a.capitals == b.capitals

    def line(bank: Passages::Bank&, index: i64, row: i64, known: Passages::Index&) -> Line:
        can Abort.Panic:
            range: Passages::Row = bank.sentences[index.usize()]
            result: mutable Line = zeroed
            result.count <- range.stop - range.start
            for i in 0..<result.count |result, range, bank, row, known|:
                text: Passages::Word = Passages::normalized(bank.words[(range.start + i).usize()], i == 0, false, known)
                result.words[i.usize()] <- Token{id: row * 100 + i, text: text}
            return result

    def remove_word(row: mutable Line&, position: i64):
        can Abort.Panic:
            for i in position..<(row.count - 1) |row|:
                row.words[i.usize()] <- row.words[(i + 1).usize()]
            row.count <- row.count - 1

    def insert_word(row: mutable Line&, position: i64, word: Token):
        can Abort.Panic:
            for i in 0..<(row.count - position) |row|:
                at: i64 = row.count - i
                row.words[at.usize()] <- row.words[(at - 1).usize()]
            row.words[position.usize()] <- word
            row.count <- row.count + 1

    def damage_line(row: mutable Line&, rng: mutable MT19937&, pairs: Passages::Index&, common: darray[Passages::Word]&,
            kind: i64, gone: mutable u64&, extra: i64) -> i64:
        can Abort.Panic:
            spots: mutable i64[28] = zeroed
            count: mutable i64 = 0
            end: i64 = row.count - (1 if kind == MISSING else 0)
            for i in 1..<end |row, spots, kind, count|:
                if kind == MISSING:
                    token: Token = row.words[i.usize()]
                    continue if token.id >= FIRST_EXTRA or (token.text.capitals & 1.u64()) != 0.u64()
                    continue if row.words[(i - 1).usize()].id >= FIRST_EXTRA or row.words[(i + 1).usize()].id >= FIRST_EXTRA
                spots[count.usize()] <- i
                count <- count + 1
            # Fisher–Yates over the occupied prefix, using Python's draws.
            for offset in 0..<(count - 1) |rng, spots, count|:
                index: usize = (count - offset - 1).usize()
                pick: usize = py_randbelow(rng, index.u64() + 1.u64()).usize()
                saved: i64 = spots[index]
                spots[index] <- spots[pick]
                spots[pick] <- saved
            for position in 0..<count |row, rng, pairs, common, kind, gone, extra, spots|:
                i: i64 = spots[position.usize()]
                previous: Token = row.words[(i - 1).usize()]
                current: Token = row.words[i.usize()]
                if kind == MISSING:
                    original: i64 = current.id % 100
                    continue if (gone[0] & (5.u64() << (original - 1))) != 0.u64()
                    continue if Passages::contains(pairs, previous.text, row.words[(i + 1).usize()].text)
                    gone[0] <- gone[0] | (1.u64() << original)
                    remove_word(row, i)
                    return original
                continue if previous.id >= FIRST_EXTRA or current.id != previous.id + 1 or common.count == 0.usize()
                word: Passages::Word = common[py_choice_index(rng, common.count.i64()).usize()]
                continue if same_word(word, previous.text) or same_word(word, current.text)
                continue if Passages::contains(pairs, previous.text, word) or Passages::contains(pairs, word, current.text)
                insert_word(row, i, Token{id: extra, text: word})
                return i
            return -1

    def build(level: Grade, rng: mutable MT19937&, sources: Sources&, sentences: Passages::Bank&,
            passages: Passages::Bank&, pairs: Passages::Index&, known: Passages::Index&) -> Candidate:
        can Abort.Panic:
            invalid: Candidate = zeroed
            machine: mutable Machine = zeroed
            machine.level <- level
            if level.sentences == 1:
                return invalid if sources.single.count == 0.usize()
                index: i64 = sources.single[py_choice_index(rng, sources.single.count.i64()).usize()]
                machine.original[0] <- line(sentences, index, 0, known)
            else:
                pool: darray[i64] = sources.passages[(level.sentences - 1).usize()]
                return invalid if pool.count == 0.usize()
                index: i64 = pool[py_choice_index(rng, pool.count.i64()).usize()]
                passage: Passages::Row = passages.passages[index.usize()]
                for i in 0..<level.sentences |machine, passage, passages, known|:
                    machine.original[i.usize()] <- line(passages, passage.start + i, i, known)
            machine.rows <- machine.original
            gone: mutable u64[6] = zeroed
            extra: mutable i64 = FIRST_EXTRA
            for _ in 0..<(level.errors * 8) |machine, level, rng, gone, extra, pairs, sources|:
                break if machine.count >= level.errors
                kind: i64 = py_choice_index(rng, level.kinds)
                row: i64 = py_choice_index(rng, level.sentences)
                index: i64 = damage_line(&machine.rows[row.usize()], rng, pairs, &sources.common, kind, &gone[row.usize()], extra)
                if index >= 0:
                    machine.damage[machine.count.usize()] <- Damage{kind: kind, row: row, index: index}
                    machine.count <- machine.count + 1
                    extra <- extra + 1 if kind == EXTRA
            return invalid if machine.count < level.errors
            machine.seed <- py_getrandbits(rng, 30)
            return Candidate{valid: true, machine: machine}

    def truth_between(machine: Machine&, a: Token, b: Token) -> Passages::Word:
        can Abort.Panic:
            row: i64 = a.id / 100
            i: i64 = a.id % 100
            blank: Passages::Word = zeroed
            return blank if a.id < 0 or row >= machine.level.sentences or b.id / 100 != row or b.id != a.id + 2
            return machine.original[row.usize()].words[(i + 1).usize()].text
