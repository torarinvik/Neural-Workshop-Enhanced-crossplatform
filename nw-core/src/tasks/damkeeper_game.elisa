include "./damkeeper.elisa"

module DamKeeperGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = DamKeeper::PORTS
    const FEEDBACK: f64 = 3.0

    struct Session:
        rng: mutable MT19937
        owner: mutable Arena
        start_rung: i64
        total: i64
        adaptive: bool
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        run: mutable DamKeeper::Run
        last_tick: mutable f64
        deadline: mutable f64
        passed: mutable i64
        best: mutable i64

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 10 or total == 20

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = zeroed
            mt_seed_int(&rng, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
            initial: i64 = rung if rung > 0 else 1
            return Session{rng: rng, owner: zeroed, start_rung: initial, total: total, adaptive: adaptive,
                rung: initial, trial: 0, phase: READY, run: DamKeeper::initialize(), last_tick: 0.0,
                deadline: 0.0, passed: 0, best: 0}

    def close(session: mutable Session&):
        can Abort.Panic, Memory.Release:
            arena_free(&session.owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}
            session.run <- DamKeeper::initialize()
            session.phase <- READY

    def next_trial(session: mutable Session&, now: f64):
        can Abort.Panic, Memory.Allocate, Memory.Release:
            session.last_tick <- now
            if session.trial >= session.total:
                close(session) can Global{Read,Write}
                session.phase <- DONE
                return
            seed: i64 = py_randbelow(&session.rng, 1073741824.u64()).i64()
            valley: DamKeeper::Valley = DamKeeper::deal(session.rung, seed)
            DamKeeper::reset(&session.run, valley)
            session.trial <- session.trial + 1
            session.phase <- PLAYING

    def start(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if (session.phase != READY and session.phase != DONE) or session.total <= 0
            session.rung <- session.start_rung
            session.trial <- 0
            session.passed <- 0
            session.best <- 0
            next_trial(session, now) can Global{Read,Write}
            return true

    def judge(session: mutable Session&, now: f64):
        won: bool = session.run.result == DamKeeper::PASSED
        if won:
            session.passed <- session.passed + 1
            session.best <- session.rung if session.rung > session.best
        if session.adaptive:
            session.rung <- session.rung + 1 if won and session.rung < 9223372036854775807
            session.rung <- session.rung - 1 if not won and session.rung > 1
        session.phase <- JUDGED
        session.deadline <- now + FEEDBACK

    def input(session: mutable Session&, port: i64, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if not (now >= session.last_tick and now <= 9007199254740.0)
            return start(session, now) can Global{Read,Write} if port == START
            return false if session.phase != PLAYING
            return DamKeeper::press(&session.run, port)

    def substeps(run: mutable DamKeeper::Run&, owner: mutable Arena&, dt: f64):
        can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
            steps: i64 = ceil(dt / DamKeeper::SUBSTEP).i64() if dt > 0.0 else 1
            in owner:
                for _step in 0..<steps |run, dt, steps|:
                    DamKeeper::step(run, dt / steps.f64())
                    break if run.result != DamKeeper::RUNNING

    def tick(session: mutable Session&, now: f64):
        can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
            dt: f64 = DamKeeper::min(0.1, now - session.last_tick)
            session.last_tick <- now
            substeps(&session.run, &session.owner, dt)
            if session.run.result != DamKeeper::RUNNING:
                judge(session, now)

    def advance(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
            return false if not (now >= session.last_tick and now <= 9007199254740.0)
            if session.phase == JUDGED:
                return false if now < session.deadline
                next_trial(session, now) can Global{Read,Write}
                return true
            return false if session.phase != PLAYING
            tick(session, now)
            return true

    def agent_event(session: mutable Session&, now: f64, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
            return false if not (now >= session.last_tick and now <= 9007199254740.0)
            return input(session, port, now) can Global{Read,Write} if port >= 0
            return false if port != -1
            # The tick that settles the valley is the verdict publication.
            if session.phase == JUDGED:
                next_trial(session, now) can Global{Read,Write}
                return true
            return false if session.phase != PLAYING
            tick(session, now)
            return true

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return py_round_half_even(session.run.t * 1000.0) if field == 4
            return session.run.valley.level.dams if field == 5
            return session.run.result if field == 6 and session.phase == JUDGED
            return session.run.fault_dam if field == 7 and session.phase == JUDGED
            return session.passed if field == 8
            return session.best if field == 9
            return py_round_half_even(session.deadline * 1000.0) if field == 10 and session.phase == JUDGED
            return -1
