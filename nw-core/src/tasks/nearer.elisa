include "../pyrandom.elisa"
include "../pymath.elisa"

module Nearer:
    const SIZE: i64 = 0
    const FLOOR: i64 = 1
    const SHADOW: i64 = 2
    const HIDING: i64 = 3
    const MOTION: i64 = 4
    const EYE_Y: f64 = 1.6
    const HALF_W: f64 = 0.55
    const HALF_H: f64 = 0.34
    const SWAY_PERIOD: f64 = 2.4

    struct Grade:
        rung: i64
        count: i64
        cue: i64
        ratio: f64
        order: bool

    struct Spot:
        x: f64
        y: f64
        radius: f64

    struct Placement:
        spots: mutable Spot[6]
        count: mutable i64

    struct Solid:
        x: f64
        y: f64
        z: f64
        size: f64
        yaw: f64
        kind: i64
        colour: i64

    struct Puzzle:
        seed: i64
        level: Grade
        solids: Solid[6]
        order: i64[6]
        count: i64

    def grade(requested: i64) -> Grade:
        can Abort.Panic:
            r: i64 = requested if requested > 0 else 1
            cue: i64 = SIZE if r < 7 else (FLOOR if r < 10 else (SHADOW if r < 13 else (HIDING if r < 16 else MOTION)))
            count: i64 = 2 + (r - 1) % 3 + (r - 1) / 9 if r < 20 else 3 + (r - 20) / 3
            limit: i64 = 5 if r < 20 else 6
            ratio: f64 = 1.6 - 0.5 * (r - 1).f64() / 18.0 if r < 20 else 1.1 - 0.006 * (r - 20).f64()
            return Grade{rung: r, count: count if count < limit else limit, cue: cue,
                ratio: ratio if ratio > 1.04 else 1.04, order: r >= 20}

    def uniform(rng: mutable MT19937&, low: f64, high: f64) -> f64:
        can Abort.Panic:
            return low + (high - low) * py_random(rng)

    def seed_attempt(rng: mutable MT19937&, seed: i64, attempt: i64, multiplier: u64 = 211.u64()):
        can Abort.Panic:
            # CPython takes the magnitude of the scaled seed plus the attempt. Split it
            # into 32-bit limbs so signed 64-bit inputs never overflow.
            if seed == 0:
                mt_seed_int(rng, attempt.u64())
                return
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            low: u64 = (magnitude & 0xffffffff.u64()) * multiplier
            high: mutable u64 = (magnitude >> 32.u64()) * multiplier
            limb: mutable u64 = low
            if seed < 0:
                if limb < attempt.u64():
                    high <- high - 1.u64()
                    limb <- limb + 0x100000000.u64()
                limb <- limb - attempt.u64()
            else:
                limb <- limb + attempt.u64()
            high <- high + (limb >> 32.u64())
            if (high >> 32.u64()) == 0.u64():
                mt_seed_int(rng, (high << 32.u64()) | (limb & 0xffffffff.u64()))
            else:
                key: u32[3] = [limb.u32(), high.u32(), (high >> 32.u64()).u32()]
                seed_three_words(rng, &key)

    def seed_three_words(rng: mutable MT19937&, key: u32[3]&):
        can Abort.Panic:
            mt_init_genrand(rng, 19650218.u32())
            i: mutable usize = 1.usize()
            for k in 0..<MT_N |rng, key, i|:
                j: usize = k % 3.usize()
                prev: u32 = rng.mt[i - 1]
                rng.mt[i] <- (rng.mt[i] ^ ((prev ^ (prev >> 30)) * 1664525.u32())) + key[j] + j.u32()
                i <- i + 1
                if i >= MT_N:
                    rng.mt[0] <- rng.mt[MT_N - 1]
                    i <- 1
            for _k in 1..<MT_N |rng, i|:
                prev: u32 = rng.mt[i - 1]
                rng.mt[i] <- (rng.mt[i] ^ ((prev ^ (prev >> 30)) * 1566083941.u32())) - i.u32()
                i <- i + 1
                if i >= MT_N:
                    rng.mt[0] <- rng.mt[MT_N - 1]
                    i <- 1
            rng.mt[0] <- 0x80000000.u32()

    def depths(rng: mutable MT19937&, level: Grade) -> f64[6]:
        can Abort.Panic:
            out: mutable f64[6] = zeroed
            out[0] <- uniform(rng, 4.0, 7.0)
            for k in 1..<level.count |out, rng, level|:
                step: f64 = uniform(rng, level.ratio, level.ratio * 1.12) if level.order or k == 1 else uniform(rng, 1.0, level.ratio * 1.4)
                out[k.usize()] <- out[(k - 1).usize()] * (step if step > 1.02 else 1.02)
            if not level.order:
                k: mutable i64 = level.count - 1
                while k > 2 |out, rng, k|:
                    other: i64 = 2 + py_randbelow(rng, (k - 1).u64()).i64()
                    value: f64 = out[k.usize()]
                    out[k.usize()] <- out[other.usize()]
                    out[other.usize()] <- value
                    k <- k - 1
                bound: f64 = out[1] * 1.02
                for i in 2..<level.count |out, bound|:
                    out[i.usize()] <- bound if out[i.usize()] < bound
            return out

    def candidate(rng: mutable MT19937&, cue: i64, z: f64) -> Spot:
        can Abort.Panic:
            radius: f64 = 0.5 / z if cue == SIZE else (uniform(rng, 0.07, 0.11) if cue == HIDING else uniform(rng, 0.045, 0.075))
            if cue == HIDING:
                return Spot{x: uniform(rng, -0.2, 0.2), y: uniform(rng, -0.13, 0.13), radius: radius}
            x: f64 = uniform(rng, -HALF_W + 0.1, HALF_W - 0.1)
            y: f64 = -EYE_Y / z if cue <= FLOOR else (uniform(rng, -0.14, 0.2) if cue == SHADOW else uniform(rng, -HALF_H + 0.1, HALF_H - 0.1))
            return Spot{x: x, y: y, radius: radius}

    def overlaps(placed: Placement&, proposed: Spot, hiding: bool) -> bool:
        can Abort.Panic:
            for i in 0..<placed.count |placed, proposed, hiding|:
                other: Spot = placed.spots[i.usize()]
                radius: f64 = proposed.radius + other.radius
                limit: f64 = radius * 0.8 if hiding else radius * 1.6 + 0.04
                return true if py_hypot(proposed.x - other.x, proposed.y - other.y) < limit
            return false

    def place(rng: mutable MT19937&, level: Grade, distances: f64[6]&) -> Placement:
        can Abort.Panic:
            out: mutable Placement = zeroed
            hiding: bool = level.cue == HIDING
            for i in 0..<level.count |rng, level, distances, out, hiding|:
                for _attempt in 0..<400 |rng, level, distances, out, hiding, i|:
                    item: Spot = candidate(rng, level.cue, distances[i.usize()])
                    overlap: bool = overlaps(&out, item, hiding)
                    if out.count == 0 or overlap == hiding:
                        out.spots[i.usize()] <- item
                        out.count <- out.count + 1
                        break
                return zeroed if out.count <= i
            return out

    def build(rng: mutable MT19937&, seed: i64, level: Grade, distances: f64[6]&, placement: Placement&) -> Puzzle:
        can Memory.Allocate, Abort.Panic:
            colours: mutable darray[i64] = [0, 1, 2, 3, 4, 5]
            py_shuffle_i64(rng, &colours)
            solids: mutable Solid[6] = zeroed
            for i in 0..<level.count |solids, placement, distances, level, rng, colours|:
                spot: Spot = placement.spots[i.usize()]
                z: f64 = distances[i.usize()]
                kind: i64 = 0 if level.cue == SIZE else py_randbelow(rng, 4.u64()).i64()
                size: f64 = 1.0 if level.cue == SIZE else 2.0 * spot.radius * z
                y: mutable f64 = size / 2.0 * (1.6 if kind == 1 else 1.0) if level.cue <= FLOOR else EYE_Y + spot.y * z
                y <- size + 0.3 if level.cue == SHADOW and y < size + 0.3
                item: Solid = Solid{x: spot.x * z, y: y, z: z, size: size,
                    yaw: uniform(rng, 0.0, 1.5707963267948966), kind: kind, colour: colours[i.usize()]}
                at: mutable i64 = i
                while at > 0 |solids, at, item|:
                    before: Solid = solids[(at - 1).usize()]
                    break if before.x / before.z >= item.x / item.z
                    solids[at.usize()] <- before
                    at <- at - 1
                solids[at.usize()] <- item
            order: mutable i64[6] = zeroed
            for i in 0..<level.count |order, solids|:
                at: mutable i64 = i
                while at > 0 |order, solids, at, i|:
                    previous: i64 = order[(at - 1).usize()]
                    break if solids[previous.usize()].z <= solids[i.usize()].z
                    order[at.usize()] <- previous
                    at <- at - 1
                order[at.usize()] <- i
            return Puzzle{seed: seed, level: level, solids: solids, order: order, count: level.count}

    def deal(rung: i64, seed: i64) -> Puzzle:
        can Memory.Allocate, Abort.Panic:
            level: Grade = grade(rung)
            rng: mutable MT19937 = mt19937_new()
            for attempt in 0..<200 |rng, seed, level|:
                seed_attempt(&rng, seed, attempt)
                distances: f64[6] = depths(&rng, level)
                placement: Placement = place(&rng, level, &distances)
                return build(&rng, seed, level, &distances, &placement) if placement.count == level.count
            return Puzzle{seed: seed, level: level, solids: zeroed, order: zeroed, count: 0}

    def eye_x(level: Grade, elapsed: f64) -> f64:
        can Abort.Panic:
            return 0.45 * sin(6.283185307179586 * elapsed / SWAY_PERIOD) if level.cue == MOTION else 0.0
