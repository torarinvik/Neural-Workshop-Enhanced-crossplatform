include "../pyrandom.elisa"
include "../pymath.elisa"
include "../strings.elisa"

module TimeIt:
    const WIDTH: f64 = 100.0
    const HEIGHT: f64 = 50.0
    const GROUND: f64 = 6.0
    const GRAVITY: f64 = 40.0
    const ROLL: i64 = 0
    const SLOW: i64 = 1
    const BOUNCE: i64 = 2
    const THROW: i64 = 3
    const PRESS: i64 = 0
    const PENDING: i64 = 0
    const ON_MARK: i64 = 1
    const EARLY: i64 = 2
    const LATE: i64 = 3
    const MISSED: i64 = 4

    struct Grade:
        rung: i64
        kind: i64
        hidden_min: f64
        hidden_max: f64
        window: f64
        speed_min: f64
        speed_max: f64

    struct Shot:
        level: Grade
        kind: i64
        x0: f64
        velocity: mutable f64
        decel: mutable f64
        wall: mutable f64
        vy: mutable f64
        left: mutable f64
        right: mutable f64
        mark: mutable f64
        when: f64

    struct Point:
        x: f64
        y: f64

    struct Trial:
        shot: Shot
        time: mutable f64
        pressed: mutable f64
        result: mutable i64

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        window: f64 = 0.12 if r < 4 else (0.09 if r < 16 else (0.08 if r < 20 else
            (0.075 - 0.003 * (r - 20).f64() if r < 29 else 0.05)))
        return Grade{rung: r, kind: ROLL if r < 7 else (SLOW if r < 10 else (BOUNCE if r < 13 else (THROW if r < 16 else -1))),
            hidden_min: 0.5 if r < 4 else (0.9 if r < 16 else 1.2), hidden_max: 0.8 if r < 4 else (1.4 if r < 16 else 1.9),
            window: window, speed_min: 22.0 if r < 16 else 28.0, speed_max: 28.0 if r < 16 else 40.0}

    def minimum(a: f64, b: f64) -> f64:
        return a if a < b else b

    def uniform(rng: mutable MT19937&, a: f64, b: f64) -> f64:
        return a + (b - a) * py_random(rng)

    def position(shot: Shot&, seconds: f64) -> Point:
        if shot.kind == THROW:
            y: f64 = GROUND + shot.vy * seconds - 0.5 * GRAVITY * seconds * seconds
            return Point{x: shot.x0 + shot.velocity * seconds, y: GROUND if y < GROUND else y}
        if shot.kind == SLOW:
            t: f64 = minimum(seconds, shot.velocity / shot.decel)
            return Point{x: shot.x0 + shot.velocity * t - 0.5 * shot.decel * t * t, y: GROUND}
        x: f64 = shot.x0 + shot.velocity * seconds
        return Point{x: 2.0 * shot.wall - x if shot.kind == BOUNCE and x > shot.wall else x, y: GROUND}

    def deal(rung: i64, seed: i64) -> Shot:
        can Abort.Panic:
            level: Grade = grade(rung)
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
            for _attempt in 0..<500 |level, rng|:
                pick: i64 = py_randbelow(&rng, 4.u64() if level.kind < 0 else 1.u64()).i64()
                kind: i64 = pick if level.kind < 0 else level.kind
                v: f64 = uniform(&rng, level.speed_min, level.speed_max)
                hidden: f64 = uniform(&rng, level.hidden_min, level.hidden_max)
                seen: f64 = uniform(&rng, 1.4, 2.2)
                target: f64 = seen + hidden
                shot: mutable Shot = Shot{level: level, kind: kind, x0: 4.0, velocity: v, decel: 0.0, wall: 0.0,
                    vy: 0.0, left: 4.0 + v * seen, right: 0.0, mark: 4.0 + v * target, when: target}
                if kind == ROLL:
                    shot.right <- minimum(WIDTH - 2.0, shot.mark + uniform(&rng, 6.0, 14.0))
                elif kind == SLOW:
                    shot.decel <- uniform(&rng, 0.25, 0.4) * v / target
                    continue if v / shot.decel < target + 0.4
                    shot.left <- position(&shot, seen).x
                    shot.mark <- position(&shot, target).x
                    shot.right <- minimum(WIDTH - 2.0, shot.mark + uniform(&rng, 6.0, 12.0))
                elif kind == BOUNCE:
                    shot.wall <- shot.left + v * hidden * uniform(&rng, 0.55, 0.8)
                    shot.mark <- 2.0 * shot.wall - shot.mark
                    continue if shot.mark < shot.left + 4.0 or shot.wall > WIDTH - 3.0
                    shot.right <- minimum(WIDTH - 1.0, shot.wall + 3.0)
                else:
                    vx: f64 = uniform(&rng, 18.0, 24.0)
                    vy: f64 = 0.5 * GRAVITY * target
                    shot.velocity <- vx
                    shot.vy <- vy
                    shot.left <- shot.x0 + vx * seen
                    shot.mark <- shot.x0 + vx * target
                    continue if shot.mark > WIDTH - 6.0 or GROUND + vy * vy / (2.0 * GRAVITY) > HEIGHT - 3.0
                    shot.right <- minimum(WIDTH - 1.0, shot.mark + uniform(&rng, 5.0, 10.0))
                return shot if shot.right - shot.left >= 8.0 and shot.mark <= WIDTH - 3.0
            return zeroed

    def trial(shot: Shot) -> Trial:
        return Trial{shot: shot, time: 0.0, pressed: -1.0, result: PENDING}

    def press(run: mutable Trial&) -> bool:
        return false if run.result != PENDING
        run.pressed <- run.time
        off: f64 = run.time - run.shot.when
        window: f64 = run.shot.level.window
        run.result <- ON_MARK if off >= -window and off <= window else (EARLY if off < 0.0 else LATE)
        return true

    def step(run: mutable Trial&, dt: f64):
        return if run.result != PENDING
        run.time <- run.time + dt
        run.result <- MISSED if run.time > run.shot.when + run.shot.level.window + 0.6

    def result_text(run: Trial&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            return if run.result == PENDING
            if run.result == MISSED:
                dstr_append_cstr(out, "No press -- the ball went by")
                return
            ms: i64 = py_round_half_even((run.pressed - run.shot.when) * 1000.0)
            if run.result == ON_MARK:
                dstr_append_cstr(out, "On the mark -- ")
                if ms >= 0:
                    dstr_append_cstr(out, "+")
                dstr_append_i64(out, ms)
            else:
                dstr_append_i64(out, -ms if ms < 0 else ms)
            dstr_append_cstr(out, " ms")
            if run.result != ON_MARK:
                dstr_append_cstr(out, " early" if run.result == EARLY else " late")
