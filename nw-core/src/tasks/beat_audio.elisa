include "./beat.elisa"
include "../tone_pcm.elisa"

module BeatAudio:
    def glass() -> TonePcm::Patch:
        partials: TonePcm::Partial[6] = [
            TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
            TonePcm::Partial{ratio: 2.269103502780446, gain: 0.6 * TonePcm::BRIGHT_PARTIAL, decay: 0.8},
            TonePcm::Partial{ratio: 4.3385956029189945, gain: 0.4 * TonePcm::BRIGHT_PARTIAL, decay: 1.6},
            TonePcm::Partial{ratio: 6.63, gain: 0.25 * TonePcm::BRIGHT_PARTIAL, decay: 2.5},
            zeroed, zeroed]
        return TonePcm::Patch{partials: partials, count: 4, attack: 0.005,
            decay: 1.2633059085543874, release: 0.5, sustain: 0.0, tremolo_rate: 0.0, tremolo_depth: 0.0}

    def render(song: Beat::Song&, begin: f64, end: f64, dest: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 0 if not (begin >= 0.0 and end > begin and end - begin <= 60.0)
            frames: i64 = py_round_half_even((end - begin) * TonePcm::RATE.f64())
            return 0 if frames < 1 or frames > capacity / TonePcm::FRAME_BYTES
            stereo: mutable darray[f64] = TonePcm::empty(frames)
            bell: TonePcm::Patch = glass()
            click: TonePcm::Patch = TonePcm::wood(660.0)
            for i in 0..<song.count |song, begin, end, stereo, frames, bell, click|:
                onset: f64 = song.times[i.usize()]
                break if onset >= end
                continue if not Beat::heard(song, i)
                if i % song.level.cycle == 0:
                    TonePcm::mix(&stereo, frames, begin, end, &bell, onset, 0.08, 880.0, 0.0, 0.9)
                else:
                    TonePcm::mix(&stereo, frames, begin, end, &click, onset, 0.08, 660.0, 0.0, 0.7)
            return TonePcm::write(stereo, frames, dest)
