include "./hold_it_audio.elisa"

module HoldItGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const PRESS: i64 = 0
    const RELEASE: i64 = 1
    const START: i64 = 2
    const SUBSTEP: f64 = 1.0 / 240.0
    const FEEDBACK: f64 = 3.0

    struct Session:
        rng: mutable MT19937
        start_rung: i64
        total: i64
        adaptive: bool
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        run: mutable HoldIt::Run
        pressed: mutable bool
        heard_to: mutable f64
        last_tick: mutable f64
        deadline: mutable f64
        passed_count: mutable i64
        best_rung: mutable i64

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            start: i64 = rung if rung > 0 else 1
            return Session{rng: rng, start_rung: start, total: total, adaptive: adaptive,
                rung: start, trial: 0, phase: READY, run: zeroed, pressed: false, heard_to: 0.0, last_tick: 0.0,
                deadline: 0.0, passed_count: 0, best_rung: 0}

    def next_trial(session: mutable Session&, now: f64):
        can Abort.Panic:
            if session.trial >= session.total:
                session.phase <- DONE
                session.run <- zeroed
                return
            seed: i64 = py_randbelow(&session.rng, 1073741824.u64()).i64()
            session.run <- HoldIt::initialize(HoldIt::deal(session.rung, seed))
            session.trial <- session.trial + 1
            session.last_tick <- now
            session.heard_to <- 0.0
            session.phase <- PLAYING

    def start(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic:
            return false if session.phase != READY and session.phase != DONE
            session.pressed <- false
            session.rung <- session.start_rung
            session.trial <- 0
            session.passed_count <- 0
            session.best_rung <- 0
            next_trial(session, now)
            return true

    def advance(session: mutable Session&, now: f64, pressed: bool) -> bool:
        can Abort.Panic:
            if session.phase == JUDGED:
                return false if now < session.deadline
                next_trial(session, now)
                return true
            return false if session.phase != PLAYING
            elapsed: f64 = now - session.last_tick
            dt: f64 = 0.0 if elapsed < 0.0 else (0.1 if elapsed > 0.1 else elapsed)
            session.last_tick <- now
            ratio: f64 = dt / SUBSTEP
            whole: i64 = ratio.i64()
            steps: i64 = whole + 1 if ratio > whole.f64() else (1 if whole == 0 else whole)
            for tick in 0..<steps |session, dt, steps, pressed|:
                HoldIt::step(&session.run, dt / steps.f64(), pressed)
                break if session.run.result != HoldIt::PENDING
            if session.run.result != HoldIt::PENDING:
                passed: bool = session.run.result == HoldIt::PASSED
                if passed:
                    session.passed_count <- session.passed_count + 1
                    session.best_rung <- session.rung if session.rung > session.best_rung
                if session.adaptive:
                    session.rung <- session.rung + 1 if passed and session.rung < 9223372036854775807
                    session.rung <- session.rung - 1 if not passed and session.rung > 1
                session.phase <- JUDGED
                session.deadline <- now + FEEDBACK
            return true

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 10 or total == 20

    def input(session: mutable Session&, action: i64, now: f64) -> bool:
        can Abort.Panic:
            return start(session, now) if action == START
            held: bool = action == PRESS
            return false if held == session.pressed or (held and session.phase != PLAYING and session.phase != JUDGED)
            if session.phase == PLAYING:
                _ = advance(session, now, session.pressed)
            session.pressed <- held
            return true

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            run: HoldIt::Run& = &session.run
            active: bool = session.phase == PLAYING or session.phase == JUDGED
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return (run.ask.kind if active else -1) if field == 4
            return (round_half_even(run.ask.factor * 1000.0) if active else 0) if field == 5
            return run.ask.count if field == 6
            return (1 if HoldIt::lamp_lit(run, 0) else 0) if field == 7
            return (1 if HoldIt::lamp_lit(run, 1) else 0) if field == 8
            return (1 if active and run.time >= run.ask.turn else 0) if field == 9
            return (1 if run.holding else 0) if field == 10
            return run.result if field == 11
            return session.passed_count if field == 12
            return session.best_rung if field == 13
            return (round_half_even(run.ask.target * 1000.0) if run.result != HoldIt::PENDING and run.started else -1) if field == 14
            return (round_half_even(run.held * 1000.0) if run.result != HoldIt::PENDING and run.started else -1) if field == 15
            return -1

    def audio_window(session: mutable Session&, dest: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 0 if session.phase != PLAYING and session.phase != JUDGED
            elapsed: f64 = session.run.time - session.heard_to
            return 0 if elapsed <= 0.0
            available: i64 = capacity / HoldItAudio::FRAME_BYTES
            return 0 if available < 1
            frames: i64 = round_half_even(elapsed * HoldItAudio::RATE.f64())
            return 0 if frames < 1
            end: f64 = session.run.time if frames <= available else session.heard_to + available.f64() / HoldItAudio::RATE.f64()
            length: i64 = HoldItAudio::render(&session.run.ask, session.heard_to, end, dest, capacity)
            session.heard_to <- end if length > 0
            return length

    def agent_step(session: mutable Session&, now: f64, held: bool) -> bool:
        can Abort.Panic:
            return false if not (now >= session.last_tick and now <= 9007199254740.0)
            if session.phase == JUDGED:
                next_trial(session, now)
                return true
            return advance(session, now, held)
