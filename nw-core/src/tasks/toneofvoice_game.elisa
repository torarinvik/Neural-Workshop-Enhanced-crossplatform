include "./toneofvoice.elisa"
include "./reading_quiz_run.elisa"
include "../hand_view.elisa"

module ToneOfVoiceGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const FEEDBACK: f64 = 2.5

    struct Session:
        rng: mutable MT19937
        start_rung: mutable i64
        total: mutable i64
        adaptive: mutable bool
        rung: mutable i64
        trial: mutable i64
        wins: mutable i64
        best_rung: mutable i64
        phase: mutable i64
        time: mutable f64
        deadline: mutable f64
        run: mutable ReadingQuiz::Run
        hand: mutable HandView::Pointer
        owner: mutable Arena
        # The round's grade, its hums, each item's voice, and when each
        # item began (Run.starts), for the audio.
        level: mutable ToneOfVoice::Grade
        hums: mutable darray[i64]
        voices: mutable darray[darray[f64]]
        starts: mutable darray[f64]
        # The voices' own arena: megabytes of samples, kept apart from the
        # round's (see keep_round).
        voice_owner: mutable Arena

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64) -> Session:
        rng: mutable MT19937 = zeroed
        magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
        mt_seed_int(&rng, magnitude)
        initial: i64 = rung if rung > 0 else 1
        return Session{rng: rng, start_rung: initial, total: trials, adaptive: adaptive, rung: initial,
            trial: 0, wins: 0, best_rung: 0, phase: READY, time: 0.0, deadline: 0.0,
            run: zeroed, hand: HandView::Pointer{x: 500.0, y: 20.0, down: false}, owner: zeroed,
            level: zeroed, hums: [], voices: [], starts: [], voice_owner: zeroed}

    def release_quiz_trial(session: mutable Session&):
        can Abort.Panic, Memory.Release:
            session.run <- zeroed
            session.hums <- []
            session.voices <- []
            session.starts <- []
            arena_free(&session.voice_owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}
            arena_free(&session.owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}

    def close(session: mutable Session&):
        can Abort.Panic, Memory.Release:
            release_quiz_trial(session) can Global{Read,Write}
            session.phase <- READY

    # Natively, what the deal and the voices allocated under `in owner`
    # landed in the SDL call's own arena and was reclaimed when it returned
    # (the session still pointing at it: the next frame read zeroed items).
    # So every buffer the session keeps is copied here into the session's
    # arenas by explicit reserves, after which the pushes never reallocate.
    # Each buffer is reserved in place in the session (a field emptied,
    # reserved in the arena, then filled), so nothing points at a local.
    # Fills a buffer already reserved for the whole text (no regrowth).
    def fill_text(into: mutable dstr&, text: dstr&):
        can Memory.Allocate, Abort.Panic:
            for i in 0..<text.count.i64() |into, text|:
                into.push(text[i.usize()])

    def keep_round(session: mutable Session&):
        can Memory.Allocate, Abort.Panic, Global.Read, Global.Write:
            dealt: ReadingQuiz::Round = session.run.round
            hums: darray[i64] = session.hums
            owner: mutable Arena& = &session.owner
            session.run.round.items <- []
            _ = arena_da_reserve[ReadingQuiz::Item](owner, &session.run.round.items, dealt.items.count + 1.usize()) can Global{Read,Write}
            for i in 0..<dealt.items.count.i64() |session, dealt, owner|:
                item: ReadingQuiz::Item& = &dealt.items[i.usize()]
                at: usize = i.usize()
                session.run.round.items.push(ReadingQuiz::Item{prompt: [], steps: [], seconds: item.seconds, title: item.title,
                    truth: [], tolerance: item.tolerance, scored: item.scored})
                _ = arena_da_reserve[u8](owner, &session.run.round.items[at].prompt, item.prompt.count + 1.usize()) can Global{Read,Write}
                fill_text(&session.run.round.items[at].prompt, &item.prompt)
                _ = arena_da_reserve[u8](owner, &session.run.round.items[at].truth, item.truth.count + 1.usize()) can Global{Read,Write}
                fill_text(&session.run.round.items[at].truth, &item.truth)
                _ = arena_da_reserve[ReadingQuiz::Step](owner, &session.run.round.items[at].steps, item.steps.count + 1.usize()) can Global{Read,Write}
                for s in 0..<item.steps.count.i64() |session, item, owner, at|:
                    step: ReadingQuiz::Step& = &item.steps[s.usize()]
                    k: usize = s.usize()
                    session.run.round.items[at].steps.push(ReadingQuiz::Step{ask: [], options: [], answer: step.answer, wide: step.wide, values: []})
                    _ = arena_da_reserve[u8](owner, &session.run.round.items[at].steps[k].ask, step.ask.count + 1.usize()) can Global{Read,Write}
                    fill_text(&session.run.round.items[at].steps[k].ask, &step.ask)
                    _ = arena_da_reserve[dstr](owner, &session.run.round.items[at].steps[k].options, step.options.count + 1.usize()) can Global{Read,Write}
                    for o in 0..<step.options.count.i64() |session, step, owner, at, k|:
                        session.run.round.items[at].steps[k].options.push([])
                        _ = arena_da_reserve[u8](owner, &session.run.round.items[at].steps[k].options[o.usize()], step.options[o.usize()].count + 1.usize()) can Global{Read,Write}
                        fill_text(&session.run.round.items[at].steps[k].options[o.usize()], &step.options[o.usize()])
                    _ = arena_da_reserve[f64](owner, &session.run.round.items[at].steps[k].values, step.values.count + 1.usize()) can Global{Read,Write}
                    for v in 0..<step.values.count.i64() |session, step, at, k|:
                        session.run.round.items[at].steps[k].values.push(step.values[v.usize()])
            session.hums <- []
            _ = arena_da_reserve[i64](owner, &session.hums, hums.count + 1.usize()) can Global{Read,Write}
            for h in hums |session|:
                session.hums.push(h)
            session.voices <- []
            _ = arena_da_reserve[darray[f64]](&session.voice_owner, &session.voices, hums.count + 1.usize()) can Global{Read,Write}
            for h in 0..<hums.count.i64() |session, hums|:
                made: darray[f64] = ToneOfVoice::samples(hums[h.usize()], session.level.cut)
                session.voices.push([])
                _ = arena_da_reserve[f64](&session.voice_owner, &session.voices[h.usize()], made.count + 1.usize()) can Global{Read,Write}
                for x in made |session, h|:
                    session.voices[h.usize()].push(x)

    def next_round(session: mutable Session&, corpus: ToneOfVoice::Corpus&, now: f64) -> bool:
        can Abort.Panic, Memory.Release, Memory.Allocate:
            session.time <- now
            if session.trial >= session.total:
                session.phase <- DONE
                return true
            release_quiz_trial(session) can Global{Read,Write}
            owner: mutable Arena& = &session.owner
            in owner:
                g: ToneOfVoice::Grade = ToneOfVoice::grade(session.rung)
                round: ToneOfVoice::Round = ToneOfVoice::deal(g, &session.rng, corpus)
                if round.quiz.items.count == 0.usize():
                    session.phase <- READY
                    return false
                session.run <- ReadingQuiz::begin(round.quiz)
                session.level <- g
                session.hums <- round.hums
                session.starts <- [0.0]
                # Each item can produce one cue per answer, plus its verdict.
                capacity: mutable i64 = 1
                for item in round.quiz.items:
                    capacity <- capacity + item.steps.count.i64() + 1
                _ = arena_da_reserve[ReadingQuiz::Cue](owner, &session.run.cues, capacity.usize()) can Global{Read,Write}
                # One start a further item; reserved here, as pushes come later.
                _ = arena_da_reserve[f64](owner, &session.starts, (round.quiz.items.count + 1.usize())) can Global{Read,Write}
            keep_round(session) can Global{Read,Write}
            session.hand <- HandView::Pointer{x: 500.0, y: 20.0, down: false}
            session.trial <- session.trial + 1
            session.phase <- PLAYING
            return true

    def start(session: mutable Session&, corpus: ToneOfVoice::Corpus&, now: f64) -> bool:
        can Abort.Panic, Memory.Release, Memory.Allocate:
            return false if (session.phase != READY and session.phase != DONE) or session.total < 1
            return false if not valid_time(session, now)
            session.rung <- session.start_rung
            session.trial <- 0
            session.wins <- 0
            session.best_rung <- 0
            return next_round(session, corpus, now) can Global{Read,Write}

    def valid_time(session: Session&, now: f64) -> bool:
        return now >= session.time and now <= 9007199254740.0

    def choose(session: mutable Session&, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if session.phase != PLAYING
            return ReadingQuiz::choose(&session.run, port)

    def pointer(session: mutable Session&, x: f64, y: f64, kind: i64) -> bool:
        can Abort.Panic, Memory.Allocate:
            return false if session.phase != PLAYING or kind < 0 or kind > 2
            HandView::place(&session.hand, (x - HandView::VIEW_LEFT) / HandView::VIEW_SCALE,
                (y - HandView::VIEW_BOTTOM) / HandView::VIEW_SCALE)
            if kind == 1:
                _ = ReadingQuiz::click(&session.run, session.hand.x, session.hand.y)
            return true

    def advance(session: mutable Session&, corpus: ToneOfVoice::Corpus&, now: f64, stepped: bool = false) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if not valid_time(session, now)
            if session.phase == JUDGED:
                return false if not stepped and now < session.deadline
                return next_round(session, corpus, now) can Global{Read,Write}
            return false if session.phase != PLAYING
            dt: f64 = fmin(0.1, now - session.time)
            session.time <- now
            steps: i64 = fmax(1.0, ceil(dt / (1.0 / 120.0))).i64()
            quantum: f64 = dt / steps.f64()
            for _ in 0..<steps |session, quantum|:
                before: i64 = session.run.index
                ReadingQuiz::advance_quiz(&session.run, quantum)
                if session.run.index != before and session.run.index < session.run.round.items.count.i64():
                    session.starts.push(session.run.since)
                break if session.run.result != ReadingQuiz::LIVE
            if session.run.result != ReadingQuiz::LIVE:
                passed: bool = session.run.result == ReadingQuiz::PASSED
                if passed:
                    session.wins <- session.wins + 1
                    session.best_rung <- session.rung if session.rung > session.best_rung
                if session.adaptive:
                    session.rung <- session.rung + 1 if passed and session.rung < 9223372036854775807
                    session.rung <- session.rung - 1 if not passed and session.rung > 1
                session.deadline <- now + FEEDBACK
                session.phase <- JUDGED
            return true
