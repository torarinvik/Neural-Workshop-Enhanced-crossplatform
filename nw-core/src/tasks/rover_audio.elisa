include "./rover.elisa"
include "./drshape_audio.elisa"

module RoverAudio:
    def render(run: Rover::Run&, begin: f64, end: f64, output: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            notes: mutable darray[DrShapeDeal::Note] = []
            bank: mutable DrShapeAudio::Bank = zeroed
            bank.count <- 3
            rng: mutable MT19937 = zeroed
            mt_seed_int(&rng, 2.u64())
            bank.patches[1] <- DrShapeAudio::make_patch(DrShapeAudio::BELL, &rng, 0.0)
            mt_seed_int(&rng, 3.u64())
            bank.patches[2] <- DrShapeAudio::make_patch(DrShapeAudio::GROWL, &rng, 0.0)
            for i in 0..<run.cue_count |run, notes|:
                cue: Rover::Cue = run.cues[i.usize()]
                gain: f64 = 0.3 if cue.passed else 0.5
                notes.push(DrShapeDeal::Note{t: cue.at, dur: 0.25 if cue.passed else 0.5,
                    freq: 880.0 if cue.passed else 90.0, pan: 0.0, pan2: 0.0, gain: gain, gain2: gain,
                    bright: 0.8, voice: 1 if cue.passed else 2, seed: i + 1, who: -1, room: 0.0})
            return DrShapeAudio::write(&notes, &bank, begin, end, output, capacity)
