# Algebra: twelve rungs from `3 + 4` to six congruences at once.
#
# Port of neural_workshop/algebra.py (GPL-2.0-or-later). What the shell keeps
# is the screen and the English; what is here is every problem, the forward
# check that a dealt problem really answers itself, the marking, and the
# solver that knows no mathematics.
#
# WHAT MAKES THE TOP RUNG SUPERHUMAN is the SIZE of the box and nothing else.
# Six five-digit primes multiplied together put the answer somewhere in 10^28,
# unique there by the remainder theorem rather than by hoping, and the numbers
# on the page stay five digits. That is why this module needs big integers at
# all -- see src/bigfrac.elisa -- and it is the only thing on the ladder that
# does.
#
# `Problem.candidates` is `log10(max(1, space))`, which is a display value, so
# `space` itself is what crosses here and the logarithm is the shell's. The
# `working` -- the derivation shown after the verdict -- is English built round
# numbers that are already checked elsewhere, so its SENTENCES are the shell's
# too; the one part of it that is load-bearing, the running recombination in
# `build_crt`, is computed here and checked against the answer exactly as the
# reference checks it.

module Algebra:

    const NUMBER: i64 = 0
    const EXPRESSION: i64 = 1

    const FAM_ADD: i64 = 0
    const FAM_CHAIN: i64 = 1
    const FAM_PRECEDENCE: i64 = 2
    const FAM_SIGNS: i64 = 3
    const FAM_FRACTIONS: i64 = 4
    const FAM_LINEAR: i64 = 5
    const FAM_EXPAND: i64 = 6
    const FAM_CONGRUENCE: i64 = 7
    const FAM_CRT: i64 = 8

    const WANT_NOTHING: i64 = 0
    const WANT_X: i64 = 1
    const WANT_SMALLEST_X: i64 = 2
    const WANT_SMALLEST_N: i64 = 3
    const WANT_EXPAND: i64 = 4

    const GRADE_COUNT: i64 = 12

    # How many candidates `crack` will look at before giving up. Not a
    # difficulty setting -- a stopwatch. A rung whose space is bigger than this
    # is a rung searching cannot reach, which is the whole claim the top of the
    # ladder makes.
    const BUDGET: i64 = 200000

    const MOST_ASKED: i64 = 512
    const MOST_MODULI: i64 = 6

    # One rung: what it asks, and how big the space it hides it in. The dials
    # are the reference's `dials` dict; -1 is a key it does not set, and every
    # reader falls back the way its own `.get` does.
    struct AlgebraGrade:
        family: i64
        kind: i64
        digits: i64
        high: i64
        degree: i64
        letters: i64
        band: i64
        modulus: i64
        moduli: i64

    def grade_of(rung: i64) -> AlgebraGrade:
        index: mutable i64 = rung - 1
        index <- 0 if index < 0
        index <- GRADE_COUNT - 1 if index > GRADE_COUNT - 1
        return AlgebraGrade{family: FAM_ADD, kind: NUMBER, digits: 1, high: -1, degree: -1, letters: -1, band: -1, modulus: -1, moduli: -1} if index == 0
        return AlgebraGrade{family: FAM_CHAIN, kind: NUMBER, digits: -1, high: 20, degree: -1, letters: -1, band: -1, modulus: -1, moduli: -1} if index == 1
        return AlgebraGrade{family: FAM_PRECEDENCE, kind: NUMBER, digits: -1, high: 9, degree: -1, letters: -1, band: -1, modulus: -1, moduli: -1} if index == 2
        return AlgebraGrade{family: FAM_SIGNS, kind: NUMBER, digits: -1, high: 12, degree: -1, letters: -1, band: -1, modulus: -1, moduli: -1} if index == 3
        return AlgebraGrade{family: FAM_FRACTIONS, kind: NUMBER, digits: -1, high: 9, degree: -1, letters: -1, band: -1, modulus: -1, moduli: -1} if index == 4
        return AlgebraGrade{family: FAM_LINEAR, kind: NUMBER, digits: -1, high: 9, degree: -1, letters: -1, band: -1, modulus: -1, moduli: -1} if index == 5
        return AlgebraGrade{family: FAM_EXPAND, kind: EXPRESSION, digits: -1, high: -1, degree: 1, letters: -1, band: 16, modulus: -1, moduli: -1} if index == 6
        return AlgebraGrade{family: FAM_CONGRUENCE, kind: NUMBER, digits: -1, high: -1, degree: -1, letters: -1, band: -1, modulus: 60, moduli: -1} if index == 7
        return AlgebraGrade{family: FAM_EXPAND, kind: EXPRESSION, digits: -1, high: -1, degree: 2, letters: -1, band: 32, modulus: -1, moduli: -1} if index == 8
        return AlgebraGrade{family: FAM_CRT, kind: NUMBER, digits: 2, high: -1, degree: -1, letters: -1, band: -1, modulus: -1, moduli: 3} if index == 9
        return AlgebraGrade{family: FAM_EXPAND, kind: EXPRESSION, digits: -1, high: -1, degree: 3, letters: 2, band: 144, modulus: -1, moduli: -1} if index == 10
        return AlgebraGrade{family: FAM_CRT, kind: NUMBER, digits: 5, high: -1, degree: -1, letters: -1, band: -1, modulus: -1, moduli: 6}

    def dial(held: i64, fallback: i64) -> i64:
        return fallback if held < 0
        return held

    # A dealt problem, with everything measured about it.
    struct Problem:
        dealt: mutable bool
        grade: mutable AlgebraGrade
        # The question, as shown -- and as `checks_out` reads it back.
        asked: mutable darray[u8]
        asked_n: mutable i64
        answer_kind: mutable i64
        answer: mutable Q::Frac
        answer_poly: mutable Expressions::Poly
        # How many candidates a checker-only solver must walk. One definition,
        # used by `candidates` and by `crack` both -- two would drift, and the
        # drift would be silent: a space that does not contain the answer makes
        # CRACKED a measure of nothing.
        space: mutable Big::Int
        # How many steps the generator took, which is an upper bound on how
        # many a solver needs and is free to know.
        steps: mutable i64
        wants: mutable i64
        # The moduli a CRT rung was built on, which is what its derivation is
        # made of.
        moduli: mutable darray[i64]
        moduli_n: mutable i64

    def new_problem() -> Problem:
        can Memory.Allocate, Abort.Panic:
            return Problem{dealt: false,
                           grade: grade_of(1),
                           asked: Bytes::zeros(MOST_ASKED), asked_n: 0,
                           answer_kind: NUMBER, answer: Q::zero(),
                           answer_poly: Expressions::zero(),
                           space: Big::zero(), steps: 0, wants: WANT_NOTHING,
                           moduli: Ints::zeros(MOST_MODULI), moduli_n: 0}

    # --- writing the question down ----------------------------------------

    def put_byte(out: mutable Problem&, value: i64):
        can Abort.Panic:
            Bytes::put(&out.asked, out.asked_n, value.u8())
            out.asked_n <- out.asked_n + 1

    def put_i64(out: mutable Problem&, value: i64):
        can Memory.Allocate, Abort.Panic:
            held: mutable i64 = value
            if held < 0:
                put_byte(out, 45)
                held <- 0 - held
            if held == 0:
                put_byte(out, 48)
                return
            digits: mutable darray[u8] = Bytes::zeros(24)
            span: mutable i64 = 0
            while held > 0 |held, digits, span|:
                Bytes::put(&digits, span, (48 + held % 10).u8())
                held <- held / 10
                span <- span + 1
            for index in 0..<span |out, digits, span|:
                put_byte(out, Bytes::at_ref(&digits, span - 1 - index).i64())

    def put_big(out: mutable Problem&, value: Big::Int&):
        can Memory.Allocate, Abort.Panic:
            text: mutable darray[u8] = Bytes::zeros(352)
            span: i64 = Big::to_text(value, &text)
            for index in 0..<span |out, text|:
                put_byte(out, Bytes::at_ref(&text, index).i64())

    def put_frac(out: mutable Problem&, value: Q::Frac&):
        can Memory.Allocate, Abort.Panic:
            text: mutable darray[u8] = Bytes::zeros(352)
            span: i64 = Q::to_text(value, &text)
            for index in 0..<span |out, text|:
                put_byte(out, Bytes::at_ref(&text, index).i64())

    def put_bytes(out: mutable Problem&, text: mutable darray[u8]&, span: i64):
        can Abort.Panic:
            for index in 0..<span |out, text|:
                put_byte(out, Bytes::at_ref(text, index).i64())

    def put_space(out: mutable Problem&):
        can Abort.Panic:
            put_byte(out, 32)

    # `TIMES` is U+00D7, which is two bytes in UTF-8 -- and `_sum_checks`
    # replaces it with a star before it reads the question back, so both have
    # to be written the same way round.
    def put_times(out: mutable Problem&):
        can Abort.Panic:
            put_byte(out, 195)
            put_byte(out, 151)

    def put_sign_and_size(out: mutable Problem&, value: i64):
        can Memory.Allocate, Abort.Panic:
            put_byte(out, 43 if value >= 0 else 45)
            put_space(out)
            put_i64(out, value if value >= 0 else 0 - value)

    # --- the small builders -----------------------------------------------

    # `randint(low, high)` again until it is not `avoid`; a negative `avoid`
    # stands for the reference's `None`, which nothing equals.
    def pick(rng: mutable MT19937&, low: i64, high: i64, avoid: i64) -> i64:
        can Abort.Panic:
            got: mutable i64 = py_randint(rng, low, high)
            while got == avoid |got, low, high, rng|:
                got <- py_randint(rng, low, high)
            return got

    # `3 + 4`. The bottom of the ladder, and it should be.
    def build_add(out: mutable Problem&, grade: AlgebraGrade&, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            high: mutable i64 = 1
            for _each in 0..<dial(grade.digits, 1) |high|:
                high <- high * 10
            high <- high - 1
            left: i64 = py_randint(rng, 1, high)
            right: i64 = py_randint(rng, 1, high)
            out.asked_n <- 0
            put_i64(out, left)
            put_space(out)
            put_byte(out, 43)
            put_space(out)
            put_i64(out, right)
            Q::set_i64(&out.answer, left + right)
            out.answer_kind <- NUMBER
            Big::set_i64(&out.space, 4 * high + 1)
            out.steps <- 1
            out.wants <- WANT_NOTHING
            return true

    # `12 - 5 + 3`. Three terms, so the order has to be kept.
    def build_chain(out: mutable Problem&, grade: AlgebraGrade&, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            high: i64 = dial(grade.high, 20)
            one: i64 = py_randint(rng, 2, high)
            two: i64 = py_randint(rng, 2, high)
            three: i64 = py_randint(rng, 2, high)
            out.asked_n <- 0
            put_i64(out, one)
            put_space(out)
            put_byte(out, 45)
            put_space(out)
            put_i64(out, two)
            put_space(out)
            put_byte(out, 43)
            put_space(out)
            put_i64(out, three)
            Q::set_i64(&out.answer, one - two + three)
            out.answer_kind <- NUMBER
            Big::set_i64(&out.space, 4 * high + 1)
            out.steps <- 2
            out.wants <- WANT_NOTHING
            return true

    # `3 + 4 x 2`. Small numbers, one real idea: which goes first.
    def build_precedence(out: mutable Problem&, grade: AlgebraGrade&, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            high: i64 = dial(grade.high, 9)
            one: i64 = py_randint(rng, 2, high)
            two: i64 = py_randint(rng, 2, high)
            three: i64 = py_randint(rng, 2, high)
            out.asked_n <- 0
            put_i64(out, one)
            put_space(out)
            put_byte(out, 43)
            put_space(out)
            put_i64(out, two)
            put_space(out)
            put_times(out)
            put_space(out)
            put_i64(out, three)
            Q::set_i64(&out.answer, one + two * three)
            out.answer_kind <- NUMBER
            Big::set_i64(&out.space, 2 * (high * high + high) + 1)
            out.steps <- 2
            out.wants <- WANT_NOTHING
            return true

    # `-7 + 12 x (-3)`. The idea is the sign, not the size.
    def build_signs(out: mutable Problem&, grade: AlgebraGrade&, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            high: i64 = dial(grade.high, 12)
            one: i64 = 0 - py_randint(rng, 2, high)
            two: i64 = py_randint(rng, 2, high)
            three: i64 = 0 - py_randint(rng, 2, high)
            out.asked_n <- 0
            put_i64(out, one)
            put_space(out)
            put_byte(out, 43)
            put_space(out)
            put_i64(out, two)
            put_space(out)
            put_times(out)
            put_space(out)
            put_byte(out, 40)
            put_i64(out, three)
            put_byte(out, 41)
            Q::set_i64(&out.answer, one + two * three)
            out.answer_kind <- NUMBER
            Big::set_i64(&out.space, 2 * (high * high + high) + 1)
            out.steps <- 2
            out.wants <- WANT_NOTHING
            return true

    # The rows and columns of the fraction rung's search, derived from the
    # rung's own dial rather than fixed, because the grid has to CONTAIN the
    # answer: two denominators of nine can make a seventy-second, and a grid
    # forty rows deep silently failed to crack one deal in six -- which read as
    # difficulty and was a bug.
    def fraction_rows(grade: AlgebraGrade&) -> i64:
        high: i64 = dial(grade.high, 9)
        return high * high

    def fraction_span(grade: AlgebraGrade&) -> i64:
        return dial(grade.high, 9) * fraction_rows(grade)

    def gcd_i64(left: i64, right: i64) -> i64:
        a: mutable i64 = left if left >= 0 else 0 - left
        b: mutable i64 = right if right >= 0 else 0 - right
        while b != 0 |a, b|:
            held: i64 = b
            b <- a % b
            a <- held
        return a

    # `2/3 + 3/4`. Exact, and the answer is a fraction too.
    #
    # The denominators are forced apart and the total forced off a whole
    # number. Left to chance, a third of these came out as `3/2 + 7/2` -- one
    # denominator, integer answer -- which is the previous rung in a costume.
    def build_fractions(out: mutable Problem&, grade: AlgebraGrade&, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            high: i64 = dial(grade.high, 9)
            one: mutable Q::Frac = Q::zero()
            two: mutable Q::Frac = Q::zero()
            total: mutable Q::Frac = Q::zero()
            settled: mutable bool = false
            held: mutable bool = false
            for _try in 0..<200 |one, two, total, settled, held, high, rng|:
                break if settled
                below: i64 = py_randint(rng, 2, high)
                other: i64 = py_randint(rng, 2, high)
                continue if below == other
                Q::from_pair(&one, py_randint(rng, 1, high), below)
                Q::from_pair(&two, py_randint(rng, 1, high), other)
                false return if not Q::add(&total, &one, &two)
                held <- true
                settled <- true if not Q::is_integer(&total) and not Q::is_integer(&one) and not Q::is_integer(&two)
            # Python leaks the loop's names, so a run that never settled hands
            # on whatever the last un-skipped turn left behind.
            false return if not held
            out.asked_n <- 0
            put_frac(out, &one)
            put_space(out)
            put_byte(out, 43)
            put_space(out)
            put_frac(out, &two)
            Q::copy(&out.answer, &total)
            out.answer_kind <- NUMBER
            Big::set_i64(&out.space, fraction_rows(grade) * (2 * fraction_span(grade) + 1))
            out.steps <- 2
            out.wants <- WANT_NOTHING
            return true

    # `3(x - 2) + 5 = 2x + 9`. Built from the answer outwards.
    def build_linear(out: mutable Problem&, grade: AlgebraGrade&, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            high: i64 = dial(grade.high, 9)
            answer: i64 = py_randint(rng, 0 - high, high)
            left_slope: i64 = pick(rng, 2, high, -1)
            right_slope: i64 = pick(rng, 1, high - 1, left_slope)
            shift: i64 = py_randint(rng, 0 - high, high)
            trailing: i64 = py_randint(rng, 0 - high, high)
            # left_slope*(x + shift) + trailing  ==  right_slope*x + rest
            rest: i64 = (left_slope - right_slope) * answer + left_slope * shift + trailing
            out.asked_n <- 0
            put_i64(out, left_slope)
            put_byte(out, 40)
            put_byte(out, 120)
            put_space(out)
            put_sign_and_size(out, shift)
            put_byte(out, 41)
            put_space(out)
            put_sign_and_size(out, trailing)
            put_space(out)
            put_byte(out, 61)
            put_space(out)
            put_i64(out, right_slope)
            put_byte(out, 120)
            put_space(out)
            put_sign_and_size(out, rest)
            Q::set_i64(&out.answer, answer)
            out.answer_kind <- NUMBER
            Big::set_i64(&out.space, 2 * high + 1)
            out.steps <- 3
            out.wants <- WANT_X
            return true

    # A product of small factors, minus another, collected.
    #
    # The answer is a polynomial rather than a number, and the question is
    # deliberately LONGER than its answer so that copying it back fails
    # `collected` even though it would pass on normal form.
    def build_linear_piece(out: mutable Expressions::Poly&, letters: i64, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            drawn: i64 = py_randint(rng, -4, 4)
            # `rng.randint(-4, 4) or 2`: a zero constant would leave a factor
            # with no constant term at all.
            Expressions::set_constant_i64(out, drawn if drawn != 0 else 2)
            step: mutable Expressions::Poly = Expressions::zero()
            scaled: mutable Expressions::Poly = Expressions::zero()
            held: mutable Expressions::Poly = Expressions::zero()
            for name in 0..<letters |out, step, scaled, held, rng|:
                Expressions::set_variable(&step, name)
                Expressions::set_constant_i64(&held, py_randint(rng, 1, 3))
                false return if not Expressions::mul(&scaled, &step, &held)
                false return if not Expressions::add(&held, out, &scaled)
                Expressions::copy(out, &held)
            return true

    def build_expand(out: mutable Problem&, grade: AlgebraGrade&, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            degree: i64 = dial(grade.degree, 1)
            letters: i64 = dial(grade.letters, 1)
            band: i64 = dial(grade.band, 16)
            product: mutable Expressions::Poly = Expressions::zero()
            piece: mutable Expressions::Poly = Expressions::zero()
            taken: mutable Expressions::Poly = Expressions::zero()
            step: mutable Expressions::Poly = Expressions::zero()
            held: mutable Expressions::Poly = Expressions::zero()
            answer: mutable Expressions::Poly = Expressions::zero()
            pieces: mutable darray[u8] = Bytes::zeros(MOST_ASKED)
            text: mutable darray[u8] = Bytes::zeros(MOST_ASKED)
            settled: mutable bool = false
            written: mutable i64 = 0
            for _try in 0..<400 |out, product, piece, taken, step, held, answer, pieces, text, settled, written, degree, letters, band, rng|:
                break if settled
                Expressions::set_constant_i64(&product, 1)
                written <- 0
                for _each in 0..<degree |product, piece, step, pieces, written, letters, rng|:
                    false return if not build_linear_piece(&piece, letters, rng)
                    Bytes::put(&pieces, written, 40.u8())
                    written <- written + 1
                    span: i64 = Expressions::render(&piece, &text)
                    for index in 0..<span |pieces, text, written|:
                        Bytes::put(&pieces, written + index, Bytes::at_ref(&text, index))
                    written <- written + span
                    Bytes::put(&pieces, written, 41.u8())
                    written <- written + 1
                    false return if not Expressions::mul(&step, &product, &piece)
                    Expressions::copy(&product, &step)
                false return if not build_linear_piece(&piece, letters, rng)
                Expressions::set_constant_i64(&held, py_randint(rng, 1, 3))
                false return if not Expressions::mul(&taken, &piece, &held)
                false return if not Expressions::sub(&answer, &product, &taken)
                # Two guards, both found by measuring rather than by thinking.
                # A quarter of the easiest rung's deals used to collapse to one
                # term or to nothing, which is not a collecting exercise; and an
                # answer outside the declared band would sit outside the space
                # `crack` searches, making that column a measure of nothing.
                continue if answer.count < 2
                widest: mutable bool = false
                ceiling: Q::Frac = Q::from_i64(band)
                for term in 0..<answer.count |answer, widest, ceiling|:
                    size: mutable Q::Frac = Q::zero()
                    Q::abs_of(&size, &answer.coefficient[term.usize()])
                    widest <- true if Q::cmp(&size, &ceiling) > 0
                continue if widest
                settled <- true
            false return if not settled
            out.asked_n <- 0
            put_bytes(out, &pieces, written)
            put_space(out)
            put_byte(out, 45)
            put_space(out)
            put_byte(out, 40)
            put_bytes(out, &text, Expressions::render(&taken, &text))
            put_byte(out, 41)
            Expressions::copy(&out.answer_poly, &answer)
            out.answer_kind <- EXPRESSION
            base: Big::Int = Big::from_i64(2 * band + 1)
            Big::set_i64(&out.space, 1)
            lifted: mutable Big::Int = Big::zero()
            for _term in 0..<answer.count |out, lifted, base|:
                false return if not Big::mul(&lifted, &out.space, &base)
                Big::copy(&out.space, &lifted)
            out.steps <- degree + 1
            out.wants <- WANT_EXPAND
            return true

    # `7x = 3 (mod 26)`. One solution, because gcd(a, m) is one.
    def build_congruence(out: mutable Problem&, grade: AlgebraGrade&, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            modulus: i64 = dial(grade.modulus, 60)
            ceiling: i64 = 4 if 4 > modulus - 1 else modulus - 1
            base: mutable i64 = 0
            multiplier: mutable i64 = 0
            settled: mutable bool = false
            while not settled |base, multiplier, settled, ceiling, modulus, rng|:
                base <- py_randint(rng, 3, ceiling)
                multiplier <- py_randint(rng, 2, modulus - 1)
                settled <- gcd_i64(multiplier, base) == 1
            answer: i64 = py_randrange(rng, 0, base)
            right: i64 = (multiplier * answer) % base
            out.asked_n <- 0
            put_i64(out, multiplier)
            put_byte(out, 120)
            put_space(out)
            put_byte(out, 61)
            put_space(out)
            put_i64(out, right)
            # TWO spaces before the modulus, which is what `_congruence_checks`
            # splits the question on.
            put_space(out)
            put_space(out)
            put_byte(out, 40)
            put_byte(out, 109)
            put_byte(out, 111)
            put_byte(out, 100)
            put_space(out)
            put_i64(out, base)
            put_byte(out, 41)
            Q::set_i64(&out.answer, answer)
            out.answer_kind <- NUMBER
            Big::set_i64(&out.space, base)
            out.steps <- 2
            out.wants <- WANT_SMALLEST_X
            return true

    # Small primes, so the moduli of a CRT rung are coprime by construction
    # rather than by a check that might not fire.
    const PRIME_COUNT: i64 = 30

    def prime_at(index: i64) -> i64:
        return 7 if index == 0
        return 11 if index == 1
        return 13 if index == 2
        return 17 if index == 3
        return 19 if index == 4
        return 23 if index == 5
        return 29 if index == 6
        return 31 if index == 7
        return 37 if index == 8
        return 41 if index == 9
        return 43 if index == 10
        return 47 if index == 11
        return 53 if index == 12
        return 59 if index == 13
        return 61 if index == 14
        return 67 if index == 15
        return 71 if index == 16
        return 73 if index == 17
        return 79 if index == 18
        return 83 if index == 19
        return 89 if index == 20
        return 97 if index == 21
        return 101 if index == 22
        return 103 if index == 23
        return 107 if index == 24
        return 109 if index == 25
        return 113 if index == 26
        return 127 if index == 27
        return 131 if index == 28
        return 137

    # Trial division. The moduli here are five digits at the most.
    def is_prime(number: i64) -> bool:
        false return if number < 2
        return number == 2 if number % 2 == 0
        step: mutable i64 = 3
        while step * step <= number |step, number|:
            false return if number % step == 0
            step <- step + 2
        return true

    # `count` distinct primes with `digits` digits.
    #
    # The size of the moduli is the whole of what makes the top rung superhuman
    # rather than merely tedious: six two-digit primes put the answer in a box
    # of 10^9, which is a long afternoon for a laptop that only knows how to
    # guess. Six five-digit primes put it in 10^28, which is not.
    def primes_near(out: mutable darray[i64]&, digits: i64, count: i64, rng: mutable MT19937&) -> bool:
        can Abort.Panic:
            low: mutable i64 = 1
            for _each in 0..<(digits - 1) |low|:
                low <- low * 10
            high: mutable i64 = low * 10 - 1
            found: mutable i64 = 0
            while found < count |found, out, low, high, rng|:
                candidate: i64 = py_randint(rng, low, high) | 1
                seen: mutable bool = false
                for index in 0..<found |out, candidate, seen|:
                    seen <- true if Ints::at_ref(out, index) == candidate
                continue if seen
                continue if not is_prime(candidate)
                Ints::put(out, found, candidate)
                found <- found + 1
            return true

    # `pow(value, -1, modulus)`: the inverse by the extended Euclid, which the
    # coprimality above guarantees exists.
    def inverse_mod(value: i64, modulus: i64) -> i64:
        old_r: mutable i64 = value % modulus
        r: mutable i64 = modulus
        old_s: mutable i64 = 1
        s: mutable i64 = 0
        while r != 0 |old_r, r, old_s, s|:
            quotient: i64 = old_r / r
            held: i64 = old_r - quotient * r
            old_r <- r
            r <- held
            held_s: i64 = old_s - quotient * s
            old_s <- s
            s <- held_s
        return ((old_s % modulus) + modulus) % modulus

    # The n below `one_mod * two_mod` agreeing with both congruences.
    def combine(out: mutable Big::Int&, one: Big::Int&, one_mod: Big::Int&, two: i64, two_mod: i64) -> bool:
        can Memory.Allocate, Abort.Panic:
            inverse: i64 = inverse_mod(Big::mod_i64(one_mod, two_mod), two_mod)
            gap: mutable Big::Int = Big::zero()
            small: Big::Int = Big::from_i64(two)
            false return if not Big::sub(&gap, &small, one)
            scaled: mutable Big::Int = Big::zero()
            false return if not Big::mul_i64(&scaled, &gap, inverse)
            step: i64 = Big::mod_i64(&scaled, two_mod)
            lifted: mutable Big::Int = Big::zero()
            false return if not Big::mul_i64(&lifted, one_mod, step)
            return Big::add(out, one, &lifted)

    # Congruences over coprime moduli: one answer in a very large box.
    #
    # This is the honest shape of a superhuman rung. The box is the product of
    # the moduli, so it is enormous and the answer is unique in it BY THE
    # REMAINDER THEOREM rather than by hoping. Nothing about it is a bigger
    # sum: the numbers on the page stay two digits.
    def build_crt(out: mutable Problem&, grade: AlgebraGrade&, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            count: i64 = dial(grade.moduli, 3)
            digits: i64 = dial(grade.digits, 2)
            out.moduli_n <- count
            if digits <= 2:
                picks: darray[i64] = py_sample_range(rng, 0, PRIME_COUNT - 1, count)
                for index in 0..<count |out, picks|:
                    Ints::put(&out.moduli, index, prime_at(Ints::at(picks, index)))
            else:
                false return if not primes_near(&out.moduli, digits, count, rng)
            product: mutable Big::Int = Big::from_i64(1)
            lifted: mutable Big::Int = Big::zero()
            for index in 0..<count |out, product, lifted|:
                false return if not Big::mul_i64(&lifted, &product, Ints::at_ref(&out.moduli, index))
                Big::copy(&product, &lifted)
            answer: mutable Big::Int = Big::zero()
            false return if not Big::randbelow(&answer, &product, rng)
            out.asked_n <- 0
            for index in 0..<count |out, answer|:
                if index > 0:
                    put_byte(out, 44)
                    put_space(out)
                    put_space(out)
                put_byte(out, 110)
                put_space(out)
                put_byte(out, 61)
                put_space(out)
                modulus: i64 = Ints::at_ref(&out.moduli, index)
                put_i64(out, Big::mod_i64(&answer, modulus))
                put_space(out)
                put_byte(out, 40)
                put_byte(out, 109)
                put_byte(out, 111)
                put_byte(out, 100)
                put_space(out)
                put_i64(out, modulus)
                put_byte(out, 41)
            # The remainder theorem, run forwards, and checked against the
            # answer it was built from -- which is the reference's own
            # `ArithmeticError` and not a decoration.
            running: mutable Big::Int = Big::from_i64(0)
            running_mod: mutable Big::Int = Big::from_i64(1)
            step: mutable Big::Int = Big::zero()
            for index in 0..<count |out, answer, running, running_mod, step|:
                modulus: i64 = Ints::at_ref(&out.moduli, index)
                false return if not combine(&step, &running, &running_mod, Big::mod_i64(&answer, modulus), modulus)
                Big::copy(&running, &step)
                false return if not Big::mul_i64(&step, &running_mod, modulus)
                Big::copy(&running_mod, &step)
            false return if Big::cmp(&running, &answer) != 0
            Q::from_big(&out.answer, &answer)
            out.answer_kind <- NUMBER
            Big::copy(&out.space, &product)
            out.steps <- count
            out.wants <- WANT_SMALLEST_N
            return true

    # --- checked forwards, by something that did not build it -------------
    #
    # Deliberately not the generator's own arithmetic run again. For a
    # congruence it reduces; for an expression it substitutes numbers into both
    # sides; for a sum it RE-READS the printed question with the parser a
    # player's answer goes through. A generator that verifies itself proves
    # only that it is consistent.

    # Where `needle` next sits in `text`, or -1.
    def find_from(text: mutable darray[u8]&, length: i64, needle: mutable darray[u8]&, span: i64, first: i64) -> i64:
        can Abort.Panic:
            return -1 if span == 0 or span > length
            for at in first..<(length - span + 1) |text, needle, span|:
                same: mutable bool = true
                for step in 0..<span |text, needle, at, same|:
                    same <- false if Bytes::at_ref(text, at + step) != Bytes::at_ref(needle, step)
                at return if same
            return -1

    def set_needle(out: mutable darray[u8]&, one: i64, two: i64, three: i64, four: i64, five: i64, six: i64, span: i64) -> i64:
        can Abort.Panic:
            Bytes::put(out, 0, one.u8())
            Bytes::put(out, 1, two.u8())
            Bytes::put(out, 2, three.u8())
            Bytes::put(out, 3, four.u8())
            Bytes::put(out, 4, five.u8())
            Bytes::put(out, 5, six.u8())
            return span

    # The decimal number sitting between two offsets, sign and all.
    def read_i64(text: mutable darray[u8]&, first: i64, last: i64) -> i64:
        can Abort.Panic:
            at: mutable i64 = first
            negative: mutable bool = false
            if at < last and Bytes::at_ref(text, at).i64() == 45:
                negative <- true
                at <- at + 1
            held: mutable i64 = 0
            while at < last |at, held, text|:
                byte: i64 = Bytes::at_ref(text, at).i64()
                break if byte < 48 or byte > 57
                held <- held * 10 + byte - 48
                at <- at + 1
            return 0 - held if negative
            return held

    # Re-read the printed sum with the player's own parser. Which is the point:
    # the question a person sees is the question that gets checked, so a
    # generator that prints something other than what it computed is caught
    # here rather than by the player.
    def sum_checks(out: mutable Problem&, reader: mutable Expressions::Reader&, work: mutable Expressions::Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            head: mutable darray[u8] = Bytes::zeros(MOST_ASKED)
            span: mutable i64 = 0
            at: mutable i64 = 0
            while at < out.asked_n |at, span, head, out|:
                byte: i64 = Bytes::at_ref(&out.asked, at).i64()
                # `asked.replace(TIMES, '*')`, where TIMES is two bytes.
                if byte == 195 and at + 1 < out.asked_n and Bytes::at_ref(&out.asked, at + 1).i64() == 151:
                    Bytes::put(&head, span, 42.u8())
                    span <- span + 1
                    at <- at + 2
                    continue
                Bytes::put(&head, span, byte.u8())
                span <- span + 1
                at <- at + 1
            false return if not Expressions::parse(work, &head, span, reader)
            value: mutable Q::Frac = Q::zero()
            false return if not Expressions::constant_value(&value, work)
            return Q::equal(&value, &out.answer)

    def linear_checks(out: mutable Problem&, reader: mutable Expressions::Reader&,
                      left: mutable Expressions::Poly&, right: mutable Expressions::Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            needle: mutable darray[u8] = Bytes::zeros(8)
            span: i64 = set_needle(&needle, 32, 61, 32, 0, 0, 0, 3)
            cut: i64 = find_from(&out.asked, out.asked_n, &needle, span, 0)
            false return if cut < 0
            head: mutable darray[u8] = Bytes::zeros(MOST_ASKED)
            for index in 0..<cut |head, out|:
                Bytes::put(&head, index, Bytes::at_ref(&out.asked, index))
            false return if not Expressions::parse(left, &head, cut, reader)
            rest: i64 = out.asked_n - cut - span
            for index in 0..<rest |head, out, cut, span|:
                Bytes::put(&head, index, Bytes::at_ref(&out.asked, cut + span + index))
            false return if not Expressions::parse(right, &head, rest, reader)
            at: mutable Expressions::Assign = Expressions::new_assign()
            Expressions::assign(&at, Expressions::NAME_X, &out.answer)
            one: mutable Q::Frac = Q::zero()
            two: mutable Q::Frac = Q::zero()
            false return if not Expressions::evaluate(&one, left, &at)
            false return if not Expressions::evaluate(&two, right, &at)
            return Q::equal(&one, &two)

    def congruence_checks(out: mutable Problem&) -> bool:
        can Memory.Allocate, Abort.Panic:
            needle: mutable darray[u8] = Bytes::zeros(8)
            cut: i64 = find_from(&out.asked, out.asked_n, &needle, set_needle(&needle, 32, 61, 32, 0, 0, 0, 3), 0)
            false return if cut < 0
            # `left.strip().rstrip('x')`
            multiplier: i64 = read_i64(&out.asked, 0, cut)
            mod_at: i64 = find_from(&out.asked, out.asked_n, &needle, set_needle(&needle, 32, 32, 40, 109, 111, 100, 6), cut)
            false return if mod_at < 0
            value: i64 = read_i64(&out.asked, cut + 3, mod_at)
            base: i64 = read_i64(&out.asked, mod_at + 7, out.asked_n)
            false return if not Q::is_integer(&out.answer)
            false return if not Big::is_i64(&out.answer.num)
            answer: i64 = Big::to_i64(&out.answer.num)
            return answer >= 0 and answer < base and (multiplier * answer) % base == value

    def crt_checks(out: mutable Problem&) -> bool:
        can Memory.Allocate, Abort.Panic:
            false return if not Q::is_integer(&out.answer)
            false return if out.answer.num.negative
            needle: mutable darray[u8] = Bytes::zeros(8)
            at: mutable i64 = 0
            for _part in 0..<out.moduli_n |out, at, needle|:
                cut: i64 = find_from(&out.asked, out.asked_n, &needle, set_needle(&needle, 32, 61, 32, 0, 0, 0, 3), at)
                false return if cut < 0
                # `left.strip() != 'n'`
                false return if cut - at != 1 or Bytes::at_ref(&out.asked, at).i64() != 110
                mod_at: i64 = find_from(&out.asked, out.asked_n, &needle, set_needle(&needle, 32, 40, 109, 111, 100, 32, 6), cut)
                false return if mod_at < 0
                value: i64 = read_i64(&out.asked, cut + 3, mod_at)
                close: i64 = find_from(&out.asked, out.asked_n, &needle, set_needle(&needle, 41, 0, 0, 0, 0, 0, 1), mod_at)
                false return if close < 0
                modulus: i64 = read_i64(&out.asked, mod_at + 6, close)
                false return if Big::mod_i64(&out.answer.num, modulus) != value
                # `asked.split(',  ')`: the bracket, then a comma and TWO
                # spaces, so the next congruence's own `n` is four on.
                at <- close + 4
            return true

    # Substitute random numbers into the question and the answer.
    def expression_checks(out: mutable Problem&, reader: mutable Expressions::Reader&, stated: mutable Expressions::Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            false return if not Expressions::parse(stated, &out.asked, out.asked_n, reader)
            false return if out.answer_kind != EXPRESSION
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, 1234.u64())
            at: mutable Expressions::Assign = Expressions::new_assign()
            for _each in 0..<8 |out, stated, at, rng|:
                # `{name: Fraction(rng.randint(-6, 6)) for name in ('x','y','z','n')}`
                # -- four draws, in that order.
                for name in 0..<Expressions::NAME_COUNT |at, rng|:
                    held: Q::Frac = Q::from_i64(py_randint(&rng, -6, 6))
                    Expressions::assign(&at, name, &held)
                one: mutable Q::Frac = Q::zero()
                two: mutable Q::Frac = Q::zero()
                false return if not Expressions::evaluate(&one, stated, &at)
                false return if not Expressions::evaluate(&two, &out.answer_poly, &at)
                false return if not Q::equal(&one, &two)
            return true

    def checks_out(out: mutable Problem&, reader: mutable Expressions::Reader&,
                   left: mutable Expressions::Poly&, right: mutable Expressions::Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            family: i64 = out.grade.family
            return expression_checks(out, reader, left) if family == FAM_EXPAND
            return crt_checks(out) if family == FAM_CRT
            return congruence_checks(out) if family == FAM_CONGRUENCE
            return linear_checks(out, reader, left, right) if family == FAM_LINEAR
            return sum_checks(out, reader, left)

    # --- dealing ----------------------------------------------------------

    def build_one(out: mutable Problem&, grade: AlgebraGrade&, rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            family: i64 = grade.family
            return build_add(out, grade, rng) if family == FAM_ADD
            return build_chain(out, grade, rng) if family == FAM_CHAIN
            return build_precedence(out, grade, rng) if family == FAM_PRECEDENCE
            return build_signs(out, grade, rng) if family == FAM_SIGNS
            return build_fractions(out, grade, rng) if family == FAM_FRACTIONS
            return build_linear(out, grade, rng) if family == FAM_LINEAR
            return build_expand(out, grade, rng) if family == FAM_EXPAND
            return build_congruence(out, grade, rng) if family == FAM_CONGRUENCE
            return build_crt(out, grade, rng) if family == FAM_CRT
            return false

    # One problem at this grade, checked forwards before it is handed over.
    def deal_one(out: mutable Problem&, grade: AlgebraGrade&, reader: mutable Expressions::Reader&,
                 left: mutable Expressions::Poly&, right: mutable Expressions::Poly&,
                 rng: mutable MT19937&) -> bool:
        can Memory.Allocate, Abort.Panic:
            out.dealt <- false
            out.grade <- AlgebraGrade{family: grade.family, kind: grade.kind, digits: grade.digits,
                               high: grade.high, degree: grade.degree, letters: grade.letters,
                               band: grade.band, modulus: grade.modulus, moduli: grade.moduli}
            for _try in 0..<20 |out, grade, reader, left, right, rng|:
                continue if not build_one(out, grade, rng)
                continue if not checks_out(out, reader, left, right)
                out.dealt <- true
                return true
            return false

    def generate(out: mutable Problem&, level: i64, seed: i64, reader: mutable Expressions::Reader&,
                 left: mutable Expressions::Poly&, right: mutable Expressions::Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            grade: AlgebraGrade = grade_of(level)
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            return deal_one(out, &grade, reader, left, right, &rng)

    # --- marking ----------------------------------------------------------

    # Whether the typed text is the answer AND ALREADY GATHERED UP.
    #
    # Normal form alone would accept the question back, because a question and
    # its own answer are the same polynomial. So a symbolic answer must also be
    # written out: no brackets, and no more written terms than the collected
    # form has. Ordering is free -- `4 + 3x` and `3x + 4` both pass -- and so
    # is an explicit times sign, which changes no term count.
    #
    # A LEADING sign is stripped before the terms are counted, because `-2x - 1`
    # is two terms and not three, and a run of signs counts once, because
    # `1 + -11x` is also two. Allowing a spare term instead -- which is what
    # this did first -- let `y + y + 3` through as a gathered form of `2y + 3`,
    # which is the one thing the function exists to refuse.
    def collected(typed: mutable darray[u8]&, length: i64, terms: i64) -> bool:
        can Memory.Allocate, Abort.Panic:
            body: mutable darray[u8] = Bytes::zeros(MOST_ASKED)
            span: mutable i64 = 0
            for index in 0..<length |typed, body, span|:
                byte: i64 = Bytes::at_ref(typed, index).i64()
                false return if byte == 40 or byte == 41
                continue if Expressions::is_space(byte)
                Bytes::put(&body, span, byte.u8())
                span <- span + 1
            first: mutable i64 = 0
            while first < span and (Bytes::at_ref(&body, first).i64() == 43 or Bytes::at_ref(&body, first).i64() == 45) |first, span, body|:
                first <- first + 1
            written: mutable i64 = 1
            inside: mutable bool = false
            for index in first..<span |body, written, inside|:
                byte: i64 = Bytes::at_ref(&body, index).i64()
                if byte == 43 or byte == 45:
                    written <- written + 1 if not inside
                    inside <- true
                else:
                    inside <- false
            return written <= terms

    # Whether the typed text answers this problem. Exact, with no tolerance.
    def correct(out: mutable Problem&, typed: mutable darray[u8]&, length: i64,
                reader: mutable Expressions::Reader&, work: mutable Expressions::Poly&) -> bool:
        can Memory.Allocate, Abort.Panic:
            blank: mutable bool = true
            for index in 0..<length |typed, blank|:
                blank <- false if not Expressions::is_space(Bytes::at_ref(typed, index).i64())
            false return if length == 0 or blank
            false return if not Expressions::parse(work, typed, length, reader)
            if out.grade.kind == NUMBER:
                value: mutable Q::Frac = Q::zero()
                false return if not Expressions::constant_value(&value, work)
                return Q::equal(&value, &out.answer)
            false return if out.answer_kind != EXPRESSION
            false return if not Expressions::equal(work, &out.answer_poly)
            return collected(typed, length, out.answer_poly.count)

    # --- the solver that knows no mathematics -----------------------------

    const WALK_COEFFICIENTS: i64 = 0
    const WALK_UPWARD: i64 = 1
    const WALK_FRACTIONS: i64 = 2
    const WALK_OUTWARD: i64 = 3

    # How a checker-only solver would sensibly search this rung.
    #
    # Not a detail: a rung that says SMALLEST N >= 0 is searched upwards, and
    # one whose answer may be negative is searched outwards from zero.
    # Searching a congruence outwards would throw away half of every step and
    # report the rung as twice as hard as it is.
    def walk_of(grade: AlgebraGrade&) -> i64:
        return WALK_COEFFICIENTS if grade.kind == EXPRESSION
        return WALK_UPWARD if grade.family == FAM_CRT or grade.family == FAM_CONGRUENCE
        return WALK_FRACTIONS if grade.family == FAM_FRACTIONS
        return WALK_OUTWARD

    # Where a value sits in `_outwards`: 0, 1, -1, 2, -2, ... counting from one.
    def outward_seen(value: i64) -> i64:
        return 1 if value == 0
        return 2 * value if value > 0
        return 2 * (0 - value) + 1

    # Search the answer space, checking rather than reasoning. Returns how many
    # candidates it looked at, or -1 if it ran out of budget. This is the
    # ladder: what a rung gives away to somebody who cannot do the maths at
    # all, only recognise the answer on tripping over it.
    #
    # Each walk below is the reference's loop in closed form. The loops are
    # enumerations of a fixed order over a space whose only interesting member
    # is the answer, so where the answer falls in that order IS the count -- and
    # a hundred thousand exact-rational comparisons to rediscover it is a
    # stopwatch measuring itself. Every one of them is checked against the
    # reference's own walk by the differential, at every rung.
    def crack(out: mutable Problem&, budget: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            ceiling: mutable i64 = budget
            if Big::is_i64(&out.space):
                held: i64 = Big::to_i64(&out.space)
                ceiling <- held if held < budget
            walk: i64 = walk_of(&out.grade)
            return crack_expression(out, ceiling) if walk == WALK_COEFFICIENTS
            # Every other walk compares whole numbers or exact fractions with
            # the answer, so an answer that is not one is never met.
            if walk == WALK_UPWARD:
                -1 return if not Q::is_integer(&out.answer) or out.answer.num.negative
                -1 return if not Big::is_i64(&out.answer.num)
                held: i64 = Big::to_i64(&out.answer.num)
                return held + 1 if held < ceiling
                return -1
            if walk == WALK_FRACTIONS:
                rows: i64 = fraction_rows(&out.grade)
                span: i64 = fraction_span(&out.grade)
                # A denominator smaller than the answer's own cannot spell it,
                # because the pair is already in lowest terms -- so the first
                # row that matches is the answer's denominator, and the column
                # is where its numerator sits in the outward walk.
                -1 return if not Big::is_i64(&out.answer.den) or not Big::is_i64(&out.answer.num)
                denominator: i64 = Big::to_i64(&out.answer.den)
                numerator: i64 = Big::to_i64(&out.answer.num)
                size: i64 = numerator if numerator >= 0 else 0 - numerator
                -1 return if denominator > rows or size > span
                seen: i64 = (denominator - 1) * (2 * span + 1) + outward_seen(numerator)
                return seen if seen <= ceiling
                return -1
            span: i64 = ceiling / 2 + 1
            -1 return if not Q::is_integer(&out.answer)
            -1 return if not Big::is_i64(&out.answer.num)
            value: i64 = Big::to_i64(&out.answer.num)
            size: i64 = value if value >= 0 else 0 - value
            -1 return if size > span
            seen: i64 = outward_seen(value)
            return seen if seen <= ceiling
            return -1

    # Every polynomial on the answer's monomials, coefficients banded.
    #
    # The band is the rung's own declared one, so the space searched is the
    # space counted, and the answer is guaranteed to be inside it -- the
    # generator refuses to deal one that is not.
    #
    # `_bands` counts with the FIRST monomial slowest, so the answer's place in
    # it is its coefficients read as digits in base `2 * band + 1`, each digit
    # being where that coefficient sits in the outward walk. The monomials are
    # ordered by `str(mono)`, which is what the reference sorts them by.
    def crack_expression(out: mutable Problem&, ceiling: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            -1 return if out.answer_kind != EXPRESSION
            band: i64 = dial(out.grade.band, 16)
            count: i64 = out.answer_poly.count
            order: mutable darray[i64] = Ints::zeros(Expressions::MOST_TERMS)
            sort_by_repr(&out.answer_poly, &order)
            width: i64 = 2 * band + 1
            index: mutable i64 = 0
            for step in 0..<count |out, order, index, band, width, ceiling|:
                term: i64 = Ints::at_ref(&order, step)
                held: mutable Q::Frac = Q::zero()
                Q::copy(&held, &out.answer_poly.coefficient[term.usize()])
                -1 return if not Q::is_integer(&held)
                -1 return if not Big::is_i64(&held.num)
                value: i64 = Big::to_i64(&held.num)
                size: i64 = value if value >= 0 else 0 - value
                -1 return if size > band
                # Saturating, because the whole space is 289^10 at the top rung
                # and the only question asked of it is whether it is inside a
                # stopwatch of two hundred thousand.
                -1 return if index > ceiling
                index <- index * width + (0 if value == 0 else (2 * size - 1 if value > 0 else 2 * size))
            return index + 1 if index + 1 <= ceiling and index >= 0
            return -1

    # `sorted(answer.terms, key=lambda mono: str(mono))` -- the repr of the
    # tuple of pairs, compared as a string.
    def sort_by_repr(value: Expressions::Poly&, order: mutable darray[i64]&):
        can Memory.Allocate, Abort.Panic:
            for term in 0..<value.count |order|:
                Ints::put(order, term, term)
            left: mutable darray[u8] = Bytes::zeros(64)
            right: mutable darray[u8] = Bytes::zeros(64)
            for index in 1..<value.count |order, value, left, right|:
                held: i64 = Ints::at_ref(order, index)
                at: mutable i64 = index - 1
                placing: mutable bool = true
                while placing and at >= 0 |order, value, left, right, at, placing, held|:
                    one: i64 = Expressions::mono_repr(value, Ints::at_ref(order, at), &left)
                    two: i64 = Expressions::mono_repr(value, held, &right)
                    after: mutable bool = false
                    decided: mutable bool = false
                    limit: i64 = one if one < two else two
                    for step in 0..<limit |left, right, after, decided|:
                        continue if decided
                        a: i64 = Bytes::at_ref(&left, step).i64()
                        b: i64 = Bytes::at_ref(&right, step).i64()
                        continue if a == b
                        after <- a > b
                        decided <- true
                    after <- one > two if not decided
                    if after:
                        Ints::put(order, at + 1, Ints::at_ref(order, at))
                        at <- at - 1
                    else:
                        placing <- false
                Ints::put(order, at + 1, held)

    # Whether the single commonest guess would have got it. Zero is the answer
    # a guesser should try first on every numeric rung, so this is the floor
    # below the floor and it belongs in the table rather than in a footnote.
    def guessable(out: mutable Problem&) -> bool:
        return false if out.grade.kind == EXPRESSION
        return Q::is_zero(&out.answer)
