include "./gunslinger.elisa"
include "../pymath.elisa"
include "../tone_pcm.elisa"

module GunslingerAudio:
    struct Instrument:
        patch: TonePcm::Patch
        fm_ratio: f64
        fm_index: f64
        fm_decay: f64
        drive: f64
        glide: f64
        glide_time: f64

    # Patch parameters from Gunslinger's original per-voice seeds.
    def wood() -> Instrument:
        partials: TonePcm::Partial[6] = [
                TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
                TonePcm::Partial{ratio: 3.7574020552038365, gain: 0.5, decay: 6.0},
                TonePcm::Partial{ratio: 9.519639037982254, gain: 0.25, decay: 12.0},
                zeroed,
                zeroed,
                zeroed]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 3, attack: 0.002,
            decay: 9.474794314157906, release: 0.05, sustain: 0.0,
            tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 0.0, fm_index: 0.0, fm_decay: 0.0,
            drive: 0.0, glide: 0.0, glide_time: 0.0}

    def growl() -> Instrument:
        partials: TonePcm::Partial[6] = [
                TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
                zeroed,
                zeroed,
                zeroed,
                zeroed,
                zeroed]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 1, attack: 0.02,
            decay: 1.5, release: 0.1, sustain: 0.5,
            tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 0.5, fm_index: 4.3648274175114, fm_decay: 0.5,
            drive: 2.723913743529675, glide: 0.0, glide_time: 0.0}

    def pluck() -> Instrument:
        partials: TonePcm::Partial[6] = [
                TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 1.4213893881275674},
                TonePcm::Partial{ratio: 2.0, gain: 0.5, decay: 2.842778776255135},
                TonePcm::Partial{ratio: 3.0, gain: 0.3333333333333333, decay: 4.264168164382703},
                TonePcm::Partial{ratio: 4.0, gain: 0.25, decay: 5.68555755251027},
                TonePcm::Partial{ratio: 5.0, gain: 0.2, decay: 7.106946940637837},
                TonePcm::Partial{ratio: 6.0, gain: 0.16666666666666666, decay: 8.528336328765405}]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 6, attack: 0.003,
            decay: 4.035383380236762, release: 0.1, sustain: 0.0,
            tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 0.0, fm_index: 0.0, fm_decay: 0.0,
            drive: 0.0, glide: 0.0, glide_time: 0.0}

    def bell() -> Instrument:
        partials: TonePcm::Partial[6] = [
                TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
                TonePcm::Partial{ratio: 2.716289563660519, gain: 0.5, decay: 1.0},
                TonePcm::Partial{ratio: 5.271425795090752, gain: 0.25, decay: 2.0},
                zeroed,
                zeroed,
                zeroed]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 3, attack: 0.002,
            decay: 1.6439454344446525, release: 0.4, sustain: 0.0,
            tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 3.478172230948243, fm_index: 2.792983362481446, fm_decay: 2.5,
            drive: 0.0, glide: 0.0, glide_time: 0.0}

    def brass() -> Instrument:
        partials: TonePcm::Partial[6] = [
                TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
                TonePcm::Partial{ratio: 2.0, gain: 0.5, decay: 0.0},
                TonePcm::Partial{ratio: 3.0, gain: 0.3333333333333333, decay: 0.0},
                TonePcm::Partial{ratio: 4.0, gain: 0.25, decay: 0.0},
                TonePcm::Partial{ratio: 5.0, gain: 0.2, decay: 0.0},
                TonePcm::Partial{ratio: 6.0, gain: 0.16666666666666666, decay: 0.0}]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 6, attack: 0.04,
            decay: 1.0, release: 0.1, sustain: 0.6,
            tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 1.0, fm_index: 1.5368705084669108, fm_decay: 3.0,
            drive: 0.0, glide: -0.03, glide_time: 0.05}

    def pad() -> Instrument:
        partials: TonePcm::Partial[6] = [
                TonePcm::Partial{ratio: 1.0, gain: 0.7, decay: 0.0},
                TonePcm::Partial{ratio: 1.00876004050257, gain: 0.7, decay: 0.0},
                TonePcm::Partial{ratio: 2.0, gain: 0.3, decay: 0.0},
                TonePcm::Partial{ratio: 0.5, gain: 0.3, decay: 0.0},
                zeroed,
                zeroed]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 4, attack: 0.15,
            decay: 0.3, release: 0.3, sustain: 0.8,
            tremolo_rate: 3.1931724253918365, tremolo_depth: 0.3}
        return Instrument{patch: patch, fm_ratio: 0.0, fm_index: 0.0, fm_decay: 0.0,
            drive: 0.0, glide: 0.0, glide_time: 0.0}

    def sub_bass() -> Instrument:
        partials: TonePcm::Partial[6] = [
                TonePcm::Partial{ratio: 0.5, gain: 1.0, decay: 0.0},
                TonePcm::Partial{ratio: 1.0, gain: 0.5, decay: 0.0},
                zeroed,
                zeroed,
                zeroed,
                zeroed]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 2, attack: 0.01,
            decay: 2.0, release: 0.1, sustain: 0.3,
            tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 0.0, fm_index: 0.0, fm_decay: 0.0,
            drive: 1.5, glide: 0.0, glide_time: 0.0}

    def play_cue(stereo: mutable darray[f64]&, frames: i64, begin: f64, end: f64,
                instrument: Instrument, cue: Gunslinger::Cue):
        can Abort.Panic:
            voice: mutable TonePcm::Patch = instrument.patch
            parts: mutable TonePcm::Partial[6] = zeroed
            count: mutable i64 = 0
            bright: f64 = pow(0.8, 0.7)
            for i in 0..<voice.count |voice, cue, bright, parts, count|:
                part: TonePcm::Partial = voice.partials[i.usize()]
                if part.ratio * cue.pitch < 0.42 * TonePcm::RATE.f64():
                    parts[count.usize()] <- TonePcm::Partial{ratio: part.ratio,
                        gain: part.gain if part.ratio < 1.5 else part.gain * bright, decay: part.decay}
                    count <- count + 1
            voice <- TonePcm::Patch{partials: parts, count: count, attack: voice.attack,
                decay: voice.decay, release: voice.release, sustain: voice.sustain, tremolo_rate: voice.tremolo_rate, tremolo_depth: voice.tremolo_depth}
            overtone: TonePcm::Partial = TonePcm::Partial{ratio: 7.0, gain: 0.14285714285714285 * bright, decay: 0.0} if cue.voice == Gunslinger::CROW and 7.0 * cue.pitch < 0.42 * TonePcm::RATE.f64() else zeroed
            fx: TonePcm::Modulation = TonePcm::Modulation{fm_ratio: instrument.fm_ratio,
                fm_index: instrument.fm_index * (0.4 + 0.6 * 0.8), fm_decay: instrument.fm_decay,
                drive: instrument.drive, ring_ratio: 0.0, ring_mix: 0.0, extra_partial: overtone}
            note: TonePcm::Note = TonePcm::Note{onset: cue.time, duration: cue.duration, frequency: cue.pitch,
                pan: cue.pan, end_pan: cue.pan, gain: cue.gain, end_gain: cue.gain, vibrato_rate: 0.0, vibrato_depth: 0.0,
                noise: 0.0, glide: instrument.glide, glide_time: instrument.glide_time, seed: cue.seed}
            TonePcm::mix_note(stereo, frames, begin, end, &voice, &note, fx)

    def render(run: Gunslinger::Run&, begin: f64, end: f64, dest: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 0 if not (end > begin and end - begin <= 120.0)
            frames: i64 = py_round_half_even((end - begin) * TonePcm::RATE.f64())
            return 0 if frames < 1 or frames > capacity / TonePcm::FRAME_BYTES
            instruments: Instrument[7] = [wood(), growl(), pluck(), bell(), brass(), pad(), sub_bass()]
            stereo: mutable darray[f64] = TonePcm::empty(frames)
            for cue in run.notes |begin, end, stereo, frames, instruments|:
                instrument: Instrument = instruments[cue.voice.usize()]
                continue if cue.time >= end or cue.time + (cue.duration + instrument.patch.release) <= begin
                play_cue(&stereo, frames, begin, end, instrument, cue)
            return TonePcm::write(stereo, frames, dest)
