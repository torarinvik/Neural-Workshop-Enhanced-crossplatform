include "../pyrandom.elisa"
include "../strings.elisa"
include "./ints.elisa"
include "./pyset.elisa"

module Notebook:
    const FACT: i64 = 0
    const UPDATE: i64 = 1
    const NOISE: i64 = 2
    const QUESTION: i64 = 3
    const MOST_LINES: i64 = 8
    const MOST_CHOICES: i64 = 4
    const SPARE: i64 = 160
    const CARD_CAPACITY: i64 = 360

    struct Grade:
        rung: i64
        facts: i64
        hold: i64
        gap: i64
        choices: i64
        noise: i64
        updates: i64
        lines: i64

    struct Card:
        kind: i64
        key: i64
        code: i64
        choices: i64[4]
        answer: i64

    struct Deal:
        seed: i64
        level: Grade
        # Up to 160 named cards, 16 questions, five updates, and at most
        # eight filler cards per fact or update while a question becomes due.
        cards: mutable Card[360]
        count: mutable i64

    struct Note:
        key: i64
        code: i64

    struct Round:
        dealt: Deal
        at: mutable i64
        lines: mutable Note[8]
        given: mutable i64
        right: mutable i64

    struct Fact:
        key: i64
        initial: i64
        code: mutable i64
        shown_at: mutable i64
        waiting: mutable bool

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        half: i64 = (r - 1) / 2
        hold: i64 = 1 + half if half < MOST_LINES else MOST_LINES
        trimmed: i64 = hold - (r - 14) / 2
        lines: i64 = hold + 1 if r < 6 else (hold if r <= 15 else (trimmed if trimmed > 0 else 1))
        return Grade{rung: r, facts: r + (r - 1) / 3 if r < 13 else 16, hold: hold,
            gap: half if half < 8 else 8, choices: 2 if r < 3 else MOST_CHOICES,
            noise: 0 if r < 6 else 1 + (r - 6) / 4,
            updates: 0 if r < 8 else (1 + (r - 8) / 3 if r < 20 else 5), lines: lines}

    def thing(index: i64) -> cstr:
        return "Gate" if index == 0
        return "Locker" if index == 1
        return "Room" if index == 2
        return "Bus" if index == 3
        return "Safe" if index == 4
        return "Desk" if index == 5
        return "Bay" if index == 6
        return "Door" if index == 7
        return "Spare"

    def tree(index: i64) -> cstr:
        return "Maple" if index == 0
        return "Ivy" if index == 1
        return "Cedar" if index == 2
        return "Birch" if index == 3
        return "Fern" if index == 4
        return "Hazel" if index == 5
        return "Rowan" if index == 6
        return "Willow" if index == 7
        return "Aspen" if index == 8
        return "Holly" if index == 9
        return "Juniper" if index == 10
        return "Laurel" if index == 11
        return "Myrtle" if index == 12
        return "Olive" if index == 13
        return "Pine" if index == 14
        return "Sage" if index == 15
        return "Thorn" if index == 16
        return "Elm" if index == 17
        return "Alder" if index == 18
        return "Larch"

    def name(key: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_cstr(out, thing(key / 20))
            dstr_append_cstr(out, " ")
            dstr_append_cstr(out, tree(key % 20))

    struct SipState:
        a: mutable u64
        b: mutable u64
        c: mutable u64
        d: mutable u64

    def rotate(x: u64, bits: u64) -> u64:
        return (x << bits) | (x >> (64.u64() - bits))

    def sip_round(s: mutable SipState&):
        s.a <- s.a + s.b
        s.b <- rotate(s.b, 13.u64()) ^ s.a
        s.a <- rotate(s.a, 32.u64())
        s.c <- s.c + s.d
        s.d <- rotate(s.d, 16.u64()) ^ s.c
        s.a <- s.a + s.d
        s.d <- rotate(s.d, 21.u64()) ^ s.a
        s.c <- s.c + s.b
        s.b <- rotate(s.b, 17.u64()) ^ s.c
        s.c <- rotate(s.c, 32.u64())

    # CPython 3.13 uses SipHash13 for ASCII strings. A zero hash secret
    # reproduces PYTHONHASHSEED=0, independent of process start order.
    def name_hash(key: i64) -> u64:
        can Memory.Allocate, Abort.Panic:
            text: mutable dstr = []
            name(key, &text)
            state: mutable SipState = SipState{a: 0x736f6d6570736575, b: 0x646f72616e646f6d,
                c: 0x6c7967656e657261, d: 0x7465646279746573}
            word: mutable u64 = 0.u64()
            shift: mutable u64 = 0.u64()
            for at in 0..<text.count.i64() |text, word, shift, state|:
                word <- word | (text[at.usize()].u64() << shift)
                shift <- shift + 8.u64()
                if shift == 64.u64():
                    state.d <- state.d ^ word
                    sip_round(&state)
                    state.a <- state.a ^ word
                    shift <- 0.u64()
                    word <- 0.u64()
            word <- word | (text.count.u64() << 56.u64())
            state.d <- state.d ^ word
            sip_round(&state)
            state.a <- state.a ^ word
            state.c <- state.c ^ 255.u64()
            sip_round(&state)
            sip_round(&state)
            sip_round(&state)
            hash_value: u64 = state.a ^ state.b ^ state.c ^ state.d
            return 18446744073709551614.u64() if hash_value == 18446744073709551615.u64() else hash_value

    def fresh(rng: mutable MT19937&, used: mutable u8&) -> i64:
        can Abort.Panic:
            while true |rng, used|:
                code: i64 = py_randint(rng, 100, 999)
                if used[code.usize()] == 0.u8():
                    used[code.usize()] <- 1.u8()
                    return code

    def plain(kind: i64, key: i64, code: i64) -> Card:
        return Card{kind: kind, key: key, code: code, choices: zeroed, answer: -1}

    def question(rng: mutable MT19937&, facts: Fact[16]&, count: i64, selected: i64, choices: i64) -> Card:
        can Memory.Allocate, Abort.Panic:
            subject: Fact = facts[selected.usize()]
            others: mutable darray[i64] = []
            for index in 0..<count |facts, others, selected|:
                if index != selected:
                    fact: Fact = facts[index.usize()]
                    others.push(fact.initial)
                    if fact.code != fact.initial:
                        others.push(fact.code)
            py_shuffle_i64(rng, &others)
            offered: mutable darray[i64] = []
            offered.push(subject.code)
            if subject.initial != subject.code:
                offered.push(subject.initial)
            for code in others |offered, choices|:
                break if offered.count.i64() == choices
                offered.push(code)
            while offered.count.i64() < choices |offered, rng, choices|:
                code: i64 = py_randint(rng, 100, 999)
                seen: mutable bool = false
                for choice in offered |seen, code|:
                    seen <- true if choice == code
                offered.push(code) if not seen
            py_shuffle_i64(rng, &offered)
            codes: mutable i64[4] = zeroed
            answer: mutable i64 = -1
            for index in 0..<choices |codes, offered, subject, answer|:
                code: i64 = offered[index.usize()]
                codes[index.usize()] <- code
                answer <- index if code == subject.code
            return Card{kind: QUESTION, key: subject.key, code: subject.code, choices: codes, answer: answer}

    def append(dealt: mutable Deal&, card: Card):
        can Abort.Panic:
            dealt.cards[dealt.count.usize()] <- card
            dealt.count <- dealt.count + 1

    def deal(rung: i64, seed: i64) -> Deal:
        can Memory.Allocate, Abort.Panic:
            level: Grade = grade(rung)
            rng: mutable MT19937 = mt19937_new()
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            names: mutable darray[i64] = []
            for key in 0..<SPARE |names|:
                names.push(key)
            py_shuffle_i64(&rng, &names)
            updates: darray[i64] = py_sample_range(&rng, 0, level.facts - 1, level.updates)
            marked: mutable u8[160] = zeroed
            for index in updates |names, marked|:
                marked[names[index.usize()].usize()] <- 1.u8()
            positions: darray[i64] = py_sample_range(&rng, 0, level.facts + level.noise - 1, level.noise)
            noise_at: mutable u8[360] = zeroed
            for position in positions |noise_at|:
                noise_at[position.usize()] <- 1.u8() if position < CARD_CAPACITY
            pending: mutable PySet::Table = PySet::new(16)
            if level.updates > 0:
                for key in 0..<SPARE |pending|:
                    pending.hashes.push(name_hash(key))
            due: mutable darray[i64] = Ints::zeros(16)
            facts: mutable Fact[16] = zeroed
            used: mutable u8[1000] = zeroed
            dealt: mutable Deal = Deal{seed: seed, level: level, cards: zeroed, count: 0}
            shown: mutable i64 = 0
            waiting: mutable i64 = 0
            noise: mutable i64 = level.facts + level.noise if level.facts + level.noise < SPARE else SPARE
            while shown < level.facts or waiting > 0 |shown, waiting, noise, facts, used, dealt, rng, level, names, noise_at, pending, due, marked|:
                at: i64 = dealt.count
                ready: mutable i64[16] = zeroed
                ready_count: mutable i64 = 0
                for index in 0..<shown |facts, pending, level, at, ready, ready_count|:
                    fact: Fact = facts[index.usize()]
                    if fact.waiting and at - fact.shown_at > level.gap and not PySet::contains(&pending, fact.key):
                        ready[ready_count.usize()] <- index
                        ready_count <- ready_count + 1
                due_count: i64 = PySet::to_list(&pending, &due)
                roll: f64 = py_random(&rng)
                if due_count > 0 and roll < 0.35:
                    key: i64 = due[py_randbelow(&rng, due_count.u64()).usize()]
                    PySet::discard(&pending, key)
                    code: i64 = fresh(&rng, &used[0])
                    for index in 0..<shown |facts, key, code, at|:
                        if facts[index.usize()].key == key:
                            facts[index.usize()].code <- code
                            facts[index.usize()].shown_at <- at
                            break
                    append(&dealt, plain(UPDATE, key, code))
                elif noise > level.facts and noise_at[at.usize()] != 0.u8():
                    noise <- noise - 1
                    append(&dealt, plain(NOISE, names[noise.usize()], fresh(&rng, &used[0])))
                elif shown < level.facts and waiting < level.hold and (ready_count == 0 or roll < 0.55):
                    key: i64 = names[(level.facts - shown - 1).usize()]
                    code: i64 = fresh(&rng, &used[0])
                    facts[shown.usize()] <- Fact{key: key, initial: code, code: code, shown_at: at, waiting: true}
                    append(&dealt, plain(FACT, key, code))
                    shown <- shown + 1
                    waiting <- waiting + 1
                    if marked[key.usize()] != 0.u8():
                        PySet::add(&pending, key)
                elif ready_count > 0:
                    selected: i64 = ready[0] if roll < 0.5 else ready[py_randbelow(&rng, ready_count.u64()).usize()]
                    facts[selected.usize()].waiting <- false
                    waiting <- waiting - 1
                    append(&dealt, question(&rng, &facts, shown, selected, level.choices))
                elif due_count == 0:
                    key: mutable i64 = 0
                    if noise > level.facts:
                        noise <- noise - 1
                        key <- names[noise.usize()]
                    else:
                        key <- SPARE + py_randbelow(&rng, 20.u64()).i64()
                    append(&dealt, plain(NOISE, key, fresh(&rng, &used[0])))
            return dealt

    def initialize(dealt: Deal) -> Round:
        return Round{dealt: dealt, at: 0, lines: zeroed, given: 0, right: 0}

    def over(run: Round&) -> bool:
        return run.at >= run.dealt.count

    def write(run: mutable Round&, line: i64) -> bool:
        can Abort.Panic:
            return false if over(run) or line < 0 or line >= run.dealt.level.lines
            card: Card = run.dealt.cards[run.at.usize()]
            return false if card.kind == QUESTION
            run.lines[line.usize()] <- Note{key: card.key, code: card.code}
            return true

    def next(run: mutable Round&) -> bool:
        can Abort.Panic:
            return false if over(run)
            return false if run.dealt.cards[run.at.usize()].kind == QUESTION
            run.at <- run.at + 1
            return true

    # -1 means ignored, 0 means a miss, 1 means a correct answer.
    def answer(run: mutable Round&, choice: i64) -> i64:
        can Abort.Panic:
            return -1 if over(run) or choice < 0 or choice >= run.dealt.level.choices
            card: Card = run.dealt.cards[run.at.usize()]
            return -1 if card.kind != QUESTION
            right: bool = choice == card.answer
            run.right <- run.right + 1 if right
            run.given <- run.given + 1
            run.at <- run.at + 1
            return 1 if right else 0
