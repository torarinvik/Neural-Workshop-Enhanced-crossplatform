include "./morning_round_rules.elisa"
include "../strings.elisa"

module MorningRoundWords:
    def phrase(atom: i64) -> cstr:
        return "blue door" if atom == MorningRoundRules::BLUE
        return "red door" if atom == MorningRoundRules::RED
        return "green door" if atom == MorningRoundRules::GREEN
        return "yellow door" if atom == MorningRoundRules::YELLOW
        return "pointed roof" if atom == MorningRoundRules::POINTED
        return "dog" if atom == MorningRoundRules::DOG
        return "flag up" if atom == MorningRoundRules::FLAG
        return "lights on" if atom == MorningRoundRules::LIGHTS
        return "cat" if atom == MorningRoundRules::CAT
        return "left side" if atom == MorningRoundRules::LEFT_SIDE
        return "even number" if atom == MorningRoundRules::EVEN
        return "number divisible by 3" if atom == MorningRoundRules::THREE
        return "church block" if atom == MorningRoundRules::CHURCH
        return "star in the window"

    def describe(rule: MorningRoundRules::Rule&, index: i64, parenthesize: bool, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            node: MorningRoundRules::Node = rule.nodes[index.usize()]
            if node.op == MorningRoundRules::ATOM:
                dstr_append_cstr(words, phrase(node.a))
            elif node.op == MorningRoundRules::SAME:
                dstr_append_cstr(words, "door as the last on its side")
            elif node.op == MorningRoundRules::AND or node.op == MorningRoundRules::OR:
                dstr_append_cstr(words, "(") if parenthesize
                describe(rule, node.a, true, words)
                dstr_append_cstr(words, " and " if node.op == MorningRoundRules::AND else " or ")
                describe(rule, node.b, true, words)
                dstr_append_cstr(words, ")") if parenthesize
            else:
                if node.op == MorningRoundRules::NOT:
                    inner: MorningRoundRules::Node = rule.nodes[node.a.usize()]
                    dstr_append_cstr(words, "no " if inner.op == MorningRoundRules::ATOM and (inner.a == MorningRoundRules::DOG or inner.a == MorningRoundRules::CAT) else "not ")
                else:
                    dstr_append_cstr(words, "across from: " if node.op == MorningRoundRules::OPPOSITE else "every 2nd: ")
                describe(rule, node.a, true, words)
