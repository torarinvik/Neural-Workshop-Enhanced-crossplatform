include "../pyrandom.elisa"
include "../pymath.elisa"

module Dispatch:
    const SLOTS: i64 = 8
    const BURN: f64 = 10.0
    const WORK: f64 = 1.0
    const REFIT: f64 = 12.0

    struct Point:
        x: f64
        y: f64

    struct Grade:
        rung: i64
        crews: i64
        scout: bool
        false_rate: f64
        size_error: f64
        growth_low: f64
        growth_high: f64
        need_low: f64
        need_high: f64
        burst: i64
        lull_low: f64
        lull_high: f64
        length: f64
        refit: f64
        factor: f64
        grace: f64

    struct Report:
        at: f64
        x: f64
        y: f64
        need: f64
        growth: f64
        false_alarm: bool
        factor: f64

    struct Deal:
        level: Grade
        reports: darray[Report]

    def stations() -> Point[3]:
        return [Point{x: 0.22, y: 0.26}, Point{x: 0.78, y: 0.30}, Point{x: 0.50, y: 0.78}]

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        harder: f64 = fmin(7.0, 1.0 + 0.2 * (r - 1).f64())
        factor: f64 = fmax(1.0, 2.0 - (r - 1).f64() / 11.0) if r <= 20 else 1.0 / (1.0 + 0.04 * (r - 20).f64())
        burst: i64 = 1 + r / 3 if r < 15 else 6
        return Grade{rung: r, crews: 2 if r <= 4 else 3, scout: r >= 4,
            false_rate: 0.0 if r < 4 else fmin(0.5, 0.08 * (r - 3).f64()),
            size_error: 0.0 if r < 6 else fmin(0.6, 0.06 * (r - 5).f64()),
            growth_low: 0.10 * harder, growth_high: 0.18 * harder,
            need_low: 2.0 + fmin(1.0, 0.05 * (r - 1).f64()),
            need_high: 4.0 + fmin(2.0, 0.1 * (r - 1).f64()),
            burst: burst, lull_low: fmax(2.0, 9.0 - 0.4 * r.f64()),
            lull_high: fmax(4.0, 16.0 - 0.6 * r.f64()),
            length: fmin(100.0, 40.0 + 3.0 * r.f64()), refit: 0.0 if r < 8 else REFIT,
            factor: factor, grace: 3.0 if r <= 20 else 0.0}

    def longest_life(level: Grade) -> f64:
        return (BURN - level.need_low) / level.growth_low + BURN / WORK

    def schedule(level: Grade, rng: mutable MT19937&) -> darray[f64]:
        can Memory.Allocate, Abort.Panic:
            window: f64 = longest_life(level)
            times: mutable darray[f64] = []
            first: mutable usize = 0.usize()
            t: mutable f64 = py_uniform(rng, 2.0, 4.0)
            while t <= level.length |level, rng, window, times, first, t|:
                burst: i64 = 1 + py_randbelow(rng, level.burst.u64()).i64()
                for _ in 0..<burst |level, rng, window, times, first, t|:
                    while first < times.count and times[first] <= t - window |times, first, t, window|:
                        first <- first + 1.usize()
                    if times.count - first >= SLOTS.usize():
                        t <- times[first] + window + 0.1
                    break if t > level.length
                    times.push(t)
                    t <- t + py_uniform(rng, 0.3, 1.2)
                t <- t + py_uniform(rng, level.lull_low, level.lull_high)
            return times

    def sample_location(rng: mutable MT19937&) -> Point:
        can Abort.Panic:
            depots: Point[3] = stations()
            while true |rng, depots|:
                x: f64 = py_uniform(rng, 0.06, 0.94)
                y: f64 = py_uniform(rng, 0.06, 0.94)
                clear: mutable bool = true
                for depot in depots |x, y, clear|:
                    clear <- false if hypot(x - depot.x, y - depot.y) <= 0.09
                return Point{x: x, y: y} if clear

    def deal(rung: i64, rng: mutable MT19937&) -> Deal:
        can Memory.Allocate, Abort.Panic:
            level: Grade = grade(rung)
            times: darray[f64] = schedule(level, rng)
            reports: mutable darray[Report] = []
            for at in times |level, rng, reports|:
                point: Point = sample_location(rng)
                need: f64 = py_uniform(rng, level.need_low, level.need_high)
                growth: f64 = py_uniform(rng, level.growth_low, level.growth_high)
                false_alarm: bool = py_random(rng) < level.false_rate
                factor: f64 = 1.0 + py_uniform(rng, -level.size_error, level.size_error)
                reports.push(Report{at: at, x: point.x, y: point.y, need: need,
                    growth: growth, false_alarm: false_alarm, factor: factor})
            return Deal{level: level, reports: reports}
