include "./captcha.elisa"

module CaptchaGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const FLAGGED: i64 = 4
    const START: i64 = Captcha::PORTS
    const FEEDBACK_MS: i64 = 2500

    struct Session:
        rng: mutable MT19937
        owner: mutable Arena
        start_rung: i64
        total: i64
        adaptive: bool
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        puzzle: mutable Captcha::Puzzle
        typed: mutable u8[Captcha::LONGEST]
        length: mutable i64
        last_ms: mutable i64
        cursor: mutable bool
        deadline: mutable i64
        won: mutable bool
        passed: mutable i64
        best: mutable i64
        scored: mutable i64
        think_capacity: mutable f64
        think_refill: mutable f64
        think_left: mutable f64
        forfeits: mutable i64
        verdict_published: mutable bool
        stepped_seconds: mutable f64

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = zeroed
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            initial: i64 = rung if rung > 0 else 1
            return Session{rng: rng, owner: zeroed, start_rung: initial, total: trials, adaptive: adaptive,
                rung: initial, trial: 0, phase: READY, puzzle: zeroed, typed: zeroed, length: 0, last_ms: 0,
                cursor: false, deadline: 0, won: false, passed: 0, best: 0, scored: 0, think_capacity: 0.0,
                think_refill: 0.0, think_left: 0.0, forfeits: 0, verdict_published: false, stepped_seconds: 0.0}

    def release(session: mutable Session&):
        can Abort.Panic, Memory.Release:
            arena_free(&session.owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}
            session.puzzle <- zeroed
            session.length <- 0

    def deal_owned(owner: mutable Arena&, rung: i64, seed: i64) -> Captcha::Puzzle:
        can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
            in owner:
                return Captcha::deal(rung, seed)

    def next_trial(session: mutable Session&, now: i64):
        can Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
            release(session) can Global{Read,Write}
            session.last_ms <- now
            session.verdict_published <- false
            if session.trial >= session.total:
                session.phase <- DONE
                return
            seed: i64 = py_randbelow(&session.rng, 1073741824.u64()).i64()
            session.puzzle <- deal_owned(&session.owner, session.rung, seed)
            session.trial <- session.trial + 1
            session.phase <- PLAYING
            session.cursor <- (now / 500) % 2 == 0

    def valid_time(session: Session&, now: i64) -> bool:
        return now >= session.last_ms and now <= 9223372036854775807 - FEEDBACK_MS

    def correct(session: Session&) -> bool:
        can Abort.Panic:
            return false if session.length != session.puzzle.answer.count.i64()
            for i in 0..<session.length |session, i|:
                return false if session.typed[i.usize()] != session.puzzle.answer[i.usize()]
            return true

    def judge(session: mutable Session&, now: i64):
        can Abort.Panic:
            session.won <- correct(session)
            session.scored <- session.scored + 1
            if session.won:
                session.passed <- session.passed + 1
                session.best <- session.rung if session.rung > session.best
                session.rung <- session.rung + 1 if session.adaptive and session.rung < 9223372036854775807
            else:
                session.rung <- session.rung - 1 if session.adaptive and session.rung > 1
            session.deadline <- now + FEEDBACK_MS
            session.phase <- JUDGED

    def event(session: mutable Session&, port: i64, now: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
            return false if not valid_time(session, now)
            if port == START:
                return false if (session.phase != READY and session.phase != DONE) or session.total < 1
                session.rung <- session.start_rung
                session.trial <- 0
                session.passed <- 0
                session.best <- 0
                session.scored <- 0
                session.think_left <- session.think_capacity
                session.forfeits <- 0
                session.stepped_seconds <- 0.0
                next_trial(session, now) can Global{Read,Write}
                return true
            return false if session.phase != PLAYING or port < 0 or port >= Captcha::PORTS
            session.last_ms <- now
            if port == Captcha::SUBMIT:
                judge(session, now)
                return true
            if port == Captcha::BACKSPACE:
                session.length <- session.length - 1 if session.length > 0
            elif session.length < Captcha::LONGEST:
                session.typed[session.length.usize()] <- Captcha::alphabet_at(port)
                session.length <- session.length + 1
            session.cursor <- (now / 500) % 2 == 0
            return true

    def advance(session: mutable Session&, now: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
            return false if session.phase != JUDGED or now < session.deadline or not valid_time(session, now)
            next_trial(session, now) can Global{Read,Write}
            return true

    def configure_think(session: mutable Session&, capacity: f64, refill: f64) -> bool:
        return false if session.phase != READY or not (capacity >= 0.0 and capacity <= 1.7976931348623157e308)
        return false if not (refill >= 0.0 and refill <= 1.7976931348623157e308)
        session.think_capacity <- capacity
        session.think_refill <- Captcha::least(refill, capacity)
        session.think_left <- capacity
        return true

    def step(session: mutable Session&, elapsed_seconds: f64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
            now: f64 = session.stepped_seconds + elapsed_seconds
            return false if not (elapsed_seconds > 0.0 and now <= 9007199254740.0)
            return false if session.phase == READY or session.phase == DONE
            session.stepped_seconds <- now
            if session.phase == PLAYING:
                if session.think_capacity > 0.0:
                    session.think_left <- session.think_left - elapsed_seconds
                    if session.think_left <= 0.000000001:
                        session.think_left <- 0.0
                        session.forfeits <- session.forfeits + 1
                        session.phase <- FLAGGED
                return true
            if session.phase == JUDGED and not session.verdict_published:
                session.verdict_published <- true
                return true
            # The Python boundary deals after showing one verdict, including
            # a flag. A flag does not add a graded answer or change the rung.
            clock_ms: i64 = (now * 1000.0).i64()
            prior_ms: i64 = session.last_ms
            next_trial(session, clock_ms) can Global{Read,Write}
            session.last_ms <- prior_ms
            if session.phase == PLAYING:
                room: f64 = session.think_capacity - session.think_left
                session.think_left <- session.think_left + Captcha::least(room, session.think_refill)
            return true

    def close(session: mutable Session&):
        can Abort.Panic, Memory.Release:
            release(session) can Global{Read,Write}
            session.phase <- READY

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 10 or total == 20

    def info(session: Session&, field: i64) -> i64:
        return session.phase if field == 0
        return session.rung if field == 1
        return session.trial if field == 2
        return session.total if field == 3
        return session.length if field == 4
        return (1 if session.won else 0) if field == 5 and session.phase == JUDGED
        return session.passed if field == 6
        return session.best if field == 7
        return session.deadline if field == 8 and session.phase == JUDGED
        return session.forfeits if field == 9
        return -1
