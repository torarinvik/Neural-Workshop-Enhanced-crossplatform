include "./cipher_abyss_family.elisa"

extend CipherLang:
    const LOOKS: i64 = 80

    struct RivalSet:
        entries: darray[i64]

    struct FirstRule:
        output: darray[i64]
        entry: i64

    def row_hash(row: darray[i64]&) -> u64:
        hash: mutable u64 = 14695981039346656037.u64()
        for value in row:
            hash <- (hash ^ value.u64()) * 1099511628211.u64()
        return hash

    def find_output(slots: darray[i64]&, first: darray[FirstRule]&, row: darray[i64]&, mask: usize) -> usize:
        can Abort.Panic:
            slot: mutable usize = row_hash(row).usize() & mask
            while slots[slot] != 0 |slot, slots, first, row, mask|:
                prior: FirstRule& = &first[(slots[slot] - 1).usize()]
                break if same_row(row, &prior.output)
                slot <- (slot + 1.usize()) & mask
            return slot

    def one_input(program: darray[Node]&, rules: Rules&, input: darray[i64]&, k: i64, at: i64,
                  rejected: mutable darray[i64]&, matches: mutable darray[i64]&):
        can Abort.Panic, Memory.Allocate, Memory.Release:
            region scratch(1048576):
                in scratch:
                    capacity: mutable i64 = 1
                    while capacity <= 2 * rules.hypotheses.count.i64() |capacity, rules|:
                        capacity <- capacity * 2
                    mask: usize = (capacity - 1).usize()
                    slots: mutable darray[i64] = Ints::zeros(capacity)
                    first: mutable darray[FirstRule] = []
                    initial: State = zeroed
                    for entry in rules.hypotheses:
                        output: darray[i64] = run(program, entry, input, k, &initial)
                        slot: usize = find_output(&slots, &first, &output, mask)
                        if slots[slot] == 0:
                            slots[slot] <- first.count.i64() + 1
                            first.push(FirstRule{output: output, entry: entry})
                    for i in 0..<rules.truths.count.i64() |program, rules, input, k, at, rejected, matches, slots, first, initial, mask|:
                        continue if rejected[i.usize()] != 0
                        entry: i64 = rules.truths[i.usize()]
                        output: darray[i64] = run(program, entry, input, k, &initial)
                        slot: usize = find_output(&slots, &first, &output, mask)
                        rival: i64 = first[(slots[slot] - 1).usize()].entry
                        if rival == entry:
                            rejected[i.usize()] <- 1
                        else:
                            matches[(i * LOOKS + at).usize()] <- rival

    def one_look(program: darray[Node]&, rules: Rules&, level: CipherAbyss::Grade) -> darray[RivalSet]:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            # A truth is eligible only when a simpler candidate matches every
            # individual look. The matches retain their first-seen order.
            draw: mutable MT19937 = zeroed
            mt_seed_int(&draw, level.rung.u64() * 31.u64() + 7.u64())
            size: i64 = rules.truths.count.i64()
            rejected: mutable darray[i64] = Ints::zeros(size)
            matches: mutable darray[i64] = Ints::zeros(size * LOOKS)
            k: i64 = level.symbols
            input: mutable darray[i64] = Ints::zeros(level.length)
            for at in 0..<LOOKS |program, rules, k, draw, input, matches, rejected, level|:
                for i in 0..<level.length |input, draw, k|:
                    input[i.usize()] <- py_randbelow(&draw, k.u64()).i64()
                one_input(program, rules, &input, k, at, &rejected, &matches)
            out: mutable darray[RivalSet] = []
            for i in 0..<size |matches, rejected, out|:
                rivals: mutable darray[i64] = []
                if rejected[i.usize()] == 0:
                    for at in 0..<LOOKS |matches, i, rivals|:
                        entry: i64 = matches[(i * LOOKS + at).usize()]
                        found: mutable bool = false
                        for earlier in rivals:
                            if earlier == entry:
                                found <- true
                                break
                        rivals.push(entry) if not found
                out.push(RivalSet{entries: rivals})
            return out
