include "./drshape_puzzle.elisa"

module DrShapeGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = DrShape::MOST
    const UPDATE: i64 = -1
    const SUBSTEP: f64 = 1.0 / 30.0
    const FEEDBACK: f64 = 2.5
    const PENDING: i64 = 0
    const RIGHT: i64 = 1
    const WRONG: i64 = -1
    const TIMEOUT: i64 = -2

    struct Session:
        rng: mutable MT19937
        start_rung: i64
        total: i64
        adaptive: bool
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        owner: mutable Arena
        puzzle: mutable DrShapePuzzle::Puzzle
        elapsed: mutable f64
        heard_to: mutable f64
        last_tick: mutable f64
        deadline: mutable f64
        choice: mutable i64
        result: mutable i64
        passed: mutable i64
        best: mutable i64
        deal_failed: mutable bool
        verdict_published: mutable bool

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 10 or total == 20

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = zeroed
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            initial: i64 = rung if rung > 0 else 1
            return Session{rng: rng, start_rung: initial, total: total, adaptive: adaptive,
                rung: initial, trial: 0, phase: READY, owner: zeroed, puzzle: zeroed,
                elapsed: 0.0, heard_to: 0.0, last_tick: 0.0, deadline: 0.0,
                choice: -1, result: PENDING, passed: 0, best: 0, deal_failed: false, verdict_published: false}

    def release(owner: mutable Arena&):
        can Memory.Release, Abort.Panic:
            arena_free(owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}

    def make_trial(owner: mutable Arena&, rung: i64, seed: i64) -> DrShapePuzzle::Puzzle:
        can Memory.Allocate, Abort.Panic:
            in owner:
                return DrShapePuzzle::deal(rung, seed)

    def next_trial(session: mutable Session&, now: f64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            release(&session.owner) can Global{Read,Write}
            session.puzzle <- zeroed
            session.last_tick <- now
            session.elapsed <- 0.0
            session.heard_to <- 0.0
            session.choice <- -1
            session.result <- PENDING
            session.verdict_published <- false
            if session.trial >= session.total:
                session.phase <- DONE
                return true
            seed: i64 = py_randbelow(&session.rng, 1073741824.u64()).i64()
            session.puzzle <- make_trial(&session.owner, session.rung, seed)
            session.deal_failed <- session.puzzle.count == 0
            if session.deal_failed:
                session.phase <- READY
                return false
            session.trial <- session.trial + 1
            session.phase <- PLAYING
            return true

    def valid_time(session: Session&, now: f64) -> bool:
        return now >= session.last_tick and now <= 9007199254740.0

    def start(session: mutable Session&, now: f64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if session.phase != READY and session.phase != DONE
            return false if session.total <= 0 or not valid_time(session, now)
            session.rung <- session.start_rung
            session.trial <- 0
            session.passed <- 0
            session.best <- 0
            return next_trial(session, now) can Global{Read,Write}

    def close(session: mutable Session&):
        can Memory.Release, Abort.Panic:
            release(&session.owner) can Global{Read,Write}
            session.puzzle <- zeroed
            session.phase <- READY

    def choosing(session: Session&) -> bool:
        return session.elapsed >= session.puzzle.show_end

    def choose(session: mutable Session&, index: i64) -> bool:
        return false if session.phase != PLAYING or session.result != PENDING or not choosing(session)
        return false if index < 0 or index >= session.puzzle.count
        session.choice <- index
        session.result <- RIGHT if index == session.puzzle.answer else WRONG
        return true

    def judge(session: mutable Session&, now: f64):
        if session.result == RIGHT:
            session.passed <- session.passed + 1
            session.best <- session.rung if session.rung > session.best
            session.rung <- session.rung + 1 if session.adaptive and session.rung < 9223372036854775807
        else:
            session.rung <- session.rung - 1 if session.adaptive and session.rung > 1
        session.phase <- JUDGED
        session.deadline <- now + FEEDBACK

    def tick(session: mutable Session&, now: f64):
        can Abort.Panic:
            dt: f64 = DrShapeDeal::clamp(now - session.last_tick, 0.0, 0.1)
            session.last_tick <- now
            if session.result == PENDING:
                whole: i64 = ceil(dt / SUBSTEP).i64()
                steps: i64 = whole if whole > 0 else 1
                timeout: f64 = session.puzzle.show_end + session.puzzle.choose
                for i in 0..<steps |session, dt, steps, timeout|:
                    session.elapsed <- session.elapsed + dt / steps.f64()
                    if session.elapsed >= timeout:
                        session.result <- TIMEOUT
                        break
            if session.result != PENDING:
                judge(session, now)

    def advance(session: mutable Session&, now: f64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if not valid_time(session, now)
            if session.phase == PLAYING:
                tick(session, now)
                return true
            if session.phase == JUDGED and now >= session.deadline:
                return next_trial(session, now) can Global{Read,Write}
            return false

    def input(session: mutable Session&, action: i64, now: f64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if not valid_time(session, now)
            return (start(session, now) can Global{Read,Write}) if action == START
            return choose(session, action)

    def agent_event(session: mutable Session&, now: f64, port: i64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            return false if not valid_time(session, now)
            return (input(session, port, now) can Global{Read,Write}) if port >= 0
            return false if port != UPDATE
            if session.phase == PLAYING:
                tick(session, now)
                session.verdict_published <- session.phase == JUDGED
                return true
            if session.phase == JUDGED:
                return (next_trial(session, now) can Global{Read,Write}) if session.verdict_published
                session.verdict_published <- true
                return true
            return false

    def strokes(session: Session&) -> f64:
        can Abort.Panic:
            count: i64 = session.puzzle.match_cards.target.path.count
            prior: mutable f64 = DrShapePuzzle::LEAD_IN
            for i in 0..<count |session, prior|:
                end: f64 = session.puzzle.drawn_by[i.usize()]
                if session.elapsed < end:
                    portion: f64 = (session.elapsed - prior) / (end - prior)
                    return i.f64() + (portion if portion > 0.0 else 0.0)
                prior <- end
            return count.f64()

    def sounding(session: Session&) -> i64:
        can Abort.Panic:
            linger: f64 = 0.3 if DrShapePuzzle::scene(session.puzzle.mode) else 0.0
            for i in 0..<session.puzzle.span_count |session, linger|:
                span: DrShapePuzzle::Span = session.puzzle.spans[i.usize()]
                return span.who if session.elapsed >= span.start and session.elapsed <= span.end + linger
            return -1

    def audio_window(session: mutable Session&, dest: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 0 if session.phase != PLAYING and session.phase != JUDGED
            elapsed: f64 = session.elapsed - session.heard_to
            available: i64 = capacity / TonePcm::FRAME_BYTES
            return 0 if elapsed <= 0.0 or available < 1
            frames: i64 = py_round_half_even(elapsed * TonePcm::RATE.f64())
            return 0 if frames < 1
            end: f64 = session.elapsed if frames <= available else session.heard_to + available.f64() / TonePcm::RATE.f64()
            length: i64 = DrShapeAudio::write(&session.puzzle.notes, &session.puzzle.bank, session.heard_to, end, dest, capacity)
            session.heard_to <- end if length > 0
            return length

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            active: bool = session.phase == PLAYING or session.phase == JUDGED
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return py_round_half_even(session.elapsed * 1000.0) if field == 4 and active
            return session.puzzle.mode if field == 5 and active
            return session.puzzle.count if field == 6 and active
            return session.result if field == 7 and session.phase == JUDGED
            return session.passed if field == 8
            return session.best if field == 9
            return py_round_half_even(session.deadline * 1000.0) if field == 10 and session.phase == JUDGED
            return session.choice if field == 11 and session.phase == JUDGED
            return session.puzzle.answer if field == 12 and session.phase == JUDGED
            return 1 if field == 13 and session.deal_failed
            return 0 if field == 13
            return -1
