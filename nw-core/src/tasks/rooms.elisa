include "../pyrandom.elisa"

module Rooms:
    const MOVED: i64 = 0
    const GONE: i64 = 1
    const SWAPPED: i64 = 2
    const RECOLOURED: i64 = 3

    struct Grade:
        rung: i64
        rooms: i64
        things: i64
        cols: i64
        rows: i64
        changes: i64
        shared: bool
        turn_low: f64
        turn_high: f64
        near_move: bool

    struct Thing:
        cell: mutable i64
        kind: i64
        colour: mutable i64
        size: f64
        yaw: mutable f64

    struct Room:
        name: i64
        tint: i64
        things: mutable Thing[7]
        count: mutable i64

    struct Puzzle:
        seed: i64
        level: Grade
        rooms: Room[5]
        tested: i64
        changed: Room
        change: i64
        answer: i64[2]
        answer_count: i64
        angle: f64

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        return Grade{rung: r, rooms: 1 if r < 4 else (2 if r < 7 else (3 if r < 13 else (4 if r < 20 else 5))),
            things: 4 if r < 7 else (5 if r < 10 else (6 if r < 20 else 7)),
            cols: 4 if r < 10 else (5 if r < 20 else 6), rows: 3 if r < 10 else (4 if r < 20 else 5),
            changes: 2 if r < 7 else 4, shared: r >= 10,
            turn_low: 0.0 if r < 16 else (25.0 if r < 20 else 30.0),
            turn_high: 0.0 if r < 16 else (45.0 if r < 20 else 180.0), near_move: r >= 20}

    def name(index: i64) -> cstr:
        return "the study" if index == 0
        return "the kitchen" if index == 1
        return "the hall" if index == 2
        return "the bedroom" if index == 3
        return "the workshop"

    def colour(index: i64) -> u32:
        return 0xd66050ff if index == 0
        return 0x508cd6ff if index == 1
        return 0x60b068ff if index == 2
        return 0xe2b440ff if index == 3
        return 0xa068c4ff if index == 4
        return 0x5ababaff if index == 5
        return 0xe68cb4ff if index == 6
        return 0x787880ff

    def tint(index: i64) -> u32:
        return 0xece2ceff if index == 0
        return 0xd6e2ecff if index == 1
        return 0xdeecd6ff if index == 2
        return 0xecd8deff if index == 3
        return 0xe6e6d2ff

    def things(rng: mutable MT19937&, count: i64) -> Thing[7]:
        can Memory.Allocate, Abort.Panic:
            colours: darray[i64] = py_sample_range(rng, 0, 7, count)
            out: mutable Thing[7] = zeroed
            for index in 0..<count |rng, colours, out|:
                kind: i64 = py_randbelow(rng, 4.u64()).i64()
                size: f64 = 0.5 + 0.25 * py_random(rng)
                out[index.usize()] <- Thing{cell: 0, kind: kind, colour: colours[index.usize()], size: size, yaw: 0.0}
            return out

    def destination(rng: mutable MT19937&, level: Grade, taken: u8[30]&, from: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            free: mutable darray[i64] = []
            if level.near_move:
                row: i64 = from / level.cols
                col: i64 = from % level.cols
                if col + 1 < level.cols and taken[(from + 1).usize()] == 0.u8():
                    free.push(from + 1)
                if col > 0 and taken[(from - 1).usize()] == 0.u8():
                    free.push(from - 1)
                if row + 1 < level.rows and taken[(from + level.cols).usize()] == 0.u8():
                    free.push(from + level.cols)
                if row > 0 and taken[(from - level.cols).usize()] == 0.u8():
                    free.push(from - level.cols)
            if free.count == 0.usize():
                for cell in 0..<(level.cols * level.rows) |free, taken|:
                    if taken[cell.usize()] == 0.u8():
                        free.push(cell)
            return free[py_randbelow(rng, free.count.u64()).usize()]

    def deal(rung: i64, seed: i64) -> Puzzle:
        can Memory.Allocate, Abort.Panic:
            level: Grade = grade(rung)
            rng: mutable MT19937 = mt19937_new()
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            shared: Thing[7] = things(&rng, level.things)
            tints: mutable darray[i64] = [0, 1, 2, 3, 4]
            names: mutable darray[i64] = [0, 1, 2, 3, 4]
            py_shuffle_i64(&rng, &tints)
            py_shuffle_i64(&rng, &names)
            rooms: mutable Room[5] = zeroed
            for r in 0..<level.rooms |rng, level, rooms, shared, names, tints|:
                objects: mutable Thing[7] = shared if level.shared else things(&rng, level.things)
                spots: darray[i64] = py_sample_range(&rng, 0, level.cols * level.rows - 1, level.things)
                for i in 0..<level.things |rng, objects, spots|:
                    objects[i.usize()].cell <- spots[i.usize()]
                    objects[i.usize()].yaw <- 1.5707963267948966 * py_random(&rng)
                rooms[r.usize()] <- Room{name: names[r.usize()], tint: tints[r.usize()], things: objects, count: level.things}
            tested: i64 = py_randbelow(&rng, level.rooms.u64()).i64()
            changed: mutable Room = rooms[tested.usize()]
            change: i64 = py_randbelow(&rng, level.changes.u64()).i64()
            i: i64 = py_randbelow(&rng, level.things.u64()).i64()
            cell: i64 = changed.things[i.usize()].cell
            answer: mutable i64[2] = [cell, -1]
            if change == MOVED:
                taken: mutable u8[30] = zeroed
                for k in 0..<changed.count |changed, taken|:
                    taken[changed.things[k.usize()].cell.usize()] <- 1.u8()
                space_cell: i64 = destination(&rng, level, &taken, cell)
                changed.things[i.usize()].cell <- space_cell
                answer[0] <- space_cell
            elif change == GONE:
                for k in i..<(changed.count - 1) |changed|:
                    changed.things[k.usize()] <- changed.things[(k + 1).usize()]
                changed.count <- changed.count - 1
            elif change == SWAPPED:
                pick: i64 = py_randbelow(&rng, (level.things - 1).u64()).i64()
                j: i64 = pick + 1 if pick >= i else pick
                other: i64 = changed.things[j.usize()].cell
                changed.things[i.usize()].cell <- other
                changed.things[j.usize()].cell <- cell
                answer[0] <- cell if cell < other else other
                answer[1] <- other if cell < other else cell
            else:
                used: mutable u8[8] = zeroed
                for k in 0..<changed.count |changed, used|:
                    used[changed.things[k.usize()].colour.usize()] <- 1.u8()
                available: mutable darray[i64] = []
                for colour in 0..<8 |used, available|:
                    if used[colour.usize()] == 0.u8():
                        available.push(colour)
                changed.things[i.usize()].colour <- available[py_randbelow(&rng, available.count.u64()).usize()]
            degrees: f64 = level.turn_low + (level.turn_high - level.turn_low) * py_random(&rng)
            sign: f64 = 1.0 if py_randbelow(&rng, 2.u64()) == 0.u64() else -1.0
            return Puzzle{seed: seed, level: level, rooms: rooms, tested: tested,
                changed: changed, change: change, answer: answer, answer_count: 2 if change == SWAPPED else 1,
                angle: degrees * 0.017453292519943295 * sign}

    def correct(puzzle: Puzzle&, cell: i64) -> bool:
        can Abort.Panic:
            return cell == puzzle.answer[0] or (puzzle.answer_count == 2 and cell == puzzle.answer[1])
