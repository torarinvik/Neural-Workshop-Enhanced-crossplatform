include "./cipher_abyss.elisa"
include "./cipher_lang_family.elisa"

extend CipherLang:
    struct Rules:
        hypotheses: darray[i64]
        truths: darray[i64]

    def atomic(program: mutable darray[Node]&, op: i64, a: i64 = -1) -> i64:
        can Abort.Panic, Memory.Allocate:
            args: darray[i64] = [a] if a >= 0 else []
            return add_node(program, op, args, [])

    def seq1(program: mutable darray[Node]&, a: i64) -> i64:
        can Abort.Panic, Memory.Allocate:
            children: darray[i64] = [a]
            return add_node(program, SEQ, [], children)

    def pair(program: mutable darray[Node]&, op: i64, a: i64, b: i64) -> i64:
        can Abort.Panic, Memory.Allocate:
            children: darray[i64] = [a, b]
            return add_node(program, op, [], children)

    def triple(program: mutable darray[Node]&, op: i64, a: i64, b: i64, c: i64) -> i64:
        can Abort.Panic, Memory.Allocate:
            children: darray[i64] = [a, b, c]
            return add_node(program, op, [], children)

    def append_list(dest: mutable darray[i64]&, source: darray[i64]&, count: i64 = 9223372036854775807):
        can Abort.Panic, Memory.Allocate:
            stop: i64 = CipherAbyss::min(count, source.count.i64())
            for i in 0..<stop |dest, source|:
                dest.push(source[i.usize()])

    def wrapped(program: mutable darray[Node]&, entries: darray[i64]&) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            result: mutable darray[i64] = []
            for entry in entries:
                result.push(seq1(program, entry))
            return result

    def positions(program: mutable darray[Node]&, n: i64, rotations: bool = true) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            entries: mutable darray[i64] = []
            for op in [REV, SWAP, MIRROR, WEAVE, UNWEAVE] |program, entries|:
                entries.push(atomic(program, op))
            if rotations:
                for i in 1..<n |program, entries|:
                    entries.push(atomic(program, ROT, i))
            return entries

    def coprime(a: i64, b: i64) -> bool:
        left: mutable i64 = a
        right: mutable i64 = b
        while right != 0 |left, right|:
            remainder: i64 = left % right
            left <- right
            right <- remainder
        return left == 1

    def strides(program: mutable darray[Node]&, n: i64, entries: mutable darray[i64]&):
        can Abort.Panic, Memory.Allocate:
            for i in 2..<n |program, entries, n|:
                if coprime(i, n):
                    entries.push(atomic(program, STRIDE, i))

    def values(program: mutable darray[Node]&, k: i64, step: i64 = 9) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            entries: mutable darray[i64] = []
            for i in 1..<k |program, entries|:
                entries.push(atomic(program, SHIFT, i))
            for i in 2..<k |program, entries, k|:
                if coprime(i, k):
                    entries.push(atomic(program, MUL, i))
            if step >= 1 or k > 3:
                for op in [PREFIX, DIFF, SORT, RUNS] |program, entries|:
                    entries.push(atomic(program, op))
            if step >= 2 or k > 3:
                for i in 1..<k |program, entries|:
                    entries.push(atomic(program, ODDSHIFT, i))
                entries.push(atomic(program, FOLD))
            return entries

    def predicates(program: mutable darray[Node]&, k: i64, stateful: bool = false) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            entries: mutable darray[i64] = []
            for op in [FIRST, LAST, HAS] |program, entries, k|:
                for i in 0..<k |program, entries, op|:
                    entries.push(atomic(program, op, i))
            entries.push(atomic(program, EVENS, 0))
            entries.push(atomic(program, SUMEVEN))
            entries.push(atomic(program, RISES))
            if stateful:
                entries.push(atomic(program, TPARITY))
                for i in 0..<k |program, entries|:
                    entries.push(atomic(program, ECHO, i))
            return entries

    def permutations(program: mutable darray[Node]&, entries: mutable darray[i64]&, prefix: mutable darray[i64]&,
                     n: i64, op: i64, used: i64 = 0, identity: bool = true, include_identity: bool = false):
        can Abort.Panic, Memory.Allocate:
            length: i64 = prefix.count.i64()
            if length == n:
                if include_identity or not identity:
                    args: darray[i64] = sliced(prefix, 0, n)
                    entries.push(add_node(program, op, args, []))
                return
            for i in 0..<n |program, entries, prefix, op, used, identity, include_identity, n, length|:
                bit: i64 = 1 << i
                if (used & bit) == 0:
                    prefix.push(i)
                    permutations(program, entries, prefix, n, op, used | bit, identity and i == length, include_identity)
                    _ = prefix.pop()

    def toggled(program: mutable darray[Node]&, moves: darray[i64]&, flip: i64, odd: i64) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            out: mutable darray[i64] = []
            for piece in moves:
                out.push(seq1(program, piece))
                out.push(pair(program, SEQ, piece, flip))
                out.push(pair(program, SEQ, piece, odd))
            return out

    def patterns(program: mutable darray[Node]&, n: i64, step: i64) -> Rules:
        can Abort.Panic, Memory.Allocate:
            moves: mutable darray[i64] = []
            prefix: mutable darray[i64] = []
            permutations(program, &moves, &prefix, n, PERM, 0, true, true)
            shift: i64 = atomic(program, SHIFT, 1)
            odd: i64 = atomic(program, ODDSHIFT, 1)
            hypotheses: mutable darray[i64] = toggled(program, &moves, shift, odd)
            named: mutable darray[i64] = []
            truths: mutable darray[i64] = []
            if step == 0:
                named <- [atomic(program, REV), atomic(program, ROT, 1), atomic(program, ROT, 2), atomic(program, SWAP), shift]
                truths <- wrapped(program, &named)
            else:
                named <- positions(program, n)
                named.push(atomic(program, SORT))
                truths <- wrapped(program, &named) if step == 1 else toggled(program, &named, shift, odd)
                truths.push(seq1(program, shift))
                truths.push(seq1(program, odd))
            append_list(&hypotheses, &truths)
            return Rules{hypotheses: hypotheses, truths: truths}

    def transformations(program: mutable darray[Node]&, n: i64, k: i64) -> Rules:
        can Abort.Panic, Memory.Allocate:
            singles: mutable darray[i64] = positions(program, n)
            changes: darray[i64] = values(program, k)
            append_list(&singles, &changes)
            for a in 2..<k |program, singles, k|:
                for b in 1..<k |program, singles, a, k|:
                    if coprime(a, k):
                        args: darray[i64] = [a, b]
                        singles.push(add_node(program, AFFINE, args, []))
            tables: mutable darray[i64] = []
            prefix: mutable darray[i64] = []
            permutations(program, &tables, &prefix, n, PERM)
            if k <= 3:
                permutations(program, &tables, &prefix, k, SUB)
            targets: darray[i64] = wrapped(program, &singles)
            hypotheses: mutable darray[i64] = sliced(&targets, 0, targets.count.i64())
            for table in tables:
                hypotheses.push(seq1(program, table))
            return Rules{hypotheses: hypotheses, truths: targets}

    def combinations(program: mutable darray[Node]&, out: mutable darray[i64]&, choices: darray[i64]&, op: i64, trigger: i64 = -1):
        can Abort.Panic, Memory.Allocate:
            for a in choices:
                for b in choices:
                    if a != b:
                        value: i64 = pair(program, op, a, b) if trigger < 0 else triple(program, op, trigger, a, b)
                        out.push(value)

    def conditions(program: mutable darray[Node]&, n: i64, k: i64, step: i64) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            pieces: mutable darray[i64] = positions(program, n)
            changes: darray[i64] = values(program, k, step)
            append_list(&pieces, &changes, k + 1)
            choices: darray[i64] = wrapped(program, &pieces)
            tests: darray[i64] = predicates(program, k)
            out: mutable darray[i64] = []
            for check in tests:
                combinations(program, &out, &choices, IF, check)
            return out

    def composition(program: mutable darray[Node]&, n: i64, k: i64, step: i64) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            choices: mutable darray[i64] = positions(program, n)
            changes: darray[i64] = values(program, k, step)
            append_list(&choices, &changes)
            out: mutable darray[i64] = []
            combinations(program, &out, &choices, SEQ)
            return out

    def state_rules(program: mutable darray[Node]&, n: i64, k: i64, step: i64) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            choices: mutable darray[i64] = positions(program, n)
            alternating: mutable darray[i64] = sliced(&choices, 0, choices.count.i64())
            changes: darray[i64] = values(program, k)
            append_list(&choices, &changes)
            append_list(&alternating, &changes, 3)
            turns: mutable darray[i64] = []
            for c in 1..<k |program, turns|:
                turns.push(atomic(program, TSHIFT, c))
            out: mutable darray[i64] = []
            for a in choices:
                for b in turns:
                    out.push(pair(program, SEQ, a, b))
            pair_choices: darray[i64] = wrapped(program, &alternating)
            combinations(program, &out, &pair_choices, ALT)
            mem: i64 = atomic(program, MEM)
            for a in choices:
                out.push(pair(program, SEQ, a, mem))
            if step >= 1:
                turn: i64 = atomic(program, TPARITY)
                all_pieces: darray[i64] = wrapped(program, &choices)
                combinations(program, &out, &all_pieces, IF, turn)
            return out

    def command_meanings(program: mutable darray[Node]&, out: mutable darray[i64]&, symbols: darray[i64],
                         meanings: darray[i64]&, picked: mutable darray[i64]&, used: i64 = 0):
        can Abort.Panic, Memory.Allocate:
            if picked.count == symbols.count:
                children: darray[i64] = sliced(picked, 0, picked.count.i64())
                out.push(add_node(program, PROG, symbols, children))
                return
            for i in 0..<meanings.count.i64() |program, out, symbols, meanings, picked, used|:
                bit: i64 = 1 << i
                if (used & bit) == 0:
                    picked.push(meanings[i.usize()])
                    command_meanings(program, out, symbols, meanings, picked, used | bit)
                    _ = picked.pop()

    def hidden_language(program: mutable darray[Node]&, k: i64, step: i64) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            meanings: darray[i64] = [atomic(program, REV), atomic(program, SWAP), atomic(program, ROT, 1),
                atomic(program, SHIFT, 1), atomic(program, MIRROR), atomic(program, SORT),
                atomic(program, DIFF), atomic(program, MUL, 2)]
            out: mutable darray[i64] = []
            picked: mutable darray[i64] = []
            for a in 0..<k |program, meanings, out, picked, k, step|:
                for b in (a + 1)..<k |program, meanings, out, picked, k, step, a|:
                    if step < 2:
                        symbols: darray[i64] = [a, b]
                        command_meanings(program, &out, symbols, &meanings, &picked)
                    else:
                        for c in (b + 1)..<k |program, meanings, out, picked, a, b|:
                            symbols: darray[i64] = [a, b, c]
                            command_meanings(program, &out, symbols, &meanings, &picked)
            return out

    def cryptography(program: mutable darray[Node]&, k: i64, step: i64) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            core: mutable darray[i64] = []
            if k == 8 or step > 0:
                for a in 2..<k |program, core|:
                    core.push(atomic(program, GF, a))
                for a in 1..<k |program, core|:
                    core.push(atomic(program, XOR, a))
            if k == 4 and step == 0:
                for a in [1, 3] |program, core, k|:
                    for b in 0..<k |program, core, a|:
                        if a != 1 or b != 0:
                            args: darray[i64] = [a, b]
                            core.push(add_node(program, AFFINE, args, []))
                for a in [1, 3] |program, core, k|:
                    for b in 1..<4 |program, core, a, k|:
                        for c in 0..<k |program, core, a, b|:
                            args: darray[i64] = [a, b, c]
                            core.push(add_node(program, CONV, args, []))
            elif k == 4:
                f: darray[i64] = [atomic(program, REV), atomic(program, ROT, 1), atomic(program, SHIFT, 1),
                    atomic(program, MUL, 3), atomic(program, XOR, 1), atomic(program, PREFIX)]
                for piece in f:
                    children: darray[i64] = [seq1(program, piece)]
                    core.push(add_node(program, FEISTEL, [], children))
            out: mutable darray[i64] = wrapped(program, &core)
            before: darray[i64] = [atomic(program, REV), atomic(program, WEAVE), atomic(program, ROT, 1), atomic(program, ROT, 2)]
            for before_op in before:
                for after_op in core:
                    out.push(pair(program, SEQ, before_op, after_op))
            return out

    def metarules(program: mutable darray[Node]&, n: i64, k: i64, step: i64) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            pieces: mutable darray[i64] = positions(program, n, false)
            pieces.push(atomic(program, SHIFT, 1))
            pieces.push(atomic(program, ROT, 1))
            pieces.push(atomic(program, MUL, 3))
            choices: darray[i64] = wrapped(program, &pieces)
            all_tests: darray[i64] = predicates(program, k)
            triggers: mutable darray[i64] = sliced(&all_tests, 0, 2 * k)
            triggers.push(atomic(program, SUMEVEN))
            out: mutable darray[i64] = []
            for trigger in triggers:
                if step == 0:
                    combinations(program, &out, &choices, META, trigger)
                else:
                    for a in choices:
                        for b in choices:
                            if a != b:
                                for c in choices:
                                    if a != c and b != c:
                                        children: darray[i64] = [trigger, a, b, c]
                                        out.push(add_node(program, META, [], children))
            return out

    def shuffled(rules: mutable darray[i64]&, rung: i64) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            draw: mutable MT19937 = zeroed
            mt_seed_int(&draw, rung.u64())
            py_shuffle_i64(&draw, rules)
            return sliced(rules, 0, CipherAbyss::min(9000, rules.count.i64()))

    def nested(program: mutable darray[Node]&, level: CipherAbyss::Grade) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            pieces: mutable darray[i64] = positions(program, level.length)
            changes: darray[i64] = values(program, level.symbols)
            append_list(&pieces, &changes, level.symbols + 1)
            branches: mutable darray[i64] = wrapped(program, &pieces)
            if level.step >= 1:
                for a in 0..<8 |branches, program, pieces|:
                    for b in 8..<pieces.count.i64() |branches, program, pieces, a|:
                        branches.push(pair(program, SEQ, pieces[a.usize()], pieces[b.usize()]))
            tests: darray[i64] = predicates(program, level.symbols, true)
            out: mutable darray[i64] = []
            for check in tests:
                combinations(program, &out, &branches, IF, check)
            return shuffled(&out, level.rung)

    def adversarial(program: mutable darray[Node]&, level: CipherAbyss::Grade) -> darray[i64]:
        can Abort.Panic, Memory.Allocate:
            pieces: mutable darray[i64] = positions(program, level.length)
            changes: darray[i64] = values(program, level.symbols)
            append_list(&pieces, &changes, 6)
            if level.step >= 2:
                for op in [DEDUPE, DOUBLE, HALVE] |program, pieces|:
                    pieces.push(atomic(program, op))
            if level.rung >= 30:
                strides(program, level.length, &pieces)
            branches: darray[i64] = wrapped(program, &pieces)
            out: mutable darray[i64] = []
            for a in pieces:
                for b in pieces:
                    if a != b:
                        usual: i64 = pair(program, SEQ, a, b)
                        for other in branches:
                            out.push(pair(program, EXCEPT, usual, other))
            return shuffled(&out, level.rung)

    def raw(program: mutable darray[Node]&, level: CipherAbyss::Grade) -> Rules:
        can Abort.Panic, Memory.Allocate:
            n: i64 = level.length
            k: i64 = level.symbols
            j: i64 = level.step
            s: i64 = level.stage
            return patterns(program, n, j) if s == 1
            return transformations(program, n, k) if s == 2
            rules: mutable darray[i64] = []
            if s == 3:
                rules <- conditions(program, n, k, j)
            elif s == 4:
                rules <- composition(program, n, k, j)
            elif s == 5:
                rules <- state_rules(program, n, k, j)
            elif s == 6:
                rules <- hidden_language(program, k, j)
            elif s == 7:
                rules <- cryptography(program, k, j)
            elif s == 8:
                rules <- metarules(program, n, k, j)
            elif s == 9:
                rules <- nested(program, level)
            elif s == 10:
                rules <- adversarial(program, level)
            return Rules{hypotheses: rules, truths: rules}
