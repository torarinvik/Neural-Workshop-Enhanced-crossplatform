include "./nearer.elisa"

module NearerGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = 6
    const UPDATE: i64 = -1
    const FEEDBACK: f64 = 3.0

    struct Run:
        rng: mutable MT19937
        puzzle: mutable Nearer::Puzzle
        start_rung: i64
        total: i64
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        chosen: mutable i64
        picks: mutable i64[6]
        pick_count: mutable i64
        passed_count: mutable i64
        best_rung: mutable i64
        started_at: mutable f64
        now: mutable f64
        deadline: mutable f64
        adaptive: bool
        passed: mutable bool
        has_verdict: mutable bool
        verdict_published: mutable bool

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 6 or total == 12 or total == 24 or total == 40

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Run:
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            initial: i64 = rung if rung > 0 else 1
            return Run{rng: rng, puzzle: zeroed, start_rung: initial, total: total, adaptive: adaptive,
                rung: initial, trial: 0, phase: READY, chosen: -1, picks: zeroed, pick_count: 0,
                passed_count: 0, best_rung: 0, started_at: 0.0, now: 0.0, deadline: 0.0,
                passed: false, has_verdict: false, verdict_published: false}

    def next_trial(run: mutable Run&, now: f64) -> bool:
        can Memory.Allocate, Abort.Panic:
            run.now <- now
            if run.trial >= run.total:
                run.phase <- DONE
                return true
            seed: i64 = py_randbelow(&run.rng, 1073741824.u64()).i64()
            region scratch(65536):
                in scratch:
                    run.puzzle <- Nearer::deal(run.rung, seed)
            if run.puzzle.count == 0:
                run.phase <- READY
                return false
            run.trial <- run.trial + 1
            run.chosen <- -1
            run.pick_count <- 0
            run.has_verdict <- false
            run.verdict_published <- false
            run.passed <- false
            run.started_at <- now
            run.phase <- PLAYING
            return true

    def start(run: mutable Run&, now: f64) -> bool:
        can Memory.Allocate, Abort.Panic:
            return false if run.phase != READY and run.phase != DONE
            run.rung <- run.start_rung
            run.trial <- 0
            run.passed_count <- 0
            run.best_rung <- 0
            run.has_verdict <- false
            run.chosen <- -1
            run.pick_count <- 0
            return next_trial(run, now)

    def picked(run: Run&, index: i64) -> i64:
        can Abort.Panic:
            for i in 0..<run.pick_count |run, index|:
                return i if run.picks[i.usize()] == index
            return -1

    def judge(run: mutable Run&, passed: bool, now: f64):
        run.passed <- passed
        run.has_verdict <- true
        if passed:
            run.passed_count <- run.passed_count + 1
            run.best_rung <- run.rung if run.rung > run.best_rung
        if run.adaptive:
            run.rung <- run.rung + 1 if passed and run.rung < 9223372036854775807
            run.rung <- run.rung - 1 if not passed and run.rung > 1
        run.phase <- JUDGED
        run.deadline <- now + FEEDBACK

    def choose(run: mutable Run&, index: i64, now: f64) -> bool:
        can Abort.Panic:
            return false if run.phase != PLAYING or index < 0 or index >= run.puzzle.count
            return false if picked(run, index) >= 0
            run.chosen <- index
            run.now <- now
            if not run.puzzle.level.order:
                judge(run, index == run.puzzle.order[0], now)
            elif index != run.puzzle.order[run.pick_count.usize()]:
                judge(run, false, now)
            else:
                run.picks[run.pick_count.usize()] <- index
                run.pick_count <- run.pick_count + 1
                if run.pick_count == run.puzzle.count:
                    judge(run, true, now)
            return true

    def elapsed(run: Run&) -> f64:
        return run.now - run.started_at if run.phase == PLAYING else 0.0

    def advance(run: mutable Run&, now: f64) -> bool:
        can Memory.Allocate, Abort.Panic:
            if run.phase == JUDGED:
                return next_trial(run, now) if now >= run.deadline else false
            return false if run.phase != PLAYING or now < run.now
            run.now <- now
            return run.puzzle.level.cue == Nearer::MOTION

    def agent_event(run: mutable Run&, now: f64, action: i64) -> bool:
        can Memory.Allocate, Abort.Panic:
            return false if not (now >= run.now and now <= 1.7976931348623157e308)
            return start(run, now) if action == START
            return choose(run, action, now) if action != UPDATE
            if run.phase == PLAYING:
                run.now <- now
                return true
            if run.phase == JUDGED:
                if run.verdict_published:
                    return next_trial(run, now)
                run.verdict_published <- true
                run.now <- now
                return true
            return false

    def info(run: Run&, field: i64) -> i64:
        can Abort.Panic:
            return run.phase if field == 0
            return run.rung if field == 1
            return run.trial if field == 2
            return run.total if field == 3
            return run.puzzle.level.cue if field == 4
            return run.puzzle.count if field == 5
            return (1 if run.puzzle.level.order else 0) if field == 6
            return run.chosen if field == 7
            return run.pick_count if field == 8
            return (1 if run.passed else 0) if field == 9
            return run.passed_count if field == 10
            return run.best_rung if field == 11
            return (run.deadline * 1000.0).i64() if field == 12 and run.phase == JUDGED
            return (elapsed(run) * 1000.0).i64() if field == 13
            return -1
