# Stateful controller for the source Trivia task.
#
# The question bank is deliberately kept on the Elisa side of the boundary.
# The browser receives only the display list; it does not carry a duplicate
# answer table or decide which option is correct.  The built-in corpus is the
# exact seed corpus from neural_workshop.trivia.py.  A later host provider can
# replace it with a fetched bank without changing the run protocol.

module TriviaGame:

    const PHASE_READY: i64 = 0
    const PHASE_ASKING: i64 = 1
    const PHASE_JUDGED: i64 = 2
    const PHASE_DONE: i64 = 3

    const ACTION_START: i64 = 0
    const ACTION_UP: i64 = 1
    const ACTION_DOWN: i64 = 2
    const ACTION_SUBMIT: i64 = 3
    const ACTION_CHOOSE_0: i64 = 4
    const ACTION_ADVANCE: i64 = 12

    const INFO_PHASE: i64 = 0
    const INFO_START_RUNG: i64 = 1
    const INFO_RUNG: i64 = 2
    const INFO_TRIAL: i64 = 3
    const INFO_TOTAL_TRIALS: i64 = 4
    const INFO_OPTION_COUNT: i64 = 5
    const INFO_CHOICE: i64 = 6
    const INFO_ANSWERED: i64 = 7
    const INFO_ANSWER: i64 = 8
    const INFO_LAST_RIGHT: i64 = 9
    const INFO_RIGHT: i64 = 10
    const INFO_ASKED: i64 = 11
    const INFO_POOL: i64 = 12
    const INFO_ADAPTIVE: i64 = 13
    const INFO_SHOW_ANSWER: i64 = 14
    const INFO_DEAL_QUESTION: i64 = 15
    const INFO_DEAL_SEED: i64 = 16

    const VALUE_OPTION_QUESTION: i64 = 0
    const VALUE_OPTION_ANSWER: i64 = 1
    const VALUE_OPTION_ID: i64 = 2

    # This is neural_workshop/trivia.py:SEED_ROWS, kept as one byte string so
    # the same parser supplies both the kernel Bank and the display strings.
    # Do not reorder rows: the row order is part of deterministic replay.
    const SEED_ROWS: cstr = "In which year did the Berlin Wall fall?|1989\nIn which year did the Titanic sink?|1912\nIn which year did the First World War begin?|1914\nIn which year did the Second World War end in Europe?|1945\nIn which year did humans first land on the Moon?|1969\nIn which year was the American Declaration of Independence signed?|1776\nIn which year did the Chernobyl reactor explode?|1986\nIn which year was Magna Carta sealed at Runnymede?|1215\nIn which year did the French Revolution begin?|1789\nIn which year was the Soviet Union dissolved?|1991\nIn which year was the Battle of Hastings fought?|1066\nIn which year did Columbus first reach the Americas?|1492\nIn which year was Elizabeth II crowned?|1953\nIn which year did the Wright brothers first fly a powered aeroplane?|1903\nIn which year was the Universal Declaration of Human Rights adopted?|1948\nIn which year did the Great Fire of London break out?|1666\nIn which year was the first iPhone released?|2007\nIn which year did the Cuban Missile Crisis take place?|1962\nIn which year was Nelson Mandela released from prison?|1990\nIn which year did the airship Hindenburg burn at Lakehurst?|1937\nHow many strings does a standard violin have?|4\nHow many players from one side are on a football pitch at kick-off?|11\nHow many bones are there in the adult human body?|206\nHow many degrees are there in a circle?|360\nHow many keys does a standard piano have?|88\nHow many squares are there on a chessboard?|64\nHow many sides does a dodecagon have?|12\nHow many hearts does an octopus have?|3\nHow many time zones does Russia span?|11\nHow many books are there in the New Testament?|27\nHow many moons does Mars have?|2\nAt how many degrees Celsius does water boil at sea level?|100\nHow many stripes are there on the flag of the United States?|13\nHow many letters are there in the Greek alphabet?|24\nHow many players from one side are on a basketball court?|5\nWho painted the Mona Lisa?|Leonardo da Vinci\nWho wrote the play Hamlet?|William Shakespeare\nWho was the first President of the United States?|George Washington\nWho published the theory of general relativity?|Albert Einstein\nWho wrote the novel Pride and Prejudice?|Jane Austen\nWho was the first woman to win a Nobel Prize?|Marie Curie\nWho composed the symphony that ends with the Ode to Joy?|Ludwig van Beethoven\nWho led the Indian independence movement by non-violence?|Mahatma Gandhi\nWho wrote the novel Nineteen Eighty-Four?|George Orwell\nWho painted The Starry Night?|Vincent van Gogh\nWho was the first person to walk on the Moon?|Neil Armstrong\nWho wrote On the Origin of Species?|Charles Darwin\nWho directed the 1960 film Psycho?|Alfred Hitchcock\nWho was Prime Minister when Britain declared war on Germany in 1939?|Neville Chamberlain\nWho was granted the American patent for the telephone in 1876?|Alexander Graham Bell\nWho wrote the Harry Potter novels?|J. K. Rowling\nWho was the first man in space?|Yuri Gagarin\nWho wrote The Old Man and the Sea?|Ernest Hemingway\nWho wrote the Divine Comedy?|Dante Alighieri\nWho discovered penicillin?|Alexander Fleming\nWho wrote the Sherlock Holmes stories?|Arthur Conan Doyle\nWho gave the speech beginning \"I have a dream\"?|Martin Luther King\nWho composed the opera The Magic Flute?|Wolfgang Amadeus Mozart\nWho wrote War and Peace?|Leo Tolstoy\nWho sculpted the David that stands in Florence?|Michelangelo Buonarroti\nWho was the Macedonian king taught by Aristotle?|Alexander the Great\nWhich ocean lies between Africa and Australia?|the Indian Ocean\nWhich sea separates Europe from Africa?|the Mediterranean Sea\nWhich mountain range is taken as the border of Europe and Asia?|the Ural Mountains\nWhich mountain is the highest above sea level?|Mount Everest\nWhich American national park holds the geyser Old Faithful?|Yellowstone National Park\nWhich canal links the Mediterranean to the Red Sea?|the Suez Canal\nWhich structure runs for thousands of miles across northern China?|the Great Wall\nWhich tower was built for the Paris exhibition of 1889?|the Eiffel Tower\nWhich band released the album Abbey Road?|the Beatles\nWhich band released the album The Dark Side of the Moon?|Pink Floyd\nWhich ship carried the Pilgrims to America in 1620?|the Mayflower\nWhich war did the Treaty of Versailles bring to a formal end?|the First World War\nWhich newspaper broke the Watergate story?|the Washington Post\nWhich lake is the largest in the world by surface area?|the Caspian Sea\nWhich language has the most native speakers?|Mandarin Chinese\nWhich musical features the song Do-Re-Mi?|the Sound of Music\nWhich Tolkien novel opens in the Shire with an unexpected party?|the Hobbit\nWhich strait separates Spain from Morocco?|the Strait of Gibraltar\nWhich document begins \"We the People\"?|the Constitution of the United States\nWhich London palace houses the House of Commons?|the Palace of Westminster\nWhich Dickens novel opens \"It was the best of times\"?|A Tale of Two Cities\nWhich ancient wonder stood on the island of Pharos?|the Lighthouse of Alexandria\nWhich battle of 1815 ended the Napoleonic Wars?|the Battle of Waterloo\nWhich treaty of 1957 founded the European Economic Community?|the Treaty of Rome\nWhich Harper Lee novel is narrated by Scout Finch?|To Kill a Mockingbird\nWhich 1939 film ends with \"there's no place like home\"?|The Wizard of Oz\nWhich sea battle of 1805 cost Nelson his life?|the Battle of Trafalgar\nWhich Beckett play has two men waiting by a tree?|Waiting for Godot\nWhich American programme first landed people on the Moon?|the Apollo programme\nWhich court at The Hague settles disputes between states?|the International Court of Justice\nWhich children's book has a girl follow a white rabbit underground?|Alice's Adventures in Wonderland\nWhich chess piece may only move diagonally?|the bishop\nWhich bone of the human body is the longest?|the femur\nWhich organ of the human body makes insulin?|the pancreas\nWhat is the capital of Australia?|Canberra\nWhich planet is known as the red planet?|Mars\nWhich metal is liquid at room temperature?|Mercury\nWhich country gave the Statue of Liberty to the United States?|France\nWhich is the largest planet of the Solar System?|Jupiter\nWhich naturally occurring substance is the hardest?|diamond\nWhich language is spoken in Brazil?|Portuguese\nWhich organ pumps blood around the body?|the heart\nWhich sport is played at Wimbledon?|tennis\nOn which continent is the Sahara?|Africa\nIn which city does the Colosseum stand?|Rome\nWhich sea creature has eight arms?|the octopus\nWhat is the capital of Japan?|Tokyo\nWhich fruit is fermented to make wine?|grapes\nWhich country is the kangaroo native to?|Australia\nWhich element has atomic number 1?|hydrogen\nWhich instrument did Louis Armstrong play?|the trumpet\nWhich American state is nicknamed the Sunshine State?|Florida\nWhich mythical creature has a single horn?|the unicorn\nWhich part of a cell holds its DNA?|the nucleus\nWhich country's flag is a red circle on a white field?|Japan\nWhat is the capital of Canada?|Ottawa\nWhich board game is won by checkmate?|chess\nWhich is the longest river in Africa?|the Nile\nWhich shape has three sides?|a triangle"

    struct TriviaRun:
        rng: mutable MT19937
        start_rung: mutable i64
        rung: mutable i64
        total_trials: mutable i64
        show_answer: mutable bool
        adaptive: mutable bool
        trial: mutable i64
        option_count: mutable i64
        option_id: mutable i64[8]
        question_id: mutable i64
        answer: mutable i64
        choice: mutable i64
        answered: mutable i64
        last_right: mutable i64
        right: mutable i64
        phase: mutable i64
        deal_seed: mutable i64

    def clamp_rung(value: i64) -> i64:
        can Abort.Panic:
            return 1 if value < 1 else (7 if value > 7 else value)

    def allowed_rung(value: i64) -> bool:
        can Abort.Panic:
            return value >= 1 and value <= 7

    def allowed_trials(value: i64) -> bool:
        can Abort.Panic:
            return value == 1 or value == 2 or value == 3 or value == 5 or value == 10 or value == 15 or value == 25 or value == 50

    def seed_bank() -> Trivia::TriviaBank:
        can Memory.Allocate, Abort.Panic:
            bank: mutable Trivia::TriviaBank = Trivia::new_bank()
            raw: mutable darray[i64] = []
            view: sview = sview(SEED_ROWS, 0, -1)
            for at in 0..<sview_len(view).i64() |raw, view|:
                raw.push(sview_at(view, at.usize()).i64())
            alias_at: mutable darray[i64] = Ints::zeros(1)
            alias_n: mutable darray[i64] = Ints::zeros(1)
            scratch: mutable darray[i64] = Ints::zeros(4096)
            line_start: mutable i64 = 0
            row_at: mutable i64 = 0
            length: i64 = raw.count.i64()
            while row_at <= length |bank, raw, alias_at, alias_n, scratch, line_start, row_at, length|:
                end: mutable i64 = row_at
                while end < length and Ints::at_ref(&raw, end) != 10 |raw, end, length|:
                    end <- end + 1
                separator: mutable i64 = line_start
                while separator < end and Ints::at_ref(&raw, separator) != 124 |raw, separator, end|:
                    separator <- separator + 1
                if separator < end:
                    Trivia::question_from(&bank, &raw, line_start,
                                          separator - line_start, separator + 1,
                                          end - separator - 1, &alias_at, &alias_n,
                                          0, &scratch)
                line_start <- end + 1
                row_at <- end + 1
            Trivia::index_kinds(&bank)
            return bank

    def append_seed_field(out: mutable dstr&, which: i64, answer: bool):
        can Memory.Allocate, Abort.Panic:
            return if which < 0
            view: sview = sview(SEED_ROWS, 0, -1)
            row: mutable i64 = 0
            at: mutable i64 = 0
            length: i64 = sview_len(view).i64()
            while at <= length |out, view, row, at, length, which, answer|:
                end: mutable i64 = at
                while end < length and sview_at(view, end.usize()) != 10.u8() |view, end, length|:
                    end <- end + 1
                if row == which:
                    separator: mutable i64 = at
                    while separator < end and sview_at(view, separator.usize()) != 124.u8() |view, separator, end|:
                        separator <- separator + 1
                    from_at: i64 = separator + 1 if answer else at
                    stop_at: i64 = end
                    for slot in from_at..<stop_at |out, view|:
                        out.push(sview_at(view, slot.usize()))
                    return
                row <- row + 1
                at <- end + 1

    def append_done_message(out: mutable dstr&, run: TriviaRun&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_i64(out, run.right)
            dstr_append_cstr(out, " of ")
            dstr_append_i64(out, run.total_trials)
            dstr_append_cstr(out, " right, highest level ")
            best: mutable i64 = run.start_rung
            best <- run.rung if run.rung > best else best
            dstr_append_i64(out, best)

    def append_message(out: mutable dstr&, run: TriviaRun&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == PHASE_READY:
                dstr_append_cstr(out, "Press Space to start")
            elif run.phase == PHASE_ASKING:
                dstr_append_cstr(out, "Level ")
                dstr_append_i64(out, run.rung)
            elif run.phase == PHASE_JUDGED:
                if run.last_right == 1:
                    dstr_append_cstr(out, "Right")
                else:
                    dstr_append_cstr(out, "No — it was \"")
                    answer_text: mutable dstr = []
                    append_seed_field(&answer_text, run.option_id[run.answer.usize()], true)
                    dstr_append_dstr(out, answer_text)
                    dstr_append_cstr(out, "\"")
            else:
                append_done_message(out, run)

    def deal_round(run: mutable TriviaRun&) -> bool:
        can Memory.Allocate, Abort.Panic:
            made: mutable bool = false
            run.deal_seed <- py_randbelow(&run.rng, 1073741824.u64()).i64()
            region trivia_deal(67108864):
                in trivia_deal:
                    bank: mutable Trivia::TriviaBank = seed_bank()
                    work: mutable Trivia::TriviaWork = Trivia::new_work()
                    deal_rng: mutable MT19937 = mt19937_new()
                    mt_seed_int(&deal_rng, run.deal_seed.u64())
                    round: Trivia::TriviaRound = Trivia::generate(&bank, &work, run.rung, &deal_rng)
                    if round.given:
                        run.question_id <- round.question
                        run.option_count <- round.options
                        run.answer <- round.answer
                        run.choice <- 0
                        run.answered <- -1
                        for at in 0..<Trivia::MOST_OPTIONS |at, run, work|:
                            run.option_id[at.usize()] <- Ints::at_ref(&work.options, at) if at < round.options else -1
                        made <- true
                    destroy trivia_deal
            return made

    def next_trial(run: mutable TriviaRun&):
        can Memory.Allocate, Abort.Panic:
            if run.trial >= run.total_trials:
                run.phase <- PHASE_DONE
                run.option_count <- 0
                return
            run.trial <- run.trial + 1
            run.last_right <- -1
            if deal_round(run):
                run.phase <- PHASE_ASKING
            else:
                run.phase <- PHASE_DONE

    def start(run: mutable TriviaRun&):
        can Memory.Allocate, Abort.Panic:
            run.rung <- clamp_rung(run.start_rung)
            run.trial <- 0
            run.right <- 0
            run.last_right <- -1
            run.answered <- -1
            run.option_count <- 0
            run.question_id <- -1
            run.answer <- -1
            run.choice <- 0
            next_trial(run)

    def initialize(run: mutable TriviaRun&, start_rung: i64, total_trials: i64,
                   show_answer: bool, adaptive: bool, seed: i64):
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            run.rng <- rng
            run.start_rung <- clamp_rung(start_rung)
            run.rung <- run.start_rung
            run.total_trials <- total_trials
            run.show_answer <- show_answer
            run.adaptive <- adaptive
            run.trial <- 0
            run.option_count <- 0
            run.question_id <- -1
            run.answer <- -1
            run.choice <- 0
            run.answered <- -1
            run.last_right <- -1
            run.right <- 0
            run.phase <- PHASE_READY
            run.deal_seed <- 0
            for at in 0..<Trivia::MOST_OPTIONS |at, run|:
                run.option_id[at.usize()] <- -1

    def move_choice(run: mutable TriviaRun&, step: i64) -> i64:
        can Abort.Panic:
            return 2 if run.phase != PHASE_ASKING or run.option_count <= 0
            run.choice <- (run.choice + step) % run.option_count
            run.choice <- run.choice + run.option_count if run.choice < 0
            return 1

    def submit_answer(run: mutable TriviaRun&, selected: i64) -> i64:
        can Abort.Panic:
            return 2 if run.phase != PHASE_ASKING
            return 2 if selected < 0 or selected >= run.option_count
            run.choice <- selected
            run.answered <- selected
            run.last_right <- 1 if selected == run.answer else 0
            run.right <- run.right + 1 if run.last_right == 1 else run.right
            if run.adaptive:
                run.rung <- clamp_rung(run.rung + (1 if run.last_right == 1 else -1))
            run.phase <- PHASE_JUDGED
            return 1

    def apply(run: mutable TriviaRun&, action: i64, value: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            if action == ACTION_START or action == ACTION_ADVANCE:
                return 2 if action == ACTION_START and run.phase == PHASE_ASKING
                if run.phase == PHASE_JUDGED:
                    next_trial(run)
                elif run.phase == PHASE_READY or run.phase == PHASE_DONE:
                    start(run)
                else:
                    return 2
                return 1
            if action == ACTION_UP:
                return move_choice(run, -1)
            if action == ACTION_DOWN:
                return move_choice(run, 1)
            if action == ACTION_SUBMIT:
                return submit_answer(run, run.choice)
            if action >= ACTION_CHOOSE_0 and action < ACTION_CHOOSE_0 + Trivia::MOST_OPTIONS:
                return submit_answer(run, action - ACTION_CHOOSE_0)
            return -6

    def info(run: TriviaRun&, field: i64) -> i64:
        can Abort.Panic:
            if field == INFO_PHASE: return run.phase
            if field == INFO_START_RUNG: return run.start_rung
            if field == INFO_RUNG: return run.rung
            if field == INFO_TRIAL: return run.trial
            if field == INFO_TOTAL_TRIALS: return run.total_trials
            if field == INFO_OPTION_COUNT: return run.option_count
            if field == INFO_CHOICE: return run.choice
            if field == INFO_ANSWERED: return run.answered
            if field == INFO_ANSWER: return run.answer
            if field == INFO_LAST_RIGHT: return run.last_right
            if field == INFO_RIGHT: return run.right
            if field == INFO_ASKED: return run.question_id
            if field == INFO_POOL: return 120
            if field == INFO_ADAPTIVE: return 1 if run.adaptive else 0
            if field == INFO_SHOW_ANSWER: return 1 if run.show_answer else 0
            if field == INFO_DEAL_QUESTION: return run.question_id
            if field == INFO_DEAL_SEED: return run.deal_seed
            return -1

    def value(run: TriviaRun&, field: i64, at: i64) -> i64:
        can Abort.Panic:
            return -1 if at < 0 or at >= run.option_count
            if field == VALUE_OPTION_QUESTION: return run.question_id
            if field == VALUE_OPTION_ANSWER: return 1 if at == run.answer else 0
            if field == VALUE_OPTION_ID: return run.option_id[at.usize()]
            return -1

    def render(run: TriviaRun&, black_background: bool, width: f64, height: f64,
               list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            asked: mutable dstr = []
            options_text: mutable dstr = []
            starts: mutable i64[8] = zeroed
            lengths: mutable i64[8] = zeroed
            if run.phase == PHASE_ASKING or run.phase == PHASE_JUDGED:
                append_seed_field(&asked, run.question_id, false)
                for at in 0..<run.option_count |at, run, options_text, starts, lengths|:
                    starts[at.usize()] <- options_text.count.i64()
                    option: i64 = run.option_id[at.usize()]
                    before: i64 = options_text.count.i64()
                    append_seed_field(&options_text, option, true)
                    lengths[at.usize()] <- options_text.count.i64() - before
            options: mutable darray[sview] = []
            for at in 0..<run.option_count |at, options, options_text, starts, lengths|:
                options.push(string_view_slice(bytes_view(options_text), starts[at.usize()], starts[at.usize()] + lengths[at.usize()]))
            message: mutable dstr = []
            append_message(&message, run)
            verdict_text: mutable dstr = []
            if run.phase == PHASE_JUDGED:
                dstr_append_cstr(&verdict_text, "Right" if run.last_right == 1 else "No")
            scene_phase: i64 = SceneTrivia::PHASE_DONE if run.phase == PHASE_DONE else run.phase
            paint: SceneTrivia::TriviaPaint = SceneTrivia::paint_of(black_background, width, height,
                width / Display::REFERENCE_WIDTH, height / Display::REFERENCE_HEIGHT)
            SceneTrivia::render(list, &paint, scene_phase,
                run.phase == PHASE_ASKING or run.phase == PHASE_JUDGED,
                bytes_view(asked), options, run.choice, run.answered, run.answer,
                run.show_answer, false, sview("Trivia is on its seed questions -- for the whole bank run python -m neural_workshop.trivia", 0, -1),
                120, run.trial, run.total_trials, bytes_view(message),
                run.last_right if run.phase == PHASE_JUDGED else -1,
                bytes_view(verdict_text))
