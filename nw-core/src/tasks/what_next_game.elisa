include "./what_next.elisa"

module WhatNextGame:
    const READY: i64 = 0
    const LOADING: i64 = 1
    const CHOOSING: i64 = 2
    const JUDGED: i64 = 3
    const DONE: i64 = 4
    const FPS: f64 = 15.0
    const FEEDBACK: f64 = 3.0
    const MAX_TRIALS: i64 = 40
    const MAX_FRAMES: i64 = 120
    const SAMPLES: i64 = (160 * 120 * 3 + 96) / 97

    def other_clips(rung: i64) -> i64:
        can Abort.Panic:
            level: WhatNext::Grade = WhatNext::grade(rung)
            return 0 if not WhatNext::has_kind(&level, WhatNext::OTHER)
            same: i64 = 0 if rung < 4 else (1 if rung < 8 else (4 if rung < 12 else 5))
            return level.choices - same if level.choices > same else 1

    struct Result:
        rung: i64
        passed: bool

    struct Run:
        rng: mutable MT19937
        start_rung: i64
        total: i64
        adaptive: bool
        rung: mutable i64
        phase: mutable i64
        trial: mutable i64
        started: mutable f64
        deadline: mutable f64
        puzzle: mutable WhatNext::Puzzle
        chosen: mutable i64
        results: mutable Result[MAX_TRIALS]
        scored: mutable i64
        passed: mutable i64
        best: mutable i64

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 8 or rung == 12 or rung == 16 or rung == 20 or rung == 24 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 5 or total == 10 or total == 20 or total == 40

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Run:
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            return Run{rng: rng, start_rung: rung, total: total, adaptive: adaptive, rung: rung, phase: READY,
                trial: 0, started: 0.0, deadline: 0.0, puzzle: zeroed, chosen: -1, results: zeroed, scored: 0, passed: 0, best: 0}

    def start(run: mutable Run&) -> bool:
        return false if run.phase != READY and run.phase != DONE
        return false if run.total < 1 or run.total > MAX_TRIALS
        run.rung <- run.start_rung
        run.trial <- 0
        run.scored <- 0
        run.passed <- 0
        run.best <- 0
        run.phase <- LOADING
        return true

    def valid_time(now: f64) -> bool:
        return now >= 0.0 and now <= 9007199254740.0

    # A rejected group leaves the trial pending so the host can try more clips.
    def load_clips(run: mutable Run&, group: WhatNext::Group&, samples: u8&, bytes: i64, now: f64) -> bool:
        can Abort.Panic:
            return false if run.phase != LOADING or not valid_time(now)
            level: WhatNext::Grade = WhatNext::grade(run.rung)
            puzzle: WhatNext::Puzzle = WhatNext::build(group, samples, bytes, &level, &run.rng)
            return accept_puzzle(run, puzzle, now)

    def accept_puzzle(run: mutable Run&, puzzle: WhatNext::Puzzle, now: f64) -> bool:
        return false if run.phase != LOADING or puzzle.count == 0 or not valid_time(now)
        run.puzzle <- puzzle
        run.chosen <- -1
        run.trial <- run.trial + 1
        run.started <- now
        run.phase <- CHOOSING
        return true

    def unavailable(run: mutable Run&) -> bool:
        return false if run.phase != LOADING
        run.phase <- READY
        return true

    def choose(run: mutable Run&, index: i64, now: f64) -> bool:
        can Abort.Panic:
            return false if run.phase != CHOOSING or index < 0 or index >= run.puzzle.count or not valid_time(now) or now < run.started
            passed: bool = index == run.puzzle.answer
            run.results[run.scored.usize()] <- Result{rung: run.rung, passed: passed}
            run.scored <- run.scored + 1
            if passed:
                run.passed <- run.passed + 1
                run.best <- run.rung if run.rung > run.best
            if run.adaptive:
                run.rung <- run.rung + 1 if passed and run.rung < 9223372036854775807
                run.rung <- run.rung - 1 if not passed and run.rung > 1
            run.chosen <- index
            run.deadline <- now + FEEDBACK
            run.phase <- JUDGED
            return true

    def advance(run: mutable Run&, now: f64) -> bool:
        return false if run.phase != JUDGED or not valid_time(now) or now < run.deadline
        run.puzzle <- zeroed
        run.chosen <- -1
        run.phase <- DONE if run.trial >= run.total else LOADING
        return true

    def frame(run: Run&, stream: i64, now: f64) -> i64:
        can Abort.Panic:
            return -1 if run.phase != CHOOSING and run.phase != JUDGED
            return -1 if not valid_time(now) or now < run.started
            return WhatNext::playback(&run.puzzle, stream, ((now - run.started) * FPS).i64())
