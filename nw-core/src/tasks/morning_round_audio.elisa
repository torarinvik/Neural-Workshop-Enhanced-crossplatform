include "./morning_round_ride.elisa"
include "./drshape_audio.elisa"

module MorningRoundAudio:
    def render(run: MorningRoundRide::Run&, begin: f64, end: f64, output: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            notes: mutable darray[DrShapeDeal::Note] = []
            bank: mutable DrShapeAudio::Bank = zeroed
            bank.count <- 7
            names: i64[7] = [DrShapeAudio::BELL, DrShapeAudio::GROWL, DrShapeAudio::WOOD,
                DrShapeAudio::WOOD, DrShapeAudio::GROWL, DrShapeAudio::WOOD, DrShapeAudio::BELL]
            made: mutable i64 = 0
            rng: mutable MT19937 = zeroed
            for i in 0..<run.cue_count |run, begin, end, notes, bank, names, made, rng|:
                cue: MorningRoundRide::Cue = run.cues[i.usize()]
                continue if cue.t >= end or cue.t + (cue.duration + 0.4) <= begin
                bit: i64 = 1 << cue.voice
                if (made & bit) == 0:
                    mt_seed_int(&rng, (cue.voice + 1).u64())
                    bank.patches[cue.voice.usize()] <- DrShapeAudio::make_patch(names[cue.voice.usize()], &rng, 0.0)
                    made <- made | bit
                notes.push(DrShapeDeal::Note{t: cue.t, dur: cue.duration, freq: cue.frequency,
                    pan: cue.pan, pan2: cue.pan, gain: cue.gain, gain2: cue.gain, bright: 0.8,
                    voice: cue.voice, seed: i + 1, who: -1, room: 0.0})
            return DrShapeAudio::write(&notes, &bank, begin, end, output, capacity)
