include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_json.elisa"
include "./figures_of_speech.elisa"

extend FiguresOfSpeech:
    def kind_name(kind: i64) -> cstr:
        return "metaphor" if kind == METAPHOR
        return "figure" if kind == FIGURE
        return "fable" if kind == FABLE
        return "odd_metaphor" if kind == ODD_METAPHOR
        return ""

    def kind_index(name: sview) -> i64:
        can Abort.Panic:
            for i in 0..<4 |name|:
                if sview_eq(name, sview(kind_name(i), 0, -1)):
                    return i
            return -1

    def copy_question_text(text: sview) -> dstr:
        can Abort.Panic, Memory.Allocate:
            result: mutable dstr = []
            dstr_append_sview(&result, text)
            return result

    struct Decoded:
        kind: i64
        question: Question
        valid: bool

    def decode_question[@r](arena: mutable Arena& @r, line: sview) -> Decoded:
        can Memory.Allocate, Abort.Panic:
            parsed: JsonParseResult[r] = json_parse_checked(arena, line) can Global{Read,Write}
            return zeroed if parsed.code != JsonErrorCode.OK
            root: JsonValueHandle[r] = json_handle_from_result(parsed)
            kind_node: JsonValueHandle[r] = try json_handle_get(root, "kind") else json_handle_null(root)
            name: sview @r = try json_handle_as_string(kind_node) else ""
            kind: i64 = kind_index(name)
            return zeroed if kind < 0
            prompt_node: JsonValueHandle[r] = try json_handle_get(root, "prompt") else json_handle_null(root)
            ask_node: JsonValueHandle[r] = try json_handle_get(root, "ask") else json_handle_null(root)
            options_node: JsonValueHandle[r] = try json_handle_get(root, "options") else json_handle_null(root)
            answer_node: JsonValueHandle[r] = try json_handle_get(root, "answer") else json_handle_null(root)
            answer: f64 = try json_handle_as_number(answer_node) else -1.0
            count: i64 = json_handle_array_len(options_node)
            return zeroed if answer < 0.0 or answer >= count.f64() or answer != answer.i64().f64()
            return zeroed if count < 2 or (kind != FIGURE and count > ReadingQuiz::PORTS)
            return zeroed if not json_handle_is_string(prompt_node) or not json_handle_is_string(ask_node)
            prompt: sview @r = try json_handle_as_string(prompt_node) else ""
            ask: sview @r = try json_handle_as_string(ask_node) else ""
            options: mutable darray[dstr] = []
            for i in 0..<count |root, options_node, options|:
                node: JsonValueHandle[r] = try json_handle_at(options_node, i) else json_handle_null(root)
                return zeroed if not json_handle_is_string(node)
                text: sview @r = try json_handle_as_string(node) else ""
                label: dstr = copy_question_text(text)
                options.push(label)
            return Decoded{kind: kind, question: Question{prompt: copy_question_text(prompt), ask: copy_question_text(ask), options: options, answer: answer.i64()}, valid: true}

    def take_line(corpus: mutable Corpus&, owner: mutable Arena&, line: sview):
        can Memory.Allocate, Abort.Panic:
            in owner:
                decoded: Decoded = decode_question(owner, line) can Global{Read,Write}
                if decoded.valid:
                    question: Question = decoded.question
                    corpus.questions[decoded.kind.usize()].push(question)

    def seed_questions(owner: mutable Arena&) -> Corpus:
        can Memory.Allocate, Abort.Panic:
            corpus: mutable Corpus = zeroed
            take_line(&corpus, owner, "{\"kind\":\"metaphor\",\"prompt\":\"Her words [cut him to the bone] and he left.\",\"ask\":\"What do the words in brackets mean here?\",\"options\":[\"hurt him deeply\",\"made him bleed\",\"cooked for him\",\"measured him\"],\"answer\":0}") can Global{Read,Write}
            take_line(&corpus, owner, "{\"kind\":\"metaphor\",\"prompt\":\"The news [spread like wildfire] through town.\",\"ask\":\"What do the words in brackets mean here?\",\"options\":[\"burned houses\",\"travelled very fast\",\"was hot\",\"stayed secret\"],\"answer\":1}") can Global{Read,Write}
            take_line(&corpus, owner, "{\"kind\":\"figure\",\"prompt\":\"The wind whispered through the trees.\",\"ask\":\"Which figure of speech is it?\",\"options\":[\"Simile\",\"Metaphor\",\"Personification\",\"Hyperbole\"],\"answer\":2}") can Global{Read,Write}
            take_line(&corpus, owner, "{\"kind\":\"figure\",\"prompt\":\"I have told you a million times.\",\"ask\":\"Which figure of speech is it?\",\"options\":[\"Simile\",\"Metaphor\",\"Personification\",\"Hyperbole\"],\"answer\":3}") can Global{Read,Write}
            take_line(&corpus, owner, "{\"kind\":\"figure\",\"prompt\":\"He runs like the wind.\",\"ask\":\"Which figure of speech is it?\",\"options\":[\"Simile\",\"Metaphor\",\"Personification\",\"Hyperbole\"],\"answer\":0}") can Global{Read,Write}
            take_line(&corpus, owner, "{\"kind\":\"fable\",\"prompt\":\"A crow found a pitcher with a little water at the bottom. It could not reach it, so it dropped pebbles in, one by one, until the water rose and it could drink.\",\"ask\":\"What is the moral?\",\"options\":[\"Little by little does the trick.\",\"Look before you leap.\",\"Pride goes before a fall.\",\"Birds of a feather flock together.\"],\"answer\":0}") can Global{Read,Write}
            take_line(&corpus, owner, "{\"kind\":\"fable\",\"prompt\":\"A fox could not reach the grapes on a high vine. Walking away, it said they were surely sour anyway.\",\"ask\":\"What is the moral?\",\"options\":[\"Slow and steady wins the race.\",\"It is easy to despise what you cannot have.\",\"A friend in need is a friend indeed.\",\"Do not count your chickens before they hatch.\"],\"answer\":1}") can Global{Read,Write}
            take_line(&corpus, owner, "{\"kind\":\"odd_metaphor\",\"prompt\":\"Which sentence about ideas does not speak of them as food?\",\"ask\":\"Which one is it?\",\"options\":[\"That is food for thought.\",\"I cannot swallow that claim.\",\"Let me chew on it.\",\"The idea came in a flash.\"],\"answer\":3}") can Global{Read,Write}
            return corpus

    # The original questions.jsonl replaces its bundled deck per question kind.
    def from_question_cache(owner: mutable Arena&, text: sview) -> Corpus:
        can Memory.Allocate, Abort.Panic:
            corpus: mutable Corpus = zeroed
            size: i64 = sview_len(text).i64()
            start: mutable i64 = 0
            for i in 0..<(size + 1) |start, size, text, corpus, owner|:
                if i == size or sview_at(text, i.usize()) == 10.u8():
                    if i > start:
                        take_line(&corpus, owner, string_view_slice(text, start, i)) can Global{Read,Write}
                    start <- i + 1
            seed: Corpus = seed_questions(owner) can Global{Read,Write}
            for k in 0..<4 |seed, corpus|:
                if corpus.questions[k.usize()].count == 0.usize():
                    corpus.questions[k.usize()] <- seed.questions[k.usize()]
            return corpus
