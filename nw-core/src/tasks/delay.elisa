include "../pyrandom.elisa"

module Delay:
    const FIXED: i64 = 0
    const UNIFORM: i64 = 1
    const HEAVY: i64 = 2
    const VARIED: i64 = 3
    const SWITCH: i64 = 4
    const NEVER_KIND: i64 = 5
    const MIXED: i64 = 6
    const NEVER: f64 = -1.0
    const OFFER_COUNT: i64 = 200
    const COLLECT: f64 = 1.0
    const GIVE_UP: f64 = 0.5

    struct Grade:
        rung: i64
        seconds: f64
        kind: i64
        shown: bool

    struct Offer:
        small: i64
        large: i64
        wait: f64

    struct Run:
        level: mutable Grade
        offers: mutable Offer[OFFER_COUNT]

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        kind: mutable i64 = MIXED
        if r < 4:
            kind <- FIXED
        elif r < 7:
            kind <- UNIFORM
        elif r < 10:
            kind <- HEAVY
        elif r < 13:
            kind <- VARIED
        elif r < 16:
            kind <- SWITCH
        elif r < 20:
            kind <- NEVER_KIND
        return Grade{rung: r, seconds: 60.0 if r < 20 else 45.0, kind: kind,
            shown: kind == FIXED or kind == VARIED}

    def draw_wait(rng: mutable MT19937&, kind: i64) -> f64:
        can Abort.Panic:
            return py_uniform(rng, 2.0, 6.0) if kind == UNIFORM
            if kind == HEAVY:
                return py_uniform(rng, 1.0, 3.0) if py_random(rng) < 0.6
                return 8.0 * pow(1.0 - py_random(rng), -1.2)
            if kind == NEVER_KIND:
                return NEVER if py_random(rng) < 0.3
                return py_uniform(rng, 1.0, 4.0)
            return 3.0

    def deal(rung: i64, seed: i64, output: mutable Run&):
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            level: Grade = grade(rung)
            output.level <- level
            first_phase: i64 = HEAVY if py_random(&rng) < 0.5 else UNIFORM
            mixed: mutable i64[3] = [UNIFORM, HEAVY, NEVER_KIND]
            # CPython random.sample uses the pool branch for three items.
            first_index: usize = py_randbelow(&rng, 3.u64()).usize()
            first_mixed: i64 = mixed[first_index]
            mixed[first_index] <- mixed[2]
            second_mixed: i64 = mixed[py_randbelow(&rng, 2.u64()).usize()]
            for k in 0..<OFFER_COUNT |rng, output, level, first_phase, first_mixed, second_mixed|:
                if level.kind == VARIED:
                    small: i64 = py_randint(&rng, 1, 3)
                    large: i64 = py_randint(&rng, small + 2, 12)
                    wait: f64 = py_uniform(&rng, 1.0, 8.0)
                    output.offers[k.usize()] <- Offer{small: small, large: large, wait: (wait * 10.0 + 0.5).i64().f64() / 10.0}
                else:
                    kind: mutable i64 = level.kind
                    if kind == SWITCH:
                        kind <- first_phase if k < 14 else (UNIFORM if first_phase == HEAVY else HEAVY)
                    elif kind == MIXED:
                        kind <- first_mixed if k < 10 else second_mixed
                    output.offers[k.usize()] <- Offer{small: 1, large: 8, wait: draw_wait(&rng, kind)}

    # A nonnegative bar chooses by payoff per second. A negative bar uses
    # the same patience on every offer, with NEVER meaning wait indefinitely.
    def play(run: Run&, patience: f64, bar: f64 = -1.0) -> i64:
        can Abort.Panic:
            elapsed: mutable f64 = 0.0
            coins: mutable i64 = 0
            end: f64 = run.level.seconds
            for k in 0..<OFFER_COUNT |run, patience, bar, elapsed, coins, end|:
                break if elapsed >= end
                offer: Offer = run.offers[k.usize()]
                clears_bar: bool = offer.wait != NEVER and offer.large.f64() / (offer.wait + COLLECT) >= bar
                chosen: f64 = patience if bar < 0.0 else (offer.wait if clears_bar else 0.0)
                if chosen == 0.0:
                    coins <- coins + offer.small
                    elapsed <- elapsed + COLLECT
                elif offer.wait != NEVER and (chosen == NEVER or offer.wait <= chosen):
                    coins <- coins + offer.large if elapsed + offer.wait <= end + 0.000000001
                    elapsed <- elapsed + (offer.wait + COLLECT)
                else:
                    remaining: f64 = end - elapsed
                    spent: f64 = remaining if chosen == NEVER or chosen > remaining else chosen
                    elapsed <- elapsed + (spent + GIVE_UP)
            return coins

    def floor_score(run: Run&) -> i64:
        can Abort.Panic:
            return play(run, 0.0)

    def reference(run: Run&) -> i64:
        can Abort.Panic:
            score: mutable i64 = floor_score(run) if not run.level.shown else 0
            if run.level.shown:
                for k in 0..<20 |run, score|:
                    paid: i64 = play(run, 0.0, k.f64() / 4.0)
                    score <- paid if paid > score
            else:
                patience: f64[14] = [0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 4.0, 5.0, 6.0, 8.0, 10.0, 15.0, 20.0, NEVER]
                for k in 0..<14 |run, score, patience|:
                    paid: i64 = play(run, patience[k.usize()])
                    score <- paid if paid > score
            return score

    def best(run: Run&) -> i64:
        can Abort.Panic:
            score: mutable i64 = 0
            for k in 0..<40 |run, score|:
                paid: i64 = play(run, 0.0, k.f64() / 8.0)
                score <- paid if paid > score
            return score

    def par(run: Run&) -> f64:
        can Abort.Panic:
            rung: i64 = run.level.rung
            baseline: f64 = reference(run).f64()
            if rung <= 20:
                spread: f64 = baseline - floor_score(run).f64()
                return baseline - (0.5 * (20 - rung).f64() / 19.0) * (spread if spread > 0.0 else 0.0)
            gain: f64 = best(run).f64() - baseline
            fraction: f64 = 0.08 * (rung - 20).f64() if rung < 30 else 0.8
            return baseline + fraction * (gain if gain > 0.0 else 0.0)
