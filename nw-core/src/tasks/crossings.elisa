include "../pyrandom.elisa"
include "../pymath.elisa"

module Crossings:
    const WIDTH: f64 = 100.0
    const HEIGHT: f64 = 62.0

    struct Grade:
        rung: i64
        bends: i64
        smooth: bool
        most: i64
        decoys: i64
        angle: f64

    struct Point:
        x: f64
        y: f64

    struct Line:
        points: mutable Point[73]
        count: i64

    struct Hit:
        point: Point
        angle: f64
        found: bool

    struct Hits:
        points: mutable Point[6]
        count: mutable i64
        clean_angle: mutable bool

    struct Puzzle:
        level: Grade
        seed: i64
        red: mutable Line
        blue: mutable Line
        decoys: mutable Line[3]
        hits: mutable Hits
        answer: mutable i64

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        return Grade{rung: r, bends: 2 if r < 4 else (3 if r < 7 else (4 if r < 13 else 5)), smooth: r >= 7,
            most: 2 if r < 4 else (3 if r < 7 else (4 if r < 13 else (5 if r < 16 else 6))),
            decoys: 0 if r < 10 else (1 if r < 16 else (2 if r < 20 else 3)),
            angle: 30.0 if r < 13 else 18.0}

    def catmull(a: f64, b: f64, c: f64, d: f64, t: f64, t2: f64, t3: f64) -> f64:
        return 0.5 * ((2.0 * b) + (-a + c) * t + (2.0 * a - 5.0 * b + 4.0 * c - d) * t2 +
            (-a + 3.0 * b - 3.0 * c + d) * t3)

    def spline(ctrl: Point[7]&, count: i64) -> Line:
        can Abort.Panic:
            end: i64 = count - 1
            line: mutable Line = Line{points: zeroed, count: end * 12 + 1}
            for i in 0..<end |ctrl, end, line|:
                a: Point = ctrl[(i - 1).usize()] if i > 0 else ctrl[0.usize()]
                b: Point = ctrl[i.usize()]
                c: Point = ctrl[(i + 1).usize()]
                d: Point = ctrl[(i + 2).usize()] if i + 2 <= end else ctrl[end.usize()]
                for k in 0..<12 |i, a, b, c, d, line|:
                    t: f64 = k.f64() / 12.0
                    t2: f64 = t * t
                    t3: f64 = t2 * t
                    line.points[(i * 12 + k).usize()] <- Point{x: catmull(a.x, b.x, c.x, d.x, t, t2, t3),
                        y: catmull(a.y, b.y, c.y, d.y, t, t2, t3)}
            line.points[(line.count - 1).usize()] <- ctrl[end.usize()]
            return line

    def draw_line(level: Grade, rng: mutable MT19937&) -> Line:
        can Abort.Panic:
            n: i64 = level.bends + 2
            side: bool = py_random(rng) < 0.5
            ctrl: mutable Point[7] = zeroed
            for k in 0..<n |ctrl, n, side, rng|:
                u: f64 = 6.0 + (WIDTH - 12.0) * k.f64() / (n - 1).f64()
                v: f64 = 6.0 + (HEIGHT - 12.0) * py_random(rng)
                ctrl[k.usize()] <- Point{x: u, y: v} if side else Point{x: v / HEIGHT * WIDTH * 0.98 + 1.0,
                    y: u / WIDTH * HEIGHT * 0.98 + 0.6}
            if py_random(rng) < 0.5:
                for k in 0..<(n / 2) |ctrl, n|:
                    first: usize = k.usize()
                    last: usize = (n - 1 - k).usize()
                    temp: Point = ctrl[first]
                    ctrl[first] <- ctrl[last]
                    ctrl[last] <- temp
            return spline(&ctrl, n) if level.smooth
            line: mutable Line = Line{points: zeroed, count: n}
            for k in 0..<n |line, ctrl|:
                line.points[k.usize()] <- ctrl[k.usize()]
            return line

    def abs_f(value: f64) -> f64:
        return -value if value < 0.0 else value

    def disjoint(a: f64, b: f64, c: f64, d: f64) -> bool:
        return (a < c and a < d and b < c and b < d) or (a > c and a > d and b > c and b > d)

    def hit(a: Point, b: Point, c: Point, d: Point) -> Hit:
        miss: Hit = zeroed
        return miss if disjoint(a.x, b.x, c.x, d.x) or disjoint(a.y, b.y, c.y, d.y)
        rx: f64 = b.x - a.x
        ry: f64 = b.y - a.y
        sx: f64 = d.x - c.x
        sy: f64 = d.y - c.y
        den: f64 = rx * sy - ry * sx
        return miss if abs_f(den) < 1e-12
        cx: f64 = c.x - a.x
        cy: f64 = c.y - a.y
        t: f64 = (cx * sy - cy * sx) / den
        u: f64 = (cx * ry - cy * rx) / den
        return miss if t < 0.0 or t >= 1.0 or u < 0.0 or u >= 1.0
        angle: f64 = atan2(abs_f(den), rx * sx + ry * sy) * 57.29577951308232
        return Hit{point: Point{x: a.x + t * rx, y: a.y + t * ry}, angle: angle if angle < 90.0 else 180.0 - angle, found: true}

    def within(a: Point, b: Point, distance: f64) -> bool:
        can Abort.Panic:
            dx: f64 = a.x - b.x
            dy: f64 = a.y - b.y
            return abs_f(dx) < distance and abs_f(dy) < distance and py_hypot(dx, dy) < distance

    def touches(p: Line&, q: Line&, limit: i64, angle: f64) -> Hits:
        can Abort.Panic:
            hits: mutable Hits = Hits{points: zeroed, count: 0, clean_angle: true}
            for i in 0..<(p.count - 1) |p, q, limit, angle, hits|:
                a: Point = p.points[i.usize()]
                b: Point = p.points[(i + 1).usize()]
                for j in 0..<(q.count - 1) |q, limit, angle, hits, a, b|:
                    cross: Hit = hit(a, b, q.points[j.usize()], q.points[(j + 1).usize()])
                    continue if not cross.found
                    hits.count <- hits.count + 1
                    return hits if hits.count > limit
                    hits.points[(hits.count - 1).usize()] <- cross.point
                    hits.clean_angle <- hits.clean_angle and cross.angle >= angle
            return hits

    # A decoy may cross either main line more than six times. Its hits
    # are consumed only for validation during generation.
    def decoy_clean(p: Line&, q: Line&, angle: f64) -> bool:
        can Abort.Panic:
            points: mutable Point[5184] = zeroed
            count: mutable i64 = 0
            for i in 0..<(p.count - 1) |p, q, angle, points, count|:
                a: Point = p.points[i.usize()]
                b: Point = p.points[(i + 1).usize()]
                for j in 0..<(q.count - 1) |q, angle, points, count, a, b|:
                    cross: Hit = hit(a, b, q.points[j.usize()], q.points[(j + 1).usize()])
                    continue if not cross.found
                    return false if cross.angle < angle
                    for prior in 0..<count |points, cross|:
                        return false if within(points[prior.usize()], cross.point, 7.0)
                    points[count.usize()] <- cross.point
                    count <- count + 1
            return false if count == 0
            return avoids_grazing(p, q, &points[0.usize()], count)

    def avoids_grazing(p: Line&, q: Line&, points: Point&, count: i64) -> bool:
        can Abort.Panic:
            for i in 0..<((p.count + 1) / 2) |p, q, points, count|:
                a: Point = p.points[(i * 2).usize()]
                near: mutable bool = false
                for j in 0..<count |a, points, near|:
                    if within(a, points[j], 6.0):
                        near <- true
                        break
                continue if near
                for j in 0..<q.count |a, q|:
                    return false if within(a, q.points[j.usize()], 2.5)
            return true

    def clean(p: Line&, q: Line&, hits: Hits&) -> bool:
        can Abort.Panic:
            return false if not hits.clean_angle
            for i in 0..<hits.count |hits|:
                for j in 0..<i |hits, i|:
                    return false if within(hits.points[i.usize()], hits.points[j.usize()], 7.0)
            return avoids_grazing(p, q, &hits.points[0.usize()], hits.count)

    def deal(rung: i64, seed: i64) -> Puzzle:
        can Abort.Panic:
            level: Grade = grade(rung)
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
            want: i64 = py_randbelow(&rng, (level.most + 1).u64()).i64()
            puzzle: mutable Puzzle = Puzzle{level: level, seed: seed, red: zeroed, blue: zeroed,
                decoys: zeroed, hits: zeroed, answer: -1}
            for _attempt in 0..<3000 |level, want, puzzle, rng|:
                puzzle.red <- draw_line(level, &rng)
                puzzle.blue <- draw_line(level, &rng)
                puzzle.hits <- touches(&puzzle.red, &puzzle.blue, want, level.angle)
                continue if puzzle.hits.count != want or not clean(&puzzle.red, &puzzle.blue, &puzzle.hits)
                count: mutable i64 = 0
                for _decoy in 0..<level.decoys |level, puzzle, rng, count|:
                    for _try in 0..<50 |level, puzzle, rng, count|:
                        line: Line = draw_line(level, &rng)
                        if decoy_clean(&line, &puzzle.red, level.angle) and decoy_clean(&line, &puzzle.blue, level.angle):
                            puzzle.decoys[count.usize()] <- line
                            count <- count + 1
                            break
                if count == level.decoys:
                    puzzle.answer <- want
                    return puzzle
            return puzzle
