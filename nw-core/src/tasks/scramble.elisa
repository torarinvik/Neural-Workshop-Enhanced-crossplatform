# Scramble: corrupt a sentence, and ask for it back.
#
#     the black horse walked along the road
#     the balck hrose wlaked alnog the raod
#
# Port of the portable half of neural_workshop/scramble.py
# (GPL-2.0-or-later). The sentence bank and the frequency-ranked vocabulary are
# downloaded corpora, so both are supplied here: a sentence is words, and a
# vocabulary is words with ranks.
#
# The corruption is a PIPELINE, not a rule, and that is what lets the ladder
# run as far as it does. Eight dials, each a different way of taking
# information out, and the order they run in is the whole of the RNG contract:
# drop, then substitute, then insert, then the shuffle, then the swaps.
#
# Three details are easy to lose and each moves every later draw:
#
#   * `drop` is capped at `len - 2`, so a short word keeps two letters -- and
#     the cap is on the COUNT of pops, so a capped word spends fewer draws.
#   * every shuffle RETRIES up to eight times to actually change the slice. A
#     shuffle that comes back the way it went in is a word that was not
#     scrambled, and on a short word that happens often enough to notice.
#   * `substitute` draws its positions with `sample`, then a neighbour per
#     position -- a typo is a NEAR MISS and a random letter is noise.
#
# NOT PORTED: `read_off` and the `read_back` that scores it. Both take
# `candidates(...)[0]`, the commonest fitting word, and `candidates` sorts a
# Python SET OF STRINGS by rank. Ranks tie -- every word the frequency list has
# never seen ties at 1 << 30 -- and a tie is broken by the set's iteration
# order, which for strings is randomised per process by PYTHONHASHSEED. It is
# not reproducible between two runs of the reference itself, let alone across
# languages. The COUNT of candidates is order-independent and is ported, which
# is what `ambiguity` and `pinned` are measured from.

module Scramble:

    const LETTER_COUNT: i64 = 26
    const GRADE_COUNT: i64 = 12

    const MOST_WORDS: i64 = 24
    const MOST_LETTERS: i64 = 640
    const MOST_VOCAB: i64 = 4096

    # Keys next to each other on a qwerty board, flattened: letter L owns
    # NEAR_START[L] .. NEAR_START[L + 1] of NEAR_FLAT.
    def near_start(letter: i64) -> i64:
        can Abort.Panic:
            return 0 if letter == 0
            return 4 if letter == 1
            return 8 if letter == 2
            return 12 if letter == 3
            return 18 if letter == 4
            return 22 if letter == 5
            return 28 if letter == 6
            return 34 if letter == 7
            return 40 if letter == 8
            return 44 if letter == 9
            return 50 if letter == 10
            return 55 if letter == 11
            return 58 if letter == 12
            return 61 if letter == 13
            return 65 if letter == 14
            return 69 if letter == 15
            return 71 if letter == 16
            return 73 if letter == 17
            return 77 if letter == 18
            return 83 if letter == 19
            return 87 if letter == 20
            return 91 if letter == 21
            return 95 if letter == 22
            return 99 if letter == 23
            return 103 if letter == 24
            return 107 if letter == 25
            return 110

    def near_flat(index: i64) -> i64:
        can Abort.Panic:
            return 16 if index == 0
            return 22 if index == 1
            return 18 if index == 2
            return 25 if index == 3
            return 21 if index == 4
            return 6 if index == 5
            return 7 if index == 6
            return 13 if index == 7
            return 23 if index == 8
            return 3 if index == 9
            return 5 if index == 10
            return 21 if index == 11
            return 18 if index == 12
            return 4 if index == 13
            return 17 if index == 14
            return 5 if index == 15
            return 2 if index == 16
            return 23 if index == 17
            return 22 if index == 18
            return 18 if index == 19
            return 3 if index == 20
            return 17 if index == 21
            return 3 if index == 22
            return 17 if index == 23
            return 19 if index == 24
            return 6 if index == 25
            return 21 if index == 26
            return 2 if index == 27
            return 5 if index == 28
            return 19 if index == 29
            return 24 if index == 30
            return 7 if index == 31
            return 1 if index == 32
            return 21 if index == 33
            return 6 if index == 34
            return 24 if index == 35
            return 20 if index == 36
            return 9 if index == 37
            return 13 if index == 38
            return 1 if index == 39
            return 20 if index == 40
            return 9 if index == 41
            return 10 if index == 42
            return 14 if index == 43
            return 7 if index == 44
            return 20 if index == 45
            return 8 if index == 46
            return 10 if index == 47
            return 12 if index == 48
            return 13 if index == 49
            return 9 if index == 50
            return 8 if index == 51
            return 14 if index == 52
            return 11 if index == 53
            return 12 if index == 54
            return 10 if index == 55
            return 14 if index == 56
            return 15 if index == 57
            return 13 if index == 58
            return 9 if index == 59
            return 10 if index == 60
            return 1 if index == 61
            return 7 if index == 62
            return 9 if index == 63
            return 12 if index == 64
            return 8 if index == 65
            return 10 if index == 66
            return 11 if index == 67
            return 15 if index == 68
            return 14 if index == 69
            return 11 if index == 70
            return 22 if index == 71
            return 0 if index == 72
            return 4 if index == 73
            return 3 if index == 74
            return 5 if index == 75
            return 19 if index == 76
            return 0 if index == 77
            return 22 if index == 78
            return 4 if index == 79
            return 3 if index == 80
            return 23 if index == 81
            return 25 if index == 82
            return 17 if index == 83
            return 5 if index == 84
            return 6 if index == 85
            return 24 if index == 86
            return 24 if index == 87
            return 7 if index == 88
            return 9 if index == 89
            return 8 if index == 90
            return 2 if index == 91
            return 5 if index == 92
            return 6 if index == 93
            return 1 if index == 94
            return 16 if index == 95
            return 0 if index == 96
            return 18 if index == 97
            return 4 if index == 98
            return 25 if index == 99
            return 18 if index == 100
            return 3 if index == 101
            return 2 if index == 102
            return 19 if index == 103
            return 6 if index == 104
            return 7 if index == 105
            return 20 if index == 106
            return 0 if index == 107
            return 18 if index == 108
            return 23

    # --- the ladder ------------------------------------------------------

    # One rung: which sentences, and what is done to them. The columns are the
    # reference's own, in its order.
    struct Grade:
        span_low: i64
        span_high: i64
        top_rank: i64
        swap: i64
        interior: bool
        whole: bool
        drop: i64
        insert: i64
        substitute: i64
        spaces: i64
        order: i64

    def grade_at(index: i64) -> Grade:
        can Abort.Panic:
            return Grade{span_low: 6, span_high: 9, top_rank: 3000, swap: 1, interior: false, whole: false, drop: 0, insert: 0, substitute: 0, spaces: 0, order: 0} if index == 0
            return Grade{span_low: 6, span_high: 9, top_rank: 6000, swap: 0, interior: true, whole: false, drop: 0, insert: 0, substitute: 0, spaces: 0, order: 0} if index == 1
            return Grade{span_low: 8, span_high: 12, top_rank: 12000, swap: 0, interior: true, whole: false, drop: 0, insert: 0, substitute: 0, spaces: 0, order: 0} if index == 2
            return Grade{span_low: 8, span_high: 12, top_rank: 12000, swap: 0, interior: false, whole: true, drop: 0, insert: 0, substitute: 0, spaces: 0, order: 0} if index == 3
            return Grade{span_low: 8, span_high: 12, top_rank: 20000, swap: 0, interior: false, whole: true, drop: 0, insert: 0, substitute: 0, spaces: 1, order: 0} if index == 4
            return Grade{span_low: 8, span_high: 12, top_rank: 20000, swap: 0, interior: false, whole: true, drop: 1, insert: 0, substitute: 0, spaces: 0, order: 0} if index == 5
            return Grade{span_low: 8, span_high: 12, top_rank: 30000, swap: 0, interior: false, whole: true, drop: 1, insert: 1, substitute: 0, spaces: 0, order: 0} if index == 6
            return Grade{span_low: 8, span_high: 12, top_rank: 30000, swap: 0, interior: false, whole: true, drop: 1, insert: 0, substitute: 0, spaces: 1, order: 0} if index == 7
            return Grade{span_low: 8, span_high: 12, top_rank: 30000, swap: 0, interior: false, whole: true, drop: 1, insert: 1, substitute: 1, spaces: 0, order: 0} if index == 8
            return Grade{span_low: 8, span_high: 12, top_rank: 30000, swap: 0, interior: false, whole: true, drop: 1, insert: 0, substitute: 0, spaces: 2, order: 0} if index == 9
            return Grade{span_low: 8, span_high: 12, top_rank: 60000, swap: 0, interior: false, whole: true, drop: 1, insert: 0, substitute: 0, spaces: 1, order: 2} if index == 10
            return Grade{span_low: 8, span_high: 14, top_rank: 60000, swap: 0, interior: false, whole: true, drop: 1, insert: 1, substitute: 1, spaces: 2, order: 3}

    def grade_of(rung: i64) -> Grade:
        can Abort.Panic:
            capped: i64 = GRADE_COUNT - 1 if rung - 1 > GRADE_COUNT - 1 else rung - 1
            return grade_at(0 if capped < 0 else capped)

    # --- what the letters still say --------------------------------------

    # Whether the first and last letters of a word survive intact. ONLY when
    # nothing changes the letters themselves: a single drop can take the last
    # letter away, so the moment drop, insert or substitute is on, the ends
    # stop being evidence.
    def anchored(grade: Grade&) -> bool:
        can Abort.Panic:
            return grade.interior and not grade.whole and not (grade.drop != 0 or grade.insert != 0 or grade.substitute != 0)

    # Letters on show that were never in the word.
    def removals(grade: Grade&) -> i64:
        can Abort.Panic:
            return grade.insert + grade.substitute

    # Letters of the word that are not on show.
    def additions(grade: Grade&) -> i64:
        can Abort.Panic:
            return grade.drop + grade.substitute

    def bag_of(letters: mutable darray[i64]&, start: i64, length: i64, out: mutable darray[i64]&, base: i64):
        can Abort.Panic:
            for slot in 0..<LETTER_COUNT |out, base|:
                Ints::put(out, base + slot, 0)
            for at in 0..<length |letters, out, base, start|:
                slot: i64 = base + Ints::at_ref(letters, start + at)
                Ints::put(out, slot, Ints::at_ref(out, slot) + 1)

    # Letters to take out of one bag and put in, to reach the other.
    def bag_distance(left: mutable darray[i64]&, left_base: i64, right: mutable darray[i64]&, right_base: i64) -> i64:
        can Abort.Panic:
            total: mutable i64 = 0
            for slot in 0..<LETTER_COUNT |left, right, left_base, right_base, total|:
                gap: i64 = Ints::at_ref(left, left_base + slot) - Ints::at_ref(right, right_base + slot)
                total <- total + (gap if gap >= 0 else 0 - gap)
            return total

    # Whether a token could be a word corrupted at this grade.
    #
    # A SUPERSET of what the corruption can actually produce, never a subset:
    # it must not reject the truth, or the ambiguity count would be a count of
    # the wrong thing. So it tests only what survives every ordering of the
    # operators -- the length, the letters, and the ends when the ends are safe.
    def feasible(grade: Grade&, token: mutable darray[i64]&, token_start: i64, token_length: i64, word: mutable darray[i64]&, word_start: i64, word_length: i64, scratch: mutable darray[i64]&) -> bool:
        can Abort.Panic:
            false return if word_length == 0
            false return if token_length < word_length - grade.drop or token_length > word_length + grade.insert
            if anchored(grade):
                false return if token_length == 0 or Ints::at_ref(token, token_start) != Ints::at_ref(word, word_start)
                false return if Ints::at_ref(token, token_start + token_length - 1) != Ints::at_ref(word, word_start + word_length - 1)
            bag_of(token, token_start, token_length, scratch, 0)
            bag_of(word, word_start, word_length, scratch, LETTER_COUNT)
            return bag_distance(scratch, 0, scratch, LETTER_COUNT) <= removals(grade) + additions(grade)

    # --- doing the corrupting ---------------------------------------------

    # Shuffle a slice in place, TRYING to actually change it. A shuffle that
    # comes back the way it went in is a word that was not scrambled, and on a
    # short word that happens often enough to notice -- one line in five at
    # rung two, before this.
    #
    # The eighth attempt is kept whether or not it changed anything, which is
    # what the reference's fall-through assignment does.
    def shuffled(letters: mutable darray[i64]&, start: i64, stop: i64, part: mutable darray[i64]&, tried: mutable darray[i64]&, rng: mutable MT19937&):
        can Abort.Panic:
            span: i64 = stop - start
            for at in 0..<span |letters, part, start|:
                Ints::put(part, at, Ints::at_ref(letters, start + at))
            # `len(set(part)) < 2`: nothing to change.
            distinct: mutable i64 = 0
            for probe in 0..<span |part, distinct, probe|:
                seen_before: mutable bool = false
                for earlier in 0..<probe |part, seen_before, probe|:
                    seen_before <- true if Ints::at_ref(part, earlier) == Ints::at_ref(part, probe)
                distinct <- distinct + 1 if not seen_before
            return if distinct < 2
            settled: mutable bool = false
            for _try in 0..<8 |letters, part, tried, start, span, settled, rng|:
                break if settled
                for at in 0..<span |part, tried|:
                    Ints::put(tried, at, Ints::at_ref(part, at))
                py_shuffle_i64_prefix(rng, tried, span)
                same: mutable bool = true
                for at in 0..<span |part, tried, same|:
                    same <- false if Ints::at_ref(tried, at) != Ints::at_ref(part, at)
                settled <- true if not same
            # Whether it settled or ran out, the last attempt is what is kept.
            for at in 0..<span |letters, tried, start|:
                Ints::put(letters, start + at, Ints::at_ref(tried, at))

    # One word, put through every letter dial the grade has turned on.
    def scramble_word(grade: Grade&, word: mutable darray[i64]&, word_start: i64, word_length: i64, out: mutable darray[i64]&, part: mutable darray[i64]&, tried: mutable darray[i64]&, picks: mutable darray[i64]&, rng: mutable MT19937&) -> i64:
        can Memory.Allocate, Abort.Panic:
            length: mutable i64 = word_length
            for at in 0..<word_length |out, word, word_start|:
                Ints::put(out, at, Ints::at_ref(word, word_start + at))
            # `min(drop, max(0, len - 2))`: a short word keeps two letters, and
            # the cap is on the COUNT of pops, so a capped word spends fewer
            # draws than an uncapped one.
            room: i64 = word_length - 2 if word_length - 2 > 0 else 0
            drops: i64 = room if room < grade.drop else grade.drop
            for _each in 0..<drops |out, length, rng|:
                gone: i64 = py_randbelow(rng, length.u64()).i64()
                for at in gone..<(length - 1) |out|:
                    Ints::put(out, at, Ints::at_ref(out, at + 1))
                length <- length - 1
            if grade.substitute != 0 and length > 0:
                wanted: i64 = length if length < grade.substitute else grade.substitute
                chosen: darray[i64] = py_sample_range(rng, 0, length - 1, wanted)
                for slot in 0..<wanted |out, chosen, rng|:
                    where: i64 = Ints::at(chosen, slot)
                    letter: i64 = Ints::at_ref(out, where)
                    first: i64 = near_start(letter)
                    near_count: i64 = near_start(letter + 1) - first
                    # `NEAR_KEYS.get(letter, LETTERS)`: every lowercase letter
                    # has neighbours, so the fallback never fires here.
                    if near_count > 0:
                        Ints::put(out, where, near_flat(first + py_randbelow(rng, near_count.u64()).i64()))
                    else:
                        Ints::put(out, where, py_randbelow(rng, LETTER_COUNT.u64()).i64())
            for _each in 0..<grade.insert |out, length, rng|:
                where: i64 = py_randbelow(rng, (length + 1).u64()).i64()
                fresh: i64 = py_randbelow(rng, LETTER_COUNT.u64()).i64()
                at: mutable i64 = length
                while at > where |out, at, where|:
                    Ints::put(out, at, Ints::at_ref(out, at - 1))
                    at <- at - 1
                Ints::put(out, where, fresh)
                length <- length + 1
            if grade.whole and length > 1:
                shuffled(out, 0, length, part, tried, rng)
            else:
                if grade.interior and length > 3:
                    shuffled(out, 1, length - 1, part, tried, rng)
            for _each in 0..<grade.swap |out, length, rng|:
                if length > 3:
                    at: i64 = 1 + py_randbelow(rng, (length - 3).u64()).i64()
                    held: i64 = Ints::at_ref(out, at)
                    Ints::put(out, at, Ints::at_ref(out, at + 1))
                    Ints::put(out, at + 1, held)
            return length

    # Which word goes where on the page, as indices into the truth. Words are
    # permuted inside BLOCKS, so a long line does not become a bag of words.
    def shuffle_order(grade: Grade&, count: i64, out: mutable darray[i64]&, block: mutable darray[i64]&, rng: mutable MT19937&):
        can Abort.Panic:
            for at in 0..<count |out|:
                Ints::put(out, at, at)
            return if grade.order < 2
            written: mutable i64 = 0
            start: mutable i64 = 0
            while start < count |grade, count, out, block, written, start, rng|:
                stop: i64 = count if start + grade.order > count else start + grade.order
                span: i64 = stop - start
                for at in 0..<span |block, start|:
                    Ints::put(block, at, start + at)
                if span > 1:
                    settled: mutable bool = false
                    for _try in 0..<8 |block, span, start, settled, rng|:
                        break if settled
                        py_shuffle_i64_prefix(rng, block, span)
                        same: mutable bool = true
                        for at in 0..<span |block, start, same|:
                            same <- false if Ints::at_ref(block, at) != start + at
                        settled <- true if not same
                for at in 0..<span |out, block, written|:
                    Ints::put(out, written + at, Ints::at_ref(block, at))
                written <- written + span
                start <- start + grade.order

    # The line broken up the way it will be shown.
    #
    # Moving the gaps means the SAME gaps somewhere else, so the chunks are the
    # words' own lengths shuffled and laid back down across the line. Cutting
    # at uniformly random points instead gives one-letter shards and a line
    # that reads as noise rather than as a line whose spaces are in the wrong
    # places.
    #
    # The retry shuffles the ALREADY SHUFFLED list and compares it against the
    # original -- not a fresh copy each time, which is what `_shuffled` does.
    def respace(grade: Grade&, blob_length: i64, lengths: mutable darray[i64]&, count: i64, sizes: mutable darray[i64]&, out_start: mutable darray[i64]&, out_length: mutable darray[i64]&, rng: mutable MT19937&) -> i64:
        can Abort.Panic:
            if grade.spaces >= 2 or blob_length < 4:
                Ints::put(out_start, 0, 0)
                Ints::put(out_length, 0, blob_length)
                return 1
            for at in 0..<count |sizes, lengths|:
                Ints::put(sizes, at, Ints::at_ref(lengths, at))
            settled: mutable bool = false
            for _try in 0..<8 |sizes, lengths, count, settled, rng|:
                break if settled
                py_shuffle_i64_prefix(rng, sizes, count)
                same: mutable bool = true
                for at in 0..<count |sizes, lengths, same|:
                    same <- false if Ints::at_ref(sizes, at) != Ints::at_ref(lengths, at)
                settled <- true if not same
            written: mutable i64 = 0
            at: mutable i64 = 0
            for slot in 0..<count |sizes, out_start, out_length, blob_length, written, at|:
                break if at >= blob_length
                size: i64 = Ints::at_ref(sizes, slot)
                span: i64 = size if at + size <= blob_length else blob_length - at
                Ints::put(out_start, written, at)
                Ints::put(out_length, written, span)
                written <- written + 1
                at <- at + size
            if at < blob_length:
                Ints::put(out_start, written, at)
                Ints::put(out_length, written, blob_length - at)
                written <- written + 1
            # `part for part in out if part`: a zero-length chunk is dropped.
            kept: mutable i64 = 0
            for slot in 0..<written |out_start, out_length, kept|:
                if Ints::at_ref(out_length, slot) != 0:
                    Ints::put(out_start, kept, Ints::at_ref(out_start, slot))
                    Ints::put(out_length, kept, Ints::at_ref(out_length, slot))
                    kept <- kept + 1
            return kept

    # --- the vocabulary a solver may draw on ------------------------------

    # Words with ranks, indexed by their LETTERS: the token's letters, minus up
    # to `removals` of them, plus up to `additions` of any, is a bag, and a bag
    # is a key straight into the index. Scanning the whole word list per token
    # instead would be a hundred times slower.
    #
    # A word already in the index under the same LETTERS in the same order is
    # not chained again: the reference collects candidates into a set of
    # STRINGS, so a vocabulary holding the same word twice counts it once.
    struct Vocab:
        count: mutable i64
        start: mutable darray[i64]
        length: mutable darray[i64]
        letter: mutable darray[i64]
        rank: mutable darray[i64]
        bag: mutable darray[i64]
        head: mutable darray[i64]
        next: mutable darray[i64]
        found: mutable darray[i64]

    const VOCAB_SLOTS: i64 = 8192
    const VOCAB_MASK: i64 = 8191

    def new_vocab() -> Vocab:
        can Memory.Allocate, Abort.Panic:
            return Vocab{count: 0, start: Ints::zeros(MOST_VOCAB), length: Ints::zeros(MOST_VOCAB),
                         letter: Ints::zeros(MOST_VOCAB * 32), rank: Ints::zeros(MOST_VOCAB),
                         bag: Ints::zeros(MOST_VOCAB * LETTER_COUNT), head: Ints::zeros(VOCAB_SLOTS),
                         next: Ints::zeros(MOST_VOCAB), found: Ints::zeros(MOST_VOCAB)}

    def bag_hash(bag: mutable darray[i64]&, base: i64) -> i64:
        can Abort.Panic:
            mixed: mutable u64 = 14695981039346656037.u64()
            for slot in 0..<LETTER_COUNT |bag, base, mixed|:
                mixed <- (mixed ^ Ints::at_ref(bag, base + slot).u64()) * 1099511628211.u64()
            return (mixed >> 11.u64()).i64() & VOCAB_MASK

    def same_word(vocab: mutable Vocab&, left: i64, right: i64) -> bool:
        can Abort.Panic:
            length: i64 = Ints::at_ref(&vocab.length, left)
            false return if length != Ints::at_ref(&vocab.length, right)
            left_start: i64 = Ints::at_ref(&vocab.start, left)
            right_start: i64 = Ints::at_ref(&vocab.start, right)
            for at in 0..<length |vocab, left_start, right_start|:
                false return if Ints::at_ref(&vocab.letter, left_start + at) != Ints::at_ref(&vocab.letter, right_start + at)
            return true

    def index_vocab(vocab: mutable Vocab&):
        can Abort.Panic:
            for slot in 0..<VOCAB_SLOTS |vocab|:
                Ints::put(&vocab.head, slot, 0)
            for word in 0..<vocab.count |vocab|:
                bag_of(&vocab.letter, Ints::at_ref(&vocab.start, word), Ints::at_ref(&vocab.length, word), &vocab.bag, word * LETTER_COUNT)
                slot: i64 = bag_hash(&vocab.bag, word * LETTER_COUNT)
                # A word already chained under the same letters in the same
                # order is the SAME STRING, and the reference's set holds it
                # once. Two words with the same letters in a different order
                # are two words and both are chained.
                twin: mutable bool = false
                probe: mutable i64 = Ints::at_ref(&vocab.head, slot) - 1
                while probe >= 0 and not twin |vocab, word, probe, twin|:
                    twin <- true if same_word(vocab, probe, word)
                    probe <- Ints::at_ref(&vocab.next, probe) - 1
                continue if twin
                Ints::put(&vocab.next, word, Ints::at_ref(&vocab.head, slot))
                Ints::put(&vocab.head, slot, word + 1)

    def bag_equal(left: mutable darray[i64]&, left_base: i64, right: mutable darray[i64]&, right_base: i64) -> bool:
        can Abort.Panic:
            for slot in 0..<LETTER_COUNT |left, right, left_base, right_base|:
                false return if Ints::at_ref(left, left_base + slot) != Ints::at_ref(right, right_base + slot)
            return true

    # Every word in the vocabulary a token could have been -- counted, not
    # listed, because the list's ORDER is not reproducible (see the module
    # comment) and only the count is measured.
    def candidates_count(grade: Grade&, token: mutable darray[i64]&, token_start: i64, token_length: i64, vocab: mutable Vocab&, scratch: mutable darray[i64]&, odometer: mutable darray[i64]&, distinct: mutable darray[i64]&) -> i64:
        can Abort.Panic:
            take: i64 = removals(grade)
            give: i64 = additions(grade)
            low: i64 = token_length - grade.insert
            high: i64 = token_length + grade.drop
            # `sorted(set(token))`, which is ascending letter order.
            distinct_n: mutable i64 = 0
            for value in 0..<LETTER_COUNT |token, token_start, token_length, distinct, distinct_n|:
                present: mutable bool = false
                for at in 0..<token_length |token, token_start, present, value|:
                    present <- true if Ints::at_ref(token, token_start + at) == value
                if present:
                    Ints::put(distinct, distinct_n, value)
                    distinct_n <- distinct_n + 1
            for word in 0..<vocab.count |vocab|:
                Ints::put(&vocab.found, word, 0)
            # scratch: 0.. = the token's bag, LETTER_COUNT.. = the stem's,
            # 2 * LETTER_COUNT.. = the key being looked up.
            bag_of(token, token_start, token_length, scratch, 0)
            for gone in 0..<(take + 1) |grade, token_length, low, high, give, vocab, scratch, odometer, distinct, distinct_n|:
                continue if gone > 0 and distinct_n == 0
                for at in 0..<gone |odometer|:
                    Ints::put(odometer, at, 0)
                more_out: mutable bool = true
                while more_out |grade, token_length, low, high, give, vocab, scratch, odometer, distinct, distinct_n, gone, more_out|:
                    for slot in 0..<LETTER_COUNT |scratch|:
                        Ints::put(scratch, LETTER_COUNT + slot, Ints::at_ref(scratch, slot))
                    negative: mutable bool = false
                    for at in 0..<gone |scratch, odometer, distinct, negative|:
                        slot: i64 = LETTER_COUNT + Ints::at_ref(distinct, Ints::at_ref(odometer, at))
                        Ints::put(scratch, slot, Ints::at_ref(scratch, slot) - 1)
                        negative <- true if Ints::at_ref(scratch, slot) < 0
                    if not negative:
                        for added in 0..<(give + 1) |grade, token_length, low, high, vocab, scratch, gone|:
                            stem_size: i64 = token_length - gone + added
                            continue if stem_size < low or stem_size > high
                            walk_extras(vocab, scratch, added, 0, 0)
                    # Step the odometer: combinations_with_replacement is a
                    # NON-DECREASING tuple, so a carry resets the tail to the
                    # digit it rolled into.
                    if gone == 0:
                        more_out <- false
                    else:
                        digit: mutable i64 = gone - 1
                        rolling: mutable bool = true
                        while rolling and digit >= 0 |odometer, distinct_n, digit, rolling|:
                            Ints::put(odometer, digit, Ints::at_ref(odometer, digit) + 1)
                            if Ints::at_ref(odometer, digit) < distinct_n:
                                rolling <- false
                            else:
                                digit <- digit - 1
                        if rolling:
                            more_out <- false
                        else:
                            for tail_at in (digit + 1)..<gone |odometer, digit|:
                                Ints::put(odometer, tail_at, Ints::at_ref(odometer, digit))
            total: mutable i64 = 0
            for word in 0..<vocab.count |vocab, grade, token, token_start, token_length, total|:
                continue if Ints::at_ref(&vocab.found, word) == 0
                if anchored(grade):
                    word_start: i64 = Ints::at_ref(&vocab.start, word)
                    word_length: i64 = Ints::at_ref(&vocab.length, word)
                    continue if word_length == 0 or token_length == 0
                    continue if Ints::at_ref(&vocab.letter, word_start) != Ints::at_ref(token, token_start)
                    continue if Ints::at_ref(&vocab.letter, word_start + word_length - 1) != Ints::at_ref(token, token_start + token_length - 1)
                total <- total + 1
            return total

    # `combinations_with_replacement(LETTERS, added)`, walked recursively: the
    # stem's bag plus `added` more letters, non-decreasing, looked up as a key.
    def walk_extras(vocab: mutable Vocab&, scratch: mutable darray[i64]&, left: i64, from_letter: i64, depth: i64):
        can Abort.Panic:
            if left == 0:
                for slot in 0..<LETTER_COUNT |scratch|:
                    Ints::put(scratch, 2 * LETTER_COUNT + slot, Ints::at_ref(scratch, LETTER_COUNT + slot))
                probe: mutable i64 = Ints::at_ref(&vocab.head, bag_hash(scratch, 2 * LETTER_COUNT)) - 1
                while probe >= 0 |vocab, scratch, probe|:
                    if bag_equal(&vocab.bag, probe * LETTER_COUNT, scratch, 2 * LETTER_COUNT):
                        Ints::put(&vocab.found, probe, 1)
                    probe <- Ints::at_ref(&vocab.next, probe) - 1
                return
            for value in from_letter..<LETTER_COUNT |vocab, scratch, left, depth|:
                slot: i64 = LETTER_COUNT + value
                Ints::put(scratch, slot, Ints::at_ref(scratch, slot) + 1)
                walk_extras(vocab, scratch, left - 1, value, depth + 1)
                Ints::put(scratch, slot, Ints::at_ref(scratch, slot) - 1)

    # --- one deal ---------------------------------------------------------

    # One corrupted sentence and everything measured about it.
    struct Deal:
        given: mutable bool
        words: mutable i64
        # Which word of the answer each shown word is, after `order`.
        placing: mutable darray[i64]
        # The corrupted words, in the order they are shown.
        corrupted_start: mutable darray[i64]
        corrupted_length: mutable darray[i64]
        corrupted_letter: mutable darray[i64]
        corrupted_letters: mutable i64
        # What is actually PRINTED. More than one chunk means the spaces are
        # where the corruption left them, not where the words are.
        chunks: mutable i64
        chunk_start: mutable darray[i64]
        chunk_length: mutable darray[i64]
        # Base-ten log of the number of readings the letters alone allow, and
        # the words whose letters allow exactly one.
        ambiguity: mutable f64
        pinned: mutable i64
        sentence: mutable i64

    def new_deal() -> Deal:
        can Memory.Allocate, Abort.Panic:
            return Deal{given: false, words: 0, placing: Ints::zeros(MOST_WORDS),
                        corrupted_start: Ints::zeros(MOST_WORDS),
                        corrupted_length: Ints::zeros(MOST_WORDS),
                        corrupted_letter: Ints::zeros(MOST_LETTERS),
                        corrupted_letters: 0, chunks: 0,
                        chunk_start: Ints::zeros(MOST_WORDS * 2),
                        chunk_length: Ints::zeros(MOST_WORDS * 2),
                        ambiguity: 0.0, pinned: 0, sentence: -1}

    # A bank of sentences, flattened: sentence s owns words
    # `word_at[s] .. word_at[s] + words[s]`, and word w owns letters
    # `letter_at[w] .. letter_at[w] + word_length[w]`.
    struct Bank:
        count: mutable i64
        words: mutable darray[i64]
        word_at: mutable darray[i64]
        word_length: mutable darray[i64]
        letter_at: mutable darray[i64]
        letter: mutable darray[i64]

    # Scratch for one deal, sized once.
    struct Work:
        block: mutable darray[i64]
        part: mutable darray[i64]
        tried: mutable darray[i64]
        picks: mutable darray[i64]
        sizes: mutable darray[i64]
        lengths: mutable darray[i64]
        scratch: mutable darray[i64]
        odometer: mutable darray[i64]
        distinct: mutable darray[i64]
        one_word: mutable darray[i64]

    def new_work() -> Work:
        can Memory.Allocate, Abort.Panic:
            return Work{block: Ints::zeros(MOST_WORDS), part: Ints::zeros(64),
                        tried: Ints::zeros(64), picks: Ints::zeros(64),
                        sizes: Ints::zeros(MOST_WORDS), lengths: Ints::zeros(MOST_WORDS),
                        scratch: Ints::zeros(LETTER_COUNT * 3), odometer: Ints::zeros(8),
                        distinct: Ints::zeros(LETTER_COUNT), one_word: Ints::zeros(64)}

    # One corrupted sentence at a grade, or nothing with nothing to use.
    def deal_one(grade: Grade&, bank: mutable Bank&, vocab: mutable Vocab&, work: mutable Work&, out: mutable Deal&, rng: mutable MT19937&):
        can Memory.Allocate, Abort.Panic:
            out.given <- false
            return if bank.count == 0
            sentence: i64 = py_randbelow(rng, bank.count.u64()).i64()
            count: i64 = Ints::at_ref(&bank.words, sentence)
            first_word: i64 = Ints::at_ref(&bank.word_at, sentence)
            out.sentence <- sentence
            out.words <- count
            shuffle_order(grade, count, &out.placing, &work.block, rng)
            written: mutable i64 = 0
            for slot in 0..<count |grade, bank, out, work, written, first_word, rng|:
                where: i64 = Ints::at_ref(&out.placing, slot)
                word: i64 = first_word + where
                length: i64 = scramble_word(grade, &bank.letter, Ints::at_ref(&bank.letter_at, word), Ints::at_ref(&bank.word_length, word), &work.one_word, &work.part, &work.tried, &work.picks, rng)
                Ints::put(&out.corrupted_start, slot, written)
                Ints::put(&out.corrupted_length, slot, length)
                for at in 0..<length |out, work, written|:
                    Ints::put(&out.corrupted_letter, written + at, Ints::at_ref(&work.one_word, at))
                written <- written + length
            out.corrupted_letters <- written
            if grade.spaces < 1:
                out.chunks <- count
                for slot in 0..<count |out|:
                    Ints::put(&out.chunk_start, slot, Ints::at_ref(&out.corrupted_start, slot))
                    Ints::put(&out.chunk_length, slot, Ints::at_ref(&out.corrupted_length, slot))
            else:
                for slot in 0..<count |out, work|:
                    Ints::put(&work.lengths, slot, Ints::at_ref(&out.corrupted_length, slot))
                out.chunks <- respace(grade, written, &work.lengths, count, &work.sizes, &out.chunk_start, &out.chunk_length, rng)
            total: mutable f64 = 0.0
            pinned: mutable i64 = 0
            for slot in 0..<count |grade, out, vocab, work, total, pinned|:
                fits: i64 = candidates_count(grade, &out.corrupted_letter, Ints::at_ref(&out.corrupted_start, slot), Ints::at_ref(&out.corrupted_length, slot), vocab, &work.scratch, &work.odometer, &work.distinct)
                counted: i64 = 1 if fits < 1 else fits
                total <- total + log10(counted.f64())
                pinned <- pinned + 1 if counted == 1
            out.ambiguity <- total
            out.pinned <- pinned
            out.given <- true

    # --- marking -----------------------------------------------------------

    # What a typed answer comes down to: lowercase words and spaces.
    #
    # The input alphabet is 0..25 for letters, SPACE for a gap and OTHER for
    # anything the reference's `[^a-z ]+` would replace with one. Runs of
    # either collapse to a single gap and the ends are trimmed, which is what
    # `' '.join(....split())` does.
    const SPACE: i64 = 26
    const OTHER: i64 = 27

    def normalise(text: mutable darray[i64]&, length: i64, out: mutable darray[i64]&) -> i64:
        can Abort.Panic:
            written: mutable i64 = 0
            gap: mutable bool = false
            for at in 0..<length |text, out, written, gap|:
                value: i64 = Ints::at_ref(text, at)
                if value == SPACE or value == OTHER:
                    gap <- true
                else:
                    if gap and written > 0:
                        Ints::put(out, written, SPACE)
                        written <- written + 1
                    gap <- false
                    Ints::put(out, written, value)
                    written <- written + 1
            return written

    # Whether a typed answer is the sentence, once both are normalised. The
    # answer is the TRUE words in their written order, joined by single spaces.
    def correct(bank: mutable Bank&, sentence: i64, typed: mutable darray[i64]&, typed_length: i64, out: mutable darray[i64]&) -> bool:
        can Abort.Panic:
            written: i64 = normalise(typed, typed_length, out)
            count: i64 = Ints::at_ref(&bank.words, sentence)
            first_word: i64 = Ints::at_ref(&bank.word_at, sentence)
            at: mutable i64 = 0
            for slot in 0..<count |bank, out, written, at, first_word|:
                if slot > 0:
                    false return if at >= written or Ints::at_ref(out, at) != SPACE
                    at <- at + 1
                word: i64 = first_word + slot
                length: i64 = Ints::at_ref(&bank.word_length, word)
                start: i64 = Ints::at_ref(&bank.letter_at, word)
                for letter_at in 0..<length |bank, out, written, at, start|:
                    false return if at >= written or Ints::at_ref(out, at) != Ints::at_ref(&bank.letter, start + letter_at)
                    at <- at + 1
            return at == written
