include "./echo_cave.elisa"
include "../tone_pcm.elisa"

module EchoCaveAudio:
    def glass(pitch: f64, bright: f64) -> TonePcm::Patch:
        factor: f64 = 1.0 if bright == 1.0 else 0.928901697685371
        parts: TonePcm::Partial[6] = [
            TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
            TonePcm::Partial{ratio: 2.3834799706469836, gain: 0.6 * factor, decay: 0.8},
            TonePcm::Partial{ratio: 4.364196009200134, gain: 0.4 * factor, decay: 1.6},
            TonePcm::Partial{ratio: 6.63, gain: 0.25 * factor, decay: 2.5}, zeroed, zeroed]
        count: i64 = 4 if 6.63 * pitch < 0.42 * TonePcm::RATE.f64() else 3
        return TonePcm::Patch{partials: parts, count: count, attack: 0.005,
            decay: 1.093572328254434, release: 0.5, sustain: 0.0, tremolo_rate: 0.0, tremolo_depth: 0.0}

    def pad() -> TonePcm::Patch:
        parts: TonePcm::Partial[6] = [
            TonePcm::Partial{ratio: 1.0, gain: 0.7, decay: 0.0},
            TonePcm::Partial{ratio: 1.0054277877625513, gain: 0.7, decay: 0.0},
            TonePcm::Partial{ratio: 2.0, gain: 0.3 * 0.6155722066724582, decay: 0.0},
            TonePcm::Partial{ratio: 0.5, gain: 0.3, decay: 0.0}, zeroed, zeroed]
        return TonePcm::Patch{partials: parts, count: 4, attack: 0.15, decay: 0.3,
            release: 0.3, sustain: 0.8, tremolo_rate: 3.026537535177571, tremolo_depth: 0.3}

    def chirp() -> TonePcm::Patch:
        parts: TonePcm::Partial[6] = [
            TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
            TonePcm::Partial{ratio: 2.0, gain: 0.3 * 0.779055912670449, decay: 0.0},
            zeroed, zeroed, zeroed, zeroed]
        return TonePcm::Patch{partials: parts, count: 2, attack: 0.005, decay: 4.736048089737435,
            release: 0.08, sustain: 0.0, tremolo_rate: 0.0, tremolo_depth: 0.0}

    def render(run: EchoCave::Run&, begin: f64, end: f64, dest: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 0 if not (end > begin and end - begin <= 30.0)
            frames: i64 = py_round_half_even((end - begin) * TonePcm::RATE.f64())
            return 0 if frames < 1 or frames > capacity / TonePcm::FRAME_BYTES
            stereo: mutable darray[f64] = TonePcm::empty(frames)
            wood: TonePcm::Patch = TonePcm::wood(2400.0, 1.0)
            far: TonePcm::Patch = pad()
            moth: TonePcm::Patch = chirp()
            for i in 0..<run.cue_count |run, begin, end, stereo, frames, wood, far, moth|:
                cue: EchoCave::Cue = run.cues[i.usize()]
                continue if cue.time >= end or cue.time + cue.duration + 0.5 <= begin
                if cue.voice == EchoCave::CLICK_SOUND:
                    TonePcm::mix(&stereo, frames, begin, end, &wood, cue.time, cue.duration, cue.pitch, cue.pan, cue.gain)
                elif cue.voice == EchoCave::FAR_SOUND:
                    TonePcm::mix(&stereo, frames, begin, end, &far, cue.time, cue.duration, cue.pitch, cue.pan, cue.gain)
                elif cue.voice == EchoCave::ECHO_SOUND:
                    echo: TonePcm::Patch = glass(cue.pitch, cue.bright)
                    TonePcm::mix(&stereo, frames, begin, end, &echo, cue.time, cue.duration, cue.pitch, cue.pan, cue.gain)
                else:
                    note: TonePcm::Note = TonePcm::Note{onset: cue.time, duration: cue.duration, frequency: cue.pitch,
                        pan: cue.pan, end_pan: cue.pan, gain: cue.gain, end_gain: cue.gain,
                        vibrato_rate: 0.0, vibrato_depth: 0.0, noise: 0.0, glide: 1.0, glide_time: 0.041769735240701336, seed: 0}
                    TonePcm::mix_note(&stereo, frames, begin, end, &moth, &note)
            return TonePcm::write(stereo, frames, dest)
