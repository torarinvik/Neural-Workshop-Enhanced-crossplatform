# Two Hands -- three lanes, a jump, a throttle, a deadline, and a sky that
# wants the other hand. Ported from neural_workshop/twohands.py.
#
# Two things here are easy to get subtly wrong, and both are recorded rather
# than rediscovered:
#
# 1. `math.hypot`. CPython's is correctly rounded; `sqrt(a*a + b*b)` differs
#    from it in the last ulp for 38% of arguments over this module's domain
#    (both coordinates live in 0..1). That sounds fatal for a differential and
#    is not: every hypot here feeds a COMPARISON -- `gap < best_gap`, a `min`
#    over targets, `<= RETICLE * 0.8` -- and a last-ulp difference only flips a
#    comparison when the two true distances are themselves within an ulp. Run
#    against the real module over 5,400 plays (10 levels x 60 seeds x 3 wants
#    x 3 looks) with `math.hypot` swapped for the naive form, not one play
#    changed. So `sqrt` it is, and the measurement is the reason.
#
# 2. `line`'s tie-break. Its layers are DICTS and it finishes with
#    `min(layers[length], key=...)`, which returns the first key holding the
#    minimum in INSERTION order. So a layer is an ordered list plus a lookup
#    table, appended to on first arrival -- not a hash set. Nothing here needs
#    CPython's hash ORDER, only its insertion order, which is the cheap half.

# NOTE: needs elisacore_math (sqrt, floor, ceil) included by the driver, as
# every task module here relies on its driver for the runtime includes.

# --- the ports ---

module TwoHands:
    const HOLD: i64 = 0
    const LEFT: i64 = 1
    const RIGHT: i64 = 2
    const JUMP: i64 = 3
    const FASTER: i64 = 4
    const SLOWER: i64 = 5
    const AIM_LEFT: i64 = 6
    const AIM_RIGHT: i64 = 7
    const AIM_UP: i64 = 8
    const AIM_DOWN: i64 = 9
    const FIRE: i64 = 10
    const PORTS: i64 = 11

    const LANES: i64 = 3
    const SUB: i64 = 4
    const CAR: i64 = 3
    const BODY: i64 = 3
    const SPAN: i64 = 5
    const TOP: i64 = 4
    const RUN_IN: i64 = 4
    const GAP: i64 = 4
    const ALOFT: i64 = 40
    const NUDGE: f64 = 0.10
    const RETICLE: f64 = 0.11

    # The nine kinds, in the two bits the rules actually read. `toll` is an index
    # rather than a string: fatal, clip, ramp, boost, coin.
    const TOLL_FATAL: i64 = 0
    const TOLL_CLIP: i64 = 1
    const TOLL_RAMP: i64 = 2
    const TOLL_BOOST: i64 = 3
    const TOLL_COIN: i64 = 4

    const DONKEY: i64 = 0
    const TRUCK: i64 = 1
    const BARRIER: i64 = 2
    const LOG: i64 = 3
    const RUBBLE: i64 = 4
    const CONE: i64 = 5
    const RAMP: i64 = 6
    const PAD: i64 = 7
    const COIN: i64 = 8

    def kind_tall(kind: i64) -> bool:
        can Abort.Panic:
            return kind == DONKEY or kind == TRUCK or kind == BARRIER or kind == RUBBLE

    def kind_toll(kind: i64) -> i64:
        can Abort.Panic:
            if kind == DONKEY or kind == TRUCK or kind == BARRIER or kind == LOG:
                return TOLL_FATAL
            if kind == RUBBLE or kind == CONE:
                return TOLL_CLIP
            if kind == RAMP:
                return TOLL_RAMP
            if kind == PAD:
                return TOLL_BOOST
            return TOLL_COIN

    # `BLOCKING` -- what a line has to get past rather than through.
    def is_blocking(kind: i64) -> bool:
        can Abort.Panic:
            toll: i64 = kind_toll(kind)
            return toll == TOLL_FATAL or toll == TOLL_CLIP

    def fatal(kind: i64) -> bool:
        can Abort.Panic:
            return kind_toll(kind) == TOLL_FATAL

    struct Grade:
        rows: mutable i64
        density: mutable f64
        pairs: mutable f64
        swerve: mutable i64
        hang: mutable i64
        top: mutable i64
        slack: mutable f64
        kind_count: mutable i64
        kinds: mutable i64[9]
        sky: mutable f64

    const GRADE_COUNT: i64 = 10

    def grade_of(level: i64) -> Grade:
        can Abort.Panic:
            index: mutable i64 = level - 1
            index <- 0 if index < 0
            index <- GRADE_COUNT - 1 if index > GRADE_COUNT - 1
            g: mutable Grade = zeroed
            # _TALL, then _FLAT, _COST, _ALL -- each rung adds a single thing.
            fill: mutable i64 = 0
            while fill < 9 |fill, g|:
                g.kinds[fill.usize()] <- fill
                fill <- fill + 1
            g.swerve <- 2
            g.hang <- 3
            if index == 0:
                g.rows <- 28
                g.density <- 0.16
                g.pairs <- 0.00
                g.top <- 2
                g.slack <- 1.70
                g.kind_count <- 3
                g.sky <- 0.04
            if index == 1:
                g.rows <- 32
                g.density <- 0.26
                g.pairs <- 0.00
                g.top <- 2
                g.slack <- 1.62
                g.kind_count <- 3
                g.sky <- 0.07
            if index == 2:
                g.rows <- 34
                g.density <- 0.30
                g.pairs <- 0.25
                g.top <- 3
                g.slack <- 1.55
                g.kind_count <- 3
                g.sky <- 0.10
            if index == 3:
                g.rows <- 36
                g.density <- 0.34
                g.pairs <- 0.25
                g.top <- 3
                g.slack <- 1.50
                g.kind_count <- 4
                g.sky <- 0.12
            if index == 4:
                g.rows <- 48
                g.density <- 0.34
                g.pairs <- 0.30
                g.top <- 3
                g.slack <- 1.45
                g.kind_count <- 4
                g.sky <- 0.14
            if index == 5:
                g.rows <- 40
                g.density <- 0.40
                g.pairs <- 0.30
                g.top <- 3
                g.slack <- 1.40
                g.kind_count <- 6
                g.sky <- 0.16
            if index == 6:
                g.rows <- 42
                g.density <- 0.44
                g.pairs <- 0.35
                g.top <- 4
                g.slack <- 1.36
                g.kind_count <- 9
                g.sky <- 0.18
            if index == 7:
                g.rows <- 44
                g.density <- 0.44
                g.pairs <- 0.35
                g.top <- 4
                g.slack <- 1.32
                g.kind_count <- 9
                g.sky <- 0.20
            if index == 8:
                g.rows <- 56
                g.density <- 0.50
                g.pairs <- 0.40
                g.top <- 4
                g.slack <- 1.28
                g.kind_count <- 9
                g.sky <- 0.24
            if index == 9:
                g.rows <- 56
                g.density <- 0.56
                g.pairs <- 0.45
                g.hang <- 4
                g.top <- 4
                g.slack <- 1.25
                g.kind_count <- 9
                g.sky <- 0.28
            # The wide swerve, from the eighth rung on.
            g.swerve <- 3 if index >= 7
            return g

    def grade_length(g: Grade) -> i64:
        can Abort.Panic:
            return g.rows * SUB

    const MOST_LENGTH: i64 = 224
    # Hazards go down at most two abreast and never closer than SPAN + GAP, so no
    # sub-row is ever marked by more than two. Four is slack, not a guess.
    const MARK_STRIDE: i64 = 4
    const MOST_HAZARDS: i64 = 64
    const MOST_SKY: i64 = 224

    struct Road:
        grade: mutable Grade
        length: mutable i64
        haz_at: mutable darray[i64]
        haz_lane: mutable darray[i64]
        haz_kind: mutable darray[i64]
        haz_n: mutable i64
        # One run per sub-row, each TH_MARK_STRIDE long with its own count: the
        # hazards overlapping it, beginning at it, and ending at it.
        marks: mutable darray[i64]
        marks_n: mutable darray[i64]
        heads: mutable darray[i64]
        heads_n: mutable darray[i64]
        tails: mutable darray[i64]
        tails_n: mutable darray[i64]
        sky_at: mutable darray[i64]
        sky_across: mutable darray[f64]
        sky_up: mutable darray[f64]
        sky_drift: mutable darray[f64]
        sky_n: mutable i64
        start: mutable i64
        clock: mutable i64
        par: mutable i64

    def Road() -> Road:
        can Memory.Allocate, Abort.Panic:
            road: mutable Road = zeroed
            road.haz_at <- Ints::zeros(MOST_HAZARDS)
            road.haz_lane <- Ints::zeros(MOST_HAZARDS)
            road.haz_kind <- Ints::zeros(MOST_HAZARDS)
            road.marks <- Ints::zeros(MOST_LENGTH * MARK_STRIDE)
            road.marks_n <- Ints::zeros(MOST_LENGTH)
            road.heads <- Ints::zeros(MOST_LENGTH * MARK_STRIDE)
            road.heads_n <- Ints::zeros(MOST_LENGTH)
            road.tails <- Ints::zeros(MOST_LENGTH * MARK_STRIDE)
            road.tails_n <- Ints::zeros(MOST_LENGTH)
            road.sky_at <- Ints::zeros(MOST_SKY)
            road.sky_across <- Floats::zeros(MOST_SKY)
            road.sky_up <- Floats::zeros(MOST_SKY)
            road.sky_drift <- Floats::zeros(MOST_SKY)
            return road

    # The last sub-row a hazard blocks, and where its drawn body begins.
    def haz_end(at: i64) -> i64:
        can Abort.Panic:
            return at + SPAN - 1

    struct Ride:
        at: mutable i64
        lane: mutable i64
        into: mutable i64
        cross: mutable i64
        air: mutable i64
        speed: mutable i64
        ticks: mutable i64
        hit: mutable bool
        passed: mutable i64
        clipped: mutable i64
        points: mutable i64

    def is_settled(ride: Ride) -> bool:
        can Abort.Panic:
            return ride.cross == 0 and ride.air == 0

    def share(ride: Ride, g: Grade) -> f64:
        can Abort.Panic:
            if ride.cross == 0:
                return 0.0
            return (g.swerve - ride.cross + 1).f64() / (g.swerve + 1).f64()

    def drawn_lane(ride: Ride, g: Grade) -> f64:
        can Abort.Panic:
            return ride.lane.f64() + (ride.into - ride.lane).f64() * share(ride, g)

    def start_ride(road: Road&) -> Ride:
        can Abort.Panic:
            ride: mutable Ride = zeroed
            ride.lane <- road.start
            ride.into <- road.start
            ride.speed <- 1
            return ride

    # One wheel port, if the car is in a position to take it. A commitment already
    # under way swallows the port whole -- every one of them.
    def press(ride: Ride, port: i64, g: Grade) -> Ride:
        can Abort.Panic:
            out: mutable Ride = ride
            if not is_settled(ride):
                return out
            lane: i64 = ride.lane
            if port == LEFT and lane > 0:
                out.into <- lane - 1
                out.cross <- g.swerve
            if port == RIGHT and lane < LANES - 1:
                out.into <- lane + 1
                out.cross <- g.swerve
            if port == JUMP:
                out.air <- g.hang
            if port == FASTER:
                out.speed <- g.top if ride.speed + 1 > g.top else ride.speed + 1
            if port == SLOWER:
                out.speed <- 1 if ride.speed - 1 < 1 else ride.speed - 1
            return out

    # One tick of road, met by the car the port left behind.
    #
    # The tick moves by the gear it STARTED in, and everything a toll pays out is
    # priced in that gear too: `moved` is read once, before the sweep, and a clip
    # or a pad met half way through changes the next tick and not this one.
    def advance(ride: Ride, road: Road&) -> Ride:
        can Abort.Panic:
            g: Grade = road.grade
            lane: mutable i64 = ride.lane
            into: mutable i64 = ride.into
            cross: mutable i64 = ride.cross
            air: mutable i64 = ride.air
            speed: mutable i64 = ride.speed
            at: i64 = ride.at
            length: i64 = road.length
            hit: mutable bool = ride.hit
            passed: mutable i64 = ride.passed
            clipped: mutable i64 = ride.clipped
            points: mutable i64 = ride.points
            # `covers` -- the lanes a hazard would have to stand in to be met.
            cover_a: i64 = ride.lane
            cover_b: i64 = ride.into if ride.cross != 0 else ride.lane
            moved: i64 = speed
            step: mutable i64 = 0
            stop: mutable bool = false
            while step < moved and not stop |step, moved, at, length, road, g, cover_a, cover_b, air, cross, hit, passed, clipped, points, speed, stop|:
                here: i64 = at + step
                if here >= length:
                    stop <- true
                if not stop:
                    slot: mutable i64 = 0
                    count: i64 = Ints::at(road.marks_n, here)
                    while slot < count and not hit |slot, count, here, road, cover_a, cover_b, air, cross, g, hit, clipped, points, speed, moved|:
                        index: i64 = Ints::at(road.marks, here * MARK_STRIDE + slot)
                        haz_lane: i64 = Ints::at(road.haz_lane, index)
                        kind: i64 = Ints::at(road.haz_kind, index)
                        tall: bool = kind_tall(kind)
                        toll: i64 = kind_toll(kind)
                        skip: mutable bool = haz_lane != cover_a and haz_lane != cover_b
                        skip <- true if not tall and air != 0
                        if not skip:
                            if toll == TOLL_FATAL:
                                # Any moment of overlap, which is why this is
                                # checked on every swept sub-row rather than once.
                                hit <- true
                            else:
                                # Met once, at the meeting: only where the run begins.
                                begins: mutable bool = false
                                look: mutable i64 = 0
                                head_count: i64 = Ints::at(road.heads_n, here)
                                while look < head_count |look, head_count, here, road, index, begins|:
                                    begins <- true if Ints::at(road.heads, here * MARK_STRIDE + look) == index
                                    look <- look + 1
                                if begins:
                                    if toll == TOLL_CLIP:
                                        clipped <- clipped + 1
                                        points <- points - 1
                                        speed <- 1
                                    if toll == TOLL_RAMP:
                                        # Mid-swerve the wheels are not square to
                                        # it, so it does nothing -- which also keeps
                                        # a ride from being airborne and across the
                                        # middle at once.
                                        air <- g.hang if cross == 0
                                    if toll == TOLL_BOOST:
                                        speed <- g.top if speed + 1 > g.top else speed + 1
                                        points <- points + 1
                                    if toll == TOLL_COIN:
                                        points <- points + moved
                        slot <- slot + 1
                    if hit:
                        stop <- true
                    if not stop:
                        tail_slot: mutable i64 = 0
                        tail_count: i64 = Ints::at(road.tails_n, here)
                        while tail_slot < tail_count |tail_slot, tail_count, here, road, passed|:
                            index: i64 = Ints::at(road.tails, here * MARK_STRIDE + tail_slot)
                            passed <- passed + 1 if fatal(Ints::at(road.haz_kind, index))
                            tail_slot <- tail_slot + 1
                step <- step + 1
            if cross != 0:
                cross <- cross - 1
                if cross == 0:
                    lane <- into
            else:
                air <- air - 1 if air != 0
            out: mutable Ride = zeroed
            out.at <- length if at + moved > length else at + moved
            out.lane <- lane
            out.into <- into
            out.cross <- cross
            out.air <- air
            out.speed <- speed
            out.ticks <- ride.ticks + 1
            out.hit <- hit
            out.passed <- passed
            out.clipped <- clipped
            out.points <- points
            return out

    def roll(ride: Ride, port: i64, road: Road&) -> Ride:
        can Abort.Panic:
            return advance(press(ride, port, road.grade), road)

    def over(ride: Ride, road: Road&) -> bool:
        can Abort.Panic:
            return ride.hit or ride.at >= road.length or (road.clock != 0 and ride.ticks >= road.clock)

    def cleared(ride: Ride, road: Road&) -> bool:
        can Abort.Panic:
            return not ride.hit and ride.at >= road.length

    def late(ride: Ride, road: Road&) -> bool:
        can Abort.Panic:
            return not ride.hit and ride.at < road.length and road.clock != 0 and ride.ticks >= road.clock

    # --- the deal ---

    # A road from a list of hazards, with the three indexes built. Hazards whose
    # `at` falls outside the road are dropped, which is what renumbers the kept
    # list -- the indexes in marks/heads/tails are into THAT list.
    def build(road: mutable Road&, g: Grade, haz_at: darray[i64], haz_lane: darray[i64], haz_kind: darray[i64], haz_n: i64, start: i64, clock: i64):
        can Abort.Panic:
            length: i64 = grade_length(g)
            road.grade <- g
            road.length <- length
            road.start <- start
            road.clock <- clock
            road.par <- 0
            road.haz_n <- 0
            wipe: mutable i64 = 0
            while wipe < length |wipe, road|:
                Ints::put(&road.marks_n, wipe, 0)
                Ints::put(&road.heads_n, wipe, 0)
                Ints::put(&road.tails_n, wipe, 0)
                wipe <- wipe + 1
            source: mutable i64 = 0
            while source < haz_n |source, haz_n, haz_at, haz_lane, haz_kind, length, road|:
                at: i64 = Ints::at(haz_at, source)
                if at >= 0 and at < length:
                    index: i64 = road.haz_n
                    Ints::put(&road.haz_at, index, at)
                    Ints::put(&road.haz_lane, index, Ints::at(haz_lane, source))
                    Ints::put(&road.haz_kind, index, Ints::at(haz_kind, source))
                    road.haz_n <- index + 1
                    step: mutable i64 = 0
                    while step < SPAN |step, at, length, road, index|:
                        spot: i64 = at + step
                        if spot < length:
                            count: i64 = Ints::at(road.marks_n, spot)
                            Ints::put(&road.marks, spot * MARK_STRIDE + count, index)
                            Ints::put(&road.marks_n, spot, count + 1)
                        step <- step + 1
                    head_count: i64 = Ints::at(road.heads_n, at)
                    Ints::put(&road.heads, at * MARK_STRIDE + head_count, index)
                    Ints::put(&road.heads_n, at, head_count + 1)
                    end: i64 = haz_end(at)
                    end_spot: i64 = length - 1 if end > length - 1 else end
                    tail_count: i64 = Ints::at(road.tails_n, end_spot)
                    Ints::put(&road.tails, end_spot * MARK_STRIDE + tail_count, index)
                    Ints::put(&road.tails_n, end_spot, tail_count + 1)
                source <- source + 1

    # --- the solver ---
    #
    # A forward dynamic program over (sub-row, lane, commitment, speed). It is a
    # DAG, not a graph with cycles: every tick moves the car at least one sub-row,
    # so a single pass in sub-row order settles it and there is no queue.
    #
    # The five numbers a state needs pack into one key. `cross` and `air` cannot
    # both be non-zero -- the wheel is deaf mid-commitment -- so the three of them
    # together are one small phase.
    const KEYSPACE: i64 = 720

    def rest_key(ride: Ride) -> i64:
        can Abort.Panic:
            return (((ride.lane * 3 + ride.into) * 4 + ride.cross) * 5 + ride.air) * 4 + (ride.speed - 1)

    def revive(at: i64, key: i64) -> Ride:
        can Abort.Panic:
            ride: mutable Ride = zeroed
            ride.at <- at
            ride.speed <- (key % 4) + 1
            ride.air <- (key / 4) % 5
            ride.cross <- (key / 20) % 4
            ride.into <- (key / 80) % 3
            ride.lane <- (key / 240) % 3
            return ride

    struct Solver:
        # `where` maps a layer's key to its 1-based place in that layer's ordered
        # list; 0 is absent. The order is the whole point: the reference's layers
        # are dicts and it finishes with `min(...)`, which takes the first key
        # holding the minimum in INSERTION order.
        slot: mutable darray[i64]
        order: mutable darray[i64]
        order_n: mutable darray[i64]
        ticks: mutable darray[i64]
        back_at: mutable darray[i64]
        back_key: mutable darray[i64]
        back_port: mutable darray[i64]
        ports: mutable darray[i64]
        port_n: mutable i64

    def Solver() -> Solver:
        can Memory.Allocate, Abort.Panic:
            s: mutable Solver = zeroed
            span: i64 = (MOST_LENGTH + 1) * KEYSPACE
            s.slot <- Ints::zeros(span)
            s.order <- Ints::zeros(span)
            s.order_n <- Ints::zeros(MOST_LENGTH + 1)
            s.ticks <- Ints::zeros(span)
            s.back_at <- Ints::zeros(span)
            s.back_key <- Ints::zeros(span)
            s.back_port <- Ints::zeros(span)
            s.ports <- Ints::zeros(MOST_LENGTH + 1)
            return s

    # The fewest ticks to the far end with no crash and no clip. Returns the number
    # of ports (into `solver.ports`), or -1 when the road cannot be driven clean
    # inside its clock.
    #
    # The transitions are `th_roll`, not a copy of it: a solver with its own idea
    # of the rules is one that certifies roads the game does not agree are
    # drivable.
    def line(solver: mutable Solver&, road: Road&) -> i64:
        can Abort.Panic:
            length: i64 = road.length
            clock: i64 = road.clock
            # Only the layers actually touched are cleared, by walking each one's
            # own ordered list -- the key space is 720 wide and almost all of it
            # is never reached.
            wipe: mutable i64 = 0
            while wipe <= length |wipe, solver|:
                used: i64 = Ints::at_ref(&solver.order_n, wipe)
                back: mutable i64 = 0
                while back < used |back, used, wipe, solver|:
                    Ints::put(&solver.slot, wipe * KEYSPACE + Ints::at_ref(&solver.order, wipe * KEYSPACE + back), 0)
                    back <- back + 1
                Ints::put(&solver.order_n, wipe, 0)
                wipe <- wipe + 1
            begin: Ride = start_ride(road)
            first: i64 = rest_key(begin)
            Ints::put(&solver.order, 0, first)
            Ints::put(&solver.order_n, 0, 1)
            Ints::put(&solver.slot, first, 1)
            Ints::put(&solver.ticks, 0, 0)
            Ints::put(&solver.back_at, 0, -1)
            at: mutable i64 = 0
            while at < length |at, length, clock, solver, road|:
                place: mutable i64 = 0
                while place < Ints::at_ref(&solver.order_n, at) |place, at, clock, solver, road|:
                    key: i64 = Ints::at_ref(&solver.order, at * KEYSPACE + place)
                    ticks: i64 = Ints::at_ref(&solver.ticks, at * KEYSPACE + place)
                    if clock == 0 or ticks < clock:
                        ride: Ride = revive(at, key)
                        settled: bool = is_settled(ride)
                        port: mutable i64 = 0
                        last: i64 = 5 if settled else 0
                        while port <= last |port, last, ride, road, solver, at, key, ticks|:
                            went: Ride = roll(ride, port, road)
                            if not went.hit and went.clipped == 0:
                                next_key: i64 = rest_key(went)
                                base: i64 = went.at * KEYSPACE
                                found: i64 = Ints::at_ref(&solver.slot, base + next_key)
                                if found == 0:
                                    used: i64 = Ints::at_ref(&solver.order_n, went.at)
                                    Ints::put(&solver.order, base + used, next_key)
                                    Ints::put(&solver.order_n, went.at, used + 1)
                                    Ints::put(&solver.slot, base + next_key, used + 1)
                                    Ints::put(&solver.ticks, base + used, ticks + 1)
                                    Ints::put(&solver.back_at, base + used, at)
                                    Ints::put(&solver.back_key, base + used, key)
                                    Ints::put(&solver.back_port, base + used, port)
                                else:
                                    spot: i64 = found - 1
                                    if Ints::at_ref(&solver.ticks, base + spot) > ticks + 1:
                                        Ints::put(&solver.ticks, base + spot, ticks + 1)
                                        Ints::put(&solver.back_at, base + spot, at)
                                        Ints::put(&solver.back_key, base + spot, key)
                                        Ints::put(&solver.back_port, base + spot, port)
                            port <- port + 1
                    place <- place + 1
                at <- at + 1
            final_used: i64 = Ints::at_ref(&solver.order_n, length)
            if final_used == 0:
                solver.port_n <- 0
                return -1
            # `min(layers[length], key=...)` -- the FIRST place holding the
            # minimum, which is why the order matters at all.
            best: mutable i64 = 0
            scan: mutable i64 = 1
            while scan < final_used |scan, final_used, length, solver, best|:
                if Ints::at_ref(&solver.ticks, length * KEYSPACE + scan) < Ints::at_ref(&solver.ticks, length * KEYSPACE + best):
                    best <- scan
                scan <- scan + 1
            # Walk the back-links out, then reverse.
            count: mutable i64 = 0
            walk_at: mutable i64 = length
            walk_place: mutable i64 = best
            running: mutable bool = true
            while running |running, walk_at, walk_place, solver, count|:
                base: i64 = walk_at * KEYSPACE + walk_place
                previous: i64 = Ints::at_ref(&solver.back_at, base)
                if previous < 0:
                    running <- false
                else:
                    Ints::put(&solver.ports, count, Ints::at_ref(&solver.back_port, base))
                    count <- count + 1
                    previous_key: i64 = Ints::at_ref(&solver.back_key, base)
                    walk_place <- Ints::at_ref(&solver.slot, previous * KEYSPACE + previous_key) - 1
                    walk_at <- previous
            head: mutable i64 = 0
            tail_index: mutable i64 = count - 1
            while head < tail_index |head, tail_index, solver|:
                swap: i64 = Ints::at_ref(&solver.ports, head)
                Ints::put(&solver.ports, head, Ints::at_ref(&solver.ports, tail_index))
                Ints::put(&solver.ports, tail_index, swap)
                head <- head + 1
                tail_index <- tail_index - 1
            solver.port_n <- count
            return count

    # Hazards down the road, one place at a time. A pair is two hazards in
    # different lanes at the same sub-row, and never more than two.
    def lay(g: Grade, rng: mutable MT19937&, haz_at: mutable darray[i64]&, haz_lane: mutable darray[i64]&, haz_kind: mutable darray[i64]&) -> i64:
        can Memory.Allocate, Abort.Panic:
            length: i64 = grade_length(g)
            chance: f64 = g.density / SUB.f64()
            free_from: mutable i64 = RUN_IN * SUB
            count: mutable i64 = 0
            lanes: mutable darray[i64] = Ints::zeros(LANES)
            at: mutable i64 = 0
            while at < length |at, length, free_from, rng, chance, g, haz_at, haz_lane, haz_kind, count, lanes|:
                if at >= free_from and at + SPAN <= length:
                    if py_random(rng) < chance:
                        seed_lane: mutable i64 = 0
                        while seed_lane < LANES |seed_lane, lanes|:
                            Ints::put(&lanes, seed_lane, seed_lane)
                            seed_lane <- seed_lane + 1
                        py_shuffle_i64_prefix(rng, &lanes, LANES)
                        wanted: i64 = 2 if py_random(rng) < g.pairs else 1
                        pick: mutable i64 = 0
                        while pick < wanted |pick, wanted, lanes, at, g, rng, haz_at, haz_lane, haz_kind, count|:
                            Ints::put(haz_at, count, at)
                            Ints::put(haz_lane, count, Ints::at(lanes, pick))
                            Ints::put(haz_kind, count, g.kinds[py_choice_index(rng, g.kind_count).usize()])
                            count <- count + 1
                            pick <- pick + 1
                        free_from <- at + SPAN + GAP
                at <- at + 1
            # A road with nothing on it that can end you is a free verdict.
            deadly: mutable bool = false
            check: mutable i64 = 0
            while check < count |check, count, haz_kind, deadly|:
                deadly <- true if fatal(Ints::at_ref(haz_kind, check))
                check <- check + 1
            if not deadly:
                Ints::put(haz_at, count, RUN_IN * SUB)
                Ints::put(haz_lane, count, py_randrange(rng, 0, LANES))
                fatal_kinds: mutable darray[i64] = Ints::zeros(9)
                fatal_n: mutable i64 = 0
                look: mutable i64 = 0
                while look < g.kind_count |look, g, fatal_kinds, fatal_n|:
                    if fatal(g.kinds[look.usize()]):
                        Ints::put(&fatal_kinds, fatal_n, g.kinds[look.usize()])
                        fatal_n <- fatal_n + 1
                    look <- look + 1
                Ints::put(haz_kind, count, Ints::at(fatal_kinds, py_choice_index(rng, fatal_n)))
                count <- count + 1
            return count

    # Targets over the horizon, at fixed places on the road.
    def fly(g: Grade, rng: mutable MT19937&, road: mutable Road&) -> i64:
        can Abort.Panic:
            length: i64 = grade_length(g)
            chance: f64 = g.sky / SUB.f64()
            count: mutable i64 = 0
            at: mutable i64 = 0
            while at < length |at, length, rng, chance, road, count|:
                if py_random(rng) < chance:
                    across: f64 = py_uniform(rng, 0.10, 0.90)
                    drift: mutable f64 = py_uniform(rng, -0.35, 0.35)
                    # A target that would drift off the side turns round instead.
                    drift <- -drift if across + drift < 0.0 or across + drift > 1.0
                    up: f64 = py_uniform(rng, 0.18, 0.86)
                    Ints::put(&road.sky_at, count, at)
                    Floats::put(&road.sky_across, count, across)
                    Floats::put(&road.sky_up, count, up)
                    Floats::put(&road.sky_drift, count, drift)
                    count <- count + 1
                at <- at + 1
            road.sky_n <- count
            return count

    # Solve a road and put its own clock on it: par times the rung's slack, so
    # what a rung demands is the same demand on every deal it makes. False when
    # there is no clean line through it at all.
    def timed(solver: mutable Solver&, road: mutable Road&) -> bool:
        can Abort.Panic:
            found: i64 = line(solver, road)
            if found < 0:
                return false
            road.par <- found
            road.clock <- ceil(found.f64() * road.grade.slack).i64()
            return true

    # Lay one road and one sky for `level`, deterministic in `seed`. A road the
    # program cannot finish clean inside its clock has a blocking hazard taken out
    # of it at random and is solved again, until it can be.
    def generate(level: i64, seed: i64, road: mutable Road&, solver: mutable Solver&):
        can Memory.Allocate, Abort.Panic:
            g: Grade = grade_of(level)
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            haz_at: mutable darray[i64] = Ints::zeros(MOST_HAZARDS)
            haz_lane: mutable darray[i64] = Ints::zeros(MOST_HAZARDS)
            haz_kind: mutable darray[i64] = Ints::zeros(MOST_HAZARDS)
            haz_n: mutable i64 = lay(g, &rng, &haz_at, &haz_lane, &haz_kind)
            _ = fly(g, &rng, road)
            start: i64 = py_randrange(&rng, 0, LANES)
            build(road, g, haz_at, haz_lane, haz_kind, haz_n, start, 0)
            blocking: mutable darray[i64] = Ints::zeros(MOST_HAZARDS)
            keep_at: mutable darray[i64] = Ints::zeros(MOST_HAZARDS)
            keep_lane: mutable darray[i64] = Ints::zeros(MOST_HAZARDS)
            keep_kind: mutable darray[i64] = Ints::zeros(MOST_HAZARDS)
            going: mutable bool = true
            while going |going, solver, road, g, rng, blocking, keep_at, keep_lane, keep_kind, start|:
                if timed(solver, road):
                    going <- false
                else:
                    count: mutable i64 = 0
                    scan: mutable i64 = 0
                    while scan < road.haz_n |scan, road, blocking, count|:
                        if is_blocking(Ints::at(road.haz_kind, scan)):
                            Ints::put(&blocking, count, scan)
                            count <- count + 1
                        scan <- scan + 1
                    if count == 0:
                        # Nothing left that can be in the way, so this is
                        # unreachable rather than a fallback -- but a generator
                        # that could loop forever is worse than one that stops.
                        build(road, g, keep_at, keep_lane, keep_kind, 0, start, 0)
                        _ = timed(solver, road)
                        going <- false
                    else:
                        dropped: i64 = Ints::at(blocking, py_choice_index(&rng, count))
                        kept: mutable i64 = 0
                        shift: mutable i64 = 0
                        while shift < road.haz_n |shift, road, dropped, keep_at, keep_lane, keep_kind, kept|:
                            if shift != dropped:
                                Ints::put(&keep_at, kept, Ints::at(road.haz_at, shift))
                                Ints::put(&keep_lane, kept, Ints::at(road.haz_lane, shift))
                                Ints::put(&keep_kind, kept, Ints::at(road.haz_kind, shift))
                                kept <- kept + 1
                            shift <- shift + 1
                        build(road, g, keep_at, keep_lane, keep_kind, kept, start, 0)

    # --- the sights ---

    # Where a target is at car position `at`, both in 0..1. Clamped rather than
    # wrapped: one that would drift off the side stops at the edge, so a crosshair
    # parked there is not rewarded for the target having nowhere else to go.
    def where_across(road: Road&, index: i64, at: i64) -> f64:
        can Abort.Panic:
            raw: f64 = (at - Ints::at(road.sky_at, index)).f64() / ALOFT.f64()
            part: mutable f64 = raw
            part <- 0.0 if part < 0.0
            part <- 1.0 if part > 1.0
            across: mutable f64 = Floats::at(road.sky_across, index) + Floats::at(road.sky_drift, index) * part
            across <- 0.0 if across < 0.0
            across <- 1.0 if across > 1.0
            return across

    def target_aloft(road: Road&, index: i64, at: i64) -> bool:
        can Abort.Panic:
            start: i64 = Ints::at(road.sky_at, index)
            return start <= at and at < start + ALOFT

    # The straight-line gap. `py_hypot` reproduces CPython's `math.hypot` exactly
    # (see src/pymath.elisa), so this is faithful rather than merely equivalent.
    #
    # The header's measurement still stands and is worth keeping: a naive
    # `sqrt(dx*dx + dy*dy)` changed none of 5,400 plays, because every hypot here
    # feeds a comparison. But "measured not to matter" is a weaker claim than "the
    # same arithmetic", and the exact version costs nothing.
    def gap_of(dx: f64, dy: f64) -> f64:
        can Abort.Panic:
            return py_hypot(dx, dy)

    # Which target a shot from (cross_x, cross_y) would take, or -1. The nearest
    # one aloft and still up, inside RETICLE. Ties go to the lower index -- the
    # older target -- because the comparison is strict.
    def sighted(road: Road&, at: i64, cross_x: f64, cross_y: f64, downed: darray[i64]) -> i64:
        can Abort.Panic:
            best: mutable i64 = -1
            best_gap: mutable f64 = RETICLE
            index: mutable i64 = 0
            while index < road.sky_n |index, road, at, cross_x, cross_y, downed, best, best_gap|:
                if Ints::at(downed, index) == 0 and target_aloft(road, index, at):
                    gap: f64 = gap_of(where_across(road, index, at) - cross_x, Floats::at(road.sky_up, index) - cross_y)
                    if gap < best_gap:
                        best <- index
                        best_gap <- gap
                index <- index + 1
            return best

    # Take the crosshair to the nearest target, and pull when it is there. Four
    # nudges and a trigger is a coarse instrument on purpose: what it costs in
    # ticks is the thing being measured. Returns -1 when the sky is empty.
    def sky_port(road: Road&, ride: Ride, cross_x: f64, cross_y: f64, downed: darray[i64]) -> i64:
        can Abort.Panic:
            # `min(up, key=...)` over the aloft list, which is in ascending index
            # order, so a strict comparison keeps the first and lowest.
            wants: mutable i64 = -1
            best_gap: mutable f64 = 0.0
            index: mutable i64 = 0
            while index < road.sky_n |index, road, ride, cross_x, cross_y, downed, wants, best_gap|:
                if Ints::at(downed, index) == 0 and target_aloft(road, index, ride.at):
                    gap: f64 = gap_of(where_across(road, index, ride.at) - cross_x, Floats::at(road.sky_up, index) - cross_y)
                    if wants < 0 or gap < best_gap:
                        wants <- index
                        best_gap <- gap
                index <- index + 1
            if wants < 0:
                return -1
            gap_x: f64 = where_across(road, wants, ride.at) - cross_x
            gap_y: f64 = Floats::at(road.sky_up, wants) - cross_y
            if gap_of(gap_x, gap_y) <= RETICLE * 0.8:
                return FIRE
            span_x: f64 = -gap_x if gap_x < 0.0 else gap_x
            span_y: f64 = -gap_y if gap_y < 0.0 else gap_y
            if span_x >= span_y:
                return AIM_RIGHT if gap_x > 0.0 else AIM_LEFT
            return AIM_UP if gap_y > 0.0 else AIM_DOWN

    # --- the shallow policies ---

    # The first blocking hazard in `lane` over [first, past), or -1.
    def blocked(road: Road&, lane: i64, first: i64, past: i64) -> i64:
        can Abort.Panic:
            low: i64 = 0 if first < 0 else first
            high: i64 = road.length if past > road.length else past
            at: mutable i64 = low
            found: mutable i64 = -1
            while at < high and found < 0 |at, high, road, lane, found|:
                slot: mutable i64 = 0
                count: i64 = Ints::at(road.marks_n, at)
                while slot < count and found < 0 |slot, count, at, road, lane, found|:
                    index: i64 = Ints::at(road.marks, at * MARK_STRIDE + slot)
                    if Ints::at(road.haz_lane, index) == lane and is_blocking(Ints::at(road.haz_kind, index)):
                        found <- index
                    slot <- slot + 1
                at <- at + 1
            return found

    # One shallow driving decision: is the lane ahead going to be clear? `look` is
    # the whole of the policy -- at 1.0 the window is the road the car would be
    # committed over if it swerved now.
    def wheel_port(road: Road&, ride: Ride, want: i64, look: f64) -> i64:
        can Abort.Panic:
            g: Grade = road.grade
            rounded: i64 = py_round_half_even(look * g.swerve.f64() * ride.speed.f64())
            reach: i64 = (1 if rounded < 1 else rounded) + ride.speed
            trouble: i64 = blocked(road, ride.lane, ride.at, ride.at + reach)
            if trouble < 0:
                return FASTER if ride.speed < want else (SLOWER if ride.speed > want else HOLD)
            kind: i64 = Ints::at(road.haz_kind, trouble)
            if not kind_tall(kind):
                # Off the ground for the whole overlap, or not at all: the jump
                # covers speed * hang sub-rows and the run is SPAN long.
                if ride.speed * g.hang >= (haz_end(Ints::at(road.haz_at, trouble)) - ride.at) + 1:
                    return JUMP
            swerve_over: i64 = g.swerve * ride.speed + ride.speed
            if ride.lane - 1 >= 0 and blocked(road, ride.lane - 1, ride.at, ride.at + swerve_over) < 0:
                return LEFT
            if ride.lane + 1 < LANES and blocked(road, ride.lane + 1, ride.at, ride.at + swerve_over) < 0:
                return RIGHT
            return SLOWER if ride.speed > 1 else HOLD

    const SHOOT_NEVER: i64 = 0
    const SHOOT_SPARE: i64 = 1
    const SHOOT_ALWAYS: i64 = 2
    const MOST_PORTS: i64 = 1024

    struct Play:
        ride: mutable Ride
        home: mutable bool
        shot: mutable i64
        ports: mutable darray[i64]
        port_n: mutable i64

    # Drive `road` with one of the shallow policies and report how it went.
    #
    # `shoot` is a setting on the SAME driver rather than a second function,
    # because that is the only fair way to ask what the sky costs the road.
    def play(road: Road&, want_in: i64, look: f64, shoot: i64) -> Play:
        can Memory.Allocate, Abort.Panic:
            g: Grade = road.grade
            want: i64 = g.top if want_in > g.top else want_in
            ride: mutable Ride = start_ride(road)
            cross_x: mutable f64 = 0.5
            cross_y: mutable f64 = 0.5
            downed: mutable darray[i64] = Ints::zeros(MOST_SKY)
            out: mutable Play = zeroed
            out.ports <- Ints::zeros(MOST_PORTS)
            shot: mutable i64 = 0
            count: mutable i64 = 0
            while not over(ride, road) |ride, road, g, want, look, shoot, cross_x, cross_y, downed, shot, count, out|:
                port: mutable i64 = HOLD
                if not is_settled(ride):
                    # The wheel is deaf while a commitment runs down, so these
                    # ticks are the sky's for nothing. Whether a policy notices
                    # that is most of the difference between the rows.
                    if shoot != SHOOT_NEVER:
                        eyes: i64 = sky_port(road, ride, cross_x, cross_y, downed)
                        port <- eyes if eyes >= 0
                else:
                    wheel: i64 = wheel_port(road, ride, want, look)
                    eyes: mutable i64 = -1
                    eyes <- sky_port(road, ride, cross_x, cross_y, downed) if shoot != SHOOT_NEVER
                    if eyes >= 0 and (shoot == SHOOT_ALWAYS or wheel == HOLD):
                        port <- eyes
                    else:
                        port <- wheel
                Ints::put(&out.ports, count, port)
                count <- count + 1
                if port >= AIM_LEFT:
                    # A sights port costs a tick and nothing else; the road still
                    # arrives, met by a car that held the wheel.
                    if port == AIM_LEFT:
                        cross_x <- 0.0 if cross_x - NUDGE < 0.0 else cross_x - NUDGE
                    if port == AIM_RIGHT:
                        cross_x <- 1.0 if cross_x + NUDGE > 1.0 else cross_x + NUDGE
                    if port == AIM_DOWN:
                        cross_y <- 0.0 if cross_y - NUDGE < 0.0 else cross_y - NUDGE
                    if port == AIM_UP:
                        cross_y <- 1.0 if cross_y + NUDGE > 1.0 else cross_y + NUDGE
                    if port == FIRE:
                        found: i64 = sighted(road, ride.at, cross_x, cross_y, downed)
                        if found >= 0:
                            Ints::put(&downed, found, 1)
                            shot <- shot + 1
                    ride <- roll(ride, HOLD, road)
                else:
                    ride <- roll(ride, port, road)
            out.ride <- ride
            out.home <- cleared(ride, road)
            out.shot <- shot
            out.port_n <- count
            return out

    # Run `ports` down `road` and hand back the ride that comes out. A sights port
    # reaches the car as a hold.
    def drive(road: Road&, ports: darray[i64], port_n: i64) -> Ride:
        can Abort.Panic:
            ride: mutable Ride = start_ride(road)
            index: mutable i64 = 0
            while index < port_n and not over(ride, road) |index, port_n, ports, road, ride|:
                port: i64 = Ints::at(ports, index)
                ride <- roll(ride, port if port <= SLOWER else HOLD, road)
                index <- index + 1
            return ride
