include "../hand_view.elisa"
include "../pymath.elisa"
include "../strings.elisa"

module FieldManual:
    const BUTTON: i64 = 0
    const SWITCH: i64 = 1
    const DIAL: i64 = 2
    const SLIDER: i64 = 3
    const PRESS: i64 = 0
    const FLIP: i64 = 1
    const TURN_DIAL: i64 = 2
    const SLIDE: i64 = 3
    const TYPE: i64 = 4
    const FACENUM: i64 = 5
    const LISTEN: i64 = 6
    const EXCEPT: i64 = 7
    const MATCH: i64 = 8
    const DIGIT: i64 = HandView::KEYS
    const SHIFT: i64 = DIGIT + 10
    const PORTS: i64 = SHIFT + 1
    const NOTCHES: i64 = 8
    const BEEP_FIRST: f64 = 1.0
    const BEEP_GAP: f64 = 1.1
    const PITCH: f64 = 0.58
    const TRACK: f64 = 0.22

    struct Grade:
        rung: i64
        steps: i64
        parts: i64
        faces: i64
        orders: i64
        relate: bool
        shift: bool
        wait: bool
        tones: bool
        spin: f64
        noise: bool
        show: f64
        pace: f64
        slack: f64

    struct Part:
        kind: i64
        colour: i64
        face: i64
        col: i64
        row: i64

    struct Order:
        kind: mutable i64
        text: mutable dstr
        targets: mutable i64
        value: mutable f64
        digits: mutable i64
        shift: mutable bool
        wait: mutable i64
        tone: mutable i64
        beeps: mutable darray[i64]

    struct Job:
        level: Grade
        valid: mutable bool
        parts: mutable Part[22]
        count: mutable i64
        numbers: mutable i64[6]
        secrets: mutable i64[22]
        start: mutable f64[22]
        orders: mutable darray[Order]
        seconds: mutable f64
        seed: mutable i64

    struct Pool:
        indices: mutable i64[22]
        count: mutable i64

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        top: i64 = r - 20 if r >= 20 else 0
        t: f64 = top.f64()
        return Grade{rung: r, steps: 1 if r < 4 else (2 if r < 7 else (3 if r < 13 else (4 if r < 20 else 5 + top / 3))),
            parts: 3 if r < 4 else (6 if r < 7 else (9 if r < 13 else (12 if r < 20 else (22 if top >= 16 else 14 + top / 2)))),
            faces: 1 if r < 4 else (3 if r < 7 else 6), orders: 2 if r < 4 else (5 if r < 7 else (6 if r < 10 else (8 if r < 13 else 9))),
            relate: r >= 7, shift: r >= 10, wait: r >= 13, tones: r >= 16,
            spin: 0.0 if r < 16 else (8.0 if r < 20 else HandView::clamp(10.0 + t, 10.0, 28.0)),
            noise: r >= 16, show: 0.0 if r < 20 else HandView::clamp(5.0 - 0.1 * t, 1.5, 5.0),
            pace: 16.0 if r < 4 else (14.0 if r < 10 else (12.0 if r < 20 else HandView::clamp(11.0 - 0.15 * t, 6.5, 11.0))),
            slack: 0.09 if r < 20 else HandView::clamp(0.09 - 0.002 * t, 0.05, 0.09)}

    def colour_text(colour: i64) -> cstr:
        return "red" if colour == 0
        return "green" if colour == 1
        return "blue" if colour == 2
        return "yellow" if colour == 3
        return "white" if colour == 4
        return "orange"

    def kind_text(kind: i64) -> cstr:
        return "button" if kind == BUTTON
        return "switch" if kind == SWITCH
        return "dial" if kind == DIAL
        return "slider"

    def ordinal(wait: i64) -> cstr:
        return "second" if wait == 2
        return "third" if wait == 3
        return "fourth"

    def third(value: f64) -> i64:
        return 0 if value <= 0.15
        return 2 if value >= 0.85
        return 1 if value >= 0.4 and value <= 0.6
        return -1

    def uniform(rng: mutable MT19937&, low: f64, high: f64) -> f64:
        can Abort.Panic:
            return low + (high - low) * py_random(rng)

    # Use rounded decimal literals so optimized division cannot move a slider
    # value by an ULP and change the Python match-order distance check.
    def hundredth(value: f64) -> f64:
        can Abort.Panic:
            values: f64[81] = [
                0.10, 0.11, 0.12, 0.13, 0.14, 0.15, 0.16, 0.17, 0.18,
                0.19, 0.20, 0.21, 0.22, 0.23, 0.24, 0.25, 0.26, 0.27,
                0.28, 0.29, 0.30, 0.31, 0.32, 0.33, 0.34, 0.35, 0.36,
                0.37, 0.38, 0.39, 0.40, 0.41, 0.42, 0.43, 0.44, 0.45,
                0.46, 0.47, 0.48, 0.49, 0.50, 0.51, 0.52, 0.53, 0.54,
                0.55, 0.56, 0.57, 0.58, 0.59, 0.60, 0.61, 0.62, 0.63,
                0.64, 0.65, 0.66, 0.67, 0.68, 0.69, 0.70, 0.71, 0.72,
                0.73, 0.74, 0.75, 0.76, 0.77, 0.78, 0.79, 0.80, 0.81,
                0.82, 0.83, 0.84, 0.85, 0.86, 0.87, 0.88, 0.89, 0.90]
            return values[(py_round_half_even(value * 100.0) - 10).usize()]

    def part_name(out: mutable dstr&, part: Part):
        can Memory.Allocate, Abort.Panic:
            dstr_append_cstr(out, "the ")
            dstr_append_cstr(out, colour_text(part.colour))
            dstr_append_cstr(out, " ")
            dstr_append_cstr(out, kind_text(part.kind))

    def describe(out: mutable dstr&, job: Job&, index: i64, rng: mutable MT19937&):
        can Memory.Allocate, Abort.Panic:
            p: Part = job.parts[index.usize()]
            if job.level.relate and p.face < 4 and py_random(rng) < 0.6:
                near: mutable Pool = zeroed
                for j in 0..<job.count |job, p, near|:
                    q: Part = job.parts[j.usize()]
                    if q.face == p.face and q.row == p.row and (q.col == p.col - 1 or q.col == p.col + 1):
                        near.indices[near.count.usize()] <- j
                        near.count <- near.count + 1
                if near.count > 0:
                    q: Part = job.parts[near.indices[py_choice_index(rng, near.count).usize()].usize()]
                    dstr_append_cstr(out, "the ")
                    dstr_append_cstr(out, kind_text(p.kind))
                    dstr_append_cstr(out, " left of " if p.col < q.col else " right of ")
                    part_name(out, q)
                    return
            part_name(out, p)

    def pool_for(job: Job&, kind: i64, excluded: i64) -> Pool:
        can Abort.Panic:
            pool: mutable Pool = zeroed
            for i in 0..<job.count |job, kind, excluded, pool|:
                if i != excluded and (kind < 0 or job.parts[i.usize()].kind == kind):
                    pool.indices[pool.count.usize()] <- i
                    pool.count <- pool.count + 1
            return pool

    def choose_order(job: Job&, rng: mutable MT19937&, last: i64, kind: mutable i64&) -> i64:
        can Abort.Panic:
            for _attempt in 0..<30 |job, rng, last, kind|:
                kind[0] <- py_choice_index(rng, job.level.orders)
                order: i64 = kind[0]
                if order == TYPE:
                    return py_choice_index(rng, 1)
                part_kind: mutable i64 = -1
                if order == PRESS or order == FLIP:
                    part_kind <- order
                elif order == TURN_DIAL or order == LISTEN:
                    part_kind <- DIAL
                elif order == SLIDE or order == MATCH:
                    part_kind <- SLIDER
                elif order == EXCEPT:
                    part_kind <- py_choice_index(rng, 2)
                    continue if pool_for(job, part_kind, -1).count < 3
                pool: Pool = pool_for(job, part_kind, last)
                if pool.count != 0:
                    return pool.indices[py_choice_index(rng, pool.count).usize()]
            return -1

    def prepare_parts(job: mutable Job&, rng: mutable MT19937&):
        can Memory.Allocate, Abort.Panic:
            cells: mutable darray[i64] = []
            for f in 0..<job.level.faces |job, cells|:
                face: i64 = 3 if job.level.faces == 3 and f == 2 else f
                for offset in 0..<9 |cells, face|:
                    cells.push(face * 9 + offset)
            py_shuffle_i64(rng, &cells)
            kinds: i64 = 2 if job.level.rung < 4 else 4
            colours: mutable i64[24] = zeroed
            free: mutable i64[4] = zeroed
            for kind in 0..<kinds |rng, colours, free|:
                sampled: darray[i64] = py_sample_range(rng, 0, 5, 6)
                for i in 0..<6 |kind, sampled, colours|:
                    colours[(kind * 6 + i).usize()] <- get sampled[i.usize()] else 0
                free[kind.usize()] <- 6
            for i in 0..<job.level.parts |job, rng, cells, kinds, free, colours|:
                kind: mutable i64 = i % kinds
                if i >= 2 * kinds:
                    available: mutable i64[4] = zeroed
                    count: mutable i64 = 0
                    for k in 0..<kinds |available, count, free|:
                        if free[k.usize()] > 0:
                            available[count.usize()] <- k
                            count <- count + 1
                    kind <- available[py_choice_index(rng, count).usize()] if count > 0 else py_choice_index(rng, kinds)
                remain: i64 = free[kind.usize()]
                continue if remain == 0
                free[kind.usize()] <- remain - 1
                cell: i64 = get cells[i.usize()] else 0
                job.parts[job.count.usize()] <- Part{kind: kind, colour: colours[(kind * 6 + remain - 1).usize()],
                    face: cell / 9, col: (cell % 9) / 3 - 1, row: cell % 3 - 1}
                job.count <- job.count + 1
            if job.level.relate:
                for face in 0..<6 |job, rng|:
                    while true |job, rng, face|:
                        word: i64 = py_randrange(rng, 100, 1000)
                        seen: mutable bool = false
                        for i in 0..<face |job, word, seen|:
                            seen <- true if job.numbers[i.usize()] == word
                        if not seen:
                            job.numbers[face.usize()] <- word
                            break
            for i in 0..<job.count |job, rng|:
                kind: i64 = job.parts[i.usize()].kind
                if kind == DIAL:
                    job.start[i.usize()] <- py_choice_index(rng, NOTCHES).f64()
                elif kind == SLIDER:
                    job.start[i.usize()] <- hundredth(uniform(rng, 0.3, 0.7))
            for i in 0..<job.count |job, rng|:
                job.secrets[i.usize()] <- py_choice_index(rng, NOTCHES)

    def click_order(order: mutable Order&, job: mutable Job&, rng: mutable MT19937&, index: i64):
        can Memory.Allocate, Abort.Panic:
            description: mutable dstr = []
            describe(&description, job, index, rng)
            roll: f64 = py_random(rng)
            if job.level.wait and roll < 0.35:
                order.wait <- py_randint(rng, 2, 3 if job.level.rung < 20 else 4)
                if job.level.tones:
                    order.tone <- py_choice_index(rng, 2)
                    heard: mutable i64 = 0
                    while heard < order.wait |heard, order, rng|:
                        beep: i64 = py_choice_index(rng, 2)
                        order.beeps.push(beep)
                        heard <- heard + 1 if beep == order.tone
                else:
                    for _beep in 0..<order.wait |order|:
                        order.beeps.push(0)
                job.seconds <- job.seconds + (BEEP_FIRST + BEEP_GAP * order.beeps.count.f64())
                for _beep in 0..<6 |rng, order|:
                    order.beeps.push(py_choice_index(rng, 2) if order.tone >= 0 else 0)
                dstr_append_cstr(&order.text, "After the ")
                dstr_append_cstr(&order.text, ordinal(order.wait))
                if order.tone >= 0:
                    dstr_append_cstr(&order.text, " high" if order.tone == 1 else " low")
                dstr_append_cstr(&order.text, " beep, ")
            elif job.level.shift and roll < 0.65:
                order.shift <- true
                dstr_append_cstr(&order.text, "Hold Shift and ")
            if order.shift or order.wait != 0:
                dstr_append_cstr(&order.text, "press " if order.kind == PRESS else "flip ")
            else:
                dstr_append_cstr(&order.text, "Press " if order.kind == PRESS else "Flip ")
            dstr_append_sview(&order.text, bytes_view(description))

    def except_order(order: mutable Order&, job: mutable Job&, index: i64):
        can Memory.Allocate, Abort.Panic:
            part: Part = job.parts[index.usize()]
            pool: Pool = pool_for(job, part.kind, index)
            order.targets <- 0
            for i in 0..<pool.count |pool, order|:
                order.targets <- order.targets | (1 << pool.indices[i.usize()].u64())
            order.kind <- PRESS if part.kind == BUTTON else FLIP
            job.seconds <- job.seconds + 2.5 * pool.count.f64()
            dstr_append_cstr(&order.text, "Press every button except the " if part.kind == BUTTON else "Flip every switch except the ")
            dstr_append_cstr(&order.text, colour_text(part.colour))
            dstr_append_cstr(&order.text, " one")

    def adjust_order(order: mutable Order&, job: Job&, rng: mutable MT19937&, index: i64, state: mutable f64&) -> bool:
        can Memory.Allocate, Abort.Panic:
            kind: i64 = order.kind
            if kind == TURN_DIAL:
                n: i64 = py_choice_index(rng, NOTCHES - 1)
                value: i64 = n + 1 if n >= state[0].i64() else n
                state[0] <- value.f64()
                order.value <- state[0]
            elif kind == LISTEN:
                value: f64 = job.secrets[index.usize()].f64()
                return false if state[0] == value
                state[0] <- value
                order.value <- value
            elif kind == SLIDE:
                past: i64 = third(state[0])
                n: i64 = py_choice_index(rng, 3 if past < 0 else 2)
                where: i64 = n + 1 if past >= 0 and n >= past else n
                state[0] <- where.f64() / 2.0
                order.value <- where.f64()
            else:
                value: f64 = hundredth(uniform(rng, 0.1, 0.9))
                return false if HandView::absolute(value - state[0]) < 0.2
                state[0] <- value
                order.value <- value
            dstr_append_cstr(&order.text, "Turn " if kind == TURN_DIAL or kind == LISTEN else "Slide ")
            describe(&order.text, job, index, rng)
            if kind == TURN_DIAL:
                dstr_append_cstr(&order.text, " to ")
                dstr_append_i64(&order.text, order.value.i64())
            elif kind == LISTEN:
                dstr_append_cstr(&order.text, " until it tocks")
            elif kind == SLIDE:
                dstr_append_cstr(&order.text, " to the ")
                dstr_append_cstr(&order.text, "bottom" if order.value == 0.0 else ("middle" if order.value == 1.0 else "top"))
            else:
                dstr_append_cstr(&order.text, " until it matches the hum")
            return true

    def build(level: Grade, seed: i64) -> Job:
        can Memory.Allocate, Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
            job: mutable Job = Job{level: level, valid: false, parts: zeroed, count: 0, numbers: zeroed,
                secrets: zeroed, start: zeroed, orders: [], seconds: 0.0, seed: 0}
            prepare_parts(&job, &rng)
            state: mutable f64[22] = job.start
            last: mutable i64 = -1
            for _attempt in 0..<(level.steps * 6) |job, level, rng, state, last|:
                break if job.orders.count.i64() == level.steps
                kind: mutable i64 = 0
                index: i64 = choose_order(&job, &rng, last, &kind)
                return job if index < 0
                order: mutable Order = Order{kind: kind, text: [], targets: 1 << index.u64(),
                    value: 0.0, digits: 0, shift: false, wait: 0, tone: -1, beeps: []}
                if kind == PRESS or kind == FLIP:
                    click_order(&order, &job, &rng, index)
                elif kind == EXCEPT:
                    except_order(&order, &job, index)
                elif kind == TYPE or kind == FACENUM:
                    order.kind <- TYPE
                    if kind == TYPE:
                        order.targets <- 0
                        order.digits <- py_randrange(&rng, 100, 1000 if level.rung < 13 else 100000)
                        dstr_append_cstr(&order.text, "Type ")
                        dstr_append_i64(&order.text, order.digits)
                    else:
                        part: Part = job.parts[index.usize()]
                        order.digits <- job.numbers[part.face.usize()]
                        dstr_append_cstr(&order.text, "Type the number on the face with ")
                        part_name(&order.text, part)
                else:
                    current: mutable f64 = state[index.usize()]
                    continue if not adjust_order(&order, &job, &rng, index, &current)
                    state[index.usize()] <- current
                dstr_append_cstr(&order.text, ".")
                last <- -1 if kind == EXCEPT or kind == TYPE else index
                job.orders.push(order)
                job.seconds <- job.seconds + level.pace
            if job.orders.count.i64() == level.steps:
                job.seed <- py_choice_index(&rng, 1073741824)
                job.valid <- true
            return job
