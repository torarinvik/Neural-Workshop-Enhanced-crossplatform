include "./missing_word_game.elisa"

module Proofreader:
    const SWAP: i64 = 0
    const SCRAMBLE: i64 = 1
    const ORDER: i64 = 2
    const INTRUDER: i64 = 3
    const AGREE: i64 = 4
    const MOVE: i64 = 5

    struct Grade:
        rung: i64
        sentences: i64
        kinds: i64
        errors: i64
        hint: bool
        whole: bool
        close: bool
        seconds: f64

    struct Machine:
        level: mutable Grade
        original: mutable MissingWord::Line[6]
        rows: mutable MissingWord::Line[6]
        row_of: mutable i64[6]
        options: mutable MissingWord::Offer[168]
        damage: mutable MissingWord::Damage[19]
        count: mutable i64

    struct Candidate:
        valid: bool
        machine: Machine

    def grade(requested: i64) -> Grade:
        can Abort.Panic:
            rung: i64 = requested if requested > 0 else 1
            count: i64 = 1 if rung < 4 else (2 if rung < 10 else (3 if rung < 16 else (4 + (rung - 16) / 6 if rung < 28 else 6)))
            kinds: i64 = 1 if rung < 2 else (2 if rung < 7 else (3 if rung < 10 else (4 if rung < 13 else 5)))
            errors: mutable i64 = 1 + (rung - 1) / 3 if rung <= 30 else 10 + (rung - 30) / 4
            cap: i64 = 3 * count
            errors <- cap if errors > cap
            base: f64 = (45 + 18 * errors + 5 * count).f64()
            seconds: f64 = base * fmax(0.25, 1.0 - 0.02 * (rung - 25).f64()) if rung > 25 and errors >= cap else base
            return Grade{rung: rung, sentences: count, kinds: kinds, errors: errors, hint: rung < 19,
                whole: rung >= 16, close: rung >= 19, seconds: py_round_decimal(seconds, 10.0)}

    def name(word: Passages::Word) -> bool:
        return (word.capitals & 1.u64()) != 0.u64()

    def fresh(row: MissingWord::Line&, pairs: Passages::Index&, at: i64, word: Passages::Word) -> bool:
        can Abort.Panic:
            return (at == 0 or not Passages::contains(pairs, row.words[(at - 1).usize()].text, word)) and
                (at + 1 == row.count or not Passages::contains(pairs, word, row.words[(at + 1).usize()].text))

    def scramble_letters(word: Passages::Word, whole: bool, draw: mutable MT19937&, vocab: MissingWord::Vocabulary&) -> Passages::Word:
        can Memory.Allocate, Abort.Panic:
            indices: mutable darray[i64] = []
            first: i64 = 0 if whole else 1
            end: i64 = word.length if whole else word.length - 1
            for _ in 0..<20 |word, whole, draw, vocab, indices, first, end|:
                indices.clear()
                for i in first..<end |indices|:
                    indices.push(i)
                py_shuffle_i64(draw, &indices)
                result: mutable Passages::Word = zeroed
                if not whole:
                    Passages::push_letter(&result, Passages::letter(word, 0))
                for i in indices:
                    Passages::push_letter(&result, Passages::letter(word, i))
                if not whole:
                    Passages::push_letter(&result, Passages::letter(word, end))
                lower: mutable Passages::Word = result
                lower.capitals <- 0.u64()
                return result if not MissingWord::same_word(result, word) and
                    (result.capitals != 0.u64() or MissingWord::word_position(vocab, lower) < 0)
            return zeroed

    def shift(row: mutable MissingWord::Line&, source: i64, target: i64):
        can Abort.Panic:
            token: MissingWord::Token = row.words[source.usize()]
            MissingWord::remove_word(row, source)
            MissingWord::insert_word(row, target, token)

    # Match repeated words to their first unused occurrence before the edit.
    def follow(before: MissingWord::Line&, after: mutable MissingWord::Line&):
        can Abort.Panic:
            used: mutable u64 = 0.u64()
            for i in 0..<after.count |before, after, used|:
                word: Passages::Word = after.words[i.usize()].text
                for j in 0..<before.count |before, after, used, i, word|:
                    bit: u64 = 1.u64() << j
                    if (used & bit) == 0.u64() and MissingWord::same_word(before.words[j.usize()].text, word):
                        after.words[i.usize()] <- MissingWord::Token{id: before.words[j.usize()].id, text: word}
                        used <- used | bit
                        break

    def replacement(row: MissingWord::Line&, i: i64, kind: i64, level: Grade, draw: mutable MT19937&,
            pairs: Passages::Index&, vocab: MissingWord::Vocabulary&) -> Passages::Word:
        can Memory.Allocate, Abort.Panic:
            word: Passages::Word = row.words[i.usize()].text
            if kind == SCRAMBLE:
                return scramble_letters(word, level.whole, draw, vocab) if word.length >= 4 else zeroed
            return zeroed if kind == INTRUDER and word.length < 3
            lower: mutable Passages::Word = word
            lower.capitals <- 0.u64()
            forms: darray[Passages::Word] = MissingWord::other_forms(vocab, lower)
            if kind == INTRUDER:
                near: darray[Passages::Word] = MissingWord::near_words(vocab, lower, &forms, level.close, draw, 12)
                for choice in near:
                    return choice if fresh(row, pairs, i, choice)
            else:
                positions: mutable darray[i64] = form_indices(&forms, word)
                py_shuffle_i64(draw, &positions)
                for at in positions:
                    choice: Passages::Word = forms[at.usize()]
                    return choice if fresh(row, pairs, i, choice)
            return zeroed

    def form_indices(forms: darray[Passages::Word]&, truth: Passages::Word) -> darray[i64]:
        can Memory.Allocate, Abort.Panic:
            indices: mutable darray[i64] = []
            for i in 0..<forms.count.i64() |indices, forms, truth|:
                indices.push(i) if not MissingWord::same_word(forms[i.usize()], truth)
            return indices

    def damage_line(row: mutable MissingWord::Line&, kind: i64, level: Grade, draw: mutable MT19937&,
            pairs: Passages::Index&, vocab: MissingWord::Vocabulary&, used: mutable u64&) -> i64:
        can Memory.Allocate, Abort.Panic:
            spots: mutable darray[i64] = []
            for i in 0..<row.count |spots, row, used|:
                spots.push(i) if (used[0] & (1.u64() << i)) == 0.u64() and not name(row.words[i.usize()].text)
            py_shuffle_i64(draw, &spots)
            for i in spots:
                bit: u64 = 1.u64() << i
                token: MissingWord::Token = row.words[i.usize()]
                if kind == SWAP:
                    j: i64 = i + 1
                    continue if j >= row.count or (used[0] & (1.u64() << j)) != 0.u64()
                    next: MissingWord::Token = row.words[j.usize()]
                    continue if name(next.text) or MissingWord::same_word(token.text, next.text) or Passages::contains(pairs, next.text, token.text)
                    before: MissingWord::Line = row[0]
                    row.words[i.usize()] <- next
                    row.words[j.usize()] <- token
                    follow(&before, row)
                    used[0] <- used[0] | (3.u64() << i)
                    return i
                if kind == MOVE:
                    targets: darray[i64] = py_sample_range(draw, 0, row.count - 1, row.count)
                    for j in targets:
                        low: i64 = i if i < j else j
                        high: i64 = j if i < j else i
                        continue if high - low < 2 or (used[0] & (1.u64() << j)) != 0.u64()
                        shifted: mutable MissingWord::Line = row[0]
                        shift(&shifted, i, j)
                        continue if not fresh(&shifted, pairs, j, token.text)
                        follow(row, &shifted)
                        row[0] <- shifted
                        used[0] <- used[0] | (((1.u64() << (high - low + 1)) - 1.u64()) << low)
                        return i
                    continue
                word: Passages::Word = replacement(row, i, kind, level, draw, pairs, vocab)
                if word.length > 0:
                    row.words[i.usize()] <- MissingWord::Token{id: token.id, text: word}
                    used[0] <- used[0] | bit
                    return i
            return -1

    def options_for(text: Passages::Word, truth: Passages::Word, close: bool,
            draw: mutable MT19937&, vocab: MissingWord::Vocabulary&) -> MissingWord::Offer:
        can Memory.Allocate, Abort.Panic:
            lower: mutable Passages::Word = truth
            lower.capitals <- 0.u64()
            forms: darray[Passages::Word] = MissingWord::other_forms(vocab, lower)
            indices: mutable darray[i64] = form_indices(&forms, truth)
            py_shuffle_i64(draw, &indices)
            count: i64 = indices.count.i64() if indices.count < 2.usize() else 2
            near: darray[Passages::Word] = MissingWord::near_words(vocab, lower, &forms, close, draw, 4 - count)
            words: mutable Passages::Word[4] = zeroed
            words[0] <- truth
            n: mutable i64 = 1
            for i in 0..<(count + near.count.i64()) |count, near, forms, indices, words, n, text, truth|:
                word: Passages::Word = forms[indices[i.usize()].usize()] if i < count else near[(i - count).usize()]
                continue if MissingWord::same_word(word, text) or MissingWord::same_word(word, truth)
                words[n.usize()] <- word
                n <- n + 1
                break if n == 4
            indices.clear()
            for i in 0..<n |indices|:
                indices.push(i)
            py_shuffle_i64(draw, &indices)
            result: mutable MissingWord::Offer = zeroed
            result.count <- n
            for i in 0..<n |result, indices, words|:
                result.words[i.usize()] <- words[indices[i.usize()].usize()]
            return result

    def option_index(id: i64) -> usize:
        return (id / 100 * 28 + id % 100).usize()

    def equal_rows(original: MissingWord::Line[6]&, rows: MissingWord::Line[6]&, count: i64) -> bool:
        can Abort.Panic:
            for i in 0..<count |original, rows|:
                a: MissingWord::Line& = &original[i.usize()]
                b: MissingWord::Line& = &rows[i.usize()]
                return false if a.count != b.count
                for j in 0..<a.count |a, b|:
                    return false if not MissingWord::same_word(a.words[j.usize()].text, b.words[j.usize()].text)
            return true

    def build(level: Grade, draw: mutable MT19937&, corpus: MissingWordGame::Corpus&) -> Candidate:
        can Memory.Allocate, Abort.Panic:
            invalid: Candidate = zeroed
            vocab: MissingWord::Vocabulary& = &corpus.vocabulary
            sources: MissingWord::Sources& = &corpus.sources
            return invalid if vocab.ordered.count == 0.usize()
            machine: mutable Machine = zeroed
            machine.level <- level
            n: i64 = level.sentences
            if n == 1:
                return invalid if sources.single.count == 0.usize()
                index: i64 = sources.single[py_choice_index(draw, sources.single.count.i64()).usize()]
                machine.original[0] <- MissingWord::line(&corpus.sentences, index, 0, &corpus.known)
            else:
                pool: mutable darray[i64] = sources.passages[(n - 1).usize()]
                if pool.count == 0.usize():
                    for i in 0..<corpus.passages.passages.count.i64() |pool, corpus, n|:
                        p: Passages::Row = corpus.passages.passages[i.usize()]
                        pool.push(i) if p.stop - p.start >= n
                return invalid if pool.count == 0.usize()
                index: i64 = pool[py_choice_index(draw, pool.count.i64()).usize()]
                p: Passages::Row = corpus.passages.passages[index.usize()]
                for i in 0..<n |machine, p, corpus|:
                    row: Passages::Row = corpus.passages.sentences[(p.start + i).usize()]
                    return invalid if row.stop - row.start > 28
                    machine.original[i.usize()] <- MissingWord::line(&corpus.passages, p.start + i, i, &corpus.known)
            machine.rows <- machine.original
            words: mutable i64 = 0
            for i in 0..<n |machine, words|:
                words <- words + machine.original[i.usize()].count
            cap: i64 = words / 3 if words >= 3 else 1
            errors: i64 = level.errors if level.errors < cap else cap
            used: mutable u64[6] = zeroed
            for _ in 0..<(errors * 4) |machine, draw, level, n, used, corpus, vocab, errors|:
                break if machine.count == errors
                pick: i64 = py_choice_index(draw, level.kinds)
                kind: i64 = pick if pick < ORDER else pick + 1
                row: i64 = py_choice_index(draw, n)
                at: i64 = damage_line(&machine.rows[row.usize()], kind, level, draw, &corpus.pairs, vocab, &used[row.usize()])
                if at >= 0:
                    machine.damage[machine.count.usize()] <- MissingWord::Damage{kind: kind, row: row, index: at}
                    machine.count <- machine.count + 1
            return invalid if machine.count < errors
            order: mutable darray[i64] = []
            for i in 0..<n |order|:
                order.push(i)
            if n > 1:
                changed: mutable bool = false
                while not changed |draw, order, changed, n|:
                    py_shuffle_i64(draw, &order)
                    for i in 0..<n |order, changed|:
                        changed <- changed or order[i.usize()] != i
                machine.damage[machine.count.usize()] <- MissingWord::Damage{kind: ORDER, row: -1, index: -1}
                machine.count <- machine.count + 1
            damaged: MissingWord::Line[6] = machine.rows
            for i in 0..<n |machine, order, damaged, level, draw, vocab|:
                at: i64 = order[i.usize()]
                machine.row_of[i.usize()] <- at
                machine.rows[i.usize()] <- damaged[at.usize()]
                for j in 0..<damaged[at.usize()].count |machine, damaged, at, level, draw, vocab|:
                    token: MissingWord::Token = damaged[at.usize()].words[j.usize()]
                    truth: Passages::Word = machine.original[at.usize()].words[(token.id % 100).usize()].text
                    if not name(truth):
                        machine.options[option_index(token.id)] <- options_for(token.text, truth, level.close, draw, vocab)
            return invalid if equal_rows(&machine.original, &machine.rows, n)
            return Candidate{valid: true, machine: machine}
