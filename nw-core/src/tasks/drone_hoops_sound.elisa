include "./drone_hoops.elisa"

module DroneHoopsSound:
    const BELL: i64 = 0
    const PASS: i64 = 1
    const KNOCK: i64 = 2
    const HUM: i64 = 3
    const WIND: i64 = 4
    const BIRD: i64 = 5
    const THUNDER: i64 = 6
    const WARN: f64 = 1.3

    struct Cue:
        time: f64
        duration: f64
        pitch: f64
        pan: f64
        gain: f64
        bright: f64
        voice: i64
        seed: i64

    struct Sound:
        cue_count: mutable i64
        chime_at: mutable f64
        decoy_at: mutable f64
        hum_at: mutable f64
        hiss_at: mutable f64
        chirps: mutable f64[32]
        thunder_index: mutable i64
        cues: mutable Cue[12288]

    struct Placed:
        pan: f64
        distance: f64
        front: bool

    def initialize(course: DroneHoops::Course&) -> Sound:
        can Abort.Panic:
            result: mutable Sound = zeroed
            reset(&result, course)
            return result

    def reset(result: mutable Sound&, course: DroneHoops::Course&):
        can Abort.Panic:
            result.cue_count <- 0
            result.chime_at <- 0.4
            result.decoy_at <- 1.1
            result.hum_at <- 0.0
            result.hiss_at <- 0.0
            result.thunder_index <- 0
            for k in 0..<(course.level.birds * 4) |course, result|:
                b: DroneHoops::Bird = course.birds[k.usize()]
                result.chirps[k.usize()] <- b.time + 0.3

    def note(sound: mutable Sound&, time: f64, duration: f64, pitch: f64, pan: f64, gain: f64, voice: i64, bright: f64 = 0.8):
        can Abort.Panic:
            return if sound.cue_count >= 12288
            sound.cues[sound.cue_count.usize()] <- Cue{time: time, duration: duration, pitch: pitch,
                pan: DroneHoops::clamp(pan, -1.0, 1.0), gain: gain, bright: bright, voice: voice, seed: 2 + sound.cue_count}
            sound.cue_count <- sound.cue_count + 1

    def placed(run: DroneHoops::Run&, point: RoomsView::Vec) -> Placed:
        f: RoomsView::Vec = DroneHoops::unit(RoomsView::sub(run.look, run.eye))
        r: RoomsView::Vec = DroneHoops::unit(RoomsView::vec(-f.z, 0.0, f.x))
        d: RoomsView::Vec = RoomsView::sub(point, run.eye)
        ahead: f64 = RoomsView::dot(d, f)
        absolute: f64 = DroneHoops::abs_value(ahead)
        factor: f64 = 2.0 if absolute < 2.0 else absolute
        return Placed{pan: RoomsView::dot(d, r) / factor, distance: DroneHoops::norm(RoomsView::sub(point, run.p)), front: ahead > 0.0}

    def bell(sound: mutable Sound&, run: DroneHoops::Run&, time: f64, index: i64, gain: f64) -> f64:
        can Abort.Panic:
            hoop: DroneHoops::Hoop = run.course.hoops[index.usize()]
            h: DroneHoops::Hooped = DroneHoops::hoop_at(hoop, time)
            loc: Placed = placed(run, h.centre)
            rise: f64 = DroneHoops::clamp((h.centre.y - run.p.y) / 3.0, -1.0, 1.0)
            pitch: f64 = 880.0 * pow(2.0, rise * 7.0 / 12.0)
            note(sound, time, 0.35, pitch, loc.pan, gain * (0.25 + 0.6 / (1.0 + loc.distance / 6.0)), BELL, 0.9 if loc.front else 0.35)
            return loc.distance

    def flight_events(sound: mutable Sound&, run: DroneHoops::Run&):
        can Abort.Panic:
            for i in 0..<run.event_count |sound, run|:
                event: DroneHoops::FlightEvent = run.events[i.usize()]
                if event.kind == DroneHoops::KNOCK_EVENT:
                    if sound.cue_count > 0:
                        last: Cue = sound.cues[(sound.cue_count - 1).usize()]
                        continue if last.voice == KNOCK and run.time - last.time < 0.15
                    note(sound, run.time, 0.12, 180.0, 0.0, event.value, KNOCK)
                else:
                    for j in 0..<3 |sound, run, event|:
                        semitones: f64 = (0.0 if j == 0 else (4.0 if j == 1 else 7.0)) + event.value
                        pitch: f64 = 523.25 * pow(2.0, semitones / 12.0)
                        note(sound, run.time + 0.07 * j.f64(), 0.25, pitch, 0.0, 0.55, PASS)

    def birds(sound: mutable Sound&, run: DroneHoops::Run&, begin: f64):
        can Abort.Panic:
            course: DroneHoops::Course& = &run.course
            for k in 0..<(course.level.birds * 4) |sound, run, course, begin|:
                scheduled: f64 = sound.chirps[k.usize()]
                continue if scheduled >= run.time
                time: f64 = begin if begin > scheduled else scheduled
                bird: DroneHoops::Bird = course.birds[k.usize()]
                if not DroneHoops::bird_visible(bird, time):
                    sound.chirps[k.usize()] <- 1e9
                    continue
                loc: Placed = placed(run, DroneHoops::bird_at(bird, time))
                gain: f64 = 0.35 / (1.0 + loc.distance / 10.0)
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, (course.seed + 7 * k + (time * 10.0).i64()).u64())
                count: i64 = 2 + py_randbelow(&rng, 2.u64()).i64()
                for j in 0..<count |sound, rng, time, loc, gain|:
                    pitch: f64 = DroneHoops::uniform(&rng, 1800.0, 2600.0)
                    note(sound, time + 0.09 * j.f64(), 0.08, pitch, loc.pan, gain, BIRD)
                sound.chirps[k.usize()] <- time + DroneHoops::uniform(&rng, 0.5, 1.3)

    def wind(sound: mutable Sound&, run: DroneHoops::Run&, begin: f64):
        can Abort.Panic:
            course: DroneHoops::Course& = &run.course
            return if course.level.wind == 0.0 or sound.hiss_at >= run.time
            t: f64 = begin if begin > sound.hiss_at else sound.hiss_at
            sound.hiss_at <- t + 0.1
            for i in 0..<course.gust_count |course, t, run, sound|:
                gust: DroneHoops::Gust = course.gusts[i.usize()]
                if t >= gust.time - WARN and t < gust.time + gust.duration:
                    rise: f64 = DroneHoops::minimum(1.0, (t - (gust.time - WARN)) / WARN)
                    point: RoomsView::Vec = RoomsView::vec(run.p.x - sin(gust.heading) * 6.0, run.p.y, run.p.z - cos(gust.heading) * 6.0)
                    loc: Placed = placed(run, point)
                    note(sound, t, 0.14, 400.0, loc.pan, 0.08 + 0.3 * rise, WIND, 0.5)
                    return

    def update(sound: mutable Sound&, run: DroneHoops::Run&, begin: f64):
        can Abort.Panic:
            flight_events(sound, run)
            start: i64 = sound.cue_count
            course: DroneHoops::Course& = &run.course
            if run.next_hoop < course.level.hoops and sound.chime_at < run.time:
                t: f64 = begin if begin > sound.chime_at else sound.chime_at
                distance: f64 = bell(sound, run, t, run.next_hoop, 1.0)
                sound.chime_at <- t + 0.18 + 0.85 * DroneHoops::minimum(1.0, distance / 22.0)
            if course.decoy > run.next_hoop and sound.decoy_at < run.time:
                t: f64 = begin if begin > sound.decoy_at else sound.decoy_at
                _ = bell(sound, run, t, course.decoy, 0.8)
                sound.decoy_at <- t + 0.62
            if sound.hum_at < run.time:
                t: f64 = begin if begin > sound.hum_at else sound.hum_at
                work: f64 = DroneHoops::norm(run.thrust) / DroneHoops::ACC
                note(sound, t, 0.16, 90.0 + 40.0 * work, 0.0, 0.05 + 0.07 * work, HUM, 0.4)
                sound.hum_at <- t + 0.12
            wind(sound, run, begin)
            birds(sound, run, begin)
            while sound.thunder_index < course.flash_count |sound, course, run, begin|:
                next: f64 = course.flashes[sound.thunder_index.usize()] + 0.6
                break if next >= run.time
                sound.thunder_index <- sound.thunder_index + 1
                note(sound, begin if begin > next else next, 1.6, 55.0, 0.0, 0.55, THUNDER, 0.3)
            for i in (start + 1)..<sound.cue_count |sound, start|:
                cue: Cue = sound.cues[i.usize()]
                at: mutable i64 = i
                while at > start |sound, cue, at, start|:
                    prev: Cue = sound.cues[(at - 1).usize()]
                    break if prev.time <= cue.time
                    sound.cues[at.usize()] <- prev
                    at <- at - 1
                sound.cues[at.usize()] <- cue
