include "./loading_dock.elisa"
include "../tone_pcm.elisa"

module LoadingDockAudio:
    struct Instrument:
        patch: TonePcm::Patch
        fm_ratio: f64
        fm_index: f64
        fm_decay: f64
        drive: f64
        glide: f64
        glide_time: f64

    # Patch parameters from Loading Dock's original per-voice seeds.
    def brass() -> Instrument:
        partials: TonePcm::Partial[6] = [
                TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
                TonePcm::Partial{ratio: 2.0, gain: 0.5, decay: 0.0},
                TonePcm::Partial{ratio: 3.0, gain: 0.3333333333333333, decay: 0.0},
                TonePcm::Partial{ratio: 4.0, gain: 0.25, decay: 0.0},
                TonePcm::Partial{ratio: 5.0, gain: 0.2, decay: 0.0},
                TonePcm::Partial{ratio: 6.0, gain: 0.16666666666666666, decay: 0.0}]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 6, attack: 0.04,
            decay: 1.0, release: 0.1, sustain: 0.6, tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 1.0, fm_index: 1.3903092732337203, fm_decay: 3.0,
            drive: 0.0, glide: -0.03, glide_time: 0.05}

    def wood() -> Instrument:
        partials: TonePcm::Partial[6] = [
                TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
                TonePcm::Partial{ratio: 4.077853366036807, gain: 0.5, decay: 6.0},
                TonePcm::Partial{ratio: 9.6120012880946, gain: 0.25, decay: 12.0},
                zeroed,
                zeroed,
                zeroed]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 3, attack: 0.002,
            decay: 8.201792461908255, release: 0.05, sustain: 0.0, tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 0.0, fm_index: 0.0, fm_decay: 0.0,
            drive: 0.0, glide: 0.0, glide_time: 0.0}

    def bell() -> Instrument:
        partials: TonePcm::Partial[6] = [
                TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
                TonePcm::Partial{ratio: 2.716606942246417, gain: 0.5, decay: 1.0},
                TonePcm::Partial{ratio: 5.414330268995888, gain: 0.25, decay: 2.0},
                zeroed,
                zeroed,
                zeroed]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 3, attack: 0.002,
            decay: 1.8452593094788996, release: 0.4, sustain: 0.0, tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 3.472690584975097, fm_index: 3.062352023157717, fm_decay: 2.5,
            drive: 0.0, glide: 0.0, glide_time: 0.0}

    def growl() -> Instrument:
        partials: TonePcm::Partial[6] = [
                TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
                zeroed,
                zeroed,
                zeroed,
                zeroed,
                zeroed]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 1, attack: 0.02,
            decay: 1.5, release: 0.1, sustain: 0.5, tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 0.5, fm_index: 3.7888384717899477, fm_decay: 0.5,
            drive: 2.301583017115358, glide: 0.0, glide_time: 0.0}

    def organ() -> Instrument:
        partials: TonePcm::Partial[6] = [
                TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
                TonePcm::Partial{ratio: 2.0, gain: 0.6147482033867643, decay: 0.0},
                TonePcm::Partial{ratio: 3.0, gain: 0.4193429591408584, decay: 0.0},
                TonePcm::Partial{ratio: 4.0, gain: 0.25, decay: 0.0},
                TonePcm::Partial{ratio: 6.0, gain: 0.15, decay: 0.0},
                TonePcm::Partial{ratio: 8.0, gain: 0.10590387131131394, decay: 0.0}]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 6, attack: 0.015,
            decay: 0.0, release: 0.08, sustain: 1.0, tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 0.0, fm_index: 0.0, fm_decay: 0.0,
            drive: 0.0, glide: 0.0, glide_time: 0.0}

    def square() -> Instrument:
        partials: TonePcm::Partial[6] = [
                TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
                TonePcm::Partial{ratio: 3.0, gain: 0.3333333333333333, decay: 0.0},
                TonePcm::Partial{ratio: 5.0, gain: 0.2, decay: 0.0},
                TonePcm::Partial{ratio: 7.0, gain: 0.14285714285714285, decay: 0.0},
                TonePcm::Partial{ratio: 9.0, gain: 0.1111111111111111, decay: 0.0},
                zeroed]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 5, attack: 0.005,
            decay: 1.0, release: 0.05, sustain: 0.6, tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 0.0, fm_index: 0.0, fm_decay: 0.0,
            drive: 0.0, glide: 0.0, glide_time: 0.0}

    def pluck() -> Instrument:
        partials: TonePcm::Partial[6] = [
                TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 1.4471498294499487},
                TonePcm::Partial{ratio: 2.0, gain: 0.5, decay: 2.8942996588998975},
                TonePcm::Partial{ratio: 3.0, gain: 0.3333333333333333, decay: 4.341449488349847},
                TonePcm::Partial{ratio: 4.0, gain: 0.25, decay: 5.788599317799795},
                TonePcm::Partial{ratio: 5.0, gain: 0.2, decay: 7.235749147249743},
                TonePcm::Partial{ratio: 6.0, gain: 0.16666666666666666, decay: 8.682898976699693}]
        patch: TonePcm::Patch = TonePcm::Patch{partials: partials, count: 6, attack: 0.003,
            decay: 3.720679339139602, release: 0.1, sustain: 0.0, tremolo_rate: 0.0, tremolo_depth: 0.0}
        return Instrument{patch: patch, fm_ratio: 0.0, fm_index: 0.0, fm_decay: 0.0,
            drive: 0.0, glide: 0.0, glide_time: 0.0}

    def play_cue(stereo: mutable darray[f64]&, frames: i64, begin: f64, end: f64,
                instrument: Instrument, cue: LoadingDock::Cue):
        can Abort.Panic:
            voice: mutable TonePcm::Patch = instrument.patch
            parts: mutable TonePcm::Partial[6] = zeroed
            count: mutable i64 = 0
            bright: f64 = pow(0.8, 0.7)
            for i in 0..<voice.count |voice, cue, bright, parts, count|:
                part: TonePcm::Partial = voice.partials[i.usize()]
                if part.ratio * cue.pitch < 0.42 * TonePcm::RATE.f64():
                    parts[count.usize()] <- TonePcm::Partial{ratio: part.ratio,
                        gain: part.gain if part.ratio < 1.5 else part.gain * bright, decay: part.decay}
                    count <- count + 1
            voice <- TonePcm::Patch{partials: parts, count: count, attack: voice.attack,
                decay: voice.decay, release: voice.release, sustain: voice.sustain, tremolo_rate: 0.0, tremolo_depth: 0.0}
            overtone: TonePcm::Partial = TonePcm::Partial{ratio: 7.0, gain: 0.14285714285714285 * bright, decay: 0.0} if cue.voice == LoadingDock::HORN and 7.0 * cue.pitch < 0.42 * TonePcm::RATE.f64() else zeroed
            fx: TonePcm::Modulation = TonePcm::Modulation{fm_ratio: instrument.fm_ratio,
                fm_index: instrument.fm_index * (0.4 + 0.6 * 0.8), fm_decay: instrument.fm_decay,
                drive: instrument.drive, ring_ratio: 0.0, ring_mix: 0.0, extra_partial: overtone}
            note: TonePcm::Note = TonePcm::Note{onset: cue.time, duration: cue.duration, frequency: cue.pitch,
                pan: cue.pan, end_pan: cue.pan, gain: cue.gain, end_gain: cue.gain, vibrato_rate: 0.0, vibrato_depth: 0.0,
                noise: 0.0, glide: instrument.glide, glide_time: instrument.glide_time, seed: cue.seed}
            TonePcm::mix_note(stereo, frames, begin, end, &voice, &note, fx)

    def render(run: LoadingDock::Run&, begin: f64, end: f64, dest: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 0 if not (end > begin and end - begin <= 120.0)
            frames: i64 = py_round_half_even((end - begin) * TonePcm::RATE.f64())
            return 0 if frames < 1 or frames > capacity / TonePcm::FRAME_BYTES
            instruments: Instrument[7] = [brass(), wood(), bell(), growl(), organ(), square(), pluck()]
            stereo: mutable darray[f64] = TonePcm::empty(frames)
            for cue in run.notes |begin, end, stereo, frames, instruments|:
                instrument: Instrument = instruments[cue.voice.usize()]
                continue if cue.time >= end or cue.time + (cue.duration + instrument.patch.release) <= begin
                play_cue(&stereo, frames, begin, end, instrument, cue)
            return TonePcm::write(stereo, frames, dest)
