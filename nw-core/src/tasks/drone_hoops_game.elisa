include "./drone_hoops_audio.elisa"

module DroneHoopsGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = 10
    const RELEASE_BASE: i64 = 11
    const CLEAR: i64 = 21
    const SUBSTEP: f64 = 1.0 / 120.0

    struct Session:
        rng: mutable MT19937
        start_rung: i64
        total: i64
        adaptive: bool
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        run: mutable DroneHoops::Run
        sound: mutable DroneHoopsSound::Sound
        heard_to: mutable f64
        last_tick: mutable f64
        deadline: mutable f64
        passed_count: mutable i64
        best_rung: mutable i64
        verdict_published: mutable bool
        held: mutable i64
        pulse: mutable i64
        pointer_x: mutable f64
        pointer_y: mutable f64
        pointer_held: mutable bool

    const CX: f64 = 456.0
    const CY: f64 = 179.0 + 389.0 / 2.0
    const BASE_FOCAL: f64 = 389.0 * 0.95

    def focal(run: DroneHoops::Run&) -> f64:
        distance: f64 = DroneHoops::norm(RoomsView::sub(run.p, run.eye))
        return BASE_FOCAL * DroneHoops::clamp(distance / 11.0, 1.0, 2.6) if run.camera >= 0 else BASE_FOCAL

    def view(run: DroneHoops::Run&) -> RoomsView::Camera:
        can Abort.Panic:
            forward: RoomsView::Vec = RoomsView::unit(RoomsView::sub(run.look, run.eye))
            right: RoomsView::Vec = RoomsView::unit(RoomsView::cross(forward, RoomsView::vec(0.0, 1.0, 0.0)))
            return RoomsView::Camera{eye: run.eye, forward: forward, right: right, up: RoomsView::cross(right, forward)}

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
            initial: i64 = rung if rung > 0 else 1
            return Session{rng: rng, start_rung: initial, total: total, adaptive: adaptive,
                rung: initial, trial: 0, phase: READY, run: zeroed, sound: zeroed, heard_to: 0.0, last_tick: 0.0,
                deadline: 0.0, passed_count: 0, best_rung: 0, verdict_published: false,
                held: 0, pulse: 0, pointer_x: 0.0, pointer_y: 0.0, pointer_held: false}

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 10 or total == 20

    def next_trial(session: mutable Session&, now: f64):
        can Abort.Panic:
            session.verdict_published <- false
            session.last_tick <- now
            session.pulse <- 0
            if session.trial >= session.total:
                session.phase <- DONE
                return
            seed: i64 = py_randbelow(&session.rng, 1073741824.u64()).i64()
            course: DroneHoops::Course = DroneHoops::deal(session.rung, seed)
            if not course.valid:
                session.phase <- READY
                return
            session.run <- DroneHoops::trial(course)
            DroneHoopsSound::reset(&session.sound, &session.run.course)
            session.heard_to <- 0.0
            session.trial <- session.trial + 1
            session.phase <- PLAYING

    def start(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic:
            return false if session.phase != READY and session.phase != DONE
            session.rung <- session.start_rung
            session.trial <- 0
            session.passed_count <- 0
            session.best_rung <- 0
            next_trial(session, now)
            return session.phase == PLAYING

    def judge(session: mutable Session&, now: f64):
        passed: bool = session.run.result == DroneHoops::PASSED
        if passed:
            session.passed_count <- session.passed_count + 1
            session.best_rung <- session.rung if session.rung > session.best_rung
        if session.adaptive:
            session.rung <- session.rung + 1 if passed and session.rung < 9223372036854775807
            session.rung <- session.rung - 1 if not passed and session.rung > 1
        session.phase <- JUDGED
        session.deadline <- now + 2.5

    def input(session: mutable Session&, action: i64, now: f64) -> bool:
        can Abort.Panic:
            return start(session, now) if action == START
            return false if action < 0 or action > CLEAR
            prior: i64 = session.held
            if action == CLEAR:
                changed: bool = prior != 0 or session.pointer_held
                session.held <- 0
                session.pointer_held <- false
                return changed
            elif action < START:
                session.held <- prior | (1 << action.u64())
            else:
                bit: i64 = 1 << (action - RELEASE_BASE).u64()
                session.held <- prior ^ (prior & bit)
            return prior != session.held

    def aim_at(run: mutable DroneHoops::Run&, x: f64, y: f64) -> bool:
        can Abort.Panic:
            camera: RoomsView::Camera = view(run)
            length: f64 = focal(run)
            dx: f64 = (x - CX) / length
            dy: f64 = (y - CY) / length
            ray: RoomsView::Vec = DroneHoops::unit(RoomsView::add(camera.forward,
                RoomsView::add(RoomsView::mul(camera.right, dx), RoomsView::mul(camera.up, dy))))
            return false if DroneHoops::abs_value(ray.y) < 0.000001
            t: f64 = (run.p.y - camera.eye.y) / ray.y
            return false if t <= 0.0
            target: RoomsView::Vec = RoomsView::add(camera.eye, RoomsView::mul(ray, t))
            bound: f64 = DroneHoops::HALF - 0.5
            height: f64 = run.aim.y if run.aimed_y else run.p.y
            run.aim <- RoomsView::vec(DroneHoops::clamp(target.x, -bound, bound), height, DroneHoops::clamp(target.z, -bound, bound))
            run.aimed <- true
            run.aimed_y <- true
            return true

    def pointer_event(session: mutable Session&, x: f64, y: f64, kind: i64, now: f64) -> bool:
        can Abort.Panic:
            if kind == 2:
                previous: bool = session.pointer_held
                session.pointer_held <- false
                return previous
            session.pointer_x <- x
            session.pointer_y <- y
            if kind == 1:
                session.pointer_held <- true
                if session.phase == READY or session.phase == DONE:
                    return start(session, now)
            return false if session.phase != PLAYING or not session.pointer_held
            return aim_at(&session.run, x, y)

    def wheel(session: mutable Session&, scroll_y: f64) -> bool:
        return false if session.phase != PLAYING or scroll_y == 0.0
        p: RoomsView::Vec = session.run.p
        previous: RoomsView::Vec = session.run.aim
        base: f64 = previous.y if session.run.aimed_y else p.y
        height: f64 = DroneHoops::clamp(base + 0.5 * scroll_y, DroneHoops::FLOOR, DroneHoops::CEILING)
        session.run.aim <- RoomsView::vec(previous.x if session.run.aimed else p.x, height,
            previous.z if session.run.aimed else p.z)
        session.run.aimed <- true
        session.run.aimed_y <- true
        return true

    def tick(session: mutable Session&, now: f64):
        can Abort.Panic:
            elapsed: f64 = now - session.last_tick
            dt: f64 = 0.1 if elapsed > 0.1 else elapsed
            session.last_tick <- now
            mask: i64 = session.held | session.pulse
            if session.pointer_held:
                _ = aim_at(&session.run, session.pointer_x, session.pointer_y)
            session.pulse <- 0
            ratio: f64 = dt / SUBSTEP
            whole: i64 = ratio.i64()
            steps: i64 = whole + 1 if ratio > whole.f64() else (1 if whole == 0 else whole)
            for _step in 0..<steps |session, dt, steps, mask|:
                begin: f64 = session.run.time
                DroneHoops::step(&session.run, dt / steps.f64(), mask)
                DroneHoopsSound::update(&session.sound, &session.run, begin)
                break if session.run.result != DroneHoops::PENDING
            if session.run.result != DroneHoops::PENDING:
                judge(session, now)

    def advance(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic:
            return false if not (now >= session.last_tick and now <= 9007199254740.0)
            if session.phase == JUDGED:
                return false if now < session.deadline
                next_trial(session, now)
                return true
            return false if session.phase != PLAYING
            tick(session, now)
            return true

    def agent_mask(session: mutable Session&, mask: i64) -> bool:
        return false if session.phase != PLAYING or mask <= 0 or mask > 1023
        session.pulse <- session.pulse | mask
        return true

    def agent_event(session: mutable Session&, now: f64, port: i64) -> bool:
        can Abort.Panic:
            return false if not (now >= session.last_tick and now <= 9007199254740.0)
            return start(session, now) if port == START
            if port >= 0 and port < START:
                return agent_mask(session, 1 << port.u64())
            return false if port != -1
            if session.phase == JUDGED and session.verdict_published:
                next_trial(session, now)
                return true
            return false if session.phase != PLAYING
            tick(session, now)
            session.verdict_published <- session.phase == JUDGED
            return true

    def info(session: Session&, field: i64) -> i64:
        can Abort.Panic:
            active: bool = session.phase == PLAYING or session.phase == JUDGED
            return session.phase if field == 0
            return session.rung if field == 1
            return session.trial if field == 2
            return session.total if field == 3
            return py_round_half_even(session.run.time * 1000.0) if field == 4 and active
            return session.run.next_hoop if field == 5 and active
            return session.run.bumps if field == 6 and active
            return session.run.result if field == 7 and session.phase == JUDGED
            return session.passed_count if field == 8
            return session.best_rung if field == 9
            return py_round_half_even(session.deadline * 1000.0) if field == 10 and session.phase == JUDGED
            return session.run.course.level.hoops if field == 11 and active
            return session.run.camera if field == 12 and active
            return py_round_half_even(session.run.p.x * 1000.0) if field == 13 and active
            return py_round_half_even(session.run.p.y * 1000.0) if field == 14 and active
            return py_round_half_even(session.run.p.z * 1000.0) if field == 15 and active
            return -1

    def audio_window(session: mutable Session&, dest: mutable u8&, capacity: i64, speaker: bool = false) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 0 if session.phase != PLAYING and session.phase != JUDGED
            elapsed: f64 = session.run.time - session.heard_to
            available: i64 = capacity / TonePcm::FRAME_BYTES
            return 0 if elapsed <= 0.0 or available < 1
            frames: i64 = py_round_half_even(elapsed * TonePcm::RATE.f64())
            return 0 if frames < 1
            end: f64 = session.run.time if frames <= available else session.heard_to + available.f64() / TonePcm::RATE.f64()
            lag: f64 = 0.15 if speaker else 0.0
            length: i64 = DroneHoopsAudio::render(&session.sound, session.heard_to - lag, end - lag, dest, capacity)
            session.heard_to <- end if length > 0
            return length
