# Exact Numberology sequence generation. The compiler runtime BigInt stores
# dynamically sized limbs, so generated values do not wrap at machine width.
# Include elisacore_bigint.elisa and tasks/numberology.elisa before this file.
module NumberologyExact:
    struct NumberologyExactPuzzle:
        # One UTF-8 decimal term per line, followed by the answer on its own
        # line. This is a portable, lossless representation for host adapters.
        text: mutable dstr
        shown: mutable i64
        rule_id: mutable i64
        rule_a: mutable i64
        rule_b: mutable i64
        rule_c: mutable i64
        complexity: mutable i64

    def polynomial(out: mutable BigInt&, coefficients: darray[i64]&, count: i64, n: i64):
        can Memory.Allocate, Abort.Panic:
            bigint_set_i64(out, 0)
            one: mutable BigInt = bigint_zero()
            for index in 0..<count |out, coefficients, n, one|:
                bigint_mul_small_assign(out, n.u64())
                bigint_set_i64(&one, get coefficients[index.usize()] else 0)
                bigint_add_assign(out, &one)

    def append_i64(out: mutable dstr&, number: i64):
        can Memory.Allocate, Abort.Panic:
            value: BigInt = bigint_from_i64(number)
            bigint_append_decimal(out, &value)

    def generate(difficulty_in: i64, seed: i64) -> NumberologyExactPuzzle:
        can Memory.Allocate, Abort.Panic:
            difficulty: i64 = 1 if difficulty_in < 1 else difficulty_in
            # The first six families only draw small constants and always have
            # four shown terms, so their existing source generator is exact.
            if difficulty <= 6:
                simple: Numberology::SeqPuzzle = Numberology::generate(difficulty, seed, 0)
                text: mutable dstr = []
                for at in 0..<simple.shown |at, simple, text|:
                    append_i64(&text, Ints::at(simple.terms, at))
                    text.push(10.u8())
                append_i64(&text, simple.answer)
                return NumberologyExactPuzzle{text: text, shown: simple.shown, rule_id: simple.rule_id,
                              rule_a: simple.rule_a, rule_b: simple.rule_b,
                              rule_c: simple.rule_c, complexity: simple.complexity}
            shown: i64 = Numberology::sequence_length(difficulty, 0)
            grown: i64 = 2 + difficulty / 4
            ceiling: i64 = 2 if shown - 1 < 2 else shown - 1
            order: i64 = grown if grown < ceiling else ceiling
            scale: i64 = 1 + difficulty / 12
            rng: mutable MT19937 = mt19937_new()
            mt_seed_int(&rng, seed.u64())
            coefficients: mutable darray[i64] = Ints::zeros(order)
            for index in 0..<order |index, coefficients, rng|:
                Ints::put(&coefficients, index, Numberology::nonzero_or_one(py_randint(&rng, -3, 3)))
            values: mutable darray[BigInt] = []
            for _index in 0..<order |values, rng, scale|:
                values.push(bigint_from_i64(Numberology::nonzero_or_one(py_randint(&rng, 0 - scale, scale))))
            force_degree: i64 = 1 + difficulty / 18
            force: mutable darray[i64] = Ints::zeros(force_degree + 1)
            for index in 0..<(force_degree + 1) |index, force, rng, scale|:
                Ints::put(&force, index, Numberology::nonzero_or_one(py_randint(&rng, 0 - scale, scale)))
            period: i64 = 2 + py_randbelow(&rng, (2 + difficulty / 10).u64()).i64()
            phase: i64 = py_randbelow(&rng, period.u64()).i64()
            layers: i64 = 1 + difficulty / 16
            count: mutable i64 = order
            while count <= shown |count, shown, order, values, coefficients, force, force_degree, period, phase, layers|:
                prior: mutable BigInt = bigint_zero()
                for step in 1..<(order + 1) |step, count, coefficients, values, prior|:
                    coefficient: i64 = Ints::at_ref(&coefficients, step - 1)
                    previous: BigInt = get values[(count - step).usize()] else bigint_zero()
                    if coefficient < 0:
                        bigint_submul_small(&prior, &previous, (0 - coefficient).u64())
                    else:
                        bigint_addmul_small(&prior, &previous, coefficient.u64())
                forced: mutable BigInt = bigint_zero()
                polynomial(&forced, &force, force_degree + 1, count)
                negative: mutable bool = false
                for layer in 0..<layers |layer, layers, count, period, phase, negative|:
                    negative <- not negative if (count * (layer + 1) + phase) % (period + layer) == 0
                if negative: bigint_sub_assign(&prior, &forced)
                else: bigint_add_assign(&prior, &forced)
                values.push(prior)
                count <- count + 1
            text: mutable dstr = []
            for index in 0..<(shown + 1) |index, shown, values, text|:
                value: BigInt = get values[index.usize()] else bigint_zero()
                bigint_append_decimal(&text, &value)
                text.push(10.u8()) if index < shown
            return NumberologyExactPuzzle{text: text, shown: shown, rule_id: Numberology::RULE_RECURRENCE,
                          rule_a: order, rule_b: force_degree, rule_c: layers,
                          complexity: order + force_degree + layers + 2}
