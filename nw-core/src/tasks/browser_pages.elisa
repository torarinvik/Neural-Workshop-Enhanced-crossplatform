include "./browser.elisa"

module BrowserPages:
    # The pages of browser.py's shop: each a list of rectangles with words
    # and, for links and buttons, what clicking them does. Positions are in
    # page units, the top measured from the page's own top.

    # Action and page kinds. A page is an Action of kind HOME, LIST, ITEM
    # or CART.
    const NONE: i64 = 0
    const BACK: i64 = 1
    const HOME: i64 = 2
    const CART: i64 = 3
    const LIST: i64 = 4
    const ITEM: i64 = 5
    const ADD: i64 = 6
    const REMOVE: i64 = 7
    const CHECKOUT: i64 = 8
    # A shop app's order confirmation, which errands.py adds; its index is
    # the order.
    const PLACED: i64 = 9

    # Element styles.
    const TITLE: i64 = 0
    const TEXT: i64 = 1
    const LINK: i64 = 2
    const BUTTON: i64 = 3
    const MUTED: i64 = 4
    const BANNER: i64 = 5
    const GOOD: i64 = 6
    const BAD: i64 = 7

    # What an element says; `first` and `second` fill it in.
    const SAYS_WELCOME: i64 = 0
    const SAYS_SHOP_BY: i64 = 1
    const SAYS_DEPARTMENT: i64 = 2
    const SAYS_DEAL: i64 = 3
    const SAYS_SORT: i64 = 4
    const SAYS_SORT_ORDER: i64 = 5
    const SAYS_STALE: i64 = 6
    const SAYS_NAME: i64 = 7
    const SAYS_DOLLARS: i64 = 8
    const SAYS_RATED: i64 = 9
    const SAYS_PREVIOUS: i64 = 10
    const SAYS_PAGE_OF: i64 = 11
    const SAYS_NEXT: i64 = 12
    const SAYS_PRICE: i64 = 13
    const SAYS_RATED_OUT_OF: i64 = 14
    const SAYS_IN_STOCK: i64 = 15
    const SAYS_OUT_OF_STOCK: i64 = 16
    const SAYS_SHIPPING: i64 = 17
    const SAYS_ADD: i64 = 18
    const SAYS_MORE: i64 = 19
    const SAYS_NOTICE: i64 = 20
    const SAYS_YOUR_CART: i64 = 21
    const SAYS_CART_EMPTY: i64 = 22
    const SAYS_REMOVE: i64 = 23
    const SAYS_TOTAL: i64 = 24
    const SAYS_CHECK_OUT: i64 = 25
    # The order confirmation's words.
    const SAYS_ORDER_PLACED: i64 = 26
    const SAYS_ORDER_NUMBER: i64 = 27
    const SAYS_TOTAL_CHARGED: i64 = 28
    const SAYS_CONTINUE: i64 = 29

    # The notice under Add to cart.
    const QUIET: i64 = 0
    const ADDED: i64 = 1
    const SOLD_OUT: i64 = 2

    # The most elements a page holds: a cart page of MOST_CART items.
    const MOST_ELEMENTS: i64 = 128
    const MOST_CART: i64 = 32

    struct Action:
        kind: i64
        department: i64
        number: i64
        sort: i64
        # A product for ITEM and ADD, a cart slot for REMOVE.
        index: i64

    struct Words:
        says: i64
        first: i64
        second: i64

    struct Element:
        x: f64
        y: f64
        width: f64
        height: f64
        style: i64
        words: Words
        action: Action

    struct Layout:
        count: mutable i64
        elements: mutable Element[128]

    # A cart: product indices in the order they were added.
    struct Cart:
        count: mutable i64
        items: mutable i64[32]

    def action(kind: i64) -> Action:
        return Action{kind: kind, department: 0, number: 0, sort: 0, index: 0}

    def list_page(department: i64, number: i64, sort: i64) -> Action:
        return Action{kind: LIST, department: department, number: number, sort: sort, index: 0}

    def indexed(kind: i64, index: i64) -> Action:
        return Action{kind: kind, department: 0, number: 0, sort: 0, index: index}

    def same(one: Action, two: Action) -> bool:
        return one.kind == two.kind and one.department == two.department and one.number == two.number and one.sort == two.sort and one.index == two.index

    def says(what: i64, first: i64, second: i64) -> Words:
        return Words{says: what, first: first, second: second}

    def add(layout: mutable Layout&, x: f64, y: f64, width: f64, height: f64, style: i64, words: Words, act: Action):
        can Abort.Panic:
            return if layout.count >= MOST_ELEMENTS
            layout.elements[layout.count.usize()] <- Element{x: x, y: y, width: width, height: height, style: style,
                words: words, action: act}
            layout.count <- layout.count + 1

    # sorted_list: a department's products in a list order. Python sorts
    # by (listed, product) or (-rating, product); products are numbered in
    # list order, so a stable sort on the first key is the same.
    def sorted_list(dealt: Browser::Deal&, department: i64, sort: i64) -> darray[i64]:
        can Memory.Allocate, Abort.Panic:
            items: mutable darray[i64] = Browser::in_department(dealt, department)
            return items if sort == Browser::FEATURED
            for i in 1..<items.count.i64() |items, dealt, sort|:
                j: mutable i64 = i
                while j > 0 and list_key(dealt, sort, items[(j - 1).usize()]) > list_key(dealt, sort, items[j.usize()]) |j, items, dealt, sort|:
                    swap: i64 = items[j.usize()]
                    items[j.usize()] <- items[(j - 1).usize()]
                    items[(j - 1).usize()] <- swap
                    j <- j - 1
            return items

    def list_key(dealt: Browser::Deal&, sort: i64, index: i64) -> f64:
        product: Browser::Product = dealt.products[index.usize()]
        return product.listed.f64() if sort == Browser::BY_PRICE
        return -product.rating

    def department_size(dealt: Browser::Deal&, department: i64) -> i64:
        can Abort.Panic:
            count: mutable i64 = 0
            for index in 0..<dealt.product_count |count, dealt, department|:
                count <- count + 1 if dealt.products[index.usize()].department == department
            return count

    def pages_of(dealt: Browser::Deal&, department: i64) -> i64:
        can Abort.Panic:
            return 1 if not dealt.level.paged
            return (department_size(dealt, department) + Browser::PER_PAGE - 1) / Browser::PER_PAGE

    def home(dealt: Browser::Deal&, out: mutable Layout&):
        can Abort.Panic:
            add(out, 40.0, 20.0, 920.0, 40.0, TITLE, says(SAYS_WELCOME, dealt.shop, 0), action(NONE))
            add(out, 40.0, 70.0, 920.0, 25.0, TEXT, says(SAYS_SHOP_BY, 0, 0), action(NONE))
            for i in 0..<dealt.level.departments |out, dealt|:
                column: i64 = i % 3
                row: i64 = i / 3
                add(out, (40 + column * 310).f64(), (110 + row * 90).f64(), 290.0, 70.0, BUTTON,
                    says(SAYS_DEPARTMENT, dealt.kinds[i.usize()], 0), list_page(i, 0, Browser::FEATURED))
            add(out, 40.0, 330.0, 920.0, 60.0, BANNER, says(SAYS_DEAL, dealt.featured, 0), indexed(ITEM, dealt.featured))

    def listing(dealt: Browser::Deal&, page: Action&, out: mutable Layout&):
        can Memory.Allocate, Abort.Panic:
            department: i64 = page.department
            number: i64 = page.number
            sort: i64 = page.sort
            add(out, 40.0, 15.0, 600.0, 40.0, TITLE, says(SAYS_DEPARTMENT, dealt.kinds[department.usize()], 0), action(NONE))
            if dealt.level.sorting:
                add(out, 40.0, 62.0, 60.0, 30.0, TEXT, says(SAYS_SORT, 0, 0), action(NONE))
                for key in 0..<3 |out, department, sort|:
                    current: bool = key == sort
                    add(out, (110 + key * 230).f64(), 62.0, 220.0, 30.0, MUTED if current else LINK,
                        says(SAYS_SORT_ORDER, key, 0), action(NONE) if current else list_page(department, 0, key))
            if dealt.level.stale:
                add(out, 620.0, 20.0, 360.0, 30.0, MUTED, says(SAYS_STALE, 0, 0), action(NONE))
            items: darray[i64] = sorted_list(dealt, department, sort)
            first: i64 = number * Browser::PER_PAGE if dealt.level.paged else 0
            last_wanted: i64 = (number + 1) * Browser::PER_PAGE if dealt.level.paged else items.count.i64()
            last: i64 = last_wanted if last_wanted < items.count.i64() else items.count.i64()
            y: mutable i64 = Browser::LIST_TOP
            for slot in first..<last |out, items, dealt, y|:
                index: i64 = items[slot.usize()]
                product: Browser::Product = dealt.products[index.usize()]
                add(out, 40.0, y.f64(), 470.0, 36.0, LINK, says(SAYS_NAME, index, 0), indexed(ITEM, index))
                add(out, 540.0, y.f64(), 160.0, 36.0, TEXT, says(SAYS_DOLLARS, product.listed, 0), action(NONE))
                add(out, 720.0, y.f64(), 240.0, 36.0, TEXT, says(SAYS_RATED, index, 0), action(NONE))
                y <- y + Browser::ROW_H
            pages: i64 = pages_of(dealt, department)
            if pages > 1:
                y <- y + 10
                if number > 0:
                    add(out, 40.0, y.f64(), 200.0, 34.0, LINK, says(SAYS_PREVIOUS, 0, 0), list_page(department, number - 1, sort))
                add(out, 400.0, y.f64(), 200.0, 34.0, TEXT, says(SAYS_PAGE_OF, number + 1, pages), action(NONE))
                if number + 1 < pages:
                    add(out, 760.0, y.f64(), 200.0, 34.0, LINK, says(SAYS_NEXT, 0, 0), list_page(department, number + 1, sort))

    def product_page(dealt: Browser::Deal&, page: Action&, notice: i64, out: mutable Layout&):
        can Abort.Panic:
            product: Browser::Product = dealt.products[page.index.usize()]
            add(out, 40.0, 20.0, 920.0, 44.0, TITLE, says(SAYS_NAME, product.product, 0), action(NONE))
            add(out, 40.0, 80.0, 400.0, 34.0, TEXT, says(SAYS_PRICE, product.price, 0), action(NONE))
            add(out, 40.0, 120.0, 400.0, 34.0, TEXT, says(SAYS_RATED_OUT_OF, product.product, 0), action(NONE))
            y: mutable f64 = 160.0
            if dealt.level.stock:
                add(out, 40.0, y, 400.0, 34.0, GOOD if product.stock else BAD,
                    says(SAYS_IN_STOCK if product.stock else SAYS_OUT_OF_STOCK, 0, 0), action(NONE))
                y <- y + 40.0
            if dealt.level.shipping:
                add(out, 40.0, y, 400.0, 34.0, TEXT, says(SAYS_SHIPPING, product.shipping, 0), action(NONE))
                y <- y + 40.0
            add(out, 40.0, y + 20.0, 260.0, 56.0, BUTTON, says(SAYS_ADD, 0, 0), indexed(ADD, product.product))
            add(out, 340.0, y + 30.0, 400.0, 36.0, LINK, says(SAYS_MORE, dealt.kinds[product.department.usize()], 0),
                list_page(product.department, 0, Browser::FEATURED))
            if notice != QUIET:
                add(out, 40.0, y + 100.0, 700.0, 34.0, TEXT, says(SAYS_NOTICE, notice, 0), action(NONE))

    def cart_page(dealt: Browser::Deal&, cart: Cart&, out: mutable Layout&):
        can Abort.Panic:
            add(out, 40.0, 20.0, 600.0, 44.0, TITLE, says(SAYS_YOUR_CART, 0, 0), action(NONE))
            y: mutable f64 = 80.0
            if cart.count == 0:
                add(out, 40.0, y, 600.0, 34.0, TEXT, says(SAYS_CART_EMPTY, 0, 0), action(NONE))
            total: mutable i64 = 0
            for slot in 0..<cart.count |out, cart, dealt, y, total|:
                product: Browser::Product = dealt.products[cart.items[slot.usize()].usize()]
                add(out, 40.0, y, 480.0, 36.0, TEXT, says(SAYS_NAME, product.product, 0), action(NONE))
                add(out, 540.0, y, 140.0, 36.0, TEXT, says(SAYS_DOLLARS, product.price, 0), action(NONE))
                add(out, 720.0, y, 140.0, 36.0, LINK, says(SAYS_REMOVE, 0, 0), indexed(REMOVE, slot))
                y <- y + Browser::ROW_H.f64()
                total <- total + product.price + product.shipping
            add(out, 40.0, y + 10.0, 400.0, 34.0, TEXT, says(SAYS_TOTAL, total, 0), action(NONE))
            add(out, 40.0, y + 60.0, 260.0, 56.0, BUTTON, says(SAYS_CHECK_OUT, 0, 0), action(CHECKOUT))

    # layout: the page's elements, in page units.
    def layout(dealt: Browser::Deal&, page: Action&, cart: Cart&, notice: i64) -> Layout:
        can Memory.Allocate, Abort.Panic:
            out: mutable Layout = zeroed
            if page.kind == HOME:
                home(dealt, &out)
            elif page.kind == LIST:
                listing(dealt, page, &out)
            elif page.kind == ITEM:
                product_page(dealt, page, notice, &out)
            else:
                cart_page(dealt, cart, &out)
            return out

    def page_height(layout: Layout&) -> f64:
        can Abort.Panic:
            bottom: mutable f64 = 0.0
            for index in 0..<layout.count |bottom, layout|:
                element: Element = layout.elements[index.usize()]
                bottom <- element.y + element.height if element.y + element.height > bottom
            return bottom + 30.0
