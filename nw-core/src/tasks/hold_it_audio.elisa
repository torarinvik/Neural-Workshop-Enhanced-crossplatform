include "./hold_it.elisa"

include "../tone_pcm.elisa"

module HoldItAudio:
    const RATE: i64 = TonePcm::RATE
    const FRAME_BYTES: i64 = TonePcm::FRAME_BYTES

    # Samples of the fixed organ and wood patches made by Python Random(1).
    # Wood's third partial is above the 0.42 * RATE bandwidth at 1400 Hz.
    def organ() -> TonePcm::Patch:
        partials: TonePcm::Partial[6] = [
            TonePcm::Partial{ratio: 1.0, gain: 1.0, decay: 0.0},
            TonePcm::Partial{ratio: 2.0, gain: 0.5561237092934881 * TonePcm::BRIGHT_PARTIAL, decay: 0.0},
            TonePcm::Partial{ratio: 3.0, gain: 0.4277946989549786 * TonePcm::BRIGHT_PARTIAL, decay: 0.0},
            TonePcm::Partial{ratio: 4.0, gain: 0.25 * TonePcm::BRIGHT_PARTIAL, decay: 0.0},
            TonePcm::Partial{ratio: 6.0, gain: 0.15 * TonePcm::BRIGHT_PARTIAL, decay: 0.0},
            TonePcm::Partial{ratio: 8.0, gain: 0.10527549237953229 * TonePcm::BRIGHT_PARTIAL, decay: 0.0}]
        return TonePcm::Patch{partials: partials, count: 6, attack: 0.015, decay: 0.0, release: 0.08, sustain: 1.0, tremolo_rate: 0.0, tremolo_depth: 0.0}

    def render(ask: HoldIt::Ask&, begin: f64, end: f64, dest: mutable u8&, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            return 0 if not (begin >= 0.0 and end > begin and end <= 9007199254740.0 and end - begin <= 30.0)
            frames: i64 = round_half_even((end - begin) * RATE.f64())
            return 0 if frames == 0 or frames > capacity / FRAME_BYTES
            stereo: mutable darray[f64] = TonePcm::empty(frames)
            hum: TonePcm::Patch = organ()
            for index in 0..<ask.count |ask, stereo, frames, begin, end, hum|:
                lamp: HoldIt::Lamp = ask.lamps[index.usize()]
                TonePcm::mix(&stereo, frames, begin, end, &hum, lamp.on, lamp.off - lamp.on,
                    330.0 + 110.0 * index.f64(), -0.3 + 0.6 * index.f64(), 0.5)
            if ask.tick > 0.0:
                click: TonePcm::Patch = TonePcm::wood(1400.0)
                onset: mutable f64 = 0.3
                while onset < ask.turn + HoldIt::WAIT + 6.0 and onset < end |ask, onset, stereo, frames, begin, end, click|:
                    TonePcm::mix(&stereo, frames, begin, end, &click, onset, 0.04, 1400.0, 0.6, 0.35)
                    onset <- onset + ask.tick
            return TonePcm::write(stereo, frames, dest)
