include "./delay.elisa"

module DelayGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const OFFER: i64 = 0
    const WAITING: i64 = 1
    const PAUSE: i64 = 2
    const OVER: i64 = 3
    const TAKE: i64 = 0
    const WAIT: i64 = 1
    const START: i64 = 2
    const FEEDBACK: f64 = 3.0

    struct Session:
        rng: mutable MT19937
        rung: mutable i64
        start_rung: mutable i64
        trials: mutable i64
        adaptive: mutable bool
        trial: mutable i64
        phase: mutable i64
        dealt: mutable Delay::Run
        mode: mutable i64
        offer: mutable i64
        coins: mutable i64
        par: mutable f64
        began: mutable f64
        clock: mutable f64
        since: mutable f64
        until: mutable f64
        passed: mutable bool
        passed_count: mutable i64
        best_rung: mutable i64

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_trials(trials: i64) -> bool:
        return trials == 1 or trials == 3 or trials == 5 or trials == 10

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            start: i64 = rung if rung > 0 else 1
            return Session{rng: rng, rung: start, start_rung: start, trials: trials,
                adaptive: adaptive, trial: 0, phase: READY, dealt: zeroed,
                mode: OFFER, offer: 0, coins: 0, par: 0.0, began: 0.0, clock: 0.0, since: 0.0,
                until: 0.0, passed: false, passed_count: 0, best_rung: 0}

    def next_round(session: mutable Session&, now: f64):
        can Abort.Panic:
            if session.trial >= session.trials:
                session.phase <- DONE
                return
            seed: i64 = py_randbelow(&session.rng, 1073741824.u64()).i64()
            Delay::deal(session.rung, seed, &session.dealt)
            session.par <- Delay::par(&session.dealt)
            session.trial <- session.trial + 1
            session.phase <- PLAYING
            session.mode <- OFFER
            session.offer <- 0
            session.coins <- 0
            session.began <- now
            session.since <- 0.0
            session.until <- 0.0
            session.passed <- false

    def reset(session: mutable Session&):
        session.rung <- session.start_rung
        session.trial <- 0
        session.phase <- READY
        session.mode <- OFFER
        session.offer <- 0
        session.coins <- 0
        session.passed_count <- 0
        session.best_rung <- 0

    def start(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic:
            return false if session.phase != READY and session.phase != DONE
            reset(session)
            next_round(session, now)
            return true

    def pause(session: mutable Session&, now: f64, duration: f64):
        session.mode <- PAUSE
        session.until <- now + duration
        session.offer <- session.offer + 1

    def steer(session: mutable Session&, port: i64, now: f64) -> bool:
        can Abort.Panic:
            session.clock <- now
            return start(session, now) if port == START
            return false if session.phase != PLAYING
            if port == TAKE:
                if session.mode == OFFER:
                    session.coins <- session.coins + session.dealt.offers[session.offer.usize()].small
                    pause(session, now, Delay::COLLECT)
                    return true
                if session.mode == WAITING:
                    pause(session, now, Delay::GIVE_UP)
                    return true
            elif port == WAIT and session.mode == OFFER:
                session.mode <- WAITING
                session.since <- now
                return true
            return false

    def judge(session: mutable Session&, now: f64):
        session.passed <- session.coins.f64() >= session.par - 0.000000001
        if session.passed:
            session.passed_count <- session.passed_count + 1
            session.best_rung <- session.rung if session.rung > session.best_rung
        if session.adaptive:
            if session.passed:
                session.rung <- session.rung + 1 if session.rung < 9223372036854775807
            elif session.rung > 1:
                session.rung <- session.rung - 1
        session.mode <- OVER
        session.phase <- JUDGED
        session.until <- now + FEEDBACK

    def advance(session: mutable Session&, now: f64) -> bool:
        can Abort.Panic:
            session.clock <- now
            if session.phase == JUDGED:
                return false if now < session.until
                next_round(session, now)
                return true
            return false if session.phase != PLAYING
            if now - session.began >= session.dealt.level.seconds:
                judge(session, now)
                return true
            if session.mode == WAITING:
                offer: Delay::Offer = session.dealt.offers[session.offer.usize()]
                if offer.wait != Delay::NEVER and now - session.since >= offer.wait:
                    session.coins <- session.coins + offer.large
                    pause(session, now, Delay::COLLECT)
                    return true
            elif session.mode == PAUSE and now >= session.until:
                session.mode <- OFFER
                return true
            return false

    # The agent publishes one verdict frame before asking for the next tick.
    # Its clock advances by a single step even when the verdict is visible.
    def agent_event(session: mutable Session&, now: f64, port: i64) -> bool:
        can Abort.Panic:
            return false if not (now >= session.clock and now <= 9007199254740.0)
            return steer(session, port, now) if port >= 0
            return false if port != -1 or session.phase == DONE
            if session.phase == JUDGED:
                session.clock <- now
                next_round(session, now)
            else:
                _ = advance(session, now)
            return true
