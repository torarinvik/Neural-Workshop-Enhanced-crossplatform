include "../pyrandom.elisa"

module Falls:
    const STAND: i64 = 0
    const LEVER: i64 = 1
    const LAND: i64 = 2
    const FIRST: i64 = 3
    const BOUNCE: i64 = 4
    const MOST_CHOICES: i64 = 8
    const WORLD_W: f64 = 12.0
    const WORLD_H: f64 = 7.0
    const GRAVITY: f64 = 9.8
    const REBOUND: f64 = 0.6
    const MAX_BLOCKS: i64 = 7
    const PILE_SLOTS: i64 = 11
    const MAX_DOTS: i64 = 5

    struct Grade:
        rung: i64
        newest: i64
        blocks: i64
        margin: f64
        bins: i64
        dots: i64
        offset_pivot: bool

    struct Block:
        x: f64
        y: f64
        w: f64
        h: f64

    struct Tower:
        count: mutable i64
        blocks: mutable Block[MAX_BLOCKS]

    struct Plank:
        pivot: mutable i64
        piles: mutable i64[PILE_SLOTS]

    struct Point:
        x: f64
        y: f64

    struct Flight:
        height: f64
        edge: f64
        speed: f64
        lo: f64
        hi: f64
        dots: mutable Point[MAX_DOTS]
        dot_count: i64
        bounces: i64

    struct Puzzle:
        kind: i64
        choices: i64
        answer: i64
        tower: Tower
        lever: Plank
        flight: Flight

    def grade(rung: i64) -> Grade:
        can Abort.Panic:
            r: i64 = rung if rung > 0 else 1
            newest: i64 = BOUNCE if r >= 16 else (FIRST if r >= 12 else (LAND if r >= 8 else (LEVER if r >= 4 else STAND)))
            inset: f64 = 0.32 - 0.015 * (r - 1).f64()
            margin: f64 = inset if inset > 0.02 else 0.02
            blocks: i64 = MAX_BLOCKS if r >= 15 else 2 + r / 3
            bins: i64 = MOST_CHOICES if r >= 23 else (3 + (r - 8) / 3 if r >= 8 else 3)
            dots: i64 = 5 if r <= 20 else (2 if r >= 27 else 5 - (r - 18) / 3)
            return Grade{rung: r, newest: newest, blocks: blocks, margin: margin, bins: bins, dots: dots, offset_pivot: r >= 10}

    def uniform(rng: mutable MT19937&, lo: f64, hi: f64) -> f64:
        can Abort.Panic:
            return lo + (hi - lo) * py_random(rng)

    def magnitude(value: f64) -> f64:
        return -value if value < 0.0 else value

    def lean(built: Tower&, level: i64) -> f64:
        can Abort.Panic:
            mass: mutable f64 = 0.0
            moment: mutable f64 = 0.0
            for at in level..<built.count |built, mass, moment|:
                block: Block = built.blocks[at.usize()]
                weight: f64 = block.w * block.h
                mass <- mass + weight
                moment <- moment + (block.x + block.w / 2.0) * weight
            com: f64 = moment / mass
            block: Block = built.blocks[level.usize()]
            under: Block = built.blocks[(level - 1).usize()]
            lo: f64 = under.x if under.x > block.x else block.x
            under_right: f64 = under.x + under.w
            right: f64 = block.x + block.w
            hi: f64 = under_right if under_right < right else right
            to_left: f64 = com - lo
            to_right: f64 = hi - com
            return (to_left if to_left < to_right else to_right) / (hi - lo)

    def first_to_fall(built: Tower&) -> i64:
        can Abort.Panic:
            for level in 1..<built.count |built|:
                return level if lean(built, level) < 0.0
            return -1

    def tower(level: Grade&, rng: mutable MT19937&, falls: bool, first: i64) -> Tower:
        can Abort.Panic:
            drawn: i64 = py_randint(rng, level.blocks - 2 if level.blocks >= 4 else 2, level.blocks)
            count: i64 = first + 1 if first >= drawn else drawn
            height: f64 = 1.0 if count <= 5 else 5.5 / count.f64()
            built: mutable Tower = zeroed
            built.count <- count
            built.blocks[0] <- Block{x: WORLD_W / 2.0 - 1.2, y: 0.0, w: 2.4, h: height}
            for index in 1..<count |built, rng, height|:
                under: Block = built.blocks[(index - 1).usize()]
                w: f64 = uniform(rng, 0.8, 2.6)
                x: f64 = under.x + uniform(rng, -0.8 * w, under.w - 0.2 * w)
                built.blocks[index.usize()] <- Block{x: x, y: under.y + under.h, w: w, h: height}
            for index in 1..<count |built, level|:
                block: Block = built.blocks[index.usize()]
                under: Block = built.blocks[(index - 1).usize()]
                return zeroed if block.x + block.w <= under.x or block.x >= under.x + under.w
                margin: f64 = magnitude(lean(&built, index))
                return zeroed if margin < level.margin or margin > level.margin + 0.35
            for index in 0..<count |built|:
                block: Block = built.blocks[index.usize()]
                return zeroed if block.x <= 0.2 or block.x + block.w >= WORLD_W - 0.2
            first_fall: i64 = first_to_fall(&built)
            return zeroed if (first_fall >= 0) != falls or (first >= 0 and first_fall != first)
            return built

    def stand(level: Grade&, rng: mutable MT19937&) -> Puzzle:
        can Abort.Panic:
            falls: bool = py_random(rng) < 0.5
            for _attempt in 0..<4000 |level, rng, falls|:
                built: Tower = tower(level, rng, falls, -1)
                if built.count > 0:
                    return Puzzle{kind: STAND, choices: 2, answer: 1 if falls else 0, tower: built, lever: zeroed, flight: zeroed}
            return zeroed

    def first(level: Grade&, rng: mutable MT19937&) -> Puzzle:
        can Abort.Panic:
            target: i64 = py_choice_index(rng, level.blocks)
            for _attempt in 0..<6000 |level, rng, target|:
                built: Tower = tower(level, rng, target > 0, target if target > 0 else -1)
                if built.count > 0:
                    return Puzzle{kind: FIRST, choices: built.count, answer: built.count - 1 if target == 0 else target - 1,
                        tower: built, lever: zeroed, flight: zeroed}
            return zeroed

    def lever(level: Grade&, rng: mutable MT19937&) -> Puzzle:
        can Abort.Panic:
            wanted: i64 = py_choice_index(rng, 3)
            pivots: i64[4] = [-2, -1, 1, 2]
            for _attempt in 0..<4000 |level, rng, wanted, pivots|:
                pivot: i64 = pivots[py_choice_index(rng, 4).usize()] if level.offset_pivot else 0
                board: mutable Plank = zeroed
                board.pivot <- pivot
                count: i64 = py_randint(rng, 2, 2 + level.rung / 6)
                for _pile in 0..<count |board, pivot, rng|:
                    at: i64 = py_randint(rng, -5, 5)
                    if at != pivot:
                        index: usize = (at + 5).usize()
                        board.piles[index] <- board.piles[index] + py_randint(rng, 1, 3)
                moment: mutable i64 = -2 * pivot
                weight: mutable i64 = 2
                for at in 0..<PILE_SLOTS |board, pivot, moment, weight|:
                    boxes: i64 = board.piles[at.usize()]
                    weight <- weight + boxes
                    moment <- moment + boxes * (at - 5 - pivot)
                answer: i64 = 2 if moment == 0 else (0 if moment < 0 else 1)
                continue if answer != wanted
                continue if moment != 0 and magnitude(moment.f64()) / (weight.f64() * 5.0) < level.margin * 0.4
                return Puzzle{kind: LEVER, choices: 3, answer: answer, tower: zeroed, lever: board, flight: zeroed}
            return zeroed

    def landing(height: f64, speed: f64, edge: f64, bounces: i64) -> f64:
        can Abort.Panic:
            fall: f64 = sqrt(2.0 * height / GRAVITY)
            x: mutable f64 = edge + speed * fall
            up: mutable f64 = GRAVITY * fall * REBOUND
            for _bounce in 0..<bounces |speed, x, up|:
                x <- x + speed * 2.0 * up / GRAVITY
                up <- up * REBOUND
            return x

    def flight(level: Grade&, rng: mutable MT19937&, bounces: i64) -> Puzzle:
        can Abort.Panic:
            index: i64 = py_choice_index(rng, level.bins)
            for _attempt in 0..<3000 |level, rng, index, bounces|:
                height: f64 = uniform(rng, 1.2, 3.5)
                edge: f64 = uniform(rng, 0.8, 3.0)
                lo: f64 = edge + 0.4
                hi: f64 = WORLD_W - 0.2
                width: f64 = (hi - lo) / level.bins.f64()
                place: f64 = index.f64() + uniform(rng, level.margin, 1.0 - level.margin)
                x: f64 = lo + place * width
                speed: f64 = (x - edge) / landing(height, 1.0, 0.0, bounces)
                continue if speed < 0.4 or speed > 12.0
                dots: mutable Point[MAX_DOTS] = zeroed
                for at in 0..<level.dots |dots, edge, speed, height|:
                    elapsed: f64 = at.f64() * 0.09
                    dots[at.usize()] <- Point{x: edge + speed * at.f64() * 0.09, y: height - 0.5 * GRAVITY * (elapsed * elapsed)}
                path: Flight = Flight{height: height, edge: edge, speed: speed, lo: lo, hi: hi,
                    dots: dots, dot_count: level.dots, bounces: bounces}
                return Puzzle{kind: BOUNCE if bounces > 0 else LAND, choices: level.bins, answer: index,
                    tower: zeroed, lever: zeroed, flight: path}
            return zeroed

    def deal(rung: i64, seed: i64) -> Puzzle:
        can Abort.Panic:
            level: Grade = grade(rung)
            draw: mutable MT19937 = mt19937_new()
            mt_seed_int(&draw, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
            for _attempt in 0..<50 |level, draw|:
                kind: i64 = level.newest if py_random(&draw) < 0.4 else py_choice_index(&draw, level.newest + 1)
                found: mutable Puzzle = zeroed
                if kind == STAND:
                    found <- stand(&level, &draw)
                elif kind == LEVER:
                    found <- lever(&level, &draw)
                elif kind == FIRST:
                    found <- first(&level, &draw)
                else:
                    found <- flight(&level, &draw, 1 if kind == BOUNCE else 0)
                return found if found.choices > 0
            return zeroed
