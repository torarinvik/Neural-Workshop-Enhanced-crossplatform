# Common-v1 Chess controller. The board geometry is source-backed through
# Chess::set_motif; engine legality remains an explicit host dependency until
# the native/browser oracle adapter is available.
module ChessGame:
    const TASK_ID: i64 = 2605208591
    const READY: i64 = 0
    const SOLVING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = 0
    const ANSWER: i64 = 1
    const LEFT: i64 = 2
    const RIGHT: i64 = 3
    const UP: i64 = 4
    const DOWN: i64 = 5

    struct Run:
        rng: mutable MT19937
        rung: mutable i64
        trials: mutable i64
        trial: mutable i64
        right: mutable i64
        phase: mutable i64
        verdict: mutable i64
        cursor: mutable i64
        target: mutable i64
        white_to_move: mutable bool
        piece: mutable i64[64]
        white: mutable i64[64]

    def allowed_rung(value: i64) -> bool:
        return value >= 1 and value <= Chess::MOST_LEVELS
    def allowed_trials(value: i64) -> bool:
        return value >= 1 and value <= 100

    def clear(run: mutable Run&):
        can Abort.Panic:
            run.cursor <- 0
            run.target <- 14
            run.white_to_move <- true
            for square in 0..<64 |square, run|:
                run.piece[square.usize()] <- 0
                run.white[square.usize()] <- 0

    def deal(run: mutable Run&):
        can Abort.Panic:
            board: mutable Chess::Board = Chess::new_board()
            Chess::set_motif(&board, 0)
            run.target <- 14
            run.white_to_move <- board.white_to_move
            for square in 0..<64 |square, board, run|:
                run.piece[square.usize()] <- board.piece[square.usize()]
                run.white[square.usize()] <- 1 if board.black[square.usize()] == 0 and board.piece[square.usize()] != 0 else 0

    def initialize(run: mutable Run&, rung: i64, trials: i64, seed: i64):
        can Abort.Panic:
            run.rng <- mt19937_new()
            mt_seed_int(&run.rng, seed.u64())
            run.rung <- rung
            run.trials <- trials
            run.trial <- 0
            run.right <- 0
            run.phase <- READY
            run.verdict <- -1
            clear(run)

    def apply(run: mutable Run&, action: i64, value: i64, now_ms: i64) -> i64:
        can Abort.Panic:
            _ = value
            _ = now_ms
            if action == START:
                if run.phase == SOLVING: return 2
                if run.trial >= run.trials:
                    run.phase <- DONE
                    return 2
                run.trial <- run.trial + 1
                clear(run)
                deal(run)
                run.phase <- SOLVING
                run.verdict <- -1
                return 1
            if run.phase != SOLVING: return 2
            if action == LEFT: run.cursor <- run.cursor - 1 if run.cursor % 8 > 0
            elif action == RIGHT: run.cursor <- run.cursor + 1 if run.cursor % 8 < 7
            elif action == UP: run.cursor <- run.cursor - 8 if run.cursor >= 8
            elif action == DOWN: run.cursor <- run.cursor + 8 if run.cursor < 56
            elif action == ANSWER:
                run.verdict <- 1 if run.cursor == run.target else 0
                if run.verdict == 1: run.right <- run.right + 1
                run.phase <- JUDGED
            else: return 2
            return 1

    def info(run: Run&, field: i64) -> i64:
        if field == 0: return run.phase
        if field == 1: return run.rung
        if field == 2: return run.trial
        if field == 3: return run.trials
        if field == 4: return run.cursor
        if field == 5: return run.target
        if field == 6: return run.verdict
        if field == 7: return run.right
        return -1

    def value(run: Run&, field: i64, at: i64) -> i64:
        return -1 if at < 0 or at >= 64
        if field == 0: return run.piece[at.usize()]
        if field == 1: return run.white[at.usize()]
        return -1

    def render(run: Run&, black: bool, width: f64, height: f64, list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            region frame(67108864):
                in frame:
                    piece: mutable darray[i64] = Ints::zeros(64)
                    white: mutable darray[i64] = Ints::zeros(64)
                    targets: mutable darray[i64] = Ints::zeros(64)
                    for square in 0..<64 |square, piece, white, run|:
                        Ints::put(&piece, square, run.piece[square.usize()])
                        Ints::put(&white, square, run.white[square.usize()])
                    sx: f64 = width / Display::REFERENCE_WIDTH
                    sy: f64 = height / Display::REFERENCE_HEIGHT
                    paint: SceneChess::Paint = SceneChess::paint_of(black, width, height, sx, sy)
                    SceneChess::render(list, &paint, &piece, &white, &targets, run.white_to_move,
                        run.phase, run.cursor, run.trial, run.trials,
                        sview("Press Space to start", 0, -1))
                destroy frame
