# Stateful common-v1 Syllogisms controller. Question generation and answer
# labels remain owned by Syllogism; the ABI record owns only fixed text and
# selection state copied out of the source question region.
module SyllogismGame:
    const TASK_ID: i64 = 199098354
    const MAX_TEXT: i64 = 32768
    const MAX_OPTIONS: i64 = 32
    const READY: i64 = 0
    const ASKING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = 0
    const ANSWER: i64 = 1
    const LEFT: i64 = 2
    const RIGHT: i64 = 3
    const UP: i64 = 4
    const DOWN: i64 = 5

    struct Run:
        rng: mutable MT19937
        rung: mutable i64
        trials: mutable i64
        trial: mutable i64
        right: mutable i64
        phase: mutable i64
        verdict: mutable i64
        choice: mutable i64
        answer: mutable i64
        family: mutable i64
        option_count: mutable i64
        text: mutable u8[MAX_TEXT]
        used: mutable i64
        premise_start: mutable i64
        premise_len: mutable i64
        asked_start: mutable i64
        asked_len: mutable i64
        options_start: mutable i64[MAX_OPTIONS]
        options_len: mutable i64[MAX_OPTIONS]

    def allowed_rung(value: i64) -> bool:
        return value >= 1 and value <= Syllogism::GRADE_COUNT
    def allowed_trials(value: i64) -> bool:
        return value >= 1 and value <= 100

    def clear(run: mutable Run&):
        can Abort.Panic:
            run.used <- 0
            run.premise_start <- 0
            run.premise_len <- 0
            run.asked_start <- 0
            run.asked_len <- 0
            run.option_count <- 0
            run.choice <- 0
            run.answer <- -1
            run.family <- 0

    def append_view(run: mutable Run&, view: sview) -> i64:
        can Abort.Panic:
            start: i64 = run.used
            length: i64 = sview_len(view).i64()
            for at in 0..<length |at, run, view, start|:
                run.text[(start + at).usize()] <- sview_at(view, at.usize())
            run.used <- start + length
            return start

    def deal(run: mutable Run&):
        can Memory.Allocate, Abort.Panic:
            region question(67108864):
                in question:
                    grade: mutable Syllogism::Grade = Syllogism::grade_of(run.rung)
                    names: mutable Syllogism::Names = Syllogism::Names()
                    work: mutable Syllogism::Work = Syllogism::Work()
                    q: mutable Syllogism::Question = Syllogism::Question()
                    _ = Syllogism::deal_one(&grade, &run.rng, true, &work, &q)
                    run.family <- q.family
                    run.answer <- q.answer
                    run.option_count <- q.option_count
                    premise: mutable i64 = 0
                    for line in 0..<q.line_count |line, q, run, premise|:
                        if line > 0:
                            run.text[run.used.usize()] <- 10.u8()
                            run.used <- run.used + 1
                        premise <- append_view(run, Syllogism::line_at(q, line))
                    run.premise_start <- 0
                    run.premise_len <- run.used
                    run.asked_start <- append_view(run, Syllogism::slice(q, q.asked_start, q.asked_len))
                    run.asked_len <- q.asked_len
                    for option in 0..<q.option_count |option, q, run|:
                        run.options_start[option.usize()] <- append_view(run, Syllogism::option_at(q, option))
                        run.options_len[option.usize()] <- sview_len(Syllogism::option_at(q, option)).i64()
                destroy question

    def initialize(run: mutable Run&, rung: i64, trials: i64, seed: i64):
        can Abort.Panic:
            run.rng <- mt19937_new()
            mt_seed_int(&run.rng, seed.u64())
            run.rung <- rung
            run.trials <- trials
            run.trial <- 0
            run.right <- 0
            run.phase <- READY
            run.verdict <- -1
            clear(run)

    def apply(run: mutable Run&, action: i64, value: i64, now_ms: i64) -> i64:
        can Memory.Allocate, Abort.Panic:
            _ = value
            _ = now_ms
            if action == START:
                if run.phase == ASKING: return 2
                if run.trial >= run.trials:
                    run.phase <- DONE
                    return 2
                run.trial <- run.trial + 1
                clear(run)
                deal(run)
                run.phase <- ASKING
                run.verdict <- -1
                return 1
            if run.phase != ASKING: return 2
            if action == LEFT or action == UP:
                run.choice <- run.choice - 1 if run.choice > 0
                return 1
            if action == RIGHT or action == DOWN:
                run.choice <- run.choice + 1 if run.choice + 1 < run.option_count
                return 1
            if action == ANSWER:
                run.verdict <- 1 if run.choice == run.answer else 0
                if run.verdict == 1: run.right <- run.right + 1
                run.phase <- JUDGED
                return 1
            return 2

    def info(run: Run&, field: i64) -> i64:
        if field == 0: return run.phase
        if field == 1: return run.rung
        if field == 2: return run.trial
        if field == 3: return run.trials
        if field == 4: return run.family
        if field == 5: return run.option_count
        if field == 6: return run.choice
        if field == 7: return run.verdict
        if field == 8: return run.right
        return -1

    def value(run: Run&, field: i64, at: i64) -> i64:
        if field == 0: return run.answer if at == 0 else -1
        if field == 1: return run.options_start[at.usize()] if at >= 0 and at < run.option_count else -1
        return -1

    def render(run: Run&, black: bool, width: f64, height: f64, list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            region frame(67108864):
                in frame:
                    text: mutable darray[u8] = Bytes::zeros(MAX_TEXT)
                    for at in 0..<run.used |at, text, run|:
                        Bytes::put(&text, at, run.text[at.usize()])
                    options: mutable darray[sview] = []
                    for option in 0..<run.option_count |option, options, text, run|:
                        options.push(string_view_slice(bytes_view(text), run.options_start[option.usize()], run.options_start[option.usize()] + run.options_len[option.usize()]))
                    sx: f64 = width / Display::REFERENCE_WIDTH
                    sy: f64 = height / Display::REFERENCE_HEIGHT
                    paint: SceneSyllogism::Paint = SceneSyllogism::paint_of(black, width, height, sx, sy)
                    premises: sview = string_view_slice(bytes_view(text), run.premise_start, run.premise_start + run.premise_len) if run.premise_len > 0 else sview("", 0, -1)
                    asked: sview = string_view_slice(bytes_view(text), run.asked_start, run.asked_start + run.asked_len) if run.asked_len > 0 else sview("", 0, -1)
                    message: sview = sview("Press Space to start", 0, -1) if run.phase == READY else sview("Choose an answer", 0, -1)
                    SceneSyllogism::render(list, &paint, run.phase, run.option_count > 0,
                        premises, 4, asked, sview("", 0, -1), options, run.choice,
                        run.answer, run.trial, run.trials, message, run.verdict,
                        sview("", 0, -1))
                destroy frame
