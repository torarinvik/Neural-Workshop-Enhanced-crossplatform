include "./triage.elisa"

module TriageGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const FINISHED: i64 = 3
    const FLAGGED: i64 = 4
    const FIRST_SWAP: i64 = 8
    const DONE: i64 = 16
    const START: i64 = 17
    const FLAG: i64 = 18
    const FEEDBACK_MS: i64 = 2500

    struct Run:
        start_rung: mutable i64
        trials: mutable i64
        adaptive: mutable bool
        rng: mutable MT19937
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        dealt: mutable Triage::Deal
        play: mutable Triage::Round
        par: mutable f64
        passed: mutable bool
        deadline_ms: mutable i64
        scored_count: mutable i64
        passed_count: mutable i64
        best_rung: mutable i64
        think_capacity: mutable f64
        think_refill: mutable f64
        think_left: mutable f64
        forfeits: mutable i64
        verdict_published: mutable bool

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 3 or rung == 5 or rung == 8 or rung == 12 or rung == 16 or rung == 20 or rung == 21 or rung == 25 or rung == 30

    def allowed_trials(trials: i64) -> bool:
        return trials == 1 or trials == 3 or trials == 5 or trials == 8 or trials == 12

    def initialize(rung: i64, trials: i64, adaptive: bool, seed: i64) -> Run:
        can Abort.Panic:
            rng: mutable MT19937 = mt19937_new()
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            start: i64 = rung if rung > 0 else 1
            play: mutable Triage::Round = zeroed
            play.active <- -1
            return Run{start_rung: start, trials: trials, adaptive: adaptive, rng: rng,
                rung: start, trial: 0, phase: READY, dealt: zeroed, play: play,
                par: 0.0, passed: false, deadline_ms: 0, scored_count: 0, passed_count: 0, best_rung: 0,
                think_capacity: 0.0, think_refill: 0.0, think_left: 0.0,
                forfeits: 0, verdict_published: false}

    def clear_trial(run: mutable Run&):
        run.dealt <- zeroed
        run.play <- zeroed
        run.play.active <- -1
        run.par <- 0.0
        run.passed <- false
        run.deadline_ms <- 0
        run.verdict_published <- false

    def reset(run: mutable Run&):
        clear_trial(run)
        run.phase <- READY
        run.rung <- run.start_rung
        run.trial <- 0
        run.scored_count <- 0
        run.passed_count <- 0
        run.best_rung <- 0
        run.think_left <- run.think_capacity
        run.forfeits <- 0

    def next_trial(run: mutable Run&):
        can Abort.Panic:
            clear_trial(run)
            if run.trial >= run.trials:
                run.phase <- FINISHED
                return
            seed: i64 = py_randbelow(&run.rng, 1073741824.u64()).i64()
            Triage::deal(run.rung, seed, &run.dealt)
            Triage::reset(&run.dealt, &run.play)
            run.par <- Triage::par(&run.dealt)
            run.trial <- run.trial + 1
            run.phase <- PLAYING

    def start(run: mutable Run&) -> bool:
        can Abort.Panic:
            return false if run.phase != READY and run.phase != FINISHED
            reset(run)
            next_trial(run)
            return true

    def judge(run: mutable Run&, now_ms: i64):
        run.scored_count <- run.scored_count + 1
        run.passed <- run.play.value.f64() >= run.par - 0.000000001
        if run.passed:
            run.passed_count <- run.passed_count + 1
            run.best_rung <- run.rung if run.rung > run.best_rung
        if run.adaptive:
            if run.passed:
                run.rung <- run.rung + 1 if run.rung < 9223372036854775807
            elif run.rung > 1:
                run.rung <- run.rung - 1
        run.deadline_ms <- now_ms + FEEDBACK_MS
        run.phase <- JUDGED

    def steer(run: mutable Run&, port: i64, now_ms: i64) -> bool:
        can Abort.Panic:
            return start(run) if port == START
            return false if run.phase != PLAYING
            if port == FLAG:
                run.phase <- FLAGGED
                run.think_left <- 0.0
                run.forfeits <- run.forfeits + 1
                return true
            return false if port < 0 or port > DONE
            kind: i64 = Triage::OPEN if port < FIRST_SWAP else (Triage::SWAP if port < DONE else Triage::DONE)
            index: i64 = port - FIRST_SWAP if kind == Triage::SWAP else port
            return false if not Triage::apply(&run.dealt, &run.play, Triage::Move{kind: kind, at: index})
            if Triage::over(&run.dealt, &run.play):
                judge(run, now_ms)
            return true

    def advance(run: mutable Run&, now_ms: i64) -> bool:
        can Abort.Panic:
            return false if run.phase != FLAGGED and (run.phase != JUDGED or now_ms < run.deadline_ms)
            next_trial(run)
            return true

    def configure_think(run: mutable Run&, capacity: f64, refill: f64) -> bool:
        return false if run.phase != READY or not (capacity >= 0.0 and capacity <= 1.7976931348623157e308)
        return false if not (refill >= 0.0 and refill <= 1.7976931348623157e308)
        run.think_capacity <- capacity
        run.think_refill <- refill if refill < capacity else capacity
        run.think_left <- capacity
        return true

    # A stepped host publishes one frame per call. The verdict survives the
    # first call after grading and the next call deals without a wall-clock wait.
    def step(run: mutable Run&, elapsed_seconds: f64) -> bool:
        can Abort.Panic:
            return false if not (elapsed_seconds > 0.0 and elapsed_seconds <= 1.7976931348623157e308)
            if run.phase == PLAYING:
                if run.think_capacity > 0.0:
                    run.think_left <- run.think_left - elapsed_seconds
                    if run.think_left <= 0.000000001:
                        return steer(run, FLAG, 0)
                return true
            if run.phase == JUDGED and not run.verdict_published:
                run.verdict_published <- true
                return true
            if run.phase == JUDGED or run.phase == FLAGGED:
                next_trial(run)
                if run.phase == PLAYING:
                    room: f64 = run.think_capacity - run.think_left
                    run.think_left <- run.think_left + (run.think_refill if run.think_refill < room else room)
                return true
            return false
