include "./crossroads.elisa"

module CrossroadsGame:
    const READY: i64 = 0
    const PLAYING: i64 = 1
    const JUDGED: i64 = 2
    const DONE: i64 = 3
    const START: i64 = Crossroads::PORTS
    const FEEDBACK_MS: i64 = 3000

    struct Session:
        rng: mutable MT19937
        owner: mutable Arena
        start_rung: i64
        total: i64
        adaptive: bool
        rung: mutable i64
        trial: mutable i64
        phase: mutable i64
        traffic: mutable Crossroads::Run
        wins: mutable i64
        best_rung: mutable i64
        verdict: mutable i64
        verdict_served: mutable i64
        deadline_ms: mutable i64
        last_ms: mutable i64
        agent_seconds: mutable f64

    def allowed_rung(rung: i64) -> bool:
        return rung == 1 or rung == 4 or rung == 7 or rung == 10 or rung == 13 or rung == 16 or rung == 20 or rung == 25 or rung == 30

    def allowed_total(total: i64) -> bool:
        return total == 1 or total == 3 or total == 5 or total == 10 or total == 20

    def initialize(rung: i64, total: i64, adaptive: bool, seed: i64) -> Session:
        can Abort.Panic:
            rng: mutable MT19937 = zeroed
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            initial: i64 = rung if rung > 0 else 1
            return Session{rng: rng, owner: zeroed, start_rung: initial, total: total, adaptive: adaptive,
                rung: initial, trial: 0, phase: READY, traffic: zeroed, wins: 0, best_rung: 0,
                verdict: Crossroads::LIVE, verdict_served: 0, deadline_ms: 0, last_ms: 0, agent_seconds: 0.0}

    def close(session: mutable Session&):
        can Abort.Panic, Memory.Release:
            arena_free(&session.owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}
            session.traffic <- zeroed
            session.phase <- READY

    def deal_owned(owner: mutable Arena&, rung: i64, rng: mutable MT19937&) -> Crossroads::Run:
        can Abort.Panic, Memory.Allocate:
            in owner:
                town: Crossroads::Town = Crossroads::deal(rung, rng)
                return Crossroads::initialize(&town)

    def reconfigure(session: mutable Session&, rung: i64, total: i64, adaptive: bool) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if session.phase != READY and session.phase != DONE
            return false if not allowed_rung(rung) or not allowed_total(total)
            rng: MT19937 = session.rng
            close(session) can Global{Read,Write}
            session[0] <- initialize(rung, total, adaptive, 0)
            session.rng <- rng
            return true

    def next_trial(session: mutable Session&, now_ms: i64):
        can Abort.Panic, Memory.Allocate, Memory.Release:
            close(session) can Global{Read,Write}
            session.last_ms <- now_ms
            if session.trial >= session.total:
                session.phase <- DONE
                return
            session.traffic <- deal_owned(&session.owner, session.rung, &session.rng)
            session.trial <- session.trial + 1
            session.verdict <- Crossroads::LIVE
            session.verdict_served <- 0
            session.phase <- PLAYING

    def input(session: mutable Session&, port: i64, now_ms: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if now_ms < session.last_ms or now_ms > 9007199254740991
            if port == START:
                return false if session.total <= 0 or (session.phase != READY and session.phase != DONE)
                session.rung <- session.start_rung
                session.trial <- 0
                session.wins <- 0
                session.best_rung <- 0
                next_trial(session, now_ms) can Global{Read,Write}
                return true
            return false if session.phase != PLAYING
            return Crossroads::toggle(&session.traffic, port)

    def judge(session: mutable Session&, now_ms: i64):
        can Abort.Panic:
            session.verdict <- session.traffic.result
            session.verdict_served <- session.traffic.served
            passed: bool = session.verdict == Crossroads::CLEAR
            if passed:
                session.wins <- session.wins + 1
                session.best_rung <- session.rung if session.rung > session.best_rung
            if session.adaptive:
                session.rung <- session.rung + 1 if passed and session.rung < 9223372036854775807
                session.rung <- session.rung - 1 if not passed and session.rung > 1
            session.deadline_ms <- now_ms + FEEDBACK_MS
            session.phase <- JUDGED

    def advance(session: mutable Session&, now_ms: i64, dt: f64, stepped: bool = false) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if now_ms < session.last_ms or now_ms > 9007199254740991
            return false if not (dt >= 0.0 and dt <= 9007199254740.0)
            if session.phase == JUDGED:
                return false if not stepped and now_ms < session.deadline_ms
                next_trial(session, now_ms) can Global{Read,Write}
                return true
            return false if session.phase != PLAYING
            session.last_ms <- now_ms
            elapsed: f64 = fmin(dt, 0.1)
            substeps: i64 = fmax(1.0, ceil(elapsed / (1.0 / 60.0))).i64()
            quantum: f64 = elapsed / substeps.f64()
            for _ in 0..<substeps |session, quantum|:
                _ = Crossroads::step(&session.traffic, quantum)
                break if session.traffic.result != Crossroads::LIVE
            if session.traffic.result != Crossroads::LIVE:
                judge(session, now_ms)
            return true

    def agent_event(session: mutable Session&, now: f64, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release:
            return false if not (now >= session.agent_seconds and now <= 9007199254740.0)
            now_ms: i64 = (now * 1000.0).i64()
            if port == START:
                changed: bool = input(session, port, now_ms) can Global{Read,Write}
                session.agent_seconds <- now if changed
                return changed
            return (input(session, port, now_ms) can Global{Read,Write}) if port >= 0 and port < START
            return false if port != -1
            changed: bool = advance(session, now_ms, now - session.agent_seconds, true) can Global{Read,Write}
            session.agent_seconds <- now if changed
            return changed

    def info(session: Session&, field: i64) -> i64:
        return session.phase if field == 0
        return session.rung if field == 1
        return session.trial if field == 2
        return session.total if field == 3
        return session.traffic.car_count if field == 4
        return session.traffic.next_arrival if field == 5
        return session.traffic.served if field == 6
        return session.verdict if field == 7
        return session.wins if field == 8
        return session.best_rung if field == 9
        return session.start_rung if field == 10
        return session.adaptive.i64() if field == 11
        return -1
