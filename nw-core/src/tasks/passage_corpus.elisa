include "./passages_seed.elisa"
include "./ints.elisa"
include "./crossword.elisa"
include "./crossword_lexicon.elisa"

extend PassageSeed:
    # The caller resolves the original lexicon cache's freshness. Rank is used
    # only for first-word capitalization, so clues need not be retained.
    def ranked_vocabulary(text: sview) -> Passages::Bank:
        can Memory.Allocate, Abort.Panic:
            words: mutable darray[Passages::Word] = []
            at: mutable i64 = 0
            size: i64 = sview_len(text).i64()
            while at < size |at, size, text, words|:
                row: CrosswordLexicon::CrosswordIndexRow = CrosswordLexicon::row_at(text, at, size)
                at <- row.next
                continue if not row.valid or row.rank > 60000 or row.word_length > 15
                word: mutable Passages::Word = zeroed
                for letter in row.word_at..<(row.word_at + row.word_length) |word, text|:
                    Passages::push_letter(&word, sview_at(text, letter.usize()).i64())
                words.push(word)
            rows: mutable darray[Passages::Row] = []
            rows.push(Passages::Row{start: 0, stop: words.count.i64()})
            return Passages::Bank{words: words, sentences: rows, passages: []}

    def from_cache(passage_text: sview, sentence_text: sview, lexicon_text: sview) -> Corpus:
        can Memory.Allocate, Abort.Panic:
            bank: Passages::Bank = Passages::read(passage_text, true) if sview_len(passage_text).i64() > 4096 else passages()
            source: Passages::Bank = Passages::read(sentence_text, false) if sview_len(sentence_text).i64() > 4096 else sentences()
            lexicon: Passages::Bank = ranked_vocabulary(lexicon_text) if sview_len(lexicon_text).i64() > 0 else vocabulary()
            return corpus(bank, source, lexicon)
