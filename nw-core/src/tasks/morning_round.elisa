include "../pyrandom.elisa"
include "../pymath.elisa"

module MorningRound:
    const LEFT: i64 = 0
    const RIGHT: i64 = 1
    const FASTER: i64 = 2
    const SLOWER: i64 = 3
    const THROW_L: i64 = 4
    const THROW_R: i64 = 5
    const PORTS: i64 = 6

    const MARKED: i64 = 0
    const TOLD: i64 = 1
    const SIGN: i64 = 2
    const HIDDEN: i64 = 3

    const CONE: i64 = 0
    const BIN: i64 = 1
    const CAR: i64 = 2
    const CYCLIST: i64 = 3

    const ROAD_LEFT: f64 = 490.0
    const ROAD_RIGHT: f64 = 710.0
    const LANE_LEFT: f64 = 508.0
    const LANE_RIGHT: f64 = 692.0
    const SPACING: f64 = 150.0
    const STAGGER: f64 = SPACING / 2.0
    const CROSSING: f64 = 170.0
    const FIRST: f64 = 330.0

    struct Grade:
        rung: i64
        mode: i64
        deck: i64
        atoms: i64
        pool: i64
        state: bool
        blocks: i64
        houses: i64
        speed: f64
        clutter: f64
        movers: bool
        memorise: bool
        brief: f64
        slack: i64

    struct House:
        i: i64
        side: i64
        k: i64
        d: f64
        block: i64
        door: i64
        number: i64
        pointed: bool
        dog: bool
        flag: bool
        lights: bool
        cat: bool
        sign: mutable bool

    struct Block:
        start: f64
        end: f64
        landmark: i64

    struct Layout:
        level: Grade
        houses: mutable House[96]
        blocks: Block[8]
        count: i64
        length: f64

    struct Thing:
        d: f64
        x: f64
        radius: f64
        kind: i64
        speed: f64

    struct Traffic:
        things: Thing[96]
        count: i64

    def cap(value: i64, upper: i64) -> i64:
        return value if value < upper else upper

    def grade(requested: i64) -> Grade:
        can Abort.Panic:
            rung: i64 = requested if requested > 1 else 1
            mode: i64 = MARKED if rung == 1 else (TOLD if rung < 5 else (SIGN if rung < 7 else HIDDEN))
            deck: i64 = 1 if rung < 5 else (2 if rung < 9 else (3 if rung < 13 else cap(3 + (rung - 12) / 4, 6)))
            atoms: i64 = 1 if rung < 4 else (2 if rung < 13 else cap(2 + (rung - 11) / 4, 9))
            pool: i64 = 13 if rung >= 12 else (12 if rung >= 9 else 9)
            blocks: i64 = 1 if rung < 5 else (2 if rung < 6 else (3 if rung < 12 else cap(4 + (rung - 12) / 4, 8)))
            early: f64[4] = [100.0, 115.0, 125.0, 135.0]
            speed: f64 = early[(rung - 1).usize()] if rung < 5 else fmin(520.0, 140.0 + 9.0 * (rung - 5).f64())
            hidden_turns: i64 = blocks - 1 if mode == HIDDEN else 0
            return Grade{rung: rung, mode: mode, deck: deck, atoms: atoms, pool: pool,
                state: rung >= 10, blocks: blocks, houses: 6 if rung < 13 else 5, speed: speed,
                clutter: 0.0 if rung < 3 else fmin(0.9, 0.15 + 0.04 * (rung - 3).f64()),
                movers: rung >= 8, memorise: rung >= 11, brief: 2.0 if rung < 11 else fmax(3.0, 14.0 - 0.25 * (rung - 11).f64()),
                slack: (2 if rung < 3 else 1) + 2 * hidden_turns}

    def draw_house(index: i64, side: i64, k: i64, d: f64, block: i64, number: i64, rng: mutable MT19937&) -> House:
        can Abort.Panic:
            door: i64 = py_choice_index(rng, 4)
            pointed: bool = py_random(rng) < 0.5
            dog: bool = py_random(rng) < 0.4
            flag: bool = py_random(rng) < 0.5
            lights: bool = py_random(rng) < 0.5
            cat: bool = py_random(rng) < 0.4
            return House{i: index, side: side, k: k, d: d, block: block, door: door, number: number,
                pointed: pointed, dog: dog, flag: flag, lights: lights, cat: cat, sign: false}

    def layout(level: Grade, rng: mutable MT19937&) -> Layout:
        can Abort.Panic:
            houses: mutable House[96] = zeroed
            blocks: mutable Block[8] = zeroed
            origins: mutable f64[8] = zeroed
            d: mutable f64 = FIRST
            start_left: i64 = py_randrange(rng, 1, 40) * 2 - 1
            start_right: i64 = start_left + 1 + 2 * py_randrange(rng, 0, 3)
            for b in 0..<level.blocks |houses, origins, d, rng, level, start_left, start_right|:
                origins[b.usize()] <- d
                for j in 0..<level.houses |houses, d, rng, level, start_left, start_right, b|:
                    k: i64 = b * level.houses + j
                    at: f64 = d + SPACING * j.f64()
                    houses[(2 * k).usize()] <- draw_house(2 * k, -1, k, at, b, start_left + 2 * k, rng)
                    houses[(2 * k + 1).usize()] <- draw_house(2 * k + 1, 1, k, at + STAGGER, b, start_right + 2 * k, rng)
                d <- d + level.houses.f64() * SPACING
                d <- d + CROSSING
            for b in 0..<level.blocks |blocks, origins, level, rng|:
                origin: f64 = origins[b.usize()]
                end: f64 = origin + level.houses.f64() * SPACING - SPACING / 2.0 + STAGGER
                blocks[b.usize()] <- Block{start: origin - SPACING / 2.0, end: end, landmark: py_choice_index(rng, 4)}
            return Layout{level: level, houses: houses, blocks: blocks, count: 2 * level.houses * level.blocks,
                length: d - CROSSING + 200.0}

    def traffic(level: Grade, length: f64, rng: mutable MT19937&) -> Traffic:
        can Abort.Panic:
            things: mutable Thing[96] = zeroed
            count: mutable i64 = 0
            d: mutable f64 = FIRST + 120.0
            for _ in 0..<(level.clutter * length / SPACING).i64() |things, count, d, rng, level, length|:
                d <- d + py_uniform(rng, 170.0, 320.0)
                break if d > length - 150.0
                if level.movers and py_random(rng) < 0.3:
                    x: f64 = py_uniform(rng, LANE_LEFT, LANE_RIGHT)
                    speed: f64 = py_uniform(rng, 40.0, 90.0)
                    things[count.usize()] <- Thing{d: d + level.speed * 2.5, x: x, radius: 14.0, kind: CYCLIST, speed: speed}
                else:
                    kind: i64 = py_choice_index(rng, 3)
                    if kind == CAR:
                        x: f64 = ROAD_LEFT + 26.0 if py_choice_index(rng, 2) == 0 else ROAD_RIGHT - 26.0
                        things[count.usize()] <- Thing{d: d, x: x, radius: 26.0, kind: kind, speed: 0.0}
                    else:
                        x: f64 = py_uniform(rng, LANE_LEFT + 20.0, LANE_RIGHT - 20.0)
                        things[count.usize()] <- Thing{d: d, x: x, radius: 12.0, kind: kind, speed: 0.0}
                count <- count + 1
            return Traffic{things: things, count: count}
