include "./crane.elisa"

module CraneReference:
    struct Pilot:
        owed: mutable f64

    struct Gain:
        length: f64
        position: f64
        velocity: f64
        angle: f64
        swing: f64

    def gains(length: f64) -> Gain:
        can Abort.Panic:
            table: Gain[7] = [
                Gain{length: 2.0, position: 0.57, velocity: 1.271, angle: -1.169, swing: -0.662},
                Gain{length: 4.0, position: 0.57, velocity: 1.35, angle: -1.793, swing: -0.586},
                Gain{length: 6.0, position: 0.57, velocity: 1.427, angle: -2.475, swing: -0.301},
                Gain{length: 9.0, position: 0.57, velocity: 1.527, angle: -3.308, swing: 0.626},
                Gain{length: 12.0, position: 0.57, velocity: 1.611, angle: -3.839, swing: 2.084},
                Gain{length: 16.0, position: 0.571, velocity: 1.702, angle: -4.131, swing: 4.684},
                Gain{length: 21.0, position: 0.571, velocity: 1.792, angle: -3.97, swing: 8.736}]
            for i in 1..<7 |length, table|:
                b: Gain = table[i.usize()]
                if length <= b.length:
                    a: Gain = table[(i - 1).usize()]
                    f: f64 = fmax(0.0, (length - a.length) / (b.length - a.length))
                    return Gain{length: length, position: a.position + (b.position - a.position) * f,
                        velocity: a.velocity + (b.velocity - a.velocity) * f,
                        angle: a.angle + (b.angle - a.angle) * f, swing: a.swing + (b.swing - a.swing) * f}
            return table[6]

    def bay_for(run: Crane::Run&, colour: i64) -> i64:
        can Abort.Panic:
            for i in 0..<run.yard.bay_count |run, colour|:
                return i if run.yard.bays[i.usize()].colour == colour
            return Crane::NEUTRAL

    def next_box(run: Crane::Run&) -> i64:
        can Abort.Panic:
            # The Python dictionary visits ship stacks in their insertion order.
            for i in 0..<run.yard.level.boxes |run|:
                box: Crane::Box = run.yard.boxes[i.usize()]
                top: i64 = Crane::top_box(run, box.column)
                return top if top >= 0
            return Crane::NEUTRAL

    def cruise(run: Crane::Run&) -> f64:
        can Abort.Panic:
            # The reference samples half-unit points along the yard. Every
            # obstacle's horizontal span contains at least one sample.
            top: mutable f64 = fmax(run.yard.level.wall, Crane::DECK + Crane::roll(run))
            for i in 0..<run.yard.level.boxes |run, top|:
                if run.location[i.usize()] != Crane::HELD:
                    at: Crane::Position = Crane::box_rect(run, i)
                    top <- fmax(top, at.y + Crane::BOX_H)
            room: f64 = Crane::RAIL - top - 1.0 - (Crane::BOX_H if run.held >= 0 else 0.0)
            return fmax(2.0, fmin(room, 7.0))

    def drive(pilot: mutable Pilot&, run: Crane::Run&, target: f64, lean: f64) -> i64:
        can Abort.Panic:
            k: Gain = gains(run.cable)
            offset: f64 = fmax(-14.0, fmin(14.0, run.x + run.cable * sin(lean) - target))
            wanted: f64 = -(k.position * offset + k.velocity * run.v + k.angle * (run.theta - lean) + k.swing * run.omega)
            owed: f64 = pilot.owed * 0.98 + wanted
            best: mutable i64 = Crane::LEFT
            best_accel: mutable f64 = Crane::acceleration(run, best)
            for port in [Crane::NEUTRAL, Crane::RIGHT] |run, owed, best, best_accel|:
                accel: f64 = Crane::acceleration(run, port)
                if fabs(accel - owed) < fabs(best_accel - owed):
                    best <- port
                    best_accel <- accel
            pilot.owed <- owed - best_accel
            return best

    def choose(pilot: mutable Pilot&, run: Crane::Run&) -> i64:
        can Abort.Panic:
            return Crane::NEUTRAL if run.result != Crane::LIVE
            target: mutable Crane::Position = zeroed
            if run.held == Crane::NEUTRAL:
                next: i64 = next_box(run)
                return Crane::NEUTRAL if next < 0
                box: Crane::Position = Crane::box_rect(run, next)
                target <- Crane::Position{x: box.x, y: box.y + Crane::BOX_H}
            else:
                bay: i64 = bay_for(run, run.yard.boxes[run.held.usize()].colour)
                return Crane::NEUTRAL if bay < 0
                x: f64 = run.yard.bays[bay.usize()].x
                target <- Crane::Position{x: x, y: Crane::surface(run, x) + Crane::BOX_H}
            tip: Crane::Position = Crane::hook(run)
            speed: Crane::Position = Crane::velocity(run)
            off: f64 = fabs(target.x - tip.x)
            lean: f64 = atan2(Crane::wind(run), Crane::G)
            sway: f64 = fabs(run.theta - lean) + fabs(run.omega) * 0.5
            return Crane::UP if off > 1.5 and run.cable > cruise(run) + 0.05
            return drive(pilot, run, target.x, lean) if off > 0.55 or fabs(speed.x) > 0.4 or sway > 0.1
            gap: f64 = tip.y - target.y
            ready: bool = run.t - run.last_grab > 0.2
            if run.held == Crane::NEUTRAL:
                return Crane::GRAB if gap <= 0.25 and ready and Crane::grabbable(run) >= 0
                return Crane::DOWN
            return Crane::DOWN if gap > 0.12
            return Crane::GRAB if ready else Crane::NEUTRAL

    def apply(run: mutable Crane::Run&, port: i64, dt: f64):
        can Abort.Panic:
            if port == Crane::GRAB:
                Crane::grab(run)
            Crane::step(run, dt, Crane::NEUTRAL if port == Crane::GRAB else port)

    def play(yard: Crane::Yard) -> bool:
        can Abort.Panic:
            run: mutable Crane::Run = Crane::start(yard)
            pilot: mutable Pilot = zeroed
            while run.result == Crane::LIVE |run, pilot|:
                port: i64 = choose(&pilot, &run)
                apply(&run, port, 1.0 / 60.0)
            return run.result == Crane::CLEAR

    def deal_seed(rung: i64, seed: i64) -> Crane::Yard:
        can Abort.Panic:
            rng: mutable MT19937 = zeroed
            magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
            mt_seed_int(&rng, magnitude)
            level: Crane::Grade = Crane::grade(rung)
            first: Crane::Yard = Crane::build(level, &rng)
            return first if play(first)
            for _ in 1..<20 |level, rng|:
                yard: Crane::Yard = Crane::build(level, &rng)
                return yard if play(yard)
            return first

    def deal(rung: i64, rng: mutable MT19937&) -> Crane::Yard:
        can Abort.Panic:
            return deal_seed(rung, py_randbelow(rng, 1073741824.u64()).i64())
