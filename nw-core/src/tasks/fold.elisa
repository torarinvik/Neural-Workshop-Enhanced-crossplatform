include "./mirror.elisa"

module Fold:
    const NONE: i64 = 0
    const ARROW: i64 = 1
    const TRIANGLE: i64 = 2
    const HALF: i64 = 3
    const TEE: i64 = 4
    const BAR: i64 = 5
    const DOT: i64 = 6
    const ELL: i64 = 7
    const FLAG: i64 = 8
    const PLAIN: i64 = 6
    const CROSS: i64 = 9
    const SWAP: i64 = 0
    const TURN: i64 = 1
    const REFLECT: i64 = 2

    struct Grade:
        rung: i64
        opposite: bool
        any_net: bool
        choices: i64
        colours: bool
        glyph_count: i64
        first_wrong: i64
        wrong_count: i64

    struct Frame:
        normal: i64
        right: i64
        up: i64

    struct Print:
        glyph: i64
        colour: i64
        quarter: i64

    struct Face:
        normal: i64
        up: i64
        glyph: i64
        colour: i64
        mirrored: bool

    struct Cube:
        faces: mutable Face[6]

    struct Option:
        cube: Cube
        turn: i64

    struct Puzzle:
        level: Grade
        net: i64
        marks: mutable Print[6]
        asked: mutable i64
        letters: mutable i64[4]
        cubes: mutable Option[6]
        answer: mutable i64

    def grade(rung: i64) -> Grade:
        r: i64 = rung if rung > 0 else 1
        choices: i64 = 3 if r >= 4 and r < 7 else (4 if r < 16 else (5 if r < 25 else 6))
        glyphs: i64 = 1 if r < 10 else (6 if r < 13 else (5 if r < 16 else (4 if r < 20 else 6)))
        return Grade{rung: r, opposite: r < 4, any_net: r >= 5 or (r >= 2 and r < 4),
            choices: choices, colours: r < 13, glyph_count: glyphs,
            first_wrong: SWAP if r < 16 else TURN, wrong_count: 0 if r < 4 else (1 if r < 10 else 2)}

    # The eleven canonical nets in Python sort order. Each cell is 10*x+y.
    # The order controls both which square starts the fold and the marking.
    def cells(net: i64) -> i64[6]:
        return [0, 1, 2, 11, 21, 31] if net == 0
        return [0, 1, 2, 12, 13, 14] if net == 1
        return [0, 1, 11, 12, 13, 21] if net == 2
        return [0, 1, 11, 12, 13, 22] if net == 3
        return [0, 1, 11, 12, 13, 23] if net == 4
        return [0, 1, 11, 12, 21, 31] if net == 5
        return [0, 1, 11, 12, 22, 23] if net == 6
        return [0, 1, 11, 21, 22, 31] if net == 7
        return [0, 1, 11, 21, 31, 32] if net == 8
        return [1, 10, 11, 12, 13, 21] if net == CROSS
        return [1, 10, 11, 12, 13, 22]

    def hinge(frame: Frame, edge: i64) -> Frame:
        n: i64 = frame.normal
        r: i64 = frame.right
        u: i64 = frame.up
        return Frame{normal: r, right: -n, up: u} if edge == 10
        return Frame{normal: -r, right: n, up: u} if edge == -10
        return Frame{normal: u, right: r, up: -n} if edge == 1
        return Frame{normal: -u, right: r, up: n}

    # Signed vectors 1, 2, 3 stand for +X,+Y,+Z, with their negatives
    # representing the opposite directions.
    def frames(net: i64) -> Frame[6]:
        can Abort.Panic:
            squares: i64[6] = cells(net)
            out: mutable Frame[6] = zeroed
            out[0] <- Frame{normal: 3, right: 1, up: 2}
            for _sweep in 0..<5 |out, squares|:
                for i in 0..<6 |out, squares|:
                    if out[i.usize()].normal == 0:
                        continue
                    frame: Frame = out[i.usize()]
                    origin: i64 = squares[i.usize()]
                    for j in 0..<6 |out, squares, origin, frame|:
                        edge: i64 = squares[j.usize()] - origin
                        if out[j.usize()].normal == 0 and (edge == 1 or edge == -1 or edge == 10 or edge == -10):
                            out[j.usize()] <- hinge(frame, edge)
            return out

    def turn_up(frame: Frame, quarter: i64) -> i64:
        return frame.up if quarter == 0 else (-frame.right if quarter == 1 else (-frame.up if quarter == 2 else frame.right))

    def get(cube: Cube&, normal: i64) -> i64:
        can Abort.Panic:
            for i in 0..<6 |cube, normal|:
                return i if cube.faces[i.usize()].normal == normal
            return -1

    def place(axis: i64, rotation: Mirror::Cube) -> i64:
        return (1 if axis == rotation.x else -1) if axis == rotation.x or axis == -rotation.x
        return (2 if axis == rotation.y else -2) if axis == rotation.y or axis == -rotation.y
        return 3 if axis == rotation.z else -3

    def symmetry(glyph: i64) -> i64:
        return 4 if glyph == NONE or glyph == DOT
        return 2 if glyph == BAR
        return 1

    def signature(cube: Cube&, rotation: Mirror::Cube) -> i64:
        can Abort.Panic:
            signature: mutable i64 = 0
            for i in 0..<6 |cube, rotation, signature|:
                face: Face = cube.faces[i.usize()]
                normal: i64 = place(face.normal, rotation)
                if normal > 0:
                    up: mutable i64 = place(face.up, rotation)
                    kind: i64 = symmetry(face.glyph)
                    up <- 0 if kind == 4
                    up <- -up if kind == 2 and up < 0
                    mirrored: i64 = 1 if face.mirrored and (face.glyph == ELL or face.glyph == FLAG) else 0
                    mark: i64 = (((face.glyph * 7 + face.colour) * 7 + up + 3) * 2 + mirrored)
                    signature <- signature | (mark << ((normal - 1) * 10))
            return signature

    def absolute(axis: i64) -> i64:
        return -axis if axis < 0 else axis

    def perpendicular(rng: mutable MT19937&, normal: i64) -> i64:
        can Abort.Panic:
            axes: i64[6] = [1, 2, 3, -1, -2, -3]
            rank: mutable i64 = py_randbelow(rng, 4.u64()).i64()
            for i in 0..<6 |axes, normal, rank|:
                axis: i64 = axes[i.usize()]
                if absolute(axis) != absolute(normal):
                    return axis if rank == 0
                    rank <- rank - 1
            return 0

    def cross(up: i64, normal: i64) -> i64:
        a: i64 = absolute(up)
        b: i64 = absolute(normal)
        right: i64 = 6 - a - b
        positive: bool = b == a % 3 + 1
        return right if positive == ((up > 0) == (normal > 0)) else -right

    def reflected(axis: i64) -> i64:
        return -axis if absolute(axis) == 1 else axis

    def wrong(rng: mutable MT19937&, truth: Cube, how: i64) -> Cube:
        can Abort.Panic:
            out: mutable Cube = truth
            if how == REFLECT:
                for i in 0..<6 |out|:
                    face: Face = out.faces[i.usize()]
                    out.faces[i.usize()] <- Face{normal: reflected(face.normal), up: reflected(face.up),
                        glyph: face.glyph, colour: face.colour, mirrored: not face.mirrored}
                return out
            turnable: mutable i64[6] = zeroed
            count: mutable i64 = 0
            for i in 0..<6 |truth, turnable, count|:
                if symmetry(truth.faces[i.usize()].glyph) < 4:
                    turnable[count.usize()] <- i
                    count <- count + 1
            if how == TURN and count > 0:
                at: i64 = turnable[py_randbelow(rng, count.u64()).usize()]
                face: Face = truth.faces[at.usize()]
                right: i64 = cross(face.up, face.normal)
                turn: i64 = py_randbelow(rng, 3.u64()).i64()
                out.faces[at.usize()] <- Face{normal: face.normal, glyph: face.glyph, colour: face.colour,
                    up: right if turn == 0 else (-right if turn == 1 else -face.up), mirrored: face.mirrored}
                return out
            # Python samples sorted normals for a swap, while its rotation
            # candidate list keeps the original net order.
            order: i64[6] = [-1, -2, -3, 3, 2, 1]
            first: i64 = py_randbelow(rng, 6.u64()).i64()
            second: i64 = py_randbelow(rng, 5.u64()).i64()
            # sample() fills the first vacancy from the end of the pool.
            a: i64 = order[first.usize()]
            b: i64 = order[(5 if second == first else second).usize()]
            ia: i64 = get(&truth, a)
            ib: i64 = get(&truth, b)
            ma: Face = truth.faces[ia.usize()]
            mb: Face = truth.faces[ib.usize()]
            ua: i64 = perpendicular(rng, a)
            ub: i64 = perpendicular(rng, b)
            out.faces[ia.usize()] <- Face{normal: a, up: ua, glyph: mb.glyph, colour: mb.colour, mirrored: mb.mirrored}
            out.faces[ib.usize()] <- Face{normal: b, up: ub, glyph: ma.glyph, colour: ma.colour, mirrored: ma.mirrored}
            return out

    def has(values: i64&, count: i64, item: i64) -> bool:
        can Abort.Panic, Unsafe.PointerCast:
            for i in 0..<count |values, item|:
                return true if values[i.usize()] == item
            return false

    def deal(rung: i64, seed: i64) -> Puzzle:
        can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
            rng: mutable MT19937 = zeroed
            mt_seed_int(&rng, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
            level: Grade = grade(rung)
            net: i64 = py_randbelow(&rng, 11.u64()).i64() if level.any_net else CROSS
            folded: Frame[6] = frames(net)
            out: mutable Puzzle = Puzzle{level: level, net: net, marks: zeroed, asked: -1, letters: zeroed, cubes: zeroed, answer: 0}
            colours: mutable darray[i64] = [0, 1, 2, 3, 4, 5]
            py_shuffle_i64(&rng, &colours)
            truth: mutable Cube = zeroed
            for i in 0..<6 |rng, colours, level, folded, out, truth|:
                pick: i64 = py_randbelow(&rng, level.glyph_count.u64()).i64()
                glyph: i64 = NONE if level.rung < 10 else (ELL + pick - 4 if level.rung >= 20 and pick >= 4 else ARROW + pick)
                colour: i64 = colours[i.usize()] if level.colours else PLAIN
                quarter: i64 = py_randbelow(&rng, 4.u64()).i64()
                frame: Frame = folded[i.usize()]
                out.marks[i.usize()] <- Print{glyph: glyph, colour: colour, quarter: quarter}
                truth.faces[i.usize()] <- Face{normal: frame.normal, up: turn_up(frame, quarter), glyph: glyph, colour: colour, mirrored: false}
            if level.opposite:
                out.asked <- py_randbelow(&rng, 6.u64()).i64()
                opposite: i64 = get(&truth, -folded[out.asked.usize()].normal)
                picks: mutable darray[i64] = []
                for i in 0..<6 |out, picks, opposite|:
                    if i != out.asked and i != opposite:
                        picks.push(i)
                py_shuffle_i64(&rng, &picks)
                out.answer <- py_randbelow(&rng, 4.u64()).i64()
                for i in 0..<4 |picks, out, opposite|:
                    out.letters[i.usize()] <- opposite if i == out.answer else picks[(i - (1 if i > out.answer else 0)).usize()]
                return out
            turns: Mirror::Turns = Mirror::grid_turns()
            views: mutable i64[24] = zeroed
            for i in 0..<24 |views, truth, turns|:
                views[i.usize()] <- signature(&truth, turns.rows[i.usize()])
            seen: mutable i64[6] = zeroed
            out.answer <- py_randbelow(&rng, level.choices.u64()).i64()
            for i in 0..<level.choices |rng, out, truth, level, turns, views, seen|:
                for attempt in 0..<400 |rng, out, truth, level, turns, views, seen, i|:
                    turn: i64 = py_randbelow(&rng, 24.u64()).i64()
                    correct: bool = i == out.answer
                    option: Cube = truth if correct else wrong(&rng, truth, level.first_wrong + py_randbelow(&rng, level.wrong_count.u64()).i64())
                    view: i64 = signature(&option, turns.rows[turn.usize()])
                    out.cubes[i.usize()] <- Option{cube: option, turn: turn}
                    if (correct == has(&views[0], 24, view) and not has(&seen[0], i, view)) or attempt == 399:
                        seen[i.usize()] <- view
                        break
            return out
