# What a menu ROW says, as opposed to where it sits.
#
# scene_menu.elisa lays rows out; this builds their text. The split matters
# because every menu screen in the game -- game mode, images, sounds, user,
# configuration, and one per task -- shares this formatting exactly, while the
# content differs. Porting it once is what makes a screen a table of names and
# value kinds rather than new code.
#
# The shape is Menu._label_text:
#
#     '%s: %7s' % (self.names[option].ljust(51), self.textify(value))
#
# so the name is padded to a fixed column, the value is right-aligned in seven,
# and a row with no value is just the name. A spacer row is empty.

module MenuText:
    const SPACER: i64 = 0
    const COMMAND: i64 = 1     # a row that acts, with no value column
    const BOOL: i64 = 2
    const INT: i64 = 3
    const TEXT: i64 = 4
    const PERCENT: i64 = 5     # PercentCycler: a fraction shown as %
    const ALL: i64 = 6         # AllCycler: zero means "no limit"

    const NAME_WIDTH: i64 = 51
    const VALUE_WIDTH: i64 = 7







# PercentCycler.__str__: two decimals out at the extremes, one in the middle,
# and the endpoints 0 and 1 are explicitly NOT extremes.
    def percent_places(fraction: f64) -> i64:
        can Abort.Panic:
            if fraction == 0.0 or fraction == 1.0:
                return 1
            if fraction < 0.1 or fraction > 0.9:
                return 2
            return 1

    def append_value(out: mutable dstr&, kind: i64, number: f64, text: sview):
        can Memory.Allocate, Abort.Panic:
            if kind == BOOL:
                # Menu.textify: True is 'Yes', False is 'No'.
                if number != 0.0:
                    dstr_append_cstr(out, "Yes")
                else:
                    dstr_append_cstr(out, "No")
            elif kind == INT:
                dstr_append_i64(out, number.i64())
            elif kind == TEXT:
                dstr_append_sview(out, text)
            elif kind == PERCENT:
                dstr_append_fixed(out, number * 100.0, percent_places(number))
                out.push(37.u8())
            elif kind == ALL:
                if number == 0.0:
                    dstr_append_cstr(out, "all")
                else:
                    dstr_append_i64(out, number.i64())

# One row's text, ready for scene_menu to place.
    def row_text(name: sview, kind: i64, number: f64, text: sview) -> dstr:
        can Memory.Allocate, Abort.Panic:
            out: mutable dstr = []
            if kind == SPACER:
                return out
            if kind == COMMAND:
                dstr_append_sview(&out, name)
                return out

            dstr_append_sview(&out, name)
            # ljust pads, and never truncates: a name longer than the column pushes
            # the value column right, which is what the original does too.
            dstr_append_spaces(&out, NAME_WIDTH - sview_len(name).i64())
            dstr_append_cstr(&out, ": ")

            rendered: mutable dstr = []
            append_value(&rendered, kind, number, text)
            dstr_append_spaces(&out, VALUE_WIDTH - rendered.count.i64())
            dstr_append_dstr(&out, rendered)
            return out

    # A screen's content: what each row says, before anything knows where it sits.
    struct Row:
        name: sview
        kind: i64
        number: f64
        text: sview

    # The constructor overload is defined, but callers use the BRACE form: a struct
    # with an sview field does not get its overload recognised, and the compiler
    # reads `Row(...)` as positional construction instead. See
    # repro/nw_ctor_overload_sview_field.elisa -- it is the view type, not the
    # module and not the arity.
    def Row(name: sview, kind: i64, number: f64, text: sview) -> Row:
        return Row{name: name, kind: kind, number: number, text: text}

    def spacer() -> Row:
        return Row{name: "", kind: SPACER, number: 0.0, text: ""}
