# The Algebra screen: game state in, display list out.
#
# Port of neural_workshop/ui/algebra.py -- the drawing, not the thinking.
#
# Six labels and no shapes: a title, a status line, a note, the question, the
# working, and what has been typed. The three that move -- question, working,
# answer -- sit at fixed fractions of the room between the chrome and the
# verdict band, so the layout is three numbers and the rest is text.
#
# `search_line` is here because it is a SENTENCE about the puzzle rather than a
# fact about it: how many values the rung leaves standing, said three different
# ways depending on how big that is. The thousands separator and the
# half-to-even rounding are both CPython's and both matter -- `round(10 ** 1.5)`
# is 32, not 31, and `{:,}` puts commas in at three digits and not four.
#
# NOTE: needs elisacore_math, pymath, strings, geometry, verdict and display
# included by the driver.

module SceneAlgebra:

    const PHASE_READY: i64 = 0
    const PHASE_WORKING: i64 = 1
    const PHASE_JUDGED: i64 = 2
    const PHASE_DONE: i64 = 3

    def color_mine() -> u32:
        return Display::rgba(0, 114, 178, 255)

    struct Paint:
        ink: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> Paint:
        back: i64 = 0 if black_background else 255
        fore: i64 = 255 - back
        return Paint{ink: Display::rgba(fore, fore, fore, 255),
                     width: width, height: height, sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: Paint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    struct Lines:
        asked: mutable f64
        working: mutable f64
        answer: mutable f64

    def lines_of(out: mutable Lines&, width: f64, height: f64):
        can Abort.Panic:
            top: f64 = Geometry::from_top_edge(height, 116.0).f64()
            bottom: f64 = Verdict::above_the_band(height, Geometry::from_bottom_edge(height, 52.0).f64()).f64()
            room: f64 = top - bottom
            tall: f64 = room if room > 60.0 else 60.0
            out.asked <- bottom + tall * 0.74
            out.working <- bottom + tall * 0.46
            out.answer <- bottom + tall * 0.16

    # `'{:,}'.format(value)` -- a comma every three digits from the right.
    def append_grouped(out: mutable dstr&, value: i64):
        can Memory.Allocate, Abort.Panic:
            digits: mutable dstr = []
            dstr_append_i64(&digits, value)
            span: i64 = digits.count.i64()
            for index in 0..<span |out, digits, span|:
                # A comma goes before a digit when the number of digits LEFT
                # after it is a multiple of three -- and never before the first.
                if index > 0 and (span - index) % 3 == 0:
                    out.push(44.u8())
                out.push(Bytes::at_ref(&digits, index))

    # How many values the rung leaves standing before any reasoning.
    def search_line(out: mutable dstr&, candidates: f64):
        can Memory.Allocate, Abort.Panic:
            if candidates < 1.5:
                dstr_append_cstr(out, "the answer is one of about ")
                dstr_append_i64(out, py_round_half_even(pow(10.0, candidates)))
                return
            if candidates < 5.0:
                dstr_append_cstr(out, "the answer is one of about ")
                # `int(round(10 ** size))` -- rounded half to even FIRST and
                # then truncated, which for an already-integral value is exact.
                append_grouped(out, py_round_half_even(pow(10.0, candidates)))
                return
            dstr_append_cstr(out, "the answer is one of about 10^")
            dstr_append_i64(out, py_round_half_even(candidates))

    def render(list: mutable Display::DisplayList&, paint: Paint&, phase: i64,
               has_problem: bool, asked: sview, wants: sview, working: sview,
               typed: sview, candidates: f64, show_working: bool, trial: i64,
               total_trials: i64, message: sview):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()
            where: mutable Lines = Lines{asked: 0.0, working: 0.0, answer: 0.0}
            lines_of(&where, paint.width, paint.height)
            showing: bool = has_problem and (phase == PHASE_WORKING or phase == PHASE_JUDGED)

            put_text(list, paint, sview("Algebra", 0, -1), middle,
                     Geometry::from_top_edge(paint.height, 34.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            status: mutable dstr = []
            dstr_append_sview(&status, message)
            if has_problem and phase == PHASE_WORKING:
                dstr_append_cstr(&status, "     question ")
                dstr_append_i64(&status, trial)
                dstr_append_cstr(&status, "/")
                dstr_append_i64(&status, total_trials)
            put_text(list, paint, bytes_view(status), middle,
                     Geometry::from_top_edge(paint.height, 64.0).f64(),
                     Geometry::calc_fontsize(paint.height, 13.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            note: mutable dstr = []
            if showing and phase == PHASE_WORKING:
                search_line(&note, candidates)
            put_text(list, paint, bytes_view(note), middle,
                     Geometry::from_top_edge(paint.height, 90.0).f64(),
                     Geometry::calc_fontsize(paint.height, 12.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            question: sview = asked if showing else sview("", 0, -1)
            put_text(list, paint, question, middle, where.asked,
                     Geometry::calc_fontsize(paint.height, 20.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            shown_working: mutable sview = sview("", 0, -1)
            if showing:
                if phase == PHASE_WORKING:
                    shown_working <- wants
                else:
                    shown_working <- working if show_working else sview("", 0, -1)
            put_text(list, paint, shown_working, middle, where.working,
                     Geometry::calc_fontsize(paint.height, 13.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            entry: mutable dstr = []
            if phase == PHASE_WORKING:
                dstr_append_sview(&entry, typed)
                entry.push(95.u8())
            if phase == PHASE_JUDGED:
                dstr_append_sview(&entry, typed)
            put_text(list, paint, bytes_view(entry), middle, where.answer,
                     Geometry::calc_fontsize(paint.height, 18.0), color_mine(),
                     Display::ANCHOR_CENTER_CENTER, false)

            put_text(list, paint,
                     sview("Esc: menu   Space: start   type the answer   Enter: check   O: options", 0, -1),
                     middle, Geometry::from_bottom_edge(paint.height, 24.0).f64(),
                     Geometry::calc_fontsize(paint.height, 11.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)
