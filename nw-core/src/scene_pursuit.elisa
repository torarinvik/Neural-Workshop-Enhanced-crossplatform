# The Pursuit screen: game state in, display list out.
#
# Port of neural_workshop/ui/pursuit.py -- the drawing, not the thinking.
#
# Three labels, a verdict and ONE glyph: the shape being chased, out of the
# same family Lookout deals from, which is why `scene_glyphrow.elisa` is its
# own module.
#
# The quarry's radius is its own and not the flock's: `scale_to_height` is
# applied to whatever radius the quarry currently has, floored at six pixels,
# so a shape that has just resized draws at its new size and not at a
# constant one.
#
# The status line joins on the adaptive multiplier as `x%.2f` -- two places
# always, so `x1.00` and not `x1.0`.
#
# NOTE: needs elisacore_math, strings, geometry, display, scene_verdict and
# scene_glyphrow included by the driver.

module ScenePursuit:

    const PHASE_READY: i64 = 0
    const PHASE_CHASING: i64 = 1
    const PHASE_FEEDBACK: i64 = 2
    const PHASE_DONE: i64 = 3

    struct Paint:
        ink: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> Paint:
        back: i64 = 0 if black_background else 255
        fore: i64 = 255 - back
        return Paint{ink: Display::rgba(fore, fore, fore, 255),
                     width: width, height: height, sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: Paint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    # `max(6.0, float(scale_to_height(quarry.radius)))`, and nought when there
    # is no quarry to take a radius from.
    def drawn_radius(height: f64, has_quarry: bool, radius: f64) -> f64:
        can Abort.Panic:
            if not has_quarry:
                return 0.0
            scaled: f64 = Geometry::scale_to_height(height, radius).f64()
            return scaled if scaled > 6.0 else 6.0

    def render(list: mutable Display::DisplayList&, paint: Paint&, phase: i64,
               has_quarry: bool, x: f64, y: f64, radius: f64, form: i64,
               color: i64, adaptive: bool, multiplier: f64, round: i64,
               total_rounds: i64, message: sview, verdict: i64,
               verdict_text: sview):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()
            chasing: bool = phase == PHASE_CHASING or phase == PHASE_FEEDBACK

            put_text(list, paint, sview("Pursuit", 0, -1), middle,
                     Geometry::from_top_edge(paint.height, 36.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            status: mutable dstr = []
            dstr_append_sview(&status, message)
            if chasing:
                dstr_append_cstr(&status, "     round ")
                dstr_append_i64(&status, round)
                dstr_append_cstr(&status, "/")
                dstr_append_i64(&status, total_rounds)
                if adaptive:
                    dstr_append_cstr(&status, "     x")
                    dstr_append_fixed(&status, multiplier, 2)
            put_text(list, paint, bytes_view(status), middle,
                     Geometry::from_top_edge(paint.height, 70.0).f64(),
                     Geometry::calc_fontsize(paint.height, 14.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            put_text(list, paint,
                     sview("Esc: task menu     Space: start     keep the mouse (or the arrows) on the shape     C: options", 0, -1),
                     middle, Geometry::from_bottom_edge(paint.height, 26.0).f64(),
                     Geometry::calc_fontsize(paint.height, 12.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            if verdict >= 0:
                SceneVerdict::put(list, paint.width, paint.height, paint.sx, paint.sy,
                                  verdict == 1, verdict_text, 60.0, 16.0)

            if has_quarry and chasing:
                SceneGlyphRow::put(list, form, x * paint.width, y * paint.height,
                                   drawn_radius(paint.height, true, radius),
                                   SceneGlyphRow::glyph_color(color),
                                   paint.sx, paint.sy)
