include "./tasks/nearer_game.elisa"
include "./nearer_view.elisa"
include "./display.elisa"
include "./strings.elisa"
include "./scene_verdict.elisa"

module SceneNearer:
    const LEFT: f64 = 27.36
    const WIDTH: f64 = 857.28
    const BOTTOM: f64 = 179.0
    const HEIGHT: f64 = 389.0
    const CX: f64 = 456.0
    const BUTTON_H: f64 = HEIGHT * 0.13
    const VIEW_H: f64 = HEIGHT * 0.84
    const CY: f64 = BOTTOM + HEIGHT - VIEW_H / 2.0
    const SCALE: f64 = VIEW_H / (2.0 * Nearer::HALF_H)
    const GAP: f64 = WIDTH * 0.012

    struct Buttons:
        left: f64
        width: f64

    def buttons(count: i64) -> Buttons:
        width: f64 = (WIDTH - GAP * (count - 1).f64()) / count.f64()
        capped: f64 = WIDTH * 0.3 if width > WIDTH * 0.3 else width
        return Buttons{left: CX - (capped * count.f64() + GAP * (count - 1).f64()) / 2.0, width: capped}

    def hit(run: NearerGame::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return NearerGame::START if run.phase == NearerGame::READY or run.phase == NearerGame::DONE
            return -1 if run.phase != NearerGame::PLAYING
            panel: Buttons = buttons(run.puzzle.count)
            if y >= BOTTOM and y <= BOTTOM + BUTTON_H:
                for port in 0..<run.puzzle.count |panel, x|:
                    left: f64 = panel.left + port.f64() * (panel.width + GAP)
                    return port if x >= left and x <= left + panel.width
            picture: NearerView::Picture = NearerView::scene(&run.puzzle, NearerGame::elapsed(run))
            return NearerView::hit(&picture, (x - CX) / SCALE, (y - CY) / SCALE)

    def mark(run: NearerGame::Run&, index: i64, ink: u32) -> u32:
        can Abort.Panic:
            return 0x3caa5aff if run.puzzle.level.order and NearerGame::picked(run, index) >= 0
            return ink if run.phase != NearerGame::JUDGED
            return 0x3caa5aff if not run.puzzle.level.order and index == run.puzzle.order[0]
            return 0xd6403aff if index == run.chosen
            return ink

    def order_text(run: NearerGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            for i in 0..<run.puzzle.count |run, out|:
                if i > 0:
                    dstr_append_cstr(out, " ")
                dstr_append_i64(out, run.puzzle.order[i.usize()] + 1)

    def judgement(run: NearerGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if not run.puzzle.level.order:
                dstr_append_cstr(out, "Right: " if run.passed else "No: ")
                dstr_append_i64(out, run.puzzle.order[0] + 1)
                dstr_append_cstr(out, " is nearest")
            elif run.passed:
                dstr_append_cstr(out, "Right: all ")
                dstr_append_i64(out, run.puzzle.count)
                dstr_append_cstr(out, " in order")
            else:
                dstr_append_cstr(out, "No: ")
                dstr_append_i64(out, run.chosen + 1)
                dstr_append_cstr(out, " is not next -- the order was ")
                order_text(run, out)

    def status_text(run: NearerGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == NearerGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif run.phase == NearerGame::DONE:
                dstr_append_i64(out, run.passed_count)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, run.trial)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, run.best_rung)
            elif run.phase == NearerGame::JUDGED:
                judgement(run, out)
            else:
                dstr_append_cstr(out, "Click them in order, nearest first" if run.puzzle.level.order else "Click the nearest one")

    def polygon(list: mutable Display::DisplayList&, shape: NearerView::Shape&, colour: u32, rim: f64):
        can Memory.Allocate, Abort.Panic:
            x: mutable f64 = 0.0
            y: mutable f64 = 0.0
            for i in 0..<shape.count |shape, x, y|:
                p: RoomsView::Point = shape.points[i.usize()]
                x <- x + p.x
                y <- y + p.y
            x <- x / shape.count.f64()
            y <- y / shape.count.f64()
            for i in 0..<shape.count |shape, x, y, list, colour, rim|:
                p: RoomsView::Point = shape.points[i.usize()]
                dx: f64 = (p.x - x) * SCALE
                dy: f64 = (p.y - y) * SCALE
                distance: f64 = py_hypot(dx, dy)
                shrink: f64 = (distance - rim) / distance if distance > rim else 0.0
                px: f64 = CX + x * SCALE + dx * shrink
                py: f64 = CY + y * SCALE + dy * shrink
                if i == 0:
                    Display::begin_polygon(list, shape.count, px, py, colour)
                Display::polygon_point(list, px, py)

    def board(list: mutable Display::DisplayList&, run: NearerGame::Run&, ink: u32, dark: bool):
        can Memory.Allocate, Abort.Panic:
            picture: NearerView::Picture = NearerView::scene(&run.puzzle, NearerGame::elapsed(run))
            Display::draw_rect(list, CX - Nearer::HALF_W * SCALE, CY - VIEW_H / 2.0,
                2.0 * Nearer::HALF_W * SCALE, VIEW_H, 0x1e222aff if dark else 0xe8ecf2ff)
            for i in 0..<picture.count |list, picture|:
                shape: NearerView::Shape& = &picture.shapes[i.usize()]
                if shape.port >= 0:
                    polygon(list, shape, 0x22242aff, 0.0)
                polygon(list, shape, shape.colour, 1.4 if shape.port >= 0 else 0.0)
            if run.puzzle.level.cue != Nearer::HIDING:
                for i in 0..<picture.visible_count |list, picture, run, ink|:
                    port: i64 = picture.front[i.usize()]
                    bounds: RoomsView::Bounds = picture.boxes[port.usize()]
                    label: mutable dstr = []
                    dstr_append_i64(&label, port + 1)
                    rank: i64 = NearerGame::picked(run, port)
                    if rank >= 0:
                        dstr_append_cstr(&label, " (")
                        dstr_append_i64(&label, rank + 1)
                        dstr_append_cstr(&label, ")")
                    Display::draw_text_weight(list, bytes_view(label), CX + SCALE * (bounds.left + bounds.right) / 2.0,
                        CY + SCALE * bounds.top + 4.0, 13.0, mark(run, port, ink), Display::ANCHOR_CENTER_BOTTOM, true)
            if run.phase == NearerGame::JUDGED and run.puzzle.level.order:
                label: mutable dstr = []
                dstr_append_cstr(&label, "nearest first: ")
                order_text(run, &label)
                Display::draw_text(list, bytes_view(label), CX, CY - VIEW_H / 2.0 + 6.0, 12.0, ink, Display::ANCHOR_CENTER_BOTTOM)

    def render(list: mutable Display::DisplayList&, run: NearerGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Which Is Nearer?", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "click an answer or press its number   Esc: menu", CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            status: mutable dstr = []
            status_text(run, &status)
            Display::draw_text(list, bytes_view(status), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if run.has_verdict:
                verdict: mutable dstr = []
                judgement(run, &verdict)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.passed, bytes_view(verdict), 60.0, 16.0)
            return if run.phase == NearerGame::READY or run.phase == NearerGame::DONE
            stats: mutable dstr = []
            dstr_append_cstr(&stats, "rung ")
            dstr_append_i64(&stats, run.rung)
            dstr_append_cstr(&stats, "  ")
            dstr_append_i64(&stats, run.trial)
            dstr_append_cstr(&stats, "/")
            dstr_append_i64(&stats, run.total)
            Display::draw_text(list, bytes_view(stats), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            panel: Buttons = buttons(run.puzzle.count)
            for i in 0..<run.puzzle.count |list, panel, run, ink, dark|:
                x: f64 = panel.left + i.f64() * (panel.width + GAP)
                border: u32 = mark(run, i, ink)
                thickness: f64 = 2.0 if border == ink else (4.0 if run.puzzle.level.order and NearerGame::picked(run, i) >= 0 else 5.0)
                Display::draw_rect(list, x, BOTTOM, panel.width, BUTTON_H, 0x2e323aff if dark else 0xe8ebf0ff)
                Display::draw_box(list, x, BOTTOM, panel.width, BUTTON_H, border, thickness)
                label: mutable dstr = []
                dstr_append_i64(&label, i + 1)
                Display::draw_text(list, bytes_view(label), x + panel.width / 2.0, BOTTOM + BUTTON_H / 2.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                swatch: f64 = BUTTON_H * 0.5
                swatch_x: f64 = x + BUTTON_H * 0.25
                swatch_y: f64 = BOTTOM + BUTTON_H * 0.25
                Display::draw_rect(list, swatch_x, swatch_y, swatch, swatch, Rooms::colour(run.puzzle.solids[i.usize()].colour))
                Display::draw_box(list, swatch_x, swatch_y, swatch, swatch, ink, 2.0)
            board(list, run, ink, dark)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Nearer::Grade = Nearer::grade(rung)
            cue: mutable cstr = "everything: size, floor, hiding"
            cue <- "where each stands on the floor" if level.cue == Nearer::FLOOR
            cue <- "shadows on the floor" if level.cue == Nearer::SHADOW
            cue <- "which hides which" if level.cue == Nearer::HIDING
            cue <- "motion parallax as the eye sways" if level.cue == Nearer::MOTION
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.count)
            dstr_append_cstr(out, " solids; the cue left is ")
            dstr_append_cstr(out, cue)
            dstr_append_cstr(out, ".  Nearest over next at least ")
            hundred: i64 = (level.ratio * 100.0 + 0.5).i64()
            dstr_append_i64(out, hundred / 100)
            dstr_append_cstr(out, ".")
            if hundred % 100 < 10:
                dstr_append_cstr(out, "0")
            dstr_append_i64(out, hundred % 100)
            dstr_append_cstr(out, ".")
            if level.order:
                dstr_append_cstr(out, "  Put them all in order.")
