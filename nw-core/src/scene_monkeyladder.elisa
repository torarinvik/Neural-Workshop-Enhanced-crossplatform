# The Monkey Ladder screen: game state in, display list out.
#
# Port of neural_workshop/ui/monkeyladder.py -- the drawing, not the thinking.
#
# A grid of tiles; the ones in the round's sequence light up and carry their
# order while they are shown, then go blank and are clicked back in that order.
# Everything on screen is a rectangle, a box or a number, so this is the
# simplest shape a task screen takes and a good place to read the pattern.
#
# The cursor ring "sits in the gap, OUTSIDE the tile, so it covers no fill
# pixels at any grid size" -- the reference's own comment, and the reason the
# ring's rectangle is grown by the gap and then shrunk by its own thickness
# rather than being inset from the tile.
#
# As with every scene here, layout is in PIXELS and the divide to reference
# space happens in `put_*`. See scene_removals.elisa for why the order of those
# two roundings is not free.
#
# NOTE: needs elisacore_math, strings, geometry and display included by the
# driver.

module SceneMonkeyLadder:

    const PHASE_READY: i64 = 0
    const PHASE_SHOW: i64 = 1
    const PHASE_INPUT: i64 = 2
    const PHASE_RESULT: i64 = 3

    const MOST_CELLS: i64 = 100

    struct MonkeyLadderPaint:
        ink: mutable u32
        black_background: mutable bool
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> MonkeyLadderPaint:
        back: i64 = 0 if black_background else 255
        fore: i64 = 255 - back
        return MonkeyLadderPaint{ink: Display::rgba(fore, fore, fore, 255),
                     black_background: black_background,
                     width: width, height: height, sx: sx, sy: sy}

    def put_rect(list: mutable Display::DisplayList&, paint: MonkeyLadderPaint&, x: f64,
                 y: f64, width: f64, height: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, x / paint.sx, y / paint.sy,
                               width / paint.sx, height / paint.sy, color)

    def put_box(list: mutable Display::DisplayList&, paint: MonkeyLadderPaint&, x: f64,
                y: f64, width: f64, height: f64, thick: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_box(list, x / paint.sx, y / paint.sy,
                              width / paint.sx, height / paint.sy, color,
                              thick / paint.sy)

    def put_text(list: mutable Display::DisplayList&, paint: MonkeyLadderPaint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    # --- the grid -------------------------------------------------------

    struct MonkeyLadderGrid:
        cell: mutable f64
        origin_x: mutable f64
        origin_y: mutable f64

    def layout_grid(out: mutable MonkeyLadderGrid&, width: f64, height: f64, grid: i64):
        can Abort.Panic:
            shorter: f64 = width if width < height else height
            size: f64 = shorter * 0.62
            out.cell <- size / grid.f64()
            out.origin_x <- (width - size) / 2.0
            # The ten is not a margin, it is the room the footnote wants: the
            # board is nudged UP off centre, not padded.
            out.origin_y <- (height - size) / 2.0 - 10.0

    # A cell's colour, in the reference's own order of precedence: the wrong
    # one first, then the ones already clicked, then the ones being shown.
    def cell_color(paint: MonkeyLadderPaint&, cell: i64, wrong: i64, clicked_upto: i64,
                   place: i64, phase: i64) -> u32:
        return Display::rgba(220, 64, 64, 255) if cell == wrong
        return Display::rgba(46, 170, 92, 255) if place >= 0 and place < clicked_upto
        return Display::rgba(64, 96, 255, 255) if phase == PHASE_SHOW and place >= 0
        return Display::rgba(36, 40, 52, 255) if paint.black_background
        return Display::rgba(228, 232, 240, 255)

    # Where a cell sits in the sequence, or -1 if it is not in it. The
    # reference builds `{cell: index + 1}` and asks `cell in numbers`; a linear
    # scan says the same thing for a sequence that is at most one hundred long,
    # and says it in the order the sequence was dealt.
    def place_of(sequence: mutable darray[i64]&, count: i64, cell: i64) -> i64:
        can Abort.Panic:
            for index in 0..<count |sequence, cell|:
                return index if Ints::at_ref(sequence, index) == cell
            return -1

    def render(list: mutable Display::DisplayList&, paint: MonkeyLadderPaint&,
               sequence: mutable darray[i64]&, count: i64, grid: i64,
               phase: i64, level: i64, clicked_upto: i64, wrong: i64,
               cursor_cell: i64, cursor_enabled: bool, reveal_answer: bool,
               message: sview):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()
            put_text(list, paint, sview("Monkey Ladder", 0, -1), middle,
                     Geometry::from_top_edge(paint.height, 36.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            # `'Length %d — %s' % (level, message)`, em dash and all.
            status: mutable dstr = []
            dstr_append_cstr(&status, "Length ")
            dstr_append_i64(&status, level)
            dstr_append_cstr(&status, " ")
            dstr_append_em_dash(&status)
            dstr_append_cstr(&status, " ")
            dstr_append_sview(&status, message)
            put_text(list, paint, bytes_view(status), middle,
                     Geometry::from_top_edge(paint.height, 70.0).f64(),
                     Geometry::calc_fontsize(paint.height, 14.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            put_text(list, paint,
                     sview("Esc: task menu     Space: next round     C: options", 0, -1),
                     middle, Geometry::from_bottom_edge(paint.height, 30.0).f64(),
                     Geometry::calc_fontsize(paint.height, 12.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            board: mutable MonkeyLadderGrid = MonkeyLadderGrid{cell: 0.0, origin_x: 0.0, origin_y: 0.0}
            layout_grid(&board, paint.width, paint.height, grid)
            raw_gap: i64 = (board.cell * 0.08).i64()
            gap: f64 = (raw_gap if raw_gap > 3 else 3).f64()
            show_numbers: bool = phase == PHASE_SHOW or (phase == PHASE_RESULT and reveal_answer)

            for row in 0..<grid |list, paint, board, gap, grid, sequence, count, phase, clicked_upto, wrong, cursor_cell, cursor_enabled, show_numbers|:
                for col in 0..<grid |list, paint, board, gap, grid, sequence, count, phase, clicked_upto, wrong, cursor_cell, cursor_enabled, show_numbers, row|:
                    cell: i64 = row * grid + col
                    x: f64 = board.origin_x + col.f64() * board.cell + gap
                    y: f64 = board.origin_y + row.f64() * board.cell + gap
                    side: f64 = board.cell - gap * 2.0
                    place: i64 = place_of(sequence, count, cell)
                    put_rect(list, paint, x, y, side, side,
                             cell_color(paint, cell, wrong, clicked_upto, place, phase))
                    if cursor_enabled and cell == cursor_cell:
                        raw_ring: i64 = (gap * 0.6).i64()
                        ring: f64 = (raw_ring if raw_ring > 2 else 2).f64()
                        put_box(list, paint, x - gap + ring / 2.0,
                                y - gap + ring / 2.0,
                                side + gap * 2.0 - ring, side + gap * 2.0 - ring,
                                ring, Display::rgba(255, 200, 40, 255))
                    if show_numbers and place >= 0:
                        text: mutable dstr = []
                        dstr_append_i64(&text, place + 1)
                        put_text(list, paint, bytes_view(text), x + side / 2.0,
                                 y + side / 2.0,
                                 Geometry::calc_fontsize(paint.height, 18.0),
                                 Display::rgba(255, 255, 255, 255),
                                 Display::ANCHOR_CENTER_CENTER, true)
