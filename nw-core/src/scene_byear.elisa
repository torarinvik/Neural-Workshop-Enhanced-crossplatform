include "./tasks/byear_game.elisa"
include "./scene_live_view.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./scene_lens.elisa"

# ui/byear.py: one octave of a keyboard, and nothing else to see. The keys do
# not light while the tune plays; a key pressed lights blue for a quarter of
# a second, a wrong one red once the try is over, and the first key of a
# shifted tune is lit gold once the tune has played. A dot a step of the tune
# above the keys, green for each played back.
module SceneByEar:
    const LEFT: f64 = (LiveView::WIDTH - LiveView::VIEW_WIDTH) / 2.0

    struct Key:
        x: f64
        y: f64
        w: f64
        h: f64
        black: bool

    def bottom() -> f64:
        can Abort.Panic:
            return Verdict::above_the_band(LiveView::HEIGHT, Geometry::from_bottom_edge(LiveView::HEIGHT, 58.0).f64()).f64()

    def height() -> f64:
        can Abort.Panic:
            return fmax(40.0, Geometry::from_top_edge(LiveView::HEIGHT, 116.0).f64() - bottom())

    def label(list: mutable Display::DisplayList&, text: sview, y: f64, size: f64, ink: u32, bold: bool = false):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, LiveView::CX, y, size, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def clip() -> SceneLens::Clip:
        can Abort.Panic:
            b: f64 = bottom()
            return SceneLens::Clip{x0: LEFT, y0: b, x1: LEFT + LiveView::VIEW_WIDTH, y1: b + height()}

    def white_index(k: i64) -> i64:
        white: i64[8] = [0, 2, 4, 5, 7, 9, 11, 12]
        for i in 0..<8 |white, k|:
            return i if white[i.usize()] == k
        return -1

    # ByEar._keys: key *k*'s rectangle.
    def key(k: i64) -> Key:
        can Abort.Panic:
            width: f64 = LiveView::VIEW_WIDTH
            tall: f64 = height()
            a: f64 = width * 0.9 / 8.0
            kw: f64 = 110.0 if 110.0 < a else a
            b: f64 = tall * 0.7
            kh: f64 = kw * 4.2 if kw * 4.2 < b else b
            x0: f64 = LEFT + (width - kw * 8.0) / 2.0
            y0: f64 = bottom() + (tall - kh) / 2.0
            i: i64 = white_index(k)
            return Key{x: x0 + i.f64() * kw, y: y0, w: kw, h: kh, black: false} if i >= 0
            j: i64 = white_index(k - 1)
            return Key{x: x0 + (j + 1).f64() * kw - kw * 0.3, y: y0 + kh * 0.38, w: kw * 0.6, h: kh * 0.62, black: true}

    def live(run: ByEar::Run&, k: i64) -> bool:
        can Abort.Panic:
            level: ByEar::Grade& = &run.tune.level
            for i in 0..<level.count |level, k|:
                return true if level.keys[i.usize()] == k
            return false

    # The key a click at (x, y) plays: the black keys are tried first, then
    # the white, and only keys in play; -1 for none.
    def hit(run: ByEar::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            order: i64[13] = [1, 3, 6, 8, 10, 0, 2, 4, 5, 7, 9, 11, 12]
            for n in 0..<13 |order, run, x, y|:
                k: i64 = order[n.usize()]
                r: Key = key(k)
                return k if live(run, k) and r.x <= x and x <= r.x + r.w and r.y <= y and y <= r.y + r.h
            return -1

    # ByEar._draw, without the frame's card.
    def view(list: mutable Display::DisplayList&, run: ByEar::Run&):
        can Memory.Allocate, Abort.Panic:
            cut: SceneLens::Clip = clip()
            order: i64[13] = [0, 2, 4, 5, 7, 9, 11, 12, 1, 3, 6, 8, 10]
            for n in 0..<13 |list, cut, order, run|:
                k: i64 = order[n.usize()]
                r: Key = key(k)
                on: bool = live(run, k)
                ink: mutable u32 = 0
                if r.black:
                    ink <- 0x282832ff if on else 0x5a5a64ff
                else:
                    ink <- 0xfafaf5ff if on else 0xaaaaafff
                ink <- 0xfad25aff if run.tune.lit == k and not ByEar::listening(run)
                recent: mutable bool = false
                bad: mutable bool = false
                for p in run.pressed |run, k, recent, bad|:
                    if p.key == k:
                        recent <- true if run.t - p.t < 0.25
                        bad <- true if not p.right
                ink <- 0x82c8faff if recent
                ink <- 0xe65a50ff if bad and run.result != ByEar::LIVE
                SceneLens::rect(list, cut, r.x, r.y, r.w, r.h, 0x14141aff)
                SceneLens::rect(list, cut, r.x + 2.0, r.y + 2.0, r.w - 4.0, r.h - 4.0, ink)
            steps: i64 = run.tune.level.length
            for i in 0..<steps |list, cut, run, steps|:
                ink: u32 = 0x6edc8cff if i < run.done else 0x5a6078ff
                x: f64 = LEFT + LiveView::VIEW_WIDTH / 2.0 + (i.f64() - (steps - 1).f64() / 2.0) * 22.0
                SceneLens::disc(list, cut, x, bottom() + height() - 24.0, 7.0, ink)

    def card(list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            frame: SceneLens::Clip = clip()
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: frame.x0 - 4.0, y: frame.y0 - 4.0,
                w: frame.x1 - frame.x0 + 8.0, h: frame.y1 - frame.y0 + 8.0}
            shades: u32[3] = [30.u32(), 18.u32(), 12.u32()]
            for i in 0..<3 |list, box, shades|:
                blur: f64 = i.f64() * 2.0
                shadow: SceneHiddenRule::Rect = ScenePolish::spread_box(&box, blur, 4.0)
                ScenePolish::rounded(list, &shadow, 14.0 + blur, shades[i.usize()])
            ScenePolish::rounded(list, &box, 14.0, 0x1e2230ff)

    def verdict_text(run: ByEar::Run&, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            n: i64 = run.tune.level.length
            if run.result == ByEar::PLAYED:
                dstr_append_cstr(words, "All ")
                dstr_append_i64(words, run.done)
                dstr_append_cstr(words, " played back")
            elif run.result == ByEar::WRONG or run.result == ByEar::SLOW:
                dstr_append_cstr(words, "A wrong note: " if run.result == ByEar::WRONG else "Too slow: ")
                dstr_append_i64(words, run.done)
                dstr_append_cstr(words, " of ")
                dstr_append_i64(words, n)
                dstr_append_cstr(words, " played")
            elif run.result == ByEar::APART:
                dstr_append_cstr(words, "Both notes of a pair, together")

    def render(list: mutable Display::DisplayList&, session: ByEarGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            run: ByEar::Run& = &session.run
            label(list, "By Ear", 648.0, 22.0, ink, true)
            label(list, "Click the keys, or A W S E D F T G Y H U J K   Esc: menu", 26.0, 12.0, ink)
            caption: mutable dstr = []
            verdict_text(run, &caption)
            status: mutable dstr = []
            if session.phase == ByEarGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == ByEarGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == ByEarGame::JUDGED:
                status <- caption
            elif session.listen_shown:
                dstr_append_cstr(&status, "Listen...")
            else:
                dstr_append_cstr(&status, "Play it back: ")
                dstr_append_i64(&status, run.done)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, run.tune.level.length)
            label(list, bytes_view(status), 614.0, 14.0, ink)
            if session.phase == ByEarGame::PLAYING or session.phase == ByEarGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   ")
                dstr_append_i64(&facts, run.tune.level.length)
                dstr_append_cstr(&facts, " notes")
                label(list, bytes_view(facts), 588.0, 12.0, ink)
                card(list)
                view(list, run)
            if session.phase == ByEarGame::JUDGED or session.phase == ByEarGame::DONE:
                SceneVerdict::put(list, LiveView::WIDTH, LiveView::HEIGHT, 1.0, 1.0, run.result == ByEar::PLAYED,
                    bytes_view(caption), 60.0, 16.0)

    # taskoptions.byear_note.
    def option_note(rung: i64, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: ByEar::Grade = ByEar::grade(rung)
            dstr_append_cstr(words, "Rung ")
            dstr_append_i64(words, level.rung)
            dstr_append_cstr(words, ": ")
            dstr_append_i64(words, level.length)
            dstr_append_cstr(words, " notes.")
            if level.shift:
                dstr_append_cstr(words, "  Play it from the lit key.")
            if level.pairs != 0.0:
                dstr_append_cstr(words, "  Some notes come in pairs.")
