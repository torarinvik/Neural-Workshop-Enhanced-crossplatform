include "scene_hidden_rule.elisa"

module ScenePolish:
    def rounded(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&, radius: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            r: f64 = SceneHiddenRule::minimum(radius, SceneHiddenRule::minimum(box.w, box.h) / 2.0 - 0.01)
            if r < 1.0:
                Display::draw_rect(list, box.x, box.y, box.w, box.h, color)
                return
            Display::begin_polygon(list, 24, box.x + box.w, box.y + box.h - r, color)
            for i in 0..<24 |list, box, r|:
                corner: i64 = i / 6
                angle: f64 = (corner * 90 + (i % 6) * 18).f64() * 0.017453292519943295
                cx: f64 = box.x + (box.w - r if corner == 0 or corner == 3 else r)
                cy: f64 = box.y + (box.h - r if corner < 2 else r)
                Display::polygon_point(list, cx + r * cos(angle), cy + r * sin(angle))

    def spread_box(box: SceneHiddenRule::Rect&, amount: f64, drop: f64 = 0.0) -> SceneHiddenRule::Rect:
        return SceneHiddenRule::Rect{x: box.x - amount, y: box.y - amount - drop,
            w: box.w + amount * 2.0, h: box.h + amount * 2.0}

    def shadow(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&,
               radius: f64, lift: f64, dark: bool):
        can Memory.Allocate, Abort.Panic:
            shadows: u32[3] = [0x00000037 if dark else 0x18223c11,
                0x00000021 if dark else 0x18223c0a, 0x00000016 if dark else 0x18223c06]
            for layer in 0..<3 |list, box, radius, lift, shadows|:
                spread: f64 = layer.f64() * lift * 0.5
                shade: SceneHiddenRule::Rect = spread_box(box, spread, lift)
                rounded(list, &shade, radius + spread, shadows[layer.usize()])

    def card_face(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&,
                  radius: f64, body: u32, edge: u32, ring: u32, dark: bool):
        can Memory.Allocate, Abort.Panic:
            if ring != 0.u32():
                pad: f64 = SceneHiddenRule::minimum(box.w, box.h) * 0.025
                spread: f64 = pad if pad > 3.0 else 3.0
                surround: SceneHiddenRule::Rect = spread_box(box, spread)
                rounded(list, &surround, radius + spread, ring)
            else:
                shadow(list, box, radius, 4.0, dark)
            if edge != 0.u32():
                border: SceneHiddenRule::Rect = spread_box(box, 1.0)
                rounded(list, &border, radius + 1.0, edge)
            rounded(list, box, radius, body)

    def ring(list: mutable Display::DisplayList&, x: f64, y: f64, r: f64, thick: f64, colour: u32, segments: i64):
        can Memory.Allocate, Abort.Panic:
            old_x: mutable f64 = x + r
            old_y: mutable f64 = y
            for i in 1..<(segments + 1) |list, x, y, r, thick, colour, segments, old_x, old_y|:
                angle: f64 = 6.283185307179586 * i.f64() / segments.f64()
                px: f64 = x + r * cos(angle)
                py: f64 = y + r * sin(angle)
                Display::draw_line(list, old_x, old_y, px, py, thick, colour)
                old_x <- px
                old_y <- py

    def mix_rgb(a: u32, b: u32, share: f64) -> u32:
        channel: u32 = 255.u32()
        ar: f64 = (a >> 24).f64()
        ag: f64 = ((a >> 16) & channel).f64()
        ab: f64 = ((a >> 8) & channel).f64()
        return Display::rgba(round_half_even(ar + ((b >> 24).f64() - ar) * share),
            round_half_even(ag + (((b >> 16) & channel).f64() - ag) * share),
            round_half_even(ab + (((b >> 8) & channel).f64() - ab) * share), 255)

    def glow(list: mutable Display::DisplayList&, x: f64, y: f64, r: f64, colour: u32, strength: i64):
        can Memory.Allocate, Abort.Panic:
            shares: f64[4] = [0.15, 0.25, 0.35, 0.5]
            for i in 0..<4 |list, x, y, r, colour, strength, shares|:
                alpha: u32 = (strength.f64() * shares[i.usize()]).u32()
                Display::draw_circle(list, x, y, r * (1.0 - i.f64() * 0.2), (colour & 0xffffff00.u32()) | alpha)

    def arc(list: mutable Display::DisplayList&, x: f64, y: f64, r: f64, start: f64, sweep: f64, thick: f64, colour: u32, segments: i64 = 32):
        can Memory.Allocate, Abort.Panic:
            old_x: mutable f64 = x + r * cos(start)
            old_y: mutable f64 = y + r * sin(start)
            for i in 1..<(segments + 1) |list, x, y, r, start, sweep, thick, colour, segments, old_x, old_y|:
                a: f64 = start + sweep * i.f64() / segments.f64()
                px: f64 = x + r * cos(a)
                py: f64 = y + r * sin(a)
                Display::draw_line(list, old_x, old_y, px, py, thick, colour)
                old_x <- px
                old_y <- py
