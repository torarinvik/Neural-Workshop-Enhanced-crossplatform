# The Python extension surface.
#
# Kept OUT of the core modules because `export pymodule` is a stage1-only
# feature: stage0 rejects the keyword, and every core module must compile with
# both compilers. Only build_pymodule.sh compiles this file.
#
# The runtime source is included the way wasm_exports.elisa and the sweeps
# include it, and for a reason that is not obvious: the stage1 backend can only
# lower the `sview_len`/`sview_at` builtins when the runtime's Elisa source is
# in the unit. Without the include it DECLINES every function that touches an
# sview -- display.elisa's Display::pool_intern, and with it Display::draw_text and Display::emit_marker --
# and a declined function is simply absent from the object, so the module links
# and then fails at import with a missing symbol. Including the source means the
# prebuilt runtime object must not be linked as well; build_pymodule.sh points
# ELISA_RUNTIME_OBJ at a small shim instead.
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "scheduling.elisa"
include "board.elisa"
include "grid.elisa"
include "timing.elisa"
include "constants.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "pyrandom.elisa"
include "gamemode.elisa"
include "session.elisa"
include "session_app.elisa"
include "strings.elisa"
include "geometry.elisa"
include "display.elisa"
include "decimal.elisa"
include "nback.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "pymath.elisa"
include "scene_nback.elisa"
include "scene_title.elisa"
include "scene_menu.elisa"
include "menu_model.elisa"
include "scene_menu_screen.elisa"
include "scene_field.elisa"
include "scene_hud.elisa"
include "hudtext.elisa"
include "readouttext.elisa"
include "trialuitext.elisa"
include "scene_readouts.elisa"
include "scene_trialui.elisa"
include "scene_batch.elisa"
include "taskhub_tasks.elisa"
include "textmetrics.elisa"
include "scene_taskhub.elisa"
include "scene_task.elisa"

# ------------------------------------------------------------
# Display-list frames
# ------------------------------------------------------------
#
# The wasm surface hands the shell a pointer into linear memory because JS can
# view that memory in place. CPython has no such view, so the natural shape
# here is the other one: return the encoded list BY VALUE as darray[u8], which
# the pymodule bridge converts to `bytes`. The shell gets an immutable object
# it can hold across frames, and nothing about buffer lifetime crosses the ABI.
#
# Note the contrast with the wasm path, which has to build the list in the
# AMBIENT region to dodge a wasm32 region-reuse bug. Natively the ordinary
# shape is correct: a fresh list per call, encoded and returned.
def nback_frame(trial: i64, nback: i64, position: i64, verdict: i64) -> darray[u8]:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        list: mutable Display::DisplayList = Display::DisplayList()
        render_nback_frame(&list, trial, nback, position, verdict)
        return Display::encode_binary(&list)

def nback_session_frame(trial: i64, nback: i64, seed: i64, mode: i64,
                        verdict: i64) -> darray[u8]:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        tables: ModeTables = ModeTables()
        preview: SessionApp::Preview = SessionApp::preview(&tables, seed, trial, mode, nback)
        list: mutable Display::DisplayList = Display::DisplayList()
        render_nback_frame(&list, trial, nback, preview.position, verdict)
        return Display::encode_binary(&list)

def batch_frame(trial: i64, nback: i64, seed: i64, mode: i64,
                black: i64, started: i64, hide_text: i64, paused: i64,
                grid_3d: i64, expanded: i64, gridlines: i64,
                old_style: i64, sharp_corners: i64, session_number: i64,
                verdict: i64, input_answer: i64) -> darray[u8]:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneBatch::render_batch_frame(&list, trial, nback, seed, mode,
            black != 0, started != 0, hide_text != 0, paused != 0,
            grid_3d != 0, expanded != 0, gridlines != 0,
            old_style != 0, sharp_corners != 0, session_number,
            verdict, input_answer)
        return Display::encode_binary(&list)

def title_frame(banner_code: i64, black_background: i64, jaeggi_mode: i64, clinical_mode: i64) -> darray[u8]:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        list: mutable Display::DisplayList = Display::DisplayList()
        render_title_frame_coded(&list, banner_code, black_background != 0, jaeggi_mode != 0, clinical_mode != 0)
        return Display::encode_binary(&list)

def taskhub_frame(category: i64, selected: i64, black_background: i64,
                  width: i64, height: i64) -> darray[u8]:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        canvas_width: f64 = width.f64()
        canvas_height: f64 = height.f64()
        sx: f64 = canvas_width / Display::REFERENCE_WIDTH
        sy: f64 = canvas_height / Display::REFERENCE_HEIGHT
        paint: SceneTaskHub::HubPaint = SceneTaskHub::paint_of(
            black_background != 0, canvas_width, canvas_height, sx, sy)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneTaskHub::render(&list, &paint, category, selected)
        return Display::encode_binary(&list)

def task_frame(category: i64, selected: i64, black_background: i64,
               started: i64, width: i64, height: i64) -> darray[u8]:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        canvas_width: f64 = width.f64()
        canvas_height: f64 = height.f64()
        sx: f64 = canvas_width / Display::REFERENCE_WIDTH
        sy: f64 = canvas_height / Display::REFERENCE_HEIGHT
        paint: SceneTask::TaskPaint = SceneTask::paint_of(
            black_background != 0, canvas_width, canvas_height, sx, sy)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneTask::render(&list, &paint, category, selected, started != 0)
        return Display::encode_binary(&list)

# The game-mode screen's rows, the same table wasm_exports.elisa builds. The
# host owns the live config while it crosses this scalar ABI: bools is a mask
# for rows 0..5, 7, 9..11 and 21; interference is percentage tenths (125 means
# 12.5%).
def gameselect_rows_state(rows: mutable darray[MenuText::Row]&, bools: i64,
                         cubes: i64, grid: i64, active_cells: i64,
                         trial_ms: i64, multi: i64, multimode: i64,
                         interference_tenths: i64):
    can Memory.Allocate, Abort.Panic:
        rows.push(MenuText::Row{name: "Use position", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 0)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "Use color", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 1)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "Use image", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 2)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "Use audio", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 3)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "Use audio2", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 4)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "Use arithmetic", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 5)) != 0 else 0.0, text: ""})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "Combination N-back mode", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 6)) != 0 else 0.0, text: ""})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "Use variable N-Back levels", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 7)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "Crab-back mode (reverse order of sets of N stimuli)", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 8)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "3D face-pattern mode", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 9)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "Cubes in 3D pattern", kind: MenuText::INT, number: cubes.f64(), text: ""})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "2D grid size", kind: MenuText::INT, number: grid.f64(), text: ""})
        rows.push(MenuText::Row{name: "Active 2D position cells", kind: MenuText::ALL, number: active_cells.f64(), text: ""})
        rows.push(MenuText::Row{name: "Trial interval (ms)", kind: MenuText::INT, number: trial_ms.f64(), text: ""})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "Simultaneous visual stimuli", kind: MenuText::INT, number: multi.f64(), text: ""})
        rows.push(MenuText::Row{name: "Simultaneous stimuli differentiated by", kind: MenuText::TEXT, number: 0.0, text: "image" if multimode != 0 else "color"})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "Self-paced mode", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 10)) != 0 else 0.0, text: ""})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "Interference (tricky stimulus generation)", kind: MenuText::PERCENT, number: interference_tenths.f64() / 1000.0, text: ""})

def gameselect_rows(rows: mutable darray[MenuText::Row]&):
    can Memory.Allocate, Abort.Panic:
        gameselect_rows_state(rows, 1, 1, 3, 8, 10, 1, 0, 125)

def menu_frame(selpos: i64, black_background: i64) -> darray[u8]:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        rows: mutable darray[MenuText::Row] = []
        gameselect_rows(&rows)
        list: mutable Display::DisplayList = Display::DisplayList()
        render_menu_screen(&list, "Choose your game mode", menu_default_footnote(), &rows, selpos, black_background != 0)
        return Display::encode_binary(&list)

def menu_state_frame(selpos: i64, black_background: i64, bools: i64,
                     cubes: i64, grid: i64, active_cells: i64, trial_ms: i64,
                     multi: i64, multimode: i64,
                     interference_tenths: i64) -> darray[u8]:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        rows: mutable darray[MenuText::Row] = []
        gameselect_rows_state(&rows, bools, cubes, grid, active_cells, trial_ms,
                              multi, multimode, interference_tenths)
        list: mutable Display::DisplayList = Display::DisplayList()
        render_menu_screen(&list, "Choose your game mode", menu_default_footnote(), &rows, selpos, black_background != 0)
        return Display::encode_binary(&list)

export pymodule nwcore:
    fn ms_to_ticks
    fn clamp_trial_interval_ms
    fn plan_trial_phases
    fn interval_adjust_step
    fn nback_frame
    fn nback_session_frame
    fn batch_frame
    fn title_frame
    fn taskhub_frame
    fn task_frame
    fn menu_frame
    fn menu_state_frame
    const api_level = API_LEVEL
