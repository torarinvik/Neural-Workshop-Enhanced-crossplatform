def count_create(kind: i64, start_count: i64, trials: i64,
                 exposure_ms: i64, adaptive: i64, show_answer: i64,
                 seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return YOU_ARE_HERE_ERROR if kind < Counting::LINES or kind > Counting::MIXED
        return YOU_ARE_HERE_ERROR if not CountingGame::allowed_start_count(start_count)
        return YOU_ARE_HERE_ERROR if not CountingGame::allowed_trials(trials)
        return YOU_ARE_HERE_ERROR if not CountingGame::allowed_exposure(exposure_ms)
        return YOU_ARE_HERE_ERROR if adaptive != 0 and adaptive != 1
        return YOU_ARE_HERE_ERROR if show_answer != 0 and show_answer != 1
        raw: mutable heap void&? = malloc(size_of(CountingGame::CountingRun).usize())
        return YOU_ARE_HERE_ERROR if raw == null
        trusted Unsafe.PointerCast:
            pointer: mutable heap void& = raw
            run: mutable heap CountingGame::CountingRun& = pointer.cast[mutable heap CountingGame::CountingRun&]
            CountingGame::initialize(run, kind, start_count, trials, exposure_ms,
                                     adaptive != 0, show_answer != 0, seed)
            return pointer.cast[u8&].uintptr().i64()

def count_action(handle: i64, action: i64, value: i64, now_ms: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return YOU_ARE_HERE_ERROR if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap CountingGame::CountingRun& = handle.uintptr().cast[mutable heap CountingGame::CountingRun&]
            return CountingGame::apply(run, action, value, now_ms)

def count_advance(handle: i64, now_ms: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return YOU_ARE_HERE_ERROR if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap CountingGame::CountingRun& = handle.uintptr().cast[mutable heap CountingGame::CountingRun&]
            return CountingGame::advance(run, now_ms)

def count_info(handle: i64, field: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return YOU_ARE_HERE_ERROR if handle <= 0
        trusted Unsafe.PointerCast:
            run: heap CountingGame::CountingRun& = handle.uintptr().cast[heap CountingGame::CountingRun&]
            return CountingGame::info(run, field)

def count_frame(handle: i64, black_background: i64,
                width: i64, height: i64) -> darray[u8]:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        empty: mutable Display::DisplayList = Display::DisplayList()
        return Display::encode_binary(&empty) if handle <= 0
        trusted Unsafe.PointerCast:
            run: heap CountingGame::CountingRun& = handle.uintptr().cast[heap CountingGame::CountingRun&]
            list: mutable Display::DisplayList = Display::DisplayList()
            shapes: mutable darray[SceneCounting::CountRenderShape] = []
            for index in 0..<run.shape_count |index, run, shapes|:
                source: Counting::CountShape = run.shapes[index.usize()]
                shapes.push(SceneCounting::CountRenderShape{
                    kind: source.kind,
                    x1: source.x[0], y1: source.y[0],
                    x2: source.x[1], y2: source.y[1],
                    x3: source.x[2], y3: source.y[2],
                    radius: source.radius,
                })
            paint: mutable SceneCounting::CountPaint = SceneCounting::paint_of(
                black_background != 0, width.f64(), height.f64(), 1.0, 1.0)
            typed: mutable dstr = []
            if run.answer_length > 0:
                dstr_append_i64(&typed, run.answer)
            message: mutable dstr = []
            if run.phase == CountingGame::PHASE_READY:
                dstr_append_cstr(&message, "Press Space to start")
            elif run.phase == CountingGame::PHASE_SHOWING or run.phase == CountingGame::PHASE_HIDDEN:
                dstr_append_cstr(&message, "How many?")
            elif run.phase == CountingGame::PHASE_FEEDBACK:
                CountingGame::append_feedback_text(&message, run)
            else:
                CountingGame::append_done_text(&message, run)
            verdict_message: mutable dstr = []
            if run.verdict >= 0:
                CountingGame::append_feedback_text(&verdict_message, run)
            SceneCounting::render(&list, &paint, run.phase, &shapes,
                                  bytes_view(typed), run.trial,
                                  run.total_trials, run.correct,
                                  bytes_view(message), run.verdict,
                                  bytes_view(verdict_message))
            return Display::encode_binary(&list)

def count_destroy(handle: i64) -> i64:
    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            heap_pointer: heap void& = handle.uintptr().cast[heap void&]
            free(heap_pointer)
            return 0

def mr_time_create(mode: i64, rung: i64, trials: i64, max_gap_ms: i64,
                   flash_ms: i64, adaptive: i64, seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return YOU_ARE_HERE_ERROR if mode < MrTime::MODE_RECALL or mode > MrTime::MODE_BOTH
        return YOU_ARE_HERE_ERROR if rung < MrTime::MIN_RUNG or rung > MrTime::MAX_RUNG
        return YOU_ARE_HERE_ERROR if trials != 5 and trials != 10 and trials != 15 and trials != 20 and trials != 30 and trials != 50 and trials != 80
        return YOU_ARE_HERE_ERROR if max_gap_ms != 500 and max_gap_ms != 1000 and max_gap_ms != 2000 and max_gap_ms != 3000 and max_gap_ms != 5000 and max_gap_ms != 8000 and max_gap_ms != 15000
