# The Python extension surface.
#
# Kept OUT of the core modules because `export pymodule` is a stage1-only
# feature: stage0 rejects the keyword, and every core module must compile with
# both compilers. Only build_pymodule.sh compiles this file.
#
# The runtime source is included the way wasm_exports.elisa and the sweeps
# include it, and for a reason that is not obvious: the stage1 backend can only
# lower the `sview_len`/`sview_at` builtins when the runtime's Elisa source is
# in the unit. Without the include it DECLINES every function that touches an
# sview -- display.elisa's pool_intern, and with it draw_text and emit_marker --
# and a declined function is simply absent from the object, so the module links
# and then fails at import with a missing symbol. Including the source means the
# prebuilt runtime object must not be linked as well; build_pymodule.sh points
# ELISA_RUNTIME_OBJ at a small shim instead.
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "scheduling.elisa"
include "board.elisa"
include "display.elisa"
include "scene_nback.elisa"
include "scene_title.elisa"

# ------------------------------------------------------------
# Display-list frames
# ------------------------------------------------------------
#
# The wasm surface hands the shell a pointer into linear memory because JS can
# view that memory in place. CPython has no such view, so the natural shape
# here is the other one: return the encoded list BY VALUE as darray[u8], which
# the pymodule bridge converts to `bytes`. The shell gets an immutable object
# it can hold across frames, and nothing about buffer lifetime crosses the ABI.
#
# Note the contrast with the wasm path, which has to build the list in the
# AMBIENT region to dodge a wasm32 region-reuse bug. Natively the ordinary
# shape is correct: a fresh list per call, encoded and returned.
def nback_frame(trial: i64, nback: i64, position: i64, verdict: i64) -> darray[u8]:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        list: mutable DisplayList = DisplayList()
        render_nback_frame(&list, trial, nback, position, verdict)
        return encode_binary(&list)

def title_frame(banner_code: i64, black_background: i64, jaeggi_mode: i64, clinical_mode: i64) -> darray[u8]:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        list: mutable DisplayList = DisplayList()
        render_title_frame_coded(&list, banner_code, black_background != 0, jaeggi_mode != 0, clinical_mode != 0)
        return encode_binary(&list)

export pymodule nwcore:
    fn ms_to_ticks
    fn clamp_trial_interval_ms
    fn plan_trial_phases
    fn interval_adjust_step
    fn nback_frame
    fn title_frame
    const api_level = API_LEVEL
