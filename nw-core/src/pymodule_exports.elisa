def marble_frame(handle: i64, black_background: i64,
                 width: i64, height: i64) -> darray[u8]:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        empty: mutable Display::DisplayList = Display::DisplayList()
        return Display::encode_binary(&empty) if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap MarbleMazeGame::MarbleRun& = handle.uintptr().cast[mutable heap MarbleMazeGame::MarbleRun&]
            grade: MarbleMaze::MarbleGrade = MarbleMaze::grade_of(run.rung)
            phase: i64 = MarbleMazeGame::info(run, MarbleMazeGame::INFO_PHASE)
            scene_phase: i64 = 0 if phase == MarbleMazeGame::PHASE_READY or phase == MarbleMazeGame::PHASE_PREPARING else (1 if phase == MarbleMazeGame::PHASE_RUNNING else (2 if phase == MarbleMazeGame::PHASE_FEEDBACK else 3))
            verdict: i64 = MarbleMazeGame::info(run, MarbleMazeGame::INFO_VERDICT)
            remaining: i64 = MarbleMazeGame::info(run, MarbleMazeGame::INFO_REMAINING_MS) / 1000
            held: i64 = MarbleMazeGame::info(run, MarbleMazeGame::INFO_HELD_MASK)
            roll: i64 = 8 if (held & MarbleMazeGame::MASK_EAST) != 0 else (-8 if (held & MarbleMazeGame::MASK_WEST) != 0 else 0)
            pitch: i64 = 8 if (held & MarbleMazeGame::MASK_NORTH) != 0 else (-8 if (held & MarbleMazeGame::MASK_SOUTH) != 0 else 0)
            message: sview = "Press SPACE to start" if scene_phase == 0 else ("Done" if scene_phase == 3 else "")
            verdict_text: sview = "Complete" if verdict == 1 else ("Try again" if verdict == 0 else "")
            paint: SceneMarbleMaze::MarblePaint = SceneMarbleMaze::paint_of(black_background != 0, width.f64(), height.f64(), width.f64() / Display::REFERENCE_WIDTH, height.f64() / Display::REFERENCE_HEIGHT)
            list: mutable Display::DisplayList = Display::DisplayList()
            SceneMarbleMaze::render_with_board(&list, &paint, scene_phase,
                scene_phase == 1, run.trial, run.total_trials, 0,
                grade.marbles, remaining, roll, pitch, message, verdict,
                verdict_text, run.trial, run.elapsed_ms / 1000, scene_phase != 0)
            return Display::encode_binary(&list)

