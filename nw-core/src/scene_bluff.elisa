include "./tasks/bluff_game.elisa"
include "./scene_hidden_rule.elisa"
include "./scene_verdict.elisa"
include "./verdict.elisa"
include "./geometry.elisa"

module SceneBluff:
    const CENTER: u32 = Display::ANCHOR_CENTER_CENTER
    const LEFT: u32 = Display::ANCHOR_LEFT_CENTER
    const RIGHT: u32 = Display::ANCHOR_RIGHT_CENTER
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const LOG: i64 = 12

    def table() -> SceneHiddenRule::Rect:
        can Abort.Panic:
            bottom: f64 = Verdict::above_the_band(HEIGHT, Geometry::from_bottom_edge(HEIGHT, 58.0).f64()).f64()
            top: f64 = Geometry::from_top_edge(HEIGHT, 116.0).f64()
            width: f64 = WIDTH * 0.92
            return SceneHiddenRule::Rect{x: (WIDTH - width) / 2.0, y: bottom, w: width * 0.56, h: fmax(40.0, top - bottom)}

    def button(area: SceneHiddenRule::Rect&, choice: i64) -> SceneHiddenRule::Rect:
        width: f64 = area.w * 0.3
        center: f64 = area.x + area.w / 2.0
        offset: f64 = area.w * 0.03
        return SceneHiddenRule::Rect{x: center + (offset if choice == 1 else -width - offset),
            y: area.y + area.h * 0.02, w: width, h: area.h * 0.11}

    def hit(session: BluffGame::Session&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return BluffGame::START if session.phase == BluffGame::READY or session.phase == BluffGame::DONE
            return -1 if session.phase != BluffGame::PLAYING
            area: SceneHiddenRule::Rect = table()
            for choice in 0..<2 |area, x, y|:
                box: SceneHiddenRule::Rect = button(&area, choice)
                return choice if SceneHiddenRule::contains(&box, x, y)
            return -1

    def text(list: mutable Display::DisplayList&, words: sview, x: f64, y: f64, size: f64,
             ink: u32, anchor: u32 = CENTER, bold: bool = false):
        can Abort.Panic, Memory.Allocate:
            Display::draw_text_weight(list, words, x, y, fmax(6.0, size), ink, anchor, bold)

    def box(list: mutable Display::DisplayList&, area: SceneHiddenRule::Rect&, fill: u32, border: u32):
        can Abort.Panic, Memory.Allocate:
            Display::draw_rect(list, area.x, area.y, area.w, area.h, fill)
            Display::draw_box(list, area.x, area.y, area.w, area.h, border, 3.0)

    def card(list: mutable Display::DisplayList&, area: SceneHiddenRule::Rect&, value: i64, ink: u32):
        can Abort.Panic, Memory.Allocate:
            box(list, area, 0x345aa0ff if value < 0 else 0xfcfaf4ff, ink)
            if value >= 0:
                label: mutable dstr = []
                dstr_append_i64(&label, value + 1)
                text(list, bytes_view(label), area.x + area.w / 2.0, area.y + area.h / 2.0,
                    area.h * 0.4, 0x141414ff, CENTER, true)

    def action_text(out: mutable dstr&, spot: i64, index: i64, player_first: bool, lower: bool = false):
        can Abort.Panic, Memory.Allocate:
            you: bool = (index % 2 == 0) == player_first
            dstr_append_cstr(out, ("you" if you else "they") if lower else ("You" if you else "They"))
            opening: bool = Bluff::opening(BluffReference::before(spot, index))
            aggressive: bool = BluffReference::aggressive_at(spot, index)
            dstr_append_cstr(out, (" bet" if aggressive else " check") if opening else (" call" if aggressive else " fold"))

    def draw_table(list: mutable Display::DisplayList&, area: SceneHiddenRule::Rect&, session: BluffGame::Session&, dark: bool, ink: u32):
        can Abort.Panic, Memory.Allocate:
            round: Bluff::Match& = &session.round
            cx: f64 = area.x + area.w / 2.0
            top: f64 = area.y + area.h
            size: f64 = 13.0
            label: mutable dstr = []
            dstr_append_cstr(&label, "cards run from 1 to ")
            dstr_append_i64(&label, round.dealt.level.cards)
            text(list, bytes_view(label), cx, top - size, size * 0.85, ink)
            return if Bluff::over(round)
            hand: Bluff::Hand = round.dealt.hands[round.records.count]
            height: f64 = fmin(area.h * 0.26, area.w * 0.22)
            width: f64 = height * 0.7
            hidden: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: cx - width / 2.0, y: top - height - size * 2.0, w: width, h: height}
            card(list, &hidden, -1, ink)
            text(list, "them", cx + width, top - height / 2.0 - size * 2.0, size, ink, LEFT)
            middle: f64 = area.y + area.h * 0.5
            lines: i64 = BluffReference::length(round.spot)
            if lines == 0:
                text(list, "You open" if hand.player_first else "They open", cx, middle + size * 0.8, size, ink, CENTER, true)
            for i in 0..<lines |list, round, lines, hand, cx, middle, size, ink|:
                words: mutable dstr = []
                action_text(&words, round.spot, i, hand.player_first)
                text(list, bytes_view(words), cx, middle + size * 1.6 * (lines.f64() / 2.0 - i.f64()), size, ink, CENTER, true)
            visible: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: hidden.x, y: area.y + area.h * 0.18, w: width, h: height}
            card(list, &visible, hand.player, ink)
            text(list, "you", cx + width, visible.y + height / 2.0, size, ink, LEFT)
            return if session.phase != BluffGame::PLAYING or Bluff::first_actor(round.spot) != hand.player_first
            facing: bool = not Bluff::opening(round.spot)
            for choice in 0..<2 |list, area, facing, dark, ink|:
                target: SceneHiddenRule::Rect = button(area, choice)
                box(list, &target, 0x2e323aff if dark else 0xe8ebf0ff, ink)
                words: sview = ("Fold (1)" if choice == 0 else "Call (2)") if facing else ("Check (1)" if choice == 0 else "Bet (2)")
                text(list, words, target.x + target.w / 2.0, target.y + target.h / 2.0, target.h * 0.32, ink, CENTER, true)

    def signed(out: mutable dstr&, value: i64):
        can Abort.Panic, Memory.Allocate:
            if value >= 0:
                out.push(43.u8())
            dstr_append_i64(out, value)

    def draw_log(list: mutable Display::DisplayList&, area: SceneHiddenRule::Rect&, round: Bluff::Match&, ink: u32):
        can Abort.Panic, Memory.Allocate:
            size: f64 = 11.0
            top: f64 = area.y + area.h
            full_width: f64 = WIDTH * 0.92
            left: f64 = area.x + area.w + full_width * 0.03
            right: f64 = area.x + full_width
            step: f64 = fmin(size * 2.4, (area.h - size * 3.0) / LOG.f64())
            text(list, "last hands   you / them", left, top - size, size, ink, LEFT, true)
            count: i64 = round.records.count.i64()
            for row in 0..<(count if count < LOG else LOG) |list, round, ink, size, top, left, right, step, count|:
                record: Bluff::Record = round.records[(count - 1 - row).usize()]
                y: f64 = top - size * 3.0 - row.f64() * step
                cards: mutable dstr = []
                dstr_append_i64(&cards, record.player_card + 1)
                dstr_append_cstr(&cards, " / ")
                if record.shown < 0:
                    cards.push(63.u8())
                else:
                    dstr_append_i64(&cards, record.shown + 1)
                text(list, bytes_view(cards), left, y, size, ink, LEFT, true)
                moves: mutable dstr = []
                for index in 0..<BluffReference::length(record.spot) |moves, record|:
                    dstr_append_cstr(&moves, ", ") if index > 0
                    action_text(&moves, record.spot, index, record.player_first, true)
                text(list, bytes_view(moves), left + size * 5.0, y, size * 0.85, ink, LEFT)
                won: mutable dstr = []
                signed(&won, record.won)
                text(list, bytes_view(won), right, y, size, 0x3c965aff if record.won > 0 else 0xd6403aff, RIGHT, true)

    def points(out: mutable dstr&, value: f64):
        can Abort.Panic, Memory.Allocate:
            magnitude: f64 = fabs(value)
            high: f64 = magnitude * 8.0
            low: f64 = magnitude * 2.0
            scaled: f64 = high + low
            whole_units: i64 = scaled.i64()
            units: mutable i64 = round_half_even(scaled)
            # A binary float can lie to either side of a decimal midpoint
            # even when its scaled product rounds to exactly half a unit.
            if scaled - whole_units.f64() == 0.5:
                residual: f64 = low - (scaled - high)
                units <- whole_units + 1 if residual > 0.0
                units <- whole_units if residual < 0.0
            if value < 0.0 and units != 0:
                out.push(45.u8())
            dstr_append_i64(out, units / 10)
            if units % 10 != 0:
                out.push(46.u8())
                dstr_append_i64(out, units % 10)

    def kind_name(kind: i64) -> cstr:
        return "station" if kind == Bluff::STATION
        return "rock" if kind == Bluff::ROCK
        return "maniac" if kind == Bluff::MANIAC
        return "sound" if kind == Bluff::SOUND
        return "adaptive"

    def verdict(out: mutable dstr&, session: BluffGame::Session&):
        can Abort.Panic, Memory.Allocate:
            dstr_append_cstr(out, "Your play was worth ")
            points(out, session.verdict_value)
            dstr_append_cstr(out, " against a par of ")
            points(out, session.par)
            dstr_append_cstr(out, " (chips ")
            signed(out, session.verdict_chips)
            dstr_append_cstr(out, ") -- they were: ")
            dstr_append_cstr(out, kind_name(session.verdict_first))
            if session.verdict_later != session.verdict_first:
                dstr_append_cstr(out, " then ")
                dstr_append_cstr(out, kind_name(session.verdict_later))

    def facts(out: mutable dstr&, session: BluffGame::Session&):
        can Abort.Panic, Memory.Allocate:
            level: Bluff::Grade = session.round.dealt.level
            dstr_append_cstr(out, "rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, "  ")
            dstr_append_i64(out, session.trial)
            dstr_append_cstr(out, "/")
            dstr_append_i64(out, session.total)
            dstr_append_cstr(out, "  hand ")
            index: i64 = session.round.records.count.i64() + 1
            dstr_append_i64(out, index if index < level.hands else level.hands)
            dstr_append_cstr(out, " of ")
            dstr_append_i64(out, level.hands)
            dstr_append_cstr(out, "  chips ")
            signed(out, session.round.chips)

    def message(out: mutable dstr&, session: BluffGame::Session&):
        can Abort.Panic, Memory.Allocate:
            if session.phase == BluffGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif session.phase == BluffGame::DONE:
                dstr_append_i64(out, session.wins)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, session.trial - session.forfeits)
                dstr_append_cstr(out, " at par or better   highest rung passed ")
                dstr_append_i64(out, session.best_rung)
            elif session.phase == BluffGame::JUDGED:
                verdict(out, session)
            else:
                dstr_append_cstr(out, "Play ")
                dstr_append_i64(out, session.round.dealt.level.hands)
                dstr_append_cstr(out, " hands worth ")
                points(out, session.par)
                dstr_append_cstr(out, " or more")

    def render(list: mutable Display::DisplayList&, session: BluffGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            text(list, "Bluff", 456.0, 648.0, 22.0, ink, CENTER, true)
            text(list, "1 or K: check / fold   2 or B: bet / call   Esc: menu", 456.0, 26.0, 12.0, ink)
            status: mutable dstr = []
            message(&status, session)
            text(list, bytes_view(status), 456.0, 614.0, 14.0, ink)
            return if session.phase == BluffGame::READY
            if session.phase == BluffGame::DONE:
                return if not session.has_verdict
                status <- []
                verdict(&status, session)
            else:
                details: mutable dstr = []
                facts(&details, session)
                text(list, bytes_view(details), 456.0, 588.0, 12.0, ink)
                area: SceneHiddenRule::Rect = table()
                draw_table(list, &area, session, dark, ink)
                draw_log(list, &area, &session.round, ink)
            if session.phase == BluffGame::FLAGGED:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, false, "Out of time", 60.0, 16.0)
            elif session.has_verdict:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, session.passed, bytes_view(status), 60.0, 16.0)

    def opponent_description(kind: i64) -> cstr:
        return "a calling station" if kind == Bluff::STATION
        return "a rock" if kind == Bluff::ROCK
        return "a maniac" if kind == Bluff::MANIAC
        return "a sound player" if kind == Bluff::SOUND
        return "a player who adapts to you"

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: Bluff::Grade = Bluff::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.hands)
            dstr_append_cstr(out, " hands, cards 1 to ")
            dstr_append_i64(out, level.cards)
            dstr_append_cstr(out, ".  Against " if level.kind_count == 1 else ".  Against one of: ")
            for i in 0..<level.kind_count |out, level|:
                dstr_append_cstr(out, ", ") if i > 0
                dstr_append_cstr(out, opponent_description(level.kinds[i.usize()]))
            dstr_append_cstr(out, ".")
            dstr_append_cstr(out, "  It changes partway.") if level.changes
            dstr_append_cstr(out, "  You must beat the reference.") if level.allow < 0.0
