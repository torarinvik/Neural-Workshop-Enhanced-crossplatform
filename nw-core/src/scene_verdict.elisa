# The verdict label, as a display list.
#
# Port of the drawing half of neural_workshop/ui/verdict.py. The thinking half
# -- where the band is, and how far above it a layout must stop -- is already
# in `verdict.elisa`; this is only the label that gets painted INTO the band
# so the agent boundary can read a scalar off the pixels.
#
# Every task screen that resolves a trial paints this, so it lives here rather
# than being retyped in each scene.
#
# Three things about it are easy to get wrong and all three are load-bearing:
#
#   * It is INVISIBLE until `show` is called, and a hidden pyglet label draws
#     nothing at all. A scene that always emits it is one command long in
#     every frame where no trial has resolved.
#   * It takes NO font_name, so it is the pyglet default face and not the
#     workshop's FONTLIST -- the one label on a task screen that is not.
#   * `y_from_bottom` is the caller's, and the default is 30.0, not the 60.0
#     that most screens pass.
#
# NOTE: needs geometry and display included by the driver.

module SceneVerdict:

    # configdefaults.COLOR_LABEL_CORRECT / COLOR_LABEL_INCORRECT. The reader
    # counts runs of exactly these, so they are not a palette choice.
    def correct_color() -> u32:
        return Display::rgba(64, 255, 64, 255)

    def incorrect_color() -> u32:
        return Display::rgba(255, 64, 64, 255)

    # `good` picks the colour and IS the public scalar; `text` is for the
    # person playing and does not change what is derived.
    def put(list: mutable Display::DisplayList&, width: f64, height: f64,
            sx: f64, sy: f64, good: bool, text: sview,
            y_from_bottom: f64, size: f64):
        can Memory.Allocate, Abort.Panic:
            color: u32 = correct_color() if good else incorrect_color()
            x: f64 = Geometry::width_center(width).f64()
            y: f64 = Geometry::from_bottom_edge(height, y_from_bottom).f64()
            Display::draw_text_weight(list, text, x / sx, y / sy,
                                      Geometry::calc_fontsize(height, size) / sy,
                                      color, Display::ANCHOR_CENTER_CENTER, false)
