# The port-facing 3D N-Back scene.
#
# This is deliberately separate from the legacy compact 2D session preview.
# The scene consumes only the public controller snapshot: a visible stimulus
# is emitted during the stimulus phase, while response/feedback phases receive
# no position or colour and therefore cannot leak the answer through the
# display list.

module SceneNBack3D:

    const PHASE_STIMULUS: i64 = 1
    const PHASE_RESPONSE: i64 = 2
    const PHASE_FEEDBACK: i64 = 3

    def put_text(list: mutable Display::DisplayList&, paint: SceneField::FieldPaint&,
                 text: sview, x: f64, y: f64, size: f64, color: u32,
                 anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    def render(list: mutable Display::DisplayList&, black_background: bool,
               width: f64, height: f64, phase: i64, trial: i64,
               total_trials: i64, nback: i64, cubes: i64, position: i64,
               color: i64, verdict: i64, hits: i64, misses: i64,
               false_alarms: i64, correct_rejections: i64, message: sview):
        can Memory.Allocate, Abort.Panic:
            sx: f64 = width / Display::REFERENCE_WIDTH
            sy: f64 = height / Display::REFERENCE_HEIGHT
            paint: mutable SceneField::FieldPaint = SceneField::paint_of(
                black_background, width, height, sx, sy)
            ink: u32 = Display::rgba(255, 255, 255, 255) if black_background else Display::rgba(20, 24, 32, 255)
            background: u32 = Display::rgba(0, 0, 0, 255) if black_background else Display::rgba(255, 255, 255, 255)
            Display::draw_rect(list, 0.0, 0.0, width / sx, height / sy, background)

            middle: f64 = Display::REFERENCE_WIDTH / 2.0
            put_text(list, &paint, "3D N-Back", middle, 36.0,
                     22.0, ink, Display::ANCHOR_CENTER_CENTER, true)

            status: mutable dstr = []
            dstr_append_cstr(&status, "N = ")
            dstr_append_i64(&status, nback)
            dstr_append_cstr(&status, "     trial ")
            dstr_append_i64(&status, trial)
            dstr_append_cstr(&status, "/")
            dstr_append_i64(&status, total_trials)
            dstr_append_cstr(&status, "     cubes ")
            dstr_append_i64(&status, cubes)
            put_text(list, &paint, bytes_view(status), middle, 70.0,
                     14.0, ink, Display::ANCHOR_CENTER_CENTER, false)

            field: SceneField::RenderField = SceneField::field_of(
                width, height, false)
            SceneField::put_cube_stage(list, &paint, &field)
            if phase == PHASE_STIMULUS and position > 0 and color > 0:
                SceneField::put_3d_pattern(list, &paint, &field, position,
                                           color, cubes)

            if phase == PHASE_FEEDBACK and verdict >= 0:
                feedback: mutable dstr = []
                if verdict == 1:
                    dstr_append_cstr(&feedback, "Hit")
                elif verdict == 0:
                    dstr_append_cstr(&feedback, "False alarm")
                elif verdict == 2:
                    dstr_append_cstr(&feedback, "Miss")
                else:
                    dstr_append_cstr(&feedback, "Correct rejection")
                put_text(list, &paint, bytes_view(feedback), middle, 600.0,
                         18.0, ink, Display::ANCHOR_CENTER_CENTER, true)

            score: mutable dstr = []
            dstr_append_cstr(&score, "hits ")
            dstr_append_i64(&score, hits)
            dstr_append_cstr(&score, "  misses ")
            dstr_append_i64(&score, misses)
            dstr_append_cstr(&score, "  false alarms ")
            dstr_append_i64(&score, false_alarms)
            dstr_append_cstr(&score, "  correct rejections ")
            dstr_append_i64(&score, correct_rejections)
            put_text(list, &paint, bytes_view(score), middle, 628.0,
                     12.0, ink, Display::ANCHOR_CENTER_CENTER, false)

            put_text(list, &paint, message, middle, 654.0, 12.0, ink,
                     Display::ANCHOR_CENTER_CENTER, false)
            put_text(list, &paint,
                     "Esc: task menu     Space: start     A: match     P: pause",
                     middle, 30.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER,
                     false)
            Display::emit_marker(list, "frame-end")
