# The assembled workshop screen: field, persistent HUD, read-outs and trial UI.
#
# The reference creates these widgets once in bootstrap._build_widgets() and
# then lets one pyglet Batch draw them together. The lower-level scene modules
# deliberately do not know about one another, so this file is the missing
# composition boundary. It owns ordering and visibility; each contributor
# still owns its own geometry and text rules.
#
# Resource-backed visuals are named for the shell. Asset 0 is the session's
# first coloured-square slot in the compact display-list ABI; a native shell
# may replace it with its decoded resource without changing this frame.
#
# NOTE: needs board, geometry, display, gamemode, session_app, strings,
# scene_field, scene_hud, hudtext, readouttext, trialuitext and scene_trialui.

module SceneBatch:

    const DEFAULT_INTERVAL_MS: i64 = 3000
    const DEFAULT_THRESHOLD_ADVANCE: i64 = 80
    const DEFAULT_THRESHOLD_FALLBACK: i64 = 50
    const DEFAULT_FALLBACK_SESSIONS: i64 = 3

    # Stock config key symbols, in INPUT_MODALITIES order. The actual config
    # can change these in the desktop app; this default frame is the portable
    # host preview, so it carries the shipped values.
    def default_keys() -> darray[sview]:
        can Memory.Allocate, Abort.Panic:
            out: mutable darray[sview] = []
            out.push("A")
            out.push("S")
            out.push("D")
            out.push("F")
            out.push("F")
            out.push("J")
            out.push("G")
            out.push("H")
            out.push("J")
            out.push("K")
            out.push("S")
            out.push("D")
            out.push("J")
            out.push("L")
            out.push("SEMICOLON")
            return out

    def stock_color(index: i64, black: bool) -> u32:
        # COLOR_4_BLK and COLOR_7_BLK are the only dark-theme overrides in
        # configdefaults.py. The rest are shared with the pale theme.
        if black and index == 4:
            return Display::rgba(255, 255, 255, 255)
        if black and index == 7:
            return Display::rgba(64, 64, 64, 255)
        if index == 1:
            return Display::rgba(0, 0, 255, 255)
        if index == 2:
            return Display::rgba(0, 255, 255, 255)
        if index == 3:
            return Display::rgba(0, 255, 0, 255)
        if index == 4:
            return Display::rgba(48, 48, 48, 255)
        if index == 5:
            return Display::rgba(255, 0, 255, 255)
        if index == 6:
            return Display::rgba(255, 0, 0, 255)
        if index == 7:
            return Display::rgba(208, 208, 208, 255)
        return Display::rgba(255, 255, 0, 255)

    def visual_text(value: i64) -> sview:
        # The sound-set letter itself is a resource choice made by the shell.
        # These stable labels keep the core frame useful for combination-mode
        # previews and preserve the one-character shape of Visual.label.
        if value == 1:
            return "H"
        if value == 2:
            return "K"
        if value == 3:
            return "L"
        if value == 4:
            return "T"
        if value == 5:
            return "C"
        if value == 6:
            return "Q"
        if value == 7:
            return "R"
        return "S"

    def empty_history() -> darray[ReadoutHistoryEntry]:
        can Memory.Allocate, Abort.Panic:
            out: mutable darray[ReadoutHistoryEntry] = []
            return out

    def empty_cells() -> darray[sview]:
        can Memory.Allocate, Abort.Panic:
            out: mutable darray[sview] = []
            return out

    def batch_game_cfg(mode_number: i64, nback: i64, black: bool) -> GameCfg:
        can Memory.Allocate, Abort.Panic:
            no_back: mutable darray[ModeOverride] = []
            no_ticks: mutable darray[ModeOverride] = []
            return GameCfg{
                game_mode: mode_number,
                back_default: nback,
                ticks_default: 30,
                bonus_ticks_crab: 0,
                bonus_ticks_multi2: 5,
                bonus_ticks_multi3: 10,
                bonus_ticks_multi4: 15,
                num_trials: 20,
                num_trials_factor: 1,
                num_trials_exponent: 2,
                manual: false,
                hide_text: false,
                skip_title_screen: true,
                black_background: black,
                back_overrides: no_back,
                ticks_overrides: no_ticks}

    # Render the complete batch for one deterministic session snapshot.
    #
    # `trial` and `seed` feed SessionApp's real generator. The remaining
    # switches are the visual/state slice a host can change without needing a
    # Python object graph: idle versus running, theme, board presentation and
    # the text visibility controls.
    def render_batch_frame(list: mutable Display::DisplayList&, trial: i64,
                           nback: i64, seed: i64, mode_number: i64,
                           black: bool, started: bool, hide_text: bool,
                           paused: bool, grid_3d: bool, expanded: bool,
                           gridlines: bool, old_style: bool,
                           sharp_corners: bool, session_number: i64,
                           verdict: i64, input_answer: i64):
        can Memory.Allocate, Abort.Panic:
            tables: ModeTables = ModeTables()
            game_cfg: GameCfg = batch_game_cfg(mode_number, nback, black)
            game: mutable Mode = Mode(&game_cfg)
            game.back <- nback
            game.started <- started
            game.hide_text <- hide_text
            game.paused <- paused
            game.session_number <- session_number
            game.trial_number <- trial

            preview: SessionApp::Preview = SessionApp::preview(&tables, seed,
                trial, mode_number, nback)
            entry_index: i64 = mode_index(&tables, mode_number)
            modalities: mutable darray[Modality] = []
            multi: mutable i64 = 1
            if entry_index >= 0:
                entry: ModeEntry = tables.entries[entry_index.usize()]
                modalities <- copy_modalities(&entry.modalities)
                multi <- entry.flags.multi

            # The window clear is outside pyglet's Batch. Keeping it in the
            # portable list makes screenshots and all three hosts agree on a
            # complete frame, including the idle board.
            Display::draw_rect(list, 0.0, 0.0, Display::REFERENCE_WIDTH,
                               Display::REFERENCE_HEIGHT,
                               Display::rgba(0, 0, 0, 255) if black else Display::rgba(255, 255, 255, 255))

            # Field.__init__ is the first persistent batch contributor.
            field_paint: SceneField::FieldPaint = SceneField::paint_of(black,
                Display::REFERENCE_WIDTH, Display::REFERENCE_HEIGHT, 1.0, 1.0)
            field: SceneField::RenderField = SceneField::field_of(
                Display::REFERENCE_WIDTH, Display::REFERENCE_HEIGHT, expanded)
            if gridlines:
                if grid_3d:
                    SceneField::put_cube_stage(list, &field_paint, &field)
                else:
                    SceneField::put_grid(list, &field_paint, &field, 3)
            if SceneField::crosshair_wanted(true, grid_3d, paused,
                                             modalities_contain(&modalities, Modality.Position1), false):
                SceneField::put_crosshair(list, &field_paint, &field)

            # HUD configuration and text are assembled together, but the draw
            # calls remain in bootstrap's creation order below.
            hud_cfg: HudConfig = HudConfig{
                clinical_mode: false,
                jaeggi_mode: false,
                grid_3d: grid_3d,
                variable_nback: false,
                window_fullscreen: false,
                black_background: black,
                use_session_feedback: true,
                morse_audio: false,
                threshold_fallback_sessions: DEFAULT_FALLBACK_SESSIONS,
                grid_size: 3,
                include_center: false,
                active_cell_limit: 0,
                cube_count: 1}
            hud_paint: SceneHud::HudPaint = SceneHud::paint_of(black,
                Display::REFERENCE_WIDTH, Display::REFERENCE_HEIGHT,
                field.centre_x, field.centre_y, field.size, 1.0, 1.0)
            hud_keys: darray[sview] = default_keys()
            mode_text: dstr = game_mode_text(&tables, &game, &hud_cfg)
            keys_text: dstr = keys_list_text(&game, &hud_cfg)
            update_text: dstr = update_notice_text(&game, false, "")
            congrats: dstr = congrats_text(&hud_cfg, false, false, false,
                                           false, false, false, false)
            native: sview = native_tag_text(&game, &hud_cfg, 1)

            SceneHud::put_circles(list, &hud_paint, circle_count(&hud_cfg),
                                  game.progress,
                                  not game.manual and not game.started)
            SceneHud::put_update(list, &hud_paint, bytes_view(update_text))
            SceneHud::put_game_mode(list, &hud_paint, bytes_view(mode_text), false)
            SceneHud::put_jaeggi_warning(list, &hud_paint, "")
            SceneHud::put_keys_list(list, &hud_paint, bytes_view(keys_text),
                                    keys_list_lifted(&game, &hud_cfg))

            # The HUD's title labels are outside the normal event draw path,
            # but their batch-owned native tag, pause and congrats labels are
            # part of this assembled surface.
            SceneHud::put_native_tag(list, &hud_paint, native)
            SceneHud::put_paused(list, &hud_paint, paused)
            SceneHud::put_congrats(list, &hud_paint, bytes_view(congrats))

            # Trial/readout content. All dstr values and sview arrays stay
            # live until the display list has copied their bytes into its pool.
            rights: i64[16] = zeroed
            wrongs: i64[16] = zeroed
            summary: AnalysisSummary = analysis_summary(&modalities, rights,
                                                         wrongs, false)
            history: darray[ReadoutHistoryEntry] = empty_history()
            first: darray[sview] = empty_cells()
            second: darray[sview] = empty_cells()
            third: darray[sview] = empty_cells()
            kinds: darray[i64] = []
            readout_paint: SceneReadouts::ReadoutPaint = SceneReadouts::paint_of(black,
                Display::REFERENCE_WIDTH, Display::REFERENCE_HEIGHT, 1.0, 1.0)
            analysis: dstr = analysis_text(&modalities, hud_keys, rights,
                wrongs, summary, started, session_number, false, false, false)
            chart_title: sview = chart_title_text(started)
            average: dstr = average_text(&tables, &history, mode_number,
                                         started, false)
            today: dstr = today_text(0, 0, 0, 0, started)
            remaining: dstr = trials_remaining_text(game.num_trials_total,
                game.trial_number, started, hide_text)
            session_info: dstr = session_info_text(started, false, 3,
                DEFAULT_INTERVAL_MS, game.num_trials, game.num_trials_total,
                8, 8, grid_3d, 1)
            thresholds: dstr = threshold_text(started, game.manual, false,
                                               DEFAULT_THRESHOLD_ADVANCE,
                                               DEFAULT_THRESHOLD_FALLBACK)
            prompt: dstr = space_prompt_text(&tables, mode_number,
                session_number, nback, false, started, 8, 8,
                game.num_trials_total)

            trial_paint: SceneTrialUI::TrialPaint = SceneTrialUI::paint_of(black,
                Display::REFERENCE_WIDTH, Display::REFERENCE_HEIGHT, 1.0, 1.0)
            SceneTrialUI::put_session_info(list, &trial_paint,
                                           bytes_view(session_info), false)
            SceneTrialUI::put_thresholds(list, &trial_paint,
                                         bytes_view(thresholds))
            SceneTrialUI::put_space_prompt(list, &trial_paint,
                                           bytes_view(prompt))
            SceneReadouts::put_analysis(list, &readout_paint,
                                        bytes_view(analysis))
            SceneReadouts::put_chart_title(list, &readout_paint, chart_title)
            SceneReadouts::put_chart(list, &readout_paint, first, second, third,
                                     kinds, 0)
            SceneReadouts::put_average(list, &readout_paint, bytes_view(average))
            SceneReadouts::put_today(list, &readout_paint, bytes_view(today))
            SceneReadouts::put_trials_remaining(list, &readout_paint,
                                                bytes_view(remaining))

            if modalities_contain(&modalities, Modality.Arithmetic):
                arithmetic: ArithmeticAnswer = ArithmeticAnswer()
                arithmetic_text: dstr = arithmetic_display_text(&arithmetic,
                    true, started, hide_text, false, false, verdict)
                SceneTrialUI::put_arithmetic(list, &trial_paint,
                                             bytes_view(arithmetic_text),
                                             input_answer)

            # Feedback labels are generated in mode order and are the final
            # persistent widgets created before a live Visual is spawned.
            non_arithmetic: mutable i64 = 0
            for value in modalities |list, trial_paint, hud_keys, multi, non_arithmetic, input_answer, started, hide_text|:
                if value == Modality.Arithmetic:
                    continue
                label: dstr = feedback_label_text(hud_keys, value, multi,
                    non_arithmetic, modalities.count.i64(), false, true)
                visible: bool = feedback_is_visible(started, hide_text, true)
                shown: sview = bytes_view(label) if visible else ""
                answer: i64 = input_answer if visible else SceneTrialUI::ANSWER_NONE
                SceneTrialUI::put_feedback(list, &trial_paint, shown,
                    sview_len(shown).i64(), non_arithmetic,
                    modalities.count.i64(), answer)
                non_arithmetic <- non_arithmetic + 1

            # The field's current stimulus is created after the persistent
            # widgets by new_session(). A blank/idle frame has no Visual.
            if started and preview.status == GenerateStatus.Ok:
                at: SceneField::RenderPoint = SceneField::centre_of(&field, 3,
                    false, grid_3d, preview.position)
                side: i64 = SceneField::stimulus_size(&field, 3,
                                                       old_style)
                color: u32 = stock_color(preview.color, black)
                entry: ModeEntry = tables.entries[entry_index.usize()] if entry_index >= 0 else ModeEntry{
                    mode: 0, flags: ModeFlags{crab: 0, multi: 1, selfpaced: 0},
                    modalities: [], short_name: [], long_name: []}
                if grid_3d:
                    SceneField::put_3d_pattern(list, &field_paint, &field,
                                               preview.position, preview.color, 1)
                elif modalities_contain(&entry.modalities, Modality.Arithmetic):
                    number: mutable dstr = []
                    dstr_append_i64(&number, preview.number)
                    SceneField::put_glyph(list, &field_paint,
                                          bytes_view(number), at.x, at.y,
                                          &field, 3, color)
                elif preview.visual == 0:
                    if old_style:
                        SceneField::put_old_style_square(list, &field_paint,
                            at.x, at.y, side, sharp_corners, color)
                    else:
                        SceneField::put_sprite(list, &field_paint, 0, 256, 256,
                                               at.x, at.y, side,
                                               Display::rgba(255, 255, 255, 255))
                elif modalities_contain(&entry.modalities, Modality.VisVis):
                    SceneField::put_glyph(list, &field_paint,
                                          visual_text(preview.visual), at.x,
                                          at.y, &field, 3, color)
                elif modalities_contain(&entry.modalities, Modality.Image):
                    SceneField::put_sprite(list, &field_paint, 0, 256, 256,
                                           at.x, at.y, side,
                                           Display::rgba(255, 255, 255, 255))

            if not started:
                SceneHud::put_logo_words(list, &hud_paint)

            Display::emit_marker(list, "frame-end")
