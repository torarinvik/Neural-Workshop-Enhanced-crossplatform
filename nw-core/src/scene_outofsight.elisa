# The Out of Sight screen: game state in, display list out.
#
# Port of neural_workshop/ui/outofsight.py -- the drawing, not the thinking.
#
# Three labels and a field: dots drifting about, a ring over the one being
# asked about, and slabs of blind laid over both.
#
# THREE GROUPS and the order between them is the task: dots at 0, the ring at
# 1, the blinds at 2. So a dot that goes behind a slab takes ITS RING WITH IT
# -- which is the whole point, because the question is where a thing you
# cannot see has got to.
#
# The dots share Moving Targets' palette, and the RING carries the verdict
# rather than the dot: green when the answer was right, vermilion when it was
# wrong, and the ink while it is still being asked. The dot itself only ever
# says whether it was cued.
#
# The blind's grey is one of two fixed values rather than a tint of the page,
# because a slab has to read as a solid thing over the field rather than as a
# hole in it.
#
# NOTE: needs elisacore_math, strings, geometry, display and scene_verdict
# included by the driver.

module SceneOutOfSight:

    const PHASE_READY: i64 = 0
    const PHASE_CUEING: i64 = 1
    const PHASE_TRACKING: i64 = 2
    const PHASE_ASKING: i64 = 3
    const PHASE_REVEALING: i64 = 4
    const PHASE_DONE: i64 = 5

    # No answer yet, wrong, right.
    const VERDICT_NONE: i64 = -1
    const VERDICT_WRONG: i64 = 0
    const VERDICT_RIGHT: i64 = 1

    def color_plain() -> u32:
        return Display::rgba(86, 180, 233, 255)

    def color_cued() -> u32:
        return Display::rgba(230, 159, 0, 255)

    def color_caught() -> u32:
        return Display::rgba(0, 158, 115, 255)

    def color_missed() -> u32:
        return Display::rgba(213, 94, 0, 255)

    struct Dot:
        x: f64
        y: f64
        target: bool

    struct Blind:
        left: f64
        bottom: f64
        width: f64
        height: f64

    struct Paint:
        ink: mutable u32
        slab: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> Paint:
        back: i64 = 0 if black_background else 255
        fore: i64 = 255 - back
        slab: u32 = Display::rgba(78, 82, 92, 255) if black_background else Display::rgba(148, 152, 162, 255)
        return Paint{ink: Display::rgba(fore, fore, fore, 255), slab: slab,
                     width: width, height: height, sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: Paint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    # `max(7.0, float(scale_to_height(19)))`.
    def radius_of(height: f64) -> f64:
        can Abort.Panic:
            scaled: f64 = Geometry::scale_to_height(height, 19.0).f64()
            return scaled if scaled > 7.0 else 7.0

    def render(list: mutable Display::DisplayList&, paint: Paint&, phase: i64,
               dots: darray[Dot]&, blinds: darray[Blind]&, has_probe: bool,
               probe_x: f64, probe_y: f64, answer: i64, round: i64,
               total_rounds: i64, probes_done: i64, probes_per_round: i64,
               message: sview):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()

            put_text(list, paint, sview("Out of Sight", 0, -1), middle,
                     Geometry::from_top_edge(paint.height, 36.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            status: mutable dstr = []
            dstr_append_sview(&status, message)
            if phase != PHASE_READY and phase != PHASE_DONE:
                # The round counter joins on only when there IS a round total;
                # the question counter always does.
                if total_rounds != 0:
                    dstr_append_cstr(&status, "     round ")
                    dstr_append_i64(&status, round)
                    dstr_append_cstr(&status, "/")
                    dstr_append_i64(&status, total_rounds)
                dstr_append_cstr(&status, "     question ")
                # `min(probes_done + 1, probes_per_round)` -- the counter
                # stops at the last question rather than running past it.
                shown: i64 = probes_done + 1 if probes_done + 1 < probes_per_round else probes_per_round
                dstr_append_i64(&status, shown)
                dstr_append_cstr(&status, "/")
                dstr_append_i64(&status, probes_per_round)
            put_text(list, paint, bytes_view(status), middle,
                     Geometry::from_top_edge(paint.height, 70.0).f64(),
                     Geometry::calc_fontsize(paint.height, 14.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            put_text(list, paint,
                     sview("Esc: task menu     Space: start     J: that one is mine     F: it is not     C: options", 0, -1),
                     middle, Geometry::from_bottom_edge(paint.height, 26.0).f64(),
                     Geometry::calc_fontsize(paint.height, 12.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            # The dots, then the ring, then the blinds over both.
            radius: f64 = radius_of(paint.height)
            cued: bool = phase == PHASE_CUEING or phase == PHASE_REVEALING
            for index in 0..<dots.count.i64() |list, paint, dots, radius, cued|:
                one: Dot = get dots[index.usize()] else Dot{x: 0.0, y: 0.0, target: false}
                Display::draw_circle(list, one.x * paint.width / paint.sx,
                                     one.y * paint.height / paint.sy,
                                     radius / paint.sx,
                                     color_cued() if cued and one.target else color_plain())

            if has_probe:
                shade: mutable u32 = paint.ink
                if answer == VERDICT_RIGHT:
                    shade <- color_caught()
                elif answer == VERDICT_WRONG:
                    shade <- color_missed()
                Display::draw_arc(list, probe_x * paint.width / paint.sx,
                                  probe_y * paint.height / paint.sy,
                                  radius * 1.7 / paint.sx, 0.0, 360.0, shade)

            for index in 0..<blinds.count.i64() |list, paint, blinds|:
                one: Blind = get blinds[index.usize()] else Blind{left: 0.0, bottom: 0.0, width: 0.0, height: 0.0}
                Display::draw_rect(list, one.left * paint.width / paint.sx,
                                   one.bottom * paint.height / paint.sy,
                                   one.width * paint.width / paint.sx,
                                   one.height * paint.height / paint.sy,
                                   paint.slab)
