    def triage_options_note(dest: i64, capacity: i64, rung: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            return ERR_BAD_OPTIONS if not TriageGame::allowed_rung(rung)
            level: Triage::Grade = Triage::grade(rung)
            note: mutable dstr = []
            for line in 0..<3 |level, note|:
                if (line == 1 and level.traps) or (line == 2 and rung > 20):
                    dstr_append_cstr(&note, "  ")
                SceneTriage::option_note(&level, line, &note)
            length: i64 = note.count.i64()
            return ERR_BUFFER if capacity < length or not valid_memory_range(dest, length, 1)
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&note[0]).cast[void&], length.usize())
            return length

