    # The arrows as desktop.py's DIRECTIONS index: up, down, left, right.
    def desktop_direction(code: i64) -> i64:
        return 0 if code == KEY_UP
        return 1 if code == KEY_DOWN
        return 2 if code == KEY_LEFT
        return 3 if code == KEY_RIGHT
        return -1

    # Forms' named keys; NO_KEY for any other.
    def forms_named_key(code: i64) -> i64:
        return Forms::BACKSPACE if code == KEY_BACKSPACE
        return Forms::TAB if code == KEY_TAB
        return Forms::ENTER if code == KEY_ENTER
        return Forms::UP if code == KEY_UP
        return Forms::DOWN if code == KEY_DOWN
        return Forms::NO_KEY

    # Spreadsheet's and Errands' keyboard: a digit, Sheet::DELETE for Backspace, -1 for
    # Enter, and -2 for any other key.
    def sheet_key_digit(code: i64) -> i64:
        return code - KEY_ONE + 1 if code >= KEY_ONE and code <= KEY_EIGHT
        return 9 if code == KEY_NINE
        return 0 if code == KEY_ZERO
        return Sheet::DELETE if code == KEY_BACKSPACE
        return -1 if code == KEY_ENTER
        return -2

