    def you_are_here_info(handle: i64, field: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_YOU_ARE_HERE
            pointer: i64 = slot_pointers[index.usize()]
            trusted Unsafe.PointerCast:
                run: heap YouAreHereGame::Run& = pointer.uintptr().cast[heap YouAreHereGame::Run&]
                return YouAreHereGame::info(run, field)

