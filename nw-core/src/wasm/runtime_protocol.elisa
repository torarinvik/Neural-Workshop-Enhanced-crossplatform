    def valid_action_code(task: i64, action: i64) -> bool:
        can Abort.Panic:
            if task == TASK_NBACK_3D:
                return action >= NBack3DGame::ACTION_START and action <= NBack3DGame::ACTION_RESTART
            if task == TASK_SALESMAN:
                return action == SalesmanGame::ACTION_START or action == SalesmanGame::ACTION_PICK
            if task == TASK_GRAPH_MAPPING:
                return action == GraphMappingGame::ACTION_START or action == GraphMappingGame::ACTION_SAME or action == GraphMappingGame::ACTION_DIFFERENT
            if task == TASK_CROSSED_WIRES:
                return action >= CrossedWiresGame::ACTION_START and action <= CrossedWiresGame::ACTION_APPLY_OPTIONS
            if task == TASK_SUDOKU:
                return action >= SudokuGame::ACTION_START and action <= SudokuGame::ACTION_PENCIL
            if task == TASK_MATRIX_REASONING:
                return action == MatrixReasoningGame::ACTION_START or (action >= MatrixReasoningGame::ACTION_ANSWER and action < MatrixReasoningGame::ACTION_ANSWER + MatrixReasoningGame::MAX_CHOICES)
            if task == TASK_HIDDEN_RULE:
                return action >= 0 and action <= HiddenRuleGame::START
            if task == TASK_HIDDEN_WIRING:
                return action >= 0 and action <= HiddenWiringGame::START
            if task == TASK_TRIAGE:
                return action >= 0 and action <= TriageGame::FLAG
            if task == TASK_DELAY:
                return action >= 0 and action <= DelayGame::START
            if task == TASK_HOLD_IT:
                return action >= HoldItGame::PRESS and action <= HoldItGame::START
            if task == TASK_TIME_IT:
                return action >= TimeIt::PRESS and action <= TimeItGame::START
            if task == TASK_BEAT:
                return action >= Beat::TAP and action <= BeatGame::START
            if task == TASK_CATCH:
                return action >= 0 and action <= CatchGame::CLEAR
            if task == TASK_ECHO_CAVE:
                return action >= 0 and action <= EchoCaveGame::CLEAR
            if task == TASK_DRONE_HOOPS:
                return action >= 0 and action <= DroneHoopsGame::CLEAR
            if task == TASK_FIELD_MANUAL:
                return action >= 0 and action <= FieldManualGame::CLEAR
            if task == TASK_SAFECRACKER:
                return action >= 0 and action <= SafecrackerGame::CLEAR
            if task == TASK_STAGEHAND:
                return action >= 0 and action <= StagehandGame::CLEAR
            if task == TASK_LOADING_DOCK:
                return action >= 0 and action <= LoadingDockGame::LAST_ACTION
            if task == TASK_CAMERA:
                return action >= 0 and action <= CameraGame::DRAG_ACTION
            if task == TASK_GUNSLINGER:
                return action >= 0 and action <= GunslingerGame::CLEAR
            if task == TASK_BALANCE:
                return action >= Balance::LEFT and action <= BalanceGame::CLEAR
            if task == TASK_JUGGLER:
                return action >= Juggler::LEFT and action <= JugglerGame::CLEAR
            if task == TASK_LANDER:
                return action >= Lander::THRUST and action <= LanderGame::CLEAR
            if task == TASK_GLIDER:
                return action >= GliderGame::LIFT and action <= GliderGame::RELEASE
            if task == TASK_NOTEBOOK:
                return action >= 0 and action <= NotebookGame::START
            if task == TASK_WHERE_WAS_IT:
                return action >= 0 and action <= RoomsGame::START
            if task == TASK_SAME_OR_MIRROR:
                return action >= 0 and action <= MirrorGame::START
            if task == TASK_POINT_OF_VIEW:
                return action >= 0 and action <= PointOfViewGame::START
            if task == TASK_INSIDE_OR_OUT:
                return action >= 0 and action <= InsideGame::START
            if task == TASK_TOUCHING:
                return action >= 0 and action <= TouchingGame::START
            if task == TASK_CROSSINGS:
