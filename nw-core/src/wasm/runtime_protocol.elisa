    def what_next_pick_clip(handle: i64, candidates: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast, Global.Read:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_WHAT_NEXT
            return ERR_BAD_EVENT if candidates < 1
            trusted Unsafe.PointerCast:
                run: mutable heap WhatNextGame::Run& = slot_pointers[index.usize()].uintptr().cast[mutable heap WhatNextGame::Run&]
                return ERR_BAD_EVENT if run.phase != WhatNextGame::LOADING
                return py_randbelow(&run.rng, candidates.u64()).i64()

    def what_next_info(handle: i64, field: i64) -> i64:
        can Abort.Panic, Global.Read:
            index: i64 = slot_for(handle)
