                return ERR_BAD_OPTIONS if not option_bool(c)
                return ERR_BAD_OPTIONS if d != 0 or e != 0 or f != 0
                return OK
            elif task == TASK_MAZE:
                return ERR_BAD_OPTIONS if a < 1 or a > Maze::GRADE_COUNT
                return ERR_BAD_OPTIONS if b != 1 and b != 2 and b != 3 and b != 5 and b != 8 and b != 10 and b != 15 and b != 20
                return ERR_BAD_OPTIONS if not option_bool(c) or not option_bool(d)
                return ERR_BAD_OPTIONS if e != 0 or f != 0
                return OK
            elif task == TASK_YOU_ARE_HERE:
                return ERR_BAD_OPTIONS if a < 1 or a > Maze::GRADE_COUNT
                return ERR_BAD_OPTIONS if b != 1 and b != 2 and b != 3 and b != 5 and b != 8 and b != 10 and b != 15 and b != 20
                return ERR_BAD_OPTIONS if not option_bool(c) or not option_bool(d)
                return ERR_BAD_OPTIONS if e != 0 or f != 0
