    def cipher_abyss_load_library(handle: i64, source: i64, length: i64) -> i64:
        can Abort.Panic, Global.Read, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_CIPHER_ABYSS
            return ERR_BUFFER if length <= 0 or length > 65536 or not valid_memory_range(source, length, 1)
            trusted Unsafe.PointerCast:
                session: mutable heap CipherAbyssGame::Session& = slot_pointers[index.usize()].uintptr().cast[mutable heap CipherAbyssGame::Session&]
                return IGNORED if session.phase != CipherAbyssGame::READY and session.phase != CipherAbyssGame::DONE
                contents: sview = unsafe_sview_bounded_bytes(source.uintptr().cast[u8&], length.usize())
                return ACCEPTED if (CipherAbyss::read_library(&session.library, contents) can Global{Read,Write}) else ERR_BAD_OPTIONS

    def cipher_abyss_record(handle: i64, kind: i64, dest: i64, capacity: i64) -> i64:
        can Abort.Panic, Global.Read, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_CIPHER_ABYSS
            return ERR_BAD_OPTIONS if kind < 0 or kind > 2
            trusted Unsafe.PointerCast:
                session: heap CipherAbyssGame::Session& = slot_pointers[index.usize()].uintptr().cast[heap CipherAbyssGame::Session&]
                return 0 if (kind == 0 and session.phase == CipherAbyssGame::READY) or (kind == 1 and session.phase != CipherAbyssGame::JUDGED)
                region scratch(65536):
                    in scratch:
                        result: mutable dstr = []
                        if kind == 0:
                            CipherAbyss::notebook_text(&result, &session.book.program, &session.run)
                        elif kind == 1:
                            CipherAbyss::metrics(&result, &session.book.program, &session.run, &session.summary)
                        else:
                            CipherAbyss::library_text(&result, &session.library)
                        length: i64 = result.count.i64()
                        return ERR_BUFFER if capacity < length or not valid_memory_range(dest, length, 1)
                        target: mutable u8& = dest.uintptr().cast[mutable u8&]
                        memcpy(target.cast[mutable void&], (&result[0]).cast[void&], length.usize())
                        return length

