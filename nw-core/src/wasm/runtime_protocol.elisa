                elif key == KEY_LEFT: return MazeGame::ACTION_LEFT
                elif key == KEY_RIGHT: return MazeGame::ACTION_RIGHT
                elif key == KEY_RESTART: return MazeGame::ACTION_RESTART
                return -1
            elif task == TASK_YOU_ARE_HERE:
