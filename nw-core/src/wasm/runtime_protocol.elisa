    def create(task: i64, options_version: i64, a: i64, b: i64, c: i64,
               d: i64, e: i64, f: i64, seed: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            validation: i64 = valid_options(task, options_version, a, b, c, d, e, f)
            return validation if validation != OK
            index: i64 = free_slot()
            return ERR_TABLE_FULL if index < 0
            return ERR_TABLE_FULL if next_handle <= 0 or next_handle == I64_MAX_VALUE
            bytes: i64 = run_bytes(task)
            raw: mutable heap void&? = malloc(bytes.usize())
            return ERR_NO_MEMORY if raw == null
            pointer: mutable heap void& = raw
            handle: i64 = next_handle
            next_handle <- next_handle + 1
            if task == TASK_NBACK_3D:
                trusted Unsafe.PointerCast:
                    run: mutable heap NBack3DGame::NBack3DRun& = pointer.cast[mutable heap NBack3DGame::NBack3DRun&]
                    NBack3DGame::initialize(run, a, b, c, d, e, f, seed)
            elif task == TASK_SALESMAN:
                trusted Unsafe.PointerCast:
                    run: mutable heap SalesmanGame::Run& = pointer.cast[mutable heap SalesmanGame::Run&]
                    SalesmanGame::initialize(run, a, b, c != 0, d != 0, seed)
            elif task == TASK_GRAPH_MAPPING:
                trusted Unsafe.PointerCast:
                    run: mutable heap GraphMappingGame::GraphMappingRun& = pointer.cast[mutable heap GraphMappingGame::GraphMappingRun&]
                    # v1 maps the six common option slots to the source's
                    # nodes, density, trials, exposure, adaptive, and subtle
                    # settings. The source feedback option remains enabled,
                    # matching its production default.
                    GraphMappingGame::initialize(run, a, b, c, f != 0, d, e != 0, true, seed)
            elif task == TASK_CROSSED_WIRES:
                trusted Unsafe.PointerCast:
                    run: mutable heap CrossedWiresGame::Run& = pointer.cast[mutable heap CrossedWiresGame::Run&]
