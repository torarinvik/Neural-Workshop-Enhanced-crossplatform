    # Stable API identity for the port-scoped 3D face-pattern task. The
    # catalog keeps the human-readable stable id `nback`; this numeric value is
    # only the versioned WASM handle used by the common runtime.
    const TASK_NBACK_3D: i64 = 2864510421
    const TASK_TETRIS: i64 = 679042920

    const OK: i64 = 0
    const ACCEPTED: i64 = 1
    const IGNORED: i64 = 2
    const ERR_INVALID_HANDLE: i64 = -1
    const ERR_UNSUPPORTED_TASK: i64 = -2
    const ERR_BAD_OPTIONS: i64 = -3
    const ERR_NO_MEMORY: i64 = -4
    const ERR_TABLE_FULL: i64 = -5
    const ERR_BAD_EVENT: i64 = -6
    const ERR_EVENT_ORDER: i64 = -7
    const ERR_BUFFER: i64 = -8
    const ERR_UNSUPPORTED: i64 = -9
    const ERR_TIME: i64 = -10
    const ERR_VERSION: i64 = -11

    const EVENT_ACTION: i64 = 1
    const EVENT_KEY_DOWN: i64 = 2
    const EVENT_KEY_UP: i64 = 3
    const EVENT_POINTER_MOVE: i64 = 4
    const EVENT_POINTER_DOWN: i64 = 5
    const EVENT_POINTER_UP: i64 = 6
    const EVENT_WHEEL: i64 = 7
    const EVENT_TEXT: i64 = 8
    const EVENT_FOCUS: i64 = 9
    const EVENT_VISIBILITY: i64 = 10
    const EVENT_CANCEL: i64 = 11

    const KEY_SPACE: i64 = 1
    const KEY_ENTER: i64 = 2
    const KEY_LEFT: i64 = 3
    const KEY_UP: i64 = 4
    const KEY_RIGHT: i64 = 5
    const KEY_DOWN: i64 = 6
    const KEY_ESCAPE: i64 = 7
    const KEY_UNDO: i64 = 8
    const KEY_RESTART: i64 = 9
    const KEY_OPTIONS: i64 = 10
    const KEY_LEVEL: i64 = 11
    const KEY_ONE: i64 = 12
    const KEY_TWO: i64 = 13
    const KEY_THREE: i64 = 14
    const KEY_FOUR: i64 = 15
    const KEY_FIVE: i64 = 16
    const KEY_SIX: i64 = 17
    const KEY_SEVEN: i64 = 18
    const KEY_EIGHT: i64 = 19
    const KEY_MATCH: i64 = 20

    const STATE_MAGIC: u32 = 0x3152574e
    const STATE_BYTES: i64 = 112
    # A snapshot is a self-contained fixed-layout payload. The first
    # controller supported here is Monkey Ladder: its run contains only
    # scalars, fixed arrays, and the fixed-layout MT19937 state, so a raw copy
    # is safe. Controllers containing heap/darray pointers must be added with
    # an explicit field serializer rather than being admitted accidentally.
    const SNAPSHOT_HEADER_BYTES: i64 = 16
    const SNAPSHOT_VERSION: u32 = 1
    const I64_MAX_VALUE: i64 = 9223372036854775807

    # A zero task code denotes a free slot. On destroy the handle is retained
    # as a tombstone until that slot is reused, making destroy idempotent while
    # ensuring an old handle fails after reuse.
    global mutable slot_handles: i64[SLOT_COUNT] = zeroed
    global mutable slot_tasks: i64[SLOT_COUNT] = zeroed
    global mutable slot_pointers: i64[SLOT_COUNT] = zeroed
    global mutable slot_last_time: i64[SLOT_COUNT] = zeroed
    global mutable slot_last_sequence: i64[SLOT_COUNT] = zeroed
    global mutable slot_elapsed: i64[SLOT_COUNT] = zeroed
    global mutable next_handle: i64 = 1

    def slot_for(handle: i64) -> i64:
        can Abort.Panic:
            return -1 if handle <= 0
            at: mutable i64 = 0
            while at < SLOT_COUNT |at, handle|:
                if slot_handles[at.usize()] == handle and slot_tasks[at.usize()] != 0:
                    return at
                at <- at + 1
            return -1

    def tombstone_for(handle: i64) -> bool:
        can Abort.Panic:
            return false if handle <= 0
            at: mutable i64 = 0
            while at < SLOT_COUNT |at, handle|:
                if slot_handles[at.usize()] == handle and slot_tasks[at.usize()] == 0:
                    return true
                at <- at + 1
            return false

    def free_slot() -> i64:
        can Abort.Panic:
            at: mutable i64 = 0
            while at < SLOT_COUNT |at|:
                return at if slot_tasks[at.usize()] == 0
                at <- at + 1
            return -1

    def wasm_bytes() -> u64:
        can Abort.Panic:
            return api_wasm_memory_size(0.u32()).u64() * 65536.u64()

    def valid_memory_range(pointer: i64, length: i64, alignment: i64) -> bool:
        can Abort.Panic:
            return false if pointer <= 0 or length < 0 or alignment <= 0
            return false if pointer % alignment != 0
            p: u64 = pointer.u64()
            n: u64 = length.u64()
            size: u64 = wasm_bytes()
            return false if p > size or n > size - p
            return true

    def option_bool(value: i64) -> bool:
        can Abort.Panic:
            return value == 0 or value == 1

    def valid_options(task: i64, version: i64, a: i64, b: i64, c: i64,
                      d: i64, e: i64, f: i64) -> i64:
        can Abort.Panic:
            return ERR_VERSION if version != 1
            if task == TASK_NBACK_3D:
                return ERR_BAD_OPTIONS if a < 1 or a > 8
                return ERR_BAD_OPTIONS if b < 1 or b > 6
                return ERR_BAD_OPTIONS if c < 4 or c > NBack3DGame::MAX_TRIALS
                # The original scheduler keeps trial intervals on a 100 ms
                # clock and caps them at one minute for the human route.
                return ERR_BAD_OPTIONS if d < 100 or d > 60000
                return ERR_BAD_OPTIONS if e < 1 or e > d
                return ERR_BAD_OPTIONS if f < 0 or f > 600000
                return OK
            elif task == TASK_SALESMAN:
                return ERR_BAD_OPTIONS if not SalesmanGame::allowed_start_cities(a)
                return ERR_BAD_OPTIONS if not SalesmanGame::allowed_rounds(b)
                return ERR_BAD_OPTIONS if not SalesmanGame::allowed_flag(c) or not SalesmanGame::allowed_flag(d)
                return ERR_BAD_OPTIONS if e != 0 or f != 0
                return OK
            elif task == TASK_GRAPH_MAPPING:
                return ERR_BAD_OPTIONS if not GraphMappingGame::allowed_start_nodes(a)
                return ERR_BAD_OPTIONS if not GraphMappingGame::allowed_density(b)
                return ERR_BAD_OPTIONS if not GraphMappingGame::allowed_trials(c)
                return ERR_BAD_OPTIONS if not GraphMappingGame::allowed_exposure(d)
                return ERR_BAD_OPTIONS if not GraphMappingGame::allowed_flag(e) or not GraphMappingGame::allowed_flag(f)
                return OK
            elif task == TASK_CROSSED_WIRES:
                return ERR_BAD_OPTIONS if a < 1 or a > CrossedWires::GRADE_COUNT
                return ERR_BAD_OPTIONS if not CrossedWiresGame::allowed_trials(b)
                return ERR_BAD_OPTIONS if not option_bool(c)
                return ERR_BAD_OPTIONS if not CrossedWiresGame::allowed_show_grid(d)
                return ERR_BAD_OPTIONS if e != 0 or f != 0
                return OK
            elif task == TASK_SUDOKU:
                return ERR_BAD_OPTIONS if a < 1 or a > Sudoku::GRADE_COUNT
                return ERR_BAD_OPTIONS if not SudokuGame::allowed_trials(b)
                return ERR_BAD_OPTIONS if not SudokuGame::allowed_flag(c) or not SudokuGame::allowed_flag(d)
                return ERR_BAD_OPTIONS if e != 0 or f != 0
                return OK
            elif task == TASK_MATRIX_REASONING:
                return ERR_BAD_OPTIONS if a < 1 or a > Ravens::GRADE_COUNT
                return ERR_BAD_OPTIONS if not MatrixReasoningGame::allowed_trials(b)
                return ERR_BAD_OPTIONS if not MatrixReasoningGame::allowed_exposure(c)
                return ERR_BAD_OPTIONS if not MatrixReasoningGame::allowed_bool(d)
                return ERR_BAD_OPTIONS if not MatrixReasoningGame::allowed_flags(e)
                return ERR_BAD_OPTIONS if not MatrixReasoningGame::allowed_bool(f)
                return OK
            elif task == TASK_JIGSAW:
                return ERR_BAD_OPTIONS if not JigsawGame::allowed_side(a)
                return ERR_BAD_OPTIONS if not JigsawGame::allowed_puzzles(b)
                return ERR_BAD_OPTIONS if not JigsawGame::allowed_flag(c) or not JigsawGame::allowed_flag(d)
                return ERR_BAD_OPTIONS if e != 0 or f != 0
                return OK
            elif task == TASK_GO:
                return ERR_BAD_OPTIONS if not GoGame::allowed_difficulty(a)
                return ERR_BAD_OPTIONS if not GoGame::allowed_trials(b)
                return ERR_BAD_OPTIONS if c != 0 or d != 0 or e != 0 or f != 0
                return OK
            if task == TASK_MONKEY_LADDER:
                return ERR_BAD_OPTIONS if a < 3 or a > 10
                return ERR_BAD_OPTIONS if b < 2 or b > a * a
                return ERR_BAD_OPTIONS if not option_bool(c) or not option_bool(f)
                return ERR_BAD_OPTIONS if d < 0 or d > 600000
                return ERR_BAD_OPTIONS if e < 0 or e > 600000
                return OK
            elif task == TASK_SOKOBAN:
                return ERR_BAD_OPTIONS if a < 1 or a > 16
                return ERR_BAD_OPTIONS if b < 1 or b > 1000
                return ERR_BAD_OPTIONS if not option_bool(c) or not option_bool(d)
                return ERR_BAD_OPTIONS if e != 0 or f != 0
                return OK
