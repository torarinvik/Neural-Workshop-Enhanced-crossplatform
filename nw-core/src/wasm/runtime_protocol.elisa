                    return BuzzWireGame::ACTION_START if phase == BuzzWireGame::PHASE_READY or phase == BuzzWireGame::PHASE_SETTLED or phase == BuzzWireGame::PHASE_DONE else -1
                return -1
            elif task == TASK_OUT_OF_SIGHT:
