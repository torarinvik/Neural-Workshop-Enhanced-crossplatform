    def create(task: i64, options_version: i64, a: i64, b: i64, c: i64,
               d: i64, e: i64, f: i64, seed: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
            validation: i64 = valid_options(task, options_version, a, b, c, d, e, f)
            return validation if validation != OK
            index: i64 = free_slot()
            return ERR_TABLE_FULL if index < 0
            return ERR_TABLE_FULL if next_handle <= 0 or next_handle == I64_MAX_VALUE
            bytes: i64 = run_bytes(task)
            raw: mutable heap void&? = malloc(bytes.usize())
            return ERR_NO_MEMORY if raw == null
            pointer: mutable heap void& = raw
            handle: i64 = next_handle
            next_handle <- next_handle + 1
            if initialize_session(task, pointer, a, b, c, seed):
                pass
            elif task == TASK_NBACK_3D:
                trusted Unsafe.PointerCast:
                    run: mutable heap NBack3DGame::NBack3DRun& = pointer.cast[mutable heap NBack3DGame::NBack3DRun&]
                    NBack3DGame::initialize(run, a, b, c, d, e, f, seed)
            elif task == TASK_SALESMAN:
                trusted Unsafe.PointerCast:
                    run: mutable heap SalesmanGame::Run& = pointer.cast[mutable heap SalesmanGame::Run&]
                    SalesmanGame::initialize(run, a, b, c != 0, d != 0, seed)
            elif task == TASK_GRAPH_MAPPING:
                trusted Unsafe.PointerCast:
                    run: mutable heap GraphMappingGame::GraphMappingRun& = pointer.cast[mutable heap GraphMappingGame::GraphMappingRun&]
                    # v1 maps the six common option slots to the source's
                    # nodes, density, trials, exposure, adaptive, and subtle
                    # settings. The source feedback option remains enabled,
                    # matching its production default.
                    GraphMappingGame::initialize(run, a, b, c, f != 0, d, e != 0, true, seed)
            elif task == TASK_CROSSED_WIRES:
                trusted Unsafe.PointerCast:
                    run: mutable heap CrossedWiresGame::CrossedWiresRun& = pointer.cast[mutable heap CrossedWiresGame::CrossedWiresRun&]
                    CrossedWiresGame::initialize(run, a, b, c != 0, d != 0, seed)
            elif task == TASK_SUDOKU:
                trusted Unsafe.PointerCast:
                    run: mutable heap SudokuGame::SudokuRun& = pointer.cast[mutable heap SudokuGame::SudokuRun&]
                    SudokuGame::initialize(run, a, b, c != 0, d != 0, seed)
            elif task == TASK_MATRIX_REASONING:
                trusted Unsafe.PointerCast:
                    run: mutable heap MatrixReasoningGame::MatrixReasoningRun& = pointer.cast[mutable heap MatrixReasoningGame::MatrixReasoningRun&]
                    MatrixReasoningGame::initialize(run, a, b, c, d != 0, e, f != 0, seed)
            elif task == TASK_HIDDEN_RULE:
                trusted Unsafe.PointerCast:
                    run: mutable heap HiddenRuleGame::Run& = pointer.cast[mutable heap HiddenRuleGame::Run&]
                    run[0] <- HiddenRuleGame::initialize(a, b, c != 0, seed)
            elif task == TASK_HIDDEN_WIRING:
                trusted Unsafe.PointerCast:
                    run: mutable heap HiddenWiringGame::Run& = pointer.cast[mutable heap HiddenWiringGame::Run&]
                    run[0] <- HiddenWiringGame::initialize(a, b, c != 0, seed)
            elif task == TASK_TRIAGE:
                trusted Unsafe.PointerCast:
                    run: mutable heap TriageGame::Run& = pointer.cast[mutable heap TriageGame::Run&]
                    run[0] <- TriageGame::initialize(a, b, c != 0, seed)
            elif task == TASK_FOLD_IT:
                trusted Unsafe.PointerCast:
                    run: mutable heap FoldGame::Run& = pointer.cast[mutable heap FoldGame::Run&]
                    run[0] <- FoldGame::initialize(a, b, c != 0, seed)
            elif task == TASK_WHO_KNOWS_WHAT:
                trusted Unsafe.PointerCast:
                    run: mutable heap BeliefsGame::Run& = pointer.cast[mutable heap BeliefsGame::Run&]
                    run[0] <- BeliefsGame::initialize(a, b, c != 0, seed)
