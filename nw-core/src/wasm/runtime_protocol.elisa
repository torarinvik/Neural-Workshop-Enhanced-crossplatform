                    return BuzzWireGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_OUT_OF_SIGHT:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap OutOfSightGame::OutOfSightRun& = pointer.uintptr().cast[mutable heap OutOfSightGame::OutOfSightRun&]
                    return OutOfSightGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_PURSUIT:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap PursuitGame::PursuitRun& = pointer.uintptr().cast[mutable heap PursuitGame::PursuitRun&]
                    return PursuitGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_DONKEY:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap DonkeyGame::DonkeyRun& = pointer.uintptr().cast[mutable heap DonkeyGame::DonkeyRun&]
                    return DonkeyGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_OVERRUN:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap OverrunGame::OverrunGameRun& = pointer.uintptr().cast[mutable heap OverrunGame::OverrunGameRun&]
                    return OverrunGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_TWO_HANDS:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap TwoHandsGame::TwoHandsRun& = pointer.uintptr().cast[mutable heap TwoHandsGame::TwoHandsRun&]
                    return TwoHandsGame::advance(run, logical_time_ms)
            return ACCEPTED

    def append_u32(out: mutable darray[u8]&, value: u32):
        can Memory.Allocate, Abort.Panic:
            out.push((value & 255.u32()).u8())
            out.push(((value >> 8.u32()) & 255.u32()).u8())
            out.push(((value >> 16.u32()) & 255.u32()).u8())
            out.push(((value >> 24.u32()) & 255.u32()).u8())

    def append_u16(out: mutable darray[u8]&, value: u16):
        can Memory.Allocate, Abort.Panic:
            out.push((value & 255.u16()).u8())
            out.push(((value >> 8.u16()) & 255.u16()).u8())

    def append_i64(out: mutable darray[u8]&, value: i64):
        can Memory.Allocate, Abort.Panic:
            bits: u64 = value.u64()
            at: mutable i64 = 0
            while at < 8 |out, bits, at|:
                shift: u64 = at.u64() * 8.u64()
                out.push(((bits >> shift) & 255.u64()).u8())
                at <- at + 1

    def append_u64(out: mutable darray[u8]&, value: u64):
        can Memory.Allocate, Abort.Panic:
            at: mutable i64 = 0
            while at < 8 |out, value, at|:
                shift: u64 = at.u64() * 8.u64()
                out.push(((value >> shift) & 255.u64()).u8())
                at <- at + 1

    def append_f64(out: mutable darray[u8]&, value: f64):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                bits: mutable u64 = 0
                memcpy((&bits).cast[mutable void&], (&value).cast[void&], 8.usize())
                append_u64(out, bits)

    def sokoban_snapshot_payload(index: i64, pointer: i64) -> darray[u8]:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
            out: mutable darray[u8] = []
            trusted Unsafe.PointerCast:
                run: heap SokobanGame::SokobanRun& = pointer.uintptr().cast[heap SokobanGame::SokobanRun&]
                append_i64(&out, run.start_rung)
                append_i64(&out, run.total_trials)
                append_i64(&out, 1 if run.adaptive else 0)
                append_i64(&out, 1 if run.show_traps else 0)
                append_i64(&out, run.seed)
                at: mutable i64 = 0
                while at < 624 |at, run, out|:
                    append_u32(&out, run.rng.mt[at.usize()])
                    at <- at + 1
                append_u32(&out, run.rng.mti.u32())
                at <- 0
                while at < 256 |at, run, out|:
                    append_i64(&out, run.walls[at.usize()])
                    append_i64(&out, run.goals[at.usize()])
                    append_i64(&out, run.traps[at.usize()])
                    append_i64(&out, run.boxes[at.usize()])
                    append_i64(&out, run.start_boxes[at.usize()])
                    at <- at + 1
                append_i64(&out, run.width)
                append_i64(&out, run.height)
                append_i64(&out, run.cells)
                append_i64(&out, run.minimum)
                append_i64(&out, run.at_least)
                append_i64(&out, run.bound)
                append_i64(&out, run.rung)
                append_i64(&out, run.trial)
                append_i64(&out, run.phase)
                append_i64(&out, run.verdict)
                append_i64(&out, run.player)
                append_i64(&out, run.start_player)
                append_i64(&out, run.pushes)
                append_i64(&out, run.moves)
                append_i64(&out, run.par)
                append_i64(&out, run.started_at_ms)
                append_i64(&out, run.took_seconds)
                append_i64(&out, run.solved_count)
                append_i64(&out, run.lost_count)
                append_i64(&out, run.total_par)
                append_i64(&out, run.total_pushes)
                append_i64(&out, run.best_rung)
                append_i64(&out, 1 if run.has_level else 0)
                append_i64(&out, slot_last_time[index.usize()])
                append_i64(&out, slot_last_sequence[index.usize()])
                append_i64(&out, slot_elapsed[index.usize()])
                append_u32(&out, run.history_count.u32())
                at <- 0
                while at < run.history_count |at, run, out|:
                    append_u16(&out, SokobanGame::history_get(run, at))
                    at <- at + 1
            return out

    def snapshot_sokoban(index: i64, dest: i64, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
            pointer: i64 = slot_pointers[index.usize()]
            trusted Unsafe.PointerCast:
                run: heap SokobanGame::SokobanRun& = pointer.uintptr().cast[heap SokobanGame::SokobanRun&]
                return ERR_UNSUPPORTED if run.history_count < 0 or run.history_count > 2147483000
                payload_bytes: i64 = SOKOBAN_SNAPSHOT_FIXED_BYTES + run.history_count * 2
                total: i64 = SNAPSHOT_HEADER_BYTES + payload_bytes
                return ERR_BUFFER if capacity < total or not valid_memory_range(dest, total, 1)
                header: mutable darray[u8] = []
                append_u32(&header, STATE_MAGIC)
                append_u32(&header, SOKOBAN_SNAPSHOT_VERSION)
                append_u32(&header, TASK_SOKOBAN.u32())
                append_u32(&header, payload_bytes.u32())
                payload: darray[u8] = sokoban_snapshot_payload(index, pointer)
                return ERR_UNSUPPORTED if payload.count.i64() != payload_bytes
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&header[0]).cast[void&], SNAPSHOT_HEADER_BYTES.usize())
                payload_target: mutable u8& = (dest + SNAPSHOT_HEADER_BYTES).uintptr().cast[mutable u8&]
                memcpy(payload_target.cast[mutable void&], (&payload[0]).cast[void&], payload_bytes.usize())
                return total

    def tetris_snapshot_payload(index: i64, pointer: i64) -> darray[u8]:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
            out: mutable darray[u8] = []
            trusted Unsafe.PointerCast:
                run: heap TetrisGame::TetrisRun& = pointer.uintptr().cast[heap TetrisGame::TetrisRun&]
                at: mutable i64 = 0
                while at < 624 |at, run, out|:
                    append_u32(&out, run.rng.mt[at.usize()])
                    at <- at + 1
                append_u32(&out, run.rng.mti.u32())
                append_i64(&out, run.cols)
                append_i64(&out, run.rows)
                append_i64(&out, run.start_rung)
                append_i64(&out, run.rung)
                append_i64(&out, run.target)
                append_i64(&out, run.queue_size)
                append_i64(&out, run.phase)
                append_i64(&out, run.piece)
                append_i64(&out, run.score)
                append_i64(&out, run.selected)
                append_i64(&out, run.quarter)
                append_i64(&out, run.column)
                append_i64(&out, run.row)
                append_i64(&out, run.remainder)
                at <- 0
                while at < TetrisGame::MAX_BOARD_CELLS |at, run, out|:
                    append_i64(&out, run.board[at.usize()])
                    at <- at + 1
                at <- 0
                while at < TetrisGame::MAX_PIECES |at, run, out|:
                    append_i64(&out, run.queue_count[at.usize()])
                    at <- at + 1
                at <- 0
                while at < TetrisGame::MAX_PIECES |at, run, out|:
                    append_i64(&out, run.queue_fits[at.usize()])
                    at <- at + 1
                at <- 0
                while at < TetrisGame::MAX_PIECES |at, run, out|:
                    append_i64(&out, run.queue_recut[at.usize()])
                    at <- at + 1
                at <- 0
                while at < TetrisGame::MAX_PIECES * TetrisGame::MAX_PIECE_CELLS |at, run, out|:
                    append_i64(&out, run.queue_x[at.usize()])
                    at <- at + 1
                at <- 0
                while at < TetrisGame::MAX_PIECES * TetrisGame::MAX_PIECE_CELLS |at, run, out|:
                    append_i64(&out, run.queue_y[at.usize()])
                    at <- at + 1
                append_i64(&out, run.active_count)
                at <- 0
                while at < TetrisGame::MAX_PIECE_CELLS |at, run, out|:
                    append_i64(&out, run.active_x[at.usize()])
                    at <- at + 1
                at <- 0
                while at < TetrisGame::MAX_PIECE_CELLS |at, run, out|:
                    append_i64(&out, run.active_y[at.usize()])
                    at <- at + 1
                append_i64(&out, run.clean)
                append_i64(&out, run.buried)
                append_i64(&out, run.lines)
                append_i64(&out, run.streak)
                append_i64(&out, run.slips)
                append_i64(&out, run.best_rung)
                append_i64(&out, slot_last_time[index.usize()])
                append_i64(&out, slot_last_sequence[index.usize()])
                append_i64(&out, slot_elapsed[index.usize()])
            return out

    def snapshot_tetris(index: i64, dest: i64, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
            total: i64 = SNAPSHOT_HEADER_BYTES + TETRIS_SNAPSHOT_FIXED_BYTES
            return ERR_BUFFER if capacity < total or not valid_memory_range(dest, total, 1)
            header: mutable darray[u8] = []
            append_u32(&header, STATE_MAGIC)
            append_u32(&header, TETRIS_SNAPSHOT_VERSION)
            append_u32(&header, TASK_TETRIS.u32())
            append_u32(&header, TETRIS_SNAPSHOT_FIXED_BYTES.u32())
            payload: darray[u8] = tetris_snapshot_payload(index, slot_pointers[index.usize()])
            return ERR_UNSUPPORTED if payload.count.i64() != TETRIS_SNAPSHOT_FIXED_BYTES
            target: mutable u8& = dest.uintptr().cast[mutable u8&]
            memcpy(target.cast[mutable void&], (&header[0]).cast[void&], SNAPSHOT_HEADER_BYTES.usize())
            payload_target: mutable u8& = (dest + SNAPSHOT_HEADER_BYTES).uintptr().cast[mutable u8&]
            memcpy(payload_target.cast[mutable void&], (&payload[0]).cast[void&], TETRIS_SNAPSHOT_FIXED_BYTES.usize())
            return total

