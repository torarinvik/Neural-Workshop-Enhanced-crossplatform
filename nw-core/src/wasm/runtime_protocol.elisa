    def what_next_task_id() -> i64:
        return TASK_WHAT_NEXT

    def what_next_options_note(dest: i64, capacity: i64, rung: i64, clips: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            return ERR_BAD_OPTIONS if not WhatNextGame::allowed_rung(rung) or clips < 0
