                    run: mutable heap SemaphoreGame::Session& = pointer.uintptr().cast[mutable heap SemaphoreGame::Session&]
                    if action == SemaphoreGame::START:
                        return ACCEPTED if (SemaphoreGame::start(run, now_ms.f64() / 1000.0) can Global{Read,Write}) else IGNORED
                    return ACCEPTED if (SemaphoreGame::input(run, action) can Global{Read,Write}) else IGNORED
            elif task == TASK_CIPHER_ABYSS:
                trusted Unsafe.PointerCast:
                    run: mutable heap CipherAbyssGame::Session& = pointer.uintptr().cast[mutable heap CipherAbyssGame::Session&]
                    if action == CipherAbyssGame::START:
                        return ACCEPTED if (CipherAbyssGame::start(run, now_ms.f64() / 1000.0) can Global{Read,Write}) else IGNORED
                    return ACCEPTED if (CipherAbyssGame::input(run, action) can Global{Read,Write}) else IGNORED
            elif task == TASK_ROVER:
                trusted Unsafe.PointerCast:
                    run: mutable heap RoverGame::Session& = pointer.uintptr().cast[mutable heap RoverGame::Session&]
                    if action == RoverGame::START:
                        return ACCEPTED if (RoverGame::start(run, now_ms.f64() / 1000.0) can Global{Read,Write}) else IGNORED
                    return ACCEPTED if RoverGame::steer(run, action) else IGNORED
            elif task == TASK_STOP_SWITCH:
                trusted Unsafe.PointerCast:
                    run: mutable heap StopSwitchGame::Run& = pointer.uintptr().cast[mutable heap StopSwitchGame::Run&]
                    return ACCEPTED if StopSwitchGame::steer(run, action, now_ms.f64() / 1000.0) else IGNORED
            elif task == TASK_FALLS:
                trusted Unsafe.PointerCast:
                    run: mutable heap FallsGame::Run& = pointer.uintptr().cast[mutable heap FallsGame::Run&]
                    if action == 0:
                        return ACCEPTED if FallsGame::start(run, now_ms) else IGNORED
                    return ACCEPTED if FallsGame::choose(run, value, now_ms) else IGNORED
            elif task == TASK_WHAT_NEXT:
                trusted Unsafe.PointerCast:
                    run: mutable heap WhatNextGame::Run& = pointer.uintptr().cast[mutable heap WhatNextGame::Run&]
                    if action == 0:
                        return ACCEPTED if WhatNextGame::start(run) else IGNORED
                    if action == 1:
                        return ACCEPTED if WhatNextGame::choose(run, value, now_ms.f64() / 1000.0) else IGNORED
                    return ACCEPTED if WhatNextGame::unavailable(run) else IGNORED
            elif task == TASK_VIDEO_SEQUENCE:
                trusted Unsafe.PointerCast:
                    run: mutable heap VideoSequence::Run& = pointer.uintptr().cast[mutable heap VideoSequence::Run&]
                    if action == VideoSequence::ACTION_START:
                        return ACCEPTED if VideoSequence::start(run) else IGNORED
                    if action == VideoSequence::ACTION_PICK:
                        return ACCEPTED if VideoSequence::pick(run, value, now_ms) else IGNORED
                    if action == VideoSequence::ACTION_CLIP_READY:
                        return ACCEPTED if VideoSequence::load_clip(run, value, now_ms) else IGNORED
                    if action == VideoSequence::ACTION_CLIP_UNAVAILABLE:
                        return ACCEPTED if VideoSequence::unavailable(run) else IGNORED
                    return ERR_BAD_EVENT
            elif task == TASK_JIGSAW:
                trusted Unsafe.PointerCast:
                    run: mutable heap JigsawGame::JigsawRun& = pointer.uintptr().cast[mutable heap JigsawGame::JigsawRun&]
                    return JigsawGame::apply(run, action, value, now_ms)
            elif task == TASK_GO:
                trusted Unsafe.PointerCast:
                    run: mutable heap GoGame::GoRun& = pointer.uintptr().cast[mutable heap GoGame::GoRun&]
                    return GoGame::apply(run, action, value, now_ms)
            elif task == TASK_MONKEY_LADDER:
                trusted Unsafe.PointerCast:
                    run: mutable heap MonkeyLadderGame::MonkeyLadderRun& = pointer.uintptr().cast[mutable heap MonkeyLadderGame::MonkeyLadderRun&]
                    return IGNORED if not can_monkey_action(run, action, value, now_ms)
                    MonkeyLadderGame::action(run, action, value, now_ms)
                    return ACCEPTED
            elif task == TASK_SOKOBAN:
                trusted Unsafe.PointerCast:
                    run: mutable heap SokobanGame::SokobanRun& = pointer.uintptr().cast[mutable heap SokobanGame::SokobanRun&]
                    phase: i64 = SokobanGame::info(run, SokobanGame::INFO_PHASE)
                    if action == SokobanGame::ACTION_SPACE:
                        return IGNORED if phase != SokobanGame::PHASE_READY and phase != SokobanGame::PHASE_DONE and phase != SokobanGame::PHASE_SOLVED and phase != SokobanGame::PHASE_LOST
                    elif action >= SokobanGame::ACTION_UP and action <= SokobanGame::ACTION_RIGHT:
                        return IGNORED if phase != SokobanGame::PHASE_PUSHING
                    elif action == SokobanGame::ACTION_UNDO or action == SokobanGame::ACTION_RESTART:
                        return IGNORED if phase != SokobanGame::PHASE_PUSHING
                    else:
                        return ERR_BAD_EVENT
                    SokobanGame::apply(run, action, now_ms)
                    return ACCEPTED
            elif task == TASK_SOKOBAN_3D:
                trusted Unsafe.PointerCast:
                    run: mutable heap Sokoban3DGame::Run& = pointer.uintptr().cast[mutable heap Sokoban3DGame::Run&]
                    phase: i64 = Sokoban3DGame::info(run, Sokoban3DGame::INFO_PHASE)
                    if action == Sokoban3DGame::ACTION_START:
                        return IGNORED if phase != Sokoban3DGame::PHASE_READY and phase != Sokoban3DGame::PHASE_DONE and phase != Sokoban3DGame::PHASE_SOLVED and phase != Sokoban3DGame::PHASE_LOST
                    elif action >= Sokoban3DGame::ACTION_AHEAD and action <= Sokoban3DGame::ACTION_RIGHT:
                        return IGNORED if phase != Sokoban3DGame::PHASE_PUSHING
                    elif action == Sokoban3DGame::ACTION_UNDO or action == Sokoban3DGame::ACTION_RESTART:
                        return IGNORED if phase != Sokoban3DGame::PHASE_PUSHING
                    else:
                        return ERR_BAD_EVENT
                    return ACCEPTED if Sokoban3DGame::apply(run, action, now_ms) == 1 else IGNORED
            elif task == TASK_COUNT:
                trusted Unsafe.PointerCast:
                    run: mutable heap CountingGame::CountingRun& = pointer.uintptr().cast[mutable heap CountingGame::CountingRun&]
                    return CountingGame::apply(run, action, value, now_ms)
            elif task == TASK_HANOI:
                trusted Unsafe.PointerCast:
                    run: mutable heap HanoiGame::Run& = pointer.uintptr().cast[mutable heap HanoiGame::Run&]
                    return HanoiGame::apply(run, action, value, now_ms)
            elif task == TASK_COOKIE_THIEF:
                trusted Unsafe.PointerCast:
                    run: mutable heap CookieThiefGame::Run& = pointer.uintptr().cast[mutable heap CookieThiefGame::Run&]
                    if action == CookieThiefGame::ACTION_START:
                        return ACCEPTED if CookieThiefGame::start_or_next(run, now_ms) else IGNORED
                    if action == CookieThiefGame::ACTION_WAIT:
                        return IGNORED if run.phase != CookieThiefGame::PHASE_RUNNING
                        _ = CookieThiefGame::press(run, CookieThief::WAIT)
                        return ACCEPTED
                    return ACCEPTED if CookieThiefGame::press(run, action - CookieThiefGame::ACTION_GRAB) else IGNORED
            elif task == TASK_MAZE:
                trusted Unsafe.PointerCast:
                    run: mutable heap MazeGame::Run& = pointer.uintptr().cast[mutable heap MazeGame::Run&]
                    return MazeGame::apply(run, action, now_ms)
            elif task == TASK_YOU_ARE_HERE:
