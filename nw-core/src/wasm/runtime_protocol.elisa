    const TASK_SHADOW_PLAY: i64 = 2286122724
    const TASK_TUNER: i64 = 4284132915
    const TASK_DRSHAPE: i64 = 2055552569
    const TASK_SFM: i64 = 464666890
    const TASK_FALLS: i64 = 1273236717
    const TASK_WHAT_NEXT: i64 = 1283785889
    const TASK_VIDEO_SEQUENCE: i64 = 3061430628
    const TASK_GO: i64 = 2946453024
    const TASK_ALGEBRA: i64 = 4281979399
    const TASK_SCRAMBLE: i64 = 993915390
    const TASK_SCRABBLE: i64 = 1272532037
    const TASK_CROSSWORD: i64 = 1085963879
    const TASK_SYLLOGISM: i64 = 199098354
    const TASK_CHESS: i64 = 2605208591
    const TASK_VERBAL: i64 = 1300493934
    # Stable API identity for the port-scoped 3D face-pattern task. The
    # catalog keeps the human-readable stable id `nback`; this numeric value is
    # only the versioned WASM handle used by the common runtime.
    const TASK_NBACK_3D: i64 = 2864510421
    const TASK_TETRIS: i64 = 679042920

    const OK: i64 = 0
    const ACCEPTED: i64 = 1
    const IGNORED: i64 = 2
    const ERR_INVALID_HANDLE: i64 = -1
    const ERR_UNSUPPORTED_TASK: i64 = -2
    const ERR_BAD_OPTIONS: i64 = -3
    const ERR_NO_MEMORY: i64 = -4
    const ERR_TABLE_FULL: i64 = -5
    const ERR_BAD_EVENT: i64 = -6
    const ERR_EVENT_ORDER: i64 = -7
    const ERR_BUFFER: i64 = -8
    const ERR_UNSUPPORTED: i64 = -9
    const ERR_TIME: i64 = -10
    const ERR_VERSION: i64 = -11

    const EVENT_ACTION: i64 = 1
    const EVENT_KEY_DOWN: i64 = 2
    const EVENT_KEY_UP: i64 = 3
    const EVENT_POINTER_MOVE: i64 = 4
    const EVENT_POINTER_DOWN: i64 = 5
    const EVENT_POINTER_UP: i64 = 6
    const EVENT_WHEEL: i64 = 7
    const EVENT_TEXT: i64 = 8
    const EVENT_FOCUS: i64 = 9
    const EVENT_VISIBILITY: i64 = 10
    const EVENT_CANCEL: i64 = 11

    const KEY_SPACE: i64 = 1
    const KEY_ENTER: i64 = 2
    const KEY_LEFT: i64 = 3
    const KEY_UP: i64 = 4
    const KEY_RIGHT: i64 = 5
    const KEY_DOWN: i64 = 6
    const KEY_ESCAPE: i64 = 7
    const KEY_UNDO: i64 = 8
    const KEY_RESTART: i64 = 9
    const KEY_OPTIONS: i64 = 10
    const KEY_LEVEL: i64 = 11
    const KEY_ONE: i64 = 12
    const KEY_TWO: i64 = 13
    const KEY_THREE: i64 = 14
    const KEY_FOUR: i64 = 15
    const KEY_FIVE: i64 = 16
    const KEY_SIX: i64 = 17
    const KEY_SEVEN: i64 = 18
    const KEY_EIGHT: i64 = 19
    const KEY_MATCH: i64 = 20
    const KEY_NINE: i64 = 21
    const KEY_ZERO: i64 = 22
    const KEY_TAB: i64 = 23
    const KEY_SHIFT: i64 = 24
    const KEY_BACKSPACE: i64 = 25
    const KEY_DAM_GATE_FIRST: i64 = 26
    const KEY_DAM_GATE_LAST: i64 = 31
    const KEY_SONAR_PING: i64 = 32
    const KEY_SONAR_DIG: i64 = 33
    const KEY_GAMBLE_STOP: i64 = 34
    const KEY_DISPATCH_INCIDENT: i64 = 35
    const KEY_DISPATCH_STATION: i64 = KEY_DISPATCH_INCIDENT + Dispatch::SLOTS

    const KEY_RAILYARD_Q: i64 = 64
    const KEY_RAILYARD_W: i64 = 65

    const KEY_AIRTRAFFIC_HOLD: i64 = 66
    const KEY_AIRTRAFFIC_LAND: i64 = 67
    const KEY_KITCHEN_FIRST: i64 = 68
    const KEY_KITCHEN_LAST: i64 = 76
    const KEY_CRANE_ALIAS_FIRST: i64 = 77
    const KEY_CRANE_ALIAS_LAST: i64 = 80
    const KEY_ROUND_THROW_LEFT: i64 = 81
    const KEY_ROUND_THROW_RIGHT: i64 = 82
    const KEY_HEAVIER_PICK_FIRST: i64 = 83
    const KEY_COG_DEEPER: i64 = 87
    const KEY_COG_NEARER: i64 = 88
    const KEY_CIPHER_TEST: i64 = 89
    const KEY_CIPHER_CHECK: i64 = 90
    const KEY_CIPHER_SUBMIT: i64 = 91
    const KEY_CIPHER_PREDICT: i64 = 92
    const KEY_CIPHER_PAGE_UP: i64 = 93
    const KEY_CIPHER_PAGE_DOWN: i64 = 94
    const KEY_CIPHER_MARK: i64 = 95
    const KEY_CIPHER_NUMBERS: i64 = 96
    const KEY_CIPHER_SORT: i64 = 97
    const KEY_LOCK_PICK_T: i64 = 98
    # Air Hockey: A and D slide the bar exactly as Left and Right do, as
    # separately held keys, so letting go of one leaves the other held.
    const KEY_AIR_HOCKEY_A: i64 = 99
    const KEY_AIR_HOCKEY_D: i64 = 100
    # Shadow Puppets: Q and E roll the figure while held, each on its own.
    const KEY_PUPPET_Q: i64 = 101
    const KEY_PUPPET_E: i64 = 102
    # Kerbside: W and S walk and step back as Up and Down do, each held on its own.
    const KEY_KERB_W: i64 = KEY_CRANE_ALIAS_FIRST
    const KEY_KERB_S: i64 = KEY_CRANE_ALIAS_FIRST + 1
    # By Ear: the keys from C to the C above, A W S E D F T G Y H U J K.
    const KEY_BY_EAR_FIRST: i64 = 103

    # Steadicam: Left or A, Right or D, Up or W, Down or S, E and Q, each held
    # on its own, one bit each in the reference's order.
    def steadicam_key_bit(code: i64) -> i64:
        return 1 if code == KEY_LEFT else (2 if code == KEY_AIR_HOCKEY_A else (4 if code == KEY_RIGHT else (8 if code == KEY_AIR_HOCKEY_D else
            (16 if code == KEY_UP else (32 if code == KEY_KERB_W else (64 if code == KEY_DOWN else (128 if code == KEY_KERB_S else
            (256 if code == KEY_PUPPET_E else (512 if code == KEY_PUPPET_Q else 0)))))))))

    # Free Kick: Left and Right aim, Up and Down raise and lower, A and D
    # curl, W and S kick harder and softer, each held on its own, one bit
    # each in the reference's order. Space kicks.
    def free_kick_key_bit(code: i64) -> i64:
        return 1 if code == KEY_LEFT else (2 if code == KEY_RIGHT else (4 if code == KEY_UP else (8 if code == KEY_DOWN else
            (16 if code == KEY_AIR_HOCKEY_A else (32 if code == KEY_AIR_HOCKEY_D else (64 if code == KEY_KERB_W else
            (128 if code == KEY_KERB_S else 0)))))))

    def claw_machine_key_bit(code: i64) -> i64:
        return 1 if code == KEY_LEFT else (2 if code == KEY_AIR_HOCKEY_A else (4 if code == KEY_RIGHT else (8 if code == KEY_AIR_HOCKEY_D else
            (16 if code == KEY_UP else (32 if code == KEY_KERB_W else (64 if code == KEY_DOWN else
            (128 if code == KEY_KERB_S else 0)))))))

    def cricket_hunt_key_bit(code: i64) -> i64:
        return 1 if code == KEY_KERB_W else (2 if code == KEY_UP else (4 if code == KEY_KERB_S else (8 if code == KEY_DOWN else
            (16 if code == KEY_AIR_HOCKEY_A else (32 if code == KEY_LEFT else (64 if code == KEY_AIR_HOCKEY_D else
            (128 if code == KEY_RIGHT else (256 if code == KEY_PUPPET_Q else (512 if code == KEY_PUPPET_E else 0)))))))))

    def piano_tuner_key_bit(code: i64) -> i64:
        return 1 if code == KEY_UP else (2 if code == KEY_KERB_W else (4 if code == KEY_DOWN else (8 if code == KEY_KERB_S else
            (16 if code == KEY_SHIFT else 0))))

    def glove_key_bit(code: i64) -> i64:
        return 1 if code == KEY_UP else (2 if code == KEY_KERB_W else (4 if code == KEY_DOWN else (8 if code == KEY_KERB_S else
            (16 if code == KEY_LEFT else (32 if code == KEY_AIR_HOCKEY_A else (64 if code == KEY_RIGHT else
            (128 if code == KEY_AIR_HOCKEY_D else 0)))))))

    const STATE_MAGIC: u32 = 0x3152574e
    const STATE_BYTES: i64 = 112
# Legacy raw v1 restore remains available only for same-build checkpoints
# of inline 3D N-Back, Monkey Ladder, and Tetris records. New snapshots use
# field serializers: Sokoban v2, Tetris v3, N-Back v4, Monkey Ladder v5, and
# Count v6.
    const SNAPSHOT_HEADER_BYTES: i64 = 16
    const SNAPSHOT_VERSION: u32 = 1
    const SOKOBAN_SNAPSHOT_VERSION: u32 = 2
    const TETRIS_SNAPSHOT_VERSION: u32 = 3
    const NBACK3D_SNAPSHOT_VERSION: u32 = 4
    const MONKEY_LADDER_SNAPSHOT_VERSION: u32 = 5
    const COUNT_SNAPSHOT_VERSION: u32 = 6
    # Stable v2 Sokoban payload: five option/seed i64s, 624 MT words plus the
    # MT cursor, five 256-entry i64 board arrays, 23 run-state i64s, three
    # common event-clock/order i64s, and a trailing u32 undo count. Each
    # history entry is a little-endian u16. No host pointers or compiler record
    # padding are present.
    const SOKOBAN_SNAPSHOT_FIXED_BYTES: i64 = 12992
    # Tetris v3: 624 MT words + cursor; 3,239 i64 controller/board/hand
    # fields; and three i64 protocol clock/order fields. All values are
    # serialized explicitly, with no compiler record padding or pointers.
    const TETRIS_SNAPSHOT_FIXED_BYTES: i64 = 28436
    # 3D N-Back v4 stores 225 i64 fields: all controller scalars, both
    # 100-entry stimulus arrays, booleans, counters, and protocol clocks.
    const NBACK3D_SNAPSHOT_FIXED_BYTES: i64 = 1800
    # Monkey Ladder v5 stores its 624-word MT state, two 100-entry i64 arrays,
    # controller/options scalars, booleans, and protocol clocks.
    const MONKEY_LADDER_SNAPSHOT_FIXED_BYTES: i64 = 4252
    # Count v6 contains 2,500 bytes of MT state, a shape-count i64, up to 60
    # 72-byte field-serialized shapes, 17 controller i64s, and three protocol
    # clock/order i64s. The minimum excludes active shapes.
    const COUNT_SNAPSHOT_FIXED_BYTES: i64 = 2668
    const COUNT_SHAPE_SNAPSHOT_BYTES: i64 = 72
    const COUNT_SNAPSHOT_MAX_BYTES: i64 = 6988
    const I64_MAX_VALUE: i64 = 9223372036854775807

    # A zero task code denotes a free slot. On destroy the handle is retained
    # as a tombstone until that slot is reused, making destroy idempotent while
    # ensuring an old handle fails after reuse.
    global mutable slot_handles: i64[SLOT_COUNT] = zeroed
    global mutable slot_tasks: i64[SLOT_COUNT] = zeroed
    global mutable slot_pointers: i64[SLOT_COUNT] = zeroed
    global mutable slot_last_time: i64[SLOT_COUNT] = zeroed
    global mutable slot_last_sequence: i64[SLOT_COUNT] = zeroed
    global mutable slot_elapsed: i64[SLOT_COUNT] = zeroed
    global mutable next_handle: i64 = 1

    def slot_for(handle: i64) -> i64:
        can Abort.Panic, Global.Read:
            return -1 if handle <= 0
            at: mutable i64 = 0
            while at < SLOT_COUNT |at, handle|:
                if slot_handles[at.usize()] == handle and slot_tasks[at.usize()] != 0:
                    return at
                at <- at + 1
            return -1

    def tombstone_for(handle: i64) -> bool:
        can Abort.Panic, Global.Read:
            return false if handle <= 0
            at: mutable i64 = 0
            while at < SLOT_COUNT |at, handle|:
                if slot_handles[at.usize()] == handle and slot_tasks[at.usize()] == 0:
                    return true
                at <- at + 1
            return false

    def free_slot() -> i64:
        can Abort.Panic, Global.Read:
            at: mutable i64 = 0
            while at < SLOT_COUNT |at|:
                return at if slot_tasks[at.usize()] == 0
                at <- at + 1
            return -1

    def wasm_bytes() -> u64:
        can Abort.Panic:
            return api_wasm_memory_size(0.u32()).u64() * 65536.u64()

    def valid_memory_range(pointer: i64, length: i64, alignment: i64) -> bool:
        can Abort.Panic:
            return false if pointer <= 0 or length < 0 or alignment <= 0
            return false if pointer % alignment != 0
            p: u64 = pointer.u64()
            n: u64 = length.u64()
            size: u64 = wasm_bytes()
            return false if p > size or n > size - p
            return true

    def write_frame_export_header(output: i64, capacity: i64, sequence: u64, timestamp_ns: u64,
                                  width: u32, height: u32, consumed: bool) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return -1 if capacity < FrameExport::HEADER_BYTES or not valid_memory_range(output, FrameExport::HEADER_BYTES, 1)
            trusted Unsafe.PointerCast:
                return FrameExport::write_header(output.uintptr().cast[mutable u8&], capacity,
                    sequence, timestamp_ns, width, height, consumed)

    def frame_digest(input: i64, bytes: i64, output: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return -1 if not valid_memory_range(input, bytes, 1) or not valid_memory_range(output, 64, 1)
            trusted Unsafe.PointerCast:
                return public_frame_digest(input.uintptr().cast[u8&], bytes, output.uintptr().cast[mutable u8&])

    def verify_outcome_frame(rgba: i64, bytes: i64, width: i64, height: i64, expected: i64, scalar: f64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return -1 if not valid_memory_range(rgba, bytes, 1) or not valid_memory_range(expected, 64, 1)
            trusted Unsafe.PointerCast:
                return public_outcome_verify_frame(rgba.uintptr().cast[u8&], bytes, width, height,
                    expected.uintptr().cast[u8&], scalar)

    def verify_outcome_evidence_mode(rgba: i64, bytes: i64, width: i64, height: i64,
                                evidence: i64, count: i64, archive: i64,
                                receipt_id: i64, receipt: i64, scalar: f64, allow_concession: bool) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return -1 if count <= 0 or count > wasm_bytes().i64() / OutcomeEvidence::DIGEST_BYTES
            digest_bytes: i64 = count * OutcomeEvidence::DIGEST_BYTES
            return -1 if not valid_memory_range(rgba, bytes, 1) or not valid_memory_range(evidence, digest_bytes, 1)
            trusted Unsafe.PointerCast:
                frames: mutable i64&? = null
                record: mutable i64&? = null
                if archive != 0:
                    return -1 if not valid_memory_range(archive, count * OutcomeEvidence::FRAME_WORDS * 8, 8)
                    rows: mutable i64& = archive.uintptr().cast[mutable i64&]
                    for index in 0..<count |index, rows|:
                        offset: usize = (index * OutcomeEvidence::FRAME_WORDS).usize()
                        address: i64 = rows[offset]
                        return -1 if address != 0 and not valid_memory_range(address, rows[offset + 1.usize()], 1)
                    frames <- rows
                if receipt != 0 and receipt_id >= 0:
                    return -1 if not valid_memory_range(receipt, OutcomeEvidence::RECEIPT_WORDS * 8, 8)
                    row: mutable i64& = receipt.uintptr().cast[mutable i64&]
                    return -1 if row[3] != 0 and not valid_memory_range(row[3], OutcomeEvidence::DIGEST_BYTES, 1)
                    return -1 if row[4] != 0 and not valid_memory_range(row[4], OutcomeEvidence::DIGEST_BYTES, 1)
                    return -1 if row[5] != 0 and row[6] == count and not valid_memory_range(row[5], digest_bytes, 1)
                    record <- row
                return public_outcome_verify_evidence_mode(rgba.uintptr().cast[u8&], bytes, width, height,
                    evidence.uintptr().cast[u8&], count, frames, receipt_id, record, scalar, allow_concession)

    def verify_outcome_evidence(rgba: i64, bytes: i64, width: i64, height: i64,
                                evidence: i64, count: i64, archive: i64,
                                receipt_id: i64, receipt: i64, scalar: f64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return verify_outcome_evidence_mode(rgba, bytes, width, height, evidence, count,
                archive, receipt_id, receipt, scalar, false)

    def verify_outcome_task_evidence(rgba: i64, bytes: i64, width: i64, height: i64,
                                     evidence: i64, count: i64, archive: i64,
                                     receipt_id: i64, receipt: i64, scalar: f64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return verify_outcome_evidence_mode(rgba, bytes, width, height, evidence, count,
                archive, receipt_id, receipt, scalar, true)

    def read_public_outcome(rgba: i64, bytes: i64, width: i64, height: i64, output: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return PublicOutcome::INVALID_FRAME if not valid_memory_range(rgba, bytes, 1) or not valid_memory_range(output, size_of(PublicOutcome::Labels).i64(), 8)
            trusted Unsafe.PointerCast:
                return public_outcome_read(rgba.uintptr().cast[u8&], bytes, width, height,
                    output.uintptr().cast[mutable PublicOutcome::Labels&])

    def option_bool(value: i64) -> bool:
        can Abort.Panic:
            return value == 0 or value == 1

    def valid_options(task: i64, version: i64, a: i64, b: i64, c: i64,
                      d: i64, e: i64, f: i64) -> i64:
        can Abort.Panic:
            return ERR_VERSION if version != 1 and (task != TASK_JIGSAW or version != 2)
            if task == TASK_NBACK_3D:
                return ERR_BAD_OPTIONS if a < 1 or a > 8
                return ERR_BAD_OPTIONS if b < 1 or b > 6
                return ERR_BAD_OPTIONS if c < 4 or c > NBack3DGame::MAX_TRIALS
                # The original scheduler keeps trial intervals on a 100 ms
                # clock and caps them at one minute for the human route.
                return ERR_BAD_OPTIONS if d < 100 or d > 60000
                return ERR_BAD_OPTIONS if e < 1 or e > d
                return ERR_BAD_OPTIONS if f < 0 or f > 600000
                return OK
            elif task == TASK_SALESMAN:
                return ERR_BAD_OPTIONS if not SalesmanGame::allowed_start_cities(a)
                return ERR_BAD_OPTIONS if not SalesmanGame::allowed_rounds(b)
                return ERR_BAD_OPTIONS if not SalesmanGame::allowed_flag(c) or not SalesmanGame::allowed_flag(d)
                return ERR_BAD_OPTIONS if e != 0 or f != 0
                return OK
            elif task == TASK_GRAPH_MAPPING:
                return ERR_BAD_OPTIONS if not GraphMappingGame::allowed_start_nodes(a)
                return ERR_BAD_OPTIONS if not GraphMappingGame::allowed_density(b)
                return ERR_BAD_OPTIONS if not GraphMappingGame::allowed_trials(c)
                return ERR_BAD_OPTIONS if not GraphMappingGame::allowed_exposure(d)
                return ERR_BAD_OPTIONS if not GraphMappingGame::allowed_flag(e) or not GraphMappingGame::allowed_flag(f)
                return OK
            elif task == TASK_CROSSED_WIRES:
                return ERR_BAD_OPTIONS if a < 1 or a > CrossedWires::GRADE_COUNT
                return ERR_BAD_OPTIONS if not CrossedWiresGame::allowed_trials(b)
                return ERR_BAD_OPTIONS if not option_bool(c)
                return ERR_BAD_OPTIONS if not CrossedWiresGame::allowed_show_grid(d)
                return ERR_BAD_OPTIONS if e != 0 or f != 0
                return OK
            elif task == TASK_SUDOKU:
                return ERR_BAD_OPTIONS if a < 1 or a > Sudoku::GRADE_COUNT
                return ERR_BAD_OPTIONS if not SudokuGame::allowed_trials(b)
                return ERR_BAD_OPTIONS if not SudokuGame::allowed_flag(c) or not SudokuGame::allowed_flag(d)
                return ERR_BAD_OPTIONS if e != 0 or f != 0
                return OK
            elif task == TASK_MATRIX_REASONING:
                return ERR_BAD_OPTIONS if a < 1 or a > Ravens::GRADE_COUNT
                return ERR_BAD_OPTIONS if not MatrixReasoningGame::allowed_trials(b)
                return ERR_BAD_OPTIONS if not MatrixReasoningGame::allowed_exposure(c)
                return ERR_BAD_OPTIONS if not MatrixReasoningGame::allowed_bool(d)
                return ERR_BAD_OPTIONS if not MatrixReasoningGame::allowed_flags(e)
                return ERR_BAD_OPTIONS if not MatrixReasoningGame::allowed_bool(f)
                return OK
            elif task == TASK_HIDDEN_RULE:
                return ERR_BAD_OPTIONS if not HiddenRuleGame::allowed_rung(a) or not HiddenRuleGame::allowed_trials(b)
                return ERR_BAD_OPTIONS if not option_bool(c) or d != 0 or e != 0 or f != 0
                return OK
            elif task == TASK_HIDDEN_WIRING:
                return ERR_BAD_OPTIONS if not HiddenWiringGame::allowed_rung(a) or not HiddenWiringGame::allowed_trials(b)
                return ERR_BAD_OPTIONS if not option_bool(c) or d != 0 or e != 0 or f != 0
                return OK
            elif task == TASK_TRIAGE:
                return ERR_BAD_OPTIONS if not option_bool(c) or not option_bool(d) or e != 0 or f != 0
                if d == 0:
