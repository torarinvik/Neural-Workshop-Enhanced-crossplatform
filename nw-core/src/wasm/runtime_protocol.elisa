            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_WHAT_NEXT
            return task_info(index, field)

    def what_next_frame(handle: i64, stream: i64, now_ms: i64) -> i64:
        can Abort.Panic, Global.Read, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_WHAT_NEXT
            trusted Unsafe.PointerCast:
                run: heap WhatNextGame::Run& = slot_pointers[index.usize()].uintptr().cast[heap WhatNextGame::Run&]
                return WhatNextGame::frame(run, stream, now_ms.f64() / 1000.0)

    def what_next_clip(handle: i64, stream: i64) -> i64:
        can Abort.Panic, Global.Read, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_WHAT_NEXT
            trusted Unsafe.PointerCast:
                run: heap WhatNextGame::Run& = slot_pointers[index.usize()].uintptr().cast[heap WhatNextGame::Run&]
                return -1 if run.puzzle.count == 0 or stream < 0 or stream > run.puzzle.count
                return 0 if stream == 0
                return run.puzzle.options[(stream - 1).usize()].slice.clip

    # Group packet is one clip-count byte, one frame-count byte per clip,
    # then each clip's frame-major sequence of RGB samples.
    def what_next_packet_size(input: u8&, length: i64) -> i64:
        can Abort.Panic:
            count: i64 = input[0].i64()
            return -1 if count < 1 or count > WhatNext::MAX_CLIPS or length < count + 1
            size: mutable i64 = count + 1
            for clip in 0..<count |input, size|:
                frames: i64 = input[(clip + 1).usize()].i64()
                return -1 if frames < 1 or frames > WhatNextGame::MAX_FRAMES
                size <- size + frames * WhatNextGame::SAMPLES
            return count if size == length else -1

    def what_next_load_group(rung: i64, rng: mutable MT19937&, input: u8&, count: i64, length: i64) -> WhatNext::Puzzle:
        can Abort.Panic:
            group: mutable WhatNext::Group = zeroed
            group.count <- count
            offset: mutable i64 = count + 1
            for clip in 0..<count |input, offset, group|:
                frames: i64 = input[(clip + 1).usize()].i64()
                group.clips[clip.usize()] <- WhatNext::Clip{frames: frames, stride: WhatNextGame::SAMPLES, offset: offset}
                offset <- offset + frames * WhatNextGame::SAMPLES
            level: WhatNext::Grade = WhatNext::grade(rung)
            return WhatNext::build(&group, input, length, &level, rng)

    def what_next_load(handle: i64, source: i64, length: i64, now_ms: i64, sequence: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_WHAT_NEXT
            now: f64 = now_ms.f64() / 1000.0
            return ERR_TIME if sequence < 0 or not WhatNextGame::valid_time(now)
            return ERR_BUFFER if length < 2 or not valid_memory_range(source, length, 1)
            trusted Unsafe.PointerCast:
                input: u8& = source.uintptr().cast[u8&]
                count: i64 = what_next_packet_size(input, length)
                return ERR_BAD_EVENT if count < 0
                order: i64 = record_order(index, now_ms, sequence)
                return order if order != OK
                run: mutable heap WhatNextGame::Run& = slot_pointers[index.usize()].uintptr().cast[mutable heap WhatNextGame::Run&]
                return IGNORED if run.phase != WhatNextGame::LOADING
                puzzle: WhatNext::Puzzle = what_next_load_group(run.rung, &run.rng, input, count, length)
                return ACCEPTED if WhatNextGame::accept_puzzle(run, puzzle, now) else IGNORED

    def camera_task_id() -> i64:
        return TASK_CAMERA

    def camera_info(handle: i64, field: i64) -> i64:
        can Abort.Panic, Global.Read:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_CAMERA
            return task_info(index, field)

    def camera_copy_packet(packet: darray[u8]&, dest: i64, capacity: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            length: i64 = packet.count.i64()
            return ERR_BUFFER if length > capacity
            if length > 0:
                trusted Unsafe.PointerCast:
                    target: mutable u8& = dest.uintptr().cast[mutable u8&]
                    memcpy(target.cast[mutable void&], (&packet[0]).cast[void&], length.usize())
            return length

    def camera_encode_frame(owner: mutable Arena&, run: CameraGame::Session&, dest: i64,
                            capacity: i64, width: i64, height: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            in owner:
                view: CameraRender::Frame = CameraRender::frame(run, width, height)
                packet: darray[u8] = CameraRender::encode_frame(&view)
                return camera_copy_packet(&packet, dest, capacity)

    def camera_options_note(dest: i64, capacity: i64, rung: i64, adaptive: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            return ERR_BAD_OPTIONS if not CameraGame::allowed_rung(rung) or not option_bool(adaptive)
            return ERR_BUFFER if capacity <= 0 or not valid_memory_range(dest, capacity, 1)
            note: mutable dstr = []
            SceneCamera::options_note(&note, rung, adaptive != 0)
            return camera_copy_packet(&note, dest, capacity)

    def camera_encode_mesh(owner: mutable Arena&, kind: i64, field: f64, dest: i64, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            in owner:
                packet: darray[u8] = CameraRender::encode_mesh(kind, field)
                return camera_copy_packet(&packet, dest, capacity)

    def camera_frame(handle: i64, dest: i64, capacity: i64, width: i64, height: i64) -> i64:
        can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_CAMERA
            return ERR_BAD_OPTIONS if width <= 0 or height <= 0 or width > 32768 or height > 32768
            return ERR_BUFFER if capacity <= 0 or not valid_memory_range(dest, capacity, 1)
            owner: mutable Arena = zeroed
            trusted Unsafe.PointerCast:
                run: heap CameraGame::Session& = slot_pointers[index.usize()].uintptr().cast[heap CameraGame::Session&]
                length: i64 = camera_encode_frame(&owner, run, dest, capacity, width, height)
                CameraGame::release_scene(&owner) can Global{Read,Write}
                return length

    def camera_encode_chrome(owner: mutable Arena&, run: CameraGame::Session&, dest: i64,
                             capacity: i64, black: bool, width: i64, height: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            in owner:
                list: mutable Display::DisplayList = Display::DisplayList()
                SceneCamera::chrome(&list, run, black, width.f64(), height.f64())
                packet: darray[u8] = Display::encode_binary(&list)
                return camera_copy_packet(&packet, dest, capacity)

    def camera_chrome(handle: i64, dest: i64, capacity: i64, black: i64, width: i64, height: i64) -> i64:
        can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_CAMERA
            return ERR_BAD_OPTIONS if not option_bool(black) or width <= 0 or height <= 0 or width > 32768 or height > 32768
            return ERR_BUFFER if capacity <= 0 or not valid_memory_range(dest, capacity, 1)
            owner: mutable Arena = zeroed
            trusted Unsafe.PointerCast:
                run: heap CameraGame::Session& = slot_pointers[index.usize()].uintptr().cast[heap CameraGame::Session&]
                length: i64 = camera_encode_chrome(&owner, run, dest, capacity, black != 0, width, height)
                CameraGame::release_scene(&owner) can Global{Read,Write}
                return length

    def camera_mesh(dest: i64, capacity: i64, kind: i64, field: f64) -> i64:
        can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
            return ERR_BAD_OPTIONS if kind < CameraMesh::BOX or kind > CameraMesh::OUTSIDE or not (field > 0.0 and field <= 120.0)
            return ERR_BUFFER if capacity <= 0 or not valid_memory_range(dest, capacity, 1)
            owner: mutable Arena = zeroed
            length: i64 = camera_encode_mesh(&owner, kind, field, dest, capacity)
            CameraGame::release_scene(&owner) can Global{Read,Write}
            return length

