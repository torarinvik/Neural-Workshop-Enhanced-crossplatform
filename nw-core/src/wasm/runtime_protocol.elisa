                    return ReflexGame::ACTION_START if phase == ReflexGame::PHASE_READY or phase == ReflexGame::PHASE_DONE else -1
                return -1
            elif task == TASK_TRACKING:
                if key == KEY_SPACE or key == KEY_ENTER:
