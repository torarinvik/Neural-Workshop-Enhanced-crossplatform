    def falls_options_note(dest: i64, capacity: i64, rung: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            return ERR_BAD_OPTIONS if not FallsGame::allowed_rung(rung)
            note: mutable dstr = []
            SceneFalls::option_note(rung, &note)
            length: i64 = note.count.i64()
            return ERR_BUFFER if capacity < length or not valid_memory_range(dest, length, 1)
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&note[0]).cast[void&], length.usize())
            return length

