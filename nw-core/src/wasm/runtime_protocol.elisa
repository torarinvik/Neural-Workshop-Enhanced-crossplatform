            elif task == TASK_DONKEY:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return DonkeyGame::ACTION_START if phase == DonkeyGame::PHASE_READY or phase == DonkeyGame::PHASE_DONE or phase == DonkeyGame::PHASE_SCORED else DonkeyGame::ACTION_SWITCH
                elif key == KEY_LEFT or key == KEY_RIGHT or key == KEY_UP:
                    return DonkeyGame::ACTION_SWITCH
                return -1
            elif task == TASK_OVERRUN:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return OverrunGame::ACTION_START if phase == OverrunGame::PHASE_READY or phase == OverrunGame::PHASE_DONE else -1
                elif key == KEY_UNDO:
                    return OverrunGame::ACTION_ERASE
                return -1
            elif task == TASK_TWO_HANDS:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return TwoHandsGame::ACTION_START if phase == TwoHandsGame::PHASE_READY or phase == TwoHandsGame::PHASE_DONE or phase == TwoHandsGame::PHASE_SCORED else TwoHandsGame::ACTION_JUMP
                elif key == KEY_LEFT: return TwoHandsGame::ACTION_LEFT
                elif key == KEY_RIGHT: return TwoHandsGame::ACTION_RIGHT
                elif key == KEY_UP: return TwoHandsGame::ACTION_FASTER
                elif key == KEY_DOWN: return TwoHandsGame::ACTION_SLOWER
                return -1
            else:
                if key == KEY_SPACE:
                    if phase == MarbleMazeGame::PHASE_READY or phase == MarbleMazeGame::PHASE_DONE:
                        return MarbleMazeGame::ACTION_START
                    return MarbleMazeGame::ACTION_NEXT if phase == MarbleMazeGame::PHASE_FEEDBACK else -1
                elif key == KEY_UP:
                    return MarbleMazeGame::ACTION_HOLD_NORTH if phase == MarbleMazeGame::PHASE_RUNNING else -1
                elif key == KEY_RIGHT:
                    return MarbleMazeGame::ACTION_HOLD_EAST if phase == MarbleMazeGame::PHASE_RUNNING else -1
                elif key == KEY_DOWN:
                    return MarbleMazeGame::ACTION_HOLD_SOUTH if phase == MarbleMazeGame::PHASE_RUNNING else -1
                elif key == KEY_LEFT:
                    return MarbleMazeGame::ACTION_HOLD_WEST if phase == MarbleMazeGame::PHASE_RUNNING else -1
                elif key == KEY_RESTART: return MarbleMazeGame::ACTION_RESTART
                elif key == KEY_LEVEL: return MarbleMazeGame::ACTION_LEVEL
                return -1

    def valid_action_payload(task: i64, action: i64, value: i64, aux: i64) -> bool:
        can Abort.Panic:
            if task == TASK_NBACK_3D:
                return value == 0 and aux == 0
            if task == TASK_SALESMAN:
                if action == SalesmanGame::ACTION_PICK:
                    return value >= 0 and value < SalesmanGame::MAX_CITIES and aux == 0
                return value == 0 and aux == 0
            if task == TASK_COUNT:
                if action == CountingGame::ACTION_DIGIT:
                    return value >= 0 and value <= 9 and aux == 0
                return value == 0 and aux == 0
            if task == TASK_HANOI:
                return value == 0 and aux == 0
            if task == TASK_NUMBEROLOGY:
                if action == NumberologyGame::ACTION_WRITE:
                    return (value == 45 or (value >= 48 and value <= 57)) and aux == 0
                return value == 0 and aux == 0
            if task == TASK_MR_TIME:
                if action == MrTime::ACTION_DIGIT:
                    return value >= 0 and value <= 9 and aux == 0
                return value == 0 and aux == 0
            if task == TASK_IN_THE_DARK:
                return value == 0 and aux == 0
            if task == TASK_REFLEX:
                return value == 0 and aux == 0
            if task == TASK_LOOKOUT:
                return value == 0 and aux == 0
            if task == TASK_BUZZ_WIRE:
                if action == BuzzWireGame::ACTION_PRESS or action == BuzzWireGame::ACTION_RELEASE or action == BuzzWireGame::ACTION_TAP:
                    return value >= 0 and value < Buzzwire::PORTS and aux == 0
                return value == 0 and aux == 0
            if task == TASK_OUT_OF_SIGHT:
                return value == 0 and aux == 0
            if task == TASK_PURSUIT:
                return value == 0 and aux == 0
            if task == TASK_OVERRUN:
                if action == OverrunGame::ACTION_WRITE:
                    return value >= 0 and value <= 25 and aux == 0
                return value == 0 and aux == 0
            if task == TASK_TWO_HANDS:
                if action == TwoHandsGame::ACTION_PORT:
                    return value >= TwoHands::HOLD and value < TwoHands::PORTS and aux == 0
                return value == 0 and aux == 0
            if task == TASK_CROSSED_WIRES:
                if action == CrossedWiresGame::ACTION_PRESS:
                    return value >= 0 and value < CrossedWiresGame::MAX_KEYS and aux == 0
                return value == 0 and aux == 0
            if task == TASK_SUDOKU:
                if action == SudokuGame::ACTION_WRITE:
                    return value >= 1 and value <= Sudoku::MOST_SIZE and aux == 0
                return value == 0 and aux == 0
            if task == TASK_MATRIX_REASONING:
                if action == MatrixReasoningGame::ACTION_ANSWER:
                    return value >= 0 and value < MatrixReasoningGame::MAX_CHOICES and aux == 0
                return value == 0 and aux == 0
            if task == TASK_JIGSAW:
                if action == JigsawGame::ACTION_PICK:
                    return value >= 0 and value < 100 and aux == 0
                return value == 0 and aux == 0
            if task == TASK_TRIVIA:
                return true
            if task == TASK_TETRIS:
                return value == 0 and aux == 0
            if task != TASK_MARBLE_MAZE:
                return true
            if action == MarbleMazeGame::ACTION_REPORT:
                return false if value < 0 or value > 3 or aux < 0 or aux > 600000
                return false if (value & 1) != 0 and (value & 2) == 0
                return true
            if action == MarbleMazeGame::ACTION_SCORE:
                return (value == 0 or value == 1) and aux == 0
            if action == MarbleMazeGame::ACTION_SYNC_SETTLE_TIME:
                return value >= 0 and value <= MarbleMazeGame::MAX_SETTLE_MS and aux == 0
            if action == MarbleMazeGame::ACTION_RECORD_RESULT:
                return value >= 0 and value <= MarbleMazeGame::MAX_TRIALS and aux >= 0 and aux <= MarbleMazeGame::MAX_TRIALS
            return true

    def record_order(index: i64, timestamp_ms: i64, sequence: i64) -> i64:
        can Abort.Panic:
            return ERR_TIME if timestamp_ms < 0 or sequence < 0
            return ERR_EVENT_ORDER if timestamp_ms < slot_last_time[index.usize()]
            return ERR_EVENT_ORDER if sequence <= slot_last_sequence[index.usize()]
            slot_last_time[index.usize()] <- timestamp_ms
            slot_last_sequence[index.usize()] <- sequence
            return OK

    # Event scalar schema (all integers, fixed-width ABI values): kind,
    # timestamp_ms, sequence, logical_or_action_code, value_or_physical_code,
    # modifiers, flags, x_millionths, y_millionths, aux. Pointer origin is the
    # bottom-left of the task viewport; values are in [0, 1_000_000].
    def dispatch(handle: i64, kind: i64, timestamp_ms: i64, sequence: i64,
                 code: i64, value: i64, modifiers: i64, flags: i64,
                 x_millionths: i64, y_millionths: i64, aux: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_BAD_EVENT if kind < EVENT_ACTION or kind > EVENT_CANCEL
            return ERR_TIME if timestamp_ms < 0 or sequence < 0
            return ERR_BAD_EVENT if modifiers < 0 or modifiers > 15 or flags < 0 or flags > 7
            return ERR_BAD_EVENT if (kind == EVENT_KEY_DOWN or kind == EVENT_KEY_UP) and code < 0
            if kind == EVENT_ACTION:
                return ERR_BAD_EVENT if not valid_action_code(slot_tasks[index.usize()], code)
                return ERR_BAD_EVENT if not valid_action_payload(slot_tasks[index.usize()], code, value, aux)
            elif kind == EVENT_POINTER_DOWN or kind == EVENT_POINTER_MOVE or kind == EVENT_POINTER_UP:
                return ERR_BAD_EVENT if x_millionths < 0 or x_millionths > 1000000 or y_millionths < 0 or y_millionths > 1000000
            elif kind == EVENT_TEXT:
                return ERR_BAD_EVENT if value < 0 or value > 1114111 or (value >= 55296 and value <= 57343)
            elif kind == EVENT_FOCUS or kind == EVENT_VISIBILITY:
                return ERR_BAD_EVENT if value != 0 and value != 1
            order: i64 = record_order(index, timestamp_ms, sequence)
            return order if order != OK
            task: i64 = slot_tasks[index.usize()]
            pointer: i64 = slot_pointers[index.usize()]
            if kind == EVENT_ACTION:
                return apply_action(index, code, value, timestamp_ms, aux)
            elif kind == EVENT_KEY_UP:
                if task == TASK_MARBLE_MAZE:
                    trusted Unsafe.PointerCast:
                        run: mutable heap MarbleMazeGame::MarbleRun& = pointer.uintptr().cast[mutable heap MarbleMazeGame::MarbleRun&]
                        return MarbleMazeGame::release_key(run, code)
                return IGNORED
            elif kind == EVENT_TEXT:
                if task == TASK_COUNT:
                    return IGNORED if value < 48 or value > 57
                    return apply_action(index, CountingGame::ACTION_DIGIT,
                                        value - 48, timestamp_ms, 0)
                elif task == TASK_NUMBEROLOGY:
                    return apply_action(index, NumberologyGame::ACTION_WRITE,
                                        value, timestamp_ms, 0)
                elif task == TASK_ALGEBRA:
                    if value == 45 or (value >= 48 and value <= 57):
                        return apply_action(index, AlgebraGame::ACTION_WRITE,
                                            value, timestamp_ms, 0)
                    return IGNORED
                elif task == TASK_SCRAMBLE:
                    return apply_action(index, ScrambleGame::ACTION_WRITE,
                                        26 if value == 32 else (value - 65 if value >= 65 and value <= 90 else value - 97 if value >= 97 and value <= 122 else 27),
                                        timestamp_ms, 0)
                elif task == TASK_CROSSWORD:
                    if value >= 65 and value <= 90: return apply_action(index, CrosswordGame::WRITE, value - 65, timestamp_ms, 0)
                    if value >= 97 and value <= 122: return apply_action(index, CrosswordGame::WRITE, value - 97, timestamp_ms, 0)
                    return IGNORED
                elif task == TASK_MR_TIME:
                    if value >= 48 and value <= 57:
                        return apply_action(index, MrTime::ACTION_DIGIT,
                                            value - 48, timestamp_ms, 0)
                    if value == 46 or value == 44:
                        return apply_action(index, MrTime::ACTION_POINT,
                                            0, timestamp_ms, 0)
                    return IGNORED
                elif task == TASK_OVERRUN:
                    if value >= 65 and value <= 90:
                        return apply_action(index, OverrunGame::ACTION_WRITE,
                                            value - 65, timestamp_ms, 0)
                    if value >= 97 and value <= 122:
                        return apply_action(index, OverrunGame::ACTION_WRITE,
                                            value - 97, timestamp_ms, 0)
                    return IGNORED
                elif task == TASK_TWO_HANDS:
                    return IGNORED
                return IGNORED
            elif kind == EVENT_FOCUS or kind == EVENT_VISIBILITY or kind == EVENT_CANCEL:
                if task == TASK_MARBLE_MAZE and (kind == EVENT_CANCEL or value == 0):
                    trusted Unsafe.PointerCast:
                        run: mutable heap MarbleMazeGame::MarbleRun& = pointer.uintptr().cast[mutable heap MarbleMazeGame::MarbleRun&]
                        MarbleMazeGame::clear_input(run)
                return IGNORED
            elif kind == EVENT_POINTER_MOVE or kind == EVENT_POINTER_UP or kind == EVENT_WHEEL or kind == EVENT_TEXT:
                if task == TASK_PURSUIT and (kind == EVENT_POINTER_MOVE or kind == EVENT_POINTER_UP):
                    trusted Unsafe.PointerCast:
                        run: mutable heap PursuitGame::PursuitRun& = pointer.uintptr().cast[mutable heap PursuitGame::PursuitRun&]
                        return PursuitGame::pointer(run, x_millionths, y_millionths)
                elif task == TASK_TWO_HANDS and (kind == EVENT_POINTER_MOVE or kind == EVENT_POINTER_UP):
                    trusted Unsafe.PointerCast:
                        run: mutable heap TwoHandsGame::TwoHandsRun& = pointer.uintptr().cast[mutable heap TwoHandsGame::TwoHandsRun&]
                        return TwoHandsGame::pointer(run, x_millionths, y_millionths, false)
                return IGNORED
            elif kind == EVENT_KEY_DOWN:
                return IGNORED if (flags & 1) != 0
                phase: i64 = task_info(index, 0)
                action: i64 = map_key(task, code, phase)
                return IGNORED if action < 0
                return apply_action(index, action, value, timestamp_ms, 0)
            elif kind == EVENT_POINTER_DOWN:
                if task == TASK_TETRIS:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: mutable heap TetrisGame::TetrisRun& = pointer.uintptr().cast[mutable heap TetrisGame::TetrisRun&]
                        slot: i64 = TetrisGame::pointer_slot(run, x_millionths, y_millionths)
                        return IGNORED if slot < 0
                        return apply_action(index, TetrisGame::ACTION_SELECT_BASE + slot, 0, timestamp_ms, 0)
                elif task == TASK_NINA_ROW:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: heap NinaRowGame::Run& = pointer.uintptr().cast[heap NinaRowGame::Run&]
                        cell: i64 = NinaRowGame::pointer_cell(run, x_millionths, y_millionths)
                        return IGNORED if cell < 0
                        return apply_action(index, NinaRowGame::ACTION_SELECT, cell, timestamp_ms, 0)
                elif task == TASK_SALESMAN:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: heap SalesmanGame::Run& = pointer.uintptr().cast[heap SalesmanGame::Run&]
                        city: i64 = SalesmanGame::pointer_city(run, x_millionths, y_millionths)
                        return IGNORED if city < 0
                        return apply_action(index, SalesmanGame::ACTION_PICK, city, timestamp_ms, 0)
                elif task == TASK_GRAPH_MAPPING:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: heap GraphMappingGame::GraphMappingRun& = pointer.uintptr().cast[heap GraphMappingGame::GraphMappingRun&]
                        phase: i64 = GraphMappingGame::info(run, GraphMappingGame::INFO_PHASE)
                        return IGNORED if phase != GraphMappingGame::PHASE_ASKING and phase != GraphMappingGame::PHASE_HIDDEN
                        px: f64 = x_millionths.f64() * 912.0 / 1000000.0
                        py: f64 = y_millionths.f64() * 684.0 / 1000000.0
                        wide: f64 = GraphMapping::button_width(912.0)
                        tall: f64 = GraphMapping::button_height(684.0)
                        gap: f64 = 912.0 * 0.04
                        left: f64 = GraphMapping::button_left(912.0)
                        bottom: f64 = GraphMapping::button_bottom(684.0)
                        return IGNORED if py < bottom or py > bottom + tall
                        if px >= left and px <= left + wide:
                            return apply_action(index, GraphMappingGame::ACTION_SAME, 0, timestamp_ms, 0)
                        if px >= left + wide + gap and px <= left + wide + gap + wide:
                            return apply_action(index, GraphMappingGame::ACTION_DIFFERENT, 0, timestamp_ms, 0)
                        return IGNORED
                elif task == TASK_MAZE:
                    return IGNORED
                elif task == TASK_MATRIX_REASONING:
                    return IGNORED if code != 0
                    phase: i64 = task_info(index, MatrixReasoningGame::INFO_PHASE)
                    return IGNORED if phase != MatrixReasoningGame::PHASE_ASKING and phase != MatrixReasoningGame::PHASE_HIDDEN
                    across: i64 = task_info(index, MatrixReasoningGame::INFO_ACROSS)
                    choices: i64 = task_info(index, MatrixReasoningGame::INFO_CHOICES)
                    px: f64 = x_millionths.f64() * 912.0 / 1000000.0
                    py: f64 = y_millionths.f64() * 684.0 / 1000000.0
                    choice: i64 = SceneRavens::choice_at(912.0, 684.0, across, choices, task_info(index, MatrixReasoningGame::INFO_EXPLAIN) != 0, px, py)
                    return IGNORED if choice < 0
                    return apply_action(index, MatrixReasoningGame::ACTION_ANSWER, choice, timestamp_ms, 0)
                elif task == TASK_JIGSAW:
                    return IGNORED if code != 0
                    phase: i64 = task_info(index, JigsawGame::INFO_PHASE)
                    return IGNORED if phase != JigsawGame::PHASE_SOLVING
                    px: f64 = x_millionths.f64() * 912.0 / 1000000.0
                    py: f64 = y_millionths.f64() * 684.0 / 1000000.0
                    side: i64 = task_info(index, JigsawGame::INFO_TRIAL_SIDE)
                    position: i64 = Jigsaw::tile_at(912.0, 684.0,
                        task_info(index, JigsawGame::INFO_PREVIEW) != 0,
                        side, px, py)
                    return IGNORED if position < 0
                    return apply_action(index, JigsawGame::ACTION_PICK, position, timestamp_ms, 0)
                elif task == TASK_GO:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: heap GoGame::GoRun& = pointer.uintptr().cast[heap GoGame::GoRun&]
                        px: f64 = x_millionths.f64() * 912.0 / 1000000.0
                        py: f64 = y_millionths.f64() * 684.0 / 1000000.0
                        cell: i64 = GoGame::pointer(run, 912.0, 684.0, px, py)
                        return IGNORED if cell < 0
                        return apply_action(index, GoGame::ACTION_ANSWER, cell, timestamp_ms, 0)
                elif task == TASK_HANOI:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: heap HanoiGame::Run& = pointer.uintptr().cast[heap HanoiGame::Run&]
                        return IGNORED if HanoiGame::info(run, HanoiGame::INFO_PHASE) != HanoiGame::PHASE_SOLVING
                        # The source clickable columns occupy x=6%..94% of
                        # the reference canvas. Use the same thirds as the
                        # native _peg_rects implementation.
                        px: i64 = x_millionths * 912 / 1000000
                        return IGNORED if px < 55 or px > 857
                        peg: i64 = (px - 55) * 3 / 802
                        return apply_action(index, HanoiGame::ACTION_PICK_0 + peg, 0, timestamp_ms, 0)
                elif task == TASK_MONKEY_LADDER:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: heap MonkeyLadderGame::MonkeyLadderRun& = pointer.uintptr().cast[heap MonkeyLadderGame::MonkeyLadderRun&]
                        return IGNORED if MonkeyLadderGame::info(run, MonkeyLadderGame::INFO_PHASE) != MonkeyLadderGame::PHASE_INPUT
                        grid: i64 = MonkeyLadderGame::info(run, MonkeyLadderGame::INFO_GRID)
                        px: i64 = x_millionths * 912 / 1000000
                        py: i64 = y_millionths * 684 / 1000000
                        board: i64 = 684 * 62 / 100
                        origin_x: i64 = (912 - board) / 2
                        origin_y: i64 = (684 - board) / 2 - 10
                        return IGNORED if px < origin_x or px >= origin_x + board or py < origin_y or py >= origin_y + board
                        column: i64 = (px - origin_x) * grid / board
                        row: i64 = (py - origin_y) * grid / board
                        return apply_action(index, MonkeyLadderGame::ACTION_SELECT, row * grid + column, timestamp_ms, 0)
                elif task == TASK_CONCENTRATION:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: heap ConcentrationGame::ConcentrationRun& = pointer.uintptr().cast[heap ConcentrationGame::ConcentrationRun&]
                        card: i64 = ConcentrationGame::pointer_card(run, x_millionths, y_millionths)
                        return IGNORED if card < 0
                        return apply_action(index, ConcentrationGame::ACTION_SELECT, card, timestamp_ms, 0)
                elif task == TASK_RECOGNITION:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: heap RecognitionGame::RecognitionRun& = pointer.uintptr().cast[heap RecognitionGame::RecognitionRun&]
                        action: i64 = RecognitionGame::pointer_action(run, x_millionths, y_millionths)
                        return IGNORED if action < 0
                        return apply_action(index, action, 0, timestamp_ms, 0)
                elif task == TASK_REMOVALS:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: heap RemovalsGame::RemovalsRun& = pointer.uintptr().cast[heap RemovalsGame::RemovalsRun&]
                        van: i64 = RemovalsGame::pointer_van(run, x_millionths)
                        return IGNORED if van < 0
                        return apply_action(index, RemovalsGame::ACTION_ANSWER_0 + van, 0, timestamp_ms, 0)
                elif task == TASK_NCUP_MONTE:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: heap NCupMonteGame::NCupMonteRun& = pointer.uintptr().cast[heap NCupMonteGame::NCupMonteRun&]
                        cup: i64 = NCupMonteGame::pointer_cup(run, x_millionths, y_millionths)
                        return IGNORED if cup < 0
                        return apply_action(index, NCupMonteGame::ACTION_CHOOSE, cup, timestamp_ms, 0)
                elif task == TASK_REFLEX:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: mutable heap ReflexGame::ReflexRun& = pointer.uintptr().cast[mutable heap ReflexGame::ReflexRun&]
                        target: i64 = ReflexGame::pointer_target(run, timestamp_ms, x_millionths, y_millionths)
                        return IGNORED if target < 0
                        return ACCEPTED
                elif task == TASK_TRACKING:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: mutable heap TrackingGame::TrackingRun& = pointer.uintptr().cast[mutable heap TrackingGame::TrackingRun&]
                        ball: i64 = TrackingGame::pointer_ball(run, timestamp_ms, x_millionths, y_millionths)
                        return IGNORED if ball < 0
                        return ACCEPTED
                elif task == TASK_PURSUIT:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: mutable heap PursuitGame::PursuitRun& = pointer.uintptr().cast[mutable heap PursuitGame::PursuitRun&]
                        return PursuitGame::pointer(run, x_millionths, y_millionths)
                elif task == TASK_TWO_HANDS:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: mutable heap TwoHandsGame::TwoHandsRun& = pointer.uintptr().cast[mutable heap TwoHandsGame::TwoHandsRun&]
                        return TwoHandsGame::pointer(run, x_millionths, y_millionths, true)
                elif task == TASK_MR_TIME:
                    return IGNORED if code != 0
                    trusted Unsafe.PointerCast:
                        run: mutable heap MrTime::MrTimeRun& = pointer.uintptr().cast[mutable heap MrTime::MrTimeRun&]
                        return IGNORED if not MrTime::mark_at(run,
                            x_millionths.f64() * 912.0 / 1000000.0,
                            y_millionths.f64() * 684.0 / 1000000.0,
                            912.0, 684.0)
                        return apply_action(index, MrTime::ACTION_ACT,
                                            0, timestamp_ms, 0)
                return ERR_BAD_EVENT
            return ERR_BAD_EVENT

    def advance(handle: i64, logical_time_ms: i64, elapsed_active_ms: i64,
                sequence: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_TIME if logical_time_ms < 0 or elapsed_active_ms < 0 or sequence < 0
            return ERR_EVENT_ORDER if logical_time_ms < slot_last_time[index.usize()]
            return ERR_EVENT_ORDER if sequence <= slot_last_sequence[index.usize()]
            return ERR_TIME if elapsed_active_ms > I64_MAX_VALUE - slot_elapsed[index.usize()]
            slot_last_time[index.usize()] <- logical_time_ms
            slot_last_sequence[index.usize()] <- sequence
            slot_elapsed[index.usize()] <- slot_elapsed[index.usize()] + elapsed_active_ms
            if slot_tasks[index.usize()] == TASK_NBACK_3D:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap NBack3DGame::NBack3DRun& = pointer.uintptr().cast[mutable heap NBack3DGame::NBack3DRun&]
                    return NBack3DGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_SALESMAN:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap SalesmanGame::Run& = pointer.uintptr().cast[mutable heap SalesmanGame::Run&]
                    return SalesmanGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_GRAPH_MAPPING:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap GraphMappingGame::GraphMappingRun& = pointer.uintptr().cast[mutable heap GraphMappingGame::GraphMappingRun&]
                    return GraphMappingGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_CROSSED_WIRES:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap CrossedWiresGame::Run& = pointer.uintptr().cast[mutable heap CrossedWiresGame::Run&]
                    return CrossedWiresGame::advance(run)
            elif slot_tasks[index.usize()] == TASK_SUDOKU:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap SudokuGame::SudokuRun& = pointer.uintptr().cast[mutable heap SudokuGame::SudokuRun&]
                    return SudokuGame::advance(run)
            elif slot_tasks[index.usize()] == TASK_MATRIX_REASONING:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap MatrixReasoningGame::MatrixReasoningRun& = pointer.uintptr().cast[mutable heap MatrixReasoningGame::MatrixReasoningRun&]
                    return MatrixReasoningGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_JIGSAW:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap JigsawGame::JigsawRun& = pointer.uintptr().cast[mutable heap JigsawGame::JigsawRun&]
                    return JigsawGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_MONKEY_LADDER:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap MonkeyLadderGame::MonkeyLadderRun& = pointer.uintptr().cast[mutable heap MonkeyLadderGame::MonkeyLadderRun&]
                    return apply_action(index, MonkeyLadderGame::ACTION_TICK, 0, logical_time_ms, 0)
            elif slot_tasks[index.usize()] == TASK_MARBLE_MAZE:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap MarbleMazeGame::MarbleRun& = pointer.uintptr().cast[mutable heap MarbleMazeGame::MarbleRun&]
                    return MarbleMazeGame::advance(run, elapsed_active_ms)
            elif slot_tasks[index.usize()] == TASK_COUNT:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap CountingGame::CountingRun& = pointer.uintptr().cast[mutable heap CountingGame::CountingRun&]
                    return CountingGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_MR_TIME:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap MrTime::MrTimeRun& = pointer.uintptr().cast[mutable heap MrTime::MrTimeRun&]
                    return MrTime::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_HANOI:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap HanoiGame::Run& = pointer.uintptr().cast[mutable heap HanoiGame::Run&]
                    return HanoiGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_IN_THE_DARK:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap InTheDarkGame::InTheDarkRun& = pointer.uintptr().cast[mutable heap InTheDarkGame::InTheDarkRun&]
                    return InTheDarkGame::tick(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_CONCENTRATION:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap ConcentrationGame::ConcentrationRun& = pointer.uintptr().cast[mutable heap ConcentrationGame::ConcentrationRun&]
                    return ConcentrationGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_RECOGNITION:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap RecognitionGame::RecognitionRun& = pointer.uintptr().cast[mutable heap RecognitionGame::RecognitionRun&]
                    return RecognitionGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_REMOVALS:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap RemovalsGame::RemovalsRun& = pointer.uintptr().cast[mutable heap RemovalsGame::RemovalsRun&]
                    return RemovalsGame::tick(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_CUSTODY:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap CustodyGame::CustodyRun& = pointer.uintptr().cast[mutable heap CustodyGame::CustodyRun&]
                    return CustodyGame::tick(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_NCUP_MONTE:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap NCupMonteGame::NCupMonteRun& = pointer.uintptr().cast[mutable heap NCupMonteGame::NCupMonteRun&]
                    return NCupMonteGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_REFLEX:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap ReflexGame::ReflexRun& = pointer.uintptr().cast[mutable heap ReflexGame::ReflexRun&]
                    return ReflexGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_TRACKING:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap TrackingGame::TrackingRun& = pointer.uintptr().cast[mutable heap TrackingGame::TrackingRun&]
                    return TrackingGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_LOOKOUT:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap LookoutGame::LookoutRun& = pointer.uintptr().cast[mutable heap LookoutGame::LookoutRun&]
                    return LookoutGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_BUZZ_WIRE:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap BuzzWireGame::BuzzWireRun& = pointer.uintptr().cast[mutable heap BuzzWireGame::BuzzWireRun&]
                    return BuzzWireGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_OUT_OF_SIGHT:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap OutOfSightGame::OutOfSightRun& = pointer.uintptr().cast[mutable heap OutOfSightGame::OutOfSightRun&]
                    return OutOfSightGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_PURSUIT:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap PursuitGame::PursuitRun& = pointer.uintptr().cast[mutable heap PursuitGame::PursuitRun&]
                    return PursuitGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_DONKEY:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap DonkeyGame::DonkeyRun& = pointer.uintptr().cast[mutable heap DonkeyGame::DonkeyRun&]
                    return DonkeyGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_OVERRUN:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap OverrunGame::OverrunGameRun& = pointer.uintptr().cast[mutable heap OverrunGame::OverrunGameRun&]
                    return OverrunGame::advance(run, logical_time_ms)
            elif slot_tasks[index.usize()] == TASK_TWO_HANDS:
                pointer: i64 = slot_pointers[index.usize()]
                trusted Unsafe.PointerCast:
                    run: mutable heap TwoHandsGame::TwoHandsRun& = pointer.uintptr().cast[mutable heap TwoHandsGame::TwoHandsRun&]
                    return TwoHandsGame::advance(run, logical_time_ms)
            return ACCEPTED

    def append_u32(out: mutable darray[u8]&, value: u32):
        can Memory.Allocate, Abort.Panic:
            out.push((value & 255.u32()).u8())
            out.push(((value >> 8.u32()) & 255.u32()).u8())
            out.push(((value >> 16.u32()) & 255.u32()).u8())
            out.push(((value >> 24.u32()) & 255.u32()).u8())

    def append_i64(out: mutable darray[u8]&, value: i64):
        can Memory.Allocate, Abort.Panic:
            bits: u64 = value.u64()
            at: mutable i64 = 0
            while at < 8 |out, bits, at|:
                shift: u64 = at.u64() * 8.u64()
                out.push(((bits >> shift) & 255.u64()).u8())
                at <- at + 1

    def read_state(handle: i64, dest: i64, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_BUFFER if capacity < STATE_BYTES
            return ERR_BUFFER if not valid_memory_range(dest, STATE_BYTES, 8)
            task: i64 = slot_tasks[index.usize()]
            out: mutable darray[u8] = []
            append_u32(&out, STATE_MAGIC)
            append_u32(&out, 1.u32())
            append_u32(&out, task.u32())
            append_u32(&out, 12.u32())
            if task == TASK_NBACK_3D:
                append_i64(&out, task_info(index, NBack3DGame::INFO_PHASE))
