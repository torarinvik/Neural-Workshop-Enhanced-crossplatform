    def tuner_recording_add(handle: i64, row: i64, label: i64, from_ms: i64, to_ms: i64) -> i64:
        can Abort.Panic, Memory.Allocate, Global.Read, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_TUNER
            return ERR_BAD_EVENT if from_ms < 0 or to_ms <= from_ms or to_ms > 60000
            trusted Unsafe.PointerCast:
                run: mutable heap TunerWeb::Session& = slot_pointers[index.usize()].uintptr().cast[mutable heap TunerWeb::Session&]
                duration: f64 = to_ms.f64() / 1000.0 - from_ms.f64() / 1000.0
                return ACCEPTED if TunerWeb::add_clip(run, row, label, duration) else IGNORED

    def tuner_recording_row(handle: i64, position: i64) -> i64:
        can Abort.Panic, Global.Read, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return -1 if index < 0 or slot_tasks[index.usize()] != TASK_TUNER
            trusted Unsafe.PointerCast:
                run: heap TunerWeb::Session& = slot_pointers[index.usize()].uintptr().cast[heap TunerWeb::Session&]
                return TunerWeb::row(run, position)

    def tuner_recording_load(handle: i64, position: i64, source: i64, length: i64, from_ms: i64, to_ms: i64, now: f64) -> i64:
        can Abort.Panic, Memory.Allocate, Global.Read, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_TUNER
            return ERR_BUFFER if length < 0 or length > TunerWeb::MAX_FILE
            return ERR_BUFFER if length > 0 and not valid_memory_range(source, length, 1)
            trusted Unsafe.PointerCast:
                run: mutable heap TunerWeb::Session& = slot_pointers[index.usize()].uintptr().cast[mutable heap TunerWeb::Session&]
                bytes: u8&? = source.uintptr().cast[u8&] if length > 0 else null
                return ACCEPTED if TunerWeb::load_wave(run, position, bytes, length, from_ms, to_ms, now) else IGNORED

    def tuner_drag(handle: i64, x: f64, y: f64, dx: f64, dy: f64, fine: i64) -> i64:
        can Abort.Panic, Global.Read, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_TUNER
            return ERR_BAD_EVENT if not option_bool(fine)
            trusted Unsafe.PointerCast:
                run: mutable heap TunerWeb::Session& = slot_pointers[index.usize()].uintptr().cast[mutable heap TunerWeb::Session&]
                return IGNORED if TunerWeb::waiting(run)
                return ACCEPTED if SceneTuner::pointer(&run.game, x, y, dx, dy, true, fine != 0) else IGNORED

