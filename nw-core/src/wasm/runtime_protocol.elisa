    def full_stop_load(handle: i64, passages: i64, p_len: i64, sentences: i64, s_len: i64, lexicon: i64, l_len: i64) -> i64:
        can Memory.Allocate, Memory.Release, Abort.Panic, Global.Read, Global.Write, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_FULL_STOP
            return ERR_BUFFER if not corpus_range(passages, p_len) or not corpus_range(sentences, s_len) or not corpus_range(lexicon, l_len)
            trusted Unsafe.PointerCast:
                run: mutable heap FullStopHost::Run& = slot_pointers[index.usize()].uintptr().cast[mutable heap FullStopHost::Run&]
                return ACCEPTED if (FullStopHost::import_caches(run, corpus_view(passages, p_len), corpus_view(sentences, s_len),
                    corpus_view(lexicon, l_len)) can Global{Read,Write}) else IGNORED

