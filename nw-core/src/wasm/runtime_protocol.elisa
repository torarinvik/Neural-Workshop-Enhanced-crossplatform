                elif key == KEY_DOWN: return FogGame::ACTION_DOWN if phase == FogGame::PHASE_EXPLORING else -1
                elif key == KEY_LEFT: return FogGame::ACTION_LEFT if phase == FogGame::PHASE_EXPLORING else -1
                elif key == KEY_RIGHT: return FogGame::ACTION_RIGHT if phase == FogGame::PHASE_EXPLORING else -1
