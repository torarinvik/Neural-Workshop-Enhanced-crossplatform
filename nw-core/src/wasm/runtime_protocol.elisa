    def corpus_range(pointer: i64, length: i64) -> bool:
        can Abort.Panic:
            return pointer == 0 if length == 0
            return length > 0 and length <= 67108864 and valid_memory_range(pointer, length, 1)

    def corpus_view(pointer: i64, length: i64) -> sview:
        can Unsafe.PointerCast:
            return "" if length == 0
            trusted Unsafe.PointerCast:
                return unsafe_sview_bounded_bytes(pointer.uintptr().cast[u8&], length.usize())

