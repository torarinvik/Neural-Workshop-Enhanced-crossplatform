    def cookie_option_value(row: i64, index: i64) -> i64:
        can Abort.Panic:
            return -1 if row < 0 or row >= 5 or index < 0 or index >= CookieThiefGame::option_count(row)
            return CookieThiefGame::option_value(row, index.usize())

    def cookie_menu_options_valid(level: i64, trials: i64, beat_ms: i64, set_ms: i64, adaptive: i64) -> bool:
        can Abort.Panic:
            return CookieThiefGame::option_allowed(0, level) and CookieThiefGame::option_allowed(1, trials) and
                CookieThiefGame::option_allowed(2, beat_ms) and CookieThiefGame::option_allowed(3, set_ms) and CookieThiefGame::option_allowed(4, adaptive)

    def cookie_options_apply(handle: i64, level: i64, trials: i64, beat_ms: i64, set_ms: i64, adaptive: i64) -> i64:
        can Abort.Panic, Global.Read, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_COOKIE_THIEF
            return ERR_BAD_OPTIONS if not cookie_menu_options_valid(level, trials, beat_ms, set_ms, adaptive)
            trusted Unsafe.PointerCast:
                run: mutable heap CookieThiefGame::Run& = slot_pointers[index.usize()].uintptr().cast[mutable heap CookieThiefGame::Run&]
                return IGNORED if run.phase != CookieThiefGame::PHASE_READY and run.phase != CookieThiefGame::PHASE_DONE
                CookieThiefGame::configure(run, level, trials, beat_ms, set_ms, adaptive != 0)
                return ACCEPTED

    def cookie_options_frame(dest: i64, capacity: i64, black: i64, selection: i64, level: i64, trials: i64, beat_ms: i64, set_ms: i64, adaptive: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            return ERR_BUFFER if not valid_memory_range(dest, capacity, 1)
            return ERR_BAD_OPTIONS if selection < 0 or selection >= 5 or not option_bool(black)
            return ERR_BAD_OPTIONS if not cookie_menu_options_valid(level, trials, beat_ms, set_ms, adaptive)
            wins: i64 = CookieThiefGame::rehearsal_wins(level)
            guessing: i64 = py_round_half_even(100.0 * wins.f64() / CookieThiefGame::REHEARSAL_DEALS.f64())
            draft: i64[6] = [level, trials, beat_ms, set_ms, adaptive, guessing]
            list: mutable Display::DisplayList = Display::DisplayList()
            CookieThiefGame::render_options(&list, black != 0, selection, &draft[0])
            encoded: darray[u8] = Display::encode_binary(&list)
            length: i64 = encoded.count.i64()
            return ERR_BUFFER if length <= 0 or length > capacity
            trusted Unsafe.PointerCast:
                memcpy(dest.uintptr().cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            return length

    def cookie_task_id() -> i64:
        return TASK_COOKIE_THIEF

    def cookie_info(handle: i64, field: i64) -> i64:
        can Abort.Panic, Global.Read:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_COOKIE_THIEF
            return task_info(index, field)

