    def bluff_options_apply(handle: i64, rung: i64, rounds: i64, adaptive: i64) -> i64:
        can Memory.Release, Abort.Panic, Global.Read, Global.Write, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_BLUFF
            return ERR_BAD_OPTIONS if not option_bool(adaptive) or not BluffGame::allowed_rung(rung) or not BluffGame::allowed_total(rounds)
            trusted Unsafe.PointerCast:
                run: mutable heap BluffGame::Session& = slot_pointers[index.usize()].uintptr().cast[mutable heap BluffGame::Session&]
                return ACCEPTED if (BluffGame::reconfigure(run, rung, rounds, adaptive != 0) can Global{Read,Write}) else IGNORED

