                return ERR_BAD_OPTIONS if not option_bool(c)
                return ERR_BAD_OPTIONS if d < 0 or d > 600000
                return ERR_BAD_OPTIONS if e != 0 and e != 15000 and e != 30000 and e != 45000 and e != 60000 and e != 90000 and e != 120000
                return ERR_BAD_OPTIONS if not option_bool(f)
