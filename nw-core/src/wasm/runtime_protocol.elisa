    def render(handle: i64, dest: i64, capacity: i64, black: i64,
               width: i64, height: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_BAD_OPTIONS if not option_bool(black) or width <= 0 or height <= 0 or width > 32768 or height > 32768
            return ERR_BUFFER if capacity <= 0 or not valid_memory_range(dest, capacity, 1)
            return ERR_UNSUPPORTED if slot_tasks[index.usize()] == TASK_MARBLE_MAZE or slot_tasks[index.usize()] == TASK_CAMERA
            pointer: i64 = slot_pointers[index.usize()]
            length: mutable i64 = 0
            if slot_tasks[index.usize()] == TASK_NBACK_3D:
                list: mutable Display::DisplayList = Display::DisplayList()
                trusted Unsafe.PointerCast:
                    run: heap NBack3DGame::NBack3DRun& = pointer.uintptr().cast[heap NBack3DGame::NBack3DRun&]
                    NBack3DGame::render(run, black != 0, width.f64(), height.f64(), &list)
                encoded: darray[u8] = Display::encode_binary(&list)
                length <- encoded.count.i64()
                return ERR_BUFFER if length <= 0 or length > capacity
                trusted Unsafe.PointerCast:
                    target: mutable u8& = dest.uintptr().cast[mutable u8&]
                    memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
