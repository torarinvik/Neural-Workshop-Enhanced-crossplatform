    def tuner_advance(handle: i64, now: f64, held: i64) -> i64:
        can Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_TUNER
            return ERR_BAD_EVENT if held < 0 or held > 15
            trusted Unsafe.PointerCast:
                run: mutable heap TunerWeb::Session& = slot_pointers[index.usize()].uintptr().cast[mutable heap TunerWeb::Session&]
                return ACCEPTED if (TunerWeb::advance(run, now, held) can Global{Read,Write}) else IGNORED

