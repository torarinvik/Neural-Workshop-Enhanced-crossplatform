                elif key == KEY_LEFT:
                    return RecognitionGame::ACTION_SEEN if phase == RecognitionGame::PHASE_SHOWING or phase == RecognitionGame::PHASE_HIDDEN else -1
                elif key == KEY_RIGHT:
                    return RecognitionGame::ACTION_NEW if phase == RecognitionGame::PHASE_SHOWING or phase == RecognitionGame::PHASE_HIDDEN else -1
                elif key == KEY_RESTART:
                    return RecognitionGame::ACTION_REPLAY if phase == RecognitionGame::PHASE_SHOWING or phase == RecognitionGame::PHASE_HIDDEN else -1
                return -1
            elif task == TASK_TRIVIA:
                if key == KEY_SPACE or key == KEY_ENTER:
                    if phase == TriviaGame::PHASE_READY or phase == TriviaGame::PHASE_DONE:
                        return TriviaGame::ACTION_START
                    if phase == TriviaGame::PHASE_JUDGED:
                        return TriviaGame::ACTION_ADVANCE
                    return TriviaGame::ACTION_SUBMIT if phase == TriviaGame::PHASE_ASKING else -1
                elif key == KEY_UP or key == KEY_LEFT:
                    return TriviaGame::ACTION_UP if phase == TriviaGame::PHASE_ASKING else -1
                elif key == KEY_DOWN or key == KEY_RIGHT:
                    return TriviaGame::ACTION_DOWN if phase == TriviaGame::PHASE_ASKING else -1
                elif key >= KEY_ONE and key <= KEY_EIGHT:
                    return TriviaGame::ACTION_CHOOSE_0 + key - KEY_ONE if phase == TriviaGame::PHASE_ASKING else -1
