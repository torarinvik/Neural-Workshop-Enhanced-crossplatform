    def count_snapshot_payload(index: i64, pointer: i64) -> darray[u8]:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
            out: mutable darray[u8] = []
            trusted Unsafe.PointerCast:
                run: heap CountingGame::CountingRun& = pointer.uintptr().cast[heap CountingGame::CountingRun&]
                at: mutable i64 = 0
                while at < 624 |at, run, out|:
                    append_u32(&out, run.rng.mt[at.usize()])
                    at <- at + 1
                append_u32(&out, run.rng.mti.u32())
                append_i64(&out, run.shape_count)
                at <- 0
                while at < run.shape_count |at, run, out|:
                    append_i64(&out, run.shapes[at.usize()].kind)
                    append_i64(&out, run.shapes[at.usize()].points)
                    point: mutable i64 = 0
                    while point < 3 |point, run, at, out|:
                        append_f64(&out, run.shapes[at.usize()].x[point.usize()])
                        point <- point + 1
                    point <- 0
                    while point < 3 |point, run, at, out|:
                        append_f64(&out, run.shapes[at.usize()].y[point.usize()])
                        point <- point + 1
                    append_f64(&out, run.shapes[at.usize()].radius)
                    at <- at + 1
                append_i64(&out, run.kind)
                append_i64(&out, run.start_count)
                append_i64(&out, run.total_trials)
                append_i64(&out, run.exposure_ms)
                append_i64(&out, 1 if run.adaptive else 0)
                append_i64(&out, 1 if run.show_answer else 0)
                append_i64(&out, run.count)
                append_i64(&out, run.shown_count)
                append_i64(&out, run.trial)
                append_i64(&out, run.correct)
                append_i64(&out, run.total_error)
                append_i64(&out, run.answer)
                append_i64(&out, run.answer_length)
                append_i64(&out, run.phase)
                append_i64(&out, run.verdict)
                append_i64(&out, run.shown_at_ms)
                append_i64(&out, run.deadline_ms)
                append_i64(&out, slot_last_time[index.usize()])
                append_i64(&out, slot_last_sequence[index.usize()])
                append_i64(&out, slot_elapsed[index.usize()])
            return out

    def snapshot_count(index: i64, dest: i64, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
            pointer: i64 = slot_pointers[index.usize()]
            payload: darray[u8] = count_snapshot_payload(index, pointer)
            payload_bytes: i64 = payload.count.i64()
            total: i64 = SNAPSHOT_HEADER_BYTES + payload_bytes
            return ERR_BUFFER if payload_bytes < COUNT_SNAPSHOT_FIXED_BYTES or payload_bytes > COUNT_SNAPSHOT_MAX_BYTES
            return ERR_BUFFER if capacity < total or not valid_memory_range(dest, total, 1)
            header: mutable darray[u8] = []
            append_u32(&header, STATE_MAGIC)
            append_u32(&header, COUNT_SNAPSHOT_VERSION)
            append_u32(&header, TASK_COUNT.u32())
            append_u32(&header, payload_bytes.u32())
            target: mutable u8& = dest.uintptr().cast[mutable u8&]
            memcpy(target.cast[mutable void&], (&header[0]).cast[void&], SNAPSHOT_HEADER_BYTES.usize())
            payload_target: mutable u8& = (dest + SNAPSHOT_HEADER_BYTES).uintptr().cast[mutable u8&]
            memcpy(payload_target.cast[mutable void&], (&payload[0]).cast[void&], payload_bytes.usize())
            return total

    def snapshot_supported_v1(task: i64) -> bool:
        can Abort.Panic:
            return task == TASK_MONKEY_LADDER or task == TASK_TETRIS or task == TASK_NBACK_3D

    def snapshot_supported(task: i64) -> bool:
        can Abort.Panic:
            return task == TASK_SOKOBAN or task == TASK_COUNT or snapshot_supported_v1(task)

    def read_state(handle: i64, dest: i64, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_BUFFER if capacity < STATE_BYTES
            return ERR_BUFFER if not valid_memory_range(dest, STATE_BYTES, 8)
            task: i64 = slot_tasks[index.usize()]
            out: mutable darray[u8] = []
            append_u32(&out, STATE_MAGIC)
            append_u32(&out, 1.u32())
            append_u32(&out, task.u32())
            append_u32(&out, 12.u32())
            if task == TASK_NBACK_3D:
                append_i64(&out, task_info(index, NBack3DGame::INFO_PHASE))
                append_i64(&out, task_info(index, NBack3DGame::INFO_NBACK))
                append_i64(&out, task_info(index, NBack3DGame::INFO_TRIAL))
                append_i64(&out, task_info(index, NBack3DGame::INFO_TOTAL_TRIALS))
                append_i64(&out, task_info(index, NBack3DGame::INFO_CUBES))
                append_i64(&out, task_info(index, NBack3DGame::INFO_POSITION))
                append_i64(&out, task_info(index, NBack3DGame::INFO_COLOR))
                append_i64(&out, task_info(index, NBack3DGame::INFO_VERDICT))
