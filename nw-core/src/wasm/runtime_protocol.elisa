                    return MazeGame::ACTION_START if phase == MazeGame::PHASE_READY or phase == MazeGame::PHASE_DONE or phase == MazeGame::PHASE_SOLVED else -1
                elif key == KEY_UP: return MazeGame::ACTION_UP
