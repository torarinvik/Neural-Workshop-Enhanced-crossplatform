            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_EXPLORE_EXPLOIT
            return ERR_BAD_OPTIONS if not option_bool(adaptive) or not BanditGame::allowed_rung(rung) or not BanditGame::allowed_total(rounds)
            trusted Unsafe.PointerCast:
                run: mutable heap BanditGame::Session& = slot_pointers[index.usize()].uintptr().cast[mutable heap BanditGame::Session&]
                return ACCEPTED if (BanditGame::reconfigure(run, rung, rounds, adaptive != 0)) else IGNORED

