                trusted Unsafe.PointerCast:
                    target: mutable u8& = dest.uintptr().cast[mutable u8&]
                    memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            elif slot_tasks[index.usize()] == TASK_OUT_OF_SIGHT:
                list: mutable Display::DisplayList = Display::DisplayList()
                trusted Unsafe.PointerCast:
                    run: heap OutOfSightGame::OutOfSightRun& = pointer.uintptr().cast[heap OutOfSightGame::OutOfSightRun&]
                    OutOfSightGame::render(run, black != 0, width.f64(), height.f64(), &list)
                encoded: darray[u8] = Display::encode_binary(&list)
                length <- encoded.count.i64()
                return ERR_BUFFER if length <= 0 or length > capacity
                trusted Unsafe.PointerCast:
                    target: mutable u8& = dest.uintptr().cast[mutable u8&]
                    memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            elif slot_tasks[index.usize()] == TASK_PURSUIT:
                list: mutable Display::DisplayList = Display::DisplayList()
                trusted Unsafe.PointerCast:
                    run: heap PursuitGame::PursuitRun& = pointer.uintptr().cast[heap PursuitGame::PursuitRun&]
                    PursuitGame::render(run, black != 0, width.f64(), height.f64(), &list)
                encoded: darray[u8] = Display::encode_binary(&list)
                length <- encoded.count.i64()
                return ERR_BUFFER if length <= 0 or length > capacity
                trusted Unsafe.PointerCast:
                    target: mutable u8& = dest.uintptr().cast[mutable u8&]
                    memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            elif slot_tasks[index.usize()] == TASK_DONKEY:
                list: mutable Display::DisplayList = Display::DisplayList()
                trusted Unsafe.PointerCast:
                    run: heap DonkeyGame::DonkeyRun& = pointer.uintptr().cast[heap DonkeyGame::DonkeyRun&]
                    DonkeyGame::render(run, black != 0, width.f64(), height.f64(), &list)
                encoded: darray[u8] = Display::encode_binary(&list)
                length <- encoded.count.i64()
                return ERR_BUFFER if length <= 0 or length > capacity
                trusted Unsafe.PointerCast:
                    target: mutable u8& = dest.uintptr().cast[mutable u8&]
                    memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            elif slot_tasks[index.usize()] == TASK_OVERRUN:
                list: mutable Display::DisplayList = Display::DisplayList()
                trusted Unsafe.PointerCast:
                    run: heap OverrunGame::OverrunGameRun& = pointer.uintptr().cast[heap OverrunGame::OverrunGameRun&]
                    OverrunGame::render(run, black != 0, width.f64(), height.f64(), &list)
                encoded: darray[u8] = Display::encode_binary(&list)
                length <- encoded.count.i64()
                return ERR_BUFFER if length <= 0 or length > capacity
                trusted Unsafe.PointerCast:
                    target: mutable u8& = dest.uintptr().cast[mutable u8&]
                    memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            elif slot_tasks[index.usize()] == TASK_TWO_HANDS:
                list: mutable Display::DisplayList = Display::DisplayList()
                trusted Unsafe.PointerCast:
                    run: heap TwoHandsGame::TwoHandsRun& = pointer.uintptr().cast[heap TwoHandsGame::TwoHandsRun&]
                    TwoHandsGame::render(run, black != 0, width.f64(), height.f64(), &list)
                encoded: darray[u8] = Display::encode_binary(&list)
                length <- encoded.count.i64()
                return ERR_BUFFER if length <= 0 or length > capacity
                trusted Unsafe.PointerCast:
                    target: mutable u8& = dest.uintptr().cast[mutable u8&]
                    memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            elif slot_tasks[index.usize()] == TASK_BUZZ_WIRE:
                list: mutable Display::DisplayList = Display::DisplayList()
                trusted Unsafe.PointerCast:
                    run: heap BuzzWireGame::BuzzWireRun& = pointer.uintptr().cast[heap BuzzWireGame::BuzzWireRun&]
                    BuzzWireGame::render(run, black != 0, width.f64(), height.f64(), &list)
                encoded: darray[u8] = Display::encode_binary(&list)
                length <- encoded.count.i64()
                return ERR_BUFFER if length <= 0 or length > capacity
                trusted Unsafe.PointerCast:
                    target: mutable u8& = dest.uintptr().cast[mutable u8&]
                    memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            else:
                length <- sokoban_run_frame_write(dest, capacity, pointer, black, width, height)
            return ERR_BUFFER if length <= 0
            return length

    def drain_effects(handle: i64, dest: i64, capacity: i64) -> i64:
        can Abort.Panic:
            return ERR_INVALID_HANDLE if slot_for(handle) < 0
            # v1's first conformance controllers have no host effects.
            return 0

    def snapshot_supported(task: i64) -> bool:
        can Abort.Panic:
            # TetrisRun is a fixed-layout controller: its board, hand,
            # active piece, and RNG are all inline fields. It therefore has
            # the same raw-copy snapshot safety as Monkey Ladder. Do not add
            # pointer-backed controllers here without an explicit serializer.
            return task == TASK_MONKEY_LADDER or task == TASK_TETRIS or task == TASK_NBACK_3D

    def snapshot(handle: i64, dest: i64, capacity: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            task: i64 = slot_tasks[index.usize()]
            return ERR_UNSUPPORTED if not snapshot_supported(task)
            payload: i64 = run_bytes(task)
            total: i64 = SNAPSHOT_HEADER_BYTES + payload
            return ERR_BUFFER if capacity < total or not valid_memory_range(dest, total, 8)
            header: mutable darray[u8] = []
            append_u32(&header, STATE_MAGIC)
            append_u32(&header, SNAPSHOT_VERSION)
            append_u32(&header, task.u32())
            append_u32(&header, payload.u32())
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                source: void& = slot_pointers[index.usize()].uintptr().cast[void&]
                memcpy(target.cast[mutable void&], (&header[0]).cast[void&], SNAPSHOT_HEADER_BYTES.usize())
                payload_target: mutable u8& = (dest + SNAPSHOT_HEADER_BYTES).uintptr().cast[mutable u8&]
                memcpy(payload_target.cast[mutable void&], source, payload.usize())
            return total

    def snapshot_u32(source: u8&, offset: i64) -> u32:
        can Abort.Panic:
            value: mutable u32 = source[offset.usize()].u32()
            value <- value | (source[(offset + 1).usize()].u32() << 8.u32())
            value <- value | (source[(offset + 2).usize()].u32() << 16.u32())
            value <- value | (source[(offset + 3).usize()].u32() << 24.u32())
            return value

    def restore(snapshot_pointer: i64, snapshot_bytes: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            return ERR_BUFFER if snapshot_bytes < SNAPSHOT_HEADER_BYTES or not valid_memory_range(snapshot_pointer, snapshot_bytes, 1)
            trusted Unsafe.PointerCast:
                source: u8& = snapshot_pointer.uintptr().cast[u8&]
                magic: u32 = snapshot_u32(source, 0)
                version: u32 = snapshot_u32(source, 4)
                task: i64 = snapshot_u32(source, 8).i64()
                payload: i64 = snapshot_u32(source, 12).i64()
                return ERR_UNSUPPORTED if magic != STATE_MAGIC or version != SNAPSHOT_VERSION
                return ERR_UNSUPPORTED if not snapshot_supported(task)
                return ERR_BUFFER if payload != run_bytes(task) or snapshot_bytes != SNAPSHOT_HEADER_BYTES + payload
                index: i64 = free_slot()
                return ERR_TABLE_FULL if index < 0 or next_handle <= 0 or next_handle == I64_MAX_VALUE
                raw: mutable heap void&? = malloc(payload.usize())
                return ERR_NO_MEMORY if raw == null
                pointer: mutable heap void& = raw
                payload_source: void& = (snapshot_pointer + SNAPSHOT_HEADER_BYTES).uintptr().cast[void&]
                memcpy(pointer, payload_source, payload.usize())
                handle: i64 = next_handle
                next_handle <- next_handle + 1
                slot_handles[index.usize()] <- handle
                slot_tasks[index.usize()] <- task
                slot_pointers[index.usize()] <- pointer.cast[u8&].uintptr().i64()
                slot_last_time[index.usize()] <- 0
                slot_last_sequence[index.usize()] <- -1
                slot_elapsed[index.usize()] <- 0
                return handle

    def destroy(handle: i64) -> i64:
        can Memory.Release, Abort.Panic, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return OK if index < 0 and tombstone_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            pointer: i64 = slot_pointers[index.usize()]
            if slot_tasks[index.usize()] == TASK_SOKOBAN:
                trusted Unsafe.PointerCast:
                    run: mutable heap SokobanGame::SokobanRun& = pointer.uintptr().cast[mutable heap SokobanGame::SokobanRun&]
                    SokobanGame::dispose(run)
            elif slot_tasks[index.usize()] == TASK_SOKOBAN_3D:
                trusted Unsafe.PointerCast:
                    run: mutable heap Sokoban3DGame::Run& = pointer.uintptr().cast[mutable heap Sokoban3DGame::Run&]
                    Sokoban3DGame::dispose(run)
            elif slot_tasks[index.usize()] == TASK_YOU_ARE_HERE:
                trusted Unsafe.PointerCast:
                    run: mutable heap YouAreHereGame::Run& = pointer.uintptr().cast[mutable heap YouAreHereGame::Run&]
                    YouAreHereGame::dispose(run)
            trusted Unsafe.PointerCast:
                heap_pointer: heap void& = pointer.uintptr().cast[heap void&]
                free(heap_pointer)
            slot_tasks[index.usize()] <- 0
            slot_pointers[index.usize()] <- 0
            slot_last_time[index.usize()] <- 0
            slot_last_sequence[index.usize()] <- 0
            slot_elapsed[index.usize()] <- 0
            return OK

    def supports(task: i64) -> i64:
        can Abort.Panic:
            return 1 if task == TASK_NBACK_3D or task == TASK_ALGEBRA or task == TASK_SCRAMBLE or task == TASK_SCRABBLE or task == TASK_CROSSWORD or task == TASK_SYLLOGISM or task == TASK_CHESS or task == TASK_VERBAL or task == TASK_SALESMAN or task == TASK_GRAPH_MAPPING or task == TASK_CROSSED_WIRES or task == TASK_SUDOKU or task == TASK_MATRIX_REASONING or task == TASK_JIGSAW or task == TASK_GO or task == TASK_MONKEY_LADDER or task == TASK_SOKOBAN or task == TASK_SOKOBAN_3D or task == TASK_MARBLE_MAZE or task == TASK_COUNT or task == TASK_MR_TIME or task == TASK_TETRIS or task == TASK_HANOI or task == TASK_MAZE or task == TASK_YOU_ARE_HERE or task == TASK_NINA_ROW or task == TASK_NUMBEROLOGY or task == TASK_IN_THE_DARK or task == TASK_FOG_OF_WAR or task == TASK_CONCENTRATION or task == TASK_RECOGNITION or task == TASK_TRIVIA or task == TASK_REMOVALS or task == TASK_CUSTODY or task == TASK_NCUP_MONTE or task == TASK_REFLEX or task == TASK_TRACKING or task == TASK_LOOKOUT or task == TASK_BUZZ_WIRE or task == TASK_OUT_OF_SIGHT or task == TASK_PURSUIT or task == TASK_DONKEY or task == TASK_OVERRUN or task == TASK_TWO_HANDS else 0

    def abi_version() -> i64:
        can Abort.Panic:
            return 1

