                    if field == 9: return run.puzzle.answer if run.phase == FallsGame::JUDGED else -1
                    if field == 10: return run.puzzle.kind if run.puzzle.choices > 0 else -1
                    if field == 11: return run.deadline_ms if run.phase == FallsGame::JUDGED else 0
                    if field == 12: return run.forfeits
                    return ERR_BAD_EVENT
            elif task == TASK_WHAT_NEXT:
                trusted Unsafe.PointerCast:
                    run: heap WhatNextGame::Run& = pointer.uintptr().cast[heap WhatNextGame::Run&]
                    if field == 0: return run.phase
                    if field == 1: return run.rung
                    if field == 2: return run.trial
                    if field == 3: return run.total
                    if field == 4: return run.puzzle.count
                    if field == 5: return run.scored
                    if field == 6: return run.passed
                    if field == 7: return run.best
                    if field == 8: return run.chosen
                    if field == 9: return run.puzzle.answer if run.phase == WhatNextGame::JUDGED else -1
                    if field == 10: return run.puzzle.options[run.chosen.usize()].kind if run.phase == WhatNextGame::JUDGED else -1
                    if field == 11: return WhatNextGame::other_clips(run.rung)
                    return ERR_UNSUPPORTED
