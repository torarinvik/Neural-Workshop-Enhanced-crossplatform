    def scramble_set_corpus(handle: i64, index_pointer: i64, index_length: i64, sentence_pointer: i64, sentence_length: i64) -> i64:
        can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read:
            slot: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if slot < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[slot.usize()] != TASK_SCRAMBLE
            return ERR_BUFFER if index_length < 0 or index_length > 67108864 or (index_length > 0 and not valid_memory_range(index_pointer, index_length, 1))
            return ERR_BUFFER if sentence_length < 0 or sentence_length > 67108864 or (sentence_length > 0 and not valid_memory_range(sentence_pointer, sentence_length, 1))
            trusted Unsafe.PointerCast:
                run: mutable heap ScrambleGame::ScrambleRun& = slot_pointers[slot.usize()].uintptr().cast[mutable heap ScrambleGame::ScrambleRun&]
                index: sview = StringView{data: index_pointer.uintptr().cast[u8&], len: index_length}
                sentences: sview = StringView{data: sentence_pointer.uintptr().cast[u8&], len: sentence_length}
                return ScrambleGame::set_corpus(run, index, sentences)

