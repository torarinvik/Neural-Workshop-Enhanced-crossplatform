                return ERR_BAD_OPTIONS if a < 1 or a > 8
                return ERR_BAD_OPTIONS if b < 1 or b > 500
                return ERR_BAD_OPTIONS if c < 1 or c > 6
                return ERR_BAD_OPTIONS if d != 0 or e != 0 or f != 0
                return OK
            return ERR_UNSUPPORTED_TASK

    def run_bytes(task: i64) -> i64:
        can Abort.Panic:
            if task == TASK_NBACK_3D: return size_of(NBack3DGame::NBack3DRun).i64()
