                elif key == KEY_DOWN: return TetrisGame::ACTION_DROP
                elif key == KEY_RESTART: return TetrisGame::ACTION_RESTART
                elif key >= KEY_ONE and key <= KEY_SIX: return TetrisGame::ACTION_SELECT_BASE + key - KEY_ONE
                return -1
            elif task == TASK_HANOI:
                if key == KEY_SPACE or key == KEY_ENTER:
