                    return MarbleMazeGame::info(run, field)

    def can_monkey_action(run: MonkeyLadderGame::MonkeyLadderRun&, action: i64,
                          value: i64, now_ms: i64) -> bool:
        can Abort.Panic:
            phase: i64 = MonkeyLadderGame::info(run, MonkeyLadderGame::INFO_PHASE)
            if action == MonkeyLadderGame::ACTION_START:
                return phase == MonkeyLadderGame::PHASE_READY or phase == MonkeyLadderGame::PHASE_RESULT
            elif action == MonkeyLadderGame::ACTION_TICK:
                return phase == MonkeyLadderGame::PHASE_SHOW and now_ms >= MonkeyLadderGame::info(run, MonkeyLadderGame::INFO_DEADLINE_MS)
            elif action == MonkeyLadderGame::ACTION_SELECT or action == MonkeyLadderGame::ACTION_COMMIT:
                return false if phase != MonkeyLadderGame::PHASE_INPUT
                cell: i64 = value if action == MonkeyLadderGame::ACTION_SELECT else MonkeyLadderGame::info(run, MonkeyLadderGame::INFO_CURSOR)
                return false if cell < 0 or cell >= MonkeyLadderGame::info(run, MonkeyLadderGame::INFO_GRID) * MonkeyLadderGame::info(run, MonkeyLadderGame::INFO_GRID)
                clicked: mutable i64 = 0
                clicked_count: i64 = MonkeyLadderGame::info(run, MonkeyLadderGame::INFO_NEXT_INDEX)
                while clicked < clicked_count |clicked, run, cell|:
                    return false if MonkeyLadderGame::cell(run, MonkeyLadderGame::CELL_CLICKED, clicked) == cell
                    clicked <- clicked + 1
                return true
            elif action == MonkeyLadderGame::ACTION_UP or action == MonkeyLadderGame::ACTION_DOWN or action == MonkeyLadderGame::ACTION_LEFT or action == MonkeyLadderGame::ACTION_RIGHT:
                return phase == MonkeyLadderGame::PHASE_INPUT
            return false

    def apply_action(index: i64, action: i64, value: i64,
                     now_ms: i64, aux: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            task: i64 = slot_tasks[index.usize()]
            pointer: i64 = slot_pointers[index.usize()]
            if task == TASK_NBACK_3D:
                trusted Unsafe.PointerCast:
                    run: mutable heap NBack3DGame::NBack3DRun& = pointer.uintptr().cast[mutable heap NBack3DGame::NBack3DRun&]
                    return NBack3DGame::apply(run, action, value, now_ms)
            elif task == TASK_SALESMAN:
                trusted Unsafe.PointerCast:
                    run: mutable heap SalesmanGame::Run& = pointer.uintptr().cast[mutable heap SalesmanGame::Run&]
                    return SalesmanGame::apply(run, action, value, now_ms)
            elif task == TASK_GRAPH_MAPPING:
                trusted Unsafe.PointerCast:
                    run: mutable heap GraphMappingGame::GraphMappingRun& = pointer.uintptr().cast[mutable heap GraphMappingGame::GraphMappingRun&]
                    if action == GraphMappingGame::ACTION_START:
                        GraphMappingGame::start_run(run, now_ms)
                        return ACCEPTED if GraphMappingGame::info(run, GraphMappingGame::INFO_PHASE) == GraphMappingGame::PHASE_ASKING else IGNORED
                    if action == GraphMappingGame::ACTION_SAME:
                        return GraphMappingGame::answer(run, GraphMapping::SAME, now_ms)
                    if action == GraphMappingGame::ACTION_DIFFERENT:
                        return GraphMappingGame::answer(run, GraphMapping::DIFFERENT, now_ms)
                    return ERR_BAD_EVENT
            elif task == TASK_CROSSED_WIRES:
                trusted Unsafe.PointerCast:
                    run: mutable heap CrossedWiresGame::Run& = pointer.uintptr().cast[mutable heap CrossedWiresGame::Run&]
                    pressed: i64 = value - 49 if value >= 49 and value <= 56 else value
                    return CrossedWiresGame::apply(run, action, pressed)
            elif task == TASK_SUDOKU:
                trusted Unsafe.PointerCast:
                    run: mutable heap SudokuGame::SudokuRun& = pointer.uintptr().cast[mutable heap SudokuGame::SudokuRun&]
                    return SudokuGame::apply(run, action, value, now_ms)
            elif task == TASK_MATRIX_REASONING:
                trusted Unsafe.PointerCast:
                    run: mutable heap MatrixReasoningGame::MatrixReasoningRun& = pointer.uintptr().cast[mutable heap MatrixReasoningGame::MatrixReasoningRun&]
                    if action == MatrixReasoningGame::ACTION_START:
                        return MatrixReasoningGame::apply(run, action, value, now_ms)
                    if action == MatrixReasoningGame::ACTION_ANSWER:
                        return MatrixReasoningGame::apply(run, action, value, now_ms)
                    if action > MatrixReasoningGame::ACTION_ANSWER and action < MatrixReasoningGame::ACTION_ANSWER + MatrixReasoningGame::MAX_CHOICES:
                        return MatrixReasoningGame::answer(run, action - MatrixReasoningGame::ACTION_ANSWER, now_ms)
                    return ERR_BAD_EVENT
            elif task == TASK_JIGSAW:
                trusted Unsafe.PointerCast:
                    run: mutable heap JigsawGame::JigsawRun& = pointer.uintptr().cast[mutable heap JigsawGame::JigsawRun&]
                    return JigsawGame::apply(run, action, value, now_ms)
            elif task == TASK_GO:
                trusted Unsafe.PointerCast:
                    run: mutable heap GoGame::GoRun& = pointer.uintptr().cast[mutable heap GoGame::GoRun&]
                    return GoGame::apply(run, action, value, now_ms)
            elif task == TASK_MONKEY_LADDER:
                trusted Unsafe.PointerCast:
                    run: mutable heap MonkeyLadderGame::MonkeyLadderRun& = pointer.uintptr().cast[mutable heap MonkeyLadderGame::MonkeyLadderRun&]
                    return IGNORED if not can_monkey_action(run, action, value, now_ms)
                    MonkeyLadderGame::action(run, action, value, now_ms)
                    return ACCEPTED
            elif task == TASK_SOKOBAN:
                trusted Unsafe.PointerCast:
                    run: mutable heap SokobanGame::SokobanRun& = pointer.uintptr().cast[mutable heap SokobanGame::SokobanRun&]
                    phase: i64 = SokobanGame::info(run, SokobanGame::INFO_PHASE)
                    if action == SokobanGame::ACTION_SPACE:
                        return IGNORED if phase != SokobanGame::PHASE_READY and phase != SokobanGame::PHASE_DONE and phase != SokobanGame::PHASE_SOLVED and phase != SokobanGame::PHASE_LOST
                    elif action >= SokobanGame::ACTION_UP and action <= SokobanGame::ACTION_RIGHT:
                        return IGNORED if phase != SokobanGame::PHASE_PUSHING
                    elif action == SokobanGame::ACTION_UNDO or action == SokobanGame::ACTION_RESTART:
                        return IGNORED if phase != SokobanGame::PHASE_PUSHING
                    else:
                        return ERR_BAD_EVENT
                    SokobanGame::apply(run, action, now_ms)
                    return ACCEPTED
            elif task == TASK_SOKOBAN_3D:
                trusted Unsafe.PointerCast:
                    run: mutable heap Sokoban3DGame::Run& = pointer.uintptr().cast[mutable heap Sokoban3DGame::Run&]
                    phase: i64 = Sokoban3DGame::info(run, Sokoban3DGame::INFO_PHASE)
                    if action == Sokoban3DGame::ACTION_START:
                        return IGNORED if phase != Sokoban3DGame::PHASE_READY and phase != Sokoban3DGame::PHASE_DONE and phase != Sokoban3DGame::PHASE_SOLVED and phase != Sokoban3DGame::PHASE_LOST
                    elif action >= Sokoban3DGame::ACTION_AHEAD and action <= Sokoban3DGame::ACTION_RIGHT:
                        return IGNORED if phase != Sokoban3DGame::PHASE_PUSHING
                    elif action == Sokoban3DGame::ACTION_UNDO or action == Sokoban3DGame::ACTION_RESTART:
                        return IGNORED if phase != Sokoban3DGame::PHASE_PUSHING
                    else:
                        return ERR_BAD_EVENT
                    return ACCEPTED if Sokoban3DGame::apply(run, action, now_ms) == 1 else IGNORED
            elif task == TASK_COUNT:
                trusted Unsafe.PointerCast:
                    run: mutable heap CountingGame::CountingRun& = pointer.uintptr().cast[mutable heap CountingGame::CountingRun&]
                    return CountingGame::apply(run, action, value, now_ms)
            elif task == TASK_HANOI:
                trusted Unsafe.PointerCast:
                    run: mutable heap HanoiGame::Run& = pointer.uintptr().cast[mutable heap HanoiGame::Run&]
                    return HanoiGame::apply(run, action, value, now_ms)
            elif task == TASK_MAZE:
                trusted Unsafe.PointerCast:
                    run: mutable heap MazeGame::Run& = pointer.uintptr().cast[mutable heap MazeGame::Run&]
                    return MazeGame::apply(run, action, now_ms)
            elif task == TASK_YOU_ARE_HERE:
                trusted Unsafe.PointerCast:
                    run: mutable heap YouAreHereGame::Run& = pointer.uintptr().cast[mutable heap YouAreHereGame::Run&]
                    return YouAreHereGame::apply(run, action, now_ms)
            elif task == TASK_NINA_ROW:
                trusted Unsafe.PointerCast:
                    run: mutable heap NinaRowGame::Run& = pointer.uintptr().cast[mutable heap NinaRowGame::Run&]
                    return NinaRowGame::apply(run, action, value, now_ms)
            elif task == TASK_NUMBEROLOGY:
                trusted Unsafe.PointerCast:
                    run: mutable heap NumberologyGame::NumberologyRun& = pointer.uintptr().cast[mutable heap NumberologyGame::NumberologyRun&]
                    return NumberologyGame::apply(run, action, value, now_ms)
            elif task == TASK_ALGEBRA:
                trusted Unsafe.PointerCast:
                    run: mutable heap AlgebraGame::AlgebraRun& = pointer.uintptr().cast[mutable heap AlgebraGame::AlgebraRun&]
                    return AlgebraGame::apply(run, action, value, now_ms)
            elif task == TASK_SCRAMBLE:
                trusted Unsafe.PointerCast:
                    run: mutable heap ScrambleGame::Run& = pointer.uintptr().cast[mutable heap ScrambleGame::Run&]
                    return ScrambleGame::apply(run, action, value, now_ms)
            elif task == TASK_SCRABBLE:
                trusted Unsafe.PointerCast:
                    run: mutable heap ScrabbleGame::Run& = pointer.uintptr().cast[mutable heap ScrabbleGame::Run&]
                    return ScrabbleGame::apply(run, action, value, now_ms)
            elif task == TASK_CROSSWORD:
                trusted Unsafe.PointerCast:
                    run: mutable heap CrosswordGame::Run& = pointer.uintptr().cast[mutable heap CrosswordGame::Run&]
                    return CrosswordGame::apply(run, action, value, now_ms)
            elif task == TASK_SYLLOGISM:
                trusted Unsafe.PointerCast:
                    run: mutable heap SyllogismGame::Run& = pointer.uintptr().cast[mutable heap SyllogismGame::Run&]
                    return SyllogismGame::apply(run, action, value, now_ms)
            elif task == TASK_CHESS:
                trusted Unsafe.PointerCast:
                    run: mutable heap ChessGame::Run& = pointer.uintptr().cast[mutable heap ChessGame::Run&]
                    return ChessGame::apply(run, action, value, now_ms)
            elif task == TASK_VERBAL:
                trusted Unsafe.PointerCast:
                    run: mutable heap VerbalGame::Run& = pointer.uintptr().cast[mutable heap VerbalGame::Run&]
                    return VerbalGame::apply(run, action, value, now_ms)
            elif task == TASK_IN_THE_DARK:
                trusted Unsafe.PointerCast:
                    run: mutable heap InTheDarkGame::InTheDarkRun& = pointer.uintptr().cast[mutable heap InTheDarkGame::InTheDarkRun&]
                    if action == InTheDarkGame::ACTION_START:
                        return InTheDarkGame::apply(run, action, value, now_ms)
                    return InTheDarkGame::answer(run, action - InTheDarkGame::ACTION_ANSWER_0, now_ms) if action >= InTheDarkGame::ACTION_ANSWER_0 and action <= InTheDarkGame::ACTION_ANSWER_4 else ERR_BAD_EVENT
            elif task == TASK_FOG_OF_WAR:
                trusted Unsafe.PointerCast:
                    run: mutable heap FogGame::FogRun& = pointer.uintptr().cast[mutable heap FogGame::FogRun&]
                    return FogGame::apply(run, action)
            elif task == TASK_CONCENTRATION:
                trusted Unsafe.PointerCast:
                    run: mutable heap ConcentrationGame::ConcentrationRun& = pointer.uintptr().cast[mutable heap ConcentrationGame::ConcentrationRun&]
                    return ConcentrationGame::apply(run, action, value, now_ms)
            elif task == TASK_RECOGNITION:
                trusted Unsafe.PointerCast:
                    run: mutable heap RecognitionGame::RecognitionRun& = pointer.uintptr().cast[mutable heap RecognitionGame::RecognitionRun&]
                    return RecognitionGame::apply(run, action, value, now_ms)
            elif task == TASK_TRIVIA:
                trusted Unsafe.PointerCast:
                    run: mutable heap TriviaGame::TriviaRun& = pointer.uintptr().cast[mutable heap TriviaGame::TriviaRun&]
                    return TriviaGame::apply(run, action, value)
            elif task == TASK_REMOVALS:
                trusted Unsafe.PointerCast:
                    run: mutable heap RemovalsGame::RemovalsRun& = pointer.uintptr().cast[mutable heap RemovalsGame::RemovalsRun&]
                    return RemovalsGame::apply(run, action, value, now_ms)
            elif task == TASK_CUSTODY:
                trusted Unsafe.PointerCast:
                    run: mutable heap CustodyGame::CustodyRun& = pointer.uintptr().cast[mutable heap CustodyGame::CustodyRun&]
                    return CustodyGame::apply(run, action, value, now_ms)
            elif task == TASK_NCUP_MONTE:
                trusted Unsafe.PointerCast:
                    run: mutable heap NCupMonteGame::NCupMonteRun& = pointer.uintptr().cast[mutable heap NCupMonteGame::NCupMonteRun&]
                    return NCupMonteGame::apply(run, action, value, now_ms)
            elif task == TASK_REFLEX:
                trusted Unsafe.PointerCast:
                    run: mutable heap ReflexGame::ReflexRun& = pointer.uintptr().cast[mutable heap ReflexGame::ReflexRun&]
                    return ReflexGame::apply(run, action, value, now_ms)
            elif task == TASK_TRACKING:
                trusted Unsafe.PointerCast:
                    run: mutable heap TrackingGame::TrackingRun& = pointer.uintptr().cast[mutable heap TrackingGame::TrackingRun&]
                    return TrackingGame::apply(run, action, value, now_ms)
            elif task == TASK_LOOKOUT:
                trusted Unsafe.PointerCast:
                    run: mutable heap LookoutGame::LookoutRun& = pointer.uintptr().cast[mutable heap LookoutGame::LookoutRun&]
                    return LookoutGame::apply(run, action, value, now_ms)
            elif task == TASK_BUZZ_WIRE:
                trusted Unsafe.PointerCast:
                    run: mutable heap BuzzWireGame::BuzzWireRun& = pointer.uintptr().cast[mutable heap BuzzWireGame::BuzzWireRun&]
                    return BuzzWireGame::apply(run, action, value, now_ms)
            elif task == TASK_OUT_OF_SIGHT:
                trusted Unsafe.PointerCast:
                    run: mutable heap OutOfSightGame::OutOfSightRun& = pointer.uintptr().cast[mutable heap OutOfSightGame::OutOfSightRun&]
                    return OutOfSightGame::apply(run, action, value, now_ms)
            elif task == TASK_PURSUIT:
                trusted Unsafe.PointerCast:
                    run: mutable heap PursuitGame::PursuitRun& = pointer.uintptr().cast[mutable heap PursuitGame::PursuitRun&]
                    return PursuitGame::apply(run, action, value, now_ms)
            elif task == TASK_DONKEY:
                trusted Unsafe.PointerCast:
                    run: mutable heap DonkeyGame::DonkeyRun& = pointer.uintptr().cast[mutable heap DonkeyGame::DonkeyRun&]
                    return DonkeyGame::apply(run, action, value, now_ms)
            elif task == TASK_OVERRUN:
                trusted Unsafe.PointerCast:
                    run: mutable heap OverrunGame::OverrunGameRun& = pointer.uintptr().cast[mutable heap OverrunGame::OverrunGameRun&]
                    return OverrunGame::apply(run, action, value, now_ms)
            elif task == TASK_TWO_HANDS:
                trusted Unsafe.PointerCast:
                    run: mutable heap TwoHandsGame::TwoHandsRun& = pointer.uintptr().cast[mutable heap TwoHandsGame::TwoHandsRun&]
                    return TwoHandsGame::apply(run, action, value, now_ms)
            elif task == TASK_MR_TIME:
                trusted Unsafe.PointerCast:
                    run: mutable heap MrTime::MrTimeRun& = pointer.uintptr().cast[mutable heap MrTime::MrTimeRun&]
                    return MrTime::apply(run, action, value, now_ms)
            elif task == TASK_TETRIS:
                trusted Unsafe.PointerCast:
                    run: mutable heap TetrisGame::TetrisRun& = pointer.uintptr().cast[mutable heap TetrisGame::TetrisRun&]
                    return TetrisGame::apply(run, action)
            else:
                trusted Unsafe.PointerCast:
                    run: mutable heap MarbleMazeGame::MarbleRun& = pointer.uintptr().cast[mutable heap MarbleMazeGame::MarbleRun&]
                    return MarbleMazeGame::action(run, action, value, aux)

    def valid_action_code(task: i64, action: i64) -> bool:
        can Abort.Panic:
            if task == TASK_NBACK_3D:
                return action >= NBack3DGame::ACTION_START and action <= NBack3DGame::ACTION_RESTART
            if task == TASK_SALESMAN:
                return action == SalesmanGame::ACTION_START or action == SalesmanGame::ACTION_PICK
            if task == TASK_GRAPH_MAPPING:
                return action == GraphMappingGame::ACTION_START or action == GraphMappingGame::ACTION_SAME or action == GraphMappingGame::ACTION_DIFFERENT
            if task == TASK_CROSSED_WIRES:
                return action >= CrossedWiresGame::ACTION_START and action <= CrossedWiresGame::ACTION_RESTART
            if task == TASK_SUDOKU:
                return action >= SudokuGame::ACTION_START and action <= SudokuGame::ACTION_PENCIL
            if task == TASK_MATRIX_REASONING:
                return action == MatrixReasoningGame::ACTION_START or (action >= MatrixReasoningGame::ACTION_ANSWER and action < MatrixReasoningGame::ACTION_ANSWER + MatrixReasoningGame::MAX_CHOICES)
            if task == TASK_JIGSAW:
                return action >= JigsawGame::ACTION_START and action <= JigsawGame::ACTION_TICK
            if task == TASK_GO:
                return action >= GoGame::ACTION_START and action <= GoGame::ACTION_RIGHT
            if task == TASK_MONKEY_LADDER:
                return action >= MonkeyLadderGame::ACTION_START and action <= MonkeyLadderGame::ACTION_COMMIT
            if task == TASK_SOKOBAN:
                return action >= SokobanGame::ACTION_SPACE and action <= SokobanGame::ACTION_RESTART
            if task == TASK_SOKOBAN_3D:
                return action >= Sokoban3DGame::ACTION_START and action <= Sokoban3DGame::ACTION_RESTART
            if task == TASK_COUNT:
                return action >= CountingGame::ACTION_START and action <= CountingGame::ACTION_SUBMIT
            if task == TASK_HANOI:
                return action >= HanoiGame::ACTION_START and action <= HanoiGame::ACTION_PICK_2
            if task == TASK_MAZE:
                return action >= MazeGame::ACTION_START and action <= MazeGame::ACTION_RESTART
            if task == TASK_YOU_ARE_HERE:
                return action >= YouAreHereGame::ACTION_START and action <= YouAreHereGame::ACTION_RESTART
            if task == TASK_NINA_ROW:
                return action >= NinaRowGame::ACTION_START and action <= NinaRowGame::ACTION_SUBMIT
            if task == TASK_NUMBEROLOGY:
                return action >= NumberologyGame::ACTION_START and action <= NumberologyGame::ACTION_SUBMIT
            if task == TASK_ALGEBRA:
                return action >= AlgebraGame::ACTION_START and action <= AlgebraGame::ACTION_SUBMIT
            if task == TASK_SCRAMBLE:
                return action >= ScrambleGame::ACTION_START and action <= ScrambleGame::ACTION_SUBMIT
            if task == TASK_SCRABBLE:
                return action >= ScrabbleGame::ACTION_START and action <= ScrabbleGame::ACTION_TOGGLE
            if task == TASK_CROSSWORD:
                return action >= CrosswordGame::START and action <= CrosswordGame::BACKSPACE
            if task == TASK_IN_THE_DARK:
                return action >= InTheDarkGame::ACTION_START and action <= InTheDarkGame::ACTION_ANSWER_4
            if task == TASK_FOG_OF_WAR:
                return action >= FogGame::ACTION_START and action <= FogGame::ACTION_RIGHT
            if task == TASK_CONCENTRATION:
                return action >= ConcentrationGame::ACTION_START and action <= ConcentrationGame::ACTION_SELECT
            if task == TASK_RECOGNITION:
                return action >= RecognitionGame::ACTION_START and action <= RecognitionGame::ACTION_REPLAY
            if task == TASK_TRIVIA:
                return action == TriviaGame::ACTION_START or action == TriviaGame::ACTION_UP or action == TriviaGame::ACTION_DOWN or action == TriviaGame::ACTION_SUBMIT or (action >= TriviaGame::ACTION_CHOOSE_0 and action < TriviaGame::ACTION_CHOOSE_0 + Trivia::MOST_OPTIONS) or action == TriviaGame::ACTION_ADVANCE
            if task == TASK_REMOVALS:
                return action >= RemovalsGame::ACTION_START and action <= RemovalsGame::ACTION_ANSWER_4
            if task == TASK_CUSTODY:
                return action >= CustodyGame::ACTION_START and action <= CustodyGame::ACTION_GRAB
            if task == TASK_NCUP_MONTE:
                return action >= NCupMonteGame::ACTION_START and action <= NCupMonteGame::ACTION_CHOOSE
            if task == TASK_REFLEX:
                return action == ReflexGame::ACTION_START
            if task == TASK_TRACKING:
                return action == TrackingGame::ACTION_START
            if task == TASK_LOOKOUT:
                return action >= LookoutGame::ACTION_START and action <= LookoutGame::ACTION_FORM
            if task == TASK_BUZZ_WIRE:
                return action >= BuzzWireGame::ACTION_START and action <= BuzzWireGame::ACTION_CLEAR
            if task == TASK_OUT_OF_SIGHT:
                return action >= OutOfSightGame::ACTION_START and action <= OutOfSightGame::ACTION_NOT_MINE
            if task == TASK_PURSUIT:
                return action >= PursuitGame::ACTION_START and action <= PursuitGame::ACTION_RIGHT
            if task == TASK_DONKEY:
                return action >= DonkeyGame::ACTION_START and action <= DonkeyGame::ACTION_SWITCH
            if task == TASK_OVERRUN:
                return action >= OverrunGame::ACTION_START and action <= OverrunGame::ACTION_ERASE
            if task == TASK_TWO_HANDS:
                return action >= TwoHandsGame::ACTION_START and action <= TwoHandsGame::ACTION_SLOWER
            if task == TASK_MR_TIME:
                return action >= MrTime::ACTION_START and action <= MrTime::ACTION_ACT
            if task == TASK_TETRIS:
                return action >= TetrisGame::ACTION_SPACE and action < TetrisGame::ACTION_SELECT_BASE + TetrisGame::MAX_PIECES
            return action >= MarbleMazeGame::ACTION_START and action <= MarbleMazeGame::ACTION_RECORD_RESULT

    def map_key(task: i64, key: i64, phase: i64) -> i64:
        can Abort.Panic:
            if task == TASK_NBACK_3D:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return NBack3DGame::ACTION_START if phase == NBack3DGame::PHASE_READY or phase == NBack3DGame::PHASE_DONE or phase == NBack3DGame::PHASE_ERROR else (NBack3DGame::ACTION_PAUSE if phase == NBack3DGame::PHASE_PAUSED else -1)
                elif key == KEY_MATCH:
                    return NBack3DGame::ACTION_MATCH if phase == NBack3DGame::PHASE_STIMULUS or phase == NBack3DGame::PHASE_RESPONSE or phase == NBack3DGame::PHASE_FEEDBACK else -1
                elif key == KEY_RESTART:
                    return NBack3DGame::ACTION_RESTART
                elif key == KEY_LEVEL:
                    return NBack3DGame::ACTION_PAUSE
                return -1
            elif task == TASK_SALESMAN:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return SalesmanGame::ACTION_START if phase == SalesmanGame::PHASE_READY or phase == SalesmanGame::PHASE_DONE else -1
                return -1
            elif task == TASK_GRAPH_MAPPING:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return GraphMappingGame::ACTION_START if phase == GraphMappingGame::PHASE_READY or phase == GraphMappingGame::PHASE_DONE else -1
                elif key == KEY_LEFT:
                    return GraphMappingGame::ACTION_SAME
                elif key == KEY_RIGHT:
                    return GraphMappingGame::ACTION_DIFFERENT
                return -1
            elif task == TASK_CROSSED_WIRES:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return CrossedWiresGame::ACTION_START if phase == CrossedWiresGame::PHASE_READY or phase == CrossedWiresGame::PHASE_SCORED or phase == CrossedWiresGame::PHASE_DONE else -1
                elif key == KEY_RESTART:
                    return CrossedWiresGame::ACTION_RESTART
                elif key >= KEY_ONE and key <= KEY_EIGHT:
                    return CrossedWiresGame::ACTION_PRESS
                return -1
            elif task == TASK_SUDOKU:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return SudokuGame::ACTION_START if phase == SudokuGame::PHASE_READY or phase == SudokuGame::PHASE_SOLVED or phase == SudokuGame::PHASE_DONE else -1
                elif key == KEY_UP: return SudokuGame::ACTION_UP if phase == SudokuGame::PHASE_SOLVING else -1
                elif key == KEY_DOWN: return SudokuGame::ACTION_DOWN if phase == SudokuGame::PHASE_SOLVING else -1
                elif key == KEY_LEFT: return SudokuGame::ACTION_LEFT if phase == SudokuGame::PHASE_SOLVING else -1
                elif key == KEY_RIGHT: return SudokuGame::ACTION_RIGHT if phase == SudokuGame::PHASE_SOLVING else -1
                elif key == KEY_UNDO: return SudokuGame::ACTION_ERASE if phase == SudokuGame::PHASE_SOLVING else -1
                elif key >= KEY_ONE and key <= KEY_EIGHT:
                    return SudokuGame::ACTION_WRITE if phase == SudokuGame::PHASE_SOLVING else -1
                return -1
            elif task == TASK_MATRIX_REASONING:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return MatrixReasoningGame::ACTION_START if phase == MatrixReasoningGame::PHASE_READY or phase == MatrixReasoningGame::PHASE_DONE else -1
                elif key >= KEY_ONE and key <= KEY_EIGHT:
                    return MatrixReasoningGame::ACTION_ANSWER + key - KEY_ONE if phase == MatrixReasoningGame::PHASE_ASKING or phase == MatrixReasoningGame::PHASE_HIDDEN else -1
                return -1
            elif task == TASK_JIGSAW:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return JigsawGame::ACTION_START if phase == JigsawGame::PHASE_READY or phase == JigsawGame::PHASE_DONE else -1
                return -1
            elif task == TASK_GO:
                if key == KEY_SPACE:
                    return GoGame::ACTION_START if phase == GoGame::PHASE_READY or phase == GoGame::PHASE_DONE else GoGame::ACTION_NEXT if phase == GoGame::PHASE_JUDGED else -1
                if key == KEY_ENTER: return GoGame::ACTION_ANSWER if phase == GoGame::PHASE_SOLVING else -1
                if key == KEY_UP: return GoGame::ACTION_UP if phase == GoGame::PHASE_SOLVING else -1
                if key == KEY_DOWN: return GoGame::ACTION_DOWN if phase == GoGame::PHASE_SOLVING else -1
                if key == KEY_LEFT: return GoGame::ACTION_LEFT if phase == GoGame::PHASE_SOLVING else -1
                if key == KEY_RIGHT: return GoGame::ACTION_RIGHT if phase == GoGame::PHASE_SOLVING else -1
