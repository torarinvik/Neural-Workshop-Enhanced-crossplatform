            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&out[0]).cast[void&], STATE_BYTES.usize())
            return STATE_BYTES

    def read_state_rest(handle: i64, dest: i64, capacity: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_BUFFER if capacity < STATE_BYTES
            return ERR_BUFFER if not valid_memory_range(dest, STATE_BYTES, 8)
            task: i64 = slot_tasks[index.usize()]
            out: mutable darray[u8] = []
            append_u32(&out, STATE_MAGIC)
            append_u32(&out, 1.u32())
            append_u32(&out, task.u32())
            append_u32(&out, 12.u32())
            if task == TASK_STEADICAM:
                for field in 0..<18 |field, index, out|:
                    append_i64(&out, task_info(index, field))
