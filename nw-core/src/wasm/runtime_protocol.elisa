                elif key == KEY_UNDO: return MrTime::ACTION_BACKSPACE
                return -1
            elif task == TASK_TETRIS:
                if key == KEY_SPACE or key == KEY_ENTER: return TetrisGame::ACTION_SPACE
                elif key == KEY_LEFT: return TetrisGame::ACTION_LEFT
