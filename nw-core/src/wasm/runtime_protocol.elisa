            if task == TASK_CIPHER_ABYSS:
                return action >= 0 and action <= CipherAbyssGame::START
            if task == TASK_ROVER:
                return action >= 0 and action <= RoverGame::START
            if task == TASK_STOP_SWITCH:
                return action >= 0 and action <= StopSwitchGame::START
            if task == TASK_FALLS:
                return action >= 0 and action <= 1
            if task == TASK_WHAT_NEXT:
                return action >= 0 and action <= 2
            if task == TASK_VIDEO_SEQUENCE:
                return action >= VideoSequence::ACTION_START and action <= VideoSequence::ACTION_CLIP_UNAVAILABLE
            if task == TASK_JIGSAW:
                return (action >= JigsawGame::ACTION_START and action <= JigsawGame::ACTION_TICK) or action == JigsawGame::ACTION_FIT_PHOTO or action == JigsawGame::ACTION_VIDEO_UNAVAILABLE
            if task == TASK_GO:
                return action >= GoGame::ACTION_START and action <= GoGame::ACTION_LEVEL
            if task == TASK_MONKEY_LADDER:
                return action >= MonkeyLadderGame::ACTION_START and action <= MonkeyLadderGame::ACTION_COMMIT
            if task == TASK_SOKOBAN:
                return action >= SokobanGame::ACTION_SPACE and action <= SokobanGame::ACTION_RESTART
            if task == TASK_SOKOBAN_3D:
                return action >= Sokoban3DGame::ACTION_START and action <= Sokoban3DGame::ACTION_RESTART
            if task == TASK_COUNT:
                return action >= CountingGame::ACTION_START and action <= CountingGame::ACTION_SUBMIT
            if task == TASK_HANOI:
                return action >= HanoiGame::ACTION_START and action <= HanoiGame::ACTION_PICK_2
            if task == TASK_COOKIE_THIEF:
                return action >= CookieThiefGame::ACTION_START and action <= CookieThiefGame::ACTION_WAIT
            if task == TASK_MAZE:
                return action >= MazeGame::ACTION_START and action <= MazeGame::ACTION_RESTART
            if task == TASK_YOU_ARE_HERE:
                return action >= YouAreHereGame::ACTION_START and action <= YouAreHereGame::ACTION_RESTART
            if task == TASK_NINA_ROW:
                return action >= NinaRowGame::ACTION_START and action <= NinaRowGame::ACTION_SUBMIT
            if task == TASK_NUMBEROLOGY:
                return action >= NumberologyGame::ACTION_START and action <= NumberologyGame::ACTION_NEXT_PAGE
            if task == TASK_ALGEBRA:
                return action >= AlgebraGame::ACTION_START and action <= AlgebraGame::ACTION_START_CLOCK
            if task == TASK_SCRAMBLE:
                return action >= ScrambleGame::ACTION_START and action <= ScrambleGame::ACTION_START_CLOCK
            if task == TASK_SCRABBLE:
                return action >= ScrabbleGame::ACTION_START and action <= ScrabbleGame::ACTION_START_CLOCK
            if task == TASK_CROSSWORD:
                return action >= CrosswordGame::START and action <= CrosswordGame::APPLY_OPTIONS
            if task == TASK_IN_THE_DARK:
                return action >= InTheDarkGame::ACTION_START and action <= InTheDarkGame::ACTION_ANSWER_4
            if task == TASK_FOG_OF_WAR:
                return action >= FogGame::ACTION_START and action <= FogGame::ACTION_RIGHT
            if task == TASK_CONCENTRATION:
                return action >= ConcentrationGame::ACTION_START and action <= ConcentrationGame::ACTION_SELECT
            if task == TASK_RECOGNITION:
                return action >= RecognitionGame::ACTION_START and action <= RecognitionGame::ACTION_REPLAY
            if task == TASK_TRIVIA:
                return action == TriviaGame::ACTION_START or action == TriviaGame::ACTION_UP or action == TriviaGame::ACTION_DOWN or action == TriviaGame::ACTION_SUBMIT or (action >= TriviaGame::ACTION_CHOOSE_0 and action < TriviaGame::ACTION_CHOOSE_0 + Trivia::MOST_OPTIONS) or action == TriviaGame::ACTION_ADVANCE
            if task == TASK_REMOVALS:
                return action >= RemovalsGame::ACTION_START and action <= RemovalsGame::ACTION_ANSWER_4
            if task == TASK_CUSTODY:
                return action >= CustodyGame::ACTION_START and action <= CustodyGame::ACTION_GRAB
            if task == TASK_NCUP_MONTE:
                return action >= NCupMonteGame::ACTION_START and action <= NCupMonteGame::ACTION_CHOOSE
            if task == TASK_REFLEX:
                return action == ReflexGame::ACTION_START
            if task == TASK_TRACKING:
                return action == TrackingGame::ACTION_START
            if task == TASK_LOOKOUT:
                return action >= LookoutGame::ACTION_START and action <= LookoutGame::ACTION_FORM
            if task == TASK_BUZZ_WIRE:
                return action >= BuzzWireGame::ACTION_START and action <= BuzzWireGame::ACTION_CLEAR
            if task == TASK_OUT_OF_SIGHT:
                return action >= OutOfSightGame::ACTION_START and action <= OutOfSightGame::ACTION_NOT_MINE
            if task == TASK_PURSUIT:
                return action >= PursuitGame::ACTION_START and action <= PursuitGame::ACTION_RIGHT
            if task == TASK_DONKEY:
                return action >= DonkeyGame::ACTION_START and action <= DonkeyGame::ACTION_SWITCH
            if task == TASK_OVERRUN:
                return action >= OverrunGame::ACTION_START and action <= OverrunGame::ACTION_ERASE
            if task == TASK_TWO_HANDS:
                return action >= TwoHandsGame::ACTION_START and action <= TwoHandsGame::ACTION_SLOWER
            if task == TASK_MR_TIME:
                return action >= MrTime::ACTION_START and action <= MrTime::ACTION_ACT
            if task == TASK_TETRIS:
                return action >= TetrisGame::ACTION_SPACE and action < TetrisGame::ACTION_SELECT_BASE + TetrisGame::MAX_PIECES
            return action >= MarbleMazeGame::ACTION_START and action <= MarbleMazeGame::ACTION_RECORD_RESULT

    def heavier_key_slot(code: i64) -> i64:
        return code - KEY_ONE if code >= KEY_ONE and code <= KEY_FOUR
        return -1

    def morning_round_key_slot(code: i64) -> i64:
        return 0 if code == KEY_LEFT
        return 1 if code == KEY_RIGHT
        return 2 if code == KEY_UP
        return 3 if code == KEY_DOWN
        return 4 if code == KEY_CRANE_ALIAS_FIRST + 2
        return 5 if code == KEY_CRANE_ALIAS_LAST
        return 6 if code == KEY_CRANE_ALIAS_FIRST
        return 7 if code == KEY_CRANE_ALIAS_FIRST + 1
        return -1

    def rover_key_slot(code: i64) -> i64:
        return 0 if code == KEY_UP
        return 1 if code == KEY_DOWN
        return 2 if code == KEY_LEFT
        return 3 if code == KEY_RIGHT
        return 4 + code - KEY_CRANE_ALIAS_FIRST if code >= KEY_CRANE_ALIAS_FIRST and code <= KEY_CRANE_ALIAS_LAST
        return -1

    def docking_key_slot(code: i64) -> i64:
        return Docking::YAW_L if code == KEY_LEFT
        return Docking::YAW_R if code == KEY_RIGHT
        return Docking::PITCH_U if code == KEY_UP
        return Docking::PITCH_D if code == KEY_DOWN
        return code - 77 if code >= 77 and code <= 82
        return Docking::ROLL_L if code == 83
        return Docking::ROLL_R if code == 84
        return -1

    def crane_key_slot(code: i64) -> i64:
        return Crane::LEFT if code == KEY_LEFT
        return Crane::RIGHT if code == KEY_RIGHT
        return Crane::UP if code == KEY_UP
        return Crane::DOWN if code == KEY_DOWN
        return 4 + code - KEY_CRANE_ALIAS_FIRST if code >= KEY_CRANE_ALIAS_FIRST and code <= KEY_CRANE_ALIAS_LAST
        return -1

    def loading_dock_key(key: i64) -> i64:
        return 0 if key == KEY_UP
        return 1 if key == KEY_DOWN
        return 2 if key == KEY_LEFT
        return 3 if key == KEY_RIGHT
        return 4 if key == 87 or key == 119
        return 5 if key == 83 or key == 115
        return 6 if key == 65 or key == 97
        return 7 if key == 68 or key == 100
        return -1

    def cipher_abyss_key(code: i64) -> i64:
        return CipherAbyss::SYMBOL + code - KEY_ONE if code >= KEY_ONE and code <= KEY_EIGHT
        return CipherAbyss::RUN if code == KEY_ENTER
        return CipherAbyss::DELETE if code == KEY_BACKSPACE
        return CipherAbyss::ADD_BLOCK if code == KEY_SPACE
        return CipherAbyss::NEXT_BLOCK if code == KEY_DOWN
        return CipherAbyss::PREV_BLOCK if code == KEY_UP
        return CipherAbyss::UNDO_BLOCK if code == KEY_UNDO
        return CipherAbyss::TEST if code == KEY_CIPHER_TEST
        return CipherAbyss::CHECK if code == KEY_CIPHER_CHECK
        return CipherAbyss::SUBMIT if code == KEY_CIPHER_SUBMIT
        return CipherAbyss::PREDICT if code == KEY_CIPHER_PREDICT
        return CipherAbyss::SCROLL_UP if code == KEY_CIPHER_PAGE_UP
        return CipherAbyss::SCROLL_DOWN if code == KEY_CIPHER_PAGE_DOWN
        return CipherAbyss::MARK if code == KEY_CIPHER_MARK
        return CipherAbyss::NUMBERS if code == KEY_CIPHER_NUMBERS
        return CipherAbyss::SORT if code == KEY_CIPHER_SORT
        return -1

    def map_key(task: i64, key: i64, phase: i64) -> i64:
        can Abort.Panic:
            if task == TASK_NBACK_3D:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return NBack3DGame::ACTION_START if phase == NBack3DGame::PHASE_READY or phase == NBack3DGame::PHASE_DONE or phase == NBack3DGame::PHASE_ERROR else (NBack3DGame::ACTION_PAUSE if phase == NBack3DGame::PHASE_PAUSED else -1)
                elif key == KEY_MATCH:
                    return NBack3DGame::ACTION_MATCH if phase == NBack3DGame::PHASE_STIMULUS or phase == NBack3DGame::PHASE_RESPONSE or phase == NBack3DGame::PHASE_FEEDBACK else -1
                elif key == KEY_RESTART:
                    return NBack3DGame::ACTION_RESTART
                elif key == KEY_LEVEL:
                    return NBack3DGame::ACTION_PAUSE
                return -1
            elif task == TASK_SALESMAN:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return SalesmanGame::ACTION_START if phase == SalesmanGame::PHASE_READY or phase == SalesmanGame::PHASE_DONE else -1
                return -1
            elif task == TASK_GRAPH_MAPPING:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return GraphMappingGame::ACTION_START if phase == GraphMappingGame::PHASE_READY or phase == GraphMappingGame::PHASE_DONE else -1
                elif key == KEY_LEFT:
                    return GraphMappingGame::ACTION_SAME
                elif key == KEY_RIGHT:
                    return GraphMappingGame::ACTION_DIFFERENT
                return -1
            elif task == TASK_CROSSED_WIRES:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return CrossedWiresGame::ACTION_START if phase == CrossedWiresGame::PHASE_READY or phase == CrossedWiresGame::PHASE_SCORED or phase == CrossedWiresGame::PHASE_DONE else -1
                elif key >= KEY_ONE and key <= KEY_EIGHT:
                    return CrossedWiresGame::ACTION_PRESS
                return -1
            elif task == TASK_SUDOKU:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return SudokuGame::ACTION_START if phase == SudokuGame::PHASE_READY or phase == SudokuGame::PHASE_SOLVED or phase == SudokuGame::PHASE_DONE else -1
                elif key == KEY_UP: return SudokuGame::ACTION_UP if phase == SudokuGame::PHASE_SOLVING else -1
                elif key == KEY_DOWN: return SudokuGame::ACTION_DOWN if phase == SudokuGame::PHASE_SOLVING else -1
                elif key == KEY_LEFT: return SudokuGame::ACTION_LEFT if phase == SudokuGame::PHASE_SOLVING else -1
                elif key == KEY_RIGHT: return SudokuGame::ACTION_RIGHT if phase == SudokuGame::PHASE_SOLVING else -1
                elif key == KEY_UNDO: return SudokuGame::ACTION_ERASE if phase == SudokuGame::PHASE_SOLVING else -1
                elif key >= KEY_ONE and key <= KEY_EIGHT:
                    return SudokuGame::ACTION_WRITE if phase == SudokuGame::PHASE_SOLVING else -1
                return -1
            elif task == TASK_MATRIX_REASONING:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return MatrixReasoningGame::ACTION_START if phase == MatrixReasoningGame::PHASE_READY or phase == MatrixReasoningGame::PHASE_DONE else -1
                elif key >= KEY_ONE and key <= KEY_EIGHT:
                    return MatrixReasoningGame::ACTION_ANSWER + key - KEY_ONE if phase == MatrixReasoningGame::PHASE_ASKING or phase == MatrixReasoningGame::PHASE_HIDDEN else -1
                return -1
            elif task == TASK_HIDDEN_RULE:
                return HiddenRuleGame::START if key == KEY_SPACE and (phase == HiddenRuleGame::READY or phase == HiddenRuleGame::DONE)
                return key - KEY_ONE if phase == HiddenRuleGame::TESTING and key >= KEY_ONE and key <= KEY_SIX
                return -1
            elif task == TASK_HIDDEN_WIRING:
                return HiddenWiringGame::START if key == KEY_SPACE and (phase == HiddenWiringGame::READY or phase == HiddenWiringGame::DONE)
                return key - KEY_ONE if (phase == HiddenWiringGame::LOOKING or phase == HiddenWiringGame::EXAMINING) and key >= KEY_ONE and key <= KEY_EIGHT
                return HiddenWiringGame::ANSWER if key == KEY_ENTER and phase == HiddenWiringGame::EXAMINING
                return -1
            elif task == TASK_TRIAGE:
                return TriageGame::START if key == KEY_SPACE and (phase == TriageGame::READY or phase == TriageGame::FINISHED)
                return key - KEY_ONE if phase == TriageGame::PLAYING and key >= KEY_ONE and key <= KEY_EIGHT
                return TriageGame::DONE if key == KEY_ENTER and phase == TriageGame::PLAYING
                return -1
            elif task == TASK_DELAY:
                return DelayGame::START if key == KEY_SPACE and (phase == DelayGame::READY or phase == DelayGame::DONE)
                return DelayGame::TAKE if key == KEY_LEFT and phase == DelayGame::PLAYING
                return DelayGame::WAIT if key == KEY_RIGHT and phase == DelayGame::PLAYING
                return -1
            elif task == TASK_HOLD_IT:
                return -1 if key != KEY_SPACE
                return HoldItGame::START if phase == HoldItGame::READY or phase == HoldItGame::DONE
                return HoldItGame::PRESS
            elif task == TASK_TIME_IT:
                return -1 if key != KEY_SPACE
                return TimeItGame::START if phase == TimeItGame::READY or phase == TimeItGame::DONE
                return TimeIt::PRESS
            elif task == TASK_BEAT:
                return -1 if key != KEY_SPACE
                return BeatGame::START if phase == BeatGame::READY or phase == BeatGame::DONE
                return Beat::TAP
            elif task == TASK_CATCH:
                return CatchGame::START if key == KEY_SPACE
                return 0 if key == KEY_LEFT
                return 1 if key == KEY_RIGHT
                return 2 if key == KEY_DOWN
                return 3 if key == KEY_UP
                return -1
            elif task == TASK_ECHO_CAVE:
                return (EchoCaveGame::START if phase == EchoCaveGame::READY or phase == EchoCaveGame::DONE else EchoCave::CLICK) if key == KEY_SPACE
                return 2 if key == KEY_LEFT
                return 3 if key == KEY_RIGHT
                return 1 if key == KEY_DOWN
                return 0 if key == KEY_UP
                return -1
            elif task == TASK_DRONE_HOOPS:
                return (DroneHoopsGame::START if phase == DroneHoopsGame::READY or phase == DroneHoopsGame::DONE else 8) if key == KEY_SPACE
                return 2 if key == KEY_LEFT
                return 3 if key == KEY_RIGHT
                return 1 if key == KEY_DOWN
                return 0 if key == KEY_UP
                return -1
            elif task == TASK_FIELD_MANUAL:
                return FieldManualGame::START if key == KEY_SPACE and (phase == FieldManualGame::READY or phase == FieldManualGame::DONE)
                return FieldManual::SHIFT if key == KEY_SHIFT
                return FieldManual::DIGIT + key - KEY_ONE + 1 if key >= KEY_ONE and key <= KEY_EIGHT
                return FieldManual::DIGIT + 9 if key == KEY_NINE
                return FieldManual::DIGIT if key == KEY_ZERO
                return -1
            elif task == TASK_SAFECRACKER:
                return SafecrackerGame::START if key == KEY_SPACE and (phase == SafecrackerGame::READY or phase == SafecrackerGame::DONE)
                return Safecracker::LETTER + key - 65 if key >= 65 and key <= 90
                return Safecracker::BACKSPACE if key == KEY_BACKSPACE
                return -1
            elif task == TASK_STAGEHAND:
                return StagehandGame::START if key == KEY_SPACE and (phase == StagehandGame::READY or phase == StagehandGame::DONE)
                return Stagehand::KEY if key == 76
                return Stagehand::KEY + 1 if key == 67
                return Stagehand::KEY + 2 if key == 77
                return Stagehand::KEY + 3 if key == 83
                return Stagehand::KEY + 4 if key == 84
                return -1
            elif task == TASK_LOADING_DOCK:
                return LoadingDockGame::START if key == KEY_SPACE and (phase == LoadingDockGame::READY or phase == LoadingDockGame::DONE)
                index: i64 = loading_dock_key(key)
                return LoadingDockGame::DRIVE_DOWN + index if index >= 0 else -1
            elif task == TASK_GUNSLINGER:
                return GunslingerGame::START if key == KEY_SPACE and (phase == GunslingerGame::READY or phase == GunslingerGame::DONE)
                return Gunslinger::COCK if key == KEY_SPACE and phase == GunslingerGame::PLAYING
                return -1
            elif task == TASK_BALANCE:
                return BalanceGame::START if key == KEY_SPACE
                return Balance::LEFT if key == KEY_LEFT
                return Balance::RIGHT if key == KEY_RIGHT
                return -1
            elif task == TASK_JUGGLER:
                return JugglerGame::START if key == KEY_SPACE
                return Juggler::LEFT if key == KEY_LEFT
                return Juggler::RIGHT if key == KEY_RIGHT
                return -1
            elif task == TASK_LANDER:
                return LanderGame::START if key == KEY_SPACE
                return Lander::THRUST if key == KEY_UP
                return Lander::LEFT if key == KEY_LEFT
                return Lander::RIGHT if key == KEY_RIGHT
                return -1
            elif task == TASK_STOP_SWITCH:
                return StopSwitchGame::START if key == KEY_SPACE and (phase == StopSwitchGame::READY or phase == StopSwitchGame::DONE)
                return 0 if key == KEY_LEFT and phase == StopSwitchGame::PLAYING
                return 1 if key == KEY_RIGHT and phase == StopSwitchGame::PLAYING
                return -1
            elif task == TASK_VIDEO_SEQUENCE:
                return VideoSequence::ACTION_START if key == KEY_SPACE and (phase == Jigsaw::PHASE_READY or phase == Jigsaw::PHASE_DONE) else -1
            elif task == TASK_JIGSAW:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return JigsawGame::ACTION_START if phase == JigsawGame::PHASE_READY or phase == JigsawGame::PHASE_DONE else (JigsawGame::ACTION_PICK_CURSOR if phase == JigsawGame::PHASE_SOLVING else -1)
                if phase == JigsawGame::PHASE_SOLVING and key >= KEY_LEFT and key <= KEY_DOWN:
                    return JigsawGame::ACTION_MOVE_CURSOR
                return -1
            elif task == TASK_GO:
                if key == KEY_SPACE:
                    return GoGame::ACTION_START if phase == GoGame::PHASE_READY or phase == GoGame::PHASE_DONE else GoGame::ACTION_NEXT if phase == GoGame::PHASE_JUDGED else -1
                if key == KEY_ENTER: return GoGame::ACTION_ANSWER if phase == GoGame::PHASE_SOLVING else -1
                if (key >= KEY_ONE and key <= KEY_EIGHT) or key == KEY_NINE or key == KEY_ZERO:
                    return GoGame::ACTION_LEVEL if phase == GoGame::PHASE_READY or phase == GoGame::PHASE_DONE else -1
                if key == KEY_UP: return GoGame::ACTION_UP if phase == GoGame::PHASE_SOLVING else -1
                if key == KEY_DOWN: return GoGame::ACTION_DOWN if phase == GoGame::PHASE_SOLVING else -1
                if key == KEY_LEFT: return GoGame::ACTION_LEFT if phase == GoGame::PHASE_SOLVING else -1
                if key == KEY_RIGHT: return GoGame::ACTION_RIGHT if phase == GoGame::PHASE_SOLVING else -1
                return -1
            elif task == TASK_MONKEY_LADDER:
                if key == KEY_SPACE:
                    return MonkeyLadderGame::ACTION_START if phase == MonkeyLadderGame::PHASE_READY or phase == MonkeyLadderGame::PHASE_RESULT else -1
                elif key == KEY_ENTER:
                    return MonkeyLadderGame::ACTION_COMMIT if phase == MonkeyLadderGame::PHASE_INPUT else -1
                elif key == KEY_LEFT: return MonkeyLadderGame::ACTION_LEFT
                elif key == KEY_RIGHT: return MonkeyLadderGame::ACTION_RIGHT
                elif key == KEY_UP: return MonkeyLadderGame::ACTION_UP
                elif key == KEY_DOWN: return MonkeyLadderGame::ACTION_DOWN
                return -1
            elif task == TASK_SOKOBAN:
                if key == KEY_SPACE or key == KEY_ENTER: return SokobanGame::ACTION_SPACE
                elif key == KEY_UP: return SokobanGame::ACTION_UP
                elif key == KEY_DOWN: return SokobanGame::ACTION_DOWN
                elif key == KEY_LEFT: return SokobanGame::ACTION_LEFT
                elif key == KEY_RIGHT: return SokobanGame::ACTION_RIGHT
                elif key == KEY_UNDO: return SokobanGame::ACTION_UNDO
                elif key == KEY_RESTART: return SokobanGame::ACTION_RESTART
                return -1
            elif task == TASK_SOKOBAN_3D:
                if key == KEY_SPACE or key == KEY_ENTER: return Sokoban3DGame::ACTION_START
                elif key == KEY_UP: return Sokoban3DGame::ACTION_AHEAD
                elif key == KEY_DOWN: return Sokoban3DGame::ACTION_BACK
                elif key == KEY_LEFT: return Sokoban3DGame::ACTION_LEFT
                elif key == KEY_RIGHT: return Sokoban3DGame::ACTION_RIGHT
                elif key == KEY_UNDO: return Sokoban3DGame::ACTION_UNDO
                elif key == KEY_RESTART: return Sokoban3DGame::ACTION_RESTART
                return -1
            elif task == TASK_COUNT:
                if key == KEY_SPACE:
                    return CountingGame::ACTION_START if phase == CountingGame::PHASE_READY or phase == CountingGame::PHASE_DONE else -1
                elif key == KEY_ENTER: return CountingGame::ACTION_SUBMIT
                elif key == KEY_UNDO: return CountingGame::ACTION_BACKSPACE
                return -1
            elif task == TASK_MR_TIME:
                if key == KEY_SPACE:
                    if phase == MrTime::PHASE_READY or phase == MrTime::PHASE_DONE:
                        return MrTime::ACTION_START
                    return MrTime::ACTION_ACT if phase == MrTime::PHASE_COUNTING else -1
                elif key == KEY_ENTER:
                    if phase == MrTime::PHASE_READY or phase == MrTime::PHASE_DONE:
                        return MrTime::ACTION_START
                    return MrTime::ACTION_SUBMIT if phase == MrTime::PHASE_ASKING else -1
                elif key == KEY_UNDO: return MrTime::ACTION_BACKSPACE
                return -1
            elif task == TASK_TETRIS:
                if key == KEY_SPACE or key == KEY_ENTER: return TetrisGame::ACTION_SPACE
                elif key == KEY_LEFT: return TetrisGame::ACTION_LEFT
                elif key == KEY_RIGHT: return TetrisGame::ACTION_RIGHT
                elif key == KEY_UP: return TetrisGame::ACTION_ROTATE
                elif key == KEY_DOWN: return TetrisGame::ACTION_DROP
                elif key == KEY_RESTART: return TetrisGame::ACTION_RESTART
                elif key >= KEY_ONE and key <= KEY_SIX: return TetrisGame::ACTION_SELECT_BASE + key - KEY_ONE
                return -1
            elif task == TASK_HANOI:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return HanoiGame::ACTION_START if phase == HanoiGame::PHASE_READY or phase == HanoiGame::PHASE_DONE else -1
                elif key == KEY_ONE or key == KEY_TWO or key == KEY_THREE:
                    return key - KEY_ONE + HanoiGame::ACTION_PICK_0 if phase == HanoiGame::PHASE_SOLVING else -1
                return -1
            elif task == TASK_COOKIE_THIEF:
                return CookieThiefGame::ACTION_START if key == KEY_SPACE or key == KEY_ENTER
                return CookieThiefGame::ACTION_GRAB if key == KEY_UP
                return CookieThiefGame::ACTION_LEAVE if key == KEY_DOWN
                return CookieThiefGame::ACTION_LUNGE if key == KEY_RIGHT
                return -1
            elif task == TASK_MAZE:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return MazeGame::ACTION_START if phase == MazeGame::PHASE_READY or phase == MazeGame::PHASE_DONE or phase == MazeGame::PHASE_SOLVED else -1
                elif key == KEY_UP: return MazeGame::ACTION_UP
                elif key == KEY_DOWN: return MazeGame::ACTION_DOWN
                elif key == KEY_LEFT: return MazeGame::ACTION_LEFT
                elif key == KEY_RIGHT: return MazeGame::ACTION_RIGHT
                elif key == KEY_RESTART: return MazeGame::ACTION_RESTART
                return -1
            elif task == TASK_YOU_ARE_HERE:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return YouAreHereGame::ACTION_START if phase == YouAreHereGame::PHASE_READY or phase == YouAreHereGame::PHASE_DONE or phase == YouAreHereGame::PHASE_SOLVED else -1
                elif key == KEY_UP: return YouAreHereGame::ACTION_AHEAD
                elif key == KEY_DOWN: return YouAreHereGame::ACTION_BACK
                elif key == KEY_LEFT: return YouAreHereGame::ACTION_LEFT
                elif key == KEY_RIGHT: return YouAreHereGame::ACTION_RIGHT
                elif key == KEY_RESTART: return YouAreHereGame::ACTION_RESTART
                return -1
            elif task == TASK_NINA_ROW:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return NinaRowGame::ACTION_START if phase == NinaRowGame::PHASE_READY or phase == NinaRowGame::PHASE_DONE or phase == NinaRowGame::PHASE_JUDGED else (NinaRowGame::ACTION_SUBMIT if key == KEY_ENTER and phase == NinaRowGame::PHASE_ASKING else -1)
                elif key == KEY_UP: return NinaRowGame::ACTION_UP
                elif key == KEY_DOWN: return NinaRowGame::ACTION_DOWN
                elif key == KEY_LEFT: return NinaRowGame::ACTION_LEFT
                elif key == KEY_RIGHT: return NinaRowGame::ACTION_RIGHT
                return -1
            elif task == TASK_NUMBEROLOGY:
                if key == KEY_SPACE:
                    return NumberologyGame::ACTION_START if phase == NumberologyGame::PHASE_READY or phase == NumberologyGame::PHASE_DONE or phase == NumberologyGame::PHASE_JUDGED else -1
                elif key == KEY_ENTER: return NumberologyGame::ACTION_SUBMIT
                elif key == KEY_UNDO: return NumberologyGame::ACTION_BACKSPACE
                return -1
            elif task == TASK_ALGEBRA:
                if key == KEY_SPACE:
                    return AlgebraGame::ACTION_START if phase == AlgebraGame::PHASE_READY or phase == AlgebraGame::PHASE_DONE or phase == AlgebraGame::PHASE_JUDGED else -1
                elif key == KEY_ENTER: return AlgebraGame::ACTION_SUBMIT
                elif key == KEY_UNDO: return AlgebraGame::ACTION_BACKSPACE
                return -1
            elif task == TASK_SCRAMBLE:
                if key == KEY_SPACE:
                    return ScrambleGame::ACTION_START if phase == ScrambleGame::PHASE_READY or phase == ScrambleGame::PHASE_DONE or phase == ScrambleGame::PHASE_JUDGED else -1
                elif key == KEY_ENTER: return ScrambleGame::ACTION_SUBMIT
                elif key == KEY_UNDO: return ScrambleGame::ACTION_BACKSPACE
                return -1
            elif task == TASK_SCRABBLE:
                if key == KEY_SPACE:
                    return ScrabbleGame::ACTION_START if phase == ScrabbleGame::PHASE_READY or phase == ScrabbleGame::PHASE_DONE or phase == ScrabbleGame::PHASE_SCORED else -1
                elif key == KEY_ENTER: return ScrabbleGame::ACTION_PLAY
                elif key == KEY_LEFT: return ScrabbleGame::ACTION_LEFT
                elif key == KEY_RIGHT: return ScrabbleGame::ACTION_RIGHT
                elif key == KEY_UP: return ScrabbleGame::ACTION_UP
                elif key == KEY_DOWN: return ScrabbleGame::ACTION_DOWN
                elif key == KEY_TAB: return ScrabbleGame::ACTION_TOGGLE
                elif key == KEY_UNDO: return ScrabbleGame::ACTION_BACK
                elif key >= KEY_ONE and key <= KEY_SEVEN: return ScrabbleGame::ACTION_LAY
                return -1
            elif task == TASK_CROSSWORD:
                if key == KEY_SPACE:
                    return CrosswordGame::START if phase == CrosswordGame::READY or phase == CrosswordGame::DONE or phase == CrosswordGame::SOLVED else -1
                elif key == KEY_ENTER: return CrosswordGame::SUBMIT
                elif key == KEY_LEFT: return CrosswordGame::LEFT
                elif key == KEY_RIGHT: return CrosswordGame::RIGHT
                elif key == KEY_UP: return CrosswordGame::UP
                elif key == KEY_DOWN: return CrosswordGame::DOWN
                elif key == KEY_UNDO: return CrosswordGame::BACKSPACE
                return -1
            elif task == TASK_SYLLOGISM:
                if key == KEY_SPACE:
                    return SyllogismGame::ANSWER if phase == SyllogismGame::ASKING else SyllogismGame::START
                elif key == KEY_ENTER: return SyllogismGame::ANSWER
                elif key == KEY_LEFT: return SyllogismGame::LEFT
                elif key == KEY_RIGHT: return SyllogismGame::RIGHT
                elif key == KEY_UP: return SyllogismGame::UP
                elif key == KEY_DOWN: return SyllogismGame::DOWN
                return -1
            elif task == TASK_CHESS:
                if key == KEY_SPACE:
                    return ChessGame::START if phase == ChessGame::READY or phase == ChessGame::DONE or phase == ChessGame::JUDGED else -1
                elif key == KEY_ENTER: return ChessGame::ANSWER
                elif key == KEY_LEFT: return ChessGame::LEFT
                elif key == KEY_RIGHT: return ChessGame::RIGHT
                elif key == KEY_UP: return ChessGame::UP
                elif key == KEY_DOWN: return ChessGame::DOWN
                return -1
            elif task == TASK_VERBAL:
                if key == KEY_SPACE:
                    return VerbalGame::START if phase == VerbalGame::READY or phase == VerbalGame::DONE or phase == VerbalGame::JUDGED else -1
                elif key == KEY_ENTER: return VerbalGame::ANSWER
                elif key == KEY_LEFT or key == KEY_UP: return VerbalGame::LEFT
                elif key == KEY_RIGHT or key == KEY_DOWN: return VerbalGame::RIGHT
                return -1
            elif task == TASK_IN_THE_DARK:
                if key == KEY_SPACE:
                    return InTheDarkGame::ACTION_START if phase == InTheDarkGame::PHASE_READY or phase == InTheDarkGame::PHASE_DONE or phase == InTheDarkGame::PHASE_SCORED else -1
                elif key >= KEY_ONE and key <= KEY_FIVE:
                    return InTheDarkGame::ACTION_ANSWER_0 + key - KEY_ONE if phase == InTheDarkGame::PHASE_ASKING else -1
                return -1
            elif task == TASK_FOG_OF_WAR:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return FogGame::ACTION_START if phase == FogGame::PHASE_READY or phase == FogGame::PHASE_FINISHED or phase == FogGame::PHASE_DONE else -1
                elif key == KEY_UP: return FogGame::ACTION_UP if phase == FogGame::PHASE_EXPLORING else -1
                elif key == KEY_DOWN: return FogGame::ACTION_DOWN if phase == FogGame::PHASE_EXPLORING else -1
                elif key == KEY_LEFT: return FogGame::ACTION_LEFT if phase == FogGame::PHASE_EXPLORING else -1
                elif key == KEY_RIGHT: return FogGame::ACTION_RIGHT if phase == FogGame::PHASE_EXPLORING else -1
                return -1
            elif task == TASK_CONCENTRATION:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return ConcentrationGame::ACTION_START if phase == ConcentrationGame::PHASE_READY or phase == ConcentrationGame::PHASE_DONE else -1
                return -1
            elif task == TASK_RECOGNITION:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return RecognitionGame::ACTION_START if phase == RecognitionGame::PHASE_READY or phase == RecognitionGame::PHASE_DONE else -1
                elif key == KEY_LEFT:
                    return RecognitionGame::ACTION_SEEN if phase == RecognitionGame::PHASE_SHOWING or phase == RecognitionGame::PHASE_HIDDEN else -1
                elif key == KEY_RIGHT:
                    return RecognitionGame::ACTION_NEW if phase == RecognitionGame::PHASE_SHOWING or phase == RecognitionGame::PHASE_HIDDEN else -1
                elif key == KEY_RESTART:
                    return RecognitionGame::ACTION_REPLAY if phase == RecognitionGame::PHASE_SHOWING or phase == RecognitionGame::PHASE_HIDDEN else -1
                return -1
            elif task == TASK_TRIVIA:
                if key == KEY_SPACE or key == KEY_ENTER:
                    if phase == TriviaGame::PHASE_READY or phase == TriviaGame::PHASE_DONE:
                        return TriviaGame::ACTION_START
                    if phase == TriviaGame::PHASE_JUDGED:
                        return TriviaGame::ACTION_ADVANCE
                    return TriviaGame::ACTION_SUBMIT if phase == TriviaGame::PHASE_ASKING else -1
                elif key == KEY_UP or key == KEY_LEFT:
                    return TriviaGame::ACTION_UP if phase == TriviaGame::PHASE_ASKING else -1
                elif key == KEY_DOWN or key == KEY_RIGHT:
                    return TriviaGame::ACTION_DOWN if phase == TriviaGame::PHASE_ASKING else -1
                elif key >= KEY_ONE and key <= KEY_EIGHT:
                    return TriviaGame::ACTION_CHOOSE_0 + key - KEY_ONE if phase == TriviaGame::PHASE_ASKING else -1
                return -1
            elif task == TASK_REMOVALS:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return RemovalsGame::ACTION_START if phase == RemovalsGame::PHASE_READY or phase == RemovalsGame::PHASE_SCORED or phase == RemovalsGame::PHASE_DONE else -1
                elif key >= KEY_ONE and key <= KEY_FIVE:
                    return RemovalsGame::ACTION_ANSWER_0 + key - KEY_ONE if phase == RemovalsGame::PHASE_ASKING else -1
                return -1
            elif task == TASK_CUSTODY:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return CustodyGame::ACTION_START if phase == CustodyGame::PHASE_READY or phase == CustodyGame::PHASE_SCORED or phase == CustodyGame::PHASE_DONE else -1
                elif key == KEY_LEFT:
                    return CustodyGame::ACTION_LEFT if phase == CustodyGame::PHASE_RUNNING else -1
                elif key == KEY_RIGHT:
                    return CustodyGame::ACTION_RIGHT if phase == CustodyGame::PHASE_RUNNING else -1
                elif key == KEY_UP or key == KEY_DOWN:
                    return CustodyGame::ACTION_GRAB if phase == CustodyGame::PHASE_RUNNING else -1
                return -1
            elif task == TASK_NCUP_MONTE:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return NCupMonteGame::ACTION_START if phase == NCupMonteGame::PHASE_READY or phase == NCupMonteGame::PHASE_RESULT else -1
                return -1
            elif task == TASK_REFLEX:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return ReflexGame::ACTION_START if phase == ReflexGame::PHASE_READY or phase == ReflexGame::PHASE_DONE else -1
                return -1
            elif task == TASK_TRACKING:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return TrackingGame::ACTION_START if phase == TrackingGame::PHASE_READY or phase == TrackingGame::PHASE_DONE else -1
                return -1
            elif task == TASK_LOOKOUT:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return LookoutGame::ACTION_START if phase == LookoutGame::PHASE_READY or phase == LookoutGame::PHASE_DONE else -1
                return -1
            elif task == TASK_BUZZ_WIRE:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return BuzzWireGame::ACTION_START if phase == BuzzWireGame::PHASE_READY or phase == BuzzWireGame::PHASE_SETTLED or phase == BuzzWireGame::PHASE_DONE else -1
                return -1
            elif task == TASK_OUT_OF_SIGHT:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return OutOfSightGame::ACTION_START if phase == OutOfSightGame::PHASE_READY or phase == OutOfSightGame::PHASE_DONE else -1
                return -1
            elif task == TASK_PURSUIT:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return PursuitGame::ACTION_START if phase == PursuitGame::PHASE_READY or phase == PursuitGame::PHASE_DONE else -1
                elif key == KEY_UP: return PursuitGame::ACTION_UP
                elif key == KEY_DOWN: return PursuitGame::ACTION_DOWN
                elif key == KEY_LEFT: return PursuitGame::ACTION_LEFT
                elif key == KEY_RIGHT: return PursuitGame::ACTION_RIGHT
                return -1
            elif task == TASK_DONKEY:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return DonkeyGame::ACTION_START if phase == DonkeyGame::PHASE_READY or phase == DonkeyGame::PHASE_DONE or phase == DonkeyGame::PHASE_SCORED else DonkeyGame::ACTION_SWITCH
                elif key == KEY_LEFT or key == KEY_RIGHT or key == KEY_UP:
                    return DonkeyGame::ACTION_SWITCH
                return -1
            elif task == TASK_OVERRUN:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return OverrunGame::ACTION_START if phase == OverrunGame::PHASE_READY or phase == OverrunGame::PHASE_DONE else -1
                elif key == KEY_UNDO:
                    return OverrunGame::ACTION_ERASE
                return -1
            elif task == TASK_TWO_HANDS:
                if key == KEY_SPACE or key == KEY_ENTER:
                    return TwoHandsGame::ACTION_START if phase == TwoHandsGame::PHASE_READY or phase == TwoHandsGame::PHASE_DONE or phase == TwoHandsGame::PHASE_SCORED else TwoHandsGame::ACTION_JUMP
                elif key == KEY_LEFT: return TwoHandsGame::ACTION_LEFT
                elif key == KEY_RIGHT: return TwoHandsGame::ACTION_RIGHT
                elif key == KEY_UP: return TwoHandsGame::ACTION_FASTER
                elif key == KEY_DOWN: return TwoHandsGame::ACTION_SLOWER
                return -1
            else:
                if key == KEY_SPACE:
                    if phase == MarbleMazeGame::PHASE_READY or phase == MarbleMazeGame::PHASE_DONE:
                        return MarbleMazeGame::ACTION_START
                    return MarbleMazeGame::ACTION_NEXT if phase == MarbleMazeGame::PHASE_FEEDBACK else -1
                elif key == KEY_UP:
                    return MarbleMazeGame::ACTION_HOLD_NORTH if phase == MarbleMazeGame::PHASE_RUNNING else -1
                elif key == KEY_RIGHT:
                    return MarbleMazeGame::ACTION_HOLD_EAST if phase == MarbleMazeGame::PHASE_RUNNING else -1
                elif key == KEY_DOWN:
                    return MarbleMazeGame::ACTION_HOLD_SOUTH if phase == MarbleMazeGame::PHASE_RUNNING else -1
                elif key == KEY_LEFT:
                    return MarbleMazeGame::ACTION_HOLD_WEST if phase == MarbleMazeGame::PHASE_RUNNING else -1
                elif key == KEY_RESTART: return MarbleMazeGame::ACTION_RESTART
                elif key == KEY_LEVEL: return MarbleMazeGame::ACTION_LEVEL
                return -1

    def valid_action_payload(task: i64, action: i64, value: i64, aux: i64) -> bool:
        can Abort.Panic:
            if task == TASK_NBACK_3D:
                return value == 0 and aux == 0
            if task == TASK_SALESMAN:
                if action == SalesmanGame::ACTION_PICK:
                    return value >= 0 and value < SalesmanGame::MAX_CITIES and aux == 0
                return value == 0 and aux == 0
            if task == TASK_COUNT:
                if action == CountingGame::ACTION_DIGIT:
                    return value >= 0 and value <= 9 and aux == 0
                return value == 0 and aux == 0
            if task == TASK_HANOI or task == TASK_COOKIE_THIEF:
                return value == 0 and aux == 0
            if task == TASK_SYLLOGISM:
                if action == SyllogismGame::CHOOSE:
                    return value >= 0 and value < SyllogismGame::MAX_OPTIONS and aux == 0
                return value == 0 and aux == 0
            if task == TASK_NUMBEROLOGY:
                if action == NumberologyGame::ACTION_WRITE:
                    return (value == 45 or (value >= 48 and value <= 57)) and aux == 0
                return value == 0 and aux == 0
            if task == TASK_MR_TIME:
                if action == MrTime::ACTION_DIGIT:
                    return value >= 0 and value <= 9 and aux == 0
                return value == 0 and aux == 0
            if task == TASK_IN_THE_DARK:
                return value == 0 and aux == 0
            if task == TASK_REFLEX:
                return value == 0 and aux == 0
            if task == TASK_LOOKOUT:
                return value == 0 and aux == 0
            if task == TASK_BUZZ_WIRE:
                if action == BuzzWireGame::ACTION_PRESS or action == BuzzWireGame::ACTION_RELEASE or action == BuzzWireGame::ACTION_TAP:
                    return value >= 0 and value < Buzzwire::PORTS and aux == 0
                return value == 0 and aux == 0
            if task == TASK_OUT_OF_SIGHT:
                return value == 0 and aux == 0
            if task == TASK_PURSUIT:
                return value == 0 and aux == 0
            if task == TASK_OVERRUN:
                if action == OverrunGame::ACTION_WRITE:
                    return value >= 0 and value <= 25 and aux == 0
                return value == 0 and aux == 0
            if task == TASK_TWO_HANDS:
                if action == TwoHandsGame::ACTION_PORT:
                    return value >= TwoHands::HOLD and value < TwoHands::PORTS and aux == 0
                return value == 0 and aux == 0
            if task == TASK_CROSSED_WIRES:
                if action == CrossedWiresGame::ACTION_PRESS:
                    return value >= 0 and value < CrossedWiresGame::MAX_KEYS and aux == 0
                if action == CrossedWiresGame::ACTION_APPLY_OPTIONS:
                    level: i64 = value & 15
                    trial_index: i64 = (value >> 4) & 15
                    return value >= 0 and (value >> 10) == 0 and level >= 1 and level <= CrossedWires::GRADE_COUNT and trial_index < 8 and aux == 0
                return value == 0 and aux == 0
            if task == TASK_SUDOKU:
                if action == SudokuGame::ACTION_WRITE:
                    return value >= 1 and value <= Sudoku::MOST_SIZE and aux == 0
                return value == 0 and aux == 0
            if task == TASK_MATRIX_REASONING:
                if action == MatrixReasoningGame::ACTION_ANSWER:
                    return value >= 0 and value < MatrixReasoningGame::MAX_CHOICES and aux == 0
                return value == 0 and aux == 0
            if task == TASK_HIDDEN_RULE:
                return value == 0 and aux == 0
            if task == TASK_BROWSER:
                return value == 0 and aux == 0
            if task == TASK_SPREADSHEET:
                return value == 0 and aux == 0
            if task == TASK_ERRANDS:
                return value == 0 and aux == 0
            if task == TASK_MANUAL:
                return value == 0 and aux == 0
            if task == TASK_FORMS:
                return value == 0 and aux == 0
            if task == TASK_DESKTOP:
                return value == 0 and aux == 0
            if task == TASK_HIDDEN_WIRING:
                return value == 0 and aux == 0
            if task == TASK_TRIAGE:
                return value == 0 and aux == 0
            if task == TASK_DELAY:
                return value == 0 and aux == 0
            if task == TASK_CAMERA:
                return CameraGame::valid_input(action, value, aux)
            if task == TASK_CIPHER_ABYSS or task == TASK_LOCK_PICK or task == TASK_AIR_HOCKEY or task == TASK_FREE_KICK or task == TASK_CLAW_MACHINE or task == TASK_CRICKET_HUNT or task == TASK_PIANO_TUNER or task == TASK_BY_EAR or task == TASK_GLOVE or task == TASK_STEADICAM or task == TASK_KERBSIDE or task == TASK_NIGHT_WATCH or task == TASK_SHADOW_PUPPETS or task == TASK_SEMAPHORE or task == TASK_BARTENDER or task == TASK_SIGN_PAINTER or task == TASK_TIGHTROPE or task == TASK_CONDUCTOR or task == TASK_POTTERS_WHEEL or task == TASK_CRAZY_COG or task == TASK_FIGURES_OF_SPEECH or task == TASK_SECOND_THOUGHTS or task == TASK_BETWEEN_THE_LINES or task == TASK_WHICH_FEELING or task == TASK_WHY_THEY_FEEL or task == TASK_TONE_OF_VOICE or task == TASK_EMOTION or task == TASK_READING_PEOPLE or task == TASK_HOW_STRONGLY or task == TASK_SOCIAL_SENSE or task == TASK_BAD_ARGUMENT or task == TASK_PROOFREADER or task == TASK_MISSING_WORD or task == TASK_FULL_STOP or task == TASK_HEAVIER or task == TASK_MORNING_ROUND or task == TASK_UNICYCLE or task == TASK_ROVER or task == TASK_DOCKING or task == TASK_FERRY or task == TASK_CRANE or task == TASK_KITCHEN or task == TASK_SOKOBANLIVE or task == TASK_ESCORT or task == TASK_AIRTRAFFIC or task == TASK_RAILYARD or task == TASK_CROSSROADS or task == TASK_FIREBREAK or task == TASK_EXPLORE_EXPLOIT or task == TASK_BLUFF or task == TASK_DISPATCH or task == TASK_GAMBLE or task == TASK_SONAR or task == TASK_DAM_KEEPER or task == TASK_WHO_KNOWS_WHAT or task == TASK_FOLD_IT or task == TASK_SIGNALS or task == TASK_CAPTCHA or task == TASK_SHADOW_PLAY or task == TASK_TUNER or task == TASK_DRSHAPE or task == TASK_SFM or task == TASK_WHICH_IS_NEARER or task == TASK_POINT_OF_VIEW or task == TASK_INSIDE_OR_OUT or task == TASK_TOUCHING or task == TASK_CROSSINGS or task == TASK_SAME_OR_MIRROR or task == TASK_WHERE_WAS_IT or task == TASK_NOTEBOOK or task == TASK_STOP_SWITCH or task == TASK_HOLD_IT or task == TASK_TIME_IT or task == TASK_BEAT or task == TASK_CATCH or task == TASK_ECHO_CAVE or task == TASK_DRONE_HOOPS or task == TASK_FIELD_MANUAL or task == TASK_SAFECRACKER or task == TASK_STAGEHAND or task == TASK_LOADING_DOCK or task == TASK_GUNSLINGER or task == TASK_BALANCE or task == TASK_JUGGLER or task == TASK_LANDER or task == TASK_GLIDER:
                return value == 0 and aux == 0
            if task == TASK_FALLS:
                return aux == 0 and ((value >= 0 and value < Falls::MOST_CHOICES) if action == 1 else value == 0)
            if task == TASK_WHAT_NEXT:
                return aux == 0 and ((value >= 0 and value < WhatNext::MOST_CHOICES) if action == 1 else value == 0)
            if task == TASK_VIDEO_SEQUENCE:
                return false if aux != 0
                if action == VideoSequence::ACTION_PICK:
                    return value >= 0 and value < VideoSequence::MOST
                if action == VideoSequence::ACTION_CLIP_READY:
                    return value >= VideoSequence::FEWEST and value <= VideoSequence::MAX_FRAMES
                return value == 0
            if task == TASK_JIGSAW:
                if action == JigsawGame::ACTION_PICK:
                    return value >= 0 and value < JigsawGame::MAX_TILES and aux == 0
                if action == JigsawGame::ACTION_FIT_PHOTO:
                    return value >= 0 and aux == 0
                return value == 0 and aux == 0
            if task == TASK_GO:
                if action == GoGame::ACTION_ANSWER:
                    return value >= 0 and value < GoGame::MAX_CELLS and aux == 0
                if action == GoGame::ACTION_LEVEL:
                    return value >= 1 and value <= 10 and aux == 0
                return value == 0 and aux == 0
            if task == TASK_SCRAMBLE:
                if action == ScrambleGame::ACTION_WRITE:
                    return value >= 0 and value <= 27 and aux == 0
                if action == ScrambleGame::ACTION_APPLY_OPTIONS:
                    level: i64 = value & 15
                    trial_index: i64 = (value >> 4) & 7
                    return value >= 0 and (value >> 9) == 0 and level >= 1 and level <= Scramble::GRADE_COUNT and trial_index < 7 and aux == 0
                return value == 0 and aux == 0
            if task == TASK_SCRABBLE:
                if action == ScrabbleGame::ACTION_LAY:
                    return value >= 0 and value < ScrabbleGame::RACK and aux == 0
                if action == ScrabbleGame::ACTION_APPLY_OPTIONS:
                    level: i64 = value & 15
                    trial_index: i64 = (value >> 4) & 7
                    return value >= 0 and (value >> 9) == 0 and level >= 1 and level <= Scrabble::GRADE_COUNT and trial_index < 7 and aux == 0
                return value == 0 and aux == 0
            if task == TASK_CROSSWORD:
                if action == CrosswordGame::WRITE:
                    return value >= 0 and value < 26 and aux == 0
                if action == CrosswordGame::CLICK:
                    return value >= 0 and value < CrosswordGame::MAX_CELLS and aux == 0
                if action == CrosswordGame::APPLY_OPTIONS:
                    rung: i64 = value & 15
                    trial_index: i64 = (value >> 4) & 7
                    return value >= 0 and (value >> 9) == 0 and rung >= 1 and rung <= Crossword::GRADE_COUNT and trial_index < 6 and aux == 0
                return value == 0 and aux == 0
            if task == TASK_TRIVIA:
                return true
            if task == TASK_TETRIS:
                return value == 0 and aux == 0
            if task != TASK_MARBLE_MAZE:
                return true
            if action == MarbleMazeGame::ACTION_REPORT:
                return false if value < 0 or value > 3 or aux < 0 or aux > 600000
                return false if (value & 1) != 0 and (value & 2) == 0
                return true
            if action == MarbleMazeGame::ACTION_SCORE:
                return (value == 0 or value == 1) and aux == 0
            if action == MarbleMazeGame::ACTION_SYNC_SETTLE_TIME:
                return value >= 0 and value <= MarbleMazeGame::MAX_SETTLE_MS and aux == 0
            if action == MarbleMazeGame::ACTION_RECORD_RESULT:
                return value >= 0 and value <= MarbleMazeGame::MAX_TRIALS and aux >= 0 and aux <= MarbleMazeGame::MAX_TRIALS
            return true

    def record_order(index: i64, timestamp_ms: i64, sequence: i64) -> i64:
        can Abort.Panic, Global.Read, Global.Write:
            return ERR_TIME if timestamp_ms < 0 or sequence < 0
            return ERR_EVENT_ORDER if timestamp_ms < slot_last_time[index.usize()]
            return ERR_EVENT_ORDER if sequence <= slot_last_sequence[index.usize()]
            slot_last_time[index.usize()] <- timestamp_ms
            slot_last_sequence[index.usize()] <- sequence
            return OK

    # Event scalar schema (all integers, fixed-width ABI values): kind,
    # timestamp_ms, sequence, logical_or_action_code, value_or_physical_code,
    # modifiers, flags, x_millionths, y_millionths, aux. Pointer origin is the
    # bottom-left of the task viewport; values are in [0, 1_000_000].
    def dispatch(handle: i64, kind: i64, timestamp_ms: i64, sequence: i64,
                 code: i64, value: i64, modifiers: i64, flags: i64,
                 x_millionths: i64, y_millionths: i64, aux: i64) -> i64:
        can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_BAD_EVENT if kind < EVENT_ACTION or kind > EVENT_CANCEL
            return ERR_TIME if timestamp_ms < 0 or sequence < 0
            return ERR_BAD_EVENT if modifiers < 0 or modifiers > 15 or flags < 0 or flags > 7
            return ERR_BAD_EVENT if (kind == EVENT_KEY_DOWN or kind == EVENT_KEY_UP) and code < 0
            if kind == EVENT_ACTION:
                return ERR_BAD_EVENT if not valid_action_code(slot_tasks[index.usize()], code)
                return ERR_BAD_EVENT if not valid_action_payload(slot_tasks[index.usize()], code, value, aux)
            elif kind == EVENT_POINTER_DOWN or kind == EVENT_POINTER_MOVE or kind == EVENT_POINTER_UP:
                return ERR_BAD_EVENT if x_millionths < 0 or x_millionths > 1000000 or y_millionths < 0 or y_millionths > 1000000
            elif kind == EVENT_TEXT:
                return ERR_BAD_EVENT if value < 0 or value > 1114111 or (value >= 55296 and value <= 57343)
            elif kind == EVENT_FOCUS or kind == EVENT_VISIBILITY:
                return ERR_BAD_EVENT if value != 0 and value != 1
            order: i64 = record_order(index, timestamp_ms, sequence)
            return order if order != OK
            task: i64 = slot_tasks[index.usize()]
            pointer: i64 = slot_pointers[index.usize()]
            if kind == EVENT_ACTION:
                return apply_action(index, code, value, timestamp_ms, aux)
            elif kind == EVENT_KEY_UP:
                if task == TASK_LOCK_PICK and (code == KEY_SPACE or code == KEY_LOCK_PICK_T):
                    trusted Unsafe.PointerCast:
                        run: mutable heap LockPickGame::Session& = pointer.uintptr().cast[mutable heap LockPickGame::Session&]
                        return ACCEPTED if LockPickGame::hold_key(run, 1 if code == KEY_SPACE else 2, false) else IGNORED
                if task == TASK_AIR_HOCKEY and (code == KEY_LEFT or code == KEY_AIR_HOCKEY_A or code == KEY_RIGHT or code == KEY_AIR_HOCKEY_D):
                    trusted Unsafe.PointerCast:
                        run: mutable heap AirHockeyGame::Session& = pointer.uintptr().cast[mutable heap AirHockeyGame::Session&]
                        return ACCEPTED if AirHockeyGame::hold_key(run, 1 if code == KEY_LEFT else (2 if code == KEY_AIR_HOCKEY_A else (4 if code == KEY_RIGHT else 8)), false) else IGNORED
                if task == TASK_FREE_KICK and free_kick_key_bit(code) != 0:
                    trusted Unsafe.PointerCast:
                        run: mutable heap FreeKickGame::Session& = pointer.uintptr().cast[mutable heap FreeKickGame::Session&]
