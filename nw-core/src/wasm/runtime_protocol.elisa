        can Abort.Panic, Global.Read, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_HOLD_IT
            return ERR_BAD_EVENT if port != -1 and port != 0 and port != HoldItGame::START
            return ERR_TIME if not (now >= 0.0 and now <= 9007199254740.0)
            trusted Unsafe.PointerCast:
                run: mutable heap HoldItGame::Session& = slot_pointers[index.usize()].uintptr().cast[mutable heap HoldItGame::Session&]
