            return STATE_BYTES

    # Marble Maze's grain seed is a source-renderer input, not part of the
    # stable twelve-field task-neutral state envelope. This additive scalar
    # accessor keeps API v1's existing state layout unchanged.
    def marble_grain_seed(handle: i64) -> f64:
        can Abort.Panic, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return -1.0 if index < 0
            return -2.0 if slot_tasks[index.usize()] != TASK_MARBLE_MAZE
            pointer: i64 = slot_pointers[index.usize()]
            trusted Unsafe.PointerCast:
                run: heap MarbleMazeGame::MarbleRun& = pointer.uintptr().cast[heap MarbleMazeGame::MarbleRun&]
                return MarbleMazeGame::grain_seed_value(run)

    def marble_info(handle: i64, field: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_MARBLE_MAZE
            pointer: i64 = slot_pointers[index.usize()]
            trusted Unsafe.PointerCast:
                run: heap MarbleMazeGame::MarbleRun& = pointer.uintptr().cast[heap MarbleMazeGame::MarbleRun&]
                return MarbleMazeGame::info(run, field)

    def marble_value(handle: i64, field: i64, at: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_MARBLE_MAZE
            pointer: i64 = slot_pointers[index.usize()]
            trusted Unsafe.PointerCast:
                run: heap MarbleMazeGame::MarbleRun& = pointer.uintptr().cast[heap MarbleMazeGame::MarbleRun&]
                return MarbleMazeGame::value(run, field, at)

    # Applying options is a task-shell lifecycle operation rather than a
    # user input event. Keep the same controller allocation so Marble's
    # persistent CPython-compatible RNG stream survives the native reset.
    def marble_apply_options(handle: i64, start_rung: i64, total_trials: i64,
                             adaptive: i64, time_override_ms: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            index: i64 = slot_for(handle)
            return ERR_INVALID_HANDLE if index < 0
            return ERR_UNSUPPORTED_TASK if slot_tasks[index.usize()] != TASK_MARBLE_MAZE
            validation: i64 = valid_options(TASK_MARBLE_MAZE, 1,
                start_rung, total_trials, adaptive, 2600, time_override_ms, 0)
            return validation if validation != OK
            pointer: i64 = slot_pointers[index.usize()]
            trusted Unsafe.PointerCast:
                run: mutable heap MarbleMazeGame::MarbleRun& = pointer.uintptr().cast[mutable heap MarbleMazeGame::MarbleRun&]
                return MarbleMazeGame::apply_options(run, start_rung,
                    total_trials, adaptive != 0, time_override_ms)

