# Versioned, task-neutral run lifecycle for the WASM host.
#
# Handles are monotonically increasing integers, never pointers. A bounded
# table owns the task records and their destruction. The scalar option slots
# and event fields are specified in docs/runtime-protocol.md.

@intrinsic("llvm.wasm.memory.size.i32")
extern api_wasm_memory_size(memory_index: u32) -> u32

module ApiV1:

    const SLOT_COUNT: i64 = 64
    const TASK_MONKEY_LADDER: i64 = 4150660153
    const TASK_SOKOBAN: i64 = 498559474
    const TASK_SOKOBAN_3D: i64 = 1429046936
    const TASK_MARBLE_MAZE: i64 = 642986
    const TASK_COUNT: i64 = 967958004
    const TASK_HANOI: i64 = 1419634454
    const TASK_MAZE: i64 = 3848665378
    const TASK_YOU_ARE_HERE: i64 = 1837057308
    const TASK_NINA_ROW: i64 = 3456348074
