    def supports(task: i64) -> i64:
        can Abort.Panic:
            # Two halves: one chain of every task is past what the effect
            # analysis will nest.
            return 1 if task == TASK_BROWSER
            return 1 if task == TASK_SPREADSHEET
            return 1 if task == TASK_ERRANDS
            return 1 if task == TASK_MANUAL
            return 1 if task == TASK_FORMS
            return 1 if task == TASK_DESKTOP
            return 1 if task == TASK_CIPHER_ABYSS or task == TASK_LOCK_PICK or task == TASK_AIR_HOCKEY or task == TASK_FREE_KICK or task == TASK_CLAW_MACHINE or task == TASK_CRICKET_HUNT or task == TASK_PIANO_TUNER or task == TASK_BY_EAR or task == TASK_GLOVE or task == TASK_STEADICAM or task == TASK_KERBSIDE or task == TASK_NIGHT_WATCH or task == TASK_SHADOW_PUPPETS or task == TASK_SEMAPHORE or task == TASK_BARTENDER or task == TASK_SIGN_PAINTER or task == TASK_TIGHTROPE or task == TASK_CONDUCTOR or task == TASK_POTTERS_WHEEL or task == TASK_CRAZY_COG or task == TASK_FIGURES_OF_SPEECH or task == TASK_SECOND_THOUGHTS or task == TASK_BETWEEN_THE_LINES or task == TASK_WHICH_FEELING or task == TASK_WHY_THEY_FEEL or task == TASK_TONE_OF_VOICE or task == TASK_EMOTION or task == TASK_READING_PEOPLE or task == TASK_HOW_STRONGLY or task == TASK_SOCIAL_SENSE or task == TASK_BAD_ARGUMENT or task == TASK_PROOFREADER or task == TASK_MISSING_WORD or task == TASK_FULL_STOP or task == TASK_HEAVIER or task == TASK_MORNING_ROUND or task == TASK_UNICYCLE or task == TASK_ROVER or task == TASK_DOCKING or task == TASK_FERRY or task == TASK_CRANE or task == TASK_KITCHEN or task == TASK_SOKOBANLIVE or task == TASK_ESCORT or task == TASK_AIRTRAFFIC or task == TASK_RAILYARD or task == TASK_CROSSROADS or task == TASK_FIREBREAK or task == TASK_EXPLORE_EXPLOIT or task == TASK_BLUFF or task == TASK_DISPATCH or task == TASK_GAMBLE or task == TASK_SONAR or task == TASK_DAM_KEEPER or task == TASK_WHO_KNOWS_WHAT or task == TASK_FOLD_IT or task == TASK_SIGNALS or task == TASK_CAPTCHA or task == TASK_SHADOW_PLAY or task == TASK_TUNER or task == TASK_DRSHAPE or task == TASK_SFM or task == TASK_FALLS or task == TASK_WHAT_NEXT or task == TASK_CAMERA or task == TASK_NBACK_3D or task == TASK_ALGEBRA or task == TASK_SCRAMBLE or task == TASK_SCRABBLE or task == TASK_CROSSWORD or task == TASK_SYLLOGISM or task == TASK_CHESS or task == TASK_VERBAL or task == TASK_SALESMAN or task == TASK_GRAPH_MAPPING or task == TASK_CROSSED_WIRES
            return 1 if task == TASK_SUDOKU or task == TASK_MATRIX_REASONING or task == TASK_JIGSAW or task == TASK_VIDEO_SEQUENCE or task == TASK_HIDDEN_RULE or task == TASK_HIDDEN_WIRING or task == TASK_TRIAGE or task == TASK_DELAY or task == TASK_STOP_SWITCH or task == TASK_HOLD_IT or task == TASK_TIME_IT or task == TASK_BEAT or task == TASK_CATCH or task == TASK_ECHO_CAVE or task == TASK_DRONE_HOOPS or task == TASK_FIELD_MANUAL or task == TASK_SAFECRACKER or task == TASK_STAGEHAND or task == TASK_LOADING_DOCK or task == TASK_GUNSLINGER or task == TASK_BALANCE or task == TASK_JUGGLER or task == TASK_LANDER or task == TASK_GLIDER or task == TASK_WHICH_IS_NEARER or task == TASK_POINT_OF_VIEW or task == TASK_INSIDE_OR_OUT or task == TASK_TOUCHING or task == TASK_CROSSINGS or task == TASK_SAME_OR_MIRROR or task == TASK_WHERE_WAS_IT or task == TASK_NOTEBOOK or task == TASK_GO or task == TASK_MONKEY_LADDER or task == TASK_SOKOBAN or task == TASK_SOKOBAN_3D or task == TASK_MARBLE_MAZE or task == TASK_COUNT or task == TASK_MR_TIME or task == TASK_TETRIS or task == TASK_HANOI or task == TASK_COOKIE_THIEF or task == TASK_MAZE or task == TASK_YOU_ARE_HERE or task == TASK_NINA_ROW or task == TASK_NUMBEROLOGY or task == TASK_IN_THE_DARK or task == TASK_FOG_OF_WAR or task == TASK_CONCENTRATION or task == TASK_RECOGNITION or task == TASK_TRIVIA or task == TASK_REMOVALS or task == TASK_CUSTODY or task == TASK_NCUP_MONTE or task == TASK_REFLEX or task == TASK_TRACKING or task == TASK_LOOKOUT or task == TASK_BUZZ_WIRE or task == TASK_OUT_OF_SIGHT or task == TASK_PURSUIT or task == TASK_DONKEY or task == TASK_OVERRUN or task == TASK_TWO_HANDS else 0

