                append_i64(&out, task_info(index, TwoHandsGame::INFO_PHASE))
                append_i64(&out, task_info(index, TwoHandsGame::INFO_RUNG))
                append_i64(&out, task_info(index, TwoHandsGame::INFO_TRIAL))
