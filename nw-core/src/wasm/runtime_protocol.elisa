                elif key >= KEY_ONE and key <= KEY_FIVE:
                    return RemovalsGame::ACTION_ANSWER_0 + key - KEY_ONE if phase == RemovalsGame::PHASE_ASKING else -1
                return -1
            elif task == TASK_CUSTODY:
