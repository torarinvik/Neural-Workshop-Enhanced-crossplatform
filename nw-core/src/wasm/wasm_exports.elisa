# The WebAssembly export surface.
#
# Kept separate from the core modules for the same reason pymodule_exports.elisa
# is: this file names a target-specific ABI. `export fn` gives each function
# external linkage so it survives -O2 (the backend prefers private linkage when
# optimising, which otherwise strips everything the shell wants to call).
#
# Built by scripts/build_wasm.sh; run by shells/web/elisa-wasm-runtime.js.

include "../../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../scheduling.elisa"
include "../board.elisa"
include "../nback.elisa"
include "../display.elisa"
include "../scene_nback.elisa"
include "../scene_title.elisa"
include "../scene_menu.elisa"
include "../strings.elisa"
include "../menu_model.elisa"
include "../scene_menu_screen.elisa"

export fn nw_ms_to_ticks(ms: f64, tick_ms: i64) -> i64 = ms_to_ticks
export fn nw_clamp_trial_interval_ms(ms: i64, tick_ms: i64, min_ticks: i64, max_ms: i64) -> i64 = clamp_trial_interval_ms
export fn nw_interval_adjust_step(ms: i64) -> i64 = interval_adjust_step
export fn nw_crab_back(x: i64, nback: i64) -> i64 = crab_back

# Structs do not cross the C ABI here (a `Cell` parameter is rejected as
# non-C-ABI-compatible), so every exported entry point takes and returns
# scalars, and aggregates are read one field at a time through a flat accessor.
def cell_distance(pid: i64, col: i64, row: i64, depth: i64, size: i64, dim: i64) -> i64:
    return centre_distance4(Cell{pid: pid, col: col, row: row, depth: depth}, size, dim)

export fn nw_cell_distance(pid: i64, col: i64, row: i64, depth: i64, size: i64, dim: i64) -> i64 = cell_distance

def phase_field(trial_ms: i64, stim_ms: i64, feedback_ms: i64, tick_ms: i64, field: i64) -> i64:
    phases: TrialPhases = plan_trial_phases(trial_ms, stim_ms, feedback_ms, tick_ms)
    return phases.total_ticks if field == 0 else (phases.stimulus_ticks if field == 1 else (phases.blank_ticks if field == 2 else (phases.feedback_ticks if field == 3 else (phases.stimulus_ms if field == 4 else (phases.blank_ms if field == 5 else phases.feedback_ms)))))

export fn nw_phase_field(trial_ms: i64, stim_ms: i64, feedback_ms: i64, tick_ms: i64, field: i64) -> i64 = phase_field

# ------------------------------------------------------------
# Display-list frames
# ------------------------------------------------------------
#
# The shell allocates one buffer up front and asks for frames into it, then
# reads the encoded bytes straight out of linear memory as a Uint8Array view.
# No copy crosses the boundary and nothing is allocated per frame on the JS
# side.
#
# A caller-provided buffer rather than a static: the frame is built in a
# function-local region that is destroyed on the way out, so the bytes must be
# copied somewhere that outlives it, and letting the shell own that storage
# keeps lifetime out of the ABI.

extern malloc(size: usize) -> mutable heap void&? can[Memory.Allocate]

def frame_alloc(size: i64) -> i64:
    can Memory.Allocate, Abort.Panic:
        trusted Unsafe.PointerCast:
            block: mutable heap void&? = malloc(size.usize())
            0 return if block == null
            slot: mutable heap void& = block
            return slot.cast[u8&].uintptr().i64()

# Build one frame into `dest`; returns the byte length written, or 0 if the
# buffer is too small.
def frame_write(dest: i64, capacity: i64, trial: i64, nback: i64, position: i64, verdict: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        written: mutable i64 = 0
        # Built in the AMBIENT region rather than a per-call `region scratch`:
        # on wasm32 a function-local region that is created and destroyed on
        # every call returns corrupted string data from the second call onward,
        # while the same code is correct natively. See
        # repro/nw_wasm32_region_reuse.md.
        list: mutable Display::DisplayList = Display::DisplayList()
        render_nback_frame(&list, trial, nback, position, verdict)
        encoded: darray[u8] = Display::encode_binary(&list)
        length: i64 = encoded.count.i64()
        if length <= capacity and length > 0:
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            written <- length
        return written

# The title screen. Same ambient-region rule as frame_write above.
def title_write(dest: i64, capacity: i64, banner_code: i64, black_background: i64, jaeggi_mode: i64, clinical_mode: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        written: mutable i64 = 0
        list: mutable Display::DisplayList = Display::DisplayList()
        render_title_frame_coded(&list, banner_code, black_background != 0, jaeggi_mode != 0, clinical_mode != 0)
        encoded: darray[u8] = Display::encode_binary(&list)
        length: i64 = encoded.count.i64()
        if length <= capacity and length > 0:
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            written <- length
        return written

# The game-mode screen (ui/gameselect.py), as CONTENT rather than as a picture
# of one: its option names, its value KINDS, and the spacer rows that shape it.
# The numbers are the game's defaults -- the live ones come from the player's
# config, and when the config screens are ported the host will supply them and
# only this function's last argument changes.
# Brace form rather than the MenuText::Row(...) constructor: a constructor
# overload is reachable UNQUALIFIED from inside its own module, but
# `MenuText::Row(...)` from outside reads as positional struct construction and
# is refused. The braces are what the compiler itself suggests.
def gameselect_rows(rows: mutable darray[MenuText::Row]&):
    can Memory.Allocate, Abort.Panic:
        rows.push(MenuText::Row{name: "Use position", kind: MenuText::BOOL, number: 1.0, text: ""})
        rows.push(MenuText::Row{name: "Use color", kind: MenuText::BOOL, number: 0.0, text: ""})
        rows.push(MenuText::Row{name: "Use image", kind: MenuText::BOOL, number: 0.0, text: ""})
        rows.push(MenuText::Row{name: "Use audio", kind: MenuText::BOOL, number: 0.0, text: ""})
        rows.push(MenuText::Row{name: "Use audio2", kind: MenuText::BOOL, number: 0.0, text: ""})
        rows.push(MenuText::Row{name: "Use arithmetic", kind: MenuText::BOOL, number: 0.0, text: ""})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "Combination N-back mode", kind: MenuText::BOOL, number: 0.0, text: ""})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "Use variable N-Back levels", kind: MenuText::BOOL, number: 0.0, text: ""})
        rows.push(MenuText::Row{name: "Crab-back mode (reverse order of sets of N stimuli)", kind: MenuText::BOOL, number: 0.0, text: ""})
        rows.push(MenuText::Row{name: "3D face-pattern mode", kind: MenuText::BOOL, number: 0.0, text: ""})
        rows.push(MenuText::Row{name: "Cubes in 3D pattern", kind: MenuText::INT, number: 1.0, text: ""})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "2D grid size", kind: MenuText::INT, number: 3.0, text: ""})
        rows.push(MenuText::Row{name: "Active 2D position cells", kind: MenuText::ALL, number: 8.0, text: ""})
        rows.push(MenuText::Row{name: "Trial interval (ms)", kind: MenuText::INT, number: 10.0, text: ""})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "Simultaneous visual stimuli", kind: MenuText::INT, number: 1.0, text: ""})
        rows.push(MenuText::Row{name: "Simultaneous stimuli differentiated by", kind: MenuText::TEXT, number: 0.0, text: "color"})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "Self-paced mode", kind: MenuText::BOOL, number: 0.0, text: ""})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "Interference (tricky stimulus generation)", kind: MenuText::PERCENT, number: 0.125, text: ""})

def menu_write(dest: i64, capacity: i64, selpos: i64, black_background: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        written: mutable i64 = 0
        rows: mutable darray[MenuText::Row] = []
        gameselect_rows(&rows)
        list: mutable Display::DisplayList = Display::DisplayList()
        render_menu_screen(&list, "Choose your game mode", menu_default_footnote(), &rows, selpos, black_background != 0)
        encoded: darray[u8] = Display::encode_binary(&list)
        length: i64 = encoded.count.i64()
        if length <= capacity and length > 0:
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            written <- length
        return written

export fn nw_frame_alloc(size: i64) -> i64 = frame_alloc
export fn nw_frame_write(dest: i64, capacity: i64, trial: i64, nback: i64, position: i64, verdict: i64) -> i64 = frame_write
export fn nw_title_write(dest: i64, capacity: i64, banner_code: i64, black_background: i64, jaeggi_mode: i64, clinical_mode: i64) -> i64 = title_write
export fn nw_menu_write(dest: i64, capacity: i64, selpos: i64, black_background: i64) -> i64 = menu_write
