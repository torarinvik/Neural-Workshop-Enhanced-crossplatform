# Kept as a compatibility wrapper for older shell clients and existing ABI
# sweeps. A started frame is the active phase with no input yet.
def task_game_write(dest: i64, capacity: i64, category: i64, selected: i64,
                    black_background: i64, started: i64, width: i64,
                    height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return task_game_input_write(dest, capacity, category, selected,
                                     black_background, 1 if started != 0 else 0,
                                     0, 0, 0, 0, -1, width, height)

# A compact, shell-facing snapshot of one certified Marble Maze tray. The
# generator already lives in tasks/marblemaze.elisa and is differentially
# checked against the original Python source; keeping this ABI separate from
# the display list lets the browser cache the expensive deal once per trial
# while its JavaScript simulation advances every frame.
const MARBLE_BOARD_MAGIC: u32 = 826496845       # "MMB1" little-endian
const MARBLE_BOARD_VERSION: u32 = 1

def marble_board_u32(out: mutable darray[u8]&, value: u32):
    can Memory.Allocate, Abort.Panic:
        out.push((value & 255.u32()).u8())
        out.push(((value >> 8.u32()) & 255.u32()).u8())
        out.push(((value >> 16.u32()) & 255.u32()).u8())
        out.push(((value >> 24.u32()) & 255.u32()).u8())

def marble_board_f32(out: mutable darray[u8]&, value: f64):
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            holder: f32[1] = zeroed
            holder[0] <- value.f32()
            bytes: u8[4] = zeroed
            memcpy((&bytes[0]).cast[mutable void&], (&holder[0]).cast[void&], 4.usize())
            out.push(bytes[0])
            out.push(bytes[1])
            out.push(bytes[2])
            out.push(bytes[3])

def marble_board_write(dest: i64, capacity: i64, rung: i64, seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        written: mutable i64 = 0
        work: mutable MarbleMaze::Work = MarbleMaze::Work()
        tray: mutable MarbleMaze::Tray = MarbleMaze::Tray()
        MarbleMaze::deal(rung, seed, 24, &work, &tray)
        out: mutable darray[u8] = []
        marble_board_u32(&out, MARBLE_BOARD_MAGIC)
        marble_board_u32(&out, MARBLE_BOARD_VERSION)
        marble_board_u32(&out, 1.u32() if tray.built else 0.u32())
        marble_board_u32(&out, tray.rung.u32())
        marble_board_u32(&out, tray.cols.u32())
        marble_board_u32(&out, tray.rows.u32())
        marble_board_f32(&out, tray.width)
        marble_board_f32(&out, tray.depth)
        marble_board_f32(&out, tray.cell)
        marble_board_f32(&out, tray.thickness)
        marble_board_f32(&out, tray.height)
        marble_board_f32(&out, tray.home_x)
        marble_board_f32(&out, tray.home_y)
        marble_board_f32(&out, tray.home_r)
        marble_board_f32(&out, tray.seconds)
        marble_board_f32(&out, tray.route)
        marble_board_u32(&out, tray.walls.count.u32())
        wall: mutable i64 = 0
        while wall < tray.walls.count |wall, tray, out|:
            marble_board_f32(&out, Floats::at(tray.walls.x0, wall))
            marble_board_f32(&out, Floats::at(tray.walls.y0, wall))
            marble_board_f32(&out, Floats::at(tray.walls.x1, wall))
            marble_board_f32(&out, Floats::at(tray.walls.y1, wall))
            wall <- wall + 1
        marble_board_u32(&out, tray.holes.count.u32())
        hole: mutable i64 = 0
        while hole < tray.holes.count |hole, tray, out|:
            marble_board_f32(&out, Floats::at(tray.holes.x, hole))
            marble_board_f32(&out, Floats::at(tray.holes.y, hole))
            marble_board_f32(&out, Floats::at(tray.holes.radius, hole))
            marble_board_u32(&out, Ints::at(tray.holes.home, hole).u32())
            hole <- hole + 1
        marble_board_u32(&out, tray.start_n.u32())
        start: mutable i64 = 0
        while start < tray.start_n |start, tray, out|:
            marble_board_f32(&out, Floats::at(tray.start_x, start))
            marble_board_f32(&out, Floats::at(tray.start_y, start))
            start <- start + 1
        length: i64 = out.count.i64()
        if length <= capacity and length > 0:
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&out[0]).cast[void&], length.usize())
            written <- length
        return written

def monkey_ladder_write(dest: i64, capacity: i64, phase: i64, level: i64,
                        clicked_upto: i64, wrong: i64, cursor_cell: i64,
                        cursor_enabled: i64, reveal_answer: i64, seed: i64,
                        width: i64, height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        written: mutable i64 = 0
        grid: i64 = 5
        cells: i64 = grid * grid
        actual_level: i64 = 2 if level < 2 else (cells if level > cells else level)
        rng: mutable MT19937 = mt19937_new()
        mt_seed_int(&rng, seed.u64())
        sequence: mutable darray[i64] = py_sample_range(&rng, 0, cells - 1, actual_level)
        canvas_width: f64 = width.f64()
        canvas_height: f64 = height.f64()
        sx: f64 = canvas_width / Display::REFERENCE_WIDTH
        sy: f64 = canvas_height / Display::REFERENCE_HEIGHT
        paint: SceneMonkeyLadder::Paint = SceneMonkeyLadder::paint_of(
            false, canvas_width, canvas_height, sx, sy)
        list: mutable Display::DisplayList = Display::DisplayList()
        message: mutable dstr = []
        if phase == SceneMonkeyLadder::PHASE_SHOW:
            dstr_append_cstr(&message, "Remember the order")
        elif phase == SceneMonkeyLadder::PHASE_INPUT:
            dstr_append_cstr(&message, "Click 1 through ")
            dstr_append_i64(&message, actual_level)
        elif phase == SceneMonkeyLadder::PHASE_RESULT:
            dstr_append_cstr(&message, "Correct" if wrong < 0 else "Miss")
        else:
            dstr_append_cstr(&message, "Press Space to watch the numbers")
        SceneMonkeyLadder::render(&list, &paint, &sequence, actual_level, grid,
                                  phase, actual_level, clicked_upto, wrong,
                                  cursor_cell, cursor_enabled != 0,
                                  reveal_answer != 0, bytes_view(message))
        encoded: darray[u8] = Display::encode_binary(&list)
        length: i64 = encoded.count.i64()
        if length <= capacity and length > 0:
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            written <- length
        return written

def monkey_ladder_expected(seed: i64, level: i64, index: i64) -> i64:
    can Memory.Allocate, Abort.Panic:
        grid: i64 = 5
        cells: i64 = grid * grid
        actual_level: i64 = 2 if level < 2 else (cells if level > cells else level)
        rng: mutable MT19937 = mt19937_new()
        mt_seed_int(&rng, seed.u64())
        sequence: mutable darray[i64] = py_sample_range(&rng, 0, cells - 1, actual_level)
        return get sequence[index.usize()] else -1

# The game-mode screen (ui/gameselect.py), as CONTENT rather than as a picture
# of one: its option names, its value KINDS, and the spacer rows that shape it.
# The numbers are the game's defaults when menu_write is used. The interactive
# host path supplies live values through a bool mask and scalar fields: bools
# covers rows 0..5, 7, 9..11 and 21; interference is percentage tenths (125 is
# 12.5%).
# Brace form rather than the MenuText::Row(...) constructor: a constructor
# overload is reachable UNQUALIFIED from inside its own module, but
# `MenuText::Row(...)` from outside reads as positional struct construction and
# is refused. The braces are what the compiler itself suggests.
def gameselect_rows_state(rows: mutable darray[MenuText::Row]&, bools: i64,
                         cubes: i64, grid: i64, active_cells: i64,
                         trial_ms: i64, multi: i64, multimode: i64,
                         interference_tenths: i64):
    can Memory.Allocate, Abort.Panic:
        rows.push(MenuText::Row{name: "Use position", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 0)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "Use color", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 1)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "Use image", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 2)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "Use audio", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 3)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "Use audio2", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 4)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "Use arithmetic", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 5)) != 0 else 0.0, text: ""})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "Combination N-back mode", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 6)) != 0 else 0.0, text: ""})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "Use variable N-Back levels", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 7)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "Crab-back mode (reverse order of sets of N stimuli)", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 8)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "3D face-pattern mode", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 9)) != 0 else 0.0, text: ""})
        rows.push(MenuText::Row{name: "Cubes in 3D pattern", kind: MenuText::INT, number: cubes.f64(), text: ""})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "2D grid size", kind: MenuText::INT, number: grid.f64(), text: ""})
        rows.push(MenuText::Row{name: "Active 2D position cells", kind: MenuText::ALL, number: active_cells.f64(), text: ""})
        rows.push(MenuText::Row{name: "Trial interval (ms)", kind: MenuText::INT, number: trial_ms.f64(), text: ""})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "Simultaneous visual stimuli", kind: MenuText::INT, number: multi.f64(), text: ""})
        rows.push(MenuText::Row{name: "Simultaneous stimuli differentiated by", kind: MenuText::TEXT, number: 0.0, text: "image" if multimode != 0 else "color"})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "Self-paced mode", kind: MenuText::BOOL, number: 1.0 if (bools & (1 << 10)) != 0 else 0.0, text: ""})
        rows.push(MenuText::spacer())
        rows.push(MenuText::Row{name: "Interference (tricky stimulus generation)", kind: MenuText::PERCENT, number: interference_tenths.f64() / 1000.0, text: ""})

def gameselect_rows(rows: mutable darray[MenuText::Row]&):
    can Memory.Allocate, Abort.Panic:
        gameselect_rows_state(rows, 1, 1, 3, 8, 10, 1, 0, 125)

def menu_write(dest: i64, capacity: i64, selpos: i64, black_background: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        written: mutable i64 = 0
        rows: mutable darray[MenuText::Row] = []
        gameselect_rows(&rows)
        list: mutable Display::DisplayList = Display::DisplayList()
        render_menu_screen(&list, "Choose your game mode", menu_default_footnote(), &rows, selpos, black_background != 0)
        encoded: darray[u8] = Display::encode_binary(&list)
        length: i64 = encoded.count.i64()
        if length <= capacity and length > 0:
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            written <- length
        return written

def menu_state_write(dest: i64, capacity: i64, selpos: i64,
                     black_background: i64, bools: i64, cubes: i64,
                     grid: i64, active_cells: i64, trial_ms: i64, multi: i64,
                     multimode: i64, interference_tenths: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        written: mutable i64 = 0
        rows: mutable darray[MenuText::Row] = []
        gameselect_rows_state(&rows, bools, cubes, grid, active_cells, trial_ms,
                              multi, multimode, interference_tenths)
        list: mutable Display::DisplayList = Display::DisplayList()
        render_menu_screen(&list, "Choose your game mode", menu_default_footnote(), &rows, selpos, black_background != 0)
        encoded: darray[u8] = Display::encode_binary(&list)
        length: i64 = encoded.count.i64()
        if length <= capacity and length > 0:
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            written <- length
        return written

export fn nw_frame_alloc(size: i64) -> i64 = frame_alloc
export fn nw_frame_write(dest: i64, capacity: i64, trial: i64, nback: i64, position: i64, verdict: i64) -> i64 = frame_write
export fn nw_session_frame_write(dest: i64, capacity: i64, trial: i64, nback: i64, seed: i64, mode: i64, verdict: i64) -> i64 = session_frame_write
export fn nw_batch_write(dest: i64, capacity: i64, trial: i64, nback: i64, seed: i64, mode: i64, black: i64, started: i64, hide_text: i64, paused: i64, grid_3d: i64, expanded: i64, gridlines: i64, old_style: i64, sharp_corners: i64, session_number: i64, verdict: i64, input_answer: i64) -> i64 = batch_write
export fn nw_title_write(dest: i64, capacity: i64, banner_code: i64, black_background: i64, jaeggi_mode: i64, clinical_mode: i64) -> i64 = title_write
export fn nw_taskhub_write(dest: i64, capacity: i64, category: i64, selected: i64, black_background: i64, width: i64, height: i64) -> i64 = taskhub_write
export fn nw_task_write(dest: i64, capacity: i64, category: i64, selected: i64, black_background: i64, started: i64, width: i64, height: i64) -> i64 = task_write
export fn nw_task_game_write(dest: i64, capacity: i64, category: i64, selected: i64, black_background: i64, started: i64, width: i64, height: i64) -> i64 = task_game_write
export fn nw_task_game_input_write(dest: i64, capacity: i64, category: i64, selected: i64, black_background: i64, phase: i64, action: i64, cursor: i64, value: i64, steps: i64, verdict: i64, width: i64, height: i64) -> i64 = task_game_input_write
export fn nw_marble_board_write(dest: i64, capacity: i64, rung: i64, seed: i64) -> i64 = marble_board_write
export fn nw_monkey_ladder_write(dest: i64, capacity: i64, phase: i64, level: i64, clicked_upto: i64, wrong: i64, cursor_cell: i64, cursor_enabled: i64, reveal_answer: i64, seed: i64, width: i64, height: i64) -> i64 = monkey_ladder_write
export fn nw_monkey_ladder_expected(seed: i64, level: i64, index: i64) -> i64 = monkey_ladder_expected
export fn nw_menu_write(dest: i64, capacity: i64, selpos: i64, black_background: i64) -> i64 = menu_write
export fn nw_menu_state_write(dest: i64, capacity: i64, selpos: i64, black_background: i64, bools: i64, cubes: i64, grid: i64, active_cells: i64, trial_ms: i64, multi: i64, multimode: i64, interference_tenths: i64) -> i64 = menu_state_write
