export fn nw_ms_to_ticks(ms: f64, tick_ms: i64) -> i64 = ms_to_ticks
export fn nw_clamp_trial_interval_ms(ms: i64, tick_ms: i64, min_ticks: i64, max_ms: i64) -> i64 = clamp_trial_interval_ms
export fn nw_interval_adjust_step(ms: i64) -> i64 = interval_adjust_step
# Structs do not cross the C ABI here (a `Cell` parameter is rejected as
# non-C-ABI-compatible), so every exported entry point takes and returns
# scalars, and aggregates are read one field at a time through a flat accessor.
def cell_distance(pid: i64, col: i64, row: i64, depth: i64, size: i64, dim: i64) -> i64:
    return centre_distance4(Cell{pid: pid, col: col, row: row, depth: depth}, size, dim)

export fn nw_cell_distance(pid: i64, col: i64, row: i64, depth: i64, size: i64, dim: i64) -> i64 = cell_distance

def phase_field(trial_ms: i64, stim_ms: i64, feedback_ms: i64, tick_ms: i64, field: i64) -> i64:
    phases: TrialPhases = plan_trial_phases(trial_ms, stim_ms, feedback_ms, tick_ms)
    return phases.total_ticks if field == 0 else (phases.stimulus_ticks if field == 1 else (phases.blank_ticks if field == 2 else (phases.feedback_ticks if field == 3 else (phases.stimulus_ms if field == 4 else (phases.blank_ms if field == 5 else phases.feedback_ms)))))

export fn nw_phase_field(trial_ms: i64, stim_ms: i64, feedback_ms: i64, tick_ms: i64, field: i64) -> i64 = phase_field

# ------------------------------------------------------------
# Display-list frames
# ------------------------------------------------------------
#
# The shell allocates one buffer up front and asks for frames into it, then
# reads the encoded bytes straight out of linear memory as a Uint8Array view.
# No copy crosses the boundary and nothing is allocated per frame on the JS
# side.
#
# A caller-provided buffer rather than a static: the frame is built in a
# function-local region that is destroyed on the way out, so the bytes must be
# copied somewhere that outlives it, and letting the shell own that storage
# keeps lifetime out of the ABI.

extern malloc(size: usize) -> mutable heap void&? can[Memory.Allocate]

def frame_alloc(size: i64) -> i64:
    can Memory.Allocate, Abort.Panic:
        trusted Unsafe.PointerCast:
            block: mutable heap void&? = malloc(size.usize())
            0 return if block == null
            slot: mutable heap void& = block
            return slot.cast[u8&].uintptr().i64()

def frame_free(pointer: i64):
    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        if pointer > 0:
            trusted Unsafe.PointerCast:
                block: heap void& = pointer.uintptr().cast[heap void&]
                free(block)

# The title frame follows the same ambient-region rule as the task frames.
def title_write(dest: i64, capacity: i64, banner_code: i64, black_background: i64, jaeggi_mode: i64, clinical_mode: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        written: mutable i64 = 0
        list: mutable Display::DisplayList = Display::DisplayList()
        render_title_frame_coded(&list, banner_code, black_background != 0, jaeggi_mode != 0, clinical_mode != 0)
        encoded: darray[u8] = Display::encode_binary(&list)
        length: i64 = encoded.count.i64()
        if length <= capacity and length > 0:
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            written <- length
        return written

def taskhub_write(dest: i64, capacity: i64, category: i64, selected: i64,
                  black_background: i64, width: i64, height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        written: mutable i64 = 0
        canvas_width: f64 = width.f64()
        canvas_height: f64 = height.f64()
        sx: f64 = canvas_width / Display::REFERENCE_WIDTH
        sy: f64 = canvas_height / Display::REFERENCE_HEIGHT
        paint: SceneTaskHub::HubPaint = SceneTaskHub::paint_of(
            black_background != 0, canvas_width, canvas_height, sx, sy)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneTaskHub::render(&list, &paint, category, selected, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true)
        encoded: darray[u8] = Display::encode_binary(&list)
        length: i64 = encoded.count.i64()
        if length <= capacity and length > 0:
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            written <- length
        return written

def task_write(dest: i64, capacity: i64, category: i64, selected: i64,
               black_background: i64, started: i64, width: i64, height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        written: mutable i64 = 0
        canvas_width: f64 = width.f64()
        canvas_height: f64 = height.f64()
        sx: f64 = canvas_width / Display::REFERENCE_WIDTH
        sy: f64 = canvas_height / Display::REFERENCE_HEIGHT
        paint: SceneTask::TaskPaint = SceneTask::paint_of(
            black_background != 0, canvas_width, canvas_height, sx, sy)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneTask::render(&list, &paint, category, selected, started != 0)
        encoded: darray[u8] = Display::encode_binary(&list)
        length: i64 = encoded.count.i64()
        if length <= capacity and length > 0:
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            written <- length
        return written

def task_game_input_write(dest: i64, capacity: i64, category: i64, selected: i64,
                          black_background: i64, phase: i64, action: i64,
                          cursor: i64, value: i64, steps: i64, verdict: i64,
                          width: i64, height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        written: mutable i64 = 0
        canvas_width: f64 = width.f64()
        canvas_height: f64 = height.f64()
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneTaskGames::render(&list, category, selected, phase, action, cursor,
                               value, steps, verdict, black_background,
                               canvas_width, canvas_height)
        encoded: darray[u8] = Display::encode_binary(&list)
        length: i64 = encoded.count.i64()
        if length <= capacity and length > 0:
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            written <- length
        return written

# Kept as a compatibility wrapper for older shell clients and existing ABI
# sweeps. A started frame is the active phase with no input yet.
def task_game_write(dest: i64, capacity: i64, category: i64, selected: i64,
                    black_background: i64, started: i64, width: i64,
                    height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return task_game_input_write(dest, capacity, category, selected,
                                     black_background, 1 if started != 0 else 0,
                                     0, 0, 0, 0, -1, width, height)

def marble_board_write(dest: i64, capacity: i64, rung: i64, seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return MarbleBoardABI::write(dest, capacity, rung, seed)

def monkey_ladder_write_state(dest: i64, capacity: i64, phase: i64,
                              sequence_level: i64, display_level: i64,
                              adaptive: i64, clicked_upto: i64, wrong: i64,
                              cursor_cell: i64, cursor_enabled: i64,
                              reveal_answer: i64, seed: i64, width: i64,
                              height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        written: mutable i64 = 0
        grid: i64 = 5
        cells: i64 = grid * grid
        actual_sequence_level: i64 = 2 if sequence_level < 2 else (cells if sequence_level > cells else sequence_level)
        actual_display_level: i64 = 2 if display_level < 2 else (cells if display_level > cells else display_level)
        rng: mutable MT19937 = mt19937_new()
        mt_seed_int(&rng, seed.u64())
        sequence: mutable darray[i64] = py_sample_range(&rng, 0, cells - 1, actual_sequence_level)
        canvas_width: f64 = width.f64()
        canvas_height: f64 = height.f64()
        sx: f64 = canvas_width / Display::REFERENCE_WIDTH
        sy: f64 = canvas_height / Display::REFERENCE_HEIGHT
        paint: SceneMonkeyLadder::MonkeyLadderPaint = SceneMonkeyLadder::paint_of(
            false, canvas_width, canvas_height, sx, sy)
        list: mutable Display::DisplayList = Display::DisplayList()
        message: mutable dstr = []
        if phase == SceneMonkeyLadder::PHASE_SHOW:
            dstr_append_cstr(&message, "Remember the order")
        elif phase == SceneMonkeyLadder::PHASE_INPUT:
            dstr_append_cstr(&message, "Click 1 through ")
            dstr_append_i64(&message, actual_sequence_level)
        elif phase == SceneMonkeyLadder::PHASE_RESULT:
            if wrong < 0:
                dstr_append_cstr(&message, "Correct")
                if adaptive != 0:
                    dstr_append_cstr(&message, " — next length ")
                    dstr_append_i64(&message, actual_display_level)
            else:
                dstr_append_cstr(&message, "Miss")
                if adaptive != 0:
                    dstr_append_cstr(&message, " — back to length ")
                    dstr_append_i64(&message, actual_display_level)
        else:
            dstr_append_cstr(&message, "Press Space to watch the numbers")
        SceneMonkeyLadder::render(&list, &paint, &sequence, actual_sequence_level, grid,
                                  phase, actual_display_level, clicked_upto, wrong,
                                  cursor_cell, cursor_enabled != 0,
                                  reveal_answer != 0, bytes_view(message))
        encoded: darray[u8] = Display::encode_binary(&list)
        length: i64 = encoded.count.i64()
        if length <= capacity and length > 0:
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            written <- length
        return written

# Backward-compatible stateless frame entry point: before adaptive state was
# carried separately, the sequence length and the status-line level were the
# same value.
def monkey_ladder_write(dest: i64, capacity: i64, phase: i64, level: i64,
                        clicked_upto: i64, wrong: i64, cursor_cell: i64,
                        cursor_enabled: i64, reveal_answer: i64, seed: i64,
                        width: i64, height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return monkey_ladder_write_state(dest, capacity, phase, level, level,
                                         0, clicked_upto, wrong, cursor_cell,
                                         cursor_enabled, reveal_answer, seed,
                                         width, height)

def monkey_ladder_expected(seed: i64, level: i64, index: i64) -> i64:
    can Memory.Allocate, Abort.Panic:
        grid: i64 = 5
        cells: i64 = grid * grid
        actual_level: i64 = 2 if level < 2 else (cells if level > cells else level)
        rng: mutable MT19937 = mt19937_new()
        mt_seed_int(&rng, seed.u64())
        sequence: mutable darray[i64] = py_sample_range(&rng, 0, cells - 1, actual_level)
        return get sequence[index.usize()] else -1

# Persistent Monkey Ladder run ABI. The host keeps this fixed-layout record
# alive across actions; clock deadlines and answer state therefore live in the
# controller, not in browser-side guessed phase/level variables.
def monkey_ladder_run_init(run_ptr: i64, grid: i64, start_level: i64,
                           adaptive: i64, show_ms: i64, per_tile_ms: i64,
                           reveal_answer: i64, seed: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            run: mutable heap MonkeyLadderGame::MonkeyLadderRun& = run_ptr.uintptr().cast[mutable heap MonkeyLadderGame::MonkeyLadderRun&]
            MonkeyLadderGame::initialize(run, grid, start_level,
                adaptive != 0, show_ms, per_tile_ms, reveal_answer != 0, seed)
        return 1

def monkey_ladder_run_action(run_ptr: i64, action: i64, value: i64,
                             now_ms: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            run: mutable heap MonkeyLadderGame::MonkeyLadderRun& = run_ptr.uintptr().cast[mutable heap MonkeyLadderGame::MonkeyLadderRun&]
            MonkeyLadderGame::action(run, action, value, now_ms)
            return run.phase

def monkey_ladder_run_info(run_ptr: i64, field: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            run: heap MonkeyLadderGame::MonkeyLadderRun& = run_ptr.uintptr().cast[heap MonkeyLadderGame::MonkeyLadderRun&]
            return MonkeyLadderGame::info(run, field)

def monkey_ladder_run_cell(run_ptr: i64, kind: i64, at: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            run: heap MonkeyLadderGame::MonkeyLadderRun& = run_ptr.uintptr().cast[heap MonkeyLadderGame::MonkeyLadderRun&]
            return MonkeyLadderGame::cell(run, kind, at)

def monkey_ladder_run_frame_write(dest: i64, capacity: i64, run_ptr: i64,
                                  black_background: i64, width: i64,
                                  height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        written: mutable i64 = 0
        trusted Unsafe.PointerCast:
            run: heap MonkeyLadderGame::MonkeyLadderRun& = run_ptr.uintptr().cast[heap MonkeyLadderGame::MonkeyLadderRun&]
            sequence: mutable darray[i64] = Ints::zeros(run.length)
            for at in 0..<run.length |run, sequence|:
                Ints::put(&sequence, at, run.sequence[at.usize()])
            canvas_width: f64 = width.f64()
            canvas_height: f64 = height.f64()
            sx: f64 = canvas_width / Display::REFERENCE_WIDTH
            sy: f64 = canvas_height / Display::REFERENCE_HEIGHT
            paint: SceneMonkeyLadder::MonkeyLadderPaint = SceneMonkeyLadder::paint_of(
                black_background != 0, canvas_width, canvas_height, sx, sy)
            list: mutable Display::DisplayList = Display::DisplayList()
            message: mutable dstr = []
            if run.phase == MonkeyLadderGame::PHASE_SHOW:
                dstr_append_cstr(&message, "Remember the order")
            elif run.phase == MonkeyLadderGame::PHASE_INPUT:
                dstr_append_cstr(&message, "Click 1 through ")
                dstr_append_i64(&message, run.length)
            elif run.phase == MonkeyLadderGame::PHASE_RESULT:
                if run.wrong < 0:
                    dstr_append_cstr(&message, "Correct")
                    if run.adaptive:
                        dstr_append_cstr(&message, " — next length ")
                        dstr_append_i64(&message, run.level)
                else:
                    dstr_append_cstr(&message, "Miss")
                    if run.adaptive:
                        dstr_append_cstr(&message, " — back to length ")
                        dstr_append_i64(&message, run.level)
            else:
                dstr_append_cstr(&message, "Press Space to watch the numbers")
            SceneMonkeyLadder::render(&list, &paint, &sequence, run.length,
                run.grid, run.phase, run.level, run.next_index, run.wrong,
                run.cursor_cell, run.cursor_enabled, run.reveal_answer,
                bytes_view(message))
            encoded: darray[u8] = Display::encode_binary(&list)
            length: i64 = encoded.count.i64()
            if length <= capacity and length > 0:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
                written <- length
        return written

# Stateful Sokoban ABI. The host allocates one aligned Run block with
# nw_frame_alloc(), initializes it once, and then passes the same handle for
# semantic actions, read-only state queries, and frame construction.
def sokoban_run_init(run_ptr: i64, start_rung: i64, total_trials: i64,
                     adaptive: i64, show_traps: i64, seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            run: mutable heap SokobanGame::SokobanRun& = run_ptr.uintptr().cast[mutable heap SokobanGame::SokobanRun&]
            SokobanGame::initialize(run, start_rung, total_trials,
                                    adaptive != 0, show_traps != 0, seed)
        return 1

def sokoban_run_action(run_ptr: i64, action: i64, now_ms: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            run: mutable heap SokobanGame::SokobanRun& = run_ptr.uintptr().cast[mutable heap SokobanGame::SokobanRun&]
            SokobanGame::apply(run, action, now_ms)
        return 1

def sokoban_run_dispose(run_ptr: i64) -> i64:
    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            run: mutable heap SokobanGame::SokobanRun& = run_ptr.uintptr().cast[mutable heap SokobanGame::SokobanRun&]
            SokobanGame::dispose(run)
        return 1

def sokoban_run_info(run_ptr: i64, field: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            run: heap SokobanGame::SokobanRun& = run_ptr.uintptr().cast[heap SokobanGame::SokobanRun&]
            return SokobanGame::info(run, field)

def sokoban_run_cell(run_ptr: i64, field: i64, at: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            run: heap SokobanGame::SokobanRun& = run_ptr.uintptr().cast[heap SokobanGame::SokobanRun&]
            return SokobanGame::cell(run, field, at)

def sokoban_run_frame_write(dest: i64, capacity: i64, run_ptr: i64,
                            black_background: i64, width: i64,
                            height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        written: mutable i64 = 0
        list: mutable Display::DisplayList = Display::DisplayList()
        trusted Unsafe.PointerCast:
            run: mutable heap SokobanGame::SokobanRun& = run_ptr.uintptr().cast[mutable heap SokobanGame::SokobanRun&]
            SokobanGame::render(run, black_background != 0,
                                width.f64(), height.f64(), &list)
        encoded: darray[u8] = Display::encode_binary(&list)
        length: i64 = encoded.count.i64()
        if length > 0 and length <= capacity:
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            written <- length
        return written

