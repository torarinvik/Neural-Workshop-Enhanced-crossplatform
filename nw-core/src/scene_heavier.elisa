include "./tasks/heavier_game.elisa"
include "./scene_live_view.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"

module SceneHeavier:
    const LEFT: f64 = (LiveView::WIDTH - LiveView::VIEW_WIDTH) / 2.0
    const START_X: f64 = LEFT + 70.0
    const WALL_X: f64 = LEFT + LiveView::VIEW_WIDTH - 150.0
    const METRE: f64 = (WALL_X - START_X) / Heavier::LANE

    struct Lane:
        floor: f64
        height: f64

    def bottom() -> f64:
        can Abort.Panic:
            return Verdict::above_the_band(LiveView::HEIGHT, Geometry::from_bottom_edge(LiveView::HEIGHT, 58.0).f64()).f64()

    def height() -> f64:
        can Abort.Panic:
            return fmax(40.0, Geometry::from_top_edge(LiveView::HEIGHT, 116.0).f64() - bottom())

    def lane(index: i64, crates: i64) -> Lane:
        can Abort.Panic:
            span: f64 = height()
            h: f64 = (span - 40.0) / crates.f64()
            return Lane{floor: bottom() + span - 20.0 - (index + 1).f64() * h + h * 0.18, height: h}

    def button(row: Lane) -> SceneHiddenRule::Rect:
        return SceneHiddenRule::Rect{x: WALL_X + 26.0, y: row.floor + row.height * 0.25, w: 104.0, h: 34.0}

    def hit(crates: i64, x: f64, y: f64) -> i64:
        can Abort.Panic:
            for index in 0..<crates |crates, x, y|:
                row: Lane = lane(index, crates)
                pick: SceneHiddenRule::Rect = button(row)
                if SceneHiddenRule::contains(&pick, x, y):
                    return Heavier::FIRST_PICK + index
                if x >= START_X - 10.0 and x <= WALL_X and y >= row.floor - 8.0 and y <= row.floor + row.height * 0.75:
                    return index
            return HeavierGame::NEUTRAL

    def label(list: mutable Display::DisplayList&, text: sview, x: f64, y: f64, size: f64, ink: u32, bold: bool = false):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x, y, size, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def course(list: mutable Display::DisplayList&, run: Heavier::Run&, held: i64):
        can Memory.Allocate, Abort.Panic:
            b: Heavier::Board = Heavier::current(run)
            crates: i64 = run.round.level.crates
            for i in 0..<crates |list, run, held, b, crates|:
                at: usize = i.usize()
                row: Lane = lane(i, crates)
                floor: f64 = row.floor
                Display::draw_rect(list, START_X - 10.0, floor - 8.0, WALL_X - START_X + 10.0, 8.0, 0x786e64ff)
                Display::draw_rect(list, WALL_X, floor - 8.0, 12.0, row.height * 0.75, 0x5a504aff)
                crate: mutable dstr = []
                dstr_append_i64(&crate, i + 1)
                label(list, bytes_view(crate), LEFT + 34.0, floor + row.height * 0.3, 18.0, 0xdce0f0ff, true)
                side: f64 = b.size[at] * fmin(METRE * 0.95, row.height * 0.62 / 0.9)
                x: f64 = START_X + (run.x[at] + b.size[at]) * METRE - side
                Display::draw_rect(list, x, floor, side, side, 0x785432ff)
                Display::draw_rect(list, x + 4.0, floor + 4.0, side - 8.0, side - 8.0,
                    0xd6a86eff if run.v[at] > 0.02 else 0xc49660ff)
                Display::draw_line(list, x + 4.0, floor + 4.0, x + side - 4.0, floor + side - 4.0, 3.0, 0x966c40ff)
                Display::draw_line(list, x + 4.0, floor + side - 4.0, x + side - 4.0, floor + 4.0, 3.0, 0x966c40ff)
                if run.result == Heavier::LIVE and held == i:
                    mid: f64 = floor + side / 2.0
                    Display::draw_triangle(list, x - 26.0, mid + 10.0, x - 6.0, mid, x - 26.0, mid - 10.0, 0xfadc5aff)
                pick: SceneHiddenRule::Rect = button(row)
                Display::draw_rect(list, pick.x, pick.y, pick.w, pick.h, 0x58648cff)
                label(list, "this one", pick.x + pick.w / 2.0, pick.y + pick.h / 2.0, 12.0, 0xf0f2faff, true)

    def board_number(run: Heavier::Run&, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_i64(words, run.board + 1)
            dstr_append_cstr(words, " of ")
            dstr_append_i64(words, run.round.level.boards)

    def verdict_text(run: Heavier::Run&, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.result == Heavier::CLEAR:
                dstr_append_cstr(words, "Every board right")
            elif run.result == Heavier::TIMEOUT:
                dstr_append_cstr(words, "Out of time on board ")
                dstr_append_i64(words, run.board + 1)
            elif run.result == Heavier::WRONG:
                b: Heavier::Board = Heavier::current(run)
                dstr_append_cstr(words, "Board ")
                dstr_append_i64(words, run.board + 1)
                dstr_append_cstr(words, ": crate ")
                dstr_append_i64(words, b.answer + 1)
                dstr_append_cstr(words, " was the slipperiest" if b.slippery else " was the heaviest")

    def render(list: mutable Display::DisplayList&, session: HeavierGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            label(list, "Heavier", LiveView::CX, 648.0, 22.0, ink, true)
            label(list, "Hold a crate or 1-4: push   Click its button or Z / X / C / V: answer   Esc: menu",
                LiveView::CX, 26.0, 12.0, ink)
            status: mutable dstr = []
            run: Heavier::Run& = &session.run
            if session.phase == HeavierGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == HeavierGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == HeavierGame::JUDGED:
                verdict_text(run, &status)
            else:
                dstr_append_cstr(&status, "Board ")
                board_number(run, &status)
                dstr_append_cstr(&status, ": under which crate is the floor slipperiest?" if Heavier::current(run).slippery else ": which crate is heaviest?")
            label(list, bytes_view(status), LiveView::CX, 614.0, 14.0, ink)
            if session.phase == HeavierGame::PLAYING or session.phase == HeavierGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   board ")
                board_number(run, &facts)
                dstr_append_cstr(&facts, "   ")
                dstr_append_i64(&facts, py_round_half_even(fmax(0.0, run.round.level.seconds - (run.t - run.started))))
                dstr_append_cstr(&facts, " s left")
                label(list, bytes_view(facts), LiveView::CX, 588.0, 12.0, ink)
                card: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT - 4.0, y: bottom() - 4.0, w: LiveView::VIEW_WIDTH + 8.0, h: height() + 8.0}
                shades: u32[3] = [30.u32(), 18.u32(), 12.u32()]
                for i in 0..<3 |list, card, shades|:
                    blur: f64 = i.f64() * 2.0
                    shadow: SceneHiddenRule::Rect = ScenePolish::spread_box(&card, blur, 4.0)
                    ScenePolish::rounded(list, &shadow, 14.0 + blur, shades[i.usize()])
                ScenePolish::rounded(list, &card, 14.0, 0x24262eff)
                course(list, run, HeavierGame::held(session))
            if session.phase == HeavierGame::JUDGED or session.phase == HeavierGame::DONE:
                caption: mutable dstr = []
                verdict_text(run, &caption)
                SceneVerdict::put(list, LiveView::WIDTH, LiveView::HEIGHT, 1.0, 1.0, run.result == Heavier::CLEAR,
                    bytes_view(caption), 60.0, 16.0)

    def option_note(rung: i64, text: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Heavier::Grade = Heavier::grade(rung)
            dstr_append_cstr(text, "Rung ")
            dstr_append_i64(text, level.rung)
            dstr_append_cstr(text, ": ")
            dstr_append_i64(text, level.crates)
            dstr_append_cstr(text, " crates, ")
            dstr_append_i64(text, level.boards)
            dstr_append_cstr(text, " boards.")
            dstr_append_cstr(text, "  Each floor grips differently.") if level.floors
