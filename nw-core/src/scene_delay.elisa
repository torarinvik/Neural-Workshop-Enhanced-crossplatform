include "tasks/delay_game.elisa"
include "scene_polish.elisa"
include "textmetrics.elisa"

module SceneDelay:
    const CENTER: f64 = 456.0
    const WIDTH: f64 = 857.28
    const BOTTOM: f64 = 179.0
    const HEIGHT: f64 = 389.0
    const GOLD: u32 = 0xe8ba3cff
    const START: i64 = DelayGame::START

    def offer_box(port: i64) -> SceneHiddenRule::Rect:
        width: f64 = WIDTH * 0.3
        gap: f64 = WIDTH * 0.03
        return SceneHiddenRule::Rect{x: CENTER - width - gap if port == DelayGame::TAKE else CENTER + gap,
            y: BOTTOM + HEIGHT * 0.24, w: width, h: HEIGHT * 0.46}

    def hit(session: DelayGame::Session&, x: f64, y: f64) -> i64:
        return START if session.phase == DelayGame::READY or session.phase == DelayGame::DONE
        return -1 if session.phase != DelayGame::PLAYING or session.mode == DelayGame::PAUSE
        left: SceneHiddenRule::Rect = offer_box(DelayGame::TAKE)
        return DelayGame::TAKE if SceneHiddenRule::contains(&left, x, y)
        right: SceneHiddenRule::Rect = offer_box(DelayGame::WAIT)
        return DelayGame::WAIT if session.mode == DelayGame::OFFER and SceneHiddenRule::contains(&right, x, y)
        return -1

    def coin(list: mutable Display::DisplayList&, x: f64, y: f64, radius: f64):
        can Memory.Allocate, Abort.Panic:
            Display::draw_circle(list, x, y - radius * 0.12, radius, 0x9f781dff)
            Display::draw_circle(list, x, y, radius, 0xf4b82cff)
            Display::draw_circle(list, x, y, radius * 0.72, 0xf6c552ff)
            Display::draw_circle(list, x - radius * 0.3, y + radius * 0.32, radius * 0.18, 0xffffffaa)

    def pile(list: mutable Display::DisplayList&, x: f64, y: f64, count: i64, radius: f64):
        can Memory.Allocate, Abort.Panic:
            rows: i64 = (count + 3) / 4
            for k in 0..<count |k, list, x, y, count, radius, rows|:
                row: i64 = k / 4
                left: i64 = count - row * 4
                in_row: i64 = 4 if left > 4 else left
                cx: f64 = x + ((k % 4).f64() - (in_row - 1).f64() / 2.0) * radius * 1.7 + row.f64() * radius * 0.4
                cy: f64 = y - (rows - 1).f64() * radius * 0.55 + row.f64() * radius * 1.1
                coin(list, cx, cy, radius)

    def ring(list: mutable Display::DisplayList&, x: f64, y: f64, radius: f64, share: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            steps: i64 = (48.0 * share).i64() + 1
            for step in 0..<steps |list, x, y, radius, share, color, steps|:
                a: f64 = 1.5707963267948966 - 6.283185307179586 * share * step.f64() / steps.f64()
                b: f64 = 1.5707963267948966 - 6.283185307179586 * share * (step + 1).f64() / steps.f64()
                Display::draw_line(list, x + cos(a) * radius, y + sin(a) * radius,
                    x + cos(b) * radius, y + sin(b) * radius, radius * 0.22, color)

    def draw_offer(list: mutable Display::DisplayList&, session: DelayGame::Session&, port: i64,
                   now: f64, dark: bool, ink: u32, muted: u32):
        can Memory.Allocate, Abort.Panic:
            box: SceneHiddenRule::Rect = offer_box(port)
            offer: Delay::Offer = session.dealt.offers[session.offer.usize()]
            waiting: bool = session.mode == DelayGame::WAITING
            later: bool = port == DelayGame::WAIT
            active: bool = waiting and later
            x: f64 = box.x + box.w / 2.0
            fill: u32 = 0x514a39ff if dark else 0xfaf0d4ff
            face: u32 = fill if active else (0x262b38ff if dark else 0xffffffff)
            edge: u32 = GOLD if active else (0x424a5cff if dark else 0xd2d8e4ff)
            ScenePolish::card_face(list, &box, 16.0, face, edge, 0.u32(), dark)
            title: mutable dstr = []
            if not later:
                dstr_append_cstr(&title, "Give up" if waiting else "Take it now")
            elif session.dealt.level.shown:
                dstr_append_cstr(&title, "Wait ")
                dstr_append_fixed(&title, offer.wait, 1)
                dstr_append_cstr(&title, " s")
            else:
                dstr_append_cstr(&title, "Wait for it")
            SceneHiddenRule::text(list, bytes_view(title), x, box.y + box.h * 0.82, 18.0, ink,
                Display::ANCHOR_CENTER_CENTER, true)
            count: i64 = offer.large if later else offer.small
            if active:
                elapsed: f64 = now - session.since if now > session.since else 0.0
                share: f64 = elapsed / offer.wait if session.dealt.level.shown else (elapsed - (elapsed / 10.0).i64().f64() * 10.0) / 10.0
                cy: f64 = box.y + box.h * 0.45
                radius: f64 = SceneHiddenRule::minimum(box.w, box.h) * 0.2
                ring(list, x, cy, radius, 1.0, 0x696763ff if dark else 0xcac6baff)
                if share > 0.0:
                    ring(list, x, cy, radius, SceneHiddenRule::minimum(1.0, share), 0xd1a736ff)
                wait_text: mutable dstr = []
                dstr_append_fixed(&wait_text, elapsed, 1)
                dstr_append_cstr(&wait_text, " s")
                SceneHiddenRule::text(list, bytes_view(wait_text), x, cy, 14.0, ink,
                    Display::ANCHOR_CENTER_CENTER, true)
            else:
                pile(list, x, box.y + box.h * 0.48, count, SceneHiddenRule::minimum(box.w, box.h) * 0.075)
            label: mutable dstr = []
            dstr_append_i64(&label, count)
            dstr_append_cstr(&label, " later" if later else " now")
            SceneHiddenRule::text(list, bytes_view(label), x, box.y + box.h * 0.14, 14.0, muted)

    def status(session: DelayGame::Session&, label: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if session.phase == DelayGame::READY:
                dstr_append_cstr(label, "Press Space or click to start")
            elif session.phase == DelayGame::DONE:
                dstr_append_i64(label, session.passed_count)
                dstr_append_cstr(label, " of ")
                dstr_append_i64(label, session.trial)
                dstr_append_cstr(label, " passed   highest rung passed ")
                dstr_append_i64(label, session.best_rung)
            elif session.phase == DelayGame::JUDGED:
                dstr_append_i64(label, session.coins)
                dstr_append_cstr(label, " coins (par ")
                dstr_append_i64(label, round_half_even(session.par))
                dstr_append_cstr(label, ")")
            else:
                dstr_append_cstr(label, "Collect as many coins as you can")

    def wait_description(kind: i64) -> cstr:
        return "every wait three seconds, shown" if kind == Delay::FIXED
        return "hidden waits of two to six seconds" if kind == Delay::UNIFORM
        return "mostly short waits, some endless" if kind == Delay::HEAVY
        return "every offer different, all shown" if kind == Delay::VARIED
        return "hidden waits that change kind halfway" if kind == Delay::SWITCH
        return "three in ten large rewards never come" if kind == Delay::NEVER_KIND
        return "kinds mixed and switching"

    def option_note(rung: i64, note: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Delay::Grade = Delay::grade(rung)
            dstr_append_cstr(note, "Rung ")
            dstr_append_i64(note, level.rung)
            dstr_append_cstr(note, ": ")
            dstr_append_i64(note, level.seconds.i64())
            dstr_append_cstr(note, " s runs, ")
            dstr_append_cstr(note, wait_description(level.kind))
            dstr_append_cstr(note, ".")

    def render(list: mutable Display::DisplayList&, session: DelayGame::Session&, now: f64, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            muted: u32 = 0x969eb0ff if dark else 0x70788aff
            SceneHiddenRule::text(list, "Delay", CENTER, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            message: mutable dstr = []
            status(session, &message)
            SceneHiddenRule::text(list, bytes_view(message), CENTER, 614.0, 14.0, ink)
            SceneHiddenRule::text(list, "A or Left: take it now / give up   D or Right: wait   Esc: menu", CENTER, 26.0, 12.0, ink)
            return if session.phase == DelayGame::READY or session.phase == DelayGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  run ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.trials)
            dstr_append_cstr(&facts, "   par ")
            dstr_append_i64(&facts, round_half_even(session.par))
            SceneHiddenRule::text(list, bytes_view(facts), CENTER, 588.0, 12.0, ink)
            purse: mutable dstr = []
            dstr_append_i64(&purse, session.coins)
            dstr_append_cstr(&purse, " coins")
            radius: f64 = HEIGHT * 0.035
            y: f64 = BOTTOM + HEIGHT * 0.88
            coin(list, CENTER - TextMetrics::text_width(24.0, purse.count.i64()).f64() / 2.0 - radius * 0.4, y, radius)
            SceneHiddenRule::text(list, bytes_view(purse), CENTER + radius * 1.4, y, 24.0,
                ink, Display::ANCHOR_CENTER_CENTER, true)
            if session.mode == DelayGame::OFFER or session.mode == DelayGame::WAITING:
                draw_offer(list, session, DelayGame::TAKE, now, dark, ink, muted)
                draw_offer(list, session, DelayGame::WAIT, now, dark, ink, muted)
            else:
                SceneHiddenRule::text(list, "next offer ...", CENTER, BOTTOM + HEIGHT * 0.47, 18.0, muted)
            seconds: f64 = session.dealt.level.seconds - (now - session.began)
            remaining: f64 = (SceneHiddenRule::minimum(seconds, session.dealt.level.seconds)) if seconds > 0.0 else 0.0
            width: f64 = WIDTH * 0.8
            track: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: CENTER - width / 2.0,
                y: BOTTOM + HEIGHT * 0.1, w: width, h: radius}
            ScenePolish::rounded(list, &track, radius / 2.0, 0x2d3240ff if dark else 0xdfe4edff)
            if remaining > 0.0:
                span: f64 = width * remaining / session.dealt.level.seconds
                fill: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: track.x, y: track.y,
                    w: span if span > radius else radius, h: radius}
                ScenePolish::rounded(list, &fill, radius / 2.0, 0x5a8cdcff)
            time: mutable dstr = []
            dstr_append_i64(&time, (remaining + 0.99).i64())
            dstr_append_cstr(&time, " s left")
            SceneHiddenRule::text(list, bytes_view(time), CENTER, BOTTOM + HEIGHT * 0.05, 12.0, muted)
            if session.phase == DelayGame::JUDGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.passed, bytes_view(message), 60.0, 16.0)
