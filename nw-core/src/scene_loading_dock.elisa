include "./tasks/loading_dock_game.elisa"
include "./scene_hand.elisa"
include "./scene_verdict.elisa"

module SceneLoadingDock:
    const SLOT: i64 = 0
    const TRUCK: i64 = 1
    const PLAYER: i64 = 2
    const OTHER: i64 = 3

    struct Item:
        depth: f64
        kind: i64
        index: i64

    def see(view: HandView::Lens&, x: f64, y: f64, z: f64) -> RoomsView::Vec:
        return HandView::see(view, RoomsView::vec(x, y, z))

    def insert(items: mutable Item[13]&, count: i64, item: Item):
        can Abort.Panic:
            at: mutable i64 = count
            while at > 0 |items, at, item|:
                previous: Item = items[(at - 1).usize()]
                break if previous.depth >= item.depth
                items[at.usize()] <- previous
                at <- at - 1
            items[at.usize()] <- item

    def quad(list: mutable Display::DisplayList&, a: RoomsView::Vec, b: RoomsView::Vec,
             c: RoomsView::Vec, d: RoomsView::Vec, colour: u32):
        can Memory.Allocate, Abort.Panic:
            return if a.z < 0.05 or b.z < 0.05 or c.z < 0.05 or d.z < 0.05
            points: mutable RoomsView::Vec[32] = zeroed
            points[0] <- a
            points[1] <- b
            points[2] <- c
            points[3] <- d
            SceneHand::polygon(list, &points, 4, colour)

    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, SceneHand::x(x), SceneHand::y(y), w * SceneHand::SCALE, h * SceneHand::SCALE, colour)

    def lamp_disc(list: mutable Display::DisplayList&, p: RoomsView::Vec, colour: u32):
        can Memory.Allocate, Abort.Panic:
            radius: f64 = 12.0
            return if p.x < -radius or p.x > HandView::WIDTH + radius or p.y < -radius or p.y > HandView::HEIGHT + radius
            if p.x >= radius and p.x <= HandView::WIDTH - radius and p.y >= radius and p.y <= HandView::HEIGHT - radius:
                Display::draw_circle(list, SceneHand::x(p.x), SceneHand::y(p.y), radius * SceneHand::SCALE, colour)
                return
            points: mutable RoomsView::Vec[32] = zeroed
            for k in 0..<16 |points, p, radius|:
                angle: f64 = k.f64() * 0.39269908169872414
                points[k.usize()] <- RoomsView::vec(p.x + radius * cos(angle), p.y + radius * sin(angle), p.z)
            SceneHand::polygon(list, &points, 16, colour)

    def block(list: mutable Display::DisplayList&, view: HandView::Lens&, x: f64, z: f64,
              half_w: f64, half_d: f64, base: f64, top: f64, colour: u32, turn: f64 = 0.0):
        can Memory.Allocate, Abort.Panic:
            fx: f64 = sin(turn)
            fz: f64 = cos(turn)
            ring: mutable RoomsView::Vec[4] = zeroed
            cap: mutable RoomsView::Vec[32] = zeroed
            for k in 0..<4 |fx, fz, x, z, half_w, half_d, ring, cap, view, top|:
                a: f64 = -half_w if k == 0 or k == 3 else half_w
                b: f64 = -half_d if k < 2 else half_d
                xx: f64 = x + a * -fz + b * fx
                zz: f64 = z + a * fx + b * fz
                ring[k.usize()] <- RoomsView::vec(xx, base, zz)
                cap[k.usize()] <- see(view, xx, top, zz)
            faces: mutable Item[13] = zeroed
            count: mutable i64 = 0
            for k in 0..<4 |ring, faces, count, view, base, top|:
                a: RoomsView::Vec = ring[k.usize()]
                b: RoomsView::Vec = ring[((k + 1) % 4).usize()]
                mid: RoomsView::Vec = see(view, (a.x + b.x) / 2.0, (base + top) / 2.0, (a.z + b.z) / 2.0)
                if mid.z >= 0.05:
                    insert(&faces, count, Item{depth: mid.z, kind: 0, index: k})
                    count <- count + 1
            for i in 0..<count |list, view, ring, cap, faces, colour|:
                k: i64 = faces[i.usize()].index
                j: i64 = (k + 1) % 4
                a: RoomsView::Vec = ring[k.usize()]
                b: RoomsView::Vec = ring[j.usize()]
                shade: u32 = ScenePolish::mix_rgb(0x000000ff, colour, 0.55 + 0.15 * i.f64())
                quad(list, HandView::see(view, a), HandView::see(view, b), cap[j.usize()], cap[k.usize()], shade)
            if cap[0].z >= 0.05 and cap[1].z >= 0.05 and cap[2].z >= 0.05 and cap[3].z >= 0.05:
                SceneHand::polygon(list, &cap, 4, ScenePolish::mix_rgb(colour, 0xffffffff, 0.15))

    def paint(kind: i64) -> u32:
        return 0xd6423aff if kind / 3 == 0
        return 0x4274e2ff if kind / 3 == 1
        return 0x42b060ff if kind / 3 == 2
        return 0xeccc42ff

    def mark(list: mutable Display::DisplayList&, kind: i64, x: f64, y: f64):
        can Memory.Allocate, Abort.Panic:
            tag: i64 = kind % 3
            if tag > 0:
                SceneHand::word(list, "F" if tag == 1 else "H", x, y, 13.0,
                    0x1e1e1eff if kind / 3 == 3 else 0xffffffff, true)

    def crate(list: mutable Display::DisplayList&, view: HandView::Lens&, kind: i64,
              x: f64, y: f64, z: f64, size: f64 = 0.55):
        can Memory.Allocate, Abort.Panic:
            top: f64 = y + 2.0 * size
            block(list, view, x, z, size, size, y, top, paint(kind))
            p: RoomsView::Vec = see(view, x, top + 0.02, z)
            if p.z >= 0.05:
                mark(list, kind, p.x, p.y)

    def shelf_slot(list: mutable Display::DisplayList&, view: HandView::Lens&, run: LoadingDock::Run&, index: i64):
        can Memory.Allocate, Abort.Panic:
            p: RoomsView::Vec = LoadingDock::slot(run, index)
            colour: u32 = 0xdcc86eff if LoadingDock::near_slot(run, index) else 0x545862ff
            block(list, view, p.x, p.z, 0.95, 0.8, 0.0, 0.35, colour)
            if run.time >= run.empty_until[index.usize()]:
                crate(list, view, run.dock.shelf[index.usize()], p.x, 0.35, p.z)

    def truck_body(list: mutable Display::DisplayList&, view: HandView::Lens&, run: LoadingDock::Run&, index: i64):
        can Memory.Allocate, Abort.Panic:
            truck: LoadingDock::Truck = get run.dock.trucks[index.usize()] else zeroed
            cargo: LoadingDock::Cargo = run.cargo[index.usize()]
            p: RoomsView::Vec = LoadingDock::bed(&truck)
            block(list, view, p.x, p.z, 1.9, 1.5, 0.5, 1.0, 0x464c5aff)
            for n in 0..<cargo.count |list, view, cargo, p|:
                crate(list, view, cargo.loads[n.usize()], p.x - 1.1 + 1.1 * n.f64(), 1.0, p.z, 0.45)
            block(list, view, p.x + 2.5, p.z + 0.3, 0.7, 1.1, 0.4, 2.6, 0xc8ced8ff)
            lamp: RoomsView::Vec = HandView::see(view, LoadingDock::lamp(&truck))
            if lamp.z >= 0.05:
                colour: u32 = 0x5ae678ff if LoadingDock::complete(run, &truck, index) else 0xf0aa3cff
                ScenePolish::glow(list, SceneHand::x(lamp.x), SceneHand::y(lamp.y), 30.0 * SceneHand::SCALE, colour, 70)
                lamp_disc(list, lamp, colour)
            label: RoomsView::Vec = see(view, p.x, 3.4, p.z)
            if label.z >= 0.05:
                SceneHand::word(list, sview(LoadingDock::city_name(truck.city), 0, -1), label.x, label.y, 14.0, 0xffffffff, true)
                share: f64 = HandView::clamp((truck.leave - run.time) / (truck.leave - truck.arrive), 0.0, 1.0)
                rect(list, label.x - 35.0, label.y - 18.0, 70.0 * share, 4.0,
                    0xf0503cff if truck.leave - run.time < 3.0 else 0xc8d2e6ff)

    def forklift(list: mutable Display::DisplayList&, view: HandView::Lens&, pose: LoadingDock::ForkPose,
                 colour: u32, carried: i64[2]&, count: i64):
        can Memory.Allocate, Abort.Panic:
            fx: f64 = sin(pose.heading)
            fz: f64 = cos(pose.heading)
            tip: RoomsView::Vec = see(view, pose.x + fx, 0.5, pose.z + fz)
            center: RoomsView::Vec = see(view, pose.x, 0.5, pose.z)
            far_forks: bool = tip.z > center.z
            for part in 0..<2 |list, view, pose, colour, carried, count, fx, fz, far_forks|:
                mast: bool = (part == 0) == far_forks
                if not mast:
                    block(list, view, pose.x - 0.25 * fx, pose.z - 0.25 * fz, 0.6, 0.75, 0.15, 1.0, colour, pose.heading)
                    block(list, view, pose.x - 0.55 * fx, pose.z - 0.55 * fz, 0.55, 0.4, 1.0, 1.7, 0x323640ff, pose.heading)
                    continue
                for side in 0..<2 |list, view, pose, fx, fz|:
                    offset: f64 = -0.35 if side == 0 else 0.35
                    x: f64 = pose.x - fz * offset
                    z: f64 = pose.z + fx * offset
                    start_x: f64 = x + 0.6 * fx
                    start_z: f64 = z + 0.6 * fz
                    SceneHand::line(list, see(view, start_x, 0.15, start_z),
                        see(view, x + 1.5 * fx, 0.15, z + 1.5 * fz), 4.0, 0x282a32ff)
                    SceneHand::line(list, see(view, start_x, 0.1, start_z),
                        see(view, start_x, 2.1, start_z), 4.0, 0x282a32ff)
                for n in 0..<count |list, view, pose, carried, fx, fz|:
                    crate(list, view, carried[n.usize()], pose.x + 1.15 * fx,
                        0.2 + 0.95 * n.f64(), pose.z + 1.15 * fz, 0.45)

    def add(items: mutable Item[13]&, count: mutable i64&, view: HandView::Lens&,
            point: RoomsView::Vec, kind: i64, index: i64):
        can Abort.Panic:
            q: RoomsView::Vec = HandView::see(view, point)
            if q.z >= 0.05:
                insert(items, count[0], Item{depth: q.z, kind: kind, index: index})
                count[0] <- count[0] + 1

    def figures(list: mutable Display::DisplayList&, view: HandView::Lens&, run: LoadingDock::Run&):
        can Memory.Allocate, Abort.Panic:
            items: mutable Item[13] = zeroed
            count: mutable i64 = 0
            for k in 0..<run.dock.level.kinds |items, count, view, run|:
                add(&items, &count, view, LoadingDock::slot(run, k), SLOT, k)
            for k in 0..<run.dock.level.trucks |items, count, view, run|:
                truck: LoadingDock::Truck = get run.dock.trucks[k.usize()] else zeroed
                if LoadingDock::here(run, &truck, k):
                    add(&items, &count, view, LoadingDock::bed(&truck), TRUCK, k)
            add(&items, &count, view, LoadingDock::fork(run), PLAYER, 0)
            other: LoadingDock::ForkPose = LoadingDock::other_fork(run)
            if run.dock.level.busy:
                add(&items, &count, view, RoomsView::vec(other.x, 0.5, other.z), OTHER, 0)
            for n in 0..<count |items, list, view, run, other|:
                item: Item = items[n.usize()]
                if item.kind == SLOT:
                    shelf_slot(list, view, run, item.index)
                elif item.kind == TRUCK:
                    truck_body(list, view, run, item.index)
                elif item.kind == PLAYER:
                    pose: LoadingDock::ForkPose = LoadingDock::ForkPose{x: run.x, z: run.z, heading: run.heading}
                    forklift(list, view, pose, 0xf08c28ff, &run.carried, run.carried_count)
                else:
                    forklift(list, view, other, 0x828c9cff, &run.carried, 0)

    def camera_label(camera: i64) -> sview:
        return "CAM 1" if camera == 0
        return "CAM 2" if camera == 1
        return "CAM 3" if camera == 2
        return "OVERHEAD" if camera == 3
        return "BEHIND THE SHELF"

    def order_board(list: mutable Display::DisplayList&, run: LoadingDock::Run&):
        can Memory.Allocate, Abort.Panic:
            waiting: mutable i64[3] = zeroed
            count: mutable i64 = 0
            sent: mutable i64 = 0
            for k in 0..<run.dock.level.trucks |waiting, count, sent, run|:
                truck: LoadingDock::Truck = get run.dock.trucks[k.usize()] else zeroed
                if LoadingDock::here(run, &truck, k):
                    waiting[count.usize()] <- k
                    count <- count + 1
                if run.cargo[k.usize()].sent:
                    sent <- sent + 1
            rows: i64 = count if count > 0 else 1
            height: f64 = (20 + 24 * rows).f64()
            rect(list, 20.0, 628.0 - height, 960.0, height, 0x10121ce1)
            if run.drag != LoadingDock::NO_DRAG:
                mark(list, run.drag_kind, run.hand.x, run.hand.y)
            for row in 0..<count |waiting, list, run|:
                k: i64 = waiting[row.usize()]
                truck: LoadingDock::Truck = get run.dock.trucks[k.usize()] else zeroed
                ready: bool = LoadingDock::complete(run, &truck, k)
                line: mutable dstr = []
                dstr_append_dstr(&line, truck.text)
                if ready:
                    dstr_append_cstr(&line, "   (ready: send it)")
                SceneHand::word(list, bytes_view(line), 500.0, 606.0 - 24.0 * row.f64(), 15.0,
                    0x8cf0a0ff if ready else 0xffffffff, true)
            SceneHand::word(list, camera_label(run.camera), 80.0, 30.0, 11.0, 0xffffffc8, true)
            counter: mutable dstr = []
            dstr_append_cstr(&counter, "sent ")
            dstr_append_i64(&counter, sent)
            dstr_append_cstr(&counter, " of ")
            dstr_append_i64(&counter, run.dock.level.trucks)
            SceneHand::word(list, bytes_view(counter), 920.0, 30.0, 11.0, 0xffffffc8)

    def warehouse(list: mutable Display::DisplayList&, run: LoadingDock::Run&):
        can Memory.Allocate, Abort.Panic:
            SceneHand::card(list, 0x1e2228ff)
            view: HandView::Lens = LoadingDock::view(run)
            quad(list, see(&view, -11.5, 0.0, -9.0), see(&view, 11.5, 0.0, -9.0),
                see(&view, 11.5, 0.0, 9.0), see(&view, -11.5, 0.0, 9.0), 0x70747aff)
            for lane in 0..<4 |view, list|:
                x: f64 = -6.0 + 4.0 * lane.f64()
                SceneHand::line(list, see(&view, x, 0.01, -5.0), see(&view, x, 0.01, 5.0), 2.0, 0xeccc425a)
            figures(list, &view, run)
            SceneHand::progress(list, &run.hand, (run.dock.seconds - run.time) / run.dock.seconds)
            if run.drag != LoadingDock::NO_DRAG:
                rect(list, run.hand.x - 16.0, run.hand.y - 16.0, 32.0, 32.0, paint(run.drag_kind))
            order_board(list, run)

    def render(list: mutable Display::DisplayList&, session: LoadingDockGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Loading Dock", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Arrows / WASD: drive   Drag: crates, shelf to forklift to truck   Click a lamp: send the truck   Esc: menu",
                456.0, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            status: mutable dstr = []
            if session.phase == LoadingDockGame::READY:
                dstr_append_cstr(&status, "Could not deal a dock. Press Space or click to retry." if session.deal_failed else "Press Space or click to start")
            elif session.phase == LoadingDockGame::DONE:
                dstr_append_i64(&status, session.passed)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best)
            elif session.phase == LoadingDockGame::JUDGED:
                status <- LoadingDock::result_text(&session.run)
            else:
                dstr_append_cstr(&status, "Load each truck with its order, then send it")
            Display::draw_text(list, bytes_view(status), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if session.phase >= LoadingDockGame::JUDGED and session.run.result != LoadingDock::PENDING:
                verdict: dstr = LoadingDock::result_text(&session.run)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.run.result == LoadingDock::SUCCESS,
                    bytes_view(verdict), 60.0, 16.0)
            return if session.phase == LoadingDockGame::READY or session.phase == LoadingDockGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.total)
            dstr_append_cstr(&facts, "   carrying ")
            dstr_append_i64(&facts, session.run.carried_count)
            dstr_append_cstr(&facts, " of 2")
            Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            warehouse(list, &session.run)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: LoadingDock::Grade = LoadingDock::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.trucks)
            dstr_append_cstr(out, " trucks, up to ")
            dstr_append_i64(out, level.most)
            dstr_append_cstr(out, " crates each.")
            if level.cut > 0.0:
                dstr_append_cstr(out, "  The camera cuts.")
            if level.tags:
                dstr_append_cstr(out, "  Marked crates.")
            if level.busy:
                dstr_append_cstr(out, "  A busy floor.")
