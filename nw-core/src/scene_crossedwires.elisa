# The Crossed Wires screen: game state in, display list out.
#
# Port of neural_workshop/ui/crossedwires.py -- the drawing, not the thinking.
#
# A square floor, a ring for the target, a disc for the marker, and a bar under
# the board for the presses left.
#
# What is NOT drawn is the point of the task. The wiring -- which key moves the
# marker which way, and how that drifts -- is kept on the Bout behind the Bench
# and never reaches the screen. This function is handed only what a player may
# see: two spots, two counters and a budget. That is not a convenience; it is
# the reason a scene can be a pure function here at all.
#
# The budget bar is the one thing this task draws low down, and the reference's
# own note says its reddish purple misses being read as a verdict by 27 on the
# blue channel. That is close, and it is checked by tests/check_band.py rather
# than asserted -- so a shell that re-themes this must re-run that check.
#
# NOTE: needs elisacore_math, strings, geometry, display, scene_verdict and
# tasks/crossedwires included by the driver.

module SceneCrossedWires:

    const PHASE_READY: i64 = 0
    const PHASE_PLAYING: i64 = 1
    const PHASE_SCORED: i64 = 2

    def color_marker() -> u32:
        return Display::rgba(204, 121, 167, 255)

    def color_target() -> u32:
        return Display::rgba(0, 158, 115, 255)

    def color_grid() -> u32:
        return Display::rgba(128, 128, 128, 255)

    def grade_name(rung: i64) -> cstr:
        can Abort.Panic:
            step: mutable i64 = rung - 1
            step <- 0 if step < 0
            step <- CrossedWires::GRADE_COUNT - 1 if step > CrossedWires::GRADE_COUNT - 1
            return "as marked" if step == 0
            return "a quarter turn" if step == 1
            return "through a mirror" if step == 2
            return "crossed" if step == 3
            return "crossed tighter" if step == 4
            return "eight ways" if step == 5
            return "eight crossed" if step == 6
            return "eight tighter" if step == 7
            return "the slow drift" if step == 8
            return "drifting" if step == 9
            return "inhuman" if step == 10
            return "superhuman"

    struct Paint:
        ink: mutable u32
        paper: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> Paint:
        back: i64 = 0 if black_background else 255
        fore: i64 = 255 - back
        return Paint{ink: Display::rgba(fore, fore, fore, 255),
                     paper: Display::rgba(back, back, back, 255),
                     width: width, height: height, sx: sx, sy: sy}

    def put_rect(list: mutable Display::DisplayList&, paint: Paint&, x: f64,
                 y: f64, width: f64, height: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, x / paint.sx, y / paint.sy,
                               width / paint.sx, height / paint.sy, color)

    def put_line(list: mutable Display::DisplayList&, paint: Paint&, x1: f64,
                 y1: f64, x2: f64, y2: f64, thick: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_line(list, x1 / paint.sx, y1 / paint.sy,
                               x2 / paint.sx, y2 / paint.sy,
                               thick / paint.sy, color)

    def put_circle(list: mutable Display::DisplayList&, paint: Paint&, x: f64,
                   y: f64, radius: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_circle(list, x / paint.sx, y / paint.sy,
                                 radius / paint.sy, color)

    def put_text(list: mutable Display::DisplayList&, paint: Paint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    struct Floor:
        left: mutable f64
        bottom: mutable f64
        side: mutable f64

    def board_of(out: mutable Floor&, width: f64, height: f64, across: i64,
                 down: i64):
        can Abort.Panic:
            top: f64 = Geometry::from_top_edge(height, 100.0).f64()
            bottom: f64 = Geometry::from_bottom_edge(height, 78.0).f64()
            tall: f64 = (top - bottom) / down.f64()
            wide: f64 = width * 0.8 / across.f64()
            side: mutable f64 = tall if tall < wide else wide
            side <- 4.0 if side < 4.0
            out.left <- Geometry::width_center(width).f64() - side * across.f64() / 2.0
            out.bottom <- bottom + ((top - bottom) - side * down.f64()) / 2.0
            out.side <- side

    def render(list: mutable Display::DisplayList&, paint: Paint&, rung: i64,
               phase: i64, show_grid: bool, at_x: i64, at_y: i64, goal_x: i64,
               goal_y: i64, goal_at: i64, goals_n: i64, presses_left: i64,
               budget: i64, trial: i64, total_trials: i64, message: sview,
               verdict: i64, verdict_text: sview):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()
            put_text(list, paint, sview("Crossed Wires", 0, -1), middle,
                     Geometry::from_top_edge(paint.height, 36.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            status: mutable dstr = []
            dstr_append_sview(&status, message)
            if phase == PHASE_PLAYING:
                dstr_append_cstr(&status, "     round ")
                dstr_append_i64(&status, trial)
                dstr_append_cstr(&status, "/")
                dstr_append_i64(&status, total_trials)
                dstr_append_cstr(&status, "   target ")
                # `min(goal_at + 1, len(goals))` -- the counter stops at the
                # last target rather than running past it when the round ends.
                shown: i64 = goal_at + 1 if goal_at + 1 < goals_n else goals_n
                dstr_append_i64(&status, shown)
                dstr_append_cstr(&status, "/")
                dstr_append_i64(&status, goals_n)
                dstr_append_cstr(&status, "   ")
                dstr_append_i64(&status, presses_left)
                dstr_append_cstr(&status, " presses left")
            put_text(list, paint, bytes_view(status), middle,
                     Geometry::from_top_edge(paint.height, 70.0).f64(),
                     Geometry::calc_fontsize(paint.height, 14.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            put_text(list, paint,
                     sview("Esc: task menu     Space: start     O: options", 0, -1),
                     middle, Geometry::from_bottom_edge(paint.height, 26.0).f64(),
                     Geometry::calc_fontsize(paint.height, 12.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            if verdict >= 0:
                SceneVerdict::put(list, paint.width, paint.height, paint.sx,
                                  paint.sy, verdict == 1, verdict_text,
                                  60.0, 16.0)

            return if phase != PHASE_PLAYING and phase != PHASE_SCORED
            grade: CrossedWires::Grade = CrossedWires::grade_at(rung)
            area: mutable Floor = Floor{left: 0.0, bottom: 0.0, side: 0.0}
            board_of(&area, paint.width, paint.height, grade.across, grade.down)
            side: f64 = area.side
            board_w: f64 = side * grade.across.f64()
            board_h: f64 = side * grade.down.f64()

            # The floor: ink with the background punched out.
            raw_thick: f64 = side * 0.06
            thick: f64 = raw_thick if raw_thick > 1.0 else 1.0
            put_rect(list, paint, area.left, area.bottom, board_w, board_h, paint.ink)
            put_rect(list, paint, area.left + thick, area.bottom + thick,
                     board_w - thick * 2.0, board_h - thick * 2.0, paint.paper)
            if show_grid:
                for column in 1..<grade.across |list, paint, area, side, board_h|:
                    put_line(list, paint, area.left + column.f64() * side, area.bottom,
                             area.left + column.f64() * side, area.bottom + board_h,
                             1.0, color_grid())
                for row in 1..<grade.down |list, paint, area, side, board_w|:
                    put_line(list, paint, area.left, area.bottom + row.f64() * side,
                             area.left + board_w, area.bottom + row.f64() * side,
                             1.0, color_grid())

            # The target: a ring, so the marker on top of it still reads.
            goal_cx: f64 = area.left + goal_x.f64() * side + side / 2.0
            goal_cy: f64 = area.bottom + goal_y.f64() * side + side / 2.0
            put_circle(list, paint, goal_cx, goal_cy, side * 0.46, color_target())
            put_circle(list, paint, goal_cx, goal_cy, side * 0.30, paint.paper)

            put_circle(list, paint,
                       area.left + at_x.f64() * side + side / 2.0,
                       area.bottom + at_y.f64() * side + side / 2.0,
                       side * 0.28, color_marker())

            # What is left, as a length as well as a number: the one quantity a
            # player has to act on should not have to be read out of a glyph.
            raw_bar: f64 = side * 0.3
            bar_h: f64 = raw_bar if raw_bar > 4.0 else 4.0
            foot: f64 = area.bottom - bar_h * 2.2
            put_rect(list, paint, area.left, foot, board_w, bar_h, color_grid())
            floor_budget: i64 = budget if budget > 1 else 1
            share: f64 = presses_left.f64() / floor_budget.f64()
            if share > 0.0:
                put_rect(list, paint, area.left, foot, board_w * share, bar_h,
                         color_marker())
