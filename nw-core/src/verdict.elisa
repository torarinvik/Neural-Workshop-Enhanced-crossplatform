# Where the agent boundary reads a verdict out of the frame.
#
# Port of the geometry half of neural_workshop/ui/verdict.py
# (GPL-2.0-or-later). The label itself is pyglet's; what a task's LAYOUT needs
# is only this: where the band starts, and how to stay out of it.
#
# The reference reads the live framebuffer height; nothing here can reach a
# window, so both functions take the height they are scaling against.

module Verdict:

    # The reader looks at rows from three quarters of the way down to the
    # bottom edge, so anything painted there is in the band whatever the
    # window size.
    const BAND_TOP: f64 = 0.75

    const CLEARANCE: i64 = 8

    # The first image row the boundary's reader scans. Row 0 is the TOP of the
    # captured frame, which is what the capture hands back.
    def band_first_row(height: f64) -> i64:
        can Abort.Panic:
            return (height * BAND_TOP).i64()

    # Hold `y` clear of the strip the agent boundary reads.
    #
    # On a window too short to have a playfield at all this still returns the
    # band's ceiling, so the task is laid out badly rather than laid out INTO
    # the band: a cramped screen is a nuisance, a scalar read off the scenery
    # is a wrong result.
    def above_the_band(height: f64, y: f64) -> i64:
        can Abort.Panic:
            ceiling: i64 = height.i64() - band_first_row(height) + CLEARANCE
            wanted: i64 = y.i64()
            return ceiling if ceiling > wanted else wanted
