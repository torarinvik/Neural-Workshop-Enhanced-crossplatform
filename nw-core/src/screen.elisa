# What is on screen right now: the top-level draw dispatch.
#
# Port of `on_draw` in neural_workshop/events.py. Every scene module in this
# port answers "where does this piece go"; not one of them answers "is this
# piece on screen at all", and until now nothing did -- each of the forty-nine
# render entry points was reached only by its own sweep. This is that missing
# answer, and it is the whole of it: five branches over four flags.
#
# The reference draws WIDGETS, not a frame. Its `state.batch` holds the board,
# the HUD, the readouts and the trial UI all at once, and what makes a piece
# appear or vanish is usually its own `visible` flag rather than this dispatch.
# So what is ported here is exactly what `on_draw` itself decides -- which of
# the four top-level surfaces is submitted, and what is drawn over it -- and
# not what any of them contains. The contents already have suites; this says
# which of those suites' output reaches the screen.
#
# A LAYER is one such surface. They come out in the order the reference draws
# them, which is also back-to-front: the input labels are drawn last and so sit
# over everything, on every branch, including the title screen.
#
# One thing worth naming. `mode.draw_graph`, `mode.saccadic` and
# `mode.title_screen` are checked in that order and are mutually exclusive HERE
# but not in the Mode struct -- nothing stops two being true at once, and if
# they are, the graph wins. Reproduced rather than tidied: a shell that
# normalised these into one enum would be deciding something the game does not.
#
# NOTE: needs gamemode.elisa (Mode) included by the driver.

# The surfaces `on_draw` can submit, numbered in the order it submits them.
const LAYER_GRAPH: i64 = 1
const LAYER_SACCADIC: i64 = 2
const LAYER_TITLE_SPLASH: i64 = 3
const LAYER_TITLE_MESSAGE: i64 = 4
const LAYER_TITLE_KEYS: i64 = 5
const LAYER_BATCH: i64 = 6
const LAYER_BRAIN_ICON: i64 = 7
const LAYER_LOGO_UPPER: i64 = 8
const LAYER_LOGO_LOWER: i64 = 9
const LAYER_INPUT_LABEL: i64 = 10

# What the dispatch reads that is not on the Mode: the build's clinical flag,
# and how many feedback labels the current mode has. Both are settled long
# before a frame is drawn -- CLINICAL_MODE is a build constant and the labels
# are rebuilt on mode change -- so they arrive as arguments rather than being
# recomputed per frame, which is also what the reference does.
struct ScreenState:
    clinical_mode: mutable bool
    input_label_count: mutable i64

def screen_state(clinical_mode: bool, input_label_count: i64) -> ScreenState:
    return ScreenState{clinical_mode: clinical_mode,
                       input_label_count: input_label_count}

# The frame's layers, back to front. One entry per `.draw()` the reference
# makes, so an input label appears once per label rather than once as a group:
# they are separate draws over separate widgets, and a shell that collapsed
# them would lose the count.
def put_layers(out: mutable darray[i64]&, game: Mode&, screen: ScreenState&):
    can Memory.Allocate, Abort.Panic:
        if game.draw_graph:
            out.push(LAYER_GRAPH)
        elif game.saccadic:
            out.push(LAYER_SACCADIC)
        elif game.title_screen:
            # The splash is a sprite and the two labels are text, but all three
            # are drawn one at a time and outside the batch, so all three are
            # layers of their own.
            out.push(LAYER_TITLE_SPLASH)
            out.push(LAYER_TITLE_MESSAGE)
            out.push(LAYER_TITLE_KEYS)
        else:
            out.push(LAYER_BATCH)
            # The logo is the idle screen's, not the session's: it goes as soon
            # as a session starts, and never appears at all in a clinical
            # build. `started` and not `session_done` -- a finished session is
            # still started, and the logo stays off.
            if not game.started and not screen.clinical_mode:
                out.push(LAYER_BRAIN_ICON)
                out.push(LAYER_LOGO_UPPER)
                out.push(LAYER_LOGO_LOWER)

        for _ in 0..<screen.input_label_count:
            out.push(LAYER_INPUT_LABEL)

def frame_layers(game: Mode&, screen: ScreenState&) -> darray[i64]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[i64] = []
        put_layers(&out, game, screen)
        return out

# Whether the batch -- the board, the HUD, the readouts, the trial UI -- is on
# screen at all. The three overlay branches replace it rather than cover it.
def batch_on_screen(game: Mode&) -> bool:
    return not (game.draw_graph or game.saccadic or game.title_screen)
