include "tasks/hidden_rule_game.elisa"
include "display.elisa"
include "strings.elisa"
include "scene_verdict.elisa"

module SceneHiddenRule:
    const LEFT: f64 = 36.48
    const BOTTOM: f64 = 179.0
    const HEIGHT: f64 = 389.0
    const WIDTH: f64 = 839.04
    const BUILDER: f64 = WIDTH * 0.42
    const NOTEBOOK: f64 = LEFT + WIDTH * 0.45
    const SWATCH: i64 = 16

    struct Rect:
        x: f64
        y: f64
        w: f64
        h: f64

    def property_name(feature: i64) -> cstr:
        return "colour" if feature == 0
        return "shape" if feature == 1
        return "size" if feature == 2
        return "count" if feature == 3
        return "fill" if feature == 4
        return "bar"

    def value_name(feature: i64, value: i64) -> cstr:
        if feature == 0:
            return "red" if value == 0 else ("blue" if value == 1 else ("green" if value == 2 else "gold"))
        if feature == 1:
            return "circle" if value == 0 else ("square" if value == 1 else ("triangle" if value == 2 else "diamond"))
        if feature == 2:
            return "small" if value == 0 else "large"
        if feature == 3:
            return "one" if value == 0 else ("two" if value == 1 else "three")
        if feature == 4:
            return "solid" if value == 0 else "hollow"
        return "no bar" if value == 0 else "barred"

    def minimum(a: f64, b: f64) -> f64:
        return a if a < b else b

    def blank(dark: bool) -> u32:
        return Display::rgba(46, 50, 58, 255) if dark else Display::rgba(232, 235, 240, 255)

    def reading(dark: bool, lit: bool) -> u32:
        return Display::rgba(252, 226, 120, 255) if lit
        return Display::rgba(70, 74, 82, 255) if dark else Display::rgba(176, 180, 188, 255)

    def text(list: mutable Display::DisplayList&, words: sview, x: f64, y: f64, size: f64, ink: u32,
             anchor: u32 = Display::ANCHOR_CENTER_CENTER, bold: bool = false):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, words, x, y, size, ink, anchor, bold)

    def card(list: mutable Display::DisplayList&, box: Rect&, back: u32, border: u32 = 0.u32()):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, box.x, box.y, box.w, box.h, back)
            if border != 0.u32():
                Display::draw_box(list, box.x, box.y, box.w, box.h, border, 3.0)

    def button(list: mutable Display::DisplayList&, box: Rect&, label: sview, back: u32, ink: u32):
        can Memory.Allocate, Abort.Panic:
            card(list, box, back, ink)
            text(list, label, box.x + box.w / 2.0, box.y + box.h / 2.0, box.h * 0.3, ink, Display::ANCHOR_CENTER_CENTER, true)

    def shape(list: mutable Display::DisplayList&, kind: i64, x: f64, y: f64, radius: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            if kind == 0:
                Display::draw_circle(list, x, y, radius, color)
            elif kind == 1:
                side: f64 = radius * 1.7
                Display::draw_rect(list, x - side / 2.0, y - side / 2.0, side, side, color)
            elif kind == 2:
                Display::draw_triangle(list, x - radius, y - radius * 0.8, x + radius, y - radius * 0.8, x, y + radius, color)
            else:
                reach: f64 = radius * 1.1
                Display::draw_triangle(list, x - reach, y, x + reach, y, x, y + reach, color)
                Display::draw_triangle(list, x - reach, y, x + reach, y, x, y - reach, color)

    def object_value(level: HiddenRule::Grade&, item: i64, feature: i64) -> i64:
        can Abort.Panic:
            if feature >= level.features:
                return 1 if feature == 2 else 0
            return HiddenRule::feature_value(level, item, feature)

    def object(list: mutable Display::DisplayList&, level: HiddenRule::Grade&, item: i64, box: Rect&, back: u32, ink: u32):
        can Memory.Allocate, Abort.Panic:
            color_index: i64 = object_value(level, item, 0)
            color: u32 = Display::rgba(214, 64, 58, 255) if color_index == 0 else (Display::rgba(52, 110, 220, 255) if color_index == 1 else (Display::rgba(54, 160, 80, 255) if color_index == 2 else Display::rgba(226, 170, 30, 255)))
            kind: i64 = object_value(level, item, 1)
            radius: f64 = box.w * (0.16 if object_value(level, item, 2) != 0 else 0.09)
            copies: i64 = object_value(level, item, 3) + 1
            hollow: bool = object_value(level, item, 4) != 0
            for index in 0..<copies |index, list, box, kind, radius, copies, hollow, color, back|:
                x: f64 = box.x + box.w / 2.0 + (index.f64() - (copies - 1).f64() / 2.0) * box.w * 0.3
                y: f64 = box.y + box.h / 2.0 + box.w * 0.04
                shape(list, kind, x, y, radius, color)
                if hollow:
                    shape(list, kind, x, y, radius * 0.5, back)
            if object_value(level, item, 5) != 0:
                Display::draw_rect(list, box.x + box.w * 0.14, box.y + box.h / 2.0 - box.w * 0.34,
                    box.w * 0.72, box.w * 0.05, ink)

    def builder_row(features: i64) -> f64:
        return HEIGHT / (features + 2).f64()

    def swatch(features: i64, feature: i64, value: i64) -> Rect:
        row: f64 = builder_row(features)
        span: f64 = minimum(row * 0.9, BUILDER * 0.16)
        return Rect{x: LEFT + BUILDER * 0.22 + value.f64() * span * 1.1,
            y: BOTTOM + HEIGHT - (feature + 1).f64() * row + (row - span) / 2.0, w: span, h: span}

    def builder_preview(features: i64) -> Rect:
        row: f64 = builder_row(features)
        span: f64 = minimum(row * 1.8, BUILDER * 0.3)
        return Rect{x: LEFT + BUILDER * 0.22, y: BOTTOM + (row * 2.0 - span) / 2.0, w: span, h: span}

    def builder_button(features: i64, testing: bool) -> Rect:
        box: Rect = builder_preview(features)
        height: f64 = box.h * 0.36
        return Rect{x: box.x + box.w + BUILDER * 0.05, y: box.y + (box.h - height if testing else 0.0),
            w: BUILDER * 0.22, h: height}

    def exam_button(lit: bool) -> Rect:
        width: f64 = BUILDER * 0.36
        gap: f64 = BUILDER * 0.03
        return Rect{x: LEFT + BUILDER / 2.0 + (-width - gap if lit else gap),
            y: BOTTOM + HEIGHT * 0.08, w: width, h: HEIGHT * 0.14}

    def contains(box: Rect&, x: f64, y: f64) -> bool:
        return x >= box.x and x <= box.x + box.w and y >= box.y and y <= box.y + box.h

    def hit(run: HiddenRuleGame::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            if run.phase == HiddenRuleGame::TESTING:
                for feature in 0..<run.level.features |feature, run, x, y|:
                    for value in 0..<run.level.values[feature.usize()] |value, feature, run, x, y|:
                        box: Rect = swatch(run.level.features, feature, value)
                        return SWATCH + feature * 4 + value if contains(&box, x, y)
                test_box: Rect = builder_button(run.level.features, true)
                exam_box: Rect = builder_button(run.level.features, false)
                return HiddenRuleGame::TEST if contains(&test_box, x, y)
                return HiddenRuleGame::EXAM if contains(&exam_box, x, y)
            elif run.phase == HiddenRuleGame::EXAMINING:
                lit: Rect = exam_button(true)
                dark: Rect = exam_button(false)
                return HiddenRuleGame::LIT if contains(&lit, x, y)
                return HiddenRuleGame::DARK if contains(&dark, x, y)
            return -1

    def click(run: mutable HiddenRuleGame::Run&, x: f64, y: f64, now_ms: i64) -> bool:
        can Abort.Panic:
            port: i64 = hit(run, x, y)
            if port >= SWATCH:
                encoded: i64 = port - SWATCH
                return HiddenRuleGame::choose(run, encoded / 4, encoded % 4)
            return HiddenRuleGame::steer(run, port, now_ms)

    def builder(list: mutable Display::DisplayList&, run: HiddenRuleGame::Run&, back: u32, ink: u32):
        can Memory.Allocate, Abort.Panic:
            item: i64 = HiddenRuleGame::item_index(run)
            stride: mutable i64 = run.level.items
            for feature in 0..<run.level.features |feature, list, run, stride, item, back, ink|:
                count: i64 = run.level.values[feature.usize()]
                current: i64 = run.item[feature.usize()]
                stride <- stride / count
                first: Rect = swatch(run.level.features, feature, 0)
                text(list, sview(property_name(feature), 0, -1), first.x - 8.0, first.y + first.h / 2.0,
                    first.h * 0.2, ink, Display::ANCHOR_RIGHT_CENTER)
                for value in 0..<count |value, feature, list, run, stride, item, current, back, ink|:
                    box: Rect = swatch(run.level.features, feature, value)
                    card(list, &box, back, Display::rgba(40, 90, 220, 255) if current == value else 0.u32())
                    object(list, &run.level, item + (value - current) * stride, &box, back, ink)
            preview: Rect = builder_preview(run.level.features)
            card(list, &preview, back, ink)
            object(list, &run.level, item, &preview, back, ink)
            test_box: Rect = builder_button(run.level.features, true)
            exam_box: Rect = builder_button(run.level.features, false)
            button(list, &test_box, "Test (T)", back, ink)
            button(list, &exam_box, "Exam (E)", back, ink)

    def notebook(list: mutable Display::DisplayList&, run: HiddenRuleGame::Run&, dark: bool, ink: u32):
        can Memory.Allocate, Abort.Panic:
            span: f64 = minimum(WIDTH * 0.55 / 10.0, HEIGHT * 0.86 / 5.0)
            top: f64 = BOTTOM + HEIGHT
            text(list, "notebook   (yellow: lit   grey: dark)", NOTEBOOK, top - span * 0.25, span * 0.18,
                ink, Display::ANCHOR_LEFT_CENTER)
            for slot in 0..<(run.round.test_count + 2) |slot, list, run, span, top, dark, ink|:
                x: f64 = NOTEBOOK + (slot % 10).f64() * span + span * 0.05
                y: f64 = top - span * (1.5 + (slot / 10).f64())
                box: Rect = Rect{x: x, y: y, w: span * 0.9, h: span * 0.9}
                item: i64 = run.dealt.seeds[slot.usize()] if slot < 2 else run.round.tests[(slot - 2).usize()]
                lit: bool = slot == 0 if slot < 2 else run.round.readings[(slot - 2).usize()]
                back: u32 = reading(dark, lit)
                card(list, &box, back)
                object(list, &run.level, item, &box, back, ink)

    def exam(list: mutable Display::DisplayList&, run: HiddenRuleGame::Run&, dark: bool, ink: u32):
        can Memory.Allocate, Abort.Panic:
            span: f64 = minimum(HEIGHT * 0.5, BUILDER * 0.6)
            box: Rect = Rect{x: LEFT + (BUILDER - span) / 2.0, y: BOTTOM + HEIGHT * 0.32, w: span, h: span}
            label: mutable dstr = []
            dstr_append_cstr(&label, "question ")
            dstr_append_i64(&label, run.round.answer_count + 1)
            dstr_append_cstr(&label, " of ")
            dstr_append_i64(&label, run.level.exam)
            text(list, bytes_view(label), LEFT + BUILDER / 2.0, box.y + span + HEIGHT * 0.06, 13.0, ink)
            back: u32 = blank(dark)
            card(list, &box, back, ink)
            object(list, &run.level, HiddenRule::question(&run.round, &run.dealt), &box, back, ink)
            yes: Rect = exam_button(true)
            no: Rect = exam_button(false)
            button(list, &yes, "Lit (Y)", reading(dark, true), Display::rgba(20, 24, 32, 255))
            button(list, &no, "Dark (N)", reading(dark, false), ink)

    def atom(label: mutable dstr&, encoded: i64):
        can Memory.Allocate, Abort.Panic:
            local: i64 = encoded % HiddenRule::ATOM_STRIDE
            if local >= 4:
                dstr_append_cstr(label, "not ")
            dstr_append_cstr(label, value_name(encoded / HiddenRule::ATOM_STRIDE, local % 4))

    def reveal(label: mutable dstr&, run: HiddenRuleGame::Run&):
        can Memory.Allocate, Abort.Panic:
            form: i64 = run.form
            dstr_append_cstr(label, "The rule was: ")
            if form == 6:
                dstr_append_cstr(label, "at least two of ")
            elif form >= 7:
                dstr_append_cstr(label, "(")
            atom(label, run.atoms[0])
            return if form == 0
            dstr_append_cstr(label, " and " if form == 1 or form == 7 else (" or " if form <= 3 or form == 8 else ", "))
            atom(label, run.atoms[1])
            if form == 3:
                dstr_append_cstr(label, ", not both")
            return if form <= 3
            dstr_append_cstr(label, " and " if form == 4 else (" or " if form == 5 else (") or " if form == 7 else (") and " if form == 8 else ", "))))
            atom(label, run.atoms[2])

    def points(label: mutable dstr&, value: f64):
        can Memory.Allocate, Abort.Panic:
            if value == value.i64().f64():
                dstr_append_i64(label, value.i64())
            else:
                dstr_append_fixed(label, value, 1)

    def status(label: mutable dstr&, run: HiddenRuleGame::Run&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == HiddenRuleGame::READY:
                dstr_append_cstr(label, "Press Space to start")
            elif run.phase == HiddenRuleGame::TESTING:
                dstr_append_cstr(label, "Learn the rule for ")
                points(label, run.par)
                dstr_append_cstr(label, " or less")
            elif run.phase == HiddenRuleGame::EXAMINING:
                dstr_append_cstr(label, "Lit or dark? Nothing is said until the end")
            elif run.phase == HiddenRuleGame::JUDGED:
                dstr_append_i64(label, run.round.test_count)
                dstr_append_cstr(label, " tests, ")
                dstr_append_i64(label, run.round.wrong)
                dstr_append_cstr(label, " wrong: cost ")
                dstr_append_i64(label, HiddenRule::cost(&run.round, &run.level))
                dstr_append_cstr(label, " against a par of ")
                points(label, run.par)
            else:
                dstr_append_i64(label, run.passed_count)
                dstr_append_cstr(label, " of ")
                dstr_append_i64(label, run.answered)
                dstr_append_cstr(label, " under par   highest rung passed ")
                dstr_append_i64(label, run.best_rung)

    def render(list: mutable Display::DisplayList&, run: HiddenRuleGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = Display::rgba(255, 255, 255, 255) if dark else Display::rgba(0, 0, 0, 255)
            text(list, "Hidden Rule", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            label: mutable dstr = []
            status(&label, run)
            text(list, bytes_view(label), 456.0, 614.0, 14.0, ink)
            idle: bool = run.phase == HiddenRuleGame::READY or run.phase == HiddenRuleGame::DONE
            footnote: sview = "Space: start   C: options   Esc: menu" if idle else "Click a swatch   T: test   E: exam   Y / N: lit or dark   Esc: menu"
            text(list, footnote, 456.0, 26.0, 12.0, ink)
            return if run.phase == HiddenRuleGame::READY or run.phase == HiddenRuleGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, run.level.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, run.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, run.trials)
            dstr_append_cstr(&facts, "  tests ")
            dstr_append_i64(&facts, run.round.test_count)
            dstr_append_cstr(&facts, " (cost 1 each, ")
            dstr_append_i64(&facts, HiddenRule::BUDGET - run.round.test_count)
            dstr_append_cstr(&facts, " left)  wrong answer ")
            dstr_append_i64(&facts, run.level.penalty)
            if run.level.noise > 0.0:
                dstr_append_cstr(&facts, "  lamp lies ")
                dstr_append_fixed(&facts, run.level.noise * 100.0, 0)
                dstr_append_cstr(&facts, "%")
            text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink)
            notebook(list, run, dark, ink)
            if run.phase == HiddenRuleGame::TESTING:
                builder(list, run, blank(dark), ink)
            elif run.phase == HiddenRuleGame::EXAMINING:
                exam(list, run, dark, ink)
            else:
                rule: mutable dstr = []
                reveal(&rule, run)
                text(list, bytes_view(rule), LEFT + BUILDER / 2.0, BOTTOM + HEIGHT / 2.0,
                    14.0, ink, Display::ANCHOR_CENTER_CENTER, true)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.passed, bytes_view(label), 60.0, 16.0)
