# The three small screens that are one shape apiece.
#
# Ports of neural_workshop/ui/message.py, ui/effects.py and ui/textinput.py --
# a modal notice, the saccadic exercise, and the one-line prompt.
#
# They are together because each is a handful of numbers and none of them
# needs a module of its own to say so.
#
# The NOTICE is the only label in the workshop drawn in the SERIF face rather
# than in FONTLIST. It is a full-window message dismissed by any key, and it
# wraps at four fifths of the window.
#
# The SACCADIC square is a fixed BLUE on both pages -- not the ink, not a
# workshop colour, and not the same blue as anything else. It is an eye
# exercise rather than a thing on a screen, and it jumps between the left and
# the right edge on a clock of its own.
#
# The PROMPT is drawn at a FIXED PIXEL SIZE and at fixed pixel coordinates:
# font size 10 and 12, a box 400 by 28, x at 250. Nothing about it scales with
# the window, which is why it is the one screen that looks wrong on a very
# large one. Reproduced rather than corrected -- it is what the screen does.
#
# NOTE: needs elisacore_math, strings, geometry and display included by the
# driver.

module SceneNotice:

    # A one-shot notice that takes over the window until dismissed.
    def put_message(list: mutable Display::DisplayList&, text: sview,
                    black_background: bool, width: f64, height: f64,
                    sx: f64, sy: f64):
        can Memory.Allocate, Abort.Panic:
            # COLOR_TEXT again, which is 240 grey on the dark page and not
            # white.
            ink: u32 = Display::rgba(240, 240, 240, 255) if black_background else Display::rgba(0, 0, 0, 255)
            Display::draw_text_weight(list, text,
                                      Geometry::width_center(width).f64() / sx,
                                      Geometry::height_center(height).f64() / sy,
                                      Geometry::calc_fontsize(height, 14.0) / sy,
                                      ink,
                                      Display::ANCHOR_CENTER_CENTER, false)

    # The saccadic square, at one edge or the other.
    def put_saccadic(list: mutable Display::DisplayList&, on_the_left: bool,
                     width: f64, height: f64, sx: f64, sy: f64):
        can Memory.Allocate, Abort.Panic:
            radius: f64 = Geometry::scale_to_height(height, 10.0).f64()
            y: f64 = Geometry::height_center(height).f64()
            x: f64 = radius if on_the_left else width - radius
            side: f64 = radius * 2.0
            Display::draw_rect(list, (x - radius) / sx, (y - radius) / sy,
                               side / sx, side / sy,
                               Display::rgba(0, 0, 255, 255))

    # The prompt's title, its box and what has been typed. `cursor_visible`
    # blinks on a clock of its own, and the caret is a SPACE when it is off --
    # so the line does not shorten and the text does not slide.
    def put_prompt(list: mutable Display::DisplayList&, title: sview,
                   typed: sview, cursor_at: i64, cursor_visible: bool,
                   black_background: bool, width: f64, height: f64,
                   sx: f64, sy: f64):
        can Memory.Allocate, Abort.Panic:
            fore: i64 = 255 * (1 if black_background else 0)
            x_input: f64 = 250.0
            y_input: f64 = height * 8.0 / 10.0 - 18.0
            Display::draw_text_weight(list, title, (width / 2.0).i64().f64() / sx,
                                      (y_input + 42.0) / sy, 10.0 / sy,
                                      Display::rgba(fore, fore, fore, 255),
                                      Display::ANCHOR_CENTER_CENTER, false)
            Display::draw_rect(list, x_input / sx, y_input / sy,
                               400.0 / sx, 28.0 / sy,
                               Display::rgba(200, 200, 200, 255))
            shown: mutable dstr = []
            span: i64 = sview_len(typed).i64()
            before: i64 = cursor_at if cursor_at < span else span
            at: mutable i64 = 0
            while at < before |shown, typed, before, at|:
                shown.push(sview_at(typed, at.usize()))
                at <- at + 1
            shown.push(95.u8() if cursor_visible else 32.u8())
            while at < span |shown, typed, span, at|:
                shown.push(sview_at(typed, at.usize()))
                at <- at + 1
            # Black at full alpha and NOT the page's ink: the box is a fixed
            # light grey, so the text on it is fixed too.
            Display::draw_text_weight(list, bytes_view(shown),
                                      (x_input + 4.0) / sx,
                                      (y_input + 14.0) / sy, 12.0 / sy,
                                      Display::rgba(255, 255, 255, 255),
                                      Display::ANCHOR_LEFT_CENTER, false)
