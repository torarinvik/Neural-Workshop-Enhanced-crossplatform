include "./tasks/escort_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./verdict.elisa"
include "./geometry.elisa"

module SceneEscort:
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const PI: f64 = 3.141592653589793

    struct Frame:
        x: f64
        y: f64
        size: f64
        height: f64

    struct Point:
        x: f64
        y: f64

    def frame() -> Frame:
        can Abort.Panic:
            bottom: f64 = Verdict::above_the_band(HEIGHT, Geometry::from_bottom_edge(HEIGHT, 58.0).f64()).f64()
            height: f64 = fmax(40.0, Geometry::from_top_edge(HEIGHT, 116.0).f64() - bottom)
            size: f64 = fmin(WIDTH * 0.94 / Escort::COLS.f64(), (height - height * 0.2) / Escort::ROWS.f64())
            return Frame{x: (WIDTH - Escort::COLS.f64() * size) / 2.0, y: bottom, size: size, height: height}

    def cell(area: Frame, c: f64, r: f64) -> Point:
        return Point{x: area.x + (c + 0.5) * area.size, y: area.y + (Escort::ROWS.f64() - 0.5 - r) * area.size}

    def place(area: Frame, tile: Escort::Cell) -> Point:
        return cell(area, tile.column.f64(), tile.row.f64())

    def lever_box(area: Frame, count: i64, k: i64) -> SceneHiddenRule::Rect:
        can Abort.Panic:
            s: f64 = area.size
            top: f64 = Escort::ROWS.f64() * s
            h: f64 = fmin(area.height - top, s * 3.2) - s * 0.5
            w: f64 = fmin(s * 3.4, Escort::COLS.f64() * s / count.f64() - s * 0.4)
            span: f64 = count.f64() * w + (count - 1).f64() * s * 0.4
            return SceneHiddenRule::Rect{x: area.x + (Escort::COLS.f64() * s - span) / 2.0 + k.f64() * (w + s * 0.4),
                y: area.y + top + s * 0.4, w: w, h: h}

    def device_point(area: Frame, temple: Escort::Temple&, device: Escort::Device) -> Point:
        can Abort.Panic:
            return place(area, temple.paths[device.walker.usize()].cells[device.at.usize()])

    def hit(session: EscortGame::Session&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return EscortGame::START if session.phase == EscortGame::READY or session.phase == EscortGame::DONE
            return -1 if session.phase != EscortGame::PLAYING
            temple: Escort::Temple& = &session.run.temple
            area: Frame = frame()
            for i in 0..<temple.level.levers |temple, area, x, y|:
                box: SceneHiddenRule::Rect = lever_box(area, temple.level.levers, i)
                if box.x <= x and x <= box.x + box.w and box.y <= y and y <= box.y + box.h:
                    return i
            r: f64 = 0.8 * area.size
            best: mutable f64 = r * r
            port: mutable i64 = -1
            for i in 0..<temple.count |temple, area, x, y, best, port|:
                d: Escort::Device = temple.devices[i.usize()]
                continue if d.lever < 0
                p: Point = device_point(area, temple, d)
                dx: f64 = p.x - x
                dy: f64 = p.y - y
                distance: f64 = dx * dx + dy * dy
                if distance < best:
                    best <- distance
                    port <- d.lever
            return port

    def lever_colour(i: i64) -> u32:
        can Abort.Panic:
            colours: u32[6] = [0xffc83cff, 0x40d6c8ff, 0xec5cc4ff, 0x60a0ffff, 0x9ce24eff, 0xff8840ff]
            return colours[i.usize()]

    def walker_colour(i: i64) -> u32:
        can Abort.Panic:
            colours: u32[3] = [0xffecaaff, 0xaaecffff, 0xffbae2ff]
            return colours[i.usize()]

    def text(list: mutable Display::DisplayList&, words: sview, x: f64, y: f64, size: f64, ink: u32, bold: bool = false):
        can Abort.Panic, Memory.Allocate:
            Display::draw_text_weight(list, words, x, y, size, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def number(list: mutable Display::DisplayList&, value: i64, x: f64, y: f64, size: f64, ink: u32):
        can Abort.Panic, Memory.Allocate:
            words: mutable dstr = []
            dstr_append_i64(&words, value)
            text(list, bytes_view(words), x, y, size, ink, true)

    def grid_index(column: i64, row: i64) -> usize:
        return (row * Escort::COLS + column).usize()

    def brickwork(list: mutable Display::DisplayList&, area: Frame, dark: bool):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            w: f64 = Escort::COLS.f64() * s
            h: f64 = Escort::ROWS.f64() * s
            panel: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: area.x - 8.0, y: area.y - 8.0, w: w + 16.0, h: h + 16.0}
            ScenePolish::shadow(list, &panel, 12.0, 4.0, dark)
            ScenePolish::rounded(list, &panel, 12.0, 0x2c2422ff)
            Display::draw_rect(list, area.x, area.y, w, h, 0x463a34ff)
            for row in 0..<(Escort::ROWS * 2) |list, area, s, w|:
                y: f64 = area.y + row.f64() * s / 2.0
                Display::draw_line(list, area.x, y, area.x + w, y, 1.0, 0x382e2aff)
                shift: f64 = (row % 2).f64() * s * 0.5
                for c in 0..<(Escort::COLS + 1) |list, area, s, y, w, shift|:
                    x: f64 = area.x + c.f64() * s + shift
                    if x < area.x + w:
                        Display::draw_line(list, x, y, x, y + s / 2.0, 1.0, 0x382e2aff)

    def corridors(list: mutable Display::DisplayList&, area: Frame, temple: Escort::Temple&):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            pits: mutable bool[Escort::COLS * Escort::ROWS] = zeroed
            for i in 0..<temple.count |temple, pits|:
                d: Escort::Device = temple.devices[i.usize()]
                if d.kind == Escort::BRIDGE:
                    tile: Escort::Cell = temple.paths[d.walker.usize()].cells[d.at.usize()]
                    pits[grid_index(tile.column, tile.row)] <- true
            draw: mutable MT19937 = zeroed
            mt_seed_int(&draw, (temple.count * 31 + temple.paths[0].count).u64())
            for w in 0..<temple.level.walkers |list, area, temple, draw, pits, s|:
                path: Escort::Path& = &temple.paths[w.usize()]
                tint: u32 = ScenePolish::mix_rgb(0xc4aa80ff, walker_colour(w), 0.12)
                for i in 0..<path.count |list, area, path, draw, pits, s, tint|:
                    tile: Escort::Cell = path.cells[i.usize()]
                    p: Point = place(area, tile)
                    x: f64 = p.x - s / 2.0
                    y: f64 = p.y - s / 2.0
                    if pits[grid_index(tile.column, tile.row)]:
                        Display::draw_rect(list, x, y, s, s, 0x100c12ff)
                        for layer in 0..<3 |list, x, y, s|:
                            offset: f64 = layer.f64() * s * 0.08
                            ink: u32 = ScenePolish::mix_rgb(0x100c12ff, 0x3c1e46ff, 0.3 - layer.f64() * 0.1)
                            Display::draw_rect(list, x + offset, y + offset, s - layer.f64() * s * 0.16, s - layer.f64() * s * 0.16, ink)
                        continue
                    ink: u32 = ScenePolish::mix_rgb(tint, 0x000000ff, py_uniform(&draw, 0.0, 0.12))
                    Display::draw_rect(list, x, y, s, s, ink)
                    Display::draw_box(list, x, y, s, s, ScenePolish::mix_rgb(ink, 0x000000ff, 0.18), 1.0)
                    if py_random(&draw) < 0.25:
                        Display::draw_line(list, p.x - s * 0.2, p.y + s * 0.1, p.x + s * 0.15, p.y - s * 0.15,
                            1.0, ScenePolish::mix_rgb(ink, 0x000000ff, 0.25))
                entrance: Point = place(area, path.cells[0])
                exit: Point = place(area, path.cells[(path.count - 1).usize()])
                ScenePolish::arc(list, entrance.x, entrance.y, s * 0.62, 0.0, PI, s * 0.14, 0x786e64ff)
                ScenePolish::arc(list, exit.x, exit.y, s * 0.62, 0.0, PI, s * 0.14, 0xfad678ff)
            for i in 0..<temple.count |list, area, temple, s|:
                d: Escort::Device = temple.devices[i.usize()]
                if d.kind == Escort::JET:
                    p: Point = device_point(area, temple, d)
                    Display::draw_circle(list, p.x, p.y, s * 0.3, 0x363238ff)
                    Display::draw_circle(list, p.x, p.y, s * 0.16, 0x181418ff)

    def torch(list: mutable Display::DisplayList&, p: Point, s: f64, t: f64, n: f64):
        can Abort.Panic, Memory.Allocate:
            flicker: f64 = 0.8 + 0.2 * sin(t * 11.0 + n * 2.3) * sin(t * 7.3 + n)
            ScenePolish::glow(list, p.x, p.y, s * 1.3 * flicker, 0xffaa46ff, 55)
            Display::draw_rect(list, p.x - s * 0.06, p.y - s * 0.3, s * 0.12, s * 0.32, 0x5a3e28ff)
            Display::draw_triangle(list, p.x - s * 0.13, p.y, p.x + s * 0.13, p.y,
                p.x + sin(t * 9.0 + n) * s * 0.05, p.y + s * 0.34 * flicker, 0xffbe46ff)

    def lights(list: mutable Display::DisplayList&, area: Frame, run: Escort::Run&):
        can Abort.Panic, Memory.Allocate:
            used: mutable bool[Escort::COLS * Escort::ROWS] = zeroed
            for w in 0..<run.temple.level.walkers |run, used|:
                path: Escort::Path& = &run.temple.paths[w.usize()]
                for i in 0..<path.count |path, used|:
                    tile: Escort::Cell = path.cells[i.usize()]
                    used[grid_index(tile.column, tile.row)] <- true
            torches: mutable i64 = 0
            for w in 0..<run.temple.level.walkers |list, area, run, used, torches|:
                path: Escort::Path& = &run.temple.paths[w.usize()]
                i: mutable i64 = 2
                while i < path.count |list, area, run, path, used, torches, i|:
                    tile: Escort::Cell = path.cells[i.usize()]
                    for side in 0..<2 |list, area, run, tile, used, torches|:
                        r: i64 = tile.row + (1 if side == 1 else -1)
                        continue if r < 0 or r >= Escort::ROWS or used[grid_index(tile.column, r)]
                        torch(list, cell(area, tile.column.f64(), r.f64()), area.size, run.elapsed, torches.f64())
                        torches <- torches + 1
                        break
                    i <- i + 5
                exit: Point = place(area, path.cells[(path.count - 1).usize()])
                through: bool = run.states[w.usize()] == Escort::ARRIVED
                ScenePolish::glow(list, exit.x, exit.y, area.size * (1.15 if through else 0.8),
                    0xffdc78ff if through else 0xc8aa6eff, 90 if through else 40)

    def jet(list: mutable Display::DisplayList&, p: Point, s: f64, t: f64, i: i64, device: Escort::Device):
        can Abort.Panic, Memory.Allocate:
            if Escort::jet_on(device, t):
                h: f64 = s * (1.4 + 0.25 * sin(t * 23.0 + i.f64()))
                ScenePolish::glow(list, p.x, p.y, s * 1.1, 0xff7828ff, 120)
                widths: f64[3] = [0.45, 0.32, 0.18]
                inks: u32[3] = [0xff5a1eff, 0xffaa28ff, 0xfff096ff]
                for j in 0..<3 |list, p, s, t, h, widths, inks|:
                    w: f64 = widths[j.usize()] * s
                    side: f64 = sin(t * 17.0 + j.f64() * 2.0) * s * 0.06
                    base: f64 = p.y - s * 0.2
                    Display::draw_triangle(list, p.x - w, base, p.x + w, base,
                        p.x + side, base + h * (1.0 - j.f64() * 0.2), inks[j.usize()])
            elif Escort::jet_next(device, t).next_on < Escort::WARN:
                for j in 0..<5 |list, p, s, t|:
                    angle: f64 = t * 9.0 + j.f64() * 1.3
                    r: f64 = s * (0.15 + 0.25 * fmod(t * 3.0 + j.f64() * 0.2, 1.0))
                    Display::draw_circle(list, p.x + cos(angle) * r, p.y + sin(angle) * r, fmax(1.5, s * 0.05), 0xffc850ff)
                Display::draw_circle(list, p.x, p.y, s * 0.12, 0xff8232ff)
            else:
                Display::draw_circle(list, p.x, p.y, s * 0.07, 0x5aa0ffff)

    def devices(list: mutable Display::DisplayList&, area: Frame, run: Escort::Run&):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            for i in 0..<run.temple.count |list, area, run, s|:
                d: Escort::Device = run.temple.devices[i.usize()]
                p: Point = device_point(area, &run.temple, d)
                progress: f64 = run.progress[i.usize()]
                if d.kind == Escort::BRIDGE:
                    span: f64 = s * progress
                    if span > 0.5:
                        for j in 0..<4 |list, p, s, span|:
                            Display::draw_rect(list, p.x - s / 2.0, p.y - s / 2.0 + j.f64() * s * 0.25 + 1.0,
                                span, s * 0.22, ScenePolish::mix_rgb(0x96683eff, 0x000000ff, 0.1 * (j % 2).f64()))
                    moving: bool = (progress > 0.0 and progress < 1.0) or run.targets[i.usize()] != (progress >= 1.0)
                    ink: u32 = 0x78ff96ff if progress >= 1.0 else (0xffaa3cff if moving else 0xff5046ff)
                    Display::draw_box(list, p.x - s / 2.0, p.y - s / 2.0, s, s, ink, fmax(2.0, s * 0.08))
                elif d.kind == Escort::DOOR:
                    lift: f64 = s * 0.85 * progress
                    for j in 0..<5 |list, p, s, lift|:
                        x: f64 = p.x - s * 0.4 + j.f64() * s * 0.2
                        Display::draw_rect(list, x - s * 0.035, p.y - s / 2.0 + lift, s * 0.07, fmax(1.0, s - lift), 0x8c92a0ff)
                    Display::draw_rect(list, p.x - s / 2.0, p.y + s / 2.0 - s * 0.12, s, s * 0.12, 0x525460ff)
                    if progress < 1.0:
                        Display::draw_rect(list, p.x - s * 0.45, p.y - s / 2.0 + lift + s * 0.04, s * 0.9, s * 0.08, 0x6e7480ff)
                else:
                    jet(list, p, s, run.elapsed, i, d)
                if d.lever >= 0:
                    x: f64 = p.x + s * 0.38
                    y: f64 = p.y + s * 0.38
                    Display::draw_circle(list, x, y, s * 0.24, 0x1e181aff)
                    Display::draw_circle(list, x, y, s * 0.19, lever_colour(d.lever))
                    number(list, d.lever + 1, x, y, fmax(7.0, s * 0.26), 0x141014ff)

    def oval(list: mutable Display::DisplayList&, x: f64, y: f64, rx: f64, ry: f64, ink: u32):
        can Abort.Panic, Memory.Allocate:
            Display::begin_polygon(list, 20, x + rx, y, ink)
            for i in 0..<20 |list, x, y, rx, ry|:
                angle: f64 = 2.0 * PI * i.f64() / 20.0
                Display::polygon_point(list, x + rx * cos(angle), y + ry * sin(angle))

    def walkers(list: mutable Display::DisplayList&, area: Frame, session: EscortGame::Session&):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            for w in 0..<session.run.temple.level.walkers |list, area, session, s|:
                hue: u32 = walker_colour(w)
                trail: EscortGame::Trail& = &session.trails[w.usize()]
                first: i64 = trail.count - EscortGame::TRAIL_SAMPLES if trail.count > EscortGame::TRAIL_SAMPLES else 0
                for i in first..<trail.count |list, area, first, trail, hue, s|:
                    tile: Escort::Position = trail.points[(i % EscortGame::TRAIL_SAMPLES).usize()]
                    p: Point = cell(area, tile.column, tile.row)
                    Display::draw_circle(list, p.x, p.y - s * 0.2, s * 0.06,
                        (hue & 0xffffff00.u32()) | (40 + 18 * (i - first)).u32())
                state: i64 = session.run.states[w.usize()]
                continue if state == Escort::FELL
                position: Escort::Position = Escort::where(&session.run, w)
                p: Point = cell(area, position.column, position.row)
                bob: f64 = sin(session.run.elapsed * 10.0 + w.f64()) * s * 0.04 if state == Escort::WALKING else 0.0
                ScenePolish::glow(list, p.x, p.y, s * 0.9, hue, 80)
                oval(list, p.x, p.y - s * 0.32, s * 0.24, s * 0.08, 0x140e0c78)
                body: u32 = 0xe65028ff if state == Escort::BURNED else hue
                box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: p.x - s * 0.22, y: p.y - s * 0.36 + bob, w: s * 0.44, h: s * 0.5}
                ScenePolish::rounded(list, &box, s * 0.1, ScenePolish::mix_rgb(body, 0x000000ff, 0.15))
                Display::draw_circle(list, p.x, p.y + s * 0.26 + bob, s * 0.19, body)
                Display::draw_circle(list, p.x + s * 0.24, p.y - s * 0.02 + bob, s * 0.08, 0xffe678ff)
                if state == Escort::WAITING:
                    Display::draw_rect(list, p.x - s * 0.11, p.y + s * 0.5, s * 0.06, s * 0.2, 0xffffffff)
                    Display::draw_rect(list, p.x + s * 0.05, p.y + s * 0.5, s * 0.06, s * 0.2, 0xffffffff)

    def levers(list: mutable Display::DisplayList&, area: Frame, session: EscortGame::Session&):
        can Abort.Panic, Memory.Allocate:
            count: i64 = session.run.temple.level.levers
            for k in 0..<count |list, area, session, count|:
                box: SceneHiddenRule::Rect = lever_box(area, count, k)
                ink: u32 = lever_colour(k)
                pulled: f64 = session.run.pulled[k.usize()]
                fresh: f64 = fmax(0.0, 1.0 - (session.run.elapsed - pulled) * 3.0) if pulled != 0.0 else 0.0
                face: u32 = ScenePolish::mix_rgb(0x342c2aff, ink, 0.18 + 0.4 * fresh)
                ScenePolish::card_face(list, &box, 10.0, face, ink, 0.u32(), false)
                x: f64 = box.x + box.w * 0.3
                y: f64 = box.y + box.h * 0.22
                Display::draw_rect(list, x - box.w * 0.16, y - box.h * 0.05, box.w * 0.32, box.h * 0.1, 0x1e1a1aff)
                angle: f64 = PI / 3.0 if session.flips[k.usize()] % 2 != 0 else 2.0 * PI / 3.0
                tx: f64 = x + cos(angle) * box.h * 0.55
                ty: f64 = y + sin(angle) * box.h * 0.55
                Display::draw_line(list, x, y, tx, ty, fmax(3.0, box.w * 0.06), 0xc8c8d2ff)
                Display::draw_circle(list, tx, ty, box.w * 0.08, ink)
                label_x: f64 = box.x + box.w * 0.76
                number(list, k + 1, label_x, box.y + box.h * 0.58, fmax(9.0, box.h * 0.32), ink)
                links: i64 = session.run.temple.levers[k.usize()].count
                for j in 0..<links |list, box, label_x, links, ink|:
                    x: f64 = label_x + (j.f64() - (links - 1).f64() / 2.0) * box.h * 0.2
                    Display::draw_circle(list, x, box.y + box.h * 0.2, box.h * 0.07, ink)

    def verdict(run: Escort::Run&, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            if run.result == Escort::CLEAR:
                dstr_append_cstr(out, "Everyone crossed in ")
                dstr_append_i64(out, py_round_half_even(run.elapsed))
                dstr_append_cstr(out, " s")
            elif run.result == Escort::PIT_LOSS:
                dstr_append_cstr(out, "A walker fell into a pit")
            elif run.result == Escort::FIRE_LOSS:
                dstr_append_cstr(out, "A walker walked into the flames")
            elif run.result == Escort::TIMEOUT:
                dstr_append_cstr(out, "Out of time")

    def render(list: mutable Display::DisplayList&, session: EscortGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            text(list, "Escort", 456.0, 648.0, 22.0, ink, true)
            text(list, "1-6 or click: pull a lever   Esc: menu", 456.0, 26.0, 12.0, ink)
            caption: mutable dstr = []
            verdict(&session.run, &caption)
            status: mutable dstr = []
            if session.phase == EscortGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == EscortGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == EscortGame::JUDGED:
                status <- caption
            else:
                dstr_append_cstr(&status, "Work the levers; bring every walker through")
            text(list, bytes_view(status), 456.0, 614.0, 14.0, ink)
            if session.phase == EscortGame::PLAYING or session.phase == EscortGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   ")
                dstr_append_i64(&facts, fmax(0.0, session.run.temple.seconds - session.run.elapsed).i64())
                dstr_append_cstr(&facts, " s left")
                text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink)
                area: Frame = frame()
                brickwork(list, area, dark)
                corridors(list, area, &session.run.temple)
                lights(list, area, &session.run)
                devices(list, area, &session.run)
                walkers(list, area, session)
                levers(list, area, session)
            if caption.count > 0:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, EscortGame::passed_verdict(session.verdict),
                    bytes_view(caption), 60.0, 16.0)

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: Escort::Grade = Escort::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.walkers)
            dstr_append_cstr(out, " walker(s), ")
            dstr_append_i64(out, level.levers)
            dstr_append_cstr(out, " lever(s).")
            dstr_append_cstr(out, "  Flame jets burn on their own clock.") if level.jets > 0
            dstr_append_cstr(out, "  Some levers work two devices.") if level.coupled
            dstr_append_cstr(out, "  Walkers change pace.") if level.wobble
