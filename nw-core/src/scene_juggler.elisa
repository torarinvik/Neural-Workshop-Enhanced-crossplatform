include "./tasks/juggler_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"

module SceneJuggler:
    const CX: f64 = 456.0
    const SCALE: f64 = 389.0 / (Juggler::HEIGHT + 1.6)
    const WIDTH: f64 = Juggler::WIDTH * SCALE
    const LEFT: f64 = CX - WIDTH / 2.0
    const BOTTOM: f64 = 179.0
    const TAU: f64 = 6.283185307179586

    def gradient(list: mutable Display::DisplayList&, x: f64, y: f64, width: f64, height: f64, low: u32, high: u32, bands: i64):
        can Memory.Allocate, Abort.Panic:
            step: f64 = height / bands.f64()
            for i in 0..<bands |list, x, y, width, step, low, high, bands|:
                colour: u32 = ScenePolish::mix_rgb(low, high, (i.f64() + 0.5) / bands.f64())
                Display::draw_rect(list, x, y + i.f64() * step, width, step + 1.0, colour)

    def scenery(list: mutable Display::DisplayList&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            h: f64 = Juggler::HEIGHT * SCALE
            area: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT, y: BOTTOM, w: WIDTH, h: h}
            frame: SceneHiddenRule::Rect = ScenePolish::spread_box(&area, 6.0)
            ScenePolish::card_face(list, &frame, 14.0, 0x5a1e28ff, 0.u32(), 0.u32(), dark)
            strip: f64 = WIDTH / 16.0
            for i in 0..<16 |list, strip, h|:
                hue: u32 = 0xc42c34ff if i % 2 == 0 else 0xf8ecd6ff
                low: u32 = ScenePolish::mix_rgb(hue, 0x000000ff, 0.35)
                high: u32 = ScenePolish::mix_rgb(hue, 0x000000ff, 0.05)
                gradient(list, LEFT + i.f64() * strip, BOTTOM + 1.2 * SCALE, strip + 0.5, h - 1.2 * SCALE, low, high, 10)
            for i in 0..<16 |list, strip, h|:
                x: f64 = LEFT + (i.f64() + 0.5) * strip
                y: f64 = BOTTOM + h
                Display::begin_polygon(list, 17, x, y, 0xc42c34ff if i % 2 == 1 else 0xfac83cff)
                for j in 0..<17 |list, strip, x, y|:
                    a: f64 = TAU / 2.0 + TAU * j.f64() / 32.0
                    Display::polygon_point(list, x + cos(a) * strip / 2.0, y + sin(a) * strip / 2.0)
            gradient(list, LEFT, BOTTOM, WIDTH, 1.4 * SCALE, 0xb6915eff, 0xd6aa6eff, 5)
            Display::draw_rect(list, LEFT, BOTTOM + 1.35 * SCALE, WIDTH, 0.18 * SCALE, 0xfad65aff)

    def wrap(x: f64, span: f64) -> f64:
        return x - floor(x / span) * span

    def wind(list: mutable Display::DisplayList&, run: Juggler::Trial&, hues: u32[5]&):
        can Memory.Allocate, Abort.Panic:
            return if run.act.level.draught == 0.0
            wind: f64 = Juggler::draught(&run.act, run.time)
            for i in 0..<24 |list, run, wind, hues|:
                x: f64 = wrap(i.f64() * 3.7 + run.time * wind * 3.0, Juggler::WIDTH)
                y: f64 = wrap(i.f64() * 5.1 - run.time * 1.2, Juggler::HEIGHT - 3.0) + 2.0
                colour: u32 = (hues[(i % 5).usize()] & 0xffffff00.u32()) | 180.u32()
                Display::draw_rect(list, LEFT + x * SCALE, BOTTOM + y * SCALE, 0.25 * SCALE, 0.15 * SCALE, colour)
            for i in 0..<12 |list, wind, hues|:
                x: f64 = LEFT + (1.5 + i.f64() * 2.6) * SCALE
                y: f64 = BOTTOM + (Juggler::HEIGHT - 2.0 - 0.5 * sin(i.f64() * 0.8)) * SCALE
                Display::draw_triangle(list, x - 0.6 * SCALE, y, x + 0.6 * SCALE, y,
                    x + wind * 0.8 * SCALE, y - 1.1 * SCALE, hues[(i % 5).usize()])

    def shadows(list: mutable Display::DisplayList&, run: Juggler::Trial&):
        can Memory.Allocate, Abort.Panic:
            for i in 0..<run.act.level.count |list, run|:
                b: Juggler::Ball& = &run.balls[i.usize()]
                continue if not b.live
                h: f64 = Juggler::clamp((b.y - Juggler::TRAY_Y) / Juggler::HEIGHT, 0.0, 1.0)
                x: f64 = LEFT + b.x * SCALE
                y: f64 = BOTTOM + 0.7 * SCALE
                rx: f64 = (0.5 + 1.6 * h) * SCALE
                ry: f64 = (0.18 + 0.3 * h) * SCALE
                Display::begin_polygon(list, 32, x, y, 0x3c1e1400 | (170.0 * (1.0 - h) + 30.0).u32())
                for j in 0..<32 |list, x, y, rx, ry|:
                    a: f64 = TAU * j.f64() / 32.0
                    Display::polygon_point(list, x + cos(a) * rx, y + sin(a) * ry)

    def tray(list: mutable Display::DisplayList&, run: Juggler::Trial&):
        can Memory.Allocate, Abort.Panic:
            x: f64 = LEFT + run.x * SCALE
            y: f64 = BOTTOM + Juggler::TRAY_Y * SCALE
            half: f64 = run.act.level.tray * 0.5 * SCALE
            body_y: f64 = BOTTOM + 0.55 * SCALE
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: x - 0.9 * half, y: body_y, w: 1.8 * half, h: y - body_y - 0.1 * SCALE}
            ScenePolish::rounded(list, &box, 0.2 * SCALE, 0x3c50aaff)
            for i in 0..<4 |list, x, y, body_y, half|:
                Display::draw_circle(list, x - half * 0.6 + i.f64() * half * 0.4, (body_y + y) / 2.0, 0.12 * SCALE, 0xfad65aff)
            spin: f64 = -run.x / 0.4
            for i in 0..<2 |list, x, half, spin|:
                wx: f64 = x + (0.6 if i == 1 else -0.6) * half
                wy: f64 = BOTTOM + 0.45 * SCALE
                Display::draw_circle(list, wx, wy, 0.42 * SCALE, 0x282832ff)
                for spoke in 0..<2 |list, wx, wy, spin|:
                    a: f64 = spin + spoke.f64() * TAU / 4.0
                    dx: f64 = cos(a) * 0.36 * SCALE
                    dy: f64 = sin(a) * 0.36 * SCALE
                    Display::draw_line(list, wx - dx, wy - dy, wx + dx, wy + dy, 1.0, 0xdcdce6ff)
            Display::draw_rect(list, x - half, y - 0.12 * SCALE, half * 2.0, 0.24 * SCALE, 0xface46ff)
            Display::draw_rect(list, x - half, y + 0.08 * SCALE, half * 2.0, 0.06 * SCALE, 0xfff0aaff)
            for i in 0..<run.flash_count |list, run|:
                flash: Juggler::Flash = run.flashes[((run.flash_next + 8 - run.flash_count + i) % 8).usize()]
                age: f64 = run.time - flash.time
                if age < 0.4:
                    colour: u32 = 0xfffac800 | (255.0 * (1.0 - age / 0.4)).u32()
                    ScenePolish::ring(list, LEFT + flash.x * SCALE, BOTTOM + (Juggler::TRAY_Y + 0.3) * SCALE,
                        (0.5 + age * 4.0) * SCALE, 2.0, colour, 32)

    def balls(list: mutable Display::DisplayList&, run: Juggler::Trial&, hues: u32[5]&):
        can Memory.Allocate, Abort.Panic:
            for i in 0..<run.act.level.count |list, run, hues|:
                b: Juggler::Ball& = &run.balls[i.usize()]
                colour: u32 = hues[i.usize()]
                x: f64 = LEFT + b.x * SCALE
                if not b.live:
                    due: f64 = Juggler::clamp((run.act.drops[i.usize()].time - run.time) / 3.0, 0.0, 1.0)
                    ScenePolish::arc(list, x, BOTTOM + (Juggler::HEIGHT - 0.6) * SCALE, 0.7 * SCALE, 0.0, TAU * due, 2.0, colour)
                    continue
                heavy: bool = b.weight > 1.1
                light: u32 = ScenePolish::mix_rgb(colour, 0xffffffff, 0.45) if b.weight < 0.9 else colour
                hue: u32 = ScenePolish::mix_rgb(colour, 0x28283cff, 0.45) if heavy else light
                for j in 0..<b.trail_count |list, b, hue|:
                    point: Juggler::Point = b.trail[((b.trail_next + 8 - b.trail_count + j) % 8).usize()]
                    alpha: u32 = (30 + 18 * j).u32()
                    Display::draw_circle(list, LEFT + point.x * SCALE, BOTTOM + point.y * SCALE, (0.15 + 0.03 * j.f64()) * SCALE,
                        (hue & 0xffffff00.u32()) | alpha)
                y: f64 = BOTTOM + b.y * SCALE
                r: f64 = Juggler::RADIUS * SCALE * (1.15 if heavy else 1.0)
                Display::draw_circle(list, x, y, r, ScenePolish::mix_rgb(hue, 0x000000ff, 0.3))
                Display::draw_circle(list, x, y + r * 0.04, r * 0.84, hue)
                Display::draw_circle(list, x - r * 0.3, y + r * 0.3, r * 0.22, 0xffffff8c)

    def paint_trial(list: mutable Display::DisplayList&, run: Juggler::Trial&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            scenery(list, dark)
            for i in 0..<2 |list, run|:
                x: f64 = (8.0 if i == 0 else 24.0) + sin(run.time * 0.5 + i.f64() * 2.0) * 2.0
                ScenePolish::glow(list, LEFT + x * SCALE, BOTTOM + 10.0 * SCALE, 5.0 * SCALE,
                    0xfff0c8ff if i == 0 else 0xc8dcffff, 50)
            hues: u32[5] = [0xec465aff, 0x3c96ecff, 0xfac832ff, 0x5ac878ff, 0xb464e6ff]
            wind(list, run, &hues)
            shadows(list, run)
            tray(list, run)
            balls(list, run, &hues)
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT, y: BOTTOM + (Juggler::HEIGHT + 0.4) * SCALE,
                w: WIDTH, h: 0.7 * SCALE}
            ScenePolish::rounded(list, &box, 0.35 * SCALE, 0xc8bec8ff)
            elapsed: f64 = Juggler::clamp(run.time / run.act.level.seconds, 0.0, 1.0)
            if elapsed > 0.02:
                fill: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: box.x, y: box.y, w: WIDTH * elapsed, h: box.h}
                ScenePolish::rounded(list, &fill, 0.35 * SCALE, 0xfac83cff)

    def render(list: mutable Display::DisplayList&, session: JugglerGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Juggler", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Left / Right: ride the tray under the balls   Esc: menu",
                CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            msg: mutable dstr = []
            if session.phase == JugglerGame::READY:
                dstr_append_cstr(&msg, "Press Space or click to start")
            elif session.phase == JugglerGame::DONE:
                dstr_append_i64(&msg, session.passed_count)
                dstr_append_cstr(&msg, " of ")
                dstr_append_i64(&msg, session.trial)
                dstr_append_cstr(&msg, " passed   highest rung passed ")
                dstr_append_i64(&msg, session.best_rung)
            elif session.phase == JugglerGame::JUDGED:
                Juggler::result_text(&session.run, &msg)
            else:
                dstr_append_cstr(&msg, "Keep every ball in the air")
            Display::draw_text(list, bytes_view(msg), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if session.phase >= JugglerGame::JUDGED and session.run.result != Juggler::PENDING:
                verdict: mutable dstr = []
                Juggler::result_text(&session.run, &verdict)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.run.result == Juggler::PASSED, bytes_view(verdict), 60.0, 16.0)
            return if session.phase == JugglerGame::READY or session.phase == JugglerGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, session.run.act.level.count)
            dstr_append_cstr(&facts, " balls   ")
            remaining: f64 = session.run.act.level.seconds - session.run.time
            dstr_append_i64(&facts, remaining.i64() if remaining > 0.0 else 0)
            dstr_append_cstr(&facts, " s to go")
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            paint_trial(list, &session.run, dark)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Juggler::Grade = Juggler::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.count)
            dstr_append_cstr(out, " ball(s) for ")
            dstr_append_i64(out, py_round_half_even(level.seconds))
            dstr_append_cstr(out, " s, a ")
            dstr_append_fixed(out, level.tray, 1)
            dstr_append_cstr(out, " m tray.")
            if level.mixed:
                dstr_append_cstr(out, "  Heavy and light balls.")
            if level.draught != 0.0:
                dstr_append_cstr(out, "  A draught.")
