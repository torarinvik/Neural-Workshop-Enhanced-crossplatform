include "./scene_hand.elisa"
include "./geometry.elisa"
include "./scene_verdict.elisa"
include "./tasks/signpainter_game.elisa"

module SceneSignPainter:
    def ink(colour: i64) -> u32:
        return 0xd63c36ff if colour == 0
        return 0x3caa5aff if colour == 1
        return 0x466edcff if colour == 2
        return 0xf0c83cff if colour == 3
        return 0x282428ff

    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            return if w <= 0.0
            Display::draw_rect(list, SceneHand::x(x), SceneHand::y(y), w * SceneHand::SCALE, h * SceneHand::SCALE, tint)

    def dot(list: mutable Display::DisplayList&, p: RoomsView::Vec, radius: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            return if p.z < 0.05 or p.x + radius < 0.0 or p.x - radius > 1000.0 or p.y + radius < 0.0 or p.y - radius > 640.0
            if p.x < radius or p.x > 1000.0 - radius or p.y < radius or p.y > 640.0 - radius:
                points: mutable RoomsView::Vec[32] = zeroed
                for i in 0..<16 |p, radius, points|:
                    angle: f64 = 3.141592653589793 * i.f64() / 8.0
                    points[i.usize()] <- RoomsView::vec(p.x + radius * cos(angle), p.y + radius * sin(angle), 1.0)
                SceneHand::polygon(list, &points, 16, tint)
                return
            Display::draw_circle(list, SceneHand::x(p.x), SceneHand::y(p.y), fmax(1.0, radius * SceneHand::SCALE), tint)

    def surface(list: mutable Display::DisplayList&, run: SignPainter::Run&, edge: f64, depth: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            poly: mutable RoomsView::Vec[32] = zeroed
            poly[0] <- SignPainter::see(run, -edge, -edge, depth)
            poly[1] <- SignPainter::see(run, SignPainter::WIDTH + edge, -edge, depth)
            poly[2] <- SignPainter::see(run, SignPainter::WIDTH + edge, SignPainter::HEIGHT + edge, depth)
            poly[3] <- SignPainter::see(run, -edge, SignPainter::HEIGHT + edge, depth)
            SceneHand::polygon(list, &poly, 4, tint)

    def backdrop(list: mutable Display::DisplayList&, run: SignPainter::Run&):
        can Abort.Panic, Memory.Allocate:
            SceneHand::card(list, 0x343c46ff)
            rect(list, 0.0, 0.0, 1000.0, 640.0, 0x606e7cff)
            for k in 0..<9 |list|:
                rect(list, 0.0, 70.0 * k.f64(), 1000.0, 2.0, 0x546270ff)
            rect(list, 0.0, 0.0, 1000.0, 70.0, 0x463c36ff)
            rect(list, 60.0, 596.0, 880.0, 18.0, 0x463228ff)
            for u in [0.6, SignPainter::WIDTH - 0.6] |list, run|:
                top: RoomsView::Vec = SignPainter::see(run, u, SignPainter::HEIGHT)
                SceneHand::line(list, RoomsView::vec(top.x, 596.0, 1.0), top, 3.0, 0x28282eff)
            surface(list, run, 0.15, -0.12, 0x3c2c22ff)
            surface(list, run, 0.0, 0.0, 0xece2c8ff)

    def stroke(list: mutable Display::DisplayList&, run: SignPainter::Run&, start: i64, end: i64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            return if start >= end
            a: RoomsView::Point = run.sign.points[start.usize()]
            previous: mutable RoomsView::Vec = SignPainter::see(run, a.x, a.y)
            for j in (start + 1)..<end |list, run, tint, previous|:
                b: RoomsView::Point = run.sign.points[j.usize()]
                current: RoomsView::Vec = SignPainter::see(run, b.x, b.y)
                SceneHand::line(list, previous, current, 9.0, tint)
                previous <- current

    def marks(list: mutable Display::DisplayList&, run: SignPainter::Run&):
        can Abort.Panic, Memory.Allocate:
            sign: SignPainter::Sign& = &run.sign
            if sign.level.guide == SignPainter::OUTLINE:
                for i in 0..<sign.stroke_count |list, run, sign|:
                    stroke(list, run, SignPainter::stroke_start(sign, i), sign.ends[i.usize()], 0xcec4acff)
            elif sign.level.guide == SignPainter::CORNERS:
                for i in 0..<sign.corner_count |list, run, sign|:
                    c: RoomsView::Point = sign.corners[i.usize()]
                    dot(list, SignPainter::see(run, c.x, c.y), 3.5, 0xaaa08cff)
            tint: u32 = ink(sign.colour)
            shown: i64 = sign.stroke_count if run.stroke >= sign.stroke_count else run.stroke + 1
            for i in 0..<shown |list, run, sign, tint|:
                start: i64 = SignPainter::stroke_start(sign, i)
                end: i64 = sign.ends[i.usize()] if i < run.stroke else start + run.point
                stroke(list, run, start, end, tint)
                for j in start..<end |list, run, sign, tint|:
                    p: RoomsView::Point = sign.points[j.usize()]
                    dot(list, SignPainter::see(run, p.x, p.y), 4.5, tint)
            if sign.level.rung < 7 and run.stroke < sign.stroke_count:
                goal: RoomsView::Point = sign.points[(SignPainter::stroke_start(sign, run.stroke) + run.point).usize()]
                target: RoomsView::Vec = SignPainter::see(run, goal.x, goal.y)
                dot(list, target, 7.0, 0xffffffc8)
                dot(list, target, 4.0, 0xec5040ff)
            if run.has_brush:
                dot(list, SignPainter::see(run, run.brush.x, run.brush.y), 6.0, ink(run.colour))

    def order(out: mutable dstr&, sign: SignPainter::Sign&):
        can Abort.Panic, Memory.Allocate:
            dstr_append_cstr(out, "Paint ")
            dstr_append_sview(out, sign.word)
            if sign.colour >= 0:
                dstr_append_cstr(out, " in ")
                dstr_append_sview(out, SignPainter::colour_name(sign.colour))
            dstr_append_cstr(out, ".")

    def hud(list: mutable Display::DisplayList&, run: SignPainter::Run&, instruction: sview):
        can Abort.Panic, Memory.Allocate:
            rect(list, 200.0, 618.0, 600.0, 22.0, 0x10121cc8)
            SceneHand::word(list, instruction, 500.0, 629.0, 13.0, 0xffffffff, true)
            if run.sign.level.colour:
                for k in 0..<4 |list, run|:
                    x: f64 = 320.0 + 120.0 * k.f64()
                    rect(list, x - 34.0, 8.0, 68.0, 52.0, 0x282422ff)
                    rect(list, x - 28.0, 14.0, 56.0, 34.0, ink(k))
                    rect(list, x - 34.0, 60.0, 68.0, 5.0, 0xffffffff) if run.colour == k
                    SceneHand::number(list, k + 1, RoomsView::vec(x, 31.0, 1.0), 13.0, 0x141414ff)
            if run.sign.level.load > 0:
                share: f64 = HandView::clamp(run.paint.f64() / run.sign.level.load.f64(), 0.0, 1.0)
                SceneHand::word(list, "paint", 60.0, 40.0, 11.0, 0xf0f0f0ff)
                rect(list, 90.0, 34.0, 110.0, 12.0, 0x282422ff)
                rect(list, 90.0, 34.0, 110.0 * share, 12.0, 0xec5040ff if share < 0.2 else 0xf0f0f0ff)
            for k in 0..<3 |list, run|:
                dot(list, RoomsView::vec(880.0 + 26.0 * k.f64(), 40.0, 1.0), 8.0,
                    0xec5040ff if k < run.smudges else 0x322e2cff)

    def verdict(result: i64) -> sview:
        return "A handsome sign" if result == SignPainter::PAINTED
        return "The sign is a mess" if result == SignPainter::MESS
        return "That was the wrong colour" if result == SignPainter::WRONG_COLOUR
        return "The paint dried on the brush"

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: SignPainter::Grade = SignPainter::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ".")
            dstr_append_cstr(out, "  In the colour asked for.") if level.colour
            dstr_append_cstr(out, "  The board swings.") if level.swing > 0.0
            dstr_append_cstr(out, "  No outline.") if level.guide != SignPainter::OUTLINE

    def render(list: mutable Display::DisplayList&, game: SignPainterGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            text_colour: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Sign Painter", 456.0, 648.0, 22.0, text_colour, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Hold the button and paint each stroke   1-4: colour   Space: dip the brush   Esc: menu",
                456.0, 26.0, 12.0, text_colour, Display::ANCHOR_CENTER_CENTER)
            if game.phase == SignPainterGame::READY:
                Display::draw_text(list, "Press Space or click to start", 456.0, 614.0, 14.0, text_colour, Display::ANCHOR_CENTER_CENTER)
                return
            if game.phase == SignPainterGame::DONE:
                report: mutable dstr = []
                dstr_append_i64(&report, game.wins)
                dstr_append_cstr(&report, " of ")
                dstr_append_i64(&report, game.trial)
                dstr_append_cstr(&report, " passed   highest rung passed ")
                dstr_append_i64(&report, game.best_rung)
                Display::draw_text(list, bytes_view(report), 456.0, 614.0, 14.0, text_colour, Display::ANCHOR_CENTER_CENTER)
                return
            run: SignPainter::Run& = &game.run
            instruction: mutable dstr = []
            order(&instruction, &run.sign)
            backdrop(list, run)
            marks(list, run)
            SceneHand::progress(list, &run.hand, fmax(0.0, (run.sign.seconds - run.time) / run.sign.seconds))
            hud(list, run, bytes_view(instruction))
            Display::draw_text(list, bytes_view(instruction), 456.0, 614.0, 14.0, text_colour, Display::ANCHOR_CENTER_CENTER)
            facts: mutable dstr = dstr_of_cstr("rung ")
            dstr_append_i64(&facts, game.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, game.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, game.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_sview(&facts, run.sign.word)
            Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, text_colour, Display::ANCHOR_CENTER_CENTER)
            if game.phase == SignPainterGame::JUDGED:
                result: i64 = run.result
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, result == SignPainter::PAINTED, verdict(result), 60.0, 16.0)
