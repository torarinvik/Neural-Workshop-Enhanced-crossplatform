# CPython math semantics that need libm, kept apart from pyrandom.elisa.
# pyrandom is included by every sweep in this port and most have no use for
# libm, so putting these beside it would make elisacore_math a requirement of
# every driver for the sake of two functions.
#
# NOTE: needs elisacore_math and pyrandom included by the driver, in that order.

# `random.gauss` keeps HALF A DRAW in its pocket. Box-Muller makes two normals
# at a time from two uniforms; CPython returns one and caches the other, so
# every SECOND call consumes no randomness at all. The cache also survives
# between calls, so a run that draws three gaussians a tick leaves one waiting
# for the next tick -- get this wrong and the stream is a draw out for ever
# after, which looks exactly like a plausible but different simulation.
#
# Needs elisacore_math (sqrt, log, sin, cos) from the driver.
struct GaussCache:
    has: mutable bool
    value: mutable f64

def py_gauss(rng: mutable MT19937&, cache: mutable GaussCache&, mu: f64, sigma: f64) -> f64:
    can Abort.Panic:
        z: mutable f64 = 0.0
        if cache.has:
            z <- cache.value
            cache.has <- false
        else:
            # TWOPI is `2.0 * pi` computed once, so it rounds once too.
            x2pi: f64 = py_random(rng) * 6.283185307179586
            g2rad: f64 = sqrt(-2.0 * log(1.0 - py_random(rng)))
            z <- cos(x2pi) * g2rad
            cache.value <- sin(x2pi) * g2rad
            cache.has <- true
        return mu + z * sigma


# `math.hypot`, which is NOT the platform's `hypot` and not the correctly
# rounded value either. Measured against this CPython (3.9.6, Apple's) it is
# the classic `max * sqrt(1 + (min/max)^2)`: 0 mismatches over 300,000 random
# doubles across the range this port uses, plus the whole 60x60 integer grid.
# Both alternatives were ruled out by the same measurement -- the correctly
# rounded value differs on about a third of arguments, and clang's own libm
# `hypot` differs on 1208 of those 3600 integer pairs.
#
# It matters where a hypot's VALUE is kept rather than compared. marblemaze's
# Dijkstra sweep seeds its field with `hypot(di, dj) * pitch`, so a last-ulp
# difference is stored and propagates through every distance downstream; a
# naive `sqrt(a*a + b*b)` there moved cells in all 64 trays measured.
def py_hypot(x: f64, y: f64) -> f64:
    can Abort.Panic:
        big: mutable f64 = -x if x < 0.0 else x
        small: mutable f64 = -y if y < 0.0 else y
        if big < small:
            swap: f64 = big
            big <- small
            small <- swap
        if big == 0.0:
            return 0.0
        t: f64 = small / big
        return big * sqrt(1.0 + t * t)
