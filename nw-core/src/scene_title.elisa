# The title screen: the first thing the player sees.
#
# This replaces the title branch of neural_workshop/ui/hud.py
# (TitleMessageLabel, TitleKeysLabel) and the splash placed by
# bootstrap._place_splash. It computes LAYOUT and emits display-list commands;
# it never touches a font, an image or a window.
#
# Every constant below was MEASURED from the original rather than read off its
# source: scripts/extract_title.py drives the real pyglet UI, reads the laid-out
# labels, and divides by the window's own scale to land in 912x684 reference
# space. That matters because the window pyglet hands back on this display is
# retina-doubled, so the geometry helpers return physical pixels and every
# number in hud.py is off by a factor of two from what actually lays out.
#
# The original's draw order (events.on_draw, the `mode.title_screen` branch) is
# splash, then the title block, then the keys block -- and inside the keys block
# the "press space" prompt draws BEFORE the key list. Command order is part of
# the contract, so it is reproduced exactly.

# --- the title block (TitleMessageLabel) ---------------------------
const TITLE_Y: f64 = 659.0              # from_top_edge(25)
const TITLE_SIZE: f64 = 32.0
const TITLE_VERSION_Y: f64 = 629.0      # from_top_edge(55)
const TITLE_VERSION_SIZE: f64 = 14.0
const TITLE_NATIVE_Y: f64 = 606.0       # from_top_edge(78)
const TITLE_NATIVE_SIZE: f64 = 10.0

# --- the keys block (TitleKeysLabel) -------------------------------
const TITLE_KEYS_X: f64 = 521.0         # from_width_center(65)
const TITLE_KEYS_TOP: f64 = 260.0       # from_bottom_edge(260)
const TITLE_KEYS_SIZE: f64 = 12.0
# Measured, not derived: pyglet advances a multiline label by the FONT's
# ascent-minus-descent, which is 16.5 reference pixels at size 12 on this face
# (content_height 132 over 8 lines). A shell cannot be asked to reproduce
# another toolkit's font metrics, so the core resolves the block into one
# command per line and the spacing stops depending on the renderer.
const TITLE_KEYS_LINE_HEIGHT: f64 = 16.5

const TITLE_SPACE_Y: f64 = 35.0         # from_bottom_edge(35)
const TITLE_SPACE_SIZE: f64 = 20.0

# --- the splash (bootstrap.SPLASH_*) -------------------------------
const TITLE_SPLASH_ROOM_WIDTH: f64 = 360.0
const TITLE_SPLASH_ROOM_HEIGHT: f64 = 316.0
const TITLE_SPLASH_BOTTOM: f64 = 268.0

def title_color_background(black_background: bool) -> u32:
    # window.py: glClearColor(0,0,0,1) under BLACK_BACKGROUND, else (1,1,1,1).
    if black_background:
        return Display::rgba(0, 0, 0, 255)
    return Display::rgba(255, 255, 255, 255)

def title_color_text(black_background: bool) -> u32:
    # configdefaults: COLOR_TEXT is black, COLOR_TEXT_BLK the light ink used
    # when the background is black.
    if black_background:
        return Display::rgba(240, 240, 240, 255)
    return Display::rgba(0, 0, 0, 255)

# bootstrap.py: `'splash-black' if cfg.BLACK_BACKGROUND else 'splash'`.
def title_splash_asset(black_background: bool) -> u32:
    if black_background:
        return Display::ASSET_SPLASH_DARK
    return Display::ASSET_SPLASH

def title_color_prompt() -> u32:
    # The one hard-coded colour on this screen: hud.py passes (32, 32, 255, 255)
    # for the prompt regardless of the background, so it is NOT a theme colour.
    return Display::rgba(32, 32, 255, 255)

# The splash room's centre. The original places the sprite at
# `center_x - width/2` and `SPLASH_BOTTOM + (room_height - height)/2`, which is
# the fitted image centred in this box; expressing it as a centre lets the
# shell do the fit without the core knowing the image's size.
def title_splash_center_y() -> f64:
    return TITLE_SPLASH_BOTTOM + TITLE_SPLASH_ROOM_HEIGHT / 2.0

# How many key lines this build offers. The original assembles the list from
# two flags, and a key that is listed but does nothing is worse than one that
# is missing, so the count follows the flags exactly.
def title_key_line_count(jaeggi_mode: bool, clinical_mode: bool) -> i64:
    can Abort.Panic:
        total: mutable i64 = 1                      # F11 is always offered
        if not (jaeggi_mode or clinical_mode):
            total <- total + 4                      # SPACE, C, S, I
        if not clinical_mode:
            total <- total + 3                      # U, G, and O
        return total

# Line `index` of the key list, or "" past the end.
def title_key_line(index: i64, jaeggi_mode: bool, clinical_mode: bool) -> sview:
    can Abort.Panic:
        at: mutable i64 = index
        if not (jaeggi_mode or clinical_mode):
            if at == 0:
                return "SPACE: Task menu"
            if at == 1:
                return "C: Choose N-Back mode"
            if at == 2:
                return "S: Choose Sounds"
            if at == 3:
                return "I: Choose Images"
            at <- at - 4
        if not clinical_mode:
            if at == 0:
                return "U: Choose User"
            if at == 1:
                return "G: Daily Progress Graph"
            at <- at - 2
        if at == 0:
            return "F11: Full Screen"
        if at == 1 and not clinical_mode:
            return "O: Edit configuration file"
        return ""

# The version and the accelerator banner are host facts, so the string-taking
# entry point below stays the real one. These exist for the SCALAR ABIs -- wasm
# and the C shell both want every argument to be a number -- so the host names a
# banner by code instead of pushing a string across the boundary.
def title_version_text() -> sview:
    return "Version 5.0"

def title_native_banner(code: i64) -> sview:
    can Abort.Panic:
        if code == 1:
            return "native: C"
        if code == 2:
            return "native: Python"
        return ""

# Paint the title screen. `version` and `native_banner` are supplied by the
# host: the version is a build fact and the banner names the accelerator the
# runtime actually loaded, neither of which the core can know.
def render_title_frame(list: mutable Display::DisplayList&, version: sview, native_banner: sview, black_background: bool, jaeggi_mode: bool, clinical_mode: bool):
    can Memory.Allocate, Abort.Panic:
        ink: u32 = title_color_text(black_background)

        Display::draw_rect(list, 0.0, 0.0, Display::REFERENCE_WIDTH, Display::REFERENCE_HEIGHT, title_color_background(black_background))

        # 1. the splash, under everything else.
        Display::draw_sprite_fitted(list, title_splash_asset(black_background), Display::REFERENCE_WIDTH / 2.0, title_splash_center_y(), TITLE_SPLASH_ROOM_WIDTH, TITLE_SPLASH_ROOM_HEIGHT, 0.0, Display::rgba(255, 255, 255, 255))

        # 2. the title block.
        Display::draw_text(list, "Neural Workshop", Display::REFERENCE_WIDTH / 2.0, TITLE_Y, TITLE_SIZE, ink, Display::ANCHOR_CENTER_CENTER)
        Display::draw_text(list, version, Display::REFERENCE_WIDTH / 2.0, TITLE_VERSION_Y, TITLE_VERSION_SIZE, ink, Display::ANCHOR_CENTER_CENTER)
        Display::draw_text(list, native_banner, Display::REFERENCE_WIDTH / 2.0, TITLE_NATIVE_Y, TITLE_NATIVE_SIZE, ink, Display::ANCHOR_CENTER_CENTER)

        # 3. the keys block -- prompt first, matching TitleKeysLabel.draw.
        Display::draw_text(list, "Press SPACE to enter the Workshop", Display::REFERENCE_WIDTH / 2.0, TITLE_SPACE_Y, TITLE_SPACE_SIZE, title_color_prompt(), Display::ANCHOR_CENTER_CENTER)

        total: i64 = title_key_line_count(jaeggi_mode, clinical_mode)
        index: mutable i64 = 0
        while index < total |index, list, ink, jaeggi_mode, clinical_mode, total|:
            line: sview = title_key_line(index, jaeggi_mode, clinical_mode)
            Display::draw_text(list, line, TITLE_KEYS_X, TITLE_KEYS_TOP - index.f64() * TITLE_KEYS_LINE_HEIGHT, TITLE_KEYS_SIZE, ink, Display::ANCHOR_CENTER_TOP)
            index <- index + 1

        Display::emit_marker(list, "frame-end")

# The scalar-ABI form: same frame, host facts named by code.
def render_title_frame_coded(list: mutable Display::DisplayList&, banner_code: i64, black_background: bool, jaeggi_mode: bool, clinical_mode: bool):
    can Memory.Allocate, Abort.Panic:
        render_title_frame(list, title_version_text(), title_native_banner(banner_code), black_background, jaeggi_mode, clinical_mode)
