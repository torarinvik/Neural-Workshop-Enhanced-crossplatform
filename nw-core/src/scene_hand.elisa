include "./hand_view.elisa"
include "./scene_polish.elisa"

module SceneHand:
    const SCALE: f64 = HandView::VIEW_SCALE
    const WIDTH: f64 = HandView::WIDTH * SCALE
    const LEFT: f64 = HandView::VIEW_LEFT
    const BOTTOM: f64 = HandView::VIEW_BOTTOM

    def x(value: f64) -> f64:
        return LEFT + value * SCALE

    def y(value: f64) -> f64:
        return BOTTOM + value * SCALE

    def edge_distance(point: RoomsView::Vec, edge: i64) -> f64:
        return point.x if edge == 0
        return HandView::WIDTH - point.x if edge == 1
        return point.y if edge == 2
        return HandView::HEIGHT - point.y

    def polygon(list: mutable Display::DisplayList&, points: mutable RoomsView::Vec[32]&, count: i64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            length: mutable i64 = count
            for edge in 0..<4 |points, length|:
                return if length < 3
                clipped: mutable RoomsView::Vec[32] = zeroed
                used: mutable i64 = 0
                previous: mutable RoomsView::Vec = points[(length - 1).usize()]
                for i in 0..<length |edge, points, clipped, used, previous|:
                    current: RoomsView::Vec = points[i.usize()]
                    before: f64 = edge_distance(previous, edge)
                    after: f64 = edge_distance(current, edge)
                    if (before >= 0.0) != (after >= 0.0):
                        fraction: f64 = before / (before - after)
                        clipped[used.usize()] <- RoomsView::add(previous, RoomsView::mul(RoomsView::sub(current, previous), fraction))
                        used <- used + 1
                    if after >= 0.0:
                        clipped[used.usize()] <- current
                        used <- used + 1
                    previous <- current
                for i in 0..<used |points, clipped|:
                    points[i.usize()] <- clipped[i.usize()]
                length <- used
            return if length < 3
            Display::begin_polygon(list, length, x(points[0].x), y(points[0].y), colour)
            for i in 0..<length |list, points|:
                p: RoomsView::Vec = points[i.usize()]
                Display::polygon_point(list, x(p.x), y(p.y))

    def line(list: mutable Display::DisplayList&, start: RoomsView::Vec, stop: RoomsView::Vec, width: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            return if start.z < 0.05 or stop.z < 0.05
            low: mutable f64 = 0.0
            high: mutable f64 = 1.0
            for edge in 0..<4 |start, stop, low, high|:
                before: f64 = edge_distance(start, edge)
                after: f64 = edge_distance(stop, edge)
                return if before < 0.0 and after < 0.0
                if before < 0.0 or after < 0.0:
                    point: f64 = before / (before - after)
                    if before < 0.0:
                        low <- point if point > low
                    else:
                        high <- point if point < high
            return if low > high
            delta: RoomsView::Vec = RoomsView::sub(stop, start)
            Display::draw_line(list, x(start.x + low * delta.x), y(start.y + low * delta.y),
                x(start.x + high * delta.x), y(start.y + high * delta.y), width * SCALE if width * SCALE >= 1.0 else 1.0, colour)

    def word(list: mutable Display::DisplayList&, text: sview, at_x: f64, at_y: f64, size: f64, colour: u32, bold: bool = false):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x(at_x), y(at_y), size * SCALE, colour, Display::ANCHOR_CENTER_CENTER, bold)

    def number(list: mutable Display::DisplayList&, value: i64, p: RoomsView::Vec, size: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            return if p.z < 0.05
            text: mutable dstr = []
            dstr_append_i64(&text, value)
            word(list, bytes_view(text), p.x, p.y, size, colour, true)

    def cursor_shape(list: mutable Display::DisplayList&, x0: f64, y0: f64, left: f64, top: f64,
                     height: f64, inner_x: f64, inner_y: f64, right: f64, right_y: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            Display::begin_polygon(list, 4, x(x0 + left), y(y0 + top), colour)
            Display::polygon_point(list, x(x0 + left), y(y0 + top))
            Display::polygon_point(list, x(x0 + left), y(y0 + height))
            Display::polygon_point(list, x(x0 + inner_x), y(y0 + inner_y))
            Display::polygon_point(list, x(x0 + right), y(y0 + right_y))

    def card(list: mutable Display::DisplayList&, colour: u32 = 0x1c1e2cff):
        can Memory.Allocate, Abort.Panic:
            card: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT - 4.0, y: BOTTOM - 4.0, w: WIDTH + 8.0, h: 397.0}
            shades: u32[3] = [30.u32(), 18.u32(), 12.u32()]
            for i in 0..<3 |list, card, shades|:
                spread: f64 = i.f64() * 2.0
                box: SceneHiddenRule::Rect = ScenePolish::spread_box(&card, spread, 4.0)
                ScenePolish::rounded(list, &box, 14.0 + spread, shades[i.usize()])
            ScenePolish::rounded(list, &card, 14.0, colour)
    def progress(list: mutable Display::DisplayList&, hand: HandView::Pointer&, share: f64):
        can Memory.Allocate, Abort.Panic:
            if share > 0.005:
                Display::draw_rect(list, x(10.0), y(6.0), 980.0 * share * SCALE, 6.0 * SCALE,
                    ScenePolish::mix_rgb(0xec5040ff, 0x6edc8cff, HandView::clamp(share * 1.6, 0.0, 1.0)))
            cursor_shape(list, hand.x, hand.y, -2.0, 3.0, -24.0, 6.72, -16.8, 18.4, -16.0, 0x14141eff)
            cursor_shape(list, hand.x, hand.y, 0.0, 0.0, -20.0, 5.76, -14.4, 14.4, -14.4,
                0xffd246ff if hand.down else 0xffffffff)


