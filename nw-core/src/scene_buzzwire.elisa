# The Buzz Wire screen: game state in, display list out.
#
# Port of neural_workshop/ui/buzzwire.py -- the CHROME, and not the 3D pass.
#
# Like Marble Maze, everything a player looks at is drawn by `ui/render3d.py`
# through a GL pipeline of its own, which the frame recorder cannot see and
# this port therefore cannot check. The wire, the loop and the hand are left
# for a shell with a mesh pipeline; what is here is what the recorder can see:
# three labels and the verdict.
#
# The status line carries a GAUGE and not a number: how much of the loop's
# clearance has been used up, drawn as eight cells of hash and dot. A percent
# would be read after the fact and a bar is read while the hand is moving,
# which is the whole difference for a task about a steady hand.
#
# NOTE: needs elisacore_math, strings, geometry, display and scene_verdict
# included by the driver.

module SceneBuzzWire:

    const PHASE_READY: i64 = 0
    const PHASE_FLYING: i64 = 1
    const PHASE_SETTLED: i64 = 2
    const PHASE_DONE: i64 = 3

    # Cells in the clearance gauge.
    const GAUGE_CELLS: i64 = 8

    struct BuzzWirePaint:
        ink: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> BuzzWirePaint:
        back: i64 = 0 if black_background else 255
        fore: i64 = 255 - back
        return BuzzWirePaint{ink: Display::rgba(fore, fore, fore, 255),
                     width: width, height: height, sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: BuzzWirePaint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    # `'[%s%s]' % ('#' * full, '.' * (cells - full))`, with `full` the used
    # share of the clearance rounded HALF TO EVEN and clamped to the bar.
    def append_gauge(out: mutable dstr&, used: f64):
        can Memory.Allocate, Abort.Panic:
            lifted: f64 = used if used > 0.0 else 0.0
            capped: f64 = lifted if lifted < 1.0 else 1.0
            full: i64 = py_round_half_even(capped * GAUGE_CELLS.f64())
            out.push(91.u8())
            for cell in 0..<GAUGE_CELLS |out, full|:
                out.push(35.u8() if cell < full else 46.u8())
            out.push(93.u8())

    def render(list: mutable Display::DisplayList&, paint: BuzzWirePaint&, phase: i64,
               flying: bool, trial: i64, total_trials: i64, along: i64,
               seconds_left: i64, buzzes: i64, touches: i64,
               show_meter: bool, used: f64, message: sview, verdict: i64,
               verdict_text: sview):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()

            put_text(list, paint, sview("Buzz Wire", 0, -1), middle,
                     Geometry::from_top_edge(paint.height, 34.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            status: mutable dstr = []
            dstr_append_sview(&status, message)
            if phase == PHASE_FLYING and flying:
                dstr_append_cstr(&status, "     wire ")
                dstr_append_i64(&status, trial)
                dstr_append_cstr(&status, "/")
                dstr_append_i64(&status, total_trials)
                dstr_append_cstr(&status, "   ")
                dstr_append_i64(&status, along)
                dstr_append_cstr(&status, "%   ")
                # `'%.0fs'` -- no decimal, and the seconds are already the
                # whole number the caller worked out.
                dstr_append_i64(&status, seconds_left)
                dstr_append_cstr(&status, "s   touched ")
                dstr_append_i64(&status, buzzes)
                dstr_append_cstr(&status, "/")
                dstr_append_i64(&status, touches)
                if show_meter:
                    dstr_append_cstr(&status, "   gap ")
                    append_gauge(&status, used)
            put_text(list, paint, bytes_view(status), middle,
                     Geometry::from_top_edge(paint.height, 58.0).f64(),
                     Geometry::calc_fontsize(paint.height, 14.0), paint.ink,
                     Display::ANCHOR_CENTER_TOP, false)

            put_text(list, paint,
                     sview("Esc: task menu   Space: start   Arrows: move the loop   W/S: along the wire   I/K/J/L: turn it   Shift: brace   C: options", 0, -1),
                     middle, Geometry::from_bottom_edge(paint.height, 26.0).f64(),
                     Geometry::calc_fontsize(paint.height, 11.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            if verdict >= 0:
                SceneVerdict::put(list, paint.width, paint.height, paint.sx, paint.sy,
                                  verdict == 1, verdict_text, 58.0, 16.0)
