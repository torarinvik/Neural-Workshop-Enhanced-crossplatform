include "./tasks/gunslinger_game.elisa"
include "./scene_hand.elisa"
include "./scene_verdict.elisa"

module SceneGunslinger:
    const TAU: f64 = 6.283185307179586
    const SKIN: u32 = 0xdeb28cff
    const STEEL: u32 = 0x3a3c44ff
    const DUSK: u32 = 0xff9646ff

    struct Figure:
        x: f64
        y: f64
        unit: f64

    struct Wall:
        x: f64
        side: f64
        z: f64

    struct Revolver:
        x: f64
        y: f64
        dx: f64
        dy: f64
        nx: f64
        ny: f64

    def screen(x: f64, y: f64) -> RoomsView::Vec:
        return RoomsView::vec(x, y, 1.0)

    def project(view: HandView::Lens&, x: f64, y: f64, z: f64) -> RoomsView::Vec:
        return HandView::see(view, RoomsView::vec(x, y, z))

    def quad(list: mutable Display::DisplayList&, a: RoomsView::Vec, b: RoomsView::Vec,
             c: RoomsView::Vec, d: RoomsView::Vec, colour: u32):
        can Memory.Allocate, Abort.Panic:
            return if a.z < 0.05 or b.z < 0.05 or c.z < 0.05 or d.z < 0.05
            p: mutable RoomsView::Vec[32] = zeroed
            p[0] <- a
            p[1] <- b
            p[2] <- c
            p[3] <- d
            SceneHand::polygon(list, &p, 4, colour)

    def triangle(list: mutable Display::DisplayList&, a: RoomsView::Vec, b: RoomsView::Vec,
                 c: RoomsView::Vec, colour: u32):
        can Memory.Allocate, Abort.Panic:
            return if a.z < 0.05 or b.z < 0.05 or c.z < 0.05
            p: mutable RoomsView::Vec[32] = zeroed
            p[0] <- a
            p[1] <- b
            p[2] <- c
            SceneHand::polygon(list, &p, 3, colour)

    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, SceneHand::x(x), SceneHand::y(y), w * SceneHand::SCALE, h * SceneHand::SCALE, colour)

    def disc(list: mutable Display::DisplayList&, p: RoomsView::Vec, radius: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            return if p.z < 0.05 or p.x < -radius or p.x > 1000.0 + radius or p.y < -radius or p.y > 640.0 + radius
            if p.x >= radius and p.x <= 1000.0 - radius and p.y >= radius and p.y <= 640.0 - radius:
                Display::draw_circle(list, SceneHand::x(p.x), SceneHand::y(p.y), radius * SceneHand::SCALE, colour)
                return
            points: mutable RoomsView::Vec[32] = zeroed
            for i in 0..<16 |points, p, radius|:
                a: f64 = 0.39269908169872414 * i.f64()
                points[i.usize()] <- screen(p.x + radius * cos(a), p.y + radius * sin(a))
            SceneHand::polygon(list, &points, 16, colour)

    def gradient(list: mutable Display::DisplayList&, bottom: f64, height: f64, bands: i64, low: u32, high: u32):
        can Memory.Allocate, Abort.Panic:
            step: f64 = height / bands.f64()
            for k in 0..<bands |list, bottom, step, bands, low, high|:
                colour: u32 = ScenePolish::mix_rgb(low, high, (k.f64() + 0.5) / bands.f64())
                rect(list, 0.0, bottom + k.f64() * step, 1000.0, step + 1.0 / SceneHand::SCALE, colour)

    def sky(list: mutable Display::DisplayList&, view: HandView::Lens&, time: f64, h: f64):
        can Memory.Allocate, Abort.Panic:
            gradient(list, h, 640.0 - h, 26, 0xffb05cff, 0x3a2c68ff)
            sun: RoomsView::Vec = project(view, -14.0, 5.0, -120.0)
            if sun.z >= 0.05:
                x: f64 = SceneHand::x(sun.x)
                y: f64 = SceneHand::y(sun.y)
                ScenePolish::glow(list, x, y, 150.0 * SceneHand::SCALE, 0xffd68cff, 26)
                ScenePolish::glow(list, x, y, 100.0 * SceneHand::SCALE, 0xffd68cff, 40)
                ScenePolish::glow(list, x, y, 62.0 * SceneHand::SCALE, 0xffd68cff, 70)
                disc(list, sun, 34.0, 0xffecbeff)
            for n in 0..<7 |list, h, time|:
                offset: f64 = (n * 173 + 60).f64() + time * 2.0
                cx: f64 = offset - (offset / 1100.0).i64().f64() * 1100.0 - 50.0
                cy: f64 = h + (120 + (n * 71) % 190).f64()
                w: f64 = (120 + (n * 53) % 140).f64()
                points: mutable RoomsView::Vec[32] = zeroed
                points[0] <- screen(cx - w, cy)
                points[1] <- screen(cx - w * 0.5, cy + 7.0)
                points[2] <- screen(cx + w * 0.6, cy + 5.0)
                points[3] <- screen(cx + w, cy - 1.0)
                points[4] <- screen(cx + w * 0.4, cy - 6.0)
                points[5] <- screen(cx - w * 0.6, cy - 5.0)
                SceneHand::polygon(list, &points, 6, Display::rgba(255, 150 + 10 * (n % 3), 120, 70))
            for layer in 0..<2 |list, h|:
                colour: u32 = 0x7a4e6eff if layer == 0 else 0x5c3854ff
                base: f64 = 0.0 if layer == 0 else -4.0
                lift: f64 = 1.0 if layer == 0 else 0.7
                seed: mutable i64 = 3 if layer == 0 else 8
                x: mutable f64 = -40.0
                while x < 1040.0 |list, h, colour, base, lift, seed, x|:
                    seed <- (seed * 37 + 11) % 101
                    width: f64 = 70.0 + seed.f64() * 1.4
                    top: f64 = h + base + lift * (18 + (seed * 13) % 46).f64()
                    quad(list, screen(x, h - 1.0), screen(x + 10.0, top),
                        screen(x + width - 14.0, top), screen(x + width, h - 1.0), colour)
                    x <- x + width + ((seed % 5) * 14 - 20).f64()

    def street(list: mutable Display::DisplayList&, view: HandView::Lens&, h: f64):
        can Memory.Allocate, Abort.Panic:
            gradient(list, 0.0, h, 18, 0x966842ff, 0xecb670ff)
            dark: u32 = 0x3a2434ff
            z: f64 = -62.0
            quad(list, project(view, -3.0, 0.0, z), project(view, 3.0, 0.0, z),
                project(view, 3.0, 4.5, z), project(view, -3.0, 4.5, z), dark)
            quad(list, project(view, -1.0, 4.5, z), project(view, 1.0, 4.5, z),
                project(view, 1.0, 8.5, z), project(view, -1.0, 8.5, z), dark)
            triangle(list, project(view, -3.4, 4.5, z), project(view, 3.4, 4.5, z), project(view, 0.0, 6.6, z), dark)
            triangle(list, project(view, -1.2, 8.5, z), project(view, 1.2, 8.5, z), project(view, 0.0, 11.5, z), dark)
            lanes: f64[4] = [-1.6, -0.9, 0.9, 1.6]
            for n in 0..<4 |lanes, list, view|:
                x: f64 = lanes[n.usize()]
                SceneHand::line(list, project(view, x, 0.0, -2.5), project(view, x * 0.9, 0.0, -60.0), 2.0, 0x8c623e6e)
            for n in 0..<40 |list, view|:
                a: f64 = ((n * 61) % 97).f64() / 97.0
                b: f64 = ((n * 29) % 89).f64() / 89.0
                p: RoomsView::Vec = project(view, (a - 0.5) * 11.0, 0.0, -3.0 - b * 40.0)
                if p.z >= 0.05:
                    w: f64 = 40.0 / p.z
                    h: f64 = 12.0 / p.z
                    rect(list, p.x, p.y, w if w > 2.0 else 2.0, h if h > 1.0 else 1.0, 0x80583878)
            for n in 0..<8 |list, view|:
                x: f64 = -5.2 if n < 4 else 5.2
                z: f64 = (-9 - 13 * (n % 4)).f64()
                SceneHand::line(list, project(view, x, 0.0, z), project(view, x, 6.2, z), 3.0, 0x463028ff)
                SceneHand::line(list, project(view, x - 0.6, 5.6, z), project(view, x + 0.6, 5.6, z), 2.0, 0x463028ff)

    def sign(index: i64) -> sview:
        return "SALOON" if index == 0
        return "BANK" if index == 1
        return "HOTEL" if index == 2
        return "SHERIFF" if index == 3
        return "STORE" if index == 4
        return "LIVERY" if index == 5
        return "BARBER" if index == 6
        return "ASSAY" if index == 7
        return "STAGE" if index == 8
        return "SMITH" if index == 9
        return "FEED" if index == 10
        return "POST"

    def wall_point(view: HandView::Lens&, wall: Wall&, distance: f64, y: f64, inset: f64 = 0.0) -> RoomsView::Vec:
        return project(view, wall.x + inset * wall.side, y, wall.z - 6.6 * distance)

    def storefront(list: mutable Display::DisplayList&, view: HandView::Lens&, wall: Wall&, height: f64, wood: u32, n: i64):
        can Memory.Allocate, Abort.Panic:
            quad(list, wall_point(view, wall, 0.0, 0.0), wall_point(view, wall, 1.0, 0.0),
                wall_point(view, wall, 1.0, height), wall_point(view, wall, 0.0, height), wood)
            quad(list, wall_point(view, wall, 0.0, height), wall_point(view, wall, 1.0, height),
                wall_point(view, wall, 1.0, height + 0.25), wall_point(view, wall, 0.0, height + 0.25), ScenePolish::mix_rgb(wood, 0x000000ff, 0.35))
            plank: u32 = (ScenePolish::mix_rgb(wood, 0x000000ff, 0.22) & 0xffffff00) | 150.u32()
            for k in 1..<9 |list, view, wall, height, plank|:
                f: f64 = k.f64() / 9.0
                SceneHand::line(list, wall_point(view, wall, f, 0.3), wall_point(view, wall, f, height), 1.0, plank)
            glass: u32 = 0xffd078ff if (n + wall.side.i64()) % 2 != 0 else 0x2e283eff
            frame: u32 = ScenePolish::mix_rgb(wood, 0x000000ff, 0.5)
            for k in 0..<2 |list, view, wall, glass, frame|:
                f: f64 = 0.12 if k == 0 else 0.62
                quad(list, wall_point(view, wall, f, 3.3), wall_point(view, wall, f + 0.24, 3.3),
                    wall_point(view, wall, f + 0.24, 4.5), wall_point(view, wall, f, 4.5), frame)
                quad(list, wall_point(view, wall, f + 0.03, 3.42), wall_point(view, wall, f + 0.21, 3.42),
                    wall_point(view, wall, f + 0.21, 4.38), wall_point(view, wall, f + 0.03, 4.38), glass)
                SceneHand::line(list, wall_point(view, wall, f + 0.12, 3.42), wall_point(view, wall, f + 0.12, 4.38), 1.0, 0x281c1eff)
            quad(list, wall_point(view, wall, 0.4, 0.3), wall_point(view, wall, 0.58, 0.3),
                wall_point(view, wall, 0.58, 2.3), wall_point(view, wall, 0.4, 2.3), 0x302022ff)
            quad(list, wall_point(view, wall, 0.1, 0.9), wall_point(view, wall, 0.32, 0.9),
                wall_point(view, wall, 0.32, 2.1), wall_point(view, wall, 0.1, 2.1),
                0xffc46eff if (n + wall.side.i64()) % 3 != 0 else 0x2e283eff)
            walk: u32 = ScenePolish::mix_rgb(0x785c46ff, DUSK, 0.15)
            quad(list, wall_point(view, wall, 0.0, 0.3), wall_point(view, wall, 1.0, 0.3),
                wall_point(view, wall, 1.0, 0.3, -1.7), wall_point(view, wall, 0.0, 0.3, -1.7), walk)
            quad(list, wall_point(view, wall, 0.0, 0.0, -1.7), wall_point(view, wall, 1.0, 0.0, -1.7),
                wall_point(view, wall, 1.0, 0.3, -1.7), wall_point(view, wall, 0.0, 0.3, -1.7), ScenePolish::mix_rgb(walk, 0x000000ff, 0.4))
            for k in 0..<3 |list, view, wall|:
                f: f64 = 0.03 + 0.47 * k.f64()
                SceneHand::line(list, wall_point(view, wall, f, 0.3, -1.6), wall_point(view, wall, f, 2.7, -1.6), 3.0, 0x463028ff)
            quad(list, wall_point(view, wall, 0.0, 3.0), wall_point(view, wall, 1.0, 3.0),
                wall_point(view, wall, 1.0, 2.65, -1.8), wall_point(view, wall, 0.0, 2.65, -1.8), ScenePolish::mix_rgb(wood, 0x1e1018ff, 0.45))

    def building(list: mutable Display::DisplayList&, view: HandView::Lens&, side: i64, n: i64):
        can Memory.Allocate, Abort.Panic:
            colors: u32[6] = [0x966846ff, 0x805c42ff, 0xa47a54ff, 0x70503cff, 0x8e6e56ff, 0x78604eff]
            pick: i64 = (n * 5 + (2 if side > 0 else 0)) % 6
            lit: u32 = ScenePolish::mix_rgb(colors[pick.usize()], DUSK, 0.18)
            wood: u32 = ScenePolish::mix_rgb(lit, 0x281832ff, 0.35) if side > 0 else lit
            height: f64 = 5.0 + 1.2 * ((n * 7 + side + 3) % 3).f64()
            wall: Wall = Wall{x: side.f64() * 7.0, side: side.f64(), z: -5.0 - 7.2 * n.f64()}
            out: f64 = wall.side * 12.5
            z: f64 = wall.z
            quad(list, project(view, wall.x, 0.0, z), project(view, out, 0.0, z),
                project(view, out, height, z), project(view, wall.x, height, z), ScenePolish::mix_rgb(wood, 0x1e121eff, 0.3))
            storefront(list, view, &wall, height, wood, n)
            a: RoomsView::Vec = project(view, wall.x + wall.side * 0.6, height - 1.5, z)
            b: RoomsView::Vec = project(view, out - wall.side * 0.6, height - 0.5, z)
            return if a.z < 0.05 or b.z < 0.05
            quad(list, a, screen(b.x, a.y), b, screen(a.x, b.y), 0xe8d6aaff)
            wide: f64 = HandView::absolute(b.x - a.x)
            return if wide <= 40.0 or a.x <= 15.0 or b.x <= 15.0 or a.x >= 985.0 or b.x >= 985.0 or a.y >= 560.0 or b.y >= 560.0
            word: sview = sign(n * 2 + (1 if side > 0 else 0))
            h: f64 = HandView::absolute(b.y - a.y) * 0.55
            w: f64 = wide / (sview_len(word).f64() * 0.95)
            SceneHand::word(list, word, (a.x + b.x) / 2.0, (a.y + b.y) / 2.0, h if h < w else w, 0x46221aff, true)

    def shadow(list: mutable Display::DisplayList&, view: HandView::Lens&, run: Gunslinger::Run&, index: i64):
        can Memory.Allocate, Abort.Panic:
            return if run.fell == index
            p: RoomsView::Vec = Gunslinger::stands(run, index)
            quad(list, project(view, p.x - 0.3, 0.0, p.z), project(view, p.x + 0.3, 0.0, p.z),
                project(view, p.x + 1.65, 0.0, p.z + 5.5), project(view, p.x + 0.75, 0.0, p.z + 5.5), 0x46282c6e)

    def tumbleweed(list: mutable Display::DisplayList&, view: HandView::Lens&, run: Gunslinger::Run&):
        can Memory.Allocate, Abort.Panic:
            return if run.duel.level.rung < 4
            offset: f64 = run.time * 0.11
            u: f64 = offset - offset.i64().f64()
            hop: f64 = 0.35 + 0.3 * HandView::absolute(sin(run.time * 3.0))
            q: RoomsView::Vec = project(view, -9.0 + 18.0 * u, hop, -7.5)
            return if q.z < 0.05
            radius: f64 = view.focal * 0.35 / q.z
            disc(list, q, radius, 0x96704696)
            for n in 0..<6 |list, q, run, radius|:
                a: f64 = run.time * 4.0 + n.f64() * 1.05
                dx: f64 = radius * cos(a)
                dy: f64 = radius * sin(a)
                SceneHand::line(list, screen(q.x - dx, q.y - dy), screen(q.x + dx, q.y + dy), 1.5, 0x684a2eff)

    def around(figure: Figure&, x: f64, y: f64) -> RoomsView::Vec:
        return screen(figure.x + x * figure.unit, figure.y + y * figure.unit)

    def figure_rect(list: mutable Display::DisplayList&, figure: Figure&, x: f64, y: f64, w: f64, h: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            p: RoomsView::Vec = around(figure, x, y)
            rect(list, p.x, p.y, w * figure.unit, h * figure.unit, colour)

    def hat_shape(list: mutable Display::DisplayList&, figure: Figure&, colour: u32, tilted: bool):
        can Memory.Allocate, Abort.Panic:
            d: f64 = 0.05 if tilted else 0.0
            quad(list, around(figure, -0.36, -d), around(figure, 0.36, d),
                around(figure, 0.3, 0.06 + d), around(figure, -0.3, 0.06 - d), colour)
            points: mutable RoomsView::Vec[32] = zeroed
            points[0] <- around(figure, -0.2, 0.05)
            points[1] <- around(figure, 0.2, 0.05)
            points[2] <- around(figure, 0.17, 0.3)
            points[3] <- around(figure, 0.0, 0.26)
            points[4] <- around(figure, -0.17, 0.3)
            SceneHand::polygon(list, &points, 5, colour)
            figure_rect(list, figure, -0.2, 0.06, 0.4, 0.05, ScenePolish::mix_rgb(colour, 0x000000ff, 0.5))

    def hat_at(list: mutable Display::DisplayList&, figure: Figure&, x: f64, y: f64, colour: u32, tilted: bool):
        can Memory.Allocate, Abort.Panic:
            p: RoomsView::Vec = around(figure, x, y)
            hat: Figure = Figure{x: p.x, y: p.y, unit: figure.unit}
            hat_shape(list, &hat, colour, tilted)

    def armed_side(list: mutable Display::DisplayList&, run: Gunslinger::Run&, j: i64, figure: Figure&, dark: u32):
        can Memory.Allocate, Abort.Panic:
            u: f64 = figure.unit
            quad(list, around(figure, -0.36, 1.5), around(figure, -0.27, 1.5),
                around(figure, -0.3, 0.92), around(figure, -0.4, 0.92), dark)
            disc(list, around(figure, -0.35, 0.88), 0.05 * u, SKIN)
            arm: f64 = Gunslinger::arm(run, j)
            start: RoomsView::Vec = around(figure, 0.31, 1.47)
            angle: f64 = -1.5707963267948966 + 0.12 + arm * (1.5707963267948966 + 0.05)
            reach: f64 = 0.6 * u * (1.0 - 0.45 * arm)
            hand: RoomsView::Vec = screen(start.x + reach * cos(angle), start.y + reach * sin(angle))
            if arm < 0.75:
                quad(list, around(figure, 0.27, 0.62), around(figure, 0.4, 0.62),
                    around(figure, 0.39, 0.9), around(figure, 0.28, 0.9), 0x462a18ff)
                figure_rect(list, figure, 0.3, 0.88, 0.07, 0.1, 0x1e1c1eff)
            SceneHand::line(list, start, hand, 0.13 * u if 0.13 * u > 2.5 else 2.5, dark)
            disc(list, hand, 0.055 * u if 0.055 * u > 2.0 else 2.0, SKIN)
            if arm >= 0.75:
                disc(list, hand, 0.085 * u if 0.085 * u > 3.0 else 3.0, 0x18181cff)
                disc(list, hand, 0.035 * u if 0.035 * u > 1.2 else 1.2, 0x000000ff)
                if run.result == Gunslinger::TOO_SLOW and j == run.duel.foe and run.fell < 0:
                    disc(list, hand, 0.5 * u, 0xffc85096)
                    disc(list, hand, 0.28 * u, 0xfff4c8e6)

    def man(list: mutable Display::DisplayList&, view: HandView::Lens&, run: Gunslinger::Run&, j: i64):
        can Memory.Allocate, Abort.Panic:
            feet: RoomsView::Vec = HandView::see(view, Gunslinger::stands(run, j))
            return if feet.z < 0.05
            u: f64 = view.focal / feet.z
            figure: Figure = Figure{x: feet.x, y: feet.y, unit: u}
            coats: u32[6] = [0x4a3c34ff, 0x624e3aff, 0x383e4eff, 0x583a38ff, 0x464a3cff, 0x3c3442ff]
            hats: u32[6] = [0xcc342cff, 0x1a181cff, 0xece6d6ff, 0x348446ff, 0x7e522cff, 0x3c64c4ff]
            coat: u32 = ScenePolish::mix_rgb(coats[j.usize()], DUSK, 0.12)
            dark: u32 = ScenePolish::mix_rgb(coat, 0x000000ff, 0.45)
            hat: u32 = hats[run.duel.men[j.usize()].hat.usize()]
            if run.fell == j:
                quad(list, around(&figure, -0.95, 0.0), around(&figure, 0.75, 0.0),
                    around(&figure, 0.8, 0.3), around(&figure, -0.9, 0.34), coat)
                disc(list, around(&figure, 0.95, 0.17), 0.15 * u, SKIN)
                quad(list, around(&figure, -1.3, 0.0), around(&figure, -0.95, 0.0),
                    around(&figure, -0.95, 0.2), around(&figure, -1.3, 0.26), 0x281e1eff)
                hat_at(list, &figure, 1.45, 0.0, hat, true)
                return
            hatless: bool = (run.hatless & (1 << j)) != 0
            if hatless:
                hat_at(list, &figure, -0.9, -0.02, hat, true)
            for k in 0..<2 |list, figure|:
                side: f64 = -1.0 if k == 0 else 1.0
                x: f64 = side * 0.17
                quad(list, around(&figure, x - 0.1, 0.0), around(&figure, x + 0.16, 0.0),
                    around(&figure, x + 0.1, 0.34), around(&figure, x - 0.09, 0.34), 0x241a1aff)
                quad(list, around(&figure, x - 0.1, 0.3), around(&figure, x + 0.1, 0.3),
                    around(&figure, x + 0.09 - side * 0.04, 0.95), around(&figure, x - 0.09 - side * 0.04, 0.95), 0x342c32ff)
            quad(list, around(&figure, -0.33, 0.52), around(&figure, 0.33, 0.52),
                around(&figure, 0.29, 1.52), around(&figure, -0.29, 1.52), coat)
            quad(list, around(&figure, -0.1, 0.9), around(&figure, 0.1, 0.9),
                around(&figure, 0.07, 1.5), around(&figure, -0.07, 1.5), 0xd6c8b0ff)
            quad(list, around(&figure, -0.33, 0.52), around(&figure, -0.1, 0.52),
                around(&figure, -0.09, 1.5), around(&figure, -0.29, 1.52), (dark & 0xffffff00) | 120.u32())
            quad(list, around(&figure, -0.31, 0.9), around(&figure, 0.31, 0.84),
                around(&figure, 0.31, 0.93), around(&figure, -0.31, 0.99), 0x3c2416ff)
            figure_rect(list, &figure, -0.035, 0.89, 0.07, 0.07, 0xdcbe5aff)
            quad(list, around(&figure, -0.3, 1.5), around(&figure, 0.3, 1.5),
                around(&figure, 0.22, 1.58), around(&figure, -0.22, 1.58), dark)
            triangle(list, around(&figure, -0.12, 1.47), around(&figure, 0.12, 1.47),
                around(&figure, 0.0, 1.33), 0xaa2824ff)
            figure_rect(list, &figure, -0.05, 1.55, 0.1, 0.08, SKIN)
            disc(list, around(&figure, 0.0, 1.71), 0.135 * u, SKIN)
            figure_rect(list, &figure, -0.13, 1.62, 0.26, 0.05, 0x3c281eff)
            if not hatless:
                hat_at(list, &figure, 0.0, 1.8, hat, false)
            armed_side(list, run, j, &figure, dark)

    def people(list: mutable Display::DisplayList&, view: HandView::Lens&, run: Gunslinger::Run&):
        can Memory.Allocate, Abort.Panic:
            men: mutable i64[6] = zeroed
            for j in 0..<run.duel.level.men |run, men|:
                slot: mutable i64 = j
                z: f64 = run.duel.men[j.usize()].z
                while slot > 0 |run, men, slot, z|:
                    prev: i64 = men[(slot - 1).usize()]
                    break if run.duel.men[prev.usize()].z >= z
                    men[slot.usize()] <- prev
                    slot <- slot - 1
                men[slot.usize()] <- j
            for j in 0..<run.duel.level.men |list, view, run, men|:
                shadow(list, view, run, men[j.usize()])
            tumbleweed(list, view, run)
            for j in 0..<run.duel.level.men |list, view, run, men|:
                man(list, view, run, men[j.usize()])

    def along(gun: Revolver&, f: f64, w: f64) -> RoomsView::Vec:
        return screen(gun.x + gun.dx * f + gun.nx * w, gun.y + gun.dy * f + gun.ny * w)

    def gun_band(list: mutable Display::DisplayList&, gun: Revolver&, start: f64, end: f64,
                 back: f64, front: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            quad(list, along(gun, start, back), along(gun, end, front), along(gun, end, -front),
                along(gun, start, -back), colour)

    def revolver(list: mutable Display::DisplayList&, run: Gunslinger::Run&, aim: RoomsView::Point):
        can Memory.Allocate, Abort.Panic:
            interval: f64 = run.time - run.shots[(run.shot_count - 1).usize()].time if run.shot_count > 0 else 0.14
            kick: f64 = 1.0 - interval / 0.14 if interval < 0.14 else 0.0
            x: f64 = 650.0 + 0.4 * (aim.x - 500.0)
            y: f64 = -130.0 + 0.08 * aim.y + 30.0 * kick
            dx: f64 = 0.3 * (aim.x - x)
            muzzle: f64 = y + 290.0 + 0.2 * (aim.y - 300.0)
            ceiling: f64 = aim.y - 130.0
            dy: f64 = (muzzle if muzzle < ceiling else ceiling) + 36.0 * kick - y
            norm: f64 = py_hypot(dx, dy)
            scale: f64 = norm if norm > 0.0 else 1.0
            gun: Revolver = Revolver{x: x, y: y, dx: dx, dy: dy, nx: dy / scale, ny: -dx / scale}
            quad(list, screen(x - 150.0, -10.0), screen(x + 230.0, -10.0), along(&gun, 0.2, 78.2), along(&gun, 0.2, -78.2), 0x42322cff)
            gun_band(list, &gun, 0.12, 0.5, 74.8, 61.2, SKIN)
            gun_band(list, &gun, 0.3, 0.62, 51.0, 51.0, 0x54341eff)
            gun_band(list, &gun, 0.55, 0.8, 57.8, 51.0, STEEL)
            for k in 0..<3 |list, gun|:
                w: f64 = (k - 1).f64() * 18.0
                SceneHand::line(list, along(&gun, 0.57, w * 1.7), along(&gun, 0.79, w * 1.5), 2.0, 0x1e1e24ff)
            gun_band(list, &gun, 0.78, 1.0, 22.1, 17.0, ScenePolish::mix_rgb(STEEL, 0xffffffff, 0.12))
            gun_band(list, &gun, 0.97, 1.04, 6.8, 5.1, 0x141418ff)
            hammer: f64 = 0.42 if run.cocked else 0.52
            gun_band(list, &gun, hammer, hammer + 0.1, 11.9, 10.2, 0x1c1c20ff)
            quad(list, along(&gun, 0.34, 68.0), along(&gun, 0.5, 74.8), along(&gun, 0.5, 37.4), along(&gun, 0.36, 34.0),
                ScenePolish::mix_rgb(SKIN, 0x000000ff, 0.12))
            if kick > 0.4:
                p: RoomsView::Vec = along(&gun, 1.08, 0.0)
                disc(list, p, 110.0 * kick, 0xffbe468c)
                disc(list, p, 60.0 * kick, 0xfff0bee6)

    def sight(list: mutable Display::DisplayList&, aim: RoomsView::Point):
        can Memory.Allocate, Abort.Panic:
            for layer in 0..<2 |list, aim|:
                width: f64 = 5.0 if layer == 0 else 2.2
                colour: u32 = 0x000000aa if layer == 0 else 0xfffaebff
                for k in 0..<28 |list, aim, width, colour|:
                    a: f64 = TAU * k.f64() / 28.0
                    b: f64 = TAU * (k + 1).f64() / 28.0
                    SceneHand::line(list, screen(aim.x + 17.0 * cos(a), aim.y + 17.0 * sin(a)),
                        screen(aim.x + 17.0 * cos(b), aim.y + 17.0 * sin(b)), width, colour)
                for k in 0..<4 |list, aim, width, colour|:
                    x: f64 = 1.0 if k == 0 else (-1.0 if k == 1 else 0.0)
                    y: f64 = 1.0 if k == 2 else (-1.0 if k == 3 else 0.0)
                    SceneHand::line(list, screen(aim.x + 9.0 * x, aim.y + 9.0 * y),
                        screen(aim.x + 27.0 * x, aim.y + 27.0 * y), width, colour)
            disc(list, screen(aim.x, aim.y), 2.4, 0xff3c28ff)

    def hud(list: mutable Display::DisplayList&, run: Gunslinger::Run&):
        can Memory.Allocate, Abort.Panic:
            for k in 0..<run.shot_count |list, run|:
                shot: Gunslinger::Shot = run.shots[k.usize()]
                if run.time - shot.time < 0.1:
                    disc(list, screen(shot.point.x, shot.point.y), 12.0, 0xfff0bec8)
            disc(list, screen(70.0, 70.0), 40.0, 0x1e1c20e6)
            rect(list, 36.0, 572.0, 928.0, 58.0, 0x3c2418ff)
            if run.duel.level.cock:
                rect(list, 120.0, 52.0, 116.0, 30.0, 0x1e1410dc)
            disc(list, screen(70.0, 70.0), 36.0, 0x585a64ff)
            rect(list, 42.0, 577.0, 916.0, 48.0, 0xecdab0ff)
            if run.duel.level.cock:
                disc(list, screen(136.0, 67.0), 7.0, 0x6ef082ff if run.cocked else 0xe64632ff)
                SceneHand::word(list, "COCKED" if run.cocked else "SPACE", 186.0, 67.0, 12.0, 0xfff0d2ff, true)
            warning: bool = run.duel.level.word and Gunslinger::drawn(run) and run.result == Gunslinger::PENDING
            if warning:
                SceneHand::word(list, "DRAW!", 503.0, 487.0, 54.0, 0x280a0aff, true)
            if run.result == Gunslinger::TOO_SLOW:
                rect(list, 0.0, 0.0, 1000.0, 640.0, 0xc814145a)
            disc(list, screen(70.0, 70.0), 6.0, 0x1e1c20ff)
            for k in 0..<Gunslinger::BULLETS |list, run|:
                a: f64 = 1.5707963267948966 + TAU * k.f64() / Gunslinger::BULLETS.f64()
                disc(list, screen(70.0 + 22.0 * cos(a), 70.0 + 22.0 * sin(a)), 8.0,
                    0xe8ba54ff if k < run.bullets else 0x222024ff)
            disc(list, screen(54.0, 601.0), 4.0, 0x3c3232ff)
            disc(list, screen(946.0, 601.0), 4.0, 0x3c3232ff)
            notice: sview = bytes_view(run.duel.notice)
            scale: f64 = 1080.0 / sview_len(notice).f64()
            SceneHand::word(list, notice, 500.0, 601.0, scale if scale < 17.0 else 17.0, 0x401e14ff, true)
            if warning:
                SceneHand::word(list, "DRAW!", 500.0, 490.0, 54.0, 0xff4628ff, true)

    def duel(list: mutable Display::DisplayList&, run: Gunslinger::Run&):
        can Memory.Allocate, Abort.Panic:
            SceneHand::card(list, 0x281a1eff)
            view: HandView::Lens = Gunslinger::view(run)
            far: RoomsView::Vec = project(&view, 0.0, 0.0, -600.0)
            h: f64 = far.y if far.z >= 0.05 else 300.0
            sky(list, &view, run.time, h)
            street(list, &view, h)
            for i in 0..<12 |list, view|:
                side: i64 = -1 if i < 6 else 1
                building(list, &view, side, 5 - i % 6)
            people(list, &view, run)
            thick: f64 = Gunslinger::dust(run)
            if thick > 0.01:
                rect(list, 0.0, 0.0, 1000.0, 640.0, Display::rgba(226, 190, 140, (255.0 * thick).i64()))
            aim: RoomsView::Point = Gunslinger::aim(run)
            revolver(list, run, aim)
            sight(list, aim)
            hud(list, run)

    def render(list: mutable Display::DisplayList&, session: GunslingerGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Gunslinger", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Mouse: aim   Click: shoot, once he has gone for his gun\nSpace: cock the hammer   Esc: menu",
                456.0, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            status: mutable dstr = []
            if session.phase == GunslingerGame::READY:
                dstr_append_cstr(&status, "Could not deal a duel. Press Space or click to retry." if session.deal_failed else "Press Space or click to start")
            elif session.phase == GunslingerGame::DONE:
                dstr_append_i64(&status, session.passed)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best)
            elif session.phase == GunslingerGame::JUDGED:
                dstr_append_sview(&status, Gunslinger::result_text(session.run.result))
            else:
                dstr_append_cstr(&status, "Hold your fire until he goes for his gun")
            Display::draw_text(list, bytes_view(status), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if session.phase >= GunslingerGame::JUDGED and session.run.result != Gunslinger::PENDING:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, Gunslinger::passed(session.run.result),
                    Gunslinger::result_text(session.run.result), 60.0, 16.0)
            return if session.phase == GunslingerGame::READY or session.phase == GunslingerGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, session.run.bullets)
            dstr_append_cstr(&facts, " rounds")
            Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            duel(list, &session.run)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Gunslinger::Grade = Gunslinger::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": he fires ")
            dstr_append_fixed(out, level.quick, 1)
            dstr_append_cstr(out, " seconds after he draws.")
            if level.cock:
                dstr_append_cstr(out, "  Cock the hammer.")
            if level.men > 1:
                dstr_append_cstr(out, "  ")
                dstr_append_i64(out, level.men)
                dstr_append_cstr(out, " men in the street.")
            if level.feints > 0:
                dstr_append_cstr(out, "  He feints.")
