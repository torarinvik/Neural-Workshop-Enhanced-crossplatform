include "./tasks/toneofvoice_game.elisa"
include "./tasks/toneofvoice_audio.elisa"
include "./scene_reading_quiz.elisa"

module SceneToneOfVoice:
    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            g: ToneOfVoice::Grade = ToneOfVoice::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, g.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, g.choices)
            dstr_append_cstr(out, " emotions to choose from.")
            if g.hiss > 0.0:
                dstr_append_cstr(out, "  A hiss behind the voice.")
            if g.cut > 0.0:
                dstr_append_cstr(out, "  Only ")
                tenths: i64 = py_round_half_even(g.cut * 10.0)
                dstr_append_i64(out, tenths / 10)
                dstr_append_cstr(out, ".")
                dstr_append_i64(out, tenths % 10)
                dstr_append_cstr(out, " s of each voice.")

    def verdict(run: ReadingQuiz::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_i64(out, run.right)
            dstr_append_cstr(out, " of ")
            dstr_append_i64(out, run.round.items.count.i64())
            dstr_append_cstr(out, " right")
            if run.result == ReadingQuiz::FAILED:
                dstr_append_cstr(out, ", ")
                dstr_append_i64(out, run.round.need)
                dstr_append_cstr(out, " needed")

    # _playing: the voice is heard, the first time or the second.
    def playing(run: ReadingQuiz::Run&, voices: darray[darray[f64]]&) -> bool:
        can Abort.Panic:
            return false if run.showing or run.index >= run.round.items.count.i64() or run.index >= voices.count.i64()
            n: f64 = voices[run.index.usize()].count.i64().f64() / ToneOfVoice::RATE.f64()
            t: f64 = run.time - run.since - ToneOfVoice::LEAD
            return (t >= 0.0 and t <= n) or (t >= n + ToneOfVoice::GAP and t <= 2.0 * n + ToneOfVoice::GAP)

    def segment(list: mutable Display::DisplayList&, x1: f64, y1: f64, x2: f64, y2: f64, width: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_line(list, SceneHand::x(x1), SceneHand::y(y1), SceneHand::x(x2), SceneHand::y(y2), width * SceneHand::SCALE, colour)

    # ToneOfVoice._show: a speaker, its rings while the voice plays, and
    # the words said.
    def speaker(list: mutable Display::DisplayList&, run: ReadingQuiz::Run&, voices: darray[darray[f64]]&, item: ReadingQuiz::Item&):
        can Memory.Allocate, Abort.Panic:
            x: f64 = 60.0
            y: f64 = 180.0
            SceneMissingWord::rect(list, x, y, 880.0, 380.0, SceneReadingQuiz::PAPER)
            cx: f64 = 500.0
            cy: f64 = y + 380.0 * 0.62
            body: u32 = 0x46465aff
            SceneMissingWord::rect(list, cx - 70.0, cy - 22.0, 26.0, 44.0, body)
            segment(list, cx - 44.0, cy + 22.0, cx - 10.0, cy + 50.0, 4.0, body)
            segment(list, cx - 44.0, cy - 22.0, cx - 10.0, cy - 50.0, 4.0, body)
            segment(list, cx - 10.0, cy + 50.0, cx - 10.0, cy - 50.0, 4.0, body)
            if playing(run, voices):
                for k in 0..<3 |list, run, cx, cy|:
                    r: f64 = 22.0 + 18.0 * k.f64() + 6.0 * sin(run.time * 9.0 - k.f64())
                    ring: u32 = 0x5078c800.u32() | (200 - 50 * k).u32()
                    Display::draw_circle(list, SceneHand::x(cx + 10.0 + r * 0.2), SceneHand::y(cy), 3.0 * SceneHand::SCALE, ring)
                    for j in -3..<4 |list, r, cx, cy, ring|:
                        angle: f64 = j.f64() * 0.22
                        Display::draw_circle(list, SceneHand::x(cx + 4.0 + r * cos(angle)), SceneHand::y(cy + r * sin(angle)),
                            2.4 * SceneHand::SCALE, ring)
            SceneHand::word(list, bytes_view(item.prompt), 500.0, y + 70.0, 20.0, SceneReadingQuiz::INK)
            SceneHand::word(list, "the same words, said one way", 500.0, y + 36.0, 10.0, SceneReadingQuiz::DIM)

    # FeelingTask._scene with the speaker for the text box.
    def page(list: mutable Display::DisplayList&, run: ReadingQuiz::Run&, voices: darray[darray[f64]]&):
        can Memory.Allocate, Abort.Panic:
            SceneReadingQuiz::dots(list, run)
            # By reference: natively a by-value copy of the item (or its step)
            # here left the run's own item empty for every later frame.
            return if run.index < 0 or run.index >= run.round.items.count.i64()
            item: ReadingQuiz::Item& = &run.round.items[run.index.usize()]
            count: i64 = item.steps.count.i64()
            return if count == 0
            SceneHand::word(list, sview(item.title, 0, -1), 500.0, 582.0, 11.0, SceneReadingQuiz::DIM, true)
            speaker(list, run, voices, item)
            shown: i64 = count - 1 if run.showing else run.progress
            return if not run.showing and (run.result != ReadingQuiz::LIVE or run.progress >= count)
            step: ReadingQuiz::Step& = &item.steps[shown.usize()]
            return if step.options.count == 0.usize()
            ask: mutable dstr = []
            color: mutable u32 = SceneReadingQuiz::PALE
            if run.showing:
                color <- 0x8ce6a0ff if run.correct else 0xff9682ff
                dstr_append_cstr(&ask, "Right: " if run.correct else "No: ")
                dstr_append_dstr(&ask, item.truth)
            else:
                dstr_append_dstr(&ask, step.ask)
            SceneReadingQuiz::paragraph(list, bytes_view(ask), 500.0, 150.0, 13.0, 900.0, color, false, false, true)
            SceneReadingQuiz::buttons(list, step, run.showing, run.selected)
            if not run.showing:
                share: f64 = fmax(0.0, item.seconds - (run.time - run.since)) / item.seconds
                SceneMissingWord::rect(list, 20.0, 8.0, 960.0 * share, 6.0, 0x6ec88cff if share > 0.3 else 0xe66e50ff)

    def render(list: mutable Display::DisplayList&, session: ToneOfVoiceGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            SceneMissingWord::label(list, "Tone of Voice", 648.0, 22.0, ink, true)
            SceneMissingWord::label(list, "Listen, then click an answer or press its number", 26.0, 12.0, ink)
            message: mutable dstr = []
            if session.phase == ToneOfVoiceGame::READY:
                dstr_append_cstr(&message, "Press Space or click to start")
            elif session.phase == ToneOfVoiceGame::DONE:
                dstr_append_i64(&message, session.wins)
                dstr_append_cstr(&message, " of ")
                dstr_append_i64(&message, session.trial)
                dstr_append_cstr(&message, " passed   highest rung passed ")
                dstr_append_i64(&message, session.best_rung)
            elif session.phase == ToneOfVoiceGame::JUDGED:
                verdict(&session.run, &message)
            else:
                dstr_append_cstr(&message, "How does the speaker feel?")
            SceneMissingWord::label(list, bytes_view(message), 614.0, 14.0, ink)
            if session.phase == ToneOfVoiceGame::PLAYING or session.phase == ToneOfVoiceGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                SceneMissingWord::label(list, bytes_view(facts), 588.0, 12.0, ink)
                SceneHand::card(list, 0x2c3040ff)
                page(list, &session.run, &session.voices)
                SceneHand::progress(list, &session.hand, 0.0)
            if session.phase == ToneOfVoiceGame::JUDGED or session.phase == ToneOfVoiceGame::DONE:
                last: mutable dstr = []
                verdict(&session.run, &last)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.run.result == ReadingQuiz::PASSED,
                    bytes_view(last), 60.0, 16.0)
