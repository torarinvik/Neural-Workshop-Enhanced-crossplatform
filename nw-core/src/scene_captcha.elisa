include "./tasks/captcha_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./geometry.elisa"

module SceneCaptcha:
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const CX: f64 = WIDTH / 2.0
    const AREA_TOP: f64 = 568.0
    const AREA_HEIGHT: f64 = 389.0
    const AREA_WIDTH: f64 = WIDTH * 0.94
    const DEGREE: f64 = 0.017453292519943295

    def paper_box() -> SceneHiddenRule::Rect:
        scale: f64 = Captcha::least(AREA_WIDTH * 0.94 / Captcha::W, AREA_HEIGHT * 0.66 / Captcha::H)
        w: f64 = Captcha::W * scale
        h: f64 = Captcha::H * scale
        return SceneHiddenRule::Rect{x: CX - w / 2.0, y: AREA_TOP - h - AREA_HEIGHT * 0.04, w: w, h: h}

    def card(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&, radius: f64, body: u32, shade: i64, edge: u32):
        can Memory.Allocate, Abort.Panic:
            shares: f64[3] = [0.5, 0.3, 0.2]
            for layer in 0..<3 |list, box, radius, shade, shares, layer|:
                spread: f64 = layer.f64() * 2.0
                shadow: SceneHiddenRule::Rect = ScenePolish::spread_box(box, spread, 4.0)
                ScenePolish::rounded(list, &shadow, radius + spread, (shade.f64() * shares[layer.usize()]).u32())
            if edge != 0.u32():
                outline: SceneHiddenRule::Rect = ScenePolish::spread_box(box, 1.0)
                ScenePolish::rounded(list, &outline, radius + 1.0, edge)
            ScenePolish::rounded(list, box, radius, body)

    def stripes(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&, count: i64):
        can Memory.Allocate, Abort.Panic:
            for k in 0..<count |list, box, count, k|:
                centre: f64 = (k.f64() + 0.5) / count.f64()
                a: f64 = box.x + box.w * Captcha::greatest(0.0, centre - 0.03)
                b: f64 = box.x + box.w * Captcha::least(1.0, centre + 0.01)
                c: f64 = box.x + box.w * Captcha::least(1.0, centre + 0.07)
                d: f64 = box.x + box.w * Captcha::least(1.0, centre + 0.03)
                ink: u32 = (ScenePolish::mix_rgb(Captcha::ink(k % 6), 0xffffffff, 0.6) & 0xffffff00.u32()) | 70.u32()
                Display::begin_polygon(list, 4, a, box.y, ink)
                Display::polygon_point(list, a, box.y)
                Display::polygon_point(list, b, box.y)
                Display::polygon_point(list, c, box.y + box.h)
                Display::polygon_point(list, d, box.y + box.h)

    def letter(list: mutable Display::DisplayList&, char: u8, x: f64, y: f64, size: f64, angle: f64, face: i64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            text: mutable dstr = []
            text.push(char)
            Display::draw_faced_text(list, bytes_view(text), x, y, size, ink, angle, face)

    def arc(list: mutable Display::DisplayList&, x: f64, y: f64, r: f64, start: f64, sweep: f64, width: f64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            segments: i64 = Captcha::greatest(14.0, r / 1.25).i64()
            Display::begin_multiline(list, segments + 1, x + r * cos(start * DEGREE), y + r * sin(start * DEGREE), width, ink)
            for n in 0..<(segments + 1) |list, x, y, r, start, sweep, segments, n|:
                angle: f64 = (start + sweep * n.f64() / segments.f64()) * DEGREE
                Display::polygon_point(list, x + r * cos(angle), y + r * sin(angle))

    def mark(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&, scale: f64, m: Captcha::Mark&):
        can Memory.Allocate, Abort.Panic:
            x: f64 = box.x + m.points[0] * scale
            y: f64 = box.y + m.points[1] * scale
            if m.kind == Captcha::BLOB:
                radius: f64 = m.points[2] * scale
                segments: i64 = (radius / 1.25).i64()
                Display::begin_polygon(list, segments, x + radius, y, m.colour)
                for i in 0..<segments |list, x, y, radius, segments, i|:
                    angle: f64 = 6.283185307179586 * i.f64() / segments.f64()
                    Display::polygon_point(list, x + radius * cos(angle), y + radius * 0.6 * sin(angle))
            elif m.kind == Captcha::STRAY:
                letter(list, m.char, x, y, Captcha::greatest(5.0, m.points[2] * scale * 1.05),
                    m.points[3], m.face, m.colour)
            elif m.kind == Captcha::LINE:
                Display::draw_line(list, x, y, box.x + m.points[2] * scale, box.y + m.points[3] * scale,
                    Captcha::greatest(1.0, m.width * scale), m.colour)
            elif m.kind == Captcha::ARC:
                arc(list, x, y, m.points[2] * scale, m.points[3], m.points[4], Captcha::greatest(1.0, m.width * scale), m.colour)
            else:
                for i in 0..<8 |list, box, scale, m, i|:
                    p: usize = (i * 2).usize()
                    Display::draw_line(list, box.x + m.points[p] * scale, box.y + m.points[p + 1.usize()] * scale,
                        box.x + m.points[p + 2.usize()] * scale, box.y + m.points[p + 3.usize()] * scale,
                        Captcha::greatest(1.5, m.width * scale), m.colour)

    def picture(list: mutable Display::DisplayList&, puzzle: Captcha::Puzzle&, judged: bool):
        can Memory.Allocate, Abort.Panic:
            box: SceneHiddenRule::Rect = paper_box()
            scale: f64 = box.w / Captcha::W
            frame: SceneHiddenRule::Rect = ScenePolish::spread_box(&box, 8.0)
            card(list, &frame, 12.0, 0xfafafaff, 70, 0.u32())
            band: f64 = box.h / 16.0
            for i in 0..<16 |list, box, puzzle, band, i|:
                colour: u32 = ScenePolish::mix_rgb(puzzle.light, puzzle.other, (i.f64() + 0.5) / 16.0)
                Display::draw_rect(list, box.x, box.y + band * i.f64(), box.w, band + 1.0, colour)
            stripes(list, &box, puzzle.stripes)
            # Python assigns strikes group -7, below the glyph groups -5 to -3.
            for m in puzzle.marks |list, box, scale|:
                mark(list, &box, scale, &m)
            for layer in 0..<3 |layer, list, puzzle, box, scale|:
                for at in 0..<puzzle.glyphs.count.i64() |layer, list, puzzle, box, scale, at|:
                    if at % 3 == layer:
                        glyph: Captcha::Glyph = puzzle.glyphs[at.usize()]
                        letter(list, glyph.char, box.x + glyph.x * scale, box.y + glyph.y * scale,
                            Captcha::greatest(6.0, glyph.size * scale * 1.05), glyph.angle, glyph.face, Captcha::ink(glyph.colour))
            if judged:
                for glyph in puzzle.glyphs |list, box, scale|:
                    if glyph.real:
                        arc(list, box.x + glyph.x * scale, box.y + glyph.y * scale,
                            glyph.size * scale * 0.7, 0.0, 360.0, 3.0, 0x3cc86edc)

    def entry(list: mutable Display::DisplayList&, game: CaptchaGame::Session&):
        can Memory.Allocate, Abort.Panic:
            paper: SceneHiddenRule::Rect = paper_box()
            w: f64 = Captcha::least(paper.w, AREA_WIDTH * 0.6)
            h: f64 = Captcha::least(AREA_HEIGHT * 0.16, 70.0)
            y: f64 = paper.y - AREA_HEIGHT * 0.08 - h
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: CX - w / 2.0, y: y, w: w, h: h}
            card(list, &box, 10.0, 0xffffffff, 40, 0x96a0b4ff)
            shown: mutable dstr = []
            for i in 0..<game.length |shown, game, i|:
                shown.push(game.typed[i.usize()])
                shown.push(32.u8())
            shown.push(95.u8() if (game.phase == CaptchaGame::PLAYING or game.phase == CaptchaGame::FLAGGED) and game.cursor else 32.u8())
            Display::draw_text_weight(list, bytes_view(shown), CX, y + h / 2.0, h * 0.38, 0x1e222eff,
                Display::ANCHOR_CENTER_CENTER, true)

    def render(list: mutable Display::DisplayList&, game: CaptchaGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Captcha", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Type the characters   Backspace: rub out   Enter: submit   Esc: menu",
                CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            if game.phase == CaptchaGame::READY:
                Display::draw_text(list, "Press Space or click to start", CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            message: mutable dstr = []
            if game.phase == CaptchaGame::DONE:
                dstr_append_i64(&message, game.passed)
                dstr_append_cstr(&message, " of ")
                dstr_append_i64(&message, game.scored)
                dstr_append_cstr(&message, " passed   highest rung passed ")
                dstr_append_i64(&message, game.best)
                Display::draw_text(list, bytes_view(message), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            judged: bool = game.phase == CaptchaGame::JUDGED
            if judged:
                dstr_append_cstr(&message, "Right: " if game.won else "It said ")
                for c in game.puzzle.answer |message|:
                    message.push(c)
            else:
                Captcha::rule_text(&game.puzzle, &message)
            Display::draw_text(list, bytes_view(message), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, game.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, game.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, game.total)
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            picture(list, &game.puzzle, judged)
            entry(list, game)
            if game.phase == CaptchaGame::FLAGGED:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, false, "Out of time", 60.0, 16.0)
            elif judged:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, game.won, bytes_view(message), 60.0, 16.0)
