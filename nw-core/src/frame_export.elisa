# Python nwenv.export's packed, little-endian NWFB version 1 header.
module FrameExport:
    const HEADER_BYTES: i64 = 36

    def write_le(output: mutable u8&, offset: i64, value: u64, count: i64):
        can Abort.Panic:
            for index in 0..<count |index, output, offset, value|:
                output[(offset + index).usize()] <- (value >> (index * 8)).u8()

    def write_header(output: mutable u8&?, capacity: i64, sequence: u64,
                     timestamp_ns: u64, width: u32, height: u32, consumed: bool) -> i64:
        can Abort.Panic:
            return -1 if output == null or capacity < HEADER_BYTES
            frame: mutable u8& = output
            write_le(frame, 0, 0x4246574e.u64(), 4) # NWFB
            write_le(frame, 4, 1.u64(), 4)
            write_le(frame, 8, sequence, 8)
            write_le(frame, 16, timestamp_ns, 8)
            write_le(frame, 24, width.u64(), 4)
            write_le(frame, 28, height.u64(), 4)
            write_le(frame, 32, 1.u64() if consumed else 0.u64(), 4)
            return HEADER_BYTES
