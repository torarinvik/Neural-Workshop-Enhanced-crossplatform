include "./tasks/firebreak_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./verdict.elisa"
include "./geometry.elisa"

module SceneFirebreak:
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const HUD_INK: u32 = 0xf0f2f8ff
    const BLUE: u32 = 0xa0d2ffff

    struct Board:
        x: f64
        y: f64
        size: f64

    def board() -> Board:
        can Abort.Panic:
            bottom: f64 = Verdict::above_the_band(HEIGHT, Geometry::from_bottom_edge(HEIGHT, 58.0).f64()).f64()
            height: f64 = fmax(40.0, Geometry::from_top_edge(HEIGHT, 116.0).f64() - bottom)
            size: f64 = fmin(WIDTH * 0.94 / Firebreak::COLS.f64(), (height - height * 0.07) / Firebreak::ROWS.f64())
            return Board{x: (WIDTH - Firebreak::COLS.f64() * size) / 2.0, y: bottom, size: size}

    def hit(session: FirebreakGame::Session&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return FirebreakGame::START if session.phase == FirebreakGame::READY or session.phase == FirebreakGame::DONE
            return -1 if session.phase != FirebreakGame::PLAYING
            area: Board = board()
            col: i64 = floor((x - area.x) / area.size).i64()
            row: i64 = floor((y - area.y) / area.size).i64()
            return FirebreakGame::FIRST_CELL + row * Firebreak::COLS + col if Firebreak::inside(col, row) else -1

    def text(list: mutable Display::DisplayList&, words: sview, x: f64, y: f64, size: f64,
             ink: u32, anchor: u32 = Display::ANCHOR_CENTER_CENTER, bold: bool = false):
        can Abort.Panic, Memory.Allocate:
            Display::draw_text_weight(list, words, x, y, size, ink, anchor, bold)

    def ellipse(list: mutable Display::DisplayList&, x: f64, y: f64, rx: f64, ry: f64):
        can Abort.Panic, Memory.Allocate:
            Display::begin_polygon(list, 24, x + rx, y, 0xaca6a0ff)
            for k in 0..<24 |list, x, y, rx, ry|:
                angle: f64 = 6.283185307179586 * k.f64() / 24.0
                Display::polygon_point(list, x + rx * cos(angle), y + ry * sin(angle))

    def scenery_cell(list: mutable Display::DisplayList&, draw: mutable MT19937&, area: Board, index: i64, kind: i64, layer: i64):
        can Abort.Panic, Memory.Allocate:
            size: f64 = area.size
            x: f64 = area.x + (index % Firebreak::COLS).f64() * size
            y: f64 = area.y + (index / Firebreak::COLS).f64() * size
            tint: f64 = py_uniform(draw, -0.06, 0.06)
            if layer == 0:
                palette: u32[6] = [0x3a6c3cff, 0x98be5cff, 0x4288ceff, 0x8a8680ff, 0xdeceaaff, 0x7e5c3cff]
                hue: u32 = ScenePolish::mix_rgb(palette[kind.usize()], 0xffffffff if tint > 0.0 else 0x000000ff, fabs(tint))
                Display::draw_rect(list, x, y, size + 0.5, size + 0.5, hue)
            if kind == Firebreak::FOREST:
                for _ in 0..<3 |list, draw, x, y, size, layer|:
                    tx: f64 = x + py_uniform(draw, 0.2, 0.8) * size
                    ty: f64 = y + py_uniform(draw, 0.2, 0.8) * size
                    radius: f64 = size * py_uniform(draw, 0.2, 0.3)
                    leaf: u32 = ScenePolish::mix_rgb(0x285c30ff, 0x468648ff, py_random(draw))
                    if layer == 1:
                        Display::draw_circle(list, tx, ty, radius, leaf)
                    elif layer == 2:
                        Display::draw_circle(list, tx - radius * 0.3, ty + radius * 0.3, radius * 0.4, ScenePolish::mix_rgb(leaf, 0xffffffff, 0.2))
            elif kind == Firebreak::GRASS:
                for _ in 0..<3 |list, draw, x, y, size, layer|:
                    tx: f64 = x + py_uniform(draw, 0.15, 0.85) * size
                    ty: f64 = y + py_uniform(draw, 0.15, 0.75) * size
                    if layer == 1:
                        Display::draw_line(list, tx, ty, tx + size * 0.06, ty + size * 0.18, fmax(1.0, size * 0.05), 0x749c42ff)
            elif kind == Firebreak::WATER:
                ty: f64 = y + py_uniform(draw, 0.3, 0.7) * size
                if layer == 1:
                    Display::draw_line(list, x + size * 0.2, ty, x + size * 0.6, ty, fmax(1.0, size * 0.06), 0x82baecff)
            elif kind == Firebreak::ROCK:
                for _ in 0..<2 |list, draw, x, y, size, layer|:
                    tx: f64 = x + py_uniform(draw, 0.25, 0.75) * size
                    ty: f64 = y + py_uniform(draw, 0.3, 0.7) * size
                    radius: f64 = size * py_uniform(draw, 0.12, 0.22)
                    ellipse(list, tx, ty, radius, size * 0.12) if layer == 1
            elif kind == Firebreak::TOWN:
                bx: f64 = x + size * 0.2
                by: f64 = y + size * 0.15
                if layer == 1:
                    Display::draw_rect(list, bx, by, size * 0.6, size * 0.42, 0xf4ecdaff)
                elif layer == 2:
                    roofs: u32[4] = [0xcc523eff, 0x5270acff, 0xd4a23eff, 0x965a96ff]
                    Display::draw_triangle(list, bx - size * 0.08, by + size * 0.42, bx + size * 0.68, by + size * 0.42,
                        bx + size * 0.3, by + size * 0.78, roofs[(index % 4).usize()])
                    Display::draw_rect(list, bx + size * 0.24, by, size * 0.12, size * 0.2, 0x78543cff)

    def scenery(list: mutable Display::DisplayList&, area: Board, land: Firebreak::Land&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            border: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: area.x - 6.0, y: area.y - 6.0,
                w: Firebreak::COLS.f64() * area.size + 12.0, h: Firebreak::ROWS.f64() * area.size + 12.0}
            ScenePolish::card_face(list, &border, 14.0, 0x404a34ff, 0.u32(), 0.u32(), dark)
            seed: mutable u64 = 0.u64()
            for i in 0..<Firebreak::CELLS |land, seed|:
                seed <- seed + 1.u64() if land.terrain[i.usize()] == Firebreak::FOREST
            # Each pass consumes the same stream so grounds, decorations, and highlights retain their stacking.
            for layer in 0..<3 |list, area, land, seed|:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed)
                for i in 0..<Firebreak::CELLS |list, area, land, draw, layer|:
                    scenery_cell(list, &draw, area, i, land.terrain[i.usize()], layer)

    def burning(list: mutable Display::DisplayList&, blaze: Firebreak::Blaze&, index: i64, area: Board, flow: Firebreak::Wind, x: f64, y: f64, layer: i64):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            t: f64 = blaze.elapsed
            age: f64 = t - blaze.lit_at[index.usize()]
            fade: f64 = fmax(0.25, 1.0 - age / Firebreak::burn_time(blaze.terrain[index.usize()]))
            cx: f64 = x + s / 2.0
            cy: f64 = y + s / 2.0
            if layer == 0:
                Display::draw_rect(list, x, y, s + 0.5, s + 0.5, ScenePolish::mix_rgb(0xa83a16ff, 0x522216ff, 1.0 - fade))
            elif layer == 1:
                for k in 0..<3 |list, index, s, t, fade, cx, cy, flow|:
                    flick: f64 = 0.75 + 0.35 * sin(t * 13.0 + index.f64() * 1.7 + k.f64() * 2.0)
                    w: f64 = s * 0.22 * fade
                    h: f64 = s * 0.62 * fade * flick
                    fx: f64 = cx + (k - 1).f64() * s * 0.24
                    low: f64 = cy - s * 0.38
                    hue: u32 = Display::rgba(255, (110.0 + 60.0 * flick * fade).i64(), 30, 255)
                    Display::draw_triangle(list, fx - w, low, fx + w, low, fx + flow.x * s * 0.15, low + h, hue)
            elif layer == 2:
                Display::draw_circle(list, cx, y + s * 0.35, s * 0.18 * fade * (0.8 + 0.3 * sin(t * 17.0 + index.f64())), 0xffe26eff)
            else:
                top: f64 = area.y + Firebreak::ROWS.f64() * s
                for k in 0..<2 |list, index, t, s, flow, fade, top, cx, cy|:
                    progress: f64 = t * 0.5 + k.f64() * 0.5 + index.f64() * 0.37
                    phase: f64 = progress - floor(progress)
                    px: f64 = cx + flow.x * s * 2.0 * phase + sin(t + index.f64()) * s * 0.1
                    py: f64 = fmin(top - s * 0.3, cy + s * 0.3 + flow.y * s * 2.0 * phase + phase * s * 0.5)
                    hue: u32 = Display::rgba(90, 90, 96, (70.0 * (1.0 - phase) * fade).i64())
                    Display::draw_circle(list, px, py, s * (0.15 + 0.3 * phase), hue)

    def draw_overlays(list: mutable Display::DisplayList&, area: Board, blaze: Firebreak::Blaze&, flow: Firebreak::Wind, layer: i64):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            for i in 0..<Firebreak::CELLS |list, area, blaze, flow, s, layer|:
                index: usize = i.usize()
                x: f64 = area.x + (i % Firebreak::COLS).f64() * s
                y: f64 = area.y + (i / Firebreak::COLS).f64() * s
                if blaze.state[index] == Firebreak::BURNING:
                    burning(list, blaze, i, area, flow, x, y, layer)
                elif blaze.state[index] == Firebreak::ASH:
                    if layer == 0:
                        Display::draw_rect(list, x, y, s + 0.5, s + 0.5, 0x403c3aff)
                    elif layer == 1:
                        age: f64 = blaze.elapsed - blaze.lit_at[index] - Firebreak::burn_time(blaze.land.terrain[index])
                        hue: u32 = Display::rgba(220, 90, 40, fmax(0.0, 255.0 - age * 40.0).i64())
                        Display::draw_circle(list, x + s * 0.4, y + s * 0.45, s * 0.1, hue)
                elif blaze.terrain[index] == Firebreak::BREAK:
                    if layer == 0:
                        Display::draw_rect(list, x, y, s + 0.5, s + 0.5, 0x7e5c3cff)
                    elif layer == 1:
                        for k in 0..<3 |list, x, y, s|:
                            furrow: f64 = y + s * (0.25 + 0.25 * k.f64())
                            Display::draw_line(list, x + s * 0.12, furrow, x + s * 0.88, furrow, fmax(1.0, s * 0.07), 0x62462eff)

    def hud(list: mutable Display::DisplayList&, area: Board, blaze: Firebreak::Blaze&, flow: Firebreak::Wind):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            width: f64 = Firebreak::COLS.f64() * s
            top: f64 = area.y + Firebreak::ROWS.f64() * s
            cap: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: area.x, y: top + s * 0.25, w: width, h: s * 1.1}
            ScenePolish::rounded(list, &cap, s * 0.3, 0x282e28dc)
            ty: f64 = top + s * 0.8
            size: f64 = fmax(9.0, s * 0.42)
            shovel: mutable dstr = []
            dstr_append_cstr(&shovel, "shovels ")
            dstr_append_i64(&shovel, blaze.shovels)
            text(list, bytes_view(shovel), area.x + s * 0.6, ty, size, HUD_INK, Display::ANCHOR_LEFT_CENTER, true)
            active: mutable i64 = 0
            for i in 0..<Firebreak::CELLS |blaze, active|:
                active <- active + 1 if blaze.state[i.usize()] == Firebreak::BURNING
            counters: mutable dstr = []
            dstr_append_cstr(&counters, "burning ")
            dstr_append_i64(&counters, active)
            dstr_append_cstr(&counters, "   burned ")
            dstr_append_i64(&counters, Firebreak::burned(blaze))
            text(list, bytes_view(counters), area.x + width * 0.45, ty, size, HUD_INK)
            return if blaze.land.level.hidden_wind
            n: f64 = py_hypot(flow.x, flow.y)
            scale: f64 = n if n > 0.0 else 1.0
            ux: f64 = flow.x / scale
            uy: f64 = flow.y / scale
            ax: f64 = area.x + width - s * 2.2
            tx: f64 = ax + ux * s * 0.7
            y: f64 = ty + uy * s * 0.25
            Display::draw_line(list, ax - ux * s * 0.7, ty - uy * s * 0.25, tx, y, 3.0, BLUE)
            hs: f64 = s * 0.32
            Display::draw_triangle(list, tx + ux * hs, y + uy * hs,
                tx - uy * hs * 0.7, y + ux * hs * 0.7, tx + uy * hs * 0.7, y - ux * hs * 0.7, BLUE)
            text(list, "wind", ax - s * 1.5, ty, size * 0.9, BLUE, Display::ANCHOR_RIGHT_CENTER)

    def cursor(list: mutable Display::DisplayList&, area: Board, blaze: Firebreak::Blaze&):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            cx: f64 = area.x + (blaze.col.f64() + 0.5) * s
            cy: f64 = area.y + (blaze.row.f64() + 0.5) * s
            ready: bool = blaze.elapsed >= blaze.ready_at and blaze.shovels > 0
            ink: u32 = 0xffffffff if ready else 0xffbe3cff
            half: f64 = s * 0.55 * (1.0 + 0.08 * sin(blaze.elapsed * 8.0))
            Display::draw_box(list, cx - half, cy - half, half * 2.0, half * 2.0, ink, fmax(2.0, s * 0.1))
            if not ready and blaze.shovels > 0:
                share: f64 = 1.0 - (blaze.ready_at - blaze.elapsed) / blaze.land.level.dig
                ScenePolish::arc(list, cx, cy, s * 0.8, 1.5707963267948966,
                    6.283185307179586 * fmax(0.0, share), 3.0, ink)

    def verdict(session: FirebreakGame::Session&, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            if session.verdict == Firebreak::SAVED:
                dstr_append_cstr(out, "Town saved; ")
                dstr_append_i64(out, session.verdict_burned)
                dstr_append_cstr(out, " cells burned")
            elif session.verdict == Firebreak::TOWN_BURNED:
                dstr_append_cstr(out, "The fire reached the town")
            elif session.verdict == Firebreak::TIMEOUT:
                dstr_append_cstr(out, "Still burning when time ran out")

    def render(list: mutable Display::DisplayList&, session: FirebreakGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            text(list, "Firebreak", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            text(list, "arrows move (Shift: four)   Space or Enter: dig   click: dig there   Esc: menu", 456.0, 26.0, 12.0, ink)
            caption: mutable dstr = []
            verdict(session, &caption)
            status: mutable dstr = []
            if session.phase == FirebreakGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == FirebreakGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == FirebreakGame::JUDGED:
                status <- caption
            else:
                dstr_append_cstr(&status, "Cut firebreaks and save the town")
            text(list, bytes_view(status), 456.0, 614.0, 14.0, ink)
            if session.phase == FirebreakGame::PLAYING or session.phase == FirebreakGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   ")
                dstr_append_i64(&facts, session.blaze.elapsed.i64())
                dstr_append_cstr(&facts, " s")
                text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink)
                area: Board = board()
                blaze: Firebreak::Blaze& = &session.blaze
                flow: Firebreak::Wind = Firebreak::wind(blaze)
                scenery(list, area, &session.blaze.land, dark)
                draw_overlays(list, area, blaze, flow, 0)
                draw_overlays(list, area, blaze, flow, 1)
                draw_overlays(list, area, blaze, flow, 2)
                draw_overlays(list, area, blaze, flow, 3)
                hud(list, area, blaze, flow)
                cursor(list, area, blaze)
            if caption.count > 0:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, session.verdict == Firebreak::SAVED,
                    bytes_view(caption), 60.0, 16.0)

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            grade: Firebreak::Grade = Firebreak::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, grade.rung)
            dstr_append_cstr(out, ": two fires, a break takes " if grade.fires == 2 else ": one fire, a break takes ")
            dstr_append_cstr(out, "0.")
            fraction: i64 = py_round_half_even(grade.dig * 100.0)
            dstr_append_i64(out, fraction)
            dstr_append_cstr(out, " s to dig.")
            dstr_append_cstr(out, "  The wind turns.") if grade.shift
            dstr_append_cstr(out, "  Embers jump narrow breaks.") if grade.embers > 0.0
            dstr_append_cstr(out, "  The wind is shown only by the smoke.") if grade.hidden_wind
