include "./scene_hand.elisa"
include "./geometry.elisa"
include "./scene_verdict.elisa"
include "./tasks/conductor_game.elisa"

module SceneConductor:
    def point(x: f64, y: f64) -> RoomsView::Vec:
        return RoomsView::vec(x, y, 1.0)

    def see(view: HandView::Lens&, x: f64, y: f64, z: f64) -> RoomsView::Vec:
        return HandView::see(view, RoomsView::vec(x, y, z))

    def quad(list: mutable Display::DisplayList&, a: RoomsView::Vec, b: RoomsView::Vec,
            c: RoomsView::Vec, d: RoomsView::Vec, tint: u32):
        can Abort.Panic, Memory.Allocate:
            return if a.z < 0.05 or b.z < 0.05 or c.z < 0.05 or d.z < 0.05
            points: mutable RoomsView::Vec[32] = zeroed
            points[0] <- a
            points[1] <- b
            points[2] <- c
            points[3] <- d
            SceneHand::polygon(list, &points, 4, tint)

    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            Display::draw_rect(list, SceneHand::x(x), SceneHand::y(y), w * SceneHand::SCALE, h * SceneHand::SCALE, tint)

    def disc(list: mutable Display::DisplayList&, x: f64, y: f64, radius: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            Display::draw_circle(list, SceneHand::x(x), SceneHand::y(y), radius * SceneHand::SCALE, tint)

    def section_name(section: i64) -> cstr:
        return "strings" if section == 0
        return "woodwind" if section == 1
        return "brass" if section == 2
        return "drums"

    def backdrop(list: mutable Display::DisplayList&, view: HandView::Lens&):
        can Abort.Panic, Memory.Allocate:
            SceneHand::card(list, 0x1a1216ff)
            rect(list, 0.0, 0.0, 1000.0, 640.0, 0x28161eff)
            quad(list, see(view, -9.0, 0.0, -13.0), see(view, 9.0, 0.0, -13.0), see(view, 9.0, 7.0, -13.0),
                see(view, -9.0, 7.0, -13.0), 0x46222cff)
            for k in 0..<2 |list, view|:
                side: f64 = -1.0 if k == 0 else 1.0
                quad(list, see(view, side * 9.0, 0.0, -13.0), see(view, side * 6.5, 0.0, -13.0),
                    see(view, side * 6.5, 7.0, -13.0), see(view, side * 9.0, 7.0, -13.0), 0x962432ff)
            quad(list, see(view, -9.0, 0.0, -13.0), see(view, 9.0, 0.0, -13.0),
                see(view, 9.0, 0.0, 1.0), see(view, -9.0, 0.0, 1.0), 0x785638ff)
            quad(list, see(view, -3.0, 0.8, -12.0), see(view, 3.0, 0.8, -12.0),
                see(view, 3.0, 0.8, -8.6), see(view, -3.0, 0.8, -8.6), 0x886442ff)
            quad(list, see(view, -3.0, 0.0, -8.6), see(view, 3.0, 0.0, -8.6),
                see(view, 3.0, 0.8, -8.6), see(view, -3.0, 0.8, -8.6), 0x60442cff)

    def section(list: mutable Display::DisplayList&, view: HandView::Lens&, index: i64, on: bool, pulse: f64):
        can Abort.Panic, Memory.Allocate:
            tints: u32[4] = [0xc87846ff, 0x5aaa78ff, 0xe6be46ff, 0x966ebeff]
            tint: u32 = tints[index.usize()]
            color: u32 = tint if on else ScenePolish::mix_rgb(0x000000ff, tint, 0.3)
            seat: RoomsView::Vec = Conductor::seat(index)
            for i in 0..<5 |list, view, seat, on, pulse, color|:
                x: f64 = seat.x + (i - 2).f64() * 0.9
                z: f64 = seat.z - 0.5 * (i % 2).f64()
                foot: RoomsView::Vec = see(view, x, seat.y, z)
                head: RoomsView::Vec = see(view, x, seat.y + 1.3, z)
                continue if foot.z < 0.05 or head.z < 0.05
                wide: f64 = view.focal * 0.32 / foot.z
                top: f64 = head.y + (4.0 * pulse if on else 0.0)
                quad(list, point(foot.x - wide, foot.y), point(foot.x + wide, foot.y),
                    point(head.x + wide, top), point(head.x - wide, top), color)
                disc(list, head.x, top + wide, wide * 0.8, 0xecc8aaff if on else 0x504642ff)

    def pulse_of(run: Conductor::Run&) -> f64:
        can Abort.Panic:
            return 0.0 if run.next < 1
            return fmax(0.0, 1.0 - 4.0 * (run.time - run.piece.times[(run.next - 1).usize()]))

    def cue_words(out: mutable dstr&, cue: Conductor::Cue):
        can Abort.Panic, Memory.Allocate:
            dstr_append_cstr(out, "Beat ")
            dstr_append_i64(out, cue.beat)
            if cue.kind == Conductor::ENTER or cue.kind == Conductor::CUT:
                dstr_append_cstr(out, ": bring in the " if cue.kind == Conductor::ENTER else ": cut the ")
                dstr_append_cstr(out, section_name(cue.section))
                dstr_append_cstr(out, ".")
            else:
                dstr_append_cstr(out, ": louder." if cue.kind == Conductor::LOUD else ": softer.")

    def score(list: mutable Display::DisplayList&, run: Conductor::Run&, pulse: f64):
        can Abort.Panic, Memory.Allocate:
            rect(list, 20.0, 540.0, 960.0, 90.0, 0x100e14e1)
            row: mutable i64 = 0
            for j in 0..<run.piece.cues.count.i64() |list, run, row|:
                cue: Conductor::Cue = run.piece.cues[j.usize()]
                continue if run.done[j.usize()] or cue.beat <= run.judged
                text: mutable dstr = []
                cue_words(&text, cue)
                Display::draw_text_weight(list, bytes_view(text), SceneHand::x(180.0), SceneHand::y(610.0 - 26.0 * row.f64()),
                    (15.0 if row == 0 else 12.0) * SceneHand::SCALE, 0xffffffff if row == 0 else 0xaaaab4ff,
                    Display::ANCHOR_LEFT_CENTER, row == 0)
                row <- row + 1
                break if row == 3
            disc(list, 90.0, 585.0, 34.0 + 6.0 * pulse, ScenePolish::mix_rgb(0x3c323cff, 0xffc846ff, pulse))
            beat: i64 = Conductor::shown_beat(run)
            number: mutable dstr = []
            if beat == 0:
                dstr_append_cstr(&number, "·")
            else:
                dstr_append_i64(&number, beat)
            SceneHand::word(list, bytes_view(number), 90.0, 585.0, 24.0, 0x141014ff if pulse > 0.4 else 0xffffffff, true)
            loud: sview = "p" if run.loud == 0 else ("mf" if run.loud == 1 else "f")
            SceneHand::word(list, loud, 930.0, 600.0, 22.0, 0xffdc78ff, true)
            spare: mutable dstr = dstr_of_cstr("slips left: ")
            dstr_append_i64(&spare, run.piece.level.slips - run.slips if run.slips < run.piece.level.slips else 0)
            SceneHand::word(list, bytes_view(spare), 930.0, 566.0, 11.0, 0xc8c8d2ff)

    def play(list: mutable Display::DisplayList&, run: Conductor::Run&):
        can Abort.Panic, Memory.Allocate:
            view: HandView::Lens = Conductor::lens()
            backdrop(list, &view)
            pulse: f64 = pulse_of(run)
            order: i64[4] = [3, 1, 0, 2]
            for i in order:
                section(list, &view, i, run.playing[i.usize()], pulse)
            quad(list, point(430.0, 0.0), point(570.0, 0.0), point(550.0, 50.0), point(450.0, 50.0), 0x463228ff)
            SceneHand::line(list, point(540.0, 30.0), point(run.hand.x, run.hand.y), 3.0, 0xfaf6e6ff)
            for i in order:
                on: bool = run.playing[i.usize()]
                at: RoomsView::Vec = Conductor::spot(i)
                SceneHand::word(list, sview(section_name(i), 0, -1), at.x, at.y - 62.0, 12.0, 0xffffffff if on else 0x969696ff, on)
            score(list, run, pulse)
            SceneHand::progress(list, &run.hand, 0.0)

    def counts(out: mutable dstr&, level: Conductor::Grade):
        can Abort.Panic, Memory.Allocate:
            dstr_append_i64(out, level.beats)
            dstr_append_cstr(out, " beats, ")
            dstr_append_i64(out, level.cues)
            dstr_append_cstr(out, " cues")

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: Conductor::Grade = Conductor::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            counts(out, level)
            dstr_append_cstr(out, ".")
            if level.bend > 0.0:
                dstr_append_cstr(out, "  The tempo wanders.")

    def render(list: mutable Display::DisplayList&, game: ConductorGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Conductor", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Flick down on each beat   Click a section on its beat   Up: louder   Down: softer   Esc: menu",
                456.0, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            if game.phase == ConductorGame::READY:
                Display::draw_text(list, "Press Space or click to start", 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            if game.phase == ConductorGame::DONE:
                report: mutable dstr = []
                dstr_append_i64(&report, game.wins)
                dstr_append_cstr(&report, " of ")
                dstr_append_i64(&report, game.trial)
                dstr_append_cstr(&report, " passed   highest rung passed ")
                dstr_append_i64(&report, game.best_rung)
                Display::draw_text(list, bytes_view(report), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            play(list, &game.run)
            Display::draw_text(list, "Beat time, and give each cue on its beat", 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            facts: mutable dstr = dstr_of_cstr("rung ")
            dstr_append_i64(&facts, game.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, game.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, game.total)
            dstr_append_cstr(&facts, "   ")
            counts(&facts, game.run.piece.level)
            Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            if game.phase == ConductorGame::JUDGED:
                passed: bool = game.run.result == Conductor::BRAVO
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, passed,
                    "Bravo" if passed else "The orchestra fell apart", 60.0, 16.0)
