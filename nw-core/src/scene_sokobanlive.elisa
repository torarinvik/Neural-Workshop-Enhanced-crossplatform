include "./tasks/sokobanlive_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./verdict.elisa"
include "./geometry.elisa"
include "./pymath.elisa"

module SceneSokobanLive:
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const PI: f64 = 3.141592653589793
    const RACK: u32 = 0x34405cff
    const RACK_EDGE: u32 = 0x242c42ff
    const PAD: u32 = 0x28c8beff
    const CRATE: u32 = 0xc48442ff
    const HOME: u32 = 0xf0c03cff
    const GUARD: u32 = 0xdc4048ff
    const HAT: u32 = 0xffce28ff
    const VEST: u32 = 0xff8028ff
    const SHUTTER: u32 = 0xe6b428ff

    struct Frame:
        x: f64
        y: f64
        scale: f64
        width: i64
        height: i64

    struct Point:
        x: f64
        y: f64

    def frame(g: SokobanLive::Grade) -> Frame:
        can Abort.Panic:
            bottom: f64 = Verdict::above_the_band(HEIGHT, Geometry::from_bottom_edge(HEIGHT, 58.0).f64()).f64()
            height: f64 = fmax(40.0, Geometry::from_top_edge(HEIGHT, 116.0).f64() - bottom)
            scale: f64 = fmin(WIDTH * 0.94 / g.width.f64(), (height - height * 0.1) / g.height.f64())
            return Frame{x: (WIDTH - g.width.f64() * scale) / 2.0, y: bottom, scale: scale, width: g.width, height: g.height}

    def hit(session: SokobanLiveGame::Session&, x: f64, y: f64) -> i64:
        return SokobanLiveGame::START if session.phase == SokobanLiveGame::READY or session.phase == SokobanLiveGame::DONE
        return -1

    def cell(area: Frame, index: i64) -> Point:
        can Abort.Panic:
            return Point{x: area.x + ((index % area.width).f64() + 0.5) * area.scale,
                y: area.y + ((area.height - 1 - index / area.width).f64() + 0.5) * area.scale}

    def rounded(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, r: f64, ink: u32):
        can Abort.Panic, Memory.Allocate:
            rect: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: x, y: y, w: fmax(1.0, w), h: fmax(1.0, h)}
            ScenePolish::rounded(list, &rect, r, ink)

    def text(list: mutable Display::DisplayList&, words: sview, y: f64, size: f64, ink: u32, bold: bool = false):
        can Abort.Panic, Memory.Allocate:
            Display::draw_text_weight(list, words, 456.0, y, size, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def cross(list: mutable Display::DisplayList&, p: Point, size: f64, thick: f64, ink: u32):
        can Abort.Panic, Memory.Allocate:
            Display::draw_line(list, p.x - size, p.y + size, p.x + size, p.y - size, thick, ink)
            Display::draw_line(list, p.x - size, p.y - size, p.x + size, p.y + size, thick, ink)

    def shelf(list: mutable Display::DisplayList&, draw: mutable MT19937&, x: f64, y: f64, s: f64):
        can Abort.Panic, Memory.Allocate:
            Display::draw_rect(list, x, y, s + 0.5, s + 0.5, RACK)
            stocks: u32[5] = [0xec783cff, 0x5aaae6ff, 0x82c864ff, 0xf0c846ff, 0xc86ebeff]
            for k in 0..<2 |list, draw, x, y, s, stocks|:
                sy: f64 = y + s * (0.12 + 0.44 * k.f64())
                Display::draw_rect(list, x + s * 0.06, sy, s * 0.88, s * 0.06, RACK_EDGE)
                bx: mutable f64 = x + s * 0.1
                while bx < x + s * 0.85 |list, draw, x, s, sy, bx, stocks|:
                    bw: f64 = s * py_uniform(draw, 0.14, 0.26)
                    height: f64 = s * py_uniform(draw, 0.16, 0.3)
                    ink: u32 = ScenePolish::mix_rgb(stocks[py_randbelow(draw, 5.u64()).usize()], RACK, 0.35)
                    Display::draw_rect(list, bx, sy + s * 0.06, fmin(bw, x + s * 0.9 - bx), height, ink)
                    bx <- bx + bw + s * 0.03

    def scenery(list: mutable Display::DisplayList&, area: Frame, floor: SokobanLive::Warehouse&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.scale
            count: i64 = area.width * area.height
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: area.x - 6.0, y: area.y - 6.0,
                w: area.width.f64() * s + 12.0, h: area.height.f64() * s + 12.0}
            ScenePolish::shadow(list, &box, 12.0, 4.0, dark)
            ScenePolish::rounded(list, &box, 12.0, RACK_EDGE)
            walls: mutable i64 = 0
            for i in 0..<count |floor, walls|:
                walls <- walls + (1 if floor.walls[i.usize()] else 0)
            draw: mutable MT19937 = zeroed
            mt_seed_int(&draw, (floor.player * 7 + walls).u64())
            for i in 0..<count |list, area, floor, draw, s|:
                p: Point = cell(area, i)
                x: f64 = p.x - s / 2.0
                y: f64 = p.y - s / 2.0
                if floor.walls[i.usize()]:
                    shelf(list, &draw, x, y, s)
                    continue
                light: u32 = 0xffffffff if py_random(&draw) < 0.5 else 0x000000ff
                tone: u32 = ScenePolish::mix_rgb(0xbec4ccff, light, py_uniform(&draw, 0.0, 0.05))
                Display::draw_rect(list, x, y, s + 0.5, s + 0.5, tone)
                Display::draw_box(list, x, y, s, s, 0xaab0baff, 1.0)
                if floor.walls[(i + area.width).usize()]:
                    for k in 0..<5 |list, x, y, s|:
                        Display::draw_rect(list, x + k.f64() * s * 0.2, y, s * 0.1, s * 0.07, 0xf0be28ff)
                if floor.goals[i.usize()]:
                    Display::draw_circle(list, p.x, p.y, s * 0.36, ScenePolish::mix_rgb(PAD, tone, 0.6))
                    ScenePolish::ring(list, p.x, p.y, s * 0.36, fmax(2.0, s * 0.06), PAD, 32)
                    cross(list, p, s * 0.16, fmax(2.0, s * 0.05), PAD)
            for i in 0..<floor.level.guards |list, area, floor, s|:
                lane: SokobanLive::Lane = floor.patrols[i.usize()].lane
                a: Point = cell(area, lane.start)
                b: Point = cell(area, lane.start + lane.stride * (lane.length - 1))
                Display::draw_line(list, a.x, a.y, b.x, b.y, fmax(2.0, s * 0.12), 0xe6788246)

    def shutters(list: mutable Display::DisplayList&, area: Frame, run: SokobanLive::Run&):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.scale
            for i in 0..<run.warehouse.level.shutters |list, area, run, s|:
                shutter: SokobanLive::Shutter = run.warehouse.shutters[i.usize()]
                p: Point = cell(area, shutter.cell)
                shut: bool = run.shut[i.usize()]
                into: f64 = fmod(run.elapsed + shutter.phase, shutter.period)
                opening: f64 = shutter.open_share * shutter.period
                left: f64 = opening - into if into < opening else shutter.period - into
                span: f64 = shutter.period * (shutter.open_share if into < opening else 1.0 - shutter.open_share)
                if shut:
                    for k in 0..<5 |list, p, s|:
                        Display::draw_rect(list, p.x - s / 2.0, p.y - s / 2.0 + k.f64() * s * 0.2,
                            s, s * 0.16, 0x787e8cff if k % 2 != 0 else SHUTTER)
                else:
                    Display::draw_rect(list, p.x - s / 2.0, p.y + s * 0.36, s, s * 0.14, SHUTTER)
                ScenePolish::arc(list, p.x, p.y, s * 0.3, PI / 2.0, 2.0 * PI * fmax(0.0, left / span),
                    fmax(2.0, s * 0.07), 0x5adc78ff if shut else 0xff5a3cff)

    def crates(list: mutable Display::DisplayList&, area: Frame, run: SokobanLive::Run&):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.scale
            size: f64 = s - 2.0 * (s * 0.08)
            for i in 0..<(area.width * area.height) |list, area, run, s, size|:
                continue if not run.boxes[i.usize()]
                p: Point = cell(area, i)
                x: f64 = p.x - s / 2.0 + s * 0.08
                y: f64 = p.y - s / 2.0 + s * 0.08
                home: bool = run.warehouse.goals[i.usize()]
                if home:
                    ScenePolish::glow(list, p.x, p.y, s * 0.75, HOME, 90)
                ink: u32 = HOME if home else CRATE
                edge: u32 = ScenePolish::mix_rgb(ink, 0x000000ff, 0.3)
                Display::draw_rect(list, x - 2.0, y - 3.0, size, size, 0x1e1e2846)
                Display::draw_rect(list, x, y, size, size, ink)
                Display::draw_box(list, x, y, size, size, edge, fmax(2.0, s * 0.08))
                cross(list, p, s * 0.3, fmax(2.0, s * 0.07), edge)

    def guards(list: mutable Display::DisplayList&, area: Frame, run: SokobanLive::Run&):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.scale
            for i in 0..<run.warehouse.level.guards |list, area, run, s|:
                guard: SokobanLive::Guard = run.guards[i.usize()]
                p: Point = cell(area, SokobanLive::guard_cell(guard))
                at: i64 = guard.at + guard.heading
                moving: bool = at >= 0 and at < guard.lane.length
                target: Point = cell(area, guard.lane.start + guard.lane.stride * at) if moving else p
                ux: f64 = (target.x - p.x) / s
                uy: f64 = (target.y - p.y) / s
                px: f64 = -uy
                py: f64 = ux
                reach: f64 = s * 1.6
                Display::draw_triangle(list, p.x, p.y, p.x + ux * reach + px * s * 0.55, p.y + uy * reach + py * s * 0.55,
                    p.x + ux * reach - px * s * 0.55, p.y + uy * reach - py * s * 0.55, 0xffec8c50)
                if moving:
                    Display::draw_box(list, target.x - s * 0.4, target.y - s * 0.4, s * 0.8, s * 0.8, 0xff6e6ea0, 2.0)
                ScenePolish::glow(list, p.x, p.y, s * 0.7, GUARD, 70)
                rounded(list, p.x - s * 0.32, p.y - s * 0.32, s * 0.64, s * 0.64, s * 0.14, GUARD)
                rounded(list, p.x - s * 0.24 + ux * s * 0.06, p.y + s * 0.02 + uy * s * 0.06,
                    s * 0.48, s * 0.16, s * 0.06, 0x28141eff)
                Display::draw_circle(list, p.x + ux * s * 0.16, p.y + s * 0.1 + uy * s * 0.06, s * 0.06, 0x78f0ffff)
                share: f64 = 1.0 - fmax(0.0, guard.next_beat - run.elapsed) / run.warehouse.level.beat
                ScenePolish::arc(list, p.x, p.y, s * 0.46, PI / 2.0, 2.0 * PI * fmin(1.0, share), 2.0, 0xffc8c8ff)

    def worker(list: mutable Display::DisplayList&, area: Frame, run: SokobanLive::Run&):
        can Abort.Panic, Memory.Allocate:
            p: Point = cell(area, run.player)
            s: f64 = area.scale
            ux: f64 = -1.0 if run.facing == 2 else (1.0 if run.facing == 3 else 0.0)
            uy: f64 = 1.0 if run.facing == 0 else (-1.0 if run.facing == 1 else 0.0)
            ScenePolish::glow(list, p.x, p.y, s * 0.7, HAT, 60)
            Display::draw_circle(list, p.x, p.y - s * 0.04, s * 0.3, VEST)
            Display::draw_rect(list, p.x - s * 0.3, p.y - s * 0.1, s * 0.6, s * 0.08, 0xfafadcff)
            Display::draw_circle(list, p.x + ux * s * 0.08, p.y + s * 0.08 + uy * s * 0.08, s * 0.2, HAT)
            Display::draw_circle(list, p.x + ux * s * 0.24, p.y + uy * s * 0.24, s * 0.06, 0x3c2814ff)
            ready: f64 = fmax(0.0, run.ready_at - run.elapsed)
            if ready > 0.0:
                ScenePolish::arc(list, p.x, p.y, s * 0.44, PI / 2.0, 2.0 * PI * (1.0 - ready / SokobanLive::STEP), 2.0, HAT)

    def progress(list: mutable Display::DisplayList&, area: Frame, run: SokobanLive::Run&):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.scale
            h: f64 = s * 0.36
            y: f64 = area.y + area.height.f64() * s + s * 0.3
            covered: i64 = SokobanLiveGame::covered(run)
            for i in 0..<run.warehouse.level.crates |list, area, s, h, y, covered|:
                x: f64 = area.x + s * 0.3 + i.f64() * h * 1.3
                Display::draw_circle(list, x + h / 2.0, y + h / 2.0, h * 0.5, HOME if i < covered else 0x78828cff)
            w: f64 = area.width.f64() * s
            x: f64 = area.x + w * 0.35
            bar: f64 = w * 0.65 - s * 0.3
            rounded(list, x, y, bar, h, h / 2.0, 0x5a606eff)
            share: f64 = fmax(0.0, 1.0 - run.elapsed / run.warehouse.seconds)
            if share > 0.02:
                rounded(list, x, y, bar * share, h, h / 2.0, ScenePolish::mix_rgb(0xf05a46ff, 0x46c88cff, fmin(1.0, share * 1.6)))

    def verdict(run: SokobanLive::Run&, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            if run.result == SokobanLive::CLEAR:
                dstr_append_cstr(out, "Every pad covered in ")
                dstr_append_i64(out, py_round_half_even(run.elapsed))
                dstr_append_cstr(out, " s")
            elif run.result == SokobanLive::CAUGHT:
                dstr_append_cstr(out, "A guard caught the worker")
            elif run.result == SokobanLive::STUCK:
                dstr_append_cstr(out, "A crate is stuck for good")
            elif run.result == SokobanLive::TIMEOUT:
                dstr_append_cstr(out, "Out of time")

    def render(list: mutable Display::DisplayList&, session: SokobanLiveGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            text(list, "Sokoban Live", 648.0, 22.0, ink, true)
            text(list, "arrows: step and push   Esc: menu", 26.0, 12.0, ink)
            caption: mutable dstr = []
            verdict(&session.run, &caption)
            status: mutable dstr = []
            if session.phase == SokobanLiveGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == SokobanLiveGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == SokobanLiveGame::JUDGED:
                status <- caption
            else:
                dstr_append_cstr(&status, "Push every crate onto a pad; keep clear of guards")
            text(list, bytes_view(status), 614.0, 14.0, ink)
            if session.phase == SokobanLiveGame::PLAYING or session.phase == SokobanLiveGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   ")
                dstr_append_i64(&facts, fmax(0.0, session.run.warehouse.seconds - session.run.elapsed).i64())
                dstr_append_cstr(&facts, " s left   pushes ")
                dstr_append_i64(&facts, session.run.pushes)
                text(list, bytes_view(facts), 588.0, 12.0, ink)
                area: Frame = frame(session.run.warehouse.level)
                scenery(list, area, &session.run.warehouse, dark)
                shutters(list, area, &session.run)
                crates(list, area, &session.run)
                guards(list, area, &session.run)
                worker(list, area, &session.run)
                progress(list, area, &session.run)
            if caption.count > 0:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, SokobanLiveGame::passed_verdict(session.verdict),
                    bytes_view(caption), 60.0, 16.0)

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            g: SokobanLive::Grade = SokobanLive::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, g.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, g.crates)
            dstr_append_cstr(out, " crate(s), ")
            dstr_append_i64(out, g.guards)
            dstr_append_cstr(out, " guard(s) stepping every ")
            fraction: i64 = py_round_half_even(g.beat * 100.0)
            dstr_append_cstr(out, "0.")
            dstr_append_i64(out, fraction)
            dstr_append_cstr(out, " s.")
            dstr_append_cstr(out, "  Shutters open and shut.") if g.shutters > 0
