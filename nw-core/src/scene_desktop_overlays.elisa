include "./scene_desktop_windows.elisa"

module SceneDesktopOverlays:
    # What opens over the windows: menus, Start, dialogs, right-click
    # menus, dropdown lists, popups, and a drag on its way.
    const NONE: i64 = -1
    const BODY: i64 = SceneDesktopDraw::BODY
    const PARTS: i64 = SceneDesktopDraw::PARTS
    const TEXT: i64 = SceneDesktopDraw::TEXT

    def dialog_title(desk: DesktopState::Desk&, dialog: i64, ellipsis: bool) -> dstr:
        can Memory.Allocate, Abort.Panic:
            out: mutable dstr = dstr_of_cstr(Desktop::dialog_name(desk.dealt.dialogs[dialog.usize()].title))
            dstr_append_cstr(&out, "…") if ellipsis
            return out

    # _draw_menu.
    def menu(list: mutable Display::DisplayList&, drawing: SceneDesktopDraw::Pen, desk: DesktopState::Desk&):
        can Abort.Panic, Memory.Allocate:
            window: i64 = desk.overlay.menu_window
            index: i64 = desk.overlay.menu_index
            sub: i64 = desk.overlay.menu_sub
            for which in 0..<DesktopView::menu_items(desk) |list, drawing, desk, window, index, sub|:
                item: DesktopState::Rect = DesktopView::menu_item(desk, which)
                cascades: bool = DesktopView::is_submenu(desk, which)
                SceneDesktopDraw::rect(list, drawing, BODY, item, SceneDesktopDraw::BUTTON if sub == which else SceneDesktopDraw::WHITE,
                    SceneDesktopDraw::PANEL_EDGE)
                name: mutable dstr = []
                if cascades:
                    dstr_append_cstr(&name, "More")
                else:
                    name <- dialog_title(desk, DesktopView::dialog_at(desk, window, index, which, NONE), true)
                SceneDesktopDraw::words(list, drawing, TEXT, bytes_view(name), item.x + 10.0, item.y + item.h / 2.0)
                if cascades:
                    SceneDesktopDraw::words(list, drawing, TEXT, "▸", item.x + item.w - 16.0, item.y + item.h / 2.0)
            if sub != NONE:
                for which in 0..<DesktopView::submenu_items(desk) |list, drawing, desk, window, index, sub|:
                    item: DesktopState::Rect = DesktopView::submenu_item(desk, which)
                    SceneDesktopDraw::rect(list, drawing, BODY, item, SceneDesktopDraw::WHITE, SceneDesktopDraw::PANEL_EDGE)
                    name: dstr = dialog_title(desk, DesktopView::dialog_at(desk, window, index, sub, which), true)
                    SceneDesktopDraw::words(list, drawing, TEXT, bytes_view(name), item.x + 10.0, item.y + item.h / 2.0)

    def context_word(name: i64) -> cstr:
        words: array[cstr, 7] = ["Open", "Cut", "Copy", "Delete", "Restore", "Paste", "View"]
        return words[name.usize()]

    # _draw_context.
    def context(list: mutable Display::DisplayList&, drawing: SceneDesktopDraw::Pen, desk: DesktopState::Desk&):
        can Abort.Panic, Memory.Allocate:
            names: darray[i64] = DesktopPointer::context_names(desk)
            for index in 0..<names.count.i64() |list, drawing, desk, names|:
                item: DesktopState::Rect = DesktopPointer::context_rect(desk, names.count.i64(), index)
                SceneDesktopDraw::rect(list, drawing, BODY, item, SceneDesktopDraw::WHITE, SceneDesktopDraw::PANEL_EDGE)
                SceneDesktopDraw::named(list, drawing, TEXT, context_word(names[index.usize()]), item.x + 12.0, item.y + item.h / 2.0)

    # _draw_start.
    def start(list: mutable Display::DisplayList&, drawing: SceneDesktopDraw::Pen, desk: DesktopState::Desk&):
        can Abort.Panic, Memory.Allocate:
            panel: DesktopState::Rect = DesktopState::start_panel()
            all: bool = desk.overlay.start_all
            SceneDesktopDraw::rect(list, drawing, BODY, panel, SceneDesktopDraw::rgb(44, 50, 62), SceneDesktopDraw::INK)
            SceneDesktopDraw::named(list, drawing, TEXT, "All apps" if all else "Pinned", panel.x + 14.0, panel.y + 22.0, 13.0,
                SceneDesktopDraw::WHITE, false, true)
            SceneDesktopDraw::named_button(list, drawing, DesktopState::all_apps_rect(), "‹ Back" if all else "All apps ›",
                SceneDesktopDraw::BUTTON, SceneDesktopDraw::INK, false, 11.0)
            listed: darray[i64] = DesktopView::start_windows(desk)
            for index in 0..<listed.count.i64() |list, drawing, desk, listed, all|:
                item: DesktopState::Rect = DesktopView::start_item(desk, index)
                title: dstr = SceneDesktopDraw::title_of(desk, listed[index.usize()])
                SceneDesktopDraw::rect(list, drawing, PARTS, item, SceneDesktopDraw::rgb(60, 68, 84))
                if all:
                    SceneDesktopDraw::words(list, drawing, TEXT, bytes_view(title), item.x + 12.0, item.y + item.h / 2.0, 13.0,
                        SceneDesktopDraw::WHITE)
                else:
                    SceneDesktopDraw::glyph(list, drawing, SceneDesktopDraw::GLYPH_APP, item, bytes_view(title))

    # _draw_dialog.
    def dialog(list: mutable Display::DisplayList&, drawing: SceneDesktopDraw::Pen, desk: DesktopState::Desk&):
        can Abort.Panic, Memory.Allocate:
            box: DesktopState::Rect = DesktopView::dialog_rect()
            SceneDesktopDraw::rect(list, drawing, BODY, box, SceneDesktopDraw::PANEL, SceneDesktopDraw::PANEL_EDGE)
            SceneDesktopDraw::rect(list, drawing, PARTS, DesktopState::rect(box.x, box.y, box.w, Desktop::TITLE_H.f64()),
                SceneDesktopDraw::rgb(80, 84, 96))
            title: dstr = dialog_title(desk, desk.overlay.dialog, false)
            SceneDesktopDraw::words(list, drawing, TEXT, bytes_view(title), box.x + 12.0, box.y + (Desktop::TITLE_H / 2).f64(),
                13.0, SceneDesktopDraw::WHITE, false, true)
            made: DesktopDeal::DialogSpec = desk.dealt.dialogs[desk.overlay.dialog.usize()]
            for ident in made.members |list, drawing, desk|:
                SceneDesktopDraw::draw_control(list, drawing, desk, ident, Desktop::DIALOG_W.f64())
            SceneDesktopDraw::button(list, drawing, DesktopView::dialog_button(0), "Cancel")
            SceneDesktopDraw::button(list, drawing, DesktopView::dialog_button(1), "OK", SceneDesktopDraw::BUTTON,
                SceneDesktopDraw::INK, true)

    # _draw_dropdown.
    def dropdown(list: mutable Display::DisplayList&, drawing: SceneDesktopDraw::Pen, desk: DesktopState::Desk&):
        can Abort.Panic, Memory.Allocate:
            ident: i64 = desk.overlay.dropdown
            control: DesktopState::Control = desk.controls[ident.usize()]
            place: DesktopState::Rect = DesktopView::control_rect(desk, ident).rect
            for value in 0..<control.count |list, drawing, desk, control, place, ident|:
                item: DesktopState::Rect = DesktopState::dropdown_item(place, control.count, value)
                picked: bool = value == control.shown
                SceneDesktopDraw::rect(list, drawing, BODY, item, SceneDesktopDraw::ACCENT if picked else SceneDesktopDraw::WHITE,
                    SceneDesktopDraw::PANEL_EDGE)
                shown: dstr = SceneDesktopDraw::word(desk, ident, value)
                SceneDesktopDraw::words(list, drawing, TEXT, bytes_view(shown), item.x + 8.0, item.y + item.h / 2.0, 13.0,
                    SceneDesktopDraw::WHITE if picked else SceneDesktopDraw::INK)

    # _draw_popup.
    def popup(list: mutable Display::DisplayList&, drawing: SceneDesktopDraw::Pen, desk: DesktopState::Desk&):
        can Abort.Panic, Memory.Allocate:
            spec: DesktopDeal::PopupSpec = desk.dealt.popups[desk.overlay.popup.usize()]
            box: DesktopState::Rect = DesktopState::popup_rect()
            SceneDesktopDraw::rect(list, drawing, BODY, box, SceneDesktopDraw::PANEL, SceneDesktopDraw::INK)
            SceneDesktopDraw::rect(list, drawing, PARTS, DesktopState::rect(box.x, box.y, box.w, Desktop::TITLE_H.f64()),
                SceneDesktopDraw::WARN)
            title: dstr = SceneDesktopDraw::title_of(desk, spec.window)
            heading: mutable dstr = []
            dstr_append_dstr(&heading, title)
            dstr_append_cstr(&heading, " update")
            SceneDesktopDraw::words(list, drawing, TEXT, bytes_view(heading), box.x + 12.0, box.y + (Desktop::TITLE_H / 2).f64(),
                13.0, SceneDesktopDraw::WHITE, false, true)
            asking: mutable dstr = []
            dstr_append_cstr(&asking, "Reset ")
            dstr_append_dstr(&asking, title)
            dstr_append_cstr(&asking, " to its defaults?")
            SceneDesktopDraw::words(list, drawing, TEXT, bytes_view(asking), box.x + 20.0, box.y + 62.0)
            SceneDesktopDraw::button(list, drawing, DesktopState::popup_button(spec.safe_left, 0), "Not now",
                SceneDesktopDraw::BUTTON, SceneDesktopDraw::INK, true)
            SceneDesktopDraw::button(list, drawing, DesktopState::popup_button(spec.safe_left, 1), "Restore")

    def whole_desktop(place: DesktopState::Rect) -> bool:
        return place.x == 0.0 and place.y == 0.0 and place.w == Desktop::SCREEN_W.f64() and place.h == Desktop::WORK_H.f64()

    # _draw_drag: what a drag carries and where it would land.
    def drag(list: mutable Display::DisplayList&, drawing: SceneDesktopDraw::Pen, desk: DesktopState::Desk&,
            preview: DesktopPointer::Preview):
        can Abort.Panic, Memory.Allocate:
            if preview.kind != DesktopPointer::PREVIEW_ICON:
                SceneDesktopDraw::outline(list, drawing, PARTS, preview.dest.rect, SceneDesktopDraw::DRAG_EDGE)
                return
            dest: i64 = preview.dest.folder
            if preview.dest.found:
                SceneDesktopDraw::outline(list, drawing, BODY, preview.dest.rect,
                    SceneDesktopDraw::DROP_OK if dest != NONE else SceneDesktopDraw::DROP_NO,
                    4.0 if whole_desktop(preview.dest.rect) else 3.0)
            size: f64 = Desktop::ICON_W.f64() * 0.8
            px: f64 = desk.pointer.x
            py: f64 = desk.pointer.y
            ghost: DesktopState::Rect = DesktopState::rect(px - size * 0.3, py - size * 0.2, size, size)
            SceneDesktopDraw::rect(list, drawing, PARTS, ghost, SceneDesktopDraw::SELECTED,
                SceneDesktopDraw::DROP_OK if dest != NONE else SceneDesktopDraw::PANEL_EDGE)
            SceneDesktopDraw::node_glyph(list, drawing, desk, preview.node, ghost)
            if dest != NONE:
                tag_words: mutable dstr = []
                dstr_append_cstr(&tag_words, "Move to ")
                name: dstr = SceneDesktopDraw::node_name(desk, dest)
                dstr_append_dstr(&tag_words, name)
                tag: DesktopState::Rect = DesktopState::rect(px + size * 0.7, py + size * 0.7,
                    14.0 + 7.5 * characters(&tag_words).f64(), 22.0)
                SceneDesktopDraw::rect(list, drawing, PARTS, tag, SceneDesktopDraw::DROP_OK)
                SceneDesktopDraw::words(list, drawing, TEXT, bytes_view(tag_words), tag.x + 7.0, tag.y + 11.0, 10.0,
                    SceneDesktopDraw::WHITE, false, true)

    # len() of the words: characters, not bytes.
    def characters(text: dstr&) -> i64:
        count: mutable i64 = 0
        for byte in text |count|:
            count <- count + 1 if byte < 128.u8() or byte >= 192.u8()
        return count
