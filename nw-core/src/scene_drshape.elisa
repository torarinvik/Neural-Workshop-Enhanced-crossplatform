include "./drshape_view.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./geometry.elisa"

module SceneDrShape:
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const CX: f64 = WIDTH / 2.0
    const FOG: u32 = 0x281c4eff

    def area() -> DrShapeView::Rect:
        return DrShapeView::Rect{x: 27.36, y: 179.0, w: 857.28, h: 389.0}

    def hit(s: DrShapeGame::Session&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return DrShapeView::hit(area(), s, x, y)

    def alpha(colour: u32, opacity: i64) -> u32:
        return (colour & 0xffffff00.u32()) | opacity.u32()

    def wheel(index: i64) -> u32:
        can Abort.Panic:
            colours: u32[12] = [0xff5c78ff, 0xffa03cff, 0xfadc46ff, 0x8ce65aff,
                0x3cdcaaff, 0x3cc8faff, 0x5a8cffff, 0xa06effff,
                0xe664f0ff, 0xff78beff, 0xc8f0ffff, 0xffc896ff]
            return colours[(index % 12).usize()]

    def tint(hues: i64[3]&, index: i64) -> u32:
        can Abort.Panic:
            return wheel(hues[(index % 3).usize()])

    def rounded(list: mutable Display::DisplayList&, rect: DrShapeView::Rect, radius: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: rect.x, y: rect.y, w: rect.w, h: rect.h}
            ScenePolish::rounded(list, &box, radius, colour)

    def card(list: mutable Display::DisplayList&, rect: DrShapeView::Rect, fill: u32, edge: u32):
        can Memory.Allocate, Abort.Panic:
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: rect.x, y: rect.y, w: rect.w, h: rect.h}
            ScenePolish::card_face(list, &box, 12.0, fill, edge, 0.u32(), true)

    def gradient(list: mutable Display::DisplayList&, rect: DrShapeView::Rect, low: u32, high: u32, bands: i64):
        can Memory.Allocate, Abort.Panic:
            h: f64 = rect.h / bands.f64()
            for i in 0..<bands |list, rect, low, high, bands, h|:
                colour: u32 = ScenePolish::mix_rgb(low, high, (i.f64() + 0.5) / bands.f64())
                Display::draw_rect(list, rect.x, rect.y + h * i.f64(), rect.w, h + 1.0, colour)

    def fogged(colour: u32, near: f64, faded: bool) -> u32:
        c: u32 = ScenePolish::mix_rgb(FOG, colour, 0.35 + 0.65 * near)
        return ScenePolish::mix_rgb(c, 0x5a5a6eff, 0.6) if faded else c

    def paint_face(list: mutable Display::DisplayList&, face: DrShapeView::Item&, hue: u32, faded: bool):
        can Memory.Allocate, Abort.Panic:
            a: DrShapeView::Point = face.vertices[0]
            b: DrShapeView::Point = face.vertices[1]
            c: DrShapeView::Point = face.vertices[2]
            u: RoomsView::Vec = RoomsView::sub(b.camera, a.camera)
            v: RoomsView::Vec = RoomsView::sub(c.camera, a.camera)
            normal: RoomsView::Vec = RoomsView::cross(u, v)
            length: f64 = sqrt(RoomsView::dot(normal, normal))
            lam: f64 = DrShape::magnitude(RoomsView::dot(normal, RoomsView::vec(-0.42, 0.72, -0.55))) / length if length > 0.0 else 0.0
            near: mutable f64 = 0.0
            for i in 0..<face.count |face, near|:
                near <- near + face.vertices[i.usize()].near
            dark: u32 = ScenePolish::mix_rgb(hue, 0x000000ff, 0.6)
            light: u32 = ScenePolish::mix_rgb(hue, 0xffffffff, 0.2)
            colour: u32 = alpha(fogged(ScenePolish::mix_rgb(dark, light, lam), near / face.count.f64(), faded), 150)
            Display::begin_polygon(list, face.count, a.x, a.y, colour)
            for i in 0..<face.count |face, list|:
                p: DrShapeView::Point = face.vertices[i.usize()]
                Display::polygon_point(list, p.x, p.y)

    def joint(list: mutable Display::DisplayList&, p: DrShapeView::Point, thick: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_circle(list, p.x, p.y, thick * 0.8, colour)
            if thick >= 3.5:
                Display::draw_circle(list, p.x - thick * 0.25, p.y + thick * 0.25,
                    thick * 0.25, ScenePolish::mix_rgb(colour, 0xffffffff, 0.6))

    def paint_tube(list: mutable Display::DisplayList&, a: DrShapeView::Point, b: DrShapeView::Point, hue: u32, scale: f64, faded: bool):
        can Memory.Allocate, Abort.Panic:
            near: f64 = (a.near + b.near) / 2.0
            dark: u32 = ScenePolish::mix_rgb(hue, 0x000000ff, 0.45)
            light: u32 = ScenePolish::mix_rgb(hue, 0xffffffff, 0.25)
            colour: u32 = fogged(ScenePolish::mix_rgb(dark, light, near), near, faded)
            thick: f64 = DrShapeView::max(2.0, scale * (0.03 + 0.05 * near))
            Display::draw_line(list, a.x, a.y, b.x, b.y, thick * 1.6, alpha(ScenePolish::mix_rgb(colour, 0x000000ff, 0.55), 230))
            Display::draw_line(list, a.x, a.y, b.x, b.y, thick, colour)
            if thick >= 3.5:
                off: f64 = thick * 0.22
                Display::draw_line(list, a.x - off, a.y + off, b.x - off, b.y + off, DrShapeView::max(1.0, thick * 0.3),
                    alpha(ScenePolish::mix_rgb(colour, 0xffffffff, 0.55), 200))
            joint(list, a, thick, colour)
            joint(list, b, thick, colour)

    def paint_form(list: mutable Display::DisplayList&, form: DrShape::Form&, cam: DrShapeView::Camera&,
            hues: i64[3]&, scale: f64, upto: f64, wobble: f64, seed: u64, faded: bool) -> DrShapeView::Figure:
        can Memory.Allocate, Abort.Panic:
            full: f64 = DrShapeView::min(form.path.count.f64(), upto)
            for i in 0..<form.path.count |list, form, cam, full, scale|:
                break if i.f64() >= full
                stroke: DrShape::Segment = form.path.segments[i.usize()]
                share: f64 = DrShapeView::min(1.0, full - i.f64())
                end: RoomsView::Vec = RoomsView::add(stroke.a, RoomsView::mul(RoomsView::sub(stroke.b, stroke.a), share)) if share < 1.0 else stroke.b
                a: DrShapeView::Point = DrShapeView::project(cam, stroke.a, true)
                b: DrShapeView::Point = DrShapeView::project(cam, end, true)
                ay: f64 = cam.y - scale * 1.25 + (a.y - cam.y) * 0.12 if cam.kind == DrShapeView::ORBIT else a.y
                by: f64 = cam.y - scale * 1.25 + (b.y - cam.y) * 0.12 if cam.kind == DrShapeView::ORBIT else b.y
                Display::draw_line(list, a.x, ay, b.x, by, DrShapeView::max(2.0, scale * 0.05), 0x00000050)
            figure: DrShapeView::Figure = DrShapeView::figure(form, cam, upto, wobble * scale, seed)
            for i in 0..<figure.count |figure, list, hues, scale, faded|:
                item: DrShapeView::Item& = &figure.items[i.usize()]
                hue: u32 = tint(hues, item.tint)
                if item.stroke:
                    paint_tube(list, item.vertices[0], item.vertices[1], hue, scale, faded)
                else:
                    paint_face(list, item, hue, faded)
            return figure

    def background(list: mutable Display::DisplayList&, box: DrShapeView::Rect):
        can Memory.Allocate, Abort.Panic:
            margin: DrShapeView::Rect = DrShapeView::Rect{x: box.x - 4.0, y: box.y - 4.0, w: box.w + 8.0, h: box.h + 8.0}
            card(list, margin, 0x1e1432ff, 0.u32())
            gradient(list, box, 0x0e0a22ff, 0x2e1248ff, 28)
            horizon: f64 = box.y + box.h * 0.42
            middle: f64 = box.x + box.w / 2.0
            for i in -14..<15 |list, box, horizon, middle|:
                k: f64 = i.f64()
                Display::draw_line(list, middle + k * box.w * 0.012, horizon, middle + k * box.w * 0.11, box.y, 1.0, 0xc850ff46)
            for i in 1..<10 |list, box, horizon|:
                k: f64 = i.f64() / 9.0
                share: f64 = k * k
                y: f64 = horizon - (horizon - box.y) * share
                Display::draw_line(list, box.x, y, box.x + box.w, y, 1.0, alpha(0x50c8ffff, (30.0 + 60.0 * share).i64()))
            ScenePolish::glow(list, middle, horizon, box.w * 0.22, 0xff50c8ff, 50)
            rng: mutable MT19937 = zeroed
            mt_seed_int(&rng, 7)
            for i in 0..<70 |list, box, horizon, rng|:
                x: f64 = box.x + py_random(&rng) * box.w
                y: f64 = horizon + py_random(&rng) * (box.y + box.h - horizon)
                r: f64 = 0.8 + 0.4 * py_choice_index(&rng, 3).f64()
                Display::draw_circle(list, x, y, r, alpha(0xdcdcffff, py_randint(&rng, 60, 199)))

    def floor_view(list: mutable Display::DisplayList&, box: DrShapeView::Rect, cam: DrShapeView::Camera&):
        can Memory.Allocate, Abort.Panic:
            gradient(list, DrShapeView::Rect{x: box.x + 2.0, y: cam.y, w: box.w - 4.0, h: box.y + box.h - cam.y - 2.0},
                0x3c2864ff, 0x181032ff, 6)
            Display::draw_rect(list, box.x + 2.0, box.y + 2.0, box.w - 4.0, cam.y - box.y - 2.0, 0x1e183aff)
            distances: f64[7] = [1.5, 2.0, 2.7, 3.6, 5.0, 7.0, 10.0]
            for i in 0..<7 |list, distances, cam, box|:
                z: f64 = distances[i.usize()]
                y: f64 = cam.y - cam.focal * DrShapeView::FLOOR_EYE / z
                if y >= box.y + 2.0:
                    Display::draw_line(list, box.x + 2.0, y, box.x + box.w - 2.0, y, 1.0,
                        alpha(0x5ac8ffff, DrShapeView::max(40.0, 170.0 - 12.0 * z).i64()))
            for i in -6..<7 |list, cam, box|:
                offset: f64 = i.f64() * 0.9
                ax: f64 = cam.x + cam.focal * offset / 1.2
                ay: f64 = cam.y - cam.focal * DrShapeView::FLOOR_EYE / 1.2
                bx: f64 = cam.x + cam.focal * offset / 14.0
                by: f64 = cam.y - cam.focal * DrShapeView::FLOOR_EYE / 14.0
                base: f64 = box.y + 2.0
                start_x: f64 = bx + (ax - bx) * (base - by) / (ay - by) if ay < base else ax
                if bx > box.x - 50.0 and bx < box.x + box.w + 50.0:
                    Display::draw_line(list, DrShapeDeal::clamp(start_x, box.x + 2.0, box.x + box.w - 2.0),
                        DrShapeView::max(base, ay), bx, by, 1.0, 0xc85aff5a)
            Display::draw_line(list, box.x + 2.0, cam.y, box.x + box.w - 2.0, cam.y, 2.0, 0xff96dca0)

    def lift(form: DrShape::Form&, view: DrShape::Matrix, size: f64) -> f64:
        can Abort.Panic:
            low: mutable f64 = 10.0
            for i in 0..<form.path.count |form, view, low|:
                stroke: DrShape::Segment = form.path.segments[i.usize()]
                low <- DrShapeView::min(low, DrShapeView::min(DrShape::apply(view, stroke.a).y, DrShape::apply(view, stroke.b).y))
            return -low * size

    def ground_point(camera: DrShapeDeal::Eye, x: f64, y: f64, focal: f64, p: RoomsView::Vec) -> RoomsView::Point:
        v: RoomsView::Vec = DrShapeDeal::seen_from(camera, p)
        depth: f64 = DrShapeView::max(0.5, v.z)
        return RoomsView::Point{x: x + focal * v.x / depth, y: y + focal * v.y / depth}

    def rim_point(camera: DrShapeDeal::Eye, x: f64, y: f64, focal: f64, height: f64, radius: f64, i: i64) -> RoomsView::Point:
        angle: f64 = DrShape::TAU * i.f64() / 28.0
        return ground_point(camera, x, y, focal, RoomsView::vec(radius * cos(angle), height, radius * sin(angle)))

    def paint_platform(list: mutable Display::DisplayList&, camera: DrShapeDeal::Eye, x: f64, y: f64, focal: f64):
        can Memory.Allocate, Abort.Panic:
            for layer in 0..<2 |list, camera, x, y, focal|:
                height: f64 = -0.35 if layer == 0 else 0.0
                for i in 0..<28 |list, camera, x, y, focal, height, layer|:
                    p: RoomsView::Point = rim_point(camera, x, y, focal, height, DrShapeDeal::PLATFORM, i)
                    if i == 0:
                        Display::begin_polygon(list, 28, p.x, p.y, 0x281846ff if layer == 0 else 0x463278ff)
                    Display::polygon_point(list, p.x, p.y)
            for ring in 0..<2 |list, camera, x, y, focal|:
                radius: f64 = DrShapeDeal::PLATFORM * (1.0 if ring == 0 else 0.55)
                prior: mutable RoomsView::Point = rim_point(camera, x, y, focal, 0.0, radius, 0)
                for i in 1..<29 |list, camera, x, y, focal, radius, prior, ring|:
                    p: RoomsView::Point = rim_point(camera, x, y, focal, 0.0, radius, i % 28)
                    Display::draw_line(list, prior.x, prior.y, p.x, p.y, 2.0 if ring == 0 else 1.0,
                        0x78dcffc8 if ring == 0 else 0xc878ff6e)
                    prior <- p
            beacon: f64 = DrShapeDeal::PLATFORM - 0.1
            base: RoomsView::Point = ground_point(camera, x, y, focal, RoomsView::vec(beacon, 0.0, 0.0))
            top: RoomsView::Point = ground_point(camera, x, y, focal, RoomsView::vec(beacon, 1.9, 0.0))
            depth: f64 = DrShapeDeal::seen_from(camera, RoomsView::vec(beacon, 0.9, 0.0)).z
            thick: f64 = DrShapeView::max(3.0, focal * 0.12 / depth)
            for i in 0..<6 |list, base, top, thick|:
                a: f64 = i.f64() / 6.0
                b: f64 = (i + 1).f64() / 6.0
                Display::draw_line(list, base.x + (top.x - base.x) * a, base.y + (top.y - base.y) * a,
                    base.x + (top.x - base.x) * b, base.y + (top.y - base.y) * b, thick,
                    0xf04646ff if i % 2 == 0 else 0xfafafaff)
            ScenePolish::glow(list, top.x, top.y, thick * 3.0, 0xfff096ff, 120)
            Display::draw_circle(list, top.x, top.y, thick * 0.9, 0xfff5b4ff)

    struct Placement:
        index: i64
        depth: f64
        lift: f64

    def play_scene(list: mutable Display::DisplayList&, session: DrShapeGame::Session&, layout: DrShapeDeal::Layout&,
            look: f64, rect: DrShapeView::Rect, reveal: bool, faded: bool, wobble: f64, seed: u64):
        can Memory.Allocate, Abort.Panic:
            p: DrShapePuzzle::Puzzle& = &session.puzzle
            x: f64 = rect.x + rect.w / 2.0
            y: f64 = rect.y + rect.h * 0.42
            focal: f64 = DrShapeView::min(rect.w, rect.h) * 1.25
            camera: DrShapeDeal::Eye = DrShapeDeal::eye(look)
            paint_platform(list, camera, x, y, focal)
            order: mutable Placement[3] = zeroed
            for i in 0..<3 |order, p, layout, camera|:
                place: DrShapeDeal::Place = layout.places[i.usize()]
                height: f64 = DrShapeDeal::ground_lift(&p.platform.things[place.thing.usize()])
                depth: f64 = DrShapeDeal::seen_from(camera, RoomsView::vec(place.x, height, place.z)).z
                index: mutable i64 = i
                while index > 0 |index, order, depth|:
                    prior: Placement = order[(index - 1).usize()]
                    break if prior.depth >= depth
                    order[index.usize()] <- prior
                    index <- index - 1
                order[index.usize()] <- Placement{index: i, depth: depth, lift: height}
            singing: i64 = DrShapeGame::sounding(session) if reveal else -1
            for i in 0..<3 |p, list, order, layout, camera, x, y, focal, faded, reveal, singing, wobble, seed, session|:
                item: Placement = order[i.usize()]
                place: DrShapeDeal::Place = layout.places[item.index.usize()]
                continue if reveal and session.elapsed < p.spans[place.thing.usize()].start
                thing: DrShapeDeal::Thing& = &p.platform.things[place.thing.usize()]
                cam: DrShapeView::Camera = DrShapeView::platform_camera(thing.turn, camera, x, y, focal, place, item.lift)
                scale: f64 = focal * DrShapeDeal::OBJECT / item.depth
                if singing == place.thing:
                    centre: DrShapeView::Point = DrShapeView::project(&cam, zeroed)
                    ScenePolish::glow(list, centre.x, centre.y, scale * 2.2, tint(&p.hues, place.thing), 110)
                _ = paint_form(list, &thing.form, &cam, &p.hues, scale, thing.form.path.count.f64(), wobble, seed, faded)

    def note_loudness(session: DrShapeGame::Session&, who: i64) -> f64:
        can Abort.Panic:
            total: mutable f64 = 0.0
            for i in 0..<session.puzzle.notes.count |session, who, total|:
                n: DrShapeDeal::Note = session.puzzle.notes[i]
                source: bool = n.who == who or (who == -1 and n.who <= -10)
                total <- total + n.gain if source and n.t <= session.elapsed and session.elapsed <= n.t + n.dur
            return DrShapeView::min(1.0, total)

    def fraction(value: f64) -> f64:
        return value - floor(value)

    def speaker(list: mutable Display::DisplayList&, x: f64, y: f64, size: f64, session: DrShapeGame::Session&):
        can Memory.Allocate, Abort.Panic:
            t: f64 = session.elapsed
            loud: f64 = note_loudness(session, -1)
            ScenePolish::glow(list, x, y, size * (0.5 + 0.3 * loud), 0x78c8ffff, 90)
            for i in 0..<4 |list, x, y, size, t, loud|:
                share: f64 = fraction(t * 0.9 + i.f64() / 4.0)
                ScenePolish::ring(list, x, y, size * (0.3 + 0.6 * share), 3.0,
                    alpha(0x8cd2ffff, (220.0 * (1.0 - share) * DrShapeView::min(1.0, loud + 0.2)).i64()), 28)
            Display::draw_circle(list, x, y, size * 0.25, 0x3c468cff)
            Display::draw_circle(list, x, y, size * 0.12 * (1.0 + 0.4 * loud), 0xc8dcffff)
            Display::draw_text_weight(list, "listen", x, y - size * 0.95, 14.0, 0xbedcffe6, Display::ANCHOR_CENTER_CENTER, true)

    def sound_card(list: mutable Display::DisplayList&, box: DrShapeView::Rect, session: DrShapeGame::Session&, index: i64, playing: bool):
        can Memory.Allocate, Abort.Panic:
            x: f64 = box.x + box.w / 2.0
            y: f64 = box.y + box.h * 0.5
            r: f64 = DrShapeView::min(box.w, box.h) * 0.16
            hue: u32 = 0xffd26eff if playing else 0x786eaaff
            if playing:
                loud: f64 = note_loudness(session, index)
                ScenePolish::glow(list, x, y, r * (2.2 + loud), hue, 80)
                for i in 0..<3 |list, x, y, r, hue, session|:
                    share: f64 = fraction(session.elapsed * 1.4 + i.f64() / 3.0)
                    ScenePolish::ring(list, x, y, r * (1.1 + 1.3 * share), 3.0, alpha(hue, (230.0 * (1.0 - share)).i64()), 24)
            Display::draw_rect(list, x - r * 0.9, y - r * 0.35, r * 0.5, r * 0.7, hue)
            Display::begin_polygon(list, 4, x - r * 0.4, y - r * 0.35, hue)
            Display::polygon_point(list, x - r * 0.4, y - r * 0.35)
            Display::polygon_point(list, x + r * 0.3, y - r * 0.9)
            Display::polygon_point(list, x + r * 0.3, y + r * 0.9)
            Display::polygon_point(list, x - r * 0.4, y + r * 0.35)

    def turtle(list: mutable Display::DisplayList&, pen: DrShapeView::Point, size: f64, t: f64, hue: u32, sounding: bool):
        can Memory.Allocate, Abort.Panic:
            r: f64 = size * 0.06 * (1.0 + 0.15 * (0.5 + 0.5 * sin(t * 12.0)))
            ScenePolish::glow(list, pen.x, pen.y, size * 0.16, hue, 120)
            for i in 0..<(3 if sounding else 0) |list, pen, size, t, hue|:
                share: f64 = fraction(t * 1.6 + i.f64() / 3.0)
                ScenePolish::ring(list, pen.x, pen.y, size * (0.08 + 0.3 * share), 2.0, alpha(hue, (200.0 * (1.0 - share)).i64()), 24)
            for i in 0..<10 |list, pen, r, t|:
                a: f64 = DrShape::TAU * i.f64() / 10.0 + t * DrShape::TAU / 4.0
                radius: f64 = r * (1.6 if i % 2 == 0 else 0.7)
                x: f64 = pen.x + radius * cos(a)
                y: f64 = pen.y + radius * sin(a)
                if i == 0:
                    Display::begin_polygon(list, 10, x, y, 0xffffe6ff)
                Display::polygon_point(list, x, y)

    def heard(mode: i64) -> bool:
        return mode == DrShape::HEAR or mode == DrShape::ECHO or mode == DrShape::HEAR_SCENE

    def show(list: mutable Display::DisplayList&, s: DrShapeGame::Session&, rect: DrShapeView::Rect):
        can Memory.Allocate, Abort.Panic:
            p: DrShapePuzzle::Puzzle& = &s.puzzle
            t: f64 = s.elapsed
            cx: f64 = rect.x + rect.w / 2.0
            cy: f64 = rect.y + rect.h / 2.0
            size: f64 = DrShapeView::min(rect.w, rect.h) * 0.3
            if heard(p.mode):
                speaker(list, cx, cy, size, s)
                return
            wobble: f64 = 0.01 * p.level.overload
            seed: u64 = (t * 20.0).u64()
            if DrShapePuzzle::scene(p.mode):
                width: f64 = DrShapeView::min(rect.w * 0.7, rect.h * 1.6)
                box: DrShapeView::Rect = DrShapeView::Rect{x: cx - width / 2.0, y: rect.y, w: width, h: rect.h * 0.9}
                play_scene(list, s, &p.platform.target, p.platform.look, box, true, false, wobble, seed)
                return
            form: DrShape::Form& = &p.match_cards.target
            view: DrShape::Matrix = DrShapeView::sway(p.match_cards.view, t)
            camera: mutable DrShapeView::Camera = DrShapeView::orbit_camera(view, cx, cy, size)
            scale: mutable f64 = size
            if p.level.floor and p.mode == DrShape::SEE:
                width: f64 = DrShapeView::min(rect.w * 0.75, rect.h * 1.7)
                box: DrShapeView::Rect = DrShapeView::Rect{x: cx - width / 2.0, y: rect.y + rect.h * 0.02, w: width, h: rect.h * 0.92}
                card(list, box, 0x20183eff, 0x785ac8ff)
                camera <- DrShapeView::floor_camera(box, view, 1.0, 0.0, DrShapeDeal::SHOW_DEPTH, lift(form, view, 1.0))
                scale <- camera.focal / DrShapeDeal::SHOW_DEPTH
                floor_view(list, box, &camera)
            strokes: f64 = DrShapeGame::strokes(s)
            drawn: DrShapeView::Figure = paint_form(list, form, &camera, &p.hues,
                scale * (0.9 if camera.kind == DrShapeView::FLOOR else 1.0), strokes, wobble, seed, false)
            if drawn.has_pen and strokes < form.path.count.f64():
                turtle(list, drawn.pen, scale, t, tint(&p.hues, form.tints[strokes.usize()]), p.mode != DrShape::SING)

    def choices(list: mutable Display::DisplayList&, s: DrShapeGame::Session&, area: DrShapeView::Rect):
        can Memory.Allocate, Abort.Panic:
            p: DrShapePuzzle::Puzzle& = &s.puzzle
            time: f64 = s.elapsed
            panel: bool = DrShapeView::panel(p)
            scene: bool = DrShapePuzzle::scene(p.mode)
            judged: bool = s.phase == DrShapeGame::JUDGED
            floor: bool = p.level.floor and p.mode == DrShape::SEE
            if panel:
                box: DrShapeView::Rect = DrShapeView::Rect{x: area.x + area.w * 0.03, y: area.y + area.h * 0.2, w: area.w * 0.22, h: area.h * 0.6}
                card(list, box, 0x241c46ff, 0x785ac8ff)
                x: f64 = box.x + box.w / 2.0
                Display::draw_text_weight(list, "the shape", x, box.y + box.h - 18.0, 14.0,
                    0xdcd2ffe6, Display::ANCHOR_CENTER_CENTER, true)
                scale: f64 = DrShapeView::min(box.w, box.h) * 0.34
                cam: DrShapeView::Camera = DrShapeView::orbit_camera(DrShapeView::sway(p.match_cards.view, time), x, box.y + box.h * 0.48, scale)
                form: DrShape::Form& = &p.match_cards.target
                _ = paint_form(list, form, &cam, &p.hues, scale, form.path.count.f64(), 0.0, 0, false)
            singing: i64 = DrShapeGame::sounding(s) if not scene else -1
            for i in 0..<p.count |p, list, s, area, time, panel, scene, judged, floor, singing|:
                rng: mutable MT19937 = zeroed
                mt_seed_int(&rng, DrShapeView::shake_seed(time, i))
                box: DrShapeView::Rect = DrShapeView::shaken(DrShapeView::cell(area, p.count, i, panel), p.level.overload, &rng)
                x: f64 = box.x + box.w / 2.0
                faded: bool = judged and i != p.answer
                active: bool = singing == i
                edge: mutable u32 = 0xffe678ff if active else 0x6e5ab4ff
                if active:
                    ScenePolish::glow(list, x, box.y + box.h / 2.0, box.w * 0.62, 0xffdc78ff, 70)
                if judged:
                    edge <- 0x5ae678ff if i == p.answer else (0xff5050ff if i == s.choice else edge)
                card(list, box, 0x20183eff, edge)
                hues: mutable i64[3] = p.hues
                if p.level.overload > 0.0 and py_random(&rng) < 0.15 * p.level.overload:
                    for j in 0..<3 |hues, rng|:
                        hues[j.usize()] <- py_choice_index(&rng, 12)
                wobble: f64 = 0.012 * p.level.overload
                seed: u64 = (time * 20.0).u64() + i.u64()
                if DrShapePuzzle::sound_cards(p.mode) and not judged:
                    sound_card(list, box, s, i, active)
                elif scene:
                    place: DrShapeDeal::PlatformCard& = &p.platform.cards[i.usize()]
                    play_scene(list, s, &place.layout, place.look, box, false, faded, wobble, seed)
                else:
                    candidate: DrShapeDeal::Candidate& = &p.match_cards.cards[i.usize()]
                    view: mutable DrShape::Matrix = candidate.view
                    if p.level.tumble and (floor or RoomsView::dot(candidate.spin, candidate.spin) > 0.0):
                        view <- DrShape::matmul(DrShape::axis_turn(candidate.spin, time * (0.6 if floor else 0.7)), view)
                    elif not DrShapePuzzle::sound_cards(p.mode):
                        view <- DrShapeView::sway(view, time, i)
                    scale: mutable f64 = DrShapeView::min(box.w, box.h) * 0.4
                    cam: mutable DrShapeView::Camera = DrShapeView::orbit_camera(view, x, box.y + box.h * 0.52, scale)
                    if floor:
                        cam <- DrShapeView::floor_camera(box, view, candidate.size, candidate.side, candidate.depth, lift(&candidate.form, view, candidate.size))
                        floor_view(list, box, &cam)
                        scale <- cam.focal / candidate.depth * candidate.size * 0.9
                    form: DrShape::Form& = &candidate.form
                    _ = paint_form(list, form, &cam, &hues, scale, form.path.count.f64(), wobble, seed, faded)
                badge: f64 = DrShapeView::min(box.w, box.h) * 0.09
                bx: f64 = box.x + badge * 1.4
                by: f64 = box.y + box.h - badge * 1.4
                Display::draw_circle(list, bx, by, badge, 0xfadc5aff)
                label: mutable dstr = []
                dstr_append_i64(&label, i + 1)
                Display::draw_text_weight(list, bytes_view(label), bx, by, badge * 0.95,
                    0x28143cff, Display::ANCHOR_CENTER_CENTER, true)

    def meters(list: mutable Display::DisplayList&, s: DrShapeGame::Session&, area: DrShapeView::Rect):
        can Memory.Allocate, Abort.Panic:
            return if s.puzzle.mode != DrShape::SEE and s.puzzle.mode != DrShape::SCENE
            l: mutable f64 = 0.0
            r: mutable f64 = 0.0
            for i in 0..<s.puzzle.notes.count |s, l, r|:
                note: DrShapeDeal::Note = s.puzzle.notes[i]
                if note.t <= s.elapsed and s.elapsed <= note.t + note.dur:
                    angle: f64 = (note.pan + 1.0) * DrShapeAudio::PI_OVER_FOUR
                    l <- l + note.gain * cos(angle)
                    r <- r + note.gain * sin(angle)
            for i in 0..<2 |area, list, l, r|:
                level: f64 = DrShapeView::min(1.0, l if i == 0 else r)
                box: DrShapeView::Rect = DrShapeView::Rect{x: area.x + area.w * (0.012 if i == 0 else 0.97),
                    y: area.y + area.h * 0.15, w: area.w * 0.018, h: area.h * 0.62}
                rounded(list, box, box.w / 2.0, 0x281e46ff)
                if level > 0.02:
                    rounded(list, DrShapeView::Rect{x: box.x, y: box.y, w: box.w, h: box.h * level},
                        box.w / 2.0, ScenePolish::mix_rgb(0x50dcffff, 0xff5ac8ff, level))
                Display::draw_text_weight(list, "L" if i == 0 else "R", box.x + box.w / 2.0,
                    box.y - 12.0, 10.0, 0xc8beffdc, Display::ANCHOR_CENTER_CENTER, true)

    def clock(list: mutable Display::DisplayList&, s: DrShapeGame::Session&, area: DrShapeView::Rect):
        can Memory.Allocate, Abort.Panic:
            choosing: bool = DrShapeGame::choosing(s)
            share: f64 = DrShapeView::max(0.0, 1.0 - (s.elapsed - s.puzzle.show_end) / s.puzzle.choose) if choosing else DrShapeView::min(1.0, s.elapsed / s.puzzle.show_end)
            colour: u32 = ScenePolish::mix_rgb(0xff505aff, 0x5ae6a0ff, DrShapeView::min(1.0, share * 1.6)) if choosing else 0xa078ffff
            w: f64 = area.w * 0.9
            h: f64 = area.h * 0.025
            x: f64 = area.x + area.w * 0.05
            y: f64 = area.y + area.h * 0.955
            rounded(list, DrShapeView::Rect{x: x, y: y, w: w, h: h}, h / 2.0, 0x322850ff)
            if share > 0.01:
                rounded(list, DrShapeView::Rect{x: x, y: y, w: w * share, h: h}, h / 2.0, colour)

    def sparks(list: mutable Display::DisplayList&, area: DrShapeView::Rect, t: f64, overload: f64):
        can Memory.Allocate, Abort.Panic:
            for k in 0..<(30.0 + 150.0 * overload).i64() |list, area, t, overload|:
                rng: mutable MT19937 = zeroed
                mt_seed_int(&rng, (k * 7919).u64())
                x: f64 = py_random(&rng)
                sx: f64 = fraction(x + t * py_uniform(&rng, -0.2, 0.2))
                y: f64 = py_random(&rng)
                sy: f64 = fraction(y + t * py_uniform(&rng, 0.05, 0.3))
                r: f64 = py_uniform(&rng, 1.0, 3.5)
                a: i64 = (80.0 + 120.0 * overload * (0.5 + 0.5 * sin(t * 9.0 + k.f64()))).i64()
                Display::draw_circle(list, area.x + sx * area.w, area.y + sy * area.h, r, alpha(wheel(k + (t * 3.0).i64()), a))
            flick: mutable MT19937 = zeroed
            mt_seed_int(&flick, (t * 12.0).u64())
            if py_random(&flick) < 0.35 * overload:
                colour: u32 = wheel(py_choice_index(&flick, 12))
                x: f64 = area.x + py_random(&flick) * area.w * 0.8
                y: f64 = area.y + py_random(&flick) * area.h * 0.8
                w: f64 = area.w * py_uniform(&flick, 0.1, 0.3)
                h: f64 = area.h * py_uniform(&flick, 0.05, 0.2)
                Display::draw_rect(list, x, y, w, h, alpha(colour, (40.0 + 60.0 * overload).i64()))
            for k in 0..<(6.0 * overload).i64() |list, area, t|:
                rng: mutable MT19937 = zeroed
                mt_seed_int(&rng, ((t * 4.0).i64() * 13 + k).u64())
                y: f64 = area.y + py_random(&rng) * area.h
                end: f64 = y + py_uniform(&rng, -20.0, 20.0)
                Display::draw_line(list, area.x, y, area.x + area.w, end, 1.0, alpha(wheel(py_choice_index(&rng, 12)), 90))

    def prompt(s: DrShapeGame::Session&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if s.phase == DrShapeGame::READY:
                dstr_append_cstr(out, "Could not deal Dr Shape. Press Space to retry" if s.deal_failed else "Press Space to start")
                return
            if s.phase == DrShapeGame::DONE:
                dstr_append_i64(out, s.passed)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, s.trial)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, s.best)
                return
            p: DrShapePuzzle::Puzzle& = &s.puzzle
            floor: bool = p.level.floor and p.mode == DrShape::SEE
            if DrShapeGame::choosing(s):
                question: mutable cstr = "Which is the same shape?"
                question <- "Which is the same shape, the same size?" if floor
                question <- "Which sound is the shape?" if p.mode == DrShape::SING
                question <- "Which is the same tune?" if p.mode == DrShape::ECHO
                question <- "Which is the same place, seen from elsewhere?" if p.mode == DrShape::SCENE
                question <- "Which place did you hear?" if p.mode == DrShape::HEAR_SCENE
                dstr_append_cstr(out, question)
                dstr_append_cstr(out, "  1-")
                dstr_append_i64(out, p.count)
            else:
                status: mutable cstr = "Watch and listen: the turtle draws a shape"
                status <- "Watch and listen: how big is it, how far?" if floor
                status <- "Listen: the shape is only heard" if p.mode == DrShape::HEAR
                status <- "Watch: the turtle draws in silence" if p.mode == DrShape::SING
                status <- "Listen to the tune" if p.mode == DrShape::ECHO
                status <- "Watch and listen: where does each thing stand?" if p.mode == DrShape::SCENE
                status <- "Listen: where does each thing stand?" if p.mode == DrShape::HEAR_SCENE
                dstr_append_cstr(out, status)

    def verdict(s: DrShapeGame::Session&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if s.result == DrShapeGame::RIGHT:
                dstr_append_cstr(out, "Card ")
                dstr_append_i64(out, s.choice + 1)
                dstr_append_cstr(out, " -- that is the one")
            else:
                if s.result == DrShapeGame::TIMEOUT:
                    dstr_append_cstr(out, "Time up -- it was card ")
                else:
                    dstr_append_cstr(out, "Not card ")
                    dstr_append_i64(out, s.choice + 1)
                    dstr_append_cstr(out, " -- it was card ")
                dstr_append_i64(out, s.puzzle.answer + 1)

    def render(list: mutable Display::DisplayList&, s: DrShapeGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x12121eff
            Display::draw_text_weight(list, "Dr Shape", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Watch and listen as the turtle draws   1-6 or click: pick the card that matches   Esc: menu",
                CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            message: mutable dstr = []
            prompt(s, &message)
            Display::draw_text(list, bytes_view(message), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            return if s.phase != DrShapeGame::PLAYING and s.phase != DrShapeGame::JUDGED
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, s.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, s.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, s.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, s.puzzle.count)
            dstr_append_cstr(&facts, " places   " if DrShapePuzzle::scene(s.puzzle.mode) else " candidates   ")
            dstr_append_cstr(&facts, "choosing" if DrShapeGame::choosing(s) else ("listening" if heard(s.puzzle.mode) else "watching"))
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            box: DrShapeView::Rect = area()
            background(list, box)
            if s.puzzle.level.overload > 0.0:
                sparks(list, box, s.elapsed, s.puzzle.level.overload)
            clock(list, s, box)
            meters(list, s, box)
            if DrShapeGame::choosing(s):
                choices(list, s, box)
            else:
                show(list, s, box)
            if s.phase == DrShapeGame::JUDGED:
                text: mutable dstr = []
                verdict(s, &text)
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, s.result == DrShapeGame::RIGHT, bytes_view(text), 60.0, 16.0)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            g: DrShape::Grade = DrShape::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, g.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, g.candidates)
            dstr_append_cstr(out, " candidates.")
            audible: mutable bool = false
            sound_cards: mutable bool = false
            scenes: mutable bool = false
            for i in 0..<g.mode_count |g, audible, sound_cards, scenes|:
                mode: i64 = g.modes[i.usize()].kind
                audible <- true if mode == DrShape::HEAR or mode == DrShape::ECHO
                sound_cards <- true if DrShapePuzzle::sound_cards(mode)
                scenes <- true if mode == DrShape::SCENE
            if audible:
                dstr_append_cstr(out, "  Some shapes are only heard.")
            if sound_cards:
                dstr_append_cstr(out, "  Some cards are sounds.")
            if g.colours > 1:
                dstr_append_cstr(out, "  Shapes in ")
                dstr_append_i64(out, g.colours)
                dstr_append_cstr(out, " colours.")
            if g.floor:
                dstr_append_cstr(out, "  Near and far.")
            if scenes:
                dstr_append_cstr(out, "  Scenes.")
            if g.mirror:
                dstr_append_cstr(out, "  Mirror images among them.")
            if g.overload > 0.0:
                dstr_append_cstr(out, "  Sensory overload.")
