include "./tasks/crickethunt_game.elisa"
include "./scene_live_view.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./scene_lens.elisa"

# ui/crickethunt.py: a dark room from inside it -- floor, ceiling, walls,
# the boards of the floor and three pieces of furniture, each drawn far to
# near -- and the crickets only once caught. Cross hairs mark the aim.
module SceneCricketHunt:
    const LEFT: f64 = (LiveView::WIDTH - LiveView::VIEW_WIDTH) / 2.0

    def bottom() -> f64:
        can Abort.Panic:
            return Verdict::above_the_band(LiveView::HEIGHT, Geometry::from_bottom_edge(LiveView::HEIGHT, 58.0).f64()).f64()

    def height() -> f64:
        can Abort.Panic:
            return fmax(40.0, Geometry::from_top_edge(LiveView::HEIGHT, 116.0).f64() - bottom())

    def label(list: mutable Display::DisplayList&, text: sview, y: f64, size: f64, ink: u32, bold: bool = false):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, LiveView::CX, y, size, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def clip() -> SceneLens::Clip:
        can Abort.Panic:
            b: f64 = bottom()
            return SceneLens::Clip{x0: LEFT, y0: b, x1: LEFT + LiveView::VIEW_WIDTH, y1: b + height()}

    def v(x: f64, y: f64, z: f64) -> SceneLens::Vec:
        return SceneLens::vec(x, y, z)

    def quad(list: mutable Display::DisplayList&, cut: SceneLens::Clip, lens: SceneLens::Lens&, a: SceneLens::Vec,
             b: SceneLens::Vec, c: SceneLens::Vec, d: SceneLens::Vec, ink: u32):
        can Memory.Allocate, Abort.Panic:
            shape: SceneLens::Solid = SceneLens::quad(a, b, c, d)
            SceneLens::face(list, cut, lens, &shape, ink)

    # Indexes 0..<count by key, largest first, ties in order (Python's
    # stable sort on the negated key).
    def farthest_first(keys: f64[4], count: i64) -> i64[4]:
        order: mutable i64[4] = [0, 1, 2, 3]
        for i in 1..<count |order, keys|:
            j: mutable i64 = i
            while j > 0 and keys[order[(j - 1).usize()].usize()] < keys[order[j.usize()].usize()] |order, keys, j|:
                swap: i64 = order[j.usize()]
                order[j.usize()] <- order[(j - 1).usize()]
                order[(j - 1).usize()] <- swap
                j <- j - 1
        return order

    # CricketHunt._draw, without the frame's card.
    def view(list: mutable Display::DisplayList&, run: CricketHunt::Run&):
        can Memory.Allocate, Abort.Panic:
            cut: SceneLens::Clip = clip()
            left: f64 = LEFT
            width: f64 = LiveView::VIEW_WIDTH
            b: f64 = bottom()
            h: f64 = height()
            look: f64[3] = CricketHunt::look(run.yaw, run.pitch)
            lens: SceneLens::Lens = SceneLens::camera(v(run.x, CricketHunt::EYE, run.z), v(look[0], look[1], look[2]), left, b,
                width, h, 70.0, true)
            s: f64 = run.room.level.room
            quad(list, cut, &lens, v(0.0, 0.0, 0.0), v(s, 0.0, 0.0), v(s, 0.0, s), v(0.0, 0.0, s), 0x1a1816ff)
            quad(list, cut, &lens, v(0.0, 2.8, 0.0), v(0.0, 2.8, s), v(s, 2.8, s), v(s, 2.8, 0.0), 0x101014ff)
            # the walls, (ax, az) to (bx, bz), far to near
            walls: f64[16] = [0.0, 0.0, s, 0.0, s, 0.0, s, s, s, s, 0.0, s, 0.0, s, 0.0, 0.0]
            far: mutable f64[4] = zeroed
            for i in 0..<4 |walls, far, run|:
                o: usize = (4 * i).usize()
                far[i.usize()] <- py_hypot((walls[o] + walls[o + 2]) / 2.0 - run.x, (walls[o + 1] + walls[o + 3]) / 2.0 - run.z)
            order: i64[4] = farthest_first(far, 4)
            for i in 0..<4 |list, cut, lens, walls, order|:
                o: usize = (4 * order[i.usize()]).usize()
                ax: f64 = walls[o]
                az: f64 = walls[o + 1]
                bx: f64 = walls[o + 2]
                bz: f64 = walls[o + 3]
                grey: u32 = (34 + 6 * i).u32()
                blue: u32 = (44 + 6 * i).u32()
                quad(list, cut, &lens, v(ax, 0.0, az), v(bx, 0.0, bz), v(bx, 2.8, bz), v(ax, 2.8, az),
                    (grey << 24.u32()) | (grey << 16.u32()) | (blue << 8.u32()) | 255.u32())
                SceneLens::seg(list, cut, &lens, v(ax, 0.01, az), v(bx, 0.01, bz), 2.0, 0x3c3c46ff)
            # the floor's boards
            for k in 1..<s.i64() |list, cut, lens, s|:
                SceneLens::seg(list, cut, &lens, v(k.f64(), 0.005, 0.0), v(k.f64(), 0.005, s), 1.0, 0x282622ff)
                SceneLens::seg(list, cut, &lens, v(0.0, 0.005, k.f64()), v(s, 0.005, k.f64()), 1.0, 0x282622ff)
            # the furniture, far to near
            pieces: f64[15] = run.room.furniture
            near: mutable f64[4] = zeroed
            for i in 0..<3 |pieces, near, run|:
                o: usize = (5 * i).usize()
                near[i.usize()] <- py_hypot(pieces[o] + pieces[o + 2] / 2.0 - run.x, pieces[o + 1] + pieces[o + 3] / 2.0 - run.z)
            ranked: i64[4] = farthest_first(near, 3)
            for i in 0..<3 |list, cut, lens, pieces, ranked|:
                o: usize = (5 * ranked[i.usize()]).usize()
                x: f64 = pieces[o]
                z: f64 = pieces[o + 1]
                SceneLens::box(list, cut, &lens, x, 0.0, z, x + pieces[o + 2], pieces[o + 4], z + pieces[o + 3], 0x3a3028ff)
            for k in 0..<run.room.level.crickets |list, cut, lens, run|:
                if run.caught[k.usize()]:
                    u: usize = (3 * k).usize()
                    SceneLens::ball(list, cut, &lens, v(run.where[u], run.where[u + 1], run.where[u + 2]), 0.06, 0x78dc82ff)
            # the aim
            cx: f64 = left + width / 2.0
            cy: f64 = b + h / 2.0
            SceneLens::line(list, cut, cx - 10.0, cy, cx + 10.0, cy, 1.0, 0xc8c8dc78)
            SceneLens::line(list, cut, cx, cy - 10.0, cx, cy + 10.0, 1.0, 0xc8c8dc78)

    def card(list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            frame: SceneLens::Clip = clip()
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: frame.x0 - 4.0, y: frame.y0 - 4.0,
                w: frame.x1 - frame.x0 + 8.0, h: frame.y1 - frame.y0 + 8.0}
            shades: u32[3] = [30.u32(), 18.u32(), 12.u32()]
            for i in 0..<3 |list, box, shades|:
                blur: f64 = i.f64() * 2.0
                shadow: SceneHiddenRule::Rect = ScenePolish::spread_box(&box, blur, 4.0)
                ScenePolish::rounded(list, &shadow, 14.0 + blur, shades[i.usize()])
            ScenePolish::rounded(list, &box, 14.0, 0x08090eff)

    def verdict_text(run: CricketHunt::Run&, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            count: i64 = run.room.level.crickets
            if run.result == CricketHunt::ALL_CAUGHT:
                dstr_append_cstr(words, "All ")
                dstr_append_i64(words, count)
                dstr_append_cstr(words, " caught in ")
                dstr_append_fixed(words, py_round_decimal(run.t, 1.0), 0)
                dstr_append_cstr(words, " s")
            elif run.result == CricketHunt::OUT_OF_TIME:
                dstr_append_i64(words, CricketHunt::caught_count(run))
                dstr_append_cstr(words, " of ")
                dstr_append_i64(words, count)
                dstr_append_cstr(words, " caught")
            elif run.result == CricketHunt::GRABS_AT_NOTHING:
                dstr_append_cstr(words, "Three grabs at nothing")

    def render(list: mutable Display::DisplayList&, session: CricketHuntGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            run: CricketHunt::Run& = &session.run
            label(list, "Cricket Hunt", 648.0, 22.0, ink, true)
            label(list, "W/S walk  A/D turn  Q/E or drag: look up/down  Space: grab   Esc: menu", 26.0, 12.0, ink)
            caption: mutable dstr = []
            verdict_text(run, &caption)
            status: mutable dstr = []
            if session.phase == CricketHuntGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == CricketHuntGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == CricketHuntGame::JUDGED:
                status <- caption
            else:
                dstr_append_cstr(&status, "Find the crickets by their chirping")
            label(list, bytes_view(status), 614.0, 14.0, ink)
            if session.phase == CricketHuntGame::PLAYING or session.phase == CricketHuntGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   caught ")
                dstr_append_i64(&facts, CricketHunt::caught_count(run))
                dstr_append_cstr(&facts, " of ")
                dstr_append_i64(&facts, run.room.level.crickets)
                dstr_append_cstr(&facts, "   grabs left ")
                dstr_append_i64(&facts, CricketHunt::MISSES - run.misses)
                label(list, bytes_view(facts), 588.0, 12.0, ink)
                card(list)
                view(list, run)
            if session.phase == CricketHuntGame::JUDGED or session.phase == CricketHuntGame::DONE:
                SceneVerdict::put(list, LiveView::WIDTH, LiveView::HEIGHT, 1.0, 1.0, run.result == CricketHunt::ALL_CAUGHT,
                    bytes_view(caption), 60.0, 16.0)

    # taskoptions.crickethunt_note.
    def option_note(rung: i64, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: CricketHunt::Grade = CricketHunt::grade(rung)
            dstr_append_cstr(words, "Rung ")
            dstr_append_i64(words, level.rung)
            dstr_append_cstr(words, ": ")
            dstr_append_i64(words, level.crickets)
            dstr_append_cstr(words, " cricket(s).")
            dstr_append_cstr(words, "  They hop.") if level.hop
