# The Marble Maze screen: game state in, display list out.
#
# Port of neural_workshop/ui/marblemaze.py -- the CHROME and the stage's
# rectangle, and not the 3D pass.
#
# Everything a player looks at here is drawn by a GL pipeline of its own:
# `ui/render3d.py` builds meshes, a camera and two passes, and hands them to
# the driver directly. Not one of those is a pyglet drawable, so the frame
# recorder cannot see any of it -- which means it cannot be checked the way
# every other line in this port has been, and it is left for a shell with a
# mesh pipeline rather than written here unverified.
#
# The web shell has no mesh/depth pipeline, so this scene also provides a
# deterministic 2D tray fallback. It preserves the task's visible affordances:
# walls, pits, the home cup, marbles, and a tilt indicator. Native shells may
# still replace this with the original 3D pass, but a web frame must never be
# reduced to three labels just because that optional pass is unavailable.
#
# That rectangle is not a formality. The tray is lit pine over a warm shadow,
# and a wooden midtone like (196, 128, 74) is a saturated RED as far as the
# outcome reader is concerned -- red over 180 with the other two under 140. A
# tray reaching into the bottom quarter would pay itself a losing verdict on
# any frame it happened to be lit that way, on trays nobody had lost.
#
# The rectangle is returned in FRAMEBUFFER pixels, which are the same as
# layout pixels everywhere except under pyglet's stretched DPI scaling.
# Getting that wrong puts the tray half off the screen on exactly the
# machines nobody tests on.
#
# NOTE: needs elisacore_math, pymath, strings, geometry, verdict, display and
# scene_verdict included by the driver.

module SceneMarbleMaze:

    const PHASE_READY: i64 = 0
    const PHASE_ROLLING: i64 = 1
    const PHASE_SETTLED: i64 = 2
    const PHASE_DONE: i64 = 3

    struct Paint:
        ink: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> Paint:
        back: i64 = 0 if black_background else 255
        fore: i64 = 255 - back
        return Paint{ink: Display::rgba(fore, fore, fore, 255),
                     width: width, height: height, sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: Paint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    def put_rect(list: mutable Display::DisplayList&, paint: Paint&, x: f64,
                 y: f64, width: f64, height: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, x / paint.sx, y / paint.sy,
                               width / paint.sx, height / paint.sy, color)

    def put_bordered_rect(list: mutable Display::DisplayList&, paint: Paint&,
                          x: f64, y: f64, width: f64, height: f64,
                          fill: u32, border: u32, border_width: f64):
        can Memory.Allocate, Abort.Panic:
            Display::draw_bordered_rect(list, x / paint.sx, y / paint.sy,
                                        width / paint.sx, height / paint.sy,
                                        fill, border, border_width / paint.sy)

    def put_circle(list: mutable Display::DisplayList&, paint: Paint&, x: f64,
                   y: f64, radius: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_circle(list, x / paint.sx, y / paint.sy,
                                 radius / paint.sy, color)

    def put_line(list: mutable Display::DisplayList&, paint: Paint&, x1: f64,
                 y1: f64, x2: f64, y2: f64, width: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_line(list, x1 / paint.sx, y1 / paint.sy,
                               x2 / paint.sx, y2 / paint.sy,
                               width / paint.sy, color)

    # A display-list fallback for the original's 3D tray. The task remains
    # deliberately sparse: the maze is a field of walls and hazards, not a
    # route painted for the player. `cursor` and `steps` are the browser's
    # action state, so the steel balls visibly respond to the arrow keys.
    def put_tray(list: mutable Display::DisplayList&, paint: Paint&, trial: i64,
                 marbles: i64, cursor: i64, steps: i64, roll_degrees: i64,
                 pitch_degrees: i64):
        can Memory.Allocate, Abort.Panic:
            wood: u32 = Display::rgba(205, 157, 93, 255)
            wood_shadow: u32 = Display::rgba(82, 51, 28, 255)
            rail: u32 = Display::rgba(111, 69, 35, 255)
            floor: u32 = Display::rgba(221, 187, 129, 255)
            wall: u32 = Display::rgba(93, 61, 35, 255)
            pit: u32 = Display::rgba(35, 24, 17, 255)
            pit_rim: u32 = Display::rgba(151, 106, 56, 255)
            home: u32 = Display::rgba(40, 150, 87, 255)
            steel: u32 = Display::rgba(236, 241, 248, 255)
            steel_shadow: u32 = Display::rgba(97, 108, 122, 210)
            tilt: u32 = Display::rgba(46, 92, 150, 255)

            left: f64 = paint.width * 0.12
            bottom: f64 = paint.height * 0.18
            width: f64 = paint.width * 0.76
            height: f64 = paint.height * 0.54
            put_rect(list, paint, left + 7.0, bottom - 8.0, width, height, wood_shadow)
            put_bordered_rect(list, paint, left, bottom, width, height,
                              wood, rail, 8.0)

            inner_left: f64 = left + 22.0
            inner_bottom: f64 = bottom + 22.0
            inner_width: f64 = width - 44.0
            inner_height: f64 = height - 44.0
            put_rect(list, paint, inner_left, inner_bottom,
                     inner_width, inner_height, floor)

            cols: i64 = 8
            rows: i64 = 5
            cell_width: f64 = inner_width / cols.f64()
            cell_height: f64 = inner_height / rows.f64()

            # Interior wall segments leave deterministic doorways and form a
            # real-looking maze without exposing a solution route.
            row: mutable i64 = 1
            while row < rows |row, cols, inner_left, inner_bottom, cell_width, cell_height, trial, wall, paint, list|:
                col: mutable i64 = 0
                while col < cols |col, row, cols, inner_left, inner_bottom, cell_width, cell_height, trial, wall, paint, list|:
                    if (row * 3 + col * 5 + trial) % 7 != 0:
                        x1: f64 = inner_left + col.f64() * cell_width
                        x2: f64 = x1 + cell_width
                        y: f64 = inner_bottom + row.f64() * cell_height
                        put_line(list, paint, x1, y, x2, y, 5.0, wall)
                    col <- col + 1
                row <- row + 1
            column: mutable i64 = 1
            while column < cols |column, rows, inner_left, inner_bottom, cell_width, cell_height, trial, wall, paint, list|:
                row2: mutable i64 = 0
                while row2 < rows |row2, column, rows, inner_left, inner_bottom, cell_width, cell_height, trial, wall, paint, list|:
                    if (column * 5 + row2 * 3 + trial + 2) % 7 != 0:
                        x: f64 = inner_left + column.f64() * cell_width
                        y1: f64 = inner_bottom + row2.f64() * cell_height
                        y2: f64 = y1 + cell_height
                        put_line(list, paint, x, y1, x, y2, 5.0, wall)
                    row2 <- row2 + 1
                column <- column + 1

            # Four pits and one green home cup. The locations are stable for a
            # trial but shift between trays, matching the reference's deal.
            hole: mutable i64 = 0
            while hole < 5 |hole, inner_left, inner_bottom, cell_width, cell_height, trial, pit_rim, pit, home, paint, list|:
                cell: i64 = (hole * 7 + 6 + trial * 3) % (cols * rows)
                cx: f64 = inner_left + (cell % cols).f64() * cell_width + cell_width / 2.0
                cy: f64 = inner_bottom + (cell / cols).f64() * cell_height + cell_height / 2.0
                put_circle(list, paint, cx, cy, cell_width * 0.22, pit_rim)
                put_circle(list, paint, cx, cy, cell_width * 0.16, home if hole == 4 else pit)
                hole <- hole + 1

            # The lead ball follows the action cursor around the tray. The
            # remaining balls trail it, so movement is visible even on a
            # multi-marble starter tray.
            marble: mutable i64 = 0
            count: i64 = 1 if marbles < 1 else (4 if marbles > 4 else marbles)
            while marble < count |marble, count, cursor, steps, cols, inner_left, inner_bottom, cell_width, cell_height, steel_shadow, steel, paint, list|:
                ball_cell: i64 = (cursor + steps * 2 + marble * 9 + 1) % (cols * rows)
                bx: f64 = inner_left + (ball_cell % cols).f64() * cell_width + cell_width / 2.0
                by: f64 = inner_bottom + (ball_cell / cols).f64() * cell_height + cell_height / 2.0
                put_circle(list, paint, bx + 3.0, by - 4.0, cell_width * 0.13, steel_shadow)
                put_circle(list, paint, bx, by, cell_width * 0.13, steel)
                marble <- marble + 1

            # A compact level indicator makes the arrow input legible even
            # when a ball is temporarily behind a wall segment.
            gauge_x: f64 = left + width - 52.0
            gauge_y: f64 = bottom + height - 34.0
            put_circle(list, paint, gauge_x, gauge_y, 18.0, floor)
            put_line(list, paint, gauge_x, gauge_y,
                     gauge_x + roll_degrees.f64() * 2.0,
                     gauge_y + pitch_degrees.f64() * 2.0, 4.0, tilt)
            put_circle(list, paint, gauge_x, gauge_y, 4.0, tilt)

    # Where the 3D pass goes, in framebuffer pixels. `across` and `down` are
    # the framebuffer's size over the layout's, which a shell measures for
    # itself; they are one on every ordinary display.
    struct Stage:
        left: mutable i64
        bottom: mutable i64
        width: mutable i64
        height: mutable i64

    def stage_of(out: mutable Stage&, width: f64, height: f64,
                 across: f64, down: f64):
        can Abort.Panic:
            bottom: i64 = Verdict::above_the_band(height, Geometry::from_bottom_edge(height, 58.0).f64())
            top: i64 = Geometry::from_top_edge(height, 88.0)
            left: i64 = (width * 0.03).i64()
            wide: i64 = (width * 0.94).i64()
            room: i64 = top - bottom
            tall: i64 = room if room > 48 else 48
            out.left <- (left.f64() * across).i64()
            out.bottom <- (bottom.f64() * down).i64()
            out.width <- (wide.f64() * across).i64()
            out.height <- (tall.f64() * down).i64()

    def render_with_board(list: mutable Display::DisplayList&, paint: Paint&, phase: i64,
               rolling: bool, trial: i64, total_trials: i64, home: i64,
               marbles: i64, seconds_left: i64, roll_degrees: i64,
               pitch_degrees: i64, message: sview, verdict: i64,
               verdict_text: sview, cursor: i64, steps: i64, show_board: bool):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()

            put_text(list, paint, sview("Marble Maze", 0, -1), middle,
                     Geometry::from_top_edge(paint.height, 36.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            put_tray(list, paint, trial, marbles, cursor, steps,
                     roll_degrees, pitch_degrees) if show_board

            status: mutable dstr = []
            dstr_append_sview(&status, message)
            if phase == PHASE_ROLLING and rolling:
                dstr_append_cstr(&status, "     tray ")
                dstr_append_i64(&status, trial)
                dstr_append_cstr(&status, "/")
                dstr_append_i64(&status, total_trials)
                dstr_append_cstr(&status, "   home ")
                dstr_append_i64(&status, home)
                dstr_append_cstr(&status, "/")
                dstr_append_i64(&status, marbles)
                dstr_append_cstr(&status, "   ")
                dstr_append_i64(&status, seconds_left)
                dstr_append_cstr(&status, "s left   tilt ")
                dstr_append_i64(&status, roll_degrees)
                dstr_append_cstr(&status, "°/")
                dstr_append_i64(&status, pitch_degrees)
                dstr_append_cstr(&status, "°")
            put_text(list, paint, bytes_view(status), middle,
                     Geometry::from_top_edge(paint.height, 62.0).f64(),
                     Geometry::calc_fontsize(paint.height, 14.0), paint.ink,
                     Display::ANCHOR_CENTER_TOP, false)

            put_text(list, paint,
                     sview("Esc: task menu   Space: start   Arrows: tip the tray   L: level it   R: restart   C: options", 0, -1),
                     middle, Geometry::from_bottom_edge(paint.height, 26.0).f64(),
                     Geometry::calc_fontsize(paint.height, 12.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            if verdict >= 0:
                SceneVerdict::put(list, paint.width, paint.height, paint.sx, paint.sy,
                                  verdict == 1, verdict_text, 60.0, 16.0)

    # Preserve the recorder-facing chrome API. The original Python screen's
    # tray is rendered by its native 3D pass and is intentionally absent from
    # the differential frame; the web task adapter calls render_with_board.
    def render(list: mutable Display::DisplayList&, paint: Paint&, phase: i64,
               rolling: bool, trial: i64, total_trials: i64, home: i64,
               marbles: i64, seconds_left: i64, roll_degrees: i64,
               pitch_degrees: i64, message: sview, verdict: i64,
               verdict_text: sview):
        can Memory.Allocate, Abort.Panic:
            render_with_board(list, paint, phase, rolling, trial, total_trials,
                              home, marbles, seconds_left, roll_degrees,
                              pitch_degrees, message, verdict, verdict_text,
                              0, 0, false)
