# The Marble Maze screen: game state in, display list out.
#
# Port of neural_workshop/ui/marblemaze.py -- the CHROME and the stage's
# rectangle, and not the 3D pass.
#
# Everything a player looks at here is drawn by a GL pipeline of its own:
# `ui/render3d.py` builds meshes, a camera and two passes, and hands them to
# the driver directly. Not one of those is a pyglet drawable, so the frame
# recorder cannot see any of it -- which means it cannot be checked the way
# every other line in this port has been, and it is left for a shell with a
# mesh pipeline rather than written here unverified.
#
# What IS here is the part the recorder can see and a shell needs told: three
# labels, the verdict, and the rectangle the 3D pass is given.
#
# That rectangle is not a formality. The tray is lit pine over a warm shadow,
# and a wooden midtone like (196, 128, 74) is a saturated RED as far as the
# outcome reader is concerned -- red over 180 with the other two under 140. A
# tray reaching into the bottom quarter would pay itself a losing verdict on
# any frame it happened to be lit that way, on trays nobody had lost.
#
# The rectangle is returned in FRAMEBUFFER pixels, which are the same as
# layout pixels everywhere except under pyglet's stretched DPI scaling.
# Getting that wrong puts the tray half off the screen on exactly the
# machines nobody tests on.
#
# NOTE: needs elisacore_math, pymath, strings, geometry, verdict, display and
# scene_verdict included by the driver.

module SceneMarbleMaze:

    const PHASE_READY: i64 = 0
    const PHASE_ROLLING: i64 = 1
    const PHASE_SETTLED: i64 = 2
    const PHASE_DONE: i64 = 3

    struct Paint:
        ink: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> Paint:
        back: i64 = 0 if black_background else 255
        fore: i64 = 255 - back
        return Paint{ink: Display::rgba(fore, fore, fore, 255),
                     width: width, height: height, sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: Paint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    # Where the 3D pass goes, in framebuffer pixels. `across` and `down` are
    # the framebuffer's size over the layout's, which a shell measures for
    # itself; they are one on every ordinary display.
    struct Stage:
        left: mutable i64
        bottom: mutable i64
        width: mutable i64
        height: mutable i64

    def stage_of(out: mutable Stage&, width: f64, height: f64,
                 across: f64, down: f64):
        can Abort.Panic:
            bottom: i64 = Verdict::above_the_band(height, Geometry::from_bottom_edge(height, 58.0).f64())
            top: i64 = Geometry::from_top_edge(height, 88.0)
            left: i64 = (width * 0.03).i64()
            wide: i64 = (width * 0.94).i64()
            room: i64 = top - bottom
            tall: i64 = room if room > 48 else 48
            out.left <- (left.f64() * across).i64()
            out.bottom <- (bottom.f64() * down).i64()
            out.width <- (wide.f64() * across).i64()
            out.height <- (tall.f64() * down).i64()

    def render(list: mutable Display::DisplayList&, paint: Paint&, phase: i64,
               rolling: bool, trial: i64, total_trials: i64, home: i64,
               marbles: i64, seconds_left: i64, roll_degrees: i64,
               pitch_degrees: i64, message: sview, verdict: i64,
               verdict_text: sview):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()

            put_text(list, paint, sview("Marble Maze", 0, -1), middle,
                     Geometry::from_top_edge(paint.height, 36.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            status: mutable dstr = []
            dstr_append_sview(&status, message)
            if phase == PHASE_ROLLING and rolling:
                dstr_append_cstr(&status, "     tray ")
                dstr_append_i64(&status, trial)
                dstr_append_cstr(&status, "/")
                dstr_append_i64(&status, total_trials)
                dstr_append_cstr(&status, "   home ")
                dstr_append_i64(&status, home)
                dstr_append_cstr(&status, "/")
                dstr_append_i64(&status, marbles)
                dstr_append_cstr(&status, "   ")
                dstr_append_i64(&status, seconds_left)
                dstr_append_cstr(&status, "s left   tilt ")
                dstr_append_i64(&status, roll_degrees)
                dstr_append_cstr(&status, "°/")
                dstr_append_i64(&status, pitch_degrees)
                dstr_append_cstr(&status, "°")
            put_text(list, paint, bytes_view(status), middle,
                     Geometry::from_top_edge(paint.height, 62.0).f64(),
                     Geometry::calc_fontsize(paint.height, 14.0), paint.ink,
                     Display::ANCHOR_CENTER_TOP, false)

            put_text(list, paint,
                     sview("Esc: task menu   Space: start   Arrows: tip the tray   L: level it   R: restart   C: options", 0, -1),
                     middle, Geometry::from_bottom_edge(paint.height, 26.0).f64(),
                     Geometry::calc_fontsize(paint.height, 12.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            if verdict >= 0:
                SceneVerdict::put(list, paint.width, paint.height, paint.sx, paint.sy,
                                  verdict == 1, verdict_text, 60.0, 16.0)
