# The display list: the core's per-frame output contract.
#
# See docs/display-list.md for the rationale. The core never draws; it emits a
# flat command stream in the historic 912x684 reference space and lets each
# platform shell interpret it.
#
# Records are fixed-size so a shell can walk the stream without allocating and
# the binary encoder is a memcpy. Strings live in a side pool referenced by
# (offset, length), never embedded.

module Display:
    const DISPLAY_LIST_MAGIC: u32 = 1313426254      # "NWDL" little-endian
    const DISPLAY_LIST_VERSION: u32 = 1

    # Reference space. Shells own the mapping to physical pixels, so HiDPI and
    # letterboxing are solved once per platform rather than once per widget.
    const REFERENCE_WIDTH: f64 = 912.0
    const REFERENCE_HEIGHT: f64 = 684.0

    const CMD_RECT: u8 = 1
    const CMD_BORDERED_RECT: u8 = 2
    const CMD_BOX: u8 = 3
    const CMD_CIRCLE: u8 = 4
    const CMD_ARC: u8 = 5
    const CMD_LINE: u8 = 6
    const CMD_TRIANGLE: u8 = 7
    const CMD_POLYGON: u8 = 8
    const CMD_POLY_POINT: u8 = 9
    const CMD_SPRITE: u8 = 10
    const CMD_TEXT: u8 = 11
    const CMD_VERDICT: u8 = 12
    const CMD_SOUND: u8 = 13
    const CMD_MARKER: u8 = 14
    # A sprite fitted into a BOX rather than drawn at a scale the core chose.
    # The core cannot know an image's pixel size -- the artwork is a resource
    # anyone may replace -- so it names the room and lets the shell, which has the
    # decoded image, do the fit. Rule: scale = min(room_w/image_w, room_h/image_h),
    # drawn centred on the room. That is the original's `_place_splash` exactly,
    # and it is why a 2000x500 logo lands in the same gap as a square one.
    const CMD_SPRITE_FIT: u8 = 15
    # An open or closed run of joined segments -- pyglet's MultiLine. A header
    # followed by `len` CMD_POLY_POINT records, the same shape CMD_POLYGON uses.
    # 16 rather than the next free number because that is what the frame
    # recorder already calls the class, and two numberings for one thing is a
    # bug waiting for a scene to find it.
    const CMD_MULTILINE: u8 = 16
    # A regular star, pyglet's Star: two radii, a spike count and a rotation.
    # 17 for the same reason 16 is 16.
    const CMD_STAR: u8 = 17

    # Text anchoring, packed into a command's `len` field alongside the string
    # length: anchor = len >> 24, length = len & 0xFFFFFF.
    const ANCHOR_LEFT_BOTTOM: u32 = 0
    const ANCHOR_CENTER_BOTTOM: u32 = 1
    const ANCHOR_RIGHT_BOTTOM: u32 = 2
    const ANCHOR_LEFT_CENTER: u32 = 3
    const ANCHOR_CENTER_CENTER: u32 = 4
    const ANCHOR_RIGHT_CENTER: u32 = 5
    const ANCHOR_LEFT_TOP: u32 = 6
    const ANCHOR_CENTER_TOP: u32 = 7
    const ANCHOR_RIGHT_TOP: u32 = 8

    # Asset identifiers. A shell loads the artwork; the core only ever names it.
    #
    # Two splashes, not one, and for a reason the original states in a test name:
    # "the dark logo is ink and not a white card". A logo drawn for a white page is
    # an opaque bright slab on a black one, so bootstrap.py picks 'splash-black' or
    # 'splash' from BLACK_BACKGROUND. The core makes the same choice by naming a
    # different asset.
    const ASSET_SPLASH: u32 = 1
    const ASSET_SPLASH_DARK: u32 = 2

    struct DrawCmd:
        kind: u8
        color: u32
        a: f32
        b: f32
        c: f32
        d: f32
        e: f32
        f: f32
        ref: u32
        len: u32

    struct DisplayList:
        commands: mutable darray[DrawCmd]
        pool: mutable darray[u8]

    def rgba(red: i64, green: i64, blue: i64, alpha: i64) -> u32:
        return ((red % 256).u32() << 24.u32()) | ((green % 256).u32() << 16.u32()) | ((blue % 256).u32() << 8.u32()) | (alpha % 256).u32()

    # The list's buffers are allocated in the innermost active region, so a caller
    # wraps construction in `in arena:` to choose one. Taking an Arena& here instead
    # would make every draw_* call region-polymorphic in the LIST parameter, and the
    # region cannot be inferred at those call sites.
    def DisplayList() -> DisplayList:
        can Memory.Allocate, Abort.Panic:
            commands: mutable darray[DrawCmd] = []
            pool: mutable darray[u8] = []
            return DisplayList{commands: commands, pool: pool}

    def display_reset(list: mutable DisplayList&):
        can Abort.Panic:
            list.commands.clear()
            list.pool.clear()

    def push_cmd(list: mutable DisplayList&, cmd: DrawCmd):
        can Memory.Allocate, Abort.Panic:
            list.commands.push(cmd)

    # Copy `text` into the pool and return its packed (offset, length) pair.
    def pool_intern(list: mutable DisplayList&, text: sview) -> u32:
        can Memory.Allocate, Abort.Panic:
            offset: u32 = list.pool.count.u32()
            length: i64 = sview_len(text).i64()
            index: mutable i64 = 0
            while index < length |index, list, text|:
                list.pool.push(sview_at(text, index.usize()))
                index <- index + 1
            return offset

    # ------------------------------------------------------------
    # Primitives
    # ------------------------------------------------------------

    def draw_rect(list: mutable DisplayList&, x: f64, y: f64, width: f64, height: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_RECT, color: color, a: x.f32(), b: y.f32(), c: width.f32(), d: height.f32(), e: 0.0.f32(), f: 0.0.f32(), ref: 0.u32(), len: 0.u32()})

    def draw_bordered_rect(list: mutable DisplayList&, x: f64, y: f64, width: f64, height: f64, fill: u32, border: u32, border_width: f64):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_BORDERED_RECT, color: fill, a: x.f32(), b: y.f32(), c: width.f32(), d: height.f32(), e: border_width.f32(), f: 0.0.f32(), ref: border, len: 0.u32()})

    # An outline-only rectangle (pyglet's shapes.Box).
    # The same rectangle, drawn about an ANCHOR inside it rather than about
    # its bottom-left corner. `x`, `y` still name the corner -- the anchor is
    # subtracted by whoever draws it, which is what pyglet does with
    # `anchor_position` -- so a glyph centred on a point passes the point's
    # own coordinates and half the side.
    def draw_rect_anchored(list: mutable DisplayList&, x: f64, y: f64, width: f64, height: f64, anchor_x: f64, anchor_y: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_RECT, color: color, a: x.f32(), b: y.f32(), c: width.f32(), d: height.f32(), e: anchor_x.f32(), f: anchor_y.f32(), ref: 0.u32(), len: 0.u32()})

    # The same rectangle again, TURNED about its anchor. `a` through `f` are
    # spoken for, so the angle rides in `ref` -- the f32's own bits, in
    # DEGREES CLOCKWISE, which is the direction pyglet turns. Freeform Tetris
    # is the only screen that uses it, and its piece's angle is anticlockwise,
    # so it passes the negative of its own.
    def draw_rect_turned(list: mutable DisplayList&, x: f64, y: f64, width: f64, height: f64, anchor_x: f64, anchor_y: f64, rotation: f64, color: u32):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            push_cmd(list, DrawCmd{kind: CMD_RECT, color: color, a: x.f32(), b: y.f32(), c: width.f32(), d: height.f32(), e: anchor_x.f32(), f: anchor_y.f32(), ref: f32_bits(rotation.f32()), len: 0.u32()})

    # An f32 as the u32 its bytes spell. memcpy rather than a numeric cast:
    # we need the BIT pattern, not a value conversion.
    def f32_bits(value: f32) -> u32:
        can Abort.Panic, Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                holder: f32[1] = zeroed
                holder[0] <- value
                out: u32[1] = zeroed
                memcpy((&out[0]).cast[mutable void&], (&holder[0]).cast[void&], 4.usize())
                return out[0]

    def draw_star(list: mutable DisplayList&, x: f64, y: f64, outer: f64, inner: f64, spikes: i64, rotation: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_STAR, color: color, a: x.f32(), b: y.f32(), c: outer.f32(), d: inner.f32(), e: spikes.f64().f32(), f: rotation.f32(), ref: 0.u32(), len: 0.u32()})

    def draw_box(list: mutable DisplayList&, x: f64, y: f64, width: f64, height: f64, color: u32, thickness: f64):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_BOX, color: color, a: x.f32(), b: y.f32(), c: width.f32(), d: height.f32(), e: thickness.f32(), f: 0.0.f32(), ref: 0.u32(), len: 0.u32()})

    def draw_circle(list: mutable DisplayList&, x: f64, y: f64, radius: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_CIRCLE, color: color, a: x.f32(), b: y.f32(), c: radius.f32(), d: 0.0.f32(), e: 0.0.f32(), f: 0.0.f32(), ref: 0.u32(), len: 0.u32()})

    def draw_arc(list: mutable DisplayList&, x: f64, y: f64, radius: f64, start_angle: f64, sweep: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_ARC, color: color, a: x.f32(), b: y.f32(), c: radius.f32(), d: 0.0.f32(), e: start_angle.f32(), f: sweep.f32(), ref: 0.u32(), len: 0.u32()})

    def draw_line(list: mutable DisplayList&, x1: f64, y1: f64, x2: f64, y2: f64, width: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_LINE, color: color, a: x1.f32(), b: y1.f32(), c: x2.f32(), d: y2.f32(), e: width.f32(), f: 0.0.f32(), ref: 0.u32(), len: 0.u32()})

    def draw_triangle(list: mutable DisplayList&, x1: f64, y1: f64, x2: f64, y2: f64, x3: f64, y3: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_TRIANGLE, color: color, a: x1.f32(), b: y1.f32(), c: x2.f32(), d: y2.f32(), e: x3.f32(), f: y3.f32(), ref: 0.u32(), len: 0.u32()})

    # A polygon header followed by `point_count` CMD_POLY_POINT records.
    #
    # `x`, `y` is the FIRST point again, for the reason a multiline's is: a
    # polygon takes its anchor from its first coordinate, and the recorder
    # reads it back off `obj.x`.
    def begin_polygon(list: mutable DisplayList&, point_count: i64, x: f64, y: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_POLYGON, color: color, a: x.f32(), b: y.f32(), c: 0.0.f32(), d: 0.0.f32(), e: 0.0.f32(), f: 0.0.f32(), ref: 0.u32(), len: point_count.u32()})

    # `x`, `y` is the FIRST point again: pyglet takes the run's anchor from
    # its first coordinate, and the recorder reads it back off `obj.x`.
    def begin_multiline(list: mutable DisplayList&, point_count: i64, x: f64, y: f64, thickness: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_MULTILINE, color: color, a: x.f32(), b: y.f32(), c: thickness.f32(), d: 0.0.f32(), e: 0.0.f32(), f: 0.0.f32(), ref: 0.u32(), len: point_count.u32()})

    def polygon_point(list: mutable DisplayList&, x: f64, y: f64):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_POLY_POINT, color: 0.u32(), a: x.f32(), b: y.f32(), c: 0.0.f32(), d: 0.0.f32(), e: 0.0.f32(), f: 0.0.f32(), ref: 0.u32(), len: 0.u32()})

    # `asset` identifies an image the shell has loaded; the core never decodes one.
    # `x`, `y` are the sprite's BOTTOM-LEFT origin, matching pyglet.Sprite and
    # the frame recorder. `draw_sprite_fitted` below is a separate primitive
    # whose room coordinates are explicitly a centre.
    #
    # `image_width` and `image_height` are the decoded image's pixel size, and
    # they are here because some screens SCALE BY IT: Reflex sizes a target by
    # `side / image.width`, so a core that did not know the width could not
    # produce the scale. They are passed IN by whoever loaded the image rather
    # than being decoded here, which keeps the decoding on the shell's side of
    # the seam while letting the arithmetic stay on this one.
    def draw_sprite(list: mutable DisplayList&, asset: u32, x: f64, y: f64, scale: f64, rotation: f64, image_width: i64, image_height: i64, color: u32):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_SPRITE, color: color, a: x.f32(), b: y.f32(), c: scale.f32(), d: image_width.f64().f32(), e: rotation.f32(), f: image_height.f64().f32(), ref: asset, len: 0.u32()})

    # `x`, `y` is the CENTRE of the room; `room_width`, `room_height` its extent.
    def draw_sprite_fitted(list: mutable DisplayList&, asset: u32, x: f64, y: f64, room_width: f64, room_height: f64, rotation: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_SPRITE_FIT, color: color, a: x.f32(), b: y.f32(), c: room_width.f32(), d: room_height.f32(), e: rotation.f32(), f: 0.0.f32(), ref: asset, len: 0.u32()})

    def draw_text(list: mutable DisplayList&, text: sview, x: f64, y: f64, size: f64, color: u32, anchor: u32):
        can Memory.Allocate, Abort.Panic:
            draw_text_weight(list, text, x, y, size, color, anchor, false)

    # The same, saying whether the face is bold.
    #
    # `d` was free on a TEXT command and is now the weight, which keeps this
    # additive: a shell built before this reads `d` as nothing on a TEXT and
    # goes on drawing at normal weight, which is what it drew anyway. The
    # alternative -- a new command kind -- would have made every existing shell
    # skip the text entirely, and a frame that silently loses its labels is the
    # failure this format's version word exists to avoid.
    #
    # It has to be carried because the original asks for it: every task screen
    # draws its title with `weight='bold'`, and a title that comes back at
    # normal weight is a different frame.
    def draw_text_weight(list: mutable DisplayList&, text: sview, x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            offset: u32 = pool_intern(list, text)
            length: u32 = sview_len(text).u32()
            push_cmd(list, DrawCmd{kind: CMD_TEXT, color: color, a: x.f32(), b: y.f32(), c: size.f32(), d: 1.0.f32() if bold else 0.0.f32(), e: 0.0.f32(), f: 0.0.f32(), ref: offset, len: (anchor << 24.u32()) | length})

    # TEXT e is clockwise degrees and f is one plus the typeface slot.
    # A zero f leaves the host's ordinary text defaults in effect.
    def draw_faced_text(list: mutable DisplayList&, text: sview, x: f64, y: f64, size: f64, color: u32, rotation: f64, face: i64):
        can Memory.Allocate, Abort.Panic:
            offset: u32 = pool_intern(list, text)
            length: u32 = sview_len(text).u32()
            push_cmd(list, DrawCmd{kind: CMD_TEXT, color: color, a: x.f32(), b: y.f32(), c: size.f32(), d: 0.0.f32(),
                e: rotation.f32(), f: (face + 1).f32(), ref: offset, len: (ANCHOR_CENTER_CENTER << 24.u32()) | length})

    # ------------------------------------------------------------
    # Non-drawing commands
    # ------------------------------------------------------------

    # The trial's outcome as DATA. The original derives the agent's reward by
    # counting coloured label runs in the rendered frame; here the verdict is a
    # command, so verification anchors to the stream rather than to anti-aliased
    # pixels. Codes match matching.elisa's verdict_code.
    def emit_verdict(list: mutable DisplayList&, verdict_code: i64):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_VERDICT, color: 0.u32(), a: 0.0.f32(), b: 0.0.f32(), c: 0.0.f32(), d: 0.0.f32(), e: 0.0.f32(), f: 0.0.f32(), ref: verdict_code.u32(), len: 0.u32()})

    def emit_sound(list: mutable DisplayList&, asset: u32, gain: f64):
        can Memory.Allocate, Abort.Panic:
            push_cmd(list, DrawCmd{kind: CMD_SOUND, color: 0.u32(), a: gain.f32(), b: 0.0.f32(), c: 0.0.f32(), d: 0.0.f32(), e: 0.0.f32(), f: 0.0.f32(), ref: asset, len: 0.u32()})

    def emit_marker(list: mutable DisplayList&, name: sview):
        can Memory.Allocate, Abort.Panic:
            offset: u32 = pool_intern(list, name)
            push_cmd(list, DrawCmd{kind: CMD_MARKER, color: 0.u32(), a: 0.0.f32(), b: 0.0.f32(), c: 0.0.f32(), d: 0.0.f32(), e: 0.0.f32(), f: 0.0.f32(), ref: offset, len: sview_len(name).u32()})

    # ------------------------------------------------------------
    # Binary encoding
    # ------------------------------------------------------------

    def put_u32(out: mutable darray[u8]&, value: u32):
        can Memory.Allocate, Abort.Panic:
            out.push((value & 255.u32()).u8())
            out.push(((value >> 8.u32()) & 255.u32()).u8())
            out.push(((value >> 16.u32()) & 255.u32()).u8())
            out.push(((value >> 24.u32()) & 255.u32()).u8())

    # Little-endian IEEE-754 bytes. memcpy rather than a numeric cast: we need the
    # BIT pattern, not a value conversion. Hosts are little-endian on every target
    # this port builds for; a big-endian shell would swap here.
    def put_f32(out: mutable darray[u8]&, value: f32):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                holder: f32[1] = zeroed
                holder[0] <- value
                bytes: u8[4] = zeroed
                memcpy((&bytes[0]).cast[mutable void&], (&holder[0]).cast[void&], 4.usize())
                out.push(bytes[0])
                out.push(bytes[1])
                out.push(bytes[2])
                out.push(bytes[3])

    # [magic][version][cmd_count][pool_len][commands...][pool bytes]
    def encode_binary(list: DisplayList&) -> darray[u8]:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            out: mutable darray[u8] = []
            put_u32(&out, DISPLAY_LIST_MAGIC)
            put_u32(&out, DISPLAY_LIST_VERSION)
            put_u32(&out, list.commands.count.u32())
            put_u32(&out, list.pool.count.u32())
            for cmd in list.commands |out|:
                out.push(cmd.kind)
                out.push(0.u8())
                out.push(0.u8())
                out.push(0.u8())
                put_u32(&out, cmd.color)
                put_f32(&out, cmd.a)
                put_f32(&out, cmd.b)
                put_f32(&out, cmd.c)
                put_f32(&out, cmd.d)
                put_f32(&out, cmd.e)
                put_f32(&out, cmd.f)
                put_u32(&out, cmd.ref)
                put_u32(&out, cmd.len)
            for byte in list.pool |out|:
                out.push(byte)
            return out
