include "./tasks/proofreader_game.elisa"
include "./scene_missing_word.elisa"

module SceneProofreader:
    def page(list: mutable Display::DisplayList&, run: Proofreader::Run&):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            n: i64 = run.machine.level.sentences
            top: f64 = MissingWord::row_y(0, n) + 44.0
            bottom: f64 = MissingWord::row_y(n - 1, n) - 40.0
            SceneMissingWord::rect(list, 20.0, bottom, 960.0, top - bottom, 0xf6f0e2ff)
            SceneMissingWord::rect(list, 20.0, bottom, 6.0, top - bottom, 0xdc786eff)
            carry: Proofreader::Carry = run.carry
            for r in 0..<n |list, run, n, carry|:
                lifted: bool = carry.kind == Proofreader::CARRY_ROW and carry.row == r
                y: f64 = run.hand.y if lifted else MissingWord::row_y(r, n)
                SceneMissingWord::rect(list, Proofreader::HANDLE_X - 22.0, y - 16.0, 44.0, 32.0,
                    0x7882a0ff if lifted else 0x96a0beff)
                label: mutable dstr = []
                dstr_append_i64(&label, r + 1)
                SceneHand::word(list, bytes_view(label), Proofreader::HANDLE_X, y, 13.0, 0xffffffff, true)
                row: MissingWord::Line& = &run.rows[r.usize()]
                tiles: Proofreader::Layout = Proofreader::layout(row)
                for i in 0..<row.count |list, run, row, tiles, r, y, lifted, carry|:
                    continue if carry.kind == Proofreader::CARRY_WORD and carry.row == r and carry.index == i
                    token: MissingWord::Token = row.words[i.usize()]
                    word: mutable Passages::Word = token.text
                    word.capitals <- word.capitals | 1.u64() if i == 0
                    SceneMissingWord::word_tile(list, word, i + 1 == row.count, tiles.centres[i.usize()], y,
                        tiles.widths[i.usize()], 15.0 * tiles.scale, token.id == run.selected, lifted)
            if carry.kind == Proofreader::CARRY_WORD:
                row: MissingWord::Line& = &run.rows[carry.row.usize()]
                tiles: Proofreader::Layout = Proofreader::layout(row)
                i: usize = carry.index.usize()
                SceneMissingWord::word_tile(list, row.words[i].text, false, run.hand.x, run.hand.y, tiles.widths[i],
                    15.0 * tiles.scale, false, true)
            opts: MissingWord::Offer = Proofreader::options(run)
            if opts.count > 0:
                SceneHand::word(list, "Its forms:", 500.0, MissingWord::OPT_Y + 30.0, 10.0, 0xe6e6f0ff)
                for k in 0..<opts.count |list, opts|:
                    SceneMissingWord::word_tile(list, opts.words[k.usize()], false,
                        MissingWord::option_x(k, opts.count), MissingWord::OPT_Y, MissingWord::OPT_WIDTH)
            SceneMissingWord::button(list, MissingWord::DONE_X, "DONE")
            SceneMissingWord::button(list, MissingWord::RESET_X, "RESET")

    def option_note(rung: i64, text: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Proofreader::Grade = Proofreader::grade(rung)
            dstr_append_cstr(text, "Rung ")
            dstr_append_i64(text, level.rung)
            dstr_append_cstr(text, ": ")
            dstr_append_i64(text, level.sentences)
            dstr_append_cstr(text, " sentence(s), ")
            dstr_append_i64(text, level.errors)
            dstr_append_cstr(text, " mistake(s) to mend.")

    def verdict(run: Proofreader::Run&, text: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.result == Proofreader::MENDED:
                dstr_append_cstr(text, "Mended")
                return
            dstr_append_cstr(text, "Out of time: " if run.result == Proofreader::TIMEOUT else "Not as it was written: ")
            for i in 0..<run.machine.level.sentences |run, text|:
                dstr_append_cstr(text, " ") if i > 0
                row: MissingWord::Line& = &run.machine.original[i.usize()]
                for j in 0..<row.count |row, text|:
                    dstr_append_cstr(text, " ") if j > 0
                    word: mutable Passages::Word = row.words[j.usize()].text
                    word.capitals <- 1.u64() if j == 0 else 0.u64()
                    Passages::append_word(text, word)
                dstr_append_cstr(text, ".")

    def render(list: mutable Display::DisplayList&, session: ProofreaderGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            SceneMissingWord::label(list, "The Proofreader", 648.0, 22.0, ink, true)
            SceneMissingWord::label(list, "Drag words along a line, sentences by their number   Click a word for its forms   Enter: done   R: reset", 26.0, 12.0, ink)
            run: Proofreader::Run& = &session.run
            status: mutable dstr = []
            if session.phase == ProofreaderGame::READY:
                dstr_append_cstr(&status, "No passage available for this rung" if session.unavailable else "Press Space or click to start")
            elif session.phase == ProofreaderGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == ProofreaderGame::JUDGED:
                raw: mutable dstr = []
                verdict(run, &raw)
                SceneMissingWord::caption(bytes_view(raw), &status)
            else:
                dstr_append_cstr(&status, "Mend the passage")
                if run.machine.level.hint:
                    ordered: bool = run.machine.level.sentences > 1
                    dstr_append_cstr(&status, ": ")
                    dstr_append_i64(&status, run.machine.count - (1 if ordered else 0))
                    dstr_append_cstr(&status, " mistake(s)")
                    dstr_append_cstr(&status, ", and the sentences out of order") if ordered
            SceneMissingWord::label(list, bytes_view(status), 614.0, 14.0, ink)
            if session.phase == ProofreaderGame::PLAYING or session.phase == ProofreaderGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                SceneMissingWord::label(list, bytes_view(facts), 588.0, 12.0, ink)
                SceneHand::card(list, 0x363c4aff)
                page(list, run)
                SceneHand::progress(list, &run.hand, fmax(0.0, (run.machine.level.seconds - run.t) / run.machine.level.seconds))
            if session.phase == ProofreaderGame::JUDGED or session.phase == ProofreaderGame::DONE:
                raw: mutable dstr = []
                final_text: mutable dstr = []
                verdict(run, &raw)
                SceneMissingWord::caption(bytes_view(raw), &final_text)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.result == Proofreader::MENDED, bytes_view(final_text), 60.0, 16.0)
