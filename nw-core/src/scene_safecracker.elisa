include "./tasks/safecracker_game.elisa"
include "./scene_hand.elisa"
include "./scene_verdict.elisa"

module SceneSafecracker:
    struct View:
        camera: HandView::Lens
        door: Safecracker::Frame

    def project(view: View&, u: f64, v: f64, depth: f64 = 0.0) -> RoomsView::Vec:
        return Safecracker::see(&view.camera, &view.door, u, v, depth)

    def quad(list: mutable Display::DisplayList&, a: RoomsView::Vec, b: RoomsView::Vec,
             c: RoomsView::Vec, d: RoomsView::Vec, colour: u32):
        can Memory.Allocate, Abort.Panic:
            points: mutable RoomsView::Vec[32] = zeroed
            points[0] <- a
            points[1] <- b
            points[2] <- c
            points[3] <- d
            SceneHand::polygon(list, &points, 4, colour)

    def disc(list: mutable Display::DisplayList&, p: RoomsView::Vec, radius: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            return if p.z < 0.05 or p.x < -radius or p.x > HandView::WIDTH + radius or p.y < -radius or p.y > HandView::HEIGHT + radius
            Display::draw_circle(list, SceneHand::x(p.x), SceneHand::y(p.y), radius * SceneHand::SCALE, colour)

    def door(list: mutable Display::DisplayList&, view: View&, run: Safecracker::Run&):
        can Memory.Allocate, Abort.Panic:
            a: RoomsView::Vec = project(view, 0.0, 0.0)
            b: RoomsView::Vec = project(view, 4.0, 0.0)
            c: RoomsView::Vec = project(view, 4.0, 4.6)
            d: RoomsView::Vec = project(view, 0.0, 4.6)
            quad(list, HandView::see(&view.camera, RoomsView::vec(-0.25, -0.2, -0.05)),
                HandView::see(&view.camera, RoomsView::vec(4.25, -0.2, -0.05)),
                HandView::see(&view.camera, RoomsView::vec(4.25, 4.8, -0.05)),
                HandView::see(&view.camera, RoomsView::vec(-0.25, 4.8, -0.05)), 0x181618ff)
            quad(list, b, project(view, 4.0, 0.0, -0.35), project(view, 4.0, 4.6, -0.35), c, 0x505868ff)
            quad(list, a, b, c, d, 0x788296ff)
            SceneHand::line(list, a, b, 3.0, 0x3c4250ff)
            SceneHand::line(list, b, c, 3.0, 0x3c4250ff)
            SceneHand::line(list, c, d, 3.0, 0x3c4250ff)
            SceneHand::line(list, d, a, 3.0, 0x3c4250ff)
            for i in 0..<2 |list, view|:
                v: f64 = 0.9 if i == 0 else 4.6 - 0.9
                SceneHand::line(list, project(view, 0.0, v - 0.3), project(view, 0.0, v + 0.3), 9.0, 0x323642ff)
            total: i64 = run.safe.bolts
            left: i64 = (total + 1) / 2
            for i in 0..<total |list, view, total, left|:
                first: bool = i < left
                row: i64 = i if first else i - left
                rows: i64 = left if first else total - left
                v: f64 = 0.45 + 3.1 * (row.f64() + 0.5) / rows.f64()
                disc(list, project(view, 0.24 if first else 3.76, v, 0.03), 8.0, 0xd6b460ff)
            colours: u32[4] = [0xe6463cff, 0x46c864ff, 0x5082f0ff, 0xf5f5f5ff]
            for i in 0..<2 |list, view, run, colours|:
                q: RoomsView::Vec = project(view, 0.45 if i == 0 else 3.55, 4.15, 0.05)
                colour: u32 = colours[run.safe.lamps[i.usize()].usize()]
                if q.z >= 0.05:
                    ScenePolish::glow(list, SceneHand::x(q.x), SceneHand::y(q.y), 26.0 * SceneHand::SCALE, colour, 60)
                disc(list, q, 11.0, colour)

    def ring_point(view: View&, radius: f64, angle: f64, depth: f64) -> RoomsView::Vec:
        return project(view, Safecracker::DIAL_X + radius * cos(angle), Safecracker::DIAL_Y + radius * sin(angle), depth)

    def ring(list: mutable Display::DisplayList&, view: View&, radius: f64, depth: f64, count: i64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            points: mutable RoomsView::Vec[32] = zeroed
            for i in 0..<count |points, view, radius, depth, count|:
                points[i.usize()] <- ring_point(view, radius, 2.0 * Safecracker::PI * i.f64() / count.f64(), depth)
            SceneHand::polygon(list, &points, count, colour)

    def dial(list: mutable Display::DisplayList&, view: View&, run: Safecracker::Run&):
        can Memory.Allocate, Abort.Panic:
            radius: f64 = Safecracker::DIAL_RADIUS
            ring(list, view, radius + 0.1, 0.0, 28, 0x323642ff)
            ring(list, view, radius, 0.12, 28, 0xe4e4deff)
            for i in 0..<Safecracker::NUMBERS |list, view, run, radius|:
                angle: f64 = Safecracker::PI / 2.0 + ((i.f64() - run.reading) * Safecracker::PER) * (Safecracker::PI / 180.0)
                major: bool = i % 5 == 0
                SceneHand::line(list, ring_point(view, radius * (0.78 if major else 0.86), angle, 0.13),
                    ring_point(view, radius * 0.97, angle, 0.13), 2.5 if major else 1.2, 0x1e1e24ff)
                if major:
                    SceneHand::number(list, i, ring_point(view, radius * 0.62, angle, 0.13), 10.0, 0x1e1e24ff)
            ring(list, view, radius * 0.32, 0.3, 16, 0x464c5cff)
            points: mutable RoomsView::Vec[32] = zeroed
            points[0] <- project(view, 2.0, 2.5 + radius + 0.02, 0.14)
            points[1] <- project(view, 1.9, 2.5 + radius + 0.26, 0.14)
            points[2] <- project(view, 2.1, 2.5 + radius + 0.26, 0.14)
            SceneHand::polygon(list, &points, 3, 0x5ae678ff if run.safe.level.glow and Safecracker::on_mark(run) else 0xe6503cff)
            total: i64 = run.safe.combo.count.i64()
            for i in 0..<total |list, view, run, radius, total|:
                u: f64 = 2.0 + (i.f64() - (total - 1).f64() / 2.0) * 0.26
                disc(list, project(view, u, 2.5 - radius - 0.3, 0.05), 6.0, 0x6ee682ff if i < run.tumblers_set else 0x282c36ff)

    def locks(list: mutable Display::DisplayList&, view: View&, run: Safecracker::Run&):
        can Memory.Allocate, Abort.Panic:
            quad(list, project(view, 1.0, 0.45, 0.03), project(view, 3.0, 0.45, 0.03),
                project(view, 3.0, 1.0, 0.03), project(view, 1.0, 1.0, 0.03), 0x141c18ff)
            text: mutable dstr = []
            for i in 0..<run.safe.answer.count.i64() |run, text|:
                dstr_append_cstr(&text, " ") if i > 0
                text.push(run.typed[i.usize()] if i < run.length else 95.u8())
            q: RoomsView::Vec = project(view, 2.0, 0.72, 0.04)
            SceneHand::word(list, bytes_view(text), q.x, q.y, 15.0, 0x78f096ff if run.worded else 0xe6e6c8ff, true)
            u: f64 = Safecracker::HANDLE_X
            v: f64 = Safecracker::HANDLE_Y
            disc(list, project(view, u - 0.5, v, 0.05), 10.0, 0x323642ff)
            tip: RoomsView::Vec = project(view, u, v - Safecracker::THROW * run.lever, 0.2)
            SceneHand::line(list, project(view, u - 0.5, v, 0.2), tip, 9.0, 0xc8aa46ff)
            disc(list, tip, 13.0, 0xe6c450ff)
            for i in 0..<run.strikes |list, view|:
                p: RoomsView::Vec = project(view, 0.5 + 0.3 * i.f64(), 0.35, 0.03)
                SceneHand::word(list, "X", p.x, p.y, 14.0, 0xf0463cff, true)

    def stage(list: mutable Display::DisplayList&, run: Safecracker::Run&):
        can Memory.Allocate, Abort.Panic:
            SceneHand::card(list, 0x342e2cff)
            view: View = View{camera: Safecracker::view(run), door: Safecracker::frame(run)}
            door(list, &view, run)
            dial(list, &view, run)
            locks(list, &view, run)
            Display::draw_rect(list, SceneHand::x(20.0), SceneHand::y(572.0), 960.0 * SceneHand::SCALE, 56.0 * SceneHand::SCALE, 0x10121cdc)
            SceneHand::word(list, bytes_view(run.safe.clue), 500.0, 600.0, 18.0, 0xffffffff, true)
            SceneHand::progress(list, &run.hand, (run.safe.level.seconds - run.time) / run.safe.level.seconds)

    def render(list: mutable Display::DisplayList&, session: SafecrackerGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Safecracker", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Drag round the dial, let go on the thunk   Letters: the word   Drag the handle down   Esc: menu",
                456.0, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            status: mutable dstr = []
            if session.phase == SafecrackerGame::READY:
                dstr_append_cstr(&status, "Could not deal a safe. Press Space or click to retry." if session.deal_failed else "Press Space or click to start")
            elif session.phase == SafecrackerGame::DONE:
                dstr_append_i64(&status, session.passed)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best)
            elif session.phase == SafecrackerGame::JUDGED:
                dstr_append_sview(&status, Safecracker::result_text(session.run.result))
            else:
                dstr_append_cstr(&status, "Listen for the thunk, answer the clue, pull the handle")
            Display::draw_text(list, bytes_view(status), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if session.phase >= SafecrackerGame::JUDGED and session.run.result != Safecracker::PENDING:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.run.result == Safecracker::PASSED,
                    Safecracker::result_text(session.run.result), 60.0, 16.0)
            return if session.phase == SafecrackerGame::READY or session.phase == SafecrackerGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_cstr(&facts, "tumblers ")
            dstr_append_i64(&facts, session.run.tumblers_set)
            dstr_append_cstr(&facts, " of ")
            dstr_append_i64(&facts, session.run.safe.combo.count.i64())
            Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            stage(list, &session.run)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Safecracker::Grade = Safecracker::grade(rung)
            dstr_append_i64(out, level.tumblers)
            dstr_append_cstr(out, " tumbler and a word lock." if level.tumblers == 1 else " tumblers and a word lock.")
            if level.strict:
                dstr_append_cstr(out, " Three mistakes trigger the alarm.")
