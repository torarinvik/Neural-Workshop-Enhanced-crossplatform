include "./tasks/crossroads_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./verdict.elisa"
include "./geometry.elisa"

module SceneCrossroads:
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const ROAD: f64 = 3.8
    const KERB: u32 = 0xc8c8c4ff
    const ASPHALT: u32 = 0x464a54ff
    const DASH: u32 = 0xf0dc78ff
    const CENTER: u32 = Display::ANCHOR_CENTER_CENTER

    struct Frame:
        x: f64
        y: f64
        size: f64

    def frame() -> Frame:
        can Abort.Panic:
            bottom: f64 = Verdict::above_the_band(HEIGHT, Geometry::from_bottom_edge(HEIGHT, 58.0).f64()).f64()
            height: f64 = fmax(40.0, Geometry::from_top_edge(HEIGHT, 116.0).f64() - bottom)
            size: f64 = fmin(WIDTH * 0.94 / Crossroads::WORLD_W, height / (Crossroads::WORLD_H + 2.0))
            return Frame{x: (WIDTH - Crossroads::WORLD_W * size) / 2.0, y: bottom, size: size}

    def hit(session: CrossroadsGame::Session&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return CrossroadsGame::START if session.phase == CrossroadsGame::READY or session.phase == CrossroadsGame::DONE
            return -1 if session.phase != CrossroadsGame::PLAYING
            area: Frame = frame()
            for j in 0..<session.traffic.town.level.layout |session, area, x, y|:
                point: Crossroads::Junction = session.traffic.town.junctions[j.usize()]
                if py_hypot(area.x + point.x * area.size - x, area.y + point.y * area.size - y) < ROAD * 2.2 * area.size:
                    return j
            return -1

    def text(list: mutable Display::DisplayList&, words: sview, x: f64, y: f64, size: f64, ink: u32, bold: bool = false):
        can Abort.Panic, Memory.Allocate:
            Display::draw_text_weight(list, words, x, y, size, ink, CENTER, bold)

    def buildings(list: mutable Display::DisplayList&, area: Frame, town: Crossroads::Town&, layer: i64):
        can Abort.Panic, Memory.Allocate:
            nx: i64 = 1 if town.level.layout == 1 else 2
            ny: i64 = 2 if town.level.layout == 4 else 1
            s: f64 = area.size
            roofs: u32[6] = [0xcc5c48ff, 0x5a78b4ff, 0xdcb05aff, 0x966eaaff, 0x78828cff, 0xe68c64ff]
            draw: mutable MT19937 = zeroed
            mt_seed_int(&draw, town.arrivals.count.u64())
            for i in 0..<(nx + 1) |list, area, town, layer, nx, ny, s, roofs, draw|:
                lo_x: f64 = 1.0 if i == 0 else town.junctions[(i - 1).usize()].x + ROAD + 1.2
                hi_x: f64 = Crossroads::WORLD_W - 1.0 if i == nx else town.junctions[i.usize()].x - ROAD - 1.2
                for j in 0..<(ny + 1) |list, area, town, layer, nx, ny, s, roofs, draw, lo_x, hi_x|:
                    lo_y: f64 = 1.0 if j == 0 else town.junctions[((j - 1) * nx).usize()].y + ROAD + 1.2
                    hi_y: f64 = Crossroads::WORLD_H - 1.0 if j == ny else town.junctions[(j * nx).usize()].y - ROAD - 1.2
                    x: mutable f64 = lo_x
                    while x < hi_x - 3.0 |list, area, layer, s, roofs, draw, x, hi_x, lo_y, hi_y|:
                        w: f64 = fmin(py_uniform(&draw, 4.0, 8.0), hi_x - x)
                        y: mutable f64 = lo_y
                        while y < hi_y - 3.0 |list, area, layer, s, roofs, draw, x, w, y, hi_y|:
                            h: f64 = fmin(py_uniform(&draw, 4.0, 8.0), hi_y - y)
                            if py_random(&draw) < 0.8:
                                roof: u32 = roofs[py_randbelow(&draw, 6.u64()).usize()]
                                px: f64 = area.x + x * s
                                py: f64 = area.y + y * s
                                rw: f64 = (w - 0.8) * s
                                rh: f64 = (h - 0.8) * s
                                if layer == 0:
                                    Display::draw_rect(list, px + 2.0, py - 2.0, rw, rh, 0x2832285a)
                                elif layer == 1:
                                    Display::draw_rect(list, px, py, rw, rh, roof)
                                else:
                                    Display::draw_rect(list, px + rw * 0.6, py + rh * 0.55, 1.2 * s, s,
                                        ScenePolish::mix_rgb(roof, 0xffffffff, 0.3))
                            elif layer == 1:
                                Display::draw_circle(list, area.x + (x + w / 2.0) * s, area.y + (y + h / 2.0) * s,
                                    fmin(w, h) * 0.35 * s, 0x468c46ff)
                            y <- y + h
                        x <- x + w

    def roads(list: mutable Display::DisplayList&, area: Frame, town: Crossroads::Town&, kerb: bool):
        can Abort.Panic, Memory.Allocate:
            nx: i64 = 1 if town.level.layout == 1 else 2
            ny: i64 = 2 if town.level.layout == 4 else 1
            s: f64 = area.size
            inset: f64 = 0.4 if kerb else 0.0
            color: u32 = KERB if kerb else ASPHALT
            for j in 0..<ny |list, area, town, nx, s, inset, color|:
                y: f64 = town.junctions[(j * nx).usize()].y
                Display::draw_rect(list, area.x, area.y + (y - ROAD) * s - inset * s,
                    Crossroads::WORLD_W * s, (2.0 * ROAD + 2.0 * inset) * s, color)
            for i in 0..<nx |list, area, town, s, inset, color|:
                x: f64 = town.junctions[i.usize()].x
                Display::draw_rect(list, area.x + (x - ROAD) * s - inset * s, area.y,
                    (2.0 * ROAD + 2.0 * inset) * s, Crossroads::WORLD_H * s, color)

    def markings(list: mutable Display::DisplayList&, area: Frame, town: Crossroads::Town&):
        can Abort.Panic, Memory.Allocate:
            nx: i64 = 1 if town.level.layout == 1 else 2
            ny: i64 = 2 if town.level.layout == 4 else 1
            s: f64 = area.size
            for j in 0..<ny |list, area, town, nx, s|:
                y: f64 = town.junctions[(j * nx).usize()].y
                for k in 0..<24 |list, area, town, nx, s, y|:
                    x: f64 = k.f64() * 3.0 + 0.5
                    near: bool = fabs(x - town.junctions[0].x) < ROAD + 1.5 or
                        (nx == 2 and fabs(x - town.junctions[1].x) < ROAD + 1.5)
                    if not near:
                        Display::draw_rect(list, area.x + x * s, area.y + y * s - 1.0, 1.5 * s, 2.0, DASH)
            for i in 0..<nx |list, area, town, nx, ny, s|:
                x: f64 = town.junctions[i.usize()].x
                for k in 0..<16 |list, area, town, nx, ny, s, x|:
                    y: f64 = k.f64() * 3.0 + 0.5
                    near: bool = fabs(y - town.junctions[0].y) < ROAD + 1.5 or
                        (ny == 2 and fabs(y - town.junctions[nx.usize()].y) < ROAD + 1.5)
                    if not near:
                        Display::draw_rect(list, area.x + x * s - 1.0, area.y + y * s, 2.0, 1.5 * s, DASH)
            for i in 0..<town.level.layout |list, area, town, s|:
                junction: Crossroads::Junction = town.junctions[i.usize()]
                for side in [-1, 1] |list, area, junction, s|:
                    for k in 0..<6 |list, area, junction, s, side|:
                        offset: f64 = -ROAD + 0.4 + k.f64() * (2.0 * ROAD - 0.8) / 5.5
                        shift: f64 = side.f64() * (ROAD + 1.0)
                        Display::draw_rect(list, area.x + (junction.x + shift) * s - 0.7 * s, area.y + (junction.y + offset) * s,
                            1.4 * s, 0.5 * s, 0xecececff)
                        Display::draw_rect(list, area.x + (junction.x + offset) * s, area.y + (junction.y + shift) * s - 0.7 * s,
                            0.5 * s, 1.4 * s, 0xecececff)

    def scenery(list: mutable Display::DisplayList&, area: Frame, town: Crossroads::Town&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            w: f64 = Crossroads::WORLD_W * area.size
            h: f64 = Crossroads::WORLD_H * area.size
            border: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: area.x - 6.0, y: area.y - 6.0, w: w + 12.0, h: h + 12.0}
            ScenePolish::card_face(list, &border, 14.0, 0x323c32ff, 0.u32(), 0.u32(), dark)
            Display::draw_rect(list, area.x, area.y, w, h, 0x76a862ff)
            buildings(list, area, town, 0)
            buildings(list, area, town, 1)
            roads(list, area, town, true)
            buildings(list, area, town, 2)
            roads(list, area, town, false)
            markings(list, area, town)

    def lights(list: mutable Display::DisplayList&, area: Frame, run: Crossroads::Run&, layer: i64):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            for i in 0..<run.town.level.layout |list, area, run, s, layer|:
                junction: Crossroads::Junction = run.town.junctions[i.usize()]
                light: Crossroads::Light = run.lights[i.usize()]
                for corner in 0..<4 |list, area, run, s, layer, junction, light|:
                    axis: i64 = corner / 2
                    dx: f64 = -1.0 if corner == 0 or corner == 3 else 1.0
                    dy: f64 = -1.0 if corner % 2 == 0 else 1.0
                    x: f64 = area.x + (junction.x + dx * (ROAD + 1.4)) * s
                    y: f64 = area.y + (junction.y + dy * (ROAD + 1.4)) * s
                    signal: i64 = Crossroads::signal(light, axis, run.elapsed)
                    hue: u32 = 0x3ce678ff if signal == Crossroads::GREEN else (0xffbe28ff if signal == Crossroads::AMBER else 0xf03c38ff)
                    if layer == 0:
                        ScenePolish::glow(list, x, y, 1.6 * s, hue, 90)
                    elif layer == 1:
                        Display::draw_circle(list, x, y, 0.7 * s, 0x1e1e24ff)
                    elif layer == 2:
                        Display::draw_circle(list, x, y, 0.5 * s, hue)
                x: f64 = area.x + junction.x * s
                y: f64 = area.y + junction.y * s
                if layer == 2:
                    label: mutable dstr = []
                    dstr_append_i64(&label, i + 1)
                    text(list, bytes_view(label), x, y, fmax(9.0, 1.4 * s), 0xffffff8c, true)
                elif layer == 3 and light.changing:
                    share: f64 = (run.elapsed - light.start) / (Crossroads::AMBER_TIME + Crossroads::ALL_RED)
                    ScenePolish::arc(list, x, y, ROAD * 0.8 * s, 1.5707963267948966,
                        6.283185307179586 * fmin(1.0, share), 3.0, 0xffc83cff)

    def car_polygon(list: mutable Display::DisplayList&, x: f64, y: f64, dx: f64, dy: f64, front: f64, back: f64, half: f64, hue: u32):
        can Abort.Panic, Memory.Allocate:
            px: f64 = x + dx * front - dy * half
            py: f64 = y + dy * front + dx * half
            Display::begin_polygon(list, 4, px, py, hue)
            Display::polygon_point(list, px, py)
            Display::polygon_point(list, x - dx * back - dy * half, y - dy * back + dx * half)
            Display::polygon_point(list, x - dx * back + dy * half, y - dy * back - dx * half)
            Display::polygon_point(list, x + dx * front + dy * half, y + dy * front - dx * half)

    def cars(list: mutable Display::DisplayList&, area: Frame, run: Crossroads::Run&, layer: i64):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            colors: u32[8] = [0xec4850ff, 0x3c96ecff, 0xfac432ff, 0x5ac878ff, 0xb464e6ff, 0xf0823cff, 0xf0f0f4ff, 0x282c38ff]
            for i in 0..<run.car_count |list, area, run, layer, s, colors|:
                car: Crossroads::Car = run.cars[i.usize()]
                path: Crossroads::Path = run.town.paths[car.path.usize()]
                dx: f64 = path.dx.f64()
                dy: f64 = path.dy.f64()
                wx: f64 = path.x + dx * car.s
                wy: f64 = path.y + dy * car.s
                continue if wx < 2.0 or wx > Crossroads::WORLD_W - 2.0 or wy < 2.0 or wy > Crossroads::WORLD_H - 2.0
                x: f64 = area.x + wx * s
                y: f64 = area.y + wy * s
                long: f64 = 1.9 * s
                half: f64 = 0.85 * s
                hue: u32 = 0xf6f6faff if car.ambulance else colors[(car.colour % 8).usize()]
                blink: u32 = 0xff3c3cff if (run.elapsed * 6.0).i64() % 2 != 0 else 0x3c78ffff
                bx: f64 = x + dx * 0.1 * long
                by: f64 = y + dy * 0.1 * long
                if layer == 0 and car.ambulance:
                    ScenePolish::glow(list, bx, by, 2.2 * s, blink, 140)
                elif layer == 1:
                    car_polygon(list, x, y, dx, dy, long, long, half, hue)
                elif layer == 2:
                    glass: u32 = 0xc8d2e6ff if car.ambulance else ScenePolish::mix_rgb(hue, 0x000000ff, 0.3)
                    car_polygon(list, x, y, dx, dy, long * 0.45, long * 0.3, half * 0.8, glass)
                elif layer == 3:
                    for side in [-1, 1] |list, x, y, dx, dy, long, half, s, car|:
                        offset: f64 = side.f64() * half * 0.6
                        Display::draw_circle(list, x - dx * long - dy * offset, y - dy * long + dx * offset,
                            0.28 * s, 0xff2828ff if car.v < 2.0 else 0x8c1e1eff)
                        Display::draw_circle(list, x + dx * long - dy * offset, y + dy * long + dx * offset, 0.25 * s, 0xfffad2ff)
                    if car.ambulance:
                        Display::draw_rect(list, bx - 0.3 * s, by - 0.3 * s, 0.6 * s, 0.6 * s, blink)
                        if car.waited > 0.0:
                            ScenePolish::arc(list, x, y, 2.6 * s, 1.5707963267948966,
                                6.283185307179586 * fmax(0.0, 1.0 - car.waited / 4.0), 3.0, 0xff5050ff)

    def queues(list: mutable Display::DisplayList&, area: Frame, run: Crossroads::Run&):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            for k in 0..<run.town.path_count |list, area, run, s|:
                count: i64 = run.backlog[k.usize()]
                continue if count == 0
                path: Crossroads::Path = run.town.paths[k.usize()]
                # Pending vehicles are the last arrivals for this path. On a
                # gridlock frame this also includes the overflow at the edge.
                at: mutable i64 = count
                i: mutable i64 = run.next_arrival
                while i > 0 and at > 0 |list, area, run, s, k, path, at, i|:
                    i <- i - 1
                    event: Crossroads::Arrival = run.town.arrivals[i.usize()]
                    continue if event.path != k
                    at <- at - 1
                    distance: f64 = 1.2 + 1.3 * at.f64()
                    x: f64 = path.x + path.dx.f64() * distance + path.dy.f64() * 2.6
                    y: f64 = path.y + path.dy.f64() * distance - path.dx.f64() * 2.6
                    hue: u32 = 0xff3c3cff if event.ambulance else ScenePolish::mix_rgb(0xffd23cff, 0xf03232ff, (at + 1).f64() / 4.0)
                    Display::draw_circle(list, area.x + x * s, area.y + y * s, 0.55 * s, hue)

    def traffic(list: mutable Display::DisplayList&, area: Frame, run: Crossroads::Run&):
        can Abort.Panic, Memory.Allocate:
            s: f64 = area.size
            width: f64 = Crossroads::WORLD_W * s
            top: f64 = area.y + (Crossroads::WORLD_H + 0.6) * s
            track: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: area.x, y: top, w: width, h: 0.9 * s}
            ScenePolish::rounded(list, &track, 0.45 * s, 0xc8c8d2ff)
            lights(list, area, run, 0)
            cars(list, area, run, 0)
            lights(list, area, run, 1)
            cars(list, area, run, 1)
            share: f64 = fmax(0.0, 1.0 - run.elapsed / run.town.level.seconds)
            if share > 0.02:
                bar: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: area.x, y: top, w: width * share, h: 0.9 * s}
                ScenePolish::rounded(list, &bar, 0.45 * s, 0x5a96f0ff)
            lights(list, area, run, 2)
            cars(list, area, run, 2)
            lights(list, area, run, 3)
            cars(list, area, run, 3)
            queues(list, area, run)

    def verdict(session: CrossroadsGame::Session&, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            if session.verdict == Crossroads::CLEAR:
                dstr_append_i64(out, session.verdict_served)
                dstr_append_cstr(out, " cars through, no jam")
            elif session.verdict == Crossroads::GRIDLOCK:
                dstr_append_cstr(out, "Gridlock: traffic backed out of town")
            elif session.verdict == Crossroads::AMBULANCE:
                dstr_append_cstr(out, "An ambulance was held up")

    def render(list: mutable Display::DisplayList&, session: CrossroadsGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            text(list, "Crossroads", 456.0, 648.0, 22.0, ink, true)
            text(list, "click a junction or press 1-4: switch its lights   Esc: menu", 456.0, 26.0, 12.0, ink)
            caption: mutable dstr = []
            verdict(session, &caption)
            status: mutable dstr = []
            if session.phase == CrossroadsGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == CrossroadsGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == CrossroadsGame::JUDGED:
                status <- caption
            else:
                dstr_append_cstr(&status, "Switch the lights; keep the town moving")
            text(list, bytes_view(status), 456.0, 614.0, 14.0, ink)
            if session.phase == CrossroadsGame::PLAYING or session.phase == CrossroadsGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   ")
                dstr_append_i64(&facts, session.traffic.served)
                dstr_append_cstr(&facts, " cars through   ")
                dstr_append_i64(&facts, fmax(0.0, session.traffic.town.level.seconds - session.traffic.elapsed).i64())
                dstr_append_cstr(&facts, " s left")
                text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink)
                area: Frame = frame()
                scenery(list, area, &session.traffic.town, dark)
                traffic(list, area, &session.traffic)
            if caption.count > 0:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, session.verdict == Crossroads::CLEAR,
                    bytes_view(caption), 60.0, 16.0)

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: Crossroads::Grade = Crossroads::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.layout)
            dstr_append_cstr(out, " junction(s), ")
            dstr_append_i64(out, level.seconds.i64())
            dstr_append_cstr(out, " s.")
            if level.ambulances > 0:
                dstr_append_cstr(out, "  ")
                dstr_append_i64(out, level.ambulances)
                dstr_append_cstr(out, " ambulance(s).")
            dstr_append_cstr(out, "  Rush hour moves the busy road.") if level.rush
