# The widgets that belong to a trial in progress.
#
# Port of neural_workshop/ui/trialui.py -- the drawing, not the scoring.
#
# The feedback labels along the bottom edge are the player's CONTROLS: each
# names the key that reports a match for one modality, and colours itself by
# whether the press was right. Five of them and they have to fit, which is why
# the layout is the odd thing it is:
#
#     width   = len(text) * font_size * 4 / 5
#     spacing = (window.width - 100) / (total - 0.99)
#     x       = 30 + int(pos * spacing - width * pos / (total - 0.5))
#
# The width is ESTIMATED from the character count rather than measured,
# because pyglet does not expose a laid-out label's width before it is drawn.
# The two odd denominators are what keep the last label on screen: `total -
# 0.99` rather than `total - 1` so a single label does not divide by zero, and
# `total - 0.5` so the rightmost one is pulled back by less than its own
# width. Neither is a rounding of the other and both are reproduced.
#
# The font size steps DOWN as the modalities go up -- 16, 14, 13, 11 -- and
# the word " match" is only appended under four of them, because past that it
# does not fit.
#
# NOTE: needs elisacore_math, strings, geometry and display included by the
# driver.

module SceneTrialUI:

    # What `check_match` came back with, and what each is coloured.
    const ANSWER_NONE: i64 = 0
    const ANSWER_CORRECT: i64 = 1
    const ANSWER_UNKNOWN: i64 = 2
    const ANSWER_INCORRECT: i64 = 3

    def color_correct() -> u32:
        return Display::rgba(64, 255, 64, 255)

    def color_incorrect() -> u32:
        return Display::rgba(255, 64, 64, 255)

    def color_oops() -> u32:
        return Display::rgba(255, 255, 64, 255)

    # COLOR_TEXT, which is NOT the inverse of the background: it is black on
    # the pale page and 240 grey on the dark one. Everything on this screen
    # that is not carrying a verdict takes it.
    def text_color(black_background: bool) -> u32:
        return Display::rgba(240, 240, 240, 255) if black_background else Display::rgba(0, 0, 0, 255)

    struct Paint:
        ink: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> Paint:
        return Paint{ink: text_color(black_background),
                     width: width, height: height, sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: Paint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    # 16 under four modalities, then 14, then 13, then 11.
    def feedback_size(height: f64, total: i64) -> f64:
        can Abort.Panic:
            if total < 4:
                return Geometry::calc_fontsize(height, 16.0)
            if total < 5:
                return Geometry::calc_fontsize(height, 14.0)
            if total < 6:
                return Geometry::calc_fontsize(height, 13.0)
            return Geometry::calc_fontsize(height, 11.0)

    # `30 + int(pos * spacing - width * pos / (total - .5))`, with the label's
    # width ESTIMATED from its character count.
    def feedback_x(width: f64, characters: i64, size: f64, pos: i64,
                   total: i64) -> f64:
        can Abort.Panic:
            estimated: f64 = characters.f64() * size * 4.0 / 5.0
            spacing: f64 = (width - 100.0) / (total.f64() - 0.99)
            shifted: f64 = pos.f64() * spacing - estimated * pos.f64() / (total.f64() - 0.5)
            return 30.0 + shifted.i64().f64()

    def answer_color(paint: Paint&, answer: i64) -> u32:
        if answer == ANSWER_CORRECT:
            return color_correct()
        if answer == ANSWER_UNKNOWN:
            return color_oops()
        if answer == ANSWER_INCORRECT:
            return color_incorrect()
        return paint.ink

    # One "K: position match" prompt. `text` is what the caller assembled --
    # the mouse prefix, the key's letter and the modality's own name, which
    # are the config's and the keyboard's rather than the layout's.
    def put_feedback(list: mutable Display::DisplayList&, paint: Paint&,
                     text: sview, characters: i64, pos: i64, total: i64,
                     answer: i64):
        can Memory.Allocate, Abort.Panic:
            size: f64 = feedback_size(paint.height, total)
            put_text(list, paint, text,
                     feedback_x(paint.width, characters, size, pos, total),
                     Geometry::from_bottom_edge(paint.height, 30.0).f64(),
                     size, answer_color(paint, answer),
                     Display::ANCHOR_LEFT_CENTER, false)

    # The number being typed in arithmetic mode. Its x is a fixed FORTY PIXELS
    # left of centre and not a share of anything.
    def put_arithmetic(list: mutable Display::DisplayList&, paint: Paint&,
                       text: sview, answer: i64):
        can Memory.Allocate, Abort.Panic:
            bold: bool = answer == ANSWER_CORRECT or answer == ANSWER_INCORRECT
            put_text(list, paint, text, paint.width / 2.0 - 40.0,
                     Geometry::from_bottom_edge(paint.height, 30.0).f64(),
                     Geometry::calc_fontsize(paint.height, 16.0),
                     answer_color(paint, answer),
                     Display::ANCHOR_LEFT_CENTER, bold)

    # Trial timing, session length and board size, bottom LEFT.
    def put_session_info(list: mutable Display::DisplayList&, paint: Paint&,
                         text: sview, bold: bool):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, text,
                     Geometry::from_left_edge(paint.width, 20.0).f64(),
                     Geometry::from_bottom_edge(paint.height, 145.0).f64(),
                     Geometry::calc_fontsize(paint.height, 11.0), paint.ink,
                     Display::ANCHOR_LEFT_TOP, bold)

    # The thresholds for moving up or down a level, bottom RIGHT.
    def put_thresholds(list: mutable Display::DisplayList&, paint: Paint&,
                       text: sview):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, text,
                     Geometry::from_right_edge(paint.width, 20.0).f64(),
                     Geometry::from_bottom_edge(paint.height, 145.0).f64(),
                     Geometry::calc_fontsize(paint.height, 11.0), paint.ink,
                     Display::ANCHOR_RIGHT_TOP, false)

    # The "press SPACE to begin session #N" prompt. A fixed BLUE on both
    # pages, because it is the one thing on an idle screen that has to be
    # found without looking for it.
    def put_space_prompt(list: mutable Display::DisplayList&, paint: Paint&,
                         text: sview):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, text,
                     Geometry::width_center(paint.width).f64(),
                     Geometry::from_bottom_edge(paint.height, 62.0).f64(),
                     Geometry::calc_fontsize(paint.height, 16.0),
                     Display::rgba(32, 32, 255, 255),
                     Display::ANCHOR_CENTER_CENTER, true)
