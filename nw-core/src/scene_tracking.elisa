# The Moving Targets screen: game state in, display list out.
#
# Port of neural_workshop/ui/tracking.py -- the drawing, not the thinking.
#
# Three labels, a verdict and a flock of circles. The balls are the whole
# screen and they carry the trial's state in their COLOUR, which changes
# meaning with the phase:
#
#   cueing     -- orange is a ball to follow
#   tracking   -- nothing is marked; this is the work
#   picking    -- orange is a ball you have picked
#   revealing  -- green caught it, vermilion is one that got away, and
#                 orange is a pick that was not a target at all
#
# so a port that colours by `target` alone looks right in two phases out of
# four and gives the answer away in the one that matters.
#
# Positions are FRACTIONS of the window and are multiplied up by the window's
# own pixel size, which is how a resize moves the flock to the same relative
# place instead of ejecting it.
#
# NOTE: needs elisacore_math, strings, geometry, display and scene_verdict
# included by the driver.

module SceneTracking:

    const PHASE_READY: i64 = 0
    const PHASE_CUEING: i64 = 1
    const PHASE_TRACKING: i64 = 2
    const PHASE_PICKING: i64 = 3
    const PHASE_REVEALING: i64 = 4
    const PHASE_DONE: i64 = 5

    # Okabe-Ito, safe on both backgrounds and for the colour-blind.
    def color_plain() -> u32:
        return Display::rgba(86, 180, 233, 255)

    def color_cued() -> u32:
        return Display::rgba(230, 159, 0, 255)

    def color_caught() -> u32:
        return Display::rgba(0, 158, 115, 255)

    def color_missed() -> u32:
        return Display::rgba(213, 94, 0, 255)

    struct TrackingBall:
        x: f64
        y: f64
        target: bool
        picked: bool

    struct TrackingPaint:
        ink: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> TrackingPaint:
        back: i64 = 0 if black_background else 255
        fore: i64 = 255 - back
        return TrackingPaint{ink: Display::rgba(fore, fore, fore, 255),
                     width: width, height: height, sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: TrackingPaint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    # `max(8.0, float(scale_to_height(21)))` -- a floor in PIXELS, so on a
    # short window the balls stop shrinking rather than vanishing.
    def radius_of(height: f64) -> f64:
        can Abort.Panic:
            scaled: f64 = Geometry::scale_to_height(height, 21.0).f64()
            return scaled if scaled > 8.0 else 8.0

    def color_of(ball: TrackingBall&, phase: i64) -> u32:
        if phase == PHASE_CUEING:
            return color_cued() if ball.target else color_plain()
        if phase == PHASE_PICKING:
            return color_cued() if ball.picked else color_plain()
        if phase == PHASE_REVEALING:
            if ball.picked and ball.target:
                return color_caught()
            if ball.target:
                return color_missed()
            if ball.picked:
                return color_cued()
        return color_plain()

    def render(list: mutable Display::DisplayList&, paint: TrackingPaint&, phase: i64,
               balls: darray[TrackingBall]&, round: i64, total_rounds: i64,
               message: sview, verdict: i64, verdict_text: sview):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()

            put_text(list, paint, sview("Moving Targets", 0, -1), middle,
                     Geometry::from_top_edge(paint.height, 36.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            # The round counter joins on in every phase but the two idle ones,
            # and only when there is a round total to count against.
            status: mutable dstr = []
            dstr_append_sview(&status, message)
            if phase != PHASE_READY and phase != PHASE_DONE and total_rounds != 0:
                dstr_append_cstr(&status, "     round ")
                dstr_append_i64(&status, round)
                dstr_append_cstr(&status, "/")
                dstr_append_i64(&status, total_rounds)
            put_text(list, paint, bytes_view(status), middle,
                     Geometry::from_top_edge(paint.height, 70.0).f64(),
                     Geometry::calc_fontsize(paint.height, 14.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            put_text(list, paint,
                     sview("Esc: task menu     Space: start     click the balls you followed     C: options", 0, -1),
                     middle, Geometry::from_bottom_edge(paint.height, 26.0).f64(),
                     Geometry::calc_fontsize(paint.height, 12.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            if verdict >= 0:
                SceneVerdict::put(list, paint.width, paint.height, paint.sx, paint.sy,
                                  verdict == 1, verdict_text, 60.0, 16.0)

            # The flock last, over the chrome. A ball's circle is made once
            # and only moved and recoloured after that, so the order here is
            # the order the balls were spawned in.
            radius: f64 = radius_of(paint.height)
            count: i64 = balls.count.i64()
            for index in 0..<count |list, paint, balls, count, phase, radius|:
                ball: TrackingBall = get balls[index.usize()] else TrackingBall{x: 0.0, y: 0.0, target: false, picked: false}
                Display::draw_circle(list, ball.x * paint.width / paint.sx,
                                     ball.y * paint.height / paint.sy,
                                     radius / paint.sx, color_of(&ball, phase))
