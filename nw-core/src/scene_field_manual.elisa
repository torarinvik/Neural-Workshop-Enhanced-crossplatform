include "./tasks/field_manual_game.elisa"
include "./scene_verdict.elisa"
include "./scene_hand.elisa"

module SceneFieldManual:

    struct FaceOrder:
        index: i64
        facing: f64

    def position(run: FieldManualRun::Run&, point: RoomsView::Vec) -> RoomsView::Vec:
        return HandView::see(&run.lens, FieldManualRun::world(run, point))

    def offset(center: RoomsView::Vec, face: FieldManualRun::Face, right: f64, up: f64) -> RoomsView::Vec:
        return RoomsView::add(center, RoomsView::add(RoomsView::mul(face.right, right), RoomsView::mul(face.up, up)))

    def corners(run: FieldManualRun::Run&, center: RoomsView::Vec, face: FieldManualRun::Face,
                half_width: f64, half_height: f64) -> RoomsView::Vec[32]:
        can Abort.Panic:
            points: mutable RoomsView::Vec[32] = zeroed
            for i in 0..<4 |run, center, face, half_width, half_height, points|:
                dx: f64 = -half_width if i == 0 or i == 3 else half_width
                dy: f64 = -half_height if i < 2 else half_height
                points[i.usize()] <- position(run, offset(center, face, dx, dy))
            return points

    def rect(list: mutable Display::DisplayList&, run: FieldManualRun::Run&, center: RoomsView::Vec,
             face: FieldManualRun::Face, width: f64, height: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            box: mutable RoomsView::Vec[32] = corners(run, center, face, width, height)
            SceneHand::polygon(list, &box, 4, colour)

    def ring(list: mutable Display::DisplayList&, run: FieldManualRun::Run&, center: RoomsView::Vec,
             face: FieldManualRun::Face, radius: f64, count: i64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            points: mutable RoomsView::Vec[32] = zeroed
            for i in 0..<count |run, center, face, radius, count, points|:
                angle: f64 = 6.283185307179586 * i.f64() / count.f64()
                points[i.usize()] <- position(run, offset(center, face, radius * cos(angle), radius * sin(angle)))
            SceneHand::polygon(list, &points, count, colour)

    def part(list: mutable Display::DisplayList&, run: FieldManualRun::Run&, index: i64, lit: f64):
        can Memory.Allocate, Abort.Panic:
            paint: u32[6] = [0xe0463cff, 0x46be64ff, 0x4678e6ff, 0xf0d246ff, 0xf0f0f0ff, 0xf08c32ff]
            p: FieldManual::Part = run.job.parts[index.usize()]
            colour: u32 = ScenePolish::mix_rgb(0x1e1e28ff, paint[p.colour.usize()], 0.45 + 0.55 * lit)
            face: FieldManualRun::Face = FieldManualRun::face(p.face)
            center: RoomsView::Vec = FieldManualRun::local(p)
            value: f64 = run.state[index.usize()]
            if p.kind == FieldManual::BUTTON:
                ring(list, run, center, face, 0.2, 14, 0x1e202cff)
                surface: RoomsView::Vec = RoomsView::add(center, RoomsView::mul(face.normal, 0.02 if run.grab == index else 0.08))
                ring(list, run, surface, face, 0.16, 14, colour)
            elif p.kind == FieldManual::SWITCH:
                rect(list, run, center, face, 0.1, 0.2, 0x1e202cff)
                tip: RoomsView::Vec = RoomsView::add(center, RoomsView::add(RoomsView::mul(face.up, 0.17 if value != 0.0 else -0.17),
                    RoomsView::mul(face.normal, 0.16)))
                q: RoomsView::Vec = position(run, tip)
                SceneHand::line(list, position(run, center), q, 7.0, colour)
                if q.z >= 0.05 and q.x >= -6.0 and q.x <= HandView::WIDTH + 6.0 and q.y >= -6.0 and q.y <= HandView::HEIGHT + 6.0:
                    Display::draw_circle(list, SceneHand::x(q.x), SceneHand::y(q.y), 6.0 * SceneHand::SCALE, colour)
            elif p.kind == FieldManual::DIAL:
                ring(list, run, center, face, 0.25, 18, 0x969caaff)
                ring(list, run, RoomsView::add(center, RoomsView::mul(face.normal, 0.06)), face, 0.15, 14, colour)
                angle: f64 = 1.5707963267948966 - 6.283185307179586 * value / FieldManual::NOTCHES.f64()
                mark: RoomsView::Vec = offset(center, face, 0.25 * cos(angle), 0.25 * sin(angle))
                SceneHand::line(list, position(run, RoomsView::add(center, RoomsView::mul(face.normal, 0.07))), position(run, mark), 3.0, 0x14141cff)
                if lit > 0.3:
                    SceneHand::number(list, value.i64(), position(run, RoomsView::add(center, RoomsView::mul(face.normal, 0.08))), 11.0 * lit + 3.0, 0x14141cff)
            else:
                track: FieldManualRun::Track = FieldManualRun::track(run, p)
                SceneHand::line(list, track.start, track.stop, 6.0, 0x1e202cff)
                handle: RoomsView::Vec = FieldManualRun::local(p, (2.0 * value - 1.0) * FieldManual::TRACK)
                rect(list, run, handle, face, 0.13, 0.06, colour)

    def machine(list: mutable Display::DisplayList&, run: FieldManualRun::Run&):
        can Memory.Allocate, Abort.Panic:
            faces: mutable FaceOrder[6] = zeroed
            for i in 0..<6 |run, faces|:
                facing: f64 = FieldManualRun::facing(run, i)
                index: mutable i64 = i
                while index > 0 and faces[(index - 1).usize()].facing > facing |index, faces, facing|:
                    faces[index.usize()] <- faces[(index - 1).usize()]
                    index <- index - 1
                faces[index.usize()] <- FaceOrder{index: i, facing: facing}
            for i in 0..<6 |list, run, faces|:
                visible: FaceOrder = faces[i.usize()]
                continue if visible.facing <= 0.0
                face: FieldManualRun::Face = FieldManualRun::face(visible.index)
                box: RoomsView::Vec[32] = corners(run, face.normal, face, 1.0, 1.0)
                clipped: mutable RoomsView::Vec[32] = box
                SceneHand::polygon(list, &clipped, 4, ScenePolish::mix_rgb(0x282c3cff, 0x566078ff, 0.35 + 0.65 * visible.facing))
                for j in 0..<4 |list, box|:
                    SceneHand::line(list, box[j.usize()], box[((j + 1) % 4).usize()], 2.0, 0x141620ff)
                value: i64 = run.job.numbers[visible.index.usize()]
                if value != 0 and visible.facing > 0.3:
                    projected: RoomsView::Vec = position(run, offset(face.normal, face, -0.72, 0.8))
                    SceneHand::number(list, value, projected, 15.0 * visible.facing + 4.0, 0xffffffdc)
                for j in 0..<run.job.count |list, run, visible|:
                    if run.job.parts[j.usize()].face == visible.index:
                        part(list, run, j, visible.facing)

    def hud(list: mutable Display::DisplayList&, run: FieldManualRun::Run&):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, SceneHand::x(20.0), SceneHand::y(556.0), 960.0 * SceneHand::SCALE, 72.0 * SceneHand::SCALE, 0x10121cdc)
            total: i64 = run.job.orders.count.i64()
            active: bool = run.step_no < total
            text: sview = FieldManualRun::reading(run)
            SceneHand::word(list, "(the order has gone)" if active and sview_len(text) == 0.usize() else text,
                500.0, 600.0, 20.0, 0xffffffff, true)
            under: mutable dstr = []
            dstr_append_cstr(&under, "order ")
            dstr_append_i64(&under, run.step_no + 1 if active else total)
            dstr_append_cstr(&under, " of ")
            dstr_append_i64(&under, total)
            if active:
                order: FieldManual::Order = get run.job.orders[run.step_no.usize()] else zeroed
                if order.kind == FieldManual::TYPE:
                    dstr_append_cstr(&under, "     ")
                    for i in 0..<FieldManualRun::digits(order.digits) |under, run, order|:
                        dstr_append_cstr(&under, " ")
                        if i < run.typed:
                            dstr_append_i64(&under, FieldManualRun::digit(order.digits, i))
                        else:
                            dstr_append_cstr(&under, "_")
            if FieldManualRun::holding_shift(run):
                dstr_append_cstr(&under, "      SHIFT")
            SceneHand::word(list, bytes_view(under), 500.0, 570.0, 12.0, 0xc8d2e6ff)

    def stage(list: mutable Display::DisplayList&, run: FieldManualRun::Run&):
        can Memory.Allocate, Abort.Panic:
            SceneHand::card(list)
            machine(list, run)
            hud(list, run)
            SceneHand::progress(list, &run.hand, (run.job.seconds - run.time) / run.job.seconds)

    def render(list: mutable Display::DisplayList&, session: FieldManualGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Field Manual", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Drag: turn the machine, dials and sliders   Click: buttons and switches   0-9: type   Shift: hold   Esc: menu",
                456.0, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            status: mutable dstr = []
            if session.phase == FieldManualGame::READY:
                dstr_append_cstr(&status, "Could not deal a machine. Press Space or click to retry." if session.deal_failed else "Press Space or click to start")
            elif session.phase == FieldManualGame::DONE:
                dstr_append_i64(&status, session.passed)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best)
            elif session.phase == FieldManualGame::JUDGED:
                dstr_append_sview(&status, FieldManualRun::result_text(session.run.result))
            else:
                dstr_append_cstr(&status, "Do what the order says")
            Display::draw_text(list, bytes_view(status), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if session.phase >= FieldManualGame::JUDGED and session.run.result != FieldManualRun::PENDING:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.run.result == FieldManualRun::PASSED,
                    FieldManualRun::result_text(session.run.result), 60.0, 16.0)
            return if session.phase == FieldManualGame::READY or session.phase == FieldManualGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, session.run.job.count)
            dstr_append_cstr(&facts, " parts")
            Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            stage(list, &session.run)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            grade: FieldManual::Grade = FieldManual::grade(rung)
            dstr_append_cstr(out, "Carry out ")
            dstr_append_i64(out, grade.steps)
            dstr_append_cstr(out, " order" if grade.steps == 1 else " orders")
            dstr_append_cstr(out, " on a machine with ")
            dstr_append_i64(out, grade.parts)
            dstr_append_cstr(out, " parts.")
            if grade.show > 0.0:
                dstr_append_cstr(out, " Orders disappear after a few seconds.")
