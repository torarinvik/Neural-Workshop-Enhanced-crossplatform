include "./tasks/pianotuner_game.elisa"
include "./scene_live_view.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./scene_lens.elisa"

# ui/pianotuner.py: the strings of a piano seen from above, a tuning hammer
# on the pin of the string being tuned, and nothing that shows the pitch --
# the pin's angle turns with it, from anywhere. A green mark under each
# string tuned.
module ScenePianoTuner:
    const LEFT: f64 = (LiveView::WIDTH - LiveView::VIEW_WIDTH) / 2.0
    const PI: f64 = 3.141592653589793

    @inline(never)
    def sine(angle: f64) -> f64:
        return sin(angle)

    @inline(never)
    def cosine(angle: f64) -> f64:
        return cos(angle)

    def bottom() -> f64:
        can Abort.Panic:
            return Verdict::above_the_band(LiveView::HEIGHT, Geometry::from_bottom_edge(LiveView::HEIGHT, 58.0).f64()).f64()

    def height() -> f64:
        can Abort.Panic:
            return fmax(40.0, Geometry::from_top_edge(LiveView::HEIGHT, 116.0).f64() - bottom())

    def label(list: mutable Display::DisplayList&, text: sview, y: f64, size: f64, ink: u32, bold: bool = false):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, LiveView::CX, y, size, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def clip() -> SceneLens::Clip:
        can Abort.Panic:
            b: f64 = bottom()
            return SceneLens::Clip{x0: LEFT, y0: b, x1: LEFT + LiveView::VIEW_WIDTH, y1: b + height()}

    # The x of string i of twelve.
    def string_x(i: i64) -> f64:
        return LEFT + 90.0 + i.f64() * (LiveView::VIEW_WIDTH - 180.0) / 11.0

    # PianoTuner._draw, without the frame's card.
    def view(list: mutable Display::DisplayList&, run: PianoTuner::Run&):
        can Memory.Allocate, Abort.Panic:
            cut: SceneLens::Clip = clip()
            left: f64 = LEFT
            width: f64 = LiveView::VIEW_WIDTH
            b: f64 = bottom()
            h: f64 = height()
            # the iron frame and the felt
            SceneLens::rect(list, cut, left + 30.0, b + 30.0, width - 60.0, h - 60.0, 0x96783cff)
            SceneLens::rect(list, cut, left + 50.0, b + h - 120.0, width - 100.0, 40.0, 0x781e28ff)
            top: f64 = b + h - 70.0
            low: f64 = b + 60.0
            for i in 0..<12 |list, cut, run, top, low|:
                x: f64 = string_x(i)
                here: bool = i == 5 + run.k
                SceneLens::line(list, cut, x, low, x, top, 3.0 if here else 2.0, 0xfaf0c8ff if here else 0xc8beaaff)
                SceneLens::disc(list, cut, x, top - 6.0, 7.0, 0x5a5a60ff)
            cx: f64 = string_x(5 + run.k)
            cy: f64 = top - 6.0
            a: f64 = PianoTuner::pin(run) * (PI / 180.0)
            r: f64 = 46.0
            ex: f64 = cx + r * cosine(a)
            ey: f64 = cy + r * sine(a)
            SceneLens::disc(list, cut, cx, cy, 18.0, 0x464650ff)
            SceneLens::line(list, cut, cx, cy, ex, ey, 10.0, 0x3c3228ff)
            SceneLens::disc(list, cut, ex, ey, 12.0, 0x5a4632ff)
            for i in 0..<run.count |list, cut, low|:
                SceneLens::disc(list, cut, string_x(5 + i), low - 20.0, 6.0, 0x6edc8cff)

    def card(list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            frame: SceneLens::Clip = clip()
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: frame.x0 - 4.0, y: frame.y0 - 4.0,
                w: frame.x1 - frame.x0 + 8.0, h: frame.y1 - frame.y0 + 8.0}
            shades: u32[3] = [30.u32(), 18.u32(), 12.u32()]
            for i in 0..<3 |list, box, shades|:
                blur: f64 = i.f64() * 2.0
                shadow: SceneHiddenRule::Rect = ScenePolish::spread_box(&box, blur, 4.0)
                ScenePolish::rounded(list, &shadow, 14.0 + blur, shades[i.usize()])
            ScenePolish::rounded(list, &box, 14.0, 0x34241cff)

    # Python's '%+.Nf': the sign of the value itself, so -0.4 is "-0".
    def signed(words: mutable dstr&, v: f64, places: i64, scale: f64):
        can Memory.Allocate, Abort.Panic:
            negative: bool = v < 0.0 or (v == 0.0 and 1.0 / v < 0.0)
            words.push(45.u8() if negative else 43.u8())
            dstr_append_fixed(words, py_round_decimal(fabs(v), scale), places)

    def verdict_text(run: PianoTuner::Run&, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.result == PianoTuner::IN_TUNE:
                dstr_append_cstr(words, "In tune: ")
                signed(words, run.said, 1, 10.0)
                dstr_append_cstr(words, " cents")
            elif run.result == PianoTuner::OUT_OF_TIME:
                dstr_append_cstr(words, "Out of time: ")
                signed(words, run.said, 0, 1.0)
                dstr_append_cstr(words, " cents")
            elif run.result == PianoTuner::SHARP or run.result == PianoTuner::FLAT:
                dstr_append_fixed(words, py_round_decimal(fabs(run.said), 1.0), 0)
                dstr_append_cstr(words, " cents sharp" if run.result == PianoTuner::SHARP else " cents flat")

    def interval_words(interval: i64) -> cstr:
        return "in unison" if interval == PianoTuner::UNISON else ("an octave above" if interval == PianoTuner::OCTAVE else
            ("a fifth above" if interval == PianoTuner::FIFTH else ("a fourth above" if interval == PianoTuner::FOURTH else
            "a major third above")))

    def interval_name(interval: i64) -> cstr:
        return "unison" if interval == PianoTuner::UNISON else ("octave" if interval == PianoTuner::OCTAVE else
            ("fifth" if interval == PianoTuner::FIFTH else ("fourth" if interval == PianoTuner::FOURTH else "third")))

    def render(list: mutable Display::DisplayList&, session: PianoTunerGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            run: PianoTuner::Run& = &session.run
            label(list, "Piano Tuner", 648.0, 22.0, ink, true)
            label(list, "Up / Down: turn the pin (Shift: slowly)   Enter: in tune   Esc: menu", 26.0, 12.0, ink)
            caption: mutable dstr = []
            verdict_text(run, &caption)
            status: mutable dstr = []
            if session.phase == PianoTunerGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == PianoTunerGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == PianoTunerGame::JUDGED:
                status <- caption
            else:
                dstr_append_cstr(&status, "String ")
                dstr_append_i64(&status, run.k + 1)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, run.job.level.strings)
                dstr_append_cstr(&status, ": tune it ")
                dstr_append_cstr(&status, interval_words(run.job.plan[run.k.usize()].interval))
            label(list, bytes_view(status), 614.0, 14.0, ink)
            if session.phase == PianoTunerGame::PLAYING or session.phase == PianoTunerGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   within ")
                dstr_append_fixed(&facts, py_round_decimal(run.job.level.tol, 10.0), 1)
                dstr_append_cstr(&facts, " cents")
                label(list, bytes_view(facts), 588.0, 12.0, ink)
                card(list)
                view(list, run)
            if session.phase == PianoTunerGame::JUDGED or session.phase == PianoTunerGame::DONE:
                SceneVerdict::put(list, LiveView::WIDTH, LiveView::HEIGHT, 1.0, 1.0, run.result == PianoTuner::IN_TUNE,
                    bytes_view(caption), 60.0, 16.0)

    # taskoptions.pianotuner_note.
    def option_note(rung: i64, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: PianoTuner::Grade = PianoTuner::grade(rung)
            dstr_append_cstr(words, "Rung ")
            dstr_append_i64(words, level.rung)
            dstr_append_cstr(words, ": ")
            for i in 0..<level.count |level, words|:
                dstr_append_cstr(words, ", ") if i > 0
                dstr_append_cstr(words, interval_name(level.intervals[i.usize()]))
            dstr_append_cstr(words, ", within ")
            dstr_append_fixed(words, py_round_decimal(level.tol, 10.0), 1)
            dstr_append_cstr(words, " cents.")
