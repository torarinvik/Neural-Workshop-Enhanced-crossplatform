# The persistent on-screen furniture: title, key list, logo and notices.
#
# Port of neural_workshop/ui/hud.py -- where each piece goes and what colour
# it takes. What each SAYS is assembled from the session's own state, which
# has suites of its own, so the text arrives as an sview.
#
# Two things are worth naming.
#
# Several of these are placed off the FIELD rather than off the window, and
# two of them off `field.center_x` where the reading is plainly `center_y` --
# the update notice and the Jaeggi warning both sit a share of the field's
# size above its horizontal centre, which is a vertical position taken from a
# horizontal number. On the square field the workshop actually draws they are
# near enough; on a field that was not square they would not be. Reproduced,
# because it is where the labels are.
#
# And the three-strikes indicator does NOT hide by leaving: it recolours its
# circles to the background at zero alpha and keeps drawing them, so the row
# holds its place whether or not it is showing anything.
#
# NOTE: needs elisacore_math, strings, geometry and display included by the
# driver.

module SceneHud:

    def text_color(black_background: bool) -> u32:
        return Display::rgba(240, 240, 240, 255) if black_background else Display::rgba(0, 0, 0, 255)

    struct HudPaint:
        ink: mutable u32
        black: mutable bool
        width: mutable f64
        height: mutable f64
        # The field's own square: its middle and its side, which several of
        # these are placed against rather than against the window.
        field_x: mutable f64
        field_y: mutable f64
        field_size: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 field_x: f64, field_y: f64, field_size: f64,
                 sx: f64, sy: f64) -> HudPaint:
        return HudPaint{ink: text_color(black_background),
                     black: black_background,
                     width: width, height: height,
                     field_x: field_x, field_y: field_y,
                     field_size: field_size, sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: HudPaint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    # The three-strikes indicator in the top left corner. One filled circle
    # per session already passed at this level -- and when there is nothing to
    # show, the circles are drawn in the BACKGROUND at zero alpha rather than
    # not drawn at all.
    def put_circles(list: mutable Display::DisplayList&, paint: HudPaint&,
                    count: i64, progress: i64, showing: bool):
        can Memory.Allocate, Abort.Panic:
            y: f64 = Geometry::from_top_edge(paint.height, 20.0).f64()
            start_x: f64 = Geometry::from_left_edge(paint.width, 30.0).f64()
            radius: f64 = Geometry::scale_to_width(paint.width, 8.0).f64()
            step: f64 = Geometry::scale_to_width(paint.width, 20.0).f64()
            dim: i64 = 64 if paint.black else 192
            back: i64 = 0 if paint.black else 255
            for index in 0..<count |list, paint, y, start_x, radius, step, dim, back, progress, showing|:
                shade: mutable u32 = Display::rgba(back, back, back, 0)
                if showing:
                    shade <- Display::rgba(64, 64, 255, 255) if index < progress else Display::rgba(dim, dim, dim, 255)
                Display::draw_circle(list, (start_x + step * index.f64()) / paint.sx,
                                     y / paint.sy, radius / paint.sx, shade)

    # An update notice, in a green that is neither the ink nor a workshop
    # colour -- it is the one thing on the screen that is about the program
    # rather than about the session.
    def put_update(list: mutable Display::DisplayList&, paint: HudPaint&, text: sview):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, text,
                     Geometry::width_center(paint.width).f64(),
                     paint.field_x + (paint.field_size.i64() / 6).f64(),
                     Geometry::calc_fontsize(paint.height, 11.0),
                     Display::rgba(0, 128, 0, 255),
                     Display::ANCHOR_CENTER_CENTER, true)

    # The mode and level caption above the field. `flashing` tints it magenta
    # for half a second to acknowledge a change.
    def put_game_mode(list: mutable Display::DisplayList&, paint: HudPaint&,
                      text: sview, flashing: bool):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, text,
                     Geometry::width_center(paint.width).f64(),
                     Geometry::from_top_edge(paint.height, 20.0).f64(),
                     Geometry::calc_fontsize(paint.height, 16.0),
                     Display::rgba(255, 0, 255, 255) if flashing else paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

    # Why a mode key did nothing while Jaeggi mode is on.
    def put_jaeggi_warning(list: mutable Display::DisplayList&, paint: HudPaint&,
                           text: sview):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, text,
                     Geometry::width_center(paint.width).f64(),
                     paint.field_x + paint.field_size / 3.0 + 8.0,
                     Geometry::calc_fontsize(paint.height, 12.0),
                     Display::rgba(255, 0, 255, 255),
                     Display::ANCHOR_CENTER_CENTER, true)

    # The keyboard reference down the left-hand side. Its y depends on WHICH
    # list it is showing: thirty from the top in a session or in manual mode,
    # forty otherwise, because the standard list is a line longer.
    def put_keys_list(list: mutable Display::DisplayList&, paint: HudPaint&,
                      text: sview, lifted: bool):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, text,
                     Geometry::scale_to_width(paint.width, 10.0).f64(),
                     Geometry::from_top_edge(paint.height, 30.0 if lifted else 40.0).f64(),
                     Geometry::calc_fontsize(paint.height, 9.0), paint.ink,
                     Display::ANCHOR_LEFT_TOP, false)

    # Product name, version and native-backend tag on the title screen.
    def put_title_message(list: mutable Display::DisplayList&, paint: HudPaint&,
                          version: sview, native: sview):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()
            put_text(list, paint, sview("Neural Workshop", 0, -1), middle,
                     Geometry::from_top_edge(paint.height, 25.0).f64(),
                     Geometry::calc_fontsize(paint.height, 32.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)
            put_text(list, paint, version, middle,
                     Geometry::from_top_edge(paint.height, 55.0).f64(),
                     Geometry::calc_fontsize(paint.height, 14.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)
            put_text(list, paint, native, middle,
                     Geometry::from_top_edge(paint.height, 78.0).f64(),
                     Geometry::calc_fontsize(paint.height, 10.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

    # The title screen's key list and its prompt. The PROMPT goes down first,
    # which is the order `draw` calls them in and not the order they are made.
    def put_title_keys(list: mutable Display::DisplayList&, paint: HudPaint&,
                       keys: sview):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, sview("Press SPACE to enter the Workshop", 0, -1),
                     Geometry::width_center(paint.width).f64(),
                     Geometry::from_bottom_edge(paint.height, 35.0).f64(),
                     Geometry::calc_fontsize(paint.height, 20.0),
                     Display::rgba(32, 32, 255, 255),
                     Display::ANCHOR_CENTER_CENTER, true)
            put_text(list, paint, keys,
                     Geometry::from_width_center(paint.width, 65.0).f64(),
                     Geometry::from_bottom_edge(paint.height, 260.0).f64(),
                     Geometry::calc_fontsize(paint.height, 12.0), paint.ink,
                     Display::ANCHOR_CENTER_TOP, true)

    # The tiny `native: C` tag on the workshop hub.
    def put_native_tag(list: mutable Display::DisplayList&, paint: HudPaint&,
                       text: sview):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, text,
                     Geometry::from_left_edge(paint.width, 10.0).f64(),
                     Geometry::from_bottom_edge(paint.height, 14.0).f64(),
                     Geometry::calc_fontsize(paint.height, 9.0), paint.ink,
                     Display::ANCHOR_LEFT_CENTER, false)

    # The two halves of the logo's caption. The program's name is NOT
    # translated, which is why it is written here rather than passed in.
    def put_logo_words(list: mutable Display::DisplayList&, paint: HudPaint&):
        can Memory.Allocate, Abort.Panic:
            size: f64 = Geometry::calc_fontsize(paint.height, 11.0)
            put_text(list, paint, sview("Brain", 0, -1), paint.field_x,
                     paint.field_y + Geometry::scale_to_height(paint.height, 30.0).f64(),
                     size, paint.ink, Display::ANCHOR_CENTER_CENTER, true)
            put_text(list, paint, sview("Workshop", 0, -1), paint.field_x,
                     paint.field_y - Geometry::scale_to_height(paint.height, 27.0).f64(),
                     size, paint.ink, Display::ANCHOR_CENTER_CENTER, true)

    # "Paused", in the middle of the field.
    def put_paused(list: mutable Display::DisplayList&, paint: HudPaint&, paused: bool):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, sview("Paused", 0, -1) if paused else sview("", 0, -1),
                     paint.field_x, paint.field_y,
                     Geometry::calc_fontsize(paint.height, 14.0),
                     Display::rgba(64, 64, 255, 255),
                     Display::ANCHOR_CENTER_CENTER, false)

    # End-of-session praise and level-change notice. Centred on the FIELD's x
    # and not the window's, which are the same number on every window the
    # workshop opens and would not be on one where the field was off-centre.
    def put_congrats(list: mutable Display::DisplayList&, paint: HudPaint&, text: sview):
        can Memory.Allocate, Abort.Panic:
            put_text(list, paint, text, paint.field_x,
                     Geometry::from_top_edge(paint.height, 47.0).f64(),
                     Geometry::calc_fontsize(paint.height, 14.0),
                     Display::rgba(255, 32, 32, 255),
                     Display::ANCHOR_CENTER_CENTER, false)
