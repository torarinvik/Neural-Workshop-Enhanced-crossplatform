include "tasks/hold_it_game.elisa"
include "scene_polish.elisa"

module SceneHoldIt:
    const LEFT: f64 = 27.36
    const WIDTH: f64 = 857.28
    const BOTTOM: f64 = 179.0
    const HEIGHT: f64 = 389.0
    const CENTER: f64 = 456.0
    const FIRST_LAMP: u32 = 0xffd678ff
    const SECOND_LAMP: u32 = 0x8cdcffff

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: HoldIt::Grade = HoldIt::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": within ")
            dstr_append_i64(out, round_half_even(level.margin * 100.0))
            dstr_append_cstr(out, "%.")
            if level.ticks:
                dstr_append_cstr(out, "  A clock ticks at the wrong speed.")

    def stage(list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT, y: BOTTOM, w: WIDTH, h: HEIGHT}
            shadows: u32[3] = [0x0000001e, 0x00000012, 0x0000000c]
            for layer in 0..<3 |list, box, shadows|:
                spread: f64 = layer.f64() * 2.0
                shadow: SceneHiddenRule::Rect = ScenePolish::spread_box(&box, spread, 4.0)
                ScenePolish::rounded(list, &shadow, 16.0 + spread, shadows[layer.usize()])
            ScenePolish::rounded(list, &box, 16.0, 0x181a28ff)
            step: f64 = (HEIGHT - 8.0) / 16.0
            for band in 0..<16 |list, step|:
                mix: f64 = (band.f64() + 0.5) / 16.0
                color: u32 = Display::rgba(round_half_even(20.0 + 26.0 * mix),
                    round_half_even(22.0 + 18.0 * mix), round_half_even(34.0 + 36.0 * mix), 255)
                Display::draw_rect(list, LEFT + 4.0, BOTTOM + 4.0 + step * band.f64(), WIDTH - 8.0, step + 1.0, color)

    def lamp(list: mutable Display::DisplayList&, run: HoldIt::Run&, index: i64):
        can Memory.Allocate, Abort.Panic:
            x: f64 = LEFT + WIDTH * (0.5 if run.ask.count == 1 else 0.38 + 0.24 * index.f64())
            y: f64 = BOTTOM + HEIGHT * 0.56
            radius: f64 = HEIGHT * 0.13
            lit: bool = HoldIt::lamp_lit(run, index)
            lit_color: u32 = FIRST_LAMP if index == 0 else SECOND_LAMP
            if lit:
                halo_alpha: u32[4] = [25.u32(), 42.u32(), 59.u32(), 85.u32()]
                for halo in 0..<4 |list, x, y, radius, lit_color, halo_alpha|:
                    Display::draw_circle(list, x, y, radius * 3.0 * (1.0 - halo.f64() * 0.2),
                        (lit_color & 0xffffff00) | halo_alpha[halo.usize()])
            Display::draw_circle(list, x, y, radius, lit_color if lit else 0x46465aff)
            Display::draw_rect(list, x - radius * 0.4, y - radius * 1.6, radius * 0.8, radius * 0.7, 0xaa8c46ff)
            Display::draw_circle(list, x - radius * 0.35, y + radius * 0.35, radius * 0.22,
                0xffffff78 if lit else 0xffffff32)
            for groove in 0..<3 |list, x, y, radius|:
                line_y: f64 = y - radius * (1.0 + 0.2 * groove.f64())
                Display::draw_line(list, x - radius * 0.4, line_y, x + radius * 0.4, line_y, 2.0, 0x786028ff)

    def clock(list: mutable Display::DisplayList&, run: HoldIt::Run&):
        can Memory.Allocate, Abort.Panic:
            return if run.ask.tick == 0.0
            x: f64 = LEFT + WIDTH * 0.86
            y: f64 = BOTTOM + HEIGHT * 0.72
            radius: f64 = HEIGHT * 0.09
            Display::draw_circle(list, x, y, radius + 1.5, 0x5a4632ff)
            Display::draw_circle(list, x, y, radius - 1.5, 0xece6d6ff)
            step: i64 = (run.time / run.ask.tick).i64()
            angle: f64 = 1.5707963267948966 - (step % 60).f64() * 0.10471975511965977
            Display::draw_line(list, x, y, x + cos(angle) * radius * 0.85,
                y + sin(angle) * radius * 0.85, 2.0, 0xc82828ff)

    def result_bars(list: mutable Display::DisplayList&, run: HoldIt::Run&):
        can Memory.Allocate, Abort.Panic:
            max_value: f64 = run.ask.target if run.ask.target > run.held else run.held
            for index in 0..<2 |list, run, max_value|:
                label: mutable dstr = []
                value: f64 = run.ask.target if index == 0 else run.held
                dstr_append_cstr(&label, "asked " if index == 0 else "held ")
                dstr_append_fixed(&label, value, 2)
                dstr_append_cstr(&label, " s")
                x: f64 = LEFT + WIDTH * 0.2
                y: f64 = BOTTOM + HEIGHT * (0.16 - 0.08 * index.f64())
                background: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: x, y: y, w: WIDTH * 0.6, h: 14.0}
                ScenePolish::rounded(list, &background, 7.0, 0x3c3c50ff)
                length: f64 = background.w * value / (max_value * 1.15)
                bar: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: x, y: y, w: length if length > 14.0 else 14.0, h: 14.0}
                ScenePolish::rounded(list, &bar, 7.0, 0x78dc96ff if index == 0 else 0xffc86eff)
                SceneHiddenRule::text(list, bytes_view(label), x - 10.0, y + 7.0, 11.0, 0xe6e6f0e6, Display::ANCHOR_RIGHT_CENTER)

    def status(session: HoldItGame::Session&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if session.phase == HoldItGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif session.phase == HoldItGame::DONE:
                dstr_append_i64(out, session.passed_count)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, session.trial)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, session.best_rung)
            elif session.phase == HoldItGame::JUDGED:
                HoldIt::result_text(&session.run, out)
            elif session.run.ask.kind == HoldIt::SUM:
                dstr_append_cstr(out, "Two lamps: then hold as long as both together")
            elif session.run.ask.kind == HoldIt::SCALE:
                dstr_append_cstr(out, "Then hold HALF as long" if session.run.ask.factor < 1.0 else "Then hold TWICE as long")
            else:
                dstr_append_cstr(out, "Remember how long it shines; then hold that long")

    def render(list: mutable Display::DisplayList&, session: HoldItGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            SceneHiddenRule::text(list, "Hold It", CENTER, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            message: mutable dstr = []
            status(session, &message)
            SceneHiddenRule::text(list, bytes_view(message), CENTER, 614.0, 14.0, ink)
            SceneHiddenRule::text(list, "watch the lamp, then hold Space just as long   Esc: menu", CENTER, 26.0, 12.0, ink)
            return if session.phase == HoldItGame::READY or session.phase == HoldItGame::DONE
            run: HoldIt::Run& = &session.run
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.total)
            dstr_append_cstr(&facts, "   within ")
            dstr_append_i64(&facts, round_half_even(run.ask.level.margin * 100.0))
            dstr_append_cstr(&facts, "%")
            SceneHiddenRule::text(list, bytes_view(facts), CENTER, 588.0, 12.0, ink)
            stage(list)
            for index in 0..<run.ask.count |list, run|:
                lamp(list, run, index)
            clock(list, run)
            if session.phase == HoldItGame::JUDGED:
                if run.started and run.result != HoldIt::NO_HOLD:
                    result_bars(list, run)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.result == HoldIt::PASSED, bytes_view(message), 60.0, 16.0)
            elif run.time >= run.ask.turn:
                SceneHiddenRule::text(list, "holding..." if run.holding else "Hold now",
                    CENTER, BOTTOM + HEIGHT * 0.2, 20.0, 0xfff0c8f0, Display::ANCHOR_CENTER_CENTER, true)
