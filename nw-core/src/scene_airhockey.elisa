include "./scene_hand.elisa"
include "./geometry.elisa"
include "./scene_verdict.elisa"
include "./tasks/airhockey_game.elisa"

module SceneAirHockey:
    struct Thing:
        radius: f64
        at: RoomsView::Point
        tall: f64
        tint: u32

    def point(x: f64, y: f64) -> RoomsView::Vec:
        return RoomsView::vec(x, y, 1.0)

    def see(run: AirHockey::Run&, x: f64, y: f64) -> RoomsView::Vec:
        can Abort.Panic:
            return AirHockey::see(run, AirHockey::point(x, y))

    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            Display::draw_rect(list, SceneHand::x(x), SceneHand::y(y), w * SceneHand::SCALE, h * SceneHand::SCALE, tint)

    def quad(list: mutable Display::DisplayList&, a: RoomsView::Vec, b: RoomsView::Vec, c: RoomsView::Vec, d: RoomsView::Vec, tint: u32):
        can Abort.Panic, Memory.Allocate:
            return if a.z < 0.05 or b.z < 0.05 or c.z < 0.05 or d.z < 0.05
            vertices: mutable RoomsView::Vec[32] = zeroed
            vertices[0] <- a
            vertices[1] <- b
            vertices[2] <- c
            vertices[3] <- d
            SceneHand::polygon(list, &vertices, 4, tint)

    def oval(list: mutable Display::DisplayList&, p: RoomsView::Vec, rx: f64, ry: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            points: mutable RoomsView::Vec[32] = zeroed
            for i in 0..<20 |points,p,rx,ry|:
                a: f64 = 2.0 * 3.141592653589793 * i.f64() / 20.0
                points[i.usize()] <- point(p.x + rx * cos(a), p.y + ry * sin(a))
            SceneHand::polygon(list, &points, 20, tint)

    def puck(list: mutable Display::DisplayList&, run: AirHockey::Run&, thing: Thing):
        can Abort.Panic, Memory.Allocate:
            low: RoomsView::Vec = AirHockey::see(run, thing.at)
            high: RoomsView::Vec = AirHockey::see(run, thing.at, thing.tall)
            side: RoomsView::Vec = see(run, thing.at.x + thing.radius, thing.at.y)
            return if low.z < 0.05 or high.z < 0.05 or side.z < 0.05
            rx: f64 = fmax(2.0, py_hypot(side.x - low.x, side.y - low.y))
            ry: f64 = rx * 0.45
            dark: u32 = ScenePolish::mix_rgb(0x000000ff, thing.tint, 0.6)
            oval(list, low, rx, ry, dark)
            quad(list, point(low.x - rx, low.y), point(low.x + rx, low.y), point(high.x + rx, high.y), point(high.x - rx, high.y), dark)
            oval(list, high, rx, ry, thing.tint)

    def table(list: mutable Display::DisplayList&, run: AirHockey::Run&):
        can Abort.Panic, Memory.Allocate:
            SceneHand::card(list, 0x141828ff)
            rect(list, 0.0, 0.0, 1000.0, 640.0, 0x1a1e32ff)
            for k in 0..<6 |list|:
                Display::draw_circle(list, SceneHand::x(90.0 + 164.0 * k.f64()), SceneHand::y(600.0), 16.0 * SceneHand::SCALE, 0xfaf0c85a)
            rim: f64 = 0.09
            quad(list, see(run, -1.0 - rim, -rim), see(run, 1.0 + rim, -rim), see(run, 1.0 + rim, 2.0 + rim), see(run, -1.0 - rim, 2.0 + rim), 0x3c466eff)
            quad(list, see(run, -1.0, 0.0), see(run, 1.0, 0.0), see(run, 1.0, 2.0), see(run, -1.0, 2.0), 0xe8eef6ff)
            SceneHand::line(list, see(run, -1.0, 1.0), see(run, 1.0, 1.0), 3.0, 0xd65a5aff)
            previous: mutable RoomsView::Vec = see(run, 0.3, 1.0)
            for k in 1..<25 |list,run,previous|:
                a: f64 = 3.141592653589793 * k.f64() / 12.0
                current: RoomsView::Vec = see(run, 0.3 * cos(a), 1.0 + 0.3 * sin(a))
                SceneHand::line(list, previous, current, 2.0, 0xd65a5aff)
                previous <- current
            for k in 0..<2 |list,run,rim|:
                y: f64 = 0.0 if k == 0 else 2.0
                half: f64 = run.game.level.mouth if k == 0 else AirHockey::THEIRS
                out: f64 = -rim if k == 0 else rim
                quad(list, see(run, -half, y), see(run, half, y), see(run, half, y + out), see(run, -half, y + out), 0x101018ff)

    def keeper(list: mutable Display::DisplayList&, run: AirHockey::Run&):
        can Abort.Panic, Memory.Allocate:
            left: f64 = run.keeper - AirHockey::BAR
            right: f64 = run.keeper + AirHockey::BAR
            quad(list, see(run, left, 0.03), see(run, right, 0.03), see(run, right, 0.09), see(run, left, 0.09), 0xffbe3cff)

    def play(list: mutable Display::DisplayList&, run: AirHockey::Run&):
        can Abort.Panic, Memory.Allocate:
            table(list, run)
            far: bool = AirHockey::far_end(run)
            things: mutable Thing[3] = [Thing{radius: AirHockey::PUCK, at: run.puck, tall: 0.03, tint: 0x1e1e24ff},
                Thing{radius: AirHockey::MALLET, at: run.mine, tall: 0.09, tint: 0xdc3c3cff},
                Thing{radius: AirHockey::MALLET, at: run.theirs, tall: 0.09, tint: 0x466ee6ff}]
            for i in 1..<3 |things,far|:
                item: Thing = things[i.usize()]
                at: mutable i64 = i
                while at > 0 |things,far,item,at|:
                    previous: Thing = things[(at - 1).usize()]
                    break if (previous.at.y <= item.at.y if far else previous.at.y >= item.at.y)
                    things[at.usize()] <- previous
                    at <- at - 1
                things[at.usize()] <- item
            keeper(list, run) if far
            for i in 0..<3 |list,run,things|:
                item: Thing = things[i.usize()]
                continue if run.wait > 0.0 and item.radius == AirHockey::PUCK and (run.time * 6.0).i64() % 2 != 0
                puck(list, run, item)
            keeper(list, run) if not far
            SceneHand::progress(list, &run.hand, fmax(0.0, (run.game.level.seconds - run.time) / run.game.level.seconds))
            rect(list, 330.0, 596.0, 340.0, 36.0, 0x0c0e18dc)
            for k in 0..<2 |list,run|:
                text: mutable dstr = dstr_of_cstr("you " if k == 0 else "them ")
                dstr_append_i64(&text, run.score[k.usize()])
                dstr_append_cstr(&text, " / ")
                dstr_append_i64(&text, run.game.level.need if k == 0 else run.game.level.allow)
                SceneHand::word(list, bytes_view(text), 420.0 if k == 0 else 580.0, 614.0, 15.0, 0xff8282ff if k == 0 else 0x8caaffff, true)
            SceneHand::word(list, "FROM THE FAR END", 500.0, 572.0, 12.0, 0xffdc78ff, true) if far

    def verdict(out: mutable dstr&, run: AirHockey::Run&):
        can Abort.Panic, Memory.Allocate:
            if run.result == AirHockey::TIMEOUT:
                dstr_append_cstr(out, "Time: no winner")
                return
            dstr_append_cstr(out, "You win " if run.result == AirHockey::WON else "You lose ")
            dstr_append_i64(out, run.score[0])
            dstr_append_cstr(out, "-")
            dstr_append_i64(out, run.score[1])

    # taskoptions.airhockey_note: what the chosen starting rung is like.
    # `if level.swing` is a float test in the reference -- 0.0 below rung 13,
    # 22.0 from it -- so it is a nonzero test here.
    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: AirHockey::Grade = AirHockey::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": first to ")
            dstr_append_i64(out, level.need)
            dstr_append_cstr(out, "; ")
            dstr_append_i64(out, level.allow)
            dstr_append_cstr(out, " against loses.")
            dstr_append_cstr(out, "  The camera swings.") if level.swing != 0.0
            dstr_append_cstr(out, "  At times you look from the far end.") if level.flips

    def render(list: mutable Display::DisplayList&, game: AirHockeyGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Air Hockey", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Mouse: your mallet   Left/Right or A/D: the bar in your goal   Esc: menu", 456.0, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            if game.phase == AirHockeyGame::READY:
                Display::draw_text(list, "Press Space or click to start", 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            if game.phase == AirHockeyGame::DONE:
                report: mutable dstr = []
                dstr_append_i64(&report, game.wins)
                dstr_append_cstr(&report, " of ")
                dstr_append_i64(&report, game.trial)
                dstr_append_cstr(&report, " passed   highest rung passed ")
                dstr_append_i64(&report, game.best_rung)
                Display::draw_text(list, bytes_view(report), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
                return
            play(list, &game.run)
            Display::draw_text(list, "Score in the far goal; keep the puck out of yours", 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if game.phase == AirHockeyGame::JUDGED:
                text: mutable dstr = []
                verdict(&text, &game.run)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, game.run.result == AirHockey::WON, bytes_view(text), 60.0, 16.0)
