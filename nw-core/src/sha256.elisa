# SHA-256 for public outcome evidence. Input is hashed as supplied, including
# alpha bytes and any bytes after the visible framebuffer.
module Sha256:
    const MAX_BYTES: i64 = 2305843009213693951

    def rotate(word: u32, shift: u32) -> u32:
        return (word >> shift) | (word << (32.u32() - shift))

    def digest(input: u8&, length: i64, hex: mutable u8&):
        can Abort.Panic:
            state: mutable u32[8] = [1779033703.u32(), 3144134277.u32(), 1013904242.u32(), 2773480762.u32(), 1359893119.u32(), 2600822924.u32(), 528734635.u32(), 1541459225.u32()]
            constants: u32[64] = [
                1116352408.u32(), 1899447441.u32(), 3049323471.u32(), 3921009573.u32(),
                961987163.u32(), 1508970993.u32(), 2453635748.u32(), 2870763221.u32(),
                3624381080.u32(), 310598401.u32(), 607225278.u32(), 1426881987.u32(),
                1925078388.u32(), 2162078206.u32(), 2614888103.u32(), 3248222580.u32(),
                3835390401.u32(), 4022224774.u32(), 264347078.u32(), 604807628.u32(),
                770255983.u32(), 1249150122.u32(), 1555081692.u32(), 1996064986.u32(),
                2554220882.u32(), 2821834349.u32(), 2952996808.u32(), 3210313671.u32(),
                3336571891.u32(), 3584528711.u32(), 113926993.u32(), 338241895.u32(),
                666307205.u32(), 773529912.u32(), 1294757372.u32(), 1396182291.u32(),
                1695183700.u32(), 1986661051.u32(), 2177026350.u32(), 2456956037.u32(),
                2730485921.u32(), 2820302411.u32(), 3259730800.u32(), 3345764771.u32(),
                3516065817.u32(), 3600352804.u32(), 4094571909.u32(), 275423344.u32(),
                430227734.u32(), 506948616.u32(), 659060556.u32(), 883997877.u32(),
                958139571.u32(), 1322822218.u32(), 1537002063.u32(), 1747873779.u32(),
                1955562222.u32(), 2024104815.u32(), 2227730452.u32(), 2361852424.u32(),
                2428436474.u32(), 2756734187.u32(), 3204031479.u32(), 3329325298.u32()
            ]
            bits: u64 = length.u64() * 8.u64()
            blocks: i64 = length / 64 + (1 if length % 64 < 56 else 2)
            words: mutable u32[64] = zeroed
            for block in 0..<blocks |block, blocks, input, length, bits, words, state, constants|:
                for index in 0..<16 |index, block, blocks, input, length, bits, words|:
                    word: mutable u32 = 0.u32()
                    for lane in 0..<4 |lane, index, block, blocks, input, length, bits, word|:
                        offset: i64 = index * 4 + lane
                        at: i64 = block * 64 + offset
                        byte: mutable u32 = 0.u32()
                        if at < length:
                            byte <- input[at.usize()].u32()
                        elif at == length:
                            byte <- 128.u32()
                        elif block == blocks - 1 and offset >= 56:
                            byte <- ((bits >> ((63 - offset) * 8).u64()) & 255.u64()).u32()
                        word <- (word << 8.u32()) | byte
                    words[index.usize()] <- word
                for index in 16..<64 |index, words|:
                    a: u32 = words[(index - 15).usize()]
                    b: u32 = words[(index - 2).usize()]
                    low: u32 = rotate(a, 7.u32()) ^ rotate(a, 18.u32()) ^ (a >> 3.u32())
                    high: u32 = rotate(b, 17.u32()) ^ rotate(b, 19.u32()) ^ (b >> 10.u32())
                    words[index.usize()] <- words[(index - 16).usize()] + low + words[(index - 7).usize()] + high

                a: mutable u32 = state[0]
                b: mutable u32 = state[1]
                c: mutable u32 = state[2]
                d: mutable u32 = state[3]
                e: mutable u32 = state[4]
                f: mutable u32 = state[5]
                g: mutable u32 = state[6]
                h: mutable u32 = state[7]
                for round in 0..<64 |round, words, constants, a, b, c, d, e, f, g, h|:
                    upper: u32 = rotate(e, 6.u32()) ^ rotate(e, 11.u32()) ^ rotate(e, 25.u32())
                    choose: u32 = (e & f) ^ ((e ^ 4294967295.u32()) & g)
                    step: u32 = h + upper + choose + constants[round.usize()] + words[round.usize()]
                    lower: u32 = rotate(a, 2.u32()) ^ rotate(a, 13.u32()) ^ rotate(a, 22.u32())
                    majority: u32 = (a & b) ^ (a & c) ^ (b & c)
                    h <- g
                    g <- f
                    f <- e
                    e <- d + step
                    d <- c
                    c <- b
                    b <- a
                    a <- step + lower + majority
                state[0] <- state[0] + a
                state[1] <- state[1] + b
                state[2] <- state[2] + c
                state[3] <- state[3] + d
                state[4] <- state[4] + e
                state[5] <- state[5] + f
                state[6] <- state[6] + g
                state[7] <- state[7] + h
            for index in 0..<64 |index, state, hex|:
                digit: u32 = (state[(index / 8).usize()] >> ((7 - index % 8) * 4).u32()) & 15.u32()
                hex[index.usize()] <- (48.u32() + digit).u8() if digit < 10.u32() else (87.u32() + digit).u8()

def public_frame_digest(input: u8&?, bytes: i64, output: mutable u8&?) -> i64:
    can Abort.Panic:
        return -1 if input == null or output == null or bytes < 0 or bytes > Sha256::MAX_BYTES
        data: u8& = input
        target: mutable u8& = output
        Sha256::digest(data, bytes, target)
        return 1
