include "tasks/what_next_game.elisa"
include "what_next_assets.elisa"

module SceneWhatNext:
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const ASPECT: f64 = 4.0 / 3.0

    struct Tile:
        left: f64
        bottom: f64
        width: f64
        height: f64

    def tile(stream: i64, count: i64) -> Tile:
        can Abort.Panic:
            area_width: f64 = WIDTH * 0.94
            top: f64 = Geometry::from_top_edge(HEIGHT, 116.0).f64()
            bottom: f64 = Verdict::above_the_band(HEIGHT, Geometry::from_bottom_edge(HEIGHT, 58.0).f64()).f64()
            area_height: f64 = top - bottom
            opening_limit: f64 = area_height * 0.46 * ASPECT
            opening_width: f64 = opening_limit if opening_limit < area_width * 0.5 else area_width * 0.5
            opening_height: f64 = opening_width / ASPECT
            if stream == 0:
                return Tile{left: (WIDTH - opening_width) / 2.0, bottom: top - opening_height,
                    width: opening_width, height: opening_height}
            gap: f64 = area_width * 0.015
            label_room: f64 = Geometry::calc_fontsize(HEIGHT, 12.0) * 2.6
            row_limit: f64 = (area_width - gap * (count - 1).f64()) / count.f64()
            height_limit: f64 = (area_height - opening_height - label_room * 1.6) * ASPECT
            width: f64 = row_limit if row_limit < height_limit else height_limit
            left: f64 = (WIDTH - count.f64() * width - (count - 1).f64() * gap) / 2.0
            return Tile{left: left + (stream - 1).f64() * (width + gap), bottom: bottom + label_room,
                width: width, height: width / ASPECT}

    def hit(run: WhatNextGame::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return -1 if run.phase != WhatNextGame::CHOOSING
            for stream in 1..<(run.puzzle.count + 1) |run, x, y|:
                box: Tile = tile(stream, run.puzzle.count)
                if x >= box.left and x <= box.left + box.width and y >= box.bottom and y <= box.bottom + box.height:
                    return stream - 1
            return -1

    def description(kind: i64) -> cstr:
        if kind == WhatNext::OTHER: return "another clip"
        if kind == WhatNext::REVERSED: return "played backwards"
        if kind == WhatNext::LATER: return "later on"
        if kind == WhatNext::REPLAY: return "the opening again"
        if kind == WhatNext::EARLIER: return "from the opening"
        if kind == WhatNext::SKIPPED: return "skipped ahead"
        return "what happened"

    def option_note(rung: i64, clips: i64, note: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: WhatNext::Grade = WhatNext::grade(rung)
            dstr_append_cstr(note, "Rung ")
            dstr_append_i64(note, rung)
            dstr_append_cstr(note, ": ")
            dstr_append_i64(note, level.choices)
            dstr_append_cstr(note, " options; the decoys are ")
            first: mutable bool = true
            for kind in WhatNext::OTHER..<(WhatNext::SKIPPED + 1) |level, note, first|:
                if WhatNext::has_kind(&level, kind):
                    if not first:
                        dstr_append_cstr(note, ", ")
                    dstr_append_cstr(note, description(kind))
                    first <- false
            dstr_append_cstr(note, ".")
            if level.context < 1.0:
                dstr_append_cstr(note, "  Only the last ")
                dstr_append_i64(note, (level.context * 100.0 + 0.5).i64())
                dstr_append_cstr(note, "% of the opening is shown.")
            if clips > 0:
                dstr_append_cstr(note, "  ")
                dstr_append_i64(note, clips)
                dstr_append_cstr(note, " clips saved.")
            else:
                dstr_append_cstr(note, "  Import video clips to build the library.")

    def status(run: WhatNextGame::Run&, message: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == WhatNextGame::READY:
                dstr_append_cstr(message, "Press Space to start")
            elif run.phase == WhatNextGame::LOADING:
                dstr_append_cstr(message, "Loading clip…")
            elif run.phase == WhatNextGame::CHOOSING:
                dstr_append_cstr(message, "Which of these is what happened next?")
            elif run.phase == WhatNextGame::DONE:
                dstr_append_i64(message, run.passed)
                dstr_append_cstr(message, " of ")
                dstr_append_i64(message, run.scored)
                dstr_append_cstr(message, " passed   highest rung passed ")
                dstr_append_i64(message, run.best)
            elif run.chosen == run.puzzle.answer:
                dstr_append_cstr(message, "Right: that is what happened")
            else:
                dstr_append_cstr(message, "No — that was ")
                dstr_append_cstr(message, description(run.puzzle.options[run.chosen.usize()].kind))
                dstr_append_cstr(message, "; option ")
                dstr_append_i64(message, run.puzzle.answer + 1)
                dstr_append_cstr(message, " is what happened")

    def draw_tile(list: mutable Display::DisplayList&, run: WhatNextGame::Run&, stream: i64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            box: Tile = tile(stream, run.puzzle.count)
            center: f64 = box.left + box.width / 2.0
            middle: f64 = box.bottom + box.height / 2.0
            size: f64 = Geometry::calc_fontsize(HEIGHT, 12.0)
            Display::draw_sprite_fitted(list, (WhatNextAssets::FIRST_SPRITE + stream).u32(), center, middle,
                box.width, box.height, 0.0, Display::rgba(255, 255, 255, 255))
            index: i64 = stream - 1
            judged: bool = stream > 0 and run.phase == WhatNextGame::JUDGED
            correct: bool = judged and index == run.puzzle.answer
            wrong: bool = judged and index == run.chosen and not correct
            color: u32 = Display::rgba(60, 170, 90, 255) if correct else (Display::rgba(214, 64, 58, 255) if wrong else ink)
            Display::draw_box(list, box.left, box.bottom, box.width, box.height, color, 5.0 if correct or wrong else 2.0)
            if stream == 0:
                Display::draw_text_weight(list, "how it starts", box.left - 12.0, middle, size, ink,
                    Display::ANCHOR_RIGHT_CENTER, false)
            else:
                label: mutable dstr = []
                dstr_append_i64(&label, stream)
                Display::draw_text_weight(list, bytes_view(label), center, box.bottom + box.height + size,
                    size * 1.2, ink, Display::ANCHOR_CENTER_CENTER, true)
                if judged:
                    label_text: cstr = description(run.puzzle.options[index.usize()].kind)
                    Display::draw_text_weight(list, sview(label_text, 0, -1),
                        center, box.bottom - size * 1.3, size * 0.9, ink, Display::ANCHOR_CENTER_CENTER, false)

    def render(list: mutable Display::DisplayList&, run: WhatNextGame::Run&, black: bool,
               notice: sview = sview("", 0, -1)):
        can Memory.Allocate, Abort.Panic:
            gray: i64 = 255 if black else 0
            ink: u32 = Display::rgba(gray, gray, gray, 255)
            center: f64 = WIDTH / 2.0
            Display::draw_text_weight(list, "What Happens Next", center, HEIGHT - 36.0, 22.0, ink,
                Display::ANCHOR_CENTER_CENTER, true)
            message: mutable dstr = []
            if run.phase == WhatNextGame::READY and sview_len(notice) > 0.usize():
                dstr_append_sview(&message, notice)
            else:
                status(run, &message)
            Display::draw_text_weight(list, bytes_view(message), center, HEIGHT - 70.0, 14.0, ink,
                Display::ANCHOR_CENTER_CENTER, false)
            Display::draw_text_weight(list, "click the stretch that really came next, or press 1-6   Esc: menu",
                center, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER, false)
            return if run.phase != WhatNextGame::CHOOSING and run.phase != WhatNextGame::JUDGED
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, run.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, run.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, run.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, run.puzzle.count)
            dstr_append_cstr(&facts, " options")
            Display::draw_text_weight(list, bytes_view(facts), center, HEIGHT - 96.0, 12.0, ink,
                Display::ANCHOR_CENTER_CENTER, false)
            for stream in 0..<(run.puzzle.count + 1) |list, run, ink|:
                draw_tile(list, run, stream, ink)
            if run.phase == WhatNextGame::JUDGED:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, run.chosen == run.puzzle.answer, bytes_view(message), 60.0, 16.0)
