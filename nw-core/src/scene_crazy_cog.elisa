include "./scene_crazy_cog_parts.elisa"
include "./geometry.elisa"
include "./scene_verdict.elisa"

extend SceneCrazyCog:
    def backdrop(list: mutable Display::DisplayList&, run: CrazyCog::Run&):
        can Abort.Panic, Memory.Allocate:
            n: i64 = run.machine.level.layers
            p: Plane = depth(run, n if n > 1 else 0)
            rect(list, point(30.0, 130.0), 940.0, 460.0, 0x3a2e26ff if n > 1 else 0xc4a478ff)
            if n > 1:
                rect(list, at(p, 30.0, 130.0), 940.0 * p.scale, 460.0 * p.scale, 0x967c5cff)
            for x in 0..<23 |list, n, p|:
                for y in 0..<11 |list, n, p, x|:
                    disc(list, at(p, 50.0 + 40.0 * x.f64(), 150.0 + 40.0 * y.f64()),
                        2.0 * p.scale if n > 1 else 2.5, 0x735c42ff if n > 1 else 0x967856ff)
            rect(list, point(0.0, 0.0), 1000.0, 124.0, 0x342820ff)
            rect(list, point(0.0, 122.0), 1000.0, 4.0, 0x1e1814ff)
            if n > 1:
                front: Plane = depth(run, 0)
                back: Plane = depth(run, n - 1)
                for corner in 0..<4 |list, front, back|:
                    x: f64 = 30.0 if corner % 2 == 0 else 970.0
                    y: f64 = 130.0 if corner < 2 else 590.0
                    SceneHand::line(list, at(front, x, y), at(back, x, y), 1.0, 0x5a4632a0)

    def name(list: mutable Display::DisplayList&, run: CrazyCog::Run&, peg: CrazyCog::Cog, label: cstr, lift: f64):
        can Abort.Panic, Memory.Allocate:
            return if peg.z < run.layer
            n: i64 = run.machine.level.layers
            p: Plane = depth(run, peg.z)
            where: RoomsView::Vec = at(p, peg.x, peg.y + lift)
            title: mutable dstr = []
            dstr_append_cstr(&title, label)
            if n > 1 and lift > 0.0:
                dstr_append_cstr(&title, " (")
                dstr_append_i64(&title, peg.z + 1)
                dstr_append_cstr(&title, ")")
            SceneHand::word(list, bytes_view(title), where.x, where.y, 10.0 * fmax(0.75, p.scale),
                0xe6dcc8ff if n > 1 else 0x282832ff, true)

    def append_load(text: mutable dstr&, load: f64):
        can Abort.Panic, Memory.Allocate:
            tenths: i64 = py_round_half_even(load * 10.0)
            dstr_append_i64(text, tenths / 10)
            dstr_append_cstr(text, ".")
            dstr_append_i64(text, tenths % 10)

    def option_note(rung: i64, text: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: CrazyCog::Grade = CrazyCog::grade(rung)
            dstr_append_cstr(text, "Rung ")
            dstr_append_i64(text, level.rung)
            dstr_append_cstr(text, ": a load of ")
            append_load(text, level.load)
            dstr_append_cstr(text, ".")
            if level.chains:
                dstr_append_cstr(text, "  Chains.")
            if level.walls > 0:
                dstr_append_cstr(text, "  ")
                dstr_append_i64(text, level.walls)
                dstr_append_cstr(text, " walls.")
            if level.layers > 1:
                dstr_append_cstr(text, "  A back layer and shared axles.")
            if level.fan > 0:
                dstr_append_cstr(text, "  A fan to turn.")

    def bucket(list: mutable Display::DisplayList&, run: CrazyCog::Run&):
        can Abort.Panic, Memory.Allocate:
            winch: CrazyCog::Cog = run.machine.winch
            p: Plane = depth(run, winch.z)
            x: f64 = winch.x + CrazyCog::DRUM
            base: f64 = CrazyCog::FLOOR
            y: f64 = base + run.height
            top: f64 = base + run.machine.lift + 26.0
            rect(list, at(p, x - 24.0, base - 4.0), 48.0 * p.scale, 4.0 * p.scale, opacity(0x5a4632ff, p.alpha))
            SceneHand::line(list, at(p, x + 4.0, top), at(p, x + 70.0, top), 2.0, opacity(0x3c8c46ff, p.alpha))
            shape(list, at(p, x + 70.0, top), at(p, x + 70.0, top + 20.0), at(p, x + 90.0, top + 12.0),
                opacity(0x50be5aff, p.alpha))
            hook: RoomsView::Vec = at(p, x, y + 30.0)
            SceneHand::line(list, at(p, x, winch.y), hook, 2.0, opacity(0x5a4628ff, p.alpha))
            strap: u32 = opacity(0x3c3c3cff, p.alpha)
            SceneHand::line(list, at(p, x - 14.0, y + 22.0), hook, 2.0, strap)
            SceneHand::line(list, at(p, x + 14.0, y + 22.0), hook, 2.0, strap)
            shape(list, at(p, x - 16.0, y + 22.0), at(p, x + 16.0, y + 22.0), at(p, x + 12.0, y),
                opacity(0x6e788cff, p.alpha), at(p, x - 12.0, y))
            if run.machine.level.load > 0.5:
                value: mutable dstr = []
                append_load(&value, run.machine.level.load)
                spot: RoomsView::Vec = at(p, x, y + 8.0)
                SceneHand::word(list, bytes_view(value), spot.x, spot.y, 9.0 * fmax(0.7, p.scale), 0xffffffe6)

    def fixtures(list: mutable Display::DisplayList&, run: CrazyCog::Run&):
        can Abort.Panic, Memory.Allocate:
            mc: CrazyCog::Machine& = &run.machine
            mp: Plane = depth(run, 0)
            motor: RoomsView::Vec = at(mp, mc.motor.x, mc.motor.y)
            rect(list, at(mp, mc.motor.x - 46.0, mc.motor.y - 46.0), 92.0 * mp.scale, 92.0 * mp.scale, opacity(0x3c465aff, mp.alpha))
            rect(list, at(mp, mc.motor.x - 42.0, mc.motor.y - 42.0), 84.0 * mp.scale, 84.0 * mp.scale, opacity(0x505c74ff, mp.alpha))
            name(list, run, mc.motor, "MOTOR", -60.0)
            wp: Plane = depth(run, mc.winch.z)
            winch: RoomsView::Vec = at(wp, mc.winch.x, mc.winch.y)
            disc(list, winch, (CrazyCog::DRUM + 4.0) * wp.scale, opacity(0x5a4632ff, wp.alpha))
            disc(list, winch, CrazyCog::DRUM * wp.scale, opacity(0x967850ff, wp.alpha))
            name(list, run, mc.winch, "WINCH", 84.0)
            if mc.fan.r > 0.0:
                fp: Plane = depth(run, mc.fan.z)
                center: RoomsView::Vec = at(fp, mc.fan.x, mc.fan.y)
                index: i64 = CrazyCog::at_peg(run, mc.fan)
                turn: f64 = run.wheels[index.usize()].angle if index >= 0 else 0.0
                for i in 0..<3 |list, fp, center, turn|:
                    angle: f64 = turn + 2.0 * PI * i.f64() / 3.0
                    shape(list, center, polar(center, 50.0 * fp.scale, angle - 0.3),
                        polar(center, 56.0 * fp.scale, angle + 0.1), opacity(0xb4d2e6ff, fp.alpha))
                arrow(list, center, 66.0 * fp.scale, mc.fan_way.f64(), opacity(0x2878c8ff, fp.alpha))
                name(list, run, mc.fan, "FAN", 80.0)
            arrow(list, motor, 34.0 * mp.scale, -1.0, opacity(0xf0c846ff, mp.alpha))
            for peg in [mc.motor, mc.winch, mc.fan] |list, run|:
                if peg.r > 0.0 and CrazyCog::at_peg(run, peg) < 0:
                    p: Plane = depth(run, peg.z)
                    center: RoomsView::Vec = at(p, peg.x, peg.y)
                    disc(list, center, 8.0 * p.scale, opacity(0x3c3228ff, p.alpha))
                    disc(list, center, 5.0 * p.scale, opacity(0xc8b478ff, p.alpha))

    def shafts(list: mutable Display::DisplayList&, run: CrazyCog::Run&):
        can Abort.Panic, Memory.Allocate:
            for a in run.wheels:
                for b in run.wheels:
                    if b.cog.z > a.cog.z and CrazyCog::shared_axle(a.cog, b.cog):
                        p: Plane = depth(run, a.cog.z)
                        q: Plane = depth(run, b.cog.z)
                        start: RoomsView::Vec = at(p, a.cog.x, a.cog.y)
                        end: RoomsView::Vec = at(q, b.cog.x, b.cog.y)
                        alpha: i64 = CrazyCog::max_i(p.alpha, q.alpha)
                        SceneHand::line(list, start, end, 6.0, opacity(0x3c4048ff, alpha))
                        SceneHand::line(list, start, end, 3.0, opacity(0xbec4d2ff, alpha))

    def plane(list: mutable Display::DisplayList&, run: CrazyCog::Run&, z: i64):
        can Abort.Panic, Memory.Allocate:
            p: Plane = depth(run, z)
            if z != run.layer:
                left: f64 = p.x + 30.0 * p.scale
                bottom: f64 = p.y + 130.0 * p.scale
                right: f64 = left + 940.0 * p.scale
                top: f64 = bottom + 460.0 * p.scale
                edge: u32 = opacity(0xc8e6ffff, CrazyCog::min_i(255, p.alpha + 40))
                rect(list, point(left, bottom), right - left, top - bottom, opacity(0x96bedcff, p.alpha / 6))
                SceneHand::line(list, point(left, bottom), point(right, bottom), 1.5, edge)
                SceneHand::line(list, point(left, top), point(right, top), 1.5, edge)
                SceneHand::line(list, point(left, bottom), point(left, top), 1.5, edge)
                SceneHand::line(list, point(right, bottom), point(right, top), 1.5, edge)
                if z > run.layer:
                    SceneHand::number(list, z + 1, point(left + 10.0, top - 10.0), 9.0, opacity(0xe6f0ffff, p.alpha))
            for wall in run.machine.walls:
                continue if wall.z != z
                base: u32 = 0x5a5e68ff if z == 0 else 0x50463eff
                rect(list, at(p, wall.x, wall.y), wall.w * p.scale, wall.h * p.scale, opacity(base, p.alpha))
                rect(list, at(p, wall.x + 3.0, wall.y + 3.0), (wall.w - 6.0) * p.scale, (wall.h - 6.0) * p.scale,
                    opacity(ScenePolish::mix_rgb(base, 0xffffffff, 0.2), p.alpha))
            if run.machine.level.layers > 1 and z == run.layer:
                for wheel in run.wheels:
                    if wheel.cog.z == z:
                        disc(list, at(p, wheel.cog.x + 6.0, wheel.cog.y - 6.0), wheel.cog.r, 0x00000028)
            for wheel in run.wheels:
                c: CrazyCog::Cog = wheel.cog
                continue if c.z != z
                center: RoomsView::Vec = at(p, c.x, c.y)
                base: u32 = metal(c.r.i64())
                color: u32 = ScenePolish::mix_rgb(base, 0x283246ff, 0.15 * (z - run.layer).f64()) if z > run.layer else base
                cog(list, center, c.r * p.scale, wheel.angle, color, p.alpha)
                for other in run.wheels:
                    if CrazyCog::shared_axle(c, other.cog):
                        disc(list, center, 9.0 * p.scale, opacity(0xe6c85aff, p.alpha))
                        disc(list, center, 4.0 * p.scale, opacity(0x3c321eff, p.alpha))
                        break
            for i in 0..<run.belts.count.i64() |list, run, p, z|:
                belt: CrazyCog::Link = run.belts[i.usize()]
                if belt.first.z == z:
                    chain(list, run, belt, p)

    def coil(list: mutable Display::DisplayList&, x: f64, y: f64, stock: i64 = -1):
        can Abort.Panic, Memory.Allocate:
            for i in 0..<3 |list, x, y|:
                p: RoomsView::Vec = point(x, y - 6.0 + 6.0 * i.f64())
                oval(list, p, 20.0, 8.0, 0x282422ff)
                oval(list, p, 15.0, 4.0, 0x5a5450ff)
            if stock >= 0:
                label: mutable dstr = []
                dstr_append_cstr(&label, "x")
                dstr_append_i64(&label, stock)
                SceneHand::word(list, bytes_view(label), x + 26.0, y - 14.0, 10.0, 0xf0e6d2ff, true)

    def tray(list: mutable Display::DisplayList&, run: CrazyCog::Run&):
        can Abort.Panic, Memory.Allocate:
            count: i64 = CrazyCog::slots(run)
            gap: f64 = CrazyCog::tray_gap(count)
            y: f64 = CrazyCog::TRAY_Y
            scale: f64 = 0.66 if gap >= 95.0 else 0.5
            hover: mutable i64 = -1
            for i in 0..<count |list, run, gap, y, scale, count, hover|:
                x: f64 = CrazyCog::tray_x(i, count)
                disc(list, point(x, y), fmin(44.0, gap / 2.0 - 4.0), 0x42342aff)
                if i == run.tray.count.i64():
                    if run.stock > 0:
                        coil(list, x, y + 4.0, run.stock)
                    SceneHand::word(list, "chain", x, y + 40.0, 9.0, 0xe6dcc8e6)
                    continue
                r: i64 = run.tray[i.usize()]
                continue if r == 0
                n: i64 = teeth(r.f64())
                cog(list, point(x, y), r.f64() * scale, 0.0, metal(r), 255, false, n)
                label: mutable dstr = []
                dstr_append_i64(&label, n)
                dstr_append_cstr(&label, " teeth")
                SceneHand::word(list, bytes_view(label), x, y + 40.0, 9.0, 0xe6dcc8e6)
                if run.carry == 0 and run.chain_from.r == 0.0 and fabs(run.hand.x - x) <= gap / 2.0 and fabs(run.hand.y - y) <= 40.0:
                    hover <- i
            if hover >= 0:
                r: f64 = run.tray[hover.usize()].f64()
                x: f64 = HandView::clamp(CrazyCog::tray_x(hover, count), 30.0 + r, 970.0 - r)
                cog(list, point(x, 134.0 + r), r, 0.0, 0xffffff5a, 255, true)
            if run.carry > 0:
                if run.hand.y >= 130.0:
                    c: CrazyCog::Cog = CrazyCog::snap_cog(run, run.hand.x, run.hand.y, run.carry.f64())
                    cog(list, point(c.x, c.y), c.r, 0.0, 0x5adc6e6e if CrazyCog::placeable(run, c) else 0xe6463c6e, 255, true)
                cog(list, point(run.hand.x, run.hand.y), run.carry.f64(), 0.0, metal(run.carry))
            elif run.carry == CrazyCog::CARRY_BELT:
                coil(list, run.hand.x, run.hand.y)
            if run.chain_from.r > 0.0:
                SceneHand::line(list, point(run.chain_from.x, run.chain_from.y), point(run.hand.x, run.hand.y), 5.0, 0x282422dc)

    def hud(list: mutable Display::DisplayList&, run: CrazyCog::Run&):
        can Abort.Panic, Memory.Allocate:
            n: i64 = run.machine.level.layers
            if n > 1:
                for z in 0..<n |list, run|:
                    active: bool = z == run.layer
                    x: f64 = 36.0 + 46.0 * z.f64()
                    rect(list, point(x, 600.0), 40.0, 22.0, 0xf0c846ff if active else 0x5a5046ff)
                    SceneHand::number(list, z + 1, point(x + 20.0, 611.0), 10.0, 0x1e1a14ff if active else 0xc8beb4ff)
                label: mutable dstr = []
                dstr_append_cstr(&label, "plane ")
                dstr_append_i64(&label, run.layer + 1)
                dstr_append_cstr(&label, " of ")
                dstr_append_i64(&label, n)
                dstr_append_cstr(&label, "   Tab: deeper   G: nearer")
                Display::draw_text(list, bytes_view(label), SceneHand::x(46.0 + 46.0 * n.f64()), SceneHand::y(611.0),
                    9.0 * SceneHand::SCALE, 0xffffffdc, Display::ANCHOR_LEFT_CENTER)
            ratio: f64 = CrazyCog::winch_ratio(run)
            if run.jammed:
                SceneHand::word(list, "JAMMED", 500.0, 612.0, 16.0, 0xff6e5aff, true)
            elif ratio > 0.0 and CrazyCog::lift_speed(1.0 / ratio, run.machine.level.load) <= 0.0:
                SceneHand::word(list, "STALLED: gear it down", 500.0, 612.0, 14.0, 0xffaa50ff, true)
            elif ratio < 0.0:
                SceneHand::word(list, "The winch turns the wrong way", 500.0, 612.0, 14.0, 0xffaa50ff, true)
            if run.machine.fan.r > 0.0 and run.machine.level.fan >= 2:
                top: f64 = 2.0 * run.machine.fan_high
                low: f64 = run.machine.fan_low / top
                high: f64 = run.machine.fan_high / top
                speed: f64 = HandView::clamp(fabs(CrazyCog::fan_speed(run)) / top, 0.0, 1.0)
                rect(list, point(830.0, 600.0), 140.0, 22.0, 0x1e1e24ff)
                rect(list, point(834.0 + 132.0 * low, 604.0), 132.0 * (high - low), 14.0, 0x50be5aff)
                rect(list, point(832.5 + 132.0 * speed, 602.0), 3.0, 18.0, 0xffffffff)
                SceneHand::word(list, "fan speed", 790.0, 608.0, 9.0, 0xffffffdc)

    def board(list: mutable Display::DisplayList&, run: CrazyCog::Run&):
        can Abort.Panic, Memory.Allocate:
            SceneHand::card(list, 0x423228ff)
            backdrop(list, run)
            bucket(list, run)
            fixtures(list, run)
            n: i64 = run.machine.level.layers
            for i in 0..<n |list, run, n|:
                z: i64 = n - 1 - i
                if z == run.layer:
                    shafts(list, run)
                plane(list, run, z)
            tray(list, run)
            hud(list, run)
            SceneHand::progress(list, &run.hand, fmax(0.0, (run.machine.seconds - run.time) / run.machine.seconds))

    def verdict(result: i64) -> sview:
        return "Bucket up" if result == CrazyCog::BUCKET_UP
        return "Bucket up, but the fan was wrong" if result == CrazyCog::FAN_WRONG
        return "Out of time"

    def render(list: mutable Display::DisplayList&, game: CrazyCogGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Crazy Cog", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Drag cogs and chains from the tray   Tab/G: deeper or nearer plane   R: clear   Esc: menu",
                456.0, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            run: CrazyCog::Run& = &game.run
            status: mutable dstr = []
            if game.phase == CrazyCogGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif game.phase == CrazyCogGame::DONE:
                dstr_append_i64(&status, game.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, game.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, game.best_rung)
            elif game.phase == CrazyCogGame::PLAYING:
                if run.machine.fan.r > 0.0:
                    dstr_append_cstr(&status, "Lift the bucket, and turn the fan its way")
                elif run.machine.level.layers > 1:
                    dstr_append_cstr(&status, "The winch is on plane ")
                    dstr_append_i64(&status, run.machine.level.layers)
                    dstr_append_cstr(&status, ", at the back: carry the drive there on shared axles")
                else:
                    dstr_append_cstr(&status, "Gear the motor to the winch: lift the bucket")
            else:
                Display::draw_text(list, verdict(run.result), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if status.count > 0.usize():
                Display::draw_text(list, bytes_view(status), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if game.phase == CrazyCogGame::PLAYING or game.phase == CrazyCogGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, game.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, game.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, game.total)
                Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
                board(list, run)
            if game.phase == CrazyCogGame::JUDGED or game.phase == CrazyCogGame::DONE:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.result == CrazyCog::BUCKET_UP, verdict(run.result), 60.0, 16.0)
