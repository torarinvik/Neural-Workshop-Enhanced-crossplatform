include "./tasks/kerbside_game.elisa"
include "./scene_live_view.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"

# ui/kerbside.py: the street from above at night, you on it, and no cars --
# they are only heard. Shapes are cut to the scene's rectangle the way
# LiveTask cuts them.
module SceneKerbside:
    const LEFT: f64 = (LiveView::WIDTH - LiveView::VIEW_WIDTH) / 2.0
    const KERB: u32 = 0x34363cff
    const ROAD: u32 = 0x1e2026ff
    const EDGE: u32 = 0xc8c8beff
    const DASH: u32 = 0xdcdcd2ff
    const VAN: u32 = 0x46506eff
    const WALKER: u32 = 0xfad278ff
    const HEAD: u32 = 0x3c3228ff

    struct Clip:
        x0: f64
        y0: f64
        x1: f64
        y1: f64

    def bottom() -> f64:
        can Abort.Panic:
            return Verdict::above_the_band(LiveView::HEIGHT, Geometry::from_bottom_edge(LiveView::HEIGHT, 58.0).f64()).f64()

    def height() -> f64:
        can Abort.Panic:
            return fmax(40.0, Geometry::from_top_edge(LiveView::HEIGHT, 116.0).f64() - bottom())

    def label(list: mutable Display::DisplayList&, text: sview, y: f64, size: f64, ink: u32, bold: bool = false):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, LiveView::CX, y, size, ink, Display::ANCHOR_CENTER_CENTER, bold)

    # LiveTask.rect.
    def rect(list: mutable Display::DisplayList&, clip: Clip, x: f64, y: f64, w: f64, h: f64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            ax: f64 = clip.x0 if clip.x0 > x else x
            ay: f64 = clip.y0 if clip.y0 > y else y
            bx: f64 = clip.x1 if clip.x1 < x + w else x + w
            by: f64 = clip.y1 if clip.y1 < y + h else y + h
            return if bx <= ax or by <= ay
            Display::draw_rect(list, ax, ay, bx - ax, by - ay, ink)

    # LiveTask.line and its Liang-Barsky cut.
    def line(list: mutable Display::DisplayList&, clip: Clip, ax: f64, ay: f64, bx: f64, by: f64, thick: f64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            dx: f64 = bx - ax
            dy: f64 = by - ay
            lo: mutable f64 = 0.0
            hi: mutable f64 = 1.0
            ps: f64[4] = [-dx, dx, -dy, dy]
            qs: f64[4] = [ax - clip.x0, clip.x1 - ax, ay - clip.y0, clip.y1 - ay]
            for e in 0..<4 |ps, qs, lo, hi|:
                p: f64 = ps[e.usize()]
                q: f64 = qs[e.usize()]
                if p == 0.0:
                    return if q < 0.0
                    continue
                t: f64 = q / p
                if p < 0.0:
                    lo <- t if t > lo else lo
                else:
                    hi <- t if t < hi else hi
                return if lo > hi
            Display::draw_line(list, ax + dx * lo, ay + dy * lo, ax + dx * hi, ay + dy * hi, thick, ink)

    # LiveTask.disc.
    def disc(list: mutable Display::DisplayList&, clip: Clip, x: f64, y: f64, radius: f64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            return if not (clip.x0 <= x and x <= clip.x1 and clip.y0 <= y and y <= clip.y1)
            r: mutable f64 = radius
            if r > 4.0:
                edges: f64[4] = [x - clip.x0, clip.x1 - x, y - clip.y0, clip.y1 - y]
                for e in 0..<4 |edges, r|:
                    r <- edges[e.usize()] if edges[e.usize()] < r
            Display::draw_circle(list, x, y, r if r > 0.5 else 0.5, ink)

    # Kerbside._draw, without the frame's card.
    def street(list: mutable Display::DisplayList&, run: Kerbside::Run&):
        can Memory.Allocate, Abort.Panic:
            left: f64 = LEFT
            low: f64 = bottom()
            width: f64 = LiveView::VIEW_WIDTH
            tall: f64 = height()
            clip: Clip = Clip{x0: left, y0: low, x1: left + width, y1: low + tall}
            level: Kerbside::Grade = run.street.level
            far: f64 = Kerbside::far_side(&level)
            span: f64 = far - Kerbside::START + 2.0
            fit: f64 = (tall - 40.0) / span
            across: f64 = (width - 40.0) / 30.0
            k: f64 = across if across < fit else fit
            x0: f64 = left + 20.0
            x1: f64 = left + width - 20.0
            cx: f64 = (x0 + x1) / 2.0
            near: f64 = low + 20.0 + (Kerbside::START - 1.0 - Kerbside::START + 1.0) * k
            kerb: f64 = low + 20.0 + (0.0 - Kerbside::START + 1.0) * k
            road: f64 = low + 20.0 + (Kerbside::LANE * level.lanes.f64() - Kerbside::START + 1.0) * k
            beyond: f64 = low + 20.0 + (far + 1.0 - Kerbside::START + 1.0) * k
            rect(list, clip, x0, near, x1 - x0, kerb - near, KERB)
            rect(list, clip, x0, kerb, x1 - x0, road - kerb, ROAD)
            rect(list, clip, x0, road, x1 - x0, beyond - road, KERB)
            for i in 0..<(level.lanes + 1) |list, clip, level, low, k, x0, x1|:
                y: f64 = low + 20.0 + (Kerbside::LANE * i.f64() - Kerbside::START + 1.0) * k
                if i == 0 or i == level.lanes:
                    line(list, clip, x0, y, x1, y, 4.0, EDGE)
                else:
                    x: mutable f64 = x0
                    while x < x1 |list, clip, x, x1, y|:
                        line(list, clip, x, y, x1 if x1 < x + 24.0 else x + 24.0, y, 3.0, DASH)
                        x <- x + 44.0
            if run.street.vans > 0:
                van: f64 = low + 20.0 + (-0.9 - Kerbside::START + 1.0) * k
                rect(list, clip, cx + run.street.van_a0 * k, van, (run.street.van_b0 - run.street.van_a0) * k, 0.8 * k, VAN)
                rect(list, clip, cx + run.street.van_a1 * k, van, (run.street.van_b1 - run.street.van_a1) * k, 0.8 * k, VAN)
            at: f64 = low + 20.0 + (run.y - Kerbside::START + 1.0) * k
            body: f64 = Kerbside::BODY * k * 1.6
            head: f64 = Kerbside::BODY * k * 0.6
            disc(list, clip, cx, at, body if body > 5.0 else 5.0, WALKER)
            disc(list, clip, cx, at + 0.25 * k, head if head > 2.0 else 2.0, HEAD)

    def card(list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT - 4.0, y: bottom() - 4.0, w: LiveView::VIEW_WIDTH + 8.0, h: height() + 8.0}
            shades: u32[3] = [30.u32(), 18.u32(), 12.u32()]
            for i in 0..<3 |list, box, shades|:
                blur: f64 = i.f64() * 2.0
                shadow: SceneHiddenRule::Rect = ScenePolish::spread_box(&box, blur, 4.0)
                ScenePolish::rounded(list, &shadow, 14.0 + blur, shades[i.usize()])
            ScenePolish::rounded(list, &box, 14.0, 0x0e1016ff)

    # The run's result, as the reference words it.
    def verdict_text(run: Kerbside::Run&, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.result == Kerbside::ACROSS:
                dstr_append_cstr(words, "Across in ")
                dstr_append_fixed(words, py_round_decimal(run.t, 10.0), 1)
                dstr_append_cstr(words, " s")
            elif run.result == Kerbside::HIT:
                dstr_append_cstr(words, "Hit in lane ")
                dstr_append_i64(words, run.lane + 1)
            elif run.result == Kerbside::STILL:
                dstr_append_cstr(words, "Still on the street")

    def render(list: mutable Display::DisplayList&, session: KerbsideGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            label(list, "Kerbside", 648.0, 22.0, ink, true)
            label(list, "Up / W: walk   Down / S: step back   Listen   Esc: menu", 26.0, 12.0, ink)
            caption: mutable dstr = []
            verdict_text(&session.run, &caption)
            status: mutable dstr = []
            if session.phase == KerbsideGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == KerbsideGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == KerbsideGame::JUDGED:
                status <- caption
            else:
                dstr_append_cstr(&status, "Cross when the way is clear -- by ear")
            label(list, bytes_view(status), 614.0, 14.0, ink)
            if session.phase == KerbsideGame::PLAYING or session.phase == KerbsideGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   ")
                dstr_append_i64(&facts, session.run.street.level.lanes)
                dstr_append_cstr(&facts, " lanes")
                label(list, bytes_view(facts), 588.0, 12.0, ink)
                card(list)
                street(list, &session.run)
            if session.phase == KerbsideGame::JUDGED or session.phase == KerbsideGame::DONE:
                SceneVerdict::put(list, LiveView::WIDTH, LiveView::HEIGHT, 1.0, 1.0, session.run.result == Kerbside::ACROSS,
                    bytes_view(caption), 60.0, 16.0)

    # taskoptions.kerbside_note.
    def option_note(rung: i64, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Kerbside::Grade = Kerbside::grade(rung)
            dstr_append_cstr(words, "Rung ")
            dstr_append_i64(words, level.rung)
            dstr_append_cstr(words, ": ")
            dstr_append_i64(words, level.lanes)
            dstr_append_cstr(words, " lane(s).")
            dstr_append_cstr(words, "  Quiet electric cars.") if level.electric != 0.0
            dstr_append_cstr(words, "  Wind.") if level.wind != 0.0
