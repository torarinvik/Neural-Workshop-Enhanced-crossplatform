include "tasks/video_sequence.elisa"
include "scene_jigsaw.elisa"

module SceneVideoSequence:
    def summary(run: VideoSequence::Run&, message: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            result: Jigsaw::JigsawScore = VideoSequence::score(run)
            dstr_append_i64(message, result.puzzles)
            dstr_append_cstr(message, " clips, ")
            dstr_append_i64(message, result.efficiency)
            dstr_append_cstr(message, "% swap efficiency, ")
            dstr_append_fixed(message, result.mean_seconds, 0)
            dstr_append_cstr(message, "s each, most pieces ")
            dstr_append_i64(message, result.most_pieces)

    def verdict(run: VideoSequence::Run&, message: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_cstr(message, "In order in ")
            dstr_append_i64(message, run.swaps)
            dstr_append_cstr(message, " swaps — the minimum was ")
            dstr_append_i64(message, run.par)
            dstr_append_cstr(message, " — in ")
            dstr_append_fixed(message, run.results[(run.result_count - 1).usize()].elapsed, 0)
            dstr_append_cstr(message, "s")

    def status(run: VideoSequence::Run&, library_count: i64, notice: sview, message: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == Jigsaw::PHASE_READY:
                if sview_len(notice).i64() > 0:
                    dstr_append_sview(message, notice)
                else:
                    dstr_append_cstr(message, "Press Space to start")
            elif run.phase == VideoSequence::PHASE_LOADING:
                dstr_append_cstr(message, "Loading clip…")
            elif run.phase == Jigsaw::PHASE_DONE:
                summary(run, message)
            else:
                if run.phase == Jigsaw::PHASE_SOLVED:
                    verdict(run, message)
                else:
                    dstr_append_cstr(message, "Put the pieces in the order they happened")
                dstr_append_cstr(message, "     clip ")
                dstr_append_i64(message, run.puzzle)
                dstr_append_cstr(message, " of ")
                dstr_append_i64(message, run.puzzles)
                dstr_append_cstr(message, "   swaps ")
                dstr_append_i64(message, run.swaps)
                dstr_append_cstr(message, "   minimum ")
                dstr_append_i64(message, run.par)
                dstr_append_cstr(message, "   pieces ")
                dstr_append_i64(message, run.active_pieces)
                if library_count > 0 and library_count < run.puzzles:
                    dstr_append_cstr(message, "     only ")
                    dstr_append_i64(message, library_count)
                    dstr_append_cstr(message, " clips downloaded — clips will repeat")

    # Each sprite identifies a time segment. The host supplies its current
    # texture using VideoSequence::source_frame for that segment.
    def render(list: mutable Display::DisplayList&, run: VideoSequence::Run&, black: bool,
               width: f64, height: f64, library_count: i64 = 0, notice: sview = sview("", 0, -1)):
        can Memory.Allocate, Abort.Panic:
            paint: SceneJigsaw::JigsawPaint = SceneJigsaw::paint_of(black, width, height, width / 912.0, height / 684.0)
            x: f64 = Geometry::width_center(width).f64()
            SceneJigsaw::put_text(list, &paint, "Video Sequence", x, Geometry::from_top_edge(height, 36.0).f64(),
                Geometry::calc_fontsize(height, 22.0), paint.ink, Display::ANCHOR_CENTER_CENTER, true)
            message: mutable dstr = []
            status(run, library_count, notice, &message)
            SceneJigsaw::put_text(list, &paint, bytes_view(message), x, Geometry::from_top_edge(height, 70.0).f64(),
                Geometry::calc_fontsize(height, 14.0), paint.ink, Display::ANCHOR_CENTER_CENTER, false)
            SceneJigsaw::put_text(list, &paint, "Esc: task menu     Space: start     click two pieces to swap     C: options",
                x, Geometry::from_bottom_edge(height, 26.0).f64(),
                Geometry::calc_fontsize(height, 12.0), paint.ink, Display::ANCHOR_CENTER_CENTER, false)
            return if run.phase != Jigsaw::PHASE_SOLVING and run.phase != Jigsaw::PHASE_SOLVED
            for position in 0..<run.active_pieces |position, run, width, height, list, paint|:
                box: Jigsaw::Rect = VideoSequence::tile_rect(width, height, run.active_pieces, position)
                Display::draw_sprite_fitted(list, (VideoSequenceAssets::FIRST_SPRITE + run.order[position.usize()]).u32(),
                    (box.left + box.width / 2.0) / paint.sx, (box.bottom + box.height / 2.0) / paint.sy,
                    box.width / paint.sx, box.height / paint.sy, 0.0, Display::rgba(255, 255, 255, 255))
            for position in 0..<run.active_pieces |position, run, width, height, list, paint|:
                selected: bool = position == run.picked
                placed: bool = run.phase == Jigsaw::PHASE_SOLVED or (run.mark_placed and run.order[position.usize()] == position)
                if selected or placed or position == run.hovered:
                    box: Jigsaw::Rect = VideoSequence::tile_rect(width, height, run.active_pieces, position)
                    color: u32 = SceneJigsaw::color_accent() if selected or (position == run.hovered and run.phase != Jigsaw::PHASE_SOLVED) else SceneJigsaw::color_right()
                    Display::draw_box(list, box.left / paint.sx, box.bottom / paint.sy, box.width / paint.sx, box.height / paint.sy,
                        color, (5.0 if selected else 3.0) / paint.sy)
            if run.phase == Jigsaw::PHASE_SOLVED:
                text: mutable dstr = []
                verdict(run, &text)
                SceneVerdict::put(list, width, height, paint.sx, paint.sy, run.swaps <= run.par, bytes_view(text), 60.0, 16.0)
