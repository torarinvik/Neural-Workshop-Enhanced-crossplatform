include "./tasks/missing_word_game.elisa"
include "./scene_hand.elisa"
include "./geometry.elisa"
include "./textmetrics.elisa"

module SceneMissingWord:
    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, color: u32):
        can Memory.Allocate, Abort.Panic:
            left: f64 = fmax(0.0, x)
            bottom: f64 = fmax(0.0, y)
            width: f64 = fmin(HandView::WIDTH, x + w) - left
            height: f64 = fmin(HandView::HEIGHT, y + h) - bottom
            if width > 0.0 and height > 0.0:
                Display::draw_rect(list, SceneHand::x(left), SceneHand::y(bottom),
                    width * SceneHand::SCALE, height * SceneHand::SCALE, color)

    def tile(list: mutable Display::DisplayList&, text: sview, center: f64, y: f64, width: f64,
            size: f64 = 15.0, picked: bool = false, lifted: bool = false):
        can Memory.Allocate, Abort.Panic:
            left: f64 = center - width / 2.0
            bottom: f64 = y - MissingWord::TILE_H / 2.0
            if lifted:
                rect(list, left + 4.0, bottom - 4.0, width, MissingWord::TILE_H, 0x0000003c)
            rect(list, left, bottom, width, MissingWord::TILE_H, 0xbeb4a0ff)
            rect(list, left + 1.5, bottom + 1.5, width - 3.0, MissingWord::TILE_H - 3.0, 0xffecaaff if picked else 0xfffcf4ff)
            SceneHand::word(list, text, center, y, size, 0x282430ff)
            if picked:
                underline: f64 = SceneHand::y(bottom + 5.0)
                Display::draw_line(list, SceneHand::x(left + 6.0), underline, SceneHand::x(left + width - 6.0),
                    underline, 2.0 * SceneHand::SCALE, 0xc83c28ff)

    def word_tile(list: mutable Display::DisplayList&, word: Passages::Word, stop: bool,
            x: f64, y: f64, width: f64, size: f64 = 15.0, picked: bool = false, lifted: bool = false):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            bytes: mutable u8[17] = zeroed
            length: i64 = word.length
            assert length >= 0 and length <= 16
            for i in 0..<length |bytes, word|:
                bytes[i.usize()] <- Passages::letter(word, i).u8()
            bytes[length.usize()] <- 46.u8() if stop
            trusted Unsafe.PointerCast:
                text: sview = unsafe_sview_bounded_bytes(&bytes[0], (length + (1 if stop else 0)).usize())
                tile(list, text, x, y, width, size, picked, lifted)

    def caret(list: mutable Display::DisplayList&, x: f64, y: f64, picked: bool):
        can Memory.Allocate, Abort.Panic:
            color: u32 = 0xd25032ff if picked else 0x786e64ff
            Display::begin_polygon(list, 3, SceneHand::x(x - 6.0), SceneHand::y(y - 4.0), color)
            Display::polygon_point(list, SceneHand::x(x + 6.0), SceneHand::y(y - 4.0))
            Display::polygon_point(list, SceneHand::x(x), SceneHand::y(y + 6.0))

    def button(list: mutable Display::DisplayList&, x: f64, name: sview):
        can Memory.Allocate, Abort.Panic:
            rect(list, x - 60.0, MissingWord::BUTTON_Y - 20.0, 120.0, 40.0, 0x5a6482ff)
            SceneHand::word(list, name, x, MissingWord::BUTTON_Y, 12.0, 0xf0f0faff, true)

    def page(list: mutable Display::DisplayList&, run: MissingWord::Run&):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            count: i64 = run.machine.level.sentences
            top: f64 = MissingWord::row_y(0, count) + 44.0
            bottom: f64 = MissingWord::row_y(count - 1, count) - 56.0
            rect(list, 20.0, bottom, 960.0, top - bottom, 0xf6f0e2ff)
            rect(list, 20.0, bottom, 6.0, top - bottom, 0xdc786eff)
            chosen: MissingWord::Choice = run.choice
            for r in 0..<count |list, run, count, chosen|:
                row: darray[MissingWord::Token] = run.rows[r.usize()]
                words: i64 = row.count.i64()
                y: f64 = MissingWord::row_y(r, count)
                scale: f64 = MissingWord::row_scale(&row)
                x: mutable f64 = MissingWord::TEXT_LEFT
                for i in 0..<words |list, row, r, y, scale, x, chosen, words|:
                    width: f64 = MissingWord::tile_width(&row, i) * scale
                    token: MissingWord::Token = row[i.usize()]
                    word: mutable Passages::Word = token.text
                    word.capitals <- word.capitals | 1.u64() if i == 0
                    word_tile(list, word, i + 1 == words, x + width / 2.0, y, width, 15.0 * scale,
                        chosen.kind == MissingWord::WORD and chosen.row == r and chosen.index == i)
                    x <- x + width + MissingWord::GAP * scale
                x <- MissingWord::TEXT_LEFT
                for i in 0..<(words - 1) |list, row, r, y, scale, x, chosen|:
                    x <- x + MissingWord::tile_width(&row, i) * scale
                    caret(list, x + MissingWord::GAP * scale / 2.0, y - MissingWord::CARET_DY,
                        chosen.kind == MissingWord::GAP_CHOICE and chosen.row == r and chosen.index == i)
                    x <- x + MissingWord::GAP * scale
            if run.options.count > 0:
                if chosen.kind == MissingWord::WORD:
                    SceneHand::word(list, "Strike it out?", 500.0, MissingWord::OPT_Y + 30.0, 10.0, 0xe6e6f0ff)
                    tile(list, "strike out", 500.0, MissingWord::OPT_Y, MissingWord::OPT_WIDTH)
                else:
                    SceneHand::word(list, "Put in:", 500.0, MissingWord::OPT_Y + 30.0, 10.0, 0xe6e6f0ff)
                    for i in 0..<run.options.count |list, run|:
                        word_tile(list, run.options.words[i.usize()], false, MissingWord::option_x(i, run.options.count),
                            MissingWord::OPT_Y, MissingWord::OPT_WIDTH)
            button(list, MissingWord::DONE_X, "DONE")
            button(list, MissingWord::RESET_X, "RESET")

    def option_note(rung: i64, text: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: MissingWord::Grade = MissingWord::grade(rung)
            dstr_append_cstr(text, "Rung ")
            dstr_append_i64(text, level.rung)
            dstr_append_cstr(text, ": ")
            dstr_append_i64(text, level.sentences)
            dstr_append_cstr(text, " sentence(s), ")
            dstr_append_i64(text, level.errors)
            dstr_append_cstr(text, " mistake(s) to mend.")

    def caption(view: sview, text: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if sview_len(view).i64() > 140:
                dstr_append_sview(text, string_view_prefix(view, 137))
                dstr_append_cstr(text, "...")
            else:
                dstr_append_sview(text, view)

    def label(list: mutable Display::DisplayList&, text: sview, y: f64, size: f64, ink: u32, bold: bool = false):
        can Memory.Allocate, Abort.Panic:
            width: f64 = TextMetrics::text_width(size, TextMetrics::codepoints(text)).f64()
            room: f64 = 912.0 * 0.96
            actual: f64 = fmax(6.0, size * room / width) if width > room else size
            Display::draw_text_weight(list, text, 456.0, y, actual, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def verdict(run: MissingWord::Run&, text: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.result == MissingWord::MENDED:
                dstr_append_cstr(text, "Mended")
                return
            dstr_append_cstr(text, "Out of time: " if run.result == MissingWord::TIMEOUT else "Not as it was written: ")
            for i in 0..<run.machine.level.sentences |run, text|:
                dstr_append_cstr(text, " ") if i > 0
                row: MissingWord::Line& = &run.machine.original[i.usize()]
                for j in 0..<row.count |row, text|:
                    dstr_append_cstr(text, " ") if j > 0
                    word: mutable Passages::Word = row.words[j.usize()].text
                    word.capitals <- 1.u64() if j == 0 else 0.u64()
                    Passages::append_word(text, word)
                dstr_append_cstr(text, ".")

    def render(list: mutable Display::DisplayList&, session: MissingWordGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            label(list, "The Missing Word", 648.0, 22.0, ink, true)
            label(list, "Click a caret for words to put in, a word to strike it   Enter: done   R: reset", 26.0, 12.0, ink)
            run: MissingWord::Run& = &session.run
            status: mutable dstr = []
            if session.phase == MissingWordGame::READY:
                dstr_append_cstr(&status, "No passage available for this rung" if session.unavailable else "Press Space or click to start")
            elif session.phase == MissingWordGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == MissingWordGame::JUDGED:
                raw: mutable dstr = []
                verdict(run, &raw)
                caption(bytes_view(raw), &status)
            else:
                dstr_append_cstr(&status, "Mend the passage")
                if run.machine.level.hint:
                    missing: mutable i64 = 0
                    for i in 0..<run.machine.count |run, missing|:
                        missing <- missing + 1 if run.machine.damage[i.usize()].kind == MissingWord::MISSING
                    dstr_append_cstr(&status, ": ")
                    dstr_append_i64(&status, missing)
                    dstr_append_cstr(&status, " word(s) missing")
                    extra: i64 = run.machine.count - missing
                    if extra > 0:
                        dstr_append_cstr(&status, ", ")
                        dstr_append_i64(&status, extra)
                        dstr_append_cstr(&status, " too many")
            label(list, bytes_view(status), 614.0, 14.0, ink)
            if session.phase == MissingWordGame::PLAYING or session.phase == MissingWordGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                label(list, bytes_view(facts), 588.0, 12.0, ink)
                SceneHand::card(list, 0x363c4aff)
                page(list, run)
                SceneHand::progress(list, &run.hand, fmax(0.0, (run.machine.level.seconds - run.t) / run.machine.level.seconds))
            if session.phase == MissingWordGame::JUDGED or session.phase == MissingWordGame::DONE:
                raw: mutable dstr = []
                final_text: mutable dstr = []
                verdict(run, &raw)
                caption(bytes_view(raw), &final_text)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.result == MissingWord::MENDED, bytes_view(final_text), 60.0, 16.0)
