include "./tasks/docking_game.elisa"
include "./docking_stars.elisa"
include "./scene_live_view.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"

module SceneDocking:
    def lens(run: Docking::Run&) -> LiveView::View:
        can Abort.Panic:
            eye: RoomsView::Vec = RoomsView::vec(run.pos.x, run.pos.y, run.pos.z)
            f: Docking::Vec = Docking::body_to_world(Docking::Vec{x: 0.0, y: 0.0, z: 1.0}, run.att)
            u: Docking::Vec = Docking::body_to_world(Docking::Vec{x: 0.0, y: 1.0, z: 0.0}, run.att)
            return LiveView::lens(eye, RoomsView::vec(f.x, f.y, f.z), RoomsView::vec(u.x, u.y, u.z), Docking::radians(30.0))

    def orbit(radius: f64, angle: f64, z: f64, roll: f64) -> RoomsView::Vec:
        p: Docking::Vec = Docking::rotate_roll(Docking::Vec{x: radius * cos(angle), y: radius * sin(angle), z: z}, roll)
        return RoomsView::vec(p.x, p.y, p.z)

    def disc(list: mutable Display::DisplayList&, view: LiveView::View&, radius: f64, depth: f64, roll: f64, count: i64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            vertices: mutable RoomsView::Vec[46] = zeroed
            for k in 0..<count |radius, depth, roll, count, vertices|:
                vertices[k.usize()] <- orbit(radius, 2.0 * Docking::PI * k.f64() / count.f64(), depth, roll)
            LiveView::face(list, view, &vertices, count, ink)

    def stars(list: mutable Display::DisplayList&, view: LiveView::View&):
        can Memory.Allocate, Abort.Panic:
            data: f64[480] = DockingStars::positions()
            for i in 0..<160 |list, view, data|:
                j: usize = (3 * i).usize()
                ray: RoomsView::Vec = RoomsView::vec(400.0 * data[j], 400.0 * data[j + 1.usize()], 400.0)
                z: f64 = RoomsView::dot(ray, view.camera.forward)
                continue if z < 0.05
                p: RoomsView::Point = LiveView::project(view, RoomsView::vec(RoomsView::dot(ray, view.camera.right),
                    RoomsView::dot(ray, view.camera.up), z))
                if fabs(p.x - LiveView::CX) < LiveView::VIEW_WIDTH / 2.0 and p.y > view.bottom and p.y < view.bottom + view.height:
                    c: u32 = (120.0 + 120.0 * data[j + 2.usize()]).u32()
                    Display::draw_circle(list, p.x, p.y, 1.2, (c << 24) | (c << 16) | (c << 8) | 255.u32())

    def station(list: mutable Display::DisplayList&, view: LiveView::View&, roll: f64):
        can Memory.Allocate, Abort.Panic:
            disc(list, view, 7.0, 0.0, roll, 40, 0x787c88ff)
            for k in 0..<8 |list, view, roll|:
                a: f64 = 2.0 * Docking::PI * k.f64() / 8.0
                LiveView::seg(list, view, orbit(1.4, a, -0.01, roll), orbit(7.0, a, -0.01, roll), 2.0, 0x5a5e6aff)
            disc(list, view, 0.9, -0.02, roll, 32, 0x282c38ff)
            for k in 0..<32 |list, view, roll|:
                a: f64 = 2.0 * Docking::PI * k.f64() / 32.0
                b: f64 = 2.0 * Docking::PI * ((k + 1) % 32).f64() / 32.0
                LiveView::seg(list, view, orbit(0.9, a, -0.02, roll), orbit(0.9, b, -0.02, roll), 3.0, 0xfac850ff)
            LiveView::seg(list, view, RoomsView::vec(0.0, 0.0, -0.02), RoomsView::vec(0.0, 0.0, -1.0), 3.0, 0xdcdce6ff)
            LiveView::seg(list, view, orbit(-0.35, 0.0, -1.0, roll), orbit(0.35, 0.0, -1.0, roll), 3.0, 0xfafaffff)
            LiveView::seg(list, view, orbit(-0.35, Docking::PI / 2.0, -1.0, roll),
                orbit(0.35, Docking::PI / 2.0, -1.0, roll), 3.0, 0xfafaffff)

    def label(list: mutable Display::DisplayList&, words: sview, y: f64, size: f64, ink: u32, bold: bool = false):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, words, LiveView::CX, y, size, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def decimal(out: mutable dstr&, value: f64, places: i64):
        can Memory.Allocate, Abort.Panic:
            scale: f64 = 100.0 if places == 2 else 10.0
            dstr_append_fixed(out, py_round_decimal(value, scale), places)

    def cockpit(list: mutable Display::DisplayList&, run: Docking::Run&):
        can Memory.Allocate, Abort.Panic:
            view: LiveView::View = lens(run)
            left: f64 = LiveView::CX - LiveView::VIEW_WIDTH / 2.0
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: left - 4.0, y: view.bottom - 4.0,
                w: LiveView::VIEW_WIDTH + 8.0, h: view.height + 8.0}
            shade: u32[3] = [30.u32(), 18.u32(), 12.u32()]
            for i in 0..<3 |list, box, shade|:
                spread: f64 = i.f64() * 2.0
                halo: SceneHiddenRule::Rect = ScenePolish::spread_box(&box, spread, 4.0)
                ScenePolish::rounded(list, &halo, 14.0 + spread, shade[i.usize()])
            ScenePolish::rounded(list, &box, 14.0, 0x04060eff)
            stars(list, &view)
            station(list, &view, Docking::station_roll(run))
            cy: f64 = view.bottom + view.height / 2.0
            for sign in 0..<2 |list, cy|:
                direction: f64 = 2.0 * sign.f64() - 1.0
                Display::draw_line(list, LiveView::CX + direction * 12.0, cy, LiveView::CX + direction * 30.0, cy, 2.0, 0x6ef08cc8)
                Display::draw_line(list, LiveView::CX, cy + direction * 12.0, LiveView::CX, cy + direction * 30.0, 2.0, 0x6ef08cc8)
            share: f64 = fmax(0.0, run.fuel / fmax(0.000001, run.approach.fuel))
            if share > 0.0:
                Display::draw_rect(list, left + 16.0, view.bottom + 16.0, 16.0, (view.height - 32.0) * share,
                    0x6ec88cff if share > 0.25 else 0xe66e50ff)
            if run.approach.level.readouts:
                words: mutable dstr = []
                p: Docking::Vec = run.pos
                dstr_append_cstr(&words, "range ")
                decimal(&words, sqrt(p.x * p.x + p.y * p.y + p.z * p.z), 1)
                dstr_append_cstr(&words, " m   closing ")
                decimal(&words, run.vel.z, 2)
                dstr_append_cstr(&words, " m/s (at most ")
                decimal(&words, run.approach.level.vmax, 2)
                dstr_append_cstr(&words, ")")
                label(list, bytes_view(words), view.bottom + 24.0, 12.0, 0xb4f0beff)

    def verdict_text(run: Docking::Run&, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.result == Docking::CLEAR:
                dstr_append_cstr(words, "Docked at ")
                decimal(words, run.vel.z, 2)
                dstr_append_cstr(words, " m/s")
            elif run.result == Docking::LOST:
                dstr_append_cstr(words, "Drifted away")
            elif run.result == Docking::CONTACT:
                dstr_append_cstr(words, "Hit the port: ")
                for i in 0..<4 |run, words|:
                    bit: i64 = 1 << i
                    continue if (run.problems & bit) == 0
                    dstr_append_cstr(words, ", ") if (run.problems & (bit - 1)) != 0
                    if bit == Docking::OFF_CENTRE:
                        decimal(words, py_hypot(run.pos.x, run.pos.y), 2)
                        dstr_append_cstr(words, " m off centre")
                    elif bit == Docking::TOO_FAST:
                        decimal(words, run.vel.z, 2)
                        dstr_append_cstr(words, " m/s too fast")
                    elif bit == Docking::NOSE_OFF:
                        dstr_append_cstr(words, "nose ")
                        dstr_append_i64(words, py_round_half_even(fmax(fabs(run.att.x), fabs(run.att.y)) * (180.0 / Docking::PI)))
                        dstr_append_cstr(words, " degrees off")
                    else:
                        dstr_append_cstr(words, "rolled ")
                        dstr_append_i64(words, py_round_half_even(fabs(Docking::roll_error(run)) * (180.0 / Docking::PI)))
                        dstr_append_cstr(words, " degrees off")

    def render(list: mutable Display::DisplayList&, session: DockingGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            label(list, "Docking", 648.0, 22.0, ink, true)
            label(list, "WASD: across / up   R / F: forward / back   Arrows: nose   Q / E: roll   Esc: menu", 26.0, 12.0, ink)
            status: mutable dstr = []
            if session.phase == DockingGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == DockingGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == DockingGame::JUDGED:
                verdict_text(&session.run, &status)
            else:
                dstr_append_cstr(&status, "Dock: centred, square and slow")
            label(list, bytes_view(status), 614.0, 14.0, ink)
            if session.phase == DockingGame::PLAYING or session.phase == DockingGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   fuel ")
                dstr_append_i64(&facts, py_round_half_even(fmax(0.0, session.run.fuel)))
                dstr_append_cstr(&facts, " s")
                label(list, bytes_view(facts), 588.0, 12.0, ink)
                cockpit(list, &session.run)
            if session.phase == DockingGame::JUDGED or session.phase == DockingGame::DONE:
                caption: mutable dstr = []
                verdict_text(&session.run, &caption)
                SceneVerdict::put(list, LiveView::WIDTH, LiveView::HEIGHT, 1.0, 1.0, session.run.result == Docking::CLEAR,
                    bytes_view(caption), 60.0, 16.0)

    def option_note(rung: i64, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Docking::Grade = Docking::grade(rung)
            dstr_append_cstr(words, "Rung ")
            dstr_append_i64(words, level.rung)
            dstr_append_cstr(words, ": within ")
            decimal(words, level.tol, 2)
            dstr_append_cstr(words, " m, under ")
            decimal(words, level.vmax, 2)
            dstr_append_cstr(words, " m/s.")
            dstr_append_cstr(words, "  No readouts.") if not level.readouts
