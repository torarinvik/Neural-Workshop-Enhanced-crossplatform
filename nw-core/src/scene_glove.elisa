include "./tasks/glove_game.elisa"
include "./scene_live_view.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./scene_lens.elisa"

# ui/glove.py: the ballpark as the camera now shows it -- the grass, the
# infield, the mound, the plate, the pitcher, the catcher (from every angle
# but the catcher's own), and the glove on the plate's plane with the ball,
# whichever is nearer drawn last. The glove is see-through, and flashes green
# for a catch and red for a miss.
module SceneGlove:
    const LEFT: f64 = (LiveView::WIDTH - LiveView::VIEW_WIDTH) / 2.0

    def bottom() -> f64:
        can Abort.Panic:
            return Verdict::above_the_band(LiveView::HEIGHT, Geometry::from_bottom_edge(LiveView::HEIGHT, 58.0).f64()).f64()

    def height() -> f64:
        can Abort.Panic:
            return fmax(40.0, Geometry::from_top_edge(LiveView::HEIGHT, 116.0).f64() - bottom())

    def label(list: mutable Display::DisplayList&, text: sview, y: f64, size: f64, ink: u32, bold: bool = false):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, LiveView::CX, y, size, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def clip() -> SceneLens::Clip:
        can Abort.Panic:
            b: f64 = bottom()
            return SceneLens::Clip{x0: LEFT, y0: b, x1: LEFT + LiveView::VIEW_WIDTH, y1: b + height()}

    def v(x: f64, y: f64, z: f64) -> SceneLens::Vec:
        return SceneLens::vec(x, y, z)

    # The lens the screen draws the view with: the controller moves the
    # glove's picture through it.
    def lens(view: i64) -> SceneLens::Lens:
        can Abort.Panic:
            e: f64[3] = Glove::eye(view)
            l: f64[3] = Glove::look(view)
            return SceneLens::camera(v(e[0], e[1], e[2]), v(l[0] - e[0], l[1] - e[1], l[2] - e[2]), LEFT, bottom(),
                LiveView::VIEW_WIDTH, height(), 76.0, false)

    def quad(list: mutable Display::DisplayList&, cut: SceneLens::Clip, lens: SceneLens::Lens&, a: SceneLens::Vec,
             b: SceneLens::Vec, c: SceneLens::Vec, d: SceneLens::Vec, ink: u32):
        can Memory.Allocate, Abort.Panic:
            shape: SceneLens::Solid = SceneLens::quad(a, b, c, d)
            SceneLens::face(list, cut, lens, &shape, ink)

    # Glove._draw, without the frame's card.
    def view(list: mutable Display::DisplayList&, run: Glove::Run&):
        can Memory.Allocate, Abort.Panic:
            cut: SceneLens::Clip = clip()
            seen: i64 = Glove::view(run)
            e: f64[3] = Glove::eye(seen)
            camera: SceneLens::Lens = lens(seen)
            quad(list, cut, &camera, v(-40.0, 0.0, -30.0), v(40.0, 0.0, -30.0), v(40.0, 0.0, 60.0), v(-40.0, 0.0, 60.0), 0x468c46ff)
            quad(list, cut, &camera, v(-14.0, 0.002, -4.0), v(14.0, 0.002, -4.0), v(14.0, 0.002, 24.0), v(-14.0, 0.002, 24.0),
                0xb0845aff)
            mound: mutable SceneLens::Solid = zeroed
            for k in 0..<24 |mound|:
                a: f64 = k.f64() * Glove::PI / 12.0
                mound.points[k.usize()] <- v(2.7 * Glove::cosine(a), 0.004, Glove::MOUND + 0.4 + 2.7 * Glove::sine(a))
            mound.count <- 24
            SceneLens::face(list, cut, &camera, &mound, 0xbe9264ff)
            plate: mutable SceneLens::Solid = zeroed
            plate.points[0] <- v(-0.22, 0.006, 0.0)
            plate.points[1] <- v(0.22, 0.006, 0.0)
            plate.points[2] <- v(0.22, 0.006, -0.22)
            plate.points[3] <- v(0.0, 0.006, -0.43)
            plate.points[4] <- v(-0.22, 0.006, -0.22)
            plate.count <- 5
            SceneLens::face(list, cut, &camera, &plate, 0xfafafaff)
            # the pitcher
            mx: f64 = Glove::RELEASE_X
            mz: f64 = Glove::MOUND + 0.5
            SceneLens::box(list, cut, &camera, mx - 0.25, 0.0, mz - 0.15, mx + 0.25, 1.5, mz + 0.15, 0x283c96ff)
            SceneLens::ball(list, cut, &camera, v(mx, 1.7, mz), 0.13, 0xe6bea0ff)
            # the catcher behind the plate, crouched -- not in the view from
            # behind the catcher, which is theirs
            if seen != 0:
                SceneLens::box(list, cut, &camera, -0.3, 0.0, -1.0, 0.3, 0.95, -0.55, 0x3c3c46ff)
                SceneLens::ball(list, cut, &camera, v(0.0, 1.1, -0.75), 0.15, 0x282832ff)
            # the glove on the plate's plane, and the ball, nearer last
            r: f64 = run.game.level.glove
            gx: f64 = run.glove_x
            gy: f64 = run.glove_y
            glove: mutable SceneLens::Solid = zeroed
            for k in 0..<24 |glove, r, gx, gy|:
                a: f64 = k.f64() * Glove::PI / 12.0
                glove.points[k.usize()] <- v(gx + r * Glove::cosine(a), gy + r * Glove::sine(a), 0.0)
            glove.count <- 24
            b: i64 = Glove::ball(run)
            at: f64[3] = Glove::ball_point(run, b) if b >= 0 else [0.0, 0.0, 0.0]
            glove_far: f64 = sqrt(Glove::psum3((gx - e[0]) * (gx - e[0]), (gy - e[1]) * (gy - e[1]), (0.0 - e[2]) * (0.0 - e[2])))
            ball_far: f64 = sqrt(Glove::psum3((at[0] - e[0]) * (at[0] - e[0]), (at[1] - e[1]) * (at[1] - e[1]),
                (at[2] - e[2]) * (at[2] - e[2])))
            if b >= 0:
                SceneLens::ball(list, cut, &camera, v(at[0], 0.01, at[2]), 0.05, 0x325a32ff, 0.0)
            # sorted by distance, far first; the glove first on a tie
            ball_first: bool = b >= 0 and ball_far > glove_far
            if ball_first:
                SceneLens::ball(list, cut, &camera, v(at[0], at[1], at[2]), 0.075, 0xfafaf5ff)
            ink: mutable u32 = 0xe1a05096
            if run.flashed and run.t - run.flash_t < 0.4:
                ink <- 0x5adc6ec8 if run.flash_got else 0xe65046c8
            SceneLens::face(list, cut, &camera, &glove, ink)
            for k in 0..<24 |list, cut, camera, glove|:
                SceneLens::seg(list, cut, &camera, glove.points[k.usize()], glove.points[((k + 1) % 24).usize()], 3.0, 0x5a2d0fff)
            pocket: mutable SceneLens::Solid = zeroed
            for k in 0..<16 |pocket, r, gx, gy|:
                a: f64 = k.f64() * Glove::PI / 8.0
                pocket.points[k.usize()] <- v(gx + 0.45 * r * Glove::cosine(a), gy + 0.45 * r * Glove::sine(a), -0.01)
            pocket.count <- 16
            SceneLens::face(list, cut, &camera, &pocket, 0x6e3c1996)
            if b >= 0 and not ball_first:
                SceneLens::ball(list, cut, &camera, v(at[0], at[1], at[2]), 0.075, 0xfafaf5ff)
            words: mutable dstr = []
            dstr_append_cstr(&words, "caught ")
            dstr_append_i64(&words, run.caught)
            dstr_append_cstr(&words, "   missed ")
            dstr_append_i64(&words, run.missed)
            Display::draw_text_weight(list, bytes_view(words), LEFT + LiveView::VIEW_WIDTH / 2.0, bottom() + 18.0, 13.0, 0xffffffff,
                Display::ANCHOR_CENTER_CENTER, false)

    def card(list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            frame: SceneLens::Clip = clip()
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: frame.x0 - 4.0, y: frame.y0 - 4.0,
                w: frame.x1 - frame.x0 + 8.0, h: frame.y1 - frame.y0 + 8.0}
            shades: u32[3] = [30.u32(), 18.u32(), 12.u32()]
            for i in 0..<3 |list, box, shades|:
                blur: f64 = i.f64() * 2.0
                shadow: SceneHiddenRule::Rect = ScenePolish::spread_box(&box, blur, 4.0)
                ScenePolish::rounded(list, &shadow, 14.0 + blur, shades[i.usize()])
            ScenePolish::rounded(list, &box, 14.0, 0x8cbee6ff)

    def verdict_text(run: Glove::Run&, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.result == Glove::MISSED:
                dstr_append_cstr(words, "Missed ")
                dstr_append_i64(words, run.missed)
            elif run.result == Glove::CAUGHT:
                dstr_append_cstr(words, "Caught ")
                dstr_append_i64(words, run.caught)
                dstr_append_cstr(words, " of ")
                dstr_append_i64(words, run.game.level.pitches)

    def render(list: mutable Display::DisplayList&, session: GloveGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            run: Glove::Run& = &session.run
            label(list, "Glove", 648.0, 22.0, ink, true)
            label(list, "Mouse or arrows: move the glove   Esc: menu", 26.0, 12.0, ink)
            caption: mutable dstr = []
            verdict_text(run, &caption)
            status: mutable dstr = []
            if session.phase == GloveGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == GloveGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == GloveGame::JUDGED:
                status <- caption
            else:
                dstr_append_cstr(&status, "Catch the pitches")
            label(list, bytes_view(status), 614.0, 14.0, ink)
            if session.phase == GloveGame::PLAYING or session.phase == GloveGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   pitch ")
                count: i64 = run.game.level.pitches
                dstr_append_i64(&facts, count if count < run.next + 1 else run.next + 1)
                dstr_append_cstr(&facts, " of ")
                dstr_append_i64(&facts, count)
                label(list, bytes_view(facts), 588.0, 12.0, ink)
                card(list)
                view(list, run)
            if session.phase == GloveGame::JUDGED or session.phase == GloveGame::DONE:
                SceneVerdict::put(list, LiveView::WIDTH, LiveView::HEIGHT, 1.0, 1.0, run.result == Glove::CAUGHT,
                    bytes_view(caption), 60.0, 16.0)

    # taskoptions.glove_note.
    def option_note(rung: i64, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Glove::Grade = Glove::grade(rung)
            dstr_append_cstr(words, "Rung ")
            dstr_append_i64(words, level.rung)
            dstr_append_cstr(words, ": ")
            dstr_append_i64(words, level.pitches)
            dstr_append_cstr(words, " pitches at ")
            dstr_append_fixed(words, py_round_decimal(level.speed, 1.0), 0)
            dstr_append_cstr(words, " m/s.")
            if level.cut != 0.0:
                dstr_append_cstr(words, "  A cut about every ")
                dstr_append_fixed(words, py_round_decimal(level.cut, 10.0), 1)
                dstr_append_cstr(words, " s.")
            elif level.per_pitch:
                dstr_append_cstr(words, "  A new angle each pitch.")
