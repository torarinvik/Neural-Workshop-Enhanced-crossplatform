include "tasks/hidden_wiring_game.elisa"
include "scene_hidden_rule.elisa"

module SceneHiddenWiring:
    const LEFT: f64 = 36.48
    const BOTTOM: f64 = 179.0
    const HEIGHT: f64 = 389.0
    const PANEL: f64 = 419.52
    const NOTE_X: f64 = 481.1712
    const NOTE_WIDTH: f64 = 394.3488

    def marked(bits: i64, index: i64) -> bool:
        return (bits & (1 << index.u64())) != 0

    def switch_color(on: bool, dark: bool) -> u32:
        return Display::rgba(60, 150, 90, 255) if on else SceneHiddenRule::blank(dark)

    def lamp(list: mutable Display::DisplayList&, x: f64, y: f64, radius: f64, lit: bool, dark: bool, target: bool = false):
        can Memory.Allocate, Abort.Panic:
            color: u32 = Display::rgba(250, 204, 60, 255) if lit else (Display::rgba(70, 74, 82, 255) if dark else Display::rgba(196, 200, 208, 255))
            Display::draw_circle(list, x, y, radius, color)
            if target:
                Display::draw_arc(list, x, y, radius * 1.25, 0.0, 360.0, Display::rgba(40, 90, 220, 255))

    def switch_box(count: i64, index: i64) -> SceneHiddenRule::Rect:
        side: f64 = SceneHiddenRule::minimum(PANEL / (count.f64() * 1.35), HEIGHT * 0.16)
        return SceneHiddenRule::Rect{x: LEFT + (PANEL - count.f64() * side * 1.3) / 2.0 + index.f64() * side * 1.3,
            y: BOTTOM + HEIGHT * 0.32, w: side, h: side * 1.4}

    def control(port: i64) -> SceneHiddenRule::Rect:
        share: f64 = 0.15 if port == HiddenWiringGame::LOOK else (0.55 if port == HiddenWiringGame::EXAM else 0.35)
        return SceneHiddenRule::Rect{x: LEFT + PANEL * share, y: BOTTOM + HEIGHT * 0.04, w: PANEL * 0.3, h: HEIGHT * 0.11}

    def hit(run: HiddenWiringGame::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return HiddenWiringGame::START if run.phase == HiddenWiringGame::READY or run.phase == HiddenWiringGame::DONE
            return -1 if run.phase != HiddenWiringGame::LOOKING and run.phase != HiddenWiringGame::EXAMINING
            for index in 0..<run.level.switches |index, run, x, y|:
                box: SceneHiddenRule::Rect = switch_box(run.level.switches, index)
                return index if SceneHiddenRule::contains(&box, x, y)
            if run.phase == HiddenWiringGame::LOOKING:
                look: SceneHiddenRule::Rect = control(HiddenWiringGame::LOOK)
                exam: SceneHiddenRule::Rect = control(HiddenWiringGame::EXAM)
                return HiddenWiringGame::LOOK if SceneHiddenRule::contains(&look, x, y)
                return HiddenWiringGame::EXAM if SceneHiddenRule::contains(&exam, x, y)
            else:
                answer: SceneHiddenRule::Rect = control(HiddenWiringGame::ANSWER)
                return HiddenWiringGame::ANSWER if SceneHiddenRule::contains(&answer, x, y)
            return -1

    def click(run: mutable HiddenWiringGame::Run&, x: f64, y: f64, now_ms: i64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic:
            port: i64 = hit(run, x, y)
            return HiddenWiringGame::start(run) if port == HiddenWiringGame::START
            return HiddenWiringGame::steer(run, port, now_ms)

    def letter(index: i64) -> cstr:
        return "A" if index == 0
        return "B" if index == 1
        return "C" if index == 2
        return "D" if index == 3
        return "E" if index == 4
        return "F"

    def describe(gate: HiddenWiring::Gate, label: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if gate.kind == HiddenWiring::MAJORITY:
                dstr_append_cstr(label, "two of ")
            joiner: cstr = " and " if gate.kind == HiddenWiring::AND else (" or " if gate.kind == HiddenWiring::OR else (" xor " if gate.kind == HiddenWiring::XOR else ", "))
            for index in 0..<gate.rank |index, gate, joiner, label|:
                if index > 0:
                    dstr_append_cstr(label, joiner)
                if marked(gate.flipped, index):
                    dstr_append_cstr(label, "not ")
                input: i64 = gate.a if index == 0 else (gate.b if index == 1 else gate.c)
                dstr_append_i64(label, input + 1)

    def notebook(list: mutable Display::DisplayList&, run: HiddenWiringGame::Run&, dark: bool, ink: u32):
        can Memory.Allocate, Abort.Panic:
            top: f64 = BOTTOM + HEIGHT
            SceneHiddenRule::text(list, "notebook: switches   lamps", NOTE_X, top - 12.0, 11.0, ink, Display::ANCHOR_LEFT_CENTER)
            rows: i64 = (HiddenWiring::budget(&run.level) + 1) / 2
            row: f64 = SceneHiddenRule::minimum((HEIGHT - 30.0) / rows.f64(), 40.0)
            columns: f64 = (run.level.switches.f64() * 1.05 + run.level.lamps.f64() * 1.1 + 1.0)
            cell: f64 = SceneHiddenRule::minimum(row * 0.7, NOTE_WIDTH * 0.5 / columns)
            for index in 0..<run.round.looks |index, run, list, dark, top, rows, row, cell|:
                x: f64 = NOTE_X + (index / rows).f64() * NOTE_WIDTH / 2.0
                y: f64 = top - 30.0 - (index % rows + 1).f64() * row
                setting: i64 = run.round.settings[index.usize()]
                reading: i64 = run.round.readings[index.usize()]
                for switch in 0..<run.level.switches |switch, list, dark, setting, x, y, cell|:
                    Display::draw_rect(list, x + switch.f64() * cell * 1.05, y, cell, cell, switch_color(marked(setting, switch), dark))
                start: f64 = x + run.level.switches.f64() * cell * 1.05 + cell
                for bulb in 0..<run.level.lamps |bulb, list, dark, reading, start, y, cell|:
                    lamp(list, start + bulb.f64() * cell * 1.1 + cell / 2.0, y + cell / 2.0, cell * 0.42, marked(reading, bulb), dark)

    def panel(list: mutable Display::DisplayList&, run: HiddenWiringGame::Run&, dark: bool, ink: u32):
        can Memory.Allocate, Abort.Panic:
            lamps: i64 = run.level.lamps
            radius: f64 = SceneHiddenRule::minimum(PANEL / (lamps.f64() * 3.2), HEIGHT * 0.08)
            lamp_y: f64 = BOTTOM + HEIGHT * 0.78
            exam: bool = run.phase == HiddenWiringGame::EXAMINING
            pattern: i64 = HiddenWiring::question(&run.round, &run.dealt) if exam else (run.round.readings[(run.round.looks - 1).usize()] if run.round.looks > 0 else 0)
            for index in 0..<lamps |index, list, lamps, radius, lamp_y, pattern, exam, dark, ink|:
                x: f64 = LEFT + PANEL * (index.f64() + 0.5) / lamps.f64()
                lit: bool = marked(pattern, index)
                lamp(list, x, lamp_y, radius, lit, dark, exam)
                if exam:
                    SceneHiddenRule::text(list, "lit" if lit else "dark", x, lamp_y - radius * 1.8, radius * 0.45, ink, Display::ANCHOR_CENTER_CENTER, true)
                SceneHiddenRule::text(list, sview(letter(index), 0, -1), x, lamp_y + radius * 1.7, radius * 0.5, ink, Display::ANCHOR_CENTER_CENTER, true)
            label: mutable dstr = []
            if exam:
                dstr_append_cstr(&label, "question ")
                dstr_append_i64(&label, run.round.answered + 1)
                dstr_append_cstr(&label, " of ")
                dstr_append_i64(&label, run.dealt.questions)
                dstr_append_cstr(&label, ": make this pattern")
            elif run.round.looks > 0:
                dstr_append_cstr(&label, "last look")
            SceneHiddenRule::text(list, bytes_view(label), LEFT + PANEL / 2.0, lamp_y + radius * 2.6, radius * 0.42, ink)
            for index in 0..<run.level.switches |index, list, run, dark, ink|:
                box: SceneHiddenRule::Rect = switch_box(run.level.switches, index)
                on: bool = marked(run.setting, index)
                SceneHiddenRule::card(list, &box, switch_color(on, dark), ink)
                SceneHiddenRule::text(list, "on" if on else "off", box.x + box.w / 2.0, box.y + box.h / 2.0,
                    box.w * 0.25, ink, Display::ANCHOR_CENTER_CENTER, true)
                number: mutable dstr = []
                dstr_append_i64(&number, index + 1)
                SceneHiddenRule::text(list, bytes_view(number), box.x + box.w / 2.0, box.y - box.w * 0.3, box.w * 0.28, ink)
            if run.phase == HiddenWiringGame::JUDGED:
                for index in 0..<lamps |index, list, run, ink|:
                    reveal: mutable dstr = []
                    dstr_append_cstr(&reveal, letter(index))
                    dstr_append_cstr(&reveal, " = ")
                    describe(run.dealt.gates[index.usize()], &reveal)
                    x: f64 = LEFT + PANEL * (0.25 + (index % 2).f64() * 0.5)
                    SceneHiddenRule::text(list, bytes_view(reveal), x, BOTTOM + 78.0 - (index / 2).f64() * 19.0, 12.0, ink,
                        Display::ANCHOR_CENTER_CENTER, true)
            elif exam:
                answer: SceneHiddenRule::Rect = control(HiddenWiringGame::ANSWER)
                SceneHiddenRule::button(list, &answer, "Answer (Enter)", SceneHiddenRule::blank(dark), ink)
            else:
                look: SceneHiddenRule::Rect = control(HiddenWiringGame::LOOK)
                exam_box: SceneHiddenRule::Rect = control(HiddenWiringGame::EXAM)
                SceneHiddenRule::button(list, &look, "Look (L)", SceneHiddenRule::blank(dark), ink)
                SceneHiddenRule::button(list, &exam_box, "Exam (E)", SceneHiddenRule::blank(dark), ink)

    def status(label: mutable dstr&, run: HiddenWiringGame::Run&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == HiddenWiringGame::READY:
                dstr_append_cstr(label, "Press Space or click to start")
            elif run.phase == HiddenWiringGame::LOOKING:
                dstr_append_cstr(label, "Learn the wiring for ")
                SceneHiddenRule::points(label, run.par)
                dstr_append_cstr(label, " or less")
            elif run.phase == HiddenWiringGame::EXAMINING:
                dstr_append_cstr(label, "Set the switches for the pattern, then Answer")
            elif run.phase == HiddenWiringGame::JUDGED:
                dstr_append_i64(label, run.round.looks)
                dstr_append_cstr(label, " looks, ")
                dstr_append_i64(label, run.round.wrong)
                dstr_append_cstr(label, " wrong: cost ")
                dstr_append_i64(label, HiddenWiring::cost(&run.round, &run.level))
                dstr_append_cstr(label, " against a par of ")
                SceneHiddenRule::points(label, run.par)
            else:
                dstr_append_i64(label, run.passed_count)
                dstr_append_cstr(label, " of ")
                dstr_append_i64(label, run.answered)
                dstr_append_cstr(label, " under par   highest rung passed ")
                dstr_append_i64(label, run.best_rung)

    def render(list: mutable Display::DisplayList&, run: HiddenWiringGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = Display::rgba(255, 255, 255, 255) if dark else Display::rgba(0, 0, 0, 255)
            SceneHiddenRule::text(list, "Hidden Wiring", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            message: mutable dstr = []
            status(&message, run)
            SceneHiddenRule::text(list, bytes_view(message), 456.0, 614.0, 14.0, ink)
            idle: bool = run.phase == HiddenWiringGame::READY or run.phase == HiddenWiringGame::DONE
            footnote: sview = "Space: start   C: options   Esc: menu" if idle else "Click a switch   L: look   E: exam   Enter: answer   Esc: menu"
            SceneHiddenRule::text(list, footnote, 456.0, 26.0, 12.0, ink)
            return if run.phase == HiddenWiringGame::READY or run.phase == HiddenWiringGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, run.level.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, run.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, run.trials)
            dstr_append_cstr(&facts, "  looks ")
            dstr_append_i64(&facts, run.round.looks)
            dstr_append_cstr(&facts, " (")
            dstr_append_i64(&facts, HiddenWiring::budget(&run.level) - run.round.looks)
            dstr_append_cstr(&facts, " left)  wrong answer ")
            dstr_append_i64(&facts, run.level.penalty)
            if run.level.noise > 0.0:
                dstr_append_cstr(&facts, "  a lamp lies on ")
                dstr_append_fixed(&facts, run.level.noise * 100.0, 0)
                dstr_append_cstr(&facts, "% of looks")
            SceneHiddenRule::text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink)
            panel(list, run, dark, ink)
            notebook(list, run, dark, ink)
            if run.phase == HiddenWiringGame::JUDGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.passed, bytes_view(message), 60.0, 16.0)
