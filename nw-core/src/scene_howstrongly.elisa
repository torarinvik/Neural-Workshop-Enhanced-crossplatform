include "./tasks/howstrongly_game.elisa"
include "./scene_reading_quiz.elisa"

module SceneHowStrongly:
    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            g: HowStrongly::Grade = HowStrongly::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, g.rung)
            if g.strongest:
                dstr_append_cstr(out, ": which emotion is strongest.")
            else:
                dstr_append_cstr(out, ": within ")
                dstr_append_i64(out, g.tolerance.i64())
                dstr_append_cstr(out, " points of the reference.")

    def verdict(run: ReadingQuiz::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_i64(out, run.right)
            dstr_append_cstr(out, " of ")
            dstr_append_i64(out, run.round.items.count.i64())
            dstr_append_cstr(out, " right")
            if run.result == ReadingQuiz::FAILED:
                dstr_append_cstr(out, ", ")
                dstr_append_i64(out, run.round.need)
                dstr_append_cstr(out, " needed")

    def render(list: mutable Display::DisplayList&, session: HowStronglyGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            SceneMissingWord::label(list, "How Strongly", 648.0, 22.0, ink, true)
            SceneMissingWord::label(list, "Click an answer or press its number", 26.0, 12.0, ink)
            message: mutable dstr = []
            if session.phase == HowStronglyGame::READY:
                dstr_append_cstr(&message, "Press Space or click to start")
            elif session.phase == HowStronglyGame::DONE:
                dstr_append_i64(&message, session.wins)
                dstr_append_cstr(&message, " of ")
                dstr_append_i64(&message, session.trial)
                dstr_append_cstr(&message, " passed   highest rung passed ")
                dstr_append_i64(&message, session.best_rung)
            elif session.phase == HowStronglyGame::JUDGED:
                verdict(&session.run, &message)
            else:
                dstr_append_cstr(&message, "How strongly does the character feel each emotion?")
            SceneMissingWord::label(list, bytes_view(message), 614.0, 14.0, ink)
            if session.phase == HowStronglyGame::PLAYING or session.phase == HowStronglyGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                SceneMissingWord::label(list, bytes_view(facts), 588.0, 12.0, ink)
                SceneHand::card(list, 0x2c3040ff)
                SceneReadingQuiz::page(list, &session.run)
                SceneHand::progress(list, &session.hand, 0.0)
            if session.phase == HowStronglyGame::JUDGED or session.phase == HowStronglyGame::DONE:
                last: mutable dstr = []
                verdict(&session.run, &last)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.run.result == ReadingQuiz::PASSED,
                    bytes_view(last), 60.0, 16.0)
