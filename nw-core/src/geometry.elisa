# Reference-window scaling: where a widget goes in the window it actually has.
#
# Port of the reference-window scaling half of neural_workshop/geometry.py
# (GPL-2.0-or-later). Everything is laid out against a 912x684 reference
# window, and these scale that to the real one.
#
# The reference reads the live window through `_width()`/`_height()`, which go
# through `pixel_size()` -- the FRAMEBUFFER size, not the point size, so a
# Retina window scales by its pixels. Nothing here can reach a window, so every
# function takes the pixel size it is scaling against.
#
# Each of these truncates to an int, and `int()` truncates TOWARD ZERO rather
# than flooring. Only `from_height_center` and `from_width_center` can be handed
# a negative, and they are the two where the difference shows.

module Geometry:

    const DEFAULT_WINDOW_WIDTH: f64 = 912.0
    const DEFAULT_WINDOW_HEIGHT: f64 = 684.0

    # Past this the glyphs no longer fit pyglet's texture atlas, and the
    # failure lands inside label creation rather than at the window size that
    # caused it.
    const MAX_FONT_SIZE: f64 = 200.0

    def from_width_center(width: f64, offset: f64) -> i64:
        can Abort.Panic:
            return (width / 2.0 + offset * (width / DEFAULT_WINDOW_WIDTH)).i64()

    def from_height_center(height: f64, offset: f64) -> i64:
        can Abort.Panic:
            return (height / 2.0 + offset * (height / DEFAULT_WINDOW_HEIGHT)).i64()

    def width_center(width: f64) -> i64:
        can Abort.Panic:
            return (width / 2.0).i64()

    def height_center(height: f64) -> i64:
        can Abort.Panic:
            return (height / 2.0).i64()

    def from_top_edge(height: f64, from_edge: f64) -> i64:
        can Abort.Panic:
            return (height - from_edge * height / DEFAULT_WINDOW_HEIGHT).i64()

    def from_bottom_edge(height: f64, from_edge: f64) -> i64:
        can Abort.Panic:
            return (from_edge * (height / DEFAULT_WINDOW_HEIGHT)).i64()

    def from_right_edge(width: f64, from_edge: f64) -> i64:
        can Abort.Panic:
            return (width - from_edge * width / DEFAULT_WINDOW_WIDTH).i64()

    def from_left_edge(width: f64, from_edge: f64) -> i64:
        can Abort.Panic:
            return (from_edge * width / DEFAULT_WINDOW_WIDTH).i64()

    def scale_to_width(width: f64, fraction: f64) -> i64:
        can Abort.Panic:
            return (fraction * width / DEFAULT_WINDOW_WIDTH).i64()

    def scale_to_height(height: f64, fraction: f64) -> i64:
        can Abort.Panic:
            return (fraction * height / DEFAULT_WINDOW_HEIGHT).i64()

    def calc_fontsize(height: f64, size: f64) -> f64:
        can Abort.Panic:
            scaled: f64 = size * (height / DEFAULT_WINDOW_HEIGHT)
            return MAX_FONT_SIZE if scaled > MAX_FONT_SIZE else scaled

    # The reference's default `size` is 100; the caller passes it.
    def calc_dpi(width: f64, height: f64, size: i64) -> i64:
        can Abort.Panic:
            return (size.f64() * ((width + height) / (DEFAULT_WINDOW_WIDTH + DEFAULT_WINDOW_HEIGHT))).i64()
