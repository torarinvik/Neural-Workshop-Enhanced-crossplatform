include "./tasks/freekick_game.elisa"
include "./scene_live_view.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"
include "./scene_lens.elisa"

# ui/freekick.py: from behind the ball, toward the goal. The lit ring hangs in
# the goal mouth; on the low rungs a dotted line shows where the kick as set
# would go. The dials along the bottom show the kick's direction, height,
# curl and power. A flag by the goal shows the wind.
module SceneFreeKick:
    const LEFT: f64 = (LiveView::WIDTH - LiveView::VIEW_WIDTH) / 2.0

    def bottom() -> f64:
        can Abort.Panic:
            return Verdict::above_the_band(LiveView::HEIGHT, Geometry::from_bottom_edge(LiveView::HEIGHT, 58.0).f64()).f64()

    def height() -> f64:
        can Abort.Panic:
            return fmax(40.0, Geometry::from_top_edge(LiveView::HEIGHT, 116.0).f64() - bottom())

    def label(list: mutable Display::DisplayList&, text: sview, y: f64, size: f64, ink: u32, bold: bool = false):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, LiveView::CX, y, size, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def clip() -> SceneLens::Clip:
        can Abort.Panic:
            b: f64 = bottom()
            return SceneLens::Clip{x0: LEFT, y0: b, x1: LEFT + LiveView::VIEW_WIDTH, y1: b + height()}

    def v(x: f64, y: f64, z: f64) -> SceneLens::Vec:
        return SceneLens::vec(x, y, z)

    def quad(list: mutable Display::DisplayList&, cut: SceneLens::Clip, lens: SceneLens::Lens&, a: SceneLens::Vec,
             b: SceneLens::Vec, c: SceneLens::Vec, d: SceneLens::Vec, ink: u32):
        can Memory.Allocate, Abort.Panic:
            shape: SceneLens::Solid = SceneLens::quad(a, b, c, d)
            SceneLens::face(list, cut, lens, &shape, ink)

    # FreeKick._draw, without the frame's card.
    def view(list: mutable Display::DisplayList&, run: FreeKick::Run&):
        can Memory.Allocate, Abort.Panic:
            p: FreeKick::Pitch& = &run.pitch
            left: f64 = LEFT
            low: f64 = bottom()
            width: f64 = LiveView::VIEW_WIDTH
            tall: f64 = height()
            cut: SceneLens::Clip = clip()
            sx: f64 = p.spot_x
            sz: f64 = p.spot_z
            eye: SceneLens::Vec = v(sx * 0.85, 2.4, sz + 7.0)
            aim: SceneLens::Vec = v(p.goal_x * 0.5 + sx * 0.5, 0.0, sz * 0.45)
            lens: SceneLens::Lens = SceneLens::camera(eye, SceneLens::sub(aim, eye), left, low + 40.0, width, tall - 40.0,
                52.0, false)
            # the grass, in stripes, far to near
            for k in -2..<16 |list, cut, lens|:
                z0: f64 = k.f64() * 2.5
                z1: f64 = (k + 1).f64() * 2.5
                quad(list, cut, &lens, v(-30.0, 0.0, z0), v(30.0, 0.0, z0), v(30.0, 0.0, z1), v(-30.0, 0.0, z1),
                    0x469646ff if k % 2 != 0 else 0x3e8a3eff)
            marks: f64[42] = [-20.16, 0.01, 0.0, 20.16, 0.01, 0.0,
                -20.16, 0.01, 0.0, -20.16, 0.01, 16.5,
                20.16, 0.01, 0.0, 20.16, 0.01, 16.5,
                -20.16, 0.01, 16.5, 20.16, 0.01, 16.5,
                -9.16, 0.01, 0.0, -9.16, 0.01, 5.5,
                9.16, 0.01, 0.0, 9.16, 0.01, 5.5,
                -9.16, 0.01, 5.5, 9.16, 0.01, 5.5]
            for i in 0..<7 |list, cut, lens, marks|:
                o: usize = (6 * i).usize()
                SceneLens::seg(list, cut, &lens, v(marks[o], marks[o + 1], marks[o + 2]),
                    v(marks[o + 3], marks[o + 4], marks[o + 5]), 2.0, 0xe6f0e6ff)
            # the net and the goal
            gx: f64 = p.goal_x
            w2: f64 = FreeKick::WIDE / 2.0
            hh: f64 = FreeKick::HIGH
            quad(list, cut, &lens, v(gx - w2, 0.0, -2.0), v(gx + w2, 0.0, -2.0), v(gx + w2, hh, -1.2), v(gx - w2, hh, -1.2),
                0xc8cdd2ff)
            for k in 0..<15 |list, cut, lens, gx, w2, hh|:
                x: f64 = gx - w2 + k.f64() * FreeKick::WIDE / 14.0
                SceneLens::seg(list, cut, &lens, v(x, 0.0, -2.0), v(x, hh, -1.2), 1.0, 0xaaafb4ff)
            ring: mutable SceneLens::Solid = zeroed
            for k in 0..<32 |p, ring|:
                a: f64 = k.f64() * FreeKick::PI / 16.0
                ring.points[k.usize()] <- v(p.ring_x + p.ring_r * FreeKick::cosine(a), p.ring_y + p.ring_r * FreeKick::sine(a), -0.02)
            ring.count <- 32
            SceneLens::face(list, cut, &lens, &ring, 0xffe65aff)
            SceneLens::seg(list, cut, &lens, v(gx - w2, 0.0, 0.0), v(gx - w2, hh, 0.0), 5.0, 0xfafafaff)
            SceneLens::seg(list, cut, &lens, v(gx + w2, 0.0, 0.0), v(gx + w2, hh, 0.0), 5.0, 0xfafafaff)
            SceneLens::seg(list, cut, &lens, v(gx - w2, hh, 0.0), v(gx + w2, hh, 0.0), 5.0, 0xfafafaff)
            # the keeper
            if p.level.keeper != 0.0:
                kx: f64 = FreeKick::keeper_x(run)
                SceneLens::box(list, cut, &lens, kx - 0.3, 0.0, -0.3, kx + 0.3, 1.6, 0.0, 0x3c3c46ff)
                SceneLens::ball(list, cut, &lens, v(kx, 1.8, -0.15), 0.14, 0xe6bea0ff)
                SceneLens::seg(list, cut, &lens, v(kx - 0.3, 1.35, -0.1), v(kx - 0.9, 1.9, -0.1), 4.0, 0xf07828ff)
                SceneLens::seg(list, cut, &lens, v(kx + 0.3, 1.35, -0.1), v(kx + 0.9, 1.9, -0.1), 4.0, 0xf07828ff)
            # the wall
            if p.level.wall != 0:
                up: f64 = p.level.jump if run.struck and run.t - run.kicked < 0.8 else 0.0
                n: i64 = p.level.wall
                for k in 0..<n |list, cut, lens, p, up, n|:
                    x0: f64 = p.wall_x - p.wall_w + (k * 2).f64() * p.wall_w / n.f64()
                    SceneLens::box(list, cut, &lens, x0 + 0.03, up, p.wall_z - 0.25, x0 + 2.0 * p.wall_w / n.f64() - 0.03,
                        up + 1.65, p.wall_z, 0xc82832ff)
                    SceneLens::ball(list, cut, &lens, v(x0 + p.wall_w / n.f64(), up + 1.8, p.wall_z - 0.12), 0.13, 0xe6bea0ff)
            # the wind's flag by the corner of the goal
            if p.level.wind != 0.0:
                fx: f64 = gx + w2 + 3.0
                fz: f64 = 0.0
                SceneLens::seg(list, cut, &lens, v(fx, 0.0, fz), v(fx, 3.2, fz), 2.0, 0xf0f0f0ff)
                s: f64 = py_hypot(p.wind_x, p.wind_z)
                ux: f64 = p.wind_x / s
                uz: f64 = p.wind_z / s
                n: f64 = 0.25 + 0.2 * s
                flag: mutable SceneLens::Solid = zeroed
                flag.points[0] <- v(fx, 3.2, fz)
                flag.points[1] <- v(fx + ux * n, 3.0, fz + uz * n)
                flag.points[2] <- v(fx, 2.8, fz)
                flag.count <- 3
                SceneLens::face(list, cut, &lens, &flag, 0xf0463cff)
            # the flight, drawn on the low rungs
            if p.level.guide and not run.struck:
                path: mutable darray[FreeKick::Point] = []
                _ = FreeKick::fly(p, run.kick, true, true, &path)
                i: mutable i64 = 0
                while i < path.count.i64() |list, cut, lens, path, i|:
                    at: FreeKick::Point = path[i.usize()]
                    SceneLens::ball(list, cut, &lens, v(at.x, at.y, at.z), 0.05, 0xffffffff, 0.0)
                    i <- i + 6
            at: FreeKick::Point = FreeKick::ball(run)
            SceneLens::ball(list, cut, &lens, v(at.x, 0.01, at.z), 0.1, 0x285a28ff, 0.0)
            SceneLens::ball(list, cut, &lens, v(at.x, at.y, at.z), FreeKick::BALL, 0xfafafaff)
            dials(list, run, left, low, width)

    # FreeKick._dials: aim, height, curl (drawn the other way) and power,
    # each a track with a knob where the dial stands between its limits.
    def dials(list: mutable Display::DisplayList&, run: FreeKick::Run&, left: f64, low: f64, width: f64):
        can Memory.Allocate, Abort.Panic:
            cut: SceneLens::Clip = clip()
            k: FreeKick::Kick = run.kick
            values: f64[4] = [k.aim, k.lift, -k.curl, k.power]
            lows: f64[4] = [-35.0, 0.0, -14.0, 8.0]
            highs: f64[4] = [35.0, 40.0, 14.0, 34.0]
            w: f64 = (width - 60.0) / 4.0
            for i in 0..<4 |list, cut, values, lows, highs, w, left, low|:
                x: f64 = left + 20.0 + i.f64() * (w + 7.0)
                SceneLens::rect(list, cut, x, low + 8.0, w, 12.0, 0x142819ff)
                u: f64 = (values[i.usize()] - lows[i.usize()]) / (highs[i.usize()] - lows[i.usize()])
                SceneLens::rect(list, cut, x + w * u - 3.0, low + 5.0, 6.0, 18.0, 0xfae678ff)
                name: sview = "aim" if i == 0 else ("height" if i == 1 else ("curl" if i == 2 else "power"))
                Display::draw_text_weight(list, name, x + w / 2.0, low + 32.0, 11.0, 0xe6f5e6ff, Display::ANCHOR_CENTER_CENTER,
                    false)

    def card(list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            frame: SceneLens::Clip = clip()
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: frame.x0 - 4.0, y: frame.y0 - 4.0,
                w: frame.x1 - frame.x0 + 8.0, h: frame.y1 - frame.y0 + 8.0}
            shades: u32[3] = [30.u32(), 18.u32(), 12.u32()]
            for i in 0..<3 |list, box, shades|:
                blur: f64 = i.f64() * 2.0
                shadow: SceneHiddenRule::Rect = ScenePolish::spread_box(&box, blur, 4.0)
                ScenePolish::rounded(list, &shadow, 14.0 + blur, shades[i.usize()])
            ScenePolish::rounded(list, &box, 14.0, 0x78aadcff)

    def verdict_text(run: FreeKick::Run&, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            r: i64 = run.result
            if r == FreeKick::IN_RING:
                dstr_append_cstr(words, "In the ring")
            elif r == FreeKick::INTO_WALL:
                dstr_append_cstr(words, "Into the wall")
            elif r == FreeKick::FELL_SHORT:
                dstr_append_cstr(words, "Fell short")
            elif r == FreeKick::WIDE_OF_GOAL:
                dstr_append_cstr(words, "Wide of the goal")
            elif r == FreeKick::OVER_BAR:
                dstr_append_cstr(words, "Over the bar")
            elif r == FreeKick::SAVED:
                dstr_append_cstr(words, "Saved")
            elif r == FreeKick::OFF_RING:
                dstr_append_cstr(words, "In the goal, but ")
                dstr_append_fixed(words, py_round_decimal(run.miss, 10.0), 1)
                dstr_append_cstr(words, " m from the ring")
            elif r == FreeKick::OUT_OF_TIME:
                dstr_append_cstr(words, "Out of time")

    def render(list: mutable Display::DisplayList&, session: FreeKickGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            run: FreeKick::Run& = &session.run
            label(list, "Free Kick", 648.0, 22.0, ink, true)
            label(list, "Left / Right: aim   Up / Down: height   A / D: curl   W / S: power   Space: kick   Esc: menu",
                26.0, 12.0, ink)
            caption: mutable dstr = []
            verdict_text(run, &caption)
            status: mutable dstr = []
            if session.phase == FreeKickGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == FreeKickGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == FreeKickGame::JUDGED:
                status <- caption
            else:
                dstr_append_cstr(&status, "Kick it into the lit ring")
            label(list, bytes_view(status), 614.0, 14.0, ink)
            if session.phase == FreeKickGame::PLAYING or session.phase == FreeKickGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                label(list, bytes_view(facts), 588.0, 12.0, ink)
                card(list)
                view(list, run)
            if session.phase == FreeKickGame::JUDGED or session.phase == FreeKickGame::DONE:
                SceneVerdict::put(list, LiveView::WIDTH, LiveView::HEIGHT, 1.0, 1.0, run.result == FreeKick::IN_RING,
                    bytes_view(caption), 60.0, 16.0)

    # taskoptions.freekick_note.
    def option_note(rung: i64, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: FreeKick::Grade = FreeKick::grade(rung)
            dstr_append_cstr(words, "Rung ")
            dstr_append_i64(words, level.rung)
            dstr_append_cstr(words, ": a ring of ")
            dstr_append_fixed(words, py_round_decimal(level.ring, 100.0), 2)
            dstr_append_cstr(words, " m.")
            dstr_append_cstr(words, "  The flight is drawn.") if level.guide
            dstr_append_cstr(words, "  A wall and a keeper.") if level.wall != 0
            dstr_append_cstr(words, "  Wind.") if level.wind != 0.0
