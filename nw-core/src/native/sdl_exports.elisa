export fn nw_sdl_screen_create(screen: i64, options: i64&?, lexicon: u8&?, index: u8&?, sentences: u8&?) -> i64 = sdl_screen_create

# Initialize a direct screen in the shared handle/mode rows. Return -1 on
# controller creation failure, 1 when SDL text input should start, else 0.
def sdl_start_screen_seeded(screen: i64, rows: usize&?, options: i64&?, lexicon: u8&?, index: u8&?, sentences: u8&?, seed: i64, requested_trials: i64, adaptive: i64) -> i32:
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return 0.i32() if screen < 2 or screen > 139 or screen == 75
        return -1.i32() if rows == null
        trusted Unsafe.PointerCast:
            table: usize& = rows
            row: usize = (screen - 4 if screen >= 76 else (screen - 3 if screen >= 46 else (21 if screen == 45 else (26 if screen == 27 else (25 if screen == 28 else screen - 2))))).usize()
            base: usize = row * 2.usize()
            return -1.i32() if table[base] == 0.usize() or table[base + 1.usize()] == 0.usize()
            handle: mutable i64& = table[base].cast[mutable i64&]
            mode: mutable u8& = table[base + 1.usize()].cast[mutable u8&]
            if screen == 4 or screen == 5 or (screen >= 7 and screen <= 19) or (screen >= 23 and screen <= 26) or (screen >= 30 and screen <= 74) or (screen >= 76 and screen <= 139):
                handle[0] <- (sdl_create_puzzle(screen, options, seed, requested_trials, adaptive) can Global{Read,Write})
            else:
                handle[0] <- (sdl_screen_create_seeded(screen, options, lexicon, index, sentences, seed) can Global{Read,Write})
            mode[0] <- 1.u8() if handle[0] != 0 else 0.u8()
            return -1.i32() if sdl_screen_creation_check(screen, handle[0]) != 0.i32()
            return 1.i32() if screen == 20 or screen == 22
            return 0.i32()

def sdl_start_screen(screen: i64, rows: usize&?, options: i64&?, lexicon: u8&?, index: u8&?, sentences: u8&?) -> i32:
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return (sdl_start_screen_seeded(screen, rows, options, lexicon, index, sentences, 23, 1, 0) can Global{Read,Write})

export fn nw_sdl_start_screen_seeded(screen: i64, rows: usize&?, options: i64&?, lexicon: u8&?, index: u8&?, sentences: u8&?, seed: i64, requested_trials: i64, adaptive: i64) -> i32 = sdl_start_screen_seeded
export fn nw_sdl_start_screen(screen: i64, rows: usize&?, options: i64&?, lexicon: u8&?, index: u8&?, sentences: u8&?) -> i32 = sdl_start_screen


# Start Python-compatible direct Maze and Sokoban sessions from CLI settings.
def sdl_create_maze(screen: i64, settings: i64&?) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if settings == null
        values: i64& = settings
        return you_are_here_create(values[0], values[1], values[2], values[3], values[5]) if screen == 2
        return sokoban_create(values[0], values[1], values[2], values[4], values[5]) if screen == 3
        return marble_create(values[6], values[1], values[2], 2600, 0, values[5]) if screen == 6
        return 0

def sdl_start_maze(screen: i64, rows: usize&?, settings: i64&?) -> i32:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write:
        return -1.i32() if rows == null or settings == null or (screen != 2 and screen != 3 and screen != 6)
        trusted Unsafe.PointerCast:
            table: usize& = rows
            row: usize = (screen - 2).usize() * 2.usize()
            handle: mutable i64& = table[row].cast[mutable i64&]
            mode: mutable u8& = table[row + 1.usize()].cast[mutable u8&]
            handle[0] <- sdl_create_maze(screen, settings)
            handle[0] <- 0 if handle[0] < 0
            mode[0] <- 1.u8() if handle[0] != 0 else 0.u8()
            return -1.i32() if sdl_screen_creation_check(screen, handle[0]) != 0.i32()
            return 0.i32()

export fn nw_sdl_start_maze(screen: i64, rows: usize&?, settings: i64&?) -> i32 = sdl_start_maze

# Validate an encoded frame using the same decoder as the SDL renderer.
def sdl_selftest_frame_valid(buffer: i64, length: i64) -> bool:
    can Abort.Panic, Unsafe.PointerCast:
        return false if buffer <= 0 or length <= 0
        frame: mutable NativeDisplayDecode::Frame = zeroed
        trusted Unsafe.PointerCast:
            return NativeDisplayDecode::decode_view(buffer.uintptr().cast[u8&], length.usize(), (&frame).uintptr().cast[mutable NativeDisplayDecode::Frame&]) != 0.i32()

def sdl_tetris_selftest() -> i32:
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        buffer: i64 = frame_alloc(65536)
        handle: i64 = tetris_create(1, 3, 5, 17)
        if buffer == 0 or handle == 0:
            _ = printf("tetris selftest: allocation failed\n")
            if handle != 0:
                _ = tetris_destroy(handle)
            frame_free(buffer) if buffer != 0
            return 1.i32()
        good: mutable bool = sdl_selftest_frame_valid(buffer, tetris_frame_write(buffer, 65536, handle, 0, 912, 684))
        good <- false if tetris_action(handle, 0) != 1
        good <- false if tetris_action(handle, 3) != 1
        good <- false if tetris_action(handle, 6) != 1
        good <- false if tetris_action(handle, 4) != 1
        good <- false if not sdl_selftest_frame_valid(buffer, tetris_frame_write(buffer, 65536, handle, 0, 1280, 720))
        good <- false if tetris_destroy(handle) != 0
        frame_free(buffer)
