            return sdl_custody_selftest().i32() if syllogism_argument_is(flag, "--selftest-custody")
            return sdl_concentration_selftest().i32() if syllogism_argument_is(flag, "--selftest-concentration")
            return sdl_recognition_selftest().i32() if syllogism_argument_is(flag, "--selftest-recognition")
            return sdl_trivia_selftest().i32() if syllogism_argument_is(flag, "--selftest-trivia")
            return sdl_reflex_selftest().i32() if syllogism_argument_is(flag, "--selftest-reflex")
            return sdl_algebra_selftest().i32() if syllogism_argument_is(flag, "--selftest-algebra")
