            return sdl_what_next_media_selftest(argc == 3 and syllogism_argument_is(args[2].i64(), "--with-clips")) if syllogism_argument_is(flag, "--selftest-what-next-media")
            return sdl_video_sequence_media_selftest(argc == 3 and syllogism_argument_is(args[2].i64(), "--with-clips")) if syllogism_argument_is(flag, "--selftest-video-sequence-media")
            return sdl_video_sequence_selftest() if syllogism_argument_is(flag, "--selftest-video-sequence")
            return sdl_sudoku_selftest().i32() if syllogism_argument_is(flag, "--selftest-sudoku")
            return sdl_go_selftest().i32() if syllogism_argument_is(flag, "--selftest-go")
            return sdl_hanoi_selftest(false) if syllogism_argument_is(flag, "--selftest-hanoi")
            return sdl_hanoi_selftest(true) if syllogism_argument_is(flag, "--selftest-hanoi-profile")
            return sdl_scrabble_selftest().i32() if syllogism_argument_is(flag, "--selftest-scrabble")
            return sdl_scramble_selftest().i32() if syllogism_argument_is(flag, "--selftest-scramble")
            return sdl_crossword_selftest().i32() if syllogism_argument_is(flag, "--selftest-crossword")
            return sdl_crossed_wires_selftest().i32() if syllogism_argument_is(flag, "--selftest-crossed-wires")
            return sdl_ncup_monte_selftest().i32() if syllogism_argument_is(flag, "--selftest-ncup-monte")
