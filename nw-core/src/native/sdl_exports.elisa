    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return 0.i32() if rows == null or special_rows == null or playing == null or step == null
        nearer: i64 = sdl_active_handle(rows, 52.usize())
