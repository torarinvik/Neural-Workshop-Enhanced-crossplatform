# Route UTF-8 text bytes to the same task actions used by the SDL event loop.
# Scramble consumes a non-ASCII sequence as one unsupported character.
def sdl_text_input(handle: i64, text: u8&?, now_ms: i64, task: i64):
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return if handle <= 0 or text == null or task < 0 or task > 2
        trusted Unsafe.PointerCast:
            pointer: u8& = text
            bytes: heap u8& = pointer.cast[heap u8&]
            index: mutable i64 = 0
            while bytes[index.usize()] != 0.u8() |index, bytes, handle, now_ms, task|:
                byte: i64 = bytes[index.usize()].i64()
                index <- index + 1
                if task == 0:
                    _ = numberology_action(handle, 1, byte, now_ms)
                elif task == 1:
                    _ = algebra_action(handle, 1, byte, now_ms)
                else:
                    mapped: i64 = 26 if byte == 32 else (byte - 65 if byte >= 65 and byte <= 90 else (byte - 97 if byte >= 97 and byte <= 122 else 27))
                    if byte >= 128:
                        while (bytes[index.usize()].i64() & 192) == 128 |index, bytes|:
                            index <- index + 1
                    _ = scramble_action(handle, 1, mapped, now_ms)

export fn nw_sdl_text_input(handle: i64, text: u8&?, now_ms: i64, task: i64) = sdl_text_input

# SDL owns the returned clipboard allocation until it is freed with SDL_free.
extern SDL_GetClipboardText() -> mutable heap void&? can[Blocking.IO, Memory.Allocate]

def sdl_paste_text(handle: i64, now_ms: i64, task: i64, suppress: mutable u8&? = null):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read:
        clipboard: mutable heap void&? = SDL_GetClipboardText()
        return if clipboard == null
        trusted Unsafe.PointerCast:
            text: mutable heap void& = clipboard
            if task == 2:
                sdl_scramble_text(handle, text.cast[u8&], now_ms, suppress)
            else:
                sdl_text_input(handle, text.cast[u8&], now_ms, task)
            SDL_free(text.cast[heap void&])

