# Route an SDL action and persist only actual state transitions.
def syllogism_sdl_dispatch(handle: i64, action: i64, value: i64, now_ms: i64,
                            options: i64&?, results: mutable usize&?) -> i64:
    can Memory.Allocate, Memory.Release, Blocking.IO, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0 or options == null or results == null
        before: i64 = syllogism_info(handle, 0)
        outcome: i64 = syllogism_action(handle, action, value, now_ms)
        after: i64 = syllogism_info(handle, 0)
        if (before == 0 or before == 3) and after == 1:
            SyllogismResults::start(results, options)
        if before == 1 and after == 2:
            count: i64 = syllogism_info(handle, 15)
            index: i64 = count - 1
            if index >= 0:
                SyllogismResults::judge(results, count, syllogism_value(handle, 2, index),
                    syllogism_value(handle, 3, index), syllogism_value(handle, 4, index))
        if before != 3 and after == 3:
            SyllogismResults::finish(results, syllogism_info(handle, 8),
                syllogism_info(handle, 9), syllogism_info(handle, 14))
        return outcome

export fn nw_syllogism_sdl_dispatch(handle: i64, action: i64, value: i64, now_ms: i64, options: i64&?, results: mutable usize&?) -> i64 = syllogism_sdl_dispatch

# Headless smoke test exercises the same input mapping and ABI as the SDL shell.
def syllogism_sdl_selftest() -> i64:
    can Memory.Allocate, Memory.Release, Blocking.IO, Abort.Panic, Unsafe.PointerCast:
        handle: i64 = syllogism_create(3, 1, 1, 0, 1, 23)
        return 1 if handle <= 0
        buffer: i64 = frame_alloc(65536)
        if buffer <= 0:
            _ = syllogism_destroy(handle)
            return 1
        ok: mutable bool = syllogism_info(handle, 0) == 0
        value: mutable i64 = 0
        action: mutable i64 = SyllogismInput::key(32, 0, 0, 0, &value)
        ok <- false if action != 0
        _ = syllogism_action(handle, action, value, 0)
        ok <- false if syllogism_info(handle, 0) != 1 or syllogism_info(handle, 5) <= 0
        ok <- false if syllogism_value(handle, 0, 0) != -1
        ok <- false if syllogism_frame_write(buffer, 65536, handle, 0, 912, 684) <= 0
        action <- SyllogismInput::key(49, 1, 0, 0, &value)
        ok <- false if action != 6 or value != 0
        _ = syllogism_action(handle, action, value, 0)
        ok <- false if syllogism_info(handle, 0) != 2 or syllogism_value(handle, 0, 0) < 0
        ok <- false if syllogism_frame_write(buffer, 65536, handle, 0, 912, 684) <= 0
        _ = syllogism_action(handle, 0, 0, 0)
        ok <- false if syllogism_info(handle, 0) != 3
        ok <- false if syllogism_options_frame_write(buffer, 65536, 0, 4, 3, 6, 1, 1, 1) <= 0
        _ = syllogism_destroy(handle)
        trusted Unsafe.PointerCast:
            free(buffer.uintptr().cast[heap void&])
        return 0 if ok else 1

export fn nw_syllogism_sdl_selftest() -> i64 = syllogism_sdl_selftest

