        good <- false if numberology_action(handle, 0, 0, 0) != 1
        good <- false if numberology_info(handle, 0) != 1 or numberology_info(handle, 4) < 4
        good <- false if not sdl_selftest_frame_valid(buffer, numberology_frame_write(buffer, 65536, handle, 0, 912, 684))
        good <- false if numberology_action(handle, 1, 45, 0) != 1
        good <- false if numberology_action(handle, 2, 0, 0) != 1
        good <- false if numberology_destroy(handle) != 0
        handle <- numberology_create(1000, 1, 0, 19)
        if handle == 0:
            good <- false
        else:
            good <- false if numberology_action(handle, 0, 0, 0) != 1 or numberology_info(handle, 4) != 29 or numberology_info(handle, 5) != -1 or numberology_info(handle, 17) != -1
            exact: cstr = "96448543405967464215539390836603148782077915887889532192857920126483182449263992839"
