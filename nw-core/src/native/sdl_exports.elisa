def marble_create(start_rung: i64, trials: i64, adaptive: i64,
                  feedback_ms: i64, time_override_ms: i64, seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return -1 if start_rung < 1 or start_rung > MarbleMaze::GRADE_COUNT
        return -1 if trials < 1 or trials > MarbleMazeGame::MAX_TRIALS
        return -1 if adaptive != 0 and adaptive != 1
        return -1 if feedback_ms < 0 or feedback_ms > 600000
        return -1 if time_override_ms < 0 or time_override_ms > MarbleMazeGame::MAX_DURATION_MS
        raw: mutable heap void&? = malloc(size_of(MarbleMazeGame::MarbleRun).usize())
        return -1 if raw == null
        trusted Unsafe.PointerCast:
            pointer: mutable heap void& = raw
            run: mutable heap MarbleMazeGame::MarbleRun& = pointer.cast[mutable heap MarbleMazeGame::MarbleRun&]
            MarbleMazeGame::initialize(run, start_rung, trials, adaptive != 0,
                                        feedback_ms, time_override_ms, seed)
            return pointer.cast[u8&].uintptr().i64()

