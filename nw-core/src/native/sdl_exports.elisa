            active[15] <- 0
        if active[16] != 0:
            _ = trivia_destroy(active[16])
            active[16] <- 0
        if active[17] != 0:
            _ = reflex_destroy(active[17])
            active[17] <- 0
        if active[18] != 0:
            _ = algebra_destroy(active[18])
            active[18] <- 0
        if active[34] != 0:
            _ = syllogism_destroy(active[34])
            active[34] <- 0
        SyllogismResults::close(syllogism_results)
        if active[19] != 0:
            _ = numberology_destroy(active[19])
            active[19] <- 0
        NumberologyResultsManager::close(numberology_results)
        if active[20] != 0:
            _ = jigsaw_destroy(active[20])
            active[20] <- 0
