        if screen == 22: return numberology_create(o[27], o[28], o[29], seed)
        if screen >= 23 and screen <= 26: return (sdl_create_puzzle(screen, options, 23, 1, 0) can Global{Read,Write})
        if screen == 27: return sdl_create_word_task_seeded(1, o[19], o[20], o[21], o[22], lexicon, seed)
        if screen == 28: return sdl_create_scramble_seeded(o[30], o[31], o[32], o[33], index, sentences, seed)
        if screen == 29: return sdl_create_word_task_seeded(0, o[15], o[16], o[17], o[18], lexicon, seed)
        return sdl_hub_create(5, 4) if screen == 2
        return sdl_hub_create(5, 2) if screen == 3
        return sdl_hub_create(0, 1) if screen == 4
        return sdl_hub_create(0, 0) if screen == 5
        return sdl_hub_create(2, 10) if screen == 6
        return sdl_hub_create(5, 6) if screen == 7
        return sdl_hub_create(3, 0) if screen == 8
        return sdl_hub_create(3, 1) if screen == 9
        return sdl_hub_create(4, 0) if screen == 10
        return sdl_hub_create(4, 1) if screen == 11
        return sdl_hub_create(0, 2) if screen == 12
        return sdl_hub_create(0, 3) if screen == 13
        return sdl_hub_create(0, 4) if screen == 14
        return sdl_hub_create(0, 5) if screen == 15
        return sdl_hub_create(1, 0) if screen == 16
        return sdl_hub_create(1, 1) if screen == 17
        return sdl_hub_create(1, 2) if screen == 18
        return sdl_hub_create(2, 0) if screen == 19
        return sdl_hub_create(2, screen - 29) if screen >= 30 and screen <= 33
        return sdl_hub_create(2, 6) if screen == 34
        return sdl_hub_create(2, 5) if screen == 35
        return sdl_hub_create(2, screen - 29) if screen >= 36 and screen <= 38
        return sdl_cookie_profile_create(seed) if screen == 44
        return sdl_sokoban3d_profile_create(seed) if screen == 43
        return sdl_maze2d_profile_create(seed) if screen == 42
        return sdl_ninarow_profile_create(seed) if screen == 41
        return sdl_salesman_profile_create(seed) if screen == 40
        return sdl_hanoi_profile_create() if screen == 39
        return 0

