        return 0 if (adaptive != 0 and adaptive != 1) or (show_traps != 0 and show_traps != 1)
        raw: mutable heap void&? = malloc(size_of(SokobanGame::SokobanRun).usize())
        return 0 if raw == null
        trusted Unsafe.PointerCast:
