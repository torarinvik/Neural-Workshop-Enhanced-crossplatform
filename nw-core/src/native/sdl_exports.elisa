def count_create(kind: i64, start_count: i64, trials: i64,
                 exposure_ms: i64, adaptive: i64, show_answer: i64,
                 seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if kind < Counting::LINES or kind > Counting::MIXED
        return 0 if not CountingGame::allowed_start_count(start_count)
        return 0 if not CountingGame::allowed_trials(trials)
        return 0 if not CountingGame::allowed_exposure(exposure_ms)
        return 0 if adaptive != 0 and adaptive != 1
        return 0 if show_answer != 0 and show_answer != 1
        raw: mutable heap void&? = malloc(size_of(CountingGame::CountingRun).usize())
        return 0 if raw == null
        trusted Unsafe.PointerCast:
            pointer: mutable heap void& = raw
            run: mutable heap CountingGame::CountingRun& = pointer.cast[mutable heap CountingGame::CountingRun&]
            CountingGame::initialize(run, kind, start_count, trials, exposure_ms,
                                     adaptive != 0, show_answer != 0, seed)
            return pointer.cast[u8&].uintptr().i64()

def count_action(handle: i64, action: i64, value: i64, now_ms: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap CountingGame::CountingRun& = handle.uintptr().cast[mutable heap CountingGame::CountingRun&]
            return CountingGame::apply(run, action, value, now_ms)

def count_advance(handle: i64, now_ms: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
