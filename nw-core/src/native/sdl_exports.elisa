def sdl_dump_puzzle_frame_write(screen: i64, buffer: i64, handle: i64, black: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Global.Read, Unsafe.PointerCast:
        return marble_frame_write(buffer, 65536, handle, black, 912, 684) if screen == 6
