        return 0 if interval_ms < 0 or stimulus_ms < 0 or feedback_ms < 0
        raw: mutable heap void&? = malloc(size_of(NBack3DGame::NBack3DRun).usize())
        return 0 if raw == null
        trusted Unsafe.PointerCast:
            pointer: mutable heap void& = raw
            run: mutable heap NBack3DGame::NBack3DRun& = pointer.cast[mutable heap NBack3DGame::NBack3DRun&]
