            return CountingGame::info(run, field)

def count_frame_write(dest: i64, capacity: i64, handle: i64,
                      black_background: i64, width: i64, height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if dest <= 0 or capacity <= 0 or handle <= 0
        trusted Unsafe.PointerCast:
            run: heap CountingGame::CountingRun& = handle.uintptr().cast[heap CountingGame::CountingRun&]
            list: mutable Display::DisplayList = Display::DisplayList()
            shapes: mutable darray[SceneCounting::CountRenderShape] = []
            for index in 0..<run.shape_count |index, run, shapes|:
                source: Counting::CountShape = run.shapes[index.usize()]
                shapes.push(SceneCounting::CountRenderShape{
                    kind: source.kind,
                    x1: source.x[0], y1: source.y[0],
                    x2: source.x[1], y2: source.y[1],
                    x3: source.x[2], y3: source.y[2],
                    radius: source.radius,
                })
            paint: mutable SceneCounting::CountPaint = SceneCounting::paint_of(
                black_background != 0, width.f64(), height.f64(), 1.0, 1.0)
            typed: mutable dstr = []
            if run.answer_length > 0:
                dstr_append_i64(&typed, run.answer)
            message: mutable dstr = []
            if run.phase == CountingGame::PHASE_READY:
                dstr_append_cstr(&message, "Press Space to start")
            elif run.phase == CountingGame::PHASE_SHOWING or run.phase == CountingGame::PHASE_HIDDEN:
                dstr_append_cstr(&message, "How many?")
            elif run.phase == CountingGame::PHASE_FEEDBACK:
                CountingGame::append_feedback_text(&message, run)
            else:
                CountingGame::append_done_text(&message, run)
            verdict_message: mutable dstr = []
            if run.verdict >= 0:
                CountingGame::append_feedback_text(&verdict_message, run)
            SceneCounting::render(&list, &paint, run.phase, &shapes,
                                  bytes_view(typed), run.trial,
                                  run.total_trials, run.correct,
                                  bytes_view(message), run.verdict,
                                  bytes_view(verdict_message))
            encoded: darray[u8] = Display::encode_binary(&list)
            length: i64 = encoded.count.i64()
            return 0 if length <= 0 or length > capacity
            target: mutable u8& = dest.uintptr().cast[mutable u8&]
            memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            return length

def count_destroy(handle: i64) -> i64:
    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            heap_pointer: heap void& = handle.uintptr().cast[heap void&]
            free(heap_pointer)
            return 0

