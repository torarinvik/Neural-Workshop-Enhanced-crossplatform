def algebra_create(level: i64, trials: i64, seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if not AlgebraGame::allowed_level(level) or not AlgebraGame::allowed_trials(trials)
        raw: mutable heap void&? = malloc(size_of(AlgebraGame::AlgebraRun).usize())
        return 0 if raw == null
        trusted Unsafe.PointerCast:
            pointer: mutable heap void& = raw
            run: mutable heap AlgebraGame::AlgebraRun& = pointer.cast[mutable heap AlgebraGame::AlgebraRun&]
            AlgebraGame::initialize(run, level, trials, seed)
            return pointer.cast[u8&].uintptr().i64()

def algebra_create_options(level: i64, trials: i64, show_working: i64, adaptive: i64, seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if (show_working != 0 and show_working != 1) or (adaptive != 0 and adaptive != 1)
        handle: i64 = algebra_create(level, trials, seed)
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap AlgebraGame::AlgebraRun& = handle.uintptr().cast[mutable heap AlgebraGame::AlgebraRun&]
            AlgebraGame::configure(run, show_working != 0, adaptive != 0)
        return handle

def algebra_action(handle: i64, action: i64, value: i64, now_ms: i64) -> i64:
