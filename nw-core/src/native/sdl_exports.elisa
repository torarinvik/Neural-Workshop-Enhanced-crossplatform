export fn nw_sokoban_cell(handle: i64, field: i64, at: i64) -> i64 = sokoban_cell
export fn nw_sokoban_frame_write(dest: i64, capacity: i64, handle: i64,
                                 black_background: i64, width: i64,
                                 height: i64) -> i64 = sokoban_frame_write
export fn nw_sokoban_destroy(handle: i64) -> i64 = sokoban_destroy
export fn nw_monkey_ladder_create(grid: i64, start_level: i64, adaptive: i64, show_ms: i64, per_tile_ms: i64, reveal_answer: i64, seed: i64) -> i64 = monkey_ladder_create
export fn nw_monkey_ladder_action(handle: i64, action: i64, value: i64, now_ms: i64) -> i64 = monkey_ladder_action
