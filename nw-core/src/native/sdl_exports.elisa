        return 0 if flash_ms != 100 and flash_ms != 200 and flash_ms != 400 and flash_ms != 800 and flash_ms != 1500
        return 0 if adaptive != 0 and adaptive != 1
        raw: mutable heap void&? = malloc(size_of(MrTime::MrTimeRun).usize())
