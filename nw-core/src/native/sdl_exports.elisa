                   seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if nback < 1 or nback > 8 or cubes < 1 or cubes > 6
        return 0 if total_trials < 4 or total_trials > NBack3DGame::MAX_TRIALS
        return 0 if interval_ms < 0 or stimulus_ms < 0 or feedback_ms < 0
        raw: mutable heap void&? = malloc(size_of(NBack3DGame::NBack3DRun).usize())
        return 0 if raw == null
        trusted Unsafe.PointerCast:
            pointer: mutable heap void& = raw
            run: mutable heap NBack3DGame::NBack3DRun& = pointer.cast[mutable heap NBack3DGame::NBack3DRun&]
            NBack3DGame::initialize(run, nback, cubes, total_trials,
                                    interval_ms, stimulus_ms, feedback_ms, seed)
            return pointer.cast[u8&].uintptr().i64()

