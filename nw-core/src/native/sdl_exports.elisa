# Preserve SDL result and adaptive-settings behavior at controller transitions.
def numberology_sdl_action(handle: i64, action: i64, now_ms: i64,
                           options: mutable i64&?, results: mutable usize&?) -> i64:
    can Memory.Allocate, Memory.Release, Blocking.IO, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0 or results == null or (action == 0 and options == null)
        before: i64 = numberology_info(handle, 0)
        outcome: i64 = numberology_action(handle, action, 0, now_ms)
        after: i64 = numberology_info(handle, 0)
        if action == 0 and options != null:
            trusted Unsafe.PointerCast:
                pointer: mutable i64& = options
                values: mutable heap i64& = pointer.cast[mutable heap i64&]
                if (before == 0 or before == 3) and after == 1:
                    NumberologyResultsManager::start(results, numberology_info(handle, 1), numberology_info(handle, 3), values[3].i32())
                if before == 2 and after == 3:
                    NumberologyResultsManager::finish(results, numberology_info(handle, 10))
                    if values[3] != 0:
                        next: i64 = numberology_info(handle, 13)
                        if next > values[0]:
                            values[0] <- next
                            if NumberologySettings::write(pointer.cast[i64&]) == 0.i32():
                                SDL_Log("Could not save Numberology settings")
        if action == 3 and before == 1 and after == 2:
            NumberologyResultsManager::judge(results, numberology_info(handle, 2), numberology_info(handle, 1),
                1.i32() if numberology_info(handle, 8) == 1 else 0.i32())
        return outcome

export fn nw_numberology_sdl_action(handle: i64, action: i64, now_ms: i64, options: mutable i64&?, results: mutable usize&?) -> i64 = numberology_sdl_action

# Exercise the real result-manager lifecycle with the level-one source oracle.
def numberology_result_selftest() -> i32:
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        handle: i64 = numberology_create(1, 1, 0, 23)
        return 1.i32() if handle == 0
        results: mutable usize[2] = zeroed
        options: mutable i64[4] = zeroed
        options[0] <- 1
        options[1] <- 1
        trusted Unsafe.PointerCast:
            config: mutable i64& = (&options[0]).uintptr().cast[mutable i64&]
            manager: mutable usize& = (&results[0]).uintptr().cast[mutable usize&]
            _ = numberology_sdl_action(handle, 0, SDL_GetTicks().i64(), config, manager)
            _ = numberology_action(handle, 1, 57, 0)
            _ = numberology_sdl_action(handle, 3, 0, null, manager)
            good: mutable bool = numberology_info(handle, 8) == 1
            _ = numberology_sdl_action(handle, 0, SDL_GetTicks().i64(), config, manager)
            good <- false if numberology_info(handle, 0) != 3
            _ = numberology_destroy(handle)
            NumberologyResultsManager::close(manager)
            return 0.i32() if good else 1.i32()

export fn nw_numberology_result_selftest() -> i32 = numberology_result_selftest


