def algebra_create(level: i64, trials: i64, seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if not AlgebraGame::allowed_level(level) or not AlgebraGame::allowed_trials(trials)
        raw: mutable heap void&? = malloc(size_of(AlgebraGame::AlgebraRun).usize())
        return 0 if raw == null
        trusted Unsafe.PointerCast:
            pointer: mutable heap void& = raw
            run: mutable heap AlgebraGame::AlgebraRun& = pointer.cast[mutable heap AlgebraGame::AlgebraRun&]
            AlgebraGame::initialize(run, level, trials, seed)
            return pointer.cast[u8&].uintptr().i64()

def algebra_action(handle: i64, action: i64, value: i64, now_ms: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap AlgebraGame::AlgebraRun& = handle.uintptr().cast[mutable heap AlgebraGame::AlgebraRun&]
            return AlgebraGame::apply(run, action, value, now_ms)

def algebra_info(handle: i64, field: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: heap AlgebraGame::AlgebraRun& = handle.uintptr().cast[heap AlgebraGame::AlgebraRun&]
            return AlgebraGame::info(run, field)

def algebra_value(handle: i64, field: i64, at: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: heap AlgebraGame::AlgebraRun& = handle.uintptr().cast[heap AlgebraGame::AlgebraRun&]
            return AlgebraGame::value(run, field, at)

def algebra_frame_write(dest: i64, capacity: i64, handle: i64,
                        black_background: i64, width: i64, height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if dest <= 0 or capacity <= 0 or handle <= 0
        trusted Unsafe.PointerCast:
            run: heap AlgebraGame::AlgebraRun& = handle.uintptr().cast[heap AlgebraGame::AlgebraRun&]
            list: mutable Display::DisplayList = Display::DisplayList()
            AlgebraGame::render(run, black_background != 0, width.f64(), height.f64(), &list)
            encoded: darray[u8] = Display::encode_binary(&list)
            length: i64 = encoded.count.i64()
            return 0 if length <= 0 or length > capacity
            target: mutable u8& = dest.uintptr().cast[mutable u8&]
            memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            return length

def algebra_destroy(handle: i64) -> i64:
    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            heap_pointer: heap void& = handle.uintptr().cast[heap void&]
            free(heap_pointer)
            return 0

export fn nw_algebra_create(level: i64, trials: i64, seed: i64) -> i64 = algebra_create
export fn nw_algebra_action(handle: i64, action: i64, value: i64, now_ms: i64) -> i64 = algebra_action
export fn nw_algebra_info(handle: i64, field: i64) -> i64 = algebra_info
export fn nw_algebra_value(handle: i64, field: i64, at: i64) -> i64 = algebra_value
export fn nw_algebra_frame_write(dest: i64, capacity: i64, handle: i64, black_background: i64, width: i64, height: i64) -> i64 = algebra_frame_write
export fn nw_algebra_destroy(handle: i64) -> i64 = algebra_destroy

def numberology_create(start_level: i64, trials: i64, adaptive: i64, seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if not NumberologyGame::allowed_trials(trials) or (adaptive != 0 and adaptive != 1)
        raw: mutable heap void&? = malloc(size_of(NumberologyGame::NumberologyRun).usize())
        return 0 if raw == null
        trusted Unsafe.PointerCast:
            pointer: mutable heap void& = raw
            run: mutable heap NumberologyGame::NumberologyRun& = pointer.cast[mutable heap NumberologyGame::NumberologyRun&]
            NumberologyGame::initialize(run, start_level, trials, adaptive != 0, seed)
            return pointer.cast[u8&].uintptr().i64()

def numberology_action(handle: i64, action: i64, value: i64, now_ms: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
