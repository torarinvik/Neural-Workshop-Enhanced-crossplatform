        good <- false if reflex_pointer(handle, x, y, 100) < 0
        good <- false if reflex_info(handle, 9) != 1
        good <- false if not sdl_selftest_frame_valid(buffer, reflex_frame_write(buffer, 65536, handle, 0, 912, 684))
        good <- false if reflex_destroy(handle) != 0
        frame_free(buffer)
        if good: _ = printf("Reflex selftest: PASS\n")
        else: _ = printf("Reflex selftest: FAILED\n")
        return 0.i32() if good else 1.i32()

