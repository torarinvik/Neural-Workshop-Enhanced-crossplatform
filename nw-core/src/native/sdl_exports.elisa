            pointer: mutable heap void& = raw
            run: mutable heap JigsawGame::JigsawRun& = pointer.cast[mutable heap JigsawGame::JigsawRun&]
            JigsawGame::initialize(run, start_side, puzzles, adaptive != 0, preview != 0, mark_placed != 0, seed, pieces, video)
            return pointer.cast[u8&].uintptr().i64()

