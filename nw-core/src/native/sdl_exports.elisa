def sdl_jigsaw_pixel_pointer(handle: i64, motion: bool, x: f32, y: f32, width: i32, height: i32):
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return if handle <= 0 or width <= 0.i32() or height <= 0.i32()
        view: mutable f32[4] = zeroed
        SDLGeometry::setup(&view[0], width, height)
        return if view[0] <= 0.0.f32()
        nx: f64 = ((x - view[1]) / (view[0] * 912.0.f32())).f64()
        ny: f64 = ((height.f32() - y - view[2]) / (view[0] * 684.0.f32())).f64()
        trusted Unsafe.PointerCast:
            run: mutable heap JigsawGame::JigsawRun& = handle.uintptr().cast[mutable heap JigsawGame::JigsawRun&]
            if run.options_row >= 0:
                if not motion:
                    row: i64 = sdl_option_row(x, y, width, height, 5)
                    if row >= 0:
                        if row == run.options_row:
                            run.options_draft[row.usize()] <- sdl_jigsaw_option_change(row, run.options_draft[row.usize()], 1)
                        run.options_row <- row
                return
            return if run.phase != JigsawGame::PHASE_SOLVING or not run.photo_timed
            tile: i64 = Jigsaw::tile_at(width.f64(), height.f64(), run.preview, run.trial_side,
                nx * width.f64(), ny * height.f64(), run.trial_rows, run.video)
            if motion:
                run.hovered <- tile
            elif tile >= 0:
                _ = JigsawGame::apply(run, JigsawGame::ACTION_PICK, tile, SDL_GetTicks().i64())

def jigsaw_frame_write(dest: i64, capacity: i64, handle: i64,
                       black_background: i64, width: i64, height: i64, photo: bool = false, photo_count: i64 = -1) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if dest <= 0 or capacity <= 0 or handle <= 0
        trusted Unsafe.PointerCast:
            run: heap JigsawGame::JigsawRun& = handle.uintptr().cast[heap JigsawGame::JigsawRun&]
            list: mutable Display::DisplayList = Display::DisplayList()
            if run.options_row >= 0:
                sdl_grid_options_frame(&list, black_background != 0, 45 if run.video else 23, run.options_row, &run.options_draft[0])
            else:
                JigsawGame::render(run, black_background != 0, width.f64(), height.f64(), &list, photo, photo_count)
            encoded: darray[u8] = Display::encode_binary(&list)
            length: i64 = encoded.count.i64()
            return 0 if length <= 0 or length > capacity
            target: mutable u8& = dest.uintptr().cast[mutable u8&]
            memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            return length

