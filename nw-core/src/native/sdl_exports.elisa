    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            heap_pointer: heap void& = handle.uintptr().cast[heap void&]
            free(heap_pointer)
            return 0

def jigsaw_create(start_side: i64, puzzles: i64, adaptive: i64,
                  preview: i64, seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if not JigsawGame::allowed_side(start_side)
        return 0 if not JigsawGame::allowed_puzzles(puzzles)
        return 0 if not JigsawGame::allowed_flag(adaptive) or not JigsawGame::allowed_flag(preview)
        raw: mutable heap void&? = malloc(size_of(JigsawGame::JigsawRun).usize())
        return 0 if raw == null
        trusted Unsafe.PointerCast:
            pointer: mutable heap void& = raw
            run: mutable heap JigsawGame::JigsawRun& = pointer.cast[mutable heap JigsawGame::JigsawRun&]
            JigsawGame::initialize(run, start_side, puzzles, adaptive != 0, preview != 0, seed)
            return pointer.cast[u8&].uintptr().i64()

def jigsaw_action(handle: i64, action: i64, value: i64, now_ms: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap JigsawGame::JigsawRun& = handle.uintptr().cast[mutable heap JigsawGame::JigsawRun&]
            return JigsawGame::apply(run, action, value, now_ms)

def jigsaw_info(handle: i64, field: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: heap JigsawGame::JigsawRun& = handle.uintptr().cast[heap JigsawGame::JigsawRun&]
            return JigsawGame::info(run, field)

def jigsaw_value(handle: i64, field: i64, at: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: heap JigsawGame::JigsawRun& = handle.uintptr().cast[heap JigsawGame::JigsawRun&]
            return JigsawGame::value(run, field, at)

def jigsaw_pointer(handle: i64, x_millionths: i64, y_millionths: i64,
                   width: i64, height: i64, now_ms: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0 or x_millionths < 0 or x_millionths > 1000000 or y_millionths < 0 or y_millionths > 1000000
        trusted Unsafe.PointerCast:
            run: mutable heap JigsawGame::JigsawRun& = handle.uintptr().cast[mutable heap JigsawGame::JigsawRun&]
            position: i64 = Jigsaw::tile_at(width.f64(), height.f64(), run.preview, run.trial_side,
                x_millionths.f64() * width.f64() / 1000000.0,
                y_millionths.f64() * height.f64() / 1000000.0)
            return 2 if position < 0
            return JigsawGame::apply(run, JigsawGame::ACTION_PICK, position, now_ms)

def jigsaw_frame_write(dest: i64, capacity: i64, handle: i64,
                       black_background: i64, width: i64, height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if dest <= 0 or capacity <= 0 or handle <= 0
        trusted Unsafe.PointerCast:
            run: heap JigsawGame::JigsawRun& = handle.uintptr().cast[heap JigsawGame::JigsawRun&]
            list: mutable Display::DisplayList = Display::DisplayList()
            JigsawGame::render(run, black_background != 0, width.f64(), height.f64(), &list)
            encoded: darray[u8] = Display::encode_binary(&list)
            length: i64 = encoded.count.i64()
            return 0 if length <= 0 or length > capacity
            target: mutable u8& = dest.uintptr().cast[mutable u8&]
            memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            return length

def jigsaw_destroy(handle: i64) -> i64:
    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            heap_pointer: heap void& = handle.uintptr().cast[heap void&]
            free(heap_pointer)
            return 0

