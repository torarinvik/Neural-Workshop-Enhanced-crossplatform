def concentration_pointer_at(handle: i64, x_millionths: i64, y_millionths: i64, width: f64, height: f64, now_ms: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap ConcentrationGame::ConcentrationRun& = handle.uintptr().cast[mutable heap ConcentrationGame::ConcentrationRun&]
            if run.options_row >= 0:
                run.options_row <- sdl_media_options_click(run.options_row, (&run.options_draft[0]).uintptr().cast[mutable i64&],
                    false, x_millionths, y_millionths)
                return 1
            card: i64 = ConcentrationGame::pointer_card_at(run, x_millionths, y_millionths, width, height)
            return ConcentrationGame::apply(run, ConcentrationGame::ACTION_SELECT, card, now_ms) if card >= 0
            return 2

