def sdl_dump_puzzle_action(screen: i64, handle: i64) -> i64:
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read:
        if screen == 20:
            before: i64 = algebra_info(handle, 0)
            result: i64 = algebra_action(handle, 0, 0, 0)
            if before != 1 and algebra_info(handle, 0) == 1:
                _ = algebra_action(handle, 4, 0, 0)
