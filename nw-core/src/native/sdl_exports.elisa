                            _ = SDLClawMachine::options_key(sdl_active_handle(rows, 125.usize()), key, true) can Global{Read,Write}
                        if target == 76 and hub_options != 0:
                            _ = SDLWhatNext::options_key(sdl_active_handle(rows, 72.usize()), key, true)
                        if target == 46 and hub_options != 0:
                            _ = SDLVideoSequence::options_key(sdl_active_handle(rows, 43.usize()), key, true)
                        if (target == 23 or target == 45) and hub_options != 0:
                            _ = sdl_jigsaw_options_key(sdl_active_handle(rows, 21.usize()), key, tasks.uintptr(), true)
                        if target == 24 and hub_options != 0:
                            _ = sdl_sudoku_options_key(sdl_active_handle(rows, 22.usize()), key, tasks.uintptr(), true)
                        if target == 25 and hub_options != 0:
                            _ = sdl_go_options_key(sdl_active_handle(rows, 23.usize()), key, tasks.uintptr(), true)
                        if target == 26 and hub_options != 0:
                            _ = sdl_wires_options_key(sdl_active_handle(rows, 24.usize()), key, tasks.uintptr(), true)
                        if target == 39 and hub_options != 0:
                            _ = sdl_hanoi_options_key(sdl_active_handle(rows, 37.usize()), key, true)
                        if target == 40 and hub_options != 0:
                            _ = sdl_salesman_options_key(sdl_active_handle(rows, 38.usize()), key, true)
                        if target == 44 and hub_options != 0:
                            _ = sdl_cookie_options_key(sdl_active_handle(rows, 42.usize()), key, true)
                        if target == 43 and hub_options != 0:
                            _ = sdl_sokoban3d_options_key(sdl_active_handle(rows, 41.usize()), key, true)
                        if target == 42 and hub_options != 0:
                            _ = sdl_maze2d_options_key(sdl_active_handle(rows, 40.usize()), key, true)
                        if target == 41 and hub_options != 0:
                            _ = sdl_ninarow_options_key(sdl_active_handle(rows, 39.usize()), key, true)
                        # Forms types through SDL text events.
                        input <- 1.i32() if target == 144
                        return input
                    lexicon_pointer: usize& = config[3 if target == 27 else 1].cast[usize&]
                    launch_rows: mutable usize[30] = zeroed
                    at <- 0.usize()
                    # Hub launch order: Scrabble, Scramble, Algebra, Syllogism, Numberology.
                    while at < 5.usize() |at, special, launch_rows|:
                        source: usize = (4 if at == 0.usize() else (3 if at == 1.usize() else (0 if at == 2.usize() else (1 if at == 3.usize() else 2)))).usize() * 10.usize()
                        dest: usize = at * 6.usize()
                        launch_rows[dest] <- special[source + 5.usize()]
                        launch_rows[dest + 1.usize()] <- special[source + 6.usize()]
                        launch_rows[dest + 2.usize()] <- special[source + 4.usize()]
                        launch_rows[dest + 3.usize()] <- special[source + 2.usize()]
                        launch_rows[dest + 4.usize()] <- special[source + 3.usize()]
                        launch_rows[dest + 5.usize()] <- special[source + 7.usize()] if at == 4.usize()
                        at <- at + 1.usize()
                    launch_seed: mutable i64 = 17
                    if maze_options != null:
                        startup: i64& = maze_options
                        launch_seed <- startup[5]
                    launched: i32 = sdl_launch_hub_rows_seeded(target, hub_options, rows, (&screen_options[0]).uintptr().cast[i64&], lexicon_pointer[0].cast[u8&?], index, sentences, (&launch_rows[0]).uintptr().cast[usize&], launch_seed)
                    input <- 1.i32() if launched != 0.i32()
            else:
                task_input: i32 = sdl_active_key(rows, special_rows, key, paste, playing, step)
                input <- task_input if task_input != 0.i32()
            return input

export fn nw_sdl_key_event(rows: usize&?, special_rows: usize&?, tasks: i64&?, configs: usize&?, taskhub: i64, key: i64, paste: i64, category: mutable i64&?, selected: mutable i64&?, playing: mutable u8&?, step: mutable u8&?, running: mutable u8&?, index: u8&?, sentences: u8&?, maze_options: i64&?) -> i32 = sdl_key_event

extern SDL_GetWindowFlags(window: mutable void&) -> u64
extern SDL_SetWindowFullscreen(window: mutable void&, fullscreen: bool) -> bool

def sdl_set_fullscreen(window: mutable void&, fullscreen: bool):
    can Console.Write:
        if not SDL_SetWindowFullscreen(window, fullscreen):
            SDL_Log("Could not change fullscreen mode: %s", SDL_GetError())

# Return the process failure status if the optional physics adapter fails.
def sdl_window_key_down(window: mutable void&?, rows: usize&?, special_rows: usize&?, tasks: i64&?, configs: usize&?, screen: i64, key: i64, modifiers: u32, repeat: u8, trial: mutable i64&?, category: mutable i64&?, selected: mutable i64&?, playing: mutable u8&?, step: mutable u8&?, running: mutable u8&, index: u8&?, sentences: u8&?, maze_options: i64&?, marble_key: usize, marble_state: usize, physics: usize, physics_tick: usize) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
        # Pyglet repeats text events and sends only the initial key press.
        return 0.i32() if repeat != 0.u8()
        if sdl_profile_picker_open or key == 117:
            return 0.i32() if sdl_profile_picker_key(window, key, screen == 0 or (screen == 1 and sdl_hub_idle(rows)))
        if key == 1073741892 and window != null: # SDLK_F11
            target: mutable void& = window
            flags: u64 = SDL_GetWindowFlags(target)
            if (flags & 8.u64()) == 0.u64(): # SDL_WINDOW_HIDDEN
                sdl_set_fullscreen(target, (flags & 1.u64()) == 0.u64())
            return 0.i32()
        return 0.i32() if SDLCameraHost::key(key, modifiers, true)
        return 0.i32() if SDLTuner::control(sdl_active_handle(rows, 76.usize()), key, modifiers, true)
        return 0.i32() if SDLShadowPlay::control(sdl_active_handle(rows, 77.usize()), key, modifiers, true)
        return 0.i32() if screen == 0 and sdl_title_key(key, trial) != 0.i32()
        if (modifiers & 3.u32()) != 0.u32() and key >= 49 and key <= 56:
            notebook: i64 = sdl_active_handle(rows, 50.usize())
            if notebook != 0:
                _ = SDLNotebook::key(notebook, key, SDL_GetTicks().i64(), true)
                return 0.i32()
        hub: i64 = 1 if screen == 1 else 0
        input: i32 = sdl_key_event(rows, special_rows, tasks, configs, hub, key, sdl_paste_modifier(modifiers), category, selected, playing, step, running, index, sentences, maze_options if hub == 1 else null)
        return 0.i32() if running[0] == 0.u8()
        sdl_apply_text_input(window, input)
        if marble_key != 0.usize():
            trusted Unsafe.PointerCast:
                forward: fn(usize, usize, usize, i64, usize) -> i32 = marble_key.cast[fn(usize, usize, usize, i64, usize) -> i32]
                if forward(marble_state, physics, rows.uintptr(), key, physics_tick) == 0.i32():
                    running[0] <- 0.u8()
                    return 1.i32()
        return 0.i32()

export fn nw_sdl_window_key_down(window: mutable void&?, rows: usize&?, special_rows: usize&?, tasks: i64&?, configs: usize&?, screen: i64, key: i64, modifiers: u32, repeat: u8, trial: mutable i64&?, category: mutable i64&?, selected: mutable i64&?, playing: mutable u8&?, step: mutable u8&?, running: mutable u8&, index: u8&?, sentences: u8&?, maze_options: i64&?, marble_key: usize, marble_state: usize, physics: usize, physics_tick: usize) -> i32 = sdl_window_key_down


def sdl_hub_destroy(category: i64, selected: i64, handle: i64) -> i64:
    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return you_are_here_destroy(handle) if category == 5 and selected == 4
        return sokoban_destroy(handle) if category == 5 and selected == 2
        return monkey_ladder_destroy(handle) if category == 0 and selected == 1
        return nback3d_destroy(handle) if category == 0 and selected == 0
        return marble_destroy(handle) if category == 2 and selected == 10
        return tetris_destroy(handle) if category == 5 and selected == 6
        return count_destroy(handle) if category == 3 and selected == 0
        return mr_time_destroy(handle) if category == 3 and selected == 1
        return graph_mapping_destroy(handle) if category == 4 and selected == 0
        return matrix_reasoning_destroy(handle) if category == 4 and selected == 1
        return in_the_dark_destroy(handle) if category == 0 and selected == 2
        return fog_destroy(handle) if category == 0 and selected == 3
        return removals_destroy(handle) if category == 0 and selected == 4
        return custody_destroy(handle) if category == 0 and selected == 5
        return concentration_destroy(handle) if category == 1 and selected == 0
        return recognition_destroy(handle) if category == 1 and selected == 1
        return trivia_destroy(handle) if category == 1 and selected == 2
        return reflex_destroy(handle) if category == 2 and selected == 0
        return ncup_monte_destroy(handle) if category == 2 and selected == 1
        return tracking_destroy(handle) if category == 2 and selected == 2
        return lookout_destroy(handle) if category == 2 and selected == 3
        return pursuit_destroy(handle) if category == 2 and selected == 4
        return out_of_sight_destroy(handle) if category == 2 and selected == 6
        return buzz_wire_destroy(handle) if category == 2 and selected == 5
        return donkey_destroy(handle) if category == 2 and selected == 7
        return two_hands_destroy(handle) if category == 2 and selected == 8
        return overrun_destroy(handle) if category == 2 and selected == 9
        return -1

export fn nw_sdl_hub_destroy(category: i64, selected: i64, handle: i64) -> i64 = sdl_hub_destroy

