        good: mutable bool = true
        args: mutable usize[7] = zeroed
        argv0: cstr = "test"
        argv1: cstr = "--scrabble-level"
        argv2: cstr = "2"
        argv3: cstr = "--scrabble-trials"
        argv4: cstr = "1"
