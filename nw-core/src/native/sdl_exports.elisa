            numberology_edit_digit(number, flag, edit, 5.i32())
            good <- false if numberology[0] != 5
            numberology_edit_backspace(number, flag, edit)
            numberology_edit_digit(number, flag, edit, 7.i32())
            good <- false if numberology[0] != 7
            edit[0] <- 9223372036854775807
            number[0] <- 9223372036854775807
            numberology_edit_digit(number, flag, edit, 9.i32())
            good <- false if numberology[0] != 9223372036854775807
            good <- false if numberology_page(265.0.f32(), 365.0.f32()) != 4.i32() or numberology_page(647.0.f32(), 365.0.f32()) != 5.i32() or numberology_page(456.0.f32(), 365.0.f32()) != 0.i32() or numberology_page(265.0.f32(), 400.0.f32()) != 0.i32()
        if good: _ = printf("SDL task-options selftest: PASS\n")
        else: _ = printf("SDL task-options selftest: FAILED\n")
        return 0.i32() if good else 1.i32()

