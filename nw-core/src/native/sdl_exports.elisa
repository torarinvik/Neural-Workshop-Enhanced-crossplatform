            OutOfSightGame::render(run, black_background != 0, width.f64(), height.f64(), &list)
            encoded: darray[u8] = Display::encode_binary(&list)
            length: i64 = encoded.count.i64()
            return 0 if length <= 0 or length > capacity
            target: mutable u8& = dest.uintptr().cast[mutable u8&]
            memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            return length

def out_of_sight_destroy(handle: i64) -> i64:
    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            heap_pointer: heap void& = handle.uintptr().cast[heap void&]
            free(heap_pointer)
            return 0

def buzz_wire_create(rung: i64, trials: i64, adaptive: i64,
                     meter: i64, beads: i64, sight: i64, seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if rung < 1 or rung > 12 or trials < 1 or trials > 32
        return 0 if adaptive < 0 or adaptive > 1 or meter < 0 or meter > 1
        return 0 if beads < 0 or beads > 1 or sight < 0 or sight > 1
        raw: mutable heap void&? = malloc(size_of(BuzzWireGame::BuzzWireRun).usize())
        return 0 if raw == null
        trusted Unsafe.PointerCast:
            pointer: mutable heap void& = raw
            run: mutable heap BuzzWireGame::BuzzWireRun& = pointer.cast[mutable heap BuzzWireGame::BuzzWireRun&]
            BuzzWireGame::initialize(run, rung, trials, adaptive != 0, meter != 0, beads != 0, sight != 0, seed)
            return pointer.cast[u8&].uintptr().i64()

def buzz_wire_action(handle: i64, action: i64, value: i64, now_ms: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap BuzzWireGame::BuzzWireRun& = handle.uintptr().cast[mutable heap BuzzWireGame::BuzzWireRun&]
            return BuzzWireGame::apply(run, action, value, now_ms)

def buzz_wire_advance(handle: i64, now_ms: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap BuzzWireGame::BuzzWireRun& = handle.uintptr().cast[mutable heap BuzzWireGame::BuzzWireRun&]
            return BuzzWireGame::advance(run, now_ms)

