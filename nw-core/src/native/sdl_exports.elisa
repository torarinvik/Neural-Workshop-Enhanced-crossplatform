# Create the SDL Scramble controller and transfer any available corpus into
# it. Small default sentence fixtures are ignored, as in the original shell.
def sdl_create_scramble_seeded(rung: i64, trials: i64, show_count: i64, adaptive: i64, index_override: u8&?, sentence_override: u8&?, seed: i64) -> i64:
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        handle: i64 = scramble_create(rung, trials, show_count, adaptive, seed)
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            index_path: mutable u8[4096] = zeroed
            sentence_path: mutable u8[4096] = zeroed
            index_name: mutable u8& = (&index_path[0]).uintptr().cast[mutable u8&]
            sentence_name: mutable u8& = (&sentence_path[0]).uintptr().cast[mutable u8&]
            if sdl_corpus_path(index_name, 4096.usize(), 0, 1) == 0.i32() or sdl_corpus_path(sentence_name, 4096.usize(), 1, 1) == 0.i32():
                _ = scramble_destroy(handle)
                return 0
            if index_override != null:
                index_name <- index_override.uintptr().cast[mutable u8&]
            if sentence_override != null:
                sentence_name <- sentence_override.uintptr().cast[mutable u8&]
            index_length: mutable i64 = 0
            sentence_length: mutable i64 = 0
            index_data: mutable heap void&? = sdl_read_corpus(index_name, &index_length)
            sentence_data: mutable heap void&? = sdl_read_corpus(sentence_name, &sentence_length)
            missing_explicit: bool = (index_data == null and index_override != null) or (sentence_data == null and sentence_override != null)
            if index_data == null:
                index_length <- 0
            if sentence_data == null:
                sentence_length <- 0
            if sentence_override == null and sentence_data != null and sentence_length <= 4096:
                short_sentence: mutable heap void& = sentence_data
                SDL_free(short_sentence.cast[heap void&])
                sentence_data <- null
                sentence_length <- 0
            index_address: mutable i64 = 0
            sentence_address: mutable i64 = 0
            if index_data != null:
                index_address <- index_data.uintptr().i64()
            if sentence_data != null:
                sentence_address <- sentence_data.uintptr().i64()
            result: mutable i64 = 0
            if not missing_explicit and (index_data != null or sentence_data != null):
                result <- scramble_set_corpus(handle, index_address, index_length, sentence_address, sentence_length)
            if index_data != null:
                index_buffer: mutable heap void& = index_data
                SDL_free(index_buffer.cast[heap void&])
            if sentence_data != null:
                sentence_buffer: mutable heap void& = sentence_data
                SDL_free(sentence_buffer.cast[heap void&])
            if missing_explicit or result != 0:
                SDL_Log("Cannot load Scramble corpus" if missing_explicit else "Invalid Scramble corpus")
                _ = scramble_destroy(handle)
                return 0
            return handle

def sdl_create_scramble(rung: i64, trials: i64, show_count: i64, adaptive: i64, index_override: u8&?, sentence_override: u8&?) -> i64:
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return sdl_create_scramble_seeded(rung, trials, show_count, adaptive, index_override, sentence_override, 17)

export fn nw_sdl_create_scramble(rung: i64, trials: i64, show_count: i64, adaptive: i64, index_override: u8&?, sentence_override: u8&?) -> i64 = sdl_create_scramble


def scrabble_create(rung: i64, trials: i64, show_premiums: i64,
                     adaptive: i64, seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if not ScrabbleGame::allowed_rung(rung) or not ScrabbleGame::allowed_trials(trials)
        return 0 if (show_premiums != 0 and show_premiums != 1) or (adaptive != 0 and adaptive != 1)
        raw: mutable heap void&? = malloc(size_of(ScrabbleGame::ScrabbleRun).usize())
        return 0 if raw == null
        trusted Unsafe.PointerCast:
            pointer: mutable heap void& = raw
            run: mutable heap ScrabbleGame::ScrabbleRun& = pointer.cast[mutable heap ScrabbleGame::ScrabbleRun&]
            ScrabbleGame::initialize(run, rung, trials, show_premiums != 0, adaptive != 0, seed)
            return pointer.cast[u8&].uintptr().i64()

def scrabble_set_lexicon(handle: i64, pointer: i64, length: i64) -> i64:
    can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0 or pointer <= 0 or length <= 0 or length > 67108864
        trusted Unsafe.PointerCast:
            run: mutable heap ScrabbleGame::ScrabbleRun& = handle.uintptr().cast[mutable heap ScrabbleGame::ScrabbleRun&]
            text: sview = StringView{data: pointer.uintptr().cast[u8&], len: length}
            return ScrabbleGame::set_lexicon(run, text)

# A missing default lexicon is recoverable. An explicit missing file, an
# invalid read, or a rejected lexicon is an error, and every read is freed.
def sdl_load_word_index(handle: i64, explicit: u8&?, scrabble: i64) -> i64:
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            storage: mutable u8[4096] = zeroed
            path: mutable u8&? = null
            if explicit != null:
                path <- explicit.uintptr().cast[mutable u8&]
            else:
                path <- (&storage[0]).uintptr().cast[mutable u8&]
                return 0 if sdl_corpus_path(path, 4096.usize(), 0, 0) == 0.i32()
            length: mutable i64 = 0
            data: mutable heap void&? = sdl_read_corpus(path, &length)
            if data == null:
                if explicit != null or length < 0:
                    SDL_Log("Cannot load %s lexicon: %s", "Scrabble" if scrabble != 0 else "Crossword", path.uintptr().cast[cstr])
                    return -1
                return 0
            buffer: mutable heap void& = data
            address: i64 = buffer.uintptr().i64()
            result: i64 = scrabble_set_lexicon(handle, address, length) if scrabble != 0 else crossword_set_lexicon(handle, address, length)
            SDL_free(buffer.cast[heap void&])
            if result != 0:
                SDL_Log("Invalid or unreadable %s lexicon: %s", "Scrabble" if scrabble != 0 else "Crossword", path.uintptr().cast[cstr])
                return -1
            return 0

export fn nw_sdl_load_word_index(handle: i64, explicit: u8&?, scrabble: i64) -> i64 = sdl_load_word_index

