# Verify long-text rendering with an offscreen SDL software surface.
extern SDL_ReadSurfacePixel(surface: mutable void&, x: i32, y: i32, red: mutable u8&, green: mutable u8&, blue: mutable u8&, alpha: mutable u8&) -> bool

def sdl_long_text_selftest() -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 1.i32() if not SDL_Init(0.u32())
        surface: mutable void&? = SDL_CreateSurface(912.i32(), 684.i32(), 373694468.u32())
        if surface == null:
            SDL_Quit()
            return 1.i32()
        target: mutable void& = surface
        renderer: mutable void&? = SDL_CreateSoftwareRenderer(target)
        if renderer == null:
            SDL_DestroySurface(target)
            SDL_Quit()
            return 1.i32()
        canvas: mutable void& = renderer
        text: mutable u8[5000] = zeroed
        at: mutable usize = 0.usize()
        while at < 5000.usize() |at, text|:
            text[at] <- 65.u8()
            at <- at + 1.usize()
        command: mutable SDLFrame::Command = zeroed
        command.kind <- 11.u8()
        command.color <- 4294967295.u32()
        command.a <- 16.0.f32()
        command.b <- 600.0.f32()
        command.c <- 16.0.f32()
        command.len <- 5000.u32()
        frame: mutable NativeDisplayDecode::Frame = zeroed
        events: mutable SDLFrame::Events = zeroed
        view: mutable f32[4] = zeroed
        painted: mutable bool = false
        trusted Unsafe.PointerCast:
            frame.commands <- (&command).uintptr().usize()
            frame.count <- 1.u32()
            frame.pool <- (&text[0]).uintptr().usize()
            frame.pool_len <- 5000.u32()
            SDLGeometry::setup((&view[0]).uintptr().cast[mutable f32&], 912.i32(), 684.i32())
            _ = SDL_SetRenderDrawColor(canvas, 0.u8(), 0.u8(), 0.u8(), 255.u8())
            _ = SDL_RenderClear(canvas)
            SDLFrame::render(canvas, (&view[0]).uintptr().cast[f32&], (&frame).uintptr().cast[NativeDisplayDecode::Frame&], (&events).uintptr().cast[mutable SDLFrame::Events&])
            _ = SDL_RenderPresent(canvas)
            y: mutable i32 = 0.i32()
            while y < 150.i32() and not painted |y, target, painted|:
                x: mutable i32 = 0.i32()
                while x < 160.i32() and not painted |x, y, target, painted|:
                    red: mutable u8 = 0.u8()
                    green: mutable u8 = 0.u8()
                    blue: mutable u8 = 0.u8()
                    alpha: mutable u8 = 0.u8()
                    if SDL_ReadSurfacePixel(target, x, y, (&red).uintptr().cast[mutable u8&], (&green).uintptr().cast[mutable u8&], (&blue).uintptr().cast[mutable u8&], (&alpha).uintptr().cast[mutable u8&]) and (red != 0.u8() or green != 0.u8() or blue != 0.u8()):
                        painted <- true
                    x <- x + 1.i32()
                y <- y + 1.i32()
        SDL_DestroyRenderer(canvas)
        SDL_DestroySurface(target)
        SDL_Quit()
        if painted: _ = printf("SDL long text selftest: PASS\n")
        else: _ = printf("SDL long text selftest: FAILED\n")
        return 0.i32() if painted else 1.i32()

export fn nw_sdl_long_text_selftest() -> i32 = sdl_long_text_selftest

# Decode and inspect the same title frames as the SDL renderer, including
# text-pool bounds and first/last-frame diagnostic output.
# Print the Python shell's canonical command representation.
def sdl_dump_command(command: heap SDLFrame::Command&, frame: NativeDisplayDecode::Frame&) -> i32:
    can Console.Write, Abort.Panic, Unsafe.PointerCast:
        kind: i64 = command.kind.i64()
        if kind == 11 or kind == 14:
            size: u32 = command.len & 16777215.u32()
            return 0.i32() if command.ref.u64() + size.u64() > frame.pool_len.u64()
            trusted Unsafe.PointerCast:
                content: cstr = (frame.pool + command.ref.usize()).cast[cstr]
                if kind == 14:
                    _ = printf("  marker text=%.*s\n", size.i32(), content)
                else:
                    anchor_code: u32 = command.len >> 24
                    return 0.i32() if anchor_code > 8.u32()
                    anchor: mutable cstr = "left_bottom"
                    anchor <- "center_bottom" if anchor_code == 1.u32()
                    anchor <- "right_bottom" if anchor_code == 2.u32()
                    anchor <- "left_center" if anchor_code == 3.u32()
                    anchor <- "center_center" if anchor_code == 4.u32()
                    anchor <- "right_center" if anchor_code == 5.u32()
                    anchor <- "left_top" if anchor_code == 6.u32()
                    anchor <- "center_top" if anchor_code == 7.u32()
                    anchor <- "right_top" if anchor_code == 8.u32()
                    r: u32 = command.color
                    _ = printf("  text anchor=%s bold=%s color=%u:%u:%u:%u size=%.4f text=%.*s x=%.4f y=%.4f\n", anchor, "True" if command.d != 0.0.f32() else "False", r >> 24, (r >> 16) & 255.u32(), (r >> 8) & 255.u32(), r & 255.u32(), command.c.f64(), size.i32(), content, command.a.f64(), command.b.f64())
                return 1.i32()
        r: u32 = command.color
        if kind == 1:
            rotation: mutable f32 = 0.0.f32()
            trusted Unsafe.PointerCast:
                bits: u32 = command.ref
                value: f32& = (&bits).uintptr().cast[f32&]
                rotation <- value[0]
            _ = printf("  rect anchor_x=%.4f anchor_y=%.4f color=%u:%u:%u:%u h=%.4f rotation=%.4f w=%.4f x=%.4f y=%.4f\n", command.e.f64(), command.f.f64(), r >> 24, (r >> 16) & 255.u32(), (r >> 8) & 255.u32(), r & 255.u32(), command.d.f64(), rotation.f64(), command.c.f64(), command.a.f64(), command.b.f64())
            return 1.i32()
        if kind == 2:
            _ = printf("  bordered_rect border=%u:%u:%u:%u border_width=%.4f color=%u:%u:%u:%u h=%.4f w=%.4f x=%.4f y=%.4f\n", command.ref >> 24, (command.ref >> 16) & 255.u32(), (command.ref >> 8) & 255.u32(), command.ref & 255.u32(), command.e.f64(), r >> 24, (r >> 16) & 255.u32(), (r >> 8) & 255.u32(), r & 255.u32(), command.d.f64(), command.c.f64(), command.a.f64(), command.b.f64())
            return 1.i32()
        if kind == 3:
            _ = printf("  box color=%u:%u:%u:%u h=%.4f thickness=%.4f w=%.4f x=%.4f y=%.4f\n", r >> 24, (r >> 16) & 255.u32(), (r >> 8) & 255.u32(), r & 255.u32(), command.d.f64(), command.e.f64(), command.c.f64(), command.a.f64(), command.b.f64())
            return 1.i32()
        if kind == 4:
            _ = printf("  circle color=%u:%u:%u:%u radius=%.4f x=%.4f y=%.4f\n", r >> 24, (r >> 16) & 255.u32(), (r >> 8) & 255.u32(), r & 255.u32(), command.c.f64(), command.a.f64(), command.b.f64())
            return 1.i32()
        if kind == 5:
            _ = printf("  arc color=%u:%u:%u:%u radius=%.4f start_angle=%.4f sweep=%.4f x=%.4f y=%.4f\n", r >> 24, (r >> 16) & 255.u32(), (r >> 8) & 255.u32(), r & 255.u32(), command.c.f64(), command.e.f64(), command.f.f64(), command.a.f64(), command.b.f64())
            return 1.i32()
        if kind == 6:
            _ = printf("  line color=%u:%u:%u:%u width=%.4f x1=%.4f x2=%.4f y1=%.4f y2=%.4f\n", r >> 24, (r >> 16) & 255.u32(), (r >> 8) & 255.u32(), r & 255.u32(), command.e.f64(), command.a.f64(), command.c.f64(), command.b.f64(), command.d.f64())
            return 1.i32()
        if kind == 7:
            _ = printf("  triangle color=%u:%u:%u:%u x1=%.4f x2=%.4f x3=%.4f y1=%.4f y2=%.4f y3=%.4f\n", r >> 24, (r >> 16) & 255.u32(), (r >> 8) & 255.u32(), r & 255.u32(), command.a.f64(), command.c.f64(), command.e.f64(), command.b.f64(), command.d.f64(), command.f.f64())
            return 1.i32()
        if kind == 8:
            _ = printf("  polygon color=%u:%u:%u:%u points=%u\n", r >> 24, (r >> 16) & 255.u32(), (r >> 8) & 255.u32(), r & 255.u32(), command.len)
            return 1.i32()
        if kind == 9:
            _ = printf("  poly_point x=%.4f y=%.4f\n", command.a.f64(), command.b.f64())
            return 1.i32()
        if kind == 10:
            _ = printf("  sprite asset=%u color=%u:%u:%u:%u image_h=%u image_w=%u rotation=%.4f scale=%.4f x=%.4f y=%.4f\n", command.ref, r >> 24, (r >> 16) & 255.u32(), (r >> 8) & 255.u32(), r & 255.u32(), command.f.u32(), command.d.u32(), command.e.f64(), command.c.f64(), command.a.f64(), command.b.f64())
            return 1.i32()
        if kind == 12:
            _ = printf("  verdict verdict=%u\n", command.ref)
            return 1.i32()
        if kind == 13:
            _ = printf("  sound asset=%u gain=%.4f\n", command.ref, command.a.f64())
            return 1.i32()
        if kind == 15:
            _ = printf("  sprite_fit asset=%u color=%u:%u:%u:%u room_h=%.4f room_w=%.4f rotation=%.4f x=%.4f y=%.4f\n", command.ref, r >> 24, (r >> 16) & 255.u32(), (r >> 8) & 255.u32(), r & 255.u32(), command.d.f64(), command.c.f64(), command.e.f64(), command.a.f64(), command.b.f64())
            return 1.i32()
        if kind == 16:
            _ = printf("  multiline color=%u:%u:%u:%u points=%u thickness=%.4f x=%.4f y=%.4f\n", r >> 24, (r >> 16) & 255.u32(), (r >> 8) & 255.u32(), r & 255.u32(), command.len, command.c.f64(), command.a.f64(), command.b.f64())
            return 1.i32()
        if kind == 17:
            _ = printf("  star color=%u:%u:%u:%u inner=%.4f outer=%.4f rotation=%.4f spikes=%u x=%.4f y=%.4f\n", r >> 24, (r >> 16) & 255.u32(), (r >> 8) & 255.u32(), r & 255.u32(), command.d.f64(), command.c.f64(), command.f.f64(), command.e.u32(), command.a.f64(), command.b.f64())
            return 1.i32()
        _ = printf("  unknown_%lld\n", kind)
        return 1.i32()

def sdl_dump_frame(data: u8&?, length: i64) -> i32:
    can Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 0.i32() if length <= 0
        scratch: mutable u8[NativeDisplayDecode::DESKTOP_SCRATCH_BYTES] = zeroed
        frame: mutable NativeDisplayDecode::Frame = zeroed
        trusted Unsafe.PointerCast:
            decoded: mutable i32 = NativeDisplayDecode::decode_view(data, length.usize(), &frame)
            if decoded == 0.i32():
                decoded <- NativeDisplayDecode::decode(data, length.usize(), (&scratch[0]).uintptr().cast[mutable u8&], NativeDisplayDecode::DESKTOP_COMMANDS.usize(), &frame)
            return 0.i32() if decoded == 0.i32()
            at: mutable i64 = 0
            while at < frame.count.i64() |at, frame|:
                command: heap SDLFrame::Command& = (frame.commands.i64() + at * 40).uintptr().cast[heap SDLFrame::Command&]
                return 0.i32() if sdl_dump_command(command, &frame) == 0.i32()
                at <- at + 1
            return 1.i32()

export fn nw_sdl_dump_frame(data: u8&?, length: i64) -> i32 = sdl_dump_frame

def sdl_dump_menu(screen: i64, trial: i64, count: i64, black: i64) -> i32:
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 0.i32() if count <= 0
        buffer: i64 = frame_alloc(65536)
        return 1.i32() if buffer == 0
        status: mutable i32 = 0.i32()
        banner: mutable i64 = trial - 1
        at: mutable i64 = 0
        trusted Unsafe.PointerCast:
            while at < count and status == 0.i32() |at, count, status, buffer, banner, black, screen|:
                length: mutable i64 = 0
                if screen == 1:
                    length <- taskhub_write(buffer, 65536, 0, 0, black, 912, 684)
                    _ = printf("# state=(0, 0, 0) bytes=%lld\n", length)
                else:
                    length <- title_write(buffer, 65536, banner, black, 1, 1)
                    _ = printf("# state=(%lld,) bytes=%lld\n", banner, length)
                status <- 1.i32() if sdl_dump_frame(buffer.uintptr().cast[u8&], length) == 0.i32()
                banner <- (banner + 1) % 4
                at <- at + 1
        frame_free(buffer)
        return status

export fn nw_sdl_dump_menu(screen: i64, trial: i64, count: i64, black: i64) -> i32 = sdl_dump_menu

