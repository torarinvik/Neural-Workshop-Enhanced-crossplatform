            args[3] <- n3.uintptr().usize()
            args[4] <- n4.uintptr().usize()
            args[5] <- n5.uintptr().usize()
            good <- false if numberology_options_parse(6, argv, number, lexicon, 0) != 0.i32() or numberology[0] != 10000 or numberology[1] != 3 or numberology[3] != 0
            numberology_modify_option(number, 0, 1)
            numberology_modify_option(number, 1, 1)
            numberology_modify_option(number, 2, 1)
            good <- false if numberology[0] != 10001 or numberology[1] != 5 or numberology[3] != 1
