extern SDL_SetStringProperty(properties: u32, name: cstr, value: cstr) -> bool

def sdl_debug_phase(phase: i64, active: cstr, third: cstr, fourth: cstr, fifth: cstr) -> cstr:
    return "ready" if phase == 0
    return active if phase == 1
    return third if phase == 2
    return fourth if phase == 3
    return fifth if phase == 4
    return "unknown"

def sdl_debug_task_summary(label: mutable u8&, screen: i64, handle: i64) -> i32:
    can Abort.Panic, Unsafe.PointerCast:
        if screen == 2:
            phase: i64 = you_are_here_info(handle, 0)
            name: cstr = sdl_debug_phase(phase, "walking", "solved", "done", "unavailable")
            return SDL_snprintf(label, 128.usize(), "3D Maze %s - steps %lld - facing %lld - ",
                name, you_are_here_info(handle, 6), you_are_here_info(handle, 5))
        if screen == 3:
            return SDL_snprintf(label, 128.usize(), "Sokoban - phase %lld - pushes %lld - moves %lld - ",
                sokoban_info(handle, 0), sokoban_info(handle, 5), sokoban_info(handle, 6))
        if screen == 4:
            return SDL_snprintf(label, 128.usize(), "Monkey Ladder - phase %lld - length %lld - ",
                monkey_ladder_info(handle, 0), monkey_ladder_info(handle, 4))
        if screen == 5:
            return SDL_snprintf(label, 128.usize(), "3D N-Back - phase %lld - trial %lld - hits %lld - misses %lld - ",
                nback3d_info(handle, 0), nback3d_info(handle, 2), nback3d_info(handle, 9), nback3d_info(handle, 10))
        if screen == 8:
            name: cstr = sdl_debug_phase(count_info(handle, 0), "showing", "hidden", "feedback", "done")
            return SDL_snprintf(label, 128.usize(), "Count %s - trial %lld/%lld - right %lld - ",
                name, count_info(handle, 3), count_info(handle, 4), count_info(handle, 5))
        if screen == 9:
            phase: i64 = mr_time_info(handle, 0)
            name: cstr = "feedback" if phase == 5 else ("done" if phase == 6 else sdl_debug_phase(phase, "showing", "waiting", "asking", "counting"))
            return SDL_snprintf(label, 128.usize(), "Mr. Time %s - trial %lld/%lld - right %lld - ",
                name, mr_time_info(handle, 4), mr_time_info(handle, 5), mr_time_info(handle, 6))
        if screen == 10:
            name: cstr = sdl_debug_phase(graph_mapping_info(handle, 0), "asking", "hidden", "feedback", "done")
            return SDL_snprintf(label, 128.usize(), "Graph Mapping %s - trial %lld/%lld - right %lld - ",
                name, graph_mapping_info(handle, 4), graph_mapping_info(handle, 5), graph_mapping_info(handle, 6))
        if screen == 11:
            name: cstr = sdl_debug_phase(matrix_reasoning_info(handle, 0), "asking", "hidden", "feedback", "done")
            return SDL_snprintf(label, 128.usize(), "Matrix Reasoning %s - trial %lld/%lld - right %lld - ",
                name, matrix_reasoning_info(handle, 2), matrix_reasoning_info(handle, 3), matrix_reasoning_info(handle, 8))
        if screen == 20 or screen == 21 or screen == 22:
            phase: i64 = algebra_info(handle, 0) if screen == 20 else (syllogism_info(handle, 0) if screen == 21 else numberology_info(handle, 0))
            name: cstr = "ready" if phase == 0 else ("asking" if phase == 1 and screen == 21 else ("working" if phase == 1 else ("judged" if phase == 2 else ("done" if phase == 3 else "unknown"))))
            if screen == 20:
                return SDL_snprintf(label, 128.usize(), "Algebra %s - trial %lld/%lld - right %lld - typed %lld - ",
                    name, algebra_info(handle, 2), algebra_info(handle, 3), algebra_info(handle, 8), algebra_info(handle, 5))
            if screen == 21:
                return SDL_snprintf(label, 128.usize(), "Syllogisms %s - question %lld/%lld - right %lld - ",
                    name, syllogism_info(handle, 2), syllogism_info(handle, 3), syllogism_info(handle, 8))
            return SDL_snprintf(label, 128.usize(), "Numberology %s - trial %lld/%lld - right %lld - level %lld - ",
                name, numberology_info(handle, 2), numberology_info(handle, 3), numberology_info(handle, 10), numberology_info(handle, 1))
        if screen == 23:
            name: cstr = sdl_debug_phase(jigsaw_info(handle, 0), "solving", "solved", "done", "unknown")
            return SDL_snprintf(label, 128.usize(), "Jigsaw %s - puzzle %lld/%lld - swaps %lld - ",
                name, jigsaw_info(handle, 3), jigsaw_info(handle, 4), jigsaw_info(handle, 6))
        if screen == 24:
            name: cstr = sdl_debug_phase(sudoku_info(handle, 0), "solving", "solved", "done", "unknown")
            return SDL_snprintf(label, 128.usize(), "Sudoku %s - cursor %lld - mistakes %lld - ",
                name, sudoku_info(handle, 7), sudoku_info(handle, 9))
        if screen == 25:
            name: cstr = sdl_debug_phase(go_info(handle, 0), "solving", "judged", "done", "unknown")
            return SDL_snprintf(label, 128.usize(), "Go %s - trial %lld/%lld - correct %lld - ",
                name, go_info(handle, 2), go_info(handle, 3), go_info(handle, 7))
        if screen == 26:
            name: cstr = sdl_debug_phase(crossed_wires_info(handle, 0), "playing", "scored", "done", "unknown")
            return SDL_snprintf(label, 128.usize(), "Crossed Wires %s - round %lld/%lld - targets %lld/%lld - right %lld - ",
                name, crossed_wires_info(handle, 2), crossed_wires_info(handle, 3),
                crossed_wires_info(handle, 16), crossed_wires_info(handle, 12), crossed_wires_info(handle, 19))
        if screen == 27:
            return SDL_snprintf(label, 128.usize(), "Scrabble - board %lld/%lld - score %lld - ",
                scrabble_info(handle, 2), scrabble_info(handle, 3), scrabble_info(handle, 5))
        if screen == 28:
            return SDL_snprintf(label, 128.usize(), "Scramble - line %lld/%lld - right %lld - ",
                scramble_info(handle, 2), scramble_info(handle, 3), scramble_info(handle, 7))
        if screen == 29:
            return SDL_snprintf(label, 128.usize(), "Crossword - puzzle %lld/%lld - solved %lld - ",
                crossword_info(handle, 2), crossword_info(handle, 3), crossword_info(handle, 9))
        if screen == 7:
            name: cstr = sdl_debug_phase(tetris_info(handle, 0), "playing", "done", "unknown", "unknown")
            return SDL_snprintf(label, 128.usize(), "Freeform Tetris %s - piece %lld/%lld - score %lld - slot %lld - ",
                name, tetris_info(handle, 2), tetris_info(handle, 2) + tetris_info(handle, 8), tetris_info(handle, 3), tetris_info(handle, 4) + 1)
        if screen == 12:
            name: cstr = sdl_debug_phase(in_the_dark_info(handle, 0), "walking", "asking", "scored", "done")
            return SDL_snprintf(label, 128.usize(), "In the Dark %s - trial %lld/%lld - right %lld - ",
                name, in_the_dark_info(handle, 2), in_the_dark_info(handle, 3), in_the_dark_info(handle, 10))
        if screen == 13:
            name: cstr = sdl_debug_phase(fog_info(handle, 0), "exploring", "finished", "done", "unknown")
            return SDL_snprintf(label, 128.usize(), "Fog of War %s - world %lld/%lld - moves %lld/%lld - ",
                name, fog_info(handle, 1), fog_info(handle, 2), fog_info(handle, 4), fog_info(handle, 5))
        if screen == 14:
            name: cstr = sdl_debug_phase(removals_info(handle, 0), "moving", "asking", "scored", "done")
            return SDL_snprintf(label, 128.usize(), "Removals %s - trial %lld/%lld - right %lld - ",
                name, removals_info(handle, 2), removals_info(handle, 3), removals_info(handle, 14))
        if screen == 15:
            name: cstr = sdl_debug_phase(custody_info(handle, 0), "marking", "running", "scored", "done")
            return SDL_snprintf(label, 128.usize(), "Chain of Custody %s - trial %lld/%lld - rung %lld - actions %lld - ",
                name, custody_info(handle, 2), custody_info(handle, 3), custody_info(handle, 1), custody_info(handle, 10))
        if screen == 16:
            name: cstr = sdl_debug_phase(concentration_info(handle, 0), "peek", "playing", "done", "unknown")
            return SDL_snprintf(label, 128.usize(), "Concentration %s - cursor %lld - pairs %lld/%lld - turns %lld - ",
                name, concentration_info(handle, 9), concentration_info(handle, 7), concentration_info(handle, 1), concentration_info(handle, 4))
        if screen == 17:
            name: cstr = sdl_debug_phase(recognition_info(handle, 0), "showing", "hidden", "feedback", "done")
            return SDL_snprintf(label, 128.usize(), "Seen It Before? %s - trial %lld/%lld - hits %lld - misses %lld - ",
                name, recognition_info(handle, 2), recognition_info(handle, 1), recognition_info(handle, 13), recognition_info(handle, 14))
        if screen == 18:
            name: cstr = sdl_debug_phase(trivia_info(handle, 0), "asking", "judged", "done", "unknown")
            return SDL_snprintf(label, 128.usize(), "Trivia %s - trial %lld/%lld - level %lld - right %lld - ",
                name, trivia_info(handle, 3), trivia_info(handle, 4), trivia_info(handle, 2), trivia_info(handle, 10))
        if screen == 19:
            name: cstr = sdl_debug_phase(reflex_info(handle, 0), "running", "done", "unknown", "unknown")
            return SDL_snprintf(label, 128.usize(), "Reflex %s - targets %lld/%lld - hits %lld - misses %lld - ",
                name, reflex_info(handle, 2), reflex_info(handle, 1), reflex_info(handle, 9), reflex_info(handle, 10))
        if screen == 31:
            name: cstr = "done" if tracking_info(handle, 0) == 5 else sdl_debug_phase(tracking_info(handle, 0), "cueing", "tracking", "picking", "revealing")
            return SDL_snprintf(label, 128.usize(), "Moving Targets %s - round %lld/%lld - ",
                name, tracking_info(handle, 8), tracking_info(handle, 5))
        if screen == 32:
            name: cstr = sdl_debug_phase(lookout_info(handle, 0), "watching", "feedback", "done", "unknown")
            return SDL_snprintf(label, 128.usize(), "Lookout %s - cue %lld/%lld - hits %lld - misses %lld - false alarms %lld - ",
                name, lookout_info(handle, 8), lookout_info(handle, 6), lookout_info(handle, 11), lookout_info(handle, 12), lookout_info(handle, 13))
        if screen == 33:
            name: cstr = sdl_debug_phase(pursuit_info(handle, 0), "chasing", "feedback", "done", "unknown")
            return SDL_snprintf(label, 128.usize(), "Pursuit %s - round %lld/%lld - on target %lld%% - ",
                name, pursuit_info(handle, 11), pursuit_info(handle, 9), pursuit_info(handle, 20))
        if screen == 34:
            name: cstr = sdl_debug_phase(out_of_sight_info(handle, 0), "cueing", "tracking", "revealing", "done")
            return SDL_snprintf(label, 128.usize(), "Out of Sight %s - round %lld/%lld - held %lld - hits %lld - wrong %lld - ",
                name, out_of_sight_info(handle, 10), out_of_sight_info(handle, 9), out_of_sight_info(handle, 11), out_of_sight_info(handle, 12), out_of_sight_info(handle, 13))
        if screen == 35:
            name: cstr = sdl_debug_phase(buzz_wire_info(handle, 0), "running", "feedback", "done", "unknown")
            return SDL_snprintf(label, 128.usize(), "Buzz Wire %s - trial %lld/%lld - along %lld%% - buzzes %lld/%lld - ",
                name, buzz_wire_info(handle, 3), buzz_wire_info(handle, 4), buzz_wire_info(handle, 8), buzz_wire_info(handle, 7), buzz_wire_info(handle, 6))
        if screen == 36:
            name: cstr = sdl_debug_phase(donkey_info(handle, 0), "setting", "running", "scored", "done")
            return SDL_snprintf(label, 128.usize(), "Donkey %s - trial %lld/%lld - road %lld rows - passed %lld - hits %lld - ",
                name, donkey_info(handle, 2), donkey_info(handle, 3), donkey_info(handle, 4), donkey_info(handle, 11), donkey_info(handle, 12))
        if screen == 37:
            name: cstr = sdl_debug_phase(two_hands_info(handle, 0), "setting", "running", "scored", "done")
            return SDL_snprintf(label, 128.usize(), "Two Hands %s - trial %lld/%lld - road %lld rows - points %lld - hit %lld - ",
                name, two_hands_info(handle, 2), two_hands_info(handle, 3), two_hands_info(handle, 4), two_hands_info(handle, 20), two_hands_info(handle, 15))
        if screen == 38:
            name: cstr = sdl_debug_phase(overrun_info(handle, 0), "typing", "settled", "done", "unknown")
            return SDL_snprintf(label, 128.usize(), "Overrun %s - wave %lld/%lld - cleared %lld - lives %lld - ",
                name, overrun_info(handle, 2), overrun_info(handle, 3), overrun_info(handle, 7), overrun_info(handle, 10))
        if screen == 30:
            name: cstr = sdl_debug_phase(ncup_monte_info(handle, 0), "reveal", "shuffle", "guess", "result")
            return SDL_snprintf(label, 128.usize(), "N-Cup Monte %s - cups %lld - ",
                name, ncup_monte_info(handle, 1))
        return 0.i32()

def sdl_desktop_debug_summary(renderer: mutable void&, rows: usize&, trial: i64, hub: i64, category: i64, selected: i64, physics: usize):
    can Abort.Panic, Unsafe.PointerCast:
        return if not sdl_debug_hud_enabled()
        label: mutable u8[128] = zeroed
        size: mutable i32 = 0.i32()
        marble: i64 = sdl_active_handle(rows, 4.usize())
        if marble != 0:
            phase: i64 = marble_info(marble, 0)
            name: cstr = "ready" if phase == 0 else ("running" if phase == 1 else ("feedback" if phase == 2 else ("preparing" if phase == 3 else "done")))
            engine: cstr = "MuJoCo 3D" if physics != 0.usize() else "2D fallback"
            size <- SDL_snprintf(&label[0], 128.usize(), "Marble Maze %s - rung %lld - tray %lld/%lld - %s - ",
                name, marble_info(marble, 1), marble_info(marble, 2), marble_info(marble, 3), engine)
        else:
            screen: mutable i64 = hub
            for index in 0..<131 |index, rows, screen, label, size|:
                handle: i64 = sdl_active_handle(rows, index.usize())
                if handle != 0:
                    screen <- index + 4 if index >= 72 else (index + 3 if index >= 43 else (27 if index == 26 else (28 if index == 25 else index + 2)))
                    size <- sdl_debug_task_summary(&label[0], screen, handle)
                    break
            if size == 0.i32():
                if screen == 0:
                    size <- SDL_snprintf(&label[0], 128.usize(), "title banner %lld - ", (trial - 1) % 4)
                elif screen == 1:
                    size <- SDL_snprintf(&label[0], 128.usize(), "task menu - %s - %s - ",
                        TaskHubTasks::category_name(category), TaskHubTasks::task_name_all(category, selected, true))
        if size > 0.i32() and size < 128.i32():
            trusted Unsafe.PointerCast:
                _ = SDL_SetStringProperty(SDL_GetRendererProperties(renderer), "nw.debug.summary", (&label[0]).uintptr().cast[cstr])

extern SDL_GetCurrentVideoDriver() -> u8&?

def sdl_finish_camera_frame(renderer: mutable void&, data: u8&?, length: i64, width: i32, height: i32,
                            trial: i64, black: i64, surface: usize, screenshot: usize, png_writer: usize) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        shade: u8 = 0.u8() if black != 0 else 255.u8()
        return 1.i32() if not SDL_SetRenderDrawColor(renderer, shade, shade, shade, 255.u8()) or not SDL_RenderClear(renderer)
        driver: u8&? = SDL_GetCurrentVideoDriver()
        if not SDLCameraHost::failed() and driver != null and not syllogism_argument_is(driver.uintptr().i64(), "dummy"):
            if SDLCameraHost::present(renderer, width, height) < 0.i32():
                SDL_Log("Could not render Camera scene: %s", SDL_GetError())
                SDLCameraHost::record_failure()
        decoded: mutable i32 = 1.i32()
        if SDLCameraHost::failed():
            ink: u8 = 255.u8() if black != 0 else 0.u8()
            _ = SDL_SetRenderDrawColor(renderer, ink, ink, ink, 255.u8())
            _ = SDL_RenderDebugText(renderer, 24.0.f32(), height.f32() / 2.0.f32(), "Camera needs OpenGL 3.3. Press Esc to return.")
        else:
            decoded <- sdl_draw_frame_layer(renderer, data, length, width, height, trial, true)
        if decoded != 0.i32():
            sdl_publish_rendered_frame(renderer)
        if not SDL_RenderPresent(renderer):
            return 1.i32()
        trusted Unsafe.PointerCast:
            return sdl_screenshot_save(decoded, surface, screenshot.cast[cstr], png_writer) if screenshot != 0.usize()
        SDL_Delay(16.u32())
        return 1.i32() if decoded == 0.i32() else -1.i32()

def sdl_desktop_frame(state: usize&, initial_size: i32&, rows: usize&, special_rows: usize&, last_marble: mutable u64&, black: i64, capacity: i64, hub: i64, category: i64, selected: i64, writer: usize, playing: i64, step: mutable u8&, last_step: mutable u64&, trial: mutable i64&, marble_advance: usize, physics: usize, physics_tick: usize, marble_finish: usize, marble_state: usize, surface: usize, screenshot: usize, png_writer: usize) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        size: mutable i32[2] = zeroed
        size[0] <- initial_size[0]
        size[1] <- initial_size[1]
        length: mutable i64 = 0
        trusted Unsafe.PointerCast:
            window: mutable void&? = state[0].cast[mutable void&?]
            renderer: mutable void& = state[1].cast[mutable void&]
            prepared: i32 = (sdl_prepare_desktop_frame(window, (&size[0]).uintptr().cast[mutable i32&],
                rows, special_rows, last_marble, black, state[2].i64(), capacity, &length,
                hub, category, selected, writer, playing, step, last_step, trial, marble_advance, physics, physics_tick) can Global{Read,Write})
            return 1.i32() if prepared == 0.i32()
            if SDLCameraHost::options_visible():
                length <- SDLCameraHost::option_frame(state[2], capacity, black)
                return 1.i32() if length <= 0
                return sdl_finish_frame(renderer, state[2].cast[u8&?], length, size[0], size[1],
                    trial[0], black, surface, screenshot, png_writer)
            camera_handle: usize = SDLCameraHost::active()
            if camera_handle != 0.usize():
                length <- SDLCameraHost::frame(camera_handle, state[2], capacity, black, size[0], size[1])
                return 1.i32() if length <= 0
                return sdl_finish_camera_frame(renderer, state[2].cast[u8&?], length, size[0], size[1],
                    trial[0], black, surface, screenshot, png_writer)
            slot: usize&? = physics.cast[usize&?]
            session: mutable usize = 0.usize()
            if slot != null:
                active: usize& = slot
                session <- active[0]
            sdl_concentration_photos(renderer, sdl_active_handle(rows, 14.usize()))
            sdl_recognition_photo(renderer, sdl_active_handle(rows, 15.usize()))
            sdl_desktop_debug_summary(renderer, rows, trial[0], hub, category, selected, session)
            jigsaw: i64 = sdl_active_handle(rows, 21.usize())
            photo: bool = sdl_jigsaw_photo(renderer, jigsaw)
            phase: i64 = jigsaw_info(jigsaw, JigsawGame::INFO_PHASE)
            if jigsaw > 0:
                properties: u32 = SDL_GetRendererProperties(renderer)
                loader: i64 = SDL_GetNumberProperty(properties, "nw.png.loader", 0)
                video: bool = SDL_GetNumberProperty(properties, "nw.jigsaw.video", 0) != 0 or jigsaw_info(jigsaw, JigsawGame::INFO_VIDEO) == 1
                if video or phase == JigsawGame::PHASE_SOLVING or phase == JigsawGame::PHASE_SOLVED:
                    count: i64 = jigsaw_info(jigsaw, JigsawGame::INFO_PHOTO_COUNT) if video or loader != 0 else -2
                    length <- jigsaw_frame_write(state[2].i64(), capacity, jigsaw, black,
                        size[0].i64(), size[1].i64(), photo, count)
                    return 1.i32() if length <= 0
            sequence: i64 = sdl_active_handle(rows, 43.usize())
            SDLVideoSequence::prepare(renderer, sequence)
            if sequence != 0:
                length <- SDLVideoSequence::frame_write(state[2].i64(), capacity, sequence, black, size[0].i64(), size[1].i64())
                return 1.i32() if length <= 0
            next: i64 = sdl_active_handle(rows, 72.usize())
            SDLWhatNext::prepare(renderer, next)
            if next != 0:
                length <- SDLWhatNext::frame_write(state[2].i64(), capacity, next, black)
                return 1.i32() if length <= 0
            falls: i64 = sdl_active_handle(rows, 73.usize())
            if falls != 0:
                _ = SDLFalls::advance(falls, SDL_GetTicks().i64())
                length <- SDLFalls::frame_write(state[2].i64(), capacity, falls, black)
                return 1.i32() if length <= 0
            sfm: i64 = sdl_active_handle(rows, 74.usize())
            if sfm != 0:
                _ = SDLSfm::advance(sfm, SDL_GetTicks().i64())
                length <- SDLSfm::frame_write(state[2].i64(), capacity, sfm, black)
                return 1.i32() if length <= 0
            if sdl_profile_picker_open:
                length <- sdl_profile_picker_frame(state[2].i64(), capacity, black != 0)
                return 1.i32() if length <= 0
            return sdl_finish_desktop_frame(renderer, state[2].cast[u8&?], length, size[0], size[1],
                trial[0], black, surface, screenshot, png_writer, marble_finish, marble_state, session)

def sdl_desktop_frame_with_arena(arena: mutable Arena&, state: usize&, initial_size: i32&, rows: usize&, special_rows: usize&, last_marble: mutable u64&, black: i64, capacity: i64, hub: i64, category: i64, selected: i64, writer: usize, playing: i64, step: mutable u8&, last_step: mutable u64&, trial: mutable i64&, marble_advance: usize, physics: usize, physics_tick: usize, marble_finish: usize, marble_state: usize, surface: usize, screenshot: usize, png_writer: usize) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
        in arena:
            return sdl_desktop_frame(state, initial_size, rows, special_rows, last_marble, black,
                capacity, hub, category, selected, writer, playing, step, last_step, trial,
                marble_advance, physics, physics_tick, marble_finish, marble_state, surface,
                screenshot, png_writer)

def sdl_desktop_frame_replay(state: usize&, initial_size: i32&, rows: usize&, special_rows: usize&, last_marble: mutable u64&, black: i64, capacity: i64, hub: i64, category: i64, selected: i64, writer: usize, playing: i64, step: mutable u8&, last_step: mutable u64&, trial: mutable i64&, marble_advance: usize, physics: usize, physics_tick: usize, marble_finish: usize, marble_state: usize, surface: usize, screenshot: usize, png_writer: usize) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
        region scratch(2097152):
            return sdl_desktop_frame_with_arena(&scratch, state, initial_size, rows, special_rows,
                last_marble, black, capacity, hub, category, selected, writer, playing, step,
                last_step, trial, marble_advance, physics, physics_tick, marble_finish,
                marble_state, surface, screenshot, png_writer)

export fn nw_sdl_desktop_frame(state: usize&, initial_size: i32&, rows: usize&, special_rows: usize&, last_marble: mutable u64&, black: i64, capacity: i64, hub: i64, category: i64, selected: i64, writer: usize, playing: i64, step: mutable u8&, last_step: mutable u64&, trial: mutable i64&, marble_advance: usize, physics: usize, physics_tick: usize, marble_finish: usize, marble_state: usize, surface: usize, screenshot: usize, png_writer: usize) -> i32 = sdl_desktop_frame_replay

# Exit the first active task in shell precedence without closing result managers.
# Each row holds a pointer to the task handle and its active-mode flag.
# Return 0 when no task was active, 1 for an exit, or 2 to stop text input.
def sdl_exit_hub_task(rows: usize&?, taskhub: i64) -> i32:
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0.i32() if rows == null or taskhub == 0
        trusted Unsafe.PointerCast:
            pointers: usize& = rows
            index: mutable usize = 0.usize()
            while index < 142.usize() |index, pointers|:
                base: usize = index * 2.usize()
                if pointers[base] != 0.usize() and pointers[base + 1.usize()] != 0.usize():
                    h: mutable i64& = pointers[base].cast[mutable i64&]
                    mode: mutable u8& = pointers[base + 1.usize()].cast[mutable u8&]
                    if mode[0] != 0.u8():
                        slot: usize = sdl_row_slot(index)
                        handles: mutable i64[142] = zeroed
                        handles[slot] <- h[0]
                        no_syllogism: mutable usize[2] = zeroed
                        no_numberology: mutable usize[2] = zeroed
                        sdl_shutdown((&handles[0]).uintptr().cast[mutable i64&], (&no_syllogism[0]).uintptr().cast[mutable usize&], (&no_numberology[0]).uintptr().cast[mutable usize&]) can Global{Read,Write}
                        h[0] <- 0
                        mode[0] <- 0.u8()
                        return 2.i32() if index == 18.usize() or index == 20.usize() or index == 25.usize()
                        return 1.i32()
                index <- index + 1.usize()
            return 0.i32()

export fn nw_sdl_exit_hub_task(rows: usize&?, taskhub: i64) -> i32 = sdl_exit_hub_task

# Return -1 when a task owns the key, otherwise update hub navigation and
# return its selected screen ID (zero means no launch).
def sdl_hub_idle(rows: usize&?) -> bool:
    can Abort.Panic, Unsafe.PointerCast:
        return false if rows == null or SDLCameraHost::active() != 0.usize()
        trusted Unsafe.PointerCast:
            pointers: usize& = rows
            for at in 0..<131 |at, pointers|:
                address: usize = pointers[(at * 2 + 1).usize()]
                if address != 0.usize():
                    mode: u8& = address.cast[u8&]
                    return false if mode[0] != 0.u8()
            return true

def sdl_hub_key(rows: usize&?, taskhub: i64, key: i64, category: mutable i64&?, selected: mutable i64&?, options: mutable i64&?) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return -1 if taskhub == 0 or category == null or selected == null or options == null or not sdl_hub_idle(rows)
        trusted Unsafe.PointerCast:
            cat: mutable i64& = category
            row: mutable i64& = selected
            option_flag: mutable i64& = options
            value: mutable i64 = 0
            action: i64 = SDLTaskKeys::map(39, key, cat[0], row[0], TaskHubTasks::task_count_all(cat[0], SDLCameraHost::available()), (&value).uintptr().cast[mutable i64&])
            option_flag[0] <- 0
            if action == 0:
                cat[0] <- value
                row[0] <- 0
            elif action == 1:
                row[0] <- value
            elif action == 2 or action == 3:
                option_flag[0] <- 1 if action == 3 else 0
                if cat[0] == 3 and SDLCameraHost::available():
                    if row[0] == 2:
                        SDLCameraHost::open(option_flag[0] != 0)
                        return 0
                    if row[0] > 2:
                        return sdl_hub_screen_id(cat[0], row[0] - 1, option_flag[0])
                return sdl_hub_screen_id(cat[0], row[0], option_flag[0])
            return 0

export fn nw_sdl_hub_key(rows: usize&?, taskhub: i64, key: i64, category: mutable i64&?, selected: mutable i64&?, options: mutable i64&?) -> i64 = sdl_hub_key



