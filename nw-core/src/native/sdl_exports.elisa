            frame_free(buffer) if buffer != 0
            return 1.i32()
        good: mutable bool = algebra_info(handle, 0) == 0
        good <- false if algebra_action(handle, 0, 0, 0) != 1
        good <- false if algebra_info(handle, 0) != 1
        good <- false if not sdl_selftest_frame_valid(buffer, algebra_frame_write(buffer, 65536, handle, 0, 912, 684))
        good <- false if algebra_action(handle, 2, 0, 0) != 2
        good <- false if algebra_destroy(handle) != 0
        good <- false if not sdl_algebra_feedback_selftest(buffer, 5, "over 14: 6 + 7\nwhich is 13/14")
        good <- false if not sdl_algebra_feedback_selftest(buffer, 12, "the moduli are coprime, so there is one n below 1936894310792171506455569293\nafter mod 44371:  n = 40522 (mod 44371)\nafter mod 31699:  n = 1220287393 (mod 1406516329)\nafter mod 18311:  n = 21173510587830 (mod 25754720500319)\nafter mod 55661:  n = 1208793225472559776 (mod 1433533497768255859)\nafter mod 14249:  n = 4059542125407404896605 (mod 20426418809699877734891)\nafter mod 94823:  n = 1313075539886062647836894758 (mod 1936894310792171506455569293)")
        frame_free(buffer)
        if good: _ = printf("Algebra selftest: PASS\n")
        else: _ = printf("Algebra selftest: FAILED\n")
        return 0.i32() if good else 1.i32()

