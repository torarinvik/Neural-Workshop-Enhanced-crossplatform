def scramble_destroy(handle: i64) -> i64:
    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap ScrambleGame::ScrambleRun& = handle.uintptr().cast[mutable heap ScrambleGame::ScrambleRun&]
