                  preview: i64, mark_placed: i64, seed: i64, pieces: i64, video: bool = false) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if pieces == 0 and not JigsawGame::allowed_side(start_side)
        return 0 if pieces != 0 and not Jigsaw::allowed_pieces(pieces)
        return 0 if not JigsawGame::allowed_puzzles(puzzles)
        return 0 if not JigsawGame::allowed_flag(adaptive) or not JigsawGame::allowed_flag(preview) or not JigsawGame::allowed_flag(mark_placed)
        raw: mutable heap void&? = malloc(size_of(JigsawGame::JigsawRun).usize())
        return 0 if raw == null
