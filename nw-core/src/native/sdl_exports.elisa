def monkey_ladder_create(grid: i64, start_level: i64, adaptive: i64,
                         show_ms: i64, per_tile_ms: i64,
                         reveal_answer: i64, seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if grid < 3 or grid > 10 or start_level < 2 or start_level > grid * grid
        return 0 if (adaptive != 0 and adaptive != 1) or (reveal_answer != 0 and reveal_answer != 1)
        return 0 if show_ms < 0 or per_tile_ms < 0
        raw: mutable heap void&? = malloc(size_of(MonkeyLadderGame::MonkeyLadderRun).usize())
        return 0 if raw == null
        trusted Unsafe.PointerCast:
            pointer: mutable heap void& = raw
            run: mutable heap MonkeyLadderGame::MonkeyLadderRun& = pointer.cast[mutable heap MonkeyLadderGame::MonkeyLadderRun&]
            MonkeyLadderGame::initialize(run, grid, start_level, adaptive != 0, show_ms, per_tile_ms, reveal_answer != 0, seed)
            return pointer.cast[u8&].uintptr().i64()

def monkey_ladder_action(handle: i64, action: i64, value: i64, now_ms: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap MonkeyLadderGame::MonkeyLadderRun& = handle.uintptr().cast[mutable heap MonkeyLadderGame::MonkeyLadderRun&]
            MonkeyLadderGame::action(run, action, value, now_ms)
            return MonkeyLadderGame::info(run, MonkeyLadderGame::INFO_PHASE)

def monkey_ladder_info(handle: i64, field: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: heap MonkeyLadderGame::MonkeyLadderRun& = handle.uintptr().cast[heap MonkeyLadderGame::MonkeyLadderRun&]
            return MonkeyLadderGame::info(run, field)

def monkey_ladder_frame_write(dest: i64, capacity: i64, handle: i64,
                              black_background: i64, width: i64, height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if dest <= 0 or capacity <= 0 or handle <= 0
        trusted Unsafe.PointerCast:
            run: heap MonkeyLadderGame::MonkeyLadderRun& = handle.uintptr().cast[heap MonkeyLadderGame::MonkeyLadderRun&]
            sequence: mutable darray[i64] = Ints::zeros(run.length)
            for at in 0..<run.length |run, sequence|:
                Ints::put(&sequence, at, run.sequence[at.usize()])
            paint: SceneMonkeyLadder::MonkeyLadderPaint = SceneMonkeyLadder::paint_of(black_background != 0, width.f64(), height.f64(), width.f64() / Display::REFERENCE_WIDTH, height.f64() / Display::REFERENCE_HEIGHT)
            list: mutable Display::DisplayList = Display::DisplayList()
            message: mutable dstr = []
            dstr_append_cstr(&message, "Remember the order" if run.phase == MonkeyLadderGame::PHASE_SHOW else ("Click 1 through " if run.phase == MonkeyLadderGame::PHASE_INPUT else ("Correct" if run.phase == MonkeyLadderGame::PHASE_RESULT and run.wrong < 0 else ("Miss" if run.phase == MonkeyLadderGame::PHASE_RESULT else "Press Space to watch the numbers"))))
            if run.phase == MonkeyLadderGame::PHASE_INPUT:
                dstr_append_i64(&message, run.length)
            SceneMonkeyLadder::render(&list, &paint, &sequence, run.length, run.grid, run.phase, run.level, run.clicked_n, run.wrong, run.cursor_cell, run.cursor_enabled, run.reveal_answer, bytes_view(message))
            encoded: darray[u8] = Display::encode_binary(&list)
            length: i64 = encoded.count.i64()
            return 0 if length <= 0 or length > capacity
            target: mutable u8& = dest.uintptr().cast[mutable u8&]
            memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            return length

def monkey_ladder_destroy(handle: i64) -> i64:
    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            heap_pointer: heap void& = handle.uintptr().cast[heap void&]
            free(heap_pointer)
            return 0

