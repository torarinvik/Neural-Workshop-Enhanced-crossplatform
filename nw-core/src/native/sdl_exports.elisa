    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: heap BuzzWireGame::BuzzWireRun& = handle.uintptr().cast[heap BuzzWireGame::BuzzWireRun&]
            return BuzzWireGame::info(run, field)

def buzz_wire_value(handle: i64, field: i64, at: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: heap BuzzWireGame::BuzzWireRun& = handle.uintptr().cast[heap BuzzWireGame::BuzzWireRun&]
