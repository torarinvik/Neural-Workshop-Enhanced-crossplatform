def sdl_dump_puzzle(screen: i64, options: i64&?, seed: i64, count: i64, black: i64, adaptive: i64, lexicon: u8&?, index: u8&?, sentences: u8&?) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        handle: mutable i64 = 0
        if screen == 2 or screen == 3 or screen == 6:
            handle <- sdl_create_maze(screen, options)
        elif (screen >= 20 and screen <= 22) or (screen >= 27 and screen <= 29):
            handle <- (sdl_screen_create_seeded(screen, options, lexicon, index, sentences, seed) can Global{Read,Write})
        else:
            handle <- (sdl_create_puzzle(screen, options, seed, count, adaptive) can Global{Read,Write})
        fields: mutable i64 = 27
        if screen <= 4: fields <- 3
        elif screen == 5: fields <- 20
        elif screen == 6: fields <- 13
        elif screen == 7: fields <- 9
        elif screen == 8: fields <- 16
        elif screen == 9: fields <- 20
        elif screen == 10 or screen == 11: fields <- 22
        elif screen == 12 or screen == 15: fields <- 23
        elif screen == 13: fields <- 20
        elif screen == 14: fields <- 21
        elif screen == 16: fields <- 16
        elif screen == 17 or screen == 19: fields <- 19
        elif screen == 18: fields <- 17
        elif screen == 23 or screen == 45: fields <- 16
        elif screen == 24: fields <- 21
        elif screen == 25: fields <- 13
        elif screen == 30: fields <- 21
        elif screen == 31: fields <- 19
        elif screen == 32: fields <- 21
        elif screen == 33: fields <- 25
        elif screen == 34: fields <- 30
        elif screen == 35: fields <- 29
        elif screen == 36: fields <- 27
        elif screen == 37: fields <- 36
        elif screen == 38: fields <- 21
        elif screen == 39: fields <- 15
        elif screen == 40: fields <- 21
        elif screen == 46: fields <- 4
        elif screen == 55: fields <- 14
        elif screen == 57: fields <- 14
        elif screen == 58: fields <- 14
        elif screen == 59: fields <- 14
        elif screen == 60: fields <- 14
        elif screen == 56: fields <- 14
        elif screen == 54: fields <- 15
        elif screen == 53: fields <- 18
        elif screen == 52: fields <- 16
        elif screen == 61: fields <- 12
        elif screen == 62: fields <- 14
        elif screen == 63: fields <- 13
        elif screen == 64: fields <- 16
        elif screen == 65: fields <- 16
        elif screen == 66: fields <- 15
        elif screen == 67: fields <- 17
        elif screen == 68: fields <- 16
        elif screen == 69: fields <- 16
        elif screen == 70: fields <- 14
        elif screen == 71: fields <- 14
        elif screen == 72: fields <- 14
        elif screen == 73: fields <- 14
        elif screen == 77: fields <- 7
        elif screen == 78: fields <- 7
        elif screen == 79: fields <- 14
        elif screen == 80: fields <- 14
        elif screen == 81: fields <- 13
        elif screen == 82: fields <- 9
        elif screen == 83: fields <- 12
        elif screen == 84: fields <- 14
        elif screen == 85: fields <- 14
        elif screen == 86: fields <- 11
        elif screen == 87: fields <- 15
        elif screen == 88: fields <- 10
        elif screen == 89: fields <- 12
        elif screen == 90: fields <- 10
        elif screen == 91: fields <- 10
        elif screen == 92: fields <- 12
        elif screen == 93: fields <- 12
        elif screen == 94: fields <- 12
        elif screen == 95: fields <- 12
        elif screen == 96: fields <- 12
        elif screen == 97: fields <- 12
        elif screen == 98: fields <- 12
        elif screen == 99: fields <- 15
        elif screen == 100: fields <- 15
        elif screen == 101: fields <- 18
        elif screen == 102: fields <- 20
        elif screen == 103: fields <- 17
        elif screen == 104: fields <- 20
        elif screen == 105: fields <- 18
        elif screen == 106: fields <- 14
        elif screen == 107: fields <- 12
        # The reading quizzes all report 13 fields; one branch keeps the
        # chain inside the compiler's nesting limit.
        elif (screen >= 108 and screen <= 111) or (screen >= 130 and screen <= 139): fields <- 13
        elif screen == 112: fields <- 15
        elif screen == 113: fields <- 15
        elif screen == 114: fields <- 16
        elif screen == 115: fields <- 17
        elif screen == 116: fields <- 19
        elif screen == 117: fields <- 17
        elif screen == 118: fields <- 18
        elif screen == 119: fields <- 18
        elif screen == 120: fields <- 18
        elif screen == 121: fields <- 18
        elif screen == 122: fields <- 18
        elif screen == 123: fields <- 18
        elif screen == 124: fields <- 18
        elif screen == 125: fields <- 18
        elif screen == 126: fields <- 18
        elif screen == 127: fields <- 18
        elif screen == 128: fields <- 18
        elif screen == 129: fields <- 18
        elif screen == 76: fields <- 7
        elif screen == 74: fields <- 14
        elif screen == 51: fields <- 17
        elif screen == 50: fields <- 12
        elif screen == 49: fields <- 10
        elif screen == 47 or screen == 48: fields <- 9
        elif screen == 41: fields <- 19
        elif screen == 42: fields <- 24
        elif screen == 43: fields <- 25
        elif screen == 44: fields <- 14
        elif screen == 20: fields <- 10
        elif screen == 21: fields <- 14
        elif screen == 22: fields <- 14
        elif screen == 27: fields <- 19
        elif screen == 28: fields <- 17
        elif screen == 29: fields <- 20
        elif screen == 145: fields <- 16
        return 1.i32() if handle <= 0
        if count <= 0:
            _ = (sdl_dump_puzzle_destroy(screen, handle) can Global{Read,Write})
            return 0.i32()
        buffer: i64 = frame_alloc(NativeDisplayDecode::DESKTOP_FRAME_BYTES if screen == 23 or screen == 41 or screen == 42 or screen == 43 or screen == 45 or screen == 82 or screen == 87 or screen == 88 or screen == 89 or screen == 90 or screen == 91 or screen == 92 or screen == 93 or screen == 94 or screen == 95 or screen == 96 or screen == 97 or screen == 98 or screen == 99 or screen == 100 or screen == 101 or screen == 102 or screen == 103 or screen == 104 or screen == 105 or screen == 106 or screen == 107 or screen == 108 or screen == 109 or screen == 134 or screen == 135 or screen == 137 or screen == 138 or screen == 139 or screen == 140 or screen == 141 or screen == 142 or screen == 143 or screen == 144 or screen == 145 or screen == 136 or screen == 133 or screen == 132 or screen == 131 or screen == 130 or screen == 110 or screen == 111 or screen == 112 or screen == 113 or screen == 114 or screen == 115 or screen == 116 or screen == 117 or screen == 118 or screen == 119 or screen == 120 or screen == 121 or screen == 122 or screen == 123 or screen == 124 or screen == 125 or screen == 126 or screen == 127 or screen == 128 or screen == 129 else 65536)
        if buffer == 0:
            _ = (sdl_dump_puzzle_destroy(screen, handle) can Global{Read,Write})
            return 1.i32()
        status: mutable i32 = 0.i32()
        at: mutable i64 = 0
        trusted Unsafe.PointerCast:
            while at < count and status == 0.i32() |at, count, status, buffer, handle, black, screen, fields|:
                length: i64 = sdl_dump_puzzle_frame_write(screen, buffer, handle, black)
                _ = printf("# state=(")
                field: mutable i64 = 0
                while field < fields |field, fields, handle, screen|:
                    if field > 0:
                        _ = printf(", ")
                    _ = printf("%lld", sdl_dump_puzzle_info(screen, handle, field))
                    field <- field + 1
                _ = printf(") bytes=%lld\n", length)
                status <- 1.i32() if sdl_dump_frame(buffer.uintptr().cast[u8&], length) == 0.i32()
                if at < count - 1:
                    _ = (sdl_dump_puzzle_action(screen, handle) can Global{Read,Write})
                at <- at + 1
        frame_free(buffer)
        _ = (sdl_dump_puzzle_destroy(screen, handle) can Global{Read,Write})
        return status

export fn nw_sdl_dump_puzzle(screen: i64, options: i64&?, seed: i64, count: i64, black: i64, adaptive: i64, lexicon: u8&?, index: u8&?, sentences: u8&?) -> i32 = sdl_dump_puzzle

def sdl_start_selected(screen: i64, rows: usize&, startup: i64&, tasks: i64&,
                       configs: usize&, index: u8&?, sentences: u8&?) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        if screen == 2 or screen == 3 or screen == 6:
            return sdl_start_maze(screen, rows, startup)
        options: mutable i64[39] = zeroed
        trusted Unsafe.PointerCast:
            sdl_collect_screen_options(tasks, configs, (&options[0]).uintptr().cast[mutable i64&])
            lexicon: usize& = configs[3 if screen == 27 else 1].cast[usize&]
            return (sdl_start_screen_seeded(screen, rows, (&options[0]).uintptr().cast[i64&],
                lexicon[0].cast[u8&?], index, sentences, startup[5], startup[1], startup[2]) can Global{Read,Write})

export fn nw_sdl_start_selected(screen: i64, rows: usize&, startup: i64&, tasks: i64&, configs: usize&, index: u8&?, sentences: u8&?) -> i32 = sdl_start_selected

def sdl_start_desktop_task(state: mutable usize&, surface: usize, screen: i64, rows: usize&, startup: i64&, tasks: i64&, configs: usize&, index: u8&?, sentences: u8&?) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        started: i32 = (sdl_start_selected(screen, rows, startup, tasks, configs, index, sentences) can Global{Read,Write})
        if started < 0.i32():
            sdl_screenshot_close(state, surface)
            SDL_Quit()
            return 0.i32()
        trusted Unsafe.PointerCast:
            window: mutable void&? = state[0].cast[mutable void&?]
            if window != null:
                target: mutable void& = window
                if started > 0.i32():
                    sdl_apply_text_input(target, 1.i32())
        return 1.i32()

export fn nw_sdl_start_desktop_task(state: mutable usize&, surface: usize, screen: i64, rows: usize&, startup: i64&, tasks: i64&, configs: usize&, index: u8&?, sentences: u8&?) -> i32 = sdl_start_desktop_task

def sdl_dump_selected(screen: i64, trial: i64, count: i64, black: i64,
                      startup: i64&, tasks: i64&, configs: usize&, index: u8&?, sentences: u8&?) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return sdl_dump_menu(screen, trial, count, black) if screen <= 1
        if screen == 2 or screen == 3 or screen == 6:
            return (sdl_dump_puzzle(screen, startup, startup[5], count, black, startup[2], null, index, sentences) can Global{Read,Write})
        options: mutable i64[39] = zeroed
        trusted Unsafe.PointerCast:
            rows: i64& = (&options[0]).uintptr().cast[i64&]
            sdl_collect_screen_options(tasks, configs, (&options[0]).uintptr().cast[mutable i64&])
            lexicon: usize& = configs[3 if screen == 27 else 1].cast[usize&]
            return (sdl_dump_puzzle(screen, rows, startup[5], count, black, startup[2], lexicon[0].cast[u8&?], index, sentences) can Global{Read,Write})

export fn nw_sdl_dump_selected(screen: i64, trial: i64, count: i64, black: i64, startup: i64&, tasks: i64&, configs: usize&, index: u8&?, sentences: u8&?) -> i32 = sdl_dump_selected

def sdl_startup_output(argc: i64, argv: usize&?, screenshot: mutable usize&, screen: i64, trial: i64, startup: i64&, tasks: i64&, configs: usize&, index: u8&?, sentences: u8&?) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        if sdl_cli_output_mode(argc, argv, screenshot) == 0.i32():
            trusted Unsafe.PointerCast:
                if screenshot[0] != 0.usize():
                    path: u8& = screenshot[0].cast[u8&]
                    screenshot[0] <- 0.usize() if path[0] == 0.u8()
            return -1.i32()
        count: mutable i64 = 0
        if sdl_dump_count(argc, argv, &count) == 0.i32():
            SDL_Log("Invalid or missing --trials value")
            return 2.i32()
        return (sdl_dump_selected(screen, trial, count, sdl_startup_profile(argc, argv), startup, tasks, configs, index, sentences) can Global{Read,Write})

export fn nw_sdl_startup_output(argc: i64, argv: usize&?, screenshot: mutable usize&, screen: i64, trial: i64, startup: i64&, tasks: i64&, configs: usize&, index: u8&?, sentences: u8&?) -> i32 = sdl_startup_output


def sdl_frame_selftest(frames: i32) -> i32:
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        buffer: i64 = frame_alloc(65536)
        if buffer == 0:
            _ = printf("selftest: nw_frame_alloc failed\n")
            return 1.i32()
        scratch: mutable u8[40960] = zeroed
        trial: mutable i64 = 1
        bad: mutable i32 = 0.i32()
        i: mutable i32 = 0.i32()
        trusted Unsafe.PointerCast:
            while i < frames |i, frames, buffer, scratch, trial, bad|:
                length: i64 = title_write(buffer, 65536, trial % 4, 0, 1, 1)
                frame: mutable NativeDisplayDecode::Frame = zeroed
                if length <= 0 or NativeDisplayDecode::decode(buffer.uintptr().cast[u8&], length.usize(), (&scratch[0]).uintptr().cast[mutable u8&], 1024.usize(), (&frame).uintptr().cast[mutable NativeDisplayDecode::Frame&]) == 0.i32():
                    _ = printf("frame %lld: DECODE FAILED (%lld bytes)\n", trial, length)
                    bad <- bad + 1.i32()
                else:
                    texts: mutable i32 = 0.i32()
                    markers: mutable i32 = 0.i32()
                    at: mutable i64 = 0
                    while at < frame.count.i64() |at, frame, texts, markers|:
                        command: heap SDLFrame::Command& = (frame.commands.i64() + at * 40).uintptr().cast[heap SDLFrame::Command&]
                        texts <- texts + 1.i32() if command.kind == 11.u8()
                        markers <- markers + 1.i32() if command.kind == 14.u8()
                        at <- at + 1
                    if i == 0.i32() or i == frames - 1.i32():
                        _ = printf("frame %-3lld  bytes=%-4lld cmds=%-3u text=%d marker=%d", trial, length, frame.count, texts, markers)
                        at <- 0
                        while at < frame.count.i64() |at, frame, bad|:
                            command: heap SDLFrame::Command& = (frame.commands.i64() + at * 40).uintptr().cast[heap SDLFrame::Command&]
                            if command.kind == 11.u8():
                                size: u32 = command.len & 16777215.u32()
                                if command.ref.u64() + size.u64() <= frame.pool_len.u64():
                                    text: cstr = (frame.pool + command.ref.usize()).cast[cstr]
                                    _ = printf(" \"%.*s\"", size.i32(), text)
                                else:
                                    _ = printf(" <pool overrun ref=%u len=%u of %u>", command.ref, size, frame.pool_len)
                                    bad <- bad + 1.i32()
                            at <- at + 1
                        _ = printf("\n")
                    if texts == 0.i32():
                        _ = printf("frame %lld: NO TEXT COMMANDS\n", trial)
                        bad <- bad + 1.i32()
                trial <- trial + 1
                i <- i + 1.i32()
        frame_free(buffer)
        _ = printf("selftest: %d frames, %d bad\n", frames, bad)
        return 0.i32() if bad == 0.i32() else 1.i32()

export fn nw_sdl_frame_selftest(frames: i32) -> i32 = sdl_frame_selftest

extern atoi(text: cstr) -> i32

# Route window-free diagnostic commands in Elisa. Return -1 for application startup.
def sdl_dispatch_selftest(argc: i64, argv: usize&?) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return -1.i32() if argc < 2 or argv == null
        trusted Unsafe.PointerCast:
            args: usize& = argv
            flag: i64 = args[1].i64()
            return sdl_corpus_selftest(argc, argv) if argc == 5 and syllogism_argument_is(flag, "--selftest-word-corpus")
            if syllogism_argument_is(flag, "--selftest"):
                frames: i32 = atoi(args[2].cast[cstr]) if argc > 2 else 180.i32()
                return sdl_frame_selftest(frames)
            if syllogism_argument_is(flag, "--selftest-taskhub-lifecycle"):
                result: i64 = (sdl_hub_lifecycle_selftest() can Global{Read,Write})
                if result == 0: _ = printf("SDL task-hub lifecycle selftest: PASS\n")
                else: _ = printf("SDL task-hub lifecycle selftest: FAILED\n")
                return result.i32()
            return sdl_jpeg_package_selftest() if syllogism_argument_is(flag, "--selftest-jpeg-package")
            if syllogism_argument_is(flag, "--selftest-video-jigsaw-package"):
                return 2.i32() if argc != 3
                return sdl_video_jigsaw_package_selftest(args[2].cast[cstr])
            return sdl_music_package_selftest(argc == 3 and syllogism_argument_is(args[2].i64(), "--with-tracks")) if syllogism_argument_is(flag, "--selftest-music-package")
            return sdl_long_text_selftest().i32() if syllogism_argument_is(flag, "--selftest-long-text")
            return syllogism_sdl_selftest().i32() if syllogism_argument_is(flag, "--selftest-syllogism")
            return numberology_result_selftest().i32() if syllogism_argument_is(flag, "--selftest-numberology-result-lifecycle")
            return sdl_algebra_options_selftest().i32() if syllogism_argument_is(flag, "--selftest-algebra-options")
            return sdl_task_options_selftest().i32() if syllogism_argument_is(flag, "--selftest-task-options")
            return sdl_you_are_here_selftest().i32() if syllogism_argument_is(flag, "--selftest-3d-maze")
            return sdl_taskhub_selftest().i32() if syllogism_argument_is(flag, "--selftest-taskhub")
            return sdl_sokoban_selftest().i32() if syllogism_argument_is(flag, "--selftest-sokoban")
            return sdl_monkey_ladder_selftest().i32() if syllogism_argument_is(flag, "--selftest-monkey-ladder")
            return sdl_nback3d_selftest().i32() if syllogism_argument_is(flag, "--selftest-nback3d")
            return sdl_marble_selftest().i32() if syllogism_argument_is(flag, "--selftest-marble")
            return sdl_tetris_selftest().i32() if syllogism_argument_is(flag, "--selftest-tetris")
