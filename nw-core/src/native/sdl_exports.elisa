export fn nw_you_are_here_frame_write(dest: i64, capacity: i64, handle: i64,
                                      black_background: i64, width: i64,
                                      height: i64) -> i64 = you_are_here_frame_write
export fn nw_you_are_here_destroy(handle: i64) -> i64 = you_are_here_destroy
export fn nw_sokoban_create(rung: i64, trials: i64, adaptive: i64,
                            show_traps: i64, seed: i64) -> i64 = sokoban_create
