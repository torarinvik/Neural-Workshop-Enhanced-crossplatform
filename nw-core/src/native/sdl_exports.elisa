                    at <- at + 1.usize()
                good <- false if numberology_action(handle, 3, 0, 0) != 1 or numberology_info(handle, 8) != 1 or numberology_info(handle, 15) != count.i64() or numberology_info(handle, 17) != 0
                at <- 0.usize()
                while at < count |at, count, bytes, handle, good|:
