# Route pointer events using the same controller and option state as key input.
def sdl_active_pointer(rows: usize&?, special_rows: usize&?, motion: i64, button: i64, x: f32, y: f32, pixel_width: i32, pixel_height: i32, width: i32, height: i32) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return 0.i32() if rows == null or special_rows == null
        return 0.i32() if width <= 0.i32() or height <= 0.i32() or pixel_width <= 0.i32() or pixel_height <= 0.i32()
        px: f32 = x * (pixel_width.f32() / width.f32())
        py: f32 = y * (pixel_height.f32() / height.f32())
        nearer: i64 = sdl_active_handle(rows, 52.usize())
