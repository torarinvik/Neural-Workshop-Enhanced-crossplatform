        options: mutable i64[4] = zeroed
        lexicon: mutable usize = 0.usize()
        trusted Unsafe.PointerCast:
            good <- false if task_settings_parse(1, 7, (&args[0]).uintptr().cast[usize&], (&options[0]).uintptr().cast[mutable i64&], (&lexicon).uintptr().cast[mutable usize&], 0) != 0.i32() or options[0] != 2 or options[1] != 1 or options[2] != 0 or options[3] != 0
        handle: i64 = scrabble_create(1, 1, 1, 1, 17)
        buffer: i64 = frame_alloc(65536)
        if handle == 0 or buffer == 0:
            good <- false
        else:
            good <- false if scrabble_action(handle, 0, 0, 100) != 1 or scrabble_info(handle, 0) != 1
            good <- false if scrabble_action(handle, 10, 0, 1100) != 1 or scrabble_action(handle, 10, 0, 1101) != 2
            good <- false if scrabble_info(handle, 9) != 8 or scrabble_info(handle, 10) <= 0
            good <- false if scrabble_value(handle, 0, 23) != 99 or scrabble_value(handle, 0, 24) != 97 or scrabble_value(handle, 0, 25) != 116 or scrabble_value(handle, 2, 0) != 103 or scrabble_value(handle, 2, 1) != 108 or scrabble_value(handle, 2, 2) != 115 or scrabble_value(handle, 2, 3) != 116
