            return ScrambleGame::info(run, field)


def sdl_scramble_text(handle: i64, text: u8&, now: i64, suppress: mutable u8&?):
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
        trusted Unsafe.PointerCast:
            return if text[0] == 0.u8()
            offset: mutable usize = 0.usize()
            if suppress != null:
                flag: mutable u8& = suppress
                offset <- 1.usize() if flag[0] != 0.u8() and text[0] == 32.u8()
                flag[0] <- 0.u8()
            sdl_text_input(handle, (&text[offset]).uintptr().cast[u8&], now, 2)

# Route complete SDL text events, including the task-specific option editor and
# Scramble's one-event suppression after starting with the space bar.
def sdl_dispatch_text(handle: i64, task: i64, options_open: i64, selected: i64, text: u8&?, now_ms: i64, suppress: mutable u8&?, level: mutable i64&?, editing: mutable u8&?, edit_value: mutable i64&?):
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return if text == null
        if task == 0:
            if options_open != 0 and selected == 0:
                numberology_edit_text(level, editing, edit_value, text)
            elif options_open == 0 and numberology_info(handle, 0) == 1:
                sdl_text_input(handle, text, now_ms, 0)
        elif task == 1:
            if options_open == 0 and algebra_info(handle, 0) == 1:
                sdl_text_input(handle, text, now_ms, 1)
        elif task == 2:
            if options_open == 0 and scramble_info(handle, 0) == 1:
                input: u8& = text
                sdl_scramble_text(handle, input, now_ms, suppress)

export fn nw_sdl_dispatch_text(handle: i64, task: i64, options_open: i64, selected: i64, text: u8&?, now_ms: i64, suppress: mutable u8&?, level: mutable i64&?, editing: mutable u8&?, edit_value: mutable i64&?) = sdl_dispatch_text

# Dispatch one SDL text event to active text tasks. The pointer table holds
# Scramble (handle, mode, overlay, suppress), Numberology (handle, mode,
# overlay, selection, level, editing, edit value), then Algebra (handle,
# mode, overlay), preserving the original event order.
def sdl_text_event(rows: usize&?, text: u8&?):
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return if rows == null or text == null
        trusted Unsafe.PointerCast:
            table: usize& = rows
            now: i64 = SDL_GetTicks().i64()
            input: u8& = text
            first: u8 = input[0]
            # Pyglet sends these as key actions, not as standalone text edits.
            if first == 8.u8() or first == 10.u8() or first == 13.u8() or first == 127.u8():
                return if input[1] == 0.u8()
            scramble: i64& = table[0].cast[i64&]
            scramble_mode: u8& = table[1].cast[u8&]
            scramble_open: u8& = table[2].cast[u8&]
            suppress: mutable u8& = table[3].cast[mutable u8&]
            if scramble_mode[0] != 0.u8() and scramble_open[0] == 0.u8() and scramble_info(scramble[0], 0) == 1:
                sdl_scramble_text(scramble[0], input, now, suppress)
            number: i64& = table[4].cast[i64&]
            number_mode: u8& = table[5].cast[u8&]
            number_open: u8& = table[6].cast[u8&]
            selected: i32& = table[7].cast[i32&]
            level: mutable i64& = table[8].cast[mutable i64&]
            editing: mutable u8& = table[9].cast[mutable u8&]
            edit_value: mutable i64& = table[10].cast[mutable i64&]
            if number_mode[0] != 0.u8():
                if number_open[0] != 0.u8() and selected[0] == 0.i32():
                    numberology_edit_text(level, editing, edit_value, input)
                elif number_open[0] == 0.u8() and numberology_info(number[0], 0) == 1:
                    sdl_text_input(number[0], input, now, 0)
            algebra: i64& = table[11].cast[i64&]
            algebra_mode: u8& = table[12].cast[u8&]
            algebra_open: u8& = table[13].cast[u8&]
            if algebra_mode[0] != 0.u8() and algebra_open[0] == 0.u8() and algebra_info(algebra[0], 0) == 1:
                sdl_text_input(algebra[0], input, now, 1)

export fn nw_sdl_text_event(rows: usize&?, text: u8&?) = sdl_text_event


