def sdl_jigsaw_selftest() -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        buffer: i64 = frame_alloc(65536)
        handle: i64 = jigsaw_create_options(3, 2, 1, 1, 1, 17)
        if buffer == 0 or handle == 0:
            _ = printf("Jigsaw selftest: allocation failed\n")
            if handle != 0:
                _ = jigsaw_destroy(handle)
            frame_free(buffer) if buffer != 0
            return 1.i32()
        good: mutable bool = true
        good <- false if jigsaw_info(handle, 0) != 0
        good <- false if jigsaw_action(handle, 0, 0, 0) != 1
        good <- false if jigsaw_info(handle, 0) != 1
        good <- false if jigsaw_info(handle, 1) != 3
        good <- false if jigsaw_info(handle, 14) != 1
        good <- false if jigsaw_value(handle, 0, 0) < 0
        good <- false if not sdl_selftest_frame_valid(buffer, jigsaw_frame_write(buffer, 65536, handle, 0, 912, 684))
        good <- false if jigsaw_action(handle, 1, 0, 0) != 1
        good <- false if jigsaw_action(handle, 1, 0, 1) != 1
        good <- false if jigsaw_destroy(handle) != 0
        rectangle: i64 = jigsaw_create_grid(0, 2, 1, 0, 0, 17, 2)
        if rectangle > 0:
            _ = jigsaw_action(rectangle, 0, 0, 0)
            good <- false if jigsaw_info(rectangle, JigsawGame::INFO_TRIAL_SIDE) != 1 or jigsaw_info(rectangle, JigsawGame::INFO_TRIAL_ROWS) != 2
            good <- false if jigsaw_value(rectangle, JigsawGame::VALUE_ORDER, 1) != 0 or jigsaw_value(rectangle, JigsawGame::VALUE_ORDER, 2) != -1
            for tile in 0..<2 |tile, rectangle, good|:
                box: Jigsaw::Rect = Jigsaw::tile_rect(912.0, 684.0, false, 1, tile, 2)
                x: i64 = ((box.left + box.width / 2.0) * 1000000.0 / 912.0).i64()
                y: i64 = ((box.bottom + box.height / 2.0) * 1000000.0 / 684.0).i64()
                good <- false if jigsaw_pointer(rectangle, x, y, 912, 684, tile) != 1
            good <- false if jigsaw_info(rectangle, JigsawGame::INFO_PHASE) != JigsawGame::PHASE_SOLVED
            good <- false if jigsaw_value(rectangle, JigsawGame::VALUE_RESULT_PIECES, 0) != 2
            _ = jigsaw_action(rectangle, 2, 0, 2000)
            good <- false if jigsaw_info(rectangle, JigsawGame::INFO_TRIAL_SIDE) != 2 or jigsaw_info(rectangle, JigsawGame::INFO_TRIAL_ROWS) != 2
            _ = jigsaw_destroy(rectangle)
        else:
            good <- false
        # Pyglet crops integer pixels from the bottom-left; SDL samples
        # from the top-left. Check both odd margins and leftover tile pixels.
        preview_crop: JigsawLayout::PhotoCrop = JigsawLayout::photo_crop(65, 130, 2, 3, -1)
        first_crop: JigsawLayout::PhotoCrop = JigsawLayout::photo_crop(130, 65, 2, 3, 0)
        last_crop: JigsawLayout::PhotoCrop = JigsawLayout::photo_crop(130, 65, 2, 3, 5)
        good <- false if preview_crop.left != 0 or preview_crop.top != 33 or preview_crop.width != 65 or preview_crop.height != 65
        good <- false if first_crop.left != 32 or first_crop.top != 2 or first_crop.width != 32 or first_crop.height != 21
        good <- false if last_crop.left != 64 or last_crop.top != 44 or last_crop.width != 32 or last_crop.height != 21
        # Spacing and hit-test phases match Python at each seam threshold.
        narrow: JigsawLayout::TileSpans = JigsawLayout::spans(288.0, 32, 30)
        medium: JigsawLayout::TileSpans = JigsawLayout::spans(320.0, 32, 30)
        wide: JigsawLayout::TileSpans = JigsawLayout::spans(768.0, 32, 30)
        good <- false if narrow.seam != 0.0 or medium.seam != 1.0 or wide.seam != 2.0
        first: Jigsaw::Rect = Jigsaw::tile_rect(912.0, 684.0, false, 32, 0, 32)
        second: Jigsaw::Rect = Jigsaw::tile_rect(912.0, 684.0, false, 32, 1, 32)
        seam_x: f64 = (first.left + first.width + second.left) / 2.0
        good <- false if Jigsaw::tile_at(912.0, 684.0, false, 32, seam_x, first.bottom + first.height / 2.0, 32) != 0
        board: Jigsaw::Square = Jigsaw::board_rect(912.0, 684.0, false)
        good <- false if Jigsaw::tile_at(912.0, 684.0, false, 32, board.left + board.size, board.bottom, 32) != 1023
        large: i64 = jigsaw_create_grid(0, 1, 0, 0, 1, 17, 2500)
        if large > 0:
            _ = jigsaw_action(large, 0, 0, 0)
            good <- false if jigsaw_action(large, JigsawGame::ACTION_FIT_PHOTO, 0, 0) != 1
            good <- false if jigsaw_info(large, JigsawGame::INFO_TRIAL_SIDE) != 50 or jigsaw_info(large, JigsawGame::INFO_TRIAL_ROWS) != 50
            # Navigate beyond single-digit tile numbers and select by key.
            good <- false if jigsaw_info(large, JigsawGame::INFO_CURSOR) != -1
            sdl_dispatch_task_key(17, large, 1073741906)
            sdl_dispatch_task_key(17, large, 1073741904)
            good <- false if jigsaw_info(large, JigsawGame::INFO_CURSOR) != 0
            sdl_dispatch_task_key(17, large, 1073741905)
            sdl_dispatch_task_key(17, large, 1073741903)
            sdl_dispatch_task_key(17, large, 13)
            good <- false if jigsaw_info(large, JigsawGame::INFO_CURSOR) != 51
            good <- false if jigsaw_info(large, JigsawGame::INFO_PICKED) != 51
            sdl_dispatch_task_key(17, large, 32)
            good <- false if jigsaw_info(large, JigsawGame::INFO_PICKED) != -1
            # Put the board one swap from solved to exercise the marked
            # frame at full size without replaying the whole permutation.
            trusted Unsafe.PointerCast:
                run: mutable heap JigsawGame::JigsawRun& = large.uintptr().cast[mutable heap JigsawGame::JigsawRun&]
                for tile in 0..<(run.trial_side * run.trial_rows) |tile, run|:
                    run.order[tile.usize()] <- tile
                run.order[2498] <- 2499
                run.order[2499] <- 2498
                run.par <- 1
            _ = jigsaw_action(large, 1, 2498, 1)
            _ = jigsaw_action(large, 1, 2499, 2)
            good <- false if jigsaw_info(large, JigsawGame::INFO_PHASE) != JigsawGame::PHASE_SOLVED
            capacity: i64 = NativeDisplayDecode::DESKTOP_FRAME_BYTES
            large_buffer: i64 = frame_alloc(capacity)
            length: i64 = jigsaw_frame_write(large_buffer, capacity, large, 0, 912, 684)
            good <- false if length <= 200000 or not sdl_selftest_frame_valid(large_buffer, length)
            frame_free(large_buffer) if large_buffer != 0
            _ = jigsaw_destroy(large)
        else:
            good <- false
        video: i64 = jigsaw_create_grid(3, 1, 0, 1, 1, 17, 1000000, true)
        if video > 0:
            _ = jigsaw_action(video, JigsawGame::ACTION_START, 0, 0)
            good <- false if jigsaw_info(video, JigsawGame::INFO_TRIAL_SIDE) != 320 or jigsaw_info(video, JigsawGame::INFO_TRIAL_ROWS) != 240
            good <- false if jigsaw_action(video, JigsawGame::ACTION_FIT_PHOTO, 240, 0) != 1
            # Exercise the full desktop frame budget with every tile marked.
            trusted Unsafe.PointerCast:
                run: mutable heap JigsawGame::JigsawRun& = video.uintptr().cast[mutable heap JigsawGame::JigsawRun&]
                for tile in 0..<(run.trial_side * run.trial_rows) |tile, run|:
                    run.order[tile.usize()] <- tile
                run.order[76798] <- 76799
                run.order[76799] <- 76798
                run.par <- 1
            _ = jigsaw_action(video, JigsawGame::ACTION_PICK, 76798, 1)
            _ = jigsaw_action(video, JigsawGame::ACTION_PICK, 76799, 2)
            good <- false if jigsaw_value(video, JigsawGame::VALUE_RESULT_PIECES, 0) != 76800
            capacity: i64 = NativeDisplayDecode::DESKTOP_FRAME_BYTES
            video_buffer: i64 = frame_alloc(capacity)
            length: i64 = jigsaw_frame_write(video_buffer, capacity, video, 0, 912, 684, true)
            good <- false if length <= 6100000 or not sdl_selftest_frame_valid(video_buffer, length)
            frame_free(video_buffer) if video_buffer != 0
            _ = jigsaw_destroy(video)
        else:
            good <- false
        options_board: i64 = jigsaw_create_options(3, 3, 1, 1, 0, 17)
        if options_board > 0:
            good <- false if sdl_jigsaw_options_key(options_board, 99, 0.usize()) != 1
            good <- false if not sdl_selftest_frame_valid(buffer, jigsaw_frame_write(buffer, 65536, options_board, 0, 912, 684))
            _ = sdl_jigsaw_options_key(options_board, SDLTaskKeys::RIGHT, 0.usize())
            _ = sdl_jigsaw_options_key(options_board, 27, 0.usize())
            good <- false if jigsaw_info(options_board, JigsawGame::INFO_TRIAL_SIDE) != 3
            _ = sdl_jigsaw_options_key(options_board, 99, 0.usize())
            _ = sdl_jigsaw_options_key(options_board, SDLTaskKeys::RIGHT, 0.usize())
            _ = sdl_jigsaw_options_key(options_board, SDLTaskKeys::DOWN, 0.usize())
            _ = sdl_jigsaw_options_key(options_board, SDLTaskKeys::RIGHT, 0.usize())
            _ = sdl_jigsaw_options_key(options_board, 13, 0.usize())
            good <- false if jigsaw_info(options_board, JigsawGame::INFO_TRIAL_ROWS) != 4
            good <- false if jigsaw_info(options_board, JigsawGame::INFO_TOTAL_PUZZLES) != 5
            _ = jigsaw_destroy(options_board)
        else:
            good <- false
        frame_free(buffer)
        if good: _ = printf("Jigsaw selftest: PASS\n")
        else: _ = printf("Jigsaw selftest: FAILED\n")
        return 0.i32() if good else 1.i32()

export fn nw_sdl_jigsaw_selftest() -> i32 = sdl_jigsaw_selftest

def sdl_sudoku_selftest() -> i32:
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        buffer: i64 = frame_alloc(65536)
        handle: i64 = sudoku_create(1, 2, 1, 1, 17)
        if buffer == 0 or handle == 0:
            _ = printf("Sudoku selftest: allocation failed\n")
            if handle != 0:
                _ = sudoku_destroy(handle)
            frame_free(buffer) if buffer != 0
            return 1.i32()
        good: mutable bool = true
        good <- false if sudoku_info(handle, 0) != 0
        good <- false if sudoku_action(handle, 0, 0, 0) != 1
        good <- false if sudoku_info(handle, 0) != 1
        good <- false if sudoku_info(handle, 5) < 4
        good <- false if sudoku_value(handle, 0, 0) < 0
        good <- false if not sdl_selftest_frame_valid(buffer, sudoku_frame_write(buffer, 65536, handle, 0, 912, 684))
        good <- false if sudoku_action(handle, 1, 0, 0) != 1
        good <- false if sudoku_action(handle, 5, 1, 0) < 1
        # O opens options even during a solve. Cancelling keeps the live
        # puzzle and cursor at the same position.
        options_board: i64 = sudoku_create(1, 2, 1, 1, 17)
        if options_board > 0:
            _ = sudoku_action(options_board, 0, 0, 100)
            cursor: i64 = sudoku_info(options_board, SudokuGame::INFO_CURSOR)
            good <- false if sdl_sudoku_options_key(options_board, 111, 0.usize()) != 1
            _ = sdl_sudoku_options_key(options_board, SDLTaskKeys::RIGHT, 0.usize())
            _ = sdl_sudoku_options_key(options_board, 27, 0.usize())
            good <- false if sudoku_info(options_board, SudokuGame::INFO_PHASE) != SudokuGame::PHASE_SOLVING
            good <- false if sudoku_info(options_board, SudokuGame::INFO_CURSOR) != cursor
            good <- false if sudoku_info(options_board, SudokuGame::INFO_RUNG) != 1
            _ = sudoku_destroy(options_board)
        else:
            good <- false
        scoring: i64 = sudoku_create(1, 2, 1, 1, 17)
        if scoring > 0:
            _ = sudoku_action(scoring, 0, 0, 100)
            trusted Unsafe.PointerCast:
                run: mutable heap SudokuGame::SudokuRun& = scoring.uintptr().cast[mutable heap SudokuGame::SudokuRun&]
                for trial in 0..<2 |trial, run, good|:
                    run.mistakes <- 0 if trial == 0 else 5
                    for cell in 0..<run.cells |cell, run|:
                        run.filled[cell.usize()] <- run.solution[cell.usize()]
                    SudokuGame::settle(run, run.started_at_ms + 1600)
                    good <- false if run.rung != (2 if trial == 0 else 1)
                    SudokuGame::next_trial(run, run.started_at_ms + 2000)
            good <- false if sudoku_info(scoring, SudokuGame::INFO_SOLVED) != 2
            good <- false if sudoku_info(scoring, SudokuGame::INFO_SLIPS) != 5
            good <- false if sudoku_info(scoring, SudokuGame::INFO_CLEAN) != 1
            good <- false if sudoku_info(scoring, SudokuGame::INFO_TOTAL_SECONDS) != 3
            good <- false if sudoku_info(scoring, SudokuGame::INFO_BEST_RUNG) != 2
            _ = sudoku_destroy(scoring)
        else:
            good <- false
        good <- false if sudoku_destroy(handle) != 0
        frame_free(buffer)
        if good: _ = printf("Sudoku selftest: PASS\n")
        else: _ = printf("Sudoku selftest: FAILED\n")
        return 0.i32() if good else 1.i32()

export fn nw_sdl_sudoku_selftest() -> i32 = sdl_sudoku_selftest

