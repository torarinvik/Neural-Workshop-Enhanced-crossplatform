def sdl_taskhub_selftest() -> i32:
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        buffer: i64 = frame_alloc(65536)
        if buffer == 0:
            _ = printf("taskhub selftest: allocation failed\n")
            return 1.i32()
        length: i64 = taskhub_write(buffer, 65536, 5, 4, 0, 912, 684)
        scratch: mutable u8[40960] = zeroed
        frame: mutable NativeDisplayDecode::Frame = zeroed
        good: mutable bool = false
        trusted Unsafe.PointerCast:
            if length > 0 and NativeDisplayDecode::decode(buffer.uintptr().cast[u8&], length.usize(), (&scratch[0]).uintptr().cast[mutable u8&], 1024.usize(), (&frame).uintptr().cast[mutable NativeDisplayDecode::Frame&]) != 0.i32():
                good <- true
                texts: mutable i64 = 0
                at: mutable i64 = 0
                while at < frame.count.i64() |at, frame, texts, good|:
                    cmd: heap SDLFrame::Command& = (frame.commands.i64() + at * 40).uintptr().cast[heap SDLFrame::Command&]
                    if cmd.kind == 11.u8():
                        texts <- texts + 1
                        good <- false if cmd.ref.u64() + (cmd.len & 16777215.u32()).u64() > frame.pool_len.u64()
                    at <- at + 1
                good <- false if texts < 3
            else:
                _ = printf("taskhub selftest: frame decode failed\n")
        frame_free(buffer)
        if good: _ = printf("taskhub selftest: PASS\n")
        else: _ = printf("taskhub selftest: FAILED\n")
        return 0.i32() if good else 1.i32()

