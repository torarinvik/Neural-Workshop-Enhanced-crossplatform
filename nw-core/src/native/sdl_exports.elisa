def sdl_nback3d_selftest() -> i32:
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        buffer: i64 = frame_alloc(65536)
        handle: i64 = nback3d_create(2, 3, 20, 3000, 500, 200, 17)
        if buffer == 0 or handle == 0:
            _ = printf("3D N-Back selftest: allocation failed\n")
            if handle != 0:
                _ = nback3d_destroy(handle)
            frame_free(buffer) if buffer != 0
            return 1.i32()
        good: mutable bool = sdl_selftest_frame_valid(buffer, nback3d_frame_write(buffer, 65536, handle, 0, 912, 684))
        good <- false if nback3d_info(handle, 0) != 0
        _ = nback3d_action(handle, 0, 0, 0)
        _ = nback3d_action(handle, 2, 0, 1000)
        good <- false if nback3d_info(handle, 0) != 1 or nback3d_info(handle, 2) != 1
        good <- false if not sdl_selftest_frame_valid(buffer, nback3d_frame_write(buffer, 65536, handle, 0, 1280, 720))
        _ = nback3d_action(handle, 2, 0, 1600)
        good <- false if nback3d_info(handle, 0) != 2
        _ = nback3d_action(handle, 1, 0, 1700)
        good <- false if nback3d_info(handle, 8) != 1
        good <- false if nback3d_info(handle, NBack3DGame::INFO_SCORE_PERCENT) != -1
        trusted Unsafe.PointerCast:
            run: mutable heap NBack3DGame::NBack3DRun& = handle.uintptr().cast[mutable heap NBack3DGame::NBack3DRun&]
            run.progression <- NBack3DGame::Progression{
                enabled: true, jaeggi: false, immediate_fallback: false, advance_threshold: 0,
                fallback_threshold: 0, fallback_sessions: 3, base_trials: 16, trials_factor: 1,
                trials_exponent: 2, fallback_progress: 0, next_nback: 2}
        _ = nback3d_action(handle, NBack3DGame::ACTION_RESTART, 0, 0)
        history: mutable darray[i64] = []
        inputs: mutable darray[i64] = []
        for trial in 0..<20 |trial, handle, history, inputs, good|:
            now: i64 = nback3d_info(handle, NBack3DGame::INFO_DEADLINE_MS)
            _ = nback3d_action(handle, 2, 0, now)
            good <- false if nback3d_info(handle, 0) != NBack3DGame::PHASE_STIMULUS
            history.push(nback3d_info(handle, NBack3DGame::INFO_POSITION))
            pressed: bool = trial == 0 or trial % 3 == 0
            inputs.push(1 if pressed else 0)
            if pressed:
                _ = nback3d_action(handle, 1, 0, now)
            _ = nback3d_action(handle, 2, 0, nback3d_info(handle, NBack3DGame::INFO_DEADLINE_MS))
            _ = nback3d_action(handle, 2, 0, nback3d_info(handle, NBack3DGame::INFO_DEADLINE_MS))
        _ = nback3d_action(handle, 2, 0, nback3d_info(handle, NBack3DGame::INFO_DEADLINE_MS))
        variable: mutable darray[i64] = []
        for mode in 0..<2 |mode, handle, history, inputs, variable, good|:
            reference: Score = score_direct(&history, &inputs, true, 2, false, mode == 1, &variable, false)
            total: i64 = reference.rights + reference.wrongs
            expected: i64 = reference.rights * 100 / total if total > 0 else 0
            good <- false if nback3d_info(handle, NBack3DGame::INFO_SCORE_PERCENT + mode) != expected
        good <- false if not sdl_selftest_frame_valid(buffer, nback3d_frame_write(buffer, 65536, handle, 0, 912, 684))
        good <- false if nback3d_info(handle, NBack3DGame::INFO_NEXT_NBACK) != 3
        good <- false if nback3d_info(handle, NBack3DGame::INFO_NBACK) != 2
        _ = nback3d_action(handle, NBack3DGame::ACTION_START, 0, 0)
        good <- false if nback3d_info(handle, NBack3DGame::INFO_NBACK) != 3 or nback3d_info(handle, NBack3DGame::INFO_TOTAL_TRIALS) != 25
        # Pause during startup and all three trial phases. Keypresses still
        # use wall time from the original onset and score at most once.
        _ = nback3d_action(handle, 3, 0, 100)
        _ = nback3d_action(handle, 3, 0, 200)
        good <- false if nback3d_info(handle, 13) != 1100
        _ = nback3d_action(handle, 2, 0, 1100)
        _ = nback3d_action(handle, 3, 0, 1200)
        _ = nback3d_action(handle, 1, 0, 1400)
        _ = nback3d_action(handle, 3, 0, 2200)
        good <- false if nback3d_info(handle, 13) != 2600
        _ = nback3d_action(handle, 2, 0, 2600)
        good <- false if nback3d_info(handle, 0) != 2 or nback3d_info(handle, 13) != 4900
        _ = nback3d_action(handle, 3, 0, 3000)
        _ = nback3d_action(handle, 3, 0, 4000)
        good <- false if nback3d_info(handle, 13) != 5900
        _ = nback3d_action(handle, 2, 0, 5900)
        good <- false if nback3d_info(handle, 0) != 3 or nback3d_info(handle, 13) != 6100
        _ = nback3d_action(handle, 3, 0, 6000)
        _ = nback3d_action(handle, 1, 0, 6500)
        _ = nback3d_action(handle, 3, 0, 7000)
        good <- false if nback3d_info(handle, 13) != 7100 or nback3d_info(handle, 11) != 1
        trusted Unsafe.PointerCast:
            paused_run: heap NBack3DGame::NBack3DRun& = handle.uintptr().cast[heap NBack3DGame::NBack3DRun&]
            good <- false if paused_run.response_ms[0] != 5400
        _ = nback3d_action(handle, 2, 0, 7100)
        good <- false if nback3d_info(handle, 0) != 1 or nback3d_info(handle, 2) != 2
        progression: mutable NBack3DGame::Progression = NBack3DGame::Progression{
            enabled: true, jaeggi: false, immediate_fallback: false, advance_threshold: 80,
            fallback_threshold: 50, fallback_sessions: 3, base_trials: 20, trials_factor: 1,
            trials_exponent: 2, fallback_progress: 0, next_nback: 3}
        NBack3DGame::finish_progression(&progression, 3, 49)
        NBack3DGame::finish_progression(&progression, 3, 50)
        NBack3DGame::finish_progression(&progression, 3, 49)
        good <- false if progression.next_nback != 3 or progression.fallback_progress != 2
        NBack3DGame::finish_progression(&progression, 3, 49)
        good <- false if progression.next_nback != 2 or progression.fallback_progress != 0
        progression.immediate_fallback <- true
        NBack3DGame::finish_progression(&progression, 2, 49)
        good <- false if progression.next_nback != 1 or progression.fallback_progress != 0
        NBack3DGame::finish_progression(&progression, 8, 80)
        good <- false if progression.next_nback != 8
        faded: f64 = sdl_reward_fade_gain(0.25, 2)
        good <- false if faded < 0.049 or faded > 0.051
        good <- false if sdl_reward_fade_gain(0.25, 4) != 0.0
        good <- false if sdl_reward_fade_gain(1.0, 20) != 0.0
        good <- false if not sdl_nback3d_in_training_day(20240229, 4, 20240301, 3, 4)
        good <- false if sdl_nback3d_in_training_day(20240229, 3, 20240301, 3, 4)
        good <- false if sdl_nback3d_in_training_day(20240229, 23, 20240301, 4, 4)
        good <- false if sdl_nback3d_in_training_day(20240301, 3, 20240301, 4, 4)
        good <- false if not sdl_nback3d_in_training_day(20240301, 4, 20240301, 4, 4)
        good <- false if nback3d_destroy(handle) != 0
        frame_free(buffer)
        if good: _ = printf("3D N-Back selftest: PASS\n")
        else: _ = printf("3D N-Back selftest: FAILED\n")
        return 0.i32() if good else 1.i32()

