        if active[34] != 0:
            return syllogism_options_frame_write(dest, capacity, black, o[1], o[2], o[3], o[4], o[5], o[6]) if o[0] != 0
            return syllogism_frame_write(dest, capacity, active[34], black, width, height)
        return numberology_options_frame_write(dest, capacity, black, o[8], o[9], o[10], o[11]) if active[19] != 0 and o[7] != 0
        return algebra_options_frame_write(dest, capacity, black, o[15], o[16], o[17], o[18], o[19]) if active[18] != 0 and o[14] != 0
        if active[35] != 0:
            return scramble_options_frame_write(dest, capacity, black, o[22], o[23], o[24], o[25], o[26]) if o[21] != 0
            return scramble_frame_write(dest, capacity, active[35], black, width, height)
        if active[36] != 0:
            return scrabble_options_frame_write(dest, capacity, black, o[29], o[30], o[31], o[32], o[33]) if o[28] != 0
            return scrabble_frame_write(dest, capacity, active[36], black, width, height)
        return crossword_options_frame_write(dest, capacity, black, o[36], o[37], o[38], o[39], o[40]) if active[23] != 0 and o[35] != 0
        return sdl_task_frame_themed(dest, capacity, handles, width, height, hub, category, selected, trial, black)

export fn nw_sdl_frame_write(dest: i64, capacity: i64, handles: i64&?, options: i64&?, width: i64, height: i64, hub: i64, category: i64, selected: i64, trial: i64) -> i64 = sdl_frame_write

# Destroy every live controller and flush the two result managers in order.
def sdl_shutdown(handles: mutable i64&?, syllogism_results: mutable usize&?, numberology_results: mutable usize&?):
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return if handles == null
        active: mutable i64& = handles
        if active[0] != 0:
            _ = you_are_here_destroy(active[0])
            active[0] <- 0
        if active[1] != 0:
            _ = sokoban_destroy(active[1])
            active[1] <- 0
        if active[2] != 0:
            _ = monkey_ladder_destroy(active[2])
            active[2] <- 0
        if active[3] != 0:
            _ = nback3d_destroy(active[3])
            active[3] <- 0
        if active[4] != 0:
            _ = marble_destroy(active[4])
            active[4] <- 0
        if active[5] != 0:
            _ = tetris_destroy(active[5])
            active[5] <- 0
        if active[6] != 0:
            _ = count_destroy(active[6])
            active[6] <- 0
        if active[7] != 0:
            _ = mr_time_destroy(active[7])
            active[7] <- 0
        if active[8] != 0:
            _ = graph_mapping_destroy(active[8])
            active[8] <- 0
        if active[9] != 0:
            _ = matrix_reasoning_destroy(active[9])
            active[9] <- 0
        if active[10] != 0:
            _ = in_the_dark_destroy(active[10])
            active[10] <- 0
        if active[11] != 0:
            _ = fog_destroy(active[11])
            active[11] <- 0
        if active[12] != 0:
            _ = removals_destroy(active[12])
            active[12] <- 0
        if active[13] != 0:
