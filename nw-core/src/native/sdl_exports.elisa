                hy: f64 = ((view[3] - view[2] - py) / view[0]).f64() * pixel_height.f64() / Display::REFERENCE_HEIGHT
                _ = sdl_hanoi_pointer(hanoi, hx, hy, pixel_width.f64(), pixel_height.f64(), SDL_GetTicks().i64())
            return 0.i32()
        trusted Unsafe.PointerCast:
            special: usize& = special_rows
            keys: mutable i64[30] = zeroed
            pointers: mutable i64[7] = zeroed
            sdl_collect_routing(rows, (&keys[0]).uintptr().cast[mutable i64&], (&pointers[0]).uintptr().cast[mutable i64&])
            sdl_dispatch_pixel_pointers((&pointers[0]).uintptr().cast[i64&], motion, px, py, pixel_width, pixel_height)
            start: mutable i32 = 0.i32()
            if motion == 0 and button > 0:
                if button == 1:
                    sdl_sudoku_options_click(keys[18], px, py, pixel_width, pixel_height)
                    sdl_wires_options_click(keys[29], px, py, pixel_width, pixel_height)
                concentration: i64 = keys[7]
                recognition: i64 = keys[8]
                if concentration != 0:
                    sdl_dispatch_pointer(10, concentration, px, py, pixel_width, pixel_height, 0)
                if recognition != 0:
                    sdl_dispatch_pointer(11, recognition, px, py, pixel_width, pixel_height, 0)
                syllogism_mode: u8& = special[11].cast[u8&]
                if button != 3 and syllogism_mode[0] != 0.u8():
                    sdl_syllogism_click(special[10].cast[mutable i64&], special[11].cast[mutable u8&], special[12].cast[mutable u8&], special[13].cast[mutable u8&], special[14].cast[mutable i64&], special[15].cast[mutable i64&], special[16].cast[mutable i64&], special[17].cast[mutable usize&], px, py, pixel_width, pixel_height)
                number_mode: u8& = special[21].cast[u8&]
                if button != 3 and number_mode[0] != 0.u8():
                    h: i64& = special[20].cast[i64&]
                    opened: u8& = special[22].cast[u8&]
                    _ = sdl_text_task_click(0, h[0], opened[0].i64(), px, py, pixel_width, pixel_height, special[24].cast[mutable i32&], special[26].cast[mutable i64&], special[27].cast[mutable u8&], special[25].cast[mutable i64&], special[29].cast[mutable usize&])
                algebra_mode: u8& = special[1].cast[u8&]
                if algebra_mode[0] != 0.u8():
                    h: i64& = special[0].cast[i64&]
                    opened: u8& = special[2].cast[u8&]
                    if button != 3 or opened[0] == 0.u8():
                        unused_edit: mutable u8 = 0.u8()
                        unused_config: mutable i64 = 0
                        unused_results: mutable usize = 0.usize()
                        _ = sdl_text_task_click(1, h[0], opened[0].i64(), px, py, pixel_width, pixel_height, special[4].cast[mutable i32&], special[6].cast[mutable i64&], &unused_edit, &unused_config, &unused_results)
                scramble_mode: u8& = special[31].cast[u8&]
                if scramble_mode[0] != 0.u8():
                    h: i64& = special[30].cast[i64&]
                    opened: u8& = special[32].cast[u8&]
                    if button != 3 or opened[0] == 0.u8():
                        unused_config: mutable i64 = 0
                        unused_results: mutable usize = 0.usize()
                        start <- sdl_text_task_click(2, h[0], opened[0].i64(), px, py, pixel_width, pixel_height, special[34].cast[mutable i32&], special[36].cast[mutable i64&], special[37].cast[mutable u8&], &unused_config, &unused_results)
            scrabble_mode: u8& = special[41].cast[u8&]
            if scrabble_mode[0] != 0.u8():
                h: i64& = special[40].cast[i64&]
                opened: u8& = special[42].cast[u8&]
                sdl_word_pointer(0, h[0], opened[0].i64(), motion, button, px, py, pixel_width, pixel_height, special[44].cast[mutable i32&], special[46].cast[mutable i64&])
            crossword_mode: u8& = special[51].cast[u8&]
            if crossword_mode[0] != 0.u8():
                h: i64& = special[50].cast[i64&]
                opened: u8& = special[52].cast[u8&]
                sdl_word_pointer(1, h[0], opened[0].i64(), motion, button, px, py, pixel_width, pixel_height, special[54].cast[mutable i32&], special[56].cast[mutable i64&])
            return start

export fn nw_sdl_active_pointer(rows: usize&?, special_rows: usize&?, motion: i64, button: i64, x: f32, y: f32, pixel_width: i32, pixel_height: i32, width: i32, height: i32) -> i32 = sdl_active_pointer

extern SDL_GetWindowSize(window: mutable void&, width: mutable i32&, height: mutable i32&) -> bool
extern SDL_GetWindowSizeInPixels(window: mutable void&, width: mutable i32&, height: mutable i32&) -> bool

def sdl_window_pointer(window: mutable void&?, rows: usize&?, special_rows: usize&?, motion: i64, button: i64, x: f32, y: f32, buttons: u32) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return 0.i32() if window == null or (motion == 1 and buttons != 0.u32() and sdl_active_handle(rows, 67.usize()) == 0 and sdl_active_handle(rows, 68.usize()) == 0 and sdl_active_handle(rows, 69.usize()) == 0 and sdl_active_handle(rows, 70.usize()) == 0 and sdl_active_handle(rows, 71.usize()) == 0 and sdl_active_handle(rows, 76.usize()) == 0 and sdl_active_handle(rows, 77.usize()) == 0 and sdl_active_handle(rows, 101.usize()) == 0 and sdl_active_handle(rows, 102.usize()) == 0 and sdl_active_handle(rows, 103.usize()) == 0 and sdl_active_handle(rows, 104.usize()) == 0 and sdl_active_handle(rows, 105.usize()) == 0 and sdl_active_handle(rows, 126.usize()) == 0 and sdl_active_handle(rows, 127.usize()) == 0 and sdl_active_handle(rows, 128.usize()) == 0 and sdl_active_handle(rows, 129.usize()) == 0 and sdl_active_handle(rows, 130.usize()) == 0 and sdl_active_handle(rows, 131.usize()) == 0 and sdl_active_handle(rows, 132.usize()) == 0 and sdl_active_handle(rows, 133.usize()) == 0 and sdl_active_handle(rows, 106.usize()) == 0 and sdl_active_handle(rows, 107.usize()) == 0 and sdl_active_handle(rows, 108.usize()) == 0 and sdl_active_handle(rows, 109.usize()) == 0 and sdl_active_handle(rows, 110.usize()) == 0 and sdl_active_handle(rows, 111.usize()) == 0 and sdl_active_handle(rows, 112.usize()) == 0 and sdl_active_handle(rows, 113.usize()) == 0 and sdl_active_handle(rows, 114.usize()) == 0 and sdl_active_handle(rows, 115.usize()) == 0 and sdl_active_handle(rows, 116.usize()) == 0 and sdl_active_handle(rows, 117.usize()) == 0 and sdl_active_handle(rows, 118.usize()) == 0 and sdl_active_handle(rows, 119.usize()) == 0 and sdl_active_handle(rows, 120.usize()) == 0 and sdl_active_handle(rows, 121.usize()) == 0 and sdl_active_handle(rows, 122.usize()) == 0 and sdl_active_handle(rows, 123.usize()) == 0 and sdl_active_handle(rows, 124.usize()) == 0 and sdl_active_handle(rows, 125.usize()) == 0 and sdl_active_handle(rows, 141.usize()) == 0)
        target: mutable void& = window
        pixel_width: mutable i32 = 0.i32()
        pixel_height: mutable i32 = 0.i32()
        width: mutable i32 = 0.i32()
        height: mutable i32 = 0.i32()
        # SDL writes each dimension during the call and does not retain the output pointers.
        trusted Unsafe.PointerCast:
            _ = SDL_GetWindowSizeInPixels(target, (&pixel_width).uintptr().cast[mutable i32&], (&pixel_height).uintptr().cast[mutable i32&])
            _ = SDL_GetWindowSize(target, (&width).uintptr().cast[mutable i32&], (&height).uintptr().cast[mutable i32&])
        active_button: i64 = (1 if (buttons & 1.u32()) != 0.u32() else 0) if motion == 1 and (sdl_active_handle(rows, 101.usize()) != 0 or sdl_active_handle(rows, 123.usize()) != 0 or sdl_active_handle(rows, 124.usize()) != 0) else button
        if (sdl_active_pointer(rows, special_rows, motion, active_button, x, y, pixel_width, pixel_height, width, height) can Global{Read,Write}) != 0.i32():
            sdl_apply_text_input(target, 1.i32())
        return 1.i32()

export fn nw_sdl_window_pointer(window: mutable void&?, rows: usize&?, special_rows: usize&?, motion: i64, button: i64, x: f32, y: f32, buttons: u32) -> i32 = sdl_window_pointer

# Collect the active controller slots used by frame rendering and timers.
# Rows use the same handle/mode pointer pairs as hub exit routing.
def sdl_collect_active(rows: usize&?, frames: mutable i64&?, timed: mutable i64&?):
    can Abort.Panic, Unsafe.PointerCast:
        return if rows == null or frames == null or timed == null
        trusted Unsafe.PointerCast:
            pointers: usize& = rows
            frame: mutable i64& = frames
            clocked: mutable i64& = timed
            at: mutable usize = 0.usize()
            while at < 142.usize() |at, frame|:
                frame[at] <- 0
                at <- at + 1.usize()
            at <- 0.usize()
            while at < 23.usize() |at, clocked|:
                clocked[at] <- 0
                at <- at + 1.usize()
            at <- 0.usize()
            while at < 142.usize() |at, pointers, frame, clocked|:
                base: usize = at * 2.usize()
                if pointers[base] != 0.usize() and pointers[base + 1.usize()] != 0.usize():
                    h: i64& = pointers[base].cast[i64&]
                    mode: u8& = pointers[base + 1.usize()].cast[u8&]
                    if mode[0] != 0.u8():
                        slot: usize = sdl_row_slot(at)
                        frame[slot] <- h[0]
                        time_slot: i64 = 22 if at == 42.usize() else (0 if at == 2.usize() else (1 if at == 3.usize() else (2 if at == 4.usize() else (at.i64() - 3 if at >= 6.usize() and at <= 10.usize() else (at.i64() - 4 if at >= 12.usize() and at <= 15.usize() else (12 if at == 17.usize() else (at.i64() - 15 if at >= 28.usize() and at < 37.usize() else -1)))))))
                        clocked[time_slot.usize()] <- h[0] if time_slot >= 0
                at <- at + 1.usize()

export fn nw_sdl_collect_active(rows: usize&?, frames: mutable i64&?, timed: mutable i64&?) = sdl_collect_active

def sdl_frame_dimensions(window: mutable void&?, dimensions: mutable i32&):
    can Abort.Panic, Unsafe.PointerCast:
        return if window == null
        target: mutable void& = window
        trusted Unsafe.PointerCast:
            _ = SDL_GetWindowSizeInPixels(target, dimensions, (&dimensions[1]).uintptr().cast[mutable i32&])

# A software screenshot inherits its requested dimensions and uses fixed ticks.
def sdl_prepare_frame(window: mutable void&?, dimensions: mutable i32&, timed: i64&, special_rows: usize&, last_marble: mutable u64&, black: i64, options: mutable i64&):
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
        if window == null:
            sdl_advance_screenshot(timed, last_marble)
        else:
            sdl_advance_frame(timed, last_marble)
            sdl_frame_dimensions(window, dimensions)
        sdl_special_frame_options(special_rows, options)
        options[41] <- black

export fn nw_sdl_prepare_frame(window: mutable void&?, dimensions: mutable i32&, timed: i64&, special_rows: usize&, last_marble: mutable u64&, black: i64, options: mutable i64&) = sdl_prepare_frame

def sdl_prepare_desktop_frame(window: mutable void&?, dimensions: mutable i32&, rows: usize&, special_rows: usize&, last_marble: mutable u64&, black: i64, dest: i64, capacity: i64, length: mutable i64&, hub: i64, category: i64, selected: i64, writer: usize, playing: i64, step: mutable u8&, last_step: mutable u64&, trial: mutable i64&, marble_advance: usize, physics: usize, physics_tick: usize) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read:
        timed: mutable i64[23] = zeroed
        frame_handles: mutable i64[142] = zeroed
        frame_options: mutable i64[42] = zeroed
        trusted Unsafe.PointerCast:
            maze_mode: u8& = rows[1].cast[u8&]
            sdl_fallback_frame(maze_mode[0].i64(), playing, step, last_step, trial)
            clocked: mutable i64& = (&timed[0]).uintptr().cast[mutable i64&]
            frames: mutable i64& = (&frame_handles[0]).uintptr().cast[mutable i64&]
            options: mutable i64& = (&frame_options[0]).uintptr().cast[mutable i64&]
            sdl_collect_active(rows, frames, clocked)
            if marble_advance != 0.usize():
                advance: fn(usize, i64, usize, usize) -> i32 = marble_advance.cast[fn(usize, i64, usize, usize) -> i32]
                return 0.i32() if advance(physics, timed[2], 1.usize() if window == null else 0.usize(), physics_tick) == 0.i32()
                timed[2] <- 0
            sdl_prepare_frame(window, dimensions, clocked, special_rows, last_marble, black, options)
            if window != null:
                _ = SDLNearer::advance(frames[52], SDL_GetTicks().i64())
                _ = SDLPov::advance(frames[54], SDL_GetTicks().i64())
                _ = SDLInside::advance(frames[55], SDL_GetTicks().i64())
