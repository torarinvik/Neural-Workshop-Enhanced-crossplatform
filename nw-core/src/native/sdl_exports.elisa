def nback3d_destroy(handle: i64) -> i64:
    can Blocking.IO, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            heap_pointer: heap void& = handle.uintptr().cast[heap void&]
            run: heap NBack3DGame::NBack3DRun& = handle.uintptr().cast[heap NBack3DGame::NBack3DRun&]
            if run.applause_voice != 0.usize():
                SDLAudio::stop(run.applause_voice.cast[mutable void&])
            sdl_reward_mixer_stop(run.music_library, run.music_mixer)
            if run.stats_path != 0.usize():
                SDL_free(run.stats_path.cast[heap void&])
            if run.history_chart != 0.usize():
                SDL_free(run.history_chart.cast[heap void&])
            free(heap_pointer)
            return 0

def sdl_nback3d_applause(handle: i64):
    can Blocking.IO, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap NBack3DGame::NBack3DRun& = handle.uintptr().cast[mutable heap NBack3DGame::NBack3DRun&]
            if run.applause_voice != 0.usize():
                voice: mutable void& = run.applause_voice.cast[mutable void&]
                if run.applause_pending or SDLAudio::queued(voice) <= 0.i32():
                    SDLAudio::stop(voice)
                    run.applause_voice <- 0.usize()
            return if not run.applause_pending
            run.applause_pending <- false
            if SDL_GetBasePath() is base:
                path: mutable u8[4096] = zeroed
                length: i32 = SDL_snprintf(&path[0], 4096.usize(), "%sres/misc/applause/applause.wav", base.cast[cstr])
                if length > 0.i32() and length < 4096.i32():
                    if SDLAudio::play_wav((&path[0]).uintptr().cast[cstr], run.applause_gain) is voice:
                        run.applause_voice <- voice.uintptr()
                        run.applause_live_gain <- run.applause_gain.f64()

