            return sdl_mr_time_selftest().i32() if syllogism_argument_is(flag, "--selftest-mr-time")
            return sdl_graph_mapping_selftest().i32() if syllogism_argument_is(flag, "--selftest-graph-mapping")
            return sdl_matrix_reasoning_selftest().i32() if syllogism_argument_is(flag, "--selftest-matrix-reasoning")
