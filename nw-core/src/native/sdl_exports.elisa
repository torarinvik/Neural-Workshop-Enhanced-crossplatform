def buzz_wire_frame_write(dest: i64, capacity: i64, handle: i64,
                          black_background: i64, width: i64, height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if dest <= 0 or capacity <= 0 or handle <= 0
        trusted Unsafe.PointerCast:
            run: heap BuzzWireGame::BuzzWireRun& = handle.uintptr().cast[heap BuzzWireGame::BuzzWireRun&]
            list: mutable Display::DisplayList = Display::DisplayList()
            BuzzWireGame::render(run, black_background != 0, width.f64(), height.f64(), &list)
            encoded: darray[u8] = Display::encode_binary(&list)
            length: i64 = encoded.count.i64()
            return 0 if length <= 0 or length > capacity
            target: mutable u8& = dest.uintptr().cast[mutable u8&]
            memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            return length

def buzz_wire_destroy(handle: i64) -> i64:
    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            heap_pointer: heap void& = handle.uintptr().cast[heap void&]
            free(heap_pointer)
            return 0

# Advance all active timed controllers with the SDL clock.
extern SDL_GetTicks() -> u64

# The idle preview responds to space/right and advances at 700 ms while playing.
def sdl_fallback_key(key: i64, playing: mutable u8&?, step: mutable u8&?):
    return if playing == null or step == null
    active: mutable u8& = playing
    pending: mutable u8& = step
    if key == 32:
        active[0] <- 0.u8() if active[0] != 0.u8() else 1.u8()
    pending[0] <- 1.u8() if key == 1073741903

export fn nw_sdl_fallback_key(key: i64, playing: mutable u8&?, step: mutable u8&?) = sdl_fallback_key

def sdl_fallback_frame(maze: i64, playing: i64, step: mutable u8&?, last_step: mutable u64&?, trial: mutable i64&?):
    return if step == null or last_step == null or trial == null
    pending: mutable u8& = step
    last: mutable u64& = last_step
    count: mutable i64& = trial
    if maze == 0 and playing != 0 and SDL_GetTicks() - last[0] > 700.u64():
        pending[0] <- 1.u8()
        last[0] <- SDL_GetTicks()
    count[0] <- count[0] + 1 if pending[0] != 0.u8()

export fn nw_sdl_fallback_frame(maze: i64, playing: i64, step: mutable u8&?, last_step: mutable u64&?, trial: mutable i64&?) = sdl_fallback_frame


def sdl_advance_frame_at(handles: i64&?, last_marble: mutable u64&?, now: u64):
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return if handles == null or last_marble == null
        active: i64& = handles
        last: mutable u64& = last_marble
        if active[0] != 0:
            _ = monkey_ladder_action(active[0], 1, 0, now.i64())
        if active[1] != 0:
            _ = nback3d_action(active[1], 2, 0, now.i64())
        if active[2] != 0:
            _ = marble_advance(active[2], (now - last[0]).i64())
            last[0] <- now
        if active[3] != 0:
            _ = count_advance(active[3], now.i64())
        if active[4] != 0:
            _ = mr_time_advance(active[4], now.i64())
        if active[5] != 0:
            _ = graph_mapping_advance(active[5], now.i64())
        if active[6] != 0:
            _ = matrix_reasoning_advance(active[6], now.i64())
        if active[7] != 0:
            _ = in_the_dark_advance(active[7], now.i64())
        if active[8] != 0:
            _ = removals_advance(active[8], now.i64())
        if active[9] != 0:
            _ = custody_advance(active[9], now.i64())
        if active[10] != 0:
            _ = concentration_advance(active[10], now.i64())
        if active[11] != 0:
            _ = recognition_advance(active[11], now.i64())
        if active[12] != 0:
            _ = reflex_advance(active[12], now.i64())
        if active[13] != 0:
            _ = ncup_monte_advance(active[13], now.i64())
        if active[14] != 0:
            _ = tracking_advance(active[14], now.i64())
        if active[15] != 0:
            _ = lookout_advance(active[15], now.i64())
        if active[16] != 0:
            _ = pursuit_advance(active[16], now.i64())
        if active[17] != 0:
            _ = out_of_sight_advance(active[17], now.i64())
        if active[18] != 0:
            _ = buzz_wire_advance(active[18], now.i64())
        if active[19] != 0:
            _ = donkey_advance(active[19], now.i64())
        if active[20] != 0:
            _ = two_hands_advance(active[20], now.i64())
        if active[21] != 0:
            _ = overrun_advance(active[21], now.i64())
        sdl_cookie_advance(active[22], now.i64())

def sdl_advance_frame(handles: i64&?, last_marble: mutable u64&?):
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
        sdl_advance_frame_at(handles, last_marble, SDL_GetTicks())

# Pyglet schedules timed sessions at 30 Hz before taking the screenshot at
# 300 ms. Reproduce those ticks on the software renderer without a window.
def sdl_advance_screenshot(handles: i64&?, last_marble: mutable u64&?):
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return if last_marble == null
        clock: mutable u64& = last_marble
        start: u64 = clock[0]
        for frame in 1..<10 |frame, handles, last_marble, start|:
            sdl_advance_frame_at(handles, last_marble, start + (frame.u64() * 1000.u64()) / 30.u64())

export fn nw_sdl_advance_screenshot(handles: i64&?, last_marble: mutable u64&?) = sdl_advance_screenshot

export fn nw_sdl_advance_frame(handles: i64&?, last_marble: mutable u64&?) = sdl_advance_frame

# Translate and dispatch simple SDL key-down events inside the native host.
def sdl_dispatch_task_key(task: i64, handle: i64, key: i64):
    can Blocking.IO, Memory.Release, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
        phase: mutable i64 = 0
        cursor: mutable i64 = 0
        count: mutable i64 = 0
        phase <- count_info(handle, 0) if task == 0
        phase <- mr_time_info(handle, 0) if task == 1
        phase <- graph_mapping_info(handle, 0) if task == 2
        phase <- matrix_reasoning_info(handle, 0) if task == 3
        phase <- concentration_info(handle, 0) if task == 7
        phase <- recognition_info(handle, 0) if task == 8
        phase <- trivia_info(handle, 0) if task == 9
        phase <- monkey_ladder_info(handle, 0) if task == 16
        phase <- jigsaw_info(handle, 0) if task == 17
        phase <- sudoku_info(handle, 0) if task == 18
        phase <- go_info(handle, 0) if task == 19
        phase <- ncup_monte_info(handle, 0) if task == 20
        phase <- tracking_info(handle, 0) if task == 21
        phase <- lookout_info(handle, 0) if task == 22
        phase <- pursuit_info(handle, 0) if task == 23
        phase <- out_of_sight_info(handle, 0) if task == 24
        phase <- buzz_wire_info(handle, 0) if task == 25
        phase <- donkey_info(handle, 0) if task == 26
        phase <- two_hands_info(handle, 0) if task == 27
        phase <- overrun_info(handle, 0) if task == 28
        phase <- crossed_wires_info(handle, 0) if task == 29
        phase <- marble_info(handle, 0) if task == 32
        if task == 7:
            cursor <- concentration_info(handle, 9)
            count <- concentration_info(handle, 2)
        count <- sudoku_info(handle, 5) if task == 18
        count <- crossed_wires_info(handle, 4) if task == 29
        if task == 19 and phase == 1 and (key == 32 or key == 13):
            cursor <- go_info(handle, 6) * go_info(handle, 4) + go_info(handle, 5)
        value: mutable i64 = 0
        trusted Unsafe.PointerCast:
            if task == 11:
                return if handle <= 0
                nback: heap NBack3DGame::NBack3DRun& = handle.uintptr().cast[heap NBack3DGame::NBack3DRun&]
                if key == nback.match_key and nback.phase != NBack3DGame::PHASE_READY and nback.phase != NBack3DGame::PHASE_DONE and nback.phase != NBack3DGame::PHASE_ERROR:
                    _ = nback3d_action(handle, NBack3DGame::ACTION_MATCH, 0, SDL_GetTicks().i64())
                    return
                return if key == 97
            mapped: i64 = SDLTaskKeys::map(task, key, phase, cursor, count, (&value).uintptr().cast[mutable i64&])
            return if mapped < 0
            if task == 0:
                _ = count_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 1:
                _ = mr_time_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 2:
                _ = graph_mapping_action(handle, mapped, SDL_GetTicks().i64())
            if task == 3:
                _ = matrix_reasoning_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 4:
                _ = in_the_dark_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 5:
                _ = removals_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 6:
                _ = custody_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 7:
                _ = concentration_action(handle, mapped, value, SDL_GetTicks().i64())
                sdl_concentration_play(handle)
            if task == 8:
                _ = recognition_action(handle, mapped, value, SDL_GetTicks().i64())
                sdl_recognition_play(handle)
            if task == 9:
                _ = trivia_action(handle, mapped, value)
            if task == 10:
                _ = reflex_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 11:
                _ = nback3d_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 12:
                _ = fog_action(handle, mapped)
            if task == 13:
                _ = tetris_action(handle, mapped)
            if task == 14:
                _ = you_are_here_action(handle, mapped, SDL_GetTicks().i64())
            if task == 15:
                _ = sokoban_action(handle, mapped, SDL_GetTicks().i64())
            if task == 16:
                _ = monkey_ladder_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 17:
                return if handle <= 0
                jigsaw: JigsawGame::JigsawRun& = handle.uintptr().cast[JigsawGame::JigsawRun&]
                if mapped == JigsawGame::ACTION_START or jigsaw.photo_timed:
                    _ = jigsaw_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 18:
                _ = sudoku_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 19:
                _ = go_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 20:
                _ = ncup_monte_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 21:
                _ = tracking_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 22:
                _ = lookout_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 23:
                _ = pursuit_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 24:
                _ = out_of_sight_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 25:
                _ = buzz_wire_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 26:
                _ = donkey_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 27:
                _ = two_hands_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 28:
                _ = overrun_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 29:
                _ = crossed_wires_action(handle, mapped, value, SDL_GetTicks().i64())
            if task == 32:
                _ = marble_action(handle, mapped, value, 0)

export fn nw_sdl_dispatch_task_key(task: i64, handle: i64, key: i64) = sdl_dispatch_task_key

# The four groups preserve the C shell's priority around special handlers.
# A matched task consumes the event even when its key has no mapped action.
def sdl_dispatch_key_group(handles: i64&?, group: i64, key: i64) -> i64:
    can Blocking.IO, Memory.Release, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return 0 if handles == null
        active: i64& = handles
        if group == 0:
            if active[14] != 0:
                sdl_dispatch_task_key(14, active[14], key)
                return 1
            if active[15] != 0:
                sdl_dispatch_task_key(15, active[15], key)
                return 1
            if active[16] != 0:
                sdl_dispatch_task_key(16, active[16], key)
                return 1
            if active[11] != 0:
                sdl_dispatch_task_key(11, active[11], key)
                return 1
        elif group == 1:
            if active[13] != 0:
                sdl_dispatch_task_key(13, active[13], key)
                return 1
            if active[0] != 0:
                sdl_dispatch_task_key(0, active[0], key)
                return 1
            if active[1] != 0:
                sdl_dispatch_task_key(1, active[1], key)
                return 1
            if active[2] != 0:
                sdl_dispatch_task_key(2, active[2], key)
                return 1
            if active[3] != 0:
                sdl_dispatch_task_key(3, active[3], key)
                return 1
            if active[4] != 0:
                sdl_dispatch_task_key(4, active[4], key)
                return 1
            if active[12] != 0:
                sdl_dispatch_task_key(12, active[12], key)
                return 1
            if active[5] != 0:
                sdl_dispatch_task_key(5, active[5], key)
                return 1
            if active[6] != 0:
                sdl_dispatch_task_key(6, active[6], key)
                return 1
            if active[7] != 0:
                sdl_dispatch_task_key(7, active[7], key)
                return 1
            if active[8] != 0:
                sdl_dispatch_task_key(8, active[8], key)
                return 1
            if active[9] != 0:
                sdl_dispatch_task_key(9, active[9], key)
                return 1
            if active[10] != 0:
                sdl_dispatch_task_key(10, active[10], key)
                return 1
        elif group == 2:
            if active[17] != 0:
                sdl_dispatch_task_key(17, active[17], key)
                return 1
            if active[18] != 0:
                sdl_dispatch_task_key(18, active[18], key)
                return 1
        elif group == 3:
            if active[29] != 0:
                sdl_dispatch_task_key(29, active[29], key)
                return 1
            if active[20] != 0:
                sdl_dispatch_task_key(20, active[20], key)
                return 1
            if active[21] != 0:
                sdl_dispatch_task_key(21, active[21], key)
                return 1
            if active[22] != 0:
                sdl_dispatch_task_key(22, active[22], key)
                return 1
            if active[23] != 0:
                sdl_dispatch_task_key(23, active[23], key)
                return 1
            if active[24] != 0:
                sdl_dispatch_task_key(24, active[24], key)
                return 1
            if active[25] != 0:
                sdl_dispatch_task_key(25, active[25], key)
                return 1
            if active[26] != 0:
                sdl_dispatch_task_key(26, active[26], key)
                return 1
            if active[27] != 0:
                sdl_dispatch_task_key(27, active[27], key)
                return 1
            if active[28] != 0:
                sdl_dispatch_task_key(28, active[28], key)
                return 1
        return 0

export fn nw_sdl_dispatch_key_group(handles: i64&?, group: i64, key: i64) -> i64 = sdl_dispatch_key_group

def sdl_dispatch_key_release(task: i64, handle: i64, key: i64):
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return if task != 25 and task != 33
        value: mutable i64 = 0
        trusted Unsafe.PointerCast:
            action: i64 = SDLTaskKeys::map(task, key, 1, 0, 0, (&value).uintptr().cast[mutable i64&])
            if task == 25 and action == 1:
                _ = buzz_wire_action(handle, 2, value, SDL_GetTicks().i64())
            if task == 33 and action >= 0:
                _ = marble_release(handle, action)

export fn nw_sdl_dispatch_key_release(task: i64, handle: i64, key: i64) = sdl_dispatch_key_release

