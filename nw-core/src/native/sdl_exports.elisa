def sdl_create_word_task_seeded(task: i64, rung: i64, trials: i64, show: i64, adaptive: i64, lexicon: u8&?, seed: i64) -> i64:
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0 if task != 0 and task != 1
        handle: i64 = crossword_create(rung, trials, show, adaptive, seed) if task == 0 else scrabble_create(rung, trials, show, adaptive, seed)
        return 0 if handle == 0
        if sdl_load_word_index(handle, lexicon, task) != 0:
            if task == 0:
                _ = crossword_destroy(handle)
            else:
                _ = scrabble_destroy(handle)
            return 0
        return handle

