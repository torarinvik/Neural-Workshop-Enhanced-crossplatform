                                    interval_ms, stimulus_ms, feedback_ms, seed)
            return pointer.cast[u8&].uintptr().i64()

extern SDL_GetKeyName(key: u32) -> cstr

# Pyglet uses X11-style symbols for non-printable keys.
def sdl_nback_match_key(symbol: i64) -> i64:
    return symbol if symbol >= 32 and symbol <= 126 and symbol != 112 and symbol != 120
    return 8 if symbol == 65288
    return 9 if symbol == 65289
    return 13 if symbol == 65293
    return 127 if symbol == 65535
    return 1073741898 if symbol == 65360 # Home
    return 1073741904 if symbol == 65361 # Left
    return 1073741906 if symbol == 65362 # Up
    return 1073741903 if symbol == 65363 # Right
    return 1073741905 if symbol == 65364 # Down
    return 1073741899 if symbol == 65365 # Page Up
    return 1073741902 if symbol == 65366 # Page Down
    return 1073741901 if symbol == 65367 # End
    return 1073741897 if symbol == 65379 # Insert
    return 1073741882 + symbol - 65470 if symbol >= 65470 and symbol <= 65481 and symbol != 65477 and symbol != 65479 and symbol != 65480
    return 1073741912 if symbol == 65421 # Keypad Enter
    return 1073741909 if symbol == 65450 # Keypad Multiply
    return 1073741911 if symbol == 65451 # Keypad Add
    return 1073741910 if symbol == 65453 # Keypad Subtract
    return 1073741923 if symbol == 65454 # Keypad Decimal
    return 1073741908 if symbol == 65455 # Keypad Divide
    return 1073741922 if symbol == 65456 # Keypad 0
    return 1073741913 + symbol - 65457 if symbol >= 65457 and symbol <= 65465
    return 97

def sdl_nback3d_create(seed: i64, adaptive: bool) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        handle: i64 = nback3d_create(2, 1, 24, 3000, 500, 200, seed)
        return handle if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap NBack3DGame::NBack3DRun& = handle.uintptr().cast[mutable heap NBack3DGame::NBack3DRun&]
            progress: mutable NBack3DGame::Progression& = &run.progression
            progress.enabled <- adaptive
            run.save_progress <- adaptive
            run.music_gain <- 1.0.f32() if adaptive else 0.0.f32()
            run.applause_gain <- 1.0.f32()
            progress.jaeggi <- false
            progress.immediate_fallback <- false
            progress.advance_threshold <- 80
            progress.fallback_threshold <- 50
            progress.fallback_sessions <- 3
            progress.base_trials <- 20
            progress.trials_factor <- 1
            progress.trials_exponent <- 2
            size: mutable i64 = 0
            reset_daily: mutable bool = false
            rollover: mutable i64 = 4
            headless: mutable bool = sdl_headless_environment()
            tick: mutable i64 = NBack3DGame::TICK_MS
            ticks: mutable i64 = 30
            interval: mutable i64 = 0
            stimulus: mutable i64 = 500
            stats_name: mutable u8[4096] = zeroed
            if sdl_media_config(&size) is raw:
                data: heap u8& = raw.cast[heap u8&]
                headless <- true if sdl_config_value(data, size, "HEADLESS", true) != 0
                run.match_key <- sdl_nback_match_key(sdl_config_option(data, size, "KEY_POSITION1", 0, 97))
                default_level: i64 = sdl_config_option(data, size, "BACK_DEFAULT", 0, 2)
                progress.next_nback <- NBack3DGame::clamp_nback(sdl_config_option(data, size, "BACK_10", 0, default_level))
                run.cubes <- NBack3DGame::clamp_cubes(sdl_config_option(data, size, "GRID_3D_CUBES", 0, 1))
                tick <- sdl_config_option(data, size, "TICK_DURATION_MS", 0, tick)
                default_ticks: i64 = sdl_config_option(data, size, "TICKS_DEFAULT", 0, ticks)
                ticks <- sdl_config_option(data, size, "TICKS_10", 0, default_ticks)
                interval <- sdl_config_option(data, size, "TRIAL_INTERVAL_MS", 0, interval)
                stimulus <- sdl_config_option(data, size, "STIMULUS_DURATION_MS", 0, stimulus)
                feedback_ms: i64 = sdl_config_option(data, size, "FEEDBACK_DURATION_MS", 0, 200)
                run.feedback_ms <- 1 if feedback_ms < 0 else (feedback_ms if feedback_ms > 0 else 200)
                reset_daily <- sdl_config_option(data, size, "RESET_LEVEL", 1, 0) != 0
                configured_rollover: i64 = sdl_config_option(data, size, "ROLLOVER_HOUR", 0, 4)
                rollover <- configured_rollover if configured_rollover >= 0 and configured_rollover <= 23
                _ = sdl_config_option(data, size, "STATSFILE", 4, 0, &stats_name[0], 4096)
                if sdl_config_option(data, size, "USE_SESSION_FEEDBACK", 1, 1) == 0 or sdl_config_option(data, size, "USE_APPLAUSE", 1, 1) == 0:
                    run.applause_gain <- 0.0.f32()
                else:
                    run.applause_gain <- sdl_config_option(data, size, "SFX_VOLUME", 3, 1000000).f32() / 1000000.0.f32()
                feedback: bool = sdl_config_option(data, size, "USE_SESSION_FEEDBACK", 1, 1) != 0
                music: bool = sdl_config_option(data, size, "USE_MUSIC", 1, 1) != 0
                manual_music: bool = sdl_config_option(data, size, "USE_MUSIC_MANUAL", 1, 0) != 0
                run.music_gain <- 0.0.f32()
                if feedback and music and (adaptive or manual_music):
                    run.music_gain <- sdl_config_option(data, size, "MUSIC_VOLUME", 3, 1000000).f32() / 1000000.0.f32()
                progress.immediate_fallback <- sdl_config_option(data, size, "JAEGGI_MODE", 1, 0) != 0
                progress.jaeggi <- progress.immediate_fallback or sdl_config_option(data, size, "JAEGGI_SCORING", 1, 0) != 0
                advance: i64 = sdl_config_option(data, size, "JAEGGI_ADVANCE" if progress.jaeggi else "THRESHOLD_ADVANCE", 0, 90 if progress.jaeggi else 80)
                fallback: i64 = sdl_config_option(data, size, "JAEGGI_FALLBACK" if progress.jaeggi else "THRESHOLD_FALLBACK", 0, 75 if progress.jaeggi else 50)
                progress.advance_threshold <- advance if advance >= 0 and advance <= 100 else (90 if progress.jaeggi else 80)
                progress.fallback_threshold <- fallback if fallback >= 0 and fallback <= 100 else (75 if progress.jaeggi else 50)
                sessions: i64 = sdl_config_option(data, size, "THRESHOLD_FALLBACK_SESSIONS", 0, 3)
                progress.fallback_sessions <- sessions if sessions > 0 else 3
                base: i64 = sdl_config_option(data, size, "NUM_TRIALS", 0, 20)
                factor: i64 = sdl_config_option(data, size, "NUM_TRIALS_FACTOR", 0, 1)
                exponent: i64 = sdl_config_option(data, size, "NUM_TRIALS_EXPONENT", 0, 2)
                progress.base_trials <- base if base >= 0 and base <= NBack3DGame::MAX_TRIALS
                progress.trials_factor <- factor if factor >= 0 and factor <= NBack3DGame::MAX_TRIALS
                progress.trials_exponent <- exponent if exponent >= 0
                SDL_free(raw)
            tick <- sdl_nback_timing_override(1, tick)
            interval <- sdl_nback_timing_override(0, interval)
            stimulus <- sdl_nback_timing_override(2, stimulus)
            if headless:
                run.music_gain <- 0.0.f32()
                run.applause_gain <- 0.0.f32()
                if interval == 0:
                    tick <- 1 if tick == 0 or tick >= 100
                    interval <- tick * 10 if tick > 1 else 10
            run.tick_ms <- 1 if tick < 0 else (60000 if tick > 60000 else (tick if tick > 0 else NBack3DGame::TICK_MS))
            derived: i64 = (60000 if ticks > 60000 else (ticks if ticks > 0 else 3)) * run.tick_ms
            run.interval_ms <- clamp_trial_interval_ms(interval if interval > 0 else derived, run.tick_ms, 3, 60000)
            run.next_interval_ms <- run.interval_ms
            run.stimulus_ms <- 1 if stimulus < 0 else (stimulus if stimulus > 0 else 500)
            run.history_rollover <- rollover
            run.clinical_log <- sdl_media_flag("NW_CLINICAL_LOG")
            run.stats_path <- sdl_nback3d_stats_path(&stats_name[0])
            if adaptive:
                if not sdl_nback3d_restore(progress, reset_daily, rollover):
                    sdl_nback3d_import_history(progress, &stats_name[0], rollover if reset_daily else -1)
            run.nback <- progress.next_nback
            run.total_trials <- NBack3DGame::adaptive_trial_count(progress, run.nback)
            return handle

