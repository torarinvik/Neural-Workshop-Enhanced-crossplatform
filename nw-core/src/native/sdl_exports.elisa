            active[47] <- 0
        if active[46] != 0:
            SDLTriage::close(active[46])
            active[46] <- 0
        if active[45] != 0:
            SDLHiddenWiring::close(active[45])
            active[45] <- 0

export fn nw_sdl_shutdown(handles: mutable i64&?, syllogism_results: mutable usize&?, numberology_results: mutable usize&?) = sdl_shutdown

# Translate shell task-row order to the frame/shutdown handle order.
def sdl_row_slot(index: usize) -> usize:
    return index if index >= 37.usize()
    return index if index < 19.usize() else (34.usize() if index == 19.usize() else (index - 1.usize() if index <= 23.usize() else (24.usize() if index == 24.usize() else (35.usize() if index == 25.usize() else (36.usize() if index == 26.usize() else (23.usize() if index == 27.usize() else index - 3.usize()))))))

# Collect all owned handles, including inactive ones, and close the actual
# result managers in the same order as the existing shutdown routine.
def sdl_shutdown_rows(rows: usize&?, syllogism_results: mutable usize&?, numberology_results: mutable usize&?):
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return if rows == null
        trusted Unsafe.PointerCast:
            table: usize& = rows
            handles: mutable i64[142] = zeroed
            at: mutable usize = 0.usize()
            while at < 142.usize() |at, table, handles|:
                address: usize = table[at * 2.usize()]
                if address != 0.usize():
                    handle: i64& = address.cast[i64&]
                    handles[sdl_row_slot(at)] <- handle[0]
                at <- at + 1.usize()
            sdl_shutdown((&handles[0]).uintptr().cast[mutable i64&], syllogism_results, numberology_results) can Global{Read,Write}
            at <- 0.usize()
            while at < 142.usize() |at, table|:
                address: usize = table[at * 2.usize()]
                if address != 0.usize():
                    handle: mutable i64& = address.cast[mutable i64&]
                    handle[0] <- 0
                at <- at + 1.usize()

export fn nw_sdl_shutdown_rows(rows: usize&?, syllogism_results: mutable usize&?, numberology_results: mutable usize&?) = sdl_shutdown_rows

def sdl_close_desktop(state: mutable usize&, surface: usize, rows: usize&, syllogism: mutable usize&, numberology: mutable usize&, marble_close: usize, marble_state: usize, physics: usize):
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
        sdl_profile_picker_close()
        SDLCameraHost::close()
        if marble_close != 0.usize():
            trusted Unsafe.PointerCast:
                close: fn(usize, usize) -> void = marble_close.cast[fn(usize, usize) -> void]
                close(marble_state, physics)
        sdl_screenshot_close(state, surface)
        sdl_shutdown_rows(rows, syllogism, numberology)
        SDL_Quit()

export fn nw_sdl_close_desktop(state: mutable usize&, surface: usize, rows: usize&, syllogism: mutable usize&, numberology: mutable usize&, marble_close: usize, marble_state: usize, physics: usize) = sdl_close_desktop


# Read a handle only while its associated mode is active.
def sdl_active_handle(rows: usize&?, index: usize) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return 0 if rows == null or index >= 142.usize()
        trusted Unsafe.PointerCast:
            table: usize& = rows
            base: usize = index * 2.usize()
            return 0 if table[base] == 0.usize() or table[base + 1.usize()] == 0.usize()
            handle: i64& = table[base].cast[i64&]
            mode: u8& = table[base + 1.usize()].cast[u8&]
            return handle[0] if mode[0] != 0.u8() else 0

# Build the task-key and pixel-pointer routing lists from active modes.
def sdl_collect_routing(rows: usize&?, keys: mutable i64&?, pointers: mutable i64&?):
    can Abort.Panic, Unsafe.PointerCast:
        return if rows == null or keys == null or pointers == null
        key_handles: mutable i64& = keys
        pointer_handles: mutable i64& = pointers
        key_handles[0] <- sdl_active_handle(rows, 6.usize())
        key_handles[1] <- sdl_active_handle(rows, 7.usize())
        key_handles[2] <- sdl_active_handle(rows, 8.usize())
        key_handles[3] <- sdl_active_handle(rows, 9.usize())
        key_handles[4] <- sdl_active_handle(rows, 10.usize())
        key_handles[5] <- sdl_active_handle(rows, 12.usize())
        key_handles[6] <- sdl_active_handle(rows, 13.usize())
        key_handles[7] <- sdl_active_handle(rows, 14.usize())
        key_handles[8] <- sdl_active_handle(rows, 15.usize())
        key_handles[9] <- sdl_active_handle(rows, 16.usize())
        key_handles[10] <- sdl_active_handle(rows, 17.usize())
        key_handles[11] <- sdl_active_handle(rows, 3.usize())
        key_handles[12] <- sdl_active_handle(rows, 11.usize())
        key_handles[13] <- sdl_active_handle(rows, 5.usize())
        key_handles[14] <- sdl_active_handle(rows, 0.usize())
        key_handles[15] <- sdl_active_handle(rows, 1.usize())
        key_handles[16] <- sdl_active_handle(rows, 2.usize())
        key_handles[17] <- sdl_active_handle(rows, 21.usize())
        key_handles[18] <- sdl_active_handle(rows, 22.usize())
        key_handles[19] <- 0
        key_handles[20] <- sdl_active_handle(rows, 28.usize())
        key_handles[21] <- sdl_active_handle(rows, 29.usize())
        key_handles[22] <- sdl_active_handle(rows, 30.usize())
        key_handles[23] <- sdl_active_handle(rows, 31.usize())
        key_handles[24] <- sdl_active_handle(rows, 32.usize())
        key_handles[25] <- sdl_active_handle(rows, 33.usize())
        key_handles[26] <- sdl_active_handle(rows, 34.usize())
        key_handles[27] <- sdl_active_handle(rows, 35.usize())
        key_handles[28] <- sdl_active_handle(rows, 36.usize())
        key_handles[29] <- sdl_active_handle(rows, 24.usize())
        pointer_handles[0] <- sdl_active_handle(rows, 17.usize())
        pointer_handles[1] <- sdl_active_handle(rows, 31.usize())
        pointer_handles[2] <- sdl_active_handle(rows, 21.usize())
        pointer_handles[3] <- sdl_active_handle(rows, 23.usize())
        pointer_handles[4] <- sdl_active_handle(rows, 28.usize())
        pointer_handles[5] <- sdl_active_handle(rows, 29.usize())
        pointer_handles[6] <- sdl_active_handle(rows, 35.usize())

export fn nw_sdl_collect_routing(rows: usize&?, keys: mutable i64&?, pointers: mutable i64&?) = sdl_collect_routing

# Snapshot each options overlay as seven i64 fields for the frame writer.
# Each input row contains pointers to its open flag, selection, and draft.
def sdl_collect_frame_options(rows: usize&?, output: mutable i64&?):
    can Abort.Panic, Unsafe.PointerCast:
        return if rows == null or output == null
        trusted Unsafe.PointerCast:
            table: usize& = rows
            values: mutable i64& = output
            row: mutable usize = 0.usize()
            while row < 6.usize() |row, table, values|:
                base: usize = row * 3.usize()
                dest: usize = row * 7.usize()
                at: mutable usize = 0.usize()
                while at < 7.usize() |at, dest, values|:
                    values[dest + at] <- 0
                    at <- at + 1.usize()
                if table[base] != 0.usize() and table[base + 1.usize()] != 0.usize() and table[base + 2.usize()] != 0.usize():
                    opened: u8& = table[base].cast[u8&]
                    draft: i64& = table[base + 2.usize()].cast[i64&]
                    values[dest] <- opened[0].i64()
                    if row == 0.usize():
                        selected64: i64& = table[base + 1.usize()].cast[i64&]
                        values[dest + 1.usize()] <- selected64[0]
                        at <- 0.usize()
                        while at < 5.usize() |at, dest, values, draft|:
                            values[dest + 2.usize() + at] <- draft[at]
                            at <- at + 1.usize()
                    else:
                        selected32: i32& = table[base + 1.usize()].cast[i32&]
                        values[dest + 1.usize()] <- selected32[0].i64()
                        values[dest + 2.usize()] <- draft[0]
                        values[dest + 3.usize()] <- draft[1]
                        if row == 1.usize():
                            values[dest + 4.usize()] <- draft[3]
                        else:
                            values[dest + 4.usize()] <- draft[2]
                            values[dest + 5.usize()] <- draft[3]
                row <- row + 1.usize()

export fn nw_sdl_collect_frame_options(rows: usize&?, output: mutable i64&?) = sdl_collect_frame_options

# Bind contiguous controller state to the row-based FFI used by the host.
def sdl_bind_rows(handles: mutable i64&?, modes: mutable u8&?, rows: mutable usize&?):
    can Abort.Panic, Unsafe.PointerCast:
        return if handles == null or modes == null or rows == null
        trusted Unsafe.PointerCast:
            h: mutable i64& = handles
            m: mutable u8& = modes
            table: mutable usize& = rows
            at: mutable usize = 0.usize()
            while at < 142.usize() |at, h, m, table|:
                table[at * 2.usize()] <- (&h[at]).uintptr()
                table[at * 2.usize() + 1.usize()] <- (&m[at]).uintptr()
                at <- at + 1.usize()

export fn nw_sdl_bind_rows(handles: mutable i64&?, modes: mutable u8&?, rows: mutable usize&?) = sdl_bind_rows

# Initialize and bind six task overlays to their shared controller state.
# Each overlay has five draft values and three byte flags (open, hub, edit).
def sdl_bind_special_rows(handles: mutable i64&?, modes: mutable u8&?, configs: usize&?, drafts: mutable i64&?, flags: mutable u8&?, selections: mutable i32&?, syllogism_selection: mutable i64&?, edit_value: mutable i64&?, syllogism_results: mutable usize&?, numberology_results: mutable usize&?, rows: mutable usize&?):
    can Abort.Panic, Unsafe.PointerCast:
        return if handles == null or modes == null or configs == null or drafts == null or flags == null or selections == null or syllogism_selection == null or edit_value == null or syllogism_results == null or numberology_results == null or rows == null
        trusted Unsafe.PointerCast:
            h: mutable i64& = handles
            m: mutable u8& = modes
            config: usize& = configs
            draft: mutable i64& = drafts
            flag: mutable u8& = flags
            selection: mutable i32& = selections
            output: mutable usize& = rows
            at: mutable usize = 0.usize()
            while at < 6.usize() |at, h, m, config, draft, flag, selection, output, syllogism_selection, edit_value, syllogism_results, numberology_results|:
                task: usize = (18 if at == 0.usize() else (19 if at == 1.usize() else (20 if at == 2.usize() else (25 if at == 3.usize() else (26 if at == 4.usize() else 27))))).usize()
                config_index: usize = (4 if at == 0.usize() else (2 if at == 1.usize() else (3 if at == 2.usize() else (5 if at == 3.usize() else (1 if at == 4.usize() else 0))))).usize()
                source: i64& = config[config_index * 2.usize()].cast[i64&]
                base: usize = at * 10.usize()
                draft_base: usize = at * 5.usize()
                flag_base: usize = at * 3.usize()
                count: usize = 5.usize() if at == 1.usize() else 4.usize()
                field: mutable usize = 0.usize()
                while field < count |field, count, source, draft, draft_base|:
                    draft[draft_base + field] <- source[field]
                    field <- field + 1.usize()
                output[base] <- (&h[task]).uintptr()
                output[base + 1.usize()] <- (&m[task]).uintptr()
                output[base + 2.usize()] <- (&flag[flag_base]).uintptr()
                output[base + 3.usize()] <- (&flag[flag_base + 1.usize()]).uintptr() if at != 5.usize() else 0.usize()
                output[base + 4.usize()] <- syllogism_selection.uintptr() if at == 1.usize() else (&selection[at]).uintptr()
                output[base + 5.usize()] <- config[config_index * 2.usize()]
                output[base + 6.usize()] <- (&draft[draft_base]).uintptr()
                output[base + 7.usize()] <- syllogism_results.uintptr() if at == 1.usize() else ((&flag[flag_base + 2.usize()]).uintptr() if at == 2.usize() or at == 3.usize() else 0.usize())
                output[base + 8.usize()] <- edit_value.uintptr() if at == 2.usize() else 0.usize()
                output[base + 9.usize()] <- numberology_results.uintptr() if at == 2.usize() else 0.usize()
                at <- at + 1.usize()

export fn nw_sdl_bind_special_rows(handles: mutable i64&?, modes: mutable u8&?, configs: usize&?, drafts: mutable i64&?, flags: mutable u8&?, selections: mutable i32&?, syllogism_selection: mutable i64&?, edit_value: mutable i64&?, syllogism_results: mutable usize&?, numberology_results: mutable usize&?, rows: mutable usize&?) = sdl_bind_special_rows

# Derive text and frame views from the shared six-row overlay state.
def sdl_special_text_event(rows: usize&?, text: u8&?):
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return if rows == null or text == null
        trusted Unsafe.PointerCast:
            table: usize& = rows
            pointers: mutable usize[14] = zeroed
            pointers[0] <- table[30]
            pointers[1] <- table[31]
            pointers[2] <- table[32]
            pointers[3] <- table[37]
            pointers[4] <- table[20]
            pointers[5] <- table[21]
            pointers[6] <- table[22]
            pointers[7] <- table[24]
            pointers[8] <- table[26]
            pointers[9] <- table[27]
            pointers[10] <- table[28]
            pointers[11] <- table[0]
            pointers[12] <- table[1]
            pointers[13] <- table[2]
            sdl_text_event((&pointers[0]).uintptr().cast[usize&], text)

export fn nw_sdl_special_text_event(rows: usize&?, text: u8&?) = sdl_special_text_event

def sdl_special_frame_options(rows: usize&?, output: mutable i64&?):
    can Abort.Panic, Unsafe.PointerCast:
        return if rows == null or output == null
        trusted Unsafe.PointerCast:
            table: usize& = rows
            pointers: mutable usize[18] = zeroed
            at: mutable usize = 0.usize()
            while at < 6.usize() |at, table, pointers|:
                source: usize = (1 if at == 0.usize() else (2 if at == 1.usize() else (0 if at == 2.usize() else at.i64()))).usize() * 10.usize()
                pointers[at * 3.usize()] <- table[source + 2.usize()]
                pointers[at * 3.usize() + 1.usize()] <- table[source + 4.usize()]
                pointers[at * 3.usize() + 2.usize()] <- table[source + 6.usize()]
                at <- at + 1.usize()
            sdl_collect_frame_options((&pointers[0]).uintptr().cast[usize&], output)

export fn nw_sdl_special_frame_options(rows: usize&?, output: mutable i64&?) = sdl_special_frame_options

