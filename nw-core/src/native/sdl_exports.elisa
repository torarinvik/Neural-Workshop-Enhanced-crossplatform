# Compare complete source-derived Algebra feedback, including large CRT text.
def sdl_algebra_feedback_selftest(buffer: i64, level: i64, expected: cstr) -> bool:
    can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read:
        handle: i64 = algebra_create(level, 1, 19)
        return false if handle == 0
        good: mutable bool = true
        good <- false if algebra_action(handle, 0, 0, 0) != 1 or algebra_info(handle, 11) != 0 or algebra_value(handle, 3, 0) != -1 or algebra_action(handle, 1, 120, 0) != 1 or algebra_action(handle, 3, 0, 0) != 1
        count: i64 = algebra_info(handle, 11)
        if count != SDL_strlen(expected).i64():
            good <- false
        else:
            trusted Unsafe.PointerCast:
                bytes: heap u8& = expected.cast[heap u8&]
                at: mutable i64 = 0
                while at < count |at, count, bytes, handle, good|:
                    good <- false if algebra_value(handle, 3, at) != bytes[at.usize()].i64()
                    at <- at + 1
        good <- false if not sdl_selftest_frame_valid(buffer, algebra_frame_write(buffer, 65536, handle, 0, 912, 684))
        good <- false if algebra_destroy(handle) != 0
        return good

