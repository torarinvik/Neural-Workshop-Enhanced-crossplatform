extern malloc(size: usize) -> mutable heap void&? can[Memory.Allocate]

def frame_alloc(size: i64) -> i64:
    can Memory.Allocate, Abort.Panic:
        trusted Unsafe.PointerCast:
            block: mutable heap void&? = malloc(size.usize())
            0 return if block == null
            slot: mutable heap void& = block
            return slot.cast[u8&].uintptr().i64()

def title_write(dest: i64, capacity: i64, banner_code: i64,
                black_background: i64, jaeggi_mode: i64,
                clinical_mode: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        list: mutable Display::DisplayList = Display::DisplayList()
        render_title_frame_coded(&list, banner_code,
                                 black_background != 0,
                                 jaeggi_mode != 0,
                                 clinical_mode != 0)
        encoded: darray[u8] = Display::encode_binary(&list)
        length: i64 = encoded.count.i64()
        if length <= capacity and length > 0:
            trusted Unsafe.PointerCast:
                target: mutable u8& = dest.uintptr().cast[mutable u8&]
                memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&],
                       length.usize())
            return length
        return 0

def taskhub_write(dest: i64, capacity: i64, category: i64, selected: i64,
                  black_background: i64, width: i64, height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        list: mutable Display::DisplayList = Display::DisplayList()
        paint: SceneTaskHub::HubPaint = SceneTaskHub::paint_of(
            black_background != 0, width.f64(), height.f64(),
            width.f64() / Display::REFERENCE_WIDTH,
            height.f64() / Display::REFERENCE_HEIGHT)
        SceneTaskHub::render(&list, &paint, category, selected)
        encoded: darray[u8] = Display::encode_binary(&list)
        length: i64 = encoded.count.i64()
        if length <= capacity and length > 0:
            target: mutable u8& = dest.uintptr().cast[mutable u8&]
            memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            return length
        return 0

export fn nw_frame_alloc(size: i64) -> i64 = frame_alloc
export fn nw_title_write(dest: i64, capacity: i64, banner_code: i64,
                         black_background: i64, jaeggi_mode: i64,
                         clinical_mode: i64) -> i64 = title_write
export fn nw_taskhub_write(dest: i64, capacity: i64, category: i64,
                            selected: i64, black_background: i64,
                            width: i64, height: i64) -> i64 = taskhub_write

def you_are_here_create(rung: i64, trials: i64, adaptive: i64,
                        show_marks: i64, seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if rung < 1 or rung > Maze::GRADE_COUNT
        return 0 if trials != 1 and trials != 2 and trials != 3 and trials != 5 and trials != 8 and trials != 10 and trials != 15 and trials != 20
        raw: mutable heap void&? = malloc(size_of(YouAreHereGame::Run).usize())
        return 0 if raw == null
        trusted Unsafe.PointerCast:
            pointer: mutable heap void& = raw
            run: mutable heap YouAreHereGame::Run& = pointer.cast[mutable heap YouAreHereGame::Run&]
            YouAreHereGame::initialize(run, rung, trials, adaptive != 0, show_marks != 0, seed)
            return pointer.cast[u8&].uintptr().i64()

def you_are_here_action(handle: i64, action: i64, now_ms: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap YouAreHereGame::Run& = handle.uintptr().cast[mutable heap YouAreHereGame::Run&]
            return YouAreHereGame::apply(run, action, now_ms)

def you_are_here_info(handle: i64, field: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: heap YouAreHereGame::Run& = handle.uintptr().cast[heap YouAreHereGame::Run&]
            return YouAreHereGame::info(run, field)

def you_are_here_frame_write(dest: i64, capacity: i64, handle: i64,
                             black_background: i64, width: i64, height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if dest <= 0 or capacity <= 0 or handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap YouAreHereGame::Run& = handle.uintptr().cast[mutable heap YouAreHereGame::Run&]
            list: mutable Display::DisplayList = Display::DisplayList()
            YouAreHereGame::render(run, black_background != 0, width.f64(), height.f64(), &list)
            encoded: darray[u8] = Display::encode_binary(&list)
            length: i64 = encoded.count.i64()
            return 0 if length <= 0 or length > capacity
            target: mutable u8& = dest.uintptr().cast[mutable u8&]
            memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            return length

def you_are_here_destroy(handle: i64) -> i64:
    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap YouAreHereGame::Run& = handle.uintptr().cast[mutable heap YouAreHereGame::Run&]
            YouAreHereGame::dispose(run)
            heap_pointer: heap void& = handle.uintptr().cast[heap void&]
            free(heap_pointer)
            return 0

