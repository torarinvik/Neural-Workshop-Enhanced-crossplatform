extern malloc(size: usize) -> mutable heap void&? can[Memory.Allocate]

def frame_alloc(size: i64) -> i64:
    can Memory.Allocate, Abort.Panic:
        return 0 if size <= 0
        trusted Unsafe.PointerCast:
            block: mutable heap void&? = malloc(size.usize())
            0 return if block == null
            slot: mutable heap void& = block
            return slot.cast[u8&].uintptr().i64()

def frame_free(address: i64):
    can Memory.Release, Unsafe.PointerCast:
        return if address == 0
        trusted Unsafe.PointerCast:
            free(address.uintptr().cast[heap void&])

extern SDL_Init(flags: u32) -> bool
extern SDL_Quit()
extern SDL_StartTextInput(window: mutable void&) -> bool
extern SDL_StopTextInput(window: mutable void&) -> bool

def sdl_apply_text_input(window: mutable void&?, request: i32):
    can Console.Write:
        return if window == null
        target: mutable void& = window
        if request == 1.i32():
            if not SDL_StartTextInput(target):
                SDL_Log("Could not start text input: %s", SDL_GetError())
        elif request == 2.i32():
            if not SDL_StopTextInput(target):
                SDL_Log("Could not stop text input: %s", SDL_GetError())

export fn nw_sdl_apply_text_input(window: mutable void&?, request: i32) = sdl_apply_text_input

extern SDL_CreateWindow(title: cstr, width: i32, height: i32, flags: u64) -> mutable void&?
extern SDL_DestroyWindow(window: mutable void&)
extern SDL_SetWindowMinimumSize(window: mutable void&, width: i32, height: i32) -> bool
extern SDL_CreateRenderer(window: mutable void&, name: u8&?) -> mutable void&?
extern SDL_SetRenderDrawBlendMode(renderer: mutable void&, mode: u32) -> bool
extern SDL_GetHint(name: cstr) -> u8&?
extern SDL_SetHint(name: cstr, value: cstr) -> bool
extern SDL_ResetHint(name: cstr) -> bool

def sdl_default_headless_driver() -> bool:
    can Abort.Panic:
        if SDL_GetHint("SDL_VIDEO_DRIVER") is current:
            return false if current != 0.u8()
        if SDL_getenv("SDL_VIDEODRIVER") is legacy:
            return false if legacy != 0.u8()
        return SDL_SetHint("SDL_VIDEO_DRIVER", "dummy,offscreen")

# State slots hold the window, renderer and frame buffer. A failed open
# releases everything it acquired, and close is safe to call again.
def sdl_window_open_mode(state: mutable usize&?, width: i32, height: i32, capacity: i64, headless: bool) -> i64:
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 0 if state == null
        slots: mutable usize& = state
        slots[0] <- 0.usize()
        slots[1] <- 0.usize()
        slots[2] <- 0.usize()
        driver_hint: bool = headless and sdl_default_headless_driver()
        initialized: bool = SDL_Init(32.u32())
        if driver_hint:
            _ = SDL_ResetHint("SDL_VIDEO_DRIVER")
        if not initialized:
            SDL_Log("SDL_Init failed: %s", SDL_GetError())
            return 0
        # SDL_WINDOW_RESIZABLE | SDL_WINDOW_HIGH_PIXEL_DENSITY.
        window: mutable void&? = SDL_CreateWindow("Neural Workshop", width, height, 8232.u64() if headless else 8224.u64())
        if window == null:
            SDL_Log("CreateWindow: %s", SDL_GetError())
            SDL_Quit()
            return 0
        target: mutable void& = window
        renderer: mutable void&? = SDL_CreateRenderer(target, null)
        if renderer == null:
            SDL_Log("CreateRenderer: %s", SDL_GetError())
            SDL_DestroyWindow(target)
            SDL_Quit()
            return 0
        canvas: mutable void& = renderer
        if not SDL_SetRenderDrawBlendMode(canvas, 1.u32()):
            SDL_Log("Could not configure window renderer blending: %s", SDL_GetError())
            SDL_DestroyRenderer(canvas)
            SDL_DestroyWindow(target)
            SDL_Quit()
            return 0
        buffer: i64 = frame_alloc(capacity)
        if buffer == 0:
            SDL_Log("nw_frame_alloc failed")
            SDL_DestroyRenderer(canvas)
            SDL_DestroyWindow(target)
            SDL_Quit()
            return 0
        slots[0] <- target.uintptr()
        slots[1] <- canvas.uintptr()
        slots[2] <- buffer.usize()
        return 1

def sdl_window_close(state: mutable usize&?):
    can Memory.Release, Unsafe.PointerCast:
        return if state == null
        slots: mutable usize& = state
        trusted Unsafe.PointerCast:
            frame_free(slots[2].i64())
            slots[2] <- 0.usize()
            if slots[1] != 0.usize(): SDL_DestroyRenderer(slots[1].cast[mutable void&])
            slots[1] <- 0.usize()
            if slots[0] != 0.usize(): SDL_DestroyWindow(slots[0].cast[mutable void&])
            slots[0] <- 0.usize()

def sdl_window_open(state: mutable usize&?, width: i32, height: i32, capacity: i64) -> i64:
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return sdl_window_open_mode(state, width, height, capacity, false)

export fn nw_sdl_window_open(state: mutable usize&?, width: i32, height: i32, capacity: i64) -> i64 = sdl_window_open
export fn nw_sdl_window_close(state: mutable usize&?) = sdl_window_close

def sdl_screenshot_open(state: mutable usize&?, width: i32, height: i32, capacity: i64, format: u32) -> usize:
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 0.usize() if state == null
        slots: mutable usize& = state
        slots[0] <- 0.usize()
        slots[1] <- 0.usize()
        slots[2] <- 0.usize()
        surface: mutable void&? = SDL_CreateSurface(width, height, format)
        if surface == null:
            SDL_Log("Could not allocate screenshot surface: %s", SDL_GetError())
            return 0.usize()
        target: mutable void& = surface
        renderer: mutable void&? = SDL_CreateSoftwareRenderer(target)
        if renderer == null:
            SDL_Log("Could not allocate screenshot renderer: %s", SDL_GetError())
            SDL_DestroySurface(target)
            return 0.usize()
        canvas: mutable void& = renderer
        slots[1] <- canvas.uintptr()
        if not SDL_SetRenderDrawBlendMode(canvas, 1.u32()):
            SDL_Log("Could not configure screenshot renderer blending: %s", SDL_GetError())
            sdl_screenshot_close(state, target.uintptr())
            return 0.usize()
        buffer: i64 = frame_alloc(capacity)
        if buffer == 0:
            SDL_Log("Could not allocate screenshot frame buffer")
            sdl_screenshot_close(state, target.uintptr())
            return 0.usize()
        slots[2] <- buffer.usize()
        return target.uintptr()

def sdl_screenshot_close(state: mutable usize&?, surface: usize):
    can Memory.Release, Unsafe.PointerCast:
        sdl_window_close(state)
        trusted Unsafe.PointerCast:
            if surface != 0.usize():
                SDL_DestroySurface(surface.cast[mutable void&])

export fn nw_sdl_screenshot_open(state: mutable usize&?, width: i32, height: i32, capacity: i64, format: u32) -> usize = sdl_screenshot_open
export fn nw_sdl_screenshot_close(state: mutable usize&?, surface: usize) = sdl_screenshot_close

# Choose the window or offscreen surface before acquiring any SDL resources.
def sdl_open_output(state: mutable usize&, width: i32, height: i32, capacity: i64,
                    screenshot: usize, writer: usize, format: u32, surface: mutable usize&) -> i32:
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        surface[0] <- 0.usize()
        if screenshot == 0.usize():
            return sdl_window_open(state, width, height, capacity).i32()
        if writer == 0.usize():
            SDL_Log("PNG screenshots require SDL 3.4 or newer")
            return 0.i32()
        surface[0] <- sdl_screenshot_open(state, width, height, capacity, format)
        return 1.i32() if surface[0] != 0.usize() else 0.i32()

export fn nw_sdl_open_output(state: mutable usize&, width: i32, height: i32, capacity: i64, screenshot: usize, writer: usize, format: u32, surface: mutable usize&) -> i32 = sdl_open_output

# SDL_SavePNG is available only when the host was built with SDL 3.4+.
def sdl_screenshot_save(decoded: i32, surface: usize, path: cstr, writer: usize) -> i32:
    can Blocking.IO, Console.Write, Unsafe.PointerCast:
        if decoded == 0.i32() or surface == 0.usize():
            SDL_Log("Could not render screenshot frame")
            return 1.i32()
        if writer == 0.usize():
            SDL_Log("PNG screenshots require SDL 3.4 or newer")
            return 1.i32()
        trusted Unsafe.PointerCast:
            save: fn(usize, usize) -> bool = writer.cast[fn(usize, usize) -> bool]
            if not save(surface, path.uintptr()):
                SDL_Log("Could not save screenshot: %s", SDL_GetError())
                return 1.i32()
        _ = printf("wrote %s\n", path)
        return 0.i32()

export fn nw_sdl_screenshot_save(decoded: i32, surface: usize, path: cstr, writer: usize) -> i32 = sdl_screenshot_save

# Return -1 after presenting an interactive frame, or the process status
# when presentation fails or a single screenshot completes.
def sdl_finish_frame(renderer: mutable void&?, data: u8&?, length: i64, width: i32, height: i32, trial: i64, black: i64, surface: usize, screenshot: usize, writer: usize) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        decoded: mutable i32 = 0.i32()
        trusted Unsafe.PointerCast:
            publish: fn(mutable void&) -> void can[Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast] = sdl_publish_rendered_frame
            decoded <- sdl_present_frame_theme(renderer, data, length, width, height, trial, black, publish.cast[uintptr])
        trusted Unsafe.PointerCast:
            return sdl_screenshot_save(decoded, surface, screenshot.cast[cstr], writer) if screenshot != 0.usize()
        return 1.i32() if decoded == 0.i32() else -1.i32()

export fn nw_sdl_finish_frame(renderer: mutable void&?, data: u8&?, length: i64, width: i32, height: i32, trial: i64, black: i64, surface: usize, screenshot: usize, writer: usize) -> i32 = sdl_finish_frame

def sdl_finish_desktop_frame(renderer: mutable void&, data: u8&?, length: i64, width: i32, height: i32, trial: i64, black: i64, surface: usize, screenshot: usize, writer: usize, marble_finish: usize, marble_state: usize, physics: usize) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        if marble_finish != 0.usize():
            trusted Unsafe.PointerCast:
                finish: fn(usize, usize, usize, usize, usize, i64, i32, i32, i64, i64) -> i32 = marble_finish.cast[fn(usize, usize, usize, usize, usize, i64, i32, i32, i64, i64) -> i32]
                result: i32 = finish(marble_state, renderer.uintptr(), physics, screenshot, data.uintptr(), length, width, height, trial, black)
                return 1.i32() if result < 0.i32()
                return -1.i32() if result > 0.i32()
        return sdl_finish_frame(renderer, data, length, width, height, trial, black, surface, screenshot, writer)

export fn nw_sdl_finish_desktop_frame(renderer: mutable void&, data: u8&?, length: i64, width: i32, height: i32, trial: i64, black: i64, surface: usize, screenshot: usize, writer: usize, marble_finish: usize, marble_state: usize, physics: usize) -> i32 = sdl_finish_desktop_frame

extern SDL_GetBasePath() -> u8&? can[Blocking.IO]
extern SDL_SetPointerProperty(properties: u32, name: cstr, value: mutable void&) -> bool

def sdl_load_title_sprites(renderer: mutable void&, png_loader: usize):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return if png_loader == 0.usize()
        base: u8&? = SDL_GetBasePath()
        return if base == null
        trusted Unsafe.PointerCast:
            prefix: u8& = base
            load_png: fn(cstr) -> mutable void&? = png_loader.cast[fn(cstr) -> mutable void&?]
            properties: u32 = SDL_GetRendererProperties(renderer)
            _ = SDL_SetNumberProperty(properties, "nw.png.loader", png_loader.i64())
            for logo in 0..<2 |logo, renderer, prefix, load_png, properties|:
                file: cstr = "logo.png" if logo == 0 else "logo-dark.png"
                key: cstr = "nw.sprite.1" if logo == 0 else "nw.sprite.2"
                path: mutable u8[4096] = zeroed
                for root in 0..<2 |root, path, prefix, file, renderer, load_png, properties, key|:
                    directory: cstr = "res/Logo" if root == 0 else "../res/Logo"
                    length: i32 = SDL_snprintf(&path[0], 4096.usize(), "%s%s/%s", prefix.cast[cstr], directory, file)
                    if length > 0.i32() and length < 4096.i32():
                        image: mutable void&? = load_png((&path[0]).uintptr().cast[cstr])
                        if image != null:
                            surface: mutable void& = image
                            texture: mutable void&? = SDL_CreateTextureFromSurface(renderer, surface)
                            SDL_DestroySurface(surface)
                            if texture != null:
                                sprite: mutable void& = texture
                                if not SDL_SetPointerProperty(properties, key, sprite):
                                    SDL_DestroyTexture(sprite)
                            break

export fn nw_sdl_load_title_sprites(renderer: mutable void&, png_loader: usize) = sdl_load_title_sprites

def sdl_select_font(renderer: mutable void&, adapter: usize):
    can Blocking.IO, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return if adapter == 0.usize()
        trusted Unsafe.PointerCast:
            attach: fn(mutable void&, usize, usize) -> i32 = adapter.cast[fn(mutable void&, usize, usize) -> i32]
            platform: i64 = SDL_GetPlatform().uintptr().i64()
            override: u8&? = SDL_getenv("NW_SDL_FONT")
            primary: mutable cstr = "/usr/share/fonts/truetype/msttcorefonts/Courier_New.ttf"
            fallback: mutable cstr = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
            second: mutable cstr? = "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"
            third: mutable cstr? = "/usr/share/fonts/dejavu-sans-mono-fonts/DejaVuSansMono.ttf"
            windows_primary: mutable u8[4096] = zeroed
            windows_fallback: mutable u8[4096] = zeroed
            if syllogism_argument_is(platform, "Windows"):
                root: u8&? = SDL_getenv("SYSTEMROOT")
                return if root == null
                prefix: u8& = root
                size: i32 = SDL_snprintf(&windows_primary[0], 4096.usize(), "%s/Fonts/cour.ttf", prefix.cast[cstr])
                symbols: i32 = SDL_snprintf(&windows_fallback[0], 4096.usize(), "%s/Fonts/seguisym.ttf", prefix.cast[cstr])
                return if size <= 0.i32() or size >= 4096.i32() or symbols <= 0.i32() or symbols >= 4096.i32()
                primary <- (&windows_primary[0]).uintptr().cast[cstr]
                fallback <- (&windows_fallback[0]).uintptr().cast[cstr]
                second <- null
                third <- null
            elif syllogism_argument_is(platform, "macOS"):
                primary <- "/System/Library/Fonts/Supplemental/Courier New.ttf"
                fallback <- "/System/Library/Fonts/Apple Symbols.ttf"
                second <- "/System/Library/Fonts/Menlo.ttc"
                third <- null
            elif SDL_GetPathInfo(fallback, null) == false:
                fallback <- "/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf"
            if override != null:
                path: u8& = override
                return if path[0] == 0.u8()
                if attach(renderer, path.uintptr(), fallback.uintptr()) == 0.i32():
                    SDL_Log("Could not open desktop font: %s", SDL_GetError())
                return
            return if attach(renderer, primary.uintptr(), fallback.uintptr()) != 0.i32()
            if second is candidate:
                return if attach(renderer, candidate.uintptr(), fallback.uintptr()) != 0.i32()
            if third is candidate:
                _ = attach(renderer, candidate.uintptr(), fallback.uintptr())

extern SDL_GetPathInfo(path: cstr, info: mutable void&?) -> bool can[Blocking.IO]
export fn nw_sdl_select_font(renderer: mutable void&, adapter: usize) = sdl_select_font

extern SDL_InitSubSystem(flags: u32) -> bool
extern SDL_QuitSubSystem(flags: u32)

# Measure the drawable without showing a window. Software-only captures use
# the requested dimensions when no video driver or drawable is available.
def sdl_screenshot_dimensions(dimensions: mutable i32&):
    can Abort.Panic, Unsafe.PointerCast:
        return if not SDL_InitSubSystem(32.u32()) # SDL_INIT_VIDEO
        # SDL_WINDOW_HIGH_PIXEL_DENSITY | SDL_WINDOW_HIDDEN
        probe: mutable void&? = SDL_CreateWindow("Neural Workshop", dimensions[0], dimensions[1], 8200.u64())
        if probe != null:
            window: mutable void& = probe
            width: mutable i32 = 0.i32()
            height: mutable i32 = 0.i32()
            trusted Unsafe.PointerCast:
                if SDL_GetWindowSizeInPixels(window, (&width).uintptr().cast[mutable i32&], (&height).uintptr().cast[mutable i32&]):
                    if width > 0.i32() and height > 0.i32():
                        dimensions[0] <- width
                        dimensions[1] <- height
            SDL_DestroyWindow(window)
        SDL_QuitSubSystem(32.u32())

extern SDL_SetFloatProperty(properties: u32, name: cstr, value: f32) -> bool
extern SDL_SetRenderVSync(renderer: mutable void&, interval: i32) -> bool

def sdl_open_desktop(state: mutable usize&, dimensions: mutable i32&, capacity: i64, screenshot: usize, writer: usize, format: u32, surface: mutable usize&, loader: usize, font: usize, fullscreen: i64, vsync: i64, headless: i64) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        logical_width: i32 = dimensions[0]
        if screenshot != 0.usize() and writer != 0.usize() and headless == 0:
            sdl_screenshot_dimensions(dimensions)
        opened: mutable i32 = 0.i32()
        if headless != 0 and screenshot == 0.usize():
            surface[0] <- 0.usize()
            opened <- sdl_window_open_mode(state, dimensions[0], dimensions[1], capacity, true).i32()
        else:
            opened <- sdl_open_output(state, dimensions[0], dimensions[1], capacity, screenshot, writer, format, surface)
        return opened if opened == 0.i32()
        trusted Unsafe.PointerCast:
            renderer: mutable void& = state[1].cast[mutable void&]
            if screenshot != 0.usize():
                density: f32 = dimensions[0].f32() / logical_width.f32()
                _ = SDL_SetFloatProperty(SDL_GetRendererProperties(renderer), "nw.capture.density", density)
            else:
                window: mutable void& = state[0].cast[mutable void&]
                sdl_set_profile_caption(window)
                _ = SDL_SetWindowMinimumSize(window, 640.i32(), 480.i32())
                sdl_set_fullscreen(window, true) if fullscreen != 0
                if vsync != 0:
                    _ = SDL_SetRenderVSync(renderer, 1.i32())
            sdl_load_title_sprites(renderer, loader)
            sdl_select_font(renderer, font)
        return opened

export fn nw_sdl_open_desktop(state: mutable usize&, dimensions: mutable i32&, capacity: i64, screenshot: usize, writer: usize, format: u32, surface: mutable usize&, loader: usize, font: usize, fullscreen: i64, vsync: i64, headless: i64) -> i32 = sdl_open_desktop

