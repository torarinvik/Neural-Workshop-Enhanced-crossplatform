        return -1 if raw == null
        trusted Unsafe.PointerCast:
            pointer: mutable heap void& = raw
            run: mutable heap TriviaGame::TriviaRun& = pointer.cast[mutable heap TriviaGame::TriviaRun&]
            TriviaGame::initialize(run, start_rung, total_trials,
                                   show_answer != 0, adaptive != 0, seed)
            return pointer.cast[u8&].uintptr().i64()

def sdl_trivia_create(trials: i64, adaptive: i64, seed: i64) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        handle: i64 = trivia_create(1, trials, 1, adaptive, seed)
        return handle if handle <= 0
        path: mutable u8[4096] = zeroed
        length: mutable i64 = 0
        trusted Unsafe.PointerCast:
            name: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
            if sdl_corpus_path(name, 4096.usize(), 2, 0) != 0.i32():
                if sdl_read_corpus(name, &length) is data:
                    if length > 33554432:
                        SDL_free(data)
                        return handle
                    run: mutable heap TriviaGame::TriviaRun& = handle.uintptr().cast[mutable heap TriviaGame::TriviaRun&]
                    run.index_address <- data.uintptr().usize()
                    run.index_size <- length
        return handle

def trivia_action(handle: i64, action: i64, value: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap TriviaGame::TriviaRun& = handle.uintptr().cast[mutable heap TriviaGame::TriviaRun&]
            return TriviaGame::apply(run, action, value)

def trivia_info(handle: i64, field: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: heap TriviaGame::TriviaRun& = handle.uintptr().cast[heap TriviaGame::TriviaRun&]
            return TriviaGame::info(run, field)

def trivia_value(handle: i64, field: i64, at: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: heap TriviaGame::TriviaRun& = handle.uintptr().cast[heap TriviaGame::TriviaRun&]
            return TriviaGame::value(run, field, at)

def trivia_frame_write(dest: i64, capacity: i64, handle: i64,
                       black_background: i64, width: i64,
                       height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if dest <= 0 or capacity <= 0 or handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap TriviaGame::TriviaRun& = handle.uintptr().cast[mutable heap TriviaGame::TriviaRun&]
            list: mutable Display::DisplayList = Display::DisplayList()
            TriviaGame::render(run, black_background != 0, width.f64(), height.f64(), &list)
            encoded: darray[u8] = Display::encode_binary(&list)
            length: i64 = encoded.count.i64()
            return 0 if length <= 0 or length > capacity
            target: mutable u8& = dest.uintptr().cast[mutable u8&]
            memcpy(target.cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            return length

def trivia_destroy(handle: i64) -> i64:
    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            heap_pointer: heap void& = handle.uintptr().cast[heap void&]
            run: heap TriviaGame::TriviaRun& = handle.uintptr().cast[heap TriviaGame::TriviaRun&]
            if run.index_address != 0.usize():
                SDL_free(run.index_address.uintptr().cast[heap void&])
            free(heap_pointer)
            return 0

def reflex_create(total_targets: i64, lifetime_ms: i64, spawn_gap_ms: i64,
                  max_active: i64, start_size: i64, adaptive: i64,
                  seed: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return -1 if not ReflexGame::allowed_targets(total_targets)
        return -1 if not ReflexGame::allowed_lifetime(lifetime_ms)
        return -1 if not ReflexGame::allowed_spawn_gap(spawn_gap_ms)
        return -1 if not ReflexGame::allowed_max_active(max_active)
        return -1 if not ReflexGame::allowed_size(start_size)
        return -1 if adaptive != 0 and adaptive != 1
        raw: mutable heap void&? = malloc(size_of(ReflexGame::ReflexRun).usize())
        return -1 if raw == null
        trusted Unsafe.PointerCast:
            pointer: mutable heap void& = raw
            run: mutable heap ReflexGame::ReflexRun& = pointer.cast[mutable heap ReflexGame::ReflexRun&]
            ReflexGame::initialize(run, total_targets, lifetime_ms, spawn_gap_ms,
                                   max_active, start_size, adaptive != 0, seed)
            return pointer.cast[u8&].uintptr().i64()

def reflex_action(handle: i64, action: i64, value: i64, now_ms: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap ReflexGame::ReflexRun& = handle.uintptr().cast[mutable heap ReflexGame::ReflexRun&]
            return ReflexGame::apply(run, action, value, now_ms)

def reflex_advance(handle: i64, now_ms: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
