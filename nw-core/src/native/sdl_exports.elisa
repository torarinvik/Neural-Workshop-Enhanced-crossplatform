def graph_mapping_action(handle: i64, action: i64, now_ms: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap GraphMappingGame::GraphMappingRun& = handle.uintptr().cast[mutable heap GraphMappingGame::GraphMappingRun&]
            if action == GraphMappingGame::ACTION_START:
