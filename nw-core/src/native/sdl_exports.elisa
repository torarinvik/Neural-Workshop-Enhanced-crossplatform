        SDLCatch::release(sdl_active_handle(rows, 64.usize()), key, focus_lost != 0, SDL_GetTicks().i64())
        SDLEchoCave::release(sdl_active_handle(rows, 65.usize()), key, focus_lost != 0, SDL_GetTicks().i64())
        SDLDroneHoops::release(sdl_active_handle(rows, 66.usize()), key, focus_lost != 0, SDL_GetTicks().i64())
        SDLFieldManual::release(sdl_active_handle(rows, 67.usize()), key, focus_lost != 0, SDL_GetTicks().i64()) can Global{Read,Write}
        SDLSafecracker::release(sdl_active_handle(rows, 68.usize()), focus_lost != 0, SDL_GetTicks().i64()) can Global{Read,Write}
        SDLStagehand::release(sdl_active_handle(rows, 69.usize()), focus_lost != 0, SDL_GetTicks().i64()) can Global{Read,Write}
        SDLLoadingDock::release(sdl_active_handle(rows, 70.usize()), key, focus_lost != 0)
        SDLGunslinger::release(sdl_active_handle(rows, 71.usize()), focus_lost != 0)
        if focus_lost != 0 or key == 32:
            SDLHoldIt::release(sdl_active_handle(rows, 49.usize()), SDL_GetTicks().i64())
        trusted Unsafe.PointerCast:
            table: usize& = rows
            marble_mode: u8& = table[9].cast[u8&]
            if marble_mode[0] != 0.u8():
                marble: i64& = table[8].cast[i64&]
                if focus_lost != 0:
                    if marble[0] != 0:
                        run: mutable heap MarbleMazeGame::MarbleRun& = marble[0].uintptr().cast[mutable heap MarbleMazeGame::MarbleRun&]
                        MarbleMazeGame::clear_input(run)
                else:
                    sdl_dispatch_key_release(33, marble[0], key)
            if focus_lost == 0:
                buzz_mode: u8& = table[67].cast[u8&]
                if buzz_mode[0] != 0.u8():
                    buzz: i64& = table[66].cast[i64&]
                    sdl_dispatch_key_release(25, buzz[0], key)

export fn nw_sdl_active_release(rows: usize&?, focus_lost: i64, key: i64) = sdl_active_release

extern SDL_GetWindowID(window: mutable void&) -> u32

# A process quit applies to every window; close and focus events target one.
def sdl_window_event(rows: usize&?, window: mutable void&?, event_window: u32, action: i64, running: mutable u8&):
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        if action == 2:
            running[0] <- 0.u8()
            return
        return if window == null
        target: mutable void& = window
        return if event_window != SDL_GetWindowID(target)
        if action == 1:
            running[0] <- 0.u8()
        else:
            sdl_active_release(rows, 1, 0) can Global{Read,Write}

export fn nw_sdl_window_event(rows: usize&?, window: mutable void&?, event_window: u32, action: i64, running: mutable u8&) = sdl_window_event

# Coordinate normalization and controller dispatch for SDL pointer events.
# Task 7 is a Scrabble click, task 8 a Scrabble motion, and task 9 Crossword.
def sdl_dispatch_pointer(task: i64, handle: i64, x: f32, y: f32, width: i32, height: i32, right: i64):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return if task == 3 and sdl_go_options_click(handle, x, y, width, height)
        if task == 2:
            sdl_jigsaw_pixel_pointer(handle, false, x, y, width, height)
            return
        if task == 10 or task == 11:
            return if width <= 0.i32() or height <= 0.i32()
            view: mutable f32[4] = zeroed
            SDLGeometry::setup(&view[0], width, height)
            rx: f32 = (x - view[1]) / view[0]
            ry: f32 = (view[3] - view[2] - y) / view[0]
            return if rx < 0.0.f32() or rx > 912.0.f32() or ry < 0.0.f32() or ry > 684.0.f32()
            nx: i64 = (rx * 1000000.0.f32() / 912.0.f32()).i64()
            ny: i64 = (ry * 1000000.0.f32() / 684.0.f32()).i64()
            now: i64 = SDL_GetTicks().i64()
            if task == 10:
                _ = concentration_pointer_at(handle, nx, ny, width.f64(), height.f64(), now)
                sdl_concentration_play(handle)
            else:
                _ = recognition_pointer_at(handle, nx, ny, width.f64(), height.f64(), now)
                sdl_recognition_play(handle)
            return
        nx: mutable i64 = 0
        ny: mutable i64 = 0
        trusted Unsafe.PointerCast:
            valid: i64 = normalize_pointer(x, y, width, height, (&nx).uintptr().cast[mutable i64&], (&ny).uintptr().cast[mutable i64&])
            return if valid == 0
            if task == 0:
                _ = reflex_pointer(handle, nx, ny, SDL_GetTicks().i64())
            elif task == 1:
                _ = pursuit_pointer(handle, nx, ny)
            elif task == 3:
                _ = go_pointer(handle, nx, ny, width.i64(), height.i64(), SDL_GetTicks().i64())
            elif task == 4:
                _ = ncup_monte_pointer(handle, nx, ny, SDL_GetTicks().i64())
            elif task == 5:
                _ = tracking_pointer(handle, nx, ny, SDL_GetTicks().i64())
            elif task == 6:
                _ = two_hands_pointer(handle, nx, ny, 0, SDL_GetTicks().i64())
            elif task == 7:
                phase: i64 = scrabble_info(handle, 0)
                _ = scrabble_pointer(handle, nx, ny, width.i64(), height.i64(), (2 if right != 0 else 0), 0, SDL_GetTicks().i64())
                if phase != 1 and scrabble_info(handle, 0) == 1:
                    _ = scrabble_action(handle, 10, 0, SDL_GetTicks().i64())
            elif task == 8:
                _ = scrabble_pointer(handle, nx, ny, width.i64(), height.i64(), 0, 1, SDL_GetTicks().i64())
            elif task == 9:
                _ = crossword_pointer(handle, nx, ny, width.i64(), height.i64(), (2 if right != 0 else 0), SDL_GetTicks().i64())

export fn nw_sdl_dispatch_pointer(task: i64, handle: i64, x: f32, y: f32, width: i32, height: i32, right: i64) = sdl_dispatch_pointer

# The seven pixel-coordinate routes listen for button presses.
# A zero handle represents an inactive controller.
def sdl_dispatch_pixel_pointers(handles: i64&?, motion: i64, x: f32, y: f32, width: i32, height: i32):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return if handles == null
        active: i64& = handles
        if motion != 0:
            sdl_jigsaw_pixel_pointer(active[2], true, x, y, width, height)
            return
        index: mutable i64 = 0
        while index < 7 |index, active, x, y, width, height|:
            if active[index.usize()] != 0:
                sdl_dispatch_pointer(index, active[index.usize()], x, y, width, height, 0)
            index <- index + 1

export fn nw_sdl_dispatch_pixel_pointers(handles: i64&?, motion: i64, x: f32, y: f32, width: i32, height: i32) = sdl_dispatch_pixel_pointers

# Scrabble and Crossword use logical window coordinates and share option
# clicks. Motion is meaningful only for Scrabble while its options are closed.
def sdl_word_pointer(task: i64, handle: i64, options_open: i64, motion: i64, button: i64, x: f32, y: f32, width: i32, height: i32, selected: mutable i32&?, draft: mutable i64&?):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return if task < 0 or task > 1 or width <= 0.i32() or height <= 0.i32()
        if motion != 0:
            if task == 0 and options_open == 0:
                sdl_dispatch_pointer(8, handle, x, y, width, height, 0)
        elif button > 0:
            if options_open != 0:
                if button != 3:
                    # Python word-game options use the full window height and ignore x.
                    reference_y: f32 = y * 684.0.f32() / height.f32()
                    _ = sdl_option_click(1 if task == 0 else 0, 456.0.f32(), reference_y,
                        912.i32(), 684.i32(), selected, draft)
            else:
                sdl_dispatch_pointer(7 if task == 0 else 9, handle, x, y, width, height, 1 if button == 3 else 0)

export fn nw_sdl_word_pointer(task: i64, handle: i64, options_open: i64, motion: i64, button: i64, x: f32, y: f32, width: i32, height: i32, selected: mutable i32&?, draft: mutable i64&?) = sdl_word_pointer



# Cancel the first active options overlay, preserving the shell's task order.
# Each row holds pointers to handle, mode, opened, and (except Crossword) hub.
# Return 2 if SDL text input should be stopped, 1 if consumed, 0 otherwise.
def sdl_cancel_options(rows: usize&?, key: i64) -> i32:
    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0.i32() if rows == null or key != 27
        trusted Unsafe.PointerCast:
            pointers: usize& = rows
            index: mutable usize = 0.usize()
            while index < 6.usize() |index, pointers|:
                base: usize = index * 4.usize()
                if pointers[base] != 0.usize() and pointers[base + 1.usize()] != 0.usize() and pointers[base + 2.usize()] != 0.usize():
                    handle: mutable i64& = pointers[base].cast[mutable i64&]
                    mode: mutable u8& = pointers[base + 1.usize()].cast[mutable u8&]
                    opened: mutable u8& = pointers[base + 2.usize()].cast[mutable u8&]
                    if mode[0] != 0.u8() and opened[0] != 0.u8():
                        opened[0] <- 0.u8()
                        if index < 5.usize() and pointers[base + 3.usize()] != 0.usize():
                            hub: mutable u8& = pointers[base + 3.usize()].cast[mutable u8&]
                            if hub[0] != 0.u8():
                                if index == 0.usize():
                                    _ = syllogism_destroy(handle[0])
                                elif index == 1.usize():
                                    _ = numberology_destroy(handle[0])
                                elif index == 2.usize():
                                    _ = algebra_destroy(handle[0])
                                elif index == 3.usize():
                                    _ = scramble_destroy(handle[0])
                                else:
                                    _ = scrabble_destroy(handle[0])
                                handle[0] <- 0
                                mode[0] <- 0.u8()
                                hub[0] <- 0.u8()
                                return 2.i32() if index == 1.usize() or index == 2.usize()
                        return 1.i32()
                index <- index + 1.usize()
            return 0.i32()

export fn nw_sdl_cancel_options(rows: usize&?, key: i64) -> i32 = sdl_cancel_options

# Assemble the screen constructor's options from the parsed task settings.
# Config rows use the same pointer table as sdl_parse_configs.
def sdl_collect_screen_options(tasks: i64&?, rows: usize&?, output: mutable i64&?):
    can Abort.Panic, Unsafe.PointerCast:
        return if tasks == null or rows == null or output == null
        trusted Unsafe.PointerCast:
            task: i64& = tasks
            table: usize& = rows
            values: mutable i64& = output
            at: mutable usize = 0.usize()
            while at < 5.usize() |at, task, values|:
                values[at] <- task[at + 4.usize()]
                at <- at + 1.usize()
            at <- 0.usize()
            while at < 4.usize() |at, task, values|:
                values[at + 5.usize()] <- task[at]
                at <- at + 1.usize()
            at <- 0.usize()
            while at < 6.usize() |at, task, values|:
                values[at + 9.usize()] <- task[at + 9.usize()]
                at <- at + 1.usize()
            # Crossword, Scrabble, Algebra, Numberology, Scramble, Syllogism.
            group: mutable usize = 0.usize()
            dest: mutable usize = 15.usize()
            while group < 6.usize() |group, dest, table, values|:
                row: usize = group if group < 2.usize() else (4.usize() if group == 2.usize() else (3.usize() if group == 3.usize() else (5.usize() if group == 4.usize() else 2.usize())))
                count: usize = 3.usize() if group == 3.usize() else (5.usize() if group == 5.usize() else 4.usize())
                return if table[row * 2.usize()] == 0.usize()
                config: i64& = table[row * 2.usize()].cast[i64&]
                at <- 0.usize()
                while at < count |at, count, group, dest, config, values|:
                    source: usize = 3.usize() if group == 3.usize() and at == 2.usize() else at
                    values[dest + at] <- config[source]
                    at <- at + 1.usize()
                dest <- dest + count
                group <- group + 1.usize()

export fn nw_sdl_collect_screen_options(tasks: i64&?, rows: usize&?, output: mutable i64&?) = sdl_collect_screen_options

def sdl_task_ini_group(data: heap u8&, size: i64, output: mutable i64&, task: i64,
                       level_key: cstr, trials_key: cstr, display_key: cstr, adaptive_key: cstr):
    can Abort.Panic, Unsafe.PointerCast:
        level: i64 = sdl_config_option(data, size, level_key, 0, -1)
        trials: i64 = sdl_config_option(data, size, trials_key, 0, -1)
        level_allowed: bool = level > 0 if task == 4 else (SyllogismOptions::allowed(0, level) if task == 5 else TaskSettings::allowed(task, 0, level))
        trials_allowed: bool = SyllogismOptions::allowed(1, trials) if task >= 4 else TaskSettings::allowed(task, 1, trials)
        output[0] <- level if level_allowed else -1
        output[1] <- trials if trials_allowed else -1
        output[2] <- sdl_config_option(data, size, display_key, 1, -1) if task != 4 else -1
        output[3] <- sdl_config_option(data, size, adaptive_key, 1, -1)
        output[4] <- sdl_config_option(data, size, "SYLLOGISM_REAL_WORDS", 1, -1) if task == 5 else -1

def sdl_read_task_ini(output: mutable i64&) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        size: mutable i64 = 0
        if sdl_media_config(&size) is raw:
            trusted Unsafe.PointerCast:
                data: heap u8& = raw.cast[heap u8&]
                sdl_task_ini_group(data, size, &output[0], 0, "CROSSWORD_LEVEL", "CROSSWORD_TRIALS", "CROSSWORD_SHOW_MISTAKES", "CROSSWORD_ADAPTIVE")
                sdl_task_ini_group(data, size, &output[5], 1, "SCRABBLE_LEVEL", "SCRABBLE_TRIALS", "SCRABBLE_SHOW_PREMIUMS", "SCRABBLE_ADAPTIVE")
                sdl_task_ini_group(data, size, &output[10], 5, "SYLLOGISM_LEVEL", "SYLLOGISM_TRIALS", "SYLLOGISM_SHOW_WORKING", "SYLLOGISM_ADAPTIVE")
                sdl_task_ini_group(data, size, &output[15], 4, "NUMBEROLOGY_LEVEL", "NUMBEROLOGY_TRIALS", "", "NUMBEROLOGY_ADVANCE")
                sdl_task_ini_group(data, size, &output[20], 2, "ALGEBRA_LEVEL", "ALGEBRA_TRIALS", "ALGEBRA_SHOW_WORKING", "ALGEBRA_ADAPTIVE")
                sdl_task_ini_group(data, size, &output[25], 3, "SCRAMBLE_LEVEL", "SCRAMBLE_TRIALS", "SCRAMBLE_SHOW_COUNT", "SCRAMBLE_ADAPTIVE")
            SDL_free(raw)
            return true
        return false

# Parse the six native task configurations and Scramble corpus paths in the
# same order as the SDL startup path. Each row is an options pointer followed
# by its optional lexicon pointer; Syllogism has no lexicon field.
def sdl_parse_configs(argc: i64, argv: usize&?, rows: usize&?, index: mutable usize&?, sentences: mutable usize&?) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 2.i32() if argv == null or rows == null or index == null or sentences == null
        trusted Unsafe.PointerCast:
            table: usize& = rows
            at: mutable usize = 0.usize()
            while at < 6.usize() |at, table|:
                return 2.i32() if table[at * 2.usize()] == 0.usize() or (at != 2.usize() and table[at * 2.usize() + 1.usize()] == 0.usize())
                at <- at + 1.usize()
            crossword: mutable i64& = table[0].cast[mutable i64&]
            crossword_path: mutable usize& = table[1].cast[mutable usize&]
            scrabble: mutable i64& = table[2].cast[mutable i64&]
            scrabble_path: mutable usize& = table[3].cast[mutable usize&]
            syllogism: mutable i64& = table[4].cast[mutable i64&]
            numberology: mutable i64& = table[6].cast[mutable i64&]
            numberology_path: mutable usize& = table[7].cast[mutable usize&]
            algebra: mutable i64& = table[8].cast[mutable i64&]
            algebra_path: mutable usize& = table[9].cast[mutable usize&]
            scramble: mutable i64& = table[10].cast[mutable i64&]
            scramble_path: mutable usize& = table[11].cast[mutable usize&]
            ini: mutable i64[30] = zeroed
            has_ini: bool = sdl_read_task_ini(&ini[0])
            return 2.i32() if task_settings_parse(0, argc, argv, crossword, crossword_path, 1, (&ini[0]).uintptr() if has_ini else 0.usize()) != 0.i32()
            return 2.i32() if task_settings_parse(1, argc, argv, scrabble, scrabble_path, 1, (&ini[5]).uintptr() if has_ini else 0.usize()) != 0.i32()
            return 2.i32() if syllogism_options_parse(argc, argv, syllogism, 1, (&ini[10]).uintptr() if has_ini else 0.usize()) != 0
            return 2.i32() if numberology_options_parse(argc, argv, numberology, numberology_path, 1, (&ini[15]).uintptr() if has_ini else 0.usize()) != 0.i32()
            return 2.i32() if task_settings_parse(2, argc, argv, algebra, algebra_path, 1, (&ini[20]).uintptr() if has_ini else 0.usize()) != 0.i32()
            return 2.i32() if task_settings_parse(3, argc, argv, scramble, scramble_path, 1, (&ini[25]).uintptr() if has_ini else 0.usize()) != 0.i32()
            return sdl_scramble_corpus_args(argc, argv, index, sentences)

export fn nw_sdl_parse_configs(argc: i64, argv: usize&?, rows: usize&?, index: mutable usize&?, sentences: mutable usize&?) -> i32 = sdl_parse_configs

# Numberology key dispatch returns 1 when leaving a hub options screen needs
# the SDL shell to stop text input.
def sdl_numberology_key(handle: mutable i64&?, mode: mutable u8&?, opened: mutable u8&?, from_hub: mutable u8&?, selected: mutable i32&?, config: mutable i64&?, draft: mutable i64&?, editing: mutable u8&?, edit_value: mutable i64&?, results: mutable usize&?, key: i64, paste: i64) -> i32:
    can Memory.Allocate, Memory.Release, Blocking.IO, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return 0.i32() if handle == null or mode == null or opened == null or from_hub == null or selected == null or config == null or draft == null or editing == null or edit_value == null or results == null
        trusted Unsafe.PointerCast:
            h: mutable i64& = handle
            active: mutable u8& = mode
            overlay: mutable u8& = opened
            hub: mutable u8& = from_hub
            row: mutable i32& = selected
            current: mutable i64& = config
            pending: mutable i64& = draft
            edit: mutable u8& = editing
            edit_number: mutable i64& = edit_value
            manager: mutable usize& = results
            now: i64 = SDL_GetTicks().i64()
            phase: i64 = numberology_info(h[0], 0)
            value: mutable i64 = 0
            if overlay[0] != 0.u8():
                action: i64 = SDLTaskKeys::map(34, key, 0, row[0].i64(), 3, (&value).uintptr().cast[mutable i64&])
                if key == SDLTaskKeys::UP:
                    row[0] <- row[0] - 1.i32() if action == 101
                    edit[0] <- 0.u8()
                elif key == SDLTaskKeys::DOWN:
                    row[0] <- row[0] + 1.i32() if action == 102
                    edit[0] <- 0.u8()
                elif action == 103:
                    numberology_modify_option(pending, row[0].i64(), value)
                    edit[0] <- 0.u8() if row[0] == 0.i32()
                elif action == 105 and row[0] == 0.i32():
                    numberology_edit_backspace(pending, edit, edit_number)
                elif action == 104:
                    fresh: i64 = numberology_create(pending[0], pending[1], pending[3], numberology_initial_seed(h[0]))
                    if fresh != 0:
                        _ = numberology_destroy(h[0])
                        h[0] <- fresh
                        at: mutable usize = 0.usize()
                        while at < 4.usize() |at, current, pending|:
                            current[at] <- pending[at]
                            at <- at + 1.usize()
                        if NumberologySettings::write(current.cast[i64&]) == 0.i32():
                            SDL_Log("Could not save Numberology settings")
                    overlay[0] <- 0.u8()
                    if hub[0] != 0.u8():
                        _ = numberology_destroy(h[0])
                        h[0] <- 0
                        active[0] <- 0.u8()
                        hub[0] <- 0.u8()
                        return 1.i32()
            else:
                action: i64 = SDLTaskKeys::map(36, key, phase, 0, paste, (&value).uintptr().cast[mutable i64&])
                if action == 100:
                    sdl_paste_text(h[0], now, 0)
                elif action == 101:
                    at: mutable usize = 0.usize()
                    while at < 4.usize() |at, current, pending|:
                        pending[at] <- current[at]
                        at <- at + 1.usize()
                    row[0] <- 0.i32()
                    edit[0] <- 0.u8()
                    overlay[0] <- 1.u8()
                elif action == 102:
                    _ = numberology_sdl_action(h[0], 0, SDL_GetTicks().i64(), current, manager)
                elif action == 103:
                    _ = numberology_sdl_action(h[0], 3, now, null, manager)
                elif action == 104:
                    _ = numberology_action(h[0], 2, 0, now)
                elif action == 105 or action == 106:
                    _ = numberology_action(h[0], 4 if action == 105 else 5, 0, now)
            return 0.i32()

export fn nw_sdl_numberology_key(handle: mutable i64&?, mode: mutable u8&?, opened: mutable u8&?, from_hub: mutable u8&?, selected: mutable i32&?, config: mutable i64&?, draft: mutable i64&?, editing: mutable u8&?, edit_value: mutable i64&?, results: mutable usize&?, key: i64, paste: i64) -> i32 = sdl_numberology_key

# Handle Algebra keys, including options and controller replacement.
def sdl_algebra_key(handle: mutable i64&?, mode: mutable u8&?, opened: mutable u8&?, from_hub: mutable u8&?, selected: mutable i32&?, config: mutable i64&?, draft: mutable i64&?, key: i64, paste: i64):
    can Memory.Allocate, Memory.Release, Blocking.IO, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return if handle == null or mode == null or opened == null or from_hub == null or selected == null or config == null or draft == null
        trusted Unsafe.PointerCast:
            h: mutable i64& = handle
            active: mutable u8& = mode
            overlay: mutable u8& = opened
            hub: mutable u8& = from_hub
            row: mutable i32& = selected
            current: mutable i64& = config
            pending: mutable i64& = draft
            value: mutable i64 = 0
            if overlay[0] != 0.u8():
                action: i64 = SDLTaskKeys::map(34, key, 0, row[0].i64(), 4, (&value).uintptr().cast[mutable i64&])
                if action == 101:
                    row[0] <- row[0] - 1.i32()
                elif action == 102:
                    row[0] <- row[0] + 1.i32()
                elif action == 103:
                    _ = task_options_modify(2, pending, row[0].i64(), value)
                elif action == 104:
                    fresh: i64 = algebra_create_options(pending[0], pending[1], pending[2], pending[3], algebra_initial_seed(h[0]))
                    if fresh != 0:
                        _ = algebra_destroy(h[0])
                        h[0] <- fresh
                        at: mutable usize = 0.usize()
                        while at < 4.usize() |at, current, pending|:
                            current[at] <- pending[at]
                            at <- at + 1.usize()
                        if TaskSettings::write(2, current.cast[i64&]) == 0.i32():
                            SDL_Log("Could not save Algebra settings")
                    overlay[0] <- 0.u8()
                    if hub[0] != 0.u8():
                        _ = algebra_destroy(h[0])
                        h[0] <- 0
                        active[0] <- 0.u8()
                        hub[0] <- 0.u8()
            else:
                action: i64 = SDLTaskKeys::map(35, key, algebra_info(h[0], 0), 0, paste, (&value).uintptr().cast[mutable i64&])
                if action == 100:
                    sdl_paste_text(h[0], SDL_GetTicks().i64(), 1)
                elif action == 101:
                    at: mutable usize = 0.usize()
                    while at < 4.usize() |at, current, pending|:
                        pending[at] <- current[at]
                        at <- at + 1.usize()
                    row[0] <- 0.i32()
                    overlay[0] <- 1.u8()
                elif action == 102:
                    _ = algebra_action(h[0], 0, 0, SDL_GetTicks().i64())
                    if algebra_info(h[0], 0) == 1:
                        _ = algebra_action(h[0], 4, 0, SDL_GetTicks().i64())
                elif action == 103:
                    _ = algebra_action(h[0], 3, 0, SDL_GetTicks().i64())
                elif action == 104:
                    _ = algebra_action(h[0], 2, 0, SDL_GetTicks().i64())

export fn nw_sdl_algebra_key(handle: mutable i64&?, mode: mutable u8&?, opened: mutable u8&?, from_hub: mutable u8&?, selected: mutable i32&?, config: mutable i64&?, draft: mutable i64&?, key: i64, paste: i64) = sdl_algebra_key

# Return 1 to start SDL text input, 2 to stop it, and 0 for no change.
def sdl_scramble_key(handle: mutable i64&?, mode: mutable u8&?, opened: mutable u8&?, from_hub: mutable u8&?, selected: mutable i32&?, config: mutable i64&?, draft: mutable i64&?, suppress: mutable u8&?, key: i64, paste: i64) -> i32:
    can Memory.Allocate, Memory.Release, Blocking.IO, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return 0.i32() if handle == null or mode == null or opened == null or from_hub == null or selected == null or config == null or draft == null or suppress == null
        trusted Unsafe.PointerCast:
            h: mutable i64& = handle
            active: mutable u8& = mode
            overlay: mutable u8& = opened
            hub: mutable u8& = from_hub
            row: mutable i32& = selected
            current: mutable i64& = config
            pending: mutable i64& = draft
            space: mutable u8& = suppress
            phase: i64 = scramble_info(h[0], 0)
            now: i64 = SDL_GetTicks().i64()
            value: mutable i64 = 0
            if overlay[0] != 0.u8():
                action: i64 = SDLTaskKeys::map(34, key, 0, row[0].i64(), 4, (&value).uintptr().cast[mutable i64&])
                if action == 101:
                    row[0] <- row[0] - 1.i32()
                elif action == 102:
                    row[0] <- row[0] + 1.i32()
                elif action == 103:
                    _ = task_options_modify(3, pending, row[0].i64(), value)
                elif action == 104:
                    option_bits: i64 = task_options_pack(1, pending.cast[i64&])
                    if scramble_action(h[0], 4, option_bits, now) == 1:
                        at: mutable usize = 0.usize()
                        while at < 4.usize() |at, current, pending|:
                            current[at] <- pending[at]
                            at <- at + 1.usize()
                        if TaskSettings::write(3, current.cast[i64&]) == 0.i32():
                            SDL_Log("Could not save Scramble settings")
                    overlay[0] <- 0.u8()
                    if hub[0] != 0.u8():
                        _ = scramble_destroy(h[0])
                        h[0] <- 0
                        active[0] <- 0.u8()
                        hub[0] <- 0.u8()
            else:
                action: i64 = SDLTaskKeys::map(37, key, phase, 0, paste, (&value).uintptr().cast[mutable i64&])
                if action == 100:
                    sdl_paste_text(h[0], now, 2, space)
                elif action == 101:
                    at: mutable usize = 0.usize()
                    while at < 4.usize() |at, current, pending|:
                        pending[at] <- current[at]
                        at <- at + 1.usize()
                    row[0] <- 0.i32()
                    overlay[0] <- 1.u8()
                    hub[0] <- 0.u8()
                    return 2.i32()
                elif action == 102:
                    _ = scramble_action(h[0], 0, 0, now)
                    if scramble_info(h[0], 0) == 1:
                        _ = scramble_action(h[0], 5, 0, SDL_GetTicks().i64())
                        space[0] <- 1.u8()
                        return 1.i32()
                elif action == 103:
                    _ = scramble_action(h[0], 3, 0, now)
                    return 2.i32() if scramble_info(h[0], 0) != 1
                elif action == 104:
                    _ = scramble_action(h[0], 2, 0, now)
            return 0.i32()

export fn nw_sdl_scramble_key(handle: mutable i64&?, mode: mutable u8&?, opened: mutable u8&?, from_hub: mutable u8&?, selected: mutable i32&?, config: mutable i64&?, draft: mutable i64&?, suppress: mutable u8&?, key: i64, paste: i64) -> i32 = sdl_scramble_key

# Dispatch word-game keys and their shared four-field options state.
# task 0 is Scrabble, task 1 is Crossword.
def sdl_word_key(task: i64, handle: mutable i64&?, mode: mutable u8&?, opened: mutable u8&?, from_hub: mutable u8&?, selected: mutable i32&?, config: mutable i64&?, draft: mutable i64&?, key: i64):
    can Memory.Allocate, Memory.Release, Blocking.IO, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return if task < 0 or task > 1 or handle == null or mode == null or opened == null or selected == null or config == null or draft == null
        trusted Unsafe.PointerCast:
            h: mutable i64& = handle
            active: mutable u8& = mode
            overlay: mutable u8& = opened
            row: mutable i32& = selected
            current: mutable i64& = config
            pending: mutable i64& = draft
            phase: i64 = scrabble_info(h[0], 0) if task == 0 else crossword_info(h[0], 0)
            now: i64 = SDL_GetTicks().i64()
            value: mutable i64 = 0
            if overlay[0] != 0.u8():
                action: i64 = SDLTaskKeys::map(34, key, 0, row[0].i64(), 4, (&value).uintptr().cast[mutable i64&])
                if action == 101:
                    row[0] <- row[0] - 1.i32()
                elif action == 102:
                    row[0] <- row[0] + 1.i32()
                elif action == 103:
                    _ = task_options_modify(1 if task == 0 else 0, pending, row[0].i64(), value)
                elif action == 104:
                    option_bits: i64 = task_options_pack(1 if task == 0 else 0, pending.cast[i64&])
                    applied: i64 = scrabble_action(h[0], 9, option_bits, now) if task == 0 else crossword_action(h[0], 10, option_bits, now)
                    if applied == 1:
                        at: mutable usize = 0.usize()
                        while at < 4.usize() |at, current, pending|:
                            current[at] <- pending[at]
                            at <- at + 1.usize()
                        if TaskSettings::write(1 if task == 0 else 0, current.cast[i64&]) == 0.i32():
                            if task == 0:
                                SDL_Log("Could not save Scrabble settings")
                            else:
                                SDL_Log("Could not save Crossword settings")
                    overlay[0] <- 0.u8()
                    if task == 0 and from_hub != null:
                        hub: mutable u8& = from_hub
                        if hub[0] != 0.u8():
                            _ = scrabble_destroy(h[0])
                            h[0] <- 0
                            active[0] <- 0.u8()
                            hub[0] <- 0.u8()
            elif (task == 0 and (key == 111 or key == 99)) or (task == 1 and key == 111 and phase != 1):
                at: mutable usize = 0.usize()
                while at < 4.usize() |at, current, pending|:
                    pending[at] <- current[at]
                    at <- at + 1.usize()
                row[0] <- 0.i32()
                overlay[0] <- 1.u8()
                if task == 0 and from_hub != null:
                    hub: mutable u8& = from_hub
                    hub[0] <- 0.u8()
            elif task == 0 and key == 32 and phase != 1:
                _ = scrabble_action(h[0], 0, 0, now)
                if scrabble_info(h[0], 0) == 1:
                    _ = scrabble_action(h[0], 10, 0, SDL_GetTicks().i64())
            elif task == 1 or phase == 1:
                action: i64 = SDLTaskKeys::map(30 if task == 0 else 31, key, phase, 0, 0, (&value).uintptr().cast[mutable i64&])
                if action >= 0:
                    if task == 0:
                        _ = scrabble_action(h[0], action, value, now)
                    else:
                        _ = crossword_action(h[0], action, value, now)

export fn nw_sdl_word_key(task: i64, handle: mutable i64&?, mode: mutable u8&?, opened: mutable u8&?, from_hub: mutable u8&?, selected: mutable i32&?, config: mutable i64&?, draft: mutable i64&?, key: i64) = sdl_word_key

# Apply Syllogism controller and option commands shared by key and pointer input.
def sdl_syllogism_action(handle: mutable i64&, mode: mutable u8&, opened: mutable u8&, from_hub: mutable u8&, selected: mutable i64&, config: mutable i64&, draft: mutable i64&, results: mutable usize&, action: i64, value: i64):
    can Memory.Allocate, Memory.Release, Blocking.IO, Console.Write, Abort.Panic, Unsafe.PointerCast:
        if action >= 0 and action <= 6:
            _ = syllogism_sdl_dispatch(handle[0], action, value, SDL_GetTicks().i64(), config.cast[i64&], results)
        elif action == 101:
            selected[0] <- selected[0] - 1
        elif action == 102:
            selected[0] <- selected[0] + 1
        elif action == 103:
            _ = syllogism_options_modify(draft, selected[0], value)
        elif action == 105:
            at: mutable usize = 0.usize()
            while at < 5.usize() |at, config, draft|:
                draft[at] <- config[at]
                at <- at + 1.usize()
            selected[0] <- 0
            opened[0] <- 1.u8()
        elif action >= 110 and action < 115:
            row: i64 = action - 110
            if row == selected[0]:
                _ = syllogism_options_modify(draft, row, 1)
            else:
                selected[0] <- row
        elif action == 100 or action == 104:
            if action == 104:
                fresh: i64 = syllogism_create(draft[0], draft[1], draft[2], draft[3], draft[4], syllogism_initial_seed(handle[0]))
                if fresh != 0:
                    _ = syllogism_destroy(handle[0])
                    handle[0] <- fresh
                    at: mutable usize = 0.usize()
                    while at < 5.usize() |at, config, draft|:
                        config[at] <- draft[at]
                        at <- at + 1.usize()
                    if syllogism_options_save(config.cast[i64&]) == 0:
                        SDL_Log("Could not save Syllogism settings")
            opened[0] <- 0.u8()
            if from_hub[0] != 0.u8():
                _ = syllogism_destroy(handle[0])
                handle[0] <- 0
                mode[0] <- 0.u8()
                from_hub[0] <- 0.u8()

# Dispatch a logical-window Syllogism click.
def sdl_syllogism_click(handle: mutable i64&?, mode: mutable u8&?, opened: mutable u8&?, from_hub: mutable u8&?, selected: mutable i64&?, config: mutable i64&?, draft: mutable i64&?, results: mutable usize&?, x: f32, y: f32, width: i32, height: i32):
    can Memory.Allocate, Memory.Release, Blocking.IO, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return if handle == null or mode == null or opened == null or from_hub == null or selected == null or config == null or draft == null or results == null
        trusted Unsafe.PointerCast:
            h: mutable i64& = handle
            active: mutable u8& = mode
            is_open: mutable u8& = opened
            hub: mutable u8& = from_hub
            row: mutable i64& = selected
            current: mutable i64& = config
            pending: mutable i64& = draft
            manager: mutable usize& = results
            view: mutable f32[4] = zeroed
            SDLGeometry::setup((&view[0]).uintptr().cast[mutable f32&], width, height)
            return if view[0] <= 0.0.f32()
            rx: f64 = ((x - view[1]) / view[0]).f64()
            ry: f64 = ((view[3] - view[2] - y) / view[0]).f64()
            action: i64 = SyllogismInput::pointer(rx, ry, is_open[0].i64(), syllogism_info(h[0], 0))
            sdl_syllogism_action(h, active, is_open, hub, row, current, pending, manager, action, 0)

export fn nw_sdl_syllogism_click(handle: mutable i64&?, mode: mutable u8&?, opened: mutable u8&?, from_hub: mutable u8&?, selected: mutable i64&?, config: mutable i64&?, draft: mutable i64&?, results: mutable usize&?, x: f32, y: f32, width: i32, height: i32) = sdl_syllogism_click

def sdl_syllogism_key(handle: mutable i64&?, mode: mutable u8&?, opened: mutable u8&?, from_hub: mutable u8&?, selected: mutable i64&?, config: mutable i64&?, draft: mutable i64&?, results: mutable usize&?, key: i64):
    can Memory.Allocate, Memory.Release, Blocking.IO, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return if handle == null or mode == null or opened == null or from_hub == null or selected == null or config == null or draft == null or results == null
        trusted Unsafe.PointerCast:
            h: mutable i64& = handle
            active: mutable u8& = mode
            is_open: mutable u8& = opened
            hub: mutable u8& = from_hub
            row: mutable i64& = selected
            current: mutable i64& = config
            pending: mutable i64& = draft
            manager: mutable usize& = results
            value: mutable i64 = 0
            action: i64 = SyllogismInput::key(key, syllogism_info(h[0], 0), is_open[0].i64(), row[0], (&value).uintptr().cast[mutable i64&])
            sdl_syllogism_action(h, active, is_open, hub, row, current, pending, manager, action, value)

export fn nw_sdl_syllogism_key(handle: mutable i64&?, mode: mutable u8&?, opened: mutable u8&?, from_hub: mutable u8&?, selected: mutable i64&?, config: mutable i64&?, draft: mutable i64&?, results: mutable usize&?, key: i64) = sdl_syllogism_key

# Text-task clicks share the option layout, but preserve each controller's
# start and paging behavior and Numberology's results manager transitions.
def sdl_text_task_click(task: i64, handle: i64, options_open: i64, x: f32, y: f32, width: i32, height: i32, selected: mutable i32&?, draft: mutable i64&?, editing: mutable u8&?, config: mutable i64&?, results: mutable usize&?) -> i32:
    can Memory.Allocate, Memory.Release, Blocking.IO, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return 0.i32() if task < 0 or task > 2
        if options_open != 0:
            return 0.i32() if width <= 0.i32() or height <= 0.i32()
            reference_x: f32 = x * 912.0.f32() / width.f32() if task == 0 else 456.0.f32()
            reference_y: f32 = y * 684.0.f32() / height.f32()
            level_selected: mutable bool = false
            if task == 0 and selected != null:
                row: mutable i32& = selected
                level_selected <- row[0] == 0.i32()
            changed: i32 = sdl_option_click(4 if task == 0 else (2 if task == 1 else 3),
                reference_x, reference_y, 912.i32(), 684.i32(), selected, draft)
            if level_selected and changed != 0.i32() and selected != null and editing != null:
                row: mutable i32& = selected
                flag: mutable u8& = editing
                flag[0] <- 0.u8() if row[0] == 0.i32()
            return 0.i32()
        now: i64 = SDL_GetTicks().i64()
        if task == 0:
            phase: i64 = numberology_info(handle, 0)
            page: mutable i32 = 0.i32()
            if width > 0.i32() and height > 0.i32():
                view: mutable f32[4] = zeroed
                trusted Unsafe.PointerCast:
                    SDLGeometry::setup((&view[0]).uintptr().cast[mutable f32&], width, height)
                page <- numberology_page((x - view[1]) / view[0], (height.f32() - y - view[2]) / view[0])
            if (phase == 1 or phase == 2) and numberology_info(handle, 22) > 1 and page != 0.i32():
                _ = numberology_action(handle, page.i64(), 0, now)
            elif phase != 1:
                _ = numberology_sdl_action(handle, 0, now, config, results)
        elif task == 1:
            if algebra_info(handle, 0) != 1:
                _ = algebra_action(handle, 0, 0, now)
                if algebra_info(handle, 0) == 1:
                    _ = algebra_action(handle, 4, 0, SDL_GetTicks().i64())
        elif scramble_info(handle, 0) != 1:
            _ = scramble_action(handle, 0, 0, now)
            if scramble_info(handle, 0) == 1:
                _ = scramble_action(handle, 5, 0, SDL_GetTicks().i64())
                if editing != null:
                    flag: mutable u8& = editing
                    flag[0] <- 0.u8()
                return 1.i32()
        return 0.i32()

export fn nw_sdl_text_task_click(task: i64, handle: i64, options_open: i64, x: f32, y: f32, width: i32, height: i32, selected: mutable i32&?, draft: mutable i64&?, editing: mutable u8&?, config: mutable i64&?, results: mutable usize&?) -> i32 = sdl_text_task_click


# Select the active task frame in the same precedence as the SDL shell.
def sdl_task_frame_themed(dest: i64, capacity: i64, handles: i64&?, width: i64, height: i64, hub: i64, category: i64, selected: i64, trial: i64, black: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return 0 if handles == null
        active: i64& = handles
        return you_are_here_frame_write(dest, capacity, active[0], black, width, height) if active[0] != 0
        return sokoban_frame_write(dest, capacity, active[1], black, width, height) if active[1] != 0
        return monkey_ladder_frame_write(dest, capacity, active[2], black, width, height) if active[2] != 0
        return nback3d_frame_write(dest, capacity, active[3], black, width, height) if active[3] != 0
        return marble_frame_write(dest, capacity, active[4], black, width, height) if active[4] != 0
        return tetris_frame_write(dest, capacity, active[5], black, width, height) if active[5] != 0
        return count_frame_write(dest, capacity, active[6], black, width, height) if active[6] != 0
        return mr_time_frame_write(dest, capacity, active[7], black, width, height) if active[7] != 0
        return graph_mapping_frame_write(dest, capacity, active[8], black, width, height) if active[8] != 0
        return matrix_reasoning_frame_write(dest, capacity, active[9], black, width, height) if active[9] != 0
        return in_the_dark_frame_write(dest, capacity, active[10], black, width, height) if active[10] != 0
        return fog_frame_write(dest, capacity, active[11], black, width, height) if active[11] != 0
        return removals_frame_write(dest, capacity, active[12], black, width, height) if active[12] != 0
        return custody_frame_write(dest, capacity, active[13], black, width, height) if active[13] != 0
        return concentration_frame_write(dest, capacity, active[14], black, width, height) if active[14] != 0
        return recognition_frame_write(dest, capacity, active[15], black, width, height) if active[15] != 0
        return trivia_frame_write(dest, capacity, active[16], black, width, height) if active[16] != 0
        return reflex_frame_write(dest, capacity, active[17], black, width, height) if active[17] != 0
        return algebra_frame_write(dest, capacity, active[18], black, width, height) if active[18] != 0
        return numberology_frame_write(dest, capacity, active[19], black, width, height) if active[19] != 0
        return jigsaw_frame_write(dest, capacity, active[20], black, width, height) if active[20] != 0
        return sudoku_frame_write(dest, capacity, active[21], black, width, height) if active[21] != 0
        return go_frame_write(dest, capacity, active[22], black, width, height) if active[22] != 0
        return crossword_frame_write(dest, capacity, active[23], black, width, height) if active[23] != 0
        return crossed_wires_frame_write(dest, capacity, active[24], black, width, height) if active[24] != 0
        return ncup_monte_frame_write(dest, capacity, active[25], black, width, height) if active[25] != 0
        return tracking_frame_write(dest, capacity, active[26], black, width, height) if active[26] != 0
        return lookout_frame_write(dest, capacity, active[27], black, width, height) if active[27] != 0
        return pursuit_frame_write(dest, capacity, active[28], black, width, height) if active[28] != 0
        return out_of_sight_frame_write(dest, capacity, active[29], black, width, height) if active[29] != 0
        return buzz_wire_frame_write(dest, capacity, active[30], black, width, height) if active[30] != 0
        return donkey_frame_write(dest, capacity, active[31], black, width, height) if active[31] != 0
        return two_hands_frame_write(dest, capacity, active[32], black, width, height) if active[32] != 0
        return overrun_frame_write(dest, capacity, active[33], black, width, height) if active[33] != 0
        return taskhub_write(dest, capacity, category, selected, black, width, height) if hub != 0
        return title_write(dest, capacity, (trial - 1) % 4 if trial > 0 else 0, black, 1, 1)

def sdl_task_frame_write(dest: i64, capacity: i64, handles: i64&?, width: i64, height: i64, hub: i64, category: i64, selected: i64, trial: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return sdl_task_frame_themed(dest, capacity, handles, width, height, hub, category, selected, trial, 0)

export fn nw_sdl_task_frame_write(dest: i64, capacity: i64, handles: i64&?, width: i64, height: i64, hub: i64, category: i64, selected: i64, trial: i64) -> i64 = sdl_task_frame_write

# The first 34 handles use sdl_task_frame_write's order; entries 34-36 are
# Syllogism, Scramble and Scrabble. Options are six rows of seven integers:
# open, selected, level, trials, and up to three task-specific flags.
def sdl_frame_write(dest: i64, capacity: i64, handles: i64&?, options: i64&?, width: i64, height: i64, hub: i64, category: i64, selected: i64, trial: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return 0 if handles == null or options == null
        active: i64& = handles
        o: i64& = options
        black: i64 = o[41]
        return SDLNearer::frame_write(dest, capacity, active[52], black) if active[52] != 0
        return SDLPov::frame_write(dest, capacity, active[54], black) if active[54] != 0
        return SDLInside::frame_write(dest, capacity, active[55], black) if active[55] != 0
        return SDLTouching::frame_write(dest, capacity, active[56], black) if active[56] != 0
        return SDLCrossings::frame_write(dest, capacity, active[57], black) if active[57] != 0
        return SDLMirror::frame_write(dest, capacity, active[53], black) if active[53] != 0
        return SDLRooms::frame_write(dest, capacity, active[51], black) if active[51] != 0
        return SDLNotebook::frame_write(dest, capacity, active[50], black) if active[50] != 0
        return SDLHoldIt::frame_write(dest, capacity, active[49], black) if active[49] != 0
        return SDLTimeIt::frame_write(dest, capacity, active[58], black) if active[58] != 0
        return SDLBalance::frame_write(dest, capacity, active[59], black) if active[59] != 0
        return SDLJuggler::frame_write(dest, capacity, active[60], black) if active[60] != 0
        return SDLLander::frame_write(dest, capacity, active[61], black) if active[61] != 0
        return SDLBeat::frame_write(dest, capacity, active[62], black) if active[62] != 0
        return SDLGlider::frame_write(dest, capacity, active[63], black) if active[63] != 0
        return SDLCatch::frame_write(dest, capacity, active[64], black) if active[64] != 0
        return SDLEchoCave::frame_write(dest, capacity, active[65], black) if active[65] != 0
        return SDLDroneHoops::frame_write(dest, capacity, active[66], black) if active[66] != 0
        return SDLFieldManual::frame_write(dest, capacity, active[67], black) if active[67] != 0
        return SDLSafecracker::frame_write(dest, capacity, active[68], black) if active[68] != 0
        return SDLStagehand::frame_write(dest, capacity, active[69], black) if active[69] != 0
        return SDLLoadingDock::frame_write(dest, capacity, active[70], black) if active[70] != 0
        return SDLGunslinger::frame_write(dest, capacity, active[71], black) if active[71] != 0
        return SDLStopSwitch::frame_write(dest, capacity, active[48], black) if active[48] != 0
        return SDLDelay::frame_write(dest, capacity, active[47], black) if active[47] != 0
        return SDLTriage::frame_write(dest, capacity, active[46], black) if active[46] != 0
        return SDLHiddenWiring::frame_write(dest, capacity, active[45], black) if active[45] != 0
        return SDLHiddenRule::frame_write(dest, capacity, active[44], black) if active[44] != 0
