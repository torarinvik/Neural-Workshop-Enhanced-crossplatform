def sdl_screen_create_seeded(screen: i64, options: i64&?, lexicon: u8&?, index: u8&?, sentences: u8&?, seed: i64) -> i64:
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global.Read:
        return 0 if options == null
        o: i64& = options
        if screen == 20: return algebra_create_options(o[23], o[24], o[25], o[26], seed)
