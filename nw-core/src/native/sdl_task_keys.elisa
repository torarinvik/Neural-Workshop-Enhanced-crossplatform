# Translate SDL keycodes to controller actions. Task identifiers here are
# private to the SDL host; -1 means the key has no action.
module SDLTaskKeys:
    const LEFT: i64 = 1073741904
    const RIGHT: i64 = 1073741903
    const UP: i64 = 1073741906
    const DOWN: i64 = 1073741905

    def enter(key: i64) -> bool:
        return key == 13 or key == 1073741912

    def option_row(key: i64, current: i64, rows: i64) -> i64:
        return 0 if key == 1073741899 # Page Up
        return rows - 1 if key == 1073741902 # Page Down
        return current - 1 if key == UP and current > 0
        return current + 1 if key == DOWN and current < rows - 1
        return current

    def map(task: i64, key: i64, phase: i64, cursor: i64, count: i64, value: mutable i64&?) -> i64:
        can Abort.Panic:
            return -1 if value == null
            output: mutable i64& = value
            output[0] <- 0
            primary: bool = key == 32 or key == 13
            if task == 0: # Count
                return (0 if phase == 0 or phase == 4 else 3) if primary
                return 2 if key == 8
                if key >= 48 and key <= 57:
                    output[0] <- key - 48
                    return 1
            elif task == 1: # Mr. Time
                return (4 if phase == 3 else 0) if primary
                return 3 if key == 8
                return 2 if key == 46 or key == 1073741923
                if key >= 48 and key <= 57:
                    output[0] <- key - 48
                    return 1
            elif task == 2: # Graph Mapping
                return (0 if phase == 0 else 2) if primary
                return 1 if key == 121 or key == 115 or key == LEFT
                return 2 if key == 110 or key == 100 or key == RIGHT
            elif task == 3: # Matrix Reasoning
                return 0 if primary and (phase == 0 or phase == 4)
                if key >= 49 and key <= 56:
                    output[0] <- key - 49
                    return 1
            elif task == 4 or task == 5: # In the Dark and Removals
                return 0 if primary
                if key >= 49 and key <= 53:
                    output[0] <- key - 49
                    return 1 + output[0]
            elif task == 6: # Chain of Custody
                return 0 if primary
                return 1 if key == LEFT
                return 2 if key == RIGHT
                return 3 if key == 122
            elif task == 7: # Concentration
                return 0 if primary and phase != 2
                if key == 13:
                    output[0] <- cursor
                    return 1
                if key == LEFT:
                    output[0] <- cursor - 1 if cursor > 0 else 0
                    return 2
                if key == RIGHT:
                    output[0] <- cursor + 1 if cursor + 1 < count else count - 1
                    return 2
                if key == UP:
                    output[0] <- cursor - 4 if cursor >= 4 else 0
                    return 2
                if key == DOWN:
                    output[0] <- cursor + 4 if cursor + 4 < count else count - 1
                    return 2
            elif task == 8: # Recognition
                return 0 if primary and (phase == 0 or phase == 4)
                return 1 if (key == LEFT or key == 115 or key == 121) and (phase == 1 or phase == 2)
                return 2 if (key == RIGHT or key == 110) and (phase == 1 or phase == 2)
                return 3 if key == 114 and (phase == 1 or phase == 2)
            elif task == 9: # Trivia
                return (0 if phase == 0 or phase == 3 else (3 if phase == 1 else (12 if phase == 2 else -1))) if primary
                return 1 if key == UP and phase == 1
                return 2 if key == DOWN and phase == 1
                return 4 + key - 49 if key >= 49 and key <= 56 and phase == 1
            elif task == 10: # Reflex
                return 0 if primary
            elif task == 11: # 3D N-back
                return 0 if primary
                return 1 if key == 97
                return 3 if key == 112
                return 4 if key == 114
                if key >= 1073741882 and key <= 1073741887: # SDL F1 through F6
                    offset: i64 = key - 1073741882
                    # Level and trial pairs are decrease/increase. F5 is slower.
                    output[0] <- 1 if offset == 4 or offset == 1 or offset == 3 else -1
                    return 5 + offset / 2
            elif task == 12: # Fog of War
                return 0 if primary
                return 2 if key == UP
                return 3 if key == DOWN
                return 4 if key == LEFT
                return 5 if key == RIGHT
            elif task == 13: # Tetris
                return 0 if primary
                return 1 if key == LEFT
                return 2 if key == RIGHT
                return 3 if key == UP
                return 4 if key == DOWN
                return 5 if key == 114
                return 6 + key - 49 if key >= 49 and key <= 54
            elif task == 14 or task == 15: # You Are Here and Sokoban
                return 0 if primary
                return 1 if key == UP
                return 2 if key == DOWN
                return 3 if key == LEFT
                return 4 if key == RIGHT
                return 5 if key == 117 and task == 15
                return (5 if task == 14 else 6) if key == 114
            elif task == 16: # Monkey Ladder
                return (7 if phase == 2 else 0) if primary
                return 3 if key == UP
                return 4 if key == DOWN
                return 5 if key == LEFT
                return 6 if key == RIGHT
            elif task == 17: # Jigsaw
                return (4 if phase == 1 else 0) if primary or key == 1073741912
                if phase == 1 and (key == UP or key == DOWN or key == LEFT or key == RIGHT):
                    output[0] <- 0 if key == UP else (1 if key == DOWN else (2 if key == LEFT else 3))
                    return 3
                if phase == 1 and key >= 48 and key <= 57:
                    output[0] <- key - 48
                    return 1
            elif task == 18: # Sudoku; count is the largest permitted symbol
                return 0 if primary
                if phase == 1:
                    return 1 if key == UP
                    return 2 if key == DOWN
                    return 3 if key == LEFT
                    return 4 if key == RIGHT
                    return 6 if key == 8 or key == 127 or key == 48 or key == 1073741922
                    return 7 if key == 110
                    if key >= 49 and key <= 57:
                        output[0] <- key - 48
                        return 5
                    if key >= 1073741913 and key <= 1073741921: # keypad 1–9
                        output[0] <- key - 1073741912
                        return 5
                    if key >= 97 and key <= 103 and (key != 99 or count >= 12):
                        output[0] <- 10 + key - 97
                        return 5
            elif task == 19: # Go; cursor is the selected board index
                if primary:
                    return 0 if phase == 0 or phase == 3
                    if phase == 1:
                        output[0] <- cursor
                        return 1
                    return 2 if phase == 2
                elif phase == 1:
                    return 3 if key == UP
                    return 4 if key == DOWN
                    return 5 if key == LEFT
                    return 6 if key == RIGHT
                elif phase == 0 or phase == 3:
                    if key >= 49 and key <= 57:
                        output[0] <- key - 48
                        return 7
                    if key == 48:
                        output[0] <- 10
                        return 7
            elif task == 20: # N-Cup Monte
                return 0 if primary and (phase == 0 or phase == 4)
            elif task == 21: # Tracking
                return 0 if primary and (phase == 0 or phase == 5)
            elif task == 22 or task == 24: # Lookout and Out of Sight
                return 0 if primary and (phase == 0 or phase == (3 if task == 22 else 4))
                if phase == (1 if task == 22 else 2):
                    return 1 if key == 106
                    return 2 if key == 102
            elif task == 23: # Pursuit
                return 0 if primary and (phase == 0 or phase == 3)
                if phase == 1:
                    return 1 if key == UP
                    return 2 if key == DOWN
                    return 3 if key == LEFT
                    return 4 if key == RIGHT
            elif task == 25: # Buzz Wire; phase 1 also maps release keys
                return 0 if primary and (phase == 0 or phase == 2 or phase == 3)
                if phase == 1:
                    port: mutable i64 = -1
                    port <- 0 if key == UP
                    port <- 1 if key == DOWN
                    port <- 2 if key == LEFT
                    port <- 3 if key == RIGHT
                    port <- 4 if key == 119
                    port <- 5 if key == 115
                    port <- 6 if key == 105
                    port <- 7 if key == 107
                    port <- 8 if key == 106
                    port <- 9 if key == 108
                    port <- 10 if key == 1073742049 or key == 1073742053
                    if port >= 0:
                        output[0] <- port
                        return 1
            elif task == 26: # Donkey
                return 0 if primary and (phase == 0 or phase == 3 or phase == 4)
                return 1 if phase == 2 and (key == LEFT or key == RIGHT or key == 32)
            elif task == 27: # Two Hands
                return 0 if primary and (phase == 0 or phase == 3 or phase == 4)
                if phase == 2:
                    port: mutable i64 = -1
                    port <- 1 if key == LEFT or key == 97
                    port <- 2 if key == RIGHT or key == 100
                    port <- 4 if key == UP or key == 119
                    port <- 5 if key == DOWN or key == 115
                    port <- 6 if key == 105
                    port <- 7 if key == 108
                    port <- 8 if key == 111
                    port <- 9 if key == 107
                    port <- 10 if key == 32
                    if port >= 0:
                        output[0] <- port
                        return 1
            elif task == 28: # Overrun
                return 0 if primary and (phase == 0 or phase == 3)
                return 2 if phase == 1 and key == 8
                if phase == 1 and key >= 97 and key <= 122:
                    output[0] <- key - 97
                    return 1
            elif task == 29: # Crossed Wires; count selects the control layout
                return 0 if key == 32
                if phase == 1 and (count == 4 or count == 8):
                    direction: mutable i64 = -1
                    direction <- 0 if key == UP or key == 119 or key == 1073741920
                    direction <- (1 if count == 4 else 2) if key == RIGHT or key == 100 or key == 1073741918
                    direction <- (2 if count == 4 else 4) if key == DOWN or key == 115 or (count == 8 and key == 120) or key == 1073741914
                    direction <- (3 if count == 4 else 6) if key == LEFT or key == 97 or key == 1073741916
                    if count == 8:
                        direction <- 1 if key == 101 or key == 1073741921
                        direction <- 3 if key == 99 or key == 1073741915
                        direction <- 5 if key == 122 or key == 1073741913
                        direction <- 7 if key == 113 or key == 1073741919
                        # S is only a four-key shortcut.
                        direction <- -1 if key == 115
                    if direction >= 0:
                        output[0] <- direction
                        return 1
            elif task == 30: # Scrabble board controls
                if phase == 1:
                    return 1 if key == 13 or key == 1073741912
                    return 2 if key == LEFT
                    return 3 if key == RIGHT
                    return 4 if key == 9
                    return 5 if key == UP
                    return 6 if key == DOWN
                    return 8 if key == 8 or key == 127
                    if key >= 49 and key <= 55:
                        output[0] <- key - 49
                        return 7
                    if key >= 1073741913 and key <= 1073741919:
                        output[0] <- key - 1073741913
                        return 7
            elif task == 31: # Crossword board controls
                return 0 if key == 32 and (phase == 0 or phase == 2 or phase == 3)
                if phase == 1:
                    return 2 if key == LEFT
                    return 3 if key == RIGHT
                    return 4 if key == UP
                    return 5 if key == DOWN
                    return 6 if key == 9
                    return 8 if key == 8 or key == 127
                    if key >= 97 and key <= 122:
                        output[0] <- key - 97
                        return 7
            elif task == 32: # Marble key press
                return (5 if phase == 2 else 0) if key == 32
                return 6 if key == UP
                return 7 if key == RIGHT
                return 8 if key == DOWN
                return 9 if key == LEFT
                return 2 if key == 108
                return 1 if key == 114
            elif task == 33: # Marble key release
                return 4 if key == UP
                return 5 if key == RIGHT
                return 6 if key == DOWN
                return 3 if key == LEFT
            elif task == 34: # Shared options menu; cursor is the selected row
                return 101 if key == UP and cursor > 0
                return 102 if key == DOWN and cursor < count - 1
                if key == LEFT or key == RIGHT or key == 32:
                    output[0] <- -1 if key == LEFT else 1
                    return 103
                return 104 if key == 13
                return 105 if key == 8 or key == 127
            elif task == 35 or task == 36 or task == 37: # Text tasks; count is paste modifier
                return 100 if key == 118 and phase == 1 and count != 0
                return 101 if key == 111 and phase != 1
                if task == 36:
                    return 105 if key == 1073741899
                    return 106 if key == 1073741902
                return 102 if key == 32 and phase != 1
                return 104 if key == 8 or key == 127
                if task == 37:
                    return 103 if key == 13 or key == 1073741912
                else:
                    return 103 if key == 13 and phase == 1
            elif task == 38: # Global exit: cursor/count reserve Q for tasks
                return 1 if key == 27 or (key == 113 and cursor == 0 and count == 0)
            elif task == 39: # Task hub; phase is category, cursor is selection
                # TaskHubTasks::category_count(true): the seven first tabs,
                # Decisions, and Computer use, Emotion, Social and Rationality.
                if key == LEFT:
                    output[0] <- (phase + 11) % 12
                    return 0
                if key == RIGHT:
                    output[0] <- (phase + 1) % 12
                    return 0
                if key == UP or key == DOWN:
                    rows: i64 = count
                    return -1 if rows <= 0
                    offset: i64 = rows - 1 if key == UP else 1
                    output[0] <- (cursor + offset) % rows
                    return 1
                return 2 if key == 32 or enter(key)
                return 3 if key == 99
            return -1

export fn nw_sdl_task_key(task: i64, key: i64, phase: i64, cursor: i64, count: i64, value: mutable i64&?) -> i64 = SDLTaskKeys::map
