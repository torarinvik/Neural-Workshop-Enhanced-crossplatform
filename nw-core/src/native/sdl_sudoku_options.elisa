def sdl_sudoku_option_label(row: i64) -> cstr:
    return "Level" if row == 0
    return "Puzzles per run" if row == 1
    return "Mark clashing digits" if row == 2
    return "Adaptive level"

def sdl_sudoku_option_change(row: i64, current: i64, direction: i64) -> i64:
    can Abort.Panic:
        return 1 - current if row >= 2
        limit: i64 = 12 if row == 0 else 10
        next: mutable i64 = current
        while true |next, limit, row, direction|:
            next <- (next + direction + limit - 1) % limit + 1
            return next if SDLTaskCLI::allowed(row, next)
        return current

def sdl_sudoku_options_key(handle: i64, key: i64, tasks: usize, from_hub: bool = false) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap SudokuGame::SudokuRun& = handle.uintptr().cast[mutable heap SudokuGame::SudokuRun&]
            draft: mutable i64& = (&run.options_draft[0]).uintptr().cast[mutable i64&]
            if run.options_row < 0:
                return 0 if key != 111 and (key != 99 or run.size >= 12)
                draft[0] <- run.start_rung
                draft[1] <- run.total_trials
                draft[2] <- 1 if run.show_clashes else 0
                draft[3] <- 1 if run.adaptive else 0
                run.options_from_hub <- from_hub
                run.options_row <- 0
                return 1
            if SDLTaskKeys::enter(key) or key == 27:
                if SDLTaskKeys::enter(key):
                    run.start_rung <- draft[0]
                    run.total_trials <- draft[1]
                    run.show_clashes <- draft[2] != 0
                    run.adaptive <- draft[3] != 0
                    SudokuGame::reset(run)
                    if tasks != 0.usize():
                        selected: mutable i64& = tasks.cast[mutable i64&]
                        for row in 0..<4 |row, selected, draft|:
                            selected[row.usize()] <- draft[row.usize()]
                        data: mutable u8[128] = zeroed
                        length: i32 = SDL_snprintf(&data[0], 128.usize(), "%lld %lld %lld %lld\n",
                            draft[0], draft[1], draft[2], draft[3])
                        if length <= 0.i32() or length >= 128.i32() or not sdl_save_profile_sidecar(".sudoku-options", &data[0], length.usize()):
                            SDL_Log("Could not save Sudoku options")
                run.options_row <- -1
                return 2 if run.options_from_hub else 1
            run.options_row <- SDLTaskKeys::option_row(key, run.options_row, 4)
            if key == SDLTaskKeys::LEFT or key == SDLTaskKeys::RIGHT or key == 32:
                row: i64 = run.options_row
                draft[row.usize()] <- sdl_sudoku_option_change(row, draft[row.usize()], -1 if key == SDLTaskKeys::LEFT else 1)
            return 1

def sdl_sudoku_options_click(handle: i64, x: f32, y: f32, width: i32, height: i32):
    can Abort.Panic, Unsafe.PointerCast:
        return if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap SudokuGame::SudokuRun& = handle.uintptr().cast[mutable heap SudokuGame::SudokuRun&]
            return if run.options_row < 0
            row: i64 = sdl_option_row(x, y, width, height, 4)
            return if row < 0
            if row == run.options_row:
                run.options_draft[row.usize()] <- sdl_sudoku_option_change(row, run.options_draft[row.usize()], 1)
            run.options_row <- row

def sdl_read_sudoku_options(output: mutable i64&):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: mutable u8[4096] = zeroed
        data: mutable u8[128] = zeroed
        trusted Unsafe.PointerCast:
            target: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
            return if not sdl_task_profile_sidecar(target, ".sudoku-options")
            if SDL_IOFromFile(target.cast[cstr], "rb") is stream:
                raw: heap u8& = (&data[0]).uintptr().cast[heap u8&]
                length: usize = SDL_ReadIO(stream, (&data[0]).cast[mutable void&], 128.usize())
                status: i32 = SDL_GetIOStatus(stream)
                closed: bool = SDL_CloseIO(stream)
                return if not closed or status != 2.i32() or length == 0.usize() or length >= 128.usize()
                values: mutable i64[4] = zeroed
                at: mutable i64 = 0
                for row in 0..<4 |row, values, at, raw, length|:
                    value: i64 = SyllogismOptions::saved_integer(raw, length.i64(), &at)
                    valid: bool = SDLTaskCLI::allowed(row, value) if row < 2 else SudokuGame::allowed_flag(value)
                    return if not valid
                    values[row.usize()] <- value
                while at < length.i64() and SyllogismOptions::whitespace(raw[at.usize()].i64()) |at, length, raw|:
                    at <- at + 1
                return if at != length.i64()
                for row in 0..<4 |row, output, values|:
                    output[row.usize()] <- values[row.usize()]
