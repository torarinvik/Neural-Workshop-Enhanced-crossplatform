# Bounded binary corpus reads. The caller owns successful buffers and releases
# them with SDL_free. Length 0 means open failed; -1 means an invalid read.
extern SDL_GetIOSize(stream: mutable void&) -> i64 can[Blocking.IO]

def sdl_read_corpus(path: u8&?, length: mutable i64&?) -> mutable heap void&?:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return null if path == null or length == null
        output: mutable i64& = length
        output[0] <- 0
        trusted Unsafe.PointerCast:
            name: u8& = path
            file: mutable void&? = SDL_IOFromFile(name.cast[cstr], "rb")
            return null if file == null
            stream: mutable void& = file
            size: i64 = SDL_GetIOSize(stream)
            output[0] <- -1
            if size <= 0 or size > 67108864:
                _ = SDL_CloseIO(stream)
                return null
            memory: mutable heap void&? = SDL_malloc(size.usize())
            if memory == null:
                _ = SDL_CloseIO(stream)
                return null
            data: mutable heap void& = memory
            read: usize = SDL_ReadIO(stream, data.cast[mutable void&], size.usize())
            closed: bool = SDL_CloseIO(stream)
            if read != size.usize() or not closed:
                SDL_free(data.cast[heap void&])
                return null
            output[0] <- size
            return data

export fn nw_sdl_read_corpus(path: u8&?, length: mutable i64&?) -> mutable heap void&? = sdl_read_corpus

# Select the original application's corpus location using SDL's platform name.
# missing_base permits Scramble's historical empty-base fallback.
def sdl_corpus_path(dest: mutable u8&?, capacity: usize, kind: i64, missing_base: i64) -> i32:
    can Abort.Panic, Unsafe.PointerCast:
        return 0 if dest == null or capacity == 0.usize() or capacity > 2147483647.usize() or kind < 0 or kind > 1
        trusted Unsafe.PointerCast:
            output: mutable u8& = dest
            address: i64 = output.uintptr().i64()
            platform: cstr = SDL_GetPlatform()
            platform_address: i64 = platform.uintptr().i64()
            windows: bool = syllogism_argument_is(platform_address, "Windows")
            mac: bool = syllogism_argument_is(platform_address, "macOS")
            base: mutable i64 = 0
            if windows:
                if getenv("APPDATA") is found:
                    base <- found.uintptr().i64()
            else:
                if getenv("HOME") is found:
                    base <- found.uintptr().i64()
            return 0 if base == 0 and missing_base == 0
            end: mutable i64 = 0
            if base != 0:
                end <- SyllogismOptionsHost::append(address, capacity.i64(), 0, base.uintptr().cast[cstr])
                return 0 if end < 0
            folder: cstr = "/Brain Workshop/data/words" if windows else ("/Library/Application Support/Brain Workshop/data/words" if mac else "/.brainworkshop/data/words")
            end <- SyllogismOptionsHost::append(address, capacity.i64(), end, folder)
            return 0 if end < 0
            end <- SyllogismOptionsHost::append(address, capacity.i64(), end, "/lexicon.tsv" if kind == 0 else "/sentences.txt")
            return 1 if end >= 0 else 0

export fn nw_sdl_corpus_path(dest: mutable u8&?, capacity: usize, kind: i64, missing_base: i64) -> i32 = sdl_corpus_path
