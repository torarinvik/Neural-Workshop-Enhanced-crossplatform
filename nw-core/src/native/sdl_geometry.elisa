# Reference-space to SDL window-space conversion. The four-float view is
# shared with the desktop shell while its renderer is being migrated.
module SDLGeometry:
    def setup(view: mutable f32&?, width: i32, height: i32):
        can Abort.Panic, Unsafe.PointerCast:
            return if view == null
            trusted Unsafe.PointerCast:
                ptr: mutable f32& = view
                values: mutable heap f32& = ptr.cast[mutable heap f32&]
                sx: f32 = width.f32() / 912.0.f32()
                sy: f32 = height.f32() / 684.0.f32()
                scale: f32 = sx if sx < sy else sy
                values[0] <- scale
                values[1] <- (width.f32() - 912.0.f32() * scale) * 0.5.f32()
                values[2] <- (height.f32() - 684.0.f32() * scale) * 0.5.f32()
                values[3] <- height.f32()

    def x(view: f32&?, value: f32) -> f32:
        can Abort.Panic, Unsafe.PointerCast:
            return 0.0.f32() if view == null
            trusted Unsafe.PointerCast:
                ptr: f32& = view
                values: heap f32& = ptr.cast[heap f32&]
                return values[1] + value * values[0]

    def y(view: f32&?, value: f32) -> f32:
        can Abort.Panic, Unsafe.PointerCast:
            return 0.0.f32() if view == null
            trusted Unsafe.PointerCast:
                ptr: f32& = view
                values: heap f32& = ptr.cast[heap f32&]
                return values[3] - values[2] - value * values[0]

export fn nw_sdl_view_setup(view: mutable f32&?, width: i32, height: i32) = SDLGeometry::setup
export fn nw_sdl_view_x(view: f32&?, value: f32) -> f32 = SDLGeometry::x
export fn nw_sdl_view_y(view: f32&?, value: f32) -> f32 = SDLGeometry::y

extern SDL_SetRenderDrawColor(renderer: mutable void&, red: u8, green: u8, blue: u8, alpha: u8) -> bool
extern SDL_RenderLine(renderer: mutable void&, x1: f32, y1: f32, x2: f32, y2: f32) -> bool
extern SDL_cosf(value: f32) -> f32
extern SDL_sinf(value: f32) -> f32

extern SDL_SetRenderDrawColorFloat(renderer: mutable void&, red: f32, green: f32, blue: f32, alpha: f32) -> bool

def sdl_set_color(renderer: mutable void&?, rgba: u32):
    return if renderer == null
    target: mutable void& = renderer
    _ = SDL_SetRenderDrawColorFloat(target, (rgba >> 24).f32() / 255.0.f32(),
        ((rgba >> 16) & 255.u32()).f32() / 255.0.f32(),
        ((rgba >> 8) & 255.u32()).f32() / 255.0.f32(), (rgba & 255.u32()).f32() / 255.0.f32())

# Match Pyglet's segment count for the radius in framebuffer pixels.
def sdl_round_segments(radius_pixels: f32) -> i64:
    return 14 if radius_pixels < 17.5.f32()
    return 4096 if radius_pixels >= 5120.0.f32()
    return (radius_pixels / 1.25.f32()).i64()

def sdl_stroke_arc(renderer: mutable void&?, view: f32&?, cx: f32, cy: f32, radius: f32, start: f32, sweep: f32, color: u32):
    can Abort.Panic, Unsafe.PointerCast:
        return if renderer == null or view == null or radius <= 0.0.f32() or sweep == 0.0.f32()
        target: mutable void& = renderer
        viewport: f32& = view
        scale: f32 = viewport[0]
        return if scale <= 0.0.f32()
        segments: i64 = sdl_round_segments(radius * scale)
        radians: f32 = 3.14159265358979323846.f32() / 180.0.f32()
        step: f32 = sweep * radians / segments.f32()
        # Pyglet's default stroke is one framebuffer pixel. Radial offsets
        # give adjacent arc segments the same miter at their shared vertex.
        half_width: f32 = 0.5.f32() / (scale * SDL_cosf(step * 0.5.f32()))
        first_angle: f32 = start * radians
        for index in 0..<segments |index, target, viewport, cx, cy, radius, first_angle, step, half_width, color|:
            a: f32 = first_angle + step * index.f32()
            b: f32 = first_angle + step * (index + 1).f32()
            ax: f32 = SDL_cosf(a)
            ay: f32 = SDL_sinf(a)
            bx: f32 = SDL_cosf(b)
            by: f32 = SDL_sinf(b)
            sdl_stroke_quad(target, viewport, cx + ax * radius, cy + ay * radius,
                            cx + bx * radius, cy + by * radius,
                            ax * half_width, ay * half_width, bx * half_width, by * half_width, color)

export fn nw_sdl_set_color(renderer: mutable void&?, rgba: u32) = sdl_set_color
export fn nw_sdl_stroke_arc(renderer: mutable void&?, view: f32&?, cx: f32, cy: f32, radius: f32, start: f32, sweep: f32, color: u32) = sdl_stroke_arc

# SDL_Vertex is eight consecutive floats: position, RGBA and texture point.
extern SDL_RenderGeometry(renderer: mutable void&, texture: void&?, vertices: void&, vertex_count: i32, indices: i32&?, index_count: i32) -> bool

def sdl_vertex(dest: mutable f32&, index: i64, x: f32, y: f32, color: u32):
    can Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            values: mutable heap f32& = dest.cast[mutable heap f32&]
            at: usize = (index * 8).usize()
            values[at] <- x
            values[at + 1.usize()] <- y
            values[at + 2.usize()] <- ((color >> 24) & 255.u32()).f32() / 255.0.f32()
            values[at + 3.usize()] <- ((color >> 16) & 255.u32()).f32() / 255.0.f32()
            values[at + 4.usize()] <- ((color >> 8) & 255.u32()).f32() / 255.0.f32()
            values[at + 5.usize()] <- (color & 255.u32()).f32() / 255.0.f32()
            values[at + 6.usize()] <- 0.0.f32()
            values[at + 7.usize()] <- 0.0.f32()

def sdl_fill_triangle(renderer: mutable void&?, view: f32&?, x1: f32, y1: f32, x2: f32, y2: f32, x3: f32, y3: f32, color: u32):
    can Abort.Panic, Unsafe.PointerCast:
        return if renderer == null or view == null
        vertices: mutable f32[24] = zeroed
        sdl_vertex(&vertices[0], 0, SDLGeometry::x(view, x1), SDLGeometry::y(view, y1), color)
        sdl_vertex(&vertices[0], 1, SDLGeometry::x(view, x2), SDLGeometry::y(view, y2), color)
        sdl_vertex(&vertices[0], 2, SDLGeometry::x(view, x3), SDLGeometry::y(view, y3), color)
        target: mutable void& = renderer
        trusted Unsafe.PointerCast:
            _ = SDL_RenderGeometry(target, null, (&vertices[0]).cast[void&], 3.i32(), null, 0.i32())

extern SDL_sqrtf(value: f32) -> f32

def sdl_stroke_quad(renderer: mutable void&, view: f32&, x1: f32, y1: f32, x2: f32, y2: f32, nx1: f32, ny1: f32, nx2: f32, ny2: f32, color: u32):
    can Abort.Panic, Unsafe.PointerCast:
        vertices: mutable f32[32] = zeroed
        indices: i32[6] = [0, 1, 2, 0, 2, 3]
        sdl_vertex(&vertices[0], 0, SDLGeometry::x(view, x1 + nx1), SDLGeometry::y(view, y1 + ny1), color)
        sdl_vertex(&vertices[0], 1, SDLGeometry::x(view, x1 - nx1), SDLGeometry::y(view, y1 - ny1), color)
        sdl_vertex(&vertices[0], 2, SDLGeometry::x(view, x2 - nx2), SDLGeometry::y(view, y2 - ny2), color)
        sdl_vertex(&vertices[0], 3, SDLGeometry::x(view, x2 + nx2), SDLGeometry::y(view, y2 + ny2), color)
        trusted Unsafe.PointerCast:
            _ = SDL_RenderGeometry(renderer, null, (&vertices[0]).cast[void&], 4.i32(), (&indices[0]).uintptr().cast[i32&], 6.i32())

def sdl_stroke_segment(renderer: mutable void&, view: f32&, x1: f32, y1: f32, x2: f32, y2: f32, width: f32, color: u32):
    can Abort.Panic, Unsafe.PointerCast:
        return if width <= 0.0.f32()
        dx: f32 = x2 - x1
        dy: f32 = y2 - y1
        length: f32 = SDL_sqrtf(dx * dx + dy * dy)
        return if length <= 0.0.f32()
        half_width: f32 = width / (2.0.f32() * length)
        nx: f32 = -dy * half_width
        ny: f32 = dx * half_width
        sdl_stroke_quad(renderer, view, x1, y1, x2, y2, nx, ny, nx, ny, color)

def sdl_fill_circle(renderer: mutable void&?, view: f32&?, cx: f32, cy: f32, radius: f32, color: u32):
    can Abort.Panic, Unsafe.PointerCast:
        return if renderer == null or view == null or radius <= 0.0.f32()
        target: mutable void& = renderer
        viewport: f32& = view
        segments: i64 = sdl_round_segments(radius * viewport[0])
        vertices: mutable f32[400] = zeroed
        indices: mutable i32[144] = zeroed
        sdl_vertex(&vertices[0], 0, SDLGeometry::x(viewport, cx), SDLGeometry::y(viewport, cy), color)
        for index in 0..<48 |index, indices|:
            indices[(index * 3).usize()] <- 0
            indices[(index * 3 + 1).usize()] <- (index + 1).i32()
            indices[(index * 3 + 2).usize()] <- (index + 2).i32()
        first: mutable i64 = 0
        while first < segments |first, segments, vertices, indices, viewport, target, cx, cy, radius, color|:
            remaining: i64 = segments - first
            batch: i64 = 48 if remaining > 48 else remaining
            for index in 0..<(batch + 1) |index, first, segments, vertices, viewport, cx, cy, radius, color|:
                angle: f32 = ((first + index) % segments).f32() / segments.f32() * 6.283185307179586.f32()
                sdl_vertex(&vertices[0], index + 1, SDLGeometry::x(viewport, cx + SDL_cosf(angle) * radius), SDLGeometry::y(viewport, cy + SDL_sinf(angle) * radius), color)
            trusted Unsafe.PointerCast:
                _ = SDL_RenderGeometry(target, null, (&vertices[0]).cast[void&], (batch + 2).i32(), (&indices[0]).uintptr().cast[i32&], (batch * 3).i32())
            first <- first + batch

export fn nw_sdl_fill_triangle(renderer: mutable void&?, view: f32&?, x1: f32, y1: f32, x2: f32, y2: f32, x3: f32, y3: f32, color: u32) = sdl_fill_triangle
export fn nw_sdl_fill_circle(renderer: mutable void&?, view: f32&?, cx: f32, cy: f32, radius: f32, color: u32) = sdl_fill_circle

extern SDL_strlen(text: cstr) -> usize
extern SDL_utf8strlen(text: cstr) -> usize
extern SDL_SetRenderScale(renderer: mutable void&, x: f32, y: f32) -> bool
extern SDL_RenderDebugText(renderer: mutable void&, x: f32, y: f32, text: cstr) -> bool

extern SDL_StepUTF8(text: mutable usize&, remaining: mutable usize&?) -> u32

# SDL's debug font leaves these navigation glyphs blank. Draw the arrows
# in the same eight-pixel cells so the rest of the label stays aligned.
def sdl_draw_navigation_glyphs(renderer: mutable void&, text: cstr, x: f32, y: f32):
    can Abort.Panic, Unsafe.PointerCast:
        cursor: mutable usize = text.uintptr()
        column: mutable f32 = x
        trusted Unsafe.PointerCast:
            point: mutable usize& = (&cursor).uintptr().cast[mutable usize&]
            glyph: mutable u32 = SDL_StepUTF8(point, null)
            while glyph != 0.u32() |glyph, point, column, y, renderer|:
                if glyph >= 8592.u32() and glyph <= 8595.u32():
                    horizontal: bool = glyph == 8592.u32() or glyph == 8594.u32()
                    direction: f32 = -1.0.f32() if glyph == 8592.u32() or glyph == 8593.u32() else 1.0.f32()
                    dx: f32 = direction if horizontal else 0.0.f32()
                    dy: f32 = 0.0.f32() if horizontal else direction
                    cx: f32 = column + 3.5.f32()
                    cy: f32 = y + 3.5.f32()
                    tip_x: f32 = cx + dx * 3.0.f32()
                    tip_y: f32 = cy + dy * 3.0.f32()
                    _ = SDL_RenderLine(renderer, cx - dx * 3.0.f32(), cy - dy * 3.0.f32(), tip_x, tip_y)
                    _ = SDL_RenderLine(renderer, tip_x, tip_y, tip_x - dx * 2.0.f32() + dy * 2.0.f32(), tip_y - dy * 2.0.f32() + dx * 2.0.f32())
                    _ = SDL_RenderLine(renderer, tip_x, tip_y, tip_x - dx * 2.0.f32() - dy * 2.0.f32(), tip_y - dy * 2.0.f32() - dx * 2.0.f32())
                column <- column + 8.0.f32()
                glyph <- SDL_StepUTF8(point, null)

extern SDL_DestroyRenderer(renderer: mutable void&)
extern SDL_CreateSurface(width: i32, height: i32, format: u32) -> mutable void&? can[Memory.Allocate]
extern SDL_CreateSoftwareRenderer(surface: mutable void&) -> mutable void&? can[Memory.Allocate]
extern SDL_DestroySurface(surface: mutable void&) can[Memory.Release]
extern SDL_CreateTextureFromSurface(renderer: mutable void&, surface: mutable void&) -> mutable void&? can[Memory.Allocate]
extern SDL_DestroyTexture(texture: mutable void&) can[Memory.Release]
extern SDL_RenderTexture(renderer: mutable void&, texture: mutable void&, source: f32&?, destination: f32&) -> bool
extern SDL_SetTextureBlendMode(texture: mutable void&, mode: u32) -> bool

# SDL_ttf returns a rasterized surface and baseline metric through the host.
def sdl_draw_font_text(renderer: mutable void&, text: cstr, x: f32, y: f32, pixels: f32, color: u32, anchor: u8, bold: bool, angle: f64 = 0.0, face: i32 = 0.i32()) -> bool:
    can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        callback: mutable void&? = SDL_GetPointerProperty(SDL_GetRendererProperties(renderer), "nw.font.rasterize", null)
        return false if callback == null
        return true if SDL_strlen(text) == 0.usize()
        trusted Unsafe.PointerCast:
            address: mutable void& = callback
            rasterize: fn(mutable void&, usize, f32, u32, i32, usize) -> mutable void&? = address.uintptr().cast[fn(mutable void&, usize, f32, u32, i32, usize) -> mutable void&?]
            ascent: mutable f32 = 0.0.f32()
            surface: mutable void&? = rasterize(renderer, text.uintptr(), pixels, color, (face << 1.i32()) | (1.i32() if bold else 0.i32()), (&ascent).uintptr())
            return false if surface == null
            image: mutable void& = surface
            texture: mutable void&? = SDL_CreateTextureFromSurface(renderer, image)
            SDL_DestroySurface(image)
            return false if texture == null
            glyphs: mutable void& = texture
            width: mutable f32 = 0.0.f32()
            height: mutable f32 = 0.0.f32()
            drawn: mutable bool = false
            if SDL_GetTextureSize(glyphs, &width, &height):
                left: f32 = x - width * (anchor % 3.u8()).f32() * 0.5.f32()
                top: f32 = y - (ascent if anchor / 3.u8() == 0.u8() else (height * 0.5.f32() if anchor / 3.u8() == 1.u8() else 0.0.f32()))
                box: f32[4] = [left, top, width, height]
                bounds: f32& = (&box[0]).uintptr().cast[f32&]
                drawn <- SDL_RenderTexture(renderer, glyphs, null, bounds) if angle == 0.0 else (
                    SDL_RenderTextureRotated(renderer, glyphs, null, bounds, angle, null, 0.i32()))
            SDL_DestroyTexture(glyphs)
            return drawn

# A single faced character rotates about its centre even in the
# SDL-only build. Rasterize the built-in fallback into a transparent tile.
def sdl_draw_debug_glyph(renderer: mutable void&, text: cstr, x: f32, y: f32, pixels: f32, color: u32, angle: f64):
    can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        if SDL_CreateSurface(8.i32(), 8.i32(), 0x16762004.u32()) is surface:
            if SDL_CreateSoftwareRenderer(surface) is software:
                _ = SDL_SetRenderDrawColor(software, 0.u8(), 0.u8(), 0.u8(), 0.u8())
                _ = SDL_RenderClear(software)
                _ = SDL_SetRenderDrawColor(software, 255.u8(), 255.u8(), 255.u8(), 255.u8())
                if SDL_RenderDebugText(software, 0.0.f32(), 0.0.f32(), text) and SDL_RenderPresent(software):
                    if SDL_CreateTextureFromSurface(renderer, surface) is texture:
                        trusted Unsafe.PointerCast:
                            box: f32[4] = [x - pixels / 2.0.f32(), y - pixels / 2.0.f32(), pixels, pixels]
                            _ = SDL_SetTextureBlendMode(texture, 1.u32())
                            _ = SDL_SetTextureColorMod(texture, (color >> 24).u8(), (color >> 16).u8(), (color >> 8).u8())
                            _ = SDL_SetTextureAlphaMod(texture, color.u8())
                            _ = SDL_RenderTextureRotated(renderer, texture, null, (&box[0]).uintptr().cast[f32&], angle, null, 0.i32())
                        SDL_DestroyTexture(texture)
                SDL_DestroyRenderer(software)
            SDL_DestroySurface(surface)

def sdl_draw_faced_text(renderer: mutable void&, view: f32&, frame: NativeDisplayDecode::Frame&, cmd: heap Command&):
    can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        pointer: mutable usize = 0.usize()
        trusted Unsafe.PointerCast:
            return if native_display_text(frame, cmd.cast[u8&], &pointer) != 1.u32() or pointer == 0.usize()
            source: heap u8& = pointer.cast[heap u8&]
            text: u8[2] = [source[0], 0.u8()]
            string: cstr = (&text[0]).cast[cstr]
            x: f32 = SDLGeometry::x(view, cmd.a)
            y: f32 = SDLGeometry::y(view, cmd.b)
            pixels: f32 = cmd.c * view[0]
            capped: f32 = 200.0.f32() if pixels > 200.0.f32() else pixels
            return if capped <= 0.0.f32()
            return if sdl_draw_font_text(renderer, string, x, y, capped, cmd.color, 4.u8(), false, cmd.e.f64(), cmd.f.i32())
            sdl_draw_debug_glyph(renderer, string, x, y, capped, cmd.color, cmd.e.f64())

def sdl_draw_text_weighted(renderer: mutable void&?, view: f32&?, text: u8&?, x: f32, y: f32, size: f32, color: u32, anchor: u8, bold: bool):
    can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return if renderer == null or view == null or text == null
        trusted Unsafe.PointerCast:
            target: mutable void& = renderer
            view_ptr: f32& = view
            values: heap f32& = view_ptr.cast[heap f32&]
            chars: u8& = text
            string: cstr = chars.cast[cstr]
            pixels: f32 = size * values[0]
            capped: f32 = 200.0.f32() if pixels > 200.0.f32() else pixels
            return if capped <= 0.0.f32()
            return if sdl_draw_font_text(target, string, SDLGeometry::x(view, x), SDLGeometry::y(view, y), capped, color, anchor, bold)
            scale: f32 = capped / 8.0.f32()
            width: f32 = SDL_utf8strlen(string).f32() * 8.0.f32() * scale
            height: f32 = 8.0.f32() * scale
            sx: mutable f32 = SDLGeometry::x(view, x)
            sy: mutable f32 = SDLGeometry::y(view, y)
            if anchor % 3.u8() == 1.u8():
                sx <- sx - width * 0.5.f32()
            elif anchor % 3.u8() == 2.u8():
                sx <- sx - width
            if anchor / 3.u8() == 0.u8():
                sy <- sy - height
            elif anchor / 3.u8() == 1.u8():
                sy <- sy - height * 0.5.f32()
            sdl_set_color(target, color)
            _ = SDL_SetRenderScale(target, scale, scale)
            _ = SDL_RenderDebugText(target, sx / scale, sy / scale, string)
            sdl_draw_navigation_glyphs(target, string, sx / scale, sy / scale)
            if bold:
                _ = SDL_RenderDebugText(target, (sx + scale) / scale, sy / scale, string)
            _ = SDL_SetRenderScale(target, 1.0.f32(), 1.0.f32())

def sdl_draw_text(renderer: mutable void&?, view: f32&?, text: u8&?, x: f32, y: f32, size: f32, color: u32, anchor: u8):
    can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        sdl_draw_text_weighted(renderer, view, text, x, y, size, color, anchor, false)

export fn nw_sdl_draw_text(renderer: mutable void&?, view: f32&?, text: u8&?, x: f32, y: f32, size: f32, color: u32, anchor: u8) = sdl_draw_text

extern SDL_malloc(size: usize) -> mutable heap void&? can[Memory.Allocate]

def sdl_draw_multiline_weighted(renderer: mutable void&?, view: f32&?, frame: NativeDisplayDecode::Frame&?, command: u8&?, x: f32, y: f32, size: f32, color: u32, anchor: u8, bold: bool):
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return if renderer == null or view == null or frame == null or command == null
        pointer: mutable usize = 0.usize()
        length: usize = native_display_text(frame, command, &pointer).usize()
        return if pointer == 0.usize()
        memory: mutable heap void&? = SDL_malloc(length + 1.usize())
        if memory == null:
            SDL_Log("Could not allocate text rendering buffer")
            return
        trusted Unsafe.PointerCast:
            view_ptr: f32& = view
            scales: heap f32& = view_ptr.cast[heap f32&]
            viewport_scale: f32 = scales[0]
            if viewport_scale <= 0.0.f32():
                allocation: mutable heap void& = memory
                SDL_free(allocation.cast[heap void&])
                return
            line_size: f32 = 200.0.f32() / viewport_scale if size * viewport_scale > 200.0.f32() else size
            allocation: mutable heap void& = memory
            buffer: mutable heap u8& = allocation.cast[mutable heap u8&]
            source: heap u8& = pointer.cast[heap u8&]
            index: mutable usize = 0.usize()
            rows: mutable i64 = 1
            while index < length |index, length, buffer, source, rows|:
                buffer[index] <- source[index]
                rows <- rows + 1 if buffer[index] == 10.u8()
                index <- index + 1.usize()
            buffer[length] <- 0.u8()
            index <- 0.usize()
            row: mutable i64 = 0
            line_start: mutable usize = 0.usize()
            while index <= length |index, length, buffer, rows, row, line_start, renderer, view, x, y, line_size, color, anchor, bold|:
                if buffer[index] == 10.u8() or buffer[index] == 0.u8():
                    buffer[index] <- 0.u8()
                    line_y: f32 = y + ((rows - 1).f32() * 0.5.f32() - row.f32()) * line_size * 1.25.f32()
                    line: u8& = (&buffer[line_start]).cast[u8&]
                    sdl_draw_text_weighted(renderer, view, line, x, line_y, line_size, color, anchor, bold)
                    line_start <- index + 1.usize()
                    row <- row + 1
                index <- index + 1.usize()
            SDL_free(allocation.cast[heap void&])

def sdl_draw_multiline(renderer: mutable void&?, view: f32&?, frame: NativeDisplayDecode::Frame&?, command: u8&?, x: f32, y: f32, size: f32, color: u32, anchor: u8):
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        sdl_draw_multiline_weighted(renderer, view, frame, command, x, y, size, color, anchor, false)

export fn nw_sdl_draw_multiline(renderer: mutable void&?, view: f32&?, frame: NativeDisplayDecode::Frame&?, command: u8&?, x: f32, y: f32, size: f32, color: u32, anchor: u8) = sdl_draw_multiline

def sdl_rotated_rect(renderer: mutable void&?, view: f32&?, x: f32, y: f32, width: f32, height: f32, anchor_x: f32, anchor_y: f32, angle: f32, color: u32):
    can Abort.Panic, Unsafe.PointerCast:
        radians: f32 = angle * 3.14159265358979323846.f32() / 180.0.f32()
        cosine: f32 = SDL_cosf(radians)
        sine: f32 = SDL_sinf(radians)
        xs: mutable f32[4] = zeroed
        ys: mutable f32[4] = zeroed
        index: mutable i64 = 0
        while index < 4 |index, xs, ys, x, y, width, height, anchor_x, anchor_y, cosine, sine|:
            local_x: f32 = -anchor_x if index == 0 or index == 3 else width - anchor_x
            local_y: f32 = -anchor_y if index < 2 else height - anchor_y
            xs[index.usize()] <- x + local_x * cosine + local_y * sine
            ys[index.usize()] <- y - local_x * sine + local_y * cosine
            index <- index + 1
        sdl_fill_triangle(renderer, view, xs[0], ys[0], xs[1], ys[1], xs[2], ys[2], color)
        sdl_fill_triangle(renderer, view, xs[0], ys[0], xs[2], ys[2], xs[3], ys[3], color)

def sdl_star(renderer: mutable void&?, view: f32&?, x: f32, y: f32, outer: f32, inner: f32, spikes: i32, rotation: f32, color: u32):
    can Abort.Panic, Unsafe.PointerCast:
        return if spikes < 2.i32()
        base: f32 = rotation * 3.14159265358979323846.f32() / 180.0.f32()
        step: f32 = 3.14159265358979323846.f32() / spikes.f32()
        previous_x: mutable f32 = 0.0.f32()
        previous_y: mutable f32 = 0.0.f32()
        index: mutable i64 = 0
        while index <= spikes.i64() * 2 |index, spikes, base, step, x, y, outer, inner, renderer, view, color, previous_x, previous_y|:
            radius: f32 = outer if index % 2 == 0 else inner
            angle: f32 = base + index.f32() * step
            next_x: f32 = x + radius * SDL_sinf(angle)
            next_y: f32 = y + radius * SDL_cosf(angle)
            if index > 0:
                sdl_fill_triangle(renderer, view, x, y, previous_x, previous_y, next_x, next_y, color)
            previous_x <- next_x
            previous_y <- next_y
            index <- index + 1

export fn nw_sdl_rotated_rect(renderer: mutable void&?, view: f32&?, x: f32, y: f32, width: f32, height: f32, anchor_x: f32, anchor_y: f32, angle: f32, color: u32) = sdl_rotated_rect
export fn nw_sdl_star(renderer: mutable void&?, view: f32&?, x: f32, y: f32, outer: f32, inner: f32, spikes: i32, rotation: f32, color: u32) = sdl_star
