# Numberology's three persisted options, shared with the Python shell.
module NumberologySettings:
    def path(out: i64, capacity: i64, create: bool) -> i64:
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                if getenv("NW_NUMBEROLOGY_SETTINGS_PATH") is override:
                    if override != 0.u8():
                        return SyllogismOptionsHost::settings_override(out, capacity, override.cast[cstr], create)
                named: i64 = sdl_named_task_settings_path(out, capacity, "/numberology-options", create)
                return named if named != -2
                selected: i64 = SyllogismOptionsHost::data_settings_path(out, capacity, "/numberology-options", create)
                return selected if selected != -2
                platform: heap u8& = SDL_GetPlatform().cast[heap u8&]
                windows: bool = platform[0] == 87.u8() and platform[1] == 105.u8() and platform[2] == 110.u8()
                base: mutable i64 = 0
                if windows:
                    if getenv("APPDATA") is found:
                        base <- found.uintptr().i64() if found != 0.u8()
                    if base == 0:
                        if getenv("USERPROFILE") is found:
                            base <- found.uintptr().i64() if found != 0.u8()
                else:
                    if getenv("HOME") is found:
                        base <- found.uintptr().i64() if found != 0.u8()
                return -1 if base == 0
                end: mutable i64 = SyllogismOptionsHost::append(out, capacity, 0, base.uintptr().cast[cstr])
                return -1 if end < 0
                end <- SyllogismOptionsHost::append(out, capacity, end, "/Neural Workshop" if windows else "/.neural-workshop")
                return -1 if end < 0
                return -1 if create and not SDL_CreateDirectory(out.uintptr().cast[cstr])
                return SyllogismOptionsHost::append(out, capacity, end, "/numberology-options")

    def decode(data: i64, length: i64, output: mutable i64&?) -> i32:
        can Abort.Panic, Unsafe.PointerCast:
            return 0 if data == 0 or length <= 0 or length > 255 or output == null
            values: mutable i64[3] = zeroed
            at: mutable i64 = 0
            trusted Unsafe.PointerCast:
                bytes: heap u8& = data.uintptr().cast[heap u8&]
                for row in 0..<3 |row, values, at, length, bytes|:
                    value: i64 = SyllogismOptions::saved_integer(bytes, length, &at)
                    return 0 if value < 0
                    values[row.usize()] <- value
                while at < length and SyllogismOptions::whitespace(bytes[at.usize()].i64()) |at, length, bytes|:
                    at <- at + 1
                return 0 if at != length or values[0] < 1 or not SyllogismOptions::allowed(1, values[1]) or not SyllogismOptions::allowed(2, values[2])
                destination: mutable i64& = output
                result: mutable heap i64& = destination.cast[mutable heap i64&]
                result[0] <- values[0]
                result[1] <- values[1]
                result[3] <- values[2]
                return 1

    def read(output: mutable i64&?):
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            return if output == null
            path_buffer: mutable u8[4096] = zeroed
            data: mutable u8[256] = zeroed
            trusted Unsafe.PointerCast:
                address: i64 = (&path_buffer[0]).uintptr().i64()
                return if path(address, 4096, false) < 0
                file: mutable void&? = SDL_IOFromFile(address.uintptr().cast[cstr], "rb")
                return if file == null
                stream: mutable void& = file
                length: usize = SDL_ReadIO(stream, (&data[0]).cast[mutable void&], 256.usize())
                status: i32 = SDL_GetIOStatus(stream)
                closed: bool = SDL_CloseIO(stream)
                return if not closed or status != 2.i32() or length > 255.usize()
                _ = decode((&data[0]).uintptr().i64(), length.i64(), output)

    def write(output: i64&?) -> i32:
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            return 0 if output == null
            path_buffer: mutable u8[4096] = zeroed
            temporary: mutable u8[4200] = zeroed
            data: mutable u8[128] = zeroed
            trusted Unsafe.PointerCast:
                pointer: i64& = output
                values: heap i64& = pointer.cast[heap i64&]
                return 0 if values[0] < 1 or not SyllogismOptions::allowed(1, values[1]) or not SyllogismOptions::allowed(2, values[3])
                path_address: i64 = (&path_buffer[0]).uintptr().i64()
                temp_address: i64 = (&temporary[0]).uintptr().i64()
                return 0 if path(path_address, 4096, true) < 0
                return 0 if SyllogismOptionsHost::temporary(temp_address, 4200, path_address) < 0
                length: i32 = SDL_snprintf(&data[0], 128.usize(), "%lld %lld %lld\n", values[0], values[1], values[3])
                return 0 if length <= 0.i32() or length >= 128.i32()
                return numberology_results_write(&temporary[0], &path_buffer[0], &data[0], length.usize())

export fn nw_numberology_settings_read(output: mutable i64&?) = NumberologySettings::read
export fn nw_numberology_settings_write(output: i64&?) -> i32 = NumberologySettings::write
export fn nw_numberology_settings_decode(data: i64, length: i64, output: mutable i64&?) -> i32 = NumberologySettings::decode

def numberology_positive_argument(address: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        value: i64 = SyllogismOptions::nonnegative_argument(address, syllogism_argument_length(address))
        return value if value > 0 else -1


def numberology_options_parse(argc: i64, argv: usize&?, output: mutable i64&?, lexicon: mutable usize&?, saved: i64, ini: usize = 0.usize()) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 2 if argc < 1 or argv == null or output == null or lexicon == null
        trusted Unsafe.PointerCast:
            args_pointer: usize& = argv
            args: heap usize& = args_pointer.cast[heap usize&]
            pointer: mutable i64& = output
            values: mutable heap i64& = pointer.cast[mutable heap i64&]
            path: mutable usize& = lexicon
            values[0] <- 1
            values[1] <- 6
            values[2] <- 0
            values[3] <- 1
            path[0] <- 0.usize()
            sdl_apply_task_ini_defaults(values, ini, 4)
            NumberologySettings::read(output) if saved != 0
            at: mutable i64 = 1
            while at < argc |at, argc, args, values|:
                name: i64 = args[at.usize()].i64()
                if syllogism_argument_is(name, "--numberology-no-adaptive"):
                    values[3] <- 0
                elif syllogism_argument_is(name, "--numberology-level") or syllogism_argument_is(name, "--numberology-trials"):
                    row: i64 = 0 if syllogism_argument_is(name, "--numberology-level") else 1
                    at <- at + 1
                    if at >= argc:
                        SDL_Log("Numberology option requires a value")
                        return 2
                    parsed: i64 = numberology_positive_argument(args[at.usize()].i64())
                    if parsed < 1 or (row == 1 and not SyllogismOptions::allowed(1, parsed)):
                        SDL_Log("Invalid Numberology option value")
                        return 2
                    values[row.usize()] <- parsed
                at <- at + 1
            return 0

def numberology_options_parse_legacy(argc: i64, argv: usize&?, output: mutable i64&?, lexicon: mutable usize&?, saved: i64) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return numberology_options_parse(argc, argv, output, lexicon, saved)

export fn nw_numberology_options_parse(argc: i64, argv: usize&?, output: mutable i64&?, lexicon: mutable usize&?, saved: i64) -> i32 = numberology_options_parse_legacy

def numberology_edit_digit(output: mutable i64&?, editing: mutable u8&?, value: mutable i64&?, digit: i32):
    can Abort.Panic, Unsafe.PointerCast:
        return if output == null or editing == null or value == null or digit < 0.i32() or digit > 9.i32()
        trusted Unsafe.PointerCast:
            options_ptr: mutable i64& = output
            options: mutable heap i64& = options_ptr.cast[mutable heap i64&]
            flag: mutable u8& = editing
            edit: mutable i64& = value
            current: i64 = edit[0] if flag[0] != 0.u8() else 0
            return if current > (9223372036854775807 - digit.i64()) / 10
            edit[0] <- current * 10 + digit.i64()
            options[0] <- edit[0] if edit[0] > 0 else 1
            flag[0] <- 1.u8()

def numberology_edit_backspace(output: mutable i64&?, editing: mutable u8&?, value: mutable i64&?):
    can Abort.Panic, Unsafe.PointerCast:
        return if output == null or editing == null or value == null
        trusted Unsafe.PointerCast:
            options_ptr: mutable i64& = output
            options: mutable heap i64& = options_ptr.cast[mutable heap i64&]
            flag: mutable u8& = editing
            edit: mutable i64& = value
            current: i64 = edit[0] if flag[0] != 0.u8() else options[0]
            edit[0] <- current / 10
            options[0] <- edit[0] if edit[0] > 0 else 1
            flag[0] <- 1.u8()

def numberology_edit_text(output: mutable i64&?, editing: mutable u8&?, value: mutable i64&?, text: u8&?):
    can Abort.Panic, Unsafe.PointerCast:
        return if output == null or editing == null or value == null or text == null
        trusted Unsafe.PointerCast:
            input: u8& = text
            bytes: heap u8& = input.cast[heap u8&]
            at: mutable i64 = 0
            while bytes[at.usize()] != 0.u8() |at, bytes, output, editing, value|:
                byte: i64 = bytes[at.usize()].i64()
                if byte >= 48 and byte <= 57:
                    numberology_edit_digit(output, editing, value, (byte - 48).i32())
                at <- at + 1

def numberology_modify_option(output: mutable i64&?, selected: i64, step: i64):
    can Abort.Panic, Unsafe.PointerCast:
        return if output == null or selected < 0 or selected > 2
        trusted Unsafe.PointerCast:
            pointer: mutable i64& = output
            options: mutable heap i64& = pointer.cast[mutable heap i64&]
            if selected == 0:
                options[0] <- options[0] - 1 if step < 0 and options[0] > 1
                options[0] <- options[0] + 1 if step > 0 and options[0] < 9223372036854775807
            elif selected == 1:
                options[1] <- SyllogismOptions::cycle(1, options[1], step)
            else:
                options[3] <- 1 if options[3] == 0 else 0

export fn nw_numberology_edit_digit(output: mutable i64&?, editing: mutable u8&?, value: mutable i64&?, digit: i32) = numberology_edit_digit
export fn nw_numberology_edit_backspace(output: mutable i64&?, editing: mutable u8&?, value: mutable i64&?) = numberology_edit_backspace
export fn nw_numberology_edit_text(output: mutable i64&?, editing: mutable u8&?, value: mutable i64&?, text: u8&?) = numberology_edit_text
export fn nw_numberology_modify_option(output: mutable i64&?, selected: i64, step: i64) = numberology_modify_option
