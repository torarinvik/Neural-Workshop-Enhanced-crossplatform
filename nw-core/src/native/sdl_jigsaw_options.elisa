def sdl_jigsaw_option_label(row: i64) -> cstr:
    return "Pieces" if row == 0
    return "Puzzles per run" if row == 1
    return "Adaptive grid" if row == 2
    return "Show finished picture" if row == 3
    return "Outline placed tiles"

def sdl_jigsaw_option_change(row: i64, current: i64, direction: i64) -> i64:
    can Abort.Panic:
        return 1 - current if row >= 2
        pieces: i64[18] = [2, 4, 6, 9, 12, 16, 25, 36, 49, 64, 100, 144, 225, 400, 625, 900, 1600, 2500]
        puzzles: i64[7] = [1, 2, 3, 5, 8, 12, 20]
        count: i64 = 18 if row == 0 else 7
        start: i64 = 0 if direction > 0 else count - 1
        for at in 0..<count |at, count, row, current, direction, pieces, puzzles|:
            index: i64 = at if direction > 0 else count - 1 - at
            candidate: i64 = pieces[index.usize()] if row == 0 else puzzles[index.usize()]
            return candidate if (candidate - current) * direction > 0
        return pieces[start.usize()] if row == 0 else puzzles[start.usize()]

def sdl_read_jigsaw_options(output: mutable i64&, video: bool = false):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: mutable u8[4096] = zeroed
        data: mutable u8[128] = zeroed
        trusted Unsafe.PointerCast:
            target: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
            return if not sdl_task_profile_sidecar(target, ".video-jigsaw-options" if video else ".jigsaw-options")
            if SDL_IOFromFile(target.cast[cstr], "rb") is stream:
                raw: heap u8& = (&data[0]).uintptr().cast[heap u8&]
                length: usize = SDL_ReadIO(stream, (&data[0]).cast[mutable void&], 128.usize())
                status: i32 = SDL_GetIOStatus(stream)
                closed: bool = SDL_CloseIO(stream)
                return if not closed or status != 2.i32() or length == 0.usize() or length >= 128.usize()
                values: mutable i64[5] = zeroed
                at: mutable i64 = 0
                for row in 0..<5 |row, values, at, raw, length|:
                    values[row.usize()] <- SyllogismOptions::saved_integer(raw, length.i64(), &at)
                while at < length.i64() and SyllogismOptions::whitespace(raw[at.usize()].i64()) |at, raw, length|:
                    at <- at + 1
                return if at != length.i64()
                pieces: i64 = values[0]
                return if not Jigsaw::allowed_pieces(pieces)
                return if not JigsawGame::allowed_puzzles(values[1])
                return if not JigsawGame::allowed_flag(values[2]) or not JigsawGame::allowed_flag(values[3]) or not JigsawGame::allowed_flag(values[4])
                output[4] <- Jigsaw::PIECE_OPTION_BASE + Jigsaw::bounded_pieces(pieces, video)
                for row in 1..<5 |row, output, values|:
                    output[(4 + row).usize()] <- values[row.usize()]

def sdl_save_jigsaw_options(draft: i64&, video: bool = false) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        data: mutable u8[128] = zeroed
        length: i32 = SDL_snprintf(&data[0], 128.usize(), "%lld %lld %lld %lld %lld\n",
            draft[0], draft[1], draft[2], draft[3], draft[4])
        return length > 0.i32() and length < 128.i32() and sdl_save_profile_sidecar(".video-jigsaw-options" if video else ".jigsaw-options", &data[0], length.usize())

# Return 2 when an options menu opened from the hub closes.
def sdl_jigsaw_options_key(handle: i64, key: i64, tasks: usize, from_hub: bool = false) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap JigsawGame::JigsawRun& = handle.uintptr().cast[mutable heap JigsawGame::JigsawRun&]
            draft: mutable i64& = (&run.options_draft[0]).uintptr().cast[mutable i64&]
            if run.options_row < 0:
                return 0 if key != 99 or (run.phase != JigsawGame::PHASE_READY and run.phase != JigsawGame::PHASE_DONE)
                draft[0] <- run.start_pieces if run.start_pieces > 0 else run.start_side * run.start_side
                draft[1] <- run.total_puzzles
                draft[2] <- 1 if run.adaptive else 0
                draft[3] <- 1 if run.preview else 0
                draft[4] <- 1 if run.mark_placed else 0
                run.options_from_hub <- from_hub
                run.options_row <- 0
                return 1
            if SDLTaskKeys::enter(key) or key == 27:
                if SDLTaskKeys::enter(key):
                    run.start_pieces <- draft[0]
                    run.pieces <- draft[0]
                    run.start_side <- Jigsaw::piece_columns(draft[0], run.video)
                    run.side <- run.start_side
                    run.trial_side <- run.start_side
                    run.trial_rows <- Jigsaw::piece_rows(draft[0], run.trial_side, run.video)
                    run.total_puzzles <- draft[1]
                    run.adaptive <- draft[2] != 0
                    run.preview <- draft[3] != 0
                    run.mark_placed <- draft[4] != 0
                    run.phase <- JigsawGame::PHASE_READY
                    run.puzzle <- 0
                    run.result_count <- 0
                    run.picked <- -1
                    run.cursor <- 0
                    run.hovered <- -1
                    for tile in 0..<(run.trial_side * run.trial_rows) |tile, run|:
                        run.order[tile.usize()] <- 0
                        run.seen[tile.usize()] <- 0
                    if tasks != 0.usize() and not sdl_save_jigsaw_options(draft, run.video):
                        SDL_Log("Could not save Jigsaw options")
                    if tasks != 0.usize() and not run.video:
                        selected: mutable i64& = tasks.cast[mutable i64&]
                        selected[4] <- Jigsaw::PIECE_OPTION_BASE + draft[0]
                        for row in 1..<5 |row, selected, draft|:
                            selected[(4 + row).usize()] <- draft[row.usize()]
                run.options_row <- -1
                return 2 if run.options_from_hub else 1
            run.options_row <- SDLTaskKeys::option_row(key, run.options_row, 5)
            if key == SDLTaskKeys::LEFT or key == SDLTaskKeys::RIGHT or key == 32:
                row: i64 = run.options_row
                draft[row.usize()] <- sdl_jigsaw_option_change(row, draft[row.usize()], -1 if key == SDLTaskKeys::LEFT else 1)
            return 1

