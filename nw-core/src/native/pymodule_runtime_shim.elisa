# Optional no-callback/no-profiler fallback for legacy Python module links.
# The current build links the selected full runtime; this object is retained
# only for hosts that intentionally decline the optional callback hooks.

def profile_negotiate(requested_version: u32) -> u32:
    _ = requested_version
    return 0.u32()

def profile_layout(arena: usize, region: usize, header: usize, data: usize, capacity: usize):
    _ = arena
    _ = region
    _ = header
    _ = data
    _ = capacity

def profile_event(kind: u32, address: usize, size: usize, old_address: usize, old_size: usize, arena: usize, region: usize):
    _ = kind
    _ = address
    _ = size
    _ = old_address
    _ = old_size
    _ = arena
    _ = region

def callback_pointer(name: u8&?) -> void&?:
    _ = name
    return null

def callback_u32(name: u8&?, arg: void&?, fallback: u32) -> u32:
    _ = name
    _ = arg
    return fallback

def callback_i32(name: u8&?, arg: void&?, fallback: i32) -> i32:
    _ = name
    _ = arg
    return fallback

def callback_usize(name: u8&?, arg: void&?, fallback: usize) -> usize:
    _ = name
    _ = arg
    return fallback

def callback_isize(name: u8&?, arg: void&?, fallback: isize) -> isize:
    _ = name
    _ = arg
    return fallback

def callback_context_new(name: u8&?, arg: void&?, fallback: u32) -> void&?:
    _ = name
    _ = arg
    _ = fallback
    return null

def callback_context_entry() -> void&?:
    return null

def callback_context_start(context: void&?, thread: mutable usize&?) -> i32:
    _ = context
    _ = thread
    return -1

def callback_context_join(handle: usize, context: void&?, fallback: u32) -> u32:
    _ = handle
    _ = context
    return fallback

def callback_context_fallback(context: void&?, fallback: u32) -> u32:
    _ = context
    return fallback

def callback_context_free(context: void&?):
    _ = context

def legacy_va_copy(destination: void&?, source: void&?):
    _ = destination
    _ = source

def legacy_va_end(argument: void&?):
    _ = argument

export fn elisa_profile_allocation_negotiate(requested_version: u32) -> u32 = profile_negotiate
export fn elisa_profile_region_layout_negotiate(requested_version: u32) -> u32 = profile_negotiate
export fn elisa_profile_region_layout_v1(arena: usize, region: usize, header: usize, data: usize, capacity: usize) = profile_layout
export fn elisa_profile_allocation_event_v1(kind: u32, address: usize, size: usize, old_address: usize, old_size: usize, arena: usize, region: usize) = profile_event
export fn elisa_native_callback_ptr(name: u8&?) -> void&? = callback_pointer
export fn elisa_native_callback_call_u32_voidp(name: u8&?, arg: void&?, fallback: u32) -> u32 = callback_u32
export fn elisa_native_callback_call_i32_voidp(name: u8&?, arg: void&?, fallback: i32) -> i32 = callback_i32
export fn elisa_native_callback_call_usize_voidp(name: u8&?, arg: void&?, fallback: usize) -> usize = callback_usize
export fn elisa_native_callback_call_isize_voidp(name: u8&?, arg: void&?, fallback: isize) -> isize = callback_isize
export fn elisa_native_callback_spawn_join_u32_voidp(name: u8&?, arg: void&?, fallback: u32) -> u32 = callback_u32
export fn elisa_native_callback_context_new_u32_voidp(name: u8&?, arg: void&?, fallback: u32) -> void&? = callback_context_new
export fn elisa_native_callback_context_entry_u32_voidp() -> void&? = callback_context_entry
export fn elisa_native_callback_context_start_u32_voidp(context: void&?, thread: mutable usize&?) -> i32 = callback_context_start
export fn elisa_native_callback_context_join_u32_voidp(handle: usize, context: void&?, fallback: u32) -> u32 = callback_context_join
export fn elisa_native_callback_context_spawn_join_u32_voidp(context: void&?, fallback: u32) -> u32 = callback_context_fallback
export fn elisa_native_callback_context_result_u32(context: void&?, fallback: u32) -> u32 = callback_context_fallback
export fn elisa_native_callback_context_free(context: void&?) = callback_context_free
export fn va_copy(destination: void&?, source: void&?) = legacy_va_copy
export fn va_end(argument: void&?) = legacy_va_end
