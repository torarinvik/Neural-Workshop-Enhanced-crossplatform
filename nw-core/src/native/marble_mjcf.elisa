# Model description used by the desktop MuJoCo integration.
module MarbleMJCF:
    def build(tray: MarbleMaze::MarbleTray&) -> dstr:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            out: mutable dstr = []
            return out if not tray.built or tray.start_n < 1 or tray.start_n > 8
            dstr_append_cstr(&out, "<mujoco><option integrator=\"implicitfast\" cone=\"elliptic\" noslip_iterations=\"2\" timestep=\"0.004\" gravity=\"0 0 -9.80665\"/>")
            buffer: mutable u8[384] = zeroed
            trusted Unsafe.PointerCast:
                width: f64 = tray.width.f32().f64()
                depth: f64 = tray.depth.f32().f64()
                half_height: f64 = tray.height.f32().f64() / 2.0
                _ = SDL_snprintf(&buffer[0], 384.usize(), "<worldbody><geom name=\"floor\" type=\"plane\" size=\"%.4f %.4f 0.1\" friction=\"0.500 0.0050 0.000060\" condim=\"6\" contype=\"1\" conaffinity=\"1\"/>", (width if width > 1.0 else 1.0) * 2.0, (depth if depth > 1.0 else 1.0) * 2.0)
                dstr_append_cstr(&out, (&buffer[0]).uintptr().cast[cstr])
                for index in 0..<tray.walls.count |index, tray, half_height, buffer, out|:
                    x0: f64 = Floats::at(tray.walls.x0, index).f32().f64()
                    y0: f64 = Floats::at(tray.walls.y0, index).f32().f64()
                    x1: f64 = Floats::at(tray.walls.x1, index).f32().f64()
                    y1: f64 = Floats::at(tray.walls.y1, index).f32().f64()
                    half_width: f64 = (x1 - x0) / 2.0
                    half_depth: f64 = (y1 - y0) / 2.0
                    _ = SDL_snprintf(&buffer[0], 384.usize(), "<geom name=\"wall%lld\" type=\"box\" pos=\"%.6f %.6f %.6f\" size=\"%.6f %.6f %.6f\" contype=\"0\" conaffinity=\"0\"/>", index, (x0 + x1) / 2.0, (y0 + y1) / 2.0, half_height, half_width if half_width > 0.0001 else 0.0001, half_depth if half_depth > 0.0001 else 0.0001, half_height)
                    dstr_append_cstr(&out, (&buffer[0]).uintptr().cast[cstr])
                for ball in 0..<tray.start_n |ball, tray, buffer, out|:
                    x: f64 = Floats::at(tray.start_x, ball).f32().f64()
                    y: f64 = Floats::at(tray.start_y, ball).f32().f64()
                    _ = SDL_snprintf(&buffer[0], 384.usize(), "<body name=\"ball%lld\" pos=\"%.6f %.6f 0.007500\"><freejoint/><geom name=\"ball%lld\" type=\"sphere\" size=\"0.0075\" density=\"7800\" friction=\"0.500 0.0050 0.000060\" condim=\"3\" contype=\"1\" conaffinity=\"1\"/></body>", ball, x, y, ball)
                    dstr_append_cstr(&out, (&buffer[0]).uintptr().cast[cstr])
                dstr_append_cstr(&out, "</worldbody><contact>")
                for ball in 0..<tray.start_n |ball, tray, buffer, out|:
                    for wall in 0..<tray.walls.count |wall, ball, buffer, out|:
                        _ = SDL_snprintf(&buffer[0], 384.usize(), "<pair geom1=\"ball%lld\" geom2=\"wall%lld\" condim=\"3\" solref=\"0.009 1.0\" friction=\"0.080 0.080 0.0001 0.0001 0.0001\"/>", ball, wall)
                        dstr_append_cstr(&out, (&buffer[0]).uintptr().cast[cstr])
                    for other in (ball + 1)..<tray.start_n |other, ball, buffer, out|:
                        _ = SDL_snprintf(&buffer[0], 384.usize(), "<pair geom1=\"ball%lld\" geom2=\"ball%lld\" condim=\"3\" solref=\"0.009 0.03\" friction=\"0.05 0.05 0.0001 0.0001 0.0001\"/>", ball, other)
                        dstr_append_cstr(&out, (&buffer[0]).uintptr().cast[cstr])
            dstr_append_cstr(&out, "</contact></mujoco>")
            return out

    def write(dest: i64, capacity: i64, rung: i64, seed: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            return 0 if dest <= 0 or capacity <= 0 or rung < 1 or rung > 16
            work: mutable MarbleMaze::MarbleWork = MarbleMaze::MarbleWork()
            tray: mutable MarbleMaze::MarbleTray = MarbleMaze::MarbleTray()
            MarbleMaze::deal(rung, seed, 24, &work, &tray)
            xml: dstr = build(&tray)
            length: i64 = xml.count.i64()
            return 0 if length <= 0 or length > capacity
            trusted Unsafe.PointerCast:
                memcpy(dest.uintptr().cast[mutable void&], (&xml[0]).cast[void&], length.usize())
            return length
