include "./sdl_desktop_bindings.elisa"
include "./sdl_desktop_features.elisa"
include "./sdl_desktop_marble_feature.elisa"
include "./sdl_desktop_camera_feature.elisa"

extern nw_sdl_desktop_main(argc: i32, argv: usize&, bindings: SDLDesktopBindings&) -> i32 can[Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write]
extern SDL_PollEvent(event: mutable void&?) -> bool
extern nw_sdl_window_pointer(window: mutable void&?, rows: usize&?, special: usize&?, motion: i64, button: i64, x: f32, y: f32, buttons: u32) -> i32
extern nw_sdl_close_desktop(state: mutable usize&, surface: usize, rows: usize&, syllogism: mutable usize&, numberology: mutable usize&, marble_close: usize, marble_state: usize, physics: usize)

def main(argc: i32, argv: mutable void&) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
        trusted Unsafe.PointerCast:
            endian: u32 = 1.u32()
            first_byte: u8& = (&endian).uintptr().cast[u8&]
            # SDL_PIXELFORMAT_RGBA32 aliases these two formats by byte order.
            rgba32: usize = 0x16762004.usize() if first_byte[0] == 1.u8() else 0x16462004.usize()
            poll: fn(mutable void&?) -> bool = SDL_PollEvent
            pointer: fn(mutable void&?, usize&?, usize&?, i64, i64, f32, f32, u32) -> i32 = nw_sdl_window_pointer
            shutdown: fn(mutable usize&, usize, usize&, mutable usize&, mutable usize&, usize, usize, usize) -> void = nw_sdl_close_desktop
            bindings: mutable SDLDesktopBindings = SDLDesktopBindings{
                pixel_format: rgba32, png_writer: sdl_entry_png_writer(), png_loader: sdl_entry_png_loader(),
                font: sdl_entry_font(), poll: poll.cast[usize], pointer: pointer.cast[usize],
                writer: 0.usize(), shutdown: shutdown.cast[usize], marble_advance: 0.usize(),
                marble_key: 0.usize(), marble_finish: 0.usize(), marble_close: 0.usize(),
                marble_set_png_loader: 0.usize(), marble_startup_status: 0.usize()
            }
            sdl_entry_marble(&bindings)
            sdl_entry_camera()
            return nw_sdl_desktop_main(argc, argv.uintptr().cast[usize&], &bindings)
