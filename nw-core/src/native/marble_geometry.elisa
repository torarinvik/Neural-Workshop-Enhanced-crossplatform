# Indexed meshes in the source renderer's X/Y/Z coordinates.
module MarbleGeometry:
    const PI: f64 = 3.141592653589793
    const MAX_SHADER_HOLES: i64 = 96

    def shader_holes(tray: MarbleMaze::MarbleTray&, out: mutable f64&, start: i64) -> i64:
        can Abort.Panic:
            half_width: f64 = tray.width.f32().f64() / 2.0
            half_depth: f64 = tray.depth.f32().f64() / 2.0
            count: i64 = MAX_SHADER_HOLES if tray.holes.count > MAX_SHADER_HOLES else tray.holes.count
            for hole in 0..<count |hole, tray, out, half_width, half_depth, start|:
                offset: usize = (start + 4 * hole).usize()
                out[offset] <- Floats::at(tray.holes.x, hole).f32().f64() - half_width
                out[offset + 1.usize()] <- half_depth - Floats::at(tray.holes.y, hole).f32().f64()
                out[offset + 2.usize()] <- Floats::at(tray.holes.radius, hole).f32().f64()
                out[offset + 3.usize()] <- Ints::at(tray.holes.home, hole).f64()
            return count

    struct Mesh:
        positions: mutable darray[f64]
        normals: mutable darray[f64]
        indices: mutable darray[i64]

    def empty() -> Mesh:
        can Memory.Allocate:
            return Mesh{positions: [], normals: [], indices: []}

    def vertex(mesh: mutable Mesh&, x: f64, y: f64, z: f64, nx: f64, ny: f64, nz: f64):
        can Memory.Allocate, Abort.Panic:
            mesh.positions.push(x)
            mesh.positions.push(y)
            mesh.positions.push(z)
            mesh.normals.push(nx)
            mesh.normals.push(ny)
            mesh.normals.push(nz)

    def triangle(mesh: mutable Mesh&, a: i64, b: i64, c: i64):
        can Memory.Allocate, Abort.Panic:
            mesh.indices.push(a)
            mesh.indices.push(b)
            mesh.indices.push(c)

    def quad(mesh: mutable Mesh&, a: i64, b: i64, c: i64, d: i64):
        can Memory.Allocate, Abort.Panic:
            triangle(mesh, a, b, c)
            triangle(mesh, a, c, d)

    def face(mesh: mutable Mesh&, a: f64[3], b: f64[3], c: f64[3], d: f64[3], nx: f64, ny: f64, nz: f64):
        can Memory.Allocate, Abort.Panic:
            base: i64 = mesh.positions.count.i64() / 3
            vertex(mesh, a[0], a[1], a[2], nx, ny, nz)
            vertex(mesh, b[0], b[1], b[2], nx, ny, nz)
            vertex(mesh, c[0], c[1], c[2], nx, ny, nz)
            vertex(mesh, d[0], d[1], d[2], nx, ny, nz)
            quad(mesh, base, base + 1, base + 2, base + 3)

    def box(mesh: mutable Mesh&, x0: f64, y0: f64, z0: f64, x1: f64, y1: f64, z1: f64):
        can Memory.Allocate, Abort.Panic:
            a: f64[3] = [x0, y0, z0]
            b: f64[3] = [x1, y0, z0]
            c: f64[3] = [x1, y0, z1]
            d: f64[3] = [x0, y0, z1]
            e: f64[3] = [x0, y1, z0]
            f: f64[3] = [x1, y1, z0]
            g: f64[3] = [x1, y1, z1]
            h: f64[3] = [x0, y1, z1]
            face(mesh, h, g, f, e, 0.0, 1.0, 0.0)
            face(mesh, a, b, c, d, 0.0, -1.0, 0.0)
            face(mesh, d, c, g, h, 0.0, 0.0, 1.0)
            face(mesh, b, a, e, f, 0.0, 0.0, -1.0)
            face(mesh, c, b, f, g, 1.0, 0.0, 0.0)
            face(mesh, a, d, h, e, -1.0, 0.0, 0.0)

    def tube(mesh: mutable Mesh&, cx: f64, cz: f64, radius: f64):
        can Memory.Allocate, Abort.Panic:
            base: i64 = mesh.positions.count.i64() / 3
            for index in 0..<22 |index, mesh, cx, cz, radius|:
                angle: f64 = 2.0 * PI * index.f64() / 22.0
                nx: f64 = cos(angle)
                nz: f64 = sin(angle)
                x: f64 = cx + nx * radius
                z: f64 = cz + nz * radius
                vertex(mesh, x, 0.0, z, -nx, 0.0, -nz)
                vertex(mesh, x, -0.032, z, -nx, 0.0, -nz)
            for index in 0..<22 |index, mesh, base|:
                a: i64 = base + index * 2
                b: i64 = base + ((index + 1) % 22) * 2
                quad(mesh, a, b, b + 1, a + 1)
            centre: i64 = base + 44
            vertex(mesh, cx, -0.032, cz, 0.0, 1.0, 0.0)
            rim: i64 = centre + 1
            for index in 0..<22 |index, mesh, cx, cz, radius, centre, rim|:
                angle: f64 = 2.0 * PI * index.f64() / 22.0
                vertex(mesh, cx + cos(angle) * radius, -0.032, cz + sin(angle) * radius, 0.0, 1.0, 0.0)
                triangle(mesh, centre, rim + index, rim + (index + 1) % 22)

    def ring(mesh: mutable Mesh&, cx: f64, cz: f64, inner: f64, outer: f64):
        can Memory.Allocate, Abort.Panic:
            base: i64 = mesh.positions.count.i64() / 3
            for index in 0..<30 |index, mesh, cx, cz, inner, outer, base|:
                angle: f64 = 2.0 * PI * index.f64() / 30.0
                nx: f64 = cos(angle)
                nz: f64 = sin(angle)
                vertex(mesh, cx + nx * inner, 0.0006, cz + nz * inner, 0.0, 1.0, 0.0)
                vertex(mesh, cx + nx * outer, 0.0006, cz + nz * outer, 0.0, 1.0, 0.0)
                a: i64 = base + index * 2
                b: i64 = base + ((index + 1) % 30) * 2
                quad(mesh, a, a + 1, b + 1, b)

    def sphere(mesh: mutable Mesh&):
        can Memory.Allocate, Abort.Panic:
            base: i64 = mesh.positions.count.i64() / 3
            for row in 0..<27 |row, mesh|:
                phi: f64 = PI * row.f64() / 26.0
                ny: f64 = cos(phi)
                radius: f64 = sin(phi)
                for column in 0..<35 |column, mesh, ny, radius|:
                    theta: f64 = 2.0 * PI * column.f64() / 34.0
                    nx: f64 = radius * cos(theta)
                    nz: f64 = radius * sin(theta)
                    vertex(mesh, nx * 0.0075, ny * 0.0075, nz * 0.0075, nx, ny, nz)
            for row in 0..<26 |row, mesh, base|:
                for column in 0..<34 |column, row, mesh, base|:
                    a: i64 = base + row * 35 + column
                    b: i64 = a + 35
                    quad(mesh, a, b, b + 1, a + 1)

    def collar_radius(tray: MarbleMaze::MarbleTray&, x: f64, y: f64, radius: f64) -> f64:
        can Abort.Panic:
            available: mutable f64 = radius * 1.34
            for wall in 0..<tray.walls.count |wall, tray, x, y, available|:
                left: f64 = Floats::at(tray.walls.x0, wall).f32().f64() - x
                right: f64 = x - Floats::at(tray.walls.x1, wall).f32().f64()
                bottom: f64 = Floats::at(tray.walls.y0, wall).f32().f64() - y
                top: f64 = y - Floats::at(tray.walls.y1, wall).f32().f64()
                dx: f64 = left if left > 0.0 else (right if right > 0.0 else 0.0)
                dy: f64 = bottom if bottom > 0.0 else (top if top > 0.0 else 0.0)
                limit: f64 = py_hypot(dx, dy) - 0.0075 * 0.40
                available <- limit if limit < available
            return available

    def build(tray: MarbleMaze::MarbleTray&, part: i64) -> Mesh:
        can Memory.Allocate, Abort.Panic:
            mesh: mutable Mesh = empty()
            w: f64 = tray.width.f32().f64() / 2.0
            d: f64 = tray.depth.f32().f64() / 2.0
            height: f64 = tray.height.f32().f64()
            if part == 0:
                box(&mesh, -w, -0.013, -d, w, 0.0, d)
            elif part == 1:
                rail: f64 = 0.016
                h: f64 = height * 1.25 if height * 1.25 > 0.020 else 0.020
                box(&mesh, -w - rail, -0.013, -d - rail, w + rail, h, -d)
                box(&mesh, -w - rail, -0.013, d, w + rail, h, d + rail)
                box(&mesh, -w - rail, -0.013, -d, -w, h, d)
                box(&mesh, w, -0.013, -d, w + rail, h, d)
            elif part == 2:
                for wall in 0..<tray.walls.count |wall, tray, mesh, w, d, height|:
                    box(&mesh, Floats::at(tray.walls.x0, wall).f32().f64() - w, 0.0, d - Floats::at(tray.walls.y1, wall).f32().f64(),
                        Floats::at(tray.walls.x1, wall).f32().f64() - w, height, d - Floats::at(tray.walls.y0, wall).f32().f64())
            elif part == 6:
                sphere(&mesh)
            else:
                for hole in 0..<tray.holes.count |hole, tray, mesh, w, d, part|:
                    home: bool = Ints::at(tray.holes.home, hole) != 0
                    x: f64 = Floats::at(tray.holes.x, hole).f32().f64()
                    y: f64 = Floats::at(tray.holes.y, hole).f32().f64()
                    radius: f64 = Floats::at(tray.holes.radius, hole).f32().f64()
                    if (part == 3 and not home) or (part == 4 and home):
                        tube(&mesh, x - w, d - y, radius)
                    elif part == 5 and home:
                        outer: f64 = collar_radius(tray, x, y, radius)
                        if outer > radius:
                            ring(&mesh, x - w, d - y, radius, outer)
            return mesh
