# Convert the logical-window click through SDL's letterboxed framebuffer view.
def sdl_hub_pointer_at(window: mutable void&, category: i64, x: f32, y: f32) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        sizes: mutable i32[4] = zeroed
        view: mutable f32[4] = zeroed
        trusted Unsafe.PointerCast:
            _ = SDL_GetWindowSize(window, (&sizes[0]).uintptr().cast[mutable i32&], (&sizes[1]).uintptr().cast[mutable i32&])
            _ = SDL_GetWindowSizeInPixels(window, (&sizes[2]).uintptr().cast[mutable i32&], (&sizes[3]).uintptr().cast[mutable i32&])
        return -1 if sizes[0] <= 0.i32() or sizes[1] <= 0.i32() or sizes[2] <= 0.i32() or sizes[3] <= 0.i32()
        SDLGeometry::setup(&view[0], sizes[2], sizes[3])
        px: f32 = x * sizes[2].f32() / sizes[0].f32()
        py: f32 = y * sizes[3].f32() / sizes[1].f32()
        rx: f64 = ((px - view[1]) / view[0]).f64() * sizes[2].f64() / Display::REFERENCE_WIDTH
        ry: f64 = ((view[3] - view[2] - py) / view[0]).f64() * sizes[3].f64() / Display::REFERENCE_HEIGHT
        return SceneTaskHub::hit(sizes[2].f64(), sizes[3].f64(), category, rx, ry, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, SDLCameraHost::available(), true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true)

# SDL3 event offsets, checked against the platform headers by the desktop shell.
def sdl_dispatch_desktop_event(event: u8&, window: mutable void&, rows: usize&, special: usize&, tasks: i64&, configs: usize&, screen: i64, trial: mutable i64&, category: mutable i64&, selected: mutable i64&, playing: mutable u8&, step: mutable u8&, running: mutable u8&, index: u8&?, sentences: u8&?, maze: i64&, marble_key: usize, marble_state: usize, physics: usize, physics_tick: usize, pointer_handler: usize, status: i32) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
        trusted Unsafe.PointerCast:
            raw: heap u8& = event.cast[heap u8&]
            words: u32& = event.uintptr().cast[u32&]
            kind: u32 = words[0]
            if kind == 0x100.u32(): # SDL_EVENT_QUIT
                sdl_window_event(rows, window, 0.u32(), 2, running)
            elif kind == 0x20f.u32() or kind == 0x210.u32(): # Focus lost or close
                if words[4] == SDL_GetWindowID(window):
                    SDLCameraHost::clear()
                    SDLTuner::clear_controls(sdl_active_handle(rows, 76.usize()))
                    SDLShadowPlay::clear_controls(sdl_active_handle(rows, 77.usize()))
                sdl_window_event(rows, window, words[4], 1 if kind == 0x210.u32() else 0, running)
            elif kind == 0x20d.u32(): # SDL_EVENT_WINDOW_MOUSE_LEAVE
                if words[4] == SDL_GetWindowID(window):
                    sdl_jigsaw_clear_hover(sdl_active_handle(rows, 21.usize()))
            elif kind == 0x303.u32(): # SDL_EVENT_TEXT_INPUT
                offset: usize = 24.usize() if size_of(usize) == 8 else 20.usize()
                text: usize& = (&raw[offset]).uintptr().cast[usize&]
                if sdl_profile_picker_open:
                    sdl_profile_picker_text_input(text[0].cast[u8&?])
                else:
                    sdl_special_text_event(special, text[0].cast[u8&?])
            elif kind == 0x300.u32(): # SDL_EVENT_KEY_DOWN
                modifiers: u16& = (&raw[32]).uintptr().cast[u16&]
                shifted_digit: bool = (modifiers[0] & 3.u16()) != 0.u16() and words[6] >= 30.u32() and words[6] <= 37.u32()
                key: i64 = words[6].i64() + 19 if shifted_digit and sdl_active_handle(rows, 50.usize()) != 0 else words[7].i64()
                return sdl_window_key_down(window, rows, special, tasks, configs, screen, key, modifiers[0].u32(), raw[37],
                    trial, category, selected, playing, step, running, index, sentences, maze,
                    marble_key, marble_state, physics, physics_tick)
            elif kind == 0x301.u32(): # SDL_EVENT_KEY_UP
                modifiers_up: u16& = (&raw[32]).uintptr().cast[u16&]
                _ = SDLTuner::control(sdl_active_handle(rows, 76.usize()), words[7].i64(), modifiers_up[0].u32(), false)
                _ = SDLShadowPlay::control(sdl_active_handle(rows, 77.usize()), words[7].i64(), modifiers_up[0].u32(), false)
                if not SDLCameraHost::key(words[7].i64(), modifiers_up[0].u32(), false):
                    sdl_active_release(rows, 0, words[7].i64()) can Global{Read,Write}
            elif kind == 0x402.u32() or kind == 0x403.u32(): # Button up or wheel
                if words[4] == SDL_GetWindowID(window):
                    drone: i64 = sdl_active_handle(rows, 66.usize())
                    if kind == 0x402.u32() and raw[24] == 1.u8():
                        SDLDroneHoops::pointer_release(drone)
                        if sdl_active_handle(rows, 67.usize()) != 0 or sdl_active_handle(rows, 68.usize()) != 0 or sdl_active_handle(rows, 69.usize()) != 0 or sdl_active_handle(rows, 70.usize()) != 0 or sdl_active_handle(rows, 71.usize()) != 0 or sdl_active_handle(rows, 76.usize()) != 0 or sdl_active_handle(rows, 77.usize()) != 0 or sdl_active_handle(rows, 101.usize()) != 0 or sdl_active_handle(rows, 102.usize()) != 0 or sdl_active_handle(rows, 103.usize()) != 0 or sdl_active_handle(rows, 104.usize()) != 0 or sdl_active_handle(rows, 105.usize()) != 0 or sdl_active_handle(rows, 130.usize()) != 0 or sdl_active_handle(rows, 129.usize()) != 0 or sdl_active_handle(rows, 128.usize()) != 0 or sdl_active_handle(rows, 127.usize()) != 0 or sdl_active_handle(rows, 126.usize()) != 0 or sdl_active_handle(rows, 106.usize()) != 0 or sdl_active_handle(rows, 107.usize()) != 0 or sdl_active_handle(rows, 108.usize()) != 0 or sdl_active_handle(rows, 109.usize()) != 0 or sdl_active_handle(rows, 110.usize()) != 0 or sdl_active_handle(rows, 111.usize()) != 0 or sdl_active_handle(rows, 112.usize()) != 0 or sdl_active_handle(rows, 113.usize()) != 0 or sdl_active_handle(rows, 114.usize()) != 0 or sdl_active_handle(rows, 115.usize()) != 0 or sdl_active_handle(rows, 116.usize()) != 0 or sdl_active_handle(rows, 117.usize()) != 0 or sdl_active_handle(rows, 118.usize()) != 0 or sdl_active_handle(rows, 119.usize()) != 0 or sdl_active_handle(rows, 120.usize()) != 0 or sdl_active_handle(rows, 121.usize()) != 0 or sdl_active_handle(rows, 122.usize()) != 0 or sdl_active_handle(rows, 123.usize()) != 0 or sdl_active_handle(rows, 124.usize()) != 0 or sdl_active_handle(rows, 125.usize()) != 0:
                            coordinates: f32& = (&raw[28]).uintptr().cast[f32&]
                            pointer: fn(mutable void&, usize, usize, i64, i64, f32, f32, u32) -> i32 = pointer_handler.cast[fn(mutable void&, usize, usize, i64, i64, f32, f32, u32) -> i32]
                            _ = pointer(window, rows.uintptr(), special.uintptr(), 2, 1, coordinates[0], coordinates[1], 0.u32())
                    elif kind == 0x402.u32() and raw[24] == 3.u8() and sdl_active_handle(rows, 77.usize()) != 0:
                        coordinates: f32& = (&raw[28]).uintptr().cast[f32&]
                        pointer: fn(mutable void&, usize, usize, i64, i64, f32, f32, u32) -> i32 = pointer_handler.cast[fn(mutable void&, usize, usize, i64, i64, f32, f32, u32) -> i32]
                        _ = pointer(window, rows.uintptr(), special.uintptr(), 2, 3, coordinates[0], coordinates[1], 0.u32())
                    elif kind == 0x403.u32() and not sdl_profile_picker_open:
                        wheel_y: f32& = (&raw[28]).uintptr().cast[f32&]
                        SDLDroneHoops::wheel(drone, -wheel_y[0].f64() if words[8] == 1.u32() else wheel_y[0].f64())
                        SDLSteadicam::wheel(sdl_active_handle(rows, 119.usize()), -wheel_y[0].f64() if words[8] == 1.u32() else wheel_y[0].f64())
            elif kind == 0x400.u32() or kind == 0x401.u32(): # Motion or button down
                return status if sdl_profile_picker_open
                motion: bool = kind == 0x400.u32()
                coordinates: f32& = (&raw[28]).uintptr().cast[f32&]
                if SDLCameraHost::active() != 0.usize():
                    if words[4] == SDL_GetWindowID(window):
                        if SDLCameraHost::options_visible():
                            if not motion and raw[24] == 1.u8():
                                SDLCameraHost::click_options(window, coordinates[0], coordinates[1])
                        elif motion and words[6] != 0.u32():
                            SDLCameraHost::drag(coordinates[2], coordinates[3])
                    return status
                if not motion and screen == 1 and sdl_hub_idle(rows):
                    hit: i64 = sdl_hub_pointer_at(window, category[0], coordinates[0], coordinates[1])
                    return status if hit < 0
                    if hit < TaskHubTasks::category_count(true):
                        if hit != category[0]:
                            category[0] <- hit
                            selected[0] <- 0
                        return status
                    selected[0] <- hit - TaskHubTasks::category_count(true)
                    return sdl_window_key_down(window, rows, special, tasks, configs, screen, 13, 0.u32(), 0.u8(),
                        trial, category, selected, playing, step, running, index, sentences, maze,
                        marble_key, marble_state, physics, physics_tick)
                pointer: fn(mutable void&, usize, usize, i64, i64, f32, f32, u32) -> i32 = pointer_handler.cast[fn(mutable void&, usize, usize, i64, i64, f32, f32, u32) -> i32]
                _ = pointer(window, rows.uintptr(), special.uintptr(), 1 if motion else 0,
                    0 if motion else raw[24].i64(), coordinates[0], coordinates[1], words[6] if motion else 0.u32())
        return status

export fn nw_sdl_dispatch_desktop_event(event: u8&, window: mutable void&, rows: usize&, special: usize&, tasks: i64&, configs: usize&, screen: i64, trial: mutable i64&, category: mutable i64&, selected: mutable i64&, playing: mutable u8&, step: mutable u8&, running: mutable u8&, index: u8&?, sentences: u8&?, maze: i64&, marble_key: usize, marble_state: usize, physics: usize, physics_tick: usize, pointer_handler: usize, status: i32) -> i32 = sdl_dispatch_desktop_event

# The title owns the root hub. Direct task and hub launches keep their own exit behavior.
def sdl_desktop_navigation(event: u8&, screen: i64, rows: usize&) -> i64:
    can Abort.Panic, Unsafe.PointerCast, Global.Read:
        return screen if sdl_profile_picker_open
        trusted Unsafe.PointerCast:
            words: u32& = event.uintptr().cast[u32&]
            return screen if words[0] != 0x300.u32() or event[37] != 0.u8()
            if screen == 0 and words[7] == 32.u32():
                return 1
            if screen == 1 and words[7] == 27.u32() and sdl_hub_idle(rows):
                return 0
        return screen

# SDL_Event is 128 bytes; u64 storage provides the union's required alignment.
def sdl_run_desktop_loop(state: usize&, dimensions: i32&, rows: usize&, special: usize&, tasks: i64&, configs: usize&, screen: i64, initial_trial: i64, black: i64, capacity: i64, index: u8&?, sentences: u8&?, maze: i64&, poll_handler: usize, pointer_handler: usize, writer: usize, marble_advance: usize, marble_key: usize, marble_finish: usize, marble_state: usize, physics: usize, physics_tick: usize, surface: usize, screenshot: usize, png_writer: usize, argc: i64 = 0, argv: usize&? = null) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
        event: mutable u64[16] = zeroed
        last_step: mutable u64 = SDL_GetTicks()
        last_marble: mutable u64 = SDL_GetTicks()
        trial: mutable i64 = initial_trial
        category: mutable i64 = 0
        selected: mutable i64 = 0
        playing: mutable u8 = 0.u8()
        running: mutable u8 = 1.u8()
        status: mutable i32 = 0.i32()
        active_screen: mutable i64 = screen
        trusted Unsafe.PointerCast:
            if physics_tick != 0.usize():
                clock: mutable u64& = physics_tick.cast[mutable u64&]
                clock[0] <- last_marble
            buffer: mutable u8& = (&event[0]).uintptr().cast[mutable u8&]
            poll: fn(mutable u8&) -> bool = poll_handler.cast[fn(mutable u8&) -> bool]
            while running != 0.u8() |running, screenshot, poll, buffer, status, state, rows, special, tasks, configs, screen, active_screen, trial, category, selected, playing, index, sentences, maze, marble_key, marble_state, physics, physics_tick, pointer_handler, dimensions, last_marble, black, capacity, writer, last_step, marble_advance, marble_finish, surface, png_writer, argc, argv|:
                step: mutable u8 = 0.u8()
                while running != 0.u8() and screenshot == 0.usize() and poll(buffer) |running, screenshot, poll, buffer, status, state, rows, special, tasks, configs, screen, active_screen, trial, category, selected, playing, step, index, sentences, maze, marble_key, marble_state, physics, physics_tick, pointer_handler, argc, argv|:
                    window: mutable void& = state[0].cast[mutable void&]
                    if screen == 0:
                        next_screen: i64 = sdl_desktop_navigation(buffer, active_screen, rows)
                        if next_screen != active_screen:
                            active_screen <- next_screen
                            selected <- 0
                            playing <- 0.u8()
                            continue
                    status <- sdl_dispatch_desktop_event(buffer, window, rows, special, tasks, configs,
                        active_screen, &trial, &category, &selected, &playing, &step, &running, index,
                        sentences, maze, marble_key, marble_state, physics, physics_tick, pointer_handler, status)
                    if sdl_profile_picker_changed:
                        sdl_profile_picker_changed <- false
                        if argv != null:
                            puzzle_options: mutable i64& = tasks.uintptr().cast[mutable i64&]
                            puzzle_status: i32 = sdl_parse_puzzle_options(argc, argv, puzzle_options)
                            return puzzle_status if puzzle_status != 0.i32()
                            reloaded_index: mutable usize = 0.usize()
                            reloaded_sentences: mutable usize = 0.usize()
                            reloaded: i32 = sdl_parse_configs(argc, argv, configs, &reloaded_index, &reloaded_sentences)
                            return reloaded if reloaded != 0.i32()
                break if running == 0.u8()
                output: i32 = sdl_desktop_frame(state, dimensions, rows, special, &last_marble, black,
                    capacity, 1 if active_screen == 1 else 0, category, selected, writer, playing.i64(), &step, &last_step, &trial,
                    marble_advance, physics, physics_tick, marble_finish, marble_state, surface, screenshot, png_writer)
                return output if output >= 0.i32()
        return status

def sdl_run_desktop_loop_with_arena(arena: mutable Arena&, state: usize&, dimensions: i32&, rows: usize&, special: usize&, tasks: i64&, configs: usize&, screen: i64, initial_trial: i64, black: i64, capacity: i64, index: u8&?, sentences: u8&?, maze: i64&, poll_handler: usize, pointer_handler: usize, writer: usize, marble_advance: usize, marble_key: usize, marble_finish: usize, marble_state: usize, physics: usize, physics_tick: usize, surface: usize, screenshot: usize, png_writer: usize) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
        in arena:
            return sdl_run_desktop_loop(state, dimensions, rows, special, tasks, configs, screen,
                initial_trial, black, capacity, index, sentences, maze, poll_handler, pointer_handler,
                writer, marble_advance, marble_key, marble_finish, marble_state, physics, physics_tick,
                surface, screenshot, png_writer)

def sdl_run_desktop_loop_legacy(state: usize&, dimensions: i32&, rows: usize&, special: usize&, tasks: i64&, configs: usize&, screen: i64, initial_trial: i64, black: i64, capacity: i64, index: u8&?, sentences: u8&?, maze: i64&, poll_handler: usize, pointer_handler: usize, writer: usize, marble_advance: usize, marble_key: usize, marble_finish: usize, marble_state: usize, physics: usize, physics_tick: usize, surface: usize, screenshot: usize, png_writer: usize) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
        region scratch(2097152):
            return sdl_run_desktop_loop_with_arena(&scratch, state, dimensions, rows, special, tasks,
                configs, screen, initial_trial, black, capacity, index, sentences, maze, poll_handler,
                pointer_handler, writer, marble_advance, marble_key, marble_finish, marble_state,
                physics, physics_tick, surface, screenshot, png_writer)


export fn nw_sdl_run_desktop_loop(state: usize&, dimensions: i32&, rows: usize&, special: usize&, tasks: i64&, configs: usize&, screen: i64, initial_trial: i64, black: i64, capacity: i64, index: u8&?, sentences: u8&?, maze: i64&, poll_handler: usize, pointer_handler: usize, writer: usize, marble_advance: usize, marble_key: usize, marble_finish: usize, marble_state: usize, physics: usize, physics_tick: usize, surface: usize, screenshot: usize, png_writer: usize) -> i32 = sdl_run_desktop_loop_legacy
