# Keep native task choices beside the selected Python profile. The INI is
# still read as the source of defaults and may contain other applications' data.
def sdl_task_profile_sidecar(path: mutable u8&, suffix: cstr) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return false if not sdl_media_profile_path(path)
        trusted Unsafe.PointerCast:
            return SyllogismOptionsHost::append(path.uintptr().i64(), 4096, SDL_strlen(path.cast[cstr]).i64(), suffix) >= 0

def sdl_media_settings_path(path: mutable u8&, recognition: bool) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return sdl_task_profile_sidecar(path, ".recognition-options" if recognition else ".concentration-options")

def sdl_save_profile_sidecar(suffix: cstr, data: u8&, length: usize) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: mutable u8[4096] = zeroed
        expanded: mutable u8[4096] = zeroed
        temporary: mutable u8[4200] = zeroed
        trusted Unsafe.PointerCast:
            target: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
            return false if not sdl_task_profile_sidecar(target, suffix)
            destination: i64 = (&expanded[0]).uintptr().i64()
            return false if SyllogismOptionsHost::settings_override(destination, 4096, target.cast[cstr], true) < 0
            temp: i64 = (&temporary[0]).uintptr().i64()
            return false if SyllogismOptionsHost::temporary(temp, 4200, destination) < 0
            return numberology_results_write(&temporary[0], &expanded[0], data, length) != 0.i32()

def sdl_read_media_settings(recognition: bool, output: mutable i64&):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: mutable u8[4096] = zeroed
        data: mutable u8[128] = zeroed
        trusted Unsafe.PointerCast:
            target: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
            return if not sdl_media_settings_path(target, recognition)
            if SDL_IOFromFile(target.cast[cstr], "rb") is stream:
                raw: heap u8& = (&data[0]).uintptr().cast[heap u8&]
                length: usize = SDL_ReadIO(stream, (&data[0]).cast[mutable void&], 128.usize())
                status: i32 = SDL_GetIOStatus(stream)
                closed: bool = SDL_CloseIO(stream)
                return if not closed or status != 2.i32() or length == 0.usize() or length >= 128.usize()
                values: mutable i64[6] = zeroed
                count: i64 = 6 if recognition else 5
                at: mutable i64 = 0
                for row in 0..<count |row, values, recognition, at, raw, length|:
                    value: i64 = SyllogismOptions::saved_integer(raw, length.i64(), &at)
                    valid: bool = (value >= 0 and value <= 2) if row == 1 else sdl_media_option_allowed(recognition, row, value)
                    return if not valid
                    values[row.usize()] <- value - 1 if row == 1 else value
                while at < length.i64() and SyllogismOptions::whitespace(raw[at.usize()].i64()) |at, length, raw|:
                    at <- at + 1
                return if at != length.i64()
                for row in 0..<count |row, output, values|:
                    output[row.usize()] <- values[row.usize()]

def sdl_save_media_settings(recognition: bool, draft: i64&, medium: i64) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        data: mutable u8[128] = zeroed
        trusted Unsafe.PointerCast:
            length: mutable i32 = 0.i32()
            if recognition:
                length <- SDL_snprintf(&data[0], 128.usize(), "%lld %lld %lld %lld %lld %lld\n",
                    draft[0], medium + 1, draft[2], draft[3], draft[4], draft[5])
            else:
                length <- SDL_snprintf(&data[0], 128.usize(), "%lld %lld %lld %lld %lld\n",
                    draft[0], medium + 1, draft[2], draft[3], draft[4])
            return length > 0.i32() and length < 128.i32() and sdl_save_profile_sidecar(".recognition-options" if recognition else ".concentration-options", &data[0], length.usize())
