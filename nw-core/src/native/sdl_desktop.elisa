include "../scene_desktop.elisa"
include "./sdl_agent_pixels.elisa"

# The desktop shell's Desktop: DesktopGame behind the SDL key, pointer and
# options plumbing the Computer use screens share. The mouse drives the
# pointer directly; arrows step it, Space clicks, R right-clicks, D holds.
module SDLDesktop:
    const SCREEN: i64 = 145
    const SPACE: i64 = 32
    const NOTE_WIDTH: i64 = 100

    struct Session:
        game: mutable DesktopGame::Session
        options_row: mutable i64
        from_hub: mutable bool
        draft: mutable i64[3]

    def read_settings(data: heap u8&, size: i64, selected: mutable i64&):
        can Abort.Panic, Unsafe.PointerCast:
            rung: i64 = sdl_config_option(data, size, "DESKTOP_RUNG", 0, -1)
            trials: i64 = sdl_config_option(data, size, "DESKTOP_TRIALS", 0, -1)
            adaptive: i64 = sdl_config_option(data, size, "DESKTOP_ADAPTIVE", 1, -1)
            selected[0] <- rung if DesktopGame::allowed_rung(rung)
            selected[1] <- trials if DesktopGame::allowed_total(trials)
            selected[2] <- adaptive if adaptive == 0 or adaptive == 1

    # A run with the saved options: the shared config, then the profile's own.
    def open(seed: i64) -> i64:
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            selected: mutable i64[3] = [1, 5, 1]
            size: mutable i64 = 0
            if sdl_media_config(&size) is raw:
                trusted Unsafe.PointerCast:
                    read_settings(raw.cast[heap u8&], size, &selected[0])
                SDL_free(raw)
            path: mutable u8[4096] = zeroed
            if sdl_task_profile_sidecar(&path[0], ".desktop-options"):
                if sdl_read_corpus(&path[0], &size) is raw:
                    trusted Unsafe.PointerCast:
                        read_settings(raw.cast[heap u8&], size, &selected[0])
                    SDL_free(raw)
            return create(selected[0], selected[1], selected[2], seed)

    def create(rung: i64, trials: i64, adaptive: i64, seed: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            return 0 if rung < 1 or trials < 1 or (adaptive != 0 and adaptive != 1)
            if malloc(size_of(Session).usize()) is memory:
                trusted Unsafe.PointerCast:
                    session: mutable heap Session& = memory.cast[mutable heap Session&]
                    session.game <- DesktopGame::initialize(rung, trials, adaptive == 1, seed)
                    session.options_row <- -1
                    session.from_hub <- false
                    return memory.uintptr().i64()
            return 0

    def close(handle: i64):
        can Memory.Release, Abort.Panic, Unsafe.PointerCast:
            if handle > 0:
                trusted Unsafe.PointerCast:
                    session: mutable heap Session& = handle.uintptr().cast[mutable heap Session&]
                    DesktopGame::close(&session.game) can Global{Read,Write}
                    free(session.cast[heap void&])

    # on_key_press: Space starts a run, then clicks; Enter is Done; arrows
    # step the pointer, Shift a long step and Alt a short one; R
    # right-clicks and D presses or lets go.
    def key(handle: i64, symbol: i64, now_ms: i64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global{Read,Write}:
            return false if handle <= 0
            trusted Unsafe.PointerCast:
                session: mutable heap Session& = handle.uintptr().cast[mutable heap Session&]
                owner: mutable Arena& = &session.game.owner
                in owner:
                    return false if session.options_row >= 0
                    now: f64 = now_ms.f64() / 1000.0
                    phase: i64 = session.game.phase
                    if symbol == SPACE and (phase == DesktopGame::READY or phase == DesktopGame::DONE):
                        return DesktopGame::start(&session.game, now)
                    return false if phase != DesktopGame::WORKING
                    return DesktopGame::steer(&session.game, DesktopGame::CLICK, now) if symbol == SPACE
                    return DesktopGame::steer(&session.game, DesktopGame::FINISH, now) if SDLTaskKeys::enter(symbol)
                    return DesktopGame::right_click(&session.game, now) if symbol == 114
                    return SceneDesktop::hold(&session.game, now) if symbol == 100
                    direction: i64 = arrow_direction(symbol)
                    return false if direction < 0
                    modifiers: u16 = SDL_GetModState()
                    return SceneDesktop::arrow(&session.game, direction, (modifiers & 3.u16()) != 0.u16(),
                        (modifiers & 768.u16()) != 0.u16(), now)

    def arrow_direction(symbol: i64) -> i64:
        return 0 if symbol == SDLTaskKeys::UP
        return 1 if symbol == SDLTaskKeys::DOWN
        return 2 if symbol == SDLTaskKeys::LEFT
        return 3 if symbol == SDLTaskKeys::RIGHT
        return -1

    # The mouse: motion 0 is a press, 1 a move and 2 a release; SDL's
    # buttons 1 and 3 are the left and right ones.
    def pointer(handle: i64, x: f32, y: f32, width: i32, height: i32, motion: i64, button: i64, now_ms: i64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global{Read,Write}:
            return false if handle <= 0 or width <= 0.i32() or height <= 0.i32()
            trusted Unsafe.PointerCast:
                session: mutable heap Session& = handle.uintptr().cast[mutable heap Session&]
                owner: mutable Arena& = &session.game.owner
                in owner:
                    if session.options_row >= 0:
                        return false if motion != 0 or button != 1
                        row: i64 = sdl_option_row(x, y, width, height, 3)
                        if row >= 0:
                            if row == session.options_row:
                                change_option(session, 1)
                            session.options_row <- row
                        return true
                    view: mutable f32[4] = zeroed
                    SDLGeometry::setup(&view[0], width, height)
                    return false if view[0] <= 0.0.f32()
                    px: f64 = ((x - view[1]) / view[0]).f64()
                    py: f64 = ((height.f32() - y - view[2]) / view[0]).f64()
                    now: f64 = now_ms.f64() / 1000.0
                    return SceneDesktop::mouse_move(&session.game, px, py, now) if motion == 1
                    return SceneDesktop::mouse_down(&session.game, button - 1, px, py, now) if motion == 0
                    return SceneDesktop::mouse_up(&session.game, button - 1, px, py, now)

    def advance(handle: i64, now_ms: i64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Global{Read,Write}:
            return false if handle <= 0
            trusted Unsafe.PointerCast:
                session: mutable heap Session& = handle.uintptr().cast[mutable heap Session&]
                owner: mutable Arena& = &session.game.owner
                in owner:
                    return false if session.options_row >= 0
                    return DesktopGame::advance(&session.game, now_ms.f64() / 1000.0)

    def info(handle: i64, field: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return -1 if handle <= 0
            trusted Unsafe.PointerCast:
                session: heap Session& = handle.uintptr().cast[heap Session&]
                return DesktopGame::info(&session.game, field)

    def frame_write(dest: i64, capacity: i64, handle: i64, black: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            return 0 if dest <= 0 or capacity <= 0 or handle <= 0
            trusted Unsafe.PointerCast:
                session: mutable heap Session& = handle.uintptr().cast[mutable heap Session&]
                region scratch(8388608):
                    in scratch:
                        list: mutable Display::DisplayList = Display::DisplayList()
                        if session.options_row >= 0:
                            sdl_grid_options_frame(&list, black != 0, SCREEN, session.options_row, (&session.draft[0]).cast[i64&])
                        else:
                            SceneDesktop::render(&list, &session.game, black != 0)
                        encoded: darray[u8] = Display::encode_binary(&list)
                        length: i64 = encoded.count.i64()
                        return 0 if length <= 0 or length > capacity
                        memcpy(dest.uintptr().cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
                        return length

    # Steps a row's value to the next one the options offer, wrapping.
    def change_option(session: mutable Session&, direction: i64):
        can Abort.Panic:
            row: i64 = session.options_row
            if row == 2:
                session.draft[2] <- 1 - session.draft[2]
                return
            limit: i64 = 30 if row == 0 else 12
            value: mutable i64 = session.draft[row.usize()]
            while true |value, session, row, direction, limit|:
                value <- (value + direction + limit - 1) % limit + 1
                if (DesktopGame::allowed_rung(value) if row == 0 else DesktopGame::allowed_total(value)):
                    session.draft[row.usize()] <- value
                    return

    # The options note, a line for each of its sentences, wrapped to fit the
    # options screen: words wrap at NOTE_WIDTH characters, and two spaces
    # before a word start a new line.
    def draw_note(list: mutable Display::DisplayList&, rung: i64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            note: mutable dstr = []
            SceneDesktop::option_note(rung, &note)
            length: i64 = note.count.i64()
            # The line so far is note[first..<last]; a word is note[word..<index].
            first: mutable i64 = -1
            last: mutable i64 = -1
            word: mutable i64 = -1
            gap: mutable i64 = 0
            row: mutable i64 = 0
            for index in 0..<(length + 1) |list, ink, note, length, first, last, word, gap, row|:
                space: bool = index == length or note[index.usize()] == SPACE.u8()
                if not space:
                    word <- index if word < 0
                elif word >= 0:
                    if first >= 0 and (gap >= 2 or index - first > NOTE_WIDTH):
                        note_line(list, &note, first, last, row, ink)
                        row <- row + 1
                        first <- -1
                    first <- word if first < 0
                    last <- index
                    word <- -1
                    gap <- 1
                else:
                    gap <- gap + 1
            note_line(list, &note, first, last, row, ink) if first >= 0

    def note_line(list: mutable Display::DisplayList&, note: dstr&, first: i64, last: i64, row: i64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            line: mutable dstr = []
            for at in first..<last |line, note|:
                line.push(note[at.usize()])
            Display::draw_text(list, bytes_view(line), 456.0, 254.0 - row.f64() * 13.0, 10.0, ink, Display::ANCHOR_CENTER_CENTER)

    def save_options(session: Session&) -> bool:
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            data: mutable u8[192] = zeroed
            length: i32 = SDL_snprintf(&data[0], 192.usize(),
                "[DEFAULT]\nDESKTOP_RUNG = %lld\nDESKTOP_TRIALS = %lld\nDESKTOP_ADAPTIVE = %s\n",
                session.draft[0], session.draft[1], "True" if session.draft[2] == 1 else "False")
            return length > 0.i32() and length < 192.i32() and sdl_save_profile_sidecar(".desktop-options", &data[0], length.usize())

    # 0: not for the options; 1: handled; 2: handled, and back to the hub.
    def options_key(handle: i64, key: i64, from_hub: bool = false) -> i64:
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            return 0 if handle <= 0
            trusted Unsafe.PointerCast:
                session: mutable heap Session& = handle.uintptr().cast[mutable heap Session&]
                if session.options_row < 0:
                    return 0 if key != 99 or (session.game.phase != DesktopGame::READY and session.game.phase != DesktopGame::DONE)
                    session.draft[0] <- session.game.ladder.start_rung
                    session.draft[1] <- session.game.ladder.total
                    session.draft[2] <- 1 if session.game.ladder.adaptive else 0
                    session.options_row <- 0
                    session.from_hub <- from_hub
                    return 1
                apply: bool = SDLTaskKeys::enter(key)
                if apply:
                    if not save_options(session):
                        SDL_Log("Could not save Desktop options")
                        return 1
                    _ = DesktopGame::reconfigure(&session.game, session.draft[0], session.draft[1], session.draft[2] == 1)
                if apply or key == 27:
                    session.options_row <- -1
                    return 2 if session.from_hub else 1
                session.options_row <- SDLTaskKeys::option_row(key, session.options_row, 3)
                if key == SDLTaskKeys::LEFT or key == SDLTaskKeys::RIGHT or key == SPACE:
                    change_option(session, -1 if key == SDLTaskKeys::LEFT else 1)
                return 1

    def agent_event(handle: i64, now: f64, port: i64) -> bool:
        can Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast, Global{Read,Write}:
            return false if handle <= 0
            trusted Unsafe.PointerCast:
                session: mutable heap Session& = handle.uintptr().cast[mutable heap Session&]
                owner: mutable Arena& = &session.game.owner
                in owner:
                    return DesktopGame::agent_input(&session.game, now, port)

    def rgba_write(output: mutable u8&?, capacity: i64, handle: i64, black: i64, width: i32, height: i32) -> i64:
        can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
            return 0 if output == null or handle <= 0 or width <= 0.i32() or height <= 0.i32() or width > 536870911.i32()
            bytes: i64 = width.i64() * height.i64() * 4
            return 0 if capacity < bytes
            pixels: mutable u8& = output
            drawn: mutable i64 = 0
            trusted Unsafe.PointerCast:
                session: mutable heap Session& = handle.uintptr().cast[mutable heap Session&]
                region scratch(8388608):
                    in scratch:
                        list: mutable Display::DisplayList = Display::DisplayList()
                        SceneDesktop::render(&list, &session.game, black != 0)
                        encoded: darray[u8] = Display::encode_binary(&list)
                        drawn <- SDLAgentPixels::draw(pixels, (&encoded[0]).uintptr().i64(), encoded.count.i64(), bytes, black, width, height)
            return drawn
