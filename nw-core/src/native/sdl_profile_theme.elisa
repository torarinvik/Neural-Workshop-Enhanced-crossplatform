# Startup theme can be inherited from the source application's default profile.
extern SDL_strtod(text: cstr, end: mutable usize&) -> f64

def sdl_config_space(byte: u8) -> bool:
    return byte == 32.u8() or byte == 9.u8() or byte == 13.u8()

def sdl_config_trim_left(data: heap u8&, start: i64, end: i64) -> i64:
    can Abort.Panic:
        at: mutable i64 = start
        while at < end and sdl_config_space(data[at.usize()]) |at, data, end|:
            at <- at + 1
        return at

def sdl_config_trim_right(data: heap u8&, start: i64, end: i64) -> i64:
    can Abort.Panic:
        at: mutable i64 = end
        while at > start and sdl_config_space(data[(at - 1).usize()]) |at, data, start|:
            at <- at - 1
        return at

def sdl_config_value(data: heap u8&, size: i64, key: cstr, boolean: bool) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return sdl_config_option(data, size, key, 1 if boolean else 0, 0)

# Modes read integer, boolean, media, unit gain in millionths, bounded text,
# or a duration in seconds converted to milliseconds.
def sdl_config_option(data: heap u8&, size: i64, key: cstr, mode: i64, fallback: i64, text_output: mutable u8&? = null, text_capacity: i64 = 0) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        in_default: mutable bool = false
        found: mutable bool = false
        result: mutable i64 = fallback
        key_length: i64 = SDL_strlen(key).i64()
        line: mutable i64 = 0
        trusted Unsafe.PointerCast:
            while line < size |line, size, data, in_default, found, result, key, key_length, mode, fallback, text_output, text_capacity|:
                stop: mutable i64 = line
                while stop < size and data[stop.usize()] != 10.u8() |stop, size, data|:
                    stop <- stop + 1
                start: i64 = sdl_config_trim_left(data, line, stop)
                end: mutable i64 = sdl_config_trim_right(data, start, stop)
                line <- stop + 1
                continue if start == end
                first: u8 = data[start.usize()]
                continue if first == 35.u8() or first == 59.u8()
                if first == 91.u8():
                    in_default <- end - start >= 9 and SDL_strncmp((&data[start.usize()]).cast[cstr], "[DEFAULT]", 9.usize()) == 0.i32()
                    continue
                continue if not in_default
                separator: mutable i64 = start
                while separator < end and data[separator.usize()] != 61.u8() and data[separator.usize()] != 58.u8() |separator, end, data|:
                    separator <- separator + 1
                continue if separator == end
                key_end: i64 = sdl_config_trim_right(data, start, separator)
                continue if key_end - start != key_length or SDL_strncasecmp((&data[start.usize()]).cast[cstr], key, key_length.usize()) != 0.i32()
                if found:
                    if text_capacity > 0 and text_output != null:
                        output: mutable u8& = text_output
                        output[0] <- 0.u8()
                    return fallback
                found <- true
                value: i64 = sdl_config_trim_left(data, separator + 1, end)
                word: mutable cstr = (&data[value.usize()]).cast[cstr] if value < end else ""
                if mode == 1:
                    if end - value == 4 and SDL_strncmp(word, "True", 4.usize()) == 0.i32():
                        result <- 1
                    elif end - value == 5 and SDL_strncmp(word, "False", 5.usize()) == 0.i32():
                        result <- 0
                elif mode == 2:
                    if end - value == 7:
                        quote: u8 = data[value.usize()]
                        if (quote == 39.u8() or quote == 34.u8()) and data[(end - 1).usize()] == quote:
                            word <- (&data[(value + 1).usize()]).cast[cstr]
                            end <- end - 2
                    if end - value == 5 and SDL_strncmp(word, "image", 5.usize()) == 0.i32():
                        result <- 0
                    elif end - value == 5 and SDL_strncmp(word, "sound", 5.usize()) == 0.i32():
                        result <- 1
                elif mode == 3:
                    result <- sdl_config_scaled_decimal(data, value, end, fallback, 1.0, 1000000.0)
                elif mode == 5:
                    result <- sdl_config_scaled_decimal(data, value, end, fallback, 60.0, 1000.0)
                elif mode == 4:
                    if text_capacity > 0 and text_output != null:
                        output: mutable u8& = text_output
                        start_value: mutable i64 = value
                        if end - value >= 2:
                            quote: u8 = data[value.usize()]
                            if (quote == 39.u8() or quote == 34.u8()) and data[(end - 1).usize()] == quote:
                                start_value <- value + 1
                                end <- end - 1
                        length: i64 = end - start_value
                        if length > 0 and length < text_capacity:
                            for at in 0..<length |at, output, data, start_value|:
                                output[at.usize()] <- data[(start_value + at).usize()]
                            output[length.usize()] <- 0.u8()
                else:
                    result <- sdl_config_integer(data, value, end, fallback)
            return result

def sdl_config_scaled_decimal(data: heap u8&, start: i64, end: i64, fallback: i64, maximum: f64, scale: f64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        length: i64 = end - start
        return fallback if length <= 0 or length >= 32
        buffer: mutable u8[32] = zeroed
        for at in 0..<length |at, buffer, data, start|:
            buffer[at.usize()] <- data[(start + at).usize()]
        trusted Unsafe.PointerCast:
            address: usize = (&buffer[0]).uintptr()
            end_address: mutable usize = 0.usize()
            value: f64 = SDL_strtod(address.cast[cstr], &end_address)
            return fallback if end_address != address + length.usize() or not (value >= 0.0 and value <= maximum)
            return (value * scale).i64()

def sdl_config_integer(data: heap u8&, start: i64, end: i64, fallback: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        length: i64 = end - start
        return fallback if length <= 0 or length >= 32
        buffer: mutable u8[32] = zeroed
        for at in 0..<length |at, buffer, data, start|:
            buffer[at.usize()] <- data[(start + at).usize()]
        value: mutable i64 = 0
        trusted Unsafe.PointerCast:
            return fallback if sdl_signed_argument((&buffer[0]).uintptr(), &value) == 0.i32()
        return value

extern SDL_SetWindowTitle(window: mutable void&, title: cstr) -> bool

def sdl_set_profile_caption(window: mutable void&):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        name: mutable u8[4096] = zeroed
        suffix: mutable u8[270] = zeroed
        title: mutable u8[296] = zeroed
        trusted Unsafe.PointerCast:
            path: mutable u8& = (&name[0]).uintptr().cast[mutable u8&]
            selected: mutable u8& = (&suffix[0]).uintptr().cast[mutable u8&]
            length: i64 = sdl_profile_suffix(path, selected)
            if length <= 0:
                _ = SDL_SetWindowTitle(window, "Neural Workshop 5.0")
                return
            suffix[(length - 11).usize()] <- 0.u8()
            address: i64 = (&title[0]).uintptr().i64()
            end: i64 = SyllogismOptionsHost::append(address, 296, 0, "Neural Workshop 5.0 - ")
            if SyllogismOptionsHost::append(address, 296, end, (&suffix[1]).cast[cstr]) >= 0:
                _ = SDL_SetWindowTitle(window, address.uintptr().cast[cstr])

def sdl_profile_config_path(name: mutable u8&, requested: usize) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        suffix: mutable u8[270] = zeroed
        trusted Unsafe.PointerCast:
            buffer: mutable u8& = (&suffix[0]).uintptr().cast[mutable u8&]
            if sdl_profile_suffix(name, buffer) > 0:
                return sdl_data_path(name, 4096.usize(), buffer.cast[cstr], 0, true)
        trusted Unsafe.PointerCast:
            if requested != 0.usize():
                path: u8& = requested.cast[u8&]
                if path[0] != 0.u8():
                    windows: bool = syllogism_argument_is(SDL_GetPlatform().uintptr().i64(), "Windows")
                    absolute: bool = path[0] == 47.u8() or (windows and (path[0] == 92.u8() or path[1] == 58.u8()))
                    start: mutable i64 = 0
                    if not absolute:
                        return 0 if sdl_data_path(name, 4096.usize(), "/", 0, true) == 0.i32()
                        start <- SDL_strlen(name.cast[cstr]).i64()
                    return 1 if SyllogismOptionsHost::append(name.uintptr().i64(), 4096, start, path.cast[cstr]) >= 0 else 0
        return sdl_data_path(name, 4096.usize(), "/config.ini", 0, true)

def sdl_startup_profile(argc: i64, argv: usize&?, dimensions: mutable i32&? = null, fullscreen: mutable i64&? = null, skip_title: mutable i64&? = null, headless: mutable i64&? = null) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        black: i64 = sdl_black_background(argc, argv)
        return 1 if black != 0 and dimensions == null
        path: mutable u8[4096] = zeroed
        size: mutable i64 = 0
        trusted Unsafe.PointerCast:
            name: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
            requested: usize = sdl_first_option_value(argc, argv, "--configfile")
            return black if sdl_profile_config_path(name, requested) == 0.i32()
            if sdl_read_corpus(name, &size) is raw:
                result: mutable i64 = black
                if size <= 1048576:
                    data: heap u8& = raw.cast[heap u8&]
                    result <- sdl_config_value(data, size, "BLACK_BACKGROUND", true) if black == 0
                    if fullscreen != null:
                        setting: mutable i64& = fullscreen
                        setting[0] <- sdl_config_value(data, size, "WINDOW_FULLSCREEN", true)
                    if skip_title != null:
                        setting: mutable i64& = skip_title
                        setting[0] <- sdl_config_value(data, size, "SKIP_TITLE_SCREEN", true)
                    if headless != null:
                        setting: mutable i64& = headless
                        setting[0] <- sdl_config_value(data, size, "HEADLESS", true) if setting[0] == 0
                    if dimensions != null:
                        target: mutable i32& = dimensions
                        if sdl_first_option_value(argc, argv, "--width") == 0.usize():
                            width: i64 = sdl_config_value(data, size, "WINDOW_WIDTH", false)
                            target[0] <- (640 if width < 640 else width).i32() if width > 0 and width <= 2147483647
                        if sdl_first_option_value(argc, argv, "--height") == 0.usize():
                            height: i64 = sdl_config_value(data, size, "WINDOW_HEIGHT", false)
                            target[1] <- (480 if height < 480 else height).i32() if height > 0 and height <= 2147483647
                SDL_free(raw)
                return result
        return black

extern SDL_strcasecmp(left: cstr, right: cstr) -> i32

def sdl_headless_environment() -> bool:
    can Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            if SDL_getenv("NW_HEADLESS") is setting:
                value: cstr = setting.cast[cstr]
                return SDL_strcasecmp(value, "1") == 0.i32() or SDL_strcasecmp(value, "true") == 0.i32() or SDL_strcasecmp(value, "yes") == 0.i32() or SDL_strcasecmp(value, "on") == 0.i32()
        return false

def sdl_headless_requested(argc: i64, argv: usize&?) -> bool:
    can Abort.Panic, Unsafe.PointerCast:
        return sdl_has_flag(argc, argv, "--headless") or sdl_headless_environment()
