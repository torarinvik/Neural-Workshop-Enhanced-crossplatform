            return SDLRailYard::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == RAILYARD
            return SDLAirTraffic::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == AIRTRAFFIC
