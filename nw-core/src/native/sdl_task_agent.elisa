    def step(session: mutable Session&, elapsed_seconds: f64) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            return SDLPov::step(session.task, elapsed_seconds) if session.kind == POINT_OF_VIEW
            if session.kind == CAPTCHA:
                return elapsed_seconds > 0.0 and elapsed_seconds <= 9007199254740.0 if session.sequence == 0
                return SDLCaptcha::step(session.task, elapsed_seconds) can Global{Read,Write}
            if session.kind == SIGNALS:
                return elapsed_seconds > 0.0 and elapsed_seconds <= 9007199254740.0 if session.sequence == 0
                return SDLSignals::step(session.task, elapsed_seconds) can Global{Read,Write}
            if session.kind == FOLD_IT:
                return elapsed_seconds > 0.0 and elapsed_seconds <= 9007199254740.0 if session.sequence == 0
                return SDLFoldIt::step(session.task, elapsed_seconds) can Global{Read,Write}
            if session.kind == WHO_KNOWS_WHAT:
                return elapsed_seconds > 0.0 and elapsed_seconds <= 9007199254740.0 if session.sequence == 0
                return SDLBeliefs::step(session.task, elapsed_seconds) can Global{Read,Write}
            if session.kind == SONAR:
                return elapsed_seconds > 0.0 and elapsed_seconds <= 9007199254740.0 if session.sequence == 0
                return SDLSonar::step(session.task, elapsed_seconds)
            if session.kind == GAMBLE:
                return elapsed_seconds > 0.0 and elapsed_seconds <= 9007199254740.0 if session.sequence == 0
                return SDLGamble::step(session.task, elapsed_seconds) can Global{Read,Write}
            if session.kind == BLUFF:
                return elapsed_seconds > 0.0 and elapsed_seconds <= 9007199254740.0 if session.sequence == 0
                return SDLBluff::step(session.task, elapsed_seconds) can Global{Read,Write}
            if session.kind == EXPLORE_EXPLOIT:
                return elapsed_seconds > 0.0 and elapsed_seconds <= 9007199254740.0 if session.sequence == 0
                return SDLBandit::step(session.task, elapsed_seconds)
            if session.kind == WILL_IT_FALL:
                # The first publication is the reset frame and opens the first receipt.
                return elapsed_seconds > 0.0 and elapsed_seconds <= 1.7976931348623157e308 if session.sequence == 0
                return SDLFalls::step(session.task, elapsed_seconds)
            return SDLInside::step(session.task, elapsed_seconds) if session.kind == INSIDE_OR_OUT
            return SDLTouching::step(session.task, elapsed_seconds) if session.kind == TOUCHING
            return SDLCrossings::step(session.task, elapsed_seconds) if session.kind == CROSSINGS
            return SDLMirror::step(session.task, elapsed_seconds) if session.kind == MIRROR
            return SDLRooms::step(session.task, elapsed_seconds) if session.kind == ROOMS
            return SDLNotebook::step(session.task, elapsed_seconds) if session.kind == NOTEBOOK
            return SDLTriage::step(session.task, elapsed_seconds) if session.kind == TRIAGE
            return false if not (elapsed_seconds > 0.0)
            # These clocked agents publish the reset frame before ticking.
            return elapsed_seconds <= 9007199254740.0 if (session.kind == LOCK_PICK or session.kind == AIR_HOCKEY or session.kind == SEMAPHORE or session.kind == SHADOW_PUPPETS or session.kind == NIGHT_WATCH or session.kind == KERBSIDE or session.kind == STEADICAM or session.kind == FREE_KICK or session.kind == GLOVE or session.kind == BY_EAR or session.kind == PIANO_TUNER or session.kind == CRICKET_HUNT or session.kind == CLAW_MACHINE or session.kind == BARTENDER or session.kind == SIGN_PAINTER or session.kind == TIGHTROPE or session.kind == CONDUCTOR or session.kind == POTTER or session.kind == CIPHER_ABYSS or session.kind == CRAZY_COG or session.kind == FIGURES or session.kind == WHICH_FEELING or session.kind == HOW_STRONGLY or session.kind == WHY_THEY_FEEL or session.kind == TONE_OF_VOICE or session.kind == EMOTION or session.kind == READING_PEOPLE or session.kind == SOCIAL_SENSE or session.kind == BAD_ARGUMENT or session.kind == SECOND_THOUGHTS or session.kind == BETWEEN_LINES or session.kind == PROOFREADER or session.kind == MISSING_WORD or session.kind == FULL_STOP or session.kind == HEAVIER or session.kind == MORNING_ROUND or session.kind == UNICYCLE or session.kind == ROVER or session.kind == DOCKING or session.kind == FERRY or session.kind == CRANE or session.kind == KITCHEN or session.kind == SOKOBANLIVE or session.kind == ESCORT or session.kind == AIRTRAFFIC or session.kind == RAILYARD or session.kind == CROSSROADS or session.kind == FIREBREAK or session.kind == DISPATCH or session.kind == DAM_KEEPER or session.kind == SHAPE_FROM_MOTION or session.kind == DRSHAPE or session.kind == TUNER or session.kind == SHADOW_PLAY) and session.sequence == 0
            now: f64 = session.seconds + elapsed_seconds
            advanced: bool = SDLHoldIt::agent_step(session.task, now, session.port == 0) if session.kind == HOLD_IT else (clocked_event(session.kind, session.task, now, -1) can Global{Read,Write})
            return false if not advanced
            session.seconds <- now
            return true

    def close(handle: i64):
        can Memory.Release, Unsafe.PointerCast:
            return if handle <= 0
            trusted Unsafe.PointerCast:
                session: mutable heap Session& = handle.uintptr().cast[mutable heap Session&]
                close_task(session.kind, session.task) can Global{Read,Write}
                free(session.cast[heap void&])

    def act(handle: i64, port: i64, timestamp_ns: i64) -> i64:
        can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            return 0 if handle <= 0 or port < 0
            trusted Unsafe.PointerCast:
                session: mutable heap Session& = handle.uintptr().cast[mutable heap Session&]
                return 0 if session.publication_pending or session.port >= 0 or timestamp_ns < session.timestamp_ns
                return 0 if session.receipt == 0 or info(session, 0) != TriageGame::PLAYING
                task_ports: mutable i64 = 2
                task_ports <- 17 if session.kind == TRIAGE
                task_ports <- NearerGame::START if session.kind == NEARER
                task_ports <- ShapeFromMotionGame::START if session.kind == SHAPE_FROM_MOTION
                task_ports <- DamKeeperGame::START if session.kind == DAM_KEEPER
                task_ports <- DispatchGame::START if session.kind == DISPATCH
                task_ports <- FirebreakGame::START if session.kind == FIREBREAK
                task_ports <- CrossroadsGame::START if session.kind == CROSSROADS
                task_ports <- RailYardGame::START if session.kind == RAILYARD
                task_ports <- AirTrafficGame::START if session.kind == AIRTRAFFIC
                task_ports <- EscortGame::START if session.kind == ESCORT
                task_ports <- SokobanLiveGame::START if session.kind == SOKOBANLIVE
                task_ports <- KitchenGame::START if session.kind == KITCHEN
                task_ports <- CraneGame::START if session.kind == CRANE
                task_ports <- FerryGame::START if session.kind == FERRY
                task_ports <- DockingGame::START if session.kind == DOCKING
                task_ports <- RoverGame::START if session.kind == ROVER
                task_ports <- UnicycleGame::START if session.kind == UNICYCLE
                task_ports <- MorningRoundGame::START if session.kind == MORNING_ROUND
                task_ports <- HeavierGame::START if session.kind == HEAVIER
                task_ports <- FullStopGame::START if session.kind == FULL_STOP
                task_ports <- MissingWordGame::START if session.kind == MISSING_WORD
                task_ports <- ProofreaderGame::START if session.kind == PROOFREADER
                task_ports <- FiguresHost::START if session.kind == FIGURES
                task_ports <- WhichFeelingHost::START if session.kind == WHICH_FEELING
                task_ports <- HowStronglyHost::START if session.kind == HOW_STRONGLY
                task_ports <- WhyTheyFeelHost::START if session.kind == WHY_THEY_FEEL
                task_ports <- ToneOfVoiceHost::START if session.kind == TONE_OF_VOICE
                task_ports <- EmotionFacesHost::START if session.kind == EMOTION
                task_ports <- ReadingPeopleHost::START if session.kind == READING_PEOPLE
                task_ports <- SocialSenseHost::START if session.kind == SOCIAL_SENSE
                task_ports <- BadArgumentHost::START if session.kind == BAD_ARGUMENT
                task_ports <- SecondThoughtsHost::START if session.kind == SECOND_THOUGHTS
                task_ports <- BetweenLinesHost::START if session.kind == BETWEEN_LINES
                task_ports <- CrazyCogGame::START if session.kind == CRAZY_COG
                task_ports <- CipherAbyssGame::START if session.kind == CIPHER_ABYSS
                task_ports <- PotterGame::START if session.kind == POTTER
                task_ports <- ConductorGame::START if session.kind == CONDUCTOR
                task_ports <- TightropeGame::START if session.kind == TIGHTROPE
                task_ports <- SignPainterGame::START if session.kind == SIGN_PAINTER
                task_ports <- BartenderGame::START if session.kind == BARTENDER
                task_ports <- LockPickGame::START if session.kind == LOCK_PICK
                task_ports <- AirHockeyGame::START if session.kind == AIR_HOCKEY
                task_ports <- SemaphoreGame::START if session.kind == SEMAPHORE
                task_ports <- ShadowPuppetsGame::START if session.kind == SHADOW_PUPPETS
                task_ports <- NightWatchGame::START if session.kind == NIGHT_WATCH
                task_ports <- KerbsideGame::START if session.kind == KERBSIDE
                task_ports <- SteadicamGame::START if session.kind == STEADICAM
                task_ports <- FreeKickGame::START if session.kind == FREE_KICK
                task_ports <- GloveGame::START if session.kind == GLOVE
                task_ports <- ByEarGame::START if session.kind == BY_EAR
                task_ports <- PianoTunerGame::START if session.kind == PIANO_TUNER
                task_ports <- CricketHuntGame::START if session.kind == CRICKET_HUNT
                task_ports <- ClawMachineGame::START if session.kind == CLAW_MACHINE
                task_ports <- PointOfViewGame::START if session.kind == POINT_OF_VIEW
                task_ports <- Falls::MOST_CHOICES if session.kind == WILL_IT_FALL
                task_ports <- Captcha::PORTS if session.kind == CAPTCHA
                task_ports <- SignalsGame::START if session.kind == SIGNALS
                task_ports <- FoldGame::START if session.kind == FOLD_IT
                task_ports <- BeliefsGame::START if session.kind == WHO_KNOWS_WHAT
                task_ports <- SonarGame::START if session.kind == SONAR
                task_ports <- GambleGame::START if session.kind == GAMBLE
                task_ports <- BluffGame::START if session.kind == BLUFF
                task_ports <- BanditGame::START if session.kind == EXPLORE_EXPLOIT
                task_ports <- InsideGame::START if session.kind == INSIDE_OR_OUT
                task_ports <- TouchingGame::START if session.kind == TOUCHING
                task_ports <- CrossingsGame::START if session.kind == CROSSINGS
                task_ports <- MirrorGame::START if session.kind == MIRROR
                task_ports <- RoomsGame::START if session.kind == ROOMS
                task_ports <- 13 if session.kind == NOTEBOOK
                task_ports <- 1 if session.kind == HOLD_IT
                task_ports <- 1 if session.kind == TIME_IT
                task_ports <- 1 if session.kind == BEAT
                task_ports <- 8 if session.kind == CATCH
                task_ports <- 9 if session.kind == ECHO_CAVE
                task_ports <- 10 if session.kind == DRONE_HOOPS
                task_ports <- 25 if session.kind == FIELD_MANUAL
                task_ports <- 41 if session.kind == SAFECRACKER
                task_ports <- 19 if session.kind == STAGEHAND
                task_ports <- 20 if session.kind == LOADING_DOCK
                task_ports <- 15 if session.kind == GUNSLINGER
                task_ports <- DrShape::MOST if session.kind == DRSHAPE
                task_ports <- Tuner::PORTS if session.kind == TUNER
                task_ports <- ShadowPlay::PORTS if session.kind == SHADOW_PLAY
                task_ports <- 1 if session.kind == GLIDER
                task_ports <- 2 if session.kind == BALANCE
                task_ports <- 2 if session.kind == JUGGLER
                task_ports <- 5 if session.kind == LANDER
                return 0 if port >= session.ports or (port >= task_ports and not session.neutral)
                if port < task_ports and session.kind != HOLD_IT:
                    if session.kind == TRIAGE:
                        _ = SDLTriage::action(session.task, port, timestamp_ns / 1000000)
                    elif session.kind == POINT_OF_VIEW:
                        _ = SDLPov::action(session.task, port, timestamp_ns / 1000000)
                    elif session.kind == CAPTCHA:
                        _ = SDLCaptcha::agent_action(session.task, port) can Global{Read,Write}
                    elif session.kind == SIGNALS:
                        _ = SDLSignals::agent_action(session.task, port) can Global{Read,Write}
                    elif session.kind == FOLD_IT:
                        _ = SDLFoldIt::agent_action(session.task, port) can Global{Read,Write}
                    elif session.kind == WHO_KNOWS_WHAT:
                        _ = SDLBeliefs::agent_action(session.task, port) can Global{Read,Write}
                    elif session.kind == SONAR:
                        _ = SDLSonar::agent_action(session.task, port)
                    elif session.kind == GAMBLE:
                        _ = SDLGamble::agent_action(session.task, port) can Global{Read,Write}
                    elif session.kind == BLUFF:
                        _ = SDLBluff::agent_action(session.task, port) can Global{Read,Write}
                    elif session.kind == EXPLORE_EXPLOIT:
                        _ = SDLBandit::agent_action(session.task, port)
                    elif session.kind == WILL_IT_FALL:
                        _ = SDLFalls::key(session.task, 49 + port, timestamp_ns / 1000000)
                    elif session.kind == INSIDE_OR_OUT:
                        _ = SDLInside::action(session.task, port, timestamp_ns / 1000000)
                    elif session.kind == TOUCHING:
                        _ = SDLTouching::action(session.task, port, timestamp_ns / 1000000)
                    elif session.kind == CROSSINGS:
                        _ = SDLCrossings::action(session.task, port, timestamp_ns / 1000000)
                    elif session.kind == MIRROR:
                        _ = SDLMirror::action(session.task, port, timestamp_ns / 1000000)
                    elif session.kind == ROOMS:
                        _ = SDLRooms::action(session.task, port, timestamp_ns / 1000000)
                    elif session.kind == NOTEBOOK:
                        _ = SDLNotebook::action(session.task, port, timestamp_ns / 1000000)
                    else:
                        _ = (clocked_event(session.kind, session.task, session.seconds, port) can Global{Read,Write})
                session.port <- port
                session.receipt_stamp <- timestamp_ns
                session.timestamp_ns <- timestamp_ns
                return session.receipt

    def catch_act_mask(handle: i64, mask: i64, timestamp_ns: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return 0 if handle <= 0 or mask <= 0 or mask > 255
            trusted Unsafe.PointerCast:
                session: mutable heap Session& = handle.uintptr().cast[mutable heap Session&]
                return 0 if session.kind != CATCH or session.publication_pending or session.port >= 0
                return 0 if session.receipt == 0 or timestamp_ns < session.timestamp_ns
                return 0 if not SDLCatch::agent_mask(session.task, mask)
                session.port <- 256 + mask
                session.receipt_stamp <- timestamp_ns
                session.timestamp_ns <- timestamp_ns
                return session.receipt
    def echo_cave_act_mask(handle: i64, mask: i64, timestamp_ns: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return 0 if handle <= 0 or mask <= 0 or mask > 511
            trusted Unsafe.PointerCast:
                session: mutable heap Session& = handle.uintptr().cast[mutable heap Session&]
                return 0 if session.kind != ECHO_CAVE or session.publication_pending or session.port >= 0
                return 0 if session.receipt == 0 or timestamp_ns < session.timestamp_ns
                return 0 if not SDLEchoCave::agent_mask(session.task, mask)
                session.port <- 512 + mask
                session.receipt_stamp <- timestamp_ns
                session.timestamp_ns <- timestamp_ns
                return session.receipt
    def drone_hoops_act_mask(handle: i64, mask: i64, timestamp_ns: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return 0 if handle <= 0 or mask <= 0 or mask > 1023
            trusted Unsafe.PointerCast:
                session: mutable heap Session& = handle.uintptr().cast[mutable heap Session&]
                return 0 if session.kind != DRONE_HOOPS or session.publication_pending or session.port >= 0
                return 0 if session.receipt == 0 or timestamp_ns < session.timestamp_ns
                return 0 if not SDLDroneHoops::agent_mask(session.task, mask)
                session.port <- 1024 + mask
                session.receipt_stamp <- timestamp_ns
                session.timestamp_ns <- timestamp_ns
                return session.receipt

    def publish(handle: i64, elapsed_seconds: f64, timestamp_ns: i64,
                frame: mutable u8&?, capacity: i64, width: i32, height: i32, black: i64,
                result: mutable Publication&?) -> i64:
        can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
            return 0 if handle <= 0 or frame == null or result == null
            return 0 if width <= 0.i32() or height <= 0.i32() or width > 536870911.i32()
            bytes: i64 = width.i64() * height.i64() * 4
            return 0 if bytes > Sha256::MAX_BYTES or capacity < bytes + FrameExport::HEADER_BYTES
            buffer: mutable u8& = frame
            output: mutable Publication& = result
            trusted Unsafe.PointerCast:
                session: mutable heap Session& = handle.uintptr().cast[mutable heap Session&]
                return 0 if timestamp_ns < session.timestamp_ns
                if not session.publication_pending:
                    return 0 if not (step(session, elapsed_seconds) can Global{Read,Write})
                    session.publication_pending <- true
                rgba: mutable u8& = &buffer[FrameExport::HEADER_BYTES.usize()]
                drawn: i64 = draw(session, rgba, bytes, black, width, height)
                return 0 if drawn != bytes
                output[0] <- zeroed
                Sha256::digest(rgba, bytes, &output.digest[0])
                session.sequence <- session.sequence + 1
                session.timestamp_ns <- timestamp_ns
                output.frame_seq <- session.sequence
                output.timestamp_ns <- timestamp_ns
                phase: i64 = info(session, 0)
                trial: i64 = info(session, 2)
                output.done <- 1 if phase == TriageGame::FINISHED else 0
                output.trial <- trial
                output.action_port <- -1
                if trial == session.trial and phase != TriageGame::FINISHED:
                    settle(session, output, rgba, bytes, width, height, phase)
                if phase == TriageGame::PLAYING:
                    if trial != session.trial:
                        session.stimulus <- output.digest
                    if trial != session.trial or session.port >= 0:
                        session.receipt <- session.receipt + 1
                        session.receipt_frame <- session.sequence
                        session.receipt_stamp <- timestamp_ns
                        session.port <- -1
                    output.open_receipt <- session.receipt
                else:
                    session.port <- -1
                session.trial <- trial
                session.publication_pending <- false
                _ = FrameExport::write_header(buffer, capacity, session.sequence.u64(), timestamp_ns.u64(), width.u32(), height.u32(), false)
                return bytes + FrameExport::HEADER_BYTES

    def draw(session: Session&, rgba: mutable u8&, bytes: i64, black: i64, width: i32, height: i32) -> i64:
        can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
            return SDLHoldIt::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == HOLD_IT
            return SDLTimeIt::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == TIME_IT
            return SDLBeat::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == BEAT
            return SDLCatch::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == CATCH
            return SDLEchoCave::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == ECHO_CAVE
            return SDLDroneHoops::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == DRONE_HOOPS
            return SDLFieldManual::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == FIELD_MANUAL
            return SDLSafecracker::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == SAFECRACKER
            return SDLStagehand::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == STAGEHAND
            return SDLLoadingDock::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == LOADING_DOCK
            return SDLGunslinger::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == GUNSLINGER
            return SDLDrShape::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == DRSHAPE
            return SDLTuner::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == TUNER
            return SDLShadowPlay::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == SHADOW_PLAY
            return SDLGlider::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == GLIDER
            return SDLBalance::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == BALANCE
            return SDLJuggler::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == JUGGLER
