            return SDLEmotionFaces::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == EMOTION
            return SDLReadingPeople::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == READING_PEOPLE
            return SDLSocialSense::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == SOCIAL_SENSE
            return SDLBadArgument::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == BAD_ARGUMENT
            return SDLSecondThoughts::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == SECOND_THOUGHTS
            return SDLBetweenLines::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == BETWEEN_LINES
            return SDLCrazyCog::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == CRAZY_COG
            return SDLCipherAbyss::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == CIPHER_ABYSS
            return SDLPotter::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == POTTER
            return SDLConductor::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == CONDUCTOR
            return SDLTightrope::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == TIGHTROPE
            return SDLSignPainter::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == SIGN_PAINTER
            return SDLBartender::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == BARTENDER
            return SDLLockPick::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == LOCK_PICK
            return SDLAirHockey::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == AIR_HOCKEY
            return SDLSemaphore::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == SEMAPHORE
            return SDLShadowPuppets::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == SHADOW_PUPPETS
            return SDLNightWatch::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == NIGHT_WATCH
            return SDLKerbside::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == KERBSIDE
            return SDLSteadicam::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == STEADICAM
            return SDLFreeKick::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == FREE_KICK
            return SDLGlove::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == GLOVE
            return SDLByEar::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == BY_EAR
            return SDLPianoTuner::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == PIANO_TUNER
            return SDLCricketHunt::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == CRICKET_HUNT
            return SDLClawMachine::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == CLAW_MACHINE
            return SDLPov::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == POINT_OF_VIEW
            return SDLFalls::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == WILL_IT_FALL
            return SDLCaptcha::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == CAPTCHA
            return SDLSignals::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == SIGNALS
            return SDLFoldIt::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == FOLD_IT
            return SDLBeliefs::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == WHO_KNOWS_WHAT
            return SDLSonar::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == SONAR
            return SDLGamble::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == GAMBLE
            return SDLBluff::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == BLUFF
            return SDLBandit::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == EXPLORE_EXPLOIT
            return SDLInside::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == INSIDE_OR_OUT
            return SDLTouching::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == TOUCHING
            return SDLCrossings::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == CROSSINGS
            return SDLMirror::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == MIRROR
            return SDLRooms::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == ROOMS
            return SDLNotebook::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == NOTEBOOK
            return SDLTriage::rgba_write(rgba, bytes, session.task, black, width, height)

    def settle(session: Session&, output: mutable Publication&, rgba: u8&, bytes: i64, width: i32, height: i32, phase: i64):
        can Abort.Panic:
            judged: bool = phase == TriageGame::JUDGED or phase == TriageGame::FLAGGED
            return if session.receipt == 0 or (not judged and not session.neutral)
            return if session.port < 0 and session.neutral
            labels: mutable PublicOutcome::Labels = zeroed
            if judged or session.kind == DISPATCH:
                label: i64 = PublicOutcome::read(rgba, bytes, width.i64(), height.i64(), &labels)
                return if judged and label != PublicOutcome::HAS_LABEL
            output.outcome_receipt <- session.receipt
            output.outcome_scalar <- labels.scalar
            output.action_port <- session.port
            output.receipt_frame_seq <- session.receipt_frame
            output.receipt_timestamp_ns <- session.receipt_stamp
            output.stimulus_digest <- session.stimulus

export fn nw_triage_agent_create(rung: i64, trials: i64, adaptive: i64, seed: i64, capacity: f64, refill: f64, ports: i64, neutral: bool) -> i64 = SDLTaskAgent::create
export fn nw_triage_agent_destroy(handle: i64) = SDLTaskAgent::close
export fn nw_triage_agent_act(handle: i64, port: i64, timestamp_ns: i64) -> i64 = SDLTaskAgent::act
export fn nw_triage_agent_publish(handle: i64, elapsed_seconds: f64, timestamp_ns: i64, frame: mutable u8&?, capacity: i64, width: i32, height: i32, black: i64, result: mutable SDLTaskAgent::Publication&?) -> i64 = SDLTaskAgent::publish
export fn nw_delay_agent_create(rung: i64, trials: i64, adaptive: i64, seed: i64, ports: i64, neutral: bool) -> i64 = SDLTaskAgent::create_delay
export fn nw_delay_agent_destroy(handle: i64) = SDLTaskAgent::close
export fn nw_delay_agent_act(handle: i64, port: i64, timestamp_ns: i64) -> i64 = SDLTaskAgent::act
export fn nw_delay_agent_publish(handle: i64, elapsed_seconds: f64, timestamp_ns: i64, frame: mutable u8&?, capacity: i64, width: i32, height: i32, black: i64, result: mutable SDLTaskAgent::Publication&?) -> i64 = SDLTaskAgent::publish

export fn nw_stop_switch_agent_create(rung: i64, trials: i64, adaptive: i64, seed: i64, ports: i64, neutral: bool) -> i64 = SDLTaskAgent::create_stop_switch
export fn nw_stop_switch_agent_destroy(handle: i64) = SDLTaskAgent::close
