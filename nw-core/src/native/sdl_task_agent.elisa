export fn nw_hold_it_agent_create(rung: i64, trials: i64, adaptive: i64, seed: i64, ports: i64, neutral: bool) -> i64 = SDLTaskAgent::create_hold_it
export fn nw_hold_it_agent_destroy(handle: i64) = SDLTaskAgent::close
