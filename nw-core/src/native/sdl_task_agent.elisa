    def create_clocked(kind: i64, rung: i64, trials: i64, adaptive: i64, seed: i64, ports: i64, neutral: bool) -> i64:
        can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            return 0 if ports < 2
            task: i64 = SDLStopSwitch::create(rung, trials, adaptive, seed) if kind == STOP_SWITCH else SDLDelay::create(rung, trials, adaptive, seed)
            return 0 if task == 0
            if (clocked_event(kind, task, 0.0, 2) can Global{Read,Write}):
                handle: i64 = allocate_session(task, ports, neutral, kind)
                return handle if handle != 0
            close_task(kind, task) can Global{Read,Write}
            return 0

