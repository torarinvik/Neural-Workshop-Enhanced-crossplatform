            return SDLRover::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == ROVER
            return SDLUnicycle::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == UNICYCLE
            return SDLMorningRound::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == MORNING_ROUND
            return SDLHeavier::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == HEAVIER
            return SDLFullStop::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == FULL_STOP
            return SDLMissingWord::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == MISSING_WORD
            return SDLProofreader::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == PROOFREADER
            return SDLFigures::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == FIGURES
            return SDLWhichFeeling::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == WHICH_FEELING
            return SDLHowStrongly::rgba_write(rgba, bytes, session.task, black, width, height) if session.kind == HOW_STRONGLY
