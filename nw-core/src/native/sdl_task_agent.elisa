export fn nw_time_it_agent_create(rung: i64, trials: i64, adaptive: i64, seed: i64, ports: i64, neutral: bool) -> i64 = SDLTaskAgent::create_time_it
export fn nw_beat_agent_create(rung: i64, trials: i64, adaptive: i64, seed: i64, ports: i64, neutral: bool) -> i64 = SDLTaskAgent::create_beat
