    def clocked_event(kind: i64, task: i64, seconds: f64, port: i64) -> bool:
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            return SDLBalance::agent_event(task, seconds, port) if kind == BALANCE
