    const TOUCHING: i64 = 10
    const CROSSINGS: i64 = 11

    struct Session:
        task: mutable i64
        sequence: mutable i64
        timestamp_ns: mutable i64
        receipt: mutable i64
        receipt_frame: mutable i64
        receipt_stamp: mutable i64
        port: mutable i64
        trial: mutable i64
        stimulus: mutable u8[64]
        publication_pending: mutable bool
        neutral: mutable bool
        ports: mutable i64
        kind: mutable i64
        seconds: mutable f64

    # Stable C layout: ten 64-bit fields followed by two SHA-256 strings.
    struct Publication:
        frame_seq: mutable i64
        timestamp_ns: mutable i64
        done: mutable i64
        open_receipt: mutable i64
        outcome_receipt: mutable i64
        outcome_scalar: mutable f64
        action_port: mutable i64
        receipt_frame_seq: mutable i64
        receipt_timestamp_ns: mutable i64
        trial: mutable i64
        digest: mutable u8[64]
        stimulus_digest: mutable u8[64]

    def allocate_session(task: i64, ports: i64, neutral: bool, kind: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            if malloc(size_of(Session).usize()) is memory:
                trusted Unsafe.PointerCast:
                    session: mutable heap Session& = memory.cast[mutable heap Session&]
                    session[0] <- zeroed
                    session.task <- task
                    session.port <- -1
                    session.ports <- ports
                    session.neutral <- neutral
                    session.kind <- kind
                    session.publication_pending <- true
                    return memory.uintptr().i64()
            return 0

    def create(rung: i64, trials: i64, adaptive: i64, seed: i64, capacity: f64, refill: f64, ports: i64, neutral: bool) -> i64:
        can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            return 0 if ports < 17
            task: i64 = SDLTriage::create(rung, trials, adaptive, seed)
            return 0 if task == 0
            if SDLTriage::think_configure(task, capacity, refill) and SDLTriage::action(task, TriageGame::START, 0):
                handle: i64 = allocate_session(task, ports, neutral, TRIAGE)
                return handle if handle != 0
            SDLTriage::close(task)
            return 0

    def create_notebook(rung: i64, trials: i64, adaptive: i64, seed: i64, capacity: f64, refill: f64, ports: i64, neutral: bool) -> i64:
        can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            return 0 if ports < 13 or rung > NotebookGame::MAX_AGENT_RUNG
            task: i64 = SDLNotebook::create(rung, trials, adaptive, seed)
            return 0 if task == 0
            if SDLNotebook::think_configure(task, capacity, refill) and SDLNotebook::action(task, NotebookGame::START, 0):
                handle: i64 = allocate_session(task, ports, neutral, NOTEBOOK)
                return handle if handle != 0
