def sdl_jigsaw_seen(data: heap u8&, size: i64, name: cstr) -> bool:
    can Abort.Panic, Unsafe.PointerCast:
        length: i64 = SDL_strlen(name).i64()
        line: mutable i64 = 0
        trusted Unsafe.PointerCast:
            while line < size |line, size, data, name, length|:
                end: mutable i64 = line
                while end < size and data[end.usize()] != 10.u8() |end, size, data|:
                    end <- end + 1
                first: i64 = sdl_config_trim_left(data, line, end)
                last: i64 = sdl_config_trim_right(data, first, end)
                return true if last - first == length and SDL_strncmp((&data[first.usize()]).cast[cstr], name, length.usize()) == 0.i32()
                line <- end + 1
        return false

def sdl_jigsaw_note_photo(path: u8&, name: cstr, reset: bool):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        record: mutable dstr = []
        dstr_append_cstr(&record, name)
        record.push(10.u8())
        trusted Unsafe.PointerCast:
            if reset:
                temporary: mutable u8[4200] = zeroed
                if SyllogismOptionsHost::temporary((&temporary[0]).uintptr().i64(), 4200, path.uintptr().i64()) >= 0:
                    _ = numberology_results_write(&temporary[0], path, &record[0], record.count.usize())
            else:
                _ = sdl_append_file(path.cast[cstr], &record[0], record.count.usize())

def sdl_jigsaw_choose_photo(run: mutable JigsawGame::JigsawRun&, history: cstr = "/datasets/div2k/seen.txt") -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: mutable u8[4096] = zeroed
        size: mutable i64 = 0
        unseen: mutable darray[i64] = []
        session_fresh: mutable darray[i64] = []
        trusted Unsafe.PointerCast:
            target: mutable u8& = &path[0]
            has_path: bool = sdl_data_path(target, 4096.usize(), history, 0, true) != 0.i32()
            raw: mutable heap void&? = sdl_read_corpus(target, &size) if has_path else null
            files: heap usize& = run.photo_files.cast[heap usize&]
            for item in 0..<run.photo_count |item, raw, size, files, run, unseen, session_fresh|:
                name: cstr = files[item.usize()].cast[cstr]
                present: mutable bool = false
                if raw != null and size <= 1048576:
                    data: heap void& = raw
                    present <- sdl_jigsaw_seen(data.cast[heap u8&], size, name)
                if not present:
                    unseen.push(item)
                shown: mutable bool = false
                for prior in 0..<(run.puzzle - 1) |prior, run, item, shown|:
                    shown <- true if run.photo_shown[prior.usize()] == item
                if not shown:
                    session_fresh.push(item)
            SDL_free(raw) if raw != null
            reset: bool = unseen.count == 0
            pick: mutable i64 = 0
            if not reset:
                pick <- unseen[py_randbelow(&run.photo_rng, unseen.count.u64()).usize()]
            elif session_fresh.count > 0:
                pick <- session_fresh[py_randbelow(&run.photo_rng, session_fresh.count.u64()).usize()]
            else:
                pick <- py_randbelow(&run.photo_rng, run.photo_count.u64()).i64()
            if has_path:
                sdl_jigsaw_note_photo(target, files[pick.usize()].cast[cstr], reset)
            run.photo_shown[(run.puzzle - 1).usize()] <- pick
            return pick

# The catalog belongs to the Jigsaw run. SDL owns the texture until the
# puzzle changes or its renderer is destroyed.
def sdl_jigsaw_photo_size(renderer: mutable void&, handle: i64, properties: u32) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        loader: i64 = SDL_GetNumberProperty(properties, "nw.png.loader", 0)
        return 0 if loader == 0
        path: mutable u8[4096] = zeroed
        trusted Unsafe.PointerCast:
            target: mutable u8& = &path[0]
            if handle > 0:
                run: mutable heap JigsawGame::JigsawRun& = handle.uintptr().cast[mutable heap JigsawGame::JigsawRun&]
                if run.phase == JigsawGame::PHASE_SOLVING or run.phase == JigsawGame::PHASE_SOLVED:
                    if not run.photo_catalog_loaded:
                        run.photo_catalog_loaded <- true
                        if sdl_data_path(target, 4096.usize(), "/datasets/div2k", 0, true) != 0.i32():
                            count: mutable i32 = 0.i32()
                            if SDL_GlobDirectory(target.cast[cstr], "*.png", 0.u32(), (&count).uintptr()) is files:
                                SDL_qsort(files, count.usize(), size_of(usize).usize(), sdl_compare_media_name)
                                run.photo_files <- files.uintptr()
                                run.photo_count <- count.i64()
                        target[0] <- 0.u8()
                    if run.photo_count > 0:
                        if run.photo_puzzle != run.puzzle:
                            run.photo_item <- sdl_jigsaw_choose_photo(run)
                            run.photo_puzzle <- run.puzzle
                        item: i64 = run.photo_item
                        target[0] <- 0.u8() if not sdl_catalog_path(target, "/datasets/div2k/", run.photo_files, item)
            current: cstr = target.cast[cstr]
            previous: cstr = SDL_GetStringProperty(properties, "nw.jigsaw.path", "")
            if SDL_strcmp(current, previous) != 0.i32():
                if SDL_GetPointerProperty(properties, "nw.jigsaw.texture", null) is old:
                    _ = SDL_ClearProperty(properties, "nw.jigsaw.texture")
                    SDL_DestroyTexture(old)
                _ = SDL_SetStringProperty(properties, "nw.jigsaw.path", current)
                if target[0] != 0.u8():
                    load: fn(cstr) -> mutable void&? = loader.uintptr().cast[fn(cstr) -> mutable void&?]
                    if load(current) is surface:
                        texture: mutable void&? = SDL_CreateTextureFromSurface(renderer, surface)
                        SDL_DestroySurface(surface)
                        if texture is ready:
                            if not SDL_SetPointerProperty(properties, "nw.jigsaw.texture", ready):
                                SDL_DestroyTexture(ready)
            return 0 if handle <= 0 or target[0] == 0.u8()
            if SDL_GetPointerProperty(properties, "nw.jigsaw.texture", null) is photo:
                width: mutable f32 = 0.0.f32()
                height: mutable f32 = 0.0.f32()
                if SDL_GetTextureSize(photo, &width, &height):
                    return (width if width < height else height).i64()
            return 0

def sdl_jigsaw_photo(renderer: mutable void&, handle: i64) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        properties: u32 = SDL_GetRendererProperties(renderer)
        if handle > 0:
            trusted Unsafe.PointerCast:
                candidate: mutable heap JigsawGame::JigsawRun& = handle.uintptr().cast[mutable heap JigsawGame::JigsawRun&]
                if candidate.video:
                    return sdl_jigsaw_video(renderer, properties, candidate)
        sdl_jigsaw_clear_video_texture(properties)
        size: i64 = sdl_jigsaw_photo_size(renderer, handle, properties)
        return false if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap JigsawGame::JigsawRun& = handle.uintptr().cast[mutable heap JigsawGame::JigsawRun&]
            if run.phase == JigsawGame::PHASE_SOLVING and not run.photo_timed:
                # Start the shared clock after the catalog and texture work.
                playable_size: i64 = size if size >= 2 else 0
                _ = JigsawGame::apply(run, JigsawGame::ACTION_FIT_PHOTO, playable_size, SDL_GetTicks().i64())
            return false if size < 2 or size < run.trial_side or size < run.trial_rows
            _ = SDL_SetNumberProperty(properties, "nw.jigsaw.columns", run.trial_side)
            _ = SDL_SetNumberProperty(properties, "nw.jigsaw.rows", run.trial_rows)
            return true
