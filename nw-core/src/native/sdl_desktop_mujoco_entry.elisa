extern nw_sdl_marble_advance(slot: mutable usize&, handle: i64, screenshot: usize, tick: mutable u64&) -> i32
extern nw_sdl_marble_key(state: mutable void&, slot: mutable usize&, rows: usize&, key: i64, tick: mutable u64&) -> i32
extern nw_sdl_marble_finish_frame(state: mutable void&, renderer: mutable void&, physics: usize, screenshot: usize, data: u8&?, length: i64, width: i32, height: i32, trial: i64, black: i64) -> i32
extern nw_sdl_marble_close(state: mutable void&, slot: mutable usize&)
extern nw_marble_set_png_loader(loader: usize)
extern nw_sdl_marble_startup_status(argc: i64, argv: usize&?) -> i32

def sdl_entry_marble(bindings: mutable SDLDesktopBindings&):
    can Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            advance: fn(mutable usize&, i64, usize, mutable u64&) -> i32 = nw_sdl_marble_advance
            key: fn(mutable void&, mutable usize&, usize&, i64, mutable u64&) -> i32 = nw_sdl_marble_key
            finish: fn(mutable void&, mutable void&, usize, usize, u8&?, i64, i32, i32, i64, i64) -> i32 = nw_sdl_marble_finish_frame
            close: fn(mutable void&, mutable usize&) -> void = nw_sdl_marble_close
            png: fn(usize) -> void = nw_marble_set_png_loader
            startup: fn(i64, usize&?) -> i32 = nw_sdl_marble_startup_status
            bindings.marble_advance <- advance.cast[usize]
            bindings.marble_key <- key.cast[usize]
            bindings.marble_finish <- finish.cast[usize]
            bindings.marble_close <- close.cast[usize]
            bindings.marble_set_png_loader <- png.cast[usize]
            bindings.marble_startup_status <- startup.cast[usize]
