# Shared Syllogism option rules. The native host calls these through its C ABI;
# platform file access stays at the host boundary during the SDL migration.
module SyllogismOptions:
    def allowed(row: i64, value: i64) -> bool:
        if row == 0:
            return value >= 1 and value <= 12
        if row == 1:
            return value == 1 or value == 2 or value == 3 or value == 5 or value == 6 or value == 8 or value == 10 or value == 15
        if row >= 2 and row <= 4:
            return value == 0 or value == 1
        return false

    def whitespace(byte: i64) -> bool:
        return byte == 32 or (byte >= 9 and byte <= 13)

    # Parse one nonnegative saved field, including Python's digit separators.
    def saved_integer(bytes: heap u8&, length: i64, cursor: mutable i64&) -> i64:
        can Abort.Panic:
            at: mutable i64 = cursor[0]
            while at < length and whitespace(bytes[at.usize()].i64()) |at, bytes, length|:
                at <- at + 1
            return -1 if at >= length
            negative: bool = bytes[at.usize()] == 45.u8()
            at <- at + 1 if negative or bytes[at.usize()] == 43.u8()
            value: mutable i64 = 0
            needs_digit: mutable bool = true
            while at < length and not whitespace(bytes[at.usize()].i64()) |at, bytes, length, needs_digit, value|:
                byte: u8 = bytes[at.usize()]
                if byte == 95.u8() and not needs_digit:
                    needs_digit <- true
                else:
                    digit: i64 = byte.i64() - 48
                    return -1 if digit < 0 or digit > 9
                    return -1 if value > 922337203685477580 or (value == 922337203685477580 and digit > 7)
                    value <- value * 10 + digit
                    needs_digit <- false
                at <- at + 1
            return -1 if needs_digit or (negative and value != 0)
            cursor[0] <- at
            return value

    def decode(data: i64, length: i64, selected: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return -1 if data == 0 or length <= 0 or length > 256 or selected < 0 or selected > 4
            fields: mutable i64[5] = zeroed
            at: mutable i64 = 0
            trusted Unsafe.PointerCast:
                bytes: heap u8& = data.uintptr().cast[heap u8&]
                for row in 0..<5 |row, at, length, bytes, fields|:
                    value: i64 = saved_integer(bytes, length, &at)
                    return -1 if not allowed(row, value)
                    fields[row.usize()] <- value
                while at < length and whitespace(bytes[at.usize()].i64()) |at, length, bytes|:
                    at <- at + 1
                return -1 if at != length
                return fields[selected.usize()]

    def encode(dest: i64, capacity: i64, level: i64, trials: i64,
               working: i64, adaptive: i64, real_words: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return -1 if dest == 0 or capacity < 0
            values: i64[5] = [level, trials, working, adaptive, real_words]
            needed: mutable i64 = 0
            for row in 0..<5 |row, values, needed|:
                value: i64 = values[row.usize()]
                return -1 if not allowed(row, value)
                needed <- needed + (2 if value >= 10 else 1) + 1
            return -1 if capacity < needed
            at: mutable i64 = 0
            trusted Unsafe.PointerCast:
                out: mutable heap u8& = dest.uintptr().cast[mutable heap u8&]
                for row in 0..<5 |row, values, out, at|:
                    value: i64 = values[row.usize()]
                    if value >= 10:
                        out[at.usize()] <- (48 + value / 10).u8()
                        at <- at + 1
                    out[at.usize()] <- (48 + value % 10).u8()
                    at <- at + 1
                    out[at.usize()] <- (10 if row == 4 else 32).u8()
                    at <- at + 1
            return needed

    def nonnegative_argument(data: i64, length: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return -1 if data == 0 or length <= 0
            at: mutable i64 = 0
            trusted Unsafe.PointerCast:
                bytes: heap u8& = data.uintptr().cast[heap u8&]
                value: i64 = saved_integer(bytes, length, &at)
                return -1 if value < 0
                while at < length and whitespace(bytes[at.usize()].i64()) |at, length, bytes|:
                    at <- at + 1
                return value if at == length else -1

    def parse_argument(data: i64, length: i64, row: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            value: i64 = nonnegative_argument(data, length)
            return value if allowed(row, value) else -1

    def trial_at(index: i64) -> i64:
        if index == 0: return 1
        if index == 1: return 2
        if index == 2: return 3
        if index == 3: return 5
        if index == 4: return 6
        if index == 5: return 8
        if index == 6: return 10
        return 15

    def cycle(row: i64, value: i64, step: i64) -> i64:
        can Abort.Panic:
            return value if not allowed(row, value)
            if row == 0:
                return 12 if step < 0 and value == 1
                return 1 if step >= 0 and value == 12
                return value - 1 if step < 0 else value + 1
            if row == 1:
                index: mutable i64 = 0
                while index < 8 |index, value|:
                    break if trial_at(index) == value
                    index <- index + 1
                return trial_at((index + (7 if step < 0 else 1)) % 8)
            return 1 - value

def syllogism_option_allowed(row: i64, value: i64) -> i64:
    return 1 if SyllogismOptions::allowed(row, value) else 0

def syllogism_option_decode(data: i64, length: i64, row: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return SyllogismOptions::decode(data, length, row)

def syllogism_option_parse_argument(data: i64, length: i64, row: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return SyllogismOptions::parse_argument(data, length, row)

def syllogism_option_encode(dest: i64, capacity: i64, level: i64, trials: i64,
                            working: i64, adaptive: i64, real_words: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return SyllogismOptions::encode(dest, capacity, level, trials, working, adaptive, real_words)

def syllogism_option_cycle(row: i64, value: i64, step: i64) -> i64:
    can Abort.Panic:
        return SyllogismOptions::cycle(row, value, step)

export fn nw_syllogism_option_allowed(row: i64, value: i64) -> i64 = syllogism_option_allowed
export fn nw_syllogism_option_cycle(row: i64, value: i64, step: i64) -> i64 = syllogism_option_cycle

export fn nw_syllogism_option_decode(data: i64, length: i64, row: i64) -> i64 = syllogism_option_decode
export fn nw_syllogism_option_parse_argument(data: i64, length: i64, row: i64) -> i64 = syllogism_option_parse_argument
export fn nw_syllogism_option_encode(dest: i64, capacity: i64, level: i64, trials: i64, working: i64, adaptive: i64, real_words: i64) -> i64 = syllogism_option_encode
