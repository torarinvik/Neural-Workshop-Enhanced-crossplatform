extern glGenTextures(count: i32, textures: mutable u32&) can[Memory.Allocate]
extern glDeleteTextures(count: i32, textures: u32&) can[Memory.Release]
extern glBindTexture(target: u32, texture: u32)
extern glTexParameteri(target: u32, name: u32, value: i32)
extern glTexImage2D(target: u32, level: i32, internal: i32, width: i32, height: i32, border: i32, format: u32, kind: u32, pixels: usize) can[Memory.Allocate]
extern glGenFramebuffers(count: i32, buffers: mutable u32&) can[Memory.Allocate]
extern glDeleteFramebuffers(count: i32, buffers: u32&) can[Memory.Release]
extern glBindFramebuffer(target: u32, buffer: u32)
extern glFramebufferTexture2D(target: u32, attachment: u32, texture_target: u32, texture: u32, level: i32)
extern glCheckFramebufferStatus(target: u32) -> u32
extern glDrawBuffer(buffer: u32)
extern glReadBuffer(buffer: u32)
extern glViewport(x: i32, y: i32, width: i32, height: i32)
extern glUseProgram(program: u32)
extern glGetUniformLocation(program: u32, name: cstr) -> i32
extern glUniformMatrix4fv(location: i32, count: i32, transpose: u8, value: f32&)
extern glUniform1i(location: i32, value: i32)
extern glUniform4fv(location: i32, count: i32, value: f32&)
extern glEnable(capability: u32)
extern glDisable(capability: u32)
extern glDepthMask(enabled: u8)
extern glDepthFunc(compare: u32)
extern glClearDepth(depth: f64)
extern glClear(mask: u32)

module MarbleGLShadow:
    const SIZE: i32 = 1024
    const TEXTURE_2D: u32 = 3553
    const FRAMEBUFFER: u32 = 36160

    struct Target:
        texture: mutable u32
        framebuffer: mutable u32

    def close(target: mutable Target&):
        can Memory.Release:
            glDeleteFramebuffers(1.i32(), &target.framebuffer)
            glDeleteTextures(1.i32(), &target.texture)
            target.framebuffer <- 0.u32()
            target.texture <- 0.u32()

    def open(target: mutable Target&) -> bool:
        can Memory.Allocate, Memory.Release:
            close(target)
            glGenTextures(1.i32(), &target.texture)
            glGenFramebuffers(1.i32(), &target.framebuffer)
            if target.texture == 0.u32() or target.framebuffer == 0.u32():
                close(target)
                return false
            glBindTexture(TEXTURE_2D, target.texture)
            glTexImage2D(TEXTURE_2D, 0.i32(), 33190.i32(), SIZE, SIZE, 0.i32(), 6402.u32(), 5125.u32(), 0.usize())
            glTexParameteri(TEXTURE_2D, 10241.u32(), 9728.i32())
            glTexParameteri(TEXTURE_2D, 10240.u32(), 9728.i32())
            glTexParameteri(TEXTURE_2D, 10242.u32(), 33071.i32())
            glTexParameteri(TEXTURE_2D, 10243.u32(), 33071.i32())
            glBindFramebuffer(FRAMEBUFFER, target.framebuffer)
            glFramebufferTexture2D(FRAMEBUFFER, 36096.u32(), TEXTURE_2D, target.texture, 0.i32())
            glDrawBuffer(0.u32())
            glReadBuffer(0.u32())
            complete: bool = glCheckFramebufferStatus(FRAMEBUFFER) == 36053.u32()
            glBindFramebuffer(FRAMEBUFFER, 0.u32())
            glBindTexture(TEXTURE_2D, 0.u32())
            if not complete:
                close(target)
            return complete

    def matrix(program: u32, name: cstr, packet: f64&, start: i64):
        can Abort.Panic:
            values: mutable f32[16] = zeroed
            for at in 0..<16 |at, values, packet, start|:
                values[at.usize()] <- packet[(start + at).usize()].f32()
            glUniformMatrix4fv(glGetUniformLocation(program, name), 1.i32(), 0.u8(), &values[0])

    def begin(target: Target&, program: u32, packet: f64&):
        can Abort.Panic:
            glBindFramebuffer(FRAMEBUFFER, target.framebuffer)
            glViewport(0.i32(), 0.i32(), SIZE, SIZE)
            glEnable(2929.u32()) # GL_DEPTH_TEST
            glDepthFunc(513.u32()) # GL_LESS
            glDepthMask(1.u8())
            glDisable(3042.u32()) # GL_BLEND
            glDisable(2884.u32()) # GL_CULL_FACE
            glDisable(3089.u32()) # GL_SCISSOR_TEST
            glDisable(32926.u32()) # GL_SAMPLE_ALPHA_TO_COVERAGE
            glClearDepth(1.0)
            glClear(256.u32()) # GL_DEPTH_BUFFER_BIT
            glUseProgram(program)
            matrix(program, "light_clip", packet, 40)
            holes(program, packet)

    def holes(program: u32, packet: f64&):
        can Abort.Panic:
            values: mutable f32[384] = zeroed
            count: i64 = packet[2].i64()
            for at in 0..<(count * 4) |at, values, packet|:
                values[at.usize()] <- packet[(72 + at).usize()].f32()
            glUniform1i(glGetUniformLocation(program, "hole_count"), count.i32())
            glUniform4fv(glGetUniformLocation(program, "holes[0]"), count.i32(), &values[0])

    def draw(program: u32, mesh: MarbleGLMesh::Mesh&, packet: f64&, model: i64, cut_holes: bool):
        can Abort.Panic:
            matrix(program, "model", packet, model)
            glUniform1i(glGetUniformLocation(program, "cut_holes"), 1.i32() if cut_holes else 0.i32())
            MarbleGLMesh::draw(mesh, program)
