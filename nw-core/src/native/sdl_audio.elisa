# A WAV cue owns one playback stream. Callers keep the handle until the
# cue drains or their task stops. Separate streams allow overlapping cues.
extern SDL_LoadWAV(path: cstr, spec: mutable void&, data: mutable usize&, length: mutable u32&) -> bool can[Blocking.IO]
extern SDL_OpenAudioDeviceStream(device: u32, spec: void&, callback: void&?, userdata: void&?) -> mutable void&?
extern SDL_DestroyAudioStream(stream: mutable void&)
extern SDL_SetAudioStreamGain(stream: mutable void&, gain: f32) -> bool
extern SDL_PutAudioStreamData(stream: mutable void&, data: void&, length: i32) -> bool
extern SDL_FlushAudioStream(stream: mutable void&) -> bool
extern SDL_ResumeAudioStreamDevice(stream: mutable void&) -> bool
extern SDL_GetAudioStreamQueued(stream: mutable void&) -> i32

module SDLAudio:
    const INIT_AUDIO: u32 = 16.u32()
    const DEFAULT_PLAYBACK: u32 = 0xffffffff.u32()

    struct Spec:
        format: mutable u32
        channels: mutable i32
        frequency: mutable i32

    def play_wav(path: cstr, gain: f32) -> mutable void&?:
        can Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast:
            return null if not (gain > 0.0.f32())
            spec: mutable Spec = zeroed
            data: mutable usize = 0.usize()
            length: mutable u32 = 0.u32()
            trusted Unsafe.PointerCast:
                spec_out: mutable void& = (&spec).uintptr().cast[mutable void&]
                return null if not SDL_LoadWAV(path, spec_out, &data, &length)
                samples: heap void& = data.uintptr().cast[heap void&]
                stream: mutable void&? = null
                if length > 0.u32() and length <= 2147483647.u32() and SDL_InitSubSystem(INIT_AUDIO):
                    stream <- SDL_OpenAudioDeviceStream(DEFAULT_PLAYBACK, spec_out, null, null)
                    if stream != null:
                        voice: mutable void& = stream
                        if not (SDL_SetAudioStreamGain(voice, gain) and SDL_PutAudioStreamData(voice, samples, length.i32()) and SDL_FlushAudioStream(voice) and SDL_ResumeAudioStreamDevice(voice)):
                            SDL_DestroyAudioStream(voice)
                            stream <- null
                    if stream == null:
                        SDL_QuitSubSystem(INIT_AUDIO)
                SDL_free(samples)
                return stream

    def play_pcm(data: void&, length: i32, rate: i32) -> mutable void&?:
        can Abort.Panic, Memory.Release, Unsafe.PointerCast:
            return null if length <= 0.i32() or rate <= 0.i32()
            return null if not SDL_InitSubSystem(INIT_AUDIO)
            spec: Spec = Spec{format: 0x8010.u32(), channels: 2.i32(), frequency: rate}
            trusted Unsafe.PointerCast:
                if SDL_OpenAudioDeviceStream(DEFAULT_PLAYBACK, (&spec).uintptr().cast[void&], null, null) is stream:
                    if SDL_PutAudioStreamData(stream, data, length) and SDL_FlushAudioStream(stream) and SDL_ResumeAudioStreamDevice(stream):
                        return stream
                    SDL_DestroyAudioStream(stream)
            SDL_QuitSubSystem(INIT_AUDIO)
            return null

    def start_pcm(rate: i32) -> mutable void&?:
        can Abort.Panic, Unsafe.PointerCast:
            return null if rate <= 0.i32() or not SDL_InitSubSystem(INIT_AUDIO)
            spec: Spec = Spec{format: 0x8010.u32(), channels: 2.i32(), frequency: rate}
            trusted Unsafe.PointerCast:
                if SDL_OpenAudioDeviceStream(DEFAULT_PLAYBACK, (&spec).uintptr().cast[void&], null, null) is stream:
                    if SDL_ResumeAudioStreamDevice(stream):
                        return stream
                    SDL_DestroyAudioStream(stream)
            SDL_QuitSubSystem(INIT_AUDIO)
            return null

    def queued(stream: mutable void&) -> i32:
        return SDL_GetAudioStreamQueued(stream)

    def stop(stream: mutable void&):
        SDL_DestroyAudioStream(stream)
        SDL_QuitSubSystem(INIT_AUDIO)

export fn nw_sdl_audio_play_wav(path: cstr, gain: f32) -> mutable void&? = SDLAudio::play_wav
export fn nw_sdl_audio_queued(stream: mutable void&) -> i32 = SDLAudio::queued
export fn nw_sdl_audio_stop(stream: mutable void&) = SDLAudio::stop
