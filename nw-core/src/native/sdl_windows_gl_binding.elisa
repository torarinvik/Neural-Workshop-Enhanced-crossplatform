static if ELISA_TARGET_OS_WINDOWS:
    extern nw_marble_windows_gl_name(index: u32) -> u8&?
    extern nw_marble_bind_windows_gl(index: u32, procedure: void&)
    extern SDL_GL_GetProcAddress(name: cstr) -> void&?

def sdl_prepare_windows_gl() -> bool:
    can Abort.Panic, Unsafe.PointerCast:
        static if ELISA_TARGET_OS_WINDOWS:
            index: mutable u32 = 0.u32()
            trusted Unsafe.PointerCast:
                while nw_marble_windows_gl_name(index) is bytes |index|:
                    name: cstr = bytes.cast[cstr]
                    procedure: void&? = SDL_GL_GetProcAddress(name)
                    if procedure == null:
                        return SDL_SetError("Missing OpenGL entry point %s", name)
                    bound: void& = procedure
                    nw_marble_bind_windows_gl(index, bound)
                    index <- index + 1.u32()
        return true
