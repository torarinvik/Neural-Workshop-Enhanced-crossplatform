extern SDL_strncasecmp(left: cstr, right: cstr, length: usize) -> i32

# Decode only the record written by Python's default Pickler, with one
# short UTF-8 string under USER. No pickle instructions are executed.
def sdl_saved_profile_name(record: heap u8&, size: i64, suffix: mutable u8&) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return 0 if size < 26 or size > 280
        return 0 if record[0] != 128.u8() or (record[1] != 4.u8() and record[1] != 5.u8()) or record[2] != 149.u8()
        frame: i64 = record[3].i64() + 256 * record[4].i64()
        return 0 if frame != size - 11
        for at in 5..<11 |record|:
            return 0 if record[at.usize()] != 0.u8()
        prefix: u8[10] = [125, 148, 140, 4, 85, 83, 69, 82, 148, 140]
        for at in 0..<10 |record, prefix|:
            return 0 if record[(11 + at).usize()] != prefix[at.usize()]
        length: i64 = record[21].i64()
        return 0 if size != length + 25 or length == 0
        return 0 if record[(size - 3).usize()] != 148.u8() or record[(size - 2).usize()] != 115.u8() or record[(size - 1).usize()] != 46.u8()
        trusted Unsafe.PointerCast:
            return sdl_named_profile_suffix((&record[22]).cast[u8&], length, suffix)

def sdl_profile_name_valid(name: u8&, length: i64) -> bool:
    can Abort.Panic:
        return false if length <= 0 or length > 255
        for at in 0..<length |at, name|:
            byte: u8 = name[at.usize()]
            return false if byte < 32.u8() or byte == 47.u8() or byte == 92.u8() or byte == 58.u8()
        return true

def sdl_named_profile_suffix(name: u8&, length: i64, suffix: mutable u8&) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return 0 if not sdl_profile_name_valid(name, length)
        trusted Unsafe.PointerCast:
            return 0 if length == 7 and SDL_strncasecmp(name.cast[cstr], "default", 7.usize()) == 0.i32()
            suffix[0] <- 47.u8()
            for at in 0..<length |at, name, suffix|:
                suffix[(at + 1).usize()] <- name[at.usize()]
            return SyllogismOptionsHost::append(suffix.uintptr().i64(), 270, length + 1, "-config.ini")

def sdl_profile_suffix(name: mutable u8&, suffix: mutable u8&) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        if SDL_getenv("NW_SELECTED_USER") is selected:
            trusted Unsafe.PointerCast:
                return sdl_named_profile_suffix(selected, SDL_strlen(selected.cast[cstr]).i64(), suffix)
        size: mutable i64 = 0
        if sdl_data_path(name, 4096.usize(), "/defaults.ini", 0, true) != 0.i32():
            if sdl_read_corpus(name, &size) is raw:
                trusted Unsafe.PointerCast:
                    length: i64 = sdl_saved_profile_name(raw.cast[heap u8&], size, suffix)
                    SDL_free(raw)
                    return length
        return 0

# Named users get their own task sidecars. Default keeps the existing
# filenames used by the Python shell and earlier SDL releases.
def sdl_named_task_settings_path(out: i64, capacity: i64, suffix: cstr, create: bool) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        root: mutable u8[4096] = zeroed
        profile: mutable u8[320] = zeroed
        full: mutable u8[4096] = zeroed
        trusted Unsafe.PointerCast:
            scratch: mutable u8& = &root[0]
            leaf: mutable u8& = &profile[0]
            length: i64 = sdl_profile_suffix(scratch, leaf)
            return -2 if length <= 0
            leaf[length.usize()] <- 46.u8()
            option: u8& = suffix.cast[u8&]
            ending: cstr = (&option[1]).cast[cstr]
            return -1 if SyllogismOptionsHost::append(leaf.uintptr().i64(), 320, length + 1, ending) < 0
            return -1 if sdl_data_path(&full[0], 4096.usize(), leaf.cast[cstr], 0, true) == 0.i32()
            return SyllogismOptionsHost::settings_override(out, capacity, (&full[0]).cast[cstr], create)
