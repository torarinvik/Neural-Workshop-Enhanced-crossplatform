# Optional SDL_ttf adapter, linked only by TrueType-enabled desktop builds.
extern TTF_Init() -> bool
extern TTF_Quit()
extern TTF_OpenFont(path: cstr, points: f32) -> mutable void&? can[Blocking.IO]
extern TTF_CloseFont(font: mutable void&)
extern TTF_AddFallbackFont(font: mutable void&, fallback: mutable void&) -> bool
extern TTF_GetFontDPI(font: mutable void&, horizontal: usize, vertical: usize) -> bool
extern TTF_GetFontSize(font: mutable void&) -> f32
extern TTF_SetFontSizeDPI(font: mutable void&, points: f32, horizontal: i32, vertical: i32) -> bool
extern TTF_GetFontStyle(font: mutable void&) -> u32
extern TTF_SetFontStyle(font: mutable void&, style: u32)
extern TTF_GetFontAscent(font: mutable void&) -> i32
# SDL_Color is four bytes passed in one integer argument on the supported
# little-endian desktop ABIs. Pack its red byte first.
extern TTF_RenderText_Blended(font: mutable void&, text: cstr, length: usize, color: u32) -> mutable void&?

extern SDL_calloc(count: usize, size: usize) -> mutable heap void&? can[Memory.Allocate]
extern SDL_free(data: heap void&) can[Memory.Release]
extern SDL_GetRendererProperties(renderer: mutable void&) -> u32
extern SDL_GetPointerProperty(properties: u32, name: cstr, default_value: void&?) -> mutable heap void&?
extern SDL_SetPointerPropertyWithCleanup(properties: u32, name: cstr, value: mutable heap void&, callback: fn(usize, usize) -> void can[Memory.Release, Unsafe.PointerCast], userdata: void&?) -> bool
extern SDL_SetPointerProperty(properties: u32, name: cstr, value: fn(mutable void&, usize, f32, u32, i32, usize) -> mutable void&? can[Abort.Panic, Unsafe.PointerCast]) -> bool
extern SDL_ClearProperty(properties: u32, name: cstr) -> bool
extern SDL_GetPlatform() -> cstr
extern SDL_strcmp(a: cstr, b: cstr) -> i32
extern SDL_getenv(name: cstr) -> u8&?
extern SDL_snprintf(text: mutable u8&, size: usize, format: cstr, ...) -> i32

struct SDLDesktopFont:
    primary: mutable void&
    fallback: mutable void&?
    faces: mutable usize[16]
    plain: mutable void&?

def sdl_captcha_face_file(slot: i64, platform: i64) -> cstr:
    return ("Arial.ttf" if platform == 0 else ("arial.ttf" if platform == 1 else "Arial.ttf")) if slot == 0
    return ("Times New Roman.ttf" if platform == 0 else ("times.ttf" if platform == 1 else "Times_New_Roman.ttf")) if slot == 1
    return ("Courier New.ttf" if platform == 0 else ("cour.ttf" if platform == 1 else "Courier_New.ttf")) if slot == 2
    return ("Georgia.ttf" if platform == 0 else ("georgia.ttf" if platform == 1 else "Georgia.ttf")) if slot == 3
    return ("Impact.ttf" if platform == 0 else ("impact.ttf" if platform == 1 else "Impact.ttf")) if slot == 4
    return ("Comic Sans MS.ttf" if platform == 0 else ("comic.ttf" if platform == 1 else "Comic_Sans_MS.ttf")) if slot == 5
    return ("Futura.ttc" if platform == 0 else ("" if platform == 1 else "")) if slot == 6
    return ("Papyrus.ttc" if platform == 0 else ("papyrus.ttf" if platform == 1 else "")) if slot == 8
    return ("Didot.ttc" if platform == 0 else ("" if platform == 1 else "")) if slot == 9
    return ("AmericanTypewriter.ttc" if platform == 0 else ("" if platform == 1 else "")) if slot == 10
    return ("Rockwell.ttc" if platform == 0 else ("rock.ttf" if platform == 1 else "")) if slot == 11
    return ("Chalkduster.ttf" if platform == 0 else ("" if platform == 1 else "")) if slot == 12
    return ("Bradley Hand Bold.ttf" if platform == 0 else ("bradhitc.ttf" if platform == 1 else "")) if slot == 13
    return ("Copperplate.ttc" if platform == 0 else ("" if platform == 1 else "")) if slot == 14
    return ("Verdana.ttf" if platform == 0 else ("verdana.ttf" if platform == 1 else "Verdana.ttf")) if slot == 15
    return ""

def sdl_open_captcha_faces(fonts: mutable SDLDesktopFont&):
    can Blocking.IO, Unsafe.PointerCast:
        os_name: cstr = SDL_GetPlatform()
        platform: i64 = 0 if SDL_strcmp(os_name, "macOS") == 0.i32() else (1 if SDL_strcmp(os_name, "Windows") == 0.i32() else 2)
        directory: cstr = "/System/Library/Fonts/Supplemental" if platform == 0 else "/usr/share/fonts/truetype/msttcorefonts"
        root: u8&? = SDL_getenv("SYSTEMROOT") if platform == 1 else null
        for i in 0..<16 |fonts, platform, directory, root, i|:
            name: cstr = sdl_captcha_face_file(i, platform)
            path: mutable u8[4096] = zeroed
            trusted Unsafe.PointerCast:
                if name.cast[u8&][0] != 0.u8():
                    length: mutable i32 = 0.i32()
                    if root is windows:
                        length <- SDL_snprintf(&path[0], 4096.usize(), "%s/Fonts/%s", windows.cast[cstr], name)
                    elif platform != 1:
                        length <- SDL_snprintf(&path[0], 4096.usize(), "%s/%s", directory, name)
                    if length > 0.i32() and length < 4096.i32():
                        if TTF_OpenFont((&path[0]).cast[cstr], 16.0.f32()) is font:
                            fonts.faces[i.usize()] <- font.uintptr().usize()
        if platform == 0:
            if TTF_OpenFont("/System/Library/Fonts/MarkerFelt.ttc", 16.0.f32()) is marker:
                fonts.faces[7] <- marker.uintptr().usize()
        elif platform == 2:
            fonts.plain <- TTF_OpenFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 16.0.f32())
            if fonts.plain == null:
                fonts.plain <- TTF_OpenFont("/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf", 16.0.f32())

def sdl_configure_ttf(font: mutable void&, points: f32, style: u32) -> bool:
    horizontal: mutable i32 = 0.i32()
    vertical: mutable i32 = 0.i32()
    return false if not TTF_GetFontDPI(font, (&horizontal).uintptr(), (&vertical).uintptr())
    # Pyglet's label sizes are points at 96 DPI.
    if TTF_GetFontSize(font) != points or horizontal != 96.i32() or vertical != 96.i32():
        return false if not TTF_SetFontSizeDPI(font, points, 96.i32(), 96.i32())
    if TTF_GetFontStyle(font) != style:
        TTF_SetFontStyle(font, style)
    return true

def sdl_ttf_rasterize(renderer: mutable void&, text: usize, points: f32, rgba: u32, bold: i32, ascent: usize) -> mutable void&?:
    can Abort.Panic, Unsafe.PointerCast:
        stored: mutable heap void&? = SDL_GetPointerProperty(SDL_GetRendererProperties(renderer), "nw.font.data", null)
        return null if stored == null
        trusted Unsafe.PointerCast:
            fonts: mutable heap SDLDesktopFont& = stored.cast[mutable heap SDLDesktopFont&]
            style: u32 = (bold & 1.i32()).u32()
            face: i32 = (bold >> 1.i32()) - 1.i32()
            primary: mutable void& = fonts.primary
            if face >= 0.i32() and face < 16.i32():
                address: usize = fonts.faces[face.usize()]
                if address != 0.usize():
                    primary <- address.cast[mutable void&]
                elif fonts.faces[0] != 0.usize():
                    primary <- fonts.faces[0].cast[mutable void&]
                elif fonts.plain is plain:
                    primary <- plain
            return null if not sdl_configure_ttf(primary, points, style)
            if face < 0.i32():
                if fonts.fallback is fallback:
                    return null if not sdl_configure_ttf(fallback, points, style)
            coordinate: mutable f32& = ascent.cast[mutable f32&]
            coordinate[0] <- TTF_GetFontAscent(primary).f32()
            color: u32 = (rgba >> 24) | ((rgba >> 8) & 0xff00.u32()) | ((rgba << 8) & 0xff0000.u32()) | (rgba << 24)
            return TTF_RenderText_Blended(primary, text.cast[cstr], 0.usize(), color)

def sdl_ttf_close(_unused: usize, value: usize):
    can Memory.Release, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            fonts: mutable heap SDLDesktopFont& = value.cast[mutable heap SDLDesktopFont&]
            TTF_CloseFont(fonts.primary)
            if fonts.fallback is fallback:
                TTF_CloseFont(fallback)
            for i in 0..<16 |fonts, i|:
                address: usize = fonts.faces[i.usize()]
                if address != 0.usize():
                    TTF_CloseFont(address.cast[mutable void&])
            if fonts.plain is plain:
                TTF_CloseFont(plain)
            SDL_free(value.cast[heap void&])
            TTF_Quit()

def sdl_attach_ttf(renderer: mutable void&, primary: usize, fallback: usize) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0.i32() if not TTF_Init()
        trusted Unsafe.PointerCast:
            opened: mutable void&? = TTF_OpenFont(primary.cast[cstr], 16.0.f32())
            if opened == null:
                TTF_Quit()
                return 0.i32()
            font: mutable void& = opened
            allocation: mutable heap void&? = SDL_calloc(1.usize(), size_of(SDLDesktopFont).usize())
            if allocation == null:
                TTF_CloseFont(font)
                TTF_Quit()
                return 0.i32()
            data: mutable heap void& = allocation
            fonts: mutable heap SDLDesktopFont& = data.cast[mutable heap SDLDesktopFont&]
            fonts.primary <- font
            if fallback != 0.usize():
                if TTF_OpenFont(fallback.cast[cstr], 16.0.f32()) is secondary:
                    if TTF_AddFallbackFont(font, secondary):
                        fonts.fallback <- secondary
                    else:
                        TTF_CloseFont(secondary)
            properties: u32 = SDL_GetRendererProperties(renderer)
            if not SDL_SetPointerPropertyWithCleanup(properties, "nw.font.data", data, sdl_ttf_close, null):
                return 0.i32()
            sdl_open_captcha_faces(fonts)
            if not SDL_SetPointerProperty(properties, "nw.font.rasterize", sdl_ttf_rasterize):
                _ = SDL_ClearProperty(properties, "nw.font.data")
                return 0.i32()
            return 1.i32()

export fn nw_sdl_attach_font(renderer: mutable void&, primary: usize, fallback: usize) -> i32 = sdl_attach_ttf
