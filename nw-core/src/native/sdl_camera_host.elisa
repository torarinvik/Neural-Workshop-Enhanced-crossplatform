extern SDL_GetGlobalProperties() -> u32

module SDLCameraHost:
    def binding(name: cstr) -> usize:
        return SDL_GetNumberProperty(SDL_GetGlobalProperties(), name, 0).usize()

    def available() -> bool:
        return binding("nw.camera.create") != 0.usize()

    def active() -> usize:
        return binding("nw.camera.run")

    def number(name: cstr) -> i64:
        return SDL_GetNumberProperty(SDL_GetGlobalProperties(), name, 0)

    def set(name: cstr, value: i64):
        _ = SDL_SetNumberProperty(SDL_GetGlobalProperties(), name, value)

    def value_key(row: i64) -> cstr:
        return "nw.camera.rung" if row == 0 else ("nw.camera.trials" if row == 1 else "nw.camera.adaptive")

    def change(row: i64, value: i64, direction: i64) -> i64:
        can Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                call: fn(i64, i64, i64) -> i64 = binding("nw.camera.option").cast[fn(i64, i64, i64) -> i64]
                return call(row, value, direction)

    def read_settings(data: heap u8&, size: i64, options: mutable i64&):
        can Abort.Panic, Unsafe.PointerCast:
            rung: i64 = sdl_config_option(data, size, "CAMERA_RUNG", 0, -1)
            trials: i64 = sdl_config_option(data, size, "CAMERA_TRIALS", 0, -1)
            adaptive: i64 = sdl_config_option(data, size, "CAMERA_ADAPTIVE", 1, -1)
            options[0] <- rung if change(0, rung, 0) >= 0
            options[1] <- trials if change(1, trials, 0) >= 0
            options[2] <- adaptive if adaptive == 0 or adaptive == 1

    def read_profile(options: mutable i64&):
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            size: mutable i64 = 0
            if sdl_media_config(&size) is raw:
                trusted Unsafe.PointerCast:
                    read_settings(raw.cast[heap u8&], size, options)
                SDL_free(raw)
            path: mutable u8[4096] = zeroed
            if sdl_task_profile_sidecar(&path[0], ".camera-options"):
                if sdl_read_corpus(&path[0], &size) is raw:
                    trusted Unsafe.PointerCast:
                        read_settings(raw.cast[heap u8&], size, options)
                    SDL_free(raw)

    def new_run(rung: i64, trials: i64, adaptive: i64) -> usize:
        can Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                call: fn(i64, i64, i64, i64) -> usize = binding("nw.camera.create").cast[fn(i64, i64, i64, i64) -> usize]
                return call(rung, trials, adaptive, SDL_GetTicks().i64())

    def open(from_hub_options: bool = false):
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            return if not available() or active() != 0.usize()
            selected: mutable i64[3] = [1, 8, 1]
            trusted Unsafe.PointerCast:
                read_profile((&selected[0]).uintptr().cast[mutable i64&])
            run: usize = new_run(selected[0], selected[1], selected[2])
            return if run == 0.usize()
            set("nw.camera.run", run.i64())
            set("nw.camera.failure", 0)
            if from_hub_options:
                open_options(true)

    def options_visible() -> bool:
        return number("nw.camera.options.row") > 0

    def open_options(from_hub: bool):
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            selected: mutable i64[3] = [1, 8, 1]
            trusted Unsafe.PointerCast:
                read_profile((&selected[0]).uintptr().cast[mutable i64&])
            for row in 0..<3 |selected|:
                set(value_key(row), selected[row.usize()])
            set("nw.camera.options.hub", 1 if from_hub else 0)
            set("nw.camera.options.error", 0)
            set("nw.camera.options.row", 1)

    def save_options(rung: i64, trials: i64, adaptive: i64) -> bool:
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            text: mutable u8[192] = zeroed
            length: i32 = SDL_snprintf(&text[0], 192.usize(),
                "[DEFAULT]\nCAMERA_RUNG = %lld\nCAMERA_TRIALS = %lld\nCAMERA_ADAPTIVE = %s\n",
                rung, trials, "True" if adaptive == 1 else "False")
            return length > 0.i32() and length < 192.i32() and sdl_save_profile_sidecar(".camera-options", &text[0], length.usize())

    def destroy(run: usize):
        can Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                call: fn(usize) -> void = binding("nw.camera.destroy").cast[fn(usize) -> void]
                call(run)

    def options_key(keycode: i64):
        can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
            from_hub: bool = number("nw.camera.options.hub") != 0
            if keycode == 27:
                set("nw.camera.options.row", 0)
                close() if from_hub
                return
            if SDLTaskKeys::enter(keycode):
                rung: i64 = number(value_key(0))
                trials: i64 = number(value_key(1))
                adaptive: i64 = number(value_key(2))
                candidate: usize = new_run(rung, trials, adaptive)
                if candidate == 0.usize() or not save_options(rung, trials, adaptive):
                    destroy(candidate) if candidate != 0.usize()
                    set("nw.camera.options.error", 1)
                    return
                close()
                if from_hub:
                    destroy(candidate)
                else:
                    set("nw.camera.run", candidate.i64())
                    set("nw.camera.failure", 0)
                return
            row: i64 = SDLTaskKeys::option_row(keycode, number("nw.camera.options.row") - 1, 3)
            set("nw.camera.options.row", row + 1)
            if keycode == SDLTaskKeys::LEFT or keycode == SDLTaskKeys::RIGHT or keycode == 32:
                name: cstr = value_key(row)
                set(name, change(row, number(name), -1 if keycode == SDLTaskKeys::LEFT else 1))

    def close():
        can Abort.Panic, Unsafe.PointerCast:
            run: usize = active()
            return if run == 0.usize()
            set("nw.camera.run", 0)
            set("nw.camera.options.row", 0)
            destroy(run)

    def phase(run: usize) -> i64:
        can Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                call: fn(usize) -> i64 = binding("nw.camera.phase").cast[fn(usize) -> i64]
                return call(run)

    def action(run: usize, code: i64, value: i64, aux: i64):
        can Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                call: fn(usize, i64, i64, i64, i64) -> bool = binding("nw.camera.action").cast[fn(usize, i64, i64, i64, i64) -> bool]
                _ = call(run, code, value, aux, SDL_GetTicks().i64())

    def key(keycode: i64, modifiers: u32, pressed: bool) -> bool:
        can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
            run: usize = active()
            return false if run == 0.usize()
            if options_visible():
                options_key(keycode) if pressed
                return true
            if pressed and keycode == 99:
                stage: i64 = phase(run)
                open_options(false) if stage == 0 or stage == 3
                return true
            if pressed and keycode == 27:
                close()
                return true
            action(run, 52, 1 if (modifiers & 3.u32()) != 0.u32() else 0, 0)
            if keycode == 116:
                action(run, 53, 1 if pressed else 0, 0)
            elif pressed and (keycode == 32 or SDLTaskKeys::enter(keycode)):
                stage: i64 = phase(run)
                if stage == 1:
                    action(run, 30, 0, 0)
                elif keycode == 32 and (stage == 0 or stage == 3):
                    action(run, 31, 0, 0)
            else:
                movement: mutable i64 = -1
                if keycode == 119: movement <- 0
                elif keycode == 115: movement <- 1
                elif keycode == 97: movement <- 2
                elif keycode == 100: movement <- 3
                elif keycode == SDLTaskKeys::LEFT: movement <- 4
                elif keycode == SDLTaskKeys::RIGHT: movement <- 5
                elif keycode == SDLTaskKeys::UP: movement <- 6
                elif keycode == SDLTaskKeys::DOWN: movement <- 7
                elif keycode == 113: movement <- 8
                elif keycode == 101: movement <- 9
                if movement >= 0:
                    action(run, (32 if pressed else 42) + movement, 0, 0)
            return true

    def clear():
        can Unsafe.PointerCast:
            run: usize = active()
            if run != 0.usize():
                action(run, 54, 0, 0)

    def drag(dx: f32, dy: f32):
        can Abort.Panic, Unsafe.PointerCast:
            run: usize = active()
            if run != 0.usize() and dx >= -1000000.0.f32() and dx <= 1000000.0.f32() and dy >= -1000000.0.f32() and dy <= 1000000.0.f32():
                action(run, 55, (dx.f64() * 1000.0).i64(), (-dy.f64() * 1000.0).i64())

    def frame(run: usize, dest: usize, capacity: i64, black: i64, width: i32, height: i32) -> i64:
        can Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                advance: fn(usize, i64) -> bool = binding("nw.camera.advance").cast[fn(usize, i64) -> bool]
                chrome: fn(usize, usize, i64, i64, i32, i32) -> i64 = binding("nw.camera.chrome").cast[fn(usize, usize, i64, i64, i32, i32) -> i64]
                _ = advance(run, SDL_GetTicks().i64())
                return chrome(run, dest, capacity, black, width, height)

    def option_frame(dest: usize, capacity: i64, black: i64) -> i64:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            values: i64[3] = [number(value_key(0)), number(value_key(1)), number(value_key(2))]
            list: mutable Display::DisplayList = Display::DisplayList()
            scratch: mutable u8[512] = zeroed
            trusted Unsafe.PointerCast:
                sdl_grid_options_frame(&list, black != 0, 75, number("nw.camera.options.row") - 1,
                    (&values[0]).uintptr().cast[i64&])
                note: fn(usize, i64, i64, i64) -> i64 = binding("nw.camera.note").cast[fn(usize, i64, i64, i64) -> i64]
                length: i64 = note((&scratch[0]).uintptr(), 512, values[0], values[2])
                ink: u32 = 0xffffffff if black != 0 else 0x141820ff
                if length > 0:
                    Display::draw_text(&list, sview((&scratch[0]).uintptr().cast[cstr], 0, length),
                        456.0, 270.0, 11.0, ink, Display::ANCHOR_CENTER_CENTER)
                if number("nw.camera.options.error") != 0:
                    Display::draw_text(&list, "Could not save Camera options", 456.0, 228.0, 16.0,
                        ink, Display::ANCHOR_CENTER_CENTER)
                encoded: darray[u8] = Display::encode_binary(&list)
                used: i64 = encoded.count.i64()
                return -1 if used <= 0 or used > capacity
                memcpy(dest.cast[mutable void&], (&encoded[0]).cast[void&], used.usize())
                return used

    def click_options(window: mutable void&, x: f32, y: f32):
        can Abort.Panic, Unsafe.PointerCast:
            sizes: mutable i32[2] = zeroed
            trusted Unsafe.PointerCast:
                _ = SDL_GetWindowSize(window, (&sizes[0]).uintptr().cast[mutable i32&], (&sizes[1]).uintptr().cast[mutable i32&])
            row: i64 = sdl_option_row(x, y, sizes[0], sizes[1], 3)
            return if row < 0
            if row + 1 == number("nw.camera.options.row"):
                name: cstr = value_key(row)
                set(name, change(row, number(name), 1))
            else:
                set("nw.camera.options.row", row + 1)

    def failed() -> bool:
        return binding("nw.camera.failure") != 0.usize()

    def record_failure():
        _ = SDL_SetNumberProperty(SDL_GetGlobalProperties(), "nw.camera.failure", 1)

    def present(renderer: mutable void&, width: i32, height: i32) -> i32:
        can Unsafe.PointerCast:
            run: usize = active()
            return 0.i32() if run == 0.usize()
            trusted Unsafe.PointerCast:
                call: fn(usize, usize, i32, i32) -> i32 = binding("nw.camera.present").cast[fn(usize, usize, i32, i32) -> i32]
                return call(run, renderer.uintptr(), width, height)
