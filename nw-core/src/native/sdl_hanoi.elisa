include "../tasks/hanoi.elisa"
include "../scene_hanoi.elisa"
include "../tasks/hanoi_game.elisa"

def sdl_hanoi_create(disks: i64, rounds: i64, adaptive: bool) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if disks < Hanoi::SMALLEST_TOWER or disks > Hanoi::LARGEST_TOWER or rounds < 1
        if malloc(size_of(HanoiGame::Run).usize()) is memory:
            trusted Unsafe.PointerCast:
                run: mutable heap HanoiGame::Run& = memory.cast[mutable heap HanoiGame::Run&]
                HanoiGame::initialize(run, disks, rounds, adaptive, 0)
                return memory.uintptr().i64()
        return 0

def sdl_hanoi_option_allowed(row: i64, value: i64) -> bool:
    return value >= Hanoi::SMALLEST_TOWER and value <= Hanoi::LARGEST_TOWER if row == 0
    return value == 0 or value == 1 if row == 2
    return value == 1 or value == 2 or value == 3 or value == 5 or value == 8 or value == 10

def sdl_read_hanoi_options(output: mutable i64&):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: mutable u8[4096] = zeroed
        data: mutable u8[128] = zeroed
        trusted Unsafe.PointerCast:
            target: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
            return if not sdl_task_profile_sidecar(target, ".hanoi-options")
            if SDL_IOFromFile(target.cast[cstr], "rb") is stream:
                raw: heap u8& = (&data[0]).uintptr().cast[heap u8&]
                length: usize = SDL_ReadIO(stream, (&data[0]).cast[mutable void&], 128.usize())
                status: i32 = SDL_GetIOStatus(stream)
                closed: bool = SDL_CloseIO(stream)
                return if not closed or status != 2.i32() or length == 0.usize() or length >= 128.usize()
                values: mutable i64[3] = zeroed
                at: mutable i64 = 0
                for row in 0..<3 |row, values, at, raw, length|:
                    value: i64 = SyllogismOptions::saved_integer(raw, length.i64(), &at)
                    valid: bool = sdl_hanoi_option_allowed(row, value)
                    return if not valid
                    values[row.usize()] <- value
                while at < length.i64() and SyllogismOptions::whitespace(raw[at.usize()].i64()) |at, length, raw|:
                    at <- at + 1
                return if at != length.i64()
                for row in 0..<3 |row, output, values|:
                    output[row.usize()] <- values[row.usize()]

def sdl_hanoi_profile_create() -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        selected: mutable i64[3] = [4, 3, 1]
        size: mutable i64 = 0
        if sdl_media_config(&size) is raw:
            trusted Unsafe.PointerCast:
                data: heap u8& = raw.cast[heap u8&]
                start: i64 = sdl_config_option(data, size, "HANOI_DISKS", 0, 4)
                count: i64 = sdl_config_option(data, size, "HANOI_ROUNDS", 0, 3)
                selected[0] <- start if sdl_hanoi_option_allowed(0, start)
                selected[1] <- count if sdl_hanoi_option_allowed(1, count)
                selected[2] <- sdl_config_option(data, size, "HANOI_ADAPTIVE", 1, 1)
            SDL_free(raw)
        sdl_read_hanoi_options(&selected[0])
        return sdl_hanoi_create(selected[0], selected[1], selected[2] != 0)

def sdl_hanoi_option_change(row: i64, current: i64, direction: i64) -> i64:
    return 1 - current if row == 2
    low: i64 = Hanoi::SMALLEST_TOWER if row == 0 else 1
    high: i64 = Hanoi::LARGEST_TOWER if row == 0 else 10
    count: i64 = high - low + 1
    next: mutable i64 = current
    while true |next, count, low, row, direction|:
        next <- (next - low + direction + count) % count + low
        return next if sdl_hanoi_option_allowed(row, next)
    return current

def sdl_hanoi_options_key(handle: i64, key: i64, from_hub: bool = false) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap HanoiGame::Run& = handle.uintptr().cast[mutable heap HanoiGame::Run&]
            draft: mutable i64& = (&run.options_draft[0]).uintptr().cast[mutable i64&]
            if run.options_row < 0:
                return 0 if key != 99 or (run.phase != HanoiGame::PHASE_READY and run.phase != HanoiGame::PHASE_DONE)
                draft[0] <- run.start_disks
                draft[1] <- run.total_rounds
                draft[2] <- 1 if run.adaptive else 0
                run.options_from_hub <- from_hub
                run.options_row <- 0
                return 1
            if SDLTaskKeys::enter(key) or key == 27:
                close: i64 = 2 if run.options_from_hub else 1
                if SDLTaskKeys::enter(key):
                    data: mutable u8[128] = zeroed
                    length: i32 = SDL_snprintf(&data[0], 128.usize(), "%lld %lld %lld\n", draft[0], draft[1], draft[2])
                    if length <= 0.i32() or length >= 128.i32() or not sdl_save_profile_sidecar(".hanoi-options", &data[0], length.usize()):
                        SDL_Log("Could not save Tower of Hanoi options")
                        return 1
                    HanoiGame::initialize(run, draft[0], draft[1], draft[2] != 0, 0)
                run.options_row <- -1
                return close
            run.options_row <- SDLTaskKeys::option_row(key, run.options_row, 3)
            if key == SDLTaskKeys::LEFT or key == SDLTaskKeys::RIGHT or key == 32:
                row: i64 = run.options_row
                draft[row.usize()] <- sdl_hanoi_option_change(row, draft[row.usize()], -1 if key == SDLTaskKeys::LEFT else 1)
            return 1

def sdl_hanoi_options_click(handle: i64, x: f32, y: f32, width: i32, height: i32) -> bool:
    can Abort.Panic, Unsafe.PointerCast:
        return false if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap HanoiGame::Run& = handle.uintptr().cast[mutable heap HanoiGame::Run&]
            return false if run.options_row < 0
            row: i64 = sdl_option_row(x, y, width, height, 3)
            if row >= 0:
                if row == run.options_row:
                    run.options_draft[row.usize()] <- sdl_hanoi_option_change(row, run.options_draft[row.usize()], 1)
                run.options_row <- row
            return true

def sdl_hanoi_options_note(list: mutable Display::DisplayList&, ink: u32, disks: i64, adaptive: bool):
    can Memory.Allocate, Abort.Panic:
        note: mutable dstr = []
        dstr_append_cstr(&note, "A tower of ")
        dstr_append_i64(&note, disks)
        dstr_append_cstr(&note, " disks takes at least ")
        dstr_append_i64(&note, Hanoi::minimum_moves(disks))
        dstr_append_cstr(&note, " moves.")
        Display::draw_text(list, bytes_view(note), 456.0, 282.0, 16.0, ink, Display::ANCHOR_CENTER_CENTER)
        if adaptive:
            Display::draw_text(list, "Solve near the minimum to grow the next tower. Extra moves can shrink it.",
                456.0, 252.0, 16.0, ink, Display::ANCHOR_CENTER_CENTER)

def sdl_hanoi_destroy(handle: i64):
    can Memory.Release, Unsafe.PointerCast:
        if handle > 0:
            trusted Unsafe.PointerCast:
                free(handle.uintptr().cast[heap void&])

def sdl_hanoi_info(handle: i64, field: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: heap HanoiGame::Run& = handle.uintptr().cast[heap HanoiGame::Run&]
            return HanoiGame::info(run, field)

def sdl_hanoi_action(handle: i64, action: i64, now: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap HanoiGame::Run& = handle.uintptr().cast[mutable heap HanoiGame::Run&]
            return HanoiGame::apply(run, action, 0, now)

def sdl_hanoi_key(handle: i64, key: i64, now: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return sdl_hanoi_action(handle, HanoiGame::ACTION_START, now) if key == 32
        return sdl_hanoi_action(handle, HanoiGame::ACTION_PICK_0 + key - 49, now) if key >= 49 and key <= 51
        return sdl_hanoi_action(handle, HanoiGame::ACTION_PICK_0 + key - 1073741913, now) if key >= 1073741913 and key <= 1073741915
        return 2

# Coordinates are in the source scene after the desktop viewport transform.
def sdl_hanoi_pointer(handle: i64, x: f64, y: f64, width: f64, height: f64, now: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 2 if width <= 0.0 or height <= 0.0
        area: mutable SceneHanoi::Canvas = zeroed
        SceneHanoi::canvas_of(&area, width, height)
        return 2 if y < area.bottom - 12.0 or y > area.bottom + area.height
        span: f64 = area.width / 3.0
        for peg in 0..<3 |peg, area, span, x, handle, now|:
            left: f64 = area.left + peg.f64() * span
            if x >= left and x <= left + span:
                return sdl_hanoi_action(handle, HanoiGame::ACTION_PICK_0 + peg, now)
        return 2

def sdl_hanoi_advance(handle: i64, now: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap HanoiGame::Run& = handle.uintptr().cast[mutable heap HanoiGame::Run&]
            return HanoiGame::advance(run, now)

def sdl_hanoi_frame_write(dest: i64, capacity: i64, handle: i64, black: i64, width: i64, height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if dest <= 0 or capacity <= 0 or handle <= 0 or width <= 0 or height <= 0
        trusted Unsafe.PointerCast:
            run: heap HanoiGame::Run& = handle.uintptr().cast[heap HanoiGame::Run&]
            list: mutable Display::DisplayList = Display::DisplayList()
            if run.options_row >= 0:
                sdl_grid_options_frame(&list, black != 0, 39, run.options_row, &run.options_draft[0])
            else:
                HanoiGame::render(run, black != 0, width.f64(), height.f64(), &list)
            encoded: darray[u8] = Display::encode_binary(&list)
            length: i64 = encoded.count.i64()
            return 0 if length <= 0 or length > capacity
            memcpy(dest.uintptr().cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            return length

def sdl_hanoi_selftest(profile: bool) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        handle: i64 = sdl_hanoi_profile_create() if profile else sdl_hanoi_create(3, 2, true)
        buffer: i64 = frame_alloc(65536)
        if handle <= 0 or buffer <= 0:
            sdl_hanoi_destroy(handle)
            frame_free(buffer) if buffer > 0
            return 1.i32()
        good: mutable bool = sdl_hanoi_info(handle, HanoiGame::INFO_START_DISKS) == 3
        good <- false if sdl_hanoi_info(handle, HanoiGame::INFO_TOTAL_ROUNDS) != 2
        good <- false if sdl_hanoi_key(handle, 32, 100) != 1
        good <- false if sdl_hanoi_pointer(handle, 456.0, 20.0, 912.0, 684.0, 200) != 2
        good <- false if sdl_hanoi_pointer(handle, 188.0, 100.0, 912.0, 684.0, 200) != 1
        good <- false if sdl_hanoi_key(handle, 1073741915, 200) != 1
        keys: i64[12] = [49, 50, 51, 50, 49, 51, 50, 49, 50, 51, 49, 51]
        for at in 0..<12 |at, keys, handle, good|:
            good <- false if sdl_hanoi_key(handle, keys[at.usize()], 200 + at) != 1
        good <- false if sdl_hanoi_info(handle, HanoiGame::INFO_PHASE) != HanoiGame::PHASE_SOLVED
        good <- false if sdl_hanoi_info(handle, HanoiGame::INFO_MOVES) != 7
        good <- false if not sdl_selftest_frame_valid(buffer, sdl_hanoi_frame_write(buffer, 65536, handle, 0, 912, 684))
        deadline: i64 = sdl_hanoi_info(handle, HanoiGame::INFO_FEEDBACK_UNTIL_MS)
        good <- false if sdl_hanoi_advance(handle, deadline - 1) != 2
        good <- false if sdl_hanoi_advance(handle, deadline) != 1
        good <- false if sdl_hanoi_info(handle, HanoiGame::INFO_DISKS) != 4
        good <- false if sdl_hanoi_info(handle, HanoiGame::INFO_ROUND) != 2
        sdl_hanoi_destroy(handle)
        frame_free(buffer)
        if good: _ = printf("SDL Hanoi controller selftest: PASS\n")
        return 0.i32() if good else 1.i32()

export fn nw_hanoi_info(handle: i64, field: i64) -> i64 = sdl_hanoi_info
