# The desktop supplies validated INI defaults before each parser reads its
# saved settings and applies command-line overrides.
def sdl_apply_task_ini_defaults(values: mutable i64&, address: usize, count: i64):
    can Abort.Panic, Unsafe.PointerCast:
        return if address == 0.usize()
        trusted Unsafe.PointerCast:
            defaults: i64& = address.cast[i64&]
            for at in 0..<count |at, values, defaults|:
                value: i64 = defaults[at.usize()]
                values[at.usize()] <- value if value >= 0
