# Mirrors the platform binding table in the C entry point.
struct SDLDesktopBindings:
    pixel_format: mutable usize
    png_writer: mutable usize
    png_loader: mutable usize
    font: mutable usize
    poll: mutable usize
    pointer: mutable usize
    writer: mutable usize
    shutdown: mutable usize
    marble_advance: mutable usize
    marble_key: mutable usize
    marble_finish: mutable usize
    marble_close: mutable usize
    marble_set_png_loader: mutable usize
    marble_startup_status: mutable usize
