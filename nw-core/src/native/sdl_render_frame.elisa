# SDL display-list command dispatch. Struct layouts match the native ABI.
extern SDL_RenderFillRect(renderer: mutable void&, rect: f32&) -> bool
extern SDL_RenderRect(renderer: mutable void&, rect: f32&) -> bool

module SDLFrame:
    struct Command:
        kind: mutable u8
        color: mutable u32
        a: mutable f32
        b: mutable f32
        c: mutable f32
        d: mutable f32
        e: mutable f32
        f: mutable f32
        ref: mutable u32
        len: mutable u32

    struct Events:
        verdict: mutable i32
        sounds: mutable i32
        marker: mutable u8[64]

    def render(renderer: mutable void&?, view: f32&?, frame: NativeDisplayDecode::Frame&?, event: mutable Events&?):
        can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
            return if renderer == null or view == null or frame == null or event == null
            trusted Unsafe.PointerCast:
                target: mutable void& = renderer
                current: NativeDisplayDecode::Frame& = frame
                events: mutable Events& = event
                view_ptr: f32& = view
                scales: heap f32& = view_ptr.cast[heap f32&]
                events.verdict <- -1
                events.sounds <- 0
                events.marker[0] <- 0.u8()
                remaining: mutable i64 = 0
                seen: mutable i64 = 0
                open: mutable bool = false
                poly_color: mutable u32 = 0.u32()
                first_x: mutable f32 = 0.0.f32()
                first_y: mutable f32 = 0.0.f32()
                prev_x: mutable f32 = 0.0.f32()
                prev_y: mutable f32 = 0.0.f32()
                index: mutable i64 = 0
                while index < current.count.i64() |index, current, target, view, frame, events, scales, remaining, seen, open, poly_color, first_x, first_y, prev_x, prev_y|:
                    cmd: heap Command& = (current.commands.i64() + index * 40).uintptr().cast[heap Command&]
                    kind: u8 = cmd.kind
                    if kind == 1.u8() or kind == 2.u8() or kind == 3.u8():
                        angle_ptr: f32& = (&cmd.ref).cast[f32&]
                        angle: f32 = angle_ptr[0]
                        if kind == 1.u8() and (angle != 0.0.f32() or cmd.e != 0.0.f32() or cmd.f != 0.0.f32()):
                            sdl_rotated_rect(target, view, cmd.a, cmd.b, cmd.c, cmd.d, cmd.e, cmd.f, angle, cmd.color)
                        else:
                            box: mutable f32[4] = zeroed
                            box[0] <- SDLGeometry::x(view, cmd.a)
                            box[1] <- SDLGeometry::y(view, cmd.b + cmd.d)
                            box[2] <- cmd.c * scales[0]
                            box[3] <- cmd.d * scales[0]
                            sdl_set_color(target, cmd.color)
                            if kind != 3.u8():
                                _ = SDL_RenderFillRect(target, &box[0])
                            if kind == 2.u8():
                                sdl_set_color(target, cmd.ref)
                            if kind != 1.u8():
                                _ = SDL_RenderRect(target, &box[0])
                    elif kind == 4.u8():
                        sdl_fill_circle(target, view, cmd.a, cmd.b, cmd.c, cmd.color)
                    elif kind == 5.u8():
                        sdl_set_color(target, cmd.color)
                        sdl_stroke_arc(target, view, cmd.a, cmd.b, cmd.c, cmd.e, cmd.f)
                    elif kind == 6.u8():
                        sdl_set_color(target, cmd.color)
                        _ = SDL_RenderLine(target, SDLGeometry::x(view, cmd.a), SDLGeometry::y(view, cmd.b), SDLGeometry::x(view, cmd.c), SDLGeometry::y(view, cmd.d))
                    elif kind == 7.u8():
                        sdl_fill_triangle(target, view, cmd.a, cmd.b, cmd.c, cmd.d, cmd.e, cmd.f, cmd.color)
                    elif kind == 8.u8() or kind == 16.u8():
                        remaining <- cmd.len.i32().i64()
                        poly_color <- cmd.color
                        seen <- 0
                        open <- kind == 16.u8()
                    elif kind == 9.u8() and remaining > 0:
                        if open:
                            if seen > 0:
                                sdl_set_color(target, poly_color)
                                _ = SDL_RenderLine(target, SDLGeometry::x(view, prev_x), SDLGeometry::y(view, prev_y), SDLGeometry::x(view, cmd.a), SDLGeometry::y(view, cmd.b))
                        elif seen == 0:
                            first_x <- cmd.a
                            first_y <- cmd.b
                        elif seen >= 2:
                            sdl_fill_triangle(target, view, first_x, first_y, prev_x, prev_y, cmd.a, cmd.b, poly_color)
                        prev_x <- cmd.a
                        prev_y <- cmd.b
                        seen <- seen + 1
                        remaining <- remaining - 1
                    elif kind == 11.u8():
                        sdl_draw_multiline(target, view, frame, cmd.cast[u8&], cmd.a, cmd.b, cmd.c, cmd.color, (cmd.len >> 24).u8())
                    elif kind == 12.u8():
                        events.verdict <- cmd.ref.i32()
                    elif kind == 13.u8():
                        events.sounds <- events.sounds + 1.i32()
                    elif kind == 14.u8():
                        text_address: mutable usize = 0.usize()
                        length: u32 = native_display_text(frame, cmd.cast[u8&], &text_address)
                        if text_address != 0.usize() and length < 64.u32():
                            text: heap u8& = text_address.cast[heap u8&]
                            at: mutable i64 = 0
                            while at < length.i64() |at, length, text, events|:
                                events.marker[at.usize()] <- text[at.usize()]
                                at <- at + 1
                            events.marker[length.usize()] <- 0.u8()
                    elif kind == 17.u8():
                        sdl_star(target, view, cmd.a, cmd.b, cmd.c, cmd.d, (cmd.e + 0.5.f32()).i32(), cmd.f, cmd.color)
                    index <- index + 1

export fn nw_sdl_render_frame(renderer: mutable void&?, view: f32&?, frame: NativeDisplayDecode::Frame&?, event: mutable SDLFrame::Events&?) = SDLFrame::render
