# Decode the shared little-endian display protocol for the SDL shell.
module NativeDisplayDecode:
    # Room for a fitted sprite and a solved outline for each video pixel.
    const DESKTOP_FRAME_BYTES: i64 = 8 * 1024 * 1024
    const DESKTOP_COMMANDS: i64 = 262144 / 40
    const DESKTOP_SCRATCH_BYTES: i64 = DESKTOP_COMMANDS * 40

    struct Frame:
        commands: mutable usize
        count: mutable u32
        pool: mutable usize
        pool_len: mutable u32

    def word(bytes: heap u8&, offset: usize) -> u32:
        return bytes[offset].u32() | (bytes[offset + 1.usize()].u32() << 8) | (bytes[offset + 2.usize()].u32() << 16) | (bytes[offset + 3.usize()].u32() << 24)

    def read_frame(data: u8&?, length: usize, frame: mutable Frame&?) -> i32:
        can Abort.Panic, Unsafe.PointerCast:
            return 0 if data == null or frame == null or length < 16.usize()
            trusted Unsafe.PointerCast:
                source_ptr: u8& = data
                source: heap u8& = source_ptr.cast[heap u8&]
                output: mutable Frame& = frame
                return 0 if word(source, 0.usize()) != 1313426254.u32() or word(source, 4.usize()) != 1.u32()
                count: usize = word(source, 8.usize()).usize()
                pool_len: usize = word(source, 12.usize()).usize()
                return 0 if count > (length - 16.usize()) / 40.usize()
                pool_offset: usize = 16.usize() + count * 40.usize()
                return 0 if pool_len > length - pool_offset
                output.commands <- source_ptr.uintptr().usize() + 16.usize()
                output.count <- count.u32()
                output.pool <- source_ptr.uintptr().usize() + pool_offset
                output.pool_len <- pool_len.u32()
                return 1

    def decode_view(data: u8&?, length: usize, frame: mutable Frame&?) -> i32:
        can Abort.Panic, Unsafe.PointerCast:
            return 0 if data == null
            source: u8& = data
            # The renderer reads naturally aligned 32-bit command fields.
            return 0 if source.uintptr() % 4.usize() != 0.usize()
            return read_frame(data, length, frame)

    def decode(data: u8&?, length: usize, scratch: mutable u8&?, scratch_count: usize, frame: mutable Frame&?) -> i32:
        can Abort.Panic, Unsafe.PointerCast:
            return 0 if scratch == null or frame == null
            parsed: mutable Frame = zeroed
            return 0 if read_frame(data, length, &parsed) == 0.i32() or parsed.count.usize() > scratch_count
            dest_ptr: mutable u8& = scratch
            output: mutable Frame& = frame
            trusted Unsafe.PointerCast:
                source: heap u8& = parsed.commands.cast[heap u8&]
                dest: mutable heap u8& = dest_ptr.cast[mutable heap u8&]
                bytes: usize = parsed.count.usize() * 40.usize()
                index: mutable usize = 0.usize()
                while index < bytes |index, bytes, source, dest|:
                    dest[index] <- source[index]
                    index <- index + 1.usize()
            output.commands <- dest_ptr.uintptr().usize()
            output.count <- parsed.count
            output.pool <- parsed.pool
            output.pool_len <- parsed.pool_len
            return 1

export fn nw_decode(data: u8&?, length: usize, scratch: mutable u8&?, scratch_count: usize, frame: mutable NativeDisplayDecode::Frame&?) -> i32 = NativeDisplayDecode::decode

def native_display_text(frame: NativeDisplayDecode::Frame&?, command: u8&?, text: mutable usize&?) -> u32:
    can Abort.Panic, Unsafe.PointerCast:
        return 0.u32() if frame == null or command == null or text == null
        trusted Unsafe.PointerCast:
            current: NativeDisplayDecode::Frame& = frame
            raw: u8& = command
            bytes: heap u8& = raw.cast[heap u8&]
            output: mutable usize& = text
            reference: u32 = NativeDisplayDecode::word(bytes, 32.usize())
            length: u32 = NativeDisplayDecode::word(bytes, 36.usize()) & 16777215.u32()
            if reference > current.pool_len or length > current.pool_len - reference:
                output[0] <- 0.usize()
                return 0.u32()
            output[0] <- current.pool + reference.usize()
            return length

export fn nw_text_of(frame: NativeDisplayDecode::Frame&?, command: u8&?, text: mutable usize&?) -> u32 = native_display_text
