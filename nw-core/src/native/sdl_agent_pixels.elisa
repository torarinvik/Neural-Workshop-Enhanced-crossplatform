module SDLAgentPixels:
    def draw(output: mutable u8&, data: i64, length: i64, bytes: i64, black: i64, width: i32, height: i32) -> i64:
        can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
            pixels: mutable u8& = output
            trusted Unsafe.PointerCast:
                endian: u32 = 1.u32()
                first_byte: u8& = (&endian).uintptr().cast[u8&]
                format: u32 = 0x16762004.u32() if first_byte[0] == 1.u8() else 0x16462004.u32()
                if SDL_CreateSurfaceFrom(width, height, format, pixels.cast[mutable void&], width * 4.i32()) is surface:
                    written: mutable i64 = 0
                    if SDL_CreateSoftwareRenderer(surface) is renderer:
                        _ = SDL_SetRenderDrawBlendMode(renderer, 1.u32())
                        decoded: i32 = sdl_draw_frame_theme(renderer, data.uintptr().cast[u8&], length, width, height, 0, black)
                        if decoded != 0.i32() and SDL_RenderPresent(renderer):
                            written <- bytes
                        SDL_DestroyRenderer(renderer)
                    SDL_DestroySurface(surface)
                    return written
            return 0

    def think_bar(pixels: mutable u8&, width: i32, height: i32, share: f64):
        can Abort.Panic:
            bar_width: i64 = (width.f64() * share).i64()
            bar_height: i64 = height.i64() if height < 6.i32() else 6
            for y in 0..<bar_height |pixels, width, bar_width|:
                for x in 0..<bar_width |pixels, width, y|:
                    offset: usize = ((y * width.i64() + x) * 4).usize()
                    pixels[offset] <- 96.u8()
                    pixels[offset + 1] <- 120.u8()
                    pixels[offset + 2] <- 168.u8()
                    pixels[offset + 3] <- 255.u8()
