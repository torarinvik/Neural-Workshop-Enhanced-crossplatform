module MarbleShaderAssets:
    def read_shader_asset(shader: i64, length: mutable usize&) -> mutable heap void&?:
        can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            length[0] <- 0.usize()
            return null if shader < 0 or shader > 5
            name: cstr = "scene.vert" if shader == 0 else ("scene.frag" if shader == 1 else ("shadow.vert" if shader == 2 else ("shadow.frag" if shader == 3 else ("composite.vert" if shader == 4 else "composite.frag"))))
            base: u8&? = SDL_GetBasePath()
            return null if base == null
            trusted Unsafe.PointerCast:
                prefix: u8& = base
                path: mutable u8[4096] = zeroed
                count: i32 = SDL_snprintf(&path[0], 4096.usize(), "%sres/marblemaze/%s", prefix.cast[cstr], name)
                return null if count <= 0.i32() or count >= 4096.i32()
                return SDL_LoadFile((&path[0]).uintptr().cast[cstr], length)
