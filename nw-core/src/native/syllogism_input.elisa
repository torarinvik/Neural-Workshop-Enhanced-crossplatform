# SDL key and pointer mapping for Syllogism. Controller actions are 0..6;
# host commands 100..106 manage its options overlay. -1 means no action.
module SyllogismInput:
    def key(symbol: i64, phase: i64, options_open: i64, selected: i64, value: mutable i64&?) -> i64:
        can Abort.Panic:
            return -1 if value == null
            output: mutable i64& = value
            output[0] <- 0
            if options_open != 0:
                return 100 if symbol == 27
                return 101 if symbol == 1073741906 and selected > 0
                return 102 if symbol == 1073741905 and selected < 4
                if symbol == 1073741904 or symbol == 1073741903 or symbol == 32:
                    output[0] <- -1 if symbol == 1073741904 else 1
                    return 103
                return 104 if symbol == 13 or symbol == 1073741912
                return -1
            return 105 if symbol == 111 and phase != 1
            return (1 if phase == 1 else 0) if symbol == 32
            return 1 if phase == 1 and (symbol == 13 or symbol == 1073741912)
            return -1 if phase != 1
            return 2 if symbol == 1073741904
            return 3 if symbol == 1073741903
            return 4 if symbol == 1073741906
            return 5 if symbol == 1073741905
            if symbol >= 49 and symbol <= 57:
                output[0] <- symbol - 49
                return 6
            return -1

    def pointer(x: f64, y: f64, options_open: i64, phase: i64) -> i64:
        return 0 if options_open == 0 and phase != 1
        return -1 if options_open == 0
        return 100 if y >= 94.0 and y <= 132.0 and x >= 170.0 and x <= 360.0
        return 104 if y >= 94.0 and y <= 132.0 and x >= 552.0 and x <= 742.0
        return -1 if x < 102.0 or x > 810.0
        row: mutable i64 = 0
        while row < 5 |row, y|:
            center: f64 = 474.0 - row.f64() * 48.0
            return 110 + row if y >= center - 18.0 and y <= center + 18.0
            row <- row + 1
        return -1

export fn nw_syllogism_input_key(symbol: i64, phase: i64, options_open: i64, selected: i64, value: mutable i64&?) -> i64 = SyllogismInput::key
export fn nw_syllogism_input_pointer(x: f64, y: f64, options_open: i64, phase: i64) -> i64 = SyllogismInput::pointer
