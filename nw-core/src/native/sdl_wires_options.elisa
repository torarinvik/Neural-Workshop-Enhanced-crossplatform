def sdl_wires_option_change(row: i64, current: i64, direction: i64) -> i64:
    return 1 - current if row >= 2
    limit: i64 = 12 if row == 0 else 20
    next: mutable i64 = current
    while true |next, limit, row, direction|:
        next <- (next + direction + limit - 1) % limit + 1
        return next if SDLTaskCLI::allowed(11 + row, next)
    return current

def sdl_wires_options_key(handle: i64, key: i64, tasks: usize, from_hub: bool = false) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap CrossedWiresGame::CrossedWiresRun& = handle.uintptr().cast[mutable heap CrossedWiresGame::CrossedWiresRun&]
            draft: mutable i64& = (&run.options_draft[0]).uintptr().cast[mutable i64&]
            if run.options_row < 0:
                grade: CrossedWires::CrossedWiresGrade = CrossedWires::grade_at(run.rung)
                return 0 if key != 111 and (key != 99 or (grade.keys == 8 and not from_hub))
                draft[0] <- run.start_rung
                draft[1] <- run.total_trials
                draft[2] <- 1 if run.adaptive else 0
                draft[3] <- 1 if run.show_grid else 0
                run.options_from_hub <- from_hub
                run.options_row <- 0
                return 1
            if SDLTaskKeys::enter(key) or key == 27:
                if SDLTaskKeys::enter(key):
                    _ = CrossedWiresGame::apply_options(run, draft[0], draft[1], draft[2], draft[3])
                    if tasks != 0.usize():
                        selected: mutable i64& = tasks.cast[mutable i64&]
                        for row in 0..<4 |row, selected, draft|:
                            selected[(11 + row).usize()] <- draft[row.usize()]
                        data: mutable u8[128] = zeroed
                        length: i32 = SDL_snprintf(&data[0], 128.usize(), "%lld %lld %lld %lld\n",
                            draft[0], draft[1], draft[2], draft[3])
                        if length <= 0.i32() or length >= 128.i32() or not sdl_save_profile_sidecar(".wires-options", &data[0], length.usize()):
                            SDL_Log("Could not save Crossed Wires options")
                run.options_row <- -1
                return 2 if run.options_from_hub else 1
            run.options_row <- SDLTaskKeys::option_row(key, run.options_row, 4)
            if key == SDLTaskKeys::LEFT or key == SDLTaskKeys::RIGHT or key == 32:
                row: i64 = run.options_row
                draft[row.usize()] <- sdl_wires_option_change(row, draft[row.usize()], -1 if key == SDLTaskKeys::LEFT else 1)
            return 1

def sdl_wires_options_click(handle: i64, x: f32, y: f32, width: i32, height: i32):
    can Abort.Panic, Unsafe.PointerCast:
        return if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap CrossedWiresGame::CrossedWiresRun& = handle.uintptr().cast[mutable heap CrossedWiresGame::CrossedWiresRun&]
            return if run.options_row < 0
            row: i64 = sdl_option_row(x, y, width, height, 4)
            if row >= 0:
                if row == run.options_row:
                    run.options_draft[row.usize()] <- sdl_wires_option_change(row, run.options_draft[row.usize()], 1)
                run.options_row <- row

def sdl_read_wires_options(output: mutable i64&):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: mutable u8[4096] = zeroed
        data: mutable u8[128] = zeroed
        trusted Unsafe.PointerCast:
            target: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
            return if not sdl_task_profile_sidecar(target, ".wires-options")
            if SDL_IOFromFile(target.cast[cstr], "rb") is stream:
                raw: heap u8& = (&data[0]).uintptr().cast[heap u8&]
                length: usize = SDL_ReadIO(stream, (&data[0]).cast[mutable void&], 128.usize())
                status: i32 = SDL_GetIOStatus(stream)
                closed: bool = SDL_CloseIO(stream)
                return if not closed or status != 2.i32() or length == 0.usize() or length >= 128.usize()
                values: mutable i64[4] = zeroed
                at: mutable i64 = 0
                for row in 0..<4 |row, values, at, raw, length|:
                    value: i64 = SyllogismOptions::saved_integer(raw, length.i64(), &at)
                    valid: bool = SDLTaskCLI::allowed(11 + row, value) if row < 2 else CrossedWiresGame::allowed_option_bool(value)
                    return if not valid
                    values[row.usize()] <- value
                while at < length.i64() and SyllogismOptions::whitespace(raw[at.usize()].i64()) |at, length, raw|:
                    at <- at + 1
                return if at != length.i64()
                for row in 0..<4 |row, output, values|:
                    output[(11 + row).usize()] <- values[row.usize()]

def sdl_wires_options_note(list: mutable Display::DisplayList&, ink: u32, rung: i64, adaptive: bool):
    can Memory.Allocate, Abort.Panic:
        grade: CrossedWires::CrossedWiresGrade = CrossedWires::grade_at(rung)
        wiring: mutable cstr = "shuffled"
        wiring <- "as marked" if grade.family == CrossedWires::STEADY
        wiring <- "rotated" if grade.family == CrossedWires::TURNED
        wiring <- "mirrored" if grade.family == CrossedWires::MIRRORED
        layout: mutable dstr = []
        dstr_append_cstr(&layout, SceneCrossedWires::grade_name(rung))
        dstr_append_cstr(&layout, "    ")
        dstr_append_i64(&layout, grade.keys)
        dstr_append_cstr(&layout, " keys    ")
        dstr_append_i64(&layout, grade.across)
        dstr_append_cstr(&layout, " × ")
        dstr_append_i64(&layout, grade.down)
        dstr_append_cstr(&layout, " wrapping grid    ")
        dstr_append_i64(&layout, grade.targets)
        dstr_append_cstr(&layout, " targets    Wiring ")
        dstr_append_cstr(&layout, wiring)
        budget: mutable dstr = []
        dstr_append_cstr(&budget, "Press budget is the shortest route plus ")
        dstr_append_i64(&budget, grade.spare)
        dstr_append_cstr(&budget, " presses.")
        if grade.drift > 0:
            dstr_append_cstr(&budget, " Wiring turns every ")
            dstr_append_i64(&budget, grade.drift)
            dstr_append_cstr(&budget, " presses.")
        if grade.dies > 0:
            dstr_append_cstr(&budget, " A key dies after press ")
            dstr_append_i64(&budget, grade.dies)
            dstr_append_cstr(&budget, ".")
        Display::draw_text(list, bytes_view(layout), 456.0, 282.0, 16.0, ink, Display::ANCHOR_CENTER_CENTER)
        Display::draw_text(list, bytes_view(budget), 456.0, 252.0, 15.0, ink, Display::ANCHOR_CENTER_CENTER)
        if adaptive:
            Display::draw_text(list, "Reach every target to climb a level next round.", 456.0, 222.0, 15.0,
                ink, Display::ANCHOR_CENTER_CENTER)
