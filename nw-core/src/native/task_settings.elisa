# Four-field options shared by Crossword, Scrabble, Algebra and Scramble.
module TaskSettings:
    def allowed(task: i64, row: i64, value: i64) -> bool:
        return false if task < 0 or task > 3
        if row == 0:
            return value >= 1 and value <= (10 if task < 2 else 12)
        if row == 1:
            return false if value == 6 and task != 2
            return false if value == 15 and task == 0
            return SyllogismOptions::allowed(1, value)
        return (value == 0 or value == 1) if row == 2 or row == 3 else false

    def path(out: i64, task: i64, create: bool) -> i64:
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            return -1 if task < 0 or task > 3
            variable: cstr = "NW_CROSSWORD_SETTINGS_PATH" if task == 0 else ("NW_SCRABBLE_SETTINGS_PATH" if task == 1 else ("NW_ALGEBRA_SETTINGS_PATH" if task == 2 else "NW_SCRAMBLE_SETTINGS_PATH"))
            suffix: cstr = "/crossword-options" if task == 0 else ("/scrabble-options" if task == 1 else ("/algebra-options" if task == 2 else "/scramble-options"))
            trusted Unsafe.PointerCast:
                if getenv(variable) is override:
                    if override != 0.u8():
                        return SyllogismOptionsHost::settings_override(out, 4096, override.cast[cstr], create)
                named: i64 = sdl_named_task_settings_path(out, 4096, suffix, create)
                return named if named != -2
                selected: i64 = SyllogismOptionsHost::data_settings_path(out, 4096, suffix, create)
                return selected if selected != -2
                platform: heap u8& = SDL_GetPlatform().cast[heap u8&]
                windows: bool = platform[0] == 87.u8() and platform[1] == 105.u8() and platform[2] == 110.u8()
                base: mutable i64 = 0
                if windows:
                    if getenv("APPDATA") is found:
                        base <- found.uintptr().i64() if found != 0.u8()
                    if base == 0:
                        if getenv("USERPROFILE") is found:
                            base <- found.uintptr().i64() if found != 0.u8()
                else:
                    if getenv("HOME") is found:
                        base <- found.uintptr().i64() if found != 0.u8()
                return -1 if base == 0
                end: mutable i64 = SyllogismOptionsHost::append(out, 4096, 0, base.uintptr().cast[cstr])
                return -1 if end < 0
                end <- SyllogismOptionsHost::append(out, 4096, end, "/Neural Workshop" if windows else "/.neural-workshop")
                return -1 if end < 0
                return -1 if create and not SDL_CreateDirectory(out.uintptr().cast[cstr])
                return SyllogismOptionsHost::append(out, 4096, end, suffix)

    def decode(data: i64, length: i64, task: i64, output: mutable i64&?) -> i32:
        can Abort.Panic, Unsafe.PointerCast:
            return 0 if data == 0 or length <= 0 or length > 255 or output == null
            values: mutable i64[4] = zeroed
            at: mutable i64 = 0
            trusted Unsafe.PointerCast:
                bytes: heap u8& = data.uintptr().cast[heap u8&]
                for row in 0..<4 |row, values, at, length, bytes, task|:
                    value: i64 = SyllogismOptions::saved_integer(bytes, length, &at)
                    return 0 if not allowed(task, row, value)
                    values[row.usize()] <- value
                while at < length and SyllogismOptions::whitespace(bytes[at.usize()].i64()) |at, length, bytes|:
                    at <- at + 1
                return 0 if at != length
                pointer: mutable i64& = output
                dest: mutable heap i64& = pointer.cast[mutable heap i64&]
                for row in 0..<4 |row, dest, values|:
                    dest[row.usize()] <- values[row.usize()]
                return 1

    def read(task: i64, output: mutable i64&?):
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            return if output == null
            path_buffer: mutable u8[4096] = zeroed
            data: mutable u8[256] = zeroed
            trusted Unsafe.PointerCast:
                address: i64 = (&path_buffer[0]).uintptr().i64()
                return if path(address, task, false) < 0
                file: mutable void&? = SDL_IOFromFile(address.uintptr().cast[cstr], "rb")
                return if file == null
                stream: mutable void& = file
                length: usize = SDL_ReadIO(stream, (&data[0]).cast[mutable void&], 256.usize())
                status: i32 = SDL_GetIOStatus(stream)
                closed: bool = SDL_CloseIO(stream)
                return if not closed or status != 2.i32() or length > 255.usize()
                _ = decode((&data[0]).uintptr().i64(), length.i64(), task, output)

    def write(task: i64, output: i64&?) -> i32:
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            return 0 if output == null
            path_buffer: mutable u8[4096] = zeroed
            temporary: mutable u8[4200] = zeroed
            data: mutable u8[128] = zeroed
            trusted Unsafe.PointerCast:
                pointer: i64& = output
                values: heap i64& = pointer.cast[heap i64&]
                for row in 0..<4 |row, values, task|:
                    return 0 if not allowed(task, row, values[row.usize()])
                address: i64 = (&path_buffer[0]).uintptr().i64()
                temp_address: i64 = (&temporary[0]).uintptr().i64()
                return 0 if path(address, task, true) < 0
                return 0 if SyllogismOptionsHost::temporary(temp_address, 4200, address) < 0
                length: i32 = SDL_snprintf(&data[0], 128.usize(), "%lld %lld %lld %lld\n", values[0], values[1], values[2], values[3])
                return 0 if length <= 0.i32() or length >= 128.i32()
                return numberology_results_write(&temporary[0], &path_buffer[0], &data[0], length.usize())

export fn nw_task_settings_read(task: i64, output: mutable i64&?) = TaskSettings::read
export fn nw_task_settings_write(task: i64, output: i64&?) -> i32 = TaskSettings::write

# The CLI shares exactly the same allowed values as the saved options.
def task_settings_parse(task: i64, argc: i64, argv: usize&?, output: mutable i64&?, lexicon: mutable usize&?, saved: i64, ini: usize = 0.usize()) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 2 if task < 0 or task > 3 or argc < 1 or argv == null or output == null or lexicon == null
        trusted Unsafe.PointerCast:
            args_pointer: usize& = argv
            args: heap usize& = args_pointer.cast[heap usize&]
            pointer: mutable i64& = output
            values: mutable heap i64& = pointer.cast[mutable heap i64&]
            path_out: mutable usize& = lexicon
            values[0] <- 2 if task == 0 else 3
            values[1] <- 3 if task == 0 else (6 if task == 2 else 5)
            values[2] <- 1
            values[3] <- 1
            path_out[0] <- 0.usize()
            sdl_apply_task_ini_defaults(values, ini, 4)
            TaskSettings::read(task, output) if saved != 0
            option_level: cstr = "--crossword-level" if task == 0 else ("--scrabble-level" if task == 1 else ("--algebra-level" if task == 2 else "--scramble-level"))
            option_trials: cstr = "--crossword-trials" if task == 0 else ("--scrabble-trials" if task == 1 else ("--algebra-trials" if task == 2 else "--scramble-trials"))
            option_first: cstr = "--crossword-no-mistakes" if task == 0 else ("--scrabble-no-premiums" if task == 1 else ("--algebra-no-working" if task == 2 else "--scramble-no-count"))
            option_adaptive: cstr = "--crossword-no-adaptive" if task == 0 else ("--scrabble-no-adaptive" if task == 1 else ("--algebra-no-adaptive" if task == 2 else "--scramble-no-adaptive"))
            option_path: cstr = "--crossword-lexicon" if task == 0 else "--scrabble-lexicon"
            at: mutable i64 = 1
            while at < argc |at, argc, args, values, path_out, task, option_level, option_trials, option_first, option_adaptive, option_path|:
                name: i64 = args[at.usize()].i64()
                if syllogism_argument_is(name, option_first):
                    values[2] <- 0
                elif syllogism_argument_is(name, option_adaptive):
                    values[3] <- 0
                elif syllogism_argument_is(name, option_level) or syllogism_argument_is(name, option_trials) or (task < 2 and syllogism_argument_is(name, option_path)):
                    is_path: bool = task < 2 and syllogism_argument_is(name, option_path)
                    row: i64 = 0 if syllogism_argument_is(name, option_level) else 1
                    at <- at + 1
                    if at >= argc:
                        SDL_Log("Task option requires a value")
                        return 2
                    argument: i64 = args[at.usize()].i64()
                    if is_path:
                        path_out[0] <- args[at.usize()]
                    else:
                        length: i64 = syllogism_argument_length(argument)
                        parsed: i64 = SyllogismOptions::parse_argument(argument, length, row)
                        if not TaskSettings::allowed(task, row, parsed):
                            SDL_Log("Invalid task option value")
                            return 2
                        values[row.usize()] <- parsed
                at <- at + 1
            return 0

def task_settings_parse_legacy(task: i64, argc: i64, argv: usize&?, output: mutable i64&?, lexicon: mutable usize&?, saved: i64) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return task_settings_parse(task, argc, argv, output, lexicon, saved)

export fn nw_task_settings_parse(task: i64, argc: i64, argv: usize&?, output: mutable i64&?, lexicon: mutable usize&?, saved: i64) -> i32 = task_settings_parse_legacy

def task_options_modify(task: i64, output: mutable i64&?, row: i64, step: i64) -> i32:
    can Abort.Panic, Unsafe.PointerCast:
        return 0 if output == null or task < 0 or task > 3 or row < 0 or row > 3
        trusted Unsafe.PointerCast:
            pointer: mutable i64& = output
            values: mutable heap i64& = pointer.cast[mutable heap i64&]
            value: i64 = values[row.usize()]
            return 0 if not TaskSettings::allowed(task, row, value)
            if row >= 2:
                values[row.usize()] <- 1 - value
            elif row == 0:
                limit: i64 = 10 if task < 2 else 12
                values[0] <- limit if step < 0 and value == 1 else (1 if step >= 0 and value == limit else value + (-1 if step < 0 else 1))
            else:
                candidate: mutable i64 = value
                while true |candidate, task, step|:
                    candidate <- candidate + (-1 if step < 0 else 1)
                    candidate <- 15 if candidate < 1 else (1 if candidate > 15 else candidate)
                    break if TaskSettings::allowed(task, 1, candidate)
                values[1] <- candidate
            return 1

def task_options_pack(task: i64, output: i64&?) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if output == null or task < 0 or task > 1
        trusted Unsafe.PointerCast:
            pointer: i64& = output
            values: heap i64& = pointer.cast[heap i64&]
            return -1 if not TaskSettings::allowed(task, 0, values[0]) or not TaskSettings::allowed(task, 1, values[1]) or not TaskSettings::allowed(task, 2, values[2]) or not TaskSettings::allowed(task, 3, values[3])
            index: mutable i64 = 0
            candidate: mutable i64 = 1
            while candidate < values[1] |candidate, index, task, values|:
                index <- index + 1 if TaskSettings::allowed(task, 1, candidate)
                candidate <- candidate + 1
            return values[0] | (index << 4) | (values[2] << 7) | (values[3] << 8)

export fn nw_task_options_modify(task: i64, output: mutable i64&?, row: i64, step: i64) -> i32 = task_options_modify
export fn nw_task_options_pack(task: i64, output: i64&?) -> i64 = task_options_pack
