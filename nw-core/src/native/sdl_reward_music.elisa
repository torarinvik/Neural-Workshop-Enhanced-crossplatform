# A reward owns one SDL_mixer device until the session is restarted or closed.
def sdl_reward_mixer_name() -> cstr:
    can Abort.Panic, Unsafe.PointerCast:
        platform: i64 = SDL_GetPlatform().uintptr().i64()
        return "libSDL3_mixer.0.dylib" if syllogism_argument_is(platform, "macOS") else ("SDL3_mixer.dll" if syllogism_argument_is(platform, "Windows") else "libSDL3_mixer.so.0")

def sdl_reward_mixer_library() -> mutable void&?:
    can Blocking.IO, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            if SDL_getenv("NW_MIXER_LIBRARY") is override:
                return SDL_LoadObject(override.cast[cstr]) if override != 0.u8()
            name: cstr = sdl_reward_mixer_name()
            if sdl_packaged_library(name) is library:
                return library
            return SDL_LoadObject(name)

def sdl_reward_close_device(library: usize, mixer: usize):
    can Blocking.IO, Unsafe.PointerCast:
        if mixer != 0.usize():
            trusted Unsafe.PointerCast:
                destroy: usize = SDL_LoadFunction(library.cast[mutable void&], "MIX_DestroyMixer")
                close_mixer: fn(usize) -> void = destroy.cast[fn(usize) -> void]
                close_mixer(mixer)

def sdl_reward_quit(library: usize):
    can Blocking.IO, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            quit: usize = SDL_LoadFunction(library.cast[mutable void&], "MIX_Quit")
            quit_mixer: fn() -> void = quit.cast[fn() -> void]
            quit_mixer()
            SDL_UnloadObject(library.cast[mutable void&])

def sdl_reward_mixer_stop(library: usize, mixer: usize):
    can Blocking.IO, Unsafe.PointerCast:
        return if library == 0.usize()
        sdl_reward_close_device(library, mixer)
        sdl_reward_quit(library)

def sdl_reward_mixer_start(library: mutable void&, path: cstr, gain: f32) -> usize:
    can Blocking.IO, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            init: usize = SDL_LoadFunction(library, "MIX_Init")
            create: usize = SDL_LoadFunction(library, "MIX_CreateMixerDevice")
            load: usize = SDL_LoadFunction(library, "MIX_LoadAudio")
            set_gain: usize = SDL_LoadFunction(library, "MIX_SetMixerGain")
            play: usize = SDL_LoadFunction(library, "MIX_PlayAudio")
            drop: usize = SDL_LoadFunction(library, "MIX_DestroyAudio")
            if init == 0.usize() or create == 0.usize() or load == 0.usize() or set_gain == 0.usize() or play == 0.usize() or drop == 0.usize() or SDL_LoadFunction(library, "MIX_Quit") == 0.usize() or SDL_LoadFunction(library, "MIX_DestroyMixer") == 0.usize():
                SDL_UnloadObject(library)
                return 0.usize()
            initialize: fn() -> bool = init.cast[fn() -> bool]
            if not initialize():
                SDL_UnloadObject(library)
                return 0.usize()
            open: fn(u32, usize) -> usize = create.cast[fn(u32, usize) -> usize]
            mixer: usize = open(SDLAudio::DEFAULT_PLAYBACK, 0.usize())
            if mixer != 0.usize():
                decode: fn(usize, cstr, bool) -> usize = load.cast[fn(usize, cstr, bool) -> usize]
                volume: fn(usize, f32) -> bool = set_gain.cast[fn(usize, f32) -> bool]
                start: fn(usize, usize) -> bool = play.cast[fn(usize, usize) -> bool]
                release_audio: fn(usize) -> void = drop.cast[fn(usize) -> void]
                audio: usize = decode(mixer, path, false)
                if audio != 0.usize():
                    started: bool = volume(mixer, gain) and start(mixer, audio)
                    release_audio(audio)
                    return mixer if started
            sdl_reward_mixer_stop(library.uintptr(), mixer)
            return 0.usize()

def sdl_reward_album(path: mutable u8&, tier: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast, Blocking.IO:
        trusted Unsafe.PointerCast:
            offset: mutable i64 = 0
            if SDL_getenv("NW_REWARD_MUSIC_DIR") is directory:
                return -1 if directory == 0.u8()
                offset <- SyllogismOptionsHost::append(path.uintptr().i64(), 4096, 0, directory.cast[cstr])
            elif SDL_GetBasePath() is base:
                offset <- SyllogismOptionsHost::append(path.uintptr().i64(), 4096, 0, base.cast[cstr])
                offset <- SyllogismOptionsHost::append(path.uintptr().i64(), 4096, offset, "res/music")
            else:
                return -1
            folder: cstr = "/advance" if tier == 3 else ("/great" if tier == 2 else "/good")
            return SyllogismOptionsHost::append(path.uintptr().i64(), 4096, offset, folder)

def sdl_reward_track(path: mutable u8&, tier: i64) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            offset: i64 = sdl_reward_album(path, tier)
            return false if offset < 0
            count: mutable i32 = 0.i32()
            files: mutable heap void&? = SDL_GlobDirectory(path.cast[cstr], "*.ogg", 0.u32(), (&count).uintptr())
            if count == 0.i32():
                if files is empty:
                    SDL_free(empty)
                files <- SDL_GlobDirectory(path.cast[cstr], "*.wav", 0.u32(), (&count).uintptr())
            if files is list:
                selected: mutable i64 = -1
                if count > 0.i32():
                    names: heap usize& = list.cast[heap usize&]
                    index: usize = (SDL_rand_bits() % count.u32()).usize()
                    separator: i64 = SyllogismOptionsHost::append(path.uintptr().i64(), 4096, offset, "/")
                    selected <- SyllogismOptionsHost::append(path.uintptr().i64(), 4096, separator, names[index].cast[cstr])
                SDL_free(list)
                return selected >= 0
            return false

def sdl_reward_fade_gain(gain: f64, steps: i64) -> f64:
    can Abort.Panic:
        volume: mutable f64 = gain
        for step in 0..<steps |step, volume|:
            return 0.0 if volume <= 0.02
            volume <- volume - (0.02 if volume <= 0.1 else 0.1)
        return volume if volume > 0.02 else 0.0

def sdl_reward_mixer_gain(library: usize, mixer: usize, gain: f32) -> bool:
    can Blocking.IO, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            address: usize = SDL_LoadFunction(library.cast[mutable void&], "MIX_SetMixerGain")
            return false if address == 0.usize()
            volume: fn(usize, f32) -> bool = address.cast[fn(usize, f32) -> bool]
            return volume(mixer, gain)

def sdl_nback3d_reward_fade(handle: i64, now: u64):
    can Blocking.IO, Abort.Panic, Unsafe.PointerCast:
        return if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap NBack3DGame::NBack3DRun& = handle.uintptr().cast[mutable heap NBack3DGame::NBack3DRun&]
            if run.phase == NBack3DGame::PHASE_DONE or (run.music_library == 0.usize() and run.applause_voice == 0.usize()):
                run.reward_fade_at <- 0.u64()
                return
            if run.reward_fade_at == 0.u64():
                run.reward_fade_at <- now + 50.u64()
                return
            return if now < run.reward_fade_at
            elapsed_steps: u64 = 1.u64() + (now - run.reward_fade_at) / 50.u64()
            steps: i64 = elapsed_steps.i64() if elapsed_steps < 20.u64() else 20
            run.reward_fade_at <- now + 50.u64() - ((now - run.reward_fade_at) % 50.u64())
            if run.applause_voice != 0.usize():
                voice: mutable void& = run.applause_voice.cast[mutable void&]
                run.applause_live_gain <- sdl_reward_fade_gain(run.applause_live_gain, steps)
                if run.applause_live_gain == 0.0 or not SDL_SetAudioStreamGain(voice, run.applause_live_gain.f32()):
                    SDLAudio::stop(voice)
                    run.applause_voice <- 0.usize()
            if run.music_library != 0.usize():
                run.music_live_gain <- sdl_reward_fade_gain(run.music_live_gain, steps)
                if run.music_live_gain == 0.0 or not sdl_reward_mixer_gain(run.music_library, run.music_mixer, run.music_live_gain.f32()):
                    sdl_reward_mixer_stop(run.music_library, run.music_mixer)
                    run.music_library <- 0.usize()
                    run.music_mixer <- 0.usize()
                    run.music_tier <- 0

def sdl_nback3d_reward_music(handle: i64):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap NBack3DGame::NBack3DRun& = handle.uintptr().cast[mutable heap NBack3DGame::NBack3DRun&]
            return if run.phase != NBack3DGame::PHASE_DONE or not run.music_pending
            run.music_pending <- false
            if run.music_library != 0.usize():
                sdl_reward_mixer_stop(run.music_library, run.music_mixer)
                run.music_library <- 0.usize()
                run.music_mixer <- 0.usize()
                run.music_tier <- 0
            score: i64 = NBack3DGame::score_percent(run, run.progression.jaeggi)
            advance: i64 = run.progression.advance_threshold
            fallback: i64 = run.progression.fallback_threshold
            tier: mutable i64 = 3
            path: mutable u8[4096] = zeroed
            target: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
            while tier > 0 |tier, target, run, score, advance, fallback|:
                threshold: i64 = advance if tier == 3 else ((advance + fallback) / 2 if tier == 2 else fallback)
                if score >= threshold and sdl_reward_track(target, tier):
                    if sdl_reward_mixer_library() is library:
                        mixer: usize = sdl_reward_mixer_start(library, target.cast[cstr], run.music_gain)
                        if mixer != 0.usize():
                            run.music_library <- library.uintptr()
                            run.music_mixer <- mixer
                            run.music_tier <- tier
                            run.music_live_gain <- run.music_gain.f64()
                    return
                tier <- tier - 1


def sdl_music_package_selftest(with_tracks: bool) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        if not with_tracks:
            if sdl_packaged_library(sdl_reward_mixer_name()) is library:
                valid: bool = SDL_LoadFunction(library, "MIX_Init") != 0.usize() and SDL_LoadFunction(library, "MIX_LoadAudio") != 0.usize() and SDL_LoadFunction(library, "MIX_PlayAudio") != 0.usize()
                SDL_UnloadObject(library)
                if valid:
                    _ = printf("Packaged SDL_mixer selftest: PASS\n")
                    return 0.i32()
            SDL_Log("Could not load SDL_mixer from the application package")
            return 1.i32()
        path: mutable u8[4096] = zeroed
        played: mutable i64 = 0
        trusted Unsafe.PointerCast:
            target: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
            for tier in 1..<4 |tier, target, played|:
                if sdl_reward_track(target, tier):
                    if sdl_packaged_library(sdl_reward_mixer_name()) is library:
                        mixer: usize = sdl_reward_mixer_start(library, target.cast[cstr], 0.0.f32())
                        if mixer != 0.usize():
                            sdl_reward_mixer_stop(library.uintptr(), mixer)
                            played <- played + 1
                            continue
                    SDL_Log("Could not play packaged reward music: %s", target.cast[cstr])
                    return 1.i32()
        if played == 0:
            SDL_Log("The package contains no playable reward music tracks")
            return 1.i32()
        _ = printf("Packaged reward music selftest: PASS (%lld tiers)\n", played)
        return 0.i32()
