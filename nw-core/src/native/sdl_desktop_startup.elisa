# Own the desktop session from argument parsing through release. The host
# supplies only library entry points and optional platform callbacks.
def sdl_run_desktop(argc: i32, argv: usize&, pixel_format: u32, png_writer: usize, png_loader: usize, font: usize, poll: usize, pointer: usize, writer: usize, shutdown: usize, marble_advance: usize, marble_key: usize, marble_finish: usize, marble_close: usize) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
        capacity: i64 = NativeDisplayDecode::DESKTOP_FRAME_BYTES
        options: mutable i64[25] = zeroed
        lexicons: mutable usize[5] = zeroed
        syllogism_options: mutable i64[5] = zeroed
        syllogism_results: mutable usize[2] = zeroed
        numberology_results: mutable usize[2] = zeroed
        dimensions: mutable i32[2] = zeroed
        startup: mutable i64[6] = zeroed
        tasks: mutable i64[15] = zeroed
        maze: mutable i64[7] = zeroed
        paths: mutable usize[3] = zeroed
        window: mutable usize[3] = zeroed
        surface: mutable usize = 0.usize()
        trusted Unsafe.PointerCast:
            configs: usize[12] = [
                (&options[0]).uintptr(), (&lexicons[0]).uintptr(),
                (&options[5]).uintptr(), (&lexicons[1]).uintptr(),
                (&syllogism_options[0]).uintptr(), 0.usize(),
                (&options[10]).uintptr(), (&lexicons[2]).uintptr(),
                (&options[15]).uintptr(), (&lexicons[3]).uintptr(),
                (&options[20]).uintptr(), (&lexicons[4]).uintptr()
            ]
            config_rows: usize& = (&configs[0]).uintptr().cast[usize&]
            size: mutable i32& = (&dimensions[0]).uintptr().cast[mutable i32&]
            startup_rows: mutable i64& = (&startup[0]).uintptr().cast[mutable i64&]
            task_options: mutable i64& = (&tasks[0]).uintptr().cast[mutable i64&]
            maze_options: mutable i64& = (&maze[0]).uintptr().cast[mutable i64&]
            status: i32 = sdl_prepare_startup(argc.i64(), argv, size, startup_rows,
                task_options, maze_options, config_rows, (&paths[0]).uintptr().cast[mutable usize&])
            return status if status >= 0.i32()
            window_rows: mutable usize& = (&window[0]).uintptr().cast[mutable usize&]
            if sdl_open_desktop(window_rows, size, capacity, paths[2], png_writer, pixel_format, &surface, png_loader, font,
                    startup[3], startup[4], startup[5]) == 0.i32():
                return 1.i32()

            handles: mutable i64[142] = zeroed
            modes: mutable u8[142] = zeroed
            exit_rows: mutable usize[284] = zeroed
            active_handles: mutable i64& = (&handles[0]).uintptr().cast[mutable i64&]
            active_modes: mutable u8& = (&modes[0]).uintptr().cast[mutable u8&]
            rows: mutable usize& = (&exit_rows[0]).uintptr().cast[mutable usize&]
            sdl_bind_rows(active_handles, active_modes, rows)
            index: u8&? = paths[0].cast[u8&?]
            sentences: u8&? = paths[1].cast[u8&?]
            if sdl_start_desktop_task(window_rows, surface, startup[0], rows, maze_options, task_options,
                    config_rows, index, sentences) == 0.i32():
                return 1.i32()

            drafts: mutable i64[30] = zeroed
            flags: mutable u8[18] = zeroed
            selections: mutable i32[6] = zeroed
            syllogism_selection: mutable i64 = 0
            edit_value: mutable i64 = 0
            special_keys: mutable usize[66] = zeroed
            special: mutable usize& = (&special_keys[0]).uintptr().cast[mutable usize&]
            syllogism: mutable usize& = (&syllogism_results[0]).uintptr().cast[mutable usize&]
            numberology: mutable usize& = (&numberology_results[0]).uintptr().cast[mutable usize&]
            sdl_bind_special_rows(active_handles, active_modes, config_rows,
                (&drafts[0]).uintptr().cast[mutable i64&], (&flags[0]).uintptr().cast[mutable u8&],
                (&selections[0]).uintptr().cast[mutable i32&], &syllogism_selection, &edit_value,
                syllogism, numberology, special)

            marble_presentation: mutable usize[5] = zeroed
            marble_physics: mutable usize = 0.usize()
            physics_clock: mutable u64 = 0.u64()
            marble: bool = marble_advance != 0.usize()
            presentation: usize = (&marble_presentation[0]).uintptr() if marble else 0.usize()
            physics: usize = (&marble_physics).uintptr() if marble else 0.usize()
            clock: usize = (&physics_clock).uintptr() if marble else 0.usize()
            result: i32 = sdl_run_desktop_loop(window_rows, size, rows, special, task_options,
                config_rows, startup[0], startup[1], startup[2], capacity, index, sentences,
                maze_options, poll, pointer, writer, marble_advance, marble_key, marble_finish,
                presentation, physics, clock, surface, paths[2], png_writer, argc.i64(), argv)
            close: fn(usize, usize, usize, usize, usize, usize, usize, usize) -> void = shutdown.cast[fn(usize, usize, usize, usize, usize, usize, usize, usize) -> void]
            close(window_rows.uintptr(), surface, rows.uintptr(), syllogism.uintptr(),
                numberology.uintptr(), marble_close, presentation, physics)
            return result

export fn nw_sdl_run_desktop(argc: i32, argv: usize&, pixel_format: u32, png_writer: usize, png_loader: usize, font: usize, poll: usize, pointer: usize, writer: usize, shutdown: usize, marble_advance: usize, marble_key: usize, marble_finish: usize, marble_close: usize) -> i32 = sdl_run_desktop

include "./sdl_desktop_bindings.elisa"

# The platform entry point supplies the SDL pixel format and optional symbols.
def sdl_desktop_entry(argc: i32, argv: usize&, bindings: SDLDesktopBindings&) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
        if bindings.marble_set_png_loader != 0.usize():
            trusted Unsafe.PointerCast:
                set_png_loader: fn(usize) -> void = bindings.marble_set_png_loader.cast[fn(usize) -> void]
                startup_status: fn(i64, usize) -> i32 = bindings.marble_startup_status.cast[fn(i64, usize) -> i32]
                set_png_loader(bindings.png_loader)
                status: i32 = startup_status(argc.i64(), argv.uintptr())
                return status if status >= 0.i32()
        return sdl_run_desktop(argc, argv, bindings.pixel_format.u32(), bindings.png_writer, bindings.png_loader,
            bindings.font, bindings.poll, bindings.pointer, bindings.writer, bindings.shutdown,
            bindings.marble_advance, bindings.marble_key, bindings.marble_finish, bindings.marble_close)

def sdl_desktop_main(argc: i32, argv: usize&, bindings: SDLDesktopBindings&) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
        return sdl_cli_run(argc, argv, 0.usize(), bindings)

export fn nw_sdl_desktop_main(argc: i32, argv: usize&, bindings: SDLDesktopBindings&) -> i32 = sdl_desktop_main
