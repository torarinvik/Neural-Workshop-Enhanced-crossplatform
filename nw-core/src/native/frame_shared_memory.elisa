# Native owner for a single named NWFB mapping. All OS calls go through FFI.
static if ELISA_TARGET_OS_WINDOWS:
    extern CreateFileMappingW(file: uintptr, attributes: uintptr, protection: u32, size_high: u32, size_low: u32, name: u16&) -> uintptr
    extern MapViewOfFile(mapping: uintptr, access: u32, offset_high: u32, offset_low: u32, bytes: usize) -> uintptr
    extern UnmapViewOfFile(address: uintptr) -> i32
    extern CloseHandle(handle: uintptr) -> i32
    extern GetLastError() -> u32
    extern MultiByteToWideChar(code_page: u32, flags: u32, source: cstr, source_size: i32, output: mutable u16&, capacity: i32) -> i32
static else:
    extern shm_open(name: cstr, flags: i32, ...) -> i32
    extern shm_unlink(name: cstr) -> i32
    extern ftruncate(fd: i32, length: i64) -> i32
    extern close(fd: i32) -> i32
    extern mmap(addr: uintptr, length: usize, prot: i32, flags: i32, fd: i32, offset: i64) -> uintptr
    extern munmap(addr: heap void&, length: usize) -> i32

module FrameSharedMemory:
    struct Mapping:
        address: mutable uintptr
        os_handle: mutable uintptr
        capacity: mutable i64
        name: mutable u8[256]

    def open_mapping(mapping: mutable Mapping&, original_name: cstr, capacity: i64) -> uintptr:
        can Abort.Panic, Unsafe.PointerCast:
            static if ELISA_TARGET_OS_WINDOWS:
                wide: mutable u16[256] = zeroed
                if MultiByteToWideChar(65001.u32(), 8.u32(), original_name, -1.i32(), &wide[0], 256.i32()) == 0.i32():
                    return 0.uintptr()
                bytes: u64 = capacity.u64()
                handle: uintptr = CreateFileMappingW(0.uintptr() - 1.uintptr(), 0.uintptr(), 4.u32(),
                    (bytes >> 32).u32(), bytes.u32(), &wide[0])
                return 0.uintptr() if handle == 0.uintptr()
                if GetLastError() == 183.u32():
                    _ = CloseHandle(handle)
                    return 0.uintptr()
                address: uintptr = MapViewOfFile(handle, 2.u32(), 0.u32(), 0.u32(), capacity.usize())
                if address == 0.uintptr():
                    _ = CloseHandle(handle)
                    return 0.uintptr()
                mapping.os_handle <- handle
                return address
            static else:
                trusted Unsafe.PointerCast:
                    # Python prepends a slash to names it opens on POSIX.
                    source: u8& = original_name.uintptr().cast[u8&]
                    start: usize = 1.usize() if source[0] == 47.u8() else 0.usize()
                    at: mutable usize = start
                    mapping.name[0] <- 47.u8()
                    while at < 255.usize() and source[at] != 0.u8() |at, source, start, mapping|:
                        return 0.uintptr() if at - start >= 254.usize() or source[at] == 47.u8()
                        mapping.name[at - start + 1.usize()] <- source[at]
                        at <- at + 1.usize()
                    return 0.uintptr() if at == start or source[at] != 0.u8()
                    mapping.name[at - start + 1.usize()] <- 0.u8()
                    name: cstr = (&mapping.name[0]).uintptr().cast[cstr]
                    # O_RDWR | O_CREAT | O_EXCL
                    flags: mutable i32 = 2562.i32()
                    static if ELISA_TARGET_OS_LINUX:
                        flags <- 194.i32()
                    fd: i32 = shm_open(name, flags, 384.i32()) # 0600
                    return 0.uintptr() if fd < 0.i32()
                    address: mutable uintptr = 0.uintptr() - 1.uintptr()
                    if ftruncate(fd, capacity) == 0.i32():
                        address <- mmap(0.uintptr(), capacity.usize(), 3.i32(), 1.i32(), fd, 0)
                    _ = close(fd)
                    if address == 0.uintptr() - 1.uintptr():
                        _ = shm_unlink(name)
                        return 0.uintptr()
                    return address

    def create(name: cstr, capacity: i64) -> uintptr:
        can Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
            return 0.uintptr() if capacity < FrameExport::HEADER_BYTES or capacity.u64() != capacity.usize().u64()
            return 0.uintptr() if name.uintptr() == 0.uintptr()
            raw: mutable heap void&? = SDL_malloc(size_of(Mapping))
            if raw is allocation:
                trusted Unsafe.PointerCast:
                    mapping: mutable heap Mapping& = allocation.cast[mutable heap Mapping&]
                    mapping.capacity <- capacity
                    mapping.address <- open_mapping(mapping, name, capacity)
                    if mapping.address != 0.uintptr():
                        return mapping.uintptr()
                    SDL_free(allocation)
            return 0.uintptr()

    def publish(handle: uintptr, sequence: u64, timestamp_ns: u64, width: u32, height: u32,
                pixels: u8&?, bytes: i64, consumed: bool) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return -1 if handle == 0.uintptr() or width == 0.u32() or height == 0.u32() or bytes < 4
            return -1 if pixels == null or bytes % 4 != 0 or width.u64() * height.u64() != (bytes / 4).u64()
            return publish_rows(handle, sequence, timestamp_ns, width, height, pixels, width.i64() * 4, consumed)

    def publish_rows(handle: uintptr, sequence: u64, timestamp_ns: u64, width: u32, height: u32,
                     pixels: u8&?, stride: i64, consumed: bool) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return -1 if handle == 0.uintptr() or pixels == null or width == 0.u32() or height == 0.u32()
            row_bytes: i64 = width.i64() * 4
            return -1 if stride < row_bytes
            rgba: u8& = pixels
            trusted Unsafe.PointerCast:
                mapping: Mapping& = handle.cast[Mapping&]
                return -1 if height.i64() > (mapping.capacity - FrameExport::HEADER_BYTES) / row_bytes
                return -1 if stride > 9223372036854775807 / height.i64()
                frame: mutable u8& = mapping.address.cast[mutable u8&]
                for row in 0..<height.i64() |row, frame, row_bytes, rgba, stride|:
                    dest: mutable void& = (&frame[(FrameExport::HEADER_BYTES + row * row_bytes).usize()]).cast[mutable void&]
                    source: void& = (&rgba[(row * stride).usize()]).cast[void&]
                    _ = memcpy(dest, source, row_bytes.usize())
                _ = FrameExport::write_header(frame, mapping.capacity, sequence, timestamp_ns, width, height, consumed)
                return row_bytes * height.i64() + FrameExport::HEADER_BYTES

    def release(owner: mutable uintptr&):
        can Abort.Panic, Memory.Release, Unsafe.PointerCast:
            handle: uintptr = owner[0]
            return if handle == 0.uintptr()
            owner[0] <- 0.uintptr()
            trusted Unsafe.PointerCast:
                mapping: mutable heap Mapping& = handle.cast[mutable heap Mapping&]
                static if ELISA_TARGET_OS_WINDOWS:
                    _ = UnmapViewOfFile(mapping.address)
                    _ = CloseHandle(mapping.os_handle)
                static else:
                    _ = shm_unlink((&mapping.name[0]).uintptr().cast[cstr])
                    _ = munmap(mapping.address.cast[heap void&], mapping.capacity.usize())
                SDL_free(mapping.cast[heap void&])

export fn nw_frame_shared_create(name: cstr, capacity: i64) -> uintptr = FrameSharedMemory::create
export fn nw_frame_shared_publish(handle: uintptr, sequence: u64, timestamp_ns: u64, width: u32, height: u32, pixels: u8&?, bytes: i64, consumed: bool) -> i64 = FrameSharedMemory::publish
export fn nw_frame_shared_release(owner: mutable uintptr&) = FrameSharedMemory::release
