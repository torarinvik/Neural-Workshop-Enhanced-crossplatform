extern SDL_memcpy(dest: mutable void&, source: void&, length: usize) -> mutable void&

# Expand attached values into the argv representation used by task parsers.
# Option names point to static strings and values borrow the original argv.
def sdl_cli_path_option(option: i64) -> bool:
    return option == 5 or option == 17 or option == 27 or option == 28 or option == 30 or option == 32 or option == 33 or option == 34

def sdl_cli_path_value(value: usize, attached: bool, expand_home: bool, owned: mutable usize&, at: usize) -> usize:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            text: u8& = value.cast[u8&]
            prefix: mutable usize = 0.usize()
            suffix: mutable usize = value
            if attached and text[0] == 45.u8():
                dot: cstr = "./"
                prefix <- dot.uintptr()
            elif expand_home and text[0] == 126.u8() and (text[1] == 0.u8() or text[1] == 47.u8()):
                home: u8&? = getenv("USERPROFILE") if syllogism_argument_is(SDL_GetPlatform().uintptr().i64(), "Windows") else getenv("HOME")
                if home != null:
                    prefix <- home.uintptr()
                    suffix <- (&text[1]).uintptr()
            return value if prefix == 0.usize()
            prefix_length: usize = SDL_strlen(prefix.cast[cstr])
            suffix_length: usize = SDL_strlen(suffix.cast[cstr])
            raw: mutable heap void&? = SDL_malloc(prefix_length + suffix_length + 1.usize())
            return 0.usize() if raw == null
            block: mutable heap void& = raw
            path: mutable heap u8& = block.cast[mutable heap u8&]
            _ = SDL_memcpy(block, prefix.cast[void&], prefix_length)
            _ = SDL_memcpy((&path[prefix_length]).cast[mutable void&], suffix.cast[void&], suffix_length + 1.usize())
            owned[at] <- block.uintptr()
            return block.uintptr()

extern SDL_strncmp(left: cstr, right: cstr, length: usize) -> i32

def sdl_cli_long_option(index: i64) -> cstr:
    return sdl_cli_option_1(index) if index < SDL_CLI_VALUE_OPTIONS
    return sdl_cli_option_0(index - SDL_CLI_VALUE_OPTIONS) if index < SDL_CLI_VALUE_OPTIONS + SDL_CLI_FLAGS
    return "--help"

# An exact name wins over longer names with the same prefix.
def sdl_cli_match_option(text: cstr, length: usize) -> i64:
    can Abort.Panic:
        candidate: mutable i64 = -1
        for index in 0..<(SDL_CLI_VALUE_OPTIONS + SDL_CLI_FLAGS + 1) |index, text, length, candidate|:
            name: cstr = sdl_cli_long_option(index)
            if SDL_strncmp(text, name, length) == 0.i32():
                return index if SDL_strlen(name) == length
                candidate <- index if candidate == -1 else -2
        return candidate

def sdl_cli_expand(argc: i64, args: usize&, out: mutable usize&, owned: mutable usize&) -> i32:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        out[0] <- args[0]
        count: mutable usize = 1.usize()
        at: mutable i64 = 1
        while at < argc |at, argc, args, out, count, owned|:
            address: usize = args[at.usize()]
            trusted Unsafe.PointerCast:
                text: u8& = address.cast[u8&]
                if syllogism_argument_is(address.i64(), "--"):
                    if at + 1 < argc:
                        out[count] <- address
                        out[count + 1.usize()] <- args[(at + 1).usize()]
                        count <- count + 2.usize()
                    break
                out[count] <- address
                count <- count + 1.usize()
                if text[0] == 45.u8() and text[1] == 45.u8():
                    length: mutable usize = 2.usize()
                    while text[length] != 0.u8() and text[length] != 61.u8() |length, text|:
                        length <- length + 1.usize()
                    option: i64 = sdl_cli_match_option(address.cast[cstr], length)
                    attached: bool = text[length] == 61.u8()
                    if option >= 0 and (not attached or option < SDL_CLI_VALUE_OPTIONS):
                        out[count - 1.usize()] <- sdl_cli_long_option(option).uintptr()
                        if option < SDL_CLI_VALUE_OPTIONS and (attached or at + 1 < argc):
                            value: mutable usize = 0.usize()
                            if attached:
                                value <- (&text[length + 1.usize()]).uintptr()
                            else:
                                at <- at + 1
                                value <- args[at.usize()]
                            if sdl_cli_path_option(option):
                                value <- sdl_cli_path_value(value, attached, option != 5, owned, at.usize())
                            return -1.i32() if value == 0.usize()
                            out[count] <- value
                            count <- count + 1.usize()
            at <- at + 1
        out[count] <- 0.usize()
        return count.i32()

export fn nw_sdl_cli_expand(argc: i64, args: usize&, out: mutable usize&, owned: mutable usize&) -> i32 = sdl_cli_expand

extern SDL_calloc(count: usize, size: usize) -> mutable heap void&? can[Memory.Allocate]

def sdl_cli_invoke(argc: i32, args: usize&, entry: usize, desktop: SDLDesktopBindings&?) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
        if desktop is bindings:
            return sdl_desktop_entry(argc, args, bindings)
        trusted Unsafe.PointerCast:
            run: fn(i32, usize) -> i32 = entry.cast[fn(i32, usize) -> i32]
            return run(argc, args.uintptr())

def sdl_cli_run(argc: i32, args: usize&, entry: usize, desktop: SDLDesktopBindings&? = null) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
        return 2.i32() if argc < 1.i32() or argc > 1073741823.i32() or (entry == 0.usize() and desktop == null)
        trusted Unsafe.PointerCast:
            if argc > 1.i32() and SDL_strncmp(args[1].cast[cstr], "--selftest", 10.usize()) == 0.i32():
                return sdl_cli_invoke(argc, args, entry, desktop)
        count: usize = argc.usize()
        stride: usize = size_of(usize).usize()
        cells: usize = count * 3.usize() + 1.usize()
        return 2.i32() if cells > (0.usize() - 1.usize()) / stride
        memory: mutable heap void&? = SDL_calloc(cells, stride)
        return 1.i32() if memory == null
        trusted Unsafe.PointerCast:
            allocation: mutable heap void& = memory
            expanded: mutable usize& = allocation.uintptr().cast[mutable usize&]
            owned: mutable usize& = (&expanded[count * 2.usize() + 1.usize()]).uintptr().cast[mutable usize&]
            length: i32 = sdl_cli_expand(argc.i64(), args, expanded, owned)
            status: mutable i32 = 1.i32()
            if length >= 0.i32():
                status <- sdl_cli_invoke(length, expanded, entry, desktop)
            for index in 0..<argc.i64() |index, owned|:
                path: usize = owned[index.usize()]
                if path != 0.usize():
                    SDL_free(path.cast[heap void&])
            SDL_free(allocation.cast[heap void&])
            return status

def sdl_cli_run_legacy(argc: i32, args: usize&, entry: usize) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast, Global.Read, Global.Write:
        return sdl_cli_run(argc, args, entry)

export fn nw_sdl_cli_run(argc: i32, args: usize&, entry: usize) -> i32 = sdl_cli_run_legacy
