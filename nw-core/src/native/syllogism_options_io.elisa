# Bounded settings I/O through SDL3 FFI. The caller supplies the final and
# temporary paths; writes replace the old file only after a successful close.
include "./syllogism_options.elisa"

extern SDL_IOFromFile(path: cstr, mode: cstr) -> mutable void&? can[Blocking.IO]
extern SDL_ReadIO(stream: mutable void&, dest: mutable void&, size: usize) -> usize can[Blocking.IO]
extern SDL_WriteIO(stream: mutable void&, data: void&, size: usize) -> usize can[Blocking.IO]
extern SDL_GetIOStatus(stream: mutable void&) -> i32 can[Blocking.IO]
extern SDL_CloseIO(stream: mutable void&) -> bool can[Blocking.IO]
extern SDL_RenamePath(old_path: cstr, new_path: cstr) -> bool can[Blocking.IO]
extern SDL_RemovePath(path: cstr) -> bool can[Blocking.IO]

def syllogism_options_read_file(path: i64, output: i64) -> i64:
    can Blocking.IO, Abort.Panic, Unsafe.PointerCast:
        return 0 if path == 0 or output == 0
        trusted Unsafe.PointerCast:
            file: mutable void&? = SDL_IOFromFile(path.uintptr().cast[cstr], "rb")
            return 0 if file == null
            stream: mutable void& = file
            data: mutable u8[257] = zeroed
            length: usize = SDL_ReadIO(stream, (&data[0]).cast[mutable void&], 257.usize())
            status: i32 = SDL_GetIOStatus(stream)
            closed: bool = SDL_CloseIO(stream)
            return 0 if not closed or status != 2 or length > 256.usize()
            address: i64 = (&data[0]).uintptr().i64()
            values: mutable i64[5] = zeroed
            for row in 0..<5 |row, values, address, length|:
                value: i64 = SyllogismOptions::decode(address, length.i64(), row)
                return 0 if value < 0
                values[row.usize()] <- value
            target: mutable heap i64& = output.uintptr().cast[mutable heap i64&]
            for row in 0..<5 |row, values, target|:
                target[row.usize()] <- values[row.usize()]
            return 1

def syllogism_options_same_path(first: i64, second: i64) -> bool:
    can Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            a: heap u8& = first.uintptr().cast[heap u8&]
            b: heap u8& = second.uintptr().cast[heap u8&]
            at: mutable i64 = 0
            while at < 4096 |at, a, b|:
                return false if a[at.usize()] != b[at.usize()]
                return true if a[at.usize()] == 0.u8()
                at <- at + 1
            return true

def syllogism_options_write_file(path: i64, temporary: i64, level: i64, trials: i64,
                                  working: i64, adaptive: i64, real_words: i64) -> i64:
    can Blocking.IO, Abort.Panic, Unsafe.PointerCast:
        return 0 if path == 0 or temporary == 0 or syllogism_options_same_path(path, temporary)
        encoded: mutable u8[32] = zeroed
        trusted Unsafe.PointerCast:
            length: i64 = SyllogismOptions::encode((&encoded[0]).uintptr().i64(), 32, level, trials, working, adaptive, real_words)
            return 0 if length <= 0
            final_path: cstr = path.uintptr().cast[cstr]
            temp_path: cstr = temporary.uintptr().cast[cstr]
            file: mutable void&? = SDL_IOFromFile(temp_path, "wbx")
            return 0 if file == null
            stream: mutable void& = file
            wrote: usize = SDL_WriteIO(stream, (&encoded[0]).cast[void&], length.usize())
            closed: bool = SDL_CloseIO(stream)
            if wrote != length.usize() or not closed:
                _ = SDL_RemovePath(temp_path)
                return 0
            if not SDL_RenamePath(temp_path, final_path):
                _ = SDL_RemovePath(temp_path)
                return 0
            return 1

export fn nw_syllogism_options_read_file(path: i64, output: i64) -> i64 = syllogism_options_read_file
export fn nw_syllogism_options_write_file(path: i64, temporary: i64, level: i64, trials: i64, working: i64, adaptive: i64, real_words: i64) -> i64 = syllogism_options_write_file
