# SDL task CLI values in the order used by the native shell.
module SDLTaskCLI:
    def allowed(field: i64, value: i64) -> bool:
        if field == 0 or field == 11: return value >= 1 and value <= 12
        if field == 9: return value >= 1 and value <= 10
        if field == 1: return value == 1 or value == 2 or value == 3 or value == 5 or value == 8 or value == 10
        if field == 4: return (value >= 2 and value <= 8) or value == 10
        if field == 5: return value == 1 or value == 2 or value == 3 or value == 5 or value == 8 or value == 12 or value == 20
        if field == 10: return value == 1 or value == 3 or value == 5 or value == 8 or value == 10 or value == 15 or value == 20 or value == 30 or value == 50
        if field == 12: return value == 1 or value == 2 or value == 3 or value == 5 or value == 8 or value == 10 or value == 15 or value == 20
        return false

    def parse(argc: i64, argv: usize&?, output: mutable i64&?) -> i32:
        can Console.Write, Abort.Panic, Unsafe.PointerCast:
            return 2 if argc < 1 or argv == null or output == null
            trusted Unsafe.PointerCast:
                argv_ptr: usize& = argv
                args: heap usize& = argv_ptr.cast[heap usize&]
                output_ptr: mutable i64& = output
                values: mutable heap i64& = output_ptr.cast[mutable heap i64&]
                defaults: i64[15] = [3, 3, 1, 1, 3, 3, 1, 1, 0, 1, 10, 3, 5, 1, 1]
                for field in 0..<15 |field, values, defaults|:
                    values[field.usize()] <- defaults[field.usize()]
                at: mutable i64 = 1
                while at < argc |at, argc, args, values|:
                    name: i64 = args[at.usize()].i64()
                    field: mutable i64 = -1
                    if syllogism_argument_is(name, "--sudoku-level"): field <- 0
                    elif syllogism_argument_is(name, "--sudoku-puzzles"): field <- 1
                    elif syllogism_argument_is(name, "--jigsaw-side"): field <- 4
                    elif syllogism_argument_is(name, "--jigsaw-puzzles"): field <- 5
                    elif syllogism_argument_is(name, "--go-level"): field <- 9
                    elif syllogism_argument_is(name, "--go-trials"): field <- 10
                    elif syllogism_argument_is(name, "--crossed-wires-level"): field <- 11
                    elif syllogism_argument_is(name, "--crossed-wires-rounds"): field <- 12
                    elif syllogism_argument_is(name, "--sudoku-no-clashes"): values[2] <- 0
                    elif syllogism_argument_is(name, "--sudoku-no-adaptive"): values[3] <- 0
                    elif syllogism_argument_is(name, "--jigsaw-no-adaptive"): values[6] <- 0
                    elif syllogism_argument_is(name, "--jigsaw-no-preview"): values[7] <- 0
                    elif syllogism_argument_is(name, "--jigsaw-mark-placed"): values[8] <- 1
                    elif syllogism_argument_is(name, "--crossed-wires-no-adaptive"): values[13] <- 0
                    elif syllogism_argument_is(name, "--crossed-wires-no-grid"): values[14] <- 0
                    if field >= 0:
                        at <- at + 1
                        if at >= argc:
                            SDL_Log("Task option requires a value")
                            return 2
                        parsed: i64 = numberology_positive_argument(args[at.usize()].i64())
                        if not allowed(field, parsed):
                            SDL_Log("Invalid task option value")
                            return 2
                        values[field.usize()] <- parsed
                    at <- at + 1
                return 0

export fn nw_sdl_task_options_parse(argc: i64, argv: usize&?, output: mutable i64&?) -> i32 = SDLTaskCLI::parse
