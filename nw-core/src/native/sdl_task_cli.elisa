# Shared option names for startup validation and --help.
const SDL_CLI_FLAGS: i64 = 31
const SDL_CLI_VALUE_OPTIONS: i64 = 40

def sdl_nback_timing_flag(index: i64) -> cstr:
    return "--trial-ms" if index == 0
    return "--tick-ms" if index == 1
    return "--stim-ms"

def sdl_nback_timing_env(index: i64) -> cstr:
    return "NW_TRIAL_MS" if index == 0
    return "NW_TICK_MS" if index == 1
    return "NW_STIM_MS"

def sdl_apply_nback_timing_args(argc: i64, argv: usize&?) -> i32:
    can Abort.Panic, Unsafe.PointerCast:
        for index in 0..<3 |index, argc, argv|:
            flag: cstr = sdl_nback_timing_flag(index)
            name: cstr = sdl_nback_timing_env(index)
            override: usize = sdl_first_option_value(argc, argv, flag)
            address: mutable usize = override
            if address == 0.usize():
                if SDL_getenv(name) is setting:
                    address <- setting.uintptr()
            continue if address == 0.usize()
            number: mutable i64 = 0
            if sdl_signed_argument(address, &number) == 0.i32():
                SDL_Log("Invalid %s value", flag if override != 0.usize() else name)
                return 2.i32()
            if override != 0.usize():
                trusted Unsafe.PointerCast:
                    if SDL_GetEnvironment() is environment:
                        continue if SDL_SetEnvironmentVariable(environment, name, override.cast[cstr], true)
                SDL_Log("Could not apply %s", flag)
                return 1.i32()
        return 0.i32()

def sdl_nback_timing_override(index: i64, fallback: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        if SDL_getenv(sdl_nback_timing_env(index)) is setting:
            value: mutable i64 = 0
            return value if sdl_signed_argument(setting.uintptr(), &value) != 0.i32()
        return fallback

def sdl_cli_option_0(at: i64) -> cstr:
    return "--black-background" if at == 0
    return "--adaptive" if at == 1
    return "--show-marks" if at == 2
    return "--show-traps" if at == 3
    return "--dump" if at == 4
    return "--jigsaw-no-adaptive" if at == 5
    return "--jigsaw-no-preview" if at == 6
    return "--jigsaw-mark-placed" if at == 7
    return "--sudoku-no-clashes" if at == 8
    return "--sudoku-no-adaptive" if at == 9
    return "--crossed-wires-no-adaptive" if at == 10
    return "--crossed-wires-no-grid" if at == 11
    return "--crossword-no-mistakes" if at == 12
    return "--crossword-no-adaptive" if at == 13
    return "--syllogism-no-working" if at == 14
    return "--syllogism-no-adaptive" if at == 15
    return "--syllogism-invented-words" if at == 16
    return "--numberology-no-adaptive" if at == 17
    return "--algebra-no-working" if at == 18
    return "--algebra-no-adaptive" if at == 19
    return "--scramble-no-count" if at == 20
    return "--scramble-no-adaptive" if at == 21
    return "--scrabble-no-premiums" if at == 22
    return "--scrabble-no-adaptive" if at == 23
    return "--vsync" if at == 24
    return "--headless" if at == 25
    return "--recognition-sound" if at == 26
    return "--concentration-sound" if at == 27
    return "--recognition-pictures" if at == 28
    return "--concentration-pictures" if at == 29
    return "--clinical-log" if at == 30
    return ""

def sdl_cli_option_1(at: i64) -> cstr:
    return "--width" if at == 0
    return "--height" if at == 1
    return "--screen" if at == 2
    return "--trial" if at == 3
    return "--seed" if at == 4
    return "--screenshot" if at == 5
    return "--trials" if at == 6
    return "--jigsaw-side" if at == 7
    return "--jigsaw-puzzles" if at == 8
    return "--sudoku-level" if at == 9
    return "--sudoku-puzzles" if at == 10
    return "--go-level" if at == 11
    return "--go-trials" if at == 12
    return "--crossed-wires-level" if at == 13
    return "--crossed-wires-rounds" if at == 14
    return "--crossword-level" if at == 15
    return "--crossword-trials" if at == 16
    return "--crossword-lexicon" if at == 17
    return "--scrabble-level" if at == 18
    return "--syllogism-level" if at == 19
    return "--syllogism-trials" if at == 20
    return "--numberology-level" if at == 21
    return "--numberology-trials" if at == 22
    return "--algebra-level" if at == 23
    return "--algebra-trials" if at == 24
    return "--scramble-level" if at == 25
    return "--scramble-trials" if at == 26
    return "--scramble-index" if at == 27
    return "--scramble-sentences" if at == 28
    return "--scrabble-trials" if at == 29
    return "--scrabble-lexicon" if at == 30
    return "--marble-start-rung" if at == 31
    return "--datadir" if at == 32
    return "--configfile" if at == 33
    return "--statsfile" if at == 34
    return sdl_nback_timing_flag(at - 35) if at >= 35 and at < 38
    return "--user" if at == 38
    return "--fetch-esc50" if at == 39
    return ""

def sdl_cli_option_arity(address: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        for at in 0..<SDL_CLI_FLAGS |at, address|:
            return 0 if syllogism_argument_is(address, sdl_cli_option_0(at))
        for at in 0..<SDL_CLI_VALUE_OPTIONS |at, address|:
            return 1 if syllogism_argument_is(address, sdl_cli_option_1(at))
        return -1

def sdl_cli_help(argc: i64, argv: usize&?) -> i32:
    can Console.Write, Abort.Panic, Unsafe.PointerCast:
        return -1.i32() if argv == null or argc < 2
        trusted Unsafe.PointerCast:
            args: usize& = argv
            at: mutable i64 = 1
            while at < argc |at, argc, args|:
                arg: i64 = args[at.usize()].i64()
                return -1.i32() if syllogism_argument_is(arg, "--")
                if syllogism_argument_is(arg, "--help") or syllogism_argument_is(arg, "-h"):
                    return sdl_cli_print_help()
                at <- at + (2 if sdl_cli_option_arity(arg) == 1 else 1)
            return -1.i32()

def sdl_cli_print_help() -> i32:
    can Console.Write, Abort.Panic:
        _ = printf("Usage: Neural Workshop [--screen NAME] [options]\n\n")
        _ = printf("  -h, --help             Show this help\n")
        for at in 0..<SDL_CLI_FLAGS |at|:
            _ = printf("  %s\n", sdl_cli_option_0(at))
        for at in 0..<SDL_CLI_VALUE_OPTIONS |at|:
            _ = printf("  %s VALUE\n", sdl_cli_option_1(at))
        _ = printf("\nScreens (default: title):\n")
        for screen in 0..<75 |screen|:
            _ = printf("  %s\n", sdl_screen_name(screen))
        _ = printf("  what-next\n  will-it-fall\n  shape-from-motion\n  dr-shape\n  tuner\n  shadow-play\n  captcha\n  signals\n  fold-it\n  who-knows-what\n  dam-keeper\n  sonar\n  gamble\n  dispatch\n  bluff\n  explore-exploit\n  firebreak\n  crossroads\n  rail-yard\n  air-traffic\n  escort\n  sokoban-live\n  kitchen\n  crane\n  ferry\n  docking\n  rover\n  unicycle\n  morning-round\n  heavier\n  full-stop\n")
        _ = printf("  3d-maze (alias for you-are-here)\n")
        return 0.i32()

export fn nw_sdl_cli_help(argc: i64, argv: usize&?) -> i32 = sdl_cli_help

def sdl_cli_validate(argc: i64, argv: usize&?) -> i32:
    can Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 2.i32() if argv == null or argc < 1
        trusted Unsafe.PointerCast:
            args: usize& = argv
            at: mutable i64 = 1
            while at < argc |at, argc, args|:
                address: usize = args[at.usize()]
                if syllogism_argument_is(address.i64(), "--"):
                    if at + 1 < argc:
                        SDL_Log("Unexpected positional argument: %s", args[(at + 1).usize()].cast[cstr])
                        return 2.i32()
                    return 0.i32()
                arity: i64 = sdl_cli_option_arity(address.i64())
                if arity < 0:
                    SDL_Log("Unrecognized argument: %s", address.cast[cstr])
                    return 2.i32()
                if arity == 1:
                    if at + 1 >= argc:
                        SDL_Log("Expected a value for %s", address.cast[cstr])
                        return 2.i32()
                    value: u8& = args[(at + 1).usize()].cast[u8&]
                    if value[0] == 45.u8() and value[1] != 0.u8():
                        next: u8 = value[1]
                        if next != 46.u8() and (next < 48.u8() or next > 57.u8()):
                            SDL_Log("Expected a value for %s", address.cast[cstr])
                            return 2.i32()
                    if syllogism_argument_is(address.i64(), "--seed") or syllogism_argument_is(address.i64(), "--trials") or syllogism_argument_is(address.i64(), "--marble-start-rung"):
                        number: mutable i64 = 0
                        if sdl_signed_argument(args[(at + 1).usize()], &number) == 0.i32():
                            SDL_Log("Invalid %s value", address.cast[cstr])
                            return 2.i32()
                at <- at + 1 + arity
            return 0.i32()

export fn nw_sdl_cli_validate(argc: i64, argv: usize&?) -> i32 = sdl_cli_validate

# This runs after argument validation. Skip option values when selecting the
# output mode, and keep the last screenshot path as Python's argparse does.
def sdl_cli_output_mode(argc: i64, argv: usize&?, screenshot: mutable usize&?) -> i32:
    can Abort.Panic, Unsafe.PointerCast:
        return 0.i32() if argv == null or screenshot == null
        trusted Unsafe.PointerCast:
            args: usize& = argv
            path: mutable usize& = screenshot
            path[0] <- 0.usize()
            dump: mutable bool = false
            at: mutable i64 = 1
            while at < argc |at, argc, args, path, dump|:
                name: i64 = args[at.usize()].i64()
                arity: i64 = sdl_cli_option_arity(name)
                dump <- true if syllogism_argument_is(name, "--dump")
                if syllogism_argument_is(name, "--screenshot") and at + 1 < argc:
                    path[0] <- args[(at + 1).usize()]
                at <- at + 2 if arity == 1 else at + 1
            return 1.i32() if dump else 0.i32()

export fn nw_sdl_cli_output_mode(argc: i64, argv: usize&?, screenshot: mutable usize&?) -> i32 = sdl_cli_output_mode

def sdl_startup_route(argc: i64, argv: usize&?, trial: mutable i64&, startup: mutable i64&, skip_title: i64) -> i64:
    can Console.Write, Abort.Panic, Unsafe.PointerCast:
        return -1 if sdl_title_trial(argc, argv, trial) != 0.i32()
        screen: mutable i64 = sdl_screen_id(argc, argv)
        if screen == 0 and skip_title != 0 and sdl_first_option_value(argc, argv, "--screen") == 0.usize():
            screen <- 1
        if screen < 0:
            SDL_Log("Invalid or missing --screen value")
            return -1
        startup[6] <- 1
        return -1 if sdl_maze_arguments(argc, argv, startup, trial[0] if screen == 0 else 0) != 0.i32()
        if screen <= 1 or screen == 6:
            trusted Unsafe.PointerCast:
                if sdl_marble_rung(argc, argv, (&startup[6]).uintptr().cast[mutable i64&]) == 0.i32():
                    SDL_Log("Invalid or missing --marble-start-rung value")
                    return -1
        return screen

def sdl_startup_arguments(argc: i64, argv: usize&?, dimensions: mutable i32&, trial: mutable i64&, startup: mutable i64&) -> i64:
    can Console.Write, Abort.Panic, Unsafe.PointerCast:
        return -1 if sdl_window_arguments(argc, argv, dimensions) != 0.i32()
        return sdl_startup_route(argc, argv, trial, startup, 0)

export fn nw_sdl_startup_arguments(argc: i64, argv: usize&?, dimensions: mutable i32&, trial: mutable i64&, startup: mutable i64&) -> i64 = sdl_startup_arguments

# Pyglet's accelerator is Command on macOS and Control elsewhere.
def sdl_paste_modifier(modifiers: u32) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        mac: bool = syllogism_argument_is(SDL_GetPlatform().uintptr().i64(), "macOS")
        mask: u32 = 0x0c00.u32() if mac else 0x00c0.u32()
        return 1 if (modifiers & mask) != 0.u32() else 0

export fn nw_sdl_paste_modifier(modifiers: u32) -> i64 = sdl_paste_modifier
