extern printf(format: cstr, ...) -> i32 can[Console.Write]
# SDL task CLI values in the order used by the native shell.
module SDLTaskCLI:
    def allowed(field: i64, value: i64) -> bool:
        if field == 0 or field == 11: return value >= 1 and value <= 12
        if field == 9: return value >= 1 and value <= 10
        if field == 1: return value == 1 or value == 2 or value == 3 or value == 5 or value == 8 or value == 10
        if field == 4: return (value >= 2 and value <= 8) or value == 10
        if field == 5: return value == 1 or value == 2 or value == 3 or value == 5 or value == 8 or value == 12 or value == 20
        if field == 10: return value == 1 or value == 3 or value == 5 or value == 8 or value == 10 or value == 15 or value == 20 or value == 30 or value == 50
        if field == 12: return value == 1 or value == 2 or value == 3 or value == 5 or value == 8 or value == 10 or value == 15 or value == 20
        return false

    def parse(argc: i64, argv: usize&?, output: mutable i64&?, ini: usize = 0.usize()) -> i32:
        can Console.Write, Abort.Panic, Unsafe.PointerCast:
            return 2 if argc < 1 or argv == null or output == null
            trusted Unsafe.PointerCast:
                argv_ptr: usize& = argv
                args: heap usize& = argv_ptr.cast[heap usize&]
                output_ptr: mutable i64& = output
                values: mutable heap i64& = output_ptr.cast[mutable heap i64&]
                defaults: i64[15] = [3, 3, 1, 1, 3, 3, 1, 1, 0, 1, 10, 3, 5, 1, 1]
                for field in 0..<15 |field, values, defaults|:
                    values[field.usize()] <- defaults[field.usize()]
                sdl_apply_task_ini_defaults(values, ini, 15)
                at: mutable i64 = 1
                while at < argc |at, argc, args, values|:
                    name: i64 = args[at.usize()].i64()
                    field: mutable i64 = -1
                    if syllogism_argument_is(name, "--sudoku-level"): field <- 0
                    elif syllogism_argument_is(name, "--sudoku-puzzles"): field <- 1
                    elif syllogism_argument_is(name, "--jigsaw-side"): field <- 4
                    elif syllogism_argument_is(name, "--jigsaw-puzzles"): field <- 5
                    elif syllogism_argument_is(name, "--go-level"): field <- 9
                    elif syllogism_argument_is(name, "--go-trials"): field <- 10
                    elif syllogism_argument_is(name, "--crossed-wires-level"): field <- 11
                    elif syllogism_argument_is(name, "--crossed-wires-rounds"): field <- 12
                    elif syllogism_argument_is(name, "--sudoku-no-clashes"): values[2] <- 0
                    elif syllogism_argument_is(name, "--sudoku-no-adaptive"): values[3] <- 0
                    elif syllogism_argument_is(name, "--jigsaw-no-adaptive"): values[6] <- 0
                    elif syllogism_argument_is(name, "--jigsaw-no-preview"): values[7] <- 0
                    elif syllogism_argument_is(name, "--jigsaw-mark-placed"): values[8] <- 1
                    elif syllogism_argument_is(name, "--crossed-wires-no-adaptive"): values[13] <- 0
                    elif syllogism_argument_is(name, "--crossed-wires-no-grid"): values[14] <- 0
                    if field >= 0:
                        at <- at + 1
                        if at >= argc:
                            SDL_Log("Task option requires a value")
                            return 2
                        parsed: i64 = numberology_positive_argument(args[at.usize()].i64())
                        if not allowed(field, parsed):
                            SDL_Log("Invalid task option value")
                            return 2
                        values[field.usize()] <- parsed
                    at <- at + 1
                return 0

def sdl_task_options_parse_legacy(argc: i64, argv: usize&?, output: mutable i64&?) -> i32:
    can Console.Write, Abort.Panic, Unsafe.PointerCast:
        return SDLTaskCLI::parse(argc, argv, output)

export fn nw_sdl_task_options_parse(argc: i64, argv: usize&?, output: mutable i64&?) -> i32 = sdl_task_options_parse_legacy

def sdl_scramble_corpus_args(argc: i64, argv: usize&?, index: mutable usize&?, sentences: mutable usize&?) -> i32:
    can Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 2.i32() if argc < 1 or argv == null or index == null or sentences == null
        trusted Unsafe.PointerCast:
            source: usize& = argv
            args: heap usize& = source.cast[heap usize&]
            index_out: mutable usize& = index
            sentence_out: mutable usize& = sentences
            index_out[0] <- 0.usize()
            sentence_out[0] <- 0.usize()
            at: mutable i64 = 1
            while at < argc |at, argc, args, index_out, sentence_out|:
                index_flag: bool = syllogism_argument_is(args[at.usize()].i64(), "--scramble-index")
                sentence_flag: bool = syllogism_argument_is(args[at.usize()].i64(), "--scramble-sentences")
                if index_flag or sentence_flag:
                    at <- at + 1
                    if at >= argc:
                        SDL_Log("Scramble corpus option requires a path")
                        return 2.i32()
                    if index_flag:
                        index_out[0] <- args[at.usize()]
                    else:
                        sentence_out[0] <- args[at.usize()]
                at <- at + 1
            return 0.i32()

export fn nw_sdl_scramble_corpus_args(argc: i64, argv: usize&?, index: mutable usize&?, sentences: mutable usize&?) -> i32 = sdl_scramble_corpus_args

# Match the Python desktop's initial window dimensions.
def sdl_window_arguments(argc: i64, argv: usize&?, dimensions: mutable i32&?) -> i32:
    can Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 2.i32() if argc < 1 or argv == null or dimensions == null
        trusted Unsafe.PointerCast:
            args: usize& = argv
            result: mutable i32& = dimensions
            result[0] <- 912.i32()
            result[1] <- 684.i32()
            at: mutable i64 = 1
            while at < argc |at, argc, args, result|:
                name: i64 = args[at.usize()].i64()
                width: bool = syllogism_argument_is(name, "--width")
                height: bool = syllogism_argument_is(name, "--height")
                if width or height:
                    at <- at + 1
                    if at >= argc:
                        SDL_Log("Window size requires a value")
                        return 2.i32()
                    value: mutable i64 = 0
                    if sdl_signed_argument(args[at.usize()], &value) == 0.i32() or value <= 0 or value > 2147483647:
                        SDL_Log("Invalid window size")
                        return 2.i32()
                    result[0 if width else 1] <- value.i32()
                elif sdl_cli_option_arity(name) == 1:
                    at <- at + 1
                at <- at + 1
            return 0.i32()

export fn nw_sdl_window_arguments(argc: i64, argv: usize&?, dimensions: mutable i32&?) -> i32 = sdl_window_arguments

# Python clamps the one-based title trial to the four available banners.
def sdl_title_trial(argc: i64, argv: usize&?, trial: mutable i64&?) -> i32:
    can Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 2.i32() if argc < 1 or argv == null or trial == null
        trusted Unsafe.PointerCast:
            args: usize& = argv
            result: mutable i64& = trial
            result[0] <- 1
            at: mutable i64 = 1
            while at < argc |at, argc, args, result|:
                if syllogism_argument_is(args[at.usize()].i64(), "--trial"):
                    at <- at + 1
                    if at >= argc or args[at.usize()] == 0.usize():
                        SDL_Log("Trial requires an integer")
                        return 2.i32()
                    parsed: mutable i64 = 0
                    if sdl_signed_argument(args[at.usize()], &parsed, true) == 0.i32():
                        SDL_Log("Trial requires an integer")
                        return 2.i32()
                    result[0] <- 1 if parsed < 1 else (4 if parsed > 4 else parsed)
                at <- at + 1
            return 0.i32()

export fn nw_sdl_title_trial(argc: i64, argv: usize&?, trial: mutable i64&?) -> i32 = sdl_title_trial

# Title navigation follows the Python shell's immediate, wrapping key actions.
def sdl_title_key(key: i64, trial: mutable i64&?) -> i32:
    return 0.i32() if trial == null
    value: mutable i64& = trial
    if key == 32 or key == 13 or key == 1073741903 or key == 1073741905:
        value[0] <- 1 if value[0] >= 4 else value[0] + 1
        return 1.i32()
    if key == 1073741904 or key == 1073741906:
        value[0] <- 4 if value[0] <= 1 else value[0] - 1
        return 1.i32()
    return 0.i32()

export fn nw_sdl_title_key(key: i64, trial: mutable i64&?) -> i32 = sdl_title_key

def sdl_has_flag(argc: i64, argv: usize&?, flag: cstr) -> bool:
    can Abort.Panic, Unsafe.PointerCast:
        return false if argc < 1 or argv == null
        trusted Unsafe.PointerCast:
            args: usize& = argv
            at: mutable i64 = 1
            while at < argc |at, argc, args, flag|:
                value: i64 = args[at.usize()].i64()
                break if syllogism_argument_is(value, "--")
                return true if syllogism_argument_is(value, flag)
                at <- at + (2 if sdl_cli_option_arity(value) == 1 else 1)
            return false

def sdl_black_background(argc: i64, argv: usize&?) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return 1 if sdl_has_flag(argc, argv, "--black-background") else 0

export fn nw_sdl_black_background(argc: i64, argv: usize&?) -> i64 = sdl_black_background

# Parse a signed 64-bit CLI integer without conflating zero with an error.
def sdl_cli_whitespace(byte: u8) -> bool:
    return byte == 32.u8() or (byte >= 9.u8() and byte <= 13.u8())

def sdl_signed_argument(address: usize, output: mutable i64&?, clamp_trial: bool = false) -> i32:
    can Abort.Panic, Unsafe.PointerCast:
        return 0.i32() if address == 0.usize() or output == null
        trusted Unsafe.PointerCast:
            text: u8& = address.cast[u8&]
            result: mutable i64& = output
            pos: mutable usize = 0.usize()
            while sdl_cli_whitespace(text[pos]) |text, pos|:
                pos <- pos + 1.usize()
            negative: bool = text[pos] == 45.u8()
            pos <- pos + 1.usize() if negative or text[pos] == 43.u8()
            value: mutable i64 = 0
            needs_digit: mutable bool = true
            while text[pos] != 0.u8() and not sdl_cli_whitespace(text[pos]) |pos, text, value, negative, needs_digit, clamp_trial|:
                digit: i64 = text[pos].i64() - 48
                if text[pos] == 95.u8() and not needs_digit:
                    needs_digit <- true
                else:
                    return 0.i32() if digit < 0 or digit > 9
                    if clamp_trial:
                        value <- -4 if value <= -4 else value * 10 - digit
                    else:
                        return 0.i32() if value < -922337203685477580 or (value == -922337203685477580 and digit > (8 if negative else 7))
                        value <- value * 10 - digit
                    needs_digit <- false
                pos <- pos + 1.usize()
            return 0.i32() if needs_digit
            while sdl_cli_whitespace(text[pos]) |text, pos|:
                pos <- pos + 1.usize()
            return 0.i32() if text[pos] != 0.u8()
            result[0] <- value if negative else 0 - value
            return 1.i32()

# Shared Python 3D Maze and Sokoban startup settings.
def sdl_marble_rung(argc: i64, argv: usize&?, output: mutable i64&?) -> i32:
    can Abort.Panic, Unsafe.PointerCast:
        return 0.i32() if argv == null or output == null
        trusted Unsafe.PointerCast:
            args: usize& = argv
            result: mutable i64& = output
            result[0] <- 1
            at: mutable i64 = 1
            while at < argc |at, argc, args, result|:
                if syllogism_argument_is(args[at.usize()].i64(), "--marble-start-rung"):
                    at <- at + 1
                    return 0.i32() if at >= argc
                    return 0.i32() if sdl_signed_argument(args[at.usize()], result) == 0.i32()
                at <- at + 1
            return 1.i32()

export fn nw_sdl_marble_rung(argc: i64, argv: usize&?, output: mutable i64&?) -> i32 = sdl_marble_rung

def sdl_dump_count(argc: i64, argv: usize&?, output: mutable i64&?) -> i32:
    can Abort.Panic, Unsafe.PointerCast:
        return 0.i32() if argv == null or output == null
        trusted Unsafe.PointerCast:
            args: usize& = argv
            result: mutable i64& = output
            result[0] <- 1
            at: mutable i64 = 1
            while at < argc |at, argc, args, result|:
                name: i64 = args[at.usize()].i64()
                if syllogism_argument_is(name, "--trials"):
                    return 0.i32() if at + 1 >= argc
                    return 0.i32() if sdl_signed_argument(args[(at + 1).usize()], result) == 0.i32()
                at <- at + 2 if sdl_cli_option_arity(name) == 1 else at + 1
            return 1.i32()

export fn nw_sdl_dump_count(argc: i64, argv: usize&?, output: mutable i64&?) -> i32 = sdl_dump_count

def sdl_maze_arguments(argc: i64, argv: usize&?, output: mutable i64&?, title_trial: i64 = 0) -> i32:
    can Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 2.i32() if argc < 1 or argv == null or output == null
        trusted Unsafe.PointerCast:
            args: usize& = argv
            values: mutable i64& = output
            values[0] <- title_trial if title_trial > 0 else 1
            values[1] <- 1
            values[2] <- 0
            values[3] <- 0
            values[4] <- 0
            values[5] <- 17
            at: mutable i64 = 1
            while at < argc |at, argc, args, values, title_trial|:
                name: i64 = args[at.usize()].i64()
                field: mutable i64 = -1
                if syllogism_argument_is(name, "--trial"): field <- 0
                elif syllogism_argument_is(name, "--trials"): field <- 1
                elif syllogism_argument_is(name, "--seed"): field <- 5
                elif syllogism_argument_is(name, "--adaptive"): values[2] <- 1
                elif syllogism_argument_is(name, "--show-marks"): values[3] <- 1
                elif syllogism_argument_is(name, "--show-traps"): values[4] <- 1
                if field >= 0:
                    at <- at + 1
                    if at >= argc:
                        SDL_Log("Task option requires a value")
                        return 2.i32()
                    if field == 0 and title_trial > 0:
                        at <- at + 1
                        continue
                    parsed: mutable i64 = 0
                    if sdl_signed_argument(args[at.usize()], &parsed) == 0.i32():
                        SDL_Log("Invalid task option value")
                        return 2.i32()
                    values[field.usize()] <- parsed
                at <- at + 1
            return 0.i32()

def sdl_maze_arguments_legacy(argc: i64, argv: usize&?, output: mutable i64&?) -> i32:
    can Console.Write, Abort.Panic, Unsafe.PointerCast:
        return sdl_maze_arguments(argc, argv, output)

export fn nw_sdl_maze_arguments(argc: i64, argv: usize&?, output: mutable i64&?) -> i32 = sdl_maze_arguments_legacy

