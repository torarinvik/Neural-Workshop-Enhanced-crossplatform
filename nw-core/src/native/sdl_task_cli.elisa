        return 131 if syllogism_argument_is(name, "second-thoughts")
        return 130 if syllogism_argument_is(name, "between-the-lines")
        return 110 if syllogism_argument_is(name, "crazy-cog")
        return 111 if syllogism_argument_is(name, "cipher-abyss")
        return 112 if syllogism_argument_is(name, "potters-wheel")
        return 113 if syllogism_argument_is(name, "conductor")
        return 114 if syllogism_argument_is(name, "tightrope")
        return 115 if syllogism_argument_is(name, "sign-painter")
        return 116 if syllogism_argument_is(name, "bartender")
        return 117 if syllogism_argument_is(name, "lock-pick")
        return 118 if syllogism_argument_is(name, "air-hockey")
        return 119 if syllogism_argument_is(name, "semaphore")
        return 120 if syllogism_argument_is(name, "shadow-puppets")
        return 121 if syllogism_argument_is(name, "night-watch")
        return 122 if syllogism_argument_is(name, "kerbside")
        return 123 if syllogism_argument_is(name, "steadicam")
        return 124 if syllogism_argument_is(name, "free-kick")
        return 125 if syllogism_argument_is(name, "glove")
        return 126 if syllogism_argument_is(name, "by-ear")
        return 127 if syllogism_argument_is(name, "piano-tuner")
        return 128 if syllogism_argument_is(name, "cricket-hunt")
        return 129 if syllogism_argument_is(name, "claw-machine")
        return 82 if syllogism_argument_is(name, "captcha")
        return 79 if syllogism_argument_is(name, "dr_shape") or syllogism_argument_is(name, "dr-shape")
        for screen in 0..<75 |screen, name|:
            return screen if syllogism_argument_is(name, sdl_screen_name(screen))
        return -1

def sdl_screen_id(argc: i64, argv: usize&?) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return 0 if argc < 2 or argv == null
        trusted Unsafe.PointerCast:
            args: usize& = argv
            screen: mutable i64 = 0
            at: mutable i64 = 1
            while at < argc |at, argc, args, screen|:
                if syllogism_argument_is(args[at.usize()].i64(), "--screen"):
                    at <- at + 1
                    return -1 if at >= argc
                    screen <- sdl_screen_name_id(args[at.usize()].i64())
                    return -1 if screen < 0
                at <- at + 1
            return screen

export fn nw_sdl_screen_id(argc: i64, argv: usize&?) -> i64 = sdl_screen_id

