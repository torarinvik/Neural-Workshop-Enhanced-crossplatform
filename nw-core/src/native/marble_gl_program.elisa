extern glCreateShader(kind: u32) -> u32 can[Memory.Allocate]
extern glShaderSource(shader: u32, count: i32, sources: usize&, lengths: i32&)
extern glCompileShader(shader: u32)
extern glGetShaderiv(shader: u32, name: u32, value: mutable i32&)
extern glGetShaderInfoLog(shader: u32, capacity: i32, written: usize, message: mutable u8&)
extern glDeleteShader(shader: u32) can[Memory.Release]
extern glCreateProgram() -> u32 can[Memory.Allocate]
extern glAttachShader(program: u32, shader: u32)
extern glLinkProgram(program: u32)
extern glGetProgramiv(program: u32, name: u32, value: mutable i32&)
extern glGetProgramInfoLog(program: u32, capacity: i32, written: usize, message: mutable u8&)
extern glDeleteProgram(program: u32) can[Memory.Release]

module MarbleGLProgram:
    def compile(asset: i64, kind: u32) -> u32:
        can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            length: mutable usize = 0.usize()
            source: mutable heap void&? = MarbleShaderAssets::read_shader_asset(asset, &length)
            if source == null:
                SDL_Log("Could not load Marble shader %lld: %s", asset, SDL_GetError())
                return 0.u32()
            trusted Unsafe.PointerCast:
                bytes: mutable heap void& = source
                shader: u32 = glCreateShader(kind)
                if shader != 0.u32() and length <= 2147483647.usize():
                    address: usize = bytes.uintptr()
                    size: i32 = length.i32()
                    glShaderSource(shader, 1.i32(), &address, &size)
                    glCompileShader(shader)
                SDL_free(bytes.cast[heap void&])
                return 0.u32() if shader == 0.u32()
                status: mutable i32 = 0.i32()
                glGetShaderiv(shader, 35713.u32(), &status) # GL_COMPILE_STATUS
                if status == 0.i32():
                    message: mutable u8[2048] = zeroed
                    glGetShaderInfoLog(shader, 2048.i32(), 0.usize(), &message[0])
                    SDL_Log("Could not compile Marble shader %lld: %s", asset, (&message[0]).uintptr().cast[cstr])
                    glDeleteShader(shader)
                    return 0.u32()
                return shader

    def create(pair: i64) -> u32:
        can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            return 0.u32() if pair < 0 or pair > 2
            vertex: u32 = compile(pair * 2, 35633.u32()) # GL_VERTEX_SHADER
            return 0.u32() if vertex == 0.u32()
            fragment: u32 = compile(pair * 2 + 1, 35632.u32()) # GL_FRAGMENT_SHADER
            if fragment == 0.u32():
                glDeleteShader(vertex)
                return 0.u32()
            return link(vertex, fragment, "Marble")

    # Takes ownership of the compiled shaders.
    def link(vertex: u32, fragment: u32, label: cstr) -> u32:
        can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            program: u32 = glCreateProgram()
            if program != 0.u32():
                glAttachShader(program, vertex)
                glAttachShader(program, fragment)
                glLinkProgram(program)
            glDeleteShader(fragment)
            glDeleteShader(vertex)
            return 0.u32() if program == 0.u32()
            status: mutable i32 = 0.i32()
            glGetProgramiv(program, 35714.u32(), &status) # GL_LINK_STATUS
            if status == 0.i32():
                message: mutable u8[2048] = zeroed
                glGetProgramInfoLog(program, 2048.i32(), 0.usize(), &message[0])
                trusted Unsafe.PointerCast:
                    SDL_Log("Could not link OpenGL program %s: %s", label, (&message[0]).uintptr().cast[cstr])
                glDeleteProgram(program)
                return 0.u32()
            return program

    def destroy(program: u32):
        can Memory.Release:
            if program != 0.u32():
                glDeleteProgram(program)
