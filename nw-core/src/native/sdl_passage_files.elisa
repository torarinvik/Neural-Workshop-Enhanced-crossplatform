module SDLPassageFiles:
    # SDL_PathInfo's type, size, create, modify, and access fields occupy
    # five eight-byte slots on supported SDL3 desktop ABIs.
    def modified(suffix: cstr) -> i64:
        can Blocking.IO, Abort.Panic, Unsafe.PointerCast:
            path: mutable u8[4096] = zeroed
            return -1 if sdl_data_path(&path[0], 4096.usize(), suffix, 0, true) == 0
            info: mutable i64[5] = zeroed
            trusted Unsafe.PointerCast:
                if SDL_GetPathInfo((&path[0]).cast[cstr], (&info[0]).cast[mutable void&?]):
                    return info[3]
            return -1

    def read_cache(suffix: cstr, count: mutable i64&) -> mutable heap void&?:
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            path: mutable u8[4096] = zeroed
            return null if sdl_data_path(&path[0], 4096.usize(), suffix, 0, true) == 0
            return sdl_read_corpus(&path[0], count)

    def as_view(data: mutable heap void&?, count: i64) -> sview:
        can Unsafe.PointerCast:
            if data is raw:
                trusted Unsafe.PointerCast:
                    return unsafe_sview_bounded_bytes(raw.cast[heap u8&], count.usize())
            return ""
