# Map SDL logical-window coordinates into the letterboxed reference scene.
def sdl_option_row(x: f32, y: f32, width: i32, height: i32, rows: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if width <= 0.i32() or height <= 0.i32() or rows <= 0
        view: mutable f32[4] = zeroed
        SDLGeometry::setup(&view[0], width, height)
        scale: f32 = view[0]
        return -1 if scale <= 0.0.f32()
        rx: f32 = (x - view[1]) / scale
        ry: f32 = (height.f32() - y - view[2]) / scale
        return -1 if rx < 102.0.f32() or rx > 810.0.f32()
        row: mutable i64 = 0
        while row < rows |row, rows, ry|:
            center: f32 = 474.0.f32() - row.f32() * 48.0.f32()
            return row if ry >= center - 18.0.f32() and ry <= center + 18.0.f32()
            row <- row + 1
        return -1

def numberology_page(x: f32, y: f32) -> i32:
    return 0 if y < 342.0.f32() or y > 388.0.f32()
    return 4 if x >= 170.0.f32() and x <= 360.0.f32()
    return 5 if x >= 552.0.f32() and x <= 742.0.f32()
    return 0

export fn nw_sdl_option_row(x: f32, y: f32, width: i32, height: i32, rows: i64) -> i64 = sdl_option_row
export fn nw_numberology_page_at(x: f32, y: f32) -> i32 = numberology_page
