def sdl_option_center(row: i64, count: i64) -> f64:
    return 474.0 - row.f64() * (36.0 if count == 7 else 48.0)

def sdl_option_half_height(count: i64) -> f64:
    return 15.0 if count == 7 else 18.0

# Map SDL logical-window coordinates into the letterboxed reference scene.
def sdl_option_row(x: f32, y: f32, width: i32, height: i32, rows: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if width <= 0.i32() or height <= 0.i32() or rows <= 0
        view: mutable f32[4] = zeroed
        SDLGeometry::setup(&view[0], width, height)
        scale: f32 = view[0]
        return -1 if scale <= 0.0.f32()
        rx: f32 = (x - view[1]) / scale
        ry: f32 = (height.f32() - y - view[2]) / scale
        return -1 if rx < 102.0.f32() or rx > 810.0.f32()
        row: mutable i64 = 0
        while row < rows |row, rows, ry|:
            center: f32 = sdl_option_center(row, rows).f32()
            half: f32 = sdl_option_half_height(rows).f32()
            return row if ry >= center - half and ry <= center + half
            row <- row + 1
        return -1

def numberology_page(x: f32, y: f32) -> i32:
    return 0 if y < 342.0.f32() or y > 388.0.f32()
    return 4 if x >= 170.0.f32() and x <= 360.0.f32()
    return 5 if x >= 552.0.f32() and x <= 742.0.f32()
    return 0

# Controller pointer coordinates use a bottom-left origin and millionths of
# the actual window dimensions. Preserve the shell's f32 arithmetic.
def normalize_pointer(x: f32, y: f32, width: i32, height: i32, out_x: mutable i64&?, out_y: mutable i64&?) -> i64:
    can Abort.Panic:
        return 0 if width <= 0.i32() or height <= 0.i32() or out_x == null or out_y == null
        px: mutable i64& = out_x
        py: mutable i64& = out_y
        px[0] <- (x * 1000000.0.f32() / width.f32()).i64()
        py[0] <- ((height.f32() - y) * 1000000.0.f32() / height.f32()).i64()
        return 1

# A click selects a new row; clicking the selected row changes its value.
# Task 4 is Numberology; the other task IDs match task_options_modify.
def sdl_option_click(task: i64, x: f32, y: f32, width: i32, height: i32, selected: mutable i32&?, values: mutable i64&?) -> i32:
    can Abort.Panic, Unsafe.PointerCast:
        return 0.i32() if task < 0 or task > 4 or selected == null or values == null
        row: i64 = sdl_option_row(x, y, width, height, 3 if task == 4 else 4)
        return 0.i32() if row < 0
        selection: mutable i32& = selected
        if row == selection[0].i64():
            if task == 4:
                numberology_modify_option(values, row, 1)
            else:
                _ = task_options_modify(task, values, row, 1)
        else:
            selection[0] <- row.i32()
        return 1.i32()

export fn nw_sdl_option_row(x: f32, y: f32, width: i32, height: i32, rows: i64) -> i64 = sdl_option_row
export fn nw_numberology_page_at(x: f32, y: f32) -> i32 = numberology_page
export fn nw_sdl_normalize_pointer(x: f32, y: f32, width: i32, height: i32, out_x: mutable i64&?, out_y: mutable i64&?) -> i64 = normalize_pointer
export fn nw_sdl_option_click(task: i64, x: f32, y: f32, width: i32, height: i32, selected: mutable i32&?, values: mutable i64&?) -> i32 = sdl_option_click
