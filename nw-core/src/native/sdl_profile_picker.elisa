global mutable sdl_profile_picker_open: bool = false
global mutable sdl_profile_picker_changed: bool = false
global mutable sdl_profile_picker_users: usize = 0.usize()
global mutable sdl_profile_picker_count: i64 = 0
global mutable sdl_profile_picker_row: i64 = 0
global mutable sdl_profile_picker_save_failed: bool = false
global mutable sdl_profile_picker_editing: bool = false
global mutable sdl_profile_picker_invalid_name: bool = false
global mutable sdl_profile_picker_text: u8[256] = zeroed
global mutable sdl_profile_picker_length: i64 = 0
global mutable sdl_profile_picker_cursor: i64 = 0

def sdl_profile_picker_close():
    can Memory.Release, Global.Read, Global.Write, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            if sdl_profile_picker_users != 0.usize():
                SDL_free(sdl_profile_picker_users.cast[mutable heap void&])
        sdl_profile_picker_users <- 0.usize()
        sdl_profile_picker_open <- false
        sdl_profile_picker_editing <- false

def sdl_profile_file_name_length(name: u8&, length: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            if length > 11 and SDL_strcmp((&name[(length - 11).usize()]).cast[cstr], "-config.ini") == 0.i32():
                return length - 11
            if length > 10 and SDL_strcmp((&name[(length - 10).usize()]).cast[cstr], "-stats.txt") == 0.i32():
                return length - 10
        return 0

def sdl_profile_picker_begin():
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Global.Read, Global.Write, Unsafe.PointerCast:
        path: mutable u8[4096] = zeroed
        count: mutable i32 = 0.i32()
        sdl_profile_picker_count <- 0
        sdl_profile_picker_row <- 0
        sdl_profile_picker_save_failed <- false
        sdl_profile_picker_open <- true
        trusted Unsafe.PointerCast:
            target: mutable u8& = (&path[0]).cast[mutable u8&]
            return if sdl_data_path(target, 4096.usize(), "/", 0, true) == 0.i32()
            if SDL_GlobDirectory(target.cast[cstr], "*", 0.u32(), (&count).uintptr()) is raw:
                sdl_profile_picker_users <- raw.uintptr()
                users: mutable heap usize& = raw.cast[mutable heap usize&]
                names: mutable i64 = 0
                for at in 0..<count.i64() |at, users, names|:
                    name: mutable heap u8& = users[at.usize()].cast[mutable heap u8&]
                    symbol: cstr = name.cast[cstr]
                    length: i64 = sdl_profile_file_name_length(name, SDL_strlen(symbol).i64())
                    continue if not sdl_profile_name_valid(name, length)
                    continue if length == 7 and SDL_strncasecmp(symbol, "default", 7.usize()) == 0.i32()
                    name[length.usize()] <- 0.u8()
                    users[names.usize()] <- name.uintptr()
                    names <- names + 1
                SDL_qsort(raw, names.usize(), size_of(usize).usize(), sdl_compare_media_name)
                suffix: mutable u8[270] = zeroed
                selected: i64 = sdl_profile_suffix(target, &suffix[0]) - 12
                for at in 0..<names |at, users, suffix, selected|:
                    current: usize = users[at.usize()]
                    unique: i64 = sdl_profile_picker_count
                    name: cstr = current.cast[cstr]
                    continue if unique > 0 and SDL_strcmp(name, users[(unique - 1).usize()].cast[cstr]) == 0.i32()
                    users[unique.usize()] <- current
                    sdl_profile_picker_count <- unique + 1
                    if selected == SDL_strlen(name).i64() and SDL_strncmp(name, (&suffix[1]).cast[cstr], selected.usize()) == 0.i32():
                        sdl_profile_picker_row <- unique + 1

def sdl_profile_picker_name(row: i64) -> cstr:
    can Abort.Panic, Global.Read, Unsafe.PointerCast:
        return "default" if row == 0
        return "New user" if row == sdl_profile_picker_count + 1
        trusted Unsafe.PointerCast:
            users: heap usize& = sdl_profile_picker_users.cast[heap usize&]
            return users[(row - 1).usize()].cast[cstr]

def sdl_profile_picker_save(name: cstr) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: mutable u8[4096] = zeroed
        temporary: mutable u8[4200] = zeroed
        record: mutable u8[280] = zeroed
        prefix: u8[22] = [128, 4, 149, 0, 0, 0, 0, 0, 0, 0, 0, 125, 148, 140, 4, 85, 83, 69, 82, 148, 140, 0]
        length: i64 = SDL_strlen(name).i64()
        trusted Unsafe.PointerCast:
            target: mutable u8& = (&path[0]).cast[mutable u8&]
            return false if sdl_data_path(target, 4096.usize(), "/defaults.ini", 0, true) == 0.i32()
            return false if SyllogismOptionsHost::temporary((&temporary[0]).uintptr().i64(), 4200, target.uintptr().i64()) < 0
            for at in 0..<22 |at, prefix, record|:
                record[at.usize()] <- prefix[at.usize()]
            record[3] <- ((length + 14) % 256).u8()
            record[4] <- ((length + 14) / 256).u8()
            record[21] <- length.u8()
            bytes: u8& = name.cast[u8&]
            for at in 0..<length |at, record, bytes|:
                record[(22 + at).usize()] <- bytes[at.usize()]
            record[(22 + length).usize()] <- 148.u8()
            record[(23 + length).usize()] <- 115.u8()
            record[(24 + length).usize()] <- 46.u8()
            return numberology_results_write(&temporary[0], target, &record[0], (25 + length).usize()) != 0.i32()

def sdl_profile_picker_activate(window: mutable void&?, name: cstr) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Global.Read, Global.Write, Unsafe.PointerCast:
        if not sdl_profile_picker_save(name):
            sdl_profile_picker_save_failed <- true
            return false
        if SDL_GetEnvironment() is environment:
            _ = SDL_SetEnvironmentVariable(environment, "NW_SELECTED_USER", name, true)
        sdl_profile_picker_changed <- true
        sdl_concentration_choices[0] <- 0
        sdl_recognition_choices[0] <- 0
        if sdl_profile_picker_editing:
            sdl_apply_text_input(window, 2.i32())
        sdl_profile_picker_close()
        if window != null:
            target: mutable void& = window
            sdl_set_profile_caption(target)
            flags: u64 = SDL_GetWindowFlags(target)
            if (flags & 8.u64()) == 0.u64():
                fullscreen: mutable i64 = 0
                dimensions: mutable i32[2] = zeroed
                _ = sdl_startup_profile(0, null, &dimensions[0], &fullscreen)
                wanted: bool = fullscreen != 0
                if wanted != ((flags & 1.u64()) != 0.u64()):
                    sdl_set_fullscreen(target, wanted)
        return true

def sdl_profile_picker_create(window: mutable void&?):
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Global.Read, Global.Write, Unsafe.PointerCast:
        length: i64 = sdl_profile_picker_length
        trusted Unsafe.PointerCast:
            name: u8& = &sdl_profile_picker_text[0]
            sdl_profile_picker_invalid_name <- not sdl_profile_name_valid(name, length)
            return if sdl_profile_picker_invalid_name
            # An empty stats file makes the profile visible to Python's picker.
            if length != 7 or SDL_strncasecmp(name.cast[cstr], "default", 7.usize()) != 0.i32():
                leaf: mutable u8[270] = zeroed
                path: mutable u8[4096] = zeroed
                expanded: mutable u8[4096] = zeroed
                filename: mutable u8& = &leaf[0]
                _ = sdl_named_profile_suffix(name, length, filename)
                _ = SyllogismOptionsHost::append(filename.uintptr().i64(), 270, length + 1, "-stats.txt")
                sdl_profile_picker_save_failed <- true
                return if sdl_data_path(&path[0], 4096.usize(), filename.cast[cstr], 0, true) == 0.i32()
                destination: i64 = (&expanded[0]).uintptr().i64()
                return if SyllogismOptionsHost::settings_override(destination, 4096, (&path[0]).cast[cstr], true) < 0
                file: mutable void&? = SDL_IOFromFile(destination.uintptr().cast[cstr], "ab")
                return if file == null
                stream: mutable void& = file
                return if not SDL_CloseIO(stream)
            _ = sdl_profile_picker_activate(window, name.cast[cstr])

def sdl_profile_picker_text_input(text: u8&?):
    can Abort.Panic, Global.Read, Global.Write, Unsafe.PointerCast:
        return if not sdl_profile_picker_editing or text == null
        trusted Unsafe.PointerCast:
            value: u8& = text
            size: i64 = SDL_strlen(value.cast[cstr]).i64()
            length: i64 = sdl_profile_picker_length
            cursor: i64 = sdl_profile_picker_cursor
            return if size <= 0 or size > 255 - length
            for offset in 0..<(length - cursor + 1) |offset, length, size|:
                index: i64 = length - offset
                sdl_profile_picker_text[(index + size).usize()] <- sdl_profile_picker_text[index.usize()]
            for offset in 0..<size |offset, cursor, value|:
                sdl_profile_picker_text[(cursor + offset).usize()] <- value[offset.usize()]
            sdl_profile_picker_length <- length + size
            sdl_profile_picker_cursor <- cursor + size
            sdl_profile_picker_invalid_name <- false
            sdl_profile_picker_save_failed <- false

def sdl_profile_picker_previous(cursor: i64) -> i64:
    can Abort.Panic, Global.Read:
        previous: mutable i64 = cursor - 1
        while previous > 0 and (sdl_profile_picker_text[previous.usize()] & 192.u8()) == 128.u8() |previous|:
            previous <- previous - 1
        return previous

def sdl_profile_picker_edit_key(window: mutable void&?, key: i64):
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Global.Read, Global.Write, Unsafe.PointerCast:
        cursor: i64 = sdl_profile_picker_cursor
        length: i64 = sdl_profile_picker_length
        if key == 27:
            sdl_apply_text_input(window, 2.i32())
            sdl_profile_picker_editing <- false
            sdl_profile_picker_save_failed <- false
        elif key == 13 or key == 1073741912:
            sdl_profile_picker_create(window)
        elif key == 1073741904 and cursor > 0:
            sdl_profile_picker_cursor <- sdl_profile_picker_previous(cursor)
        elif key == 1073741903 and cursor < length:
            next: mutable i64 = cursor + 1
            while next < length and (sdl_profile_picker_text[next.usize()] & 192.u8()) == 128.u8() |next, length|:
                next <- next + 1
            sdl_profile_picker_cursor <- next
        elif key == 8 and cursor > 0:
            previous: i64 = sdl_profile_picker_previous(cursor)
            for offset in 0..<(length - cursor + 1) |offset, previous, cursor|:
                sdl_profile_picker_text[(previous + offset).usize()] <- sdl_profile_picker_text[(cursor + offset).usize()]
            sdl_profile_picker_length <- length - (cursor - previous)
            sdl_profile_picker_cursor <- previous
            sdl_profile_picker_invalid_name <- false
            sdl_profile_picker_save_failed <- false

def sdl_profile_picker_key(window: mutable void&?, key: i64, available: bool) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Global.Read, Global.Write, Unsafe.PointerCast:
        if not sdl_profile_picker_open:
            return false if key != 117 or not available
            sdl_profile_picker_begin()
            return true
        if sdl_profile_picker_editing:
            sdl_profile_picker_edit_key(window, key)
        elif key == 27:
            sdl_profile_picker_close()
        elif key == 1073741906:
            sdl_profile_picker_row <- sdl_profile_picker_count + 1 if sdl_profile_picker_row == 0 else sdl_profile_picker_row - 1
        elif key == 1073741905:
            sdl_profile_picker_row <- 0 if sdl_profile_picker_row == sdl_profile_picker_count + 1 else sdl_profile_picker_row + 1
        elif key == 13 or key == 32 or key == 1073741912:
            if sdl_profile_picker_row == sdl_profile_picker_count + 1:
                sdl_profile_picker_editing <- true
                sdl_profile_picker_invalid_name <- false
                sdl_profile_picker_save_failed <- false
                sdl_profile_picker_length <- 0
                sdl_profile_picker_cursor <- 0
                sdl_profile_picker_text[0] <- 0.u8()
                sdl_apply_text_input(window, 1.i32())
            else:
                _ = sdl_profile_picker_activate(window, sdl_profile_picker_name(sdl_profile_picker_row))
        return true

def sdl_profile_picker_frame(dest: i64, capacity: i64, black: bool) -> i64:
    can Memory.Allocate, Abort.Panic, Global.Read, Unsafe.PointerCast:
        list: mutable Display::DisplayList = Display::DisplayList()
        ink: u32 = Display::rgba(255, 255, 255, 255) if black else Display::rgba(20, 24, 32, 255)
        background: u32 = Display::rgba(0, 0, 0, 255) if black else Display::rgba(255, 255, 255, 255)
        Display::draw_rect(&list, 0.0, 0.0, 912.0, 684.0, background)
        if sdl_profile_picker_editing:
            Display::draw_text_weight(&list, "Enter new user name", 456.0, 610.0, 30.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            text: mutable dstr = []
            cursor: i64 = sdl_profile_picker_cursor
            length: i64 = sdl_profile_picker_length
            trusted Unsafe.PointerCast:
                name: cstr = (&sdl_profile_picker_text[0]).cast[cstr]
                entered: sview = sview(name, 0, -1)
                dstr_append_sview(&text, string_view_slice(entered, 0, cursor))
                dstr_append_cstr(&text, "_")
                dstr_append_sview(&text, string_view_slice(entered, cursor, length))
            Display::draw_text_weight(&list, bytes_view(text), 456.0, 480.0, 24.0, ink, Display::ANCHOR_CENTER_CENTER, false)
            footer: sview = "Enter a valid profile name" if sdl_profile_picker_invalid_name else ("Could not save profile selection" if sdl_profile_picker_save_failed else "Enter: create    Esc: cancel")
            Display::draw_text_weight(&list, footer, 456.0, 44.0, 16.0, ink, Display::ANCHOR_CENTER_CENTER, false)
        else:
            Display::draw_text_weight(&list, "Select user profile", 456.0, 610.0, 30.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            start: i64 = (sdl_profile_picker_row / 10) * 10
            end: i64 = sdl_profile_picker_count + 2 if sdl_profile_picker_count + 2 < start + 10 else start + 10
            for row in start..<end |row, list, start, ink|:
                selected: bool = row == sdl_profile_picker_row
                label: cstr = sdl_profile_picker_name(row)
                y: f64 = 540.0 - (row - start).f64() * 45.0
                if selected:
                    Display::draw_rect(&list, 156.0, y - 20.0, 600.0, 40.0, Display::rgba(70, 120, 180, 96))
                Display::draw_text_weight(&list, sview(label, 0, -1), 456.0, y, 21.0, ink, Display::ANCHOR_CENTER_CENTER, selected)
            footer: sview = "Could not save profile selection" if sdl_profile_picker_save_failed else "Up/Down: choose    Enter: select    Esc: cancel"
            Display::draw_text_weight(&list, footer, 456.0, 44.0, 16.0, ink, Display::ANCHOR_CENTER_CENTER, false)
        encoded: darray[u8] = Display::encode_binary(&list)
        length: i64 = encoded.count.i64()
        return 0 if length <= 0 or length > capacity
        trusted Unsafe.PointerCast:
            memcpy(dest.uintptr().cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
        return length
