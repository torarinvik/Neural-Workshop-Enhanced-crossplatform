include "../scene_video_sequence.elisa"

def sdl_video_sequence_selftest() -> i32:
    can Memory.Allocate, Console.Write, Abort.Panic:
        run: mutable VideoSequence::Run = VideoSequence::initialize(4, 2, true, false, 17)
        good: mutable bool = VideoSequence::start(&run)
        good <- false if VideoSequence::load_clip(&run, 3, 900)
        good <- false if run.puzzle != 0 or not VideoSequence::load_clip(&run, 23, 1000)
        # Python shuffle with random.Random(17), supplied the same clip
        # without advancing the RNG for library selection.
        good <- false if run.order[0] != 0 or run.order[1] != 2 or run.order[2] != 1 or run.order[3] != 3
        good <- false if run.par != 1 or run.frames_per_piece != 5
        good <- false if VideoSequence::source_frame(&run, 3, 1400) != 16
        good <- false if VideoSequence::source_frame(&run, 4, 1400) != -1
        good <- false if VideoSequence::columns(3, 1200.0, 200.0) != 3 or VideoSequence::columns(4, 400.0, 400.0) != 2
        box: Jigsaw::Rect = VideoSequence::tile_rect(912.0, 684.0, 4, 1)
        good <- false if VideoSequence::tile_at(912.0, 684.0, 4, box.left + box.width / 2.0, box.bottom + box.height / 2.0) != 1
        good <- false if VideoSequence::tile_at(912.0, 684.0, 4, 0.0, 0.0) != -1
        frame: mutable Display::DisplayList = Display::DisplayList()
        SceneVideoSequence::render(&frame, &run, false, 912.0, 684.0)
        good <- false if frame.commands.count != 7
        good <- false if not VideoSequence::pick(&run, 1, 2100)
        good <- false if not VideoSequence::pick(&run, 1, 2100) or run.picked != -1 or run.swaps != 0
        good <- false if not VideoSequence::pick(&run, 1, 2200) or not VideoSequence::pick(&run, 2, 2200)
        good <- false if run.phase != Jigsaw::PHASE_SOLVED or run.pieces != 5 or run.results[0].elapsed != 1.2
        good <- false if VideoSequence::advance(&run, 3799) or not VideoSequence::advance(&run, 3800)
        good <- false if not VideoSequence::load_clip(&run, 27, 5000)
        good <- false if run.order[0] != 0 or run.order[1] != 3 or run.order[2] != 4 or run.order[3] != 1 or run.order[4] != 2
        # Two wasted round trips, then the two minimum swaps.
        for swap in 0..<4 |swap, run|:
            _ = VideoSequence::pick(&run, 0, 5200)
            _ = VideoSequence::pick(&run, 1, 5200)
        _ = VideoSequence::pick(&run, 1, 6000)
        _ = VideoSequence::pick(&run, 3, 6000)
        _ = VideoSequence::pick(&run, 2, 6000)
        _ = VideoSequence::pick(&run, 4, 6000)
        good <- false if run.phase != Jigsaw::PHASE_SOLVED or run.pieces != 4 or run.swaps != 6
        good <- false if not VideoSequence::advance(&run, 7600) or run.phase != Jigsaw::PHASE_DONE
        score: Jigsaw::JigsawScore = VideoSequence::score(&run)
        good <- false if score.puzzles != 2 or score.efficiency != 67 or score.mean_seconds != 1.1 or score.most_pieces != 5
        good <- false if not VideoSequence::start(&run) or not VideoSequence::unavailable(&run) or run.phase != Jigsaw::PHASE_READY
        if good:
            _ = printf("Video Sequence controller and scene selftest: PASS\n")
            return 0.i32()
        _ = printf("Video Sequence controller and scene selftest: FAILED\n")
        return 1.i32()

# Run against an isolated Python-format profile and UCF-101 folder.
def sdl_video_sequence_media_selftest(expect_library: bool) -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        handle: i64 = SDLVideoSequence::open(17)
        return 1.i32() if handle <= 0
        good: mutable bool = false
        trusted Unsafe.PointerCast:
            session: mutable heap SDLVideoSequence::Session& = handle.uintptr().cast[mutable heap SDLVideoSequence::Session&]
            _ = SDLVideoSequence::start(session)
            loaded: bool = SDLVideoSequence::deal(session)
            if expect_library:
                good <- loaded and session.count == 2 and session.notice == 0 and session.run.active_pieces == 3 and session.run.frames_per_piece == 1
                good <- good and session.run.puzzles == 1 and not session.run.adaptive and session.run.mark_placed and session.pixels != 0.usize()
                good <- good and session.shown_count == 2 and SDL_strcmp(session.shown[0].cast[cstr], "broken.avi") == 0.i32()
                # random.Random(17) after two pool shuffles and two choices.
                good <- good and session.run.order[0] == 2 and session.run.order[1] == 1 and session.run.order[2] == 0
            else:
                good <- not loaded and session.notice == SDLVideoSequence::NO_LIBRARY and session.run.phase == Jigsaw::PHASE_READY
        if good and expect_library:
            good <- sdl_video_sequence_render_selftest(handle)
            if good:
                good <- sdl_video_sequence_refresh_selftest(handle)
        SDLVideoSequence::close(handle)
        if good:
            _ = printf("Video Sequence media selftest: PASS\n")
        return 0.i32() if good else 1.i32()

def sdl_video_sequence_render_selftest(handle: i64) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        state: mutable usize[3] = zeroed
        surface: usize = sdl_screenshot_open(&state[0], 912.i32(), 684.i32(), 65536, 373694468.u32())
        return false if surface == 0.usize()
        good: mutable bool = true
        trusted Unsafe.PointerCast:
            renderer: mutable void& = state[1].cast[mutable void&]
            SDLVideoSequence::prepare(renderer, handle)
            length: i64 = SDLVideoSequence::frame_write(state[2].i64(), 65536, handle, 1, 912, 684)
            good <- sdl_finish_frame(renderer, state[2].cast[u8&], length, 912.i32(), 684.i32(), 1, 1,
                surface, 0.usize(), 0.usize()) == -1.i32()
            session: mutable heap SDLVideoSequence::Session& = handle.uintptr().cast[mutable heap SDLVideoSequence::Session&]
            target: mutable void& = surface.cast[mutable void&]
            for position in 0..<3 |position, session, target, good, handle|:
                box: Jigsaw::Rect = VideoSequence::tile_rect(912.0, 684.0, 3, position)
                x: f32 = (box.left + box.width / 2.0).f32()
                y: f32 = (684.0 - box.bottom - box.height / 2.0).f32()
                red: mutable u8 = 0.u8()
                green: mutable u8 = 0.u8()
                blue: mutable u8 = 0.u8()
                alpha: mutable u8 = 0.u8()
                good <- false if not SDL_ReadSurfacePixel(target, x.i32(), y.i32(), &red, &green, &blue, &alpha)
                piece: i64 = session.run.order[position.usize()]
                good <- false if (piece == 0 and red < 200.u8()) or (piece == 1 and green < 200.u8()) or (piece == 2 and blue < 200.u8())
            for position in 0..<2 |position, handle|:
                box: Jigsaw::Rect = VideoSequence::tile_rect(912.0, 684.0, 3, position)
                SDLVideoSequence::pointer(handle, false, (box.left + box.width / 2.0).f32(),
                    (684.0 - box.bottom - box.height / 2.0).f32(), 912.i32(), 684.i32())
            good <- good and session.run.swaps == 1
            SDLVideoSequence::prepare(renderer, 0)
            good <- good and SDL_GetNumberProperty(SDL_GetRendererProperties(renderer), "nw.video.sequence.pieces", 0) == 0
        sdl_screenshot_close(&state[0], surface)
        return good

def sdl_video_sequence_options_selftest() -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        handle: i64 = SDLVideoSequence::open(17)
        return 1.i32() if handle <= 0
        good: mutable bool = SDLVideoSequence::options_key(handle, 99) == 1
        _ = SDLVideoSequence::options_key(handle, SDLTaskKeys::RIGHT)
        good <- false if SDLVideoSequence::options_key(handle, 27) != 1
        trusted Unsafe.PointerCast:
            session: heap SDLVideoSequence::Session& = handle.uintptr().cast[heap SDLVideoSequence::Session&]
            good <- false if session.run.start_pieces != 3 or session.options_row >= 0
        good <- false if SDLVideoSequence::options_key(handle, 99, true) != 1
        _ = SDLVideoSequence::options_key(handle, SDLTaskKeys::LEFT)
        _ = SDLVideoSequence::options_key(handle, SDLTaskKeys::DOWN)
        _ = SDLVideoSequence::options_key(handle, SDLTaskKeys::LEFT)
        _ = SDLVideoSequence::options_key(handle, SDLTaskKeys::DOWN)
        _ = SDLVideoSequence::options_key(handle, 32)
        SDLVideoSequence::pointer(handle, false, 456.0.f32(), (684.0 - sdl_option_center(3, 4)).f32(), 912.i32(), 684.i32())
        SDLVideoSequence::pointer(handle, false, 456.0.f32(), (684.0 - sdl_option_center(3, 4)).f32(), 912.i32(), 684.i32())
        good <- false if SDLVideoSequence::options_key(handle, 13) != 2
        SDLVideoSequence::close(handle)
        reopened: i64 = SDLVideoSequence::open(17)
        if reopened > 0:
            trusted Unsafe.PointerCast:
                session: heap SDLVideoSequence::Session& = reopened.uintptr().cast[heap SDLVideoSequence::Session&]
                good <- false if session.run.start_pieces != 9 or session.run.puzzles != 20 or not session.run.adaptive or session.run.mark_placed
            SDLVideoSequence::close(reopened)
        else:
            good <- false
        if good:
            _ = printf("Video Sequence options selftest: PASS\n")
        return 0.i32() if good else 1.i32()

def sdl_video_sequence_refresh_selftest(handle: i64) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        staged: mutable u8[4096] = zeroed
        added: mutable u8[4096] = zeroed
        seen: mutable u8[4096] = zeroed
        return false if sdl_data_path(&staged[0], 4096.usize(), "/datasets/ucf101/incoming", 0, true) == 0.i32()
        return false if sdl_data_path(&added[0], 4096.usize(), "/datasets/ucf101/added.avi", 0, true) == 0.i32()
        return false if sdl_data_path(&seen[0], 4096.usize(), "/datasets/ucf101/seen.txt", 0, true) == 0.i32()
        trusted Unsafe.PointerCast:
            session: mutable heap SDLVideoSequence::Session& = handle.uintptr().cast[mutable heap SDLVideoSequence::Session&]
            session.run.puzzles <- 3
            for position in 0..<3 |position, session|:
                if session.run.order[position.usize()] != position:
                    for other in 0..<3 |other, position, session|:
                        if session.run.order[other.usize()] == position:
                            _ = VideoSequence::pick(&session.run, position, SDL_GetTicks().i64())
                            _ = VideoSequence::pick(&session.run, other, SDL_GetTicks().i64())
                            break
            return false if not SDL_RenamePath((&staged[0]).cast[cstr], (&added[0]).cast[cstr])
            sdl_jigsaw_note_photo(&seen[0], "added.avi", true)
            sdl_jigsaw_note_photo(&seen[0], "broken.avi", false)
            sdl_jigsaw_note_photo(&seen[0], "playable.avi", false)
            return false if not VideoSequence::advance(&session.run, session.run.feedback_until_ms) or not SDLVideoSequence::deal(session)
            return false if session.count != 3 or session.shown_count != 3 or session.run.puzzle != 2
            return SDL_strcmp(session.shown[2].cast[cstr], "added.avi") == 0.i32() and session.run.order[0] == 0 and session.run.order[1] == 2 and session.run.order[2] == 1
