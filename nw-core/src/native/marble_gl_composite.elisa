extern glActiveTexture(unit: u32)
extern glDrawArrays(mode: u32, first: i32, count: i32)

module MarbleGLComposite:
    def open(array: mutable u32&) -> bool:
        can Memory.Allocate:
            if array[0] == 0.u32():
                glGenVertexArrays(1.i32(), array)
            return array[0] != 0.u32()

    def close(array: mutable u32&):
        can Memory.Release:
            glDeleteVertexArrays(1.i32(), array)
            array[0] <- 0.u32()

    def draw(program: u32, array: u32, target: MarbleGLColour::Target&, stage: i64[4]&, width: i32, height: i32):
        can Abort.Panic:
            glBindFramebuffer(MarbleGLColour::FRAMEBUFFER, 0.u32())
            glViewport(stage[0].i32(), stage[1].i32(), stage[2].i32(), stage[3].i32())
            glDisable(2929.u32()) # GL_DEPTH_TEST
            glDisable(3042.u32()) # GL_BLEND
            glDisable(2884.u32()) # GL_CULL_FACE
            glDisable(3089.u32()) # GL_SCISSOR_TEST
            glDisable(32926.u32()) # GL_SAMPLE_ALPHA_TO_COVERAGE
            glUseProgram(program)
            glUniform1i(glGetUniformLocation(program, "scene_texture"), 0.i32())
            glActiveTexture(33984.u32()) # GL_TEXTURE0
            glBindTexture(MarbleGLColour::TEXTURE_2D, target.texture)
            glBindVertexArray(array)
            glDrawArrays(4.u32(), 0.i32(), 6.i32()) # GL_TRIANGLES
            glBindVertexArray(0.u32())
            glBindTexture(MarbleGLColour::TEXTURE_2D, 0.u32())
            glUseProgram(0.u32())
            glViewport(0.i32(), 0.i32(), width, height)
