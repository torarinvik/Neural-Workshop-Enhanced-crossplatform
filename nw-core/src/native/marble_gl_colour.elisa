extern glGenRenderbuffers(count: i32, buffers: mutable u32&) can[Memory.Allocate]
extern glDeleteRenderbuffers(count: i32, buffers: u32&) can[Memory.Release]
extern glBindRenderbuffer(target: u32, buffer: u32)
extern glRenderbufferStorageMultisample(target: u32, samples: i32, format: u32, width: i32, height: i32) can[Memory.Allocate]
extern glFramebufferRenderbuffer(target: u32, attachment: u32, renderbuffer_target: u32, buffer: u32)
extern glBlitFramebuffer(sx0: i32, sy0: i32, sx1: i32, sy1: i32, dx0: i32, dy0: i32, dx1: i32, dy1: i32, mask: u32, filter: u32)
extern glScissor(x: i32, y: i32, width: i32, height: i32)
extern glClearColor(r: f32, g: f32, b: f32, a: f32)

module MarbleGLColour:
    const FRAMEBUFFER: u32 = 36160
    const READ_FRAMEBUFFER: u32 = 36008
    const DRAW_FRAMEBUFFER: u32 = 36009
    const RENDERBUFFER: u32 = 36161
    const COLOR_ATTACHMENT: u32 = 36064
    const TEXTURE_2D: u32 = 3553
    const RGBA8: u32 = 32856

    struct Target:
        colour: mutable u32
        depth: mutable u32
        multisample: mutable u32
        resolved: mutable u32
        texture: mutable u32
        width: mutable i32
        height: mutable i32

    def close(target: mutable Target&):
        can Memory.Release:
            glDeleteFramebuffers(1.i32(), &target.multisample)
            glDeleteFramebuffers(1.i32(), &target.resolved)
            glDeleteRenderbuffers(1.i32(), &target.colour)
            glDeleteRenderbuffers(1.i32(), &target.depth)
            glDeleteTextures(1.i32(), &target.texture)
            target[0] <- zeroed

    def attach(buffer: mutable u32&, attachment: u32, format: u32, width: i32, height: i32):
        can Memory.Allocate:
            glGenRenderbuffers(1.i32(), buffer)
            glBindRenderbuffer(RENDERBUFFER, buffer[0])
            glRenderbufferStorageMultisample(RENDERBUFFER, 4.i32(), format, width, height)
            glFramebufferRenderbuffer(FRAMEBUFFER, attachment, RENDERBUFFER, buffer[0])

    def resize(target: mutable Target&, width: i32, height: i32) -> bool:
        can Memory.Allocate, Memory.Release:
            return false if width <= 0.i32() or height <= 0.i32()
            return true if target.width == width and target.height == height
            close(target)
            glGenFramebuffers(1.i32(), &target.multisample)
            glBindFramebuffer(FRAMEBUFFER, target.multisample)
            attach(&target.colour, COLOR_ATTACHMENT, RGBA8, width, height)
            attach(&target.depth, 36096.u32(), 33190.u32(), width, height)
            multisample_ok: bool = glCheckFramebufferStatus(FRAMEBUFFER) == 36053.u32()
            glGenFramebuffers(1.i32(), &target.resolved)
            glBindFramebuffer(FRAMEBUFFER, target.resolved)
            glGenTextures(1.i32(), &target.texture)
            glBindTexture(TEXTURE_2D, target.texture)
            glTexImage2D(TEXTURE_2D, 0.i32(), RGBA8.i32(), width, height, 0.i32(), 6408.u32(), 5121.u32(), 0.usize())
            glTexParameteri(TEXTURE_2D, 10241.u32(), 9729.i32())
            glTexParameteri(TEXTURE_2D, 10240.u32(), 9729.i32())
            glTexParameteri(TEXTURE_2D, 10242.u32(), 33071.i32())
            glTexParameteri(TEXTURE_2D, 10243.u32(), 33071.i32())
            glFramebufferTexture2D(FRAMEBUFFER, COLOR_ATTACHMENT, TEXTURE_2D, target.texture, 0.i32())
            resolved_ok: bool = glCheckFramebufferStatus(FRAMEBUFFER) == 36053.u32()
            glBindFramebuffer(FRAMEBUFFER, 0.u32())
            glBindRenderbuffer(RENDERBUFFER, 0.u32())
            glBindTexture(TEXTURE_2D, 0.u32())
            if not multisample_ok or not resolved_ok or glGetError() != 0.u32():
                close(target)
                return false
            target.width <- width
            target.height <- height
            return true

    def begin(target: Target&, dark: bool):
        glBindFramebuffer(FRAMEBUFFER, target.multisample)
        glViewport(0.i32(), 0.i32(), target.width, target.height)
        if dark:
            glClearColor(0.055.f32(), 0.055.f32(), 0.065.f32(), 1.0.f32())
        else:
            glClearColor(0.90.f32(), 0.905.f32(), 0.925.f32(), 1.0.f32())
        glEnable(2929.u32())
        glDepthFunc(513.u32())
        glDepthMask(1.u8())
        glDisable(2884.u32())
        glDisable(3042.u32())
        glEnable(32925.u32()) # GL_MULTISAMPLE
        glEnable(32926.u32()) # GL_SAMPLE_ALPHA_TO_COVERAGE
        glClearDepth(1.0)
        glClear(16640.u32()) # GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT

    def resolve(target: Target&):
        glBindFramebuffer(READ_FRAMEBUFFER, target.multisample)
        glBindFramebuffer(DRAW_FRAMEBUFFER, target.resolved)
        glBlitFramebuffer(0.i32(), 0.i32(), target.width, target.height, 0.i32(), 0.i32(), target.width, target.height, 16384.u32(), 9728.u32())
        glBindFramebuffer(FRAMEBUFFER, 0.u32())
