# Applied task options are profile-scoped for the lifetime of the desktop process.
global mutable sdl_concentration_choices: i64[6] = zeroed
global mutable sdl_recognition_choices: i64[6] = zeroed

# Dataset libraries use the same stable filename order as Python’s media pool.
extern SDL_GlobDirectory(path: cstr, pattern: cstr, flags: u32, count: usize) -> mutable heap void&? can[Blocking.IO, Memory.Allocate]
extern SDL_strcmp(left: cstr, right: cstr) -> i32

extern SDL_qsort(data: mutable heap void&, count: usize, width: usize, compare: fn(usize, usize) -> i32 can[Unsafe.PointerCast])

def sdl_compare_media_name(left: usize, right: usize) -> i32:
    can Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            a: heap usize& = left.cast[heap usize&]
            b: heap usize& = right.cast[heap usize&]
            return SDL_strcmp(a[0].cast[cstr], b[0].cast[cstr])

def sdl_media_flag(setting: cstr) -> bool:
    if SDL_getenv(setting) is sound:
        return sound == 49.u8()
    return false

def sdl_media_catalog(required: i64, task: cstr, directory: cstr, pattern: cstr, count: mutable i32&) -> mutable heap void&?:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        path: mutable u8[4096] = zeroed
        trusted Unsafe.PointerCast:
            folder: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
            return null if sdl_data_path(folder, 4096.usize(), directory, 0, true) == 0.i32()
            files: mutable heap void&? = SDL_GlobDirectory(folder.cast[cstr], pattern, 0.u32(), count.uintptr())
            if files == null or count[0].i64() < required:
                if files is memory:
                    SDL_free(memory)
                SDL_Log("%s needs %lld items, found %d in %s", task, required, count[0], folder.cast[cstr])
                return null
            data: mutable heap void& = files
            SDL_qsort(data, count[0].usize(), size_of(usize).usize(), sdl_compare_media_name)
            return data

def sdl_media_profile_path(path: mutable u8&) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        requested: mutable usize = 0.usize()
        if SDL_getenv("NW_MEDIA_CONFIGFILE") is config:
            requested <- config.uintptr()
        return sdl_profile_config_path(path, requested) != 0.i32()

def sdl_media_config(size: mutable i64&) -> mutable heap void&?:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: mutable u8[4096] = zeroed
        trusted Unsafe.PointerCast:
            target: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
            return null if not sdl_media_profile_path(target)
            if sdl_read_corpus(target, size) is data:
                if size[0] <= 1048576:
                    return data
                SDL_free(data)
        return null

def sdl_recognition_create(trials: i64, seed: i64) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Global.Read, Abort.Panic, Unsafe.PointerCast:
        count: mutable i64 = trials if RecognitionGame::allowed_trials(trials) else 40
        medium: mutable i64 = 0
        repeat: mutable i64 = 40
        lag: mutable i64 = 4
        study: mutable i64 = 0
        feedback: mutable i64 = 1
        size: mutable i64 = 0
        if sdl_media_config(&size) is raw:
            trusted Unsafe.PointerCast:
                data: heap u8& = raw.cast[heap u8&]
                saved_count: i64 = sdl_config_option(data, size, "RECOGNITION_TRIALS", 0, count)
                count <- saved_count if not RecognitionGame::allowed_trials(trials) and RecognitionGame::allowed_trials(saved_count)
                medium <- sdl_config_option(data, size, "RECOGNITION_MEDIUM", 2, 0)
                share: i64 = sdl_config_option(data, size, "RECOGNITION_REPEAT_PERCENT", 0, repeat)
                repeat <- share if RecognitionGame::allowed_repeat_percent(share)
                gap: i64 = sdl_config_option(data, size, "RECOGNITION_MIN_LAG", 0, lag)
                lag <- gap if RecognitionGame::allowed_lag(gap)
                duration: i64 = sdl_config_option(data, size, "RECOGNITION_STUDY_MS", 0, study)
                study <- duration if RecognitionGame::allowed_study(duration)
                feedback <- sdl_config_option(data, size, "RECOGNITION_FEEDBACK", 1, feedback)
                SDL_free(raw)
        saved: mutable i64[6] = zeroed
        trusted Unsafe.PointerCast:
            sdl_read_media_settings(true, (&saved[0]).uintptr().cast[mutable i64&])
        if saved[0] != 0:
            count <- saved[0] if not RecognitionGame::allowed_trials(trials)
            medium <- saved[1]
            repeat <- saved[2]
            lag <- saved[3]
            study <- saved[4]
            feedback <- saved[5]
        medium <- 0 if sdl_media_flag("NW_RECOGNITION_PICTURES")
        medium <- 1 if sdl_media_flag("NW_RECOGNITION_SOUND")
        if sdl_recognition_choices[0] != 0:
            count <- sdl_recognition_choices[0]
            medium <- sdl_recognition_choices[1]
            repeat <- sdl_recognition_choices[2]
            lag <- sdl_recognition_choices[3]
            study <- sdl_recognition_choices[4]
            feedback <- sdl_recognition_choices[5]
        handle: i64 = recognition_create(count, 1 if medium == 1 else 0, repeat, lag, study, feedback, seed)
        if medium >= 0 and handle > 0:
            trusted Unsafe.PointerCast:
                run: mutable heap RecognitionGame::RecognitionRun& = handle.uintptr().cast[mutable heap RecognitionGame::RecognitionRun&]
                run.media_enabled <- true
        return handle

def sdl_recognition_reload_media(run: mutable RecognitionGame::RecognitionRun&) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            sdl_release_task_media(run.media_files, run.sound_voice)
            run.media_files <- 0.usize()
            run.sound_voice <- 0.usize()
            run.media_count <- 0
            count: mutable i32 = 0.i32()
            sound: bool = run.medium == RecognitionGame::MEDIUM_SOUND
            directory: cstr = "/datasets/esc50" if sound else "/datasets/tiny-imagenet"
            pattern: cstr = "*.wav" if sound else "*.jpg"
            files: mutable heap void&? = sdl_media_catalog(2, "Recognition", directory, pattern, &count)
            run.media_missing <- files == null
            if files is catalog:
                run.media_files <- catalog.uintptr()
                run.media_count <- count.i64()
                return true
            run.phase <- RecognitionGame::PHASE_READY
            return false

def sdl_recognition_stop(run: mutable RecognitionGame::RecognitionRun&):
    can Abort.Panic, Unsafe.PointerCast:
        if run.sound_voice != 0.usize():
            trusted Unsafe.PointerCast:
                SDLAudio::stop(run.sound_voice.cast[mutable void&])
            run.sound_voice <- 0.usize()

def sdl_recognition_play(handle: i64):
    can Blocking.IO, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap RecognitionGame::RecognitionRun& = handle.uintptr().cast[mutable heap RecognitionGame::RecognitionRun&]
            return if run.medium != RecognitionGame::MEDIUM_SOUND or run.media_files == 0.usize()
            if run.phase != RecognitionGame::PHASE_SHOWING:
                sdl_recognition_stop(run)
                return
            return if run.sound_presented == run.sound_request
            run.sound_presented <- run.sound_request
            sdl_recognition_stop(run)
            id: i64 = RecognitionGame::info(run, RecognitionGame::INFO_ITEM)
            return if id < 0 or id >= run.media_count
            run.sound_voice <- sdl_play_esc50(run.media_files, id)

extern SDL_SetNumberProperty(properties: u32, name: cstr, value: i64) -> bool
extern SDL_ClearProperty(properties: u32, name: cstr) -> bool

def sdl_recognition_photo(renderer: mutable void&, handle: i64):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        properties: u32 = SDL_GetRendererProperties(renderer)
        trusted Unsafe.PointerCast:
            path: mutable u8[4096] = zeroed
            target: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
            asset: mutable i64 = 0
            if handle > 0:
                run: heap RecognitionGame::RecognitionRun& = handle.uintptr().cast[heap RecognitionGame::RecognitionRun&]
                if run.medium == RecognitionGame::MEDIUM_PICTURE and run.media_files != 0.usize() and run.phase == RecognitionGame::PHASE_SHOWING:
                    item: i64 = RecognitionGame::info(run, RecognitionGame::INFO_ITEM)
                    if item >= 0 and item < run.media_count and sdl_catalog_path(target, "/datasets/tiny-imagenet/", run.media_files, item):
                        asset <- 2000 + item
            _ = SDL_SetNumberProperty(properties, "nw.recognition.asset", asset)
            sdl_update_photo(renderer, properties, "nw.recognition.texture", "nw.recognition.path", target.cast[cstr] if asset != 0 else "")

def sdl_update_photo(renderer: mutable void&, properties: u32, texture_key: cstr, path_key: cstr, path: cstr):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        previous: cstr = SDL_GetStringProperty(properties, path_key, "")
        return if SDL_strcmp(previous, path) == 0.i32()
        if SDL_GetPointerProperty(properties, texture_key, null) is old:
            _ = SDL_ClearProperty(properties, texture_key)
            SDL_DestroyTexture(old)
        if SDL_strcmp(path, "") == 0.i32():
            _ = SDL_ClearProperty(properties, path_key)
            return
        _ = SDL_SetStringProperty(properties, path_key, path)
        if sdl_jpeg_texture(renderer, path) is texture:
            if not SDL_SetPointerProperty(properties, texture_key, texture):
                SDL_DestroyTexture(texture)

def sdl_concentration_photos(renderer: mutable void&, handle: i64):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        properties: u32 = SDL_GetRendererProperties(renderer)
        pairs: mutable i64 = 0
        visible: mutable i64[64] = zeroed
        files: mutable usize = 0.usize()
        trusted Unsafe.PointerCast:
            if handle > 0:
                run: heap ConcentrationGame::ConcentrationRun& = handle.uintptr().cast[heap ConcentrationGame::ConcentrationRun&]
                if run.medium == ConcentrationGame::MEDIUM_PICTURE and run.media_files != 0.usize():
                    pairs <- run.pairs
                    files <- run.media_files
                    for at in 0..<run.count |at, run, visible|:
                        if run.face_up[at.usize()] != 0 or run.matched[at.usize()] != 0:
                            pair: usize = run.index[at.usize()].usize()
                            visible[pair] <- run.media_pair[pair] + 1
            prior: i64 = SDL_GetNumberProperty(properties, "nw.concentration.pairs", 0)
            limit: i64 = pairs if pairs > prior else prior
            if pairs != prior:
                _ = SDL_SetNumberProperty(properties, "nw.concentration.pairs", pairs)
            for pair in 0..<limit |pair, renderer, properties, files, visible|:
                key: mutable u8[48] = zeroed
                path_key: mutable u8[48] = zeroed
                _ = SDL_snprintf(&key[0], 48.usize(), "nw.concentration.texture.%lld", pair)
                _ = SDL_snprintf(&path_key[0], 48.usize(), "nw.concentration.path.%lld", pair)
                path: mutable u8[4096] = zeroed
                item: i64 = visible[pair.usize()] - 1
                target: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
                if item >= 0:
                    target[0] <- 0.u8() if not sdl_catalog_path(target, "/datasets/tiny-imagenet/", files, item)
                sdl_update_photo(renderer, properties, (&key[0]).uintptr().cast[cstr],
                    (&path_key[0]).uintptr().cast[cstr], target.cast[cstr])

def sdl_catalog_path(target: mutable u8&, directory: cstr, files: usize, id: i64) -> bool:
    can Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            entries: heap usize& = files.cast[heap usize&]
            return false if sdl_data_path(target, 4096.usize(), directory, 0, true) == 0.i32()
            length: i64 = SDL_strlen(target.cast[cstr]).i64()
            return SyllogismOptionsHost::append(target.uintptr().i64(), 4096, length, entries[id.usize()].cast[cstr]) >= 0

def sdl_play_esc50(files: usize, id: i64) -> usize:
    can Blocking.IO, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            path: mutable u8[4096] = zeroed
            target: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
            return 0.usize() if not sdl_catalog_path(target, "/datasets/esc50/", files, id)
            if SDLAudio::play_wav(target.cast[cstr], 1.0.f32()) is voice:
                return voice.uintptr()
        return 0.usize()

def sdl_concentration_create(seed: i64) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Global.Read, Abort.Panic, Unsafe.PointerCast:
        pairs: mutable i64 = 8
        medium: mutable i64 = 0
        peek: mutable i64 = 0
        hide: mutable i64 = 900
        turns: mutable i64 = 1
        size: mutable i64 = 0
        if sdl_media_config(&size) is raw:
            trusted Unsafe.PointerCast:
                data: heap u8& = raw.cast[heap u8&]
                saved_pairs: i64 = sdl_config_option(data, size, "CONCENTRATION_PAIRS", 0, pairs)
                pairs <- saved_pairs if ConcentrationGame::allowed_pairs(saved_pairs)
                medium <- sdl_config_option(data, size, "CONCENTRATION_MEDIUM", 2, 0)
                saved_peek: i64 = sdl_config_option(data, size, "CONCENTRATION_PEEK_MS", 0, peek)
                peek <- saved_peek if ConcentrationGame::allowed_peek(saved_peek)
                saved_hide: i64 = sdl_config_option(data, size, "CONCENTRATION_HIDE_MS", 0, hide)
                hide <- saved_hide if ConcentrationGame::allowed_hide(saved_hide)
                turns <- sdl_config_option(data, size, "CONCENTRATION_SHOW_TURNS", 1, turns)
                SDL_free(raw)
        saved: mutable i64[6] = zeroed
        trusted Unsafe.PointerCast:
            sdl_read_media_settings(false, (&saved[0]).uintptr().cast[mutable i64&])
        if saved[0] != 0:
            pairs <- saved[0]
            medium <- saved[1]
            peek <- saved[2]
            hide <- saved[3]
            turns <- saved[4]
        medium <- 0 if sdl_media_flag("NW_CONCENTRATION_PICTURES")
        medium <- 1 if sdl_media_flag("NW_CONCENTRATION_SOUND")
        if sdl_concentration_choices[0] != 0:
            pairs <- sdl_concentration_choices[0]
            medium <- sdl_concentration_choices[1]
            peek <- sdl_concentration_choices[2]
            hide <- sdl_concentration_choices[3]
            turns <- sdl_concentration_choices[4]
        handle: i64 = concentration_create(pairs, 1 if medium == 1 else 0, peek, hide, turns, 0, seed)
        if medium >= 0 and handle > 0:
            trusted Unsafe.PointerCast:
                run: mutable heap ConcentrationGame::ConcentrationRun& = handle.uintptr().cast[mutable heap ConcentrationGame::ConcentrationRun&]
                run.media_enabled <- true
        return handle

def sdl_concentration_reload_media(run: mutable ConcentrationGame::ConcentrationRun&) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            sdl_release_task_media(run.media_files, run.sound_voice)
            run.media_files <- 0.usize()
            run.sound_voice <- 0.usize()
            run.media_count <- 0
            count: mutable i32 = 0.i32()
            sound: bool = run.medium == ConcentrationGame::MEDIUM_SOUND
            directory: cstr = "/datasets/esc50" if sound else "/datasets/tiny-imagenet"
            pattern: cstr = "*.wav" if sound else "*.jpg"
            files: mutable heap void&? = sdl_media_catalog(run.pairs, "Concentration", directory, pattern, &count)
            run.media_missing <- files == null
            if files is catalog:
                run.media_files <- catalog.uintptr()
                run.media_count <- count.i64()
                return true
            run.phase <- ConcentrationGame::PHASE_READY
            return false

def sdl_concentration_play(handle: i64):
    can Blocking.IO, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap ConcentrationGame::ConcentrationRun& = handle.uintptr().cast[mutable heap ConcentrationGame::ConcentrationRun&]
            return if run.medium != ConcentrationGame::MEDIUM_SOUND or run.media_files == 0.usize() or run.sound_presented == run.sound_request
            run.sound_presented <- run.sound_request
            if run.sound_voice != 0.usize():
                SDLAudio::stop(run.sound_voice.cast[mutable void&])
                run.sound_voice <- 0.usize()
            id: i64 = run.sound_item
            if id >= 0 and id < run.media_count:
                run.sound_voice <- sdl_play_esc50(run.media_files, id)


def sdl_release_task_media(files: usize, voice: usize):
    can Memory.Release, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            if voice != 0.usize():
                SDLAudio::stop(voice.cast[mutable void&])
            if files != 0.usize():
                SDL_free(files.cast[mutable heap void&])
