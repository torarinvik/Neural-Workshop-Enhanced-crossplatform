extern glGenVertexArrays(count: i32, arrays: mutable u32&) can[Memory.Allocate]
extern glDeleteVertexArrays(count: i32, arrays: u32&) can[Memory.Release]
extern glBindVertexArray(array: u32)
extern glGenBuffers(count: i32, buffers: mutable u32&) can[Memory.Allocate]
extern glDeleteBuffers(count: i32, buffers: u32&) can[Memory.Release]
extern glBindBuffer(target: u32, buffer: u32)
extern glBufferData(target: u32, size: isize, data: void&, usage: u32) can[Memory.Allocate]
extern glGetAttribLocation(program: u32, name: cstr) -> i32
extern glEnableVertexAttribArray(index: u32)
extern glDisableVertexAttribArray(index: u32)
extern glVertexAttribPointer(index: u32, size: i32, kind: u32, normalized: u8, stride: i32, offset: usize)
extern glDrawElements(mode: u32, count: i32, kind: u32, offset: usize)
extern glGetError() -> u32

module MarbleGLMesh:
    const ARRAY_BUFFER: u32 = 34962
    const ELEMENT_ARRAY_BUFFER: u32 = 34963
    const STATIC_DRAW: u32 = 35044
    const FLOAT: u32 = 5126
    const UNSIGNED_INT: u32 = 5125

    struct Mesh:
        array: mutable u32
        vertices: mutable u32
        elements: mutable u32
        count: mutable i32
        normal_offset: mutable usize

    def close(mesh: mutable Mesh&):
        can Memory.Release:
            glDeleteVertexArrays(1.i32(), &mesh.array)
            glDeleteBuffers(1.i32(), &mesh.vertices)
            glDeleteBuffers(1.i32(), &mesh.elements)
            mesh.array <- 0.u32()
            mesh.vertices <- 0.u32()
            mesh.elements <- 0.u32()
            mesh.count <- 0.i32()
            mesh.normal_offset <- 0.usize()

    def upload(mesh: mutable Mesh&, source: MarbleGeometry::Mesh&) -> bool:
        can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            close(mesh)
            count: i64 = source.indices.count.i64()
            return true if count == 0
            coordinates: i64 = source.positions.count.i64()
            return false if coordinates == 0 or coordinates % 3 != 0 or source.normals.count != source.positions.count or count > 2147483647
            vertices: mutable darray[f32] = []
            indices: mutable darray[u32] = []
            for at in 0..<coordinates |at, vertices, source|:
                vertices.push(source.positions[at.usize()].f32())
            for at in 0..<coordinates |at, vertices, source|:
                vertices.push(source.normals[at.usize()].f32())
            for at in 0..<count |at, indices, source, coordinates|:
                index: i64 = source.indices[at.usize()]
                return false if index < 0 or index >= coordinates / 3
                indices.push(index.u32())
            glGenVertexArrays(1.i32(), &mesh.array)
            glGenBuffers(1.i32(), &mesh.vertices)
            glGenBuffers(1.i32(), &mesh.elements)
            if mesh.array == 0.u32() or mesh.vertices == 0.u32() or mesh.elements == 0.u32():
                close(mesh)
                return false
            glBindVertexArray(mesh.array)
            glBindBuffer(ARRAY_BUFFER, mesh.vertices)
            glBindBuffer(ELEMENT_ARRAY_BUFFER, mesh.elements)
            trusted Unsafe.PointerCast:
                glBufferData(ARRAY_BUFFER, (coordinates * 8).isize(), (&vertices[0]).cast[void&], STATIC_DRAW)
                glBufferData(ELEMENT_ARRAY_BUFFER, (count * 4).isize(), (&indices[0]).cast[void&], STATIC_DRAW)
            glBindVertexArray(0.u32())
            glBindBuffer(ARRAY_BUFFER, 0.u32())
            if glGetError() != 0.u32():
                close(mesh)
                return false
            mesh.count <- count.i32()
            mesh.normal_offset <- (coordinates * 4).usize()
            return true

    def draw(mesh: Mesh&, program: u32):
        return if mesh.count == 0.i32()
        glBindVertexArray(mesh.array)
        glBindBuffer(ARRAY_BUFFER, mesh.vertices)
        position: i32 = glGetAttribLocation(program, "position")
        normal: i32 = glGetAttribLocation(program, "normal")
        if position >= 0.i32():
            glEnableVertexAttribArray(position.u32())
            glVertexAttribPointer(position.u32(), 3.i32(), FLOAT, 0.u8(), 0.i32(), 0.usize())
        if normal >= 0.i32():
            glEnableVertexAttribArray(normal.u32())
            glVertexAttribPointer(normal.u32(), 3.i32(), FLOAT, 0.u8(), 0.i32(), mesh.normal_offset)
        glDrawElements(4.u32(), mesh.count, UNSIGNED_INT, 0.usize())
        if position >= 0.i32():
            glDisableVertexAttribArray(position.u32())
        if normal >= 0.i32():
            glDisableVertexAttribArray(normal.u32())
        glBindVertexArray(0.u32())
        glBindBuffer(ARRAY_BUFFER, 0.u32())
