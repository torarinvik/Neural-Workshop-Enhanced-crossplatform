# Platform path and settings persistence through SDL3 FFI.
include "./syllogism_options_io.elisa"

extern SDL_getenv(name: cstr) -> u8&?
extern SDL_GetPlatform() -> cstr
extern SDL_CreateDirectory(path: cstr) -> bool can[Blocking.IO]
extern SDL_GetTicksNS() -> u64

module SyllogismOptionsHost:
    def append(dest: i64, capacity: i64, start: i64, source: cstr) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            return -1 if dest == 0 or capacity <= 0 or start < 0 or start >= capacity
            trusted Unsafe.PointerCast:
                out: mutable heap u8& = dest.uintptr().cast[mutable heap u8&]
                text: heap u8& = source.cast[heap u8&]
                at: mutable i64 = start
                index: mutable i64 = 0
                while at < capacity - 1 |at, capacity, index, out, text|:
                    byte: u8 = text[index.usize()]
                    if byte == 0.u8():
                        out[at.usize()] <- 0.u8()
                        return at
                    out[at.usize()] <- byte
                    index <- index + 1
                    at <- at + 1
                if text[index.usize()] == 0.u8():
                    out[at.usize()] <- 0.u8()
                    return at
                return -1

    def append_user_path(dest: i64, capacity: i64, source: cstr) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                text: u8& = source.cast[u8&]
                if text[0] == 126.u8() and (text[1] == 47.u8() or text[1] == 0.u8()):
                    windows: bool = syllogism_argument_is(SDL_GetPlatform().uintptr().i64(), "Windows")
                    home: u8&? = SDL_getenv("USERPROFILE") if windows else SDL_getenv("HOME")
                    if home != null:
                        base: u8& = home
                        if base[0] != 0.u8():
                            end: i64 = append(dest, capacity, 0, base.cast[cstr])
                            return -1 if end < 0
                            return append(dest, capacity, end, (&text[1]).uintptr().cast[cstr])
                return append(dest, capacity, 0, source)

    def settings_override(dest: i64, capacity: i64, source: cstr, create: bool) -> i64:
        can Blocking.IO, Abort.Panic, Unsafe.PointerCast:
            length: i64 = append_user_path(dest, capacity, source)
            return length if length < 0 or not create
            trusted Unsafe.PointerCast:
                bytes: mutable heap u8& = dest.uintptr().cast[mutable heap u8&]
                windows: bool = syllogism_argument_is(SDL_GetPlatform().uintptr().i64(), "Windows")
                parent: mutable i64 = length - 1
                while parent > 0 and bytes[parent.usize()] != 47.u8() and (not windows or bytes[parent.usize()] != 92.u8()) |bytes, parent, windows|:
                    parent <- parent - 1
                return length if parent <= 0 or (windows and parent == 2 and bytes[1] == 58.u8())
                separator: u8 = bytes[parent.usize()]
                bytes[parent.usize()] <- 0.u8()
                created: bool = SDL_CreateDirectory(dest.uintptr().cast[cstr])
                bytes[parent.usize()] <- separator
                return length if created else -1

    # -2 means the desktop has no data-directory override.
    def data_path(dest: i64, capacity: i64, suffix: cstr) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            if SDL_getenv("NW_DATA_DIRECTORY") is directory:
                return -2 if directory == 0.u8()
                trusted Unsafe.PointerCast:
                    length: i64 = append(dest, capacity, 0, directory.cast[cstr])
                    return -1 if length < 0
                    return append(dest, capacity, length, suffix)
            return -2

    def data_settings_path(dest: i64, capacity: i64, suffix: cstr, create: bool) -> i64:
        can Blocking.IO, Abort.Panic, Unsafe.PointerCast:
            length: i64 = data_path(dest, capacity, "")
            return length if length < 0
            trusted Unsafe.PointerCast:
                return -1 if create and not SDL_CreateDirectory(dest.uintptr().cast[cstr])
            return append(dest, capacity, length, suffix)

    def path(dest: i64, capacity: i64, create: bool) -> i64:
        can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
            if SDL_getenv("NW_SYLLOGISM_SETTINGS_PATH") is override:
                if override != 0.u8():
                    trusted Unsafe.PointerCast:
                        return settings_override(dest, capacity, override.cast[cstr], create)
            named: i64 = sdl_named_task_settings_path(dest, capacity, "/syllogism-options", create)
            return named if named != -2
            selected: i64 = data_settings_path(dest, capacity, "/syllogism-options", create)
            return selected if selected != -2
            trusted Unsafe.PointerCast:
                platform: cstr = SDL_GetPlatform()
                platform_bytes: heap u8& = platform.cast[heap u8&]
                windows: bool = platform_bytes[0] == 87.u8() and platform_bytes[1] == 105.u8() and platform_bytes[2] == 110.u8() and platform_bytes[3] == 100.u8() and platform_bytes[4] == 111.u8() and platform_bytes[5] == 119.u8() and platform_bytes[6] == 115.u8() and platform_bytes[7] == 0.u8()
                base: mutable i64 = 0
                if windows:
                    if SDL_getenv("APPDATA") is found:
                        base <- found.uintptr().i64() if found != 0.u8()
                    if base == 0:
                        if SDL_getenv("USERPROFILE") is found:
                            base <- found.uintptr().i64() if found != 0.u8()
                else:
                    if SDL_getenv("HOME") is found:
                        base <- found.uintptr().i64() if found != 0.u8()
                return -1 if base == 0
                end: mutable i64 = append(dest, capacity, 0, base.uintptr().cast[cstr])
                return -1 if end < 0
                end <- append(dest, capacity, end, "/Neural Workshop" if windows else "/.neural-workshop")
                return -1 if end < 0
                return -1 if create and not SDL_CreateDirectory(dest.uintptr().cast[cstr])
                return append(dest, capacity, end, "/syllogism-options")

    def temporary(dest: i64, capacity: i64, path: i64) -> i64:
        can Abort.Panic, Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                end: mutable i64 = append(dest, capacity, 0, path.uintptr().cast[cstr])
                return -1 if end < 0
                end <- append(dest, capacity, end, ".")
                return -1 if end < 0
                digits: mutable u8[24] = zeroed
                n: mutable u64 = SDL_GetTicksNS()
                count: mutable i64 = 0
                while n > 0 |n, count, digits|:
                    digits[count.usize()] <- (48.u64() + n % 10.u64()).u8()
                    n <- n / 10.u64()
                    count <- count + 1
                if count == 0:
                    digits[0] <- 48.u8()
                    count <- 1
                return -1 if end + count >= capacity
                out: mutable heap u8& = dest.uintptr().cast[mutable heap u8&]
                while count > 0 |count, end, out, digits|:
                    count <- count - 1
                    out[end.usize()] <- digits[count.usize()]
                    end <- end + 1
                out[end.usize()] <- 0.u8()
                return append(dest, capacity, end, ".tmp")

def syllogism_options_read_settings(output: i64) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: mutable u8[4096] = zeroed
        trusted Unsafe.PointerCast:
            address: i64 = (&path[0]).uintptr().i64()
            return 0 if SyllogismOptionsHost::path(address, 4096, false) < 0
            return syllogism_options_read_file(address, output)

def syllogism_options_save_settings(level: i64, trials: i64, working: i64, adaptive: i64, real_words: i64) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: mutable u8[4096] = zeroed
        temporary: mutable u8[4200] = zeroed
        trusted Unsafe.PointerCast:
            path_address: i64 = (&path[0]).uintptr().i64()
            temp_address: i64 = (&temporary[0]).uintptr().i64()
            return 0 if SyllogismOptionsHost::path(path_address, 4096, true) < 0
            return 0 if SyllogismOptionsHost::temporary(temp_address, 4200, path_address) < 0
            return syllogism_options_write_file(path_address, temp_address, level, trials, working, adaptive, real_words)

export fn nw_syllogism_options_read_settings(output: i64) -> i64 = syllogism_options_read_settings
export fn nw_syllogism_options_save_settings(level: i64, trials: i64, working: i64, adaptive: i64, real_words: i64) -> i64 = syllogism_options_save_settings

extern SDL_Log(format: cstr, ...) can[Console.Write]

def syllogism_argument_length(address: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if address == 0
        trusted Unsafe.PointerCast:
            bytes: heap u8& = address.uintptr().cast[heap u8&]
            at: mutable i64 = 0
            while at < 16777216 |at, bytes|:
                return at if bytes[at.usize()] == 0.u8()
                at <- at + 1
            return -1

def syllogism_argument_is(address: i64, text: cstr) -> bool:
    can Abort.Panic, Unsafe.PointerCast:
        return false if address == 0
        trusted Unsafe.PointerCast:
            other: i64 = text.uintptr().i64()
            return syllogism_options_same_path(address, other)

def syllogism_options_parse(argc: i64, argv: usize&?, output: mutable i64&?, saved: i64, ini: usize = 0.usize()) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 2 if argc < 1 or argv == null or output == null
        trusted Unsafe.PointerCast:
            args_pointer: usize& = argv
            output_pointer: mutable i64& = output
            values: mutable heap i64& = output_pointer.cast[mutable heap i64&]
            values[0] <- 3
            values[1] <- 6
            values[2] <- 1
            values[3] <- 1
            values[4] <- 1
            sdl_apply_task_ini_defaults(values, ini, 5)
            if saved != 0:
                _ = syllogism_options_read_settings(output_pointer.uintptr().i64())
            args: heap usize& = args_pointer.cast[heap usize&]
            at: mutable i64 = 1
            while at < argc |at, args, values, argc|:
                argument: i64 = args[at.usize()].i64()
                if syllogism_argument_is(argument, "--syllogism-no-working"):
                    values[2] <- 0
                elif syllogism_argument_is(argument, "--syllogism-no-adaptive"):
                    values[3] <- 0
                elif syllogism_argument_is(argument, "--syllogism-invented-words"):
                    values[4] <- 0
                elif syllogism_argument_is(argument, "--syllogism-level") or syllogism_argument_is(argument, "--syllogism-trials"):
                    row: i64 = 0 if syllogism_argument_is(argument, "--syllogism-level") else 1
                    at <- at + 1
                    if at >= argc:
                        SDL_Log("Syllogism option requires a value")
                        return 2
                    value_address: i64 = args[at.usize()].i64()
                    length: i64 = syllogism_argument_length(value_address)
                    value: i64 = SyllogismOptions::parse_argument(value_address, length, row)
                    if value < 0:
                        SDL_Log("Invalid Syllogism option value")
                        return 2
                    values[row.usize()] <- value
                at <- at + 1
            return 0

def syllogism_options_save(output: i64&?) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        return 0 if output == null
        trusted Unsafe.PointerCast:
            pointer: i64& = output
            values: heap i64& = pointer.cast[heap i64&]
            return syllogism_options_save_settings(values[0], values[1], values[2], values[3], values[4])

def syllogism_options_modify(output: mutable i64&?, row: i64, step: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return 0 if output == null or row < 0 or row > 4
        trusted Unsafe.PointerCast:
            pointer: mutable i64& = output
            values: mutable heap i64& = pointer.cast[mutable heap i64&]
            values[row.usize()] <- SyllogismOptions::cycle(row, values[row.usize()], step)
            return 1

def syllogism_options_parse_legacy(argc: i64, argv: usize&?, output: mutable i64&?, saved: i64) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return syllogism_options_parse(argc, argv, output, saved)

export fn nw_syllogism_options_parse(argc: i64, argv: usize&?, output: mutable i64&?, saved: i64) -> i64 = syllogism_options_parse_legacy
export fn nw_syllogism_options_save(output: i64&?) -> i64 = syllogism_options_save
export fn nw_syllogism_options_modify(output: mutable i64&?, row: i64, step: i64) -> i64 = syllogism_options_modify
