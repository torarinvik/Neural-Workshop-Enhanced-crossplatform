extern SDL_GetGlobalProperties() -> u32
extern SDL_SetNumberProperty(properties: u32, name: cstr, value: i64) -> bool
extern nw_sdl_camera_create(rung: i64, trials: i64, adaptive: i64, seed: i64) -> usize
extern nw_sdl_camera_destroy(handle: usize)
extern nw_sdl_camera_action(handle: usize, code: i64, value: i64, aux: i64, now_ms: i64) -> bool
extern nw_sdl_camera_advance(handle: usize, now_ms: i64) -> bool
extern nw_sdl_camera_phase(handle: usize) -> i64
extern nw_sdl_camera_chrome(handle: usize, dest: mutable u8&, capacity: i64, black: i64, width: i32, height: i32) -> i64
extern nw_sdl_camera_present(handle: usize, output: mutable void&, width: i32, height: i32) -> i32

extern nw_sdl_camera_option(row: i64, value: i64, direction: i64) -> i64
extern nw_sdl_camera_write_note(dest: mutable u8&, capacity: i64, rung: i64, adaptive: i64) -> i64

def sdl_entry_camera():
    can Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            properties: u32 = SDL_GetGlobalProperties()
            create: fn(i64, i64, i64, i64) -> usize = nw_sdl_camera_create
            destroy: fn(usize) -> void = nw_sdl_camera_destroy
            action: fn(usize, i64, i64, i64, i64) -> bool = nw_sdl_camera_action
            advance: fn(usize, i64) -> bool = nw_sdl_camera_advance
            phase: fn(usize) -> i64 = nw_sdl_camera_phase
            chrome: fn(usize, mutable u8&, i64, i64, i32, i32) -> i64 = nw_sdl_camera_chrome
            present: fn(usize, mutable void&, i32, i32) -> i32 = nw_sdl_camera_present
            _ = SDL_SetNumberProperty(properties, "nw.camera.destroy", destroy.cast[usize].i64())
            _ = SDL_SetNumberProperty(properties, "nw.camera.action", action.cast[usize].i64())
            _ = SDL_SetNumberProperty(properties, "nw.camera.advance", advance.cast[usize].i64())
            _ = SDL_SetNumberProperty(properties, "nw.camera.phase", phase.cast[usize].i64())
            _ = SDL_SetNumberProperty(properties, "nw.camera.chrome", chrome.cast[usize].i64())
            _ = SDL_SetNumberProperty(properties, "nw.camera.present", present.cast[usize].i64())
            option: fn(i64, i64, i64) -> i64 = nw_sdl_camera_option
            note: fn(mutable u8&, i64, i64, i64) -> i64 = nw_sdl_camera_write_note
            _ = SDL_SetNumberProperty(properties, "nw.camera.option", option.cast[usize].i64())
            _ = SDL_SetNumberProperty(properties, "nw.camera.note", note.cast[usize].i64())
            _ = SDL_SetNumberProperty(properties, "nw.camera.create", create.cast[usize].i64())
