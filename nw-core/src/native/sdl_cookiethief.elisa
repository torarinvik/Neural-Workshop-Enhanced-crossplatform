include "../tasks/cookiethief.elisa"
include "../scene_cookiethief.elisa"
include "../tasks/cookiethief_game.elisa"

struct SDLCookieThiefSession:
    run: mutable CookieThiefGame::Run
    options_row: mutable i64
    options_from_hub: mutable bool
    options_draft: mutable i64[6]

def sdl_read_cookie_options(output: mutable i64&):
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: mutable u8[4096] = zeroed
        data: mutable u8[128] = zeroed
        trusted Unsafe.PointerCast:
            target: mutable u8& = (&path[0]).uintptr().cast[mutable u8&]
            return if not sdl_task_profile_sidecar(target, ".cookie-thief-options")
            if SDL_IOFromFile(target.cast[cstr], "rb") is stream:
                raw: heap u8& = (&data[0]).uintptr().cast[heap u8&]
                length: usize = SDL_ReadIO(stream, (&data[0]).cast[mutable void&], 128.usize())
                status: i32 = SDL_GetIOStatus(stream)
                closed: bool = SDL_CloseIO(stream)
                return if not closed or status != 2.i32() or length == 0.usize() or length >= 128.usize()
                values: mutable i64[5] = zeroed
                at: mutable i64 = 0
                for row in 0..<5 |row, values, at, raw, length|:
                    value: i64 = SyllogismOptions::saved_integer(raw, length.i64(), &at)
                    valid: bool = CookieThiefGame::option_allowed(row, value)
                    return if not valid
                    values[row.usize()] <- value
                while at < length.i64() and SyllogismOptions::whitespace(raw[at.usize()].i64()) |at, length, raw|:
                    at <- at + 1
                return if at != length.i64()
                for row in 0..<5 |row, output, values|:
                    output[row.usize()] <- values[row.usize()]

def sdl_cookie_option_change(row: i64, current: i64, direction: i64) -> i64:
    can Abort.Panic:
        count: i64 = CookieThiefGame::option_count(row)
        for at in 0..<count |at, row, current, direction, count|:
            index: usize = (at if direction > 0 else count - at - 1).usize()
            value: i64 = CookieThiefGame::option_value(row, index)
            return value if (value - current) * direction > 0
        return CookieThiefGame::option_value(row, (0 if direction > 0 else count - 1).usize())

def sdl_cookie_preview(draft: mutable i64&):
    can Memory.Allocate, Abort.Panic:
        wins: i64 = CookieThiefGame::rehearsal_wins(draft[0])
        draft[5] <- py_round_half_even(100.0 * wins.f64() / CookieThiefGame::REHEARSAL_DEALS.f64())

def sdl_cookie_options_key(handle: i64, key: i64, from_hub: bool = false) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            session: mutable heap SDLCookieThiefSession& = handle.uintptr().cast[mutable heap SDLCookieThiefSession&]
            draft: mutable i64& = (&session.options_draft[0]).uintptr().cast[mutable i64&]
            if session.options_row < 0:
                return 0 if key != 99 or (session.run.phase != CookieThiefGame::PHASE_READY and session.run.phase != CookieThiefGame::PHASE_DONE)
                draft[0] <- session.run.start_rung
                draft[1] <- session.run.total_trials
                draft[2] <- session.run.beat_ms
                draft[3] <- session.run.set_ms
                draft[4] <- 1 if session.run.adaptive else 0
                sdl_cookie_preview(draft)
                session.options_from_hub <- from_hub
                session.options_row <- 0
                return 1
            if SDLTaskKeys::enter(key) or key == 27:
                close: i64 = 2 if session.options_from_hub else 1
                if SDLTaskKeys::enter(key):
                    data: mutable u8[128] = zeroed
                    length: i32 = SDL_snprintf(&data[0], 128.usize(), "%lld %lld %lld %lld %lld\n", draft[0], draft[1], draft[2], draft[3], draft[4])
                    if length <= 0.i32() or length >= 128.i32() or not sdl_save_profile_sidecar(".cookie-thief-options", &data[0], length.usize()):
                        SDL_Log("Could not save Cookie Thief options")
                        return 1
                    CookieThiefGame::configure(&session.run, draft[0], draft[1], draft[2], draft[3], draft[4] != 0)
                session.options_row <- -1
                return close
            session.options_row <- SDLTaskKeys::option_row(key, session.options_row, 5)
            if key == SDLTaskKeys::LEFT or key == SDLTaskKeys::RIGHT or key == 32:
                row: i64 = session.options_row
                draft[row.usize()] <- sdl_cookie_option_change(row, draft[row.usize()], -1 if key == SDLTaskKeys::LEFT else 1)
                if row == 0:
                    sdl_cookie_preview(draft)
            return 1

def sdl_cookie_options_click(handle: i64, x: f32, y: f32, width: i32, height: i32) -> bool:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return false if handle <= 0
        trusted Unsafe.PointerCast:
            session: mutable heap SDLCookieThiefSession& = handle.uintptr().cast[mutable heap SDLCookieThiefSession&]
            return false if session.options_row < 0
            row: i64 = sdl_option_row(x, y, width, height, 5)
            if row >= 0:
                if row == session.options_row:
                    session.options_draft[row.usize()] <- sdl_cookie_option_change(row, session.options_draft[row.usize()], 1)
                    if row == 0:
                        sdl_cookie_preview((&session.options_draft[0]).uintptr().cast[mutable i64&])
                session.options_row <- row
            return true

def sdl_cookie_profile_create(seed: i64) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        selected: mutable i64[5] = [4, 5, 160, 800, 1]
        size: mutable i64 = 0
        if sdl_media_config(&size) is raw:
            trusted Unsafe.PointerCast:
                data: heap u8& = raw.cast[heap u8&]
                level: i64 = sdl_config_option(data, size, "COOKIE_LEVEL", 0, 4)
                trials: i64 = sdl_config_option(data, size, "COOKIE_TRIALS", 0, 5)
                beat_ms: i64 = sdl_config_option(data, size, "COOKIE_BEAT_SECONDS", 5, 160)
                selected[0] <- level if CookieThiefGame::option_allowed(0, level)
                selected[1] <- trials if CookieThiefGame::option_allowed(1, trials)
                selected[2] <- beat_ms if CookieThiefGame::option_allowed(2, beat_ms)
                set_ms: i64 = sdl_config_option(data, size, "COOKIE_SET_SECONDS", 5, 800)
                selected[3] <- set_ms if CookieThiefGame::option_allowed(3, set_ms)
                selected[4] <- sdl_config_option(data, size, "COOKIE_ADAPTIVE", 1, 1)
            SDL_free(raw)
        sdl_read_cookie_options(&selected[0])
        if malloc(size_of(SDLCookieThiefSession).usize()) is memory:
            trusted Unsafe.PointerCast:
                session: mutable heap SDLCookieThiefSession& = memory.cast[mutable heap SDLCookieThiefSession&]
                session.options_row <- -1
                CookieThiefGame::initialize(&session.run, selected[0], selected[1], selected[2], selected[3], selected[4] != 0, seed)
                return memory.uintptr().i64()
        return 0

def sdl_cookie_key(handle: i64, key: i64, now: i64) -> bool:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return false if handle <= 0
        trusted Unsafe.PointerCast:
            session: mutable heap SDLCookieThiefSession& = handle.uintptr().cast[mutable heap SDLCookieThiefSession&]
            run: mutable CookieThiefGame::Run& = &session.run
            if key == 32:
                return CookieThiefGame::start_or_next(run, now)
            return CookieThiefGame::press(run, CookieThief::GRAB) if key == 120 or key == SDLTaskKeys::UP
            return CookieThiefGame::press(run, CookieThief::LEAVE) if key == 122 or key == SDLTaskKeys::DOWN
            return CookieThiefGame::press(run, CookieThief::LUNGE) if key == 103 or key == SDLTaskKeys::RIGHT
            return false

def sdl_cookie_advance(handle: i64, now: i64):
    can Abort.Panic, Unsafe.PointerCast:
        if handle > 0:
            trusted Unsafe.PointerCast:
                session: mutable heap SDLCookieThiefSession& = handle.uintptr().cast[mutable heap SDLCookieThiefSession&]
                _ = CookieThiefGame::advance(&session.run, now)

def sdl_cookie_destroy(handle: i64):
    can Memory.Release, Unsafe.PointerCast:
        if handle > 0:
            trusted Unsafe.PointerCast:
                free(handle.uintptr().cast[heap void&])

def sdl_cookie_info(handle: i64, field: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        return -1 if handle <= 0
        trusted Unsafe.PointerCast:
            session: heap SDLCookieThiefSession& = handle.uintptr().cast[heap SDLCookieThiefSession&]
            return CookieThiefGame::info(&session.run, field)

def sdl_cookie_dump_step(handle: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            session: mutable heap SDLCookieThiefSession& = handle.uintptr().cast[mutable heap SDLCookieThiefSession&]
            run: mutable CookieThiefGame::Run& = &session.run
            if run.phase == CookieThiefGame::PHASE_SETTING or run.phase == CookieThiefGame::PHASE_RUNNING:
                return 1 if CookieThiefGame::advance(run, run.deadline) else 2
            return 1 if CookieThiefGame::start_or_next(run, run.deadline) else 2

def sdl_cookie_frame_write(dest: i64, capacity: i64, handle: i64, black: i64, width: i64, height: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        return 0 if dest <= 0 or capacity <= 0 or handle <= 0 or width <= 0 or height <= 0
        trusted Unsafe.PointerCast:
            session: heap SDLCookieThiefSession& = handle.uintptr().cast[heap SDLCookieThiefSession&]
            list: mutable Display::DisplayList = Display::DisplayList()
            if session.options_row >= 0:
                CookieThiefGame::render_options(&list, black != 0, session.options_row, (&session.options_draft[0]).uintptr().cast[i64&])
            else:
                CookieThiefGame::render(&session.run, black != 0, width.f64(), height.f64(), &list)
            encoded: darray[u8] = Display::encode_binary(&list)
            length: i64 = encoded.count.i64()
            return 0 if length <= 0 or length > capacity
            memcpy(dest.uintptr().cast[mutable void&], (&encoded[0]).cast[void&], length.usize())
            return length

export fn nw_cookie_thief_info(handle: i64, field: i64) -> i64 = sdl_cookie_info
