# The options use the same reference-space rows as other SDL task menus.
def sdl_media_option_allowed(recognition: bool, row: i64, value: i64) -> bool:
    can Abort.Panic:
        if row == 1 or row == (5 if recognition else 4):
            return value == 0 or value == 1
        if recognition:
            return RecognitionGame::allowed_trials(value) if row == 0
            return RecognitionGame::allowed_repeat_percent(value) if row == 2
            return RecognitionGame::allowed_lag(value) if row == 3
            return RecognitionGame::allowed_study(value)
        return ConcentrationGame::allowed_pairs(value) if row == 0
        return ConcentrationGame::allowed_peek(value) if row == 2
        return ConcentrationGame::allowed_hide(value)

def sdl_media_option_change(recognition: bool, row: i64, value: i64, direction: i64) -> i64:
    can Abort.Panic:
        candidate: mutable i64 = value
        while true |candidate, recognition, row, direction|:
            candidate <- (candidate + direction + 5001) % 5001
            return candidate if sdl_media_option_allowed(recognition, row, candidate)
        return value

def sdl_media_options_click(selected: i64, draft: mutable i64&, recognition: bool, nx: i64, ny: i64) -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        x: f32 = nx.f32() * 912.0.f32() / 1000000.0.f32()
        y: f32 = 684.0.f32() - ny.f32() * 684.0.f32() / 1000000.0.f32()
        row: i64 = sdl_option_row(x, y, 912.i32(), 684.i32(), 6 if recognition else 5)
        return selected if row < 0
        if row == selected:
            draft[row.usize()] <- sdl_media_option_change(recognition, row, draft[row.usize()], 1)
        return row

def sdl_media_options_move(selected: i64, draft: mutable i64&, recognition: bool, key: i64) -> i64:
    can Abort.Panic:
        count: i64 = 6 if recognition else 5
        return -1 if key == 27
        return (selected + count - 1) % count if key == SDLTaskKeys::UP
        return (selected + 1) % count if key == SDLTaskKeys::DOWN
        if key == SDLTaskKeys::LEFT or key == SDLTaskKeys::RIGHT or key == 32:
            draft[selected.usize()] <- sdl_media_option_change(recognition, selected, draft[selected.usize()],
                -1 if key == SDLTaskKeys::LEFT else 1)
        return selected

def sdl_concentration_options_key(handle: i64, key: i64, from_hub: bool = false) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Global.Write, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap ConcentrationGame::ConcentrationRun& = handle.uintptr().cast[mutable heap ConcentrationGame::ConcentrationRun&]
            draft: mutable i64& = (&run.options_draft[0]).uintptr().cast[mutable i64&]
            close_hub: bool = run.options_from_hub and (key == 13 or key == 27)
            if run.options_row < 0:
                return 0 if key != 99 and key != 111
                draft[0] <- run.pairs
                draft[1] <- run.medium
                draft[2] <- run.peek_ms
                draft[3] <- run.hide_ms
                draft[4] <- 1 if run.show_turns else 0
                run.options_from_hub <- from_hub
                run.options_row <- 0
            elif key == 13:
                media: bool = run.media_enabled or draft[1] != run.medium
                for row in 0..<5 |row, draft|:
                    sdl_concentration_choices[row.usize()] <- draft[row.usize()]
                sdl_concentration_choices[1] <- -1 if not media
                if not sdl_save_media_settings(false, draft, draft[1] if media else -1):
                    SDL_Log("Could not save Concentration options")
                sdl_release_task_media(run.media_files, run.sound_voice)
                ConcentrationGame::configure(run, draft[0], draft[1], draft[2], draft[3], draft[4] != 0, run.coach)
                run.media_enabled <- media
            else:
                run.options_row <- sdl_media_options_move(run.options_row, draft, false, key)
            return 2 if close_hub else 1

def sdl_recognition_options_key(handle: i64, key: i64, from_hub: bool = false) -> i64:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Global.Write, Abort.Panic, Unsafe.PointerCast:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            run: mutable heap RecognitionGame::RecognitionRun& = handle.uintptr().cast[mutable heap RecognitionGame::RecognitionRun&]
            draft: mutable i64& = (&run.options_draft[0]).uintptr().cast[mutable i64&]
            close_hub: bool = run.options_from_hub and (key == 13 or key == 27)
            if run.options_row < 0:
                return 0 if key != 99 and key != 111
                draft[0] <- run.total_trials
                draft[1] <- run.medium
                draft[2] <- run.repeat_percent
                draft[3] <- run.min_lag
                draft[4] <- run.study_ms
                draft[5] <- 1 if run.feedback else 0
                run.options_from_hub <- from_hub
                run.options_row <- 0
            elif key == 13:
                media: bool = run.media_enabled or draft[1] != run.medium
                for row in 0..<6 |row, draft|:
                    sdl_recognition_choices[row.usize()] <- draft[row.usize()]
                sdl_recognition_choices[1] <- -1 if not media
                if not sdl_save_media_settings(true, draft, draft[1] if media else -1):
                    SDL_Log("Could not save Recognition options")
                sdl_release_task_media(run.media_files, run.sound_voice)
                RecognitionGame::configure(run, draft[0], draft[1], draft[2], draft[3], draft[4], draft[5] != 0)
                run.media_enabled <- media
            else:
                run.options_row <- sdl_media_options_move(run.options_row, draft, true, key)
            return 2 if close_hub else 1

def sdl_media_option_label(recognition: bool, row: i64) -> cstr:
    return "Items per run" if recognition and row == 0
    return "Pairs on the board" if row == 0
    return "Present" if recognition and row == 1
    return "Cards show" if row == 1
    return "Share of items repeated" if recognition and row == 2
    return "Smallest gap before a repeat" if recognition and row == 3
    return "Hide the image after" if recognition and row == 4
    return "Say whether each answer was right" if recognition
    return "Reveal the board at the start for" if row == 2
    return "A wrong pair stays up for" if row == 3
    return "Count pairs and turns"

def sdl_media_options_frame(list: mutable Display::DisplayList&, black: bool, recognition: bool, selected: i64, draft: i64&):
    can Memory.Allocate, Abort.Panic:
        back: u32 = Display::rgba(0, 0, 0, 255) if black else Display::rgba(255, 255, 255, 255)
        panel: u32 = Display::rgba(23, 26, 32, 255) if black else Display::rgba(246, 247, 249, 255)
        highlight: u32 = Display::rgba(42, 48, 58, 255) if black else Display::rgba(226, 231, 239, 255)
        ink: u32 = Display::rgba(232, 235, 240, 255) if black else Display::rgba(32, 36, 42, 255)
        Display::draw_rect(list, 0.0, 0.0, 912.0, 684.0, back)
        Display::draw_rect(list, 62.0, 72.0, 788.0, 540.0, panel)
        title: sview = sview("Seen it before? options", 0, -1) if recognition else sview("Concentration options", 0, -1)
        Display::draw_text_weight(list, title, 456.0, 558.0, 24.0, ink, Display::ANCHOR_CENTER_CENTER, true)
        rows: i64 = 6 if recognition else 5
        for row in 0..<rows |row, rows, list, recognition, selected, draft, highlight, ink|:
            y: f64 = 474.0 - row.f64() * 48.0
            if row == selected:
                Display::draw_rect(list, 102.0, y - 18.0, 708.0, 36.0, highlight)
            label: sview = sview(sdl_media_option_label(recognition, row), 0, -1)
            Display::draw_text_weight(list, label, 132.0, y, 16.0, ink, Display::ANCHOR_LEFT_CENTER, false)
            value: mutable dstr = []
            choice: i64 = draft[row.usize()]
            if row == 1:
                dstr_append_cstr(&value, "Sound" if choice == 1 else "Image")
            elif row == rows - 1:
                dstr_append_cstr(&value, "Yes" if choice == 1 else "No")
            else:
                dstr_append_i64(&value, choice)
                if recognition and row == 2:
                    dstr_append_cstr(&value, "%")
                elif recognition and row == 3:
                    dstr_append_cstr(&value, " items")
                elif row != 0:
                    dstr_append_cstr(&value, " ms")
            Display::draw_text_weight(list, bytes_view(value), 780.0, y, 16.0, ink, Display::ANCHOR_RIGHT_CENTER, true)
        Display::draw_text_weight(list, sview("Esc: cancel    Left/Right or Space: change    Enter: apply", 0, -1),
            456.0, 92.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER, false)
