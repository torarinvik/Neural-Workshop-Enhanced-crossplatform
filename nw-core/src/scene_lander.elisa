include "./tasks/lander_game.elisa"
include "./display.elisa"
include "./scene_verdict.elisa"

module SceneLander:
    const CX: f64 = 456.0
    const HEIGHT: f64 = 389.0
    const SCALE: f64 = HEIGHT / Lander::HEIGHT
    const WIDTH: f64 = Lander::WIDTH * SCALE
    const LEFT: f64 = CX - WIDTH / 2.0
    const BOTTOM: f64 = 179.0
    const INK: u32 = 0xe6e8f0ff
    const CRAFT: u32 = 0xe2e4ecff

    def screen(x: f64, y: f64) -> Lander::Point:
        return Lander::Point{x: LEFT + x * SCALE, y: BOTTOM + y * SCALE}

    def terrain(list: mutable Display::DisplayList&, flight: Lander::Flight&, time: f64):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, LEFT, BOTTOM, WIDTH, HEIGHT, 0x10121eff)
            for i in 1..<flight.count |list, flight|:
                a: Lander::Point = flight.ground[(i - 1).usize()]
                b: Lander::Point = flight.ground[i.usize()]
                start: Lander::Point = screen(a.x, a.y)
                end: Lander::Point = screen(b.x, b.y)
                Display::begin_polygon(list, 4, start.x, BOTTOM, 0x6e6860ff)
                Display::polygon_point(list, start.x, BOTTOM)
                Display::polygon_point(list, start.x, start.y)
                Display::polygon_point(list, end.x, end.y)
                Display::polygon_point(list, end.x, BOTTOM)
            pad: Lander::Point = screen(Lander::pad_centre(flight, time) - flight.level.pad / 2.0, flight.pad_y - 0.6)
            Display::draw_rect(list, pad.x, pad.y, flight.level.pad * SCALE, 0.6 * SCALE, 0xf0c83cff)

    def hull_point(craft: Lander::Craft&, dx: f64, dy: f64) -> Lander::Point:
        c: f64 = cos(craft.angle)
        s: f64 = sin(craft.angle)
        return screen((craft.x + dx * c) - dy * s, (craft.y + dx * s) + dy * c)

    def draw_craft(list: mutable Display::DisplayList&, craft: Lander::Craft&):
        can Memory.Allocate, Abort.Panic:
            a: Lander::Point = hull_point(craft, -Lander::HALF_W * 0.7, 0.8)
            b: Lander::Point = hull_point(craft, Lander::HALF_W * 0.7, 0.8)
            c: Lander::Point = hull_point(craft, Lander::HALF_W * 0.5, Lander::HIGH)
            d: Lander::Point = hull_point(craft, -Lander::HALF_W * 0.5, Lander::HIGH)
            Display::begin_polygon(list, 4, a.x, a.y, CRAFT)
            Display::polygon_point(list, a.x, a.y)
            Display::polygon_point(list, b.x, b.y)
            Display::polygon_point(list, c.x, c.y)
            Display::polygon_point(list, d.x, d.y)
            for side in 0..<2 |list, craft|:
                dx: f64 = Lander::HALF_W if side == 1 else -Lander::HALF_W
                leg: Lander::Point = hull_point(craft, dx * 0.5, 0.9)
                foot: Lander::Point = hull_point(craft, dx, 0.0)
                Display::draw_line(list, leg.x, leg.y, foot.x, foot.y, Lander::maximum(1.5, SCALE * 0.25), CRAFT)
            if craft.firing:
                l: Lander::Point = hull_point(craft, -0.5, 0.8)
                r: Lander::Point = hull_point(craft, 0.5, 0.8)
                end: Lander::Point = hull_point(craft, 0.0, -1.6)
                Display::draw_triangle(list, l.x, l.y, r.x, r.y, end.x, end.y, 0xff8c28ff)

    def speed_label(list: mutable Display::DisplayList&, label: cstr, value: f64, limit: f64, x: f64, y: f64):
        can Memory.Allocate, Abort.Panic:
            text: mutable dstr = []
            dstr_append_cstr(&text, label)
            dstr_append_fixed(&text, value, 1)
            dstr_append_cstr(&text, " / ")
            dstr_append_fixed(&text, limit, 1)
            Display::draw_text(list, bytes_view(text), x, y, 12.0, INK, Display::ANCHOR_LEFT_CENTER)

    def instruments(list: mutable Display::DisplayList&, craft: Lander::Craft&):
        can Memory.Allocate, Abort.Panic:
            flight: Lander::Flight& = &craft.flight
            pos: Lander::Point = screen(1.5, Lander::HEIGHT - 2.0)
            speed_label(list, "down ", -craft.vy, flight.level.max_down, pos.x, pos.y)
            across: f64 = Lander::magnitude(craft.vx - Lander::pad_speed(flight, craft.time))
            speed_label(list, "across ", across, flight.level.max_across, pos.x, pos.y - 21.6)
            tilt: mutable dstr = []
            dstr_append_cstr(&tilt, "tilt ")
            dstr_append_i64(&tilt, Lander::degrees(craft.angle))
            dstr_append_cstr(&tilt, " / ")
            dstr_append_i64(&tilt, Lander::degrees(flight.level.max_tilt))
            Display::draw_text(list, bytes_view(tilt), pos.x, pos.y - 43.2, 12.0, INK, Display::ANCHOR_LEFT_CENTER)
            fuel: mutable dstr = []
            if flight.level.fuel < 0.0:
                dstr_append_cstr(&fuel, "fuel unlimited")
            else:
                dstr_append_cstr(&fuel, "fuel ")
                dstr_append_fixed(&fuel, craft.fuel, 1)
                dstr_append_cstr(&fuel, " s")
            Display::draw_text(list, bytes_view(fuel), pos.x, pos.y - 64.8, 12.0, INK, Display::ANCHOR_LEFT_CENTER)
            if flight.level.wind != 0.0:
                wind: Lander::Point = screen(Lander::WIDTH - 10.0, Lander::HEIGHT - 4.0)
                length: f64 = Lander::wind_at(flight, craft.time) * SCALE * 14.0
                Display::draw_line(list, wind.x, wind.y, wind.x + length, wind.y, 3.0, 0x8cc8ffff)
                Display::draw_text(list, "wind", wind.x, wind.y - 16.8, 12.0, INK, Display::ANCHOR_CENTER_CENTER)

    def paint_trial(list: mutable Display::DisplayList&, craft: Lander::Craft&):
        can Memory.Allocate, Abort.Panic:
            terrain(list, &craft.flight, craft.time)
            draw_craft(list, craft)
            instruments(list, craft)

    def render(list: mutable Display::DisplayList&, session: LanderGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Lander", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Up: fire   Left / Right: turn   Esc: menu",
                CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            msg: mutable dstr = []
            if session.phase == LanderGame::READY:
                dstr_append_cstr(&msg, "Press Space or click to start")
            elif session.phase == LanderGame::DONE:
                dstr_append_i64(&msg, session.passed_count)
                dstr_append_cstr(&msg, " of ")
                dstr_append_i64(&msg, session.trial)
                dstr_append_cstr(&msg, " passed   highest rung passed ")
                dstr_append_i64(&msg, session.best_rung)
            elif session.phase == LanderGame::JUDGED:
                Lander::result_text(&session.run, &msg)
            else:
                dstr_append_cstr(&msg, "Land on the pad: gently, upright")
            Display::draw_text(list, bytes_view(msg), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if session.phase >= LanderGame::JUDGED and session.run.result != Lander::PENDING:
                verdict: mutable dstr = []
                Lander::result_text(&session.run, &verdict)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.run.result == Lander::LANDED, bytes_view(verdict), 60.0, 16.0)
            return if session.phase == LanderGame::READY or session.phase == LanderGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, session.run.time.i64())
            dstr_append_cstr(&facts, " s")
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            paint_trial(list, &session.run)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Lander::Grade = Lander::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": a ")
            dstr_append_i64(out, level.pad.i64())
            dstr_append_cstr(out, " m pad; down ")
            dstr_append_fixed(out, level.max_down, 1)
            dstr_append_cstr(out, ", across ")
            dstr_append_fixed(out, level.max_across, 1)
            dstr_append_cstr(out, " m/s, tilt ")
            dstr_append_i64(out, Lander::degrees(level.max_tilt))
            dstr_append_cstr(out, " degrees at most.  ")
            if level.fuel < 0.0:
                dstr_append_cstr(out, "Unlimited fuel.")
            else:
                dstr_append_cstr(out, "Fuel ")
                dstr_append_i64(out, level.fuel.i64())
                dstr_append_cstr(out, " s.")
            if level.rough:
                dstr_append_cstr(out, "  With rough ground")
                if level.wind != 0.0:
                    dstr_append_cstr(out, ", gusts" if level.gusts else ", wind")
                if level.hidden:
                    dstr_append_cstr(out, ", hidden gravity and engine")
                if level.moving != 0.0:
                    dstr_append_cstr(out, ", a moving pad")
                dstr_append_cstr(out, ".")
