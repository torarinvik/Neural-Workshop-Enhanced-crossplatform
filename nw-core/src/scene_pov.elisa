include "./tasks/pov_game.elisa"
include "./pov_view.elisa"
include "./scene_rooms.elisa"

module ScenePointOfView:
    const LEFT: f64 = 27.36
    const WIDTH: f64 = 857.28
    const BOTTOM: f64 = 179.0
    const HEIGHT: f64 = 389.0
    const CX: f64 = 456.0
    const MAP_W: f64 = WIDTH * 0.36
    const GAP: f64 = WIDTH * 0.012
    const MAP_RING: f64 = PointOfView::TABLE * 1.5

    struct Card:
        x: f64
        y: f64
        w: f64
        h: f64

    def card(port: i64, count: i64) -> Card:
        can Abort.Panic:
            cols: i64 = 2 if count <= 4 else 3
            rows: i64 = (count + cols - 1) / cols
            area_w: f64 = WIDTH - MAP_W - GAP * 2.0
            cw: f64 = (area_w - GAP * (cols - 1).f64()) / cols.f64()
            ch: f64 = (HEIGHT - GAP * (rows - 1).f64()) / rows.f64()
            w: f64 = cw if cw < ch * 1.35 else ch * 1.35
            h: f64 = w / 1.35
            row: f64 = (port / cols).f64()
            col: f64 = (port % cols).f64()
            return Card{x: LEFT + MAP_W + GAP * 2.0 + col * (cw + GAP) + (cw - w) / 2.0,
                y: BOTTOM + HEIGHT - (row + 1.0) * ch - row * GAP + (ch - h) / 2.0, w: w, h: h}

    def hit(run: PointOfViewGame::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return PointOfViewGame::START if run.phase == PointOfViewGame::READY or run.phase == PointOfViewGame::DONE
            return -1 if run.phase != PointOfViewGame::PLAYING
            for port in 0..<run.puzzle.level.choices |run, x, y|:
                c: Card = card(port, run.puzzle.level.choices)
                return port if x >= c.x and x <= c.x + c.w and y >= c.y and y <= c.y + c.h
            return -1

    def point(x: f64, y: f64) -> RoomsView::Point:
        return RoomsView::Point{x: x, y: y}

    def polygon(list: mutable Display::DisplayList&, item: RoomsView::Polygon&, place: SceneRooms::Placement, rim: f64):
        can Memory.Allocate, Abort.Panic:
            if rim > 0.0:
                SceneRooms::polygon(list, item, place, 0x22242aff, 0.0)
            SceneRooms::polygon(list, item, place, item.colour, rim)

    def camera_mark(list: mutable Display::DisplayList&, place: SceneRooms::Placement, angle: f64):
        can Memory.Allocate, Abort.Panic:
            x: f64 = MAP_RING * cos(angle)
            z: f64 = MAP_RING * sin(angle)
            back: f64 = angle + PointOfView::PI
            spread: f64 = 22.0 * PointOfView::RADIANS
            far: f64 = MAP_RING * 0.55
            wedge: RoomsView::Point[6] = [point(x, -z),
                point(x + far * cos(back - spread), -(z + far * sin(back - spread))),
                point(x + far * cos(back + spread), -(z + far * sin(back + spread))),
                point(0.0, 0.0), point(0.0, 0.0), point(0.0, 0.0)]
            cone: RoomsView::Polygon = RoomsView::Polygon{points: wedge, count: 3, colour: 0x788cbeff, depth: 0.0, cell: -1}
            polygon(list, &cone, place, 0.0)
            body: mutable RoomsView::Polygon = RoomsView::Polygon{points: zeroed, count: 4, colour: 0x1e222cff, depth: 0.0, cell: -1}
            for i in 0..<4 |body, back, x, z|:
                a: f64 = back + i.f64() * PointOfView::PI / 2.0 + PointOfView::PI / 4.0
                body.points[i.usize()] <- point(x + 0.22 * cos(a), -(z + 0.22 * sin(a)))
            polygon(list, &body, place, 0.0)

    def map(list: mutable Display::DisplayList&, puzzle: PointOfView::Puzzle&, ink: u32):
        can Memory.Allocate, Abort.Panic:
            scale: f64 = MAP_W / (2.0 * (MAP_RING + 0.4))
            place: SceneRooms::Placement = SceneRooms::Placement{x: LEFT + MAP_W / 2.0, y: BOTTOM + HEIGHT / 2.0, scale: scale}
            t: f64 = PointOfView::TABLE
            top: RoomsView::Point[6] = [point(-t, t), point(t, t), point(t, -t), point(-t, -t), point(0.0, 0.0), point(0.0, 0.0)]
            table: RoomsView::Polygon = RoomsView::Polygon{points: top, count: 4, colour: PointOfViewView::TABLE_TOP, depth: 0.0, cell: -1}
            polygon(list, &table, place, 1.6)
            for i in 0..<puzzle.table.count |puzzle, list, place|:
                shape: mutable RoomsView::Polygon = PointOfViewView::footprint(puzzle.table.solids[i.usize()])
                for j in 0..<shape.count |shape|:
                    p: RoomsView::Point = shape.points[j.usize()]
                    shape.points[j.usize()] <- point(p.x, -p.y)
                polygon(list, &shape, place, 1.6)
            camera_mark(list, place, puzzle.target.angle)
            if puzzle.level.rung >= 20:
                label: mutable dstr = []
                dstr_append_cstr(&label, "camera height ")
                tenth: i64 = py_round_half_even(puzzle.target.eye * 10.0)
                dstr_append_i64(&label, tenth / 10)
                dstr_append_cstr(&label, ".")
                dstr_append_i64(&label, tenth % 10)
                Display::draw_text(list, bytes_view(label), place.x, BOTTOM + 4.0, 12.0, ink, Display::ANCHOR_CENTER_BOTTOM)

    def mark(run: PointOfViewGame::Run&, port: i64, ink: u32) -> u32:
        return ink if run.phase != PointOfViewGame::JUDGED
        return 0x3caa5aff if port == run.puzzle.answer
        return 0xd6403aff if port == run.chosen
        return ink

    def picture(list: mutable Display::DisplayList&, run: PointOfViewGame::Run&, port: i64, ink: u32, dark: bool):
        can Memory.Allocate, Abort.Panic:
            c: Card = card(port, run.puzzle.level.choices)
            border: u32 = mark(run, port, ink)
            Display::draw_rect(list, c.x, c.y, c.w, c.h, 0x2e323aff if dark else 0xf7f8fbff)
            Display::draw_box(list, c.x, c.y, c.w, c.h, border, 2.0 if border == ink else 5.0)
            Display::draw_rect(list, c.x + 3.0, c.y + 3.0, c.w - 6.0, c.h - 6.0, 0xe2e8f0ff)
            shapes: RoomsView::Picture = PointOfViewView::picture(&run.puzzle.table, run.puzzle.views[port.usize()])
            place: SceneRooms::Placement = SceneRooms::Placement{x: c.x + c.w / 2.0, y: c.y + c.h * 0.55, scale: c.w * 1.05}
            for i in 0..<shapes.count |shapes, list, place|:
                item: RoomsView::Polygon& = &shapes.polygons[i.usize()]
                polygon(list, item, place, 1.2)
            label: mutable dstr = []
            dstr_append_i64(&label, port + 1)
            Display::draw_text_weight(list, bytes_view(label), c.x + 8.0, c.y + c.h - 8.0,
                13.0, ink, Display::ANCHOR_LEFT_TOP, true)

    def judgement(run: PointOfViewGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            dstr_append_cstr(out, "Right: " if run.passed else "No: ")
            dstr_append_i64(out, run.puzzle.answer + 1)

    def message(run: PointOfViewGame::Run&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == PointOfViewGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif run.phase == PointOfViewGame::DONE:
                dstr_append_i64(out, run.passed_count)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, run.scored_count)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, run.best_rung)
            elif run.phase == PointOfViewGame::JUDGED:
                judgement(run, out)
            else:
                dstr_append_cstr(out, "Which picture does the camera on the map take?")

    def render(list: mutable Display::DisplayList&, run: PointOfViewGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Point of View", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "click the picture or press its number   Esc: menu", CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            status: mutable dstr = []
            message(run, &status)
            Display::draw_text(list, bytes_view(status), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if run.has_verdict:
                verdict: mutable dstr = []
                judgement(run, &verdict)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.passed, bytes_view(verdict), 60.0, 16.0)
            if run.phase == PointOfViewGame::FLAGGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, false, "Out of time", 60.0, 16.0)
            return if run.phase == PointOfViewGame::READY or run.phase == PointOfViewGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, run.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, run.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, run.total)
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            map(list, &run.puzzle, ink)
            for port in 0..<run.puzzle.level.choices |list, run, ink, dark|:
                picture(list, run, port, ink, dark)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: PointOfView::Grade = PointOfView::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.few)
            dstr_append_cstr(out, " to ")
            dstr_append_i64(out, level.most)
            dstr_append_cstr(out, " solids, ")
            dstr_append_i64(out, level.choices)
            dstr_append_cstr(out, " pictures.")
            if level.sides_only:
                dstr_append_cstr(out, "  Camera at a side.")
            else:
                dstr_append_cstr(out, "  Camera anywhere; wrong pictures ")
                dstr_append_i64(out, level.turn_min.i64())
                dstr_append_cstr(out, " to ")
                dstr_append_i64(out, level.turn_max.i64())
                dstr_append_cstr(out, " degrees round.")
            if level.mirror:
                dstr_append_cstr(out, "  One wrong picture mirrored.")
            if not level.colours:
                dstr_append_cstr(out, "  One colour for all.")
