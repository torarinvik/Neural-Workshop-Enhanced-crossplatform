include "tasks/triage_game.elisa"
include "scene_polish.elisa"

module SceneTriage:
    const LEFT: f64 = 27.36
    const WIDTH: f64 = 857.28
    const TOP: f64 = 568.0
    const BOTTOM: f64 = 179.0
    const HEIGHT: f64 = TOP - BOTTOM
    const GAP: f64 = WIDTH * 0.015
    const OPEN: u32 = 0x285adcff
    const SOLVED: u32 = 0x3caa5aff

    def card_box(count: i64, index: i64) -> SceneHiddenRule::Rect:
        columns: i64 = Triage::minimum(count, 4)
        rows: i64 = (count + columns - 1) / columns
        width: f64 = (WIDTH - GAP * (columns - 1).f64()) / columns.f64()
        height: f64 = (HEIGHT * 0.5 - GAP * (rows - 1).f64()) / rows.f64()
        return SceneHiddenRule::Rect{x: LEFT + (index % columns).f64() * (width + GAP),
            y: TOP - (index / columns + 1).f64() * height - (index / columns).f64() * GAP, w: width, h: height}

    def digit_box(length: i64, index: i64) -> SceneHiddenRule::Rect:
        height: f64 = HEIGHT * 0.44
        cell: f64 = SceneHiddenRule::minimum(WIDTH * 0.8 / (length.f64() * 1.5), height * 0.45)
        total: f64 = cell * (length.f64() + (length - 1).f64() * 0.5)
        return SceneHiddenRule::Rect{x: (912.0 - total) / 2.0 + index.f64() * cell * 1.5,
            y: BOTTOM + height * 0.45, w: cell, h: cell}

    def swap_box(digit: SceneHiddenRule::Rect&) -> SceneHiddenRule::Rect:
        return SceneHiddenRule::Rect{x: digit.x + digit.w, y: digit.y, w: digit.w * 0.5, h: digit.h}

    def done_box() -> SceneHiddenRule::Rect:
        return SceneHiddenRule::Rect{x: LEFT + WIDTH * 0.83, y: BOTTOM, w: WIDTH * 0.17, h: HEIGHT * 0.088}

    def hit(run: TriageGame::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return TriageGame::START if run.phase == TriageGame::READY or run.phase == TriageGame::FINISHED
            return -1 if run.phase != TriageGame::PLAYING
            for i in 0..<run.dealt.level.cards |run, x, y|:
                box: SceneHiddenRule::Rect = card_box(run.dealt.level.cards, i)
                return i if SceneHiddenRule::contains(&box, x, y)
            done: SceneHiddenRule::Rect = done_box()
            return TriageGame::DONE if SceneHiddenRule::contains(&done, x, y)
            if run.play.active >= 0:
                length: i64 = run.dealt.cards[run.play.active.usize()].length
                for i in 0..<(length - 1) |length, x, y|:
                    digit: SceneHiddenRule::Rect = digit_box(length, i)
                    swap: SceneHiddenRule::Rect = swap_box(&digit)
                    return TriageGame::FIRST_SWAP + i if SceneHiddenRule::contains(&swap, x, y)
            return -1

    def machine_face(list: mutable Display::DisplayList&, box: SceneHiddenRule::Rect&, index: i64, ring: u32, dark: bool):
        can Memory.Allocate, Abort.Panic:
            hues: u32[8] = [0x5676c4ff, 0x34968cff, 0xcc7a4aff, 0x8c66bcff, 0x549656ff, 0xc45c80ff, 0x687c94ff, 0xb89634ff]
            light_bodies: u32[8] = [0xf1f4faff, 0xeff7f6ff, 0xfbf4f1ff, 0xf6f3faff, 0xf1f7f1ff, 0xfaf2f5ff, 0xf3f5f6ff, 0xf9f7efff]
            dark_bodies: u32[8] = [0x2a3143ff, 0x27343fff, 0x333139ff, 0x2e3043ff, 0x2a343aff, 0x332f3eff, 0x2b313fff, 0x323438ff]
            radius: f64 = SceneHiddenRule::minimum(box.w, box.h) * 0.08
            edge: u32 = 0x424a5cff if dark else 0xd2d8e4ff
            body: u32 = dark_bodies[index.usize()] if dark else light_bodies[index.usize()]
            ScenePolish::card_face(list, box, radius, body, edge, ring, dark)
            hue: u32 = hues[index.usize()]
            header: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: box.x, y: box.y + box.h * 0.7, w: box.w, h: box.h * 0.3}
            ScenePolish::rounded(list, &header, radius, hue)
            Display::draw_rect(list, header.x, header.y, header.w, header.h * 0.5, hue)
            margin: f64 = box.w * 0.08
            screen: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: box.x + margin, y: header.y - margin * 0.7 - box.h * 0.52,
                w: box.w - 2.0 * margin, h: box.h * 0.52}
            ScenePolish::rounded(list, &screen, radius * 0.6, 0x1b1e27ff if dark else 0xdee2e7ff)

    def draw_card(list: mutable Display::DisplayList&, run: TriageGame::Run&, index: i64, dark: bool, ink: u32):
        can Memory.Allocate, Abort.Panic:
            card: Triage::Card = run.dealt.cards[index.usize()]
            box: SceneHiddenRule::Rect = card_box(run.dealt.level.cards, index)
            bit: i64 = 1 << index.u64()
            solved: bool = (run.play.solved & bit) != 0
            border: u32 = SOLVED if solved else (OPEN if index == run.play.active else 0.u32())
            machine_face(list, &box, index, border, dark)
            size: f64 = SceneHiddenRule::minimum(14.0, SceneHiddenRule::minimum(box.h * 0.16, box.w * 0.07))
            number: mutable dstr = []
            dstr_append_i64(&number, index + 1)
            SceneHiddenRule::text(list, bytes_view(number), box.x + 12.0, box.y + box.h * 0.85,
                size, 0xffffffff, Display::ANCHOR_LEFT_CENTER, true)
            title: mutable dstr = []
            dstr_append_cstr(&title, "pays ")
            dstr_append_i64(&title, card.pays)
            SceneHiddenRule::text(list, bytes_view(title), box.x + box.w / 2.0, box.y + box.h * 0.85,
                size * 1.1, 0xffffffff, Display::ANCHOR_CENTER_CENTER, true)
            row: mutable dstr = []
            if solved:
                dstr_append_cstr(&row, "solved")
            elif (run.play.turned & bit) == 0:
                dstr_append_i64(&row, card.length)
                dstr_append_cstr(&row, " digits, face down")
            else:
                for i in 0..<card.length |row, run, index|:
                    dstr_append_cstr(&row, " ") if i > 0
                    dstr_append_i64(&row, Triage::digit(run.play.rows[index.usize()], i).i64())
            screen_bottom: f64 = box.y + box.h * 0.18 - box.w * 0.056
            face_ink: u32 = SOLVED if solved else (0x788096ff if (run.play.turned & bit) == 0 else ink)
            SceneHiddenRule::text(list, bytes_view(row), box.x + box.w / 2.0, screen_bottom + box.h * 0.26,
                size * 1.15, face_ink, Display::ANCHOR_CENTER_CENTER, solved)
            if run.phase == TriageGame::JUDGED:
                cost: mutable dstr = []
                dstr_append_cstr(&cost, "cost ")
                dstr_append_i64(&cost, card.cost)
                SceneHiddenRule::text(list, bytes_view(cost), box.x + box.w / 2.0, (box.y + screen_bottom) / 2.0, size * 0.9, ink)

    def draw_active(list: mutable Display::DisplayList&, run: TriageGame::Run&, dark: bool, ink: u32):
        can Memory.Allocate, Abort.Panic:
            done: SceneHiddenRule::Rect = done_box()
            ScenePolish::card_face(list, &done, done.h * 0.3, SceneHiddenRule::blank(dark), 0.u32(), 0.u32(), dark)
            SceneHiddenRule::text(list, "Done (Enter)", done.x + done.w / 2.0, done.y + done.h * 0.55,
                SceneHiddenRule::minimum(13.0, done.h * 0.35), ink, Display::ANCHOR_CENTER_CENTER, true)
            if run.play.active < 0:
                SceneHiddenRule::text(list, "Open a card to work on it", 456.0, BOTTOM + HEIGHT * 0.264, 14.0, ink)
                return
            length: i64 = run.dealt.cards[run.play.active.usize()].length
            row: u64 = run.play.rows[run.play.active.usize()]
            for i in 0..<length |length, row, list, dark, ink|:
                box: SceneHiddenRule::Rect = digit_box(length, i)
                ScenePolish::card_face(list, &box, box.w * 0.16, 0x262b38ff if dark else 0xffffffff, OPEN, 0.u32(), dark)
                digit: mutable dstr = []
                dstr_append_i64(&digit, Triage::digit(row, i).i64())
                SceneHiddenRule::text(list, bytes_view(digit), box.x + box.w / 2.0, box.y + box.h / 2.0, box.h * 0.45, ink, Display::ANCHOR_CENTER_CENTER, true)
                if i + 1 < length:
                    swap: SceneHiddenRule::Rect = swap_box(&box)
                    button: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: swap.x + 4.0,
                        y: swap.y + swap.h * 0.3, w: swap.w - 8.0, h: swap.h * 0.4}
                    ScenePolish::rounded(list, &button, box.h * 0.2, 0x292e3aff if dark else 0xe2e6efff)
                    SceneHiddenRule::text(list, "<>", swap.x + swap.w / 2.0, box.y + box.h / 2.0,
                        box.h * 0.16, ink, Display::ANCHOR_CENTER_CENTER, true)
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "card ")
            dstr_append_i64(&facts, run.play.active + 1)
            dstr_append_cstr(&facts, ": ")
            dstr_append_i64(&facts, Triage::inversions(row, length))
            dstr_append_cstr(&facts, " swaps still to go")
            first: SceneHiddenRule::Rect = digit_box(length, 0)
            SceneHiddenRule::text(list, bytes_view(facts), 456.0, first.y - first.h * 0.35, 12.0, ink)

    def status(run: TriageGame::Run&, text: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == TriageGame::READY:
                dstr_append_cstr(text, "Press Space or click to start")
            elif run.phase == TriageGame::FINISHED:
                dstr_append_i64(text, run.passed_count)
                dstr_append_cstr(text, " of ")
                dstr_append_i64(text, run.scored_count)
                dstr_append_cstr(text, " passed   highest rung passed ")
                dstr_append_i64(text, run.best_rung)
            elif run.phase == TriageGame::JUDGED:
                dstr_append_cstr(text, "Earned ")
                dstr_append_i64(text, run.play.value)
                dstr_append_cstr(text, " against a par of ")
                SceneHiddenRule::points(text, run.par)
                dstr_append_cstr(text, "   (the best possible was ")
                dstr_append_i64(text, Triage::best(&run.dealt))
                dstr_append_cstr(text, ")")
            else:
                dstr_append_cstr(text, "Earn ")
                SceneHiddenRule::points(text, run.par)
                dstr_append_cstr(text, " or more with ")
                dstr_append_i64(text, run.dealt.budget)
                dstr_append_cstr(text, " moves")

    def option_note(level: Triage::Grade&, line: i64, note: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if line == 0:
                dstr_append_cstr(note, "Rung ")
                dstr_append_i64(note, level.rung)
                dstr_append_cstr(note, ": ")
                dstr_append_i64(note, level.cards)
                dstr_append_cstr(note, " cards of ")
                dstr_append_i64(note, level.shortest)
                dstr_append_cstr(note, " to ")
                dstr_append_i64(note, level.longest)
                dstr_append_cstr(note, " digits; the moves cover about ")
                dstr_append_i64(note, Triage::minimum(100, (level.tight * 100.0 + 0.5).i64()))
                dstr_append_cstr(note, "% of the work.")
            elif line == 1 and level.traps:
                dstr_append_cstr(note, "With pay that does not follow cost")
                if level.hidden:
                    dstr_append_cstr(note, ", face-down cards that cost a move to turn")
                dstr_append_cstr(note, ".")
            elif line == 2 and level.rung > 20:
                dstr_append_cstr(note, "You must beat the reference.")

    def render(list: mutable Display::DisplayList&, run: TriageGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = Display::rgba(255, 255, 255, 255) if dark else Display::rgba(0, 0, 0, 255)
            SceneHiddenRule::text(list, "Triage", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            message: mutable dstr = []
            status(run, &message)
            SceneHiddenRule::text(list, bytes_view(message), 456.0, 614.0, 14.0, ink)
            idle: bool = run.phase == TriageGame::READY or run.phase == TriageGame::FINISHED
            footnote: sview = "Space: start   C: options   Esc: menu" if idle else "Click a card or press 1–8   Click between digits to swap   Enter: done   Esc: menu"
            SceneHiddenRule::text(list, footnote, 456.0, 26.0, 12.0, ink)
            return if idle
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, run.rung)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, run.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, run.trials)
            dstr_append_cstr(&facts, "   moves left ")
            dstr_append_i64(&facts, run.dealt.budget - run.play.used)
            dstr_append_cstr(&facts, " of ")
            dstr_append_i64(&facts, run.dealt.budget)
            dstr_append_cstr(&facts, "   earned ")
            dstr_append_i64(&facts, run.play.value)
            dstr_append_cstr(&facts, "   par ")
            SceneHiddenRule::points(&facts, run.par)
            SceneHiddenRule::text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink)
            for i in 0..<run.dealt.level.cards |list, run, dark, ink|:
                draw_card(list, run, i, dark, ink)
            draw_active(list, run, dark, ink)
            if run.phase == TriageGame::JUDGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.passed, bytes_view(message), 60.0, 16.0)
            elif run.phase == TriageGame::FLAGGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, false, "Out of time", 60.0, 16.0)
