# The Scramble screen: game state in, display list out.
#
# Port of neural_workshop/ui/scramble.py -- the drawing, not the thinking.
#
# Seven labels and no shapes: a title, a status line, the readings count, the
# corrupted line, what has been typed, a footnote and the verdict. The two
# that carry the game -- the corrupted line and the answer -- sit at fixed
# fractions of the room between the chrome and the verdict band.
#
# `readings` is a SENTENCE about the deal rather than a fact about it: how
# many readings the letters still allow, said three different ways depending
# on how big that is, and hedged to "at least" once the grade moves spaces --
# because past that the count is measured on word boundaries the player cannot
# see, so it is a floor.
#
# Unlike Algebra's line, which says the same kind of thing, this one has NO
# thousands separator. `'%d' % count`, not `'{:,}'.format(count)`. The two
# screens were written apart and they do not agree, so a shared helper here
# would be a change to one of them.
#
# NOTE: needs elisacore_math, pymath, strings, geometry, verdict, display and
# scene_verdict included by the driver.

module SceneScramble:

    const PHASE_READY: i64 = 0
    const PHASE_READING: i64 = 1
    const PHASE_JUDGED: i64 = 2
    const PHASE_DONE: i64 = 3

    def color_mine() -> u32:
        return Display::rgba(0, 114, 178, 255)

    struct ScramblePaint:
        ink: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> ScramblePaint:
        back: i64 = 0 if black_background else 255
        fore: i64 = 255 - back
        return ScramblePaint{ink: Display::rgba(fore, fore, fore, 255),
                     width: width, height: height, sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: ScramblePaint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    def floor_of(height: f64) -> f64:
        can Abort.Panic:
            return Verdict::above_the_band(height, Geometry::from_bottom_edge(height, 52.0).f64()).f64()

    struct ScrambleLines:
        scrambled: mutable f64
        answer: mutable f64

    def lines_of(out: mutable ScrambleLines&, height: f64):
        can Abort.Panic:
            top: f64 = Geometry::from_top_edge(height, 116.0).f64()
            bottom: f64 = floor_of(height)
            room: f64 = top - bottom
            tall: f64 = room if room > 60.0 else 60.0
            out.scrambled <- bottom + tall * 0.60
            out.answer <- bottom + tall * 0.28

    # How many sentences the letters alone still allow. `floor` is whether the
    # grade moves spaces, which turns the count into a lower bound.
    def readings(out: mutable dstr&, ambiguity: f64, floor: bool):
        can Memory.Allocate, Abort.Panic:
            if ambiguity < 0.05:
                if floor:
                    dstr_append_cstr(out, "at least one reading fits the letters")
                else:
                    dstr_append_cstr(out, "one reading fits the letters")
                return
            if ambiguity < 5.0:
                # `int(round(10 ** ambiguity))` -- half to EVEN, then truncated.
                count: i64 = py_round_half_even(pow(10.0, ambiguity))
                if floor:
                    dstr_append_cstr(out, "at least ")
                    dstr_append_i64(out, count)
                    dstr_append_cstr(out, " readings fit the letters")
                else:
                    dstr_append_cstr(out, "about ")
                    dstr_append_i64(out, count)
                    dstr_append_cstr(out, " readings fit the letters")
                return
            power: i64 = py_round_half_even(ambiguity)
            if floor:
                dstr_append_cstr(out, "at least 10^")
            else:
                dstr_append_cstr(out, "about 10^")
            dstr_append_i64(out, power)
            dstr_append_cstr(out, " readings fit the letters")

    def options(list: mutable Display::DisplayList&, black: bool, selected: i64,
                level: i64, trials: i64, mistakes: bool, adaptive: bool):
        can Memory.Allocate, Abort.Panic:
            back: u32 = Display::rgba(0, 0, 0, 255) if black else Display::rgba(255, 255, 255, 255)
            panel: u32 = Display::rgba(23, 26, 32, 255) if black else Display::rgba(246, 247, 249, 255)
            highlight: u32 = Display::rgba(42, 48, 58, 255) if black else Display::rgba(226, 231, 239, 255)
            ink: u32 = Display::rgba(232, 235, 240, 255) if black else Display::rgba(32, 36, 42, 255)
            Display::draw_rect(list, 0.0, 0.0, 912.0, 684.0, back)
            Display::draw_rect(list, 62.0, 72.0, 788.0, 540.0, panel)
            Display::draw_text_weight(list, sview("Scramble options", 0, -1), 456.0, 558.0, 24.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            for row in 0..<4 |list, selected, level, trials, mistakes, adaptive, highlight, ink|:
                y: f64 = 474.0 - row.f64() * 48.0
                if row == selected: Display::draw_rect(list, 102.0, y - 18.0, 708.0, 36.0, highlight)
                label: sview = sview("Level", 0, -1) if row == 0 else sview("Lines per run", 0, -1) if row == 1 else sview("Say how many words", 0, -1) if row == 2 else sview("Climb after a right answer", 0, -1)
                Display::draw_text_weight(list, label, 132.0, y, 16.0, ink, Display::ANCHOR_LEFT_CENTER, false)
                value: mutable dstr = []
                if row == 0: dstr_append_i64(&value, level)
                elif row == 1: dstr_append_i64(&value, trials)
                elif (row == 2 and mistakes) or (row == 3 and adaptive): dstr_append_cstr(&value, "Yes")
                else: dstr_append_cstr(&value, "No")
                Display::draw_text_weight(list, bytes_view(value), 780.0, y, 16.0, ink, Display::ANCHOR_RIGHT_CENTER, true)
            Display::draw_text_weight(list, sview("Read and reconstruct the original sentence.", 0, -1), 456.0, 224.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER, false)
            Display::draw_text_weight(list, sview("Esc: cancel    Left/Right or Space: change    Enter: apply", 0, -1), 456.0, 92.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER, false)


    def render(list: mutable Display::DisplayList&, paint: ScramblePaint&, phase: i64,
               has_deal: bool, shown: sview, typed: sview, ambiguity: f64,
               moves_spaces: bool, words: i64, show_count: bool, stocked: bool,
               missing: sview, trial: i64, total_trials: i64, message: sview,
               verdict: i64, verdict_text: sview):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()
            where: mutable ScrambleLines = ScrambleLines{scrambled: 0.0, answer: 0.0}
            lines_of(&where, paint.height)
            playing: bool = has_deal and (phase == PHASE_READING or phase == PHASE_JUDGED)

            put_text(list, paint, sview("Scramble", 0, -1), middle,
                     Geometry::from_top_edge(paint.height, 34.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            # `'     '.join(parts)`, and the parts are conditional.
            status: mutable dstr = []
            dstr_append_sview(&status, message)
            if has_deal and phase == PHASE_READING:
                dstr_append_cstr(&status, "     line ")
                dstr_append_i64(&status, trial)
                dstr_append_cstr(&status, "/")
                dstr_append_i64(&status, total_trials)
                if show_count:
                    dstr_append_cstr(&status, "   ")
                    dstr_append_i64(&status, words)
                    dstr_append_cstr(&status, " words")
            if phase == PHASE_READY and not stocked:
                dstr_append_cstr(&status, "     ")
                dstr_append_sview(&status, missing)
            put_text(list, paint, bytes_view(status), middle,
                     Geometry::from_top_edge(paint.height, 64.0).f64(),
                     Geometry::calc_fontsize(paint.height, 13.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            note: mutable dstr = []
            if playing and phase == PHASE_READING:
                readings(&note, ambiguity, moves_spaces)
            put_text(list, paint, bytes_view(note), middle,
                     Geometry::from_top_edge(paint.height, 90.0).f64(),
                     Geometry::calc_fontsize(paint.height, 12.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            line: sview = shown if playing else sview("", 0, -1)
            put_text(list, paint, line, middle, where.scrambled,
                     Geometry::calc_fontsize(paint.height, 21.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            entry: mutable dstr = []
            if phase == PHASE_READING:
                dstr_append_sview(&entry, typed)
                entry.push(95.u8())
            elif phase == PHASE_JUDGED:
                dstr_append_sview(&entry, typed)
            put_text(list, paint, bytes_view(entry), middle, where.answer,
                     Geometry::calc_fontsize(paint.height, 17.0), color_mine(),
                     Display::ANCHOR_CENTER_CENTER, false)

            put_text(list, paint,
                     sview("Esc: menu   Space: start   type the line   Enter: check   O: options", 0, -1),
                     middle, Geometry::from_bottom_edge(paint.height, 24.0).f64(),
                     Geometry::calc_fontsize(paint.height, 11.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            if verdict >= 0:
                SceneVerdict::put(list, paint.width, paint.height, paint.sx, paint.sy,
                                  verdict == 1, verdict_text, 60.0, 16.0)
