include "./scene_hand.elisa"
include "./geometry.elisa"
include "./scene_verdict.elisa"
include "./tasks/cipher_abyss_game.elisa"

module SceneCipherAbyss:
    const INK: u32 = 0xe6ebfaff
    const GOLD: u32 = 0xfadc78ff
    const PAPER_INK: u32 = 0x3c3c5aff

    def point(x: f64, y: f64) -> RoomsView::Vec:
        return RoomsView::Vec{x: x, y: y, z: 1.0}

    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, color: u32):
        can Abort.Panic, Memory.Allocate:
            Display::draw_rect(list, SceneHand::x(x), SceneHand::y(y), w * SceneHand::SCALE, h * SceneHand::SCALE, color)

    def disc(list: mutable Display::DisplayList&, x: f64, y: f64, r: f64, color: u32):
        can Abort.Panic, Memory.Allocate:
            Display::draw_circle(list, SceneHand::x(x), SceneHand::y(y), r * SceneHand::SCALE, color)

    def label(list: mutable Display::DisplayList&, text: sview, x: f64, y: f64, size: f64,
              color: u32 = INK, bold: bool = false, anchor: u32 = Display::ANCHOR_CENTER_CENTER):
        can Abort.Panic, Memory.Allocate:
            Display::draw_text_weight(list, text, SceneHand::x(x), SceneHand::y(y), size * SceneHand::SCALE, color, anchor, bold)

    def symbol(list: mutable Display::DisplayList&, v: i64, x: f64, y: f64, r: f64):
        can Abort.Panic, Memory.Allocate:
            colors: u32[8] = [0xe24840ff, 0x4082e6ff, 0x46be64ff, 0xf0c83cff, 0xaa5ad2ff, 0xf58c32ff, 0x28bebeff, 0xf06eaaff]
            shadows: u32[8] = [0x882b26ff, 0x264e8aff, 0x2a723cff, 0x907824ff, 0x66367eff, 0x93541eff, 0x187272ff, 0x904266ff]
            color: u32 = colors[v.usize()]
            dark: u32 = shadows[v.usize()]
            if v == 0:
                disc(list, x, y, r, dark)
                disc(list, x, y, r - 2.0, color)
            elif v == 1:
                rect(list, x - r, y - r, 2.0 * r, 2.0 * r, dark)
                rect(list, x - r + 2.0, y - r + 2.0, 2.0 * r - 4.0, 2.0 * r - 4.0, color)
            elif v == 7:
                w: f64 = r * 0.38
                rect(list, x - r, y - w, 2.0 * r, 2.0 * w, dark)
                rect(list, x - w, y - r, 2.0 * w, 2.0 * r, dark)
                if w > 2.0:
                    rect(list, x - r + 2.0, y - w + 2.0, 2.0 * r - 4.0, 2.0 * w - 4.0, color)
                    rect(list, x - w + 2.0, y - r + 2.0, 2.0 * w - 4.0, 2.0 * r - 4.0, color)
            else:
                sides: i64 = 10 if v == 6 else v + 1
                turn: f64 = 0.0 if v == 3 else 1.5707963267948966
                for layer in 0..<(1 if v == 6 else 2) |list, v, x, y, r, color, dark, sides, turn|:
                    radius: f64 = r if v == 6 else (r + 1.5 if layer == 0 else r - 1.5)
                    pts: mutable RoomsView::Vec[32] = zeroed
                    for i in 0..<sides |pts, sides, turn, radius, v, x, y|:
                        a: f64 = turn + 6.283185307179586 * i.f64() / sides.f64()
                        reach: f64 = radius * 0.45 if v == 6 and i % 2 == 1 else radius
                        pts[i.usize()] <- point(x + reach * cos(a), y + reach * sin(a))
                    if v == 6:
                        for i in 0..<sides |list, pts, sides, color, x, y|:
                            triangle: mutable RoomsView::Vec[32] = zeroed
                            triangle[0] <- point(x, y)
                            triangle[1] <- pts[i.usize()]
                            triangle[2] <- pts[((i + 1) % sides).usize()]
                            SceneHand::polygon(list, &triangle, 3, color)
                    else:
                        SceneHand::polygon(list, &pts, sides, dark if layer == 0 else color)

    def row(list: mutable Display::DisplayList&, values: darray[i64]&, x: f64, y: f64, r: f64, gap: f64,
            count: i64, numbers: bool = false):
        can Abort.Panic, Memory.Allocate:
            for i in 0..<CipherAbyss::min(count, values.count.i64()) |list, values, x, y, r, gap, numbers|:
                at: f64 = x + i.f64() * gap
                v: i64 = values[i.usize()]
                symbol(list, v, at, y, r)
                if numbers:
                    SceneHand::number(list, v, point(at, y - r - 4.0), 6.0, 0x46465aff)

    def button(list: mutable Display::DisplayList&, text: sview, x: f64, active: bool):
        can Abort.Panic, Memory.Allocate:
            rect(list, x - 42.0, 38.0, 84.0, 48.0, 0x2a3042ff if active else 0x1a1c24ff)
            rect(list, x - 40.0, 40.0, 80.0, 44.0, 0x46506eff if active else 0x2c2e3cff)
            label(list, text, x, CipherAbyss::PAL_Y, 12.0, INK if active else 0xe6ebfa78, true)

    def bench(list: mutable Display::DisplayList&, run: CipherAbyss::Run&, count: i64):
        can Abort.Panic, Memory.Allocate:
            for i in 0..<run.machine.level.symbols |list|:
                x: f64 = CipherAbyss::pal_x(i)
                rect(list, x - 32.0, 32.0, 64.0, 60.0, 0x2c2e3cff)
                symbol(list, i, x, 66.0, 17.0)
                SceneHand::number(list, i, point(x + 24.0, 42.0), 9.0, 0xdcdce6e6)
            button(list, "DELETE", 680.0, run.entry.count > 0.usize())
            button(list, "ANSWER" if run.testing else "RUN", 780.0, run.entry.count.i64() == count)
            button(list, "TEST ME", 880.0, not run.testing)
            for i in 0..<count |list, run, count|:
                x: f64 = CipherAbyss::slot_x(i, count)
                h: f64 = fmin(24.0, 190.0 / count.f64())
                rect(list, x - h, 128.0, 2.0 * h, 44.0, 0x24283cff)
                rect(list, x - h + 2.0, 130.0, 2.0 * h - 4.0, 40.0, 0x181a28ff)
                if i < run.entry.count.i64():
                    v: i64 = run.entry[i.usize()]
                    symbol(list, v, x, 150.0, fmin(16.0, h * 0.7))
                    if run.numbers:
                        SceneHand::number(list, v, point(x + h - 7.0, 136.0), 7.0, 0xe6e6f0e6)
            rect(list, 378.0, 136.0, 104.0, 28.0, 0x5a7850ff if run.predicting else 0x2c2e3cff)
            text: sview = "your guess" if run.pending.count > 0.usize() else ("PREDICT: on" if run.predicting else "PREDICT: off")
            label(list, text, 430.0, 150.0, 9.0, INK, true)

    def shown(run: CipherAbyss::Run&) -> i64:
        return ((run.time - run.shown_at) / 0.16).i64() + 1

    def experiments_left(list: mutable Display::DisplayList&, run: CipherAbyss::Run&, x: f64, y: f64, size: f64):
        can Abort.Panic, Memory.Allocate:
            text: mutable dstr = []
            dstr_append_i64(&text, CipherAbyss::left(run))
            dstr_append_cstr(&text, " experiments left")
            label(list, bytes_view(text), x, y, size, INK, true)

    def machine(list: mutable Display::DisplayList&, program: darray[CipherLang::Node]&, run: CipherAbyss::Run&):
        can Abort.Panic, Memory.Allocate:
            rect(list, 20.0, 452.0, 480.0, 180.0, 0x323850ff)
            rect(list, 26.0, 458.0, 468.0, 168.0, 0x464e6cff)
            busy: bool = run.time >= run.shown_at and run.time - run.shown_at < 1.28
            speed: f64 = 4.0 if busy else 1.0
            for i in 0..<3 |list, run, speed|:
                x: f64 = 70.0 + 50.0 * i.f64()
                y: f64 = 580.0 - 12.0 * (i % 2).f64()
                r: f64 = 20.0 + 5.0 * (i % 2).f64()
                a: f64 = run.time * speed * (1.2 if i % 2 == 1 else -1.0)
                for j in 0..<9 |list, x, y, r, a|:
                    b: f64 = a + 6.283185307179586 * j.f64() / 9.0
                    disc(list, x + r * cos(b), y + r * sin(b), 4.0, 0x7880a0ff)
                disc(list, x, y, r - 2.0, 0x60688cff)
                disc(list, x, y, 4.0, 0x282c3cff)
            for i in 0..<5 |list, run, busy|:
                on: bool = (run.time * (9.0 if busy else 3.0) + i.f64() * 1.7).i64() % 4 == 0
                disc(list, 50.0 + 30.0 * i.f64(), 480.0, 5.0, GOLD if on else 0x5a503cff)
            label(list, "CIPHER MACHINE", 120.0, 620.0, 9.0, 0xc8d2f0ff, true)
            q: i64 = CipherAbyss::question_index(run)
            if run.twins_q and run.result == CipherAbyss::LIVE:
                label(list, "A SECOND MACHINE:", 350.0, 612.0, 11.0, GOLD, true)
                words: mutable dstr = []
                CipherLang::write_rule_words(&words, program, run.machine.other)
                lines(list, bytes_view(words), 350.0, 584.0, 9.0, 51, 5, INK)
                lines(list, "The same as yours? S says so. If not, give an input that tells them apart, then Enter", 350.0, 511.0, 8.0, 54, 3, INK)
            elif q >= 0:
                question: CipherLang::Probe& = &run.machine.tests[q.usize()]
                title: mutable dstr = dstr_of_cstr("TEST ")
                dstr_append_i64(&title, q + 1)
                dstr_append_cstr(&title, " of ")
                dstr_append_i64(&title, run.machine.tests.count.i64())
                dstr_append_cstr(&title, ": what input gives" if run.machine.kind == CipherLang::INVERT else ": what does it give for")
                label(list, bytes_view(title), 360.0, 612.0, 9.5, GOLD, true)
                n: i64 = question.values.count.i64()
                gap: f64 = fmin(40.0, 260.0 / CipherAbyss::max(1, n).f64())
                row(list, &question.values, 350.0 - (n - 1).f64() * gap / 2.0, 575.0, fmin(14.0, gap / 2.8), gap, n)
                if n > run.machine.level.length:
                    label(list, "a longer row than any experiment!", 350.0, 520.0, 9.0, 0xfaa078ff, true)
                label(list, "(the machine starts afresh for the test)", 350.0, 538.0, 8.0)
                label(list, "Answer in the row below, then Enter", 350.0, 482.0, 9.0)
            elif run.log.count > 0.usize() and run.result == CipherAbyss::LIVE:
                n: i64 = CipherAbyss::max(1, CipherAbyss::max(run.last.given.count.i64(), run.last.result.count.i64()))
                gap: f64 = fmin(30.0, 130.0 / n.f64())
                radius: f64 = fmin(10.0, gap / 2.8)
                row(list, &run.last.given, 270.0, 590.0, radius, gap, n)
                row(list, &run.last.result, 270.0, 556.0, radius, gap, shown(run))
                label(list, "in", 255.0 - radius, 590.0, 8.0, INK, false, Display::ANCHOR_RIGHT_CENTER)
                label(list, "out", 255.0 - radius, 556.0, 8.0, INK, false, Display::ANCHOR_RIGHT_CENTER)
                experiments_left(list, run, 380.0, 500.0, 12.0)
            else:
                experiments_left(list, run, 350.0, 560.0, 13.0)
                label(list, "Build an input below and run it", 350.0, 520.0, 9.0)

    def lines(list: mutable Display::DisplayList&, text: sview, x: f64, y: f64, size: f64,
              columns: i64, limit: i64, color: u32):
        can Abort.Panic, Memory.Allocate:
            n: i64 = sview_len(text).i64()
            start: mutable i64 = 0
            for i in 0..<limit |list, text, x, y, size, columns, limit, color, n, start|:
                break if start >= n
                stop: mutable i64 = CipherAbyss::min(n, start + columns)
                if stop < n and sview_at(text, stop.usize()) != 32.u8() and i + 1 < limit:
                    scan: mutable i64 = stop
                    while scan > start and sview_at(text, scan.usize()) != 32.u8() |text, scan, start|:
                        scan <- scan - 1
                    stop <- scan if scan > start
                part: mutable dstr = []
                for j in start..<stop |part, text|:
                    part.push(sview_at(text, j.usize()))
                if stop < n and i + 1 == limit:
                    dstr_append_cstr(&part, "...")
                label(list, bytes_view(part), x, y - i.f64() * size * 1.35, size, color)
                start <- stop
                while start < n and sview_at(text, start.usize()) == 32.u8() |start, text, n|:
                    start <- start + 1

    def form_words(form: i64) -> cstr:
        return "two steps:" if form == CipherLang::THEN2
        return "three steps:" if form == CipherLang::THEN3
        return "if ... then ... else" if form == CipherLang::IF_FORM
        return "even runs / odd runs" if form == CipherLang::ALT_FORM
        return "usually ... but one symbol throughout ..." if form == CipherLang::EXCEPT_FORM
        return "in turn, moving on when ... (2 rules)" if form == CipherLang::META2
        return "in turn, moving on when ... (3 rules)" if form == CipherLang::META3
        return "2 instruction symbols" if form == CipherLang::PROG2
        return "3 instruction symbols"

    def block_words(text: mutable dstr&, program: darray[CipherLang::Node]&, block: CipherLang::Block):
        can Abort.Panic, Memory.Allocate:
            if block.kind == CipherLang::FORM:
                dstr_append_cstr(text, form_words(block.value))
            elif block.kind == CipherLang::SYMBOL_BLOCK:
                dstr_append_cstr(text, "symbol ")
                dstr_append_i64(text, block.value)
            else:
                CipherLang::write_rule_words(text, program, block.value)

    def clipped(text: mutable dstr&, size: i64):
        can Abort.Panic, Memory.Allocate:
            if text.count.i64() > size:
                while text.count.i64() >= size |text, size|:
                    _ = text.pop()
                dstr_append_cstr(text, "…")

    def slot_words(slot: i64) -> cstr:
        return "a test" if slot == CipherLang::PREDICATE
        return "a symbol" if slot == CipherLang::SYMBOL_BLOCK
        return "a rule"

    def hypothesis(list: mutable Display::DisplayList&, program: darray[CipherLang::Node]&, run: CipherAbyss::Run&):
        can Abort.Panic, Memory.Allocate:
            label(list, "HYPOTHESIS BOARD", 30.0, 426.0, 10.0, 0xc8d2f0ff, true, Display::ANCHOR_LEFT_CENTER)
            need: darray[i64] = CipherLang::expecting(&run.board)
            complete: bool = need.count == 0.usize()
            for i in 0..<3 |list, run, complete|:
                x: f64 = 440.0 if i == 2 else 270.0 + 80.0 * i.f64()
                enabled: bool = run.board.count > 0.usize() if i == 0 else (complete and (i == 1 or run.machine.level.stage >= 4))
                rect(list, x - 37.0, 200.0, 74.0, 24.0, 0x46506eff if enabled else 0x2c2e3cff)
                text: sview = "UNDO" if i == 0 else ("CHECK" if i == 1 else ("SAME" if run.twins_q else "SUBMIT"))
                label(list, text, x, 212.0, 9.0, INK if enabled or (i == 2 and run.twins_q) else 0xe6ebfa6e, true)
            caption: mutable dstr = []
            if complete:
                dstr_append_cstr(&caption, "complete")
            else:
                dstr_append_cstr(&caption, "next: ")
                dstr_append_cstr(&caption, slot_words(need[need.count - 1.usize()]))
            label(list, bytes_view(caption), 232.0, 426.0, 8.0, GOLD, false, Display::ANCHOR_LEFT_CENTER)
            menu: darray[CipherLang::Block] = CipherLang::menu(&run.board, &run.available)
            top: i64 = CipherAbyss::max(0, run.cursor - CipherAbyss::MENU_ROWS + 1)
            for j in 0..<CipherAbyss::min(CipherAbyss::MENU_ROWS, menu.count.i64() - top) |list, program, menu, top, run|:
                y: f64 = CipherAbyss::menu_y(j)
                if top + j == run.cursor:
                    rect(list, 26.0, y - 10.0, 194.0, 20.0, 0x465078ff)
                item: CipherLang::Block = menu[(top + j).usize()]
                text: mutable dstr = []
                block_words(&text, program, item)
                clipped(&text, 30)
                label(list, bytes_view(text), 30.0, y, 8.0, GOLD if item.kind == CipherLang::FORM else INK, false, Display::ANCHOR_LEFT_CENTER)
            if menu.count.i64() > top + CipherAbyss::MENU_ROWS:
                label(list, "... more (Down)", 30.0, CipherAbyss::menu_y(CipherAbyss::MENU_ROWS) + 4.0, 7.0, 0xa0aac8ff, false, Display::ANCHOR_LEFT_CENTER)
            SceneHand::line(list, point(224.0, 220.0), point(224.0, 410.0), 1.0, 0x46506eff)
            tree(list, program, run, &need)
            if run.checked.count > 0.usize():
                record: mutable dstr = dstr_of_cstr("fits ")
                dstr_append_i64(&record, run.check_good)
                dstr_append_cstr(&record, " of ")
                dstr_append_i64(&record, run.check_total)
                dstr_append_cstr(&record, " rows")
                label(list, bytes_view(record), 360.0, 236.0, 9.0, 0x78dc8cff if run.check_good == run.check_total else 0xf07864ff, true)

    def tree(list: mutable Display::DisplayList&, program: darray[CipherLang::Node]&, run: CipherAbyss::Run&, need: darray[i64]&):
        can Abort.Panic, Memory.Allocate:
            n: i64 = run.board.count.i64()
            if n == 0:
                label(list, "Write your guess at the rule here", 236.0, 404.0, 8.0, 0x96a0beff, false, Display::ANCHOR_LEFT_CENTER)
                return
            first: i64 = CipherAbyss::max(0, n - 11)
            depths: mutable darray[i64] = [0]
            for i in 0..<n |list, program, run, depths, first|:
                block: CipherLang::Block = run.board[i.usize()]
                depth: i64 = depths.pop()
                if block.kind == CipherLang::FORM:
                    for child in 0..<CipherLang::form_size(block.value) |depths, depth|:
                        depths.push(depth + 1)
                if i >= first:
                    words: mutable dstr = []
                    block_words(&words, program, block)
                    clipped(&words, CipherAbyss::max(8, 34 - 2 * depth))
                    label(list, bytes_view(words), 232.0 + 14.0 * depth.f64(), 404.0 - 18.0 * (i - first).f64(),
                          8.0, GOLD if block.kind == CipherLang::FORM else INK, false, Display::ANCHOR_LEFT_CENTER)
            y: f64 = 404.0 - 18.0 * (n - first).f64()
            if y > 226.0 and need.count > 0.usize() and depths.count > 0.usize():
                words: mutable dstr = dstr_of_cstr("_ ")
                dstr_append_cstr(&words, slot_words(need[need.count - 1.usize()]))
                label(list, bytes_view(words), 232.0 + 14.0 * depths[depths.count - 1.usize()].f64(), y,
                      8.0, 0x96a0beff, false, Display::ANCHOR_LEFT_CENTER)

    def note_sample(run: CipherAbyss::Run&, id: i64) -> CipherLang::Sample:
        return run.log[id.usize()] if id >= 0 else run.answers[(-1 - id).usize()].sample

    def notebook(list: mutable Display::DisplayList&, run: CipherAbyss::Run&):
        can Abort.Panic, Memory.Allocate:
            rect(list, 515.0, 100.0, 475.0, 530.0, 0xe8e2ceff)
            rect(list, 515.0, 602.0, 475.0, 28.0, 0xd6ceb6ff)
            for k in 0..<(CipherAbyss::NOTE_ROWS + 1) |list|:
                y: f64 = CipherAbyss::note_y(k) + 19.0
                SceneHand::line(list, point(523.0, y), point(982.0, y), 1.0, 0xc8c4e6ff)
            label(list, "NOTEBOOK", 870.0, 616.0, 10.0, PAPER_INK, true)
            label(list, "sort: by input" if run.input_order else "sort: by time", 640.0, 616.0, 8.0, PAPER_INK)
            label(list, "numbers: on" if run.numbers else "numbers: off", 770.0, 616.0, 8.0, PAPER_INK)
            rows: darray[i64] = CipherAbyss::visible(run)
            n: mutable i64 = 1
            for id in rows:
                sample: CipherLang::Sample = note_sample(run, id)
                n <- CipherAbyss::max(n, CipherAbyss::max(sample.given.count.i64(), sample.result.count.i64()))
            size: f64 = fmin(9.0, 160.0 / (2.3 * n.f64() + 2.0))
            for j in 0..<rows.count.i64() |list, run, rows, size|:
                notebook_row(list, run, rows[rows.count - 1.usize() - j.usize()], CipherAbyss::note_y(j), size)
            total: i64 = run.log.count.i64() + run.answers.count.i64()
            if total > CipherAbyss::NOTE_ROWS:
                text: mutable dstr = []
                dstr_append_i64(&text, total)
                dstr_append_cstr(&text, " rows (PageUp/PageDown)")
                label(list, bytes_view(text), 750.0, 112.0, 7.0, PAPER_INK)

    def notebook_row(list: mutable Display::DisplayList&, run: CipherAbyss::Run&, id: i64, y: f64, size: f64):
        can Abort.Panic, Memory.Allocate:
            sample: CipherLang::Sample = note_sample(run, id)
            for mark in run.marks:
                if mark == id:
                    rect(list, 517.0, y - 17.0, 471.0, 34.0, 0xfaec96ff)
                    break
            i: i64 = id if id >= 0 else run.log.count.i64() - 1 - id
            if i < run.checked.count.i64():
                rect(list, 519.0, y - 15.0, 6.0, 30.0, 0x3caa50ff if run.checked[i.usize()] == 1 else 0xd23c32ff)
            if id < 0:
                label(list, "test", 541.0, y, 8.0, 0x288c3cff if run.answers[(-1 - id).usize()].correct else 0xc83228ff)
            else:
                SceneHand::number(list, id + 1, point(541.0, y), 8.0, 0x5a5a6eff)
            gap: f64 = 2.2 * size + 3.0
            end: f64 = 567.0 + sample.given.count.i64().f64() * gap
            row(list, &sample.given, 567.0, y, size, gap, sample.given.count.i64(), run.numbers)
            pts: mutable RoomsView::Vec[32] = zeroed
            pts[0] <- point(end + 2.0, y + 5.0)
            pts[1] <- point(end + 12.0, y)
            pts[2] <- point(end + 2.0, y - 5.0)
            SceneHand::polygon(list, &pts, 3, 0x5a5a6eff)
            count: i64 = sample.result.count.i64()
            revealed: i64 = CipherAbyss::min(count, shown(run)) if id >= 0 and id + 1 == run.log.count.i64() else count
            row(list, &sample.result, end + 22.0, y, size, gap, revealed, run.numbers)
            for j in 0..<revealed |list, sample, end, y, size, gap|:
                if j >= sample.given.count.i64() or sample.given[j.usize()] != sample.result[j.usize()]:
                    disc(list, end + 22.0 + j.f64() * gap, y + size + 4.0, 1.8, 0xc85a3cff)
            if id >= 0 and id < run.predictions.count.i64() and revealed == count:
                guess: CipherLang::Probe& = &run.predictions[id.usize()]
                if guess.values.count > 0.usize():
                    ok: bool = CipherLang::same_row(&guess.values, &sample.result)
                    label(list, "✓" if ok else "✗", 976.0, y, 11.0, 0x288c3cff if ok else 0xc83228ff, true)

    def guide(list: mutable Display::DisplayList&, run: CipherAbyss::Run&, count: i64):
        can Abort.Panic, Memory.Allocate:
            step: i64 = 3 if run.testing else (1 if run.entry.count.i64() == count else
                ((3 if run.log.count >= 3.usize() else 2) if run.log.count > 0.usize() and run.entry.count == 0.usize() else 0))
            pts: mutable RoomsView::Vec[32] = zeroed
            if step == 0:
                x: f64 = CipherAbyss::pal_x(run.machine.level.symbols - 1) + 40.0
                pts[0] <- point(x, 62.0)
                pts[1] <- point(x + 14.0, 71.0)
                pts[2] <- point(x + 14.0, 53.0)
                SceneHand::polygon(list, &pts, 3, GOLD)
                rect(list, x + 14.0, 50.0, 250.0, 24.0, GOLD)
                label(list, "1. click symbols to build an input", x + 139.0, 62.0, 9.0, 0x1e1e28ff, true)
                return
            x: f64 = 780.0 if step == 1 else (750.0 if step == 2 else 860.0)
            y: f64 = 450.0 if step == 2 else 108.0
            pts[0] <- point(x - 9.0, y + 16.0)
            pts[1] <- point(x + 9.0, y + 16.0)
            pts[2] <- point(x, y + 2.0)
            SceneHand::polygon(list, &pts, 3, GOLD)
            rect(list, x - 130.0, y + 16.0, 260.0, 24.0, GOLD)
            text: sview = "2. run it" if step == 1 else ("3. watch what comes out" if step == 2 else "4. when you know, take the test")
            label(list, text, x, y + 28.0, 9.0, 0x1e1e28ff, true)

    def feedback(list: mutable Display::DisplayList&, game: CipherAbyssGame::Session&):
        can Abort.Panic, Memory.Allocate:
            run: CipherAbyss::Run& = &game.run
            summary: CipherAbyss::Summary& = &game.summary
            passed: bool = CipherAbyss::won(run.result)
            rect(list, 20.0, 124.0, 480.0, 326.0, 0x181a28ff)
            label(list, "CRACKED" if passed else "NOT CRACKED", 260.0, 430.0, 14.0,
                  0x78dc8cff if passed else 0xf07864ff, true)
            description: mutable dstr = dstr_of_cstr("The machine: ")
            shown_words: i64 = CipherAbyss::min(150, summary.words.count.i64())
            for i in 0..<shown_words |description, summary|:
                description.push(summary.words[i.usize()])
            if shown_words < summary.words.count.i64():
                dstr_append_cstr(&description, "... (")
                dstr_append_i64(&description, CipherLang::size(&game.book.program, run.machine.rule))
                dstr_append_cstr(&description, " pieces in all)")
            lines(list, bytes_view(description), 260.0, 399.0, 9.0, 78, 3, INK)
            code: mutable dstr = []
            CipherLang::write_code(&code, &game.book.program, run.machine.rule)
            clipped(&code, 65)
            label(list, bytes_view(code), 260.0, 346.0, 8.0, 0xaabee6ff)
            recalled: mutable dstr = []
            CipherAbyss::recall_text(&recalled, &game.recalled)
            if recalled.count > 0.usize():
                label(list, bytes_view(recalled), 260.0, 320.0, 8.0, GOLD)
            label(list, "What each experiment told (bits)", 140.0, 300.0, 8.0)
            top: mutable f64 = 1.0
            sum: mutable f64 = 0.0
            for value in summary.bits:
                top <- fmax(top, value)
                sum <- sum + value
            for i in 0..<summary.bits.count.i64() |list, summary, top|:
                height: f64 = fmax(1.0, 70.0 * summary.bits[i.usize()] / top)
                rect(list, 40.0 + 22.0 * i.f64(), 210.0, 16.0, height, GOLD if i == summary.best else 0x6e96dcff)
                SceneHand::number(list, i + 1, point(48.0 + 22.0 * i.f64(), 200.0), 7.0, 0xc8c8dcff)
            if summary.bits.count > 0.usize():
                rate: mutable dstr = []
                dstr_append_fixed(&rate, py_round_decimal(sum / summary.bits.count.i64().f64(), 10.0), 1)
                dstr_append_cstr(&rate, " bits per experiment")
                label(list, bytes_view(rate), 140.0, 180.0, 8.0)
            stats: mutable dstr = []
            dstr_append_i64(&stats, run.log.count.i64())
            dstr_append_cstr(&stats, " experiments (a careful player: ")
            dstr_append_i64(&stats, run.machine.plan.count.i64())
            dstr_append_cstr(&stats, ")   ")
            dstr_append_fixed(&stats, run.time, 0)
            dstr_append_cstr(&stats, " s")
            label(list, bytes_view(stats), 260.0, 150.0, 8.0, 0xc8cde6ff)
            label(list, "A careful experimenter ran", 390.0, 300.0, 8.0)
            for i in 0..<CipherAbyss::min(6, run.machine.plan.count.i64()) |list, run|:
                sample: CipherLang::Probe& = &run.machine.plan[i.usize()]
                n: i64 = sample.values.count.i64()
                gap: f64 = fmin(18.0, 160.0 / CipherAbyss::max(1, n).f64())
                row(list, &sample.values, 320.0, 278.0 - 18.0 * i.f64(), fmin(6.0, gap / 2.8), gap, n)

    def play(list: mutable Display::DisplayList&, game: CipherAbyssGame::Session&, tutorial: bool):
        can Abort.Panic, Memory.Allocate, Memory.Release:
            run: CipherAbyss::Run& = &game.run
            program: darray[CipherLang::Node]& = &game.book.program
            SceneHand::card(list, 0x121422ff)
            rect(list, 0.0, 0.0, 1000.0, 124.0, 0x1c1e2eff)
            rect(list, 20.0, 190.0, 480.0, 250.0, 0x22263aff)
            machine(list, program, run)
            count: i64 = CipherAbyss::want(program, run)
            bench(list, run, count)
            hypothesis(list, program, run)
            notebook(list, run)
            if run.result != CipherAbyss::LIVE:
                feedback(list, game)
            else:
                if tutorial and run.machine.level.rung == 1:
                    guide(list, run, count)
                if run.time - run.flash_at < 2.5:
                    label(list, sview(run.flash, 0, -1), 260.0, 176.0, 11.0, GOLD, true)
            SceneHand::progress(list, &run.hand, fmax(0.0, 1.0 - run.time / run.machine.level.seconds))

    def option_note(rung: i64, text: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: CipherAbyss::Grade = CipherAbyss::grade(rung)
            dstr_append_cstr(text, "Rung ")
            dstr_append_i64(text, level.rung)
            dstr_append_cstr(text, " (")
            dstr_append_cstr(text, CipherAbyss::stage_name(level))
            dstr_append_cstr(text, "): ")
            dstr_append_i64(text, level.symbols)
            dstr_append_cstr(text, " symbols, rows of ")
            dstr_append_i64(text, level.length)
            dstr_append_cstr(text, ", ")
            dstr_append_i64(text, level.budget)
            dstr_append_cstr(text, " experiments.")

    def verdict(result: i64) -> sview:
        return "Cracked it." if result == CipherAbyss::CRACKED or result == CipherAbyss::RULE_CRACKED
        return "They differ there." if result == CipherAbyss::DIFFERENT
        return "Both give the same there." if result == CipherAbyss::SAME_THERE
        return "Yes, the same machine." if result == CipherAbyss::SAME_MACHINE
        return "No, they differ." if result == CipherAbyss::DIFFERENT_MACHINE
        return "Not the same machine." if result == CipherAbyss::WRONG_RULE
        return "Out of time." if result == CipherAbyss::TIMEOUT
        return "Wrong."

    def render(list: mutable Display::DisplayList&, game: CipherAbyssGame::Session&, dark: bool, tutorial: bool = false):
        can Abort.Panic, Memory.Allocate, Memory.Release:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "The Cipher Abyss", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "1–8 symbols   Enter run   T test   Up/Down/Space blocks   C check   S submit   P predict   Esc menu",
                456.0, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            status: mutable dstr = []
            if game.phase == CipherAbyssGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif game.phase == CipherAbyssGame::DONE:
                dstr_append_i64(&status, game.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, game.trial)
                dstr_append_cstr(&status, " cracked")
            else:
                dstr_append_cstr(&status, "What does the machine do? (")
                dstr_append_cstr(&status, CipherAbyss::stage_name(game.run.machine.level))
                dstr_append_cstr(&status, ")")
                facts: mutable dstr = dstr_of_cstr("rung ")
                dstr_append_i64(&facts, game.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, game.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, game.total)
                Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
                play(list, game, tutorial)
            Display::draw_text(list, bytes_view(status), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if game.phase == CipherAbyssGame::JUDGED:
                result: i64 = game.run.result
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, CipherAbyss::won(result), verdict(result), 60.0, 16.0)
