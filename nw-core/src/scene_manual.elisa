include "./tasks/manual_game.elisa"
include "./display.elisa"
include "./scene_verdict.elisa"
include "./verdict.elisa"
include "./geometry.elisa"
include "./textmetrics.elisa"

module SceneManual:
    # ui/manual.py's drawing: the panel on the left -- lamps and the
    # display, then rows of switches, knobs and buttons -- and the
    # procedure with Finish on the right, inside RungTask's chrome. A
    # judged round outlines every control left wrong in red.
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const PI: f64 = 3.141592653589793
    const FACE_LIGHT: u32 = 0xe2e5ebff
    const FACE_DARK: u32 = 0x32363eff
    const LAMP_GREEN: u32 = 0x3cbe5aff
    const LAMP_RED: u32 = 0xdc3c32ff
    const LAMP_OFF: u32 = 0x5a5e66ff
    const ON: u32 = 0x3c96e6ff
    const OFF: u32 = 0x969aa2ff
    const WRONG: u32 = 0xd6403aff
    const DIGIT: u32 = 0xffaa28ff
    const SCREEN: u32 = 0x141418ff
    const SLOT: u32 = 0x1e2026ff
    const DIAL: u32 = 0x464a54ff
    const RED_BUTTON: u32 = 0xb43c3cff
    const BLUE_BUTTON: u32 = 0x3c5ab4ff
    const WHITE: u32 = 0xffffffff
    const CENTRE: u32 = Display::ANCHOR_CENTER_CENTER

    struct Area:
        left: f64
        bottom: f64
        width: f64
        height: f64

    # RungTask._area: the playing area under the chrome.
    def area() -> Area:
        can Abort.Panic:
            top: f64 = Geometry::from_top_edge(HEIGHT, 116.0).f64()
            bottom: f64 = Verdict::above_the_band(HEIGHT, Geometry::from_bottom_edge(HEIGHT, 58.0).f64()).f64()
            width: f64 = WIDTH * 0.94
            return Area{left: (WIDTH - width) / 2.0, bottom: bottom, width: width, height: fmax(40.0, top - bottom)}

    def font(size: f64) -> f64:
        can Abort.Panic:
            return Geometry::calc_fontsize(HEIGHT, size)

    def panel_area(whole: Area) -> Area:
        return Area{left: whole.left, bottom: whole.bottom, width: whole.width * 0.56, height: whole.height}

    def steps_area(whole: Area) -> Area:
        panel_width: f64 = whole.width * 0.56
        return Area{left: whole.left + panel_width + whole.width * 0.03, bottom: whole.bottom,
            width: whole.width - panel_width - whole.width * 0.03, height: whole.height}

    # _rows: lamps, switches, then knobs and buttons when there are any.
    def row_count(level: Manual::Grade&) -> i64:
        return 2 + (1 if level.knobs > 0 else 0) + (1 if level.buttons > 0 else 0)

    def knob_row(level: Manual::Grade&) -> i64:
        return 2 if level.knobs > 0 else -1

    def button_row(level: Manual::Grade&) -> i64:
        return (2 + (1 if level.knobs > 0 else 0)) if level.buttons > 0 else -1

    # Row `index`'s band: its bottom and height inside the panel.
    def band(panel: Area, level: Manual::Grade&, index: i64) -> Area:
        height: f64 = panel.height / row_count(level).f64()
        return Area{left: panel.left, bottom: panel.bottom + panel.height - index.f64() * height - height, width: panel.width,
            height: height}

    def label_size(panel: Area, level: Manual::Grade&) -> f64:
        can Abort.Panic:
            return fmin(font(12.0), panel.height / row_count(level).f64() * 0.12)

    # _slots: the middle of the `slot`th of `count` equal cells.
    def slot_x(row: Area, count: i64, slot: i64) -> f64:
        cell: f64 = row.width / (count if count > 1 else 1).f64()
        return row.left + cell * (slot.f64() + 0.5)

    def switch_width(row: Area, count: i64) -> f64:
        can Abort.Panic:
            return fmin(row.height * 0.4, row.width / count.f64() * 0.5)

    def knob_radius(row: Area, count: i64) -> f64:
        can Abort.Panic:
            return fmin(row.height * 0.22, row.width / count.f64() * 0.18)

    def button_width(row: Area, count: i64) -> f64:
        can Abort.Panic:
            return fmin(row.height * 0.55, row.width / count.f64() * 0.6)

    def finish_box(steps: Area) -> Area:
        finish_width: f64 = steps.width * 0.6
        return Area{left: steps.left + steps.width - finish_width, bottom: steps.bottom, width: finish_width,
            height: steps.height * 0.12}

    def inside(box: Area, x: f64, y: f64) -> bool:
        return box.left <= x and x <= box.left + box.width and box.bottom <= y and y <= box.bottom + box.height

    # A knob's minus (way -1) or plus button.
    def turn_box(row: Area, x: f64, radius: f64, way: i64) -> Area:
        width: f64 = radius * 0.9
        return Area{left: x - width - 2.0 if way < 0 else x + 2.0, bottom: row.bottom + row.height * 0.06, width: width,
            height: row.height * 0.2}

    # _click over self.hits, in the order they were drawn: the port under
    # a press, or -1.
    def hit(session: ManualGame::Session&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return -1 if session.phase != ManualGame::PLAYING
            whole: Area = area()
            panel: Area = panel_area(whole)
            level: Manual::Grade = session.deal.level
            switches: Area = band(panel, &level, 1)
            width: f64 = switch_width(switches, level.switches)
            for slot in 0..<level.switches |switches, level, width, x, y|:
                box: Area = Area{left: slot_x(switches, level.switches, slot) - width / 2.0,
                    bottom: switches.bottom + switches.height * 0.32, width: width, height: switches.height * 0.5}
                return slot if inside(box, x, y)
            if level.knobs > 0:
                knobs: Area = band(panel, &level, knob_row(&level))
                radius: f64 = knob_radius(knobs, level.knobs)
                for slot in 0..<level.knobs |knobs, level, radius, x, y|:
                    centre: f64 = slot_x(knobs, level.knobs, slot)
                    return Manual::KNOB_PORT + 2 * slot if inside(turn_box(knobs, centre, radius, -1), x, y)
                    return Manual::KNOB_PORT + 2 * slot + 1 if inside(turn_box(knobs, centre, radius, 1), x, y)
            if level.buttons > 0:
                buttons: Area = band(panel, &level, button_row(&level))
                side: f64 = button_width(buttons, level.buttons)
                for slot in 0..<level.buttons |buttons, level, side, x, y|:
                    box: Area = Area{left: slot_x(buttons, level.buttons, slot) - side / 2.0,
                        bottom: buttons.bottom + buttons.height * 0.3, width: side, height: side * 0.8}
                    return Manual::BUTTON_PORT + slot if inside(box, x, y)
            return Manual::FINISH_PORT if inside(finish_box(steps_area(whole)), x, y)
            return -1

    def text(list: mutable Display::DisplayList&, words: sview, x: f64, y: f64, size: f64, ink: u32, bold: bool = false,
            anchor: u32 = 4):
        can Abort.Panic, Memory.Allocate:
            Display::draw_text_weight(list, words, x, y, fmax(6.0, size), ink, anchor, bold)

    # _box: a fill when `fill` is not NO_FILL, then a border.
    def box(list: mutable Display::DisplayList&, place: Area, fill: u32, edge: u32, thickness: f64 = 2.0):
        can Abort.Panic, Memory.Allocate:
            Display::draw_rect(list, place.left, place.bottom, place.width, place.height, fill) if fill != 0.u32()
            Display::draw_box(list, place.left, place.bottom, place.width, place.height, edge, thickness) if edge != 0.u32()

    def lamp_colour(colour: i64) -> u32:
        return LAMP_GREEN if colour == Manual::GREEN else (LAMP_RED if colour == Manual::RED else LAMP_OFF)

    def lamps(list: mutable Display::DisplayList&, row: Area, board: Manual::Panel&, size: f64, ink: u32):
        can Abort.Panic, Memory.Allocate:
            count: i64 = board.level.lamps + 1
            radius: f64 = fmin(row.height * 0.24, row.width / count.f64() * 0.25)
            cy: f64 = row.bottom + row.height * 0.55
            for index in 0..<board.level.lamps |list, row, board, size, ink, count, radius, cy|:
                x: f64 = slot_x(row, count, index)
                Display::draw_circle(list, x, cy, radius * 1.12, ink)
                Display::draw_circle(list, x, cy, radius, lamp_colour(Manual::lamp(board, index)))
                name: mutable dstr = []
                ManualText::lamp_name(&name, index)
                text(list, bytes_view(name), x, cy - radius - size * 1.4, size, ink)
            x: f64 = slot_x(row, count, count - 1)
            width: f64 = radius * 2.4
            height: f64 = radius * 2.2
            box(list, Area{left: x - width / 2.0, bottom: cy - height / 2.0, width: width, height: height}, SCREEN, ink)
            shown: mutable dstr = []
            dstr_append_i64(&shown, Manual::display(board))
            text(list, bytes_view(shown), x, cy, radius * 1.3, DIGIT, true)
            text(list, "display", x, cy - height / 2.0 - size * 1.4, size, ink)

    def switches(list: mutable Display::DisplayList&, row: Area, session: ManualGame::Session&, size: f64, ink: u32, judged: bool):
        can Abort.Panic, Memory.Allocate:
            count: i64 = session.deal.level.switches
            width: f64 = switch_width(row, count)
            height: f64 = row.height * 0.5
            for slot in 0..<count |list, row, session, size, ink, judged, count, width, height|:
                index: i64 = session.deal.switch_slots[slot.usize()]
                centre: f64 = slot_x(row, count, slot)
                x: f64 = centre - width / 2.0
                y: f64 = row.bottom + row.height * 0.32
                lit: bool = session.board.switches[index.usize()]
                bad: bool = judged and lit != session.wanted.switches[index.usize()]
                box(list, Area{left: x, bottom: y, width: width, height: height}, SLOT, WRONG if bad else ink, 4.0 if bad else 2.0)
                box(list, Area{left: x + 3.0, bottom: y + height * (0.55 if lit else 0.05), width: width - 6.0, height: height * 0.4},
                    ON if lit else OFF, 0.u32())
                text(list, "on" if lit else "off", centre, y + height + size * 0.9, size * 0.9, ink)
                name: mutable dstr = []
                ManualText::switch_name(&name, index)
                text(list, bytes_view(name), centre, y - size * 1.2, size, ink, true)

    def knobs(list: mutable Display::DisplayList&, row: Area, session: ManualGame::Session&, size: f64, ink: u32, judged: bool):
        can Abort.Panic, Memory.Allocate:
            count: i64 = session.deal.level.knobs
            radius: f64 = knob_radius(row, count)
            cy: f64 = row.bottom + row.height * 0.62
            for slot in 0..<count |list, row, session, size, ink, judged, count, radius, cy|:
                index: i64 = session.deal.knob_slots[slot.usize()]
                x: f64 = slot_x(row, count, slot)
                at: i64 = session.board.knobs[index.usize()]
                bad: bool = judged and at != session.wanted.knobs[index.usize()]
                Display::draw_circle(list, x, cy, radius * 1.1, WRONG if bad else ink)
                Display::draw_circle(list, x, cy, radius, DIAL)
                # 0 points left, TOP points right, over the top.
                angle: f64 = PI * (1.0 - at.f64() / Manual::TOP.f64())
                Display::draw_line(list, x, cy, x + radius * 0.9 * cos(angle), cy + radius * 0.9 * sin(angle),
                    fmax(2.0, radius * 0.15), WHITE)
                for tick in 0..<Manual::TOP + 1 |list, size, ink, x, cy, radius|:
                    turned: f64 = PI * (1.0 - tick.f64() / Manual::TOP.f64())
                    number: mutable dstr = []
                    dstr_append_i64(&number, tick)
                    text(list, bytes_view(number), x + radius * 1.45 * cos(turned), cy + radius * 1.45 * sin(turned), size * 0.75, ink)
                name: mutable dstr = []
                ManualText::knob_name(&name, index)
                text(list, bytes_view(name), x - radius * 1.9, cy, size, ink, true, Display::ANCHOR_RIGHT_CENTER)
                for way in [-1, 1] |list, row, size, ink, x, radius|:
                    place: Area = turn_box(row, x, radius, way)
                    box(list, place, 0.u32(), ink)
                    text(list, "-" if way < 0 else "+", place.left + place.width / 2.0, place.bottom + place.height / 2.0,
                        size * 1.3, ink, true)

    def buttons(list: mutable Display::DisplayList&, row: Area, session: ManualGame::Session&, size: f64, ink: u32, judged: bool):
        can Abort.Panic, Memory.Allocate:
            count: i64 = session.deal.level.buttons
            side: f64 = button_width(row, count)
            for slot in 0..<count |list, row, session, size, ink, judged, count, side|:
                index: i64 = session.deal.button_slots[slot.usize()]
                x: f64 = slot_x(row, count, slot)
                y: f64 = row.bottom + row.height * 0.3
                bad: bool = judged and session.board.presses[index.usize()] != session.wanted.presses[index.usize()]
                box(list, Area{left: x - side / 2.0, bottom: y, width: side, height: side * 0.8},
                    RED_BUTTON if index % 2 == 1 else BLUE_BUTTON, WRONG if bad else ink, 4.0 if bad else 2.0)
                name: mutable dstr = []
                ManualText::button_name(&name, index)
                text(list, bytes_view(name), x, y + side * 0.4, size * 1.1, WHITE, true)

    def panel(list: mutable Display::DisplayList&, whole: Area, session: ManualGame::Session&, ink: u32):
        can Abort.Panic, Memory.Allocate:
            place: Area = panel_area(whole)
            level: Manual::Grade = session.deal.level
            size: f64 = label_size(place, &level)
            judged: bool = session.phase == ManualGame::JUDGED
            lamps(list, band(place, &level, 0), &session.board, size, ink)
            switches(list, band(place, &level, 1), session, size, ink, judged)
            knobs(list, band(place, &level, knob_row(&level)), session, size, ink, judged) if level.knobs > 0
            buttons(list, band(place, &level, button_row(&level)), session, size, ink, judged) if level.buttons > 0

    # A multiline label's lines, anchored at their tops: paragraphs split
    # at newlines, each wrapped at the last space before the width.
    def paragraph(list: mutable Display::DisplayList&, words: sview, x: f64, top: f64, size: f64, width: f64, ink: u32):
        can Abort.Panic, Memory.Allocate:
            advance: i64 = TextMetrics::advance(size)
            leading: f64 = TextMetrics::line_height(size).f64()
            length: i64 = sview_len(words).i64()
            y: mutable f64 = top
            start: mutable i64 = 0
            space: mutable i64 = -1
            for at in 0..<length + 1 |list, words, x, size, width, ink, advance, leading, length, y, start, space|:
                byte: u8 = 10.u8() if at == length else sview_at(words, at.usize())
                if byte == 10.u8():
                    Display::draw_text(list, string_view_slice(words, start, at), x, y, size, ink, Display::ANCHOR_LEFT_TOP)
                    y <- y - leading
                    start <- at + 1
                    space <- -1
                elif byte == 32.u8():
                    space <- at
                elif space >= start and ((at - start + 1) * advance).f64() >= width:
                    Display::draw_text(list, string_view_slice(words, start, space), x, y, size, ink, Display::ANCHOR_LEFT_TOP)
                    y <- y - leading
                    start <- space + 1
                    space <- -1

    def paragraph_lines(words: sview, size: f64, width: f64) -> i64:
        can Abort.Panic:
            advance: i64 = TextMetrics::advance(size)
            length: i64 = sview_len(words).i64()
            lines: mutable i64 = 1
            start: mutable i64 = 0
            space: mutable i64 = -1
            for at in 0..<length |words, advance, length, width, lines, start, space|:
                byte: u8 = sview_at(words, at.usize())
                if byte == 10.u8():
                    lines <- lines + 1
                    start <- at + 1
                    space <- -1
                elif byte == 32.u8():
                    space <- at
                elif space >= start and ((at - start + 1) * advance).f64() >= width:
                    lines <- lines + 1
                    start <- space + 1
                    space <- -1
            return lines

    # _draw_steps: the procedure, shrunk until it fits above Finish.
    def procedure(list: mutable Display::DisplayList&, whole: Area, session: ManualGame::Session&, face: u32, ink: u32):
        can Abort.Panic, Memory.Allocate:
            place: Area = steps_area(whole)
            words: mutable dstr = []
            ManualText::procedure(&words, &session.deal)
            finish: Area = finish_box(place)
            wrap: f64 = fmax(20.0, place.width).i64().f64()
            size: mutable f64 = fmax(6.0, font(13.0))
            room: f64 = place.height - finish.height * 1.3
            while (paragraph_lines(bytes_view(words), size, wrap) * TextMetrics::line_height(size)).f64() > room and size > 7.0 |size, words, wrap, room|:
                size <- size * 0.92
            paragraph(list, bytes_view(words), place.left, place.bottom + place.height, size, wrap, ink)
            box(list, finish, face, ink)
            fitted: mutable f64 = fmax(6.0, fmin(font(14.0), finish.height * 0.35))
            wide: f64 = TextMetrics::text_width(fitted, 14).f64()
            fitted <- fitted * finish.width * 0.9 / wide if wide > finish.width * 0.9
            Display::draw_text_weight(list, "Finish (Enter)", finish.left + finish.width / 2.0, finish.bottom + finish.height / 2.0, fitted, ink,
                CENTRE, true)

    def message(session: ManualGame::Session&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if session.phase == ManualGame::READY:
                dstr_append_cstr(out, "Press Space or click to start")
            elif session.phase == ManualGame::DONE:
                dstr_append_i64(out, session.ladder.wins)
                dstr_append_cstr(out, " of ")
                dstr_append_i64(out, session.ladder.trial)
                dstr_append_cstr(out, " passed   highest rung passed ")
                dstr_append_i64(out, session.ladder.best_rung)
            elif session.phase == ManualGame::JUDGED:
                verdict_words(session, out)
            else:
                dstr_append_cstr(out, "Follow the procedure, then press Finish")

    def verdict_words(session: ManualGame::Session&, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if session.verdict == ManualGame::RIGHT:
                dstr_append_cstr(out, "Done exactly as written")
                return
            dstr_append_cstr(out, "Not as written: ")
            wrong: mutable dstr = []
            ManualText::mistakes(&wrong, &session.board, &session.wanted)
            for at in 0..<wrong.count.i64() |out, wrong|:
                out.push(wrong[at.usize()])

    # A chrome label, centred, shrunk as _fit does when wider than 96% of
    # the window.
    def fitted(list: mutable Display::DisplayList&, words: sview, y: f64, size: f64, ink: u32, bold: bool = false):
        can Abort.Panic, Memory.Allocate:
            wide: f64 = TextMetrics::text_width(size, TextMetrics::codepoints(words)).f64()
            room: f64 = WIDTH * 0.96
            shown: f64 = fmax(6.0, size * room / wide) if wide > room else size
            Display::draw_text_weight(list, words, WIDTH / 2.0, y, shown, ink, CENTRE, bold)

    def render(list: mutable Display::DisplayList&, session: ManualGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            ink: u32 = WHITE if dark else 0x000000ff
            Display::draw_text_weight(list, "Manual", WIDTH / 2.0, Geometry::from_top_edge(HEIGHT, 36.0).f64(), font(22.0), ink,
                CENTRE, true)
            status: mutable dstr = []
            message(session, &status)
            fitted(list, bytes_view(status), Geometry::from_top_edge(HEIGHT, 70.0).f64(), font(14.0), ink)
            live: bool = session.phase == ManualGame::PLAYING or session.phase == ManualGame::JUDGED
            facts: mutable dstr = []
            if live:
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.ladder.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.ladder.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.ladder.total)
                dstr_append_cstr(&facts, "   ")
                dstr_append_i64(&facts, session.deal.step_count)
                dstr_append_cstr(&facts, " steps")
                fitted(list, bytes_view(facts), Geometry::from_top_edge(HEIGHT, 96.0).f64(), font(12.0), ink)
            fitted(list, "click switches, knob - and +, and buttons   Enter: finish   Esc: menu",
                Geometry::from_bottom_edge(HEIGHT, 26.0).f64(), font(12.0), ink)
            if live:
                whole: Area = area()
                face: u32 = FACE_DARK if dark else FACE_LIGHT
                box(list, panel_area(whole), face, ink)
                panel(list, whole, session, ink)
                procedure(list, whole, session, face, ink)
            # The last verdict stays up after the run ends, as _finish
            # leaves it.
            if session.verdict != ManualGame::LIVE and (session.phase == ManualGame::JUDGED or session.phase == ManualGame::DONE):
                caption: mutable dstr = []
                verdict_words(session, &caption)
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, session.verdict == ManualGame::RIGHT, bytes_view(caption), 60.0,
                    16.0)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Manual::Grade = Manual::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.steps)
            dstr_append_cstr(out, " steps on a panel of ")
            dstr_append_i64(out, level.switches)
            dstr_append_cstr(out, " switches, ")
            dstr_append_i64(out, level.knobs)
            dstr_append_cstr(out, " knobs, ")
            dstr_append_i64(out, level.buttons)
            dstr_append_cstr(out, " buttons and ")
            dstr_append_i64(out, level.lamps)
            dstr_append_cstr(out, " lamps.")
            found: mutable i64 = 0
            for at in 0..<level.kind_count + 1 |out, level, found|:
                kind: i64 = level.kinds[at.usize()] if at < level.kind_count else -1
                shuffled: bool = level.shuffled and at == level.kind_count
                if shuffled or kind > Manual::PRESS:
                    dstr_append_cstr(out, "  With " if found == 0 else ", ")
                    dstr_append_cstr(out, feature_words(kind, shuffled))
                    found <- found + 1
            dstr_append_cstr(out, ".") if found > 0

    def feature_words(kind: i64, shuffled: bool) -> cstr:
        return "controls in shuffled order" if shuffled
        return "steps that depend on a lamp" if kind == Manual::IF
        return "counts read off the display" if kind == Manual::COUNT
        return "copying one control to another" if kind == Manual::COPY
        return "pressing until a lamp changes" if kind == Manual::UNTIL
        return "putting controls back as they started" if kind == Manual::RECALL
        return "steps that skip the next" if kind == Manual::SKIP
        return ""
