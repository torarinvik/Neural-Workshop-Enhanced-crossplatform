include "./scene_hand.elisa"
include "./geometry.elisa"
include "./scene_verdict.elisa"
include "./tasks/bartender_game.elisa"

module SceneBartender:
    def point(x: f64, y: f64) -> RoomsView::Vec:
        return RoomsView::vec(x, y, 1.0)

    def see(run: Bartender::Run&, x: f64, y: f64, z: f64) -> RoomsView::Vec:
        return HandView::see(&run.camera, RoomsView::vec(x, y, z))

    def ink(index: i64) -> u32:
        return 0xd63c36ff if index == 0
        return 0x3caa5aff if index == 1
        return 0x466edcff if index == 2
        return 0xe2a032ff if index == 3
        return 0xa05ac8ff if index == 4
        return 0x5a463cff

    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            left: f64 = fmax(0.0, x)
            bottom: f64 = fmax(0.0, y)
            width: f64 = fmin(1000.0, x + w) - left
            height: f64 = fmin(640.0, y + h) - bottom
            return if width <= 0.0 or height <= 0.0
            Display::draw_rect(list, SceneHand::x(left), SceneHand::y(bottom), width * SceneHand::SCALE, height * SceneHand::SCALE, tint)

    def disc(list: mutable Display::DisplayList&, x: f64, y: f64, radius: f64, tint: u32):
        can Abort.Panic, Memory.Allocate:
            if x < radius or y < radius or x > 1000.0 - radius or y > 640.0 - radius:
                points: mutable RoomsView::Vec[32] = zeroed
                for i in 0..<16 |points, x, y, radius|:
                    angle: f64 = 3.141592653589793 * i.f64() / 8.0
                    points[i.usize()] <- point(x + radius * cos(angle), y + radius * sin(angle))
                SceneHand::polygon(list, &points, 16, tint)
                return
            Display::draw_circle(list, SceneHand::x(x), SceneHand::y(y), fmax(1.0, radius * SceneHand::SCALE), tint)

    def quad(list: mutable Display::DisplayList&, a: RoomsView::Vec, b: RoomsView::Vec, c: RoomsView::Vec,
             d: RoomsView::Vec, tint: u32):
        can Abort.Panic, Memory.Allocate:
            return if a.z < 0.05 or b.z < 0.05 or c.z < 0.05 or d.z < 0.05
            vertices: mutable RoomsView::Vec[32] = zeroed
            vertices[0] <- a
            vertices[1] <- b
            vertices[2] <- c
            vertices[3] <- d
            SceneHand::polygon(list, &vertices, 4, tint)

    def bottle(list: mutable Display::DisplayList&, x: f64, y: f64, index: i64, size: f64):
        can Abort.Panic, Memory.Allocate:
            tint: u32 = ink(index)
            rect(list, x - 0.5 * size, y - size, size, 2.0 * size, tint)
            rect(list, x - 0.18 * size, y + size, 0.36 * size, 0.8 * size, ScenePolish::mix_rgb(0x000000ff, tint, 0.7))
            rect(list, x - 0.5 * size, y - 0.3 * size, size, 0.6 * size, 0xf0ecdcff)

    def customer(list: mutable Display::DisplayList&, run: Bartender::Run&, order: Bartender::Order&):
        can Abort.Panic, Memory.Allocate:
            x: f64 = Bartender::seat_at(order.seat)
            foot: RoomsView::Vec = see(run, x, Bartender::TOP, -0.7)
            head: RoomsView::Vec = see(run, x, Bartender::TOP + 1.0, -0.7)
            return if foot.z < 0.05 or head.z < 0.05
            width: f64 = run.camera.focal * 0.42 / foot.z
            quad(list, point(foot.x - width, foot.y), point(foot.x + width, foot.y),
                point(head.x + 0.8 * width, head.y), point(head.x - 0.8 * width, head.y), 0x5a6482ff)
            disc(list, head.x, head.y + 0.6 * width, 0.62 * width, 0xecc8aaff)
            hats: u32[5] = [0x1e1e22ff, 0xf0f0f0ff, 0x825a32ff, 0x8c8c96ff, 0x328246ff]
            tint: u32 = hats[order.hat.usize()]
            rect(list, head.x - 0.9 * width, head.y + 0.95 * width, 1.8 * width, 0.2 * width, tint)
            rect(list, head.x - 0.55 * width, head.y + 1.1 * width, 1.1 * width, 0.6 * width, tint)

    def backdrop(list: mutable Display::DisplayList&, run: Bartender::Run&):
        can Abort.Panic, Memory.Allocate:
            SceneHand::card(list, 0x1e1614ff)
            rect(list, 0.0, 0.0, 1000.0, 640.0, 0x38241eff)
            for k in 0..<12 |list|:
                rect(list, 84.0 * k.f64(), 330.0, 4.0, 310.0, 0x2e1e1aff)
            quad(list, see(run, -2.4, 1.6, -1.6), see(run, 2.2, 1.6, -1.6),
                see(run, 2.2, 1.6, -1.0), see(run, -2.4, 1.6, -1.0), 0x6e4c32ff)
            for k in 0..<run.night.level.bottles |list, run|:
                continue if run.held == k
                q: RoomsView::Vec = HandView::see(&run.camera, Bartender::bottle_at(k))
                bottle(list, q.x, q.y, k, run.camera.focal * 0.34 / q.z) if q.z >= 0.05
            for i in run.first_open..<run.night.level.customers |list, run|:
                order: Bartender::Order = run.night.orders[i.usize()]
                break if order.arrive > run.time
                customer(list, run, &order) if run.status[i.usize()] == Bartender::PENDING

    def bar(list: mutable Display::DisplayList&, run: Bartender::Run&):
        can Abort.Panic, Memory.Allocate:
            top: f64 = Bartender::TOP
            end: f64 = Bartender::END
            quad(list, see(run, -2.8, top, -0.2), see(run, end, top, -0.2),
                see(run, end, top, 1.0), see(run, -2.8, top, 1.0), 0x966038ff)
            quad(list, see(run, -2.8, top, 1.0), see(run, end, top, 1.0),
                see(run, end, 0.0, 1.0), see(run, -2.8, 0.0, 1.0), 0x603c26ff)
            a: f64 = Bartender::LEFT - 0.3
            b: f64 = Bartender::RIGHT + 0.3
            y: f64 = top + 0.005
            quad(list, see(run, a, y, 0.0), see(run, b, y, 0.0),
                see(run, b, y, 0.8), see(run, a, y, 0.8), 0xaa7446ff)
            for i in 0..<5 |list, run, top|:
                x: f64 = Bartender::seat_at(i)
                SceneHand::number(list, i + 1, see(run, x, top - 0.45, 1.0), 16.0, 0xfae6beff)
                SceneHand::line(list, see(run, x - 0.55, top + 0.01, 0.05), see(run, x + 0.55, top + 0.01, 0.05), 3.0, 0xfae6bea0)

    def glass(list: mutable Display::DisplayList&, run: Bartender::Run&):
        can Abort.Panic, Memory.Allocate:
            top: f64 = Bartender::TOP
            base: RoomsView::Vec = see(run, run.glass_x, top, 0.4)
            lip: RoomsView::Vec = see(run, run.glass_x, top + 0.6, 0.4)
            return if base.z < 0.05 or lip.z < 0.05
            wide: f64 = run.camera.focal * 0.2 / base.z
            tall: f64 = lip.y - base.y
            pewter: bool = run.night.level.pewter
            left: RoomsView::Vec = point(base.x - 0.8 * wide, base.y)
            right: RoomsView::Vec = point(base.x + 0.8 * wide, base.y)
            quad(list, left, right, point(lip.x + wide, lip.y), point(lip.x - wide, lip.y),
                0x969aa6ff if pewter else 0xd2e2ec6e)
            if not pewter and run.level_in > 0.0:
                fill: f64 = fmin(1.0, run.level_in)
                edge: f64 = (0.8 + 0.2 * fill) * wide
                y: f64 = base.y + tall * fill
                quad(list, left, right, point(base.x + edge, y), point(base.x - edge, y), ink(run.drink))
            if run.night.level.rung < 7 and not pewter:
                marks: f64[4] = [0.38, 0.62, 0.78, 1.0]
                for i in 0..<4 |list, base, wide, tall, marks|:
                    value: f64 = marks[i.usize()]
                    y: f64 = base.y + tall * value
                    SceneHand::line(list, point(base.x - wide, y), point(base.x - 0.6 * wide, y), 2.0, 0xffffffdc)
            if run.ice:
                rect(list, base.x - 0.4 * wide, lip.y - 0.3 * wide, 0.4 * wide, 0.4 * wide, 0xf0faffff)
                rect(list, base.x + 0.3 * wide, lip.y - 0.3 * wide, 0.4 * wide, 0.4 * wide, 0xf0faffff)

    def held_bottle(list: mutable Display::DisplayList&, run: Bartender::Run&):
        can Abort.Panic, Memory.Allocate:
            return if run.held < 0 or run.held == Bartender::HELD_GLASS
            bottle(list, run.hand.x, run.hand.y + 30.0, run.held, 20.0)
            q: RoomsView::Vec = HandView::see(&run.camera, Bartender::glass_at(run.glass_x))
            if q.z >= 0.05 and fabs(q.x - run.hand.x) < Bartender::OVER and fabs(q.y - run.hand.y) < Bartender::OVER:
                SceneHand::line(list, point(run.hand.x, run.hand.y + 8.0), q, 3.0, ink(run.held))

    def orders(list: mutable Display::DisplayList&, run: Bartender::Run&):
        can Abort.Panic, Memory.Allocate:
            row: mutable i64 = 0
            for i in run.first_open..<run.night.level.customers |list, run, row|:
                order: Bartender::Order = run.night.orders[i.usize()]
                break if order.arrive > run.time or row >= 4
                continue if run.status[i.usize()] != Bartender::PENDING
                y: f64 = 612.0 - 30.0 * row.f64()
                rect(list, 250.0, y - 13.0, 730.0, 26.0, 0x100e12d7)
                label: mutable dstr = []
                Bartender::order_text(&label, &order, &run.night.level)
                Display::draw_text_weight(list, bytes_view(label), SceneHand::x(262.0), SceneHand::y(y),
                    13.0 * SceneHand::SCALE, 0xffffffff, Display::ANCHOR_LEFT_CENTER, row == 0)
                share: f64 = fmax(0.0, (order.leave - run.time) / (order.leave - order.arrive))
                rect(list, 860.0, y - 4.0, 110.0 * share, 8.0, ScenePolish::mix_rgb(0xec5040ff, 0x6edc8cff, share))
                row <- row + 1
            for k in 0..<run.night.level.strikes |list, run|:
                disc(list, 40.0 + 26.0 * k.f64(), 610.0, 8.0, 0xec5040ff if k < run.strikes else 0x463832ff)
            report: mutable dstr = []
            dstr_append_i64(&report, run.served)
            dstr_append_cstr(&report, " of ")
            dstr_append_i64(&report, run.night.level.customers)
            dstr_append_cstr(&report, " served")
            SceneHand::word(list, bytes_view(report), 110.0, 580.0, 12.0, 0xf0e6dcff)

    def verdict(result: i64) -> sview:
        return "Last orders: a good night" if result == Bartender::GOOD_NIGHT
        return "Too much spilt" if result == Bartender::SPILT
        return "Too many glasses on the floor" if result == Bartender::FLOOR
        return "Too many customers walked out" if result == Bartender::WALKOUT
        return "Not everyone got their drink" if result == Bartender::UNSERVED
        return "Too many wrong drinks" if result == Bartender::WRONG_DRINK
        return "Too many drinks sent to nobody"

    def option_note(rung: i64, out: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: Bartender::Grade = Bartender::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": ")
            dstr_append_i64(out, level.customers)
            dstr_append_cstr(out, " customers, ")
            dstr_append_i64(out, level.bottles)
            dstr_append_cstr(out, " bottles.")
            dstr_append_cstr(out, "  Pour by ear.") if level.pewter
            dstr_append_cstr(out, "  Remember the usual.") if level.usual

    def render(list: mutable Display::DisplayList&, game: BartenderGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate:
            text_colour: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Bartender", 456.0, 648.0, 22.0, text_colour, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Hold a bottle over the glass: pour   Drag the glass back and let go: slide   Space: ice   Esc: menu",
                456.0, 26.0, 12.0, text_colour, Display::ANCHOR_CENTER_CENTER)
            if game.phase == BartenderGame::READY:
                Display::draw_text(list, "Press Space or click to start", 456.0, 614.0, 14.0, text_colour, Display::ANCHOR_CENTER_CENTER)
                return
            if game.phase == BartenderGame::DONE:
                report: mutable dstr = []
                dstr_append_i64(&report, game.wins)
                dstr_append_cstr(&report, " of ")
                dstr_append_i64(&report, game.trial)
                dstr_append_cstr(&report, " passed   highest rung passed ")
                dstr_append_i64(&report, game.best_rung)
                Display::draw_text(list, bytes_view(report), 456.0, 614.0, 14.0, text_colour, Display::ANCHOR_CENTER_CENTER)
                return
            run: Bartender::Run& = &game.run
            backdrop(list, run)
            bar(list, run)
            glass(list, run)
            held_bottle(list, run)
            SceneHand::progress(list, &run.hand, 0.0)
            orders(list, run)
            Display::draw_text(list, "Serve every customer before they walk out", 456.0, 614.0, 14.0, text_colour, Display::ANCHOR_CENTER_CENTER)
            facts: mutable dstr = dstr_of_cstr("rung ")
            dstr_append_i64(&facts, game.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, game.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, game.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, run.night.level.customers)
            dstr_append_cstr(&facts, " customers")
            Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, text_colour, Display::ANCHOR_CENTER_CENTER)
            if game.phase == BartenderGame::JUDGED:
                result: i64 = run.result
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, result == Bartender::GOOD_NIGHT, verdict(result), 60.0, 16.0)
