include "./tasks/stagehand_game.elisa"
include "./scene_hand.elisa"
include "./scene_verdict.elisa"

module SceneStagehand:
    const TAU: f64 = 6.283185307179586

    struct Item:
        z: f64
        prop: i64

    def shade(colour: u32, amount: f64) -> u32:
        return ScenePolish::mix_rgb(0x000000ff, colour, amount)

    def see(view: HandView::Lens&, x: f64, y: f64, z: f64) -> RoomsView::Vec:
        return HandView::see(view, RoomsView::vec(x, y, z))

    def quad(list: mutable Display::DisplayList&, a: RoomsView::Vec, b: RoomsView::Vec,
            c: RoomsView::Vec, d: RoomsView::Vec, colour: u32):
        can Memory.Allocate, Abort.Panic:
            return if a.z < 0.05 or b.z < 0.05 or c.z < 0.05 or d.z < 0.05
            points: mutable RoomsView::Vec[32] = zeroed
            points[0] <- a
            points[1] <- b
            points[2] <- c
            points[3] <- d
            SceneHand::polygon(list, &points, 4, colour)

    def disc(list: mutable Display::DisplayList&, at: RoomsView::Vec, radius: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            return if at.z < 0.05 or at.x < -radius or at.x > HandView::WIDTH + radius or at.y < -radius or at.y > HandView::HEIGHT + radius
            Display::draw_circle(list, SceneHand::x(at.x), SceneHand::y(at.y), radius * SceneHand::SCALE, colour)

    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, width: f64, height: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, SceneHand::x(x), SceneHand::y(y), width * SceneHand::SCALE, height * SceneHand::SCALE, colour)

    def floor_scene(list: mutable Display::DisplayList&, view: HandView::Lens&, run: Stagehand::Run&, bright: f64):
        can Memory.Allocate, Abort.Panic:
            back_a: RoomsView::Vec = see(view, -6.6, 0.0, -4.2)
            back_b: RoomsView::Vec = see(view, 6.6, 0.0, -4.2)
            if run.camera != 4:
                quad(list, back_a, back_b, see(view, 6.6, 5.0, -4.2), see(view, -6.6, 5.0, -4.2), shade(0x46283cff, bright))
            quad(list, back_a, back_b, see(view, 6.6, 0.0, 4.4), see(view, -6.6, 0.0, 4.4), shade(0x96704cff, bright))
            if run.camera != 4:
                reach: f64 = 2.6 if (run.on & 2) != 0 else 1.0
                for i in 0..<2 |list, view, bright, reach|:
                    side: f64 = -1.0 if i == 0 else 1.0
                    outer: f64 = side * 6.6
                    inner: f64 = side * (6.6 - reach)
                    quad(list, see(view, outer, 0.0, -4.15), see(view, inner, 0.0, -4.15),
                        see(view, inner, 5.0, -4.15), see(view, outer, 5.0, -4.15), shade(0xaa2832ff, bright))
            for i in 0..<15 |list, view|:
                p: RoomsView::Vec = Stagehand::spot_of(i)
                SceneHand::line(list, see(view, p.x - 0.25, 0.01, p.z), see(view, p.x + 0.25, 0.01, p.z), 2.0, 0xf0e6c896)
                SceneHand::line(list, see(view, p.x, 0.01, p.z - 0.25), see(view, p.x, 0.01, p.z + 0.25), 2.0, 0xf0e6c896)

    def insert(items: mutable Item[10]&, index: i64, item: Item):
        can Abort.Panic:
            at: mutable i64 = index
            while at > 0 |items, at, item|:
                previous: Item = items[(at - 1).usize()]
                break if previous.z > item.z or (previous.z == item.z and previous.prop <= item.prop)
                items[at.usize()] <- previous
                at <- at - 1
            items[at.usize()] <- item

    def prism(list: mutable Display::DisplayList&, view: HandView::Lens&, p: RoomsView::Vec, half: f64,
              base: f64, height: f64, sides: i64, colour: u32, turn: f64 = 0.0):
        can Memory.Allocate, Abort.Panic:
            ring: mutable RoomsView::Vec[10] = zeroed
            cap: mutable RoomsView::Vec[32] = zeroed
            items: mutable Item[10] = zeroed
            total: mutable i64 = 0
            for i in 0..<sides |view, p, turn, sides, half, ring, height, cap|:
                angle: f64 = turn + TAU * i.f64() / sides.f64()
                spot: RoomsView::Vec = RoomsView::vec(p.x + half * cos(angle), 0.0, p.z + half * sin(angle))
                ring[i.usize()] <- spot
                cap[i.usize()] <- see(view, spot.x, height, spot.z)
            for i in 0..<sides |view, ring, sides, base, height, items, total|:
                a: RoomsView::Vec = ring[i.usize()]
                b: RoomsView::Vec = ring[((i + 1) % sides).usize()]
                mid: RoomsView::Vec = see(view, (a.x + b.x) / 2.0, (base + height) / 2.0, (a.z + b.z) / 2.0)
                if mid.z >= 0.05:
                    insert(&items, total, Item{z: mid.z, prop: i})
                    total <- total + 1
            for i in 0..<total |list, view, ring, sides, items, base, height, colour, total|:
                index: i64 = items[i.usize()].prop
                a: RoomsView::Vec = ring[index.usize()]
                b: RoomsView::Vec = ring[((index + 1) % sides).usize()]
                scale: f64 = 0.55 + 0.45 * (i.f64() / (total - 1).f64()) if total > 1 else 0.55
                quad(list, see(view, a.x, base, a.z), see(view, b.x, base, b.z),
                    see(view, b.x, height, b.z), see(view, a.x, height, a.z), shade(colour, scale))
            SceneHand::polygon(list, &cap, sides, ScenePolish::mix_rgb(colour, 0xffffffff, 0.18))

    def legs(list: mutable Display::DisplayList&, view: HandView::Lens&, p: RoomsView::Vec, half_x: f64, half_z: f64,
             height: f64, width: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            for i in 0..<4 |list, view, p, half_x, half_z, height, width, colour|:
                x: f64 = p.x + (-half_x if i < 2 else half_x)
                z: f64 = p.z + (-half_z if i % 2 == 0 else half_z)
                SceneHand::line(list, see(view, x, 0.0, z), see(view, x, height, z), width, colour)

    def prop(list: mutable Display::DisplayList&, view: HandView::Lens&, kind: i64, p: RoomsView::Vec, bright: f64):
        can Memory.Allocate, Abort.Panic:
            if kind == 0:
                legs(list, view, p, 0.3, 0.3, 0.5, 3.0, shade(0x5a3c28ff, bright))
                prism(list, view, p, 0.45, 0.5, 0.6, 4, shade(0xaa6e3cff, bright), TAU / 8.0)
                z: f64 = p.z - 0.3
                quad(list, see(view, p.x - 0.32, 0.6, z), see(view, p.x + 0.32, 0.6, z),
                    see(view, p.x + 0.32, 1.35, z), see(view, p.x - 0.32, 1.35, z), shade(0x965f32ff, bright))
            elif kind == 1:
                legs(list, view, p, 0.55, 0.4, 0.85, 4.0, shade(0x464650ff, bright))
                prism(list, view, p, 0.85, 0.85, 0.97, 4, shade(0xc8c8d2ff, bright), TAU / 8.0)
            elif kind == 2:
                colour: u32 = shade(0x3c3c46ff, bright)
                prism(list, view, p, 0.3, 0.0, 0.08, 8, colour)
                SceneHand::line(list, see(view, p.x, 0.08, p.z), see(view, p.x, 1.7, p.z), 4.0, colour)
                prism(list, view, p, 0.42, 1.55, 2.0, 8, 0xfadc6eff)
            elif kind == 3:
                prism(list, view, p, 0.62, 0.0, 0.88, 4, shade(0xbe965aff, bright), TAU / 8.0)
            elif kind == 4:
                prism(list, view, p, 0.3, 0.0, 0.45, 6, shade(0xb45a3cff, bright))
                colour: u32 = shade(0x3ca050ff, bright)
                disc(list, see(view, p.x, 0.75, p.z), 17.0, colour)
                disc(list, see(view, p.x, 1.05, p.z), 14.0, colour)
                disc(list, see(view, p.x, 1.3, p.z), 10.0, colour)
            else:
                prism(list, view, p, 0.48, 0.0, 1.05, 10, shade(0x783c32ff, bright))

    def spotlight(list: mutable Display::DisplayList&, view: HandView::Lens&, p: RoomsView::Vec):
        can Memory.Allocate, Abort.Panic:
            pool: mutable RoomsView::Vec[32] = zeroed
            for i in 0..<16 |pool, view, p|:
                angle: f64 = TAU * i.f64() / 16.0
                pool[i.usize()] <- see(view, p.x + cos(angle), 0.02, p.z + sin(angle))
            SceneHand::polygon(list, &pool, 16, 0xfff0aa78)

    def figures(list: mutable Display::DisplayList&, view: HandView::Lens&, run: Stagehand::Run&, bright: f64):
        can Memory.Allocate, Abort.Panic:
            order: mutable Item[10] = zeroed
            total: mutable i64 = 0
            for i in -1..<run.show.level.props |view, run, order, total|:
                point: RoomsView::Vec = run.actor if i < 0 else Stagehand::place(run, i)
                depth: f64 = HandView::see(view, point).z
                if depth >= 0.05:
                    insert(&order, total, Item{z: depth, prop: i})
                    total <- total + 1
            for i in 0..<total |list, view, run, order, bright|:
                index: i64 = order[i.usize()].prop
                if index < 0:
                    actor: RoomsView::Vec = run.actor
                    prism(list, view, actor, 0.28, 0.0, 1.25, 6, shade(0x3c64c8ff, bright))
                    disc(list, see(view, actor.x, 1.5, actor.z), 9.0, shade(0xecc8aaff, bright))
                else:
                    p: RoomsView::Vec = Stagehand::place(run, index)
                    if run.lit == index:
                        spotlight(list, view, p)
                    kind: i64 = run.show.props[index.usize()]
                    prop(list, view, kind, p, bright)
                    if run.show.level.rung < 4:
                        at: RoomsView::Vec = see(view, p.x, 0.0, p.z + 0.75)
                        if at.z >= 0.05:
                            SceneHand::word(list, sview(Stagehand::prop_name(kind), 0, -1), at.x, at.y, 11.0, 0xffffffe6)

    def seat(camera: i64) -> sview:
        return "CENTRE" if camera == 0
        return "LEFT BOX" if camera == 1
        return "RIGHT BOX" if camera == 2
        return "BALCONY" if camera == 3
        return "BACKSTAGE"

    def hud(list: mutable Display::DisplayList&, run: Stagehand::Run&):
        can Memory.Allocate, Abort.Panic:
            if (run.on & 8) != 0:
                rect(list, 0.0, 0.0, 1000.0, 540.0, 0xdcdce63c)
            rect(list, 20.0, 548.0, 960.0, 80.0, 0x10121ce1)
            total: i64 = run.show.lines.count.i64()
            if run.line_no < total:
                line: Stagehand::Line = get run.show.lines[run.line_no.usize()] else zeroed
                SceneHand::word(list, bytes_view(line.text), 500.0, 602.0, 18.0, 0xffffffff, true)
                if Stagehand::open(run):
                    span: f64 = run.due - run.opens
                    share: f64 = HandView::clamp((run.due - run.time) / (span if span > 0.000001 else 0.000001), 0.0, 1.0)
                    rect(list, 250.0, 552.0, 500.0 * share, 5.0, 0xffc846ff)
            if run.line_no + 1 < total:
                following: Stagehand::Line = get run.show.lines[(run.line_no + 1).usize()] else zeroed
                text: mutable dstr = []
                dstr_append_cstr(&text, "next: ")
                dstr_append_sview(&text, bytes_view(following.text))
                SceneHand::word(list, bytes_view(text), 500.0, 572.0, 11.0, 0xaab4c8ff)
            SceneHand::word(list, seat(run.camera), 70.0, 528.0, 11.0, 0xffffffc8, true)
            counter: mutable dstr = []
            dstr_append_cstr(&counter, "line ")
            dstr_append_i64(&counter, run.line_no + 1 if run.line_no < total else total)
            dstr_append_cstr(&counter, " of ")
            dstr_append_i64(&counter, total)
            SceneHand::word(list, bytes_view(counter), 930.0, 528.0, 11.0, 0xffffffc8)

    def stage(list: mutable Display::DisplayList&, run: Stagehand::Run&):
        can Memory.Allocate, Abort.Panic:
            SceneHand::card(list, 0x16121aff)
            view: HandView::Lens = Stagehand::view(run)
            bright: f64 = 1.0 if (run.on & 1) != 0 else 0.8
            floor_scene(list, &view, run, bright)
            figures(list, &view, run, bright)
            hud(list, run)
            SceneHand::progress(list, &run.hand, (run.show.seconds - run.time) / run.show.seconds)

    def render(list: mutable Display::DisplayList&, session: StagehandGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Stagehand", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Drag: move a prop   Click: spotlight   L lights  C curtain  M music  S smoke  T thunder   Esc: menu",
                456.0, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            status: mutable dstr = []
            if session.phase == StagehandGame::READY:
                dstr_append_cstr(&status, "Could not deal a show. Press Space or click to retry." if session.deal_failed else "Press Space or click to start")
            elif session.phase == StagehandGame::DONE:
                dstr_append_i64(&status, session.passed)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best)
            elif session.phase == StagehandGame::JUDGED:
                dstr_append_sview(&status, Stagehand::result_text(session.run.result))
            else:
                dstr_append_cstr(&status, "Follow the script: left and right are the audience's")
            Display::draw_text(list, bytes_view(status), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if session.phase >= StagehandGame::JUDGED and session.run.result != Stagehand::PENDING:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.run.result == Stagehand::SUCCESS,
                    Stagehand::result_text(session.run.result), 60.0, 16.0)
            return if session.phase == StagehandGame::READY or session.phase == StagehandGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, session.run.show.level.props)
            dstr_append_cstr(&facts, " props")
            Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            stage(list, &session.run)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Stagehand::Grade = Stagehand::grade(rung)
            dstr_append_i64(out, level.lines)
            dstr_append_cstr(out, " cues and ")
            dstr_append_i64(out, level.props)
            dstr_append_cstr(out, " props.")
            if level.cameras > 1:
                dstr_append_cstr(out, " The camera changes seats during the show.")
