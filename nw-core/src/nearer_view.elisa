include "./tasks/nearer.elisa"
include "./rooms_view.elisa"

module NearerView:
    struct Shape:
        points: mutable RoomsView::Point[10]
        count: mutable i64
        colour: u32
        depth: f64
        port: i64

    struct Picture:
        shapes: mutable Shape[118]
        count: mutable i64
        boxes: mutable RoomsView::Bounds[6]
        depths: mutable f64[6]
        visible: mutable bool[6]
        front: mutable i64[6]
        visible_count: mutable i64

    def camera(level: Nearer::Grade, elapsed: f64) -> RoomsView::Camera:
        can Abort.Panic:
            return RoomsView::Camera{eye: RoomsView::vec(Nearer::eye_x(level, elapsed), Nearer::EYE_Y, 0.0),
                forward: RoomsView::vec(0.0, 0.0, 1.0), right: RoomsView::vec(-1.0, 0.0, 0.0),
                up: RoomsView::vec(0.0, 1.0, 0.0)}

    def inside(point: RoomsView::Point, edge: i64) -> bool:
        return point.x >= -Nearer::HALF_W if edge == 0
        return point.x <= Nearer::HALF_W if edge == 1
        return point.y >= -Nearer::HALF_H if edge == 2
        return point.y <= Nearer::HALF_H

    def cross_edge(a: RoomsView::Point, b: RoomsView::Point, edge: i64) -> RoomsView::Point:
        if edge < 2:
            x: f64 = -Nearer::HALF_W if edge == 0 else Nearer::HALF_W
            return RoomsView::Point{x: x, y: a.y + (b.y - a.y) * (x - a.x) / (b.x - a.x)}
        y: f64 = -Nearer::HALF_H if edge == 2 else Nearer::HALF_H
        return RoomsView::Point{x: a.x + (b.x - a.x) * (y - a.y) / (b.y - a.y), y: y}

    def clip(poly: RoomsView::Polygon&) -> Shape:
        can Abort.Panic:
            shape: mutable Shape = Shape{points: zeroed, count: poly.count, colour: poly.colour,
                depth: poly.depth, port: poly.cell}
            for i in 0..<poly.count |poly, shape|:
                shape.points[i.usize()] <- poly.points[i.usize()]
            for edge in 0..<4 |shape|:
                break if shape.count == 0
                next_points: mutable RoomsView::Point[10] = zeroed
                count: mutable i64 = 0
                previous: mutable RoomsView::Point = shape.points[(shape.count - 1).usize()]
                for i in 0..<shape.count |shape, previous, edge, count, next_points|:
                    here: RoomsView::Point = shape.points[i.usize()]
                    in_now: bool = inside(here, edge)
                    if in_now != inside(previous, edge):
                        next_points[count.usize()] <- cross_edge(previous, here, edge)
                        count <- count + 1
                    if in_now:
                        next_points[count.usize()] <- here
                        count <- count + 1
                    previous <- here
                shape.points <- next_points
                shape.count <- count
            return shape

    def add(view: mutable Picture&, projected: RoomsView::Polygon&):
        can Abort.Panic:
            shape: Shape = clip(projected)
            return if shape.count < 3
            view.shapes[view.count.usize()] <- shape
            view.count <- view.count + 1
            return if shape.port < 0
            port: usize = shape.port.usize()
            if not view.visible[port]:
                p: RoomsView::Point = shape.points[0]
                view.boxes[port] <- RoomsView::Bounds{left: p.x, bottom: p.y, right: p.x, top: p.y}
                view.depths[port] <- shape.depth
                view.visible[port] <- true
            for i in 0..<shape.count |shape, port, view|:
                p: RoomsView::Point = shape.points[i.usize()]
                view.boxes[port].left <- p.x if p.x < view.boxes[port].left
                view.boxes[port].right <- p.x if p.x > view.boxes[port].right
                view.boxes[port].bottom <- p.y if p.y < view.boxes[port].bottom
                view.boxes[port].top <- p.y if p.y > view.boxes[port].top

    def flat(view: mutable Picture&, cam: RoomsView::Camera&, left: f64, right: f64, near: f64, far: f64, colour: u32):
        can Abort.Panic:
            return if near <= 0.05
            blank: RoomsView::Vec = RoomsView::vec(0.0, 0.0, 0.0)
            points: RoomsView::Vec[6] = [RoomsView::vec(left, 0.0, near), RoomsView::vec(right, 0.0, near),
                RoomsView::vec(right, 0.0, far), RoomsView::vec(left, 0.0, far), blank, blank]
            p: RoomsView::Polygon = RoomsView::polygon(cam, &points, 4, blank, colour, -1)
            add(view, &p)

    def backdrop(view: mutable Picture&, cam: RoomsView::Camera&, puzzle: Nearer::Puzzle&):
        can Abort.Panic:
            return if puzzle.level.cue > Nearer::SHADOW
            flat(view, cam, -40.0, 40.0, 0.6, 80.0, 0xc4beb0ff)
            if puzzle.level.cue <= Nearer::FLOOR:
                for i in 0..<21 |view, cam|:
                    x: f64 = (i * 2 - 20).f64()
                    flat(view, cam, x - 0.03, x + 0.03, 0.6, 80.0, 0x969084ff)
                for i in 0..<40 |view, cam|:
                    z: f64 = (i * 2 + 1).f64()
                    band: f64 = 0.03 * z / 4.0
                    flat(view, cam, -40.0, 40.0, z - band, z + band, 0x969084ff)
            for i in 0..<puzzle.count |view, cam, puzzle|:
                index: i64 = puzzle.order[(puzzle.count - 1 - i).usize()]
                solid: Nearer::Solid = puzzle.solids[index.usize()]
                r: f64 = solid.size * 0.6
                flat(view, cam, solid.x - r, solid.x + r, solid.z - r, solid.z + r, 0x78746cff)

    def sort_visible(view: mutable Picture&, count: i64):
        can Abort.Panic:
            for i in 0..<count |view|:
                if view.visible[i.usize()]:
                    at: mutable i64 = view.visible_count
                    while at > 0 |view, i, at|:
                        previous: i64 = view.front[(at - 1).usize()]
                        break if view.depths[previous.usize()] <= view.depths[i.usize()]
                        view.front[at.usize()] <- previous
                        at <- at - 1
                    view.front[at.usize()] <- i
                    view.visible_count <- view.visible_count + 1

    def scene(puzzle: Nearer::Puzzle&, elapsed: f64) -> Picture:
        can Abort.Panic:
            cam: RoomsView::Camera = camera(puzzle.level, elapsed)
            view: mutable Picture = zeroed
            backdrop(&view, &cam, puzzle)
            faces: mutable RoomsView::Picture = zeroed
            for i in 0..<puzzle.count |puzzle, faces, cam|:
                item: Nearer::Solid = puzzle.solids[i.usize()]
                solid: RoomsView::Solid = RoomsView::Solid{centre: RoomsView::vec(item.x, item.y, item.z),
                    size: item.size, height: item.size * (1.6 if item.kind == 1 else 1.0),
                    angle: item.yaw, cell: i, colour: Rooms::colour(item.colour)}
                if item.kind < 2:
                    RoomsView::box(&faces, &cam, &solid, 0, item.kind == 1)
                else:
                    RoomsView::prism(&faces, &cam, &solid, 0, item.kind == 2)
            for i in 0..<faces.count |faces, view|:
                add(&view, &faces.polygons[i.usize()])
            sort_visible(&view, puzzle.count)
            return view

    def hit(view: Picture&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            for i in 0..<view.visible_count |view, x, y|:
                target: i64 = view.front[i.usize()]
                box: RoomsView::Bounds = view.boxes[target.usize()]
                return target if x >= box.left and x <= box.right and y >= box.bottom and y <= box.top
            return -1
