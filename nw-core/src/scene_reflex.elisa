# The Reflex screen: game state in, display list out.
#
# Port of neural_workshop/ui/reflex.py -- the drawing, not the thinking.
#
# Three labels, a verdict, and one SPRITE per live target. This is the first
# scene whose drawing depends on the image itself: a target's scale is
# `side / image.width`, so a core that did not know the width could not
# produce the scale at all. The width and height are therefore passed in --
# the shell decodes the file and hands over its size; the core does the
# arithmetic. Deciding otherwise would mean the shell reimplementing the
# shrink, which is the task's whole clock.
#
# Two floors are load-bearing and neither is cosmetic:
#
#   * the scale floor, `max(0.001, ...)`, is what keeps a target that has run
#     out of life from becoming a zero-scale sprite -- it is still drawn, at a
#     few thousandths, and the recorder still sees it. The floor is applied in
#     PIXELS, before the divide into reference space, which is where the
#     reference applies it.
#   * the SPAWN floor is the verdict band. The targets are photographs, so
#     whether a run painted something the band reader counted as a scored
#     trial used to depend on which pictures it happened to draw. That is why
#     the placement clears the band by the target's full-size half-width and
#     not by a fraction of the screen.
#
# The sprite's position is its BOTTOM-LEFT corner, `centre - side / 2`, and
# not the centre it is nominally at.
#
# NOTE: needs elisacore_math, strings, geometry, verdict, display and
# scene_verdict included by the driver.

module SceneReflex:

    const PHASE_READY: i64 = 0
    const PHASE_RUNNING: i64 = 1
    const PHASE_DONE: i64 = 2

    struct Target:
        x: f64
        y: f64
        # Fraction of life left: 1 at spawn, 0 when it vanishes.
        remaining: f64
        asset: i64
        image_width: i64
        image_height: i64

    struct Paint:
        ink: mutable u32
        width: mutable f64
        height: mutable f64
        sx: mutable f64
        sy: mutable f64

    def paint_of(black_background: bool, width: f64, height: f64,
                 sx: f64, sy: f64) -> Paint:
        back: i64 = 0 if black_background else 255
        fore: i64 = 255 - back
        return Paint{ink: Display::rgba(fore, fore, fore, 255),
                     width: width, height: height, sx: sx, sy: sy}

    def put_text(list: mutable Display::DisplayList&, paint: Paint&, text: sview,
                 x: f64, y: f64, size: f64, color: u32, anchor: u32, bold: bool):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, text, x / paint.sx, y / paint.sy,
                                      size / paint.sy, color, anchor, bold)

    # A target's width at full size, in pixels.
    def full_side(height: f64, start_size: f64) -> f64:
        can Abort.Panic:
            scaled: f64 = Geometry::scale_to_height(height, start_size).f64()
            return scaled if scaled > 16.0 else 16.0

    def render(list: mutable Display::DisplayList&, paint: Paint&, phase: i64,
               targets: darray[Target]&, start_size: f64, spawned: i64,
               total_targets: i64, hits: i64, misses: i64, message: sview,
               verdict: i64, verdict_text: sview):
        can Memory.Allocate, Abort.Panic:
            middle: f64 = Geometry::width_center(paint.width).f64()

            put_text(list, paint, sview("Reflex", 0, -1), middle,
                     Geometry::from_top_edge(paint.height, 36.0).f64(),
                     Geometry::calc_fontsize(paint.height, 22.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, true)

            status: mutable dstr = []
            dstr_append_sview(&status, message)
            if phase == PHASE_RUNNING:
                dstr_append_cstr(&status, "     ")
                dstr_append_i64(&status, spawned)
                dstr_append_cstr(&status, "/")
                dstr_append_i64(&status, total_targets)
                dstr_append_cstr(&status, "   hit ")
                dstr_append_i64(&status, hits)
                dstr_append_cstr(&status, "   missed ")
                dstr_append_i64(&status, misses)
            put_text(list, paint, bytes_view(status), middle,
                     Geometry::from_top_edge(paint.height, 70.0).f64(),
                     Geometry::calc_fontsize(paint.height, 14.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            put_text(list, paint,
                     sview("Esc: task menu     Space: start     C: options", 0, -1),
                     middle, Geometry::from_bottom_edge(paint.height, 30.0).f64(),
                     Geometry::calc_fontsize(paint.height, 12.0), paint.ink,
                     Display::ANCHOR_CENTER_CENTER, false)

            if verdict >= 0:
                SceneVerdict::put(list, paint.width, paint.height, paint.sx, paint.sy,
                                  verdict == 1, verdict_text, 60.0, 16.0)

            # The targets are synced whatever the phase: a relayout mid-run
            # rebuilds them where they are rather than waiting for a frame.
            full: f64 = full_side(paint.height, start_size)
            for index in 0..<targets.count.i64() |list, paint, targets, full|:
                one: Target = get targets[index.usize()] else Target{x: 0.0, y: 0.0, remaining: 0.0, asset: 0, image_width: 1, image_height: 1}
                side: f64 = full * one.remaining
                wide: i64 = one.image_width if one.image_width > 1 else 1
                scaled: f64 = side / wide.f64()
                scale: f64 = scaled if scaled > 0.001 else 0.001
                Display::draw_sprite(list, one.asset.u32(),
                                     (one.x * paint.width - side / 2.0) / paint.sx,
                                     (one.y * paint.height - side / 2.0) / paint.sy,
                                     scale / paint.sx, 0.0, one.image_width,
                                     one.image_height,
                                     Display::rgba(255, 255, 255, 255))
