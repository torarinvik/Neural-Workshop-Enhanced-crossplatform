include "tasks/falls_game.elisa"
include "pymath.elisa"

module SceneFalls:
    const WIDTH: f64 = 912.0
    const HEIGHT: f64 = 684.0
    const FALLEN: u32 = 0xd6403aff
    const STOOD: u32 = 0x3caa5aff
    const FLOOR: u32 = 0x6e727cff
    const EDGE: u32 = 0x5a3c24ff
    const PATH: u32 = 0x285adcff

    struct Layout:
        left: f64
        bottom: f64
        width: f64
        button_height: f64
        scene_x: f64
        scene_y: f64
        scale: f64

    def layout() -> Layout:
        can Abort.Panic:
            width: f64 = WIDTH * 0.94
            left: f64 = (WIDTH - width) / 2.0
            bottom: f64 = Verdict::above_the_band(HEIGHT, 58.0).f64()
            height: f64 = HEIGHT - 116.0 - bottom
            button_height: f64 = height * 0.16
            scale_x: f64 = width / Falls::WORLD_W
            scale_y: f64 = (height - button_height - height * 0.04) / Falls::WORLD_H
            scale: f64 = scale_x if scale_x < scale_y else scale_y
            return Layout{left: left, bottom: bottom, width: width, button_height: button_height,
                scene_x: left + (width - Falls::WORLD_W * scale) / 2.0,
                scene_y: bottom + button_height + height * 0.04, scale: scale}

    def at(view: Layout&, x: f64, y: f64) -> Falls::Point:
        return Falls::Point{x: view.scene_x + x * view.scale, y: view.scene_y + y * view.scale}

    def button_width(view: Layout&, count: i64) -> f64:
        can Abort.Panic:
            return (view.width - view.width * 0.012 * (count - 1).f64()) / count.f64()

    def hit(run: FallsGame::Run&, x: f64, y: f64) -> i64:
        can Abort.Panic:
            return -1 if run.phase != FallsGame::CHOOSING
            view: Layout = layout()
            return -1 if x < view.left or x > view.left + view.width or y < view.bottom or y > view.bottom + view.button_height
            width: f64 = button_width(&view, run.puzzle.choices)
            stride: f64 = width + view.width * 0.012
            index: i64 = ((x - view.left) / stride).i64()
            return -1 if x - view.left - index.f64() * stride > width
            return index

    def letter(index: i64) -> cstr:
        if index == 0: return "A"
        if index == 1: return "B"
        if index == 2: return "C"
        if index == 3: return "D"
        if index == 4: return "E"
        if index == 5: return "F"
        return "G"

    def kind_note(kind: i64) -> cstr:
        if kind == Falls::STAND: return "towers that stand or fall"
        if kind == Falls::LEVER: return "planks on a pivot"
        if kind == Falls::LAND: return "where a ball lands"
        if kind == Falls::FIRST: return "which block topples first"
        return "where a ball lands after a bounce"

    def option_note(rung: i64, note: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Falls::Grade = Falls::grade(rung)
            dstr_append_cstr(note, "Rung ")
            dstr_append_i64(note, level.rung)
            dstr_append_cstr(note, ": ")
            for kind in 0..<(level.newest + 1) |note|:
                if kind > 0:
                    dstr_append_cstr(note, ", ")
                dstr_append_cstr(note, kind_note(kind))
            dstr_append_cstr(note, ".  Deciding margin ")
            dstr_append_i64(note, py_round_half_even(level.margin * 100.0))
            dstr_append_cstr(note, "% of a support.")
            if level.offset_pivot:
                dstr_append_cstr(note, "  Pivots off the middle, so the plank weighs in.")

    def question(kind: i64) -> cstr:
        if kind == Falls::STAND: return "Does the tower stand or fall?"
        if kind == Falls::LEVER: return "Which way does the plank go?"
        if kind == Falls::FIRST: return "Which block is the first to topple?"
        if kind == Falls::LAND: return "Where does the ball land?"
        return "Where does the ball land the second time?"

    def choice_text(puzzle: Falls::Puzzle&, index: i64, small: bool, text: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if puzzle.kind == Falls::STAND:
                if small:
                    dstr_append_cstr(text, "it stands" if index == 0 else "it falls")
                else:
                    dstr_append_cstr(text, "It stands" if index == 0 else "It falls")
            elif puzzle.kind == Falls::LEVER:
                if small:
                    dstr_append_cstr(text, "tips left" if index == 0 else ("tips right" if index == 1 else "stays level"))
                else:
                    dstr_append_cstr(text, "Tips left" if index == 0 else ("Tips right" if index == 1 else "Stays level"))
            elif puzzle.kind == Falls::FIRST:
                if index == puzzle.choices - 1:
                    dstr_append_cstr(text, "nothing falls" if small else "Nothing falls")
                else:
                    if small:
                        text.push((98 + index).u8())
                    else:
                        dstr_append_cstr(text, letter(index + 1))
                    dstr_append_cstr(text, " falls first")
            else:
                dstr_append_cstr(text, "bin " if small else "Bin ")
                dstr_append_i64(text, index + 1)

    def status(run: FallsGame::Run&, text: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == FallsGame::READY:
                dstr_append_cstr(text, "Press Space to start")
            elif run.phase == FallsGame::CHOOSING or run.phase == FallsGame::FLAGGED:
                dstr_append_cstr(text, question(run.puzzle.kind))
            elif run.phase == FallsGame::JUDGED:
                dstr_append_cstr(text, "Right: " if run.chosen == run.puzzle.answer else "No: ")
                choice_text(&run.puzzle, run.puzzle.answer, true, text)
            else:
                dstr_append_i64(text, run.passed)
                dstr_append_cstr(text, " of ")
                dstr_append_i64(text, run.scored)
                dstr_append_cstr(text, " passed   highest rung passed ")
                dstr_append_i64(text, run.best)

    def draw_tower(list: mutable Display::DisplayList&, puzzle: Falls::Puzzle&, view: Layout&, judged: bool, ink: u32):
        can Memory.Allocate, Abort.Panic:
            tower: Falls::Tower& = &puzzle.tower
            fell: i64 = Falls::first_to_fall(tower) if judged else -1
            available: f64 = tower.blocks[0].h * view.scale * 0.45
            size: f64 = 14.0 if available >= 14.0 else available
            for index in 0..<tower.count |list, puzzle, tower, view, fell, size|:
                block: Falls::Block = tower.blocks[index.usize()]
                corner: Falls::Point = at(view, block.x, block.y)
                width: f64 = block.w * view.scale
                height: f64 = block.h * view.scale
                toppling: bool = fell >= 0 and index >= fell
                Display::draw_bordered_rect(list, corner.x, corner.y, width, height,
                    0xb08458ff, FALLEN if toppling else EDGE, 3.0 if toppling else 2.0)
                if puzzle.kind == Falls::FIRST:
                    label: cstr = letter(index)
                    Display::draw_text_weight(list, sview(label, 0, -1), corner.x + width / 2.0,
                        corner.y + height / 2.0, size, 0xffffffff, Display::ANCHOR_CENTER_CENTER, true)
            if judged and fell < 0:
                top: Falls::Block = tower.blocks[(tower.count - 1).usize()]
                center: Falls::Point = at(view, top.x + top.w / 2.0, top.y + top.h)
                Display::draw_text_weight(list, "stands", center.x, center.y + size, size, ink, Display::ANCHOR_CENTER_CENTER, true)

    def plank_point(pivot: Falls::Point, scale: f64, offset: f64, up: f64, tilt: f64) -> Falls::Point:
        dx: f64 = offset * 0.9 * scale
        return Falls::Point{x: pivot.x + dx * cos(tilt) - up * sin(tilt), y: pivot.y + dx * sin(tilt) + up * cos(tilt)}

    def draw_lever(list: mutable Display::DisplayList&, puzzle: Falls::Puzzle&, view: Layout&, judged: bool):
        can Memory.Allocate, Abort.Panic:
            tilt: f64 = (0.12 if puzzle.answer == 0 else (-0.12 if puzzle.answer == 1 else 0.0)) if judged else 0.0
            pivot: f64 = puzzle.lever.pivot.f64()
            point: Falls::Point = at(view, 6.0 + pivot * 0.9, 1.6)
            half: f64 = view.scale * 0.5
            Display::begin_polygon(list, 3, point.x - half, view.scene_y, FLOOR)
            Display::polygon_point(list, point.x - half, view.scene_y)
            Display::polygon_point(list, point.x + half, view.scene_y)
            Display::polygon_point(list, point.x, point.y)
            thickness: f64 = view.scale * 0.18
            left: Falls::Point = plank_point(point, view.scale, -5.0 - pivot, 0.0, tilt)
            right: Falls::Point = plank_point(point, view.scale, 5.0 - pivot, 0.0, tilt)
            Display::draw_line(list, left.x, left.y, right.x, right.y, thickness, 0x785a3cff)
            box: f64 = 0.9 * 0.85 * view.scale
            for index in 0..<Falls::PILE_SLOTS |list, puzzle, point, view, pivot, tilt, box, thickness|:
                offset: f64 = (index - 5).f64() - pivot
                tick: Falls::Point = plank_point(point, view.scale, offset, -thickness, tilt)
                Display::draw_text(list, "|", tick.x, tick.y, 8.0, FLOOR, Display::ANCHOR_CENTER_CENTER)
                for level in 0..<puzzle.lever.piles[index.usize()] |list, point, view, offset, thickness, box, tilt|:
                    center: Falls::Point = plank_point(point, view.scale, offset, thickness / 2.0 + box * (level.f64() + 0.5), tilt)
                    Display::draw_bordered_rect(list, center.x - box / 2.0, center.y - box / 2.0, box, box, 0xc8a05aff, EDGE, 2.0)

    def draw_trace(list: mutable Display::DisplayList&, path: Falls::Flight&, view: Layout&):
        can Memory.Allocate, Abort.Panic:
            x: mutable f64 = path.edge
            y: mutable f64 = path.height
            up: mutable f64 = 0.0
            left: mutable i64 = path.bounces
            previous: mutable Falls::Point = at(view, x, y + 0.14)
            for step in 1..<2000 |list, path, view, x, y, up, left, previous|:
                x <- x + path.speed * 0.02
                up <- up - Falls::GRAVITY * 0.02
                y <- y + up * 0.02
                ended: bool = y <= 0.0 and left == 0
                if y <= 0.0:
                    y <- 0.0
                    left <- left - 1
                    up <- -up * Falls::REBOUND
                if step % 3 == 0:
                    point: Falls::Point = at(view, x, y + 0.14)
                    Display::draw_line(list, previous.x, previous.y, point.x, point.y, 2.0, PATH)
                    previous <- point
                return if ended

    def draw_flight(list: mutable Display::DisplayList&, puzzle: Falls::Puzzle&, view: Layout&, judged: bool, ink: u32):
        can Memory.Allocate, Abort.Panic:
            path: Falls::Flight& = &puzzle.flight
            Display::draw_bordered_rect(list, view.scene_x, view.scene_y, path.edge * view.scale,
                path.height * view.scale, 0x966e46ff, EDGE, 2.0)
            radius: f64 = view.scale * 0.14
            for index in 0..<path.dot_count |list, path, view, radius|:
                dot: Falls::Point = path.dots[index.usize()]
                point: Falls::Point = at(view, dot.x, dot.y + 0.14)
                Display::draw_circle(list, point.x, point.y, radius if index == 0 else radius * 0.6,
                    0x3c6ec8ff if index == 0 else 0x7896d2ff)
            width: f64 = (path.hi - path.lo) / puzzle.choices.f64()
            available: f64 = width * view.scale * 0.35
            size: f64 = 13.0 if available >= 13.0 else available
            for index in 0..<(puzzle.choices + 1) |list, puzzle, path, view, width, ink, size|:
                marker: Falls::Point = at(view, path.lo + index.f64() * width, 0.0)
                Display::draw_rect(list, marker.x - 1.0, marker.y, 2.0, 0.45 * view.scale, FLOOR)
                if index < puzzle.choices:
                    number: mutable dstr = []
                    dstr_append_i64(&number, index + 1)
                    Display::draw_text_weight(list, bytes_view(number), marker.x + width * view.scale / 2.0,
                        marker.y + 0.22 * view.scale, size, ink, Display::ANCHOR_CENTER_CENTER, true)
            if judged:
                draw_trace(list, path, view)

    def draw_buttons(list: mutable Display::DisplayList&, run: FallsGame::Run&, view: Layout&, black: bool, ink: u32):
        can Memory.Allocate, Abort.Panic:
            width: f64 = button_width(view, run.puzzle.choices)
            gap: f64 = view.width * 0.012
            back: u32 = 0x2e323aff if black else 0xe8ebf0ff
            judged: bool = run.phase == FallsGame::JUDGED
            for index in 0..<run.puzzle.choices |list, run, view, width, gap, back, ink, judged|:
                x: f64 = view.left + index.f64() * (width + gap)
                correct: bool = judged and index == run.puzzle.answer
                incorrect: bool = judged and index == run.chosen and not correct
                color: u32 = STOOD if correct else (FALLEN if incorrect else ink)
                Display::draw_bordered_rect(list, x, view.bottom, width, view.button_height,
                    back, color, 4.0 if correct or incorrect else 2.0)
                caption: mutable dstr = []
                dstr_append_i64(&caption, index + 1)
                dstr_append_cstr(&caption, "  ")
                choice_text(&run.puzzle, index, false, &caption)
                estimate: f64 = TextMetrics::text_width(14.0, caption.count.i64()).f64()
                size: f64 = 14.0 if estimate <= width * 0.9 else 14.0 * width * 0.9 / estimate
                Display::draw_text(list, bytes_view(caption), x + width / 2.0,
                    view.bottom + view.button_height / 2.0, size, ink, Display::ANCHOR_CENTER_CENTER)

    def render(list: mutable Display::DisplayList&, run: FallsGame::Run&, black: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if black else 0x000000ff
            center: f64 = WIDTH / 2.0
            Display::draw_text_weight(list, "Will It Fall?", center, HEIGHT - 36.0, 22.0, ink,
                Display::ANCHOR_CENTER_CENTER, true)
            message: mutable dstr = []
            status(run, &message)
            Display::draw_text(list, bytes_view(message), center, HEIGHT - 70.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            Display::draw_text(list, "click an answer or press its number   Esc: menu", center, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            return if run.phase == FallsGame::READY or run.phase == FallsGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, run.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, run.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, run.total)
            Display::draw_text(list, bytes_view(facts), center, HEIGHT - 96.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            view: Layout = layout()
            judged: bool = run.phase == FallsGame::JUDGED
            Display::draw_rect(list, view.scene_x, view.scene_y - 4.0, Falls::WORLD_W * view.scale, 4.0, FLOOR)
            if run.puzzle.tower.count > 0:
                draw_tower(list, &run.puzzle, &view, judged, ink)
            elif run.puzzle.kind == Falls::LEVER:
                draw_lever(list, &run.puzzle, &view, judged)
            else:
                draw_flight(list, &run.puzzle, &view, judged, ink)
            draw_buttons(list, run, &view, black, ink)
            if run.phase == FallsGame::FLAGGED:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, false, "Out of time", 60.0, 16.0)
            elif judged:
                SceneVerdict::put(list, WIDTH, HEIGHT, 1.0, 1.0, run.chosen == run.puzzle.answer, bytes_view(message), 60.0, 16.0)
