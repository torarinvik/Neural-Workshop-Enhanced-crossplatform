include "./tasks/time_it_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"

module SceneTimeIt:
    const HEIGHT: f64 = 389.0
    const SCALE: f64 = HEIGHT / TimeIt::HEIGHT
    const CX: f64 = 456.0
    const LEFT: f64 = CX - TimeIt::WIDTH * SCALE / 2.0
    const BOTTOM: f64 = 179.0

    def mix(lo: i64, hi: i64, t: f64) -> i64:
        return py_round_half_even(lo.f64() + (hi - lo).f64() * t)

    def scenery(list: mutable Display::DisplayList&):
        can Memory.Allocate, Abort.Panic:
            width: f64 = TimeIt::WIDTH * SCALE
            area: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT, y: BOTTOM, w: width, h: HEIGHT}
            frame: SceneHiddenRule::Rect = ScenePolish::spread_box(&area, 6.0)
            shadows: u32[3] = [0x0000001e, 0x00000012, 0x0000000c]
            for layer in 0..<3 |list, frame, shadows|:
                spread: f64 = layer.f64() * 2.0
                shadow: SceneHiddenRule::Rect = ScenePolish::spread_box(&frame, spread, 4.0)
                ScenePolish::rounded(list, &shadow, 14.0 + spread, shadows[layer.usize()])
            ScenePolish::rounded(list, &frame, 14.0, 0x1e2846ff)
            for band in 0..<20 |list, width|:
                t: f64 = (band.f64() + 0.5) / 20.0
                colour: u32 = Display::rgba(mix(120, 40, t), mix(190, 80, t), mix(240, 160, t), 255)
                Display::draw_rect(list, LEFT, BOTTOM + band.f64() * HEIGHT / 20.0, width, HEIGHT / 20.0 + 1.0, colour)
            ground: f64 = (TimeIt::GROUND - 0.8) * SCALE
            for band in 0..<5 |list, width, ground|:
                t: f64 = (band.f64() + 0.5) / 5.0
                colour: u32 = Display::rgba(mix(60, 110, t), mix(140, 190, t), mix(70, 100, t), 255)
                Display::draw_rect(list, LEFT, BOTTOM + band.f64() * ground / 5.0, width, ground / 5.0 + 1.0, colour)
            for dash in 0..<25 |list, ground|:
                x: f64 = LEFT + dash.f64() * 4.0 * SCALE
                Display::draw_line(list, x, BOTTOM + ground, x + 2.0 * SCALE, BOTTOM + ground, 2.0, 0xf0f0e6ff)

    def glow(list: mutable Display::DisplayList&, x: f64, y: f64, radius: f64, colour: u32, strength: i64):
        can Memory.Allocate, Abort.Panic:
            shares: f64[4] = [0.15, 0.25, 0.35, 0.5]
            for i in 0..<4 |list, x, y, radius, colour, strength, shares|:
                alpha: u32 = (strength.f64() * shares[i.usize()]).u32()
                Display::draw_circle(list, x, y, radius * (1.0 - i.f64() * 0.2), colour | alpha)

    def paint_shot(list: mutable Display::DisplayList&, run: TimeIt::Trial&):
        can Memory.Allocate, Abort.Panic:
            judged: bool = run.result != TimeIt::PENDING
            radius: f64 = 1.6 * SCALE
            if run.shot.kind == TimeIt::BOUNCE:
                Display::draw_rect(list, LEFT + run.shot.wall * SCALE, BOTTOM + (TimeIt::GROUND - 0.8) * SCALE,
                    1.2 * SCALE, 9.0 * SCALE, 0x78503cff)
            ball: TimeIt::Point = TimeIt::position(&run.shot, run.shot.when if judged else run.time)
            x: f64 = LEFT + ball.x * SCALE
            y: f64 = BOTTOM + (ball.y + 1.6) * SCALE
            spin: f64 = -ball.x / 1.6
            Display::draw_circle(list, x, y, radius, 0xfa5a50ff)
            Display::draw_line(list, x, y, x + cos(spin) * radius, y + sin(spin) * radius, 3.0, 0xffdcc8ff)
            if judged and run.pressed >= 0.0:
                ghost: TimeIt::Point = TimeIt::position(&run.shot, run.pressed)
                ScenePolish::ring(list, LEFT + ghost.x * SCALE, BOTTOM + (ghost.y + 1.6) * SCALE,
                    radius, 3.0, 0xffffffdc, 48)
            edge: f64 = LEFT + run.shot.left * SCALE
            width: f64 = (run.shot.right - run.shot.left) * SCALE
            count: i64 = (width / (3.0 * SCALE)).i64()
            stripes: i64 = count if count >= 3 else 3
            alpha: u32 = 110.u32() if judged else 255.u32()
            for i in 0..<stripes |list, alpha, edge, width, stripes|:
                colour: u32 = 0xfad24600 if i % 2 == 1 else 0x3c467800
                Display::draw_rect(list, edge + width * i.f64() / stripes.f64(), BOTTOM,
                    width / stripes.f64() + 1.0, HEIGHT, colour | alpha)
            mark: f64 = LEFT + run.shot.mark * SCALE
            glow(list, mark, BOTTOM + HEIGHT * 0.5, 4.0 * SCALE, 0xffffff00, 60)
            Display::draw_line(list, mark, BOTTOM, mark, BOTTOM + HEIGHT, 4.0, 0xffffffff)
            Display::draw_triangle(list, mark - 2.0 * SCALE, BOTTOM + HEIGHT, mark + 2.0 * SCALE,
                BOTTOM + HEIGHT, mark, BOTTOM + HEIGHT - 3.0 * SCALE, 0xff5078ff)
            if run.pressed >= 0.0:
                flash: f64 = 1.0 - (run.time - run.pressed) / 0.3
                if flash > 0.0:
                    glow(list, mark, BOTTOM + HEIGHT * 0.5, 10.0 * SCALE, 0xffffc800, (150.0 * flash).i64())

    def instructions(kind: i64) -> cstr:
        return "It is slowing -- press as it passes the mark" if kind == TimeIt::SLOW
        return "It bounces off the wall -- press as it comes back to the mark" if kind == TimeIt::BOUNCE
        return "Press as it lands on the mark" if kind == TimeIt::THROW
        return "Press as it passes the mark"

    def render(list: mutable Display::DisplayList&, session: TimeItGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Time It", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Space: press when the hidden ball is at the mark   Esc: menu", CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            message: mutable dstr = []
            if session.phase == TimeItGame::READY:
                dstr_append_cstr(&message, "Press Space or click to start")
            elif session.phase == TimeItGame::DONE:
                dstr_append_i64(&message, session.passed_count)
                dstr_append_cstr(&message, " of ")
                dstr_append_i64(&message, session.trial)
                dstr_append_cstr(&message, " passed   highest rung passed ")
                dstr_append_i64(&message, session.best_rung)
            elif session.phase == TimeItGame::JUDGED:
                TimeIt::result_text(&session.run, &message)
            else:
                dstr_append_cstr(&message, instructions(session.run.shot.kind))
            Display::draw_text(list, bytes_view(message), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if session.phase >= TimeItGame::JUDGED and session.run.result != TimeIt::PENDING:
                verdict: mutable dstr = []
                TimeIt::result_text(&session.run, &verdict)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.run.result == TimeIt::ON_MARK, bytes_view(verdict), 60.0, 16.0)
            return if session.phase == TimeItGame::READY or session.phase == TimeItGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.total)
            dstr_append_cstr(&facts, "   window +-")
            dstr_append_i64(&facts, py_round_half_even(session.run.shot.level.window * 1000.0))
            dstr_append_cstr(&facts, " ms")
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            scenery(list)
            paint_shot(list, &session.run)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            grade: TimeIt::Grade = TimeIt::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, grade.rung)
            dstr_append_cstr(out, ": +-")
            dstr_append_i64(out, py_round_half_even(grade.window * 1000.0))
            dstr_append_cstr(out, " ms.  ")
            kinds: cstr = "roll" if grade.kind == TimeIt::ROLL else ("slow" if grade.kind == TimeIt::SLOW else
                ("bounce" if grade.kind == TimeIt::BOUNCE else ("throw" if grade.kind == TimeIt::THROW else "roll, slow, bounce, throw")))
            dstr_append_cstr(out, kinds)
