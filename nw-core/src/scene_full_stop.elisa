include "./tasks/full_stop_game.elisa"
include "./scene_hand.elisa"
include "./geometry.elisa"
include "./scene_verdict.elisa"
include "./textmetrics.elisa"

module SceneFullStop:
    const INK: u32 = 0x282430ff

    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            Display::draw_rect(list, SceneHand::x(x), SceneHand::y(y), w * SceneHand::SCALE, h * SceneHand::SCALE, colour)

    def page(list: mutable Display::DisplayList&, run: FullStop::Run&):
        can Memory.Allocate, Abort.Panic:
            last: i64 = run.machine.count - 1
            scale: f64 = run.layout.scale
            top: f64 = run.layout.tiles[0].y + 40.0 * scale
            bottom: f64 = run.layout.tiles[last.usize()].y - 40.0 * scale
            rect(list, 20.0, bottom, 960.0, top - bottom, 0xf6f0e2ff)
            rect(list, 20.0, bottom, 6.0, top - bottom, 0xdc786eff)
            for i in 0..<(last + 1) |list, run, last, scale|:
                t: FullStop::Tile = run.layout.tiles[i.usize()]
                x: f64 = t.x - t.width / 2.0
                y: f64 = t.y - FullStop::TILE_H / 2.0
                rect(list, x, y, t.width, FullStop::TILE_H, 0xbeb4a0ff)
                rect(list, x + 1.5, y + 1.5, t.width - 3.0, FullStop::TILE_H - 3.0, 0xfffcf4ff)
                text: mutable dstr = []
                word: mutable Passages::Word = run.machine.words[i.usize()]
                if i == 0 or run.stops[(i - 1).usize()]:
                    word.capitals <- word.capitals | 1.u64()
                Passages::append_word(&text, word)
                SceneHand::word(list, bytes_view(text), t.x, t.y, 15.0 * scale, INK)
                if i == last or run.stops[i.usize()]:
                    Display::draw_circle(list, SceneHand::x(t.x + t.width / 2.0 + 5.0 * scale),
                        SceneHand::y(t.y - 11.0 * scale), fmax(1.0, 4.5 * scale * SceneHand::SCALE), INK if i == last else 0xc83228ff)
            button(list, FullStop::DONE_X, "DONE")
            button(list, FullStop::RESET_X, "RESET")
            if run.machine.level.hint:
                hint: mutable dstr = []
                dstr_append_i64(&hint, run.count + 1)
                dstr_append_cstr(&hint, " of ")
                dstr_append_i64(&hint, run.machine.level.sentences)
                dstr_append_cstr(&hint, " sentences")
                SceneHand::word(list, bytes_view(hint), 120.0, FullStop::BUTTON_Y, 12.0, 0xe6e6f0ff)

    def button(list: mutable Display::DisplayList&, x: f64, name: sview):
        can Memory.Allocate, Abort.Panic:
            rect(list, x - 60.0, FullStop::BUTTON_Y - 20.0, 120.0, 40.0, 0x5a6482ff)
            SceneHand::word(list, name, x, FullStop::BUTTON_Y, 12.0, 0xf0f0faff, true)

    def feedback(run: FullStop::Run&, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.result == FullStop::CLEAR:
                dstr_append_cstr(words, "Every stop in its place")
                return
            if run.result == FullStop::TIMEOUT:
                dstr_append_cstr(words, "Out of time")
            else:
                dstr_append_i64(words, run.missing)
                dstr_append_cstr(words, " stop(s) missing, ")
                dstr_append_i64(words, run.extra)
                dstr_append_cstr(words, " too many")
            dstr_append_cstr(words, ": ")
            first: mutable bool = true
            for i in 0..<run.machine.count |run, words, first|:
                dstr_append_cstr(words, " ") if i > 0
                word: mutable Passages::Word = run.machine.words[i.usize()]
                word.capitals <- 1.u64() if first else 0.u64()
                Passages::append_word(words, word)
                first <- run.machine.stops[i.usize()]
                dstr_append_cstr(words, ".") if first or i == run.machine.count - 1

    def caption(view: sview, text: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if sview_len(view).i64() > 140:
                dstr_append_sview(text, string_view_prefix(view, 137))
                dstr_append_cstr(text, "...")
            else:
                dstr_append_sview(text, view)

    def label(list: mutable Display::DisplayList&, text: sview, y: f64, size: f64, ink: u32, bold: bool = false):
        can Memory.Allocate, Abort.Panic:
            width: f64 = TextMetrics::text_width(size, TextMetrics::codepoints(text)).f64()
            room: f64 = 912.0 * 0.96
            actual: f64 = fmax(6.0, size * room / width) if width > room else size
            Display::draw_text_weight(list, text, 456.0, y, actual, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def render(list: mutable Display::DisplayList&, session: FullStopGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            label(list, "Full Stop", 648.0, 22.0, ink, true)
            label(list, "Click the last word of each sentence   Enter: done   R: reset", 26.0, 12.0, ink)
            run: FullStop::Run& = &session.run
            status: mutable dstr = []
            verdict: mutable dstr = []
            if session.phase == FullStopGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == FullStopGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == FullStopGame::JUDGED:
                feedback(run, &verdict)
                caption(bytes_view(verdict), &status)
            else:
                dstr_append_cstr(&status, "Put in the full stops")
                if run.machine.level.hint:
                    dstr_append_cstr(&status, ": ")
                    dstr_append_i64(&status, run.machine.level.sentences)
                    dstr_append_cstr(&status, " sentences")
            label(list, bytes_view(status), 614.0, 14.0, ink)
            if session.phase == FullStopGame::PLAYING or session.phase == FullStopGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                label(list, bytes_view(facts), 588.0, 12.0, ink)
                SceneHand::card(list, 0x363c4aff)
                page(list, run)
                SceneHand::progress(list, &run.hand, fmax(0.0, (run.machine.seconds - run.t) / run.machine.seconds))
            if session.phase == FullStopGame::JUDGED or session.phase == FullStopGame::DONE:
                if session.phase == FullStopGame::DONE:
                    feedback(run, &verdict)
                shown: mutable dstr = []
                caption(bytes_view(verdict), &shown)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.result == FullStop::CLEAR, bytes_view(shown), 60.0, 16.0)

    def option_note(rung: i64, text: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: FullStop::Grade = FullStop::grade(rung)
            dstr_append_cstr(text, "Rung ")
            dstr_append_i64(text, level.rung)
            dstr_append_cstr(text, ": ")
            dstr_append_i64(text, level.sentences)
            dstr_append_cstr(text, " sentences run together.")
