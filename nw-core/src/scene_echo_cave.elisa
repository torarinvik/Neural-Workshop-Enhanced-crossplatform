include "./tasks/echo_cave_game.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"

module SceneEchoCave:
    const WIDTH: f64 = 857.28
    const LEFT: f64 = (912.0 - WIDTH) / 2.0
    const BOTTOM: f64 = 179.0
    const HEIGHT: f64 = 389.0
    const CX: f64 = EchoCaveGame::CX

    struct ViewPoint:
        x: f64
        y: f64
        scale: f64

    def see(eye: EchoCaveGame::Camera&, x: f64, y: f64, z: f64) -> ViewPoint:
        depth: f64 = z - eye.z
        return ViewPoint{x: 0.0, y: 0.0, scale: 0.0} if depth < 0.3
        k: f64 = EchoCaveGame::FOCAL / depth
        return ViewPoint{x: CX + (x - eye.x) * k, y: EchoCaveGame::CY + (y - eye.y) * k, scale: k}

    def inside(point: ViewPoint) -> bool:
        return point.x >= LEFT + 16.0 and point.x <= LEFT + WIDTH - 16.0 and point.y >= BOTTOM + 16.0 and point.y <= BOTTOM + HEIGHT - 16.0

    def tunnel(list: mutable Display::DisplayList&, eye: EchoCaveGame::Camera&, run: EchoCave::Run&, light: f64):
        can Memory.Allocate, Abort.Panic:
            return if light <= 0.0
            start: f64 = floor(run.z / 2.0) * 2.0
            for ring_index in 0..<45 |list, eye, run, light, start|:
                z: f64 = start + (44 - ring_index).f64() * 2.0
                ahead: f64 = z - run.z
                continue if ahead < -EchoCaveGame::BACK + 0.6
                fade: f64 = 1.0 - (ahead if ahead > 0.0 else 0.0) / light
                continue if fade <= 0.02
                center: EchoCave::Point = EchoCave::axis(&run.cave, z)
                radius: f64 = EchoCave::radius(&run.cave, z)
                projected: ViewPoint = see(eye, center.x, center.y, z)
                continue if projected.scale <= 0.0
                width: f64 = EchoCave::clamp(projected.scale * 0.25, 1.0, 14.0)
                colour: u32 = (ScenePolish::mix_rgb(0x141014ff, 0xb08864ff, fade) & 0xffffff00.u32()) | (255.0 * fade).u32()
                previous: mutable ViewPoint = zeroed
                first: mutable ViewPoint = zeroed
                for i in 0..<24 |list, eye, center, z, radius, previous, first, width, colour|:
                    angle: f64 = EchoCave::TAU * i.f64() / 24.0
                    wobble: f64 = 1.0 + 0.06 * sin(angle * 3.0 + z * 0.7)
                    p: ViewPoint = see(eye, center.x + radius * wobble * cos(angle), center.y + radius * wobble * sin(angle), z)
                    if i == 0:
                        first <- p
                    elif inside(previous) and inside(p):
                        Display::draw_line(list, previous.x, previous.y, p.x, p.y, width, colour)
                    previous <- p
                if inside(previous) and inside(first):
                    Display::draw_line(list, previous.x, previous.y, first.x, first.y, width, colour)

    def moths(list: mutable Display::DisplayList&, eye: EchoCaveGame::Camera&, run: EchoCave::Run&, light: f64):
        can Memory.Allocate, Abort.Panic:
            return if not run.cave.level.moths_seen
            for k in 0..<run.cave.level.moths |list, eye, run, light|:
                entry: EchoCave::Moth = run.cave.moths[k.usize()]
                continue if (run.caught_mask & (1 << k.u64())) != 0 or entry.z - run.z > light or entry.z < eye.z + 0.5
                position: EchoCave::Point = EchoCave::moth(run, k, run.time)
                point: ViewPoint = see(eye, position.x, position.y, entry.z)
                continue if not inside(point)
                scale: f64 = 0.35 * point.scale if point.scale * 0.35 > 1.5 else 1.5
                flap: f64 = sin(run.time * 30.0 + k.f64()) * scale
                ScenePolish::glow(list, point.x, point.y, scale * 3.0, 0xfff0a0ff, 120)
                for i in 0..<2 |list, point, scale, flap|:
                    side: f64 = -1.0 if i == 0 else 1.0
                    Display::draw_triangle(list, point.x, point.y, point.x + side * scale * 1.6,
                        point.y + flap, point.x + side * scale * 1.2, point.y - scale * 0.6, 0xfaecc8ff)

    def bat(list: mutable Display::DisplayList&, eye: EchoCaveGame::Camera&, run: EchoCave::Run&):
        can Memory.Allocate, Abort.Panic:
            p: ViewPoint = see(eye, run.x, run.y, run.z)
            scale: f64 = 0.9 * p.scale
            flap: f64 = sin(run.time * 14.0) * scale * 0.5
            if run.clicked_at >= 0.0 and run.time - run.clicked_at < 0.12:
                ScenePolish::glow(list, p.x, p.y, scale * 2.2, 0xa0c8ffff, 150)
            for i in 0..<2 |list, p, scale, flap|:
                side: f64 = -1.0 if i == 0 else 1.0
                Display::draw_triangle(list, p.x, p.y + scale * 0.2, p.x + side * scale * 1.8, p.y + flap + scale * 0.3,
                    p.x + side * scale * 1.1, p.y - scale * 0.4, 0x3c3246ff)
                Display::draw_triangle(list, p.x + side * scale * 1.8, p.y + flap + scale * 0.3, p.x + side * scale * 1.1,
                    p.y - scale * 0.4, p.x + side * scale * 1.5, p.y - scale * 0.1 + flap * 0.5, 0x5a4c64ff)
            Display::draw_circle(list, p.x, p.y, scale * 0.45, 0x50425aff)
            Display::draw_circle(list, p.x - scale * 0.16, p.y + scale * 0.12, scale * 0.08, 0xffdc78ff)
            Display::draw_circle(list, p.x + scale * 0.16, p.y + scale * 0.12, scale * 0.08, 0xffdc78ff)

    def progress(list: mutable Display::DisplayList&, run: EchoCave::Run&):
        can Memory.Allocate, Abort.Panic:
            bar: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT + 20.0, y: BOTTOM + 14.0, w: WIDTH - 40.0, h: 6.0}
            ScenePolish::rounded(list, &bar, 3.0, 0xffffff28)
            fill: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: bar.x, y: bar.y, h: bar.h,
                w: EchoCave::clamp(bar.w * (run.z / run.cave.level.length), 6.0, bar.w)}
            ScenePolish::rounded(list, &fill, 3.0, 0x96beffff)
            y: f64 = BOTTOM + HEIGHT - 22.0
            count: i64 = run.cave.level.moths
            for k in 0..<count |run, list, y|:
                colour: u32 = 0xffe68cff if (run.caught_mask & (1 << k.u64())) != 0 else 0xffffff32
                Display::draw_circle(list, LEFT + 24.0 + k.f64() * 22.0, y, 7.0, colour)
            text: mutable dstr = []
            dstr_append_cstr(&text, "need ")
            dstr_append_i64(&text, run.cave.level.need)
            Display::draw_text(list, bytes_view(text), LEFT + 30.0 + count.f64() * 22.0, y, 10.0,
                0xffffffa0, Display::ANCHOR_LEFT_CENTER)

    def stage(list: mutable Display::DisplayList&, run: EchoCave::Run&):
        can Memory.Allocate, Abort.Panic:
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT - 4.0, y: BOTTOM - 4.0, w: WIDTH + 8.0, h: HEIGHT + 8.0}
            alphas: u32[3] = [30.u32(), 18.u32(), 12.u32()]
            for i in 0..<3 |list, box, alphas|:
                spread: f64 = i.f64() * 2.0
                shadow: SceneHiddenRule::Rect = ScenePolish::spread_box(&box, spread, 4.0)
                ScenePolish::rounded(list, &shadow, 14.0 + spread, alphas[i.usize()])
            ScenePolish::rounded(list, &box, 14.0, 0x06060aff)
            Display::draw_rect(list, LEFT, BOTTOM, WIDTH, HEIGHT, 0x08080eff)
            eye: EchoCaveGame::Camera = EchoCaveGame::camera(run)
            light: f64 = EchoCave::lit(run)
            tunnel(list, &eye, run, light)
            moths(list, &eye, run, light)
            bat(list, &eye, run)
            progress(list, run)

    def render(list: mutable Display::DisplayList&, session: EchoCaveGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Echo Cave", CX, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Mouse or arrows / WASD: steer   Space: click   Esc: menu",
                CX, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            msg: mutable dstr = []
            if session.phase == EchoCaveGame::READY:
                dstr_append_cstr(&msg, "Press Space or click to start")
            elif session.phase == EchoCaveGame::DONE:
                dstr_append_i64(&msg, session.passed_count)
                dstr_append_cstr(&msg, " of ")
                dstr_append_i64(&msg, session.trial)
                dstr_append_cstr(&msg, " passed   highest rung passed ")
                dstr_append_i64(&msg, session.best_rung)
            elif session.phase == EchoCaveGame::JUDGED:
                EchoCave::result_text(&session.run, &msg)
            elif session.run.cave.level.see != 0.0:
                dstr_append_cstr(&msg, "Fly through; catch ")
                dstr_append_i64(&msg, session.run.cave.level.need)
                dstr_append_cstr(&msg, " moths")
            elif session.run.cave.level.flash != 0.0:
                dstr_append_cstr(&msg, "Dark: Space clicks and lights the cave")
            else:
                dstr_append_cstr(&msg, "No light: fly by the echoes of your clicks")
            Display::draw_text(list, bytes_view(msg), CX, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if session.phase >= EchoCaveGame::JUDGED and session.run.result != EchoCave::PENDING:
                verdict: mutable dstr = []
                EchoCave::result_text(&session.run, &verdict)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.run.result == EchoCave::ESCAPED, bytes_view(verdict), 60.0, 16.0)
            return if session.phase == EchoCaveGame::READY or session.phase == EchoCaveGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_cstr(&facts, "moths ")
            dstr_append_i64(&facts, session.run.caught)
            dstr_append_cstr(&facts, " of ")
            dstr_append_i64(&facts, session.run.cave.level.need)
            Display::draw_text(list, bytes_view(facts), CX, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            stage(list, &session.run)

    def option_note(rung: i64, out: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: EchoCave::Grade = EchoCave::grade(rung)
            dstr_append_cstr(out, "Rung ")
            dstr_append_i64(out, level.rung)
            dstr_append_cstr(out, ": catch ")
            dstr_append_i64(out, level.need)
            dstr_append_cstr(out, " of ")
            dstr_append_i64(out, level.moths)
            dstr_append_cstr(out, " moths. ")
            if level.see > 0.0:
                dstr_append_cstr(out, "The cave is lit." if level.see >= 60.0 else "Only the near cave is lit.")
            elif level.flash > 0.0:
                dstr_append_cstr(out, "Clicks briefly light the cave.")
            else:
                dstr_append_cstr(out, "Fly by sound alone.")
