include "./tasks/unicycle_game.elisa"
include "./scene_live_view.elisa"
include "./scene_polish.elisa"
include "./scene_verdict.elisa"

module SceneUnicycle:
    const SCALE: f64 = 70.0
    const PI: f64 = 3.141592653589793
    const LEFT: f64 = (LiveView::WIDTH - LiveView::VIEW_WIDTH) / 2.0
    const RIGHT: f64 = LEFT + LiveView::VIEW_WIDTH
    const RIM: f64 = Unicycle::RADIUS * SCALE

    struct View:
        x: f64
        y: f64
        bottom: f64
        top: f64

    def view(run: Unicycle::Run&) -> View:
        can Abort.Panic:
            bottom: f64 = Verdict::above_the_band(LiveView::HEIGHT, Geometry::from_bottom_edge(LiveView::HEIGHT, 58.0).f64()).f64()
            top: f64 = fmax(bottom + 40.0, Geometry::from_top_edge(LiveView::HEIGHT, 116.0).f64())
            b: Unicycle::Body& = &run.body
            return View{x: b.px + 1.5, y: (b.py + Unicycle::ground(&run.track, b.px)) / 2.0 + 0.8, bottom: bottom, top: top}

    def point(x: f64, y: f64) -> RoomsView::Point:
        return RoomsView::Point{x: x, y: y}

    def at(v: View, x: f64, y: f64) -> RoomsView::Point:
        return point(LiveView::CX + (x - v.x) * SCALE, v.bottom + (v.top - v.bottom) / 2.0 + (y - v.y) * SCALE)

    def boundary(v: View, p: RoomsView::Point, edge: i64) -> f64:
        return p.x - LEFT if edge == 0
        return RIGHT - p.x if edge == 1
        return p.y - v.bottom if edge == 2
        return v.top - p.y

    def along(a: RoomsView::Point, b: RoomsView::Point, t: f64) -> RoomsView::Point:
        return point(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t)

    def segment(list: mutable Display::DisplayList&, v: View, a: RoomsView::Point, b: RoomsView::Point, width: f64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            low: mutable f64 = 0.0
            high: mutable f64 = 1.0
            for edge in 0..<4 |v, a, b, low, high|:
                first: f64 = boundary(v, a, edge)
                last: f64 = boundary(v, b, edge)
                return if first < 0.0 and last < 0.0
                if (first < 0.0) != (last < 0.0):
                    t: f64 = first / (first - last)
                    if first < 0.0:
                        low <- fmax(low, t)
                    else:
                        high <- fmin(high, t)
            return if low > high
            p: RoomsView::Point = along(a, b, low)
            q: RoomsView::Point = along(a, b, high)
            Display::draw_line(list, p.x, p.y, q.x, q.y, width, ink)

    def face(list: mutable Display::DisplayList&, v: View, a: RoomsView::Point, b: RoomsView::Point,
             c: RoomsView::Point, d: RoomsView::Point, count: i64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            points: mutable RoomsView::Point[8] = zeroed
            points[0] <- a
            points[1] <- b
            points[2] <- c
            points[3] <- d
            length: mutable i64 = count
            for edge in 0..<4 |v, points, length|:
                return if length < 3
                cut: mutable RoomsView::Point[8] = zeroed
                kept: mutable i64 = 0
                prior: mutable RoomsView::Point = points[(length - 1).usize()]
                for i in 0..<length |v, points, cut, kept, prior, edge|:
                    p: RoomsView::Point = points[i.usize()]
                    first: f64 = boundary(v, prior, edge)
                    last: f64 = boundary(v, p, edge)
                    if (first >= 0.0) != (last >= 0.0):
                        cut[kept.usize()] <- along(prior, p, first / (first - last))
                        kept <- kept + 1
                    if last >= 0.0:
                        cut[kept.usize()] <- p
                        kept <- kept + 1
                    prior <- p
                points <- cut
                length <- kept
            return if length < 3
            Display::begin_polygon(list, length, points[0].x, points[0].y, ink)
            for i in 0..<length |list, points|:
                p: RoomsView::Point = points[i.usize()]
                Display::polygon_point(list, p.x, p.y)

    def circle(list: mutable Display::DisplayList&, v: View, p: RoomsView::Point, radius: f64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            dx: f64 = fmin(p.x - LEFT, RIGHT - p.x)
            dy: f64 = fmin(p.y - v.bottom, v.top - p.y)
            return if dx < 0.0 or dy < 0.0
            Display::draw_circle(list, p.x, p.y, fmax(0.5, fmin(radius, fmin(dx, dy))), ink)

    def terrain(list: mutable Display::DisplayList&, v: View, track: Unicycle::Track&):
        can Memory.Allocate, Abort.Panic:
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: LEFT - 4.0, y: v.bottom - 4.0,
                w: LiveView::VIEW_WIDTH + 8.0, h: v.top - v.bottom + 8.0}
            shade: u32[3] = [30.u32(), 18.u32(), 12.u32()]
            for i in 0..<3 |list, box, shade|:
                spread: f64 = i.f64() * 2.0
                halo: SceneHiddenRule::Rect = ScenePolish::spread_box(&box, spread, 4.0)
                ScenePolish::rounded(list, &halo, 14.0 + spread, shade[i.usize()])
            ScenePolish::rounded(list, &box, 14.0, 0x96c8ebff)
            for k in -2..<8 |list, v|:
                raw: f64 = fmod(k.f64() * 9.0 - v.x * 0.3, 90.0)
                hx: f64 = (raw + 90.0 if raw < 0.0 else raw) - 20.0
                base: f64 = LEFT + (hx / 70.0) * LiveView::VIEW_WIDTH
                a: RoomsView::Point = point(base, v.bottom)
                b: RoomsView::Point = point(base + 160.0, v.bottom + (v.top - v.bottom) * 0.55)
                face(list, v, a, b, point(base + 320.0, v.bottom), a, 3, 0xafd2e1ff)
            half: f64 = LiveView::VIEW_WIDTH / 2.0 / SCALE + 1.0
            x: mutable f64 = v.x - half
            while x < v.x + half |list, v, track, half, x|:
                next: f64 = x + Unicycle::DX
                a: RoomsView::Point = at(v, x, Unicycle::ground(track, x))
                b: RoomsView::Point = at(v, next, Unicycle::ground(track, next))
                face(list, v, point(a.x, v.bottom), a, b, point(b.x, v.bottom), 4, 0x6e543cff)
                segment(list, v, a, b, 5.0, 0x5aa046ff)
                x <- next
            finish: f64 = track.finish
            y: f64 = Unicycle::ground(track, finish)
            base: RoomsView::Point = at(v, finish, y)
            top: RoomsView::Point = at(v, finish, y + 2.4)
            segment(list, v, base, top, 3.0, 0xf0f0f0ff)
            face(list, v, top, at(v, finish + 0.9, y + 2.1), at(v, finish, y + 1.8), base, 3, 0xe63c3cff)

    def rider(list: mutable Display::DisplayList&, v: View, b: Unicycle::Body&):
        can Memory.Allocate, Abort.Panic:
            wheel: RoomsView::Point = at(v, b.px, b.py)
            circle(list, v, wheel, RIM, 0x28282eff)
            circle(list, v, wheel, RIM - 6.0, 0xc8cdd7ff)
            for i in 0..<6 |list, v, b, wheel|:
                angle: f64 = b.a + i.f64() * PI / 3.0
                p: RoomsView::Point = point(wheel.x + cos(angle) * (RIM - 6.0), wheel.y + sin(angle) * (RIM - 6.0))
                segment(list, v, wheel, p, 2.0, 0x5a5a64ff)
            seat: RoomsView::Point = at(v, b.qx, b.qy)
            top: RoomsView::Point = at(v, b.px + (b.qx - b.px) * 1.32, b.py + (b.qy - b.py) * 1.32)
            segment(list, v, wheel, seat, 4.0, 0x3c3c46ff)
            for i in 0..<2 |list, v, b, wheel, seat|:
                angle: f64 = b.a + i.f64() * PI
                pedal: RoomsView::Point = point(wheel.x + cos(angle) * 0.16 * SCALE, wheel.y + sin(angle) * 0.16 * SCALE)
                knee: RoomsView::Point = point((seat.x + pedal.x) / 2.0 + 0.22 * SCALE, (seat.y + pedal.y) / 2.0 + 0.05 * SCALE)
                segment(list, v, seat, knee, 7.0, 0x283c8cff)
                segment(list, v, knee, pedal, 6.0, 0x283c8cff)
            segment(list, v, seat, top, 12.0, 0xdc5a3cff)
            segment(list, v, top, point((seat.x + top.x) / 2.0 + 0.35 * SCALE, (seat.y + top.y) / 2.0), 5.0, 0xdc5a3cff)
            head: Unicycle::Point = Unicycle::head(b)
            circle(list, v, at(v, head.x, head.y), 0.17 * SCALE, 0xf0c8aaff)

    def label(list: mutable Display::DisplayList&, words: sview, y: f64, size: f64, ink: u32, bold: bool = false):
        can Memory.Allocate, Abort.Panic:
            Display::draw_text_weight(list, words, LiveView::CX, y, size, ink, Display::ANCHOR_CENTER_CENTER, bold)

    def verdict_text(run: Unicycle::Run&, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.result == Unicycle::CLEAR:
                dstr_append_cstr(words, "At the flag in ")
                dstr_append_fixed(words, py_round_decimal(run.t, 10.0), 1)
                dstr_append_cstr(words, " s")
            elif run.result == Unicycle::HEAD_OVER_HEELS:
                dstr_append_cstr(words, "Head over heels")
            elif run.result == Unicycle::FELL:
                dstr_append_cstr(words, "Fell off")
            elif run.result == Unicycle::TIMEOUT:
                dstr_append_cstr(words, "Out of time, ")
                dstr_append_i64(words, py_round_half_even(run.track.finish - run.body.px))
                dstr_append_cstr(words, " m to go")

    def render(list: mutable Display::DisplayList&, session: UnicycleGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            label(list, "Unicycle", 648.0, 22.0, ink, true)
            label(list, "Up / Down: pedal / back-pedal   Left / Right: lean back / forward   Esc: menu", 26.0, 12.0, ink)
            caption: mutable dstr = []
            verdict_text(&session.run, &caption)
            status: mutable dstr = []
            if session.phase == UnicycleGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == UnicycleGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == UnicycleGame::JUDGED:
                status <- caption
            else:
                dstr_append_cstr(&status, "Ride to the flag. Keep your head off the ground")
            label(list, bytes_view(status), 614.0, 14.0, ink)
            if session.phase == UnicycleGame::PLAYING or session.phase == UnicycleGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                dstr_append_cstr(&facts, "   ")
                dstr_append_i64(&facts, py_round_half_even(fmax(0.0, session.run.track.seconds - session.run.t)))
                dstr_append_cstr(&facts, " s left")
                label(list, bytes_view(facts), 588.0, 12.0, ink)
                v: View = view(&session.run)
                terrain(list, v, &session.run.track)
                rider(list, v, &session.run.body)
                width: f64 = LiveView::VIEW_WIDTH - 40.0
                share: f64 = fmax(0.0, fmin(1.0, session.run.body.px / session.run.track.finish))
                Display::draw_rect(list, LEFT + 20.0, v.top - 22.0, width, 6.0, 0x3c465aff)
                Display::draw_rect(list, LEFT + 20.0, v.top - 22.0, width * share, 6.0, 0xfadc5aff) if share > 0.0
            if session.phase == UnicycleGame::JUDGED or session.phase == UnicycleGame::DONE:
                SceneVerdict::put(list, LiveView::WIDTH, LiveView::HEIGHT, 1.0, 1.0, session.run.result == Unicycle::CLEAR,
                    bytes_view(caption), 60.0, 16.0)

    def option_note(rung: i64, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: Unicycle::Grade = Unicycle::grade(rung)
            dstr_append_cstr(words, "Rung ")
            dstr_append_i64(words, level.rung)
            dstr_append_cstr(words, ": ")
            dstr_append_i64(words, py_round_half_even(level.length))
            dstr_append_cstr(words, " m.")
            dstr_append_cstr(words, "  Hills.") if level.hills != 0.0
            dstr_append_cstr(words, "  Steps.") if level.steps != 0.0
            dstr_append_cstr(words, "  Ledges.") if level.pits > 0
