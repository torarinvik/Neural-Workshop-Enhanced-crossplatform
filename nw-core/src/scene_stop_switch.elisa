include "tasks/stop_switch_game.elisa"
include "scene_polish.elisa"

module SceneStopSwitch:
    const CENTER: f64 = 456.0
    const WIDTH: f64 = 857.28
    const LEFT: f64 = 27.36
    const HEIGHT: f64 = 389.0
    const BOTTOM: f64 = 179.0
    const MID_Y: f64 = BOTTOM + HEIGHT * 0.5
    const UNIT: f64 = HEIGHT * 0.1
    const BLUE: u32 = 0x3c78dcff
    const ORANGE: u32 = 0xec8c28ff
    const STOP: u32 = 0xdc2828ff
    const CORRECT: u32 = 0x3caa5aff
    const WRONG: u32 = 0xd6403aff

    def option_note(rung: i64, note: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: StopSwitch::Grade = StopSwitch::grade(rung)
            dstr_append_cstr(note, "Rung ")
            dstr_append_i64(note, level.rung)
            dstr_append_cstr(note, ": ")
            dstr_append_i64(note, level.count)
            dstr_append_cstr(note, " stimuli, ")
            dstr_append_fixed(note, level.window, 2)
            dstr_append_cstr(note, " s to answer, ")
            dstr_append_i64(note, (level.needed * 100.0).i64())
            dstr_append_cstr(note, "% right needed.")
            if level.stops > 0.0:
                dstr_append_cstr(note, "  Stops on ")
                dstr_append_i64(note, (level.stops * 100.0).i64())
                dstr_append_cstr(note, "%, ")
                dstr_append_fixed(note, level.stop_delay, 2)
                dstr_append_cstr(note, " s in.")
            if level.rules > 1:
                dstr_append_cstr(note, "  Rules shape/colour")
                if level.rules == 3:
                    dstr_append_cstr(note, "/opposite")
                dstr_append_cstr(note, ", changing on a beat." if level.rung < 13 else ", changing at random.")

    def hit(run: StopSwitchGame::Run&) -> i64:
        return StopSwitchGame::START if run.phase == StopSwitchGame::READY or run.phase == StopSwitchGame::DONE
        return -1

    def rule_label(rule: i64) -> sview:
        return "SHAPE" if rule == StopSwitch::SHAPE
        return "COLOUR" if rule == StopSwitch::COLOUR
        return "OPPOSITE"

    def draw_rule(list: mutable Display::DisplayList&, stimulus: StopSwitch::Stimulus, dark: bool):
        can Memory.Allocate, Abort.Panic:
            width: f64 = WIDTH * 0.3
            height: f64 = HEIGHT * 0.1
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: CENTER - width / 2.0,
                y: BOTTOM + HEIGHT * 0.84, w: width, h: height}
            color: u32 = 0x966ec8ff if stimulus.rule == StopSwitch::SHAPE else (0x3caaa0ff if stimulus.rule == StopSwitch::COLOUR else 0x787c86ff)
            ScenePolish::shadow(list, &box, height / 2.0, 3.0, dark)
            ScenePolish::rounded(list, &box, height / 2.0, color)
            SceneHiddenRule::text(list, rule_label(stimulus.rule), CENTER, box.y + height / 2.0,
                SceneHiddenRule::minimum(20.0, height / 2.0), 0xffffffff, Display::ANCHOR_CENTER_CENTER, true)

    def stimulus_face(list: mutable Display::DisplayList&, stimulus: StopSwitch::Stimulus, ring: bool, dark: bool):
        can Memory.Allocate, Abort.Panic:
            x: f64 = CENTER + stimulus.side.f64() * WIDTH * 0.2
            color: u32 = BLUE if stimulus.colour == 0 else ORANGE
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: x - UNIT * 0.9,
                y: MID_Y - UNIT * 0.9, w: UNIT * 1.8, h: UNIT * 1.8}
            circle: bool = stimulus.shape == 0
            ScenePolish::shadow(list, &box, UNIT * (0.9 if circle else 0.25), UNIT * 0.12, dark)
            if circle:
                Display::draw_circle(list, x, MID_Y, UNIT, 0x2a549aff if stimulus.colour == 0 else 0xa5621cff)
                Display::draw_circle(list, x, MID_Y + UNIT * 0.04, UNIT * 0.84, color)
                Display::draw_circle(list, x - UNIT * 0.3, MID_Y + UNIT * 0.3, UNIT * 0.22, 0xffffff8c)
            else:
                ScenePolish::rounded(list, &box, UNIT * 0.22, color)
            if ring:
                radius: f64 = UNIT * 1.6
                segments: i64 = (radius / 1.25).i64()
                angle: f64 = 6.283185307179586 / segments.f64()
                for segment in 0..<segments |list, x, radius, angle|:
                    a: f64 = segment.f64() * angle
                    b: f64 = (segment + 1).f64() * angle
                    Display::draw_line(list, x + cos(a) * radius, MID_Y + sin(a) * radius,
                        x + cos(b) * radius, MID_Y + sin(b) * radius, UNIT * 0.25, STOP)

    def keycap(list: mutable Display::DisplayList&, side: i64, ink: u32, muted: u32, dark: bool):
        can Memory.Allocate, Abort.Panic:
            x: f64 = LEFT + WIDTH * (0.08 if side == 0 else 0.92)
            size: f64 = SceneHiddenRule::minimum(WIDTH * 0.1, HEIGHT * 0.16)
            box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: x - size / 2.0, y: MID_Y - size / 2.0, w: size, h: size}
            face: u32 = 0x262b38ff if dark else 0xffffffff
            radius: f64 = size * 0.16
            lip: f64 = SceneHiddenRule::minimum(5.0, size * 0.08)
            ScenePolish::shadow(list, &box, radius, 3.0, dark)
            ScenePolish::rounded(list, &box, radius, 0x1f232eff if dark else 0xd1d1d1ff)
            top: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: box.x, y: box.y + lip, w: box.w, h: box.h - lip}
            ScenePolish::rounded(list, &top, radius, face)
            SceneHiddenRule::text(list, "F" if side == 0 else "J", x, MID_Y + size * 0.06, 22.0,
                ink, Display::ANCHOR_CENTER_CENTER, true)
            SceneHiddenRule::text(list, "left" if side == 0 else "right", x, MID_Y - size * 0.82, 13.0, muted)

    def progress(list: mutable Display::DisplayList&, run: StopSwitchGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            count: i64 = run.block.level.count
            spacing: f64 = SceneHiddenRule::minimum(WIDTH * 0.8 / count.f64(), UNIT * 0.7)
            first: f64 = CENTER - spacing * (count - 1).f64() / 2.0
            pending: u32 = 0x313746ff if dark else 0xdce2ebff
            for i in 0..<count |list, run, spacing, first, pending|:
                marked: bool = (run.marks & (1 << i.u64())) != 0
                color: u32 = pending if i >= run.index else (CORRECT if marked else WRONG)
                box: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: first + i.f64() * spacing - spacing * 0.32,
                    y: BOTTOM + HEIGHT * 0.06 - spacing * 0.16, w: spacing * 0.64, h: spacing * 0.32}
                ScenePolish::rounded(list, &box, spacing * 0.16, color)

    def status(run: StopSwitchGame::Run&, label: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.phase == StopSwitchGame::READY:
                dstr_append_cstr(label, "Press Space or click to start")
            elif run.phase == StopSwitchGame::DONE:
                dstr_append_i64(label, run.passed_count)
                dstr_append_cstr(label, " of ")
                dstr_append_i64(label, run.trial)
                dstr_append_cstr(label, " passed   highest rung passed ")
                dstr_append_i64(label, run.best_rung)
            elif run.phase == StopSwitchGame::JUDGED:
                threshold: f64 = run.block.level.needed * run.index.f64()
                whole: i64 = threshold.i64()
                dstr_append_i64(label, run.hits)
                dstr_append_cstr(label, " of ")
                dstr_append_i64(label, run.index)
                dstr_append_cstr(label, " right (")
                dstr_append_i64(label, whole + 1 if threshold > whole.f64() else whole)
                dstr_append_cstr(label, " needed)")
            else:
                dstr_append_cstr(label, "Answer by the rule; a red ring means stop")

    def render(list: mutable Display::DisplayList&, run: StopSwitchGame::Run&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            muted: u32 = 0x969eb0ff if dark else 0x70788aff
            SceneHiddenRule::text(list, "Stop & Switch", CENTER, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            message: mutable dstr = []
            status(run, &message)
            SceneHiddenRule::text(list, bytes_view(message), CENTER, 614.0, 14.0, ink)
            SceneHiddenRule::text(list, "F or Left: left   J or Right: right   red ring: do nothing   Esc: menu",
                CENTER, 26.0, 12.0, ink)
            return if run.phase == StopSwitchGame::READY or run.phase == StopSwitchGame::DONE
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, run.rung)
            dstr_append_cstr(&facts, "  block ")
            dstr_append_i64(&facts, run.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, run.total)
            dstr_append_cstr(&facts, "   ")
            dstr_append_i64(&facts, run.hits)
            dstr_append_cstr(&facts, " of ")
            dstr_append_i64(&facts, run.index)
            dstr_append_cstr(&facts, "   ")
            dstr_append_fixed(&facts, run.block.level.window, 2)
            dstr_append_cstr(&facts, " s to answer")
            SceneHiddenRule::text(list, bytes_view(facts), CENTER, 588.0, 12.0, ink)
            stage: SceneHiddenRule::Rect = SceneHiddenRule::Rect{x: CENTER - WIDTH * 0.33,
                y: MID_Y - HEIGHT * 0.3, w: WIDTH * 0.66, h: HEIGHT * 0.6}
            ScenePolish::card_face(list, &stage, 22.0, 0x181b24ff if dark else 0xecf0f6ff,
                0x424a5cff if dark else 0xd2d8e4ff, 0.u32(), dark)
            if run.index < run.block.level.count:
                item: StopSwitch::Stimulus = run.block.stimuli[run.index.usize()]
                if run.showing or run.block.level.prepared:
                    draw_rule(list, item, dark)
                if run.showing:
                    stimulus_face(list, item, run.ring, dark)
                else:
                    arm: f64 = UNIT * 0.22
                    Display::draw_line(list, CENTER - arm, MID_Y, CENTER + arm, MID_Y, 2.0, muted)
                    Display::draw_line(list, CENTER, MID_Y - arm, CENTER, MID_Y + arm, 2.0, muted)
            keycap(list, 0, ink, muted, dark)
            keycap(list, 1, ink, muted, dark)
            progress(list, run, dark)
            if run.phase == StopSwitchGame::JUDGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.passed, bytes_view(message), 60.0, 16.0)
