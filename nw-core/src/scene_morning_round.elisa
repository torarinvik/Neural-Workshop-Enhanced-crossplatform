include "./scene_hand.elisa"
include "./tasks/morning_round_game.elisa"
include "./tasks/morning_round_words.elisa"
include "./textmetrics.elisa"
include "./geometry.elisa"
include "./scene_verdict.elisa"

module SceneMorningRound:
    const INK: u32 = 0x1e1e28ff
    const PANEL: u32 = 0x222636ff
    const PALE: u32 = 0xe6e8f0ff
    const DIM: u32 = 0x969cb0ff
    const ROAD: u32 = 0x5c5e66ff
    const DASH: u32 = 0xe6dc96ff
    const RIDER_Y: f64 = 140.0
    const PI: f64 = 3.141592653589793

    def point(x: f64, y: f64) -> RoomsView::Vec:
        return RoomsView::vec(x, y, 1.0)

    def rect(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            left: f64 = fmax(0.0, x)
            bottom: f64 = fmax(0.0, y)
            width: f64 = fmin(1000.0, x + w) - left
            height: f64 = fmin(640.0, y + h) - bottom
            if width > 0.0 and height > 0.0:
                Display::draw_rect(list, SceneHand::x(left), SceneHand::y(bottom),
                    width * SceneHand::SCALE, height * SceneHand::SCALE, colour)

    def line(list: mutable Display::DisplayList&, x1: f64, y1: f64, x2: f64, y2: f64, w: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            SceneHand::line(list, point(x1, y1), point(x2, y2), w, colour)

    def triangle(list: mutable Display::DisplayList&, a: RoomsView::Vec, b: RoomsView::Vec, c: RoomsView::Vec, colour: u32):
        can Memory.Allocate, Abort.Panic:
            pts: mutable RoomsView::Vec[32] = zeroed
            pts[0] <- a
            pts[1] <- b
            pts[2] <- c
            SceneHand::polygon(list, &pts, 3, colour)

    def oval(list: mutable Display::DisplayList&, x: f64, y: f64, rx: f64, ry: f64, colour: u32, count: i64 = 20):
        can Memory.Allocate, Abort.Panic:
            pts: mutable RoomsView::Vec[32] = zeroed
            for i in 0..<count |pts, x, y, rx, ry, count|:
                angle: f64 = 2.0 * PI * i.f64() / count.f64()
                pts[i.usize()] <- point(x + rx * cos(angle), y + ry * sin(angle))
            SceneHand::polygon(list, &pts, count, colour)

    def disc(list: mutable Display::DisplayList&, x: f64, y: f64, r: f64, colour: u32):
        can Memory.Allocate, Abort.Panic:
            if y - r >= 0.0 and y + r <= 640.0:
                Display::draw_circle(list, SceneHand::x(x), SceneHand::y(y), r * SceneHand::SCALE, colour)
            else:
                oval(list, x, y, r, r, colour, 16)

    def street_y(run: MorningRoundRide::Run&, d: f64) -> f64:
        return RIDER_Y + (d - run.s)

    def wrap_position(value: f64, span: f64) -> f64:
        return value - span * floor(value / span)

    def road(list: mutable Display::DisplayList&, s: f64):
        can Memory.Allocate, Abort.Panic:
            rect(list, 320.0, 0.0, 560.0, 640.0, 0x70a85cff)
            for k in 0..<12 |list, s|:
                rect(list, 320.0, wrap_position(k.f64() * 120.0 - s, 1440.0) - 120.0, 560.0, 60.0, 0x649c54ff)
            rect(list, MorningRound::ROAD_LEFT, 0.0, MorningRound::ROAD_RIGHT - MorningRound::ROAD_LEFT, 640.0, ROAD)
            rect(list, MorningRoundRide::LEFT_FRONT + 4.0, 0.0, 16.0, 640.0, 0xc4c4bcff)
            rect(list, MorningRoundRide::RIGHT_FRONT - 20.0, 0.0, 16.0, 640.0, 0xc4c4bcff)
            for k in 0..<10 |list, s|:
                rect(list, 598.0, wrap_position(k.f64() * 80.0 - s, 800.0) - 80.0, 4.0, 40.0, DASH)

    def letter(rule: i64) -> sview:
        can Abort.Panic:
            labels: sview[8] = ["A", "B", "C", "D", "E", "F", "G", "H"]
            return labels[rule.usize()]

    def sign(list: mutable Display::DisplayList&, y: f64, rule: i64):
        can Memory.Allocate, Abort.Panic:
            x: f64 = MorningRound::ROAD_RIGHT + 30.0
            rect(list, x - 2.0, y - 30.0, 4.0, 30.0, 0x505050ff)
            rect(list, x - 22.0, y, 44.0, 34.0, 0xfafafaff)
            rect(list, x - 20.0, y + 2.0, 40.0, 30.0, 0x1e5aaaff)
            SceneHand::word(list, letter(rule), x, y + 17.0, 18.0, PALE, true)

    def landmark(list: mutable Display::DisplayList&, kind: i64, y: f64):
        can Memory.Allocate, Abort.Panic:
            x: f64 = 352.0
            if kind == 0:
                rect(list, x - 16.0, y - 14.0, 32.0, 26.0, 0xc8c8d2ff)
                rect(list, x - 2.0, y + 12.0, 4.0, 18.0, 0x50505aff)
                rect(list, x - 8.0, y + 22.0, 16.0, 4.0, 0x50505aff)
            elif kind == 1:
                rect(list, x - 18.0, y - 12.0, 36.0, 24.0, 0xe6963cff)
                rect(list, x - 18.0, y + 6.0, 36.0, 6.0, 0xc83c3cff)
            elif kind == 2:
                disc(list, x - 10.0, y, 9.0, 0x3c823cff)
                disc(list, x + 8.0, y + 6.0, 9.0, 0x3c823cff)
                disc(list, x + 2.0, y - 10.0, 9.0, 0x3c823cff)
            else:
                rect(list, x - 18.0, y - 12.0, 36.0, 24.0, 0xbe6e5aff)
                rect(list, x - 3.0, y + 12.0, 6.0, 12.0, 0x5a5a5aff)
            if y - 24.0 > 10.0 and y - 24.0 < 630.0:
                names: sview[4] = ["CHURCH", "SHOP", "PARK", "SCHOOL"]
                SceneHand::word(list, names[kind.usize()], x, y - 24.0, 8.0, INK, true)

    def crossroads(list: mutable Display::DisplayList&, run: MorningRoundRide::Run&):
        can Memory.Allocate, Abort.Panic:
            level: MorningRound::Grade = run.street.layout.level
            for b in 0..<level.blocks |list, run, level|:
                block: MorningRound::Block = run.street.layout.blocks[b.usize()]
                if b + 1 < level.blocks:
                    next: MorningRound::Block = run.street.layout.blocks[(b + 1).usize()]
                    y: f64 = street_y(run, (block.end + next.start) / 2.0)
                    if y > -90.0 and y < 730.0:
                        rect(list, 320.0, y - 45.0, 560.0, 90.0, ROAD)
                        for j in 0..<14 |list, y|:
                            x: f64 = 330.0 + 40.0 * j.f64()
                            if x <= MorningRound::ROAD_LEFT - 10.0 or x >= MorningRound::ROAD_RIGHT + 10.0:
                                rect(list, x, y - 2.0, 22.0, 4.0, DASH)
                        if level.mode == MorningRound::SIGN:
                            sign(list, y - 70.0, run.street.active[(b + 1).usize()])
                y: f64 = street_y(run, block.start - 20.0)
                landmark(list, block.landmark, y) if y > -60.0 and y < 700.0

    def star_tip(x: f64, y: f64, at: i64) -> RoomsView::Vec:
        angle: f64 = PI / 2.0 + at.f64() * PI / 5.0
        radius: f64 = 16.0 if at % 2 == 0 else 7.2
        return point(x + radius * cos(angle), y + radius * sin(angle))

    def house(list: mutable Display::DisplayList&, h: MorningRound::House, y: f64, got: i64):
        can Memory.Allocate, Abort.Panic:
            left: bool = h.side < 0
            x0: f64 = 340.0 if left else 760.0
            x1: f64 = x0 + 100.0
            half: f64 = (MorningRoundRide::HOUSE_LENGTH - 16.0) / 2.0
            cx: f64 = x0 + 50.0
            rect(list, x0 - 3.0, y - half - 3.0, 106.0, 2.0 * half + 6.0, 0xece0c8ff)
            if h.pointed:
                rect(list, x0, y - half, 100.0, 2.0 * half, 0x964638ff)
                line(list, x0 + 18.0, y, x1 - 18.0, y, 3.0, 0x64281eff)
                line(list, x0, y - half, x0 + 18.0, y, 2.0, 0x64281eff)
                line(list, x0, y + half, x0 + 18.0, y, 2.0, 0x64281eff)
                line(list, x1, y - half, x1 - 18.0, y, 2.0, 0x64281eff)
                line(list, x1, y + half, x1 - 18.0, y, 2.0, 0x64281eff)
            else:
                rect(list, x0, y - half, 100.0, 2.0 * half, 0xaaacb2ff)
                rect(list, x0 + 6.0, y - half + 6.0, 88.0, 2.0 * half - 12.0, 0x9698a0ff)
            face: f64 = x1 if left else x0
            out: f64 = 1.0 if left else -1.0
            lit: u32 = 0xfffce1ff if h.lights else 0x242c46ff
            window: f64 = face if left else face - 8.0
            rect(list, window, y - 36.0, 8.0, 16.0, lit)
            rect(list, window, y + 20.0, 8.0, 16.0, lit)
            doors: u32[4] = [0xd2322cff, 0x3264dcff, 0x289646ff, 0xf0c828ff]
            rect(list, face if left else face - 13.0, y - 13.0, 13.0, 26.0, doors[h.door.usize()])
            if h.cat:
                cat: f64 = face + out * 18.0
                oval(list, cat, y + 2.0, 7.0, 5.0, 0x787882ff)
                triangle(list, point(cat - 6.0, y + 6.0), point(cat - 3.0, y + 12.0), point(cat, y + 6.0), 0x787882ff)
                triangle(list, point(cat, y + 6.0), point(cat + 3.0, y + 12.0), point(cat + 6.0, y + 6.0), 0x787882ff)
            if h.dog:
                dog: f64 = face + out * 34.0
                oval(list, dog, y - 30.0, 12.0, 7.0, 0x8c5a32ff)
                disc(list, dog + out * 12.0, y - 26.0, 6.0, 0x8c5a32ff)
            mail: f64 = MorningRoundRide::LEFT_FRONT - 6.0 if left else MorningRoundRide::RIGHT_FRONT + 6.0
            rect(list, mail - 6.0, y + 30.0, 12.0, 10.0, 0x3c3c46ff)
            if h.flag:
                rect(list, mail + 4.0, y + 38.0, 4.0, 14.0, 0xdc2828ff)
            else:
                rect(list, mail + 4.0, y + 30.0, 10.0, 3.0, 0x787878ff)
            if y - 44.0 > 10.0 and y - 44.0 < 630.0:
                SceneHand::number(list, h.number, point(mail, y - 44.0), 10.0, INK)
            if h.sign:
                for k in 0..<10 |list, cx, y|:
                    triangle(list, point(cx, y), star_tip(cx, y, k), star_tip(cx, y, (k + 1) % 10), 0xffd628ff)
            if got == MorningRoundRide::DELIVERED:
                line(list, cx - 12.0, y, cx - 3.0, y - 10.0, 5.0, 0x3cc85aff)
                line(list, cx - 3.0, y - 10.0, cx + 14.0, y + 12.0, 5.0, 0x3cc85aff)
            elif got == MorningRoundRide::WRONG:
                line(list, cx - 12.0, y - 12.0, cx + 12.0, y + 12.0, 5.0, 0xe63228ff)
                line(list, cx - 12.0, y + 12.0, cx + 12.0, y - 12.0, 5.0, 0xe63228ff)
            elif got == MorningRoundRide::MISSED:
                disc(list, cx, y, 14.0, 0xfa9628ff)
                SceneHand::word(list, "!", cx, y, 16.0, INK, true) if y > 10.0 and y < 630.0

    def traffic(list: mutable Display::DisplayList&, run: MorningRoundRide::Run&):
        can Memory.Allocate, Abort.Panic:
            for k in 0..<run.street.traffic.count |list, run|:
                continue if run.hit[k.usize()]
                th: MorningRound::Thing = run.street.traffic.things[k.usize()]
                x: f64 = th.x
                y: f64 = street_y(run, MorningRoundRide::thing_d(run, th))
                continue if y <= -60.0 or y >= 700.0
                if th.kind == MorningRound::CONE:
                    triangle(list, point(x - 11.0, y - 10.0), point(x + 11.0, y - 10.0), point(x, y + 12.0), 0xfa821eff)
                elif th.kind == MorningRound::BIN:
                    disc(list, x, y, th.radius, 0x466e50ff)
                    disc(list, x, y, th.radius - 4.0, 0x5a8c64ff)
                elif th.kind == MorningRound::CAR:
                    rect(list, x - 22.0, y - 36.0, 44.0, 72.0, 0x5a78c8ff)
                    rect(list, x - 17.0, y - 14.0, 34.0, 28.0, 0xb4d2f0ff)
                else:
                    line(list, x, y - 14.0, x, y + 14.0, 4.0, 0x282828ff)
                    disc(list, x, y - 2.0, 7.0, 0xc83ca0ff)

    def rider(list: mutable Display::DisplayList&, run: MorningRoundRide::Run&):
        can Memory.Allocate, Abort.Panic:
            x: f64 = run.x
            y: f64 = RIDER_Y
            if run.t < run.down_until:
                line(list, x - 16.0, y - 8.0, x + 16.0, y + 8.0, 4.0, 0x1e1e1eff)
                disc(list, x + 10.0, y - 10.0, 8.0, 0xfac8a0ff)
                return
            line(list, x, y - 18.0, x, y + 18.0, 4.0, 0x1e1e1eff)
            line(list, x - 10.0, y + 10.0, x + 10.0, y + 10.0, 3.0, 0x3c3c3cff)
            disc(list, x, y, 9.0, 0xe6463cff)
            disc(list, x, y + 4.0, 6.0, 0xfac8a0ff)
            SceneHand::number(list, run.papers, point(x + 22.0, y - 14.0), 9.0, PALE)
            for k in 0..<run.flying_count |list, run|:
                p: MorningRoundRide::Paper = run.flying[k.usize()]
                rect(list, p.x - 7.0, street_y(run, p.d) - 3.0, 14.0, 6.0, 0xfafafaff)

    def paragraph(list: mutable Display::DisplayList&, text: sview, y: f64, size: f64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            pixel_size: f64 = size * SceneHand::SCALE
            advance: i64 = TextMetrics::advance(pixel_size)
            line_height: f64 = TextMetrics::line_height(pixel_size).f64()
            width: f64 = 280.0 * SceneHand::SCALE
            length: i64 = sview_len(text).i64()
            start: mutable i64 = 0
            space: mutable i64 = -1
            top: mutable f64 = SceneHand::y(y)
            for i in 0..<length |list, text, pixel_size, advance, line_height, width, start, space, top, ink|:
                if sview_at(text, i.usize()) == 32.u8():
                    space <- i
                elif space >= start and ((i - start + 1) * advance).f64() >= width:
                    Display::draw_text(list, string_view_slice(text, start, space), SceneHand::x(16.0), top,
                        pixel_size, ink, Display::ANCHOR_LEFT_TOP)
                    start <- space + 1
                    space <- -1
                    top <- top - line_height
            Display::draw_text(list, string_view_slice(text, start, length), SceneHand::x(16.0), top,
                pixel_size, ink, Display::ANCHOR_LEFT_TOP)

    def paragraph_height(text: sview, size: f64) -> f64:
        can Abort.Panic:
            return TextMetrics::wrapped_height(size * SceneHand::SCALE, text, 280.0 * SceneHand::SCALE).f64() / SceneHand::SCALE

    def rules_height(texts: darray[dstr]&, size: f64) -> f64:
        can Abort.Panic:
            height: mutable f64 = 0.0
            for text in texts |height, size|:
                height <- height + paragraph_height(bytes_view(text), size) + 0.9 * size
            return height

    def rulebook(list: mutable Display::DisplayList&, run: MorningRoundRide::Run&):
        can Memory.Allocate, Abort.Panic:
            rect(list, 0.0, 0.0, 310.0, 640.0, PANEL)
            SceneHand::word(list, "RULEBOOK", 155.0, 612.0, 13.0, PALE, true)
            if not MorningRoundRide::rulebook_open(run):
                SceneHand::word(list, "Put away: ride from memory", 155.0, 580.0, 10.0, DIM)
                return
            mode: i64 = run.street.layout.level.mode
            if mode == MorningRound::MARKED:
                paragraph(list, "Deliver to every house with a star in the window.", 580.0, 11.0, PALE)
                return
            y: mutable f64 = 580.0
            if mode == MorningRound::TOLD:
                Display::draw_text(list, "Deliver to houses with:", SceneHand::x(16.0), SceneHand::y(y),
                    10.0 * SceneHand::SCALE, DIM, Display::ANCHOR_LEFT_CENTER)
                y <- y - 20.0
            block: i64 = MorningRoundRide::block_at(run, run.s)
            selected: i64 = run.street.active[block.usize()] if mode == MorningRound::SIGN or block == 0 else -1
            count: i64 = run.street.book.count
            texts: mutable darray[dstr] = []
            for k in 0..<count |run, count, texts|:
                row: mutable dstr = []
                if count > 1:
                    dstr_append_sview(&row, letter(k))
                    dstr_append_cstr(&row, ":  ")
                rule: MorningRoundRules::Rule& = &run.street.book.rules[k.usize()]
                MorningRoundWords::describe(rule, rule.count - 1, false, &row)
                texts.push(row)
            size: mutable f64 = 10.5
            while size > 6.0 and rules_height(&texts, size) > y - 70.0 |size, texts, y|:
                size <- size - 0.5
            for k in 0..<count |list, y, size, count, selected, texts|:
                row: sview = bytes_view(texts[k.usize()])
                height: f64 = paragraph_height(row, size)
                if k == selected and count > 1:
                    rect(list, 8.0, y - height - 4.0, 294.0, height + 8.0, 0x3c466eff)
                paragraph(list, row, y, size, PALE)
                y <- y - height - 0.9 * size
            if mode == MorningRound::SIGN:
                paragraph(list, "The sign at each crossroads says which rule holds from there.", y, fmin(9.0, size), DIM)
            elif mode == MorningRound::HIDDEN:
                note: mutable dstr = []
                dstr_append_cstr(&note, "Start with ")
                dstr_append_sview(&note, letter(run.street.active[0]))
                dstr_append_cstr(&note, ". At any crossroads the rule may change without a word.")
                paragraph(list, bytes_view(note), y, fmin(9.0, size), DIM)

    def fraction(list: mutable Display::DisplayList&, name: sview, value: i64, limit: i64, y: f64, ink: u32):
        can Memory.Allocate, Abort.Panic:
            SceneHand::word(list, name, 940.0, y, 9.0, DIM)
            text: mutable dstr = []
            dstr_append_i64(&text, value)
            dstr_append_cstr(&text, " / ")
            dstr_append_i64(&text, limit)
            SceneHand::word(list, bytes_view(text), 940.0, y - 20.0, 13.0, ink, true)

    def scene(list: mutable Display::DisplayList&, run: MorningRoundRide::Run&):
        can Memory.Allocate, Abort.Panic:
            road(list, run.s)
            crossroads(list, run)
            for i in 0..<run.street.layout.count |list, run|:
                h: MorningRound::House = run.street.layout.houses[i.usize()]
                y: f64 = street_y(run, h.d)
                house(list, h, y, run.got[i.usize()]) if y > -80.0 and y < 720.0
            traffic(list, run)
            rider(list, run)
            rulebook(list, run)
            level: MorningRound::Grade = run.street.layout.level
            if not MorningRoundRide::riding(run):
                rect(list, 500.0, 300.0, 200.0, 50.0, PANEL)
                text: mutable dstr = []
                dstr_append_cstr(&text, "Setting off in ")
                dstr_append_i64(&text, ceil(level.brief - run.t).i64())
                SceneHand::word(list, bytes_view(text), 600.0, 325.0, 15.0, 0xffdc78ff, true)
            SceneHand::word(list, "papers", 940.0, 600.0, 9.0, DIM)
            SceneHand::number(list, run.papers, point(940.0, 580.0), 13.0, PALE)
            fraction(list, "mistakes", run.mistakes, level.slack, 548.0, 0xff9678ff if run.mistakes != 0 else PALE)
            fraction(list, "falls", run.falls, 3, 496.0, PALE)
            fraction(list, "block", MorningRoundRide::block_at(run, run.s) + 1, level.blocks, 444.0, PALE)

    def instructions(mode: i64) -> cstr:
        return "Throw a paper to every house with a star" if mode == MorningRound::MARKED
        return "Throw a paper to the houses the rulebook names" if mode == MorningRound::TOLD
        return "Follow the rule the crossroads sign shows" if mode == MorningRound::SIGN
        return "The rule may change at a crossroads: listen"

    def verdict_text(run: MorningRoundRide::Run&, text: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            if run.result == MorningRoundRide::CLEAR:
                dstr_append_cstr(text, "Round done: ")
                dstr_append_i64(text, run.mistakes)
                dstr_append_cstr(text, " mistake(s)")
            elif run.result == MorningRoundRide::COMPLAINTS:
                dstr_append_cstr(text, "Too many complaints: ")
                dstr_append_i64(text, run.mistakes)
            elif run.result == MorningRoundRide::TIMEOUT:
                dstr_append_cstr(text, "Out of time: the round was not done")
            elif run.result == MorningRoundRide::THREE_FALLS:
                dstr_append_cstr(text, "Three falls: the round is off")

    def render(list: mutable Display::DisplayList&, session: MorningRoundGame::Session&, dark: bool):
        can Memory.Allocate, Abort.Panic:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            Display::draw_text_weight(list, "Morning Round", 456.0, 648.0, 22.0, ink, Display::ANCHOR_CENTER_CENTER, true)
            Display::draw_text(list, "Left / Right: steer   Up / Down: faster / slower   Z: throw left   X: throw right",
                456.0, 26.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
            status: mutable dstr = []
            run: MorningRoundRide::Run& = &session.run
            if session.phase == MorningRoundGame::READY:
                dstr_append_cstr(&status, "Press Space or click to start")
            elif session.phase == MorningRoundGame::DONE:
                dstr_append_i64(&status, session.wins)
                dstr_append_cstr(&status, " of ")
                dstr_append_i64(&status, session.trial)
                dstr_append_cstr(&status, " passed   highest rung passed ")
                dstr_append_i64(&status, session.best_rung)
            elif session.phase == MorningRoundGame::JUDGED:
                verdict_text(run, &status)
            else:
                dstr_append_cstr(&status, instructions(run.street.layout.level.mode))
            Display::draw_text(list, bytes_view(status), 456.0, 614.0, 14.0, ink, Display::ANCHOR_CENTER_CENTER)
            if session.phase == MorningRoundGame::PLAYING or session.phase == MorningRoundGame::JUDGED:
                facts: mutable dstr = []
                dstr_append_cstr(&facts, "rung ")
                dstr_append_i64(&facts, session.rung)
                dstr_append_cstr(&facts, "  ")
                dstr_append_i64(&facts, session.trial)
                dstr_append_cstr(&facts, "/")
                dstr_append_i64(&facts, session.total)
                Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink, Display::ANCHOR_CENTER_CENTER)
                SceneHand::card(list, 0x363c4aff)
                scene(list, run)
                share: f64 = fmax(0.0, (run.street.seconds - run.t) / run.street.seconds)
                if share > 0.005:
                    rect(list, 10.0, 6.0, 980.0 * share, 6.0,
                        ScenePolish::mix_rgb(0xec5040ff, 0x6edc8cff, fmin(1.0, share * 1.6)))
            if session.phase == MorningRoundGame::JUDGED or session.phase == MorningRoundGame::DONE:
                caption: mutable dstr = []
                verdict_text(run, &caption)
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, run.result == MorningRoundRide::CLEAR,
                    bytes_view(caption), 60.0, 16.0)

    def option_note(rung: i64, words: mutable dstr&):
        can Memory.Allocate, Abort.Panic:
            level: MorningRound::Grade = MorningRound::grade(rung)
            dstr_append_cstr(words, "Rung ")
            dstr_append_i64(words, level.rung)
            dstr_append_cstr(words, ": ")
            dstr_append_i64(words, level.deck)
            dstr_append_cstr(words, " rule(s), ")
            dstr_append_i64(words, level.blocks)
            dstr_append_cstr(words, " block(s), ")
            dstr_append_i64(words, level.slack)
            dstr_append_cstr(words, " mistake(s) allowed.")
