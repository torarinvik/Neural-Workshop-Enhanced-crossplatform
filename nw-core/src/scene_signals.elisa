include "./tasks/signals_game.elisa"
include "./scene_hidden_rule.elisa"
include "./scene_verdict.elisa"
include "./geometry.elisa"

module SceneSignals:
    const LEFT: f64 = 27.36
    const BOTTOM: f64 = 179.0
    const WIDTH: f64 = 857.28
    const HEIGHT: f64 = 389.0
    const MAIN: f64 = WIDTH * 0.74
    const SIDE: f64 = WIDTH * 0.24
    const OBJECTS_Y: f64 = BOTTOM + HEIGHT * 0.3
    const OBJECTS_H: f64 = HEIGHT * 0.38
    const KEYS_H: f64 = HEIGHT * 0.24
    const GAP: f64 = MAIN * 0.012
    const KEY_W: f64 = (MAIN - GAP * 7.0) / 8.0
    const CENTER: u32 = Display::ANCHOR_CENTER_CENTER

    def box(list: mutable Display::DisplayList&, x: f64, y: f64, w: f64, h: f64, fill: u32, border: u32):
        can Abort.Panic, Memory.Allocate:
            Display::draw_rect(list, x, y, w, h, fill)
            Display::draw_box(list, x, y, w, h, border, 2.0)

    def stroke(list: mutable Display::DisplayList&, x: f64, y: f64, size: f64, ink: u32, width: f64,
               ax: f64, ay: f64, bx: f64, by: f64):
        can Abort.Panic, Memory.Allocate:
            Display::draw_line(list, x + ax * size, y + ay * size, x + bx * size, y + by * size, width, ink)

    def glyph(list: mutable Display::DisplayList&, id: i64, x: f64, y: f64, size: f64, ink: u32, fixed: bool = false):
        can Abort.Panic, Memory.Allocate:
            width: f64 = 2.0 if fixed or size * 0.08 < 2.0 else size * 0.08
            if id == 0:
                stroke(list, x, y, size, ink, width, 0.5, 0.1, 0.5, 0.9)
                stroke(list, x, y, size, ink, width, 0.2, 0.9, 0.8, 0.9)
            elif id == 1:
                stroke(list, x, y, size, ink, width, 0.15, 0.15, 0.85, 0.85)
                stroke(list, x, y, size, ink, width, 0.15, 0.85, 0.85, 0.15)
            elif id == 2:
                stroke(list, x, y, size, ink, width, 0.1, 0.2, 0.35, 0.8)
                stroke(list, x, y, size, ink, width, 0.35, 0.8, 0.65, 0.2)
                stroke(list, x, y, size, ink, width, 0.65, 0.2, 0.9, 0.8)
            elif id == 3:
                stroke(list, x, y, size, ink, width, 0.2, 0.9, 0.2, 0.2)
                stroke(list, x, y, size, ink, width, 0.2, 0.2, 0.8, 0.2)
                stroke(list, x, y, size, ink, width, 0.8, 0.2, 0.8, 0.5)
            elif id == 4:
                stroke(list, x, y, size, ink, width, 0.15, 0.85, 0.85, 0.85)
                stroke(list, x, y, size, ink, width, 0.85, 0.85, 0.15, 0.15)
                stroke(list, x, y, size, ink, width, 0.15, 0.15, 0.85, 0.15)
            elif id == 5:
                stroke(list, x, y, size, ink, width, 0.1, 0.1, 0.5, 0.9)
                stroke(list, x, y, size, ink, width, 0.5, 0.9, 0.9, 0.1)
                stroke(list, x, y, size, ink, width, 0.3, 0.5, 0.7, 0.5)
            elif id == 6:
                stroke(list, x, y, size, ink, width, 0.2, 0.35, 0.8, 0.35)
                stroke(list, x, y, size, ink, width, 0.2, 0.65, 0.8, 0.65)
                stroke(list, x, y, size, ink, width, 0.5, 0.1, 0.5, 0.9)
            elif id == 7:
                stroke(list, x, y, size, ink, width, 0.2, 0.2, 0.8, 0.2)
                stroke(list, x, y, size, ink, width, 0.8, 0.2, 0.8, 0.8)
                stroke(list, x, y, size, ink, width, 0.8, 0.8, 0.35, 0.8)
                stroke(list, x, y, size, ink, width, 0.35, 0.8, 0.35, 0.45)
                stroke(list, x, y, size, ink, width, 0.35, 0.45, 0.6, 0.45)

    def thing(list: mutable Display::DisplayList&, id: i64, x: f64, y: f64, r: f64):
        can Abort.Panic, Memory.Allocate:
            colour: i64 = id / 4
            ink: u32 = 0xdc3c32ff if colour == 0 else (0x3264dcff if colour == 1 else (0x32aa50ff if colour == 2 else 0xebc828ff))
            shape: i64 = id % 4
            if shape == 0:
                Display::draw_circle(list, x, y, r, ink)
            elif shape == 1:
                Display::draw_rect(list, x - r * 0.85, y - r * 0.85, r * 1.7, r * 1.7, ink)
            elif shape == 2:
                Display::draw_triangle(list, x - r, y - r * 0.8, x + r, y - r * 0.8, x, y + r, ink)
            else:
                Display::draw_star(list, x, y, r, r * 0.45, 5, 0.0, ink)

    def partner(list: mutable Display::DisplayList&, game: Signals::Game&, ink: u32, panel: u32):
        can Abort.Panic, Memory.Allocate:
            h: f64 = HEIGHT * 0.28
            bottom: f64 = BOTTOM + HEIGHT * 0.72
            box(list, LEFT, bottom, MAIN, h, panel, ink)
            return if game.at >= game.deal.level.exchanges
            listening: bool = game.deal.exchanges[game.at.usize()].role == Signals::LISTEN
            Display::draw_text_weight(list, "Partner says" if listening else "You say", LEFT + 16.0,
                bottom + h - 13.0 * 1.4, 13.0, ink, Display::ANCHOR_LEFT_CENTER, true)
            heard: Signals::Message = Signals::partner_says(&game.deal, game.at) if listening else (
                Signals::Message{first: game.drafted, second: -1, length: 1})
            slots: i64 = game.deal.level.length
            size: f64 = SceneHiddenRule::minimum(h * 0.55, MAIN * 0.12)
            x0: f64 = LEFT + MAIN / 2.0 - slots.f64() * size * 0.7
            y: f64 = bottom + h * 0.12
            for i in 0..<slots |i, list, ink, size, x0, y, heard|:
                x: f64 = x0 + i.f64() * size * 1.4
                Display::draw_box(list, x - 6.0, y - 6.0, size + 12.0, size + 12.0, ink, 2.0)
                mark: i64 = heard.first if i == 0 else heard.second
                if mark >= 0:
                    glyph(list, mark, x, y, size, ink)

    def cell_width(count: i64) -> f64:
        return SceneHiddenRule::minimum(MAIN / count.f64(), OBJECTS_H)

    def object_left(cell: f64, count: i64) -> f64:
        return LEFT + (MAIN - cell * count.f64()) / 2.0

    def objects(list: mutable Display::DisplayList&, game: Signals::Game&, ink: u32):
        can Abort.Panic, Memory.Allocate:
            return if game.at >= game.deal.level.exchanges
            row: Signals::Exchange& = &game.deal.exchanges[game.at.usize()]
            count: i64 = game.deal.level.objects
            cell: f64 = cell_width(count)
            x0: f64 = object_left(cell, count)
            y: f64 = OBJECTS_Y + OBJECTS_H * 0.55
            r: f64 = cell * 0.3
            for i in 0..<count |list, ink, row, cell, x0, y, r, i|:
                x: f64 = x0 + cell * (i.f64() + 0.5)
                if row.role == Signals::SPEAK and i == row.target:
                    Display::draw_box(list, x - r * 1.4, y - r * 1.4, r * 2.8, r * 2.8, ink, 4.0)
                thing(list, row.objects[i.usize()], x, y, r)
                number: mutable dstr = []
                dstr_append_i64(&number, i + 1)
                Display::draw_text_weight(list, bytes_view(number), x, OBJECTS_Y + OBJECTS_H * 0.08, 11.0, ink, CENTER, true)

    def key_left(index: i64) -> f64:
        return LEFT + index.f64() * (KEY_W + GAP)

    def keys(list: mutable Display::DisplayList&, game: Signals::Game&, ink: u32, panel: u32):
        can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
            speaking: bool = game.at < game.deal.level.exchanges and game.deal.exchanges[game.at.usize()].role == Signals::SPEAK
            colour: u32 = ink if speaking else 0x969696ff
            size: f64 = SceneHiddenRule::minimum(KEY_W, KEYS_H) * 0.6
            for i in 0..<Signals::GLYPHS |list, i, ink, panel, colour, size|:
                x: f64 = key_left(i)
                box(list, x, BOTTOM, KEY_W, KEYS_H, panel, colour)
                glyph(list, i, x + (KEY_W - size) / 2.0, BOTTOM + (KEYS_H - size) / 2.0 + 6.0, size, colour)
                text: mutable dstr = []
                trusted Unsafe.PointerCast:
                    letters: cstr = "QWERTYUI"
                    text.push(letters.cast[u8&][i.usize()])
                Display::draw_text(list, bytes_view(text), x + 8.0, BOTTOM + 10.0, 9.0, ink, Display::ANCHOR_LEFT_CENTER)

    def history(list: mutable Display::DisplayList&, game: Signals::Game&, ink: u32, panel: u32):
        can Abort.Panic, Memory.Allocate:
            left: f64 = LEFT + MAIN + WIDTH * 0.02
            box(list, left, BOTTOM, SIDE, HEIGHT, panel, ink)
            Display::draw_text_weight(list, "Last: meant > taken", left + SIDE / 2.0,
                BOTTOM + HEIGHT - 11.0 * 1.4, 11.0, ink, CENTER, true)
            row: f64 = (HEIGHT - 33.0) / 6.0
            size: f64 = SceneHiddenRule::minimum(row * 0.55, SIDE * 0.14)
            for i in 0..<Signals::minimum(6, game.at) |list, game, ink, left, row, size, i|:
                at: usize = (game.at - 1 - i).usize()
                ex: Signals::Exchange = game.deal.exchanges[at]
                found: Signals::Result = game.history[at]
                bottom: f64 = BOTTOM + HEIGHT - 33.0 - (i + 1).f64() * row
                y: f64 = bottom + row / 2.0
                Display::draw_text(list, "them" if ex.role == Signals::LISTEN else "you", left + 10.0,
                    y, 8.8, ink, Display::ANCHOR_LEFT_CENTER)
                gx: f64 = left + 10.0 + SIDE * 0.2
                gy: f64 = bottom + (row - size) / 2.0
                glyph(list, found.signal.first, gx, gy, size, ink, true)
                if found.signal.length == 2:
                    glyph(list, found.signal.second, gx + size * 1.15, gy, size, ink, true)
                x: f64 = left + SIDE * 0.6
                thing(list, ex.objects[ex.target.usize()], x, y, size * 0.4)
                if not found.right:
                    Display::draw_text(list, ">", x + size * 0.65, y, 8.8, ink, CENTER)
                    thing(list, ex.objects[found.picked.usize()], x + size * 1.3, y, size * 0.4)
                Display::draw_text_weight(list, "right" if found.right else "wrong", left + SIDE - 10.0,
                    y, 8.8, ink, Display::ANCHOR_RIGHT_CENTER, found.right)

    def hit(session: SignalsGame::Session&, x: f64, y: f64) -> i64:
        return -1 if session.phase != SignalsGame::PLAYING
        game: Signals::Game& = &session.game
        if game.deal.exchanges[game.at.usize()].role == Signals::LISTEN:
            return -1 if y < OBJECTS_Y or y > OBJECTS_Y + OBJECTS_H
            count: i64 = game.deal.level.objects
            cell: f64 = cell_width(count)
            left: f64 = object_left(cell, count)
            for i in 0..<count |i, x, left, cell|:
                return i if x >= left + i.f64() * cell and x <= left + (i + 1).f64() * cell
        elif y >= BOTTOM and y <= BOTTOM + KEYS_H:
            for i in 0..<Signals::GLYPHS |x, i|:
                left: f64 = key_left(i)
                return SignalsGame::SEND + i if x >= left and x <= left + KEY_W
        return -1

    def points(text: mutable dstr&, value: f64):
        can Abort.Panic, Memory.Allocate:
            if value == value.i64().f64():
                dstr_append_i64(text, value.i64())
            else:
                dstr_append_fixed(text, value, 1)

    def status(text: mutable dstr&, session: SignalsGame::Session&):
        can Abort.Panic, Memory.Allocate:
            game: Signals::Game& = &session.game
            if session.phase == SignalsGame::READY:
                dstr_append_cstr(text, "Press Space or click to start")
            elif session.phase == SignalsGame::DONE:
                dstr_append_i64(text, session.passed)
                dstr_append_cstr(text, " of ")
                dstr_append_i64(text, session.trial)
                dstr_append_cstr(text, " passed   highest rung passed ")
                dstr_append_i64(text, session.best)
            elif session.phase == SignalsGame::JUDGED:
                dstr_append_i64(text, game.score)
                dstr_append_cstr(text, " of ")
                dstr_append_i64(text, game.deal.level.exchanges)
                dstr_append_cstr(text, " exchanges understood (par ")
                points(text, session.par)
                dstr_append_cstr(text, ")")
            else:
                listening: bool = game.deal.exchanges[game.at.usize()].role == Signals::LISTEN
                dstr_append_cstr(text, "Your partner means one of these. Which?" if listening else (
                    "Send two glyphs so your partner picks the outlined one" if game.deal.level.length == 2 else
                    "Send a glyph so your partner picks the outlined one"))

    def render(list: mutable Display::DisplayList&, session: SignalsGame::Session&, dark: bool):
        can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
            ink: u32 = 0xffffffff if dark else 0x000000ff
            panel: u32 = 0x2e323aff if dark else 0xe8ebf0ff
            Display::draw_text_weight(list, "Signals", 456.0, 648.0, 22.0, ink, CENTER, true)
            Display::draw_text(list, "listening: click the object meant (1-8)   speaking: click glyphs (Q-I)   Esc: menu",
                456.0, 26.0, 12.0, ink, CENTER)
            message: mutable dstr = []
            status(&message, session)
            Display::draw_text(list, bytes_view(message), 456.0, 614.0, 14.0, ink, CENTER)
            return if session.phase == SignalsGame::READY or session.phase == SignalsGame::DONE
            game: Signals::Game& = &session.game
            facts: mutable dstr = []
            dstr_append_cstr(&facts, "rung ")
            dstr_append_i64(&facts, session.rung)
            dstr_append_cstr(&facts, "  ")
            dstr_append_i64(&facts, session.trial)
            dstr_append_cstr(&facts, "/")
            dstr_append_i64(&facts, session.trials)
            dstr_append_cstr(&facts, "   exchange ")
            dstr_append_i64(&facts, Signals::minimum(game.at + 1, game.deal.level.exchanges))
            dstr_append_cstr(&facts, " of ")
            dstr_append_i64(&facts, game.deal.level.exchanges)
            dstr_append_cstr(&facts, "   understood ")
            dstr_append_i64(&facts, game.score)
            dstr_append_cstr(&facts, "   par ")
            points(&facts, session.par)
            Display::draw_text(list, bytes_view(facts), 456.0, 588.0, 12.0, ink, CENTER)
            partner(list, game, ink, panel)
            objects(list, game, ink)
            keys(list, game, ink, panel)
            history(list, game, ink, panel)
            if session.phase == SignalsGame::JUDGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, session.won, bytes_view(message), 60.0, 16.0)
            elif session.phase == SignalsGame::FLAGGED:
                SceneVerdict::put(list, 912.0, 684.0, 1.0, 1.0, false, "Out of time", 60.0, 16.0)

    def option_note(rung: i64, text: mutable dstr&):
        can Abort.Panic, Memory.Allocate:
            level: Signals::Grade = Signals::grade(rung)
            dstr_append_cstr(text, "Rung ")
            dstr_append_i64(text, level.rung)
            dstr_append_cstr(text, ": ")
            dstr_append_i64(text, level.exchanges)
            dstr_append_cstr(text, " exchanges, ")
            dstr_append_i64(text, level.objects)
            dstr_append_cstr(text, " objects, ")
            dstr_append_cstr(text, "you listen" if level.roles == Signals::LISTEN else ("you speak" if level.roles == Signals::SPEAK else "you take turns"))
            dstr_append_cstr(text, "; glyphs name ")
            dstr_append_cstr(text, "colours and shapes, " if level.shapes else "colours, ")
            dstr_append_i64(text, level.length)
            dstr_append_cstr(text, " to a signal.")
            if level.swaps > 0:
                dstr_append_cstr(text, "  The partner changes its code partway.")
            if level.rung > 20:
                dstr_append_cstr(text, "  You must beat the reference.")
