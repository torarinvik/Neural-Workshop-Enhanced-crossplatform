+func IsAggregateValueEqualityUnsupported(t Type) bool {
+	// Some runtime string views are represented as ordinary structs (for
+	// example a user-visible StringView) but have a dedicated content-equality
+	// lowering. Keep them out of the aggregate fallback guard.
+	if runtimeStringKindOf(t) != runtimeStringNone {
