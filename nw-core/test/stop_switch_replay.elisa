include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "../src/tasks/stop_switch_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def main() -> i32:
    can Abort.Panic, Console.Write:
        for rung in 1..<36 |rung|:
            for seed in -4..<4 |rung, seed|:
                block: mutable StopSwitch::Block = zeroed
                StopSwitch::deal(rung, seed, &block)
                level: StopSwitch::Grade = block.level
                _ = printf("%lld %lld %lld %.9f %.9f %.9f %lld %lld %.9f %.9f\n",
                    rung, seed, level.count, level.window, level.stops, level.stop_delay,
                    level.rules, 1 if level.prepared else 0, level.incongruent, level.needed)
                for index in 0..<level.count |block|:
                    item: StopSwitch::Stimulus = block.stimuli[index.usize()]
                    _ = printf("%lld %lld %lld %lld %lld %lld\n", item.shape, item.colour, item.side, item.rule,
                        1 if item.stop else 0, StopSwitch::answer(item))
        rungs: i64[4] = [1, 7, 13, 25]
        for scenario in 0..<4 |scenario, rungs|:
            run: mutable StopSwitchGame::Run = StopSwitchGame::initialize(rungs[scenario.usize()], 2, scenario != 2, 17)
            _ = StopSwitchGame::start(&run, 0.0)
            for tick in 0..<3200 |tick, run, scenario|:
                now: f64 = tick.f64() / 32.0
                _ = StopSwitchGame::advance(&run, now)
                if run.phase == StopSwitchGame::DONE:
                    _ = printf("done %lld %lld\n", run.passed_count, run.best_rung)
                    break
                if run.showing and tick % 7 == 0:
                    stimulus: StopSwitch::Stimulus = run.block.stimuli[run.index.usize()]
                    if not stimulus.stop or scenario % 2 == 1:
                        key: i64 = StopSwitch::answer(stimulus) if scenario != 3 else tick % 2
                        _ = StopSwitchGame::steer(&run, key, now)
                _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %.9f\n",
                    run.phase, run.trial, run.rung, run.index, run.hits, run.marks,
                    1 if run.showing else 0, 1 if run.ring else 0, run.shown_at)
        return 0.i32()
