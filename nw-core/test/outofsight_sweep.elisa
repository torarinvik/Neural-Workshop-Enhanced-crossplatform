# Differential sweep driver for tasks/outofsight.elisa. See outofsight_diff.py
# for the reference side.
#
# Everything here rides one RNG stream, and three places in it are easy to get
# wrong, so all three are swept directly as well as through a whole run:
#
#   * `lay_blinds` draws upright-or-along FIRST and then two coordinates, and a
#     REJECTED candidate has already spent all three -- so a field that asks
#     for more slabs than fit consumes a different number of draws than one
#     that fits, and every dot after it moves.
#   * `scattered` REWINDS: a relaxed pass throws away the spots it had. The
#     configs include a field crowded enough to force that.
#   * `maybe_cross` schedules its next gap BEFORE it looks for a free pair.
#
# The presser answers on a fixed cadence and deliberately gets some wrong, so
# hits, wrong answers and ran-out-of-time all land, and the adaptive ladder
# moves in both directions.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/pymath.elisa"
include "../src/geometry.elisa"
include "../src/tasks/tracking.elisa"
include "../src/tasks/outofsight.elisa"

# printr(i64) and int_to_string_scratch both trip a stage1 backend decline of
# store_* generics (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

def emit_scaled(value: f64):
    can Console.Write, Abort.Panic:
        emit_cell(py_round_half_even(value * 1000000.0))

def window_width(which: i64) -> f64:
    can Abort.Panic:
        return 912.0 if which == 0
        return 640.0 if which == 1
        return 1366.0 if which == 2
        return 1101.0

def window_height(which: i64) -> f64:
    can Abort.Panic:
        return 684.0 if which == 0
        return 480.0 if which == 1
        return 768.0 if which == 2
        return 617.0

def emit_blinds(slabs: mutable OutOfSight::OutOfSightSourceBlinds&):
    can Console.Write, Abort.Panic:
        emit_cell(slabs.count)
        for at in 0..<slabs.count |slabs|:
            emit_scaled(Floats::at_ref(&slabs.left, at))
            emit_scaled(Floats::at_ref(&slabs.bottom, at))
            emit_scaled(Floats::at_ref(&slabs.width, at))
            emit_scaled(Floats::at_ref(&slabs.height, at))

def emit_flock(flock: mutable OutOfSight::OutOfSightSourceFlock&):
    can Console.Write, Abort.Panic:
        emit_cell(flock.count)
        for at in 0..<flock.count |flock|:
            emit_scaled(Floats::at_ref(&flock.x, at))
            emit_scaled(Floats::at_ref(&flock.y, at))
            emit_scaled(Floats::at_ref(&flock.vx, at))
            emit_scaled(Floats::at_ref(&flock.vy, at))
            emit_cell(Ints::at_ref(&flock.target, at))
            emit_scaled(Floats::at_ref(&flock.busy_until, at))
            emit_scaled(Floats::at_ref(&flock.risky_until, at))
            emit_cell(Ints::at_ref(&flock.was_hidden, at))

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(64 * 1024 * 1024)
        in w:
            slabs: mutable OutOfSight::OutOfSightSourceBlinds = OutOfSight::new_blinds()
            flock: mutable OutOfSight::OutOfSightSourceFlock = OutOfSight::new_flock()
            spots_x: mutable darray[f64] = Floats::zeros(OutOfSight::MOST_DOTS)
            spots_y: mutable darray[f64] = Floats::zeros(OutOfSight::MOST_DOTS)

            # --- the field the dots are laid in --------------------------
            for size in 0..<4:
                width: f64 = window_width(size)
                height: f64 = window_height(size)
                field: OutOfSight::OutOfSightBounds = OutOfSight::bounds(width, height)
                printr("edge")
                emit_cell(size)
                emit_scaled(OutOfSight::radius(height))
                emit_scaled(field.low_x)
                emit_scaled(field.high_x)
                emit_scaled(field.low_y)
                emit_scaled(field.high_y)
                emit_scaled(OutOfSight::aspect_of(width, height))
                print("")

            # --- slabs, up to and past what the field can take -----------
            for blinds in 0..<9 |slabs|:
                for wide in 0..<4 |slabs, blinds|:
                    for seed in 1..<3 |slabs, blinds, wide|:
                        rng: mutable MT19937 = mt19937_new()
                        mt_seed_int(&rng, (blinds * 1000 + wide * 10 + seed).u64())
                        blind_width: f64 = 0.05 + wide.f64() * 0.09
                        OutOfSight::lay_blinds(&slabs, blinds, blind_width, 912.0, 684.0, &rng)
                        printr("blinds")
                        emit_cell(blinds)
                        emit_cell(wide)
                        emit_cell(seed)
                        emit_blinds(&slabs)
                        print("")
                        # The scatter that has to find clear air among them.
                        for dots in 3..<10 |slabs, spots_x, spots_y, blinds, wide, seed, rng|:
                            OutOfSight::scattered(&spots_x, &spots_y, dots, &slabs, 912.0, 684.0, &rng)
                            printr("spots")
                            emit_cell(blinds)
                            emit_cell(wide)
                            emit_cell(seed)
                            emit_cell(dots)
                            for at in 0..<dots |spots_x, spots_y|:
                                emit_scaled(Floats::at_ref(&spots_x, at))
                                emit_scaled(Floats::at_ref(&spots_y, at))
                            print("")

            # --- whole rounds, answered ----------------------------------
            # A fresh Run per config: `next_probe` and `next_cross` are not
            # cleared by a reset -- the reference makes a new task object per
            # run, so carrying them over would be this harness's own fiction.
            for cfg in 0..<5 |slabs, flock, spots_x, spots_y|:
                run: mutable OutOfSight::OutOfSightSourceRun = OutOfSight::new_run()
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, (700 + cfg).u64())
                width: f64 = window_width(cfg % 4)
                height: f64 = window_height(cfg % 4)
                run.dot_count <- 4 + cfg
                run.start_targets <- 1 + (cfg % 3)
                run.speed <- 0.18 + cfg.f64() * 0.05
                run.blind_count <- cfg % 4
                run.blind_width <- 0.07 + cfg.f64() * 0.03
                # cfg 2 switches crossings off entirely, which removes their
                # draws from the stream.
                run.cross_gap <- 0.0 if cfg == 2 else 1.2
                run.probes_per_round <- 3
                run.total_rounds <- 2
                run.adaptive <- (cfg % 2) == 0
                OutOfSight::start_run(&run, &slabs, &flock, &spots_x, &spots_y, width, height, 0.0, &rng)
                printr("start")
                emit_cell(cfg)
                emit_cell(run.phase)
                emit_cell(run.round_number)
                emit_cell(run.held)
                emit_blinds(&slabs)
                emit_flock(&flock)
                for question in 0..<run.probes_per_round |run|:
                    emit_cell(Ints::at_ref(&run.schedule, question))
                print("")

                dt: f64 = 1.0 / 60.0
                now: mutable f64 = 0.0
                tick: mutable i64 = 0
                while run.phase != OutOfSight::PHASE_DONE and tick < 6000 |run, slabs, flock, spots_x, spots_y, cfg, width, height, now, tick, dt, rng|:
                    now <- now + dt
                    OutOfSight::update(&run, &slabs, &flock, &spots_x, &spots_y, dt, width, height, now, &rng)
                    # A presser on a fixed cadence, right four times in five --
                    # so wrong answers and ran-out-of-time both arrive.
                    if run.probe >= 0 and run.verdict < 0 and (tick % 17) == 0:
                        truth: bool = Ints::at_ref(&flock.target, run.probe) != 0
                        said: bool = truth if (tick % 5) != 0 else not truth
                        OutOfSight::answer(&run, &flock, said, now)
                    printr("tick")
                    emit_cell(cfg)
                    emit_cell(tick)
                    emit_cell(run.phase)
                    emit_cell(run.round_number)
                    emit_cell(run.held)
                    emit_cell(run.probe)
                    emit_cell(run.verdict)
                    emit_cell(run.probes_done)
                    emit_cell(run.round_right)
                    emit_cell(run.hits)
                    emit_cell(run.wrong)
                    emit_cell(run.late)
                    emit_scaled(run.next_probe)
                    emit_scaled(run.next_cross)
                    emit_flock(&flock)
                    print("")
                    tick <- tick + 1

                tally: OutOfSight::OutOfSightScore = OutOfSight::score(&run)
                printr("score")
                emit_cell(cfg)
                emit_cell(tick)
                emit_cell(tally.rounds)
                emit_cell(tally.asked)
                emit_cell(tally.hits)
                emit_cell(tally.wrong)
                emit_cell(tally.late)
                emit_cell(tally.accuracy)
                emit_cell(tally.mean_ms)
                emit_cell(tally.most_held)
                print("")
        destroy w
        return 0
