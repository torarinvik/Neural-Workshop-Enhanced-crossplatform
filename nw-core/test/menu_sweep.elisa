# Emits one menu screen per (option count, selection, theme) case as a
# hex-encoded display list. menu_diff.py drives the ORIGINAL's Menu class with
# the same cases and compares command by command.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
# geometry.elisa is here because the two captions at the bottom of
# scene_menu -- the resolved-mode line and the options note -- are the only
# menu chrome computed from the window rather than measured into reference
# space, so they are the only part of that module that needs it.
include "../src/geometry.elisa"
include "../src/display.elisa"
include "../src/scene_menu.elisa"

def print_hex_byte(value: u8):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            digits: cstr = "0123456789abcdef"
            pair: u8[3] = zeroed
            pair[0] <- digits.cast[u8&][(value >> 4.u8()).usize()]
            pair[1] <- digits.cast[u8&][(value & 15.u8()).usize()]
            pair[2] <- 0
            printr((&pair[0]).cast[cstr])

# "Option 0" .. "Option 29", the same names extract_menu.py builds.
def option_name(index: i64) -> sview:
    can Abort.Panic:
        if index == 0:
            return "Option 0"
        if index == 1:
            return "Option 1"
        if index == 2:
            return "Option 2"
        if index == 3:
            return "Option 3"
        if index == 4:
            return "Option 4"
        if index == 5:
            return "Option 5"
        if index == 6:
            return "Option 6"
        if index == 7:
            return "Option 7"
        if index == 8:
            return "Option 8"
        if index == 9:
            return "Option 9"
        if index == 10:
            return "Option 10"
        if index == 11:
            return "Option 11"
        if index == 12:
            return "Option 12"
        if index == 13:
            return "Option 13"
        if index == 14:
            return "Option 14"
        if index == 15:
            return "Option 15"
        if index == 16:
            return "Option 16"
        if index == 17:
            return "Option 17"
        if index == 18:
            return "Option 18"
        if index == 19:
            return "Option 19"
        if index == 20:
            return "Option 20"
        if index == 21:
            return "Option 21"
        if index == 22:
            return "Option 22"
        if index == 23:
            return "Option 23"
        if index == 24:
            return "Option 24"
        if index == 25:
            return "Option 25"
        if index == 26:
            return "Option 26"
        if index == 27:
            return "Option 27"
        if index == 28:
            return "Option 28"
        return "Option 29"

# Matches extract_menu.py's --blanks: every third row is a spacer.
def option_name_maybe_blank(index: i64, blanks: bool) -> sview:
    can Abort.Panic:
        if blanks and index % 3 == 2:
            return ""
        return option_name(index)

def emit_one(count: i64, selpos: i64, black_background: bool, blanks: bool):
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(4 * 1024 * 1024)
        in work:
            options: mutable darray[sview] = []
            index: mutable i64 = 0
            while index < count |index, options, count, blanks|:
                options.push(option_name_maybe_blank(index, blanks))
                index <- index + 1
            list: mutable Display::DisplayList = Display::DisplayList()
            render_menu_frame(&list, "Test Menu", menu_default_footnote(), &options, selpos, black_background)
            encoded: darray[u8] = Display::encode_binary(&list)
            for byte in encoded:
                print_hex_byte(byte)
            print("")
        destroy work

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        # Order is the contract menu_diff.py relies on.
        emit_one(8, 0, false, false)
        emit_one(8, 7, false, false)
        emit_one(30, 0, false, false)
        emit_one(30, 15, false, false)
        emit_one(30, 29, false, false)
        emit_one(8, 3, true, false)
        emit_one(1, 0, false, false)
        emit_one(24, 0, false, true)
        emit_one(24, 23, false, true)
        # Land ON a spacer, from both directions, and near the scroll edge:
        # move_selection steps off it and the scroll guards then rerun.
        emit_one(24, 20, false, true)
        emit_one(24, 2, false, true)
        emit_one(24, 5, false, true)
        emit_one(24, 11, false, true)
        return 0
