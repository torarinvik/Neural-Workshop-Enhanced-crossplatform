# Differential sweep driver for src/scene_sudoku.elisa.
# See scene_sudoku_diff.py for the reference side.
#
# The board is named rather than solved: every cell's value, given-ness and
# pencil mask is chosen by arithmetic, so the sweep covers clashing digits,
# pencilled cells and empty ones without having to reach them through play.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_sudoku.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            width: f64 = 1824.0
            height: f64 = 1368.0
            filled: mutable darray[i64] = Ints::zeros(SceneSudoku::MOST_CELLS)
            givens: mutable darray[i64] = Ints::zeros(SceneSudoku::MOST_CELLS)
            marks: mutable darray[i64] = Ints::zeros(SceneSudoku::MOST_CELLS)
            print("names|spec|box|phase|black|at|show_clashes|pencil|trial|total_trials|has_puzzle")
            for spec in 0..<24 |width, height, filled, givens, marks|:
                box: i64 = 2 + spec % 3
                size: i64 = box * box
                cells: i64 = size * size
                phase: i64 = 1 if spec % 6 != 5 else 2
                black: bool = spec % 4 == 1
                at: i64 = (spec * 7) % cells
                show_clashes: bool = spec % 3 != 2
                pencil: bool = spec % 5 == 0
                has_puzzle: bool = spec % 11 != 10
                for cell in 0..<cells |filled, givens, marks, spec, size|:
                    # A third of the cells hold a digit, and the pattern is
                    # chosen to put like digits in one another's units --
                    # otherwise `show_clashes` would never colour anything.
                    value: mutable i64 = 0
                    if (cell + spec) % 3 == 0:
                        value <- 1 + (cell / size + spec) % size
                    Ints::put(filled, cell, value)
                    Ints::put(givens, cell, 1 if value != 0 and (cell + spec) % 6 == 0 else 0)
                    Ints::put(marks, cell, 0 if value != 0 else ((cell * 37 + spec) % 512))
                printr("spec|")
                print_i64(spec)
                emit_bar(box)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(at)
                emit_bar(1 if show_clashes else 0)
                emit_bar(1 if pencil else 0)
                emit_bar(1 + spec % 4)
                emit_bar(4)
                emit_bar(1 if has_puzzle else 0)
                print("")
                message: mutable dstr = []
                dstr_append_cstr(&message, "Press Space to start")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneSudoku::SudokuPaint = SceneSudoku::paint_of(black, width, height, 2.0, 2.0)
                SceneSudoku::render(&list, &paint, filled, givens, marks, box,
                                    phase, at, show_clashes, pencil,
                                    1 + spec % 4, 4, has_puzzle,
                                    bytes_view(message),
                                    # The reference fixture never calls
                                    # VerdictLabel.show(); a solved phase
                                    # alone does not make the verdict visible.
                                    -1,
                                    bytes_view(message))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
