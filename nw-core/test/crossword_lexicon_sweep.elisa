include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/strings.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/crossword.elisa"
include "../src/tasks/crossword_lexicon.elisa"

def main() -> i64:
    can Console.Write, Global.Read, Global.Write, Memory.Allocate, Abort.Panic:
        region work(32 * 1024 * 1024)
        in work:
            text: sview = sview("ant\t1\tan insect colony\nbee\t2\tabéille — an insect\nan\t3\ta short article\nbird\t4\ta feathered animal\ncat\t5\ta domestic animal\n", 0, -1)
            stats: CrosswordLexicon::CrosswordIndexStats = CrosswordLexicon::inspect(text, 5, 4)
            return 1 if not stats.valid or not stats.clued or stats.words != 3 or stats.letters != 10
            lex: mutable Crossword::Lexicon = Crossword::new_lexicon_sized(stats.words, stats.letters)
            CrosswordLexicon::read_crossword_index(text, 5, 4, &lex)
            return 2 if lex.count != 3 or Ints::at_ref(&lex.length_count, 3) != 2 or Ints::at_ref(&lex.length_count, 4) != 1
            sample_word: mutable darray[i64] = [1, 8, 17, 3]
            return 3 if Crossword::word_of(&lex, &sample_word, 0, 4) != 2
            clue: i64 = Ints::at_ref(&lex.clue, 2)
            return 4 if clue < 0 or sview_at(text, clue.usize()) != 97.u8()
            unordered: sview = sview("cat\t5\ta cat clue\nant\t1\tan ant clue\n", 0, -1)
            unsorted_stats: CrosswordLexicon::CrosswordIndexStats = CrosswordLexicon::inspect(unordered, 100, 4)
            return 5 if not unsorted_stats.valid or not unsorted_stats.clued or unsorted_stats.words != 2
            unordered_lex: mutable Crossword::Lexicon = Crossword::new_lexicon_sized(unsorted_stats.words, unsorted_stats.letters)
            CrosswordLexicon::read_crossword_index(unordered, 100, 4, &unordered_lex)
            return 8 if Ints::at_ref(&unordered_lex.rank, 0) != 1 or Ints::at_ref(&unordered_lex.rank, 1) != 5
            tied: sview = sview("cat\t5\tcat clue\nant\t1\tant clue\nbee\t1\tbee clue\n", 0, -1)
            tied_lex: mutable Crossword::Lexicon = Crossword::new_lexicon_sized(3, 9)
            CrosswordLexicon::read_crossword_index(tied, 100, 4, &tied_lex)
            return 9 if Ints::at_ref(&tied_lex.rank, 0) != 1 or Ints::at_ref(&tied_lex.rank, 1) != 1
            return 10 if Ints::at_ref(&tied_lex.letter, Ints::at_ref(&tied_lex.start, 0)) != 0
            return 11 if Ints::at_ref(&tied_lex.letter, Ints::at_ref(&tied_lex.start, 1)) != 1
            late_clue: mutable dstr = []
            dstr_append_cstr(&late_clue, "cat\t65\tclue\n")
            for rank in 1..<65 |late_clue|:
                dstr_append_cstr(&late_clue, "ant\t")
                dstr_append_i64(&late_clue, rank)
                dstr_append_cstr(&late_clue, "\t\n")
            return 12 if CrosswordLexicon::inspect(bytes_view(late_clue), 100, 4).clued
            early_clue: mutable dstr = []
            dstr_append_cstr(&early_clue, "cat\t64\tclue\n")
            for rank in 1..<64 |early_clue|:
                dstr_append_cstr(&early_clue, "ant\t")
                dstr_append_i64(&early_clue, rank)
                dstr_append_cstr(&early_clue, "\t\n")
            return 13 if not CrosswordLexicon::inspect(bytes_view(early_clue), 100, 4).clued
            tied_boundary: mutable dstr = []
            for index in 0..<64 |tied_boundary|:
                dstr_append_cstr(&tied_boundary, "ant\t1\t\n")
            dstr_append_cstr(&tied_boundary, "cat\t1\tlate clue\n")
            return 14 if CrosswordLexicon::inspect(bytes_view(tied_boundary), 100, 4).clued
            malformed: sview = sview("ant\tnot-a-rank\ta clue\n", 0, -1)
            return 6 if CrosswordLexicon::inspect(malformed, 100, 4).valid
            empty: sview = sview("", 0, -1)
            return 7 if CrosswordLexicon::inspect(empty, 100, 4).clued
            print("lexicon-ok")
        destroy work
        return 0
