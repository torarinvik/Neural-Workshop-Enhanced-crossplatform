# Differential sweep for src/trialuitext.elisa.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/strings.elisa"
include "../src/nback.elisa"
include "../src/decimal.elisa"
include "../src/gamemode.elisa"
include "../src/board.elisa"
include "../src/trialuitext.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            index: mutable i64 = 23
            number: mutable i64 = value
            if number == 0:
                index <- 22
                buf[22] <- 48.u8()
            else:
                negative: bool = number < 0
                while number != 0:
                    digit: i64 = number % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    index <- index - 1
                    buf[index.usize()] <- (48 + magnitude).u8()
                    number <- number / 10
                if negative:
                    index <- index - 1
                    buf[index.usize()] <- 45.u8()
            printr((&buf[index.usize()]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr("|")
        print_i64(value)

def emit_view(view: sview):
    can Console.Write, Abort.Panic:
        printr("[")
        index: mutable i64 = 0
        length: i64 = sview_len(view).i64()
        while index < length |index, view, length|:
            byte: u8 = sview_at(view, index.usize())
            if byte == 10.u8():
                printr("\\n")
            elif byte == 92.u8():
                printr("\\\\")
            else:
                one: mutable u8[2] = zeroed
                one[0] <- byte
                trusted Unsafe.PointerCast:
                    printr((&one[0]).cast[cstr])
            index <- index + 1
        printr("]")

def emit_text(text: dstr):
    can Console.Write, Memory.Allocate, Abort.Panic:
        emit_view(bytes_view(text))

def key_list() -> darray[sview]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[sview] = []
        out.push("A")
        out.push("B")
        out.push("C")
        out.push("D")
        out.push("E")
        out.push("F")
        out.push("G")
        out.push("H")
        out.push("SEMICOLON")
        out.push("J")
        out.push("K")
        out.push("L")
        out.push("M")
        out.push("N")
        out.push("O")
        return out

def modalities_for(which: i64) -> darray[Modality]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[Modality] = []
        if which == 0:
            out.push(Modality.Position1)
            out.push(Modality.Audio)
        elif which == 1:
            out.push(Modality.Position1)
            out.push(Modality.VisAudio)
            out.push(Modality.AudioVis)
            out.push(Modality.Arithmetic)
        elif which == 2:
            out.push(Modality.Vis1)
            out.push(Modality.Vis2)
            out.push(Modality.Vis3)
            out.push(Modality.Color)
            out.push(Modality.Image)
        elif which == 3:
            for index in 0..<15 |out|:
                out.push(input_modality_at(index))
        else:
            out.push(Modality.Position1)
            out.push(Modality.Arithmetic)
        return out

def answer_sequence(which: i64) -> sview:
    if which == 0:
        return ""
    if which == 1:
        return "."
    if which == 2:
        return "12.50"
    if which == 3:
        return "-12.5"
    if which == 4:
        return "--7"
    if which == 5:
        return ".5"
    if which == 6:
        return "1..2"
    if which == 7:
        return "000"
    return "-0.00"

def feed_answer(state: mutable ArithmeticAnswer&, sequence: sview):
    can Abort.Panic:
        index: mutable i64 = 0
        length: i64 = sview_len(sequence).i64()
        while index < length |index, sequence|:
            arithmetic_input(state, sview_at(sequence, index.usize()))
            index <- index + 1

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(32 * 1024 * 1024)
        in work:
            tables: ModeTables = ModeTables()
            keys: darray[sview] = key_list()
            print("names|spec|which|multi|started|hide|jaeggi|mouse|clinical|mode|session|back|varnback|interval|numtrials|total|cells|active|grid3d|cubes|advance|fallback|answer_case|showfeedback|showmissed|verdict|pressed|audiovis|missed")
            for spec in 0..<180 |tables, keys|:
                which: i64 = spec % 5
                multi: i64 = 1 + spec % 6
                started: bool = spec % 7 == 1
                hide: bool = spec % 9 == 4
                jaeggi: bool = spec % 5 == 2
                mouse: bool = spec % 3 != 0
                clinical: bool = spec % 11 == 3
                mode: i64 = 10 if spec % 4 == 0 else 2 + spec % 10
                session: i64 = 1 + spec % 6
                back: i64 = 1 + spec % 5
                varnback: bool = spec % 4 == 1
                interval: i64 = 800 + spec % 3 * 100 if spec % 2 == 0 else 1200 + spec % 5 * 137
                numtrials: i64 = 15 + spec % 8
                total: i64 = numtrials + 4 + spec % 11
                grid3d: bool = spec % 6 == 2
                cubes: i64 = 1 + spec % 4
                cells: i64 = ipow(6, cubes) if grid3d else 16 + spec % 9
                active: i64 = cells - (spec % 5) if spec % 3 == 1 else cells
                advance: i64 = 75 + spec % 4
                fallback: i64 = 45 + spec % 3
                sequence: sview = answer_sequence(spec % 9)
                showfeedback: bool = spec % 4 != 0
                showmissed: bool = spec % 3 == 1
                verdict: i64 = spec % 4
                pressed: bool = spec % 2 == 0
                audiovis: bool = spec % 5 == 1
                missed: bool = spec % 6 == 0

                printr("spec|")
                print_i64(spec)
                emit_cell(which)
                emit_cell(multi)
                emit_cell(1 if started else 0)
                emit_cell(1 if hide else 0)
                emit_cell(1 if jaeggi else 0)
                emit_cell(1 if mouse else 0)
                emit_cell(1 if clinical else 0)
                emit_cell(mode)
                emit_cell(session)
                emit_cell(back)
                emit_cell(1 if varnback else 0)
                emit_cell(interval)
                emit_cell(numtrials)
                emit_cell(total)
                emit_cell(cells)
                emit_cell(active)
                emit_cell(1 if grid3d else 0)
                emit_cell(cubes)
                emit_cell(advance)
                emit_cell(fallback)
                emit_cell(spec % 9)
                emit_cell(1 if showfeedback else 0)
                emit_cell(1 if showmissed else 0)
                emit_cell(verdict)
                emit_cell(1 if pressed else 0)
                emit_cell(1 if audiovis else 0)
                emit_cell(1 if missed else 0)
                print("")

                modalities: darray[Modality] = modalities_for(which)
                total_modalities: i64 = modalities.count.i64()
                index: mutable i64 = 0
                for one in modalities |index, total_modalities, keys|:
                    if one != Modality.Arithmetic:
                        printr("feedback")
                        emit_cell(index)
                        emit_cell(1 if feedback_is_visible(started, hide, true) else 0)
                        emit_cell(feedback_answer_state(showfeedback, pressed,
                                                        verdict, audiovis,
                                                        showmissed, missed))
                        printr("|")
                        emit_text(feedback_label_text(&keys, one, multi, index,
                                                      total_modalities, jaeggi,
                                                      mouse))
                        print("")
                    index <- index + 1

                answer: mutable ArithmeticAnswer = ArithmeticAnswer()
                feed_answer(&answer, sequence)
                printr("answer")
                printr("|")
                emit_text(arithmetic_display_text(&answer,
                                                  which == 1 or which == 4,
                                                  started, hide, showfeedback,
                                                  showmissed, verdict))
                emit_cell(arithmetic_answer_state(showfeedback, showmissed, verdict))
                print("")
                printr("session")
                printr("|")
                emit_text(session_info_text(started, clinical, 3 + spec % 4,
                                             interval, numtrials, total, cells,
                                             active, grid3d, cubes))
                print("")
                printr("threshold")
                printr("|")
                emit_text(threshold_text(started, spec % 4 == 0, clinical,
                                         advance, fallback))
                print("")
                printr("space")
                printr("|")
                emit_text(space_prompt_text(&tables, mode, session, back,
                                            varnback, started, active, cells,
                                            total))
                print("")
                print("end")
        destroy work
        return 0
