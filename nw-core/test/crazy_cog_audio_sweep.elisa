include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/crazy_cog_audio.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Console.Write:
        machine: CrazyCog::Machine = zeroed
        run: mutable CrazyCog::Run = CrazyCog::begin(machine)
        run.time <- 0.05
        CrazyCog::note(&run, 0.05, 900.0, CrazyCog::TICK, 0.3, 0.6)
        run.time <- 0.09
        CrazyCog::note(&run, 0.15, 90.0, CrazyCog::CLUNK, 0.4)
        run.time <- 0.28
        CrazyCog::note(&run, 0.45, 140.0, CrazyCog::HUM, 0.3, -0.6)
        run.time <- 0.42
        CrazyCog::note(&run, 0.3, 55.0, CrazyCog::GRIND, 0.45, -0.6)
        run.time <- 0.53
        CrazyCog::note(&run, 0.6, 880.0, CrazyCog::DONE, 0.5)
        run.time <- 0.6
        CrazyCog::note(&run, 0.45, 280.0, CrazyCog::MISS, 0.2, 0.4)
        for i in 0..<15 |run|:
            data: mutable u8[8820] = zeroed
            begin: f64 = i.f64() * 0.1
            count: i64 = CrazyCogAudio::render(&run, begin, begin + 0.1, &data[0], 8820)
            for j in 0..<count |data|:
                _ = dprintf(1.i32(), "%02x", data[j.usize()].i32())
            _ = dprintf(1.i32(), "\n")
        return 0.i32()
