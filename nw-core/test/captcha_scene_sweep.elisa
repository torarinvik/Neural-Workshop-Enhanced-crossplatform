include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_captcha.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def frame(rung: i64, phase: i64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        game: mutable CaptchaGame::Session = CaptchaGame::initialize(rung, 1, false, 17)
        if phase != CaptchaGame::READY:
            _ = CaptchaGame::event(&game, CaptchaGame::START, 0) can Global{Read,Write}
            _ = CaptchaGame::event(&game, 0, 100) can Global{Read,Write}
            if phase == CaptchaGame::JUDGED or phase == CaptchaGame::DONE:
                _ = CaptchaGame::event(&game, Captcha::SUBMIT, 120) can Global{Read,Write}
                if phase == CaptchaGame::DONE:
                    _ = CaptchaGame::advance(&game, 2620) can Global{Read,Write}

        list: mutable Display::DisplayList = Display::DisplayList()
        SceneCaptcha::render(&list, &game, false)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g %.9g %.9g %.9g ", cmd.color, cmd.a.f64(),
                    cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_MULTILINE and cmd.color == 0x3cc86edc:
                _ = printf("ring %.9g %.9g %.9g\n", cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
            elif cmd.kind == Display::CMD_RECT:
                _ = printf("paper %u %.9g %.9g %.9g %.9g\n", cmd.color,
                    cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64())
        _ = printf("end\n")
        CaptchaGame::close(&game) can Global{Read,Write}

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        levels: i64[5] = [1, 7, 13, 20, 30]
        for rung in levels:
            for phase in 0..<4 |rung, phase|:
                region scratch(1048576):
                    in scratch:
                        frame(rung, phase) can Global{Read,Write}
        return 0.i32()
