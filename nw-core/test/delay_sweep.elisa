include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/delay.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def main() -> i32:
    can Abort.Panic, Console.Write:
        for rung in 1..<36 |rung|:
            for seed in -8..<8 |rung, seed|:
                run: mutable Delay::Run = zeroed
                Delay::deal(rung, seed, &run)
                _ = printf("%lld %lld %lld %lld %lld %.12g\n", rung, seed, Delay::floor_score(&run),
                    Delay::reference(&run), Delay::best(&run), Delay::par(&run))
                for k in 0..<Delay::OFFER_COUNT |run|:
                    offer: Delay::Offer = run.offers[k.usize()]
                    _ = printf("%lld %lld %.17g\n", offer.small, offer.large, offer.wait)
        return 0.i32()
