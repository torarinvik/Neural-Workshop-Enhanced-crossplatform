# Differential sweep driver for src/scene_twohands.elisa.
# See scene_twohands_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_twohands.elisa"
include "scene_emit.elisa"

const ASKED: cstr = "Rung 3, three lanes. 60 rows of road, 90 ticks to drive them, top gear 3. A jump clears anything flat and nothing that stands up."

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|phase|black|at|hazards|car_lane|air|sky|downed|loaded|gear|top_gear|trial|total_trials|tall|verdict")
        region w(256 * 1024 * 1024)
        in w:
            for spec in 0..<40:
                phase: i64 = spec % 5
                black: bool = spec % 7 == 1
                # The car walks the road in sub-rows, so the bands slide and
                # the dashes swap rows with them.
                at: i64 = spec * 3
                hazards: i64 = (spec / 5) % 8
                # A lane and a half: the car is drawn where it actually is
                # between two lanes, which it has to be for the whole of a
                # swerve.
                car_lane: i64 = spec % 5
                # Ticks of the jump still owed, and the arc it makes:
                # highest in the middle and on the ground at both ends, so
                # the lift says how much of the hop is left.
                air: i64 = 0 if spec % 3 != 1 else 1 + spec % 4
                in_air: bool = air > 0
                part: f64 = 1.0 - (air.f64() - 0.5) / 4.0
                bulge: f64 = 1.0 - (2.0 * part - 1.0) * (2.0 * part - 1.0)
                lift: f64 = bulge if bulge > 0.0 else 0.0
                sky: i64 = (spec / 5) % 5
                downed: i64 = (spec / 5) % 3
                loaded: bool = spec % 4 == 2
                gear: i64 = spec % 4
                top_gear: i64 = 3 + (spec / 5) % 2
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 3 else -1
                ticks: i64 = at % 91
                walked: f64 = at.f64() / 240.0
                road_share: f64 = walked if walked < 1.0 else 1.0
                spent: f64 = ticks.f64() / 90.0
                clock_share: f64 = spent if spent < 1.0 else 1.0
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(at)
                emit_bar(hazards)
                emit_bar(car_lane)
                emit_bar(air)
                emit_bar(sky)
                emit_bar(downed)
                emit_bar(1 if loaded else 0)
                emit_bar(gear)
                emit_bar(top_gear)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")

                # All nine kinds, standing at whole SUB-ROWS down the road --
                # which is where the model puts them, and the only way the
                # two sides agree about `ahead` to the last bit. The window
                # is `-0.6 <= ahead <= SIGHT`, and the sweep applies it here
                # because the reference applies it there.
                road: mutable darray[SceneTwoHands::TwoHandsHazard] = []
                for index in 0..<hazards |road, at|:
                    body: i64 = at + 2 + index * 7
                    ahead: f64 = (body - at).f64() / 4.0
                    if ahead >= -0.6 and ahead <= 14.0:
                        road.push(SceneTwoHands::TwoHandsHazard{
                            ahead: ahead,
                            lane: (index % 3).f64(),
                            kind: index % 9})
                targets: mutable darray[SceneTwoHands::TwoHandsTarget] = []
                for index in 0..<sky |targets, downed|:
                    targets.push(SceneTwoHands::TwoHandsTarget{
                        across: 0.11 + 0.19 * index.f64(),
                        up: 0.17 + 0.16 * (index % 4).f64(),
                        downed: index < downed})

                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneTwoHands::TwoHandsPaint = SceneTwoHands::paint_of(black, width, height, 2.0, 2.0)
                SceneTwoHands::render(&list, &paint, phase, true, at, &road,
                                      car_lane.f64() / 2.0,
                                      lift, in_air,
                                      &targets, 0.29 + 0.07 * (spec % 8).f64(),
                                      0.23 + 0.09 * (spec % 6).f64(), loaded,
                                      # The two bars are `min(1, at/length)`
                                      # and `min(1, ticks/clock)`, and the
                                      # counters under them are the same
                                      # numbers said in words -- so they are
                                      # derived here rather than named, or
                                      # the bar and its label would disagree.
                                      road_share, clock_share, gear, top_gear,
                                      at / 4, 60, ticks, 90,
                                      at % 23, downed, sky,
                                      sview(ASKED, 0, -1), 1 + spec % 5, 5,
                                      sview("Drive and shoot", 0, -1), verdict,
                                      sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
