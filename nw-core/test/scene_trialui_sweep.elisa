# Differential sweep driver for src/scene_trialui.elisa.
# See scene_trialui_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/textmetrics.elisa"
include "../src/display.elisa"
include "../src/scene_trialui.elisa"
include "scene_emit.elisa"

# Feedback prompts of very different lengths, because the x is estimated from
# the character count and a short one and a long one pull apart differently.
const PROMPT_COUNT: i64 = 6

def prompt_of(which: i64) -> cstr:
    if which == 0:
        return "A: position match"
    elif which == 1:
        return "Left-click or A: position match"
    elif which == 2:
        return "L: audio"
    elif which == 3:
        return "S: color & n-vis"
    elif which == 4:
        return "D: vis2 & n-audio"
    return ";: arithmetic"

const ARITHMETIC: cstr = "Answer: -12.5"
const SESSION: cstr = "Session:\n1400 ms/trial\n20+5 trials\n35 seconds\nGrid 4×4 (12/16 cells)"
const THRESHOLDS: cstr = "Thresholds:\nRaise level: ≥ 80%\nLower level: < 50%"
const SPACE: cstr = "Press SPACE to begin session #3: Dual 2-Back"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|black|total|answer|arith_answer|bold|tall")
        region w(64 * 1024 * 1024)
        in w:
            for spec in 0..<40:
                black: bool = spec % 3 == 1
                # One modality through six: the font ladder steps at four,
                # five and six, and the spacing divides by `total - 0.99`, so
                # a single label is the case that would divide by zero.
                total: i64 = 1 + spec % 6
                answer: i64 = spec % 4
                arith_answer: i64 = (spec / 6) % 4
                bold: bool = spec % 5 == 4
                tall: i64 = 1368 if spec % 2 == 0 else 960
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(1 if black else 0)
                emit_bar(total)
                emit_bar(answer)
                emit_bar(arith_answer)
                emit_bar(1 if bold else 0)
                emit_bar(tall)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneTrialUI::TrialPaint = SceneTrialUI::paint_of(black, width, height, 2.0, 2.0)
                for pos in 0..<total |list, paint, total, answer|:
                    text: sview = sview(prompt_of(pos % PROMPT_COUNT), 0, -1)
                    SceneTrialUI::put_feedback(&list, &paint, text,
                                               TextMetrics::codepoints(text),
                                               pos, total,
                                               (answer + pos) % 4)
                SceneTrialUI::put_arithmetic(&list, &paint,
                                             sview(ARITHMETIC, 0, -1),
                                             arith_answer)
                SceneTrialUI::put_session_info(&list, &paint,
                                               sview(SESSION, 0, -1), bold)
                SceneTrialUI::put_thresholds(&list, &paint,
                                             sview(THRESHOLDS, 0, -1))
                SceneTrialUI::put_space_prompt(&list, &paint,
                                               sview(SPACE, 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
