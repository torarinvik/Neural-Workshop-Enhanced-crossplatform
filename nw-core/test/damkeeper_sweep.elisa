include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/damkeeper_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, seed: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        valley: DamKeeper::Valley = DamKeeper::deal(rung, seed)
        level: DamKeeper::Grade = valley.level
        _ = printf("valley %lld %lld %lld %lld %.17g %.17g %.17g %.17g %lld\n",
            rung, seed, level.dams, level.storms, level.rain, level.delay, level.flood, level.stiff, 1 if level.hidden else 0)
        for i in 0..<level.storms |valley|:
            storm: DamKeeper::Storm = valley.storms[i.usize()]
            _ = printf("storm %.17g %.17g %.17g %.17g\n", storm.start, storm.speed, storm.width, storm.rain)
        for i in 0..<level.dams |valley|:
            _ = printf("water %.17g\n", valley.initial[i.usize()])
        run: mutable DamKeeper::Run = DamKeeper::initialize()
        for policy in 0..<3 |valley, level, run|:
            DamKeeper::reset(&run, valley)
            tick: mutable i64 = 0
            while run.result == DamKeeper::RUNNING |run, policy, tick, level|:
                port: i64 = DamKeeper::autopilot(&run) if policy == 0 else (2 * (level.dams - 1) if policy == 2 and tick < 4 else -1)
                _ = DamKeeper::press(&run, port)
                dt: f64 = DamKeeper::SUBSTEP if policy < 2 else (0.0 if tick % 23 == 0 else (0.037 if tick % 2 == 0 else 0.011))
                DamKeeper::step(&run, dt)
                _ = printf("tick %lld %lld %lld %lld %lld %.17g %.17g %.17g", policy, tick, port, run.result,
                    run.fault_dam, run.t, run.town, run.flood_for)
                for i in 0..<level.dams |run|:
                    k: usize = i.usize()
                    _ = printf(" %.17g %lld %.17g %.17g %.17g %.17g", run.water[k], run.gate[k], run.opening[k],
                        run.arriving[k], run.low_for[k], DamKeeper::in_pipe(&run, i))
                _ = printf("\n")
                tick <- tick + 1

def game_state(game: DamKeeperGame::Session&, label: cstr, accepted: bool):
    can Console.Write, Abort.Panic:
        _ = printf("game %s %lld %lld %lld %lld %lld %lld %lld %.17g %.17g\n", label,
            1 if accepted else 0, game.phase, game.rung, game.trial, game.passed, game.best, game.run.result,
            game.run.t, game.deadline)

def session():
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
        game: mutable DamKeeperGame::Session = DamKeeperGame::initialize(4, 2, true, 17)
        accepted: mutable bool = DamKeeperGame::input(&game, DamKeeperGame::START, 5.0) can Global{Read,Write}
        game_state(&game, "start", accepted)
        accepted <- DamKeeperGame::advance(&game, 7.0) can Global{Read,Write}
        game_state(&game, "clamp", accepted)
        index: mutable i64 = 1
        while game.phase == DamKeeperGame::PLAYING |game, index|:
            _ = DamKeeperGame::advance(&game, 7.0 + index.f64() / 60.0) can Global{Read,Write}
            index <- index + 1
        game_state(&game, "fail", true)
        deadline: f64 = game.deadline
        accepted <- DamKeeperGame::advance(&game, deadline - 0.001) can Global{Read,Write}
        game_state(&game, "wait", accepted)
        accepted <- DamKeeperGame::advance(&game, deadline) can Global{Read,Write}
        game_state(&game, "next", accepted)
        index <- 1
        while game.phase == DamKeeperGame::PLAYING |game, index, deadline|:
            now: f64 = deadline + index.f64() / 60.0
            port: i64 = DamKeeper::autopilot(&game.run)
            if port >= 0:
                _ = DamKeeperGame::agent_event(&game, now, port) can Global{Read,Write}
            _ = DamKeeperGame::agent_event(&game, now, -1) can Global{Read,Write}
            index <- index + 1
        game_state(&game, "pilot", true)
        accepted <- DamKeeperGame::agent_event(&game, deadline + index.f64() / 60.0, -1) can Global{Read,Write}
        game_state(&game, "done", accepted)
        accepted <- DamKeeperGame::input(&game, DamKeeperGame::START, deadline + index.f64() / 60.0 + 1.0) can Global{Read,Write}
        game_state(&game, "restart", accepted)
        DamKeeperGame::close(&game) can Global{Read,Write}

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
        levels: i64[9] = [1, 3, 4, 7, 10, 13, 16, 20, 35]
        for index in 0..<9 |levels|:
            region scratch(262144):
                in scratch:
                    emit(levels[index.usize()], -4 + index)
        session() can Global{Read,Write}
        return 0.i32()
