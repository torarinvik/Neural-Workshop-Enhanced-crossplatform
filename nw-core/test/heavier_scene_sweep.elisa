include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_heavier.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Global.Read, Global.Write:
        session: mutable HeavierGame::Session = HeavierGame::initialize(rung, 1, true, 17)
        _ = HeavierGame::start(&session, 0.0)
        if mode >= 1:
            _ = HeavierGame::pointer(&session, 0)
            for frame in 1..<(9 if mode == 1 else 41) |session|:
                _ = HeavierGame::advance(&session, frame.f64() / 10.0)
        if mode == 3:
            _ = HeavierGame::steer(&session, Heavier::FIRST_PICK + Heavier::current(&session.run).answer)
            _ = HeavierGame::clear_controls(&session)
        if mode == 4:
            answer: i64 = (Heavier::current(&session.run).answer + 1) % session.run.round.level.crates
            _ = HeavierGame::steer(&session, Heavier::FIRST_PICK + answer)
        _ = printf("frame %lld %lld\n", rung, mode)
        crates: i64 = session.run.round.level.crates
        for index in 0..<crates |crates|:
            row: SceneHeavier::Lane = SceneHeavier::lane(index, crates)
            pick: SceneHiddenRule::Rect = SceneHeavier::button(row)
            _ = printf("hit %lld %lld %lld\n", SceneHeavier::hit(crates, SceneHeavier::START_X, row.floor),
                SceneHeavier::hit(crates, pick.x + pick.w / 2.0, pick.y + pick.h / 2.0),
                SceneHeavier::hit(crates, 0.0, row.floor))
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneHeavier::course(&list, &session.run, HeavierGame::held(&session))
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneHeavier::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 4, 7, 10, 30]:
            for mode in 0..<5 |rung|:
                region scratch(2097152):
                    in scratch:
                        emit(rung, mode)
        return 0.i32()
