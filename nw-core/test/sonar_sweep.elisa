include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/sonar_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit_session():
    can Console.Write, Abort.Panic:
        session: mutable SonarGame::Session = SonarGame::initialize(1, 2, true, -1729)
        _ = SonarGame::input(&session, SonarGame::START, -1, 100)
        _ = SonarGame::input(&session, 0, -1, 105)
        _ = printf("survey %lld %lld %lld %.17g\n", session.phase, session.trial, session.cursor, session.par)
        _ = SonarGame::input(&session, SonarGame::DIG, Sonar::target(&session.board), 200)
        early: bool = SonarGame::advance(&session, 1999)
        _ = printf("judged %lld %lld %lld %lld %lld\n", session.rung, session.wins, session.best_rung,
            session.elapsed_ms, 1 if early else 0)
        _ = SonarGame::advance(&session, 2000)
        _ = printf("survey %lld %lld %lld %.17g\n", session.phase, session.trial, session.cursor, session.par)
        for at in 0..<session.board.dealt.budget |session|:
            _ = SonarGame::input(&session, SonarGame::PING, -1, 2010 + at)
        _ = printf("loss %lld %lld %lld %lld\n", session.phase, session.rung, session.board.cost, session.deadline_ms)
        _ = SonarGame::advance(&session, 2200, true)
        _ = printf("done %lld %lld %.17g\n", session.phase, session.wins, SonarGame::mean_cost(&session))
        _ = SonarGame::input(&session, SonarGame::START, -1, 2300)
        _ = printf("restart %lld %lld %lld %lld %.17g\n", session.phase, session.trial, session.wins,
            Sonar::target(&session.board), session.par)

def main() -> i32:
    can Console.Write, Abort.Panic:
        levels: i64[11] = [0, 1, 2, 3, 5, 7, 8, 10, 15, 23, 100]
        for index in 0..<11 |levels|:
            rng: mutable MT19937 = zeroed
            mt_seed_int(&rng, 1729.u64())
            rung: i64 = levels[index.usize()]
            # Reuse the RNG for another deal to detect missing draws even
            # when those draws have no visible effect on the current board.
            for trial in 0..<2 |rng, rung|:
                dealt: Sonar::Deal = Sonar::deal(rung, &rng)
                level: Sonar::Grade = dealt.level
                _ = printf("deal %lld %lld %lld %lld %lld %.17g %.17g %lld %.17g %lld\n",
                    rung, trial, level.side, level.width, level.bands, level.noise, level.drift,
                    level.penalty, level.slack, dealt.budget)
                for at in 0..<(dealt.budget + 1) |dealt|:
                    _ = printf("path %lld %lld\n", dealt.path[at.usize()], dealt.lies[at.usize()])
                _ = printf("last %lld\n", dealt.path[(dealt.budget + 1).usize()])
                round: mutable Sonar::Round = Sonar::initialize(dealt)
                for at in 0..<dealt.budget |round|:
                    side: i64 = round.dealt.level.side
                    target: i64 = Sonar::target(&round)
                    cell: i64 = (target + 1 + 17 * at % (side * side - 1)) % (side * side)
                    reading: mutable i64 = -1
                    if at % 3 == 0:
                        _ = Sonar::dig(&round, cell)
                    else:
                        reading <- Sonar::ping(&round, cell)
                    _ = printf("act %lld %lld %lld %lld %lld\n", cell, reading, round.cost, Sonar::target(&round), 1 if round.over else 0)
                _ = printf("over %lld %lld\n", Sonar::ping(&round, 0), 1 if Sonar::dig(&round, Sonar::target(&round)) else 0)
                won: mutable Sonar::Round = Sonar::initialize(dealt)
                _ = Sonar::dig(&won, Sonar::target(&won))
                _ = printf("win %lld %lld %lld %lld\n", 1 if won.over else 0, 1 if won.found else 0, won.actions, won.cost)
                solver: mutable MT19937 = zeroed
                mt_seed_int(&solver, 0.u64())
                belief: mutable SonarReference::Belief = SonarReference::initialize(level)
                reference: mutable Sonar::Round = Sonar::initialize(dealt)
                while not reference.over |solver, belief, reference|:
                    action: i64 = SonarReference::reference_move(&belief, &solver)
                    digging: bool = action >= SonarReference::DIG
                    cell: i64 = action - SonarReference::DIG if digging else action
                    _ = printf("ref %lld %lld\n", 1 if digging else 0, cell)
                    if digging:
                        if not Sonar::dig(&reference, cell):
                            SonarReference::missed(&belief, cell)
                    else:
                        reading: i64 = Sonar::ping(&reference, cell)
                        SonarReference::heard(&belief, cell, reading)
                _ = printf("par %.17g\n", SonarReference::par(&dealt))
        emit_session()
        return 0.i32()
