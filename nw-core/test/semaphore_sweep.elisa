include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/semaphore_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# Semaphore against semaphore.py, for semaphore_diff.py: the code chart, the
# grade table, dealt messages, and every step of play -- the reference
# autopilot at nine rungs, then three ways to take strikes: letting every
# signal pass, the right pose with the wrong letter, and a letter typed with
# the flags nowhere near the pose.

def pcm(run: Semaphore::Run&, bank: DrShapeAudio::Bank&, start: f64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region audio(524288):
            in audio:
                bytes: mutable u8[8824] = zeroed
                used: i64 = SemaphoreAudio::render(run, bank, start, start + 0.1, &bytes[0], 8824)
                _ = printf("audio %.17g\n", start)
                for j in 0..<used |bytes|:
                    _ = printf("%02x", bytes[j.usize()].i32())
                _ = printf("\n")

# The player for each mode: 0 the reference autopilot, 1 nobody, 2 the
# autopilot with every letter one along, 3 the right letter at once.
def player(run: Semaphore::Run&, mode: i64) -> i64:
    can Abort.Panic:
        return Semaphore::pilot(run) if mode == 0
        return -1 if mode == 1
        if mode == 2:
            port: i64 = Semaphore::pilot(run)
            return port if port < HandView::KEYS
            return HandView::KEYS + (port - HandView::KEYS + 1) % Semaphore::LETTERS
        k: i64 = Semaphore::index(run)
        return -1 if k < 0 or run.read[k.usize()] != -1
        return HandView::KEYS + run.message.text[k.usize()]

def replay(rung: i64, seed: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(4194304):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                message: Semaphore::Message = Semaphore::deal(rung, &draw)
                _ = printf("message %lld %lld %lld %lld %d %u %lld", mode, rung, seed, message.seed,
                    1 if message.valid else 0, py_getrandbits(&draw, 32).u32(), message.count)
                for i in 0..<message.count |message|:
                    _ = printf(" %lld %d", message.text[i.usize()], 1 if message.turned[i.usize()] else 0)
                _ = printf("\n")
                run: mutable Semaphore::Run = Semaphore::begin(message)
                while run.result == Semaphore::LIVE |run, mode|:
                    port: i64 = player(&run, mode)
                    Semaphore::act(&run, port)
                    Semaphore::step(&run, 1.0 / 60.0)
                    theirs: RoomsView::Point = Semaphore::theirs(&run)
                    _ = printf("%lld %lld %.17g %.17g %d %.17g %.17g %.17g %lld %lld %lld %lld %lld %d %lld %.17g %.17g %d %lld %d %lld ",
                        port, run.result, run.hand.x, run.hand.y, 1 if run.hand.down else 0, run.time,
                        run.flags[0], run.flags[1], run.held, run.strikes, run.said, run.said_letter,
                        run.rung_at, 1 if run.matched else 0, Semaphore::index(&run), theirs.x, theirs.y,
                        1 if Semaphore::back(&run) else 0, Semaphore::helped(&run),
                        1 if Semaphore::fogged(&run) else 0, Semaphore::pose(&run))
                    for i in 0..<message.count |run|:
                        value: i64 = run.read[i.usize()]
                        _ = printf("%c", 110 if value == -1 else (49 if value == 1 else 48))
                    _ = printf("\n")
                _ = printf("end %lld %lld\n", run.result, Semaphore::read_count(&run))
                _ = printf("notes %lld\n", run.notes.count.i64())
                for cue in run.notes:
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g %.17g\n",
                        cue.seed, cue.voice, cue.t, cue.dur, cue.freq, cue.gain, cue.pan)
                bank: DrShapeAudio::Bank = SemaphoreAudio::patches()
                pcm(&run, &bank, 0.0)
                pcm(&run, &bank, 2.0)
                pcm(&run, &bank, run.time - 0.04)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        chart: i64[26] = Semaphore::code()
        _ = printf("code")
        for i in 0..<26 |chart|:
            _ = printf(" %lld", chart[i.usize()])
        _ = printf("\n")
        for rung in 0..<81:
            g: Semaphore::Grade = Semaphore::grade(rung)
            _ = printf("grade %lld %lld %.17g %.17g %lld %.17g %d %d %d %lld %.17g\n",
                g.rung, g.letters, g.hold, g.near, g.help, g.roll, 1 if g.turns else 0,
                1 if g.words else 0, 1 if g.fog else 0, g.strikes, g.seconds)
        for rung in [1.i64(), 4.i64(), 7.i64(), 10.i64(), 13.i64(), 16.i64(), 20.i64(), 25.i64(), 30.i64()]:
            replay(rung, 17, 0)
        for mode in 1..<4:
            replay(1, 19, mode)
        return 0
