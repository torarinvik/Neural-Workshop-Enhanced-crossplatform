# Differential sweep driver for src/scene_ninarow.elisa.
# See scene_ninarow_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/pyset.elisa"
include "../src/tasks/maze.elisa"
include "../src/tasks/ninarow.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_ninarow.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(512 * 1024 * 1024)
        in w:
            width: f64 = 1824.0
            height: f64 = 1368.0
            cells: mutable darray[i64] = Ints::zeros(40000)
            scratch: mutable darray[i64] = Ints::zeros(40000)
            extras: mutable darray[i64] = Ints::zeros(40000)
            order: mutable darray[i64] = Ints::zeros(40000)
            print("names|spec|rung|seed|phase|black|has_puzzle|trial|total_trials|choice|show_answer")
            for rung in [1, 2, 3, 4, 5, 6] |cells, scratch, extras, order, width, height|:
                grade: NinaRow::Grade = NinaRow::grade_at(rung)
                table: NinaRow::Lines = NinaRow::lines_new(grade.size, grade.length)
                patterns: NinaRow::Patterns = NinaRow::candidate_patterns(&table)
                for seed in [0, 7, 42, 1234] |cells, scratch, extras, order, rung, table, patterns, width, height|:
                    puzzle: mutable NinaRow::Puzzle = NinaRow::generate(&table, &patterns, rung, seed, 0, cells, scratch, extras, order)
                    spec: i64 = rung * 10 + seed % 10
                    phase: i64 = 1 if seed % 3 != 2 else 2
                    black: bool = seed % 2 == 1
                    has_puzzle: bool = puzzle.ok
                    choice: i64 = (seed * 3) % (puzzle.size * puzzle.size) if puzzle.ok else 0
                    show_answer: bool = seed % 2 == 0
                    printr("spec|")
                    print_i64(spec)
                    emit_bar(rung)
                    emit_bar(seed)
                    emit_bar(phase)
                    emit_bar(1 if black else 0)
                    emit_bar(1 if has_puzzle else 0)
                    emit_bar(1 + rung % 5)
                    emit_bar(5)
                    emit_bar(choice)
                    emit_bar(1 if show_answer else 0)
                    print("")
                    message: mutable dstr = []
                    if phase == SceneNinaRow::PHASE_ASKING:
                        dstr_append_cstr(&message, "Find the move that completes ")
                        dstr_append_i64(&message, puzzle.length)
                        dstr_append_cstr(&message, " in a row")
                    else:
                        dstr_append_cstr(&message, "Press Space to start")
                    list: mutable Display::DisplayList = Display::DisplayList()
                    paint: SceneNinaRow::Paint = SceneNinaRow::paint_of(black, width, height, 2.0, 2.0)
                    SceneNinaRow::render(&list, &paint, &puzzle, cells, has_puzzle, phase,
                                         1 + rung % 5, 5, choice, show_answer,
                                         bytes_view(message))
                    emit_frame(&list)
                    print("end")
        destroy w
        return 0
