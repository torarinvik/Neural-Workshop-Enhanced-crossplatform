include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_full_stop.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def trace(session: mutable FullStopGame::Session&, corpus: PassageSeed::Corpus&, mode: i64):
    can Memory.Allocate, Memory.Release, Abort.Panic, Global.Read, Global.Write:
        return if mode == 0
        if mode >= 5:
            _ = FullStopGame::agent_event(session, corpus, 0.0, FullStopGame::START)
            time: mutable f64 = 0.0
            while session.phase == FullStopGame::PLAYING |session, corpus, time|:
                _ = FullStopGame::agent_event(session, corpus, time, FullStop::pilot(&session.run))
                time <- time + 1.0 / 60.0
                _ = FullStopGame::agent_event(session, corpus, time, FullStopGame::NEUTRAL)
            if mode == 6:
                _ = FullStopGame::agent_event(session, corpus, time, FullStopGame::NEUTRAL)
            return
        _ = FullStopGame::pointer(session, corpus, 456.0, 342.0, 1, 0.0)
        if mode >= 2:
            t: FullStop::Tile = session.run.layout.tiles[0]
            _ = FullStopGame::pointer(session, corpus, SceneHand::x(t.x), SceneHand::y(t.y), 1, 0.0)
        if mode >= 3:
            _ = FullStopGame::clear_controls(session)
            _ = FullStopGame::input(session, FullStop::RESET)
            _ = FullStopGame::input(session, FullStop::DONE)
            _ = FullStopGame::advance(session, corpus, 0.1)
            if mode == 4:
                _ = FullStopGame::advance(session, corpus, 4.099)
                if session.phase == FullStopGame::JUDGED:
                    _ = FullStopGame::advance(session, corpus, 4.1)

def emit(corpus: PassageSeed::Corpus&, rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        session: mutable FullStopGame::Session = FullStopGame::initialize(rung, 1, true, 17)
        trace(&session, corpus, mode)
        _ = dprintf(1.i32(), "frame %lld %lld %lld %lld %lld %lld %lld %lld\n", rung, mode, 1 if dark else 0,
            session.phase, session.rung, session.trial, session.wins, session.best_rung)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneFullStop::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = dprintf(1.i32(), "text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list|:
                    _ = dprintf(1.i32(), "%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = dprintf(1.i32(), "\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = dprintf(1.i32(), "poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = dprintf(1.i32(), "shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = dprintf(1.i32(), "end\n")
        FullStopGame::close(&session) can Global{Read,Write}

def session_trace(corpus: PassageSeed::Corpus&) -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic, Global.Read, Global.Write:
        session: mutable FullStopGame::Session = FullStopGame::initialize(4, 2, true, 17)
        return 1.i32() if not FullStopGame::start(&session, corpus, 0.0)
        tile: FullStop::Tile = session.run.layout.tiles[0]
        _ = FullStopGame::pointer(&session, corpus, SceneHand::x(tile.x), SceneHand::y(tile.y), 1, 0.0)
        _ = FullStopGame::pointer(&session, corpus, SceneHand::x(tile.x), SceneHand::y(tile.y), 1, 0.0)
        return 2.i32() if session.run.count != 1 or session.run.notes.count.i64() != 1
        _ = FullStopGame::pointer(&session, corpus, SceneHand::x(tile.x), SceneHand::y(tile.y), 2, 0.0)
        return 3.i32() if session.run.hand.down
        _ = FullStopGame::pointer(&session, corpus, SceneHand::x(FullStop::RESET_X), SceneHand::y(FullStop::BUTTON_Y), 1, 0.0)
        return 4.i32() if session.run.count != 0 or session.run.notes.count.i64() != 2
        _ = FullStopGame::pointer(&session, corpus, SceneHand::x(FullStop::DONE_X), SceneHand::y(FullStop::BUTTON_Y), 2, 0.0)
        _ = FullStopGame::pointer(&session, corpus, SceneHand::x(FullStop::DONE_X), SceneHand::y(FullStop::BUTTON_Y), 1, 0.0)
        _ = FullStopGame::advance(&session, corpus, 0.0)
        return 5.i32() if session.phase != FullStopGame::JUDGED or session.rung != 3
        return 6.i32() if FullStopGame::advance(&session, corpus, 3.999)
        _ = FullStopGame::advance(&session, corpus, 4.0)
        return 7.i32() if session.phase != FullStopGame::PLAYING or session.trial != 2 or session.run.notes.count.i64() != 0
        session.run.t <- session.run.machine.seconds
        _ = FullStopGame::advance(&session, corpus, 4.0)
        return 8.i32() if session.phase != FullStopGame::JUDGED or session.run.result != FullStop::TIMEOUT
        _ = FullStopGame::agent_event(&session, corpus, 4.0, FullStopGame::NEUTRAL)
        return 9.i32() if not FullStopGame::reconfigure(&session, 13, 1, false)
        return 10.i32() if not FullStopGame::start(&session, corpus, 4.0) or session.trial != 1 or session.wins != 0
        FullStopGame::close(&session)
        return 0.i32()

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneFullStop::option_note(rung, &note)
            _ = dprintf(1.i32(), "note %lld ", rung)
            for char in note:
                _ = dprintf(1.i32(), "%c", char.i32())
            _ = dprintf(1.i32(), "\n")
        corpus: PassageSeed::Corpus = PassageSeed::offline()
        status: i32 = session_trace(&corpus)
        if status != 0.i32():
            _ = dprintf(2.i32(), "Full Stop session assertion %d\n", status)
            return status
        for rung in [1, 10, 30] |corpus|:
            for mode in 0..<7 |corpus, rung|:
                for dark in 0..<2 |corpus, rung, mode|:
                    region scratch(2097152):
                        in scratch:
                            emit(&corpus, rung, mode, dark != 0)
        return 0.i32()
