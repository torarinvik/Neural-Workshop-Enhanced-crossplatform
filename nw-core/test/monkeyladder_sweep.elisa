# Differential sweep driver for tasks/monkeyladder.elisa. See
# monkeyladder_diff.py for the reference side.
#
# Monkey Ladder has no core module in the reference -- its rules live in
# ui/monkeyladder.py beside the drawing -- so what is compared is the deal, the
# cursor clamp, the click rules and the adaptive ladder, driven through a
# scripted run rather than through a window.
#
# The deal is `random.sample`, whose CPython implementation picks between a
# pool copy and a selected-set by population size and consumes the stream
# differently either way, so a whole dealt sequence is the real check on it.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/monkeyladder.elisa"

# printr(i64) and int_to_string_scratch both trip a stage1 backend decline of
# store_* generics (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)


def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(64 * 1024 * 1024)
        in w:
            # The clamp, over both ends and every grid the options allow.
            for grid in 2..<10:
                for level in 0..<26:
                    printr("clamp")
                    emit_cell(grid)
                    emit_cell(level)
                    emit_cell(MonkeyLadder::clamp_level(level, grid))
                    print("")

            # The deal, across the sample branch boundary: a 3x3 grid is a
            # small population and a 9x9 is not, so both sides of CPython's
            # setsize heuristic are exercised.
            for grid in 3..<10:
                for level in 2..<9:
                    for seed in 1..<4:
                        rng: mutable MT19937 = mt19937_new()
                        mt_seed_int(&rng, (grid * 10000 + level * 100 + seed).u64())
                        round: mutable MonkeyLadder::Round = MonkeyLadder::new_round(grid, level, true)
                        MonkeyLadder::start_round(&round, &rng)
                        printr("deal")
                        emit_cell(grid)
                        emit_cell(level)
                        emit_cell(seed)
                        emit_cell(round.length)
                        for at in 0..<round.length |round|:
                            emit_cell(Ints::at_ref(&round.sequence, at))
                        print("")

            # A whole round walked correctly, then one walked into a miss at
            # every position -- so the level moves both ways and the ignored
            # cases (out of phase, already clicked) are exercised too.
            for grid in 3..<6:
                for miss_at in 0..<6:
                    rng: mutable MT19937 = mt19937_new()
                    mt_seed_int(&rng, (grid * 77 + miss_at).u64())
                    round: mutable MonkeyLadder::Round = MonkeyLadder::new_round(grid, 5, true)
                    MonkeyLadder::start_round(&round, &rng)
                    printr("walk")
                    emit_cell(grid)
                    emit_cell(miss_at)
                    # A click before the input phase is IGNORED, not a miss.
                    emit_cell(MonkeyLadder::click_cell(&round, Ints::at_ref(&round.sequence, 0)))
                    MonkeyLadder::begin_input(&round)
                    for step in 0..<round.length |round, miss_at, grid|:
                        break if round.phase == MonkeyLadder::PHASE_RESULT
                        right: i64 = Ints::at_ref(&round.sequence, step)
                        # At `miss_at`, click a cell that is not the expected
                        # one; the grid always has more cells than the sequence.
                        cell: i64 = right if step != miss_at else (right + 1) % (grid * grid)
                        emit_cell(MonkeyLadder::click_cell(&round, cell))
                    emit_cell(round.phase)
                    emit_cell(round.level)
                    emit_cell(round.wrong)
                    emit_cell(round.clicked_n)
                    # And a click after the round has ended.
                    emit_cell(MonkeyLadder::click_cell(&round, Ints::at_ref(&round.sequence, 0)))
                    print("")

            # The cursor clamp, walked off every edge.
            for grid in 2..<7:
                round: mutable MonkeyLadder::Round = MonkeyLadder::new_round(grid, 3, false)
                for step in 0..<12 |round, grid|:
                    d_row: i64 = 1 if step % 4 == 0 else (-1 if step % 4 == 1 else 0)
                    d_col: i64 = 1 if step % 4 == 2 else (-1 if step % 4 == 3 else 0)
                    MonkeyLadder::move_cursor(&round, d_row * (step / 4 + 1), d_col * (step / 4 + 1))
                    printr("cursor")
                    emit_cell(grid)
                    emit_cell(step)
                    emit_cell(round.cursor_row)
                    emit_cell(round.cursor_col)
                    emit_cell(MonkeyLadder::cursor_cell(&round))
                    print("")
        destroy w
        return 0
