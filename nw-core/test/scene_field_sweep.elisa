# Differential sweep driver for src/scene_field.elisa.
# See scene_field_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/gamemode.elisa"
include "../src/board.elisa"
include "../src/display.elisa"
include "../src/scene_field.elisa"
include "scene_emit.elisa"

# The glyph a spec draws, chosen by index so the two sides can agree on it
# without the sweep having to print text.
def glyph_text(index: i64) -> sview:
    can Memory.Allocate:
        return sview("7", 0, -1) if index == 0 else (sview("12", 0, -1) if index == 1 else (sview("-3", 0, -1) if index == 2 else sview("K", 0, -1)))

def variable_text(index: i64) -> sview:
    can Memory.Allocate:
        return sview("2", 0, -1) if index == 0 else (sview("3", 0, -1) if index == 1 else sview("5", 0, -1))

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|expanded|black|n|include_center|grid_3d|crosshairs|paused|has_position|variable_mode|position|stim|shrunk|sharp|glyph|variable|cubes|color_id|pattern|tall")
        region w(64 * 1024 * 1024)
        in w:
            for spec in 0..<48:
                expanded: bool = spec % 5 == 1
                black: bool = spec % 3 == 1
                n: i64 = 3 + (spec / 4) % 4
                include_center: bool = spec % 7 == 2
                grid_3d: bool = spec % 4 == 3
                cubes: i64 = 1 + spec % 6
                color_id: i64 = 1 + spec * 3 % 40
                # Zero is the colour-only pattern, which lights every face.
                pattern: i64 = (spec * 7 % 60) - 1
                crosshairs: bool = spec % 4 != 3
                paused: bool = spec % 9 == 4
                has_position: bool = spec % 5 != 2
                variable_mode: bool = spec % 13 == 6
                position: i64 = spec * 5 % (n * n + 2)
                # 0 none, 1 old-style square, 2 sprite square, 3 glyph. A 3D
                # board draws none of them: `spawn` sends vis == 0 to the
                # pattern, and the label branches are its elif.
                stim: i64 = 0 if grid_3d else spec % 4
                shrunk: bool = spec % 2 == 0
                sharp: bool = spec % 6 < 3
                glyph: i64 = spec % 4
                variable: i64 = -1 if spec % 3 == 0 else spec % 3 - 1
                tall: i64 = 1368 if spec % 2 == 0 else 960
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(1 if expanded else 0)
                emit_bar(1 if black else 0)
                emit_bar(n)
                emit_bar(1 if include_center else 0)
                emit_bar(1 if grid_3d else 0)
                emit_bar(1 if crosshairs else 0)
                emit_bar(1 if paused else 0)
                emit_bar(1 if has_position else 0)
                emit_bar(1 if variable_mode else 0)
                emit_bar(position)
                emit_bar(stim)
                emit_bar(1 if shrunk else 0)
                emit_bar(1 if sharp else 0)
                emit_bar(glyph)
                emit_bar(variable)
                emit_bar(cubes)
                emit_bar(color_id)
                emit_bar(pattern)
                emit_bar(tall)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneField::FieldPaint = SceneField::paint_of(black, width, height, 2.0, 2.0)
                field: SceneField::RenderField = SceneField::field_of(width, height, expanded)
                if grid_3d:
                    SceneField::put_cube_stage(&list, &paint, &field)
                    SceneField::put_3d_pattern(&list, &paint, &field, pattern, color_id, cubes)
                else:
                    SceneField::put_grid(&list, &paint, &field, n)
                if SceneField::crosshair_wanted(crosshairs, grid_3d, paused, has_position, variable_mode):
                    SceneField::put_crosshair(&list, &paint, &field)
                at: SceneField::RenderPoint = SceneField::centre_of(&field, n, include_center, grid_3d, position)
                side: i64 = SceneField::stimulus_size(&field, n, shrunk)
                colour: u32 = Display::rgba(19, 6, 224, 255)
                if stim == 1:
                    SceneField::put_old_style_square(&list, &paint, at.x, at.y, side, sharp, colour)
                if stim == 2:
                    SceneField::put_sprite(&list, &paint, 0, 256, 256, at.x, at.y, side,
                                           Display::rgba(255, 255, 255, 255))
                if stim == 3:
                    SceneField::put_glyph(&list, &paint, glyph_text(glyph), at.x, at.y,
                                          &field, n, colour)
                if variable >= 0:
                    SceneField::put_variable(&list, &paint, variable_text(variable),
                                             &field, n, has_position, colour)
                emit_frame(&list)
                print("end")
        destroy w
        return 0
