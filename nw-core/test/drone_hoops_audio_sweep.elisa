include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/drone_hoops_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def window(cues: DroneHoopsSound::Sound&, begin: f64, end: f64):
    can Memory.Allocate, Abort.Panic, Console.Write:
        data: mutable u8[3200] = zeroed
        count: i64 = DroneHoopsAudio::render(cues, begin, end, &data[0], 3200)
        for i in 0..<count |data|:
            _ = printf("%02x", data[i.usize()].i32())
        _ = printf("\n")

def emit(rung: i64, guided: bool):
    can Memory.Allocate, Abort.Panic, Console.Write:
        course: DroneHoops::Course = DroneHoops::deal(rung, 17)
        run: mutable DroneHoops::Run = DroneHoops::trial(course)
        cues: mutable DroneHoopsSound::Sound = DroneHoopsSound::initialize(&course)
        tick: mutable i64 = 0
        while run.result == DroneHoops::PENDING |run, cues, guided, tick|:
            start: f64 = run.time
            port: i64 = DroneHoops::pilot(&run) if guided else 0
            DroneHoops::step(&run, 1.0 / 30.0, 0 if port < 0 else 1 << port.u64())
            DroneHoopsSound::update(&cues, &run, start)
            if tick % 5 == 0:
                window(&cues, start, run.time)
            tick <- tick + 1

def main() -> i32:
    can Memory.Allocate, Abort.Panic, Console.Write:
        emit(1, true)
        emit(24, true)
        emit(35, false)
        return 0.i32()
