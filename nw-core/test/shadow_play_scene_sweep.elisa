include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_shadow_play.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def frame(rung: i64, scene_case: i64):
    can Abort.Panic, Memory.Allocate, Console.Write:
        box: SceneHiddenRule::Rect = SceneShadowPlay::area()
        view: SceneShadowPlay::Lens = SceneShadowPlay::lens(&box)
        _ = printf("%.17g %.17g %.17g\n", view.focal, view.center_x, view.center_y)
        setup: ShadowPlay::Setup = ShadowPlay::deal(rung, 17)
        session: mutable ShadowPlayGame::Session = ShadowPlayGame::initialize(rung, 1, false, 17)
        session.run <- ShadowPlay::initialize(&setup, false)
        session.phase <- ShadowPlayGame::PLAYING if scene_case < 2 else ShadowPlayGame::JUDGED
        session.trial <- 1
        t: f64 = setup.level.seconds if scene_case == 3 else scene_case.f64() * 0.6
        fitted: bool = scene_case == 1 or scene_case == 2
        turn: DrShape::Matrix = ShadowPlay::target_at(&setup, t) if fitted else setup.start
        session.run.t <- t
        session.run.turn <- turn
        if fitted:
            session.run.fit <- 0.0
            session.run.fit_since <- t - 0.4
        if scene_case == 2:
            session.run.result <- ShadowPlay::WON
        elif scene_case == 3:
            session.run.result <- ShadowPlay::TIMED_OUT
        light: RoomsView::Vec = ShadowPlay::wall_light(setup.level.swing, t)
        copper: SceneShadowPlay::PaintedRod = SceneShadowPlay::copper(&setup.rod, turn, &view, light)
        for i in 0..<copper.count |copper|:
            line: SceneShadowPlay::Segment = copper.pieces[i.usize()]
            _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g\n", line.a.x, line.a.y, line.b.x, line.b.y, line.depth, line.lit)
        display: mutable Display::DisplayList = Display::DisplayList()
        SceneShadowPlay::render(&display, &session, true)
        hold: mutable i64 = 0
        green: mutable i64 = 0
        red: mutable i64 = 0
        quads: mutable i64 = 0
        for i in 0..<display.commands.count |display, hold, green, red, quads|:
            cmd: Display::DrawCmd = display.commands[i]
            quads <- quads + 1 if cmd.kind == Display::CMD_POLYGON and cmd.len == 4.u32()
            green <- green + 1 if cmd.kind == Display::CMD_TEXT and cmd.color == SceneVerdict::correct_color()
            red <- red + 1 if cmd.kind == Display::CMD_TEXT and cmd.color == SceneVerdict::incorrect_color()
            hold <- hold + 1 if cmd.kind == Display::CMD_LINE and cmd.color == SceneShadowPlay::HOLD_RING
            if cmd.kind == Display::CMD_LINE and (cmd.color == SceneShadowPlay::GOLD_SOFT or cmd.color == SceneShadowPlay::GOLD_EDGE or
                    cmd.color == SceneShadowPlay::SHADOW or cmd.color == SceneShadowPlay::FITTED_SHADOW):
                _ = printf("%u %.9g %.9g %.9g %.9g %.9g\n", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64())
        _ = printf("%lld %lld %lld %lld\n", quads, hold, green, red)

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Console.Write:
        levels: i64[4] = [1, 10, 16, 27]
        for rung in levels:
            for scene_case in 0..<4 |rung|:
                frame(rung, scene_case)
        return 0.i32()
