# Differential sweep driver for board.elisa. See board_diff.py for the
# reference side: the same grid runs through the original bwaccel/board.py.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../src/board.elisa"

# printr(i64) and int_to_string_scratch both trip a stage1 backend decline of
# store_* generics (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

def sweep_layout(a: mutable Arena&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        for dim in [2, 3] |a|:
            for n in [2, 3, 4, 5, 6, 7] |a, dim|:
                for center in [0, 1] |a, dim, n|:
                    cells: darray[Cell] = grid_layout(a, n, center == 1, dim)
                    printr("lay")
                    emit_cell(dim)
                    emit_cell(n)
                    emit_cell(center)
                    emit_cell(cells.count.i64())
                    for cell in cells:
                        emit_cell(cell.pid)
                        emit_cell(cell.col)
                        emit_cell(cell.row)
                        emit_cell(cell.depth)
                    print("")

def sweep_position(a: mutable Arena&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        for n in [2, 3, 4, 5, 7] |a|:
            for center in [0, 1] |a, n|:
                for position in [-1, 0, 1, 2, 5, 8, 9, 10, 25, 50] |a, n, center|:
                    flat: Cell = position_cell(a, position, n, center == 1)
                    cube: Cell = position_cell_3d(a, position, n, center == 1)
                    printr("pos")
                    emit_cell(n)
                    emit_cell(center)
                    emit_cell(position)
                    emit_cell(flat.pid)
                    emit_cell(flat.col)
                    emit_cell(flat.row)
                    emit_cell(cube.pid)
                    emit_cell(cube.col)
                    emit_cell(cube.row)
                    emit_cell(cube.depth)
                    print("")

def sweep_center_out(a: mutable Arena&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        for dim in [2, 3] |a|:
            for n in [2, 3, 4, 5, 6, 7] |a, dim|:
                for center in [0, 1] |a, dim, n|:
                    ids: darray[i64] = grid_center_out_ids(a, n, center == 1, dim)
                    printr("cout")
                    emit_cell(dim)
                    emit_cell(n)
                    emit_cell(center)
                    for pid in ids:
                        emit_cell(pid)
                    print("")

def sweep_active(a: mutable Arena&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        for dim in [2, 3] |a|:
            for n in [2, 3, 4, 5, 6] |a, dim|:
                for center in [0, 1] |a, dim, n|:
                    for limit in [-5, 0, 1, 2, 3, 6, 8, 20, 500] |a, dim, n, center|:
                        ids: darray[i64] = active_position_ids(a, n, center == 1, limit, dim)
                        printr("act")
                        emit_cell(dim)
                        emit_cell(n)
                        emit_cell(center)
                        emit_cell(limit)
                        for pid in ids:
                            emit_cell(pid)
                        print("")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(64 * 1024 * 1024)
        arena: mutable Arena& = (&work).cast[mutable Arena&]
        sweep_layout(arena)
        sweep_position(arena)
        sweep_center_out(arena)
        sweep_active(arena)
        destroy work
        return 0
