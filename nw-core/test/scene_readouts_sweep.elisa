# Differential sweep driver for src/scene_readouts.elisa.
# See scene_readouts_diff.py for the reference side.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/display.elisa"
include "../src/scene_readouts.elisa"
include "scene_emit.elisa"

const ANALYSIS: cstr = "Correct-Errors:   A:12-3   L:11-4   Score: 79%"
const CHART_TITLE: cstr = "Today's Last 20:"
const AVERAGE: cstr = "DNB average: 2.35"
const TODAY: cstr = "14 min 20 sec done today in 6 sessions\n31 min 5 sec done in last 24 hours in 13 sessions"
const REMAINING: cstr = "17 remaining"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|black|rows|tall")
        region w(64 * 1024 * 1024)
        in w:
            for spec in 0..<24:
                black: bool = spec % 3 == 1
                # None, a few, and a full chart: the blank rows keep their
                # places, so the frame is the same length either way.
                rows: i64 = spec % 21
                tall: i64 = 1368 if spec % 2 == 0 else 960
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(1 if black else 0)
                emit_bar(rows)
                emit_bar(tall)
                print("")
                first: mutable darray[sview] = []
                second: mutable darray[sview] = []
                third: mutable darray[sview] = []
                kinds: mutable darray[i64] = []
                held: mutable darray[dstr] = []
                for row in 0..<rows |first, second, third, kinds, held|:
                    number: mutable dstr = []
                    if row % 5 == 4:
                        number.push(77.u8())
                    else:
                        number.push(35.u8())
                        dstr_append_i64(&number, 100 + row)
                    held.push(number)
                    mode: mutable dstr = []
                    dstr_append_cstr(&mode, "D")
                    dstr_append_i64(&mode, 2 + row % 3)
                    dstr_append_cstr(&mode, "B")
                    held.push(mode)
                    score: mutable dstr = []
                    dstr_append_i64(&score, 40 + row * 3)
                    score.push(37.u8())
                    held.push(score)
                    kinds.push(0 if row % 5 == 4 else (1 if row % 3 == 0 else (2 if row % 3 == 1 else 0)))
                for row in 0..<rows |first, second, third, held|:
                    first.push(bytes_view(get held[(row * 3).usize()] else []))
                    second.push(bytes_view(get held[(row * 3 + 1).usize()] else []))
                    third.push(bytes_view(get held[(row * 3 + 2).usize()] else []))
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneReadouts::ReadoutPaint = SceneReadouts::paint_of(black, width, height, 2.0, 2.0)
                SceneReadouts::put_analysis(&list, &paint, sview(ANALYSIS, 0, -1))
                SceneReadouts::put_chart_title(&list, &paint, sview(CHART_TITLE, 0, -1))
                SceneReadouts::put_chart(&list, &paint, &first, &second, &third, &kinds, rows)
                SceneReadouts::put_average(&list, &paint, sview(AVERAGE, 0, -1))
                SceneReadouts::put_today(&list, &paint, sview(TODAY, 0, -1))
                SceneReadouts::put_trials_remaining(&list, &paint, sview(REMAINING, 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
