include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_tuner.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def state(s: TunerGame::Session&):
    can Console.Write, Abort.Panic:
        _ = printf("%lld %lld %lld %lld %lld %lld %.17g %.17g %.17g %lld\n",
            s.phase, s.rung, s.trial, s.passed, s.best, s.run.result, s.run.t, s.run.dial, s.run.replay_until,
            s.run.gains.count.i64())

def audio(s: mutable TunerGame::Session&, buffer: mutable u8&):
    can Console.Write, Abort.Panic, Memory.Allocate:
        count: i64 = TunerGame::audio_window(s, buffer, 32768)
        _ = printf("%.17g ", s.heard_to)
        for i in 0..<count |buffer|:
            _ = printf("%02x", buffer[i.usize()].i32())
        _ = printf("\n")

def paint(s: TunerGame::Session&, lit: bool, outcome: i64) -> bool:
    can Abort.Panic, Memory.Allocate:
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneTuner::render(&list, s, false)
        lamps: mutable i64 = 0
        needle: mutable i64 = 0
        verdict: mutable i64 = 0
        for i in 0..<list.commands.count |list, lamps, needle, verdict|:
            cmd: Display::DrawCmd = get list.commands[i] else zeroed
            lamps <- lamps + 1 if cmd.color == 0xff8c3c64
            needle <- needle + 1 if cmd.kind == Display::CMD_LINE and cmd.color == 0xc8281eff
            verdict <- 1 if cmd.kind == Display::CMD_TEXT and cmd.color == SceneVerdict::correct_color()
            verdict <- -1 if cmd.kind == Display::CMD_TEXT and cmd.color == SceneVerdict::incorrect_color()
        return needle == 1 and lamps == (s.run.radio.count if lit else 0) and verdict == outcome

def replay() -> bool:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        empty: darray[Tuner::Clip] = []
        s: mutable TunerGame::Session = TunerGame::initialize(1, 3, true, -17)
        now: mutable f64 = 10.0
        return false if not (TunerGame::start(&s, now, &empty) can Global{Read,Write})
        return false if TunerGame::event(&s, Tuner::LOCK) or TunerGame::event(&s, Tuner::REPLAY)
        return false if not paint(&s, false, 0)
        state(&s)
        now <- now + 0.4
        _ = (TunerGame::advance(&s, now, 0, &empty) can Global{Read,Write})
        for i in 0..<12 |s, now, empty|:
            now <- now + 0.05
            _ = (TunerGame::advance(&s, now, 0, &empty) can Global{Read,Write})
        state(&s)
        buffer: mutable u8[32768] = zeroed
        audio(&s, &buffer[0])
        audio(&s, &buffer[0])
        for trial in 0..<3 |s, now, empty|:
            if trial < 2:
                while not Tuner::on(&s.run) |s, now, empty|:
                    now <- now + 0.05
                    _ = (TunerGame::advance(&s, now, 2, &empty) can Global{Read,Write})
                return false if not paint(&s, true, 0)
                box: SceneTuner::Layout = SceneTuner::layout()
                x: f64 = box.knob.x + box.knob.w / 2.0
                y: f64 = box.knob.y + box.knob.h / 2.0
                return false if not SceneTuner::pointer(&s, x + 10.0, y - 4.0, 10.0, -4.0, true, true)
                return false if not TunerGame::event(&s, Tuner::FINE_DOWN)
                now <- now + 0.05
                _ = (TunerGame::advance(&s, now, 2, &empty) can Global{Read,Write})
                state(&s)
                target: i64 = s.run.radio.target if trial == 0 else (s.run.radio.target + 1) % s.run.radio.count
                target_dial: f64 = Tuner::where(&s.run.radio, target, s.run.t)
                return false if not SceneTuner::pointer(&s, box.dial.x + target_dial / Tuner::DIAL * box.dial.w,
                    box.dial.y + 8.0, 0.0, 0.0, false, false)
                return false if not TunerGame::event(&s, Tuner::REPLAY) or not TunerGame::event(&s, Tuner::LOCK)
            while s.phase == TunerGame::PLAYING |s, now, empty|:
                now <- now + 0.05
                _ = (TunerGame::agent_event(&s, now, TunerGame::UPDATE, &empty) can Global{Read,Write})
            state(&s)
            return false if not paint(&s, true, 1 if trial == 0 else -1)
            return false if (TunerGame::advance(&s, s.deadline - 0.001, 0, &empty) can Global{Read,Write})
            now <- s.deadline if trial == 0 else now + 0.05
            if trial == 0:
                return false if not (TunerGame::advance(&s, now, 0, &empty) can Global{Read,Write})
            else:
                return false if not (TunerGame::agent_event(&s, now, TunerGame::UPDATE, &empty) can Global{Read,Write})
            state(&s)
        return false if s.phase != TunerGame::DONE or s.passed != 1
        return false if not (TunerGame::start(&s, now + 1.0, &empty) can Global{Read,Write})
        state(&s)
        (TunerGame::close(&s) can Global{Read,Write})
        return s.phase == TunerGame::READY and s.run.gains.count == 0.usize()

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        return 0.i32() if (replay() can Global{Read,Write}) else 1.i32()
