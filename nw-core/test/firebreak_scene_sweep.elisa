include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_firebreak.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        session: mutable FirebreakGame::Session = FirebreakGame::initialize(rung, 1, false, 17)
        if mode != 0:
            _ = FirebreakGame::input(&session, FirebreakGame::START, 0)
        if mode >= 2:
            _ = FirebreakGame::input(&session, FirebreakGame::FIRST_CELL + 285, 0)
        if mode == 2:
            for tick in 1..<4 |session|:
                _ = FirebreakGame::advance(&session, tick * 100, 0.1)
        if mode >= 3:
            now: mutable i64 = 0
            while session.phase == FirebreakGame::PLAYING |session, now|:
                next: i64 = now + 100
                _ = FirebreakGame::advance(&session, next, next.f64() / 1000.0 - now.f64() / 1000.0)
                now <- next
        if mode == 4:
            _ = FirebreakGame::advance(&session, session.deadline_ms, 0.0)
        _ = printf("frame %lld %lld %lld\n", rung, mode, 1 if dark else 0)
        area: SceneFirebreak::Board = SceneFirebreak::board()
        for cell in [0, 29, 285, 569] |area, session|:
            x: f64 = area.x + ((cell % Firebreak::COLS).f64() + 0.5) * area.size
            y: f64 = area.y + ((cell / Firebreak::COLS).f64() + 0.5) * area.size
            _ = printf("hit %lld %.9g %.9g\n", SceneFirebreak::hit(&session, x, y), x, y)
        _ = printf("hit %lld 0 0\n", SceneFirebreak::hit(&session, 0.0, 0.0))
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneFirebreak::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneFirebreak::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 16]:
            for mode in 0..<5 |rung|:
                for dark in 0..<2 |rung, mode|:
                    region scratch(2097152):
                        in scratch:
                            emit(rung, mode, dark != 0)
        return 0.i32()
