include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/pianotuner.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# Piano Tuner against pianotuner.py, for pianotuner_diff.py: the grade
# table, dealt jobs, and tries played step by step -- the reference
# autopilot, nobody, done said too soon, and the pin turned by hand one way
# and the other before the autopilot takes over, and the pin turned up
# five seconds before done is said -- with the notes and both
# sound tracks' settings and phases.

def player(run: PianoTuner::Run&, mode: i64, n: i64) -> i64:
    can Abort.Panic:
        auto: i64 = PianoTuner::pilot(run)
        return auto if mode == 0
        return -1 if mode == 1
        if mode == 2:
            return PianoTuner::DONE if n == 300 else (auto if auto != PianoTuner::DONE else -1)
        return ((n / 40) % 4 if n < 640 else auto) if mode == 3
        return PianoTuner::UP if n < 150 else (PianoTuner::DONE if n == 150 else -1)

def replay(rung: i64, seed: i64, mode: i64, dt: f64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(67108864):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                job: PianoTuner::Job = PianoTuner::deal(rung, &draw)
                _ = printf("job %lld %lld %lld %u %.17g\n", mode, rung, seed, py_getrandbits(&draw, 32).u32(), job.ref)
                for s in 0..<job.level.strings |job|:
                    p: PianoTuner::Plan = job.plan[s.usize()]
                    _ = printf("plan %lld %.17g %.17g\n", p.interval, p.off, p.pin)
                return if mode < 0
                run: mutable PianoTuner::Run = PianoTuner::begin(job)
                _ = printf("begin %.17g %.17g\n", run.pitch, run.end)
                n: mutable i64 = 0
                while run.result == PianoTuner::LIVE |run, mode, n, dt|:
                    port: i64 = player(&run, mode, n)
                    if port == PianoTuner::DONE:
                        PianoTuner::act(&run, port)
                    PianoTuner::step(&run, dt, port if port != PianoTuner::DONE else -1)
                    _ = printf("%lld %lld %.17g %.17g %lld %lld %.17g %.17g %lld\n", port, run.result, run.t, run.pitch,
                        run.k, run.count, PianoTuner::cents_off(&run), PianoTuner::pin(&run), run.times.count.i64())
                    n <- n + 1
                _ = printf("end %lld %.17g\n", run.result, run.said)
                for note in run.notes:
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g\n", note.seed, note.voice, note.t, note.freq, note.dur, note.gain)
                for i in 0..<run.times.count.i64() |run|:
                    k: usize = i.usize()
                    _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g\n", run.times[k], run.ref_f[k], run.string_f[k], run.gain[k],
                        run.ref_ph[k], run.string_ph[k])

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in 0..<41:
            level: PianoTuner::Grade = PianoTuner::grade(rung)
            _ = printf("grade %lld %lld %lld %.17g %.17g %.17g", level.rung, level.count, level.strings, level.tol, level.stiff,
                level.seconds)
            for i in 0..<level.count |level|:
                _ = printf(" %lld", level.intervals[i.usize()])
            _ = printf("\n")
        for rung in 1..<41:
            for seed in 1..<11 |rung|:
                replay(rung, seed, -1, 0.0)
        for rung in [1.i64(), 2.i64(), 4.i64(), 5.i64(), 7.i64(), 8.i64(), 10.i64(), 13.i64(), 16.i64(), 20.i64(), 30.i64()]:
            for mode in 0..<4 |rung|:
                replay(rung, 17 + mode, mode, 1.0 / 120.0)
        replay(1, 5, 1, 1.0 / 30.0)
        replay(25, 9, 0, 1.0 / 30.0)
        replay(1, 3, 4, 1.0 / 30.0)
        return 0
