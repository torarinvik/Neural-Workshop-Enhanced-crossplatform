# Differential sweep driver for src/scene_youarehere.elisa.
# See scene_youarehere_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pymath.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/pyset.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_youarehere.elisa"
include "scene_emit.elisa"

# Rays a view is cast with. The real screen uses 180 and the sweep uses the
# same number, because a strip is a command and the count is the frame size.
const COLUMNS: i64 = 180

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|phase|black|wide|tall_cells|doors|held|show_marks|motes|steps|par|trial|total_trials|tall|verdict")
        region w(512 * 1024 * 1024)
        in w:
            for spec in 0..<24:
                phase: i64 = spec % 4
                black: bool = spec % 7 == 1
                wide: i64 = 7 + (spec / 4) % 3 * 4
                tall_cells: i64 = 7 + (spec / 4) % 2 * 6
                doors: i64 = (spec / 4) % 4
                held: i64 = spec % 8
                show_marks: bool = (spec / 4) % 2 == 0
                motes: i64 = (spec / 4) % 4
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(wide)
                emit_bar(tall_cells)
                emit_bar(doors)
                emit_bar(held)
                emit_bar(1 if show_marks else 0)
                emit_bar(motes)
                emit_bar(spec % 29)
                emit_bar(11)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")

                cells: i64 = wide * tall_cells
                walls: mutable darray[i64] = []
                for cell in 0..<cells |walls, wide, tall_cells|:
                    x: i64 = cell % wide
                    y: i64 = cell / wide
                    if x == 0 or y == 0 or x == wide - 1 or y == tall_cells - 1 or (x % 2 == 0 and y % 2 == 0):
                        walls.push(cell)
                door_cells: mutable darray[i64] = []
                key_cells: mutable darray[i64] = []
                for one in 0..<doors |door_cells, key_cells, wide, cells|:
                    door_cells.push((wide + 1 + one * 5) % cells)
                    key_cells.push((wide + 3 + one * 7) % cells)

                # A view with walls at every distance, some of them the door
                # cells so a doorway keeps its colour, some beyond FAR so the
                # strip is not drawn at all, and both sides so the edge-on
                # dimming is exercised.
                sights: mutable darray[SceneYouAreHere::Sight] = []
                for column in 0..<COLUMNS |sights, door_cells, doors, cells|:
                    beyond: bool = column % 37 == 0
                    cell: i64 = (get door_cells[(column % (doors if doors > 0 else 1)).usize()] else -1) if doors > 0 and column % 5 == 0 else (column * 7) % cells
                    sights.push(SceneYouAreHere::Sight{
                        distance: SceneYouAreHere::FAR if beyond else 0.2 + 0.09 * (column % 61).f64(),
                        cell: cell,
                        side: column % 2})
                marks: mutable darray[SceneYouAreHere::Mote] = []
                for one in 0..<motes |marks|:
                    marks.push(SceneYouAreHere::Mote{
                        what: one % 2,
                        which: one,
                        across: 0.07 + 0.23 * one.f64(),
                        # Nearer than the wall behind it for some and further
                        # for others, because a mark behind a wall is hidden.
                        distance: 0.3 + 2.5 * one.f64()})

                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneYouAreHere::Paint = SceneYouAreHere::paint_of(black, width, height, 2.0, 2.0)
                SceneYouAreHere::render(&list, &paint, phase, true, wide,
                                        tall_cells, &walls, &door_cells,
                                        &key_cells, wide + 1,
                                        cells - wide - 2, held, &sights,
                                        &marks, show_marks, spec % 29, 11,
                                        1 + spec % 5, 5,
                                        sview("Rung 3 - two doors", 0, -1),
                                        verdict,
                                        sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
