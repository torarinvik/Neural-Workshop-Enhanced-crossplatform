# Differential sweep for the host-facing session assembly.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "../src/pyrandom.elisa"
include "../src/board.elisa"
include "../src/grid.elisa"
include "../src/strings.elisa"
include "../src/gamemode.elisa"
include "../src/session.elisa"
include "../src/session_app.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            index: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                index <- 22
                buf[22] <- 48.u8()
            else:
                negative: bool = n < 0
                while n != 0 |buf, index, n|:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    index <- index - 1
                    buf[index.usize()] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    index <- index - 1
                    buf[index.usize()] <- 45.u8()
            printr((&buf[index.usize()]).cast[cstr])

def emit(value: i64):
    can Console.Write, Abort.Panic:
        printr("|")
        print_i64(value)

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|case|seed|trial|mode|back|status|position|color|visual|audio|audio2|number|operation|real_back|variable_back|next_random")
        region work(256 * 1024 * 1024)
        in work:
            tables: ModeTables = ModeTables()
            case: mutable i64 = 0
            # This port covers only 3D Position N-Back. Keep every differential
            # case on source mode 10; other variants remain in the original app.
            for cubes in [1, 2, 3, 6] |tables, case|:
                for back in [1, 2, 5] |tables, case, cubes|:
                    for seed in [1, 7, 17, 12345] |tables, case, cubes, back|:
                        for trial in [1, 4, 10] |tables, case, cubes, back, seed|:
                            one: SessionApp::Preview = SessionApp::preview_3d(
                                &tables, seed, trial, 10, back, cubes)
                            printr("case")
                            emit(case)
                            emit(seed)
                            emit(trial)
                            emit(1000 + cubes)
                            emit(back)
                            emit(generate_status_code(one.status))
                            emit(one.position)
                            emit(one.color)
                            emit(one.visual)
                            emit(one.audio)
                            emit(one.audio2)
                            emit(one.number)
                            emit(one.operation)
                            emit(one.real_back)
                            emit(one.variable_back)
                            emit(one.next_random)
                            print("")
                            case <- case + 1
        destroy work
        return 0
