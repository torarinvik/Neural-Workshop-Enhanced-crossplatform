# Differential sweep driver for tasks/algebra.elisa. See algebra_diff.py for
# the reference side.
#
# Twelve rungs, eight deals each, and every deal is put through everything that
# is measured about it: the question as printed, the answer as shown, the size
# of the box, the forward check that reads the question back, whether zero
# would have got it, and what the checker-only solver spends. Then twenty-five
# things a player might type are marked against it.
#
# The typed answers are read from a file the harness writes, so both sides read
# the same strings.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_fileio.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/bigfrac.elisa"
include "../src/tasks/expressions.elisa"
include "../src/tasks/algebra.elisa"

const TYPED_PATH: cstr = "/tmp/nw_algebra_typed.txt"
const MOST_TYPED: i64 = 64
const MOST_LINE: i64 = 512

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

def print_bytes(text: mutable darray[u8]&, first: i64, count: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[544] = zeroed
            for index in 0..<count |buf, text, first|:
                buf[index.usize()] <- Bytes::at_ref(text, first + index)
            buf[count.usize()] <- 0.u8()
            printr((&buf[0]).cast[cstr])

def emit_text(text: mutable darray[u8]&, count: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_bytes(text, 0, count)

def emit_big(value: Big::Int&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        text: mutable darray[u8] = Bytes::zeros(352)
        emit_text(&text, Big::to_text(value, &text))

def emit_frac(value: Q::Frac&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        text: mutable darray[u8] = Bytes::zeros(352)
        emit_text(&text, Q::to_text(value, &text))

struct Typed:
    count: mutable i64
    start: mutable darray[i64]
    span: mutable darray[i64]
    body: mutable darray[u8]

def load_typed(out: mutable Typed&, body: darray[u8]&) -> bool:
    can Abort.Panic:
        out.count <- 0
        length: i64 = body.count.i64()
        false return if length > MOST_TYPED * MOST_LINE
        for index in 0..<length |out, body|:
            Bytes::put(&out.body, index, get body[index.usize()] else 0.u8())
        first: mutable i64 = 0
        for index in 0..<length |out, first|:
            continue if Bytes::at_ref(&out.body, index).i64() != 10
            false return if out.count >= MOST_TYPED
            Ints::put(&out.start, out.count, first)
            Ints::put(&out.span, out.count, index - first)
            out.count <- out.count + 1
            first <- index + 1
        return true

def take_typed(typed: mutable Typed&, spec: i64, out: mutable darray[u8]&) -> i64:
    can Abort.Panic:
        first: i64 = Ints::at_ref(&typed.start, spec)
        span: i64 = Ints::at_ref(&typed.span, spec)
        for index in 0..<span |out, typed, first|:
            Bytes::put(out, index, Bytes::at_ref(&typed.body, first + index))
        return span

# The sweep is written as four functions rather than one `main` because the
# polynomials are large structs and a single frame holding all of them at once
# takes the optimiser two minutes to look at. Split, it takes four seconds.

def emit_grades():
    can Console.Write, Abort.Panic:
        for rung in 0..<15:
            g: Algebra::Grade = Algebra::grade_of(rung)
            printr("grade")
            emit_cell(rung)
            emit_cell(g.family)
            emit_cell(g.kind)
            emit_cell(g.digits)
            emit_cell(g.high)
            emit_cell(g.degree)
            emit_cell(g.letters)
            emit_cell(g.band)
            emit_cell(g.modulus)
            emit_cell(g.moduli)
            emit_cell(Algebra::fraction_rows(&g))
            emit_cell(Algebra::fraction_span(&g))
            print("")

def emit_primes():
    can Console.Write, Abort.Panic:
        for number_at in 1..<200:
            printr("prime")
            emit_cell(number_at)
            emit_cell(1 if Algebra::is_prime(number_at) else 0)
            print("")

def emit_one_deal(problem: mutable Algebra::Problem&, reader: mutable Expressions::Reader&,
                  left: mutable Expressions::Poly&, right: mutable Expressions::Poly&,
                  typed: mutable Typed&, line: mutable darray[u8]&,
                  level: i64, seed: i64, loaded: bool):
    can Console.Write, Memory.Allocate, Abort.Panic:
        made: bool = Algebra::generate(problem, level, level * 1000 + seed, reader, left, right)
        printr("deal")
        emit_cell(level)
        emit_cell(seed)
        emit_cell(1 if made else 0)
        if not made:
            print("")
            return
        emit_text(&problem.asked, problem.asked_n)
        if problem.answer_kind == Algebra::EXPRESSION:
            shown: mutable darray[u8] = Bytes::zeros(544)
            emit_text(&shown, Expressions::render(&problem.answer_poly, &shown))
        else:
            emit_frac(&problem.answer)
        emit_big(&problem.space)
        emit_cell(problem.steps)
        emit_cell(problem.wants)
        emit_cell(1 if problem.answer_kind == Algebra::EXPRESSION else 0)
        emit_cell(1 if Algebra::checks_out(problem, reader, left, right) else 0)
        emit_cell(1 if Algebra::guessable(problem) else 0)
        emit_cell(Algebra::walk_of(&problem.grade))
        emit_cell(Algebra::crack(problem, Algebra::BUDGET))
        emit_cell(problem.answer_poly.count if problem.answer_kind == Algebra::EXPRESSION else -1)
        for spec in 0..<typed.count |problem, reader, left, typed, line, loaded|:
            span: i64 = take_typed(typed, spec, line)
            emit_cell(1 if loaded and Algebra::correct(problem, line, span, reader, left) else 0)
        print("")

def emit_deals(problem: mutable Algebra::Problem&, reader: mutable Expressions::Reader&,
               left: mutable Expressions::Poly&, right: mutable Expressions::Poly&,
               typed: mutable Typed&, line: mutable darray[u8]&, loaded: bool):
    can Console.Write, Memory.Allocate, Abort.Panic:
        for level in 1..<13 |problem, reader, left, right, typed, line, loaded|:
            for seed in 1..<9 |problem, reader, left, right, typed, line, loaded, level|:
                emit_one_deal(problem, reader, left, right, typed, line, level, seed, loaded)

def emit_crt(problem: mutable Algebra::Problem&, reader: mutable Expressions::Reader&,
             left: mutable Expressions::Poly&, right: mutable Expressions::Poly&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        for which in 0..<2 |problem, reader, left, right|:
            level: i64 = 10 if which == 0 else 12
            for seed in 1..<5 |problem, reader, left, right, level|:
                made: bool = Algebra::generate(problem, level, level * 77 + seed, reader, left, right)
                printr("crt")
                emit_cell(level)
                emit_cell(seed)
                emit_cell(1 if made else 0)
                if not made:
                    print("")
                    continue
                emit_big(&problem.space)
                emit_frac(&problem.answer)
                for index in 0..<problem.moduli_n |problem|:
                    emit_cell(Ints::at_ref(&problem.moduli, index))
                print("")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(192 * 1024 * 1024)
        in w:
            arena: mutable Arena& = (&w).cast[mutable Arena&]
            missing: darray[u8] = Bytes::zeros(0)
            body: darray[u8] = try read_entire_file(arena, TYPED_PATH) else missing
            typed: mutable Typed = Typed{count: 0, start: Ints::zeros(MOST_TYPED),
                                         span: Ints::zeros(MOST_TYPED),
                                         body: Bytes::zeros(MOST_TYPED * MOST_LINE)}
            loaded: bool = load_typed(&typed, &body)
            emit_grades()
            emit_primes()
            problem: mutable Algebra::Problem = Algebra::new_problem()
            reader: mutable Expressions::Reader = Expressions::new_reader()
            left: mutable Expressions::Poly = Expressions::zero()
            right: mutable Expressions::Poly = Expressions::zero()
            line: mutable darray[u8] = Bytes::zeros(MOST_LINE)
            emit_deals(&problem, &reader, &left, &right, &typed, &line, loaded)
            emit_crt(&problem, &reader, &left, &right)
        destroy w
        return 0
