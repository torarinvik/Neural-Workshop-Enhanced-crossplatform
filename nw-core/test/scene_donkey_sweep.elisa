# Differential sweep driver for src/scene_donkey.elisa.
# See scene_donkey_diff.py for the reference side.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_donkey.elisa"
include "scene_emit.elisa"

const ASKED: cstr = "Rung 3, two-row swerve. 40 rows of road, 6 donkeys in it. The swerve takes 2 rows and cannot be called off, so press 2 rows before the donkey -- on sight is already too late."

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|phase|black|has_road|donkeys|car_at|car_lane|car_crossing|car_span|car_passed|trial|total_trials|tall|verdict")
        region w(256 * 1024 * 1024)
        in w:
            for spec in 0..<40:
                phase: i64 = spec % 5
                black: bool = spec % 7 == 1
                has_road: bool = spec % 13 != 12
                donkeys: i64 = 1 + (spec / 5) % 6
                # The car walks the road in sub-rows, so a donkey passes
                # through the whole window rather than jumping it.
                car_at: i64 = spec * 3
                car_lane: i64 = (spec / 5) % 2
                # A crossing under way draws the car between lanes; zero
                # draws it in one.
                car_span: i64 = 4 + (spec / 5) % 3 * 4
                car_crossing: i64 = 0 if spec % 3 == 0 else 1 + spec % car_span
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 3 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if has_road else 0)
                emit_bar(donkeys)
                emit_bar(car_at)
                emit_bar(car_lane)
                emit_bar(car_crossing)
                emit_bar(car_span)
                emit_bar(spec % 7)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                # Donkeys every eleven sub-rows, alternating lanes: close
                # enough together that several are in the window at once and
                # the car walks through them.
                beasts: mutable darray[SceneDonkey::DonkeyBeast] = []
                for index in 0..<donkeys |beasts|:
                    beasts.push(SceneDonkey::DonkeyBeast{at: 8 + index * 11,
                                                   lane: index % 2})
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneDonkey::DonkeyPaint = SceneDonkey::paint_of(black, width, height, 2.0, 2.0)
                SceneDonkey::render(&list, &paint, phase, has_road, &beasts,
                                    8 + donkeys * 11 + 6, 40, donkeys,
                                    car_at, car_lane, car_crossing, car_span,
                                    spec % 7, sview(ASKED, 0, -1),
                                    1 + spec % 5, 5,
                                    sview("Swerve in time", 0, -1), verdict,
                                    sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
