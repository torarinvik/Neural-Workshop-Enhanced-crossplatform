# Optional real-index check. The Python driver supplies this temporary path.
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_fileio.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/strings.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/crossword.elisa"
include "../src/tasks/crossword_lexicon.elisa"

def print_number(value: i64):
    can Console.Write, Global.Read, Global.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            at: mutable i64 = 23
            left: mutable i64 = 0 - value if value < 0 else value
            if left == 0:
                at <- 22
                buf[22] <- 48
            else:
                while left > 0 |buf, at, left|:
                    at <- at - 1
                    buf[at] <- (48 + left % 10).u8()
                    left <- left / 10
            if value < 0:
                at <- at - 1
                buf[at] <- 45
            printr((&buf[at]).cast[cstr])

def emit_number(value: i64):
    can Console.Write, Global.Read, Global.Write, Abort.Panic:
        printr(",")
        print_number(value)

def main() -> i64:
    can Console.Write, Global.Read, Global.Write, Memory.Allocate, Memory.Release, Blocking.IO, Abort.Panic:
        region work(256 * 1024 * 1024)
        in work:
            arena: mutable Arena& = (&work).cast[mutable Arena&]
            body: cstr = try read_entire_file_cstr(arena, "/tmp/nw_crossword_real_index.tsv") else "".cast[cstr]
            text: sview = sview(body, 0, string_len(body))
            return 1 if sview_len(text) == 0.usize()
            for band in 0..<4 |text|:
                rank_limit: i64 = 3000 if band == 0 else (10000 if band == 1 else (30000 if band == 2 else 1073741824))
                stats: CrosswordLexicon::CrosswordIndexStats = CrosswordLexicon::inspect(text, rank_limit, 9)
                return 2 if not stats.valid or not stats.clued
                print_number(rank_limit)
                printr(",")
                print_number(stats.words)
                printr(",")
                print_number(stats.letters)
                print("")
                if band == 3:
                    lex: mutable Crossword::Lexicon = Crossword::new_lexicon_sized(stats.words, stats.letters)
                    CrosswordLexicon::load(text, rank_limit, 9, &lex)
                    return 3 if lex.count != stats.words
                    last: i64 = lex.count - 1
                    start: i64 = Ints::at_ref(&lex.start, last)
                    length: i64 = Ints::at_ref(&lex.length, last)
                    sample_word: mutable darray[i64] = Ints::zeros(length)
                    for digit in 0..<length |sample_word, lex, start|:
                        Ints::put(&sample_word, digit, Ints::at_ref(&lex.letter, start + digit))
                    return 4 if Crossword::word_of(&lex, &sample_word, 0, length) != last
                    return 5 if Ints::at_ref(&lex.clue, last) < 0
            for rung in 1..<3 |text|:
                grade: Crossword::CrosswordGrade = Crossword::grade_of(rung)
                stats: CrosswordLexicon::CrosswordIndexStats = CrosswordLexicon::inspect(text, grade.top_rank, grade.size)
                lex: mutable Crossword::Lexicon = Crossword::new_lexicon_sized(stats.words, stats.letters)
                CrosswordLexicon::load(text, grade.top_rank, grade.size, &lex)
                puzzle: mutable Crossword::CrosswordPuzzle = Crossword::new_puzzle()
                filler: mutable Crossword::Filler = Crossword::new_filler()
                shaper: mutable Crossword::Shaper = Crossword::new_shaper()
                numbers: mutable darray[i64] = Ints::zeros(Crossword::MOST_CELLS)
                word: mutable darray[i64] = Ints::zeros(Crossword::MAX_ENTRY)
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, 17.u64())
                Crossword::deal_one(&puzzle, &grade, &filler, &lex, &shaper, &numbers, &word, &rng)
                printr("deal")
                emit_number(rung)
                emit_number(1 if puzzle.dealt else 0)
                emit_number(puzzle.size)
                emit_number(puzzle.tried)
                if puzzle.dealt:
                    emit_number(Crossword::blanks(&puzzle))
                    emit_number(Crossword::unclued(&puzzle))
                    for cell in 0..<(puzzle.size * puzzle.size) |puzzle|:
                        emit_number(Ints::at_ref(&puzzle.blocks, cell))
                        emit_number(Ints::at_ref(&puzzle.solution, cell))
                        emit_number(Ints::at_ref(&puzzle.givens, cell))
                    emit_number(puzzle.slots)
                    for slot in 0..<puzzle.slots |puzzle|:
                        emit_number(Ints::at_ref(&puzzle.slot_number, slot))
                        emit_number(Ints::at_ref(&puzzle.slot_down, slot))
                        emit_number(Ints::at_ref(&puzzle.slot_n, slot))
                        emit_number(Ints::at_ref(&puzzle.slot_clue, slot))
                        first: i64 = Ints::at_ref(&puzzle.slot_at, slot)
                        length: i64 = Ints::at_ref(&puzzle.slot_n, slot)
                        for step in 0..<length |puzzle, first|:
                            emit_number(Ints::at_ref(&puzzle.slot_cell, first + step))
                print("")
        destroy work
        return 0
