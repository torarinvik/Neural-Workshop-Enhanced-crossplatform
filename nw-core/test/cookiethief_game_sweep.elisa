include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_cookiethief.elisa"
include "../src/tasks/cookiethief.elisa"
include "../src/tasks/cookiethief_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def sample(run: CookieThiefGame::Run&, tick: i64):
    can Console.Write, Abort.Panic:
        _ = printf("%lld,%lld,%lld,%lld,%lld,%lld,%lld,%lld,%lld,%lld,%lld,%lld,%lld,%lld,%lld,%lld,%lld,%lld\n",
            tick, run.phase, run.rung, run.trial, run.thief.beat, run.thief.jar, run.thief.eaten,
            run.thief.caught, run.thief.pace, run.thief.phase, run.thief.reaching, run.verdict,
            run.clean, run.cookies, run.points, run.best_rung, run.floor_percent, CookieThiefGame::visible_verdict(run))

def scenario(level: i64, strategy: i64, coach: bool):
    can Console.Write, Memory.Allocate, Abort.Panic:
        region session(4194304):
            in session:
                run: mutable CookieThiefGame::Run = zeroed
                CookieThiefGame::initialize(&run, level, 5, 125, 250, true, 42, coach)
                _ = CookieThiefGame::start_or_next(&run, 0)
                for tick in 0..<600 |tick, strategy, run|:
                    now: i64 = tick * 125
                    if run.phase == CookieThiefGame::PHASE_RUNNING:
                        if strategy == 0:
                            grade: CookieThief::Grade = CookieThief::grade_at(run.trial_rung)
                            port: i64 = CookieThief::GRAB if run.thief.eaten < grade.quota else CookieThief::LEAVE
                            _ = CookieThiefGame::press(&run, port)
                        elif strategy == 1:
                            _ = CookieThiefGame::press(&run, CookieThief::GRAB)
                        elif strategy == 2 and tick % 3 != 0:
                            port: i64 = CookieThief::LUNGE if tick % 3 == 1 else CookieThief::GRAB
                            _ = CookieThiefGame::press(&run, port)
                    _ = CookieThiefGame::advance(&run, now)
                    if run.phase == CookieThiefGame::PHASE_SCORED:
                        _ = CookieThiefGame::start_or_next(&run, now)
                    sample(&run, tick)
                    break if run.phase == CookieThiefGame::PHASE_DONE
                list: mutable Display::DisplayList = Display::DisplayList()
                CookieThiefGame::render(&run, false, 912.0, 684.0, &list)
                _ = printf("render,%lld\n", Display::encode_binary(&list).count.i64())
            destroy session

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        scenario(1, 0, false)
        scenario(6, 1, false)
        scenario(10, 2, false)
        scenario(4, 3, false)
        scenario(1, 0, true)
        scenario(6, 1, true)
        scenario(10, 2, true)
        scenario(4, 3, true)
        return 0
