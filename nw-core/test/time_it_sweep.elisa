include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_time_it.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, seed: i64):
    can Abort.Panic, Console.Write, Memory.Allocate:
        shot: TimeIt::Shot = TimeIt::deal(rung, seed)
        _ = printf("%lld %lld %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g\n",
            rung, seed, shot.kind, shot.level.window, shot.x0, shot.velocity, shot.decel, shot.wall,
            shot.vy, shot.left, shot.right, shot.mark, shot.when)
        for i in 0..<7 |shot|:
            t: f64 = shot.when * i.f64() / 5.0
            p: TimeIt::Point = TimeIt::position(&shot, t)
            _ = printf("%.17g %.17g %.17g\n", t, p.x, p.y)
        for i in 0..<4 |shot|:
            run: mutable TimeIt::Trial = TimeIt::trial(shot)
            offset: f64 = -0.2 if i == 0 else (0.0017 if i == 1 else (0.2 if i == 2 else 0.9))
            TimeIt::step(&run, shot.when + offset)
            if i < 3:
                _ = TimeIt::press(&run)
            msg: mutable dstr = []
            TimeIt::result_text(&run, &msg)
            for b in 0..<msg.count.i64() |msg|:
                _ = printf("%c", msg[b.usize()].i32())
            _ = printf("\n")

def audio(rung: i64, seed: i64, begin: f64, end: f64):
    can Abort.Panic, Console.Write, Memory.Allocate:
        shot: TimeIt::Shot = TimeIt::deal(rung, seed)
        pcm: mutable u8[16384] = zeroed
        length: i64 = TimeItAudio::render(&shot, begin, end, &pcm[0.usize()], 16384)
        _ = printf("%lld %lld %.17g %.17g ", rung, seed, begin, end)
        for i in 0..<length |pcm|:
            _ = printf("%02x", pcm[i.usize()].i32())
        _ = printf("\n")

def main() -> i32:
    can Abort.Panic, Console.Write, Memory.Allocate:
        for rung in -1..<40:
            for seed in -9..<10 |rung|:
                emit(rung, seed)
        emit(25, -9223372036854775807 - 1)
        emit(25, 9223372036854775807)
        audio(1, 17, 0.0, 0.08)
        audio(7, 17, 0.12, 0.19)
        audio(10, 17, 0.59, 0.691)
        audio(13, 17, 1.43, 1.51)
        audio(20, 17, 2.49, 2.56)
        audio(20, 17, 2.99, 3.06)
        fixed: mutable TimeIt::Shot = TimeIt::deal(1, 17)
        rounded: mutable TimeIt::Trial = TimeIt::trial(fixed)
        rounded.pressed <- fixed.when + 0.0625
        rounded.result <- TimeIt::ON_MARK
        msg: mutable dstr = []
        TimeIt::result_text(&rounded, &msg)
        return 1.i32() if bytes_view(msg) != "On the mark -- +62 ms"
        session: mutable TimeItGame::Session = TimeItGame::initialize(10, 2, true, 17)
        return 2.i32() if not TimeItGame::agent_event(&session, 0.0, TimeItGame::START)
        return 3.i32() if not TimeItGame::agent_event(&session, 0.2, -1) or TimeItGame::info(&session, 5) != 100
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneTimeIt::render(&list, &session, false)
        return 4.i32() if Display::encode_binary(&list).count < 1000.usize()
        out: mutable u8[10000] = zeroed
        return 5.i32() if TimeItGame::audio_window(&session, &out[0.usize()], 10000) != 8820
        session.run.time <- session.run.shot.when
        return 6.i32() if not TimeItGame::agent_event(&session, 0.21, TimeIt::PRESS)
        return 7.i32() if not TimeItGame::agent_event(&session, 0.22, -1) or session.phase != TimeItGame::JUDGED
        return 8.i32() if session.run.result != TimeIt::ON_MARK or session.rung != 11 or session.best_rung != 10
        return 9.i32() if not TimeItGame::agent_event(&session, 0.23, -1) or session.trial != 2
        return 0.i32()
