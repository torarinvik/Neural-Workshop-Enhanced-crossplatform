include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/unicycle_game.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def terrain(track: Unicycle::Track&):
    can Abort.Panic, Console.Write:
        g: Unicycle::Grade = track.level
        _ = dprintf(1.i32(), "track %lld %.17g %.17g %.17g %.17g %lld %.17g %lld %.17g %.17g %.17g\n",
            g.rung, g.length, g.hills, g.bumps, g.steps, g.pits, g.slack,
            track.count, track.finish, track.seconds, track.best)
        for i in 0..<track.count |track|:
            x: f64 = Unicycle::x_at(i)
            _ = dprintf(1.i32(), "height %.17g %.17g %.17g\n", x, track.heights[i.usize()], Unicycle::ground(track, x + 0.125))

def state(run: Unicycle::Run&):
    can Abort.Panic, Console.Write:
        b: Unicycle::Body& = &run.body
        head: Unicycle::Point = Unicycle::head(b)
        _ = dprintf(1.i32(), "tick %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %lld\n",
            run.last, run.t, b.px, b.py, b.vx, b.vy, b.a, b.w, b.qx, b.qy, b.ux, b.uy,
            head.x, head.y, Unicycle::tilt(b), run.result)

def replay(track: Unicycle::Track, mode: i64):
    can Abort.Panic, Console.Write:
        run: mutable Unicycle::Run = Unicycle::start(track)
        i: mutable i64 = 0
        while run.result == Unicycle::LIVE and (mode != 0 or i < 720) |run, mode, i|:
            port: i64 = i / 5 % 9 - 1 if mode == 0 else UnicycleReference::steer(&run.track, &run.body)
            dt: f64 = 1.0 / 120.0 if mode == 0 else UnicycleReference::STEP
            Unicycle::step(&run, dt, port)
            state(&run)
            i <- i + 1
        _ = dprintf(1.i32(), "end %lld\n", i)

def candidate(rung: i64, seed: i64):
    can Abort.Panic, Console.Write:
        _ = dprintf(1.i32(), "candidate %lld %lld\n", rung, seed)
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, seed.u64())
        for i in 0..<3 |rung, rng|:
            track: Unicycle::Track = Unicycle::build(Unicycle::grade(rung), &rng)
            terrain(&track)
            replay(track, 0) if i == 0

def screened(rung: i64, seed: i64):
    can Abort.Panic, Console.Write:
        _ = dprintf(1.i32(), "deal %lld %lld\n", rung, seed)
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, seed.u64())
        deal: UnicycleReference::Deal = UnicycleReference::deal(rung, &rng)
        if not deal.valid:
            _ = dprintf(1.i32(), "no deal\n")
            return
        terrain(&deal.track)
        _ = dprintf(1.i32(), "draw %.17g\n", py_random(&rng))
        replay(deal.track, 1)

def edge(mode: i64):
    can Abort.Panic, Console.Write:
        _ = dprintf(1.i32(), "edge %lld\n", mode)
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, 17.u64())
        run: mutable Unicycle::Run = Unicycle::start(Unicycle::build(Unicycle::grade(1), &rng))
        if mode == 2:
            run.body.qy <- 0.1
        elif mode == 3:
            run.body.py <- -0.4
            run.body.qy <- 0.08
        else:
            run.t <- run.track.seconds + 0.1
        Unicycle::step(&run, 0.0, Unicycle::NEUTRAL)
        state(&run)

def session_trace() -> i32:
    can Abort.Panic:
        session: mutable UnicycleGame::Session = UnicycleGame::initialize(1, 3, true, 17)
        return 1.i32() if not UnicycleGame::agent_event(&session, 0.0, UnicycleGame::START)
        _ = UnicycleGame::key(&session, 0, true)
        _ = UnicycleGame::key(&session, 4, true)
        _ = UnicycleGame::key(&session, 2, true)
        _ = UnicycleGame::key(&session, 0, false)
        return 2.i32() if UnicycleGame::control(&session) != Unicycle::PEDAL_B
        _ = UnicycleGame::key(&session, 3, true)
        return 3.i32() if UnicycleGame::control(&session) != Unicycle::PEDAL
        _ = UnicycleGame::key(&session, 1, true)
        return 4.i32() if UnicycleGame::control(&session) != Unicycle::NEUTRAL
        _ = UnicycleGame::steer(&session, Unicycle::BACK_F)
        _ = UnicycleGame::advance(&session, 1.0)
        return 5.i32() if session.run.last != Unicycle::BACK_F or UnicycleGame::control(&session) != Unicycle::NEUTRAL
        _ = UnicycleGame::clear_keys(&session)
        finish: f64 = session.run.track.finish
        session.run.body <- Unicycle::Body{px: finish, py: 0.35, vx: 0.0, vy: 0.0, a: 0.0, w: 0.0,
            qx: finish, qy: 1.35, ux: 0.0, uy: 0.0}
        _ = UnicycleGame::advance(&session, 1.0)
        return 6.i32() if session.phase != UnicycleGame::JUDGED or session.rung != 2 or session.run.result != Unicycle::CLEAR
        return 7.i32() if UnicycleGame::advance(&session, 3.49)
        _ = UnicycleGame::advance(&session, 3.5)
        return 8.i32() if session.phase != UnicycleGame::PLAYING or session.trial != 2
        session.run.body.qy <- 0.1
        _ = UnicycleGame::advance(&session, 3.5)
        return 9.i32() if session.phase != UnicycleGame::JUDGED or session.rung != 1
        _ = UnicycleGame::agent_event(&session, 3.5, Unicycle::NEUTRAL)
        return 10.i32() if session.phase != UnicycleGame::PLAYING or session.trial != 3
        session.run.body.qy <- 0.1
        _ = UnicycleGame::advance(&session, 3.5)
        _ = UnicycleGame::agent_event(&session, 3.5, Unicycle::NEUTRAL)
        return 11.i32() if session.phase != UnicycleGame::DONE or session.wins != 1 or session.best_rung != 1
        return 12.i32() if not UnicycleGame::start(&session, 3.5) or session.trial != 1 or session.wins != 0
        return 0.i32()

def main() -> i32:
    can Abort.Panic, Console.Write:
        status: i32 = session_trace()
        if status != 0.i32():
            _ = dprintf(2.i32(), "Unicycle session assertion %d\n", status)
            return status
        for rung in [0, 1, 2, 4, 6, 7, 10, 12, 13, 16, 20, 30, 60]:
            for seed in [0, 17, 42] |rung|:
                candidate(rung, seed)
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            screened(rung, 17)
        for mode in 2..<5:
            edge(mode)
        return 0.i32()
