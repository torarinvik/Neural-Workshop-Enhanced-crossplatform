# Differential sweep for src/readouttext.elisa.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/strings.elisa"
include "../src/gamemode.elisa"
include "../src/readouttext.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            index: mutable i64 = 23
            number: mutable i64 = value
            if number == 0:
                index <- 22
                buf[22] <- 48.u8()
            else:
                negative: bool = number < 0
                while number != 0:
                    digit: i64 = number % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    index <- index - 1
                    buf[index.usize()] <- (48 + magnitude).u8()
                    number <- number / 10
                if negative:
                    index <- index - 1
                    buf[index.usize()] <- 45.u8()
            printr((&buf[index.usize()]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr("|")
        print_i64(value)

def emit_view(view: sview):
    can Console.Write, Abort.Panic:
        printr("[")
        index: mutable i64 = 0
        length: i64 = sview_len(view).i64()
        while index < length |index, view, length|:
            byte: u8 = sview_at(view, index.usize())
            if byte == 10.u8():
                printr("\\n")
            elif byte == 92.u8():
                printr("\\\\")
            else:
                one: mutable u8[2] = zeroed
                one[0] <- byte
                trusted Unsafe.PointerCast:
                    printr((&one[0]).cast[cstr])
            index <- index + 1
        printr("]")

def emit_text(text: dstr):
    can Console.Write, Memory.Allocate, Abort.Panic:
        emit_view(bytes_view(text))

def modalities_for(which: i64) -> darray[Modality]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[Modality] = []
        if which == 0:
            out.push(Modality.Position1)
            out.push(Modality.Audio)
        elif which == 1:
            out.push(Modality.Vis1)
            out.push(Modality.Vis2)
            out.push(Modality.Color)
            out.push(Modality.VisAudio)
            out.push(Modality.Image)
            out.push(Modality.Arithmetic)
        elif which == 2:
            out.push(Modality.VisVis)
            out.push(Modality.VisAudio)
            out.push(Modality.AudioVis)
        elif which == 3:
            for index in 0..<15 |out|:
                out.push(input_modality_at(index))
            out.push(Modality.Arithmetic)
        else:
            out.push(Modality.Arithmetic)
        return out

def key_list() -> darray[sview]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[sview] = []
        out.push("A")
        out.push("B")
        out.push("C")
        out.push("D")
        out.push("E")
        out.push("F")
        out.push("G")
        out.push("H")
        out.push("SEMICOLON")
        out.push("J")
        out.push("K")
        out.push("L")
        out.push("M")
        out.push("N")
        out.push("O")
        return out

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(16 * 1024 * 1024)
        in work:
            tables: ModeTables = ModeTables()
            keys: darray[sview] = key_list()
            print("names|spec|which|started|session|skip|clinical|jaeggi|mode|advance|fallback|time_today|sessions_today|time_hours|sessions_hours|total|trial|hide|history")
            for spec in 0..<120 |tables, keys|:
                which: i64 = spec % 5
                started: bool = spec % 7 == 1
                session_number: i64 = 0 if spec % 11 == 0 else 1 + spec % 5
                skip: bool = spec % 13 == 4
                clinical: bool = spec % 9 == 2
                jaeggi: bool = spec % 4 == 1
                mode: i64 = 2 + spec % 11
                advance: i64 = 70 + spec % 3
                fallback: i64 = 40 + spec % 4
                time_today: i64 = 600 + spec * 7
                sessions_today: i64 = spec % 12
                time_hours: i64 = 1200 + spec * 5
                sessions_hours: i64 = spec % 17
                total: i64 = 20 + spec % 9
                trial: i64 = spec % 23
                hide: bool = spec % 6 == 3
                history_count: i64 = spec % 25

                printr("spec|")
                print_i64(spec)
                emit_cell(which)
                emit_cell(1 if started else 0)
                emit_cell(session_number)
                emit_cell(1 if skip else 0)
                emit_cell(1 if clinical else 0)
                emit_cell(1 if jaeggi else 0)
                emit_cell(mode)
                emit_cell(advance)
                emit_cell(fallback)
                emit_cell(time_today)
                emit_cell(sessions_today)
                emit_cell(time_hours)
                emit_cell(sessions_hours)
                emit_cell(total)
                emit_cell(trial)
                emit_cell(1 if hide else 0)
                emit_cell(history_count)
                print("")

                modalities: darray[Modality] = modalities_for(which)
                rights: mutable i64[16] = zeroed
                wrongs: mutable i64[16] = zeroed
                for index in 0..<16 |rights, wrongs|:
                    rights[index.usize()] <- (index * 3 + spec) % 7
                    wrongs[index.usize()] <- (index + spec) % 5
                summary: AnalysisSummary = analysis_summary(&modalities, rights, wrongs, jaeggi)

                printr("analysis")
                emit_text(analysis_text(&modalities, &keys, rights, wrongs,
                                        summary, started, session_number, skip,
                                        clinical, jaeggi))
                print("")
                printr("summary")
                emit_cell(summary.percent)
                for index in 0..<16 |summary|:
                    emit_cell(summary.categories[index.usize()])
                print("")
                printr("title")
                emit_view(chart_title_text(started))
                print("")

                history: mutable darray[ReadoutHistoryEntry] = []
                for index in 0..<history_count |history|:
                    history.push(ReadoutHistoryEntry{
                        session_number: -1 if index % 5 == 4 else 100 + index,
                        mode: 2 + index % 8,
                        back: 1 + index % 5,
                        percent: 30 + index * 3,
                        manual: index % 5 == 4})
                rows: i64 = chart_row_count(&history)
                start: i64 = chart_history_start(&history)
                for row in 0..<rows |history, tables|:
                    entry: ReadoutHistoryEntry = history[(start + row).usize()]
                    printr("chart")
                    emit_cell(row)
                    emit_cell(chart_row_kind(entry.manual, entry.percent, advance, fallback))
                    for column in 0..<3 |history, tables|:
                        printr("|")
                        emit_text(chart_cell_text(&tables, entry, column))
                    print("")

                printr("average")
                emit_text(average_text(&tables, &history, mode, started, clinical))
                print("")
                printr("today")
                emit_text(today_text(time_today, sessions_today, time_hours,
                                     sessions_hours, started))
                print("")
                printr("remaining")
                emit_text(trials_remaining_text(total, trial, started, hide))
                print("")
                print("end")
        destroy work
        return 0
