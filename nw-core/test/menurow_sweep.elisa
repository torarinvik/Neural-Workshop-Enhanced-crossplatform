# Every row shape a menu can produce, printed one per line. menurow_diff.py
# formats the same cases with the ORIGINAL's Menu._label_text and compares.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "../src/strings.elisa"
include "../src/menu_model.elisa"

# Byte at a time, as the other text sweeps do: a dstr is a darray[u8] and
# there is no cstr conversion that keeps embedded spacing honest. Bracketed so
# trailing spaces survive the comparison -- a row's padding IS the thing under
# test, and a shell that trims would hide a column that had drifted.
def emit(name: sview, kind: i64, number: f64, text: sview):
    can Console.Write, Memory.Allocate, Abort.Panic:
        row: dstr = MenuText::row_text(name, kind, number, text)
        view: sview = bytes_view(row)
        printr("[")
        index: mutable i64 = 0
        while index < sview_len(view).i64() |index, view|:
            one: mutable u8[2] = zeroed
            one[0] <- sview_at(view, index.usize())
            trusted Unsafe.PointerCast:
                printr((&one[0]).cast[cstr])
            index <- index + 1
        print("]")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(1024 * 1024)
        in work:
            emit("Use position", MenuText::BOOL, 1.0, "")
            emit("Use color", MenuText::BOOL, 0.0, "")
            emit("Crab-back mode (reverse order of sets of N stimuli)", MenuText::BOOL, 0.0, "")
            emit("2D grid size", MenuText::INT, 3.0, "")
            emit("Trial interval (ms)", MenuText::INT, 3000.0, "")
            emit("Simultaneous stimuli differentiated by", MenuText::TEXT, 0.0, "color")
            emit("Simultaneous stimuli differentiated by", MenuText::TEXT, 0.0, "image")
            emit("Active 2D position cells", MenuText::ALL, 0.0, "")
            emit("Active 2D position cells", MenuText::ALL, 8.0, "")
            # The whole interference ladder: i/8 for i in 0..8, which is where
            # the one-decimal / two-decimal split actually bites.
            emit("Interference (tricky stimulus generation)", MenuText::PERCENT, 0.0, "")
            emit("Interference (tricky stimulus generation)", MenuText::PERCENT, 0.125, "")
            emit("Interference (tricky stimulus generation)", MenuText::PERCENT, 0.25, "")
            emit("Interference (tricky stimulus generation)", MenuText::PERCENT, 0.375, "")
            emit("Interference (tricky stimulus generation)", MenuText::PERCENT, 0.5, "")
            emit("Interference (tricky stimulus generation)", MenuText::PERCENT, 0.625, "")
            emit("Interference (tricky stimulus generation)", MenuText::PERCENT, 0.75, "")
            emit("Interference (tricky stimulus generation)", MenuText::PERCENT, 0.875, "")
            emit("Interference (tricky stimulus generation)", MenuText::PERCENT, 1.0, "")
            # Below .1 and above .9 without being an endpoint: two decimals.
            emit("Interference (tricky stimulus generation)", MenuText::PERCENT, 0.0625, "")
            emit("Interference (tricky stimulus generation)", MenuText::PERCENT, 0.9375, "")
            emit("Interference (tricky stimulus generation)", MenuText::PERCENT, 0.05, "")
            emit("A command row", MenuText::COMMAND, 0.0, "")
            emit("", MenuText::SPACER, 0.0, "")
            # A name longer than the 51-column pad pushes the value right.
            emit("A name that is considerably longer than fifty-one characters", MenuText::INT, 7.0, "")
        destroy work
        return 0
