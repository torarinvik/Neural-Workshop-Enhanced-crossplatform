include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_freekick.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# The pitch Free Kick draws, for freekick_scene_diff.py, in frames of 1/60 s:
# at the start, the dials turned, the autopilot's ball in flight, the
# autopilot's round judged, and the first kick as set struck at once and
# judged; then the options notes.

def emit(rung: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        session: mutable FreeKickGame::Session = FreeKickGame::initialize(rung, 1, true, 17)
        _ = FreeKickGame::start(&session, 0.0)
        after: mutable i64 = -1
        frame: mutable i64 = 1
        while frame <= 1800 and session.phase == FreeKickGame::PLAYING |session, mode, after, frame|:
            break if mode == 0 or (mode == 1 and frame > 40) or (mode == 2 and after >= 0 and frame - after > 5)
            port: mutable i64 = -1
            if mode == 1:
                port <- FreeKick::AIM_R if frame <= 15 else (FreeKick::CURL_L if frame <= 30 else FreeKick::RAISE)
            elif mode == 4:
                port <- FreeKick::KICK if frame == 1 else -1
            else:
                port <- FreeKick::pilot(&session.run)
            if port >= 0:
                _ = FreeKickGame::input(&session, port) can Global{Read,Write}
            after <- frame if after < 0 and session.run.struck and mode != 3
            _ = FreeKickGame::advance(&session, frame.f64() / 60.0)
            frame <- frame + 1
        _ = printf("frame %lld %lld %lld\n", rung, mode, session.run.result)
        caption: mutable dstr = []
        SceneFreeKick::verdict_text(&session.run, &caption)
        _ = printf("verdict ")
        for char in caption:
            _ = printf("%c", char.i32())
        _ = printf("\n")
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneFreeKick::view(&list, &session.run)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")
        FreeKickGame::close(&session)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneFreeKick::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 2, 4, 7, 10, 13, 30]:
            for mode in 0..<5 |rung|:
                region scratch(33554432):
                    in scratch:
                        emit(rung, mode)
        return 0.i32()
