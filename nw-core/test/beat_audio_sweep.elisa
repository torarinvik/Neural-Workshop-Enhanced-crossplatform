include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/beat_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(song: Beat::Song&, begin: f64):
    can Memory.Allocate, Abort.Panic, Console.Write:
        pcm: mutable u8[9000] = zeroed
        length: i64 = BeatAudio::render(song, begin, begin + 0.093, &pcm[0], 9000)
        for index in 0..<length |pcm|:
            _ = printf("%02x", pcm[index.usize()].i32())
        _ = printf("\n")

def main() -> i32:
    can Memory.Allocate, Abort.Panic, Console.Write:
        for rung in 15..<18:
            song: Beat::Song = Beat::deal(rung, 17)
            for index in 0..<song.count |song|:
                emit(&song, song.times[index.usize()] - 0.024)
                emit(&song, song.times[index.usize()] + 0.012)
        return 0.i32()
