include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_semaphore.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# Semaphore frames for semaphore_scene_diff.py, which draws the same states
# with the reference's own Semaphore._scene and requires every one of its
# shapes, polygons and labels to appear, in order, in these frames.
#
# Mid-game states are reached by stepping the run itself, 1/60 s a step with
# the reference autopilot or nobody, exactly as the diff steps semaphore.Run:
# the named letter and the chart at rung 1, a struck signal, the signaller's
# back at rung 13 with only a peek of the chart, fog on a rolling ship at
# rung 25, and then whole sessions to a pass and a fail verdict.

def frame(game: SemaphoreGame::Session&, name: cstr):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region scratch(65536):
            in scratch:
                list: mutable Display::DisplayList = Display::DisplayList()
                SceneSemaphore::render(&list, game, true)
                _ = printf("frame %s %lld %lld %lld %lld %lld\n", name, game.phase, game.rung,
                    game.trial, game.wins, game.run.strikes)
                for cmd in list.commands |list|:
                    if cmd.kind == Display::CMD_TEXT:
                        for i in 0..<(cmd.len & 0xffffff.u32()).i64() |list, cmd|:
                            _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                        _ = printf("\n")
                    elif cmd.kind == Display::CMD_POLYGON or cmd.kind == Display::CMD_POLY_POINT:
                        _ = printf("poly %u %u %u %.7g %.7g\n", cmd.kind, cmd.color, cmd.len, cmd.a.f64(), cmd.b.f64())
                    elif cmd.kind == Display::CMD_LINE or cmd.kind == Display::CMD_CIRCLE or cmd.kind == Display::CMD_RECT:
                        _ = printf("shape %u %u %.7g %.7g %.7g %.7g\n", cmd.kind, cmd.color,
                            cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64())
                _ = printf("end\n")

# Step the run: `steps` frames, or until `until` holds (1 back, 2 fogged with
# a signal up); with the autopilot when `piloted`.
def walk(game: mutable SemaphoreGame::Session&, steps: i64, piloted: bool, until: i64 = 0):
    can Abort.Panic, Memory.Allocate, Memory.Release:
        for _ in 0..<steps |game, piloted, until|:
            break if game.run.result != Semaphore::LIVE
            break if until == 1 and Semaphore::back(&game.run)
            break if until == 2 and Semaphore::fogged(&game.run) and Semaphore::index(&game.run) >= 0
            port: i64 = Semaphore::pilot(&game.run) if piloted else -1
            SemaphoreGame::reserve_cues(game, 4) can Global{Read,Write}
            Semaphore::act(&game.run, port)
            Semaphore::step(&game.run, 1.0 / 60.0)

def session(rung: i64) -> SemaphoreGame::Session:
    can Abort.Panic, Memory.Allocate, Memory.Release:
        game: mutable SemaphoreGame::Session = SemaphoreGame::initialize(rung, 1, true, 17)
        _ = SemaphoreGame::start(&game, 0.0) can Global{Read,Write}
        return game

# A whole session: the run played to its verdict through the controller.
def finish(game: mutable SemaphoreGame::Session&, piloted: bool) -> f64:
    can Abort.Panic, Memory.Allocate, Memory.Release:
        t: mutable f64 = 0.0
        while game.phase == SemaphoreGame::PLAYING and t < 200.0 |game, t, piloted|:
            port: i64 = Semaphore::pilot(&game.run) if piloted else -1
            if port >= 0:
                _ = SemaphoreGame::input(game, port) can Global{Read,Write}
            t <- t + 1.0 / 60.0
            _ = SemaphoreGame::advance(game, t) can Global{Read,Write}
        return t

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        game: mutable SemaphoreGame::Session = SemaphoreGame::initialize(1, 1, true, 17)
        frame(&game, "ready")
        SemaphoreGame::close(&game) can Global{Read,Write}

        game <- session(1) can Global{Read,Write}
        walk(&game, 200, true) can Global{Read,Write}
        frame(&game, "named")
        SemaphoreGame::close(&game) can Global{Read,Write}

        game <- session(1) can Global{Read,Write}
        walk(&game, 780, false) can Global{Read,Write}
        frame(&game, "struck")
        SemaphoreGame::close(&game) can Global{Read,Write}

        game <- session(13) can Global{Read,Write}
        walk(&game, 6000, true, 1) can Global{Read,Write}
        if not Semaphore::back(&game.run):
            return 1
        frame(&game, "back")
        SemaphoreGame::close(&game) can Global{Read,Write}

        game <- session(25) can Global{Read,Write}
        walk(&game, 6000, true, 2) can Global{Read,Write}
        if not Semaphore::fogged(&game.run):
            return 2
        frame(&game, "fog")
        SemaphoreGame::close(&game) can Global{Read,Write}

        game <- session(1) can Global{Read,Write}
        t: mutable f64 = finish(&game, true) can Global{Read,Write}
        frame(&game, "passed")
        _ = SemaphoreGame::advance(&game, t + 2.49) can Global{Read,Write}
        frame(&game, "hold")
        _ = SemaphoreGame::advance(&game, t + 2.5) can Global{Read,Write}
        frame(&game, "done")
        SemaphoreGame::close(&game) can Global{Read,Write}

        game <- session(1) can Global{Read,Write}
        _ = finish(&game, false) can Global{Read,Write}
        frame(&game, "failed")
        SemaphoreGame::close(&game) can Global{Read,Write}

        rungs: i64[11] = [1, 4, 7, 10, 13, 16, 20, 25, 30, 0, 200]
        for i in 0..<11 |rungs|:
            region note(4096):
                in note:
                    text: mutable dstr = []
                    SceneSemaphore::option_note(rungs[i.usize()], &text)
                    _ = printf("note %lld ", rungs[i.usize()])
                    view: sview = bytes_view(text)
                    for j in 0..<sview_len(view).i64() |view|:
                        _ = printf("%c", sview_at(view, j.usize()).i32())
                    _ = printf("\n")
        return 0
