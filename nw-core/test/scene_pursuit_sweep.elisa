# Differential sweep driver for src/scene_pursuit.elisa.
# See scene_pursuit_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_glyphrow.elisa"
include "../src/scene_pursuit.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|has_quarry|form|color|radius|adaptive|multiplier|round|total_rounds|tall|verdict")
            for spec in 0..<40:
                phase: i64 = spec % 4
                black: bool = spec % 7 == 1
                has_quarry: bool = spec % 11 != 10
                form: i64 = (spec / 4) % SceneGlyphRow::FORM_COUNT
                color: i64 = (spec / 4) % SceneGlyphRow::COLOR_COUNT
                # A radius small enough to hit the six-pixel floor on a short
                # window, and one comfortably above it.
                radius: i64 = 3 + (spec / 4) % 5 * 8
                adaptive: bool = (spec / 4) % 2 == 0
                # Rounded to two places, so a value that ends in 5 at the
                # third place is where the two roundings would differ.
                multiplier: i64 = 75 + (spec / 4) % 10 * 25
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if has_quarry else 0)
                emit_bar(form)
                emit_bar(color)
                emit_bar(radius)
                emit_bar(1 if adaptive else 0)
                emit_bar(multiplier)
                emit_bar(1 + spec % 6)
                emit_bar(6)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: ScenePursuit::PursuitPaint = ScenePursuit::paint_of(black, width, height, 2.0, 2.0)
                ScenePursuit::render(&list, &paint, phase, has_quarry,
                                     0.17 + 0.06 * (spec % 9).f64(),
                                     0.21 + 0.05 * (spec % 7).f64(),
                                     radius.f64(), form, color, adaptive,
                                     multiplier.f64() / 100.0, 1 + spec % 6, 6,
                                     sview("Stay on it", 0, -1), verdict,
                                     sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
