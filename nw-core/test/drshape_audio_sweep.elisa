include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/drshape_puzzle.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit_patch(p: DrShapeAudio::Patch&):
    can Abort.Panic, Console.Write:
        _ = printf("%lld %lld %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g\n",
            p.name, p.count, p.tap_count, p.attack, p.decay, p.sustain, p.release,
            p.fm_ratio, p.fm_index, p.fm_decay, p.vibrato_rate, p.vibrato_depth,
            p.tremolo_rate, p.tremolo_depth, p.glide, p.glide_time, p.noise, p.drive, p.fold, p.ring_ratio, p.ring_mix)
        for i in 0..<p.count |p|:
            part: TonePcm::Partial = p.partials[i.usize()]
            _ = printf("%.17g %.17g %.17g\n", part.ratio, part.gain, part.decay)
        for i in 0..<p.tap_count |p|:
            tap: DrShapeAudio::Tap = p.taps[i.usize()]
            _ = printf("%.17g %.17g %.17g\n", tap.delay, tap.gain, tap.pan)

def emit_audio(bank: DrShapeAudio::Bank&, begin: f64, end: f64, rate: i64):
    can Abort.Panic, Memory.Allocate, Console.Write:
        first: DrShapeDeal::Note = DrShapeDeal::Note{t: 0.045, dur: 0.19, freq: 371.0,
            pan: -0.63, pan2: 0.37, gain: 0.58, gain2: 0.9, bright: 0.71, voice: 0, seed: 19, who: 1, room: 0.8}
        second: DrShapeDeal::Note = DrShapeDeal::Note{t: 0.09, dur: 0.14, freq: 1800.0,
            pan: 0.7, pan2: 0.27, gain: 0.71, gain2: 0.12, bright: 0.41, voice: 1, seed: 867, who: 2, room: 0.0}
        notes: darray[DrShapeDeal::Note] = [first, second]
        output: mutable u8[32768] = zeroed
        length: i64 = DrShapeAudio::write(&notes, bank, begin, end, &output[0], 32768, rate)
        for i in 0..<length |output|:
            _ = printf("%02x", output[i.usize()].i32())
        _ = printf("\n")

def emit_puzzle(rung: i64, seed: i64, forced: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        p: mutable DrShapePuzzle::Puzzle = DrShapePuzzle::deal(rung, seed, forced)
        _ = printf("%lld %lld %lld %.17g %.17g %lld %lld\n",
            p.mode, p.count, p.answer, p.show_end, p.choose, p.span_count, p.notes.count.i64())
        _ = printf("%lld %lld %lld\n", p.hues[0], p.hues[1], p.hues[2])
        for i in 0..<p.match_cards.target.path.count |p|:
            _ = printf("%.17g ", p.drawn_by[i.usize()])
        _ = printf("\n")
        for i in 0..<p.span_count |p|:
            span: DrShapePuzzle::Span = p.spans[i.usize()]
            _ = printf("%lld %.17g %.17g\n", span.who, span.start, span.end)
        for i in 0..<p.bank.count |p|:
            emit_patch(&p.bank.patches[i.usize()])
        for i in 0..<p.notes.count |p|:
            n: DrShapeDeal::Note = p.notes[i]
            _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %lld %lld %lld %.17g\n",
                n.t, n.dur, n.freq, n.pan, n.pan2, n.gain, n.gain2, n.bright, n.voice, n.seed, n.who, n.room)
        if rung == 30:
            output: mutable u8[16384] = zeroed
            length: i64 = DrShapeAudio::write(&p.notes, &p.bank, 0.4, 0.49, &output[0], 16384)
            for i in 0..<length |output|:
                _ = printf("%02x", output[i.usize()].i32())
            _ = printf("\n")

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Console.Write:
        for name in 0..<18:
            for variant in 0..<3 |name|:
                rng: mutable MT19937 = zeroed
                mt_seed_int(&rng, (17 + variant * 111 + name).u64())
                wild: f64 = variant.f64() * 0.5
                bank: mutable DrShapeAudio::Bank = zeroed
                bank.count <- 2
                bank.patches[0] <- DrShapeAudio::make_patch(name, &rng, wild)
                bank.patches[1] <- DrShapeAudio::make_patch((name + 5) % 18, &rng, wild)
                emit_patch(&bank.patches[0])
                emit_patch(&bank.patches[1])
                emit_audio(&bank, 0.0, 0.18, 22050)
                emit_audio(&bank, 0.18, 0.32, 22050)
                emit_audio(&bank, 0.32, 0.53, 16000)
        for rung in 1..<33:
            rng: mutable MT19937 = zeroed
            mt_seed_int(&rng, (rung * 17).u64())
            level: DrShape::Grade = DrShape::grade(rung)
            bank: mutable DrShapeAudio::Bank = DrShapeAudio::patches(&level, &rng)
            if level.overload > 0.0:
                DrShapeAudio::add_noise_patches(&bank, &rng)
            _ = printf("%lld\n", bank.count)
            for i in 0..<bank.count |bank|:
                emit_patch(&bank.patches[i.usize()])
        for rung in 1..<34:
            emit_puzzle(rung, rung * 13, -1)
        for mode in 0..<6:
            emit_puzzle(30, 17, mode)
        emit_puzzle(30, -9223372036854775807 - 1, -1)
        emit_puzzle(30, 9223372036854775807, -1)
        return 0.i32()
