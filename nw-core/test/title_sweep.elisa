# Emits the title screen for each flag combination the original can show, as
# hex-encoded display lists (one per line). title_diff.py decodes them and
# checks every command against values measured from the real pyglet UI.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../src/display.elisa"
include "../src/scene_title.elisa"

def print_hex_byte(value: u8):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            digits: cstr = "0123456789abcdef"
            pair: u8[3] = zeroed
            pair[0] <- digits.cast[u8&][(value >> 4.u8()).usize()]
            pair[1] <- digits.cast[u8&][(value & 15.u8()).usize()]
            pair[2] <- 0
            printr((&pair[0]).cast[cstr])

def emit_one(black_background: bool, jaeggi_mode: bool, clinical_mode: bool):
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(4 * 1024 * 1024)
        in work:
            list: mutable Display::DisplayList = Display::DisplayList()
            render_title_frame(&list, "Version 5.0", "native: C", black_background, jaeggi_mode, clinical_mode)
            encoded: darray[u8] = Display::encode_binary(&list)
            for byte in encoded:
                print_hex_byte(byte)
            print("")
        destroy work

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        # black_background x jaeggi x clinical, in a fixed order the checker
        # relies on.
        emit_one(false, false, false)
        emit_one(true, false, false)
        emit_one(false, true, false)
        emit_one(false, false, true)
        emit_one(true, true, true)
        return 0
