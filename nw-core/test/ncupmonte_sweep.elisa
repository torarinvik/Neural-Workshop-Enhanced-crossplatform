# Differential sweep driver for tasks/ncupmonte.elisa. See ncupmonte_diff.py
# for the reference side.
#
# What is compared is the deal, the swap plan and the permutation the swaps
# leave behind -- so a divergence in the draw order shows up as cups in the
# wrong slots rather than as one wrong number. The animation is the shell's and
# is not here; the reference settles a swap when its tween ends, so the
# permutation is the same whether or not anything was drawn.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/ncupmonte.elisa"

# printr(i64) and int_to_string_scratch both trip a stage1 backend decline of
# store_* generics (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)


def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(64 * 1024 * 1024)
        in w:
            for cups in 0..<14:
                for ceiling in 3..<12:
                    printr("clamp")
                    emit_cell(cups)
                    emit_cell(ceiling)
                    emit_cell(NCupMonte::clamp_cups(cups, ceiling))
                    print("")

            # A whole round: the ball, the plan, and the slots the swaps leave
            # the cups in. `swap_count` spans zero and a negative, because the
            # plan is `swap_count + cups` floored at one and both ends of that
            # want checking.
            for cups in 3..<10:
                for swap_count in -2..<5:
                    for seed in 1..<4:
                        rng: mutable MT19937 = mt19937_new()
                        mt_seed_int(&rng, (cups * 1000 + (swap_count + 2) * 100 + seed).u64())
                        table: mutable NCupMonte::NCupMonteTable = NCupMonte::new_table(cups, 12, true, swap_count)
                        NCupMonte::start_round(&table, &rng)
                        NCupMonte::plan_swaps(&table, &rng)
                        printr("round")
                        emit_cell(cups)
                        emit_cell(swap_count)
                        emit_cell(seed)
                        emit_cell(table.ball)
                        emit_cell(table.swap_n)
                        for at in 0..<table.swap_n |table|:
                            emit_cell(Ints::at_ref(&table.swaps, at * 2))
                            emit_cell(Ints::at_ref(&table.swaps, at * 2 + 1))
                        NCupMonte::settle_all(&table)
                        emit_cell(table.phase)
                        for slot in 0..<table.cups |table|:
                            emit_cell(NCupMonte::cup_in_slot(&table, slot))
                        print("")

            # The guess and the ladder, both ways, including a guess made out
            # of phase.
            for cups in 3..<8:
                for right in 0..<2:
                    rng: mutable MT19937 = mt19937_new()
                    mt_seed_int(&rng, (cups * 31 + right).u64())
                    table: mutable NCupMonte::NCupMonteTable = NCupMonte::new_table(cups, 9, true, 2)
                    printr("guess")
                    emit_cell(cups)
                    emit_cell(right)
                    # Out of phase: refused, and nothing moves.
                    emit_cell(1 if NCupMonte::choose_cup(&table, 0) else 0)
                    emit_cell(table.cups)
                    NCupMonte::start_round(&table, &rng)
                    NCupMonte::plan_swaps(&table, &rng)
                    NCupMonte::settle_all(&table)
                    pick: i64 = table.ball if right == 1 else (table.ball + 1) % table.cups
                    emit_cell(1 if NCupMonte::choose_cup(&table, pick) else 0)
                    emit_cell(table.cups)
                    emit_cell(table.phase)
                    emit_cell(table.guess)
                    print("")
        destroy w
        return 0
