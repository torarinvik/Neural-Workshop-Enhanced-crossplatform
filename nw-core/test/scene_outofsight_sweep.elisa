# Differential sweep driver for src/scene_outofsight.elisa.
# See scene_outofsight_diff.py for the reference side.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_outofsight.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|phase|black|dots|blinds|has_probe|answer|round|total_rounds|probes_done|probes_per_round")
        region w(256 * 1024 * 1024)
        in w:
            for spec in 0..<36:
                phase: i64 = spec % 6
                black: bool = spec % 7 == 1
                dots: i64 = 3 + (spec / 6) % 6 * 3
                blinds: i64 = (spec / 6) % 5
                has_probe: bool = spec % 11 != 10
                # No answer yet, wrong, right -- the ring carries all three.
                answer: i64 = (spec / 6) % 3 - 1
                # Zero rounds is a real state: the round counter is joined on
                # only when there is a total to count against.
                total_rounds: i64 = 0 if spec % 13 == 12 else 6
                probes_done: i64 = spec % 9
                tall: i64 = 1368
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(dots)
                emit_bar(blinds)
                emit_bar(1 if has_probe else 0)
                emit_bar(answer)
                emit_bar(1 + spec % 6)
                emit_bar(total_rounds)
                emit_bar(probes_done)
                emit_bar(5)
                print("")
                field: mutable darray[SceneOutOfSight::Dot] = []
                for index in 0..<dots |field|:
                    field.push(SceneOutOfSight::Dot{
                        x: 0.07 + 0.11 * (index % 8).f64(),
                        y: 0.13 + 0.13 * (index % 6).f64(),
                        target: index % 3 == 0})
                slabs: mutable darray[SceneOutOfSight::Blind] = []
                for index in 0..<blinds |slabs|:
                    slabs.push(SceneOutOfSight::Blind{
                        left: 0.05 + 0.17 * index.f64(),
                        bottom: 0.12 + 0.13 * (index % 4).f64(),
                        width: 0.14, height: 0.22})
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneOutOfSight::OutOfSightPaint = SceneOutOfSight::paint_of(black, width, height, 2.0, 2.0)
                SceneOutOfSight::render(&list, &paint, phase, &field, &slabs,
                                        has_probe, 0.31 + 0.04 * (spec % 9).f64(),
                                        0.27 + 0.05 * (spec % 7).f64(),
                                        answer, 1 + spec % 6, total_rounds,
                                        probes_done, 5,
                                        sview("Where did it go?", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
