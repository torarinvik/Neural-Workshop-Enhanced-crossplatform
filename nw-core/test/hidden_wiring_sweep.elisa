include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/hidden_wiring_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def main() -> i32:
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic:
        for rung in 1..<31 |rung|:
            region scratch(8388608):
                in scratch:
                    level: HiddenWiring::Grade = HiddenWiring::grade(rung)
                    gates: darray[HiddenWiring::Gate] = HiddenWiring::space(&level)
                    count: i64 = 1 << level.switches.u64()
                    digest: u64 = fingerprint(&gates, count)
                    _ = printf("%lld %lld %lld %llu\n", rung, level.switches, gates.count.i64(), digest)
                    for seed in 0..<5 |seed, gates, level, count|:
                        rng: mutable MT19937 = mt19937_new()
                        mt_seed_int(&rng, seed.u64())
                        dealt: mutable HiddenWiring::Deal = zeroed
                        HiddenWiring::deal(&level, &gates, &rng, &dealt)
                        _ = printf("%lld", seed)
                        for lamp in 0..<level.lamps |lamp, dealt|:
                            _ = printf(" %lld", dealt.indices[lamp.usize()])
                        for look in 0..<HiddenWiring::budget(&level) |look, dealt|:
                            _ = printf(" %lld", dealt.lies[look.usize()])
                        for exam in 0..<dealt.questions |exam, dealt|:
                            _ = printf(" %lld", dealt.exam[exam.usize()])
                        _ = printf("\n")
                        round: mutable HiddenWiring::Round = zeroed
                        for look in 0..<HiddenWiring::budget(&level) |look, round, level, dealt, count|:
                            reading: i64 = HiddenWiring::look(&round, &level, &dealt, (look * 19) % count)
                            _ = printf("%lld ", reading)
                        _ = printf("%lld", HiddenWiring::look(&round, &level, &dealt, 0))
                        round.examining <- true
                        for exam in 0..<dealt.questions |exam, round, level, dealt, count|:
                            _ = HiddenWiring::answer(&round, &level, &dealt, (exam * 5) % count)
                        _ = printf(" %lld %lld %lld\n", round.wrong, HiddenWiring::cost(&round, &level), HiddenWiring::question(&round, &dealt))
                        reference: mutable HiddenWiring::Round = zeroed
                        HiddenWiringReference::play(&level, &gates, &dealt, &reference)
                        _ = printf("%lld %lld %.0f", reference.wrong, HiddenWiring::cost(&reference, &level), HiddenWiringReference::par(&level, &reference) * 1000000000.0)
                        for look in 0..<reference.looks |look, reference|:
                            _ = printf(" %lld %lld", reference.settings[look.usize()], reference.readings[look.usize()])
                        for exam in 0..<reference.answered |exam, reference|:
                            _ = printf(" %lld", reference.answers[exam.usize()])
                        _ = printf("\n")
                destroy scratch
        return check_session()

def fingerprint(gates: darray[HiddenWiring::Gate]&, settings: i64) -> u64:
    can Abort.Panic:
        digest: mutable u64 = 2166136261.u64()
        for index in 0..<gates.count.i64() |index, gates, digest, settings|:
            for setting in 0..<settings |setting, index, gates, digest|:
                bit: u64 = 1.u64() if HiddenWiring::evaluate(gates[index.usize()], setting) else 0.u64()
                digest <- ((digest ^ bit) * 16777619.u64()) & 4294967295.u64()
        return digest

def answer_exam(run: mutable HiddenWiringGame::Run&, correct: bool, time: i64):
    can Abort.Panic:
        for index in 0..<run.dealt.questions |index, run, correct, time|:
            want: i64 = HiddenWiring::question(&run.round, &run.dealt)
            for setting in 0..<(1 << run.level.switches.u64()) |setting, run, want, correct, time|:
                continue if (HiddenWiring::lamps(&run.level, &run.dealt, setting) == want) != correct
                for bit in 0..<run.level.switches |bit, run, setting|:
                    if ((run.setting ^ setting) & (1 << bit.u64())) != 0:
                        _ = HiddenWiringGame::steer(run, bit, 0)
                _ = HiddenWiringGame::steer(run, HiddenWiringGame::ANSWER, time)
                break

def check_session() -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        run: mutable HiddenWiringGame::Run = HiddenWiringGame::initialize(1, 3, true, 17)
        return 1.i32() if not HiddenWiringGame::start(&run)
        return 2.i32() if not HiddenWiringGame::steer(&run, 0, 0) or run.setting != 1
        return 3.i32() if not HiddenWiringGame::steer(&run, HiddenWiringGame::EXAM, 0)
        answer_exam(&run, true, 500)
        return 4.i32() if run.phase != HiddenWiringGame::JUDGED or not run.passed or run.rung != 2
        return 5.i32() if HiddenWiringGame::advance(&run, 4499) or not HiddenWiringGame::advance(&run, 4500)
        for look in 0..<HiddenWiring::budget(&run.level) |look, run|:
            return 6.i32() if not HiddenWiringGame::look(&run)
        return 7.i32() if run.phase != HiddenWiringGame::EXAMINING or run.setting != 0
        answer_exam(&run, false, 5000)
        return 8.i32() if run.passed or run.rung != 1
        return 9.i32() if not HiddenWiringGame::advance(&run, 9000) or run.trial != 3
        _ = HiddenWiringGame::begin_exam(&run)
        answer_exam(&run, true, 10000)
        return 10.i32() if not HiddenWiringGame::advance(&run, 14000) or run.phase != HiddenWiringGame::DONE
        return 11.i32() if run.answered != 3 or run.passed_count != 2 or run.best_rung != 1
        return 12.i32() if not HiddenWiringGame::start(&run) or run.trial != 1 or run.answered != 0
        return 0.i32()
