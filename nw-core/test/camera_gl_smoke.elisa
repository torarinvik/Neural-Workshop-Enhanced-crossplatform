extern SDL_RenderClear(renderer: mutable void&) -> bool
extern SDL_RenderPresent(renderer: mutable void&) -> bool
extern SDL_GL_GetCurrentContext() -> mutable void&?
extern SDL_ReadSurfacePixel(surface: mutable void&, x: i32, y: i32, r: mutable u8&, g: mutable u8&, b: mutable u8&, a: mutable u8&) -> bool

def sdl_pixel(surface: mutable void&, x: i32, y: i32) -> u32:
    can Abort.Panic, Unsafe.PointerCast:
        color: mutable u8[4] = zeroed
        trusted Unsafe.PointerCast:
            return 0.u32() if not SDL_ReadSurfacePixel(surface, x, y,
                (&color[0]).uintptr().cast[mutable u8&], (&color[1]).uintptr().cast[mutable u8&],
                (&color[2]).uintptr().cast[mutable u8&], (&color[3]).uintptr().cast[mutable u8&])
        return color[0].u32() | (color[1].u32() << 8.u32()) | (color[2].u32() << 16.u32()) | (color[3].u32() << 24.u32())

def sdl_present_replay(handle: usize, renderer: mutable void&, surface: mutable void&) -> i32:
    can Abort.Panic, Unsafe.PointerCast:
        return 20.i32() if nw_sdl_camera_phase(handle) != 0 or nw_sdl_camera_present(handle, renderer, 881.i32(), 641.i32()) != 0.i32()
        return 21.i32() if not nw_sdl_camera_action(handle, CameraGame::START, 0, 0, 0)
        original: mutable void&? = SDL_GL_GetCurrentContext()
        background: u32 = 0xff271709
        if not SDL_SetRenderDrawColor(renderer, 9.u8(), 23.u8(), 39.u8(), 255.u8()) or not SDL_RenderClear(renderer):
            return 22.i32()
        if nw_sdl_camera_present(handle, renderer, 881.i32(), 641.i32()) != 1.i32() or not SDL_RenderPresent(renderer):
            return 23.i32()
        before: u32 = sdl_pixel(surface, 400.i32(), 280.i32())
        if sdl_pixel(surface, 0.i32(), 0.i32()) != background or before == 0.u32() or before == background or SDL_GL_GetCurrentContext() != original:
            return 24.i32()
        bytes: mutable u8[4096] = zeroed
        length: i64 = nw_sdl_camera_chrome(handle, &bytes[0], 4096, 0, 881.i32(), 641.i32())
        if length < 16 or bytes[0] != 78.u8() or nw_sdl_camera_chrome(handle, &bytes[0], 8, 0, 881.i32(), 641.i32()) >= 0:
            return 25.i32()
        if not nw_sdl_camera_action(handle, CameraGame::PEEK_ACTION, 1, 0, 100):
            return 26.i32()
        if nw_sdl_camera_present(handle, renderer, 881.i32(), 641.i32()) != 1.i32() or not SDL_RenderPresent(renderer):
            return 27.i32()
        if sdl_pixel(surface, 400.i32(), 280.i32()) == before:
            return 28.i32()
        if nw_sdl_camera_present(handle, renderer, 603.i32(), 474.i32()) != 1.i32():
            return 29.i32()
        if not nw_sdl_camera_action(handle, CameraGame::SUBMIT, 0, 0, 200) or nw_sdl_camera_phase(handle) != 2:
            return 30.i32()
        if not nw_sdl_camera_advance(handle, 2001) or nw_sdl_camera_phase(handle) != 3:
            return 31.i32()
        return 0.i32() if nw_sdl_camera_present(handle, renderer, 881.i32(), 641.i32()) == 0.i32() else 32.i32()

def camera_options_test() -> i32:
    can Abort.Panic, Unsafe.PointerCast:
        if nw_sdl_camera_option(0, 6, 1) != 8 or nw_sdl_camera_option(0, 100, 1) != 1 or nw_sdl_camera_option(0, 1, -1) != 100:
            return 34.i32()
        if nw_sdl_camera_option(0, 7, 0) != -1 or nw_sdl_camera_option(1, 9, 0) != -1:
            return 35.i32()
        if nw_sdl_camera_option(1, 8, 1) != 12 or nw_sdl_camera_option(1, 1, -1) != 30 or nw_sdl_camera_option(2, 0, 1) != 1:
            return 36.i32()
        text: mutable u8[512] = zeroed
        trusted Unsafe.PointerCast:
            buffer: mutable u8& = (&text[0]).uintptr().cast[mutable u8&]
            length: i64 = nw_sdl_camera_write_note(buffer, 512, 8, 1)
            expected: sview = "Rung 8: within 0.3 m and 4.4 degrees, 22 objects.  A match climbs a rung, a miss drops one; the ladder has no top."
            if length <= 0 or length != sview_len(expected).i64():
                return 37.i32()
            for at in 0..<length |expected, text|:
                if text[at.usize()] != sview_at(expected, at.usize()):
                    return 38.i32()
        return 0.i32()

def sdl_present_test() -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        if SDL_CreateSurface(881.i32(), 641.i32(), 0x16762004.u32()) is surface:
            if SDL_CreateSoftwareRenderer(surface) is renderer:
                handle: usize = nw_sdl_camera_create(8, 1, 1, 17)
                result: i32 = sdl_present_replay(handle, renderer, surface)
                nw_sdl_camera_destroy(handle)
                SDL_DestroyRenderer(renderer)
                SDL_DestroySurface(surface)
                return result
            SDL_DestroySurface(surface)
        return 33.i32()

def main() -> i32:
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        if not SDL_Init(32.u32()):
            SDL_Log("SDL_Init: %s", SDL_GetError())
            return 40.i32()
        _ = SDL_GL_SetAttribute(17.i32(), 3.i32())
        _ = SDL_GL_SetAttribute(18.i32(), 3.i32())
        _ = SDL_GL_SetAttribute(20.i32(), 1.i32())
        _ = SDL_GL_SetAttribute(19.i32(), 2.i32())
        opened: mutable void&? = SDL_CreateWindow("Camera replay", 64.i32(), 64.i32(), 10.u64())
        if opened == null:
            SDL_Log("SDL_CreateWindow: %s", SDL_GetError())
            SDL_Quit()
            return 41.i32()
        window: mutable void& = opened
        created: mutable void&? = SDL_GL_CreateContext(window)
        if created == null:
            SDL_Log("SDL_GL_CreateContext: %s", SDL_GetError())
            SDL_DestroyWindow(window)
            SDL_Quit()
            return 42.i32()
        context: mutable void& = created
        result: mutable i32 = camera_gl_test() can Global{Read,Write}
        if result == 0.i32():
            result <- sdl_present_test()
        _ = SDL_GL_DestroyContext(context)
        SDL_DestroyWindow(window)
        if result == 0.i32():
            # Software and Metal SDL renderers may have no current GL context.
            result <- sdl_present_test()
        if result == 0.i32():
            result <- camera_options_test()
        if result != 0.i32():
            SDL_Log("Camera OpenGL replay failed at check %d", result)
        SDL_Quit()
        return result
