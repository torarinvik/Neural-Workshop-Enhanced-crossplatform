def camera_pixel(x: i64, y: i64) -> u32:
    can Abort.Panic, Unsafe.PointerCast:
        word: mutable u32 = 0.u32()
        trusted Unsafe.PointerCast:
            glReadPixels(x.i32(), y.i32(), 1.i32(), 1.i32(), 6408.u32(), 5121.u32(),
                (&word).cast[mutable f32&])
        return word

def camera_readback(renderer: CameraGL::Renderer&, frame: CameraRender::Frame&) -> u32:
    can Abort.Panic, Unsafe.PointerCast:
        glBindFramebuffer(MarbleGLColour::FRAMEBUFFER, renderer.target.resolved)
        marker: mutable u32 = 0.u32()
        if camera_pixel(0, 0) == 0.u32():
            x: i64 = frame.live.x + frame.live.width / 2
            y: i64 = frame.live.y + frame.live.height / 2
            pixel: u32 = camera_pixel(x, y)
            photo: CameraRender::Pass = frame.photo
            ref_alpha: u32 = (camera_pixel(photo.x + photo.width / 2, photo.y + photo.height / 2) >> 24.u32()) if frame.passes == 2 else 255.u32()
            if (pixel >> 24.u32()) == 255.u32() and ref_alpha == 255.u32():
                for offset in 1..<9 |marker, x, y, frame, pixel|:
                    sample: u32 = camera_pixel(x + offset * frame.live.width / 24, y + offset * frame.live.height / 24)
                    marker <- marker | (sample ^ pixel)
        glBindFramebuffer(MarbleGLColour::FRAMEBUFFER, 0.u32())
        return marker

def camera_gl_replay(renderer: mutable CameraGL::Renderer&, run: mutable CameraGame::Session&) -> i32:
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        if not (CameraGame::start(run, 0.0) can Global{Read,Write}):
            return 1.i32()
        live: CameraRender::Frame = CameraRender::frame(run, 881, 641)
        if live.passes != 2 or not (CameraGL::render(renderer, &live) can Global{Read,Write}):
            return 2.i32()
        before: u32 = camera_readback(renderer, &live)
        if before == 0.u32() or glGetError() != 0.u32():
            return 3.i32()
        if not CameraGame::set_peek(run, true):
            return 4.i32()
        peek: CameraRender::Frame = CameraRender::frame(run, 881, 641)
        if peek.passes != 1 or not (CameraGL::render(renderer, &peek) can Global{Read,Write}):
            return 5.i32()
        after: u32 = camera_readback(renderer, &peek)
        if after == 0.u32() or after == before or glGetError() != 0.u32():
            return 6.i32()
        resized: CameraRender::Frame = CameraRender::frame(run, 603, 474)
        if not (CameraGL::render(renderer, &resized) can Global{Read,Write}):
            return 7.i32()
        if renderer.target.width != 603.i32() or renderer.target.height != 474.i32():
            return 8.i32()
        return 0.i32()

def camera_gl_test() -> i32:
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        run: mutable CameraGame::Session = CameraGame::initialize(8, 1, true, 17)
        renderer: mutable CameraGL::Renderer = zeroed
        result: i32 = camera_gl_replay(&renderer, &run) can Global{Read,Write}
        CameraGL::close(&renderer)
        CameraGame::close(&run) can Global{Read,Write}
        return result

extern nw_sdl_camera_option(row: i64, value: i64, direction: i64) -> i64
extern nw_sdl_camera_write_note(dest: mutable u8&, capacity: i64, rung: i64, adaptive: i64) -> i64
extern nw_sdl_camera_create(rung: i64, trials: i64, adaptive: i64, seed: i64) -> usize
extern nw_sdl_camera_destroy(handle: usize)
extern nw_sdl_camera_action(handle: usize, code: i64, value: i64, aux: i64, now_ms: i64) -> bool
extern nw_sdl_camera_advance(handle: usize, now_ms: i64) -> bool
extern nw_sdl_camera_phase(handle: usize) -> i64
extern nw_sdl_camera_chrome(handle: usize, dest: mutable u8&, capacity: i64, black: i64, width: i32, height: i32) -> i64
extern nw_sdl_camera_present(handle: usize, renderer: mutable void&, width: i32, height: i32) -> i32
extern SDL_CreateSurface(width: i32, height: i32, format: u32) -> mutable void&? can[Memory.Allocate]
extern SDL_CreateSoftwareRenderer(surface: mutable void&) -> mutable void&? can[Memory.Allocate]
