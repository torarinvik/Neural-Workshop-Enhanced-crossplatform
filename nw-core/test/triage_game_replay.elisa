include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_triage.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def state(run: TriageGame::Run&):
    can Abort.Panic, Console.Write:
        _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %.9f", run.phase, run.rung,
            run.trial, run.passed_count, run.best_rung, run.deadline_ms, run.dealt.budget, run.play.used,
            run.play.value, run.play.active, run.par)
        for i in 0..<run.dealt.level.cards |run|:
            _ = printf(" %lld", run.dealt.cards[i.usize()].pays)
        _ = printf("\n")

def scene_smoke() -> bool:
    can Abort.Panic, Memory.Allocate, Memory.Release:
        run: mutable TriageGame::Run = TriageGame::initialize(12, 1, false, 17)
        return false if SceneTriage::hit(&run, 456.0, 342.0) != TriageGame::START
        _ = TriageGame::start(&run)
        return false if SceneTriage::hit(&run, 100.0, 535.0) != 0
        _ = TriageGame::steer(&run, 0, 0)
        return false if run.play.used != 1
        length: i64 = run.dealt.cards[0.usize()].length
        digit: SceneHiddenRule::Rect = SceneTriage::digit_box(length, 0)
        swap: SceneHiddenRule::Rect = SceneTriage::swap_box(&digit)
        port: mutable i64 = SceneTriage::hit(&run, swap.x + swap.w / 2.0, swap.y + swap.h / 2.0)
        return false if port != TriageGame::FIRST_SWAP or not TriageGame::steer(&run, port, 0)
        return false if run.play.used != 2
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneTriage::render(&list, &run, false)
        encoded: darray[u8] = Display::encode_binary(&list)
        return false if encoded.count < 512.usize()
        done: SceneHiddenRule::Rect = SceneTriage::done_box()
        port <- SceneTriage::hit(&run, done.x + done.w / 2.0, done.y + done.h / 2.0)
        return false if port != TriageGame::DONE or not TriageGame::steer(&run, port, 0)
        return SceneTriage::hit(&run, 100.0, 535.0) == -1

def main() -> i32:
    can Abort.Panic, Console.Write, Memory.Allocate, Memory.Release:
        return 1.i32() if not scene_smoke()
        rungs: i64[6] = [1, 12, 25, 4, -5, 35]
        trials: i64[6] = [5, 5, 5, 2, 0, 1]
        seeds: i64[6] = [17, 17, 17, -17, 8, -29]
        for index in 0..<6 |index, rungs, trials, seeds|:
            count: i64 = trials[index.usize()]
            run: mutable TriageGame::Run = TriageGame::initialize(rungs[index.usize()], count, index != 2 and index != 3, seeds[index.usize()])
            for replay in 0..<2 |run, count|:
                _ = TriageGame::start(&run)
                state(&run)
                for trial in 0..<count |trial, run|:
                    now: i64 = 10000 * trial + 1234
                    if trial % 2 == 1:
                        _ = TriageGame::steer(&run, TriageGame::DONE, now)
                    else:
                        while run.phase == TriageGame::PLAYING |run, now|:
                            action: Triage::Move = Triage::reference_move(&run.dealt, &run.play)
                            port: i64 = action.at if action.kind == Triage::OPEN else (action.at + 8 if action.kind == Triage::SWAP else 16)
                            _ = TriageGame::steer(&run, port, now)
                    state(&run)
                    _ = TriageGame::advance(&run, now + 2499)
                    state(&run)
                    _ = TriageGame::advance(&run, now + 2500)
                    state(&run)
        return 0.i32()
