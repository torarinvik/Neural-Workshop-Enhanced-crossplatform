include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/native/tuner_recordings.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def replay(arena: mutable Arena&, index: cstr, directory: cstr):
    can Abort.Panic, Memory.Allocate, Memory.Release, Console.Write, Blocking.IO:
        entries: darray[TunerRecordingFiles::Entry] = TunerRecordingFiles::bank(arena, index, directory)
        clips: darray[Tuner::Clip] = TunerRecordingFiles::clips(&entries)
        _ = printf("%lld\n", clips.count.i64())
        return if clips.count == 0.usize()
        for i in 0..<clips.count |clips|:
            clip: Tuner::Clip = clips[i]
            _ = printf("%lld %lld %.17g\n", clip.row, clip.label, clip.duration)
        radio: Tuner::Radio = Tuner::deal(24, 17, &clips)
        audio: TunerAudio::Audio = TunerRecordingFiles::prepare(arena, directory, &entries, &radio)
        _ = printf("%lld %lld\n", radio.heard.row, audio.heard.samples.count.i64())
        for sample in audio.heard.samples:
            _ = printf("%.9g ", sample.f64())
        _ = printf("\n")
        for i in 0..<radio.count |radio, audio|:
            station: Tuner::Station = radio.stations[i.usize()]
            wave: TunerAudio::Wave = audio.stations[i.usize()]
            _ = printf("%lld %lld\n", station.sound.row, wave.samples.count.i64())
        run: mutable Tuner::Run = Tuner::initialize(&radio, true)
        while run.t < radio.listen + 0.4 |run, radio|:
            Tuner::step(&run, 1.0 / 60.0, 1)
        output: mutable u8[32768] = zeroed
        count: i64 = TunerAudio::mix(&run, &audio, radio.listen - 0.1, radio.listen + 0.2, &output[0], 32768)
        for i in 0..<count |output|:
            _ = printf("%02x", output[i.usize()].i32())
        _ = printf("\n")

def main(argc: i32, argv: mutable void&) -> i32:
    can Abort.Panic, Memory.Allocate, Memory.Release, Console.Write, Blocking.IO, Unsafe.PointerCast:
        return 2.i32() if argc != 3.i32()
        trusted Unsafe.PointerCast:
            args: usize& = argv.uintptr().cast[usize&]
            index: cstr = args[1].cast[cstr]
            directory: cstr = args[2].cast[cstr]
            region work(33554432):
                in work:
                    arena: mutable Arena& = (&work).cast[mutable Arena&]
                    replay(arena, index, directory)
        return 0.i32()
