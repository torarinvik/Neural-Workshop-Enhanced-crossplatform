include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_gunslinger.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def duel_data(duel: Gunslinger::Duel&):
    can Abort.Panic, Console.Write:
        level: Gunslinger::Grade = duel.level
        _ = printf("duel %lld %lld %lld %lld %.17g %.17g %.17g %.17g\n", level.men, duel.foe,
            1 if duel.hat else 0, duel.seed, duel.draw_at, level.quick, level.sway, level.pace)
        _ = printf("notice ")
        for byte in duel.notice:
            _ = printf("%c", byte.i32())
        _ = printf("\n")
        for k in 0..<level.men |duel|:
            man: Gunslinger::Man = duel.men[k.usize()]
            _ = printf("man %lld %.17g %.17g %.17g %.17g %.17g\n", man.hat, man.x, man.z, man.stride, man.rate, man.phase)
        for k in 0..<duel.reach_count |duel|:
            reach: Gunslinger::Reach = duel.reaches[k.usize()]
            _ = printf("reach %lld %lld %.17g\n", reach.who, 1 if reach.real else 0, reach.time)

def scripted(run: mutable Gunslinger::Run&, frame: i64, mode: i64) -> i64:
    can Abort.Panic:
        return Gunslinger::pilot(run) if mode == 0
        return HandView::PRESS if mode == 1 and frame == 0
        if mode == 2:
            if Gunslinger::drawn(run) and run.shot_count == 0:
                if not run.cocked and not run.hand.down:
                    return Gunslinger::COCK if frame % 2 == 0 else HandView::PRESS
                return HandView::RELEASE if run.hand.down
                HandView::place(&run.hand, 0.0, 0.0)
                return HandView::PRESS
        if (mode == 3 or mode == 4) and Gunslinger::drawn(run):
            return HandView::RELEASE if run.hand.down
            return Gunslinger::COCK if not run.cocked
            other: i64 = (run.duel.foe + 1) % run.duel.level.men
            target: Gunslinger::Target = Gunslinger::boxes(run, other if mode == 3 else run.duel.foe)
            box: Gunslinger::Box = target.body
            offset: RoomsView::Point = Gunslinger::sway(run)
            HandView::place(&run.hand, (box.left + box.right) / 2.0 - offset.x, (box.bottom + box.top) / 2.0 - offset.y)
            return HandView::PRESS
        return -1

def replay(duel: Gunslinger::Duel, mode: i64):
    can Memory.Allocate, Abort.Panic, Console.Write:
        run: mutable Gunslinger::Run = Gunslinger::initialize(duel)
        frame: mutable i64 = 0
        _ = printf("mode %lld\n", mode)
        while run.result == Gunslinger::PENDING |run, frame, mode|:
            port: i64 = scripted(&run, frame, mode)
            Gunslinger::act(&run, port)
            Gunslinger::tick(&run, 1.0 / 60.0)
            if frame % 43 == 0 or run.result != Gunslinger::PENDING:
                aim: RoomsView::Point = Gunslinger::aim(&run)
                _ = printf("state %lld %lld %lld %lld %lld %lld %lld %lld %.17g %.17g %.17g %.17g %.17g\n",
                    frame, port, run.result, 1 if run.cocked else 0, run.bullets, run.fell, run.hatless, run.reach_no,
                    run.time, aim.x, aim.y, run.fell_at, Gunslinger::dust(&run))
                for k in 0..<run.duel.level.men |run|:
                    p: RoomsView::Vec = Gunslinger::stands(&run, k)
                    b: Gunslinger::Target = Gunslinger::boxes(&run, k)
                    _ = printf("target %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g\n",
                        p.x, p.z, Gunslinger::arm(&run, k), run.hat_at[k.usize()],
                        b.hat.left, b.hat.bottom, b.hat.right, b.hat.top,
                        b.body.left, b.body.bottom, b.body.right, b.body.top)
            frame <- frame + 1
        _ = printf("verdict ")
        message: sview = Gunslinger::result_text(run.result)
        for i in 0..<sview_len(message).i64() |message|:
            _ = printf("%c", sview_at(message, i.usize()).i32())
        _ = printf("\n")
        for k in 0..<run.shot_count |run|:
            shot: Gunslinger::Shot = run.shots[k.usize()]
            _ = printf("shot %.17g %.17g %.17g\n", shot.time, shot.point.x, shot.point.y)
        for cue in run.notes:
            _ = printf("cue %lld %lld %.17g %.17g %.17g %.17g %.17g\n", cue.voice, cue.seed, cue.time,
                cue.duration, cue.pitch, cue.gain, cue.pan)

def emit(rung: i64, seed: i64):
    can Memory.Allocate, Abort.Panic, Console.Write:
        draw: mutable MT19937 = mt19937_new()
        mt_seed_int(&draw, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
        duel: Gunslinger::Duel = Gunslinger::deal(rung, &draw)
        _ = printf("case %lld %lld %lld\n", rung, seed, 1 if duel.valid else 0)
        return if not duel.valid
        duel_data(&duel)
        replay(duel, 0)
        if seed == 0:
            replay(duel, 1)
            replay(duel, 2)
        if duel.level.men > 1 and seed < 2:
            replay(duel, 3)
        if duel.hat:
            replay(duel, 4)

def release_trial(owner: mutable Arena&):
    can Memory.Release, Abort.Panic:
        arena_free(owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}

def has_text(frame: Display::DisplayList&, expected: sview, ink: u32) -> bool:
    can Abort.Panic:
        for cmd in frame.commands |frame, expected, ink|:
            if cmd.kind == Display::CMD_TEXT and cmd.color == ink:
                text: sview = bytes_view_range(frame.pool, cmd.ref.usize(), (cmd.len & 0xffffff.u32()).usize())
                return true if sview_eq(text, expected)
        return false

def session_check() -> bool:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        session: mutable GunslingerGame::Session = GunslingerGame::initialize(1, 3, true, 17)
        frame: mutable Display::DisplayList = Display::DisplayList()
        SceneGunslinger::render(&frame, &session, false)
        valid: mutable bool = has_text(&frame, "Press Space or click to start", 0x000000ff)
        valid <- (GunslingerGame::start(&session, 0.0) can Global{Read,Write}) and valid
        Display::display_reset(&frame)
        SceneGunslinger::render(&frame, &session, false)
        valid <- valid and frame.commands.count > 300.usize() and not has_text(&frame, "DRAW!", 0xff4628ff)
        now: mutable f64 = 0.0
        saw_draw: mutable bool = false
        while session.phase == GunslingerGame::PLAYING and now < 12.0 |session, now, valid, frame, saw_draw|:
            if not saw_draw and Gunslinger::drawn(&session.run):
                Display::display_reset(&frame)
                SceneGunslinger::render(&frame, &session, false)
                saw_draw <- has_text(&frame, "DRAW!", 0xff4628ff)
            port: i64 = Gunslinger::pilot(&session.run)
            if port >= 0:
                valid <- (GunslingerGame::agent_event(&session, now, port) can Global{Read,Write}) and valid
            now <- now + 1.0 / 60.0
            _ = GunslingerGame::agent_event(&session, now, -1) can Global{Read,Write}
        valid <- valid and saw_draw and session.phase == GunslingerGame::JUDGED and session.rung == 2 and session.best == 1
        valid <- valid and GunslingerGame::result_field(&session, 0, 1) == Gunslinger::QUICKER
        Display::display_reset(&frame)
        SceneGunslinger::render(&frame, &session, false)
        valid <- valid and has_text(&frame, "You were the quicker", 0x40ff40ff)
        _ = GunslingerGame::agent_event(&session, now, -1) can Global{Read,Write}
        valid <- valid and session.phase == GunslingerGame::PLAYING and session.trial == 2
        _ = GunslingerGame::pointer_event(&session, 456.0, 400.0, 1, now) can Global{Read,Write}
        now <- now + 1.0 / 60.0
        _ = GunslingerGame::advance(&session, now) can Global{Read,Write}
        valid <- valid and session.phase == GunslingerGame::JUDGED and session.rung == 1
        valid <- valid and GunslingerGame::result_field(&session, 1, 0) == 2
        valid <- valid and GunslingerGame::result_field(&session, 1, 1) == Gunslinger::FIRST
        Display::display_reset(&frame)
        SceneGunslinger::render(&frame, &session, true)
        valid <- valid and has_text(&frame, "You fired first", 0xff4040ff)
        GunslingerGame::close(&session) can Global{Read,Write}
        return valid and session.phase == GunslingerGame::READY

def main() -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic, Console.Write:
        return 1.i32() if not (session_check() can Global{Read,Write})
        rungs: i64[12] = [-1, 1, 4, 7, 10, 13, 16, 19, 20, 25, 30, 70]
        for rung in rungs:
            for seed in -1..<5 |rung|:
                owner: mutable Arena = zeroed
                in owner:
                    emit(rung, seed)
                release_trial(&owner) can Global{Read,Write}
        return 0.i32()
