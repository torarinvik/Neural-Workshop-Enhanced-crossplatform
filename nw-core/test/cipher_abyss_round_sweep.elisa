include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/cipher_abyss_machine.elisa"
include "../src/tasks/cipher_lang_parse.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def print_row(row: darray[i64]&):
    can Console.Write:
        _ = printf("%lld", row.count.i64())
        for value in row:
            _ = printf(" %lld", value)
        _ = printf("\n")

def sweep(rung: i64, seed: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region scratch(1048576):
            in scratch:
                level: CipherAbyss::Grade = CipherAbyss::grade(rung)
                program: mutable darray[CipherLang::Node] = []
                target: i64 = CipherLang::parse(&program, "seq(tshift(1),rot(1))" if rung == 13 else "seq(rot(1),shift(1))")
                a: i64 = CipherLang::parse(&program, "rev")
                b: i64 = CipherLang::parse(&program, "shift(1)")
                c: i64 = CipherLang::parse(&program, "if(same,rot(1),shift(2))")
                d: i64 = CipherLang::parse(&program, "alt(shift(1),shift(2))")
                survivors: darray[i64] = [target]
                earlier: darray[i64] = [a, b, c, d]
                rivals: darray[i64] = [c, d]
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                inverse: darray[CipherLang::Probe] = CipherLang::invert_tests(&program, target, &survivors, &earlier, level, &draw)
                _ = printf("inverse %lld %lld %lld %llu\n", rung, seed, inverse.count.i64(), py_getrandbits(&draw, 32))
                for row in inverse:
                    print_row(&row.values)
                mt_seed_int(&draw, seed.u64())
                crack: CipherLang::QuestionSet = CipherLang::crack_questions(&program, target, &survivors, &earlier, &rivals, level, &draw)
                _ = printf("crack %lld %lld %lld %lld %llu\n", rung, seed, crack.rejected, crack.rows.count.i64(), py_getrandbits(&draw, 32))
                for row in crack.rows:
                    print_row(&row.values)

def print_rule(program: darray[CipherLang::Node]&, entry: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region scratch(4096):
            in scratch:
                code: mutable dstr = []
                CipherLang::write_code(&code, program, entry)
                for byte in code:
                    _ = printf("%c", byte.i32())
                _ = printf("\n")

def builds(rung: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read:
        region scratch(1048576):
            in scratch:
                level: CipherAbyss::Grade = CipherAbyss::grade(rung)
                book: mutable CipherLang::Workshop = CipherLang::workshop(level)
                target: i64 = book.rules.truths[(book.rules.truths.count / 2.usize())]
                near: darray[i64] = CipherLang::twins(&book.program, &book.rules.hypotheses, target, level)
                _ = printf("twins %lld %lld\n", rung, near.count.i64())
                for entry in near:
                    print_rule(&book.program, entry)
                for seed in 0..<12 |rung, level, book, target, near|:
                    draw: mutable MT19937 = zeroed
                    mt_seed_int(&draw, seed.u64())
                    alternate: CipherLang::Twin = CipherLang::twin_for(&book.program, target, &near, level, &draw)
                    _ = printf("twin %lld %lld %lld %lld %llu\n", rung, seed, 1 if alternate.entry >= 0 else 0,
                        1 if alternate.same else 0, py_getrandbits(&draw, 32))
                    if alternate.entry >= 0:
                        print_rule(&book.program, alternate.entry)
                    mt_seed_int(&draw, seed.u64())
                    machine: CipherLang::Machine = CipherLang::build(&book, &draw)
                    _ = printf("build %lld %lld %lld %lld %lld %lld %lld %llu\n", rung, seed, machine.rejected,
                        machine.kind, machine.seed, machine.tests.count.i64(), machine.plan.count.i64(), py_getrandbits(&draw, 32))
                    if machine.rejected == 0:
                        print_rule(&book.program, machine.rule)
                        if machine.kind == CipherLang::TWINS:
                            print_rule(&book.program, machine.other)
                        for row in machine.tests:
                            print_row(&row.values)
                        for row in machine.plan:
                            print_row(&row.values)
                        _ = printf("wins %lld\n", 1 if CipherLang::reference_wins(&book, &machine) else 0)

def deals(rung: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        level: CipherAbyss::Grade = CipherAbyss::grade(rung)
        owner: mutable Arena = zeroed
        book: mutable CipherLang::Workshop = zeroed
        in owner:
            book <- CipherLang::workshop(level)
        draw: mutable MT19937 = zeroed
        mt_seed_int(&draw, 17.u64())
        for iteration in 0..<2 |book, draw, rung, owner|:
            machine: CipherLang::Machine = CipherLang::deal(&book, &draw, &owner) can Global{Read,Write}
            _ = printf("deal %lld %lld %lld %lld %lld %lld %lld\n", rung, iteration, machine.rejected, machine.kind,
                machine.seed, machine.tests.count.i64(), machine.plan.count.i64())
            if machine.rejected == 0:
                print_rule(&book.program, machine.rule)
                if machine.kind == CipherLang::TWINS:
                    print_rule(&book.program, machine.other)
                for row in machine.tests:
                    print_row(&row.values)
                for row in machine.plan:
                    print_row(&row.values)
        _ = printf("end %llu\n", py_getrandbits(&draw, 32))
        arena_free(&owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in [1, 4, 13, 19, 21, 25, 28, 30, 40]:
            for seed in 0..<4 |rung|:
                sweep(rung, seed)
        for rung in [1, 4, 10, 13, 19, 20, 25, 30, 40]:
            builds(rung) can Global.Read
        for rung in [1, 10, 19, 30]:
            deals(rung) can Global{Read,Write}
        return 0.i32()
