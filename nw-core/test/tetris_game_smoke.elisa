include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/textmetrics.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_tetris.elisa"
include "../src/tasks/tetris.elisa"
include "../src/tasks/tetris_game.elisa"

def main():
    can Memory.Allocate, Abort.Panic:
        first: mutable TetrisGame::TetrisRun = zeroed
        second: mutable TetrisGame::TetrisRun = zeroed
        TetrisGame::initialize(&first, 1, 3, 5, 12345)
        TetrisGame::initialize(&second, 1, 3, 5, 12345)
        assert TetrisGame::info(&first, TetrisGame::INFO_PHASE) == TetrisGame::PHASE_READY
        assert TetrisGame::apply(&first, TetrisGame::ACTION_SPACE) == 1
        assert TetrisGame::apply(&second, TetrisGame::ACTION_SPACE) == 1
        assert TetrisGame::info(&first, TetrisGame::INFO_PHASE) == TetrisGame::PHASE_PLAYING
        assert TetrisGame::info(&first, TetrisGame::INFO_REMAINDER) == 3
        # The original Queue uses carve(attempts=32, shortlist=8).  Pin the
        # first seeded hand so the controller cannot silently drift to a
        # different RNG/hand policy while its public state still looks valid.
        expected_counts: i64[5] = [4, 4, 4, 4, 3]
        expected_fits: i64[5] = [71, 71, 141, 141, 142]
        for slot in 0..<5 |slot, first, expected_counts, expected_fits|:
            assert first.queue_count[slot.usize()] == expected_counts[slot.usize()]
            assert first.queue_fits[slot.usize()] == expected_fits[slot.usize()]
        assert TetrisGame::info(&first, TetrisGame::INFO_PIECE) == TetrisGame::info(&second, TetrisGame::INFO_PIECE)
        assert TetrisGame::apply(&first, TetrisGame::ACTION_SELECT_BASE + 1) == 1
        assert TetrisGame::info(&first, TetrisGame::INFO_SELECTED) == 1
        assert TetrisGame::apply(&first, TetrisGame::ACTION_ROTATE) == 1
        assert TetrisGame::apply(&first, TetrisGame::ACTION_LEFT) == 1
        assert TetrisGame::apply(&first, TetrisGame::ACTION_DROP) == 1
        assert TetrisGame::info(&first, TetrisGame::INFO_PIECE) == 1
        assert TetrisGame::info(&first, TetrisGame::INFO_REMAINDER) == 2
        assert TetrisGame::apply(&first, TetrisGame::ACTION_RESTART) == 1
        assert TetrisGame::info(&first, TetrisGame::INFO_PHASE) == TetrisGame::PHASE_PLAYING
        frame: mutable Display::DisplayList = Display::DisplayList()
        TetrisGame::render(&first, false, 912.0, 684.0, 1.0, 1.0, &frame)
        assert frame.commands.count.i64() > 0
        print("PASS: source-backed Tetris controller lifecycle, deterministic deal, rotation, drop, and restart")
