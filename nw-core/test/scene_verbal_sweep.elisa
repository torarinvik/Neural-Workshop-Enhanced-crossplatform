# Differential sweep driver for src/scene_verbal.elisa.
# See scene_verbal_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/textmetrics.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_verbal.elisa"
include "scene_emit.elisa"

# Mirrored, in order, by PROMPTS in scene_verbal_diff.py. The question's font
# size steps at 600 and at 1000 characters, so the set has one on each side of
# both steps -- and a short one, because a question that does not wrap is the
# case where a broken measurer still looks right.
const PROMPT_COUNT: i64 = 4

def prompt_of(which: i64) -> cstr:
    if which == 0:
        return "Which word completes the pair?"
    elif which == 1:
        return "A study of commuters found that those who cycled reported better sleep than those who drove. The researchers concluded that cycling improves sleep. Which of the following, if true, most weakens the conclusion?"
    elif which == 2:
        return "The council has proposed to close the north bridge for eight weeks of resurfacing. Local traders say the closure will cost them a quarter of their custom, and have asked instead for overnight works spread across a year. The council replies that overnight works cost twice as much and that the noise would fall on the residents of the streets nearest the bridge, who are already the least well served by the current arrangement. A survey of those residents found a majority preferred the shorter closure, though a majority of traders preferred the longer one, and the two groups overlap by about a third. The transport committee must weigh a cost borne once against a cost borne nightly, and it must do so without knowing how many of the trade losses would simply be deferred rather than lost. Which of the following would be most useful to establish before deciding?"
    return "The argument above proceeds by establishing a general principle and then applying it to a particular case, but the application depends on an unstated assumption about the comparability of the two situations. Consider the following at length. The council has proposed to close the north bridge for eight weeks of resurfacing. Local traders say the closure will cost them a quarter of their custom, and have asked instead for overnight works spread across a year. The council replies that overnight works cost twice as much and that the noise would fall on the residents of the streets nearest the bridge, who are already the least well served by the current arrangement. A survey of those residents found a majority preferred the shorter closure, though a majority of traders preferred the longer one, and the two groups overlap by about a third. The transport committee must weigh a cost borne once against a cost borne nightly, and it must do so without knowing how many of the trade losses would simply be deferred rather than lost. Which of the following would be most useful to establish before deciding, given all of that?"

const CHOICE_COUNT: i64 = 4

def choice_of(which: i64) -> cstr:
    if which == 0:
        return "The cyclists were younger on average than the drivers."
    elif which == 1:
        return "Cycling is cheaper than driving over a year of commuting."
    elif which == 2:
        return "People who sleep badly are less likely to take up cycling in the first place, which would reverse the direction of the effect entirely."
    return "Neither group was asked about caffeine."

# Two explanations: one comfortably under the 600-character slice, and one
# over it so the cut and its ellipsis are exercised. Both are padded with the
# whitespace `str.strip()` takes off, because the strip happens BEFORE the
# slice and a port that strips afterwards cuts in a different place.
const EXPLANATION_COUNT: i64 = 2

def explanation_of(which: i64) -> cstr:
    if which == 0:
        return "  \n The conclusion treats a correlation as a cause. An option that supplies a plausible reverse direction -- bad sleepers avoid cycling -- undercuts it without denying the correlation at all. \t "
    return " \n\n The conclusion treats a correlation as a cause, and the question asks only which option most weakens it. An option that supplies a plausible reverse direction -- that people who already sleep badly are the ones least likely to take up cycling -- undercuts the causal reading without denying the correlation at all, which is exactly what weakening an argument of this shape means. The remaining options are true, or plausibly true, but bear on cost, on comfort, or on the composition of the sample in ways that leave the inference from correlation to cause standing. Note also that the sample was self-selected, that the reported sleep was self-reported rather than measured, and that neither of those is what the question is asking about. \r\n  "

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|has_question|prompt|choices|choice|answered|trial|total_trials|tall|verdict|show_explanation|note")
            for spec in 0..<40:
                phase: i64 = spec % 5
                black: bool = spec % 7 == 1
                has_question: bool = spec % 11 != 10
                which: i64 = spec % PROMPT_COUNT
                shown: i64 = 2 + spec % 3
                choice: i64 = spec % shown
                answered: i64 = (spec + 1) % shown
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                show_explanation: bool = spec % 13 != 12
                note: i64 = spec % EXPLANATION_COUNT
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if has_question else 0)
                emit_bar(which)
                emit_bar(shown)
                emit_bar(choice)
                emit_bar(answered)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                emit_bar(1 if show_explanation else 0)
                emit_bar(note)
                print("")
                choices: mutable darray[sview] = []
                for one in 0..<shown |choices|:
                    choices.push(sview(choice_of(one), 0, -1))
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneVerbal::Paint = SceneVerbal::paint_of(black, width, height, 2.0, 2.0)
                SceneVerbal::render(&list, &paint, phase, has_question,
                                    sview(prompt_of(which), 0, -1), &choices,
                                    choice, answered, 1 + spec % 5, 5,
                                    sview("Sentence Completion", 0, -1),
                                    show_explanation,
                                    sview(explanation_of(note), 0, -1), verdict,
                                    sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
