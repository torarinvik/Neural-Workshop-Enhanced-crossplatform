include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_crossings.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def line(stroke: Crossings::Line&):
    can Abort.Panic, Console.Write:
        for i in 0..<stroke.count |stroke|:
            p: Crossings::Point = stroke.points[i.usize()]
            _ = printf("%.17g %.17g ", p.x, p.y)
        _ = printf("\n")

def emit(rung: i64, seed: i64):
    can Abort.Panic, Console.Write:
        puzzle: Crossings::Puzzle = Crossings::deal(rung, seed)
        _ = printf("%lld %lld %lld %lld %lld %lld\n", rung, seed, puzzle.answer, puzzle.level.bends, puzzle.level.most, puzzle.level.decoys)
        return if puzzle.answer < 0
        line(&puzzle.red)
        line(&puzzle.blue)
        for i in 0..<puzzle.level.decoys |puzzle|:
            line(&puzzle.decoys[i.usize()])
        for i in 0..<puzzle.hits.count |puzzle|:
            hit: Crossings::Point = puzzle.hits.points[i.usize()]
            _ = printf("%.17g %.17g ", hit.x, hit.y)
        _ = printf("\n")

def main() -> i32:
    can Abort.Panic, Console.Write, Memory.Allocate:
        for rung in -1..<8:
            for seed in -3..<4 |rung|:
                emit(rung, seed)
        emit(10, 1)
        emit(13, 1)
        emit(16, 2)
        emit(20, 2)
        emit(9, -9223372036854775807 - 1)
        emit(1, 9223372036854775807)
        run: mutable CrossingsGame::Run = CrossingsGame::initialize(10, 3, true, 17)
        return 1.i32() if not CrossingsGame::configure_think(&run, 0.2, 0.05)
        return 2.i32() if not CrossingsGame::steer(&run, CrossingsGame::START, 0)
        return 3.i32() if CrossingsGame::choices(&run.puzzle) != 5 or run.puzzle.level.decoys != 1
        button: SceneHiddenRule::Rect = SceneCrossings::button(run.puzzle.answer, 5)
        port: i64 = SceneCrossings::hit(&run, button.x + button.w / 2.0, button.y + button.h / 2.0)
        return 4.i32() if port != run.puzzle.answer or not CrossingsGame::steer(&run, port, 10)
        return 5.i32() if run.rung != 11 or run.best_rung != 10 or not run.passed
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneCrossings::render(&list, &run, false)
        return 6.i32() if Display::encode_binary(&list).count < 1000.usize()
        return 7.i32() if not CrossingsGame::step(&run, 0.1) or run.phase != CrossingsGame::JUDGED
        return 8.i32() if not CrossingsGame::step(&run, 0.1) or run.trial != 2
        return 9.i32() if not CrossingsGame::step(&run, 0.2) or run.phase != CrossingsGame::FLAGGED
        return 10.i32() if not CrossingsGame::step(&run, 0.1) or run.think_left != 0.05
        return 0.i32()
