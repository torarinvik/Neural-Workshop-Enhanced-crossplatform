# Differential sweep driver for src/scene_go.elisa.
# See scene_go_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/pyset.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/tasks/go.elisa"
include "../src/scene_go.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(512 * 1024 * 1024)
        in w:
            width: f64 = 1824.0
            height: f64 = 1368.0
            print("names|spec|difficulty|seed|phase|black|has_problem|trial|total_trials|cursor_x|cursor_y")
            for spec in 0..<20 |width, height|:
                difficulty: i64 = 1 + spec % 10
                seed: i64 = 5500 + spec * 17
                phase: i64 = 1 if spec % 4 != 3 else 2
                black: bool = spec % 5 == 2
                has_problem: bool = spec % 9 != 8
                problem: mutable Go::GoProblem = Go::generate_problem(seed, difficulty)
                cursor_x: i64 = spec % problem.size
                cursor_y: i64 = (spec * 3) % problem.size
                printr("spec|")
                print_i64(spec)
                emit_bar(difficulty)
                emit_bar(seed)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if has_problem else 0)
                emit_bar(1 + spec % 6)
                emit_bar(6)
                emit_bar(cursor_x)
                emit_bar(cursor_y)
                print("")
                message: mutable dstr = []
                dstr_append_cstr(&message, "Press Space to start")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneGo::GoPaint = SceneGo::paint_of(black, width, height, 2.0, 2.0)
                SceneGo::render(&list, &paint, &problem.board, &problem.target,
                                problem.size, problem.winning, problem.show_target,
                                problem.show_move, has_problem, phase,
                                difficulty, 1 + spec % 6, 6, cursor_x, cursor_y,
                                bytes_view(message))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
