include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_crossroads.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        session: mutable CrossroadsGame::Session = CrossroadsGame::initialize(rung, 1, false, 17)
        if mode != 0:
            _ = CrossroadsGame::input(&session, CrossroadsGame::START, 0) can Global{Read,Write}
        if mode >= 2:
            _ = CrossroadsGame::input(&session, 0, 0) can Global{Read,Write}
        now: mutable i64 = 0
        if mode >= 2:
            stop: i64 = 700 if mode == 2 else (2000 if mode == 3 else 120000)
            while session.phase == CrossroadsGame::PLAYING and now < stop |session, now, stop|:
                next: i64 = now + 100
                _ = CrossroadsGame::advance(&session, next, next.f64() / 1000.0 - now.f64() / 1000.0) can Global{Read,Write}
                now <- next
        if mode == 5:
            _ = CrossroadsGame::advance(&session, session.deadline_ms, 0.0) can Global{Read,Write}
        _ = printf("frame %lld %lld %lld\n", rung, mode, 1 if dark else 0)
        area: SceneCrossroads::Frame = SceneCrossroads::frame()
        if session.phase == CrossroadsGame::PLAYING or session.phase == CrossroadsGame::JUDGED:
            for j in 0..<session.traffic.town.level.layout |area, session|:
                point: Crossroads::Junction = session.traffic.town.junctions[j.usize()]
                x: f64 = area.x + point.x * area.size
                y: f64 = area.y + point.y * area.size
                _ = printf("hit %lld %.9g %.9g\n", SceneCrossroads::hit(&session, x, y), x, y)
        _ = printf("hit %lld 0 0\n", SceneCrossroads::hit(&session, 0.0, 0.0))
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneCrossroads::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")
        CrossroadsGame::close(&session) can Global{Read,Write}

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneCrossroads::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 7, 16]:
            for mode in 0..<6 |rung|:
                for dark in 0..<2 |rung, mode|:
                    region scratch(2097152):
                        in scratch:
                            emit(rung, mode, dark != 0) can Global{Read,Write}
        return 0.i32()
