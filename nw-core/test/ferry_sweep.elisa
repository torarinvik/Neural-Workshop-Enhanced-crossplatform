include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/ferry_reference.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def emit(river: Ferry::River&):
    can Abort.Panic, Console.Write:
        g: Ferry::Grade = river.level
        _ = dprintf(1.i32(), "river %lld %.17g %lld %lld %.17g %.17g %lld %.17g %lld\n",
            g.rung, g.current, g.crossings, g.lanes, g.barge_speed, g.gusts, 1 if g.fog else 0, g.seconds, river.gust_seed)
        for k in 0..<(g.crossings + 1) |river|:
            p: Ferry::Point = river.piers[k.usize()]
            _ = dprintf(1.i32(), "pier %.17g %.17g\n", p.x, p.y)
        for k in 0..<g.lanes |river|:
            b: Ferry::Barge = river.barges[k.usize()]
            _ = dprintf(1.i32(), "lane %.17g %.17g %.17g %.17g\n", b.lane_y, b.speed, b.start, b.gap)

def emit_tick(run: Ferry::Run&, port: i64):
    can Abort.Panic, Console.Write:
        v: Ferry::Point = Ferry::velocity(run)
        _ = dprintf(1.i32(), "tick %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %lld %.17g %lld %lld %lld",
            port, run.t, run.x, run.y, run.heading, run.speed, v.x, v.y, Ferry::gust(run, run.t),
            run.leg, run.docked_since, run.thrusting, run.result, run.wake_count)
        if run.wake_count > 0:
            oldest: Ferry::Wake = run.wake[((run.wake_next + Ferry::WAKE_LENGTH - run.wake_count) % Ferry::WAKE_LENGTH).usize()]
            newest: Ferry::Wake = run.wake[((run.wake_next + Ferry::WAKE_LENGTH - 1) % Ferry::WAKE_LENGTH).usize()]
            _ = dprintf(1.i32(), " %.17g %.17g %.17g %.17g %.17g %.17g",
                oldest.at.x, oldest.at.y, oldest.time, newest.at.x, newest.at.y, newest.time)
        for k in 0..<run.river.level.lanes |run|:
            b: Ferry::Barge = run.river.barges[k.usize()]
            _ = dprintf(1.i32(), " %.17g %.17g", Ferry::barge_x(b, 0, run.t), Ferry::barge_x(b, 1, run.t))
        _ = dprintf(1.i32(), "\n")

def sample(rung: i64, seed: i64, mode: i64):
    can Abort.Panic, Console.Write:
        _ = dprintf(1.i32(), "case %lld %lld %lld\n", rung, seed, mode)
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, seed.u64())
        if mode == 0:
            for _ in 0..<3 |rung, rng|:
                river: Ferry::River = Ferry::build(Ferry::grade(rung), &rng)
                emit(&river)
        else:
            river: Ferry::River = FerryReference::deal_seed(rung, seed) if mode == 2 else Ferry::build(Ferry::grade(rung), &rng)
            emit(&river)
            run: mutable Ferry::Run = Ferry::start(river)
            if mode == 4:
                run.x <- Ferry::WIDTH - 1.01
                run.heading <- 0.0
            pilot: mutable FerryReference::Pilot = FerryReference::Pilot{committed_lane: Ferry::NEUTRAL, committed_direction: 0.0}
            tick: mutable i64 = 0
            while run.result == Ferry::LIVE and (mode != 3 or tick < 1200) |mode, run, pilot, tick|:
                port: i64 = (tick / 59) % 7 - 1 if mode == 3 else Ferry::AHEAD if mode == 4 else FerryReference::choose(&pilot, &run)
                Ferry::step(&run, 1.0 / 30.0, port)
                emit_tick(&run, port)
                tick <- tick + 1
        _ = dprintf(1.i32(), "end\n")

def main() -> i64:
    can Abort.Panic, Console.Write:
        for rung in [0, 1, 4, 7, 10, 13, 16, 20, 25, 30, 60]:
            for seed in [0, 17, 42] |rung|:
                sample(rung, seed, 0)
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            sample(rung, 17, 1)
            sample(rung, 42, 3)
        sample(1, 17, 2)
        sample(20, 42, 2)
        sample(1, 17, 4)
        return 0
