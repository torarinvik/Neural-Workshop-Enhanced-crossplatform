include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_mirror.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(figure: Mirror::Figure&, lit: bool):
    can Console.Write, Abort.Panic:
        for i in 0..<figure.shape.count |figure|:
            c: Mirror::Cube = figure.shape.cubes[i.usize()]
            _ = printf("%lld %lld %lld\n", c.x, c.y, c.z)
        t: Mirror::Matrix = figure.turn
        _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g\n",
            t.x.x, t.x.y, t.x.z, t.y.x, t.y.y, t.y.z, t.z.x, t.z.y, t.z.z)

        painted: RoomsView::Picture = MirrorView::scene(figure, lit)
        _ = printf("%lld %.17g\n", painted.count, MirrorView::radius(&figure.shape))
        for i in 0..<painted.count |painted|:
            poly: RoomsView::Polygon& = &painted.polygons[i.usize()]
            _ = printf("%llu %.17g", poly.colour.u64(), poly.depth)
            for j in 0..<poly.count |poly|:
                v: RoomsView::Point = poly.points[j.usize()]
                _ = printf(" %.17g %.17g", v.x, v.y)
            _ = printf("\n")

def replay(rung: i64, seed: i64) -> bool:
    can Memory.Allocate, Console.Write, Abort.Panic:
        puzzle: Mirror::Puzzle = Mirror::deal(rung, seed)
        return false if puzzle.count == 0
        _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld\n", rung, seed, puzzle.level.rung,
            puzzle.level.cubes, puzzle.level.options, puzzle.level.nudged, 1 if puzzle.level.lit else 0,
            puzzle.count, puzzle.answer)
        emit(&puzzle.reference, puzzle.level.lit)
        for i in 0..<puzzle.count |puzzle|:
            _ = printf("%.17g\n", puzzle.angles[i.usize()])
            emit(&puzzle.others[i.usize()], puzzle.level.lit)
        return true

def main() -> i32:
    can Memory.Allocate, Console.Write, Abort.Panic:
        for rung in -1..<34:
            for seed in -8..<8 |rung|:
                return 1.i32() if not replay(rung, seed)
        return 2.i32() if not replay(26, -9223372036854775807 - 1)
        return 3.i32() if not replay(26, 9223372036854775807)
        run: mutable MirrorGame::Run = MirrorGame::initialize(12, 3, true, 17)
        return 4.i32() if not MirrorGame::configure_think(&run, 0.2, 0.05)
        return 5.i32() if SceneMirror::hit(&run, 456.0, 400.0) != MirrorGame::START
        return 5.i32() if not MirrorGame::steer(&run, MirrorGame::START, 0)
        _ = printf("start %lld %lld\n", run.puzzle.seed, run.rung)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneMirror::render(&list, &run, false)
        return 16.i32() if Display::encode_binary(&list).count < 1000.usize()
        panel: SceneMirror::Cards = SceneMirror::cards(2, true)
        return 17.i32() if SceneMirror::hit(&run, panel.left + 4.0, SceneMirror::BOTTOM + 4.0) != 0
        return 6.i32() if MirrorGame::steer(&run, 4, 0)
        return 7.i32() if not MirrorGame::steer(&run, run.puzzle.answer, 0)
        return 8.i32() if not MirrorGame::step(&run, 0.1) or run.phase != MirrorGame::JUDGED
        return 9.i32() if not MirrorGame::step(&run, 0.1) or run.phase != MirrorGame::PLAYING
        _ = printf("next %lld %lld\n", run.puzzle.seed, run.rung)
        return 10.i32() if not MirrorGame::step(&run, 0.2) or run.phase != MirrorGame::FLAGGED
        return 11.i32() if not MirrorGame::step(&run, 0.1) or run.think_left != 0.05 or run.forfeits != 1
        _ = printf("refill %lld %lld\n", run.puzzle.seed, run.rung)
        wrong: i64 = (run.puzzle.answer + 1) % 3
        return 12.i32() if not MirrorGame::steer(&run, wrong, 100)
        return 13.i32() if run.passed or run.rung != 12 or run.passed_count != 1
        return 14.i32() if MirrorGame::advance(&run, 2599) or not MirrorGame::advance(&run, 2600)
        return 15.i32() if run.phase != MirrorGame::DONE or not run.has_verdict or run.scored_count != 2
        return 0.i32()
