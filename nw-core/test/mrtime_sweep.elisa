# Differential sweep driver for tasks/mrtime.elisa. See mrtime_diff.py for the
# reference side.
#
# Four streams:
#
#   * the ladder and its bands, which is the whole of the difficulty;
#   * the canvas, which folds the verdict band's ceiling into its floor and so
#     goes through geometry.elisa's int() truncation twice;
#   * the answer field, typed with every guard it has -- a leading zero that
#     gets replaced, a second point refused, a full field refused, and the two
#     spellings (`.` and `0.`) that hold no number;
#   * whole runs on a stepped clock, recall and produce and the shuffle of the
#     two, with a produce trial deliberately left to run past LATE_GRACE.
#
# The typed answer is parsed exactly on both sides, so the seconds a field
# holds are compared as scaled integers like every other float here.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/pymath.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/strings.elisa"
include "../src/tasks/mrtime.elisa"

# printr(i64) and int_to_string_scratch both trip a stage1 backend decline of
# store_* generics (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

def emit_scaled(value: f64):
    can Console.Write, Abort.Panic:
        emit_cell(py_round_half_even(value * 1000000.0))

def emit_text(text: dstr):
    can Console.Write, Abort.Panic:
        for index in 0..<text.count.i64() |text|:
            pair: mutable u8[2] = zeroed
            pair[0] <- text[index.usize()]
            trusted Unsafe.PointerCast:
                printr((&pair[0]).cast[cstr])

def window_width(which: i64) -> f64:
    can Abort.Panic:
        return 912.0 if which == 0
        return 640.0 if which == 1
        return 1366.0 if which == 2
        return 1101.0

def window_height(which: i64) -> f64:
    can Abort.Panic:
        return 684.0 if which == 0
        return 480.0 if which == 1
        return 768.0 if which == 2
        return 617.0

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(64 * 1024 * 1024)
        in w:
            # --- the ladder ----------------------------------------------
            for number in -2..<10:
                printr("rung")
                emit_cell(number)
                emit_cell(MrTime::rung_at(number))
                emit_scaled(MrTime::rung_per_second(MrTime::rung_at(number)))
                emit_scaled(MrTime::rung_share(MrTime::rung_at(number)))
                for step in 0..<13 |number, step|:
                    interval: f64 = -1.5 + step.f64() * 0.75
                    emit_scaled(MrTime::tolerance(interval, number))
                print("")

            # --- the canvas the shape is placed in ------------------------
            for size in 0..<4:
                width: f64 = window_width(size)
                height: f64 = window_height(size)
                view: MrTime::Canvas = MrTime::canvas(width, height)
                printr("canvas")
                emit_cell(size)
                emit_cell(Verdict::band_first_row(height))
                emit_cell(Verdict::above_the_band(height, 0.0))
                emit_scaled(view.left)
                emit_scaled(view.bottom)
                emit_scaled(view.width)
                emit_scaled(view.height)
                print("")

            # --- target labels -------------------------------------------
            for rung in -2..<10:
                for step in 0..<7 |rung, step|:
                    seconds: f64 = -2.5 + step.f64() * 2.5
                    text: mutable dstr = []
                    MrTime::quantity(&text, seconds, rung)
                    printr("quantity|")
                    emit_text(text)
                    print("")

            # --- the answer field, with every guard it has ----------------
            for recipe in 0..<24:
                run: mutable MrTime::Run = MrTime::new_run()
                MrTime::reset(&run)
                run.phase <- MrTime::PHASE_ASKING
                run.answer_count <- 0
                printr("field")
                emit_cell(recipe)
                for press in 0..<18 |run, recipe, press|:
                    # A press schedule that hits every branch: points early and
                    # late, leading zeros, a backspace, and enough digits to
                    # fill the twelve-character field.
                    what: i64 = (recipe * 5 + press * 7) % 13
                    if what == 11:
                        MrTime::type_point(&run)
                    else:
                        if what == 12:
                            MrTime::backspace(&run)
                        else:
                            MrTime::type_digit(&run, what % 10)
                    emit_cell(run.answer_count)
                    for at in 0..<run.answer_count |run|:
                        emit_cell(Ints::at_ref(&run.answer, at))
                given: MrTime::Answer = MrTime::answer_seconds(&run)
                emit_cell(1 if given.given else 0)
                emit_scaled(given.seconds)
                print("")

            # --- whole runs, on a stepped clock --------------------------
            # A fresh Run per config: `ask_at` and `deadline` are set by only
            # one of the two halves, so a reused run would carry the other
            # half's stamp into a trial that never sets it. The reference
            # makes a new task object per run.
            for cfg in 0..<9:
                run: mutable MrTime::Run = MrTime::new_run()
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, (400 + cfg).u64())
                run.mode <- cfg % 3
                run.start_rung <- 1 + (cfg % 6)
                run.total_trials <- 5
                run.max_gap_ms <- 1200 + cfg * 400
                run.flash_ms <- 150 + cfg * 30
                run.adaptive <- (cfg % 2) == 0
                MrTime::start_run(&run, 0.0, &rng)
                printr("start")
                emit_cell(cfg)
                emit_cell(run.phase)
                emit_cell(run.trial)
                emit_cell(run.trial_mode)
                emit_cell(run.rung)
                emit_cell(run.mark.kind)
                emit_scaled(run.mark.x)
                emit_scaled(run.mark.y)
                emit_scaled(run.mark.radius)
                emit_scaled(run.mark.turn)
                emit_scaled(run.target)
                emit_scaled(run.ask_at)
                emit_scaled(run.deadline)
                print("")

                dt: f64 = 1.0 / 60.0
                now: mutable f64 = 0.0
                tick: mutable i64 = 0
                while run.phase != MrTime::PHASE_DONE and tick < 6000 |run, cfg, now, tick, dt, rng|:
                    now <- now + dt
                    MrTime::update(&run, now, &rng)
                    if run.phase == MrTime::PHASE_ASKING:
                        # Type an answer a digit a tick, then submit. The digits
                        # come from the tick so a run answers differently every
                        # trial: some inside the band, some far outside it.
                        if run.answer_count < 3:
                            if run.answer_count == 1:
                                MrTime::type_point(&run)
                            else:
                                MrTime::type_digit(&run, (tick / 7) % 10)
                        else:
                            MrTime::submit(&run, now)
                    if run.phase == MrTime::PHASE_COUNTING:
                        # Every third trial is left to run past LATE_GRACE.
                        if run.trial % 3 != 0 and now - run.appeared_at >= run.target * 0.94:
                            MrTime::act_now(&run, now)
                    if (tick % 5) == 0:
                        printr("tick")
                        emit_cell(cfg)
                        emit_cell(tick)
                        emit_cell(run.phase)
                        emit_cell(run.trial)
                        emit_cell(run.trial_mode)
                        emit_cell(run.rung)
                        emit_cell(run.correct)
                        emit_cell(run.verdict)
                        emit_cell(run.answer_count)
                        emit_scaled(run.interval)
                        emit_scaled(run.target)
                        emit_cell(1 if MrTime::mark_showing(&run) else 0)
                        emit_cell(1 if MrTime::mark_at(&run, 480.0, 400.0, 912.0, 684.0) else 0)
                        print("")
                    tick <- tick + 1

                tally: MrTime::Score = MrTime::score(&run)
                printr("score")
                emit_cell(cfg)
                emit_cell(tick)
                emit_cell(tally.trials)
                emit_cell(tally.correct)
                emit_cell(tally.accuracy)
                emit_scaled(tally.weber)
                emit_scaled(tally.mean_error_ms)
                emit_cell(tally.best_rung)
                for at in 0..<run.result_count |run|:
                    emit_cell(Ints::at_ref(&run.result_mode, at))
                    emit_scaled(Floats::at_ref(&run.result_interval, at))
                    emit_cell(Ints::at_ref(&run.result_has_answer, at))
                    emit_scaled(Floats::at_ref(&run.result_answered, at))
                    emit_scaled(Floats::at_ref(&run.result_band, at))
                    emit_cell(Ints::at_ref(&run.result_rung, at))
                print("")
        destroy w
        return 0
