# Differential sweep driver for src/scene_tetris.elisa.
# See scene_tetris_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pymath.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/textmetrics.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_tetris.elisa"
include "scene_emit.elisa"

const SLOTS: i64 = 6

# A status line long enough to need shrinking on a narrow window, and short
# enough not to on a wide one.
const STATUS: cstr = "rung 3 · loose ends   piece 7/40   no gap 5/6   buried 2   rows 1"
const READOUT: cstr = "37° free   this drop buries 2   every piece still fits (fewest 4 ways)"

# How many gapless drops each piece has, and whether it had to be cut again.
def fits_of(which: i64) -> i64:
    if which == 0:
        return 4
    elif which == 1:
        return 11
    elif which == 2:
        return 2
    elif which == 3:
        return 9
    elif which == 4:
        return 6
    return 1

def recut_of(which: i64) -> bool:
    return which == 1 or which == 4

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|phase|black|cols|rows|cells|piece_size|ghost|flying|angle|armed|clean|status|readout|tall|verdict")
        region w(256 * 1024 * 1024)
        in w:
            for spec in 0..<32:
                phase: i64 = spec % 4
                black: bool = spec % 7 == 1
                cols: i64 = 16 + (spec / 4) % 4 * 16
                rows: i64 = 12 + (spec / 4) % 3 * 8
                filled: i64 = (spec / 4) % 9 * 4
                # Pieces of two to six cells, so the tray's fit-to-slot
                # arithmetic is exercised at every size.
                piece_size: i64 = 2 + (spec / 4) % 5
                ghost: i64 = (spec / 4) % 6
                flying: i64 = (spec / 4) % 7
                # Not a multiple of ninety, so the turn is a real rotation
                # rather than one that happens to line up.
                angle: i64 = (spec * 37) % 360
                armed: i64 = spec % SLOTS
                clean: bool = spec % 3 != 2
                say_status: bool = spec % 5 != 4
                say_readout: bool = spec % 4 != 3
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(cols)
                emit_bar(rows)
                emit_bar(filled)
                emit_bar(piece_size)
                emit_bar(ghost)
                emit_bar(flying)
                emit_bar(angle)
                emit_bar(armed)
                emit_bar(1 if clean else 0)
                emit_bar(1 if say_status else 0)
                emit_bar(1 if say_readout else 0)
                emit_bar(tall)
                emit_bar(verdict)
                print("")

                board: mutable darray[i64] = Ints::zeros(cols * rows)
                for index in 0..<filled |board, cols, rows|:
                    Ints::put(&board, (index * 3) % rows * cols + (index * 5) % cols,
                              1 + index % 7)
                # An L of `piece_size + slot` cells a slot: normalised, and
                # already in `sorted()` order, which is what the reference
                # draws them in.
                queue_cells: mutable darray[SceneTetris::Cell] = []
                queue_counts: mutable darray[i64] = []
                # A `while` and not a `for`: a range whose bound is a local
                # declared in the enclosing loop's own body is not something
                # this compiler will take.
                for bay in 0..<SLOTS |queue_cells, queue_counts, piece_size|:
                    count: i64 = piece_size + bay % 2
                    queue_counts.push(count)
                    step: mutable i64 = 0
                    while step < count |queue_cells, count, step|:
                        stem: bool = step < count - 1
                        across: i64 = 0 if stem else 1
                        up: i64 = step if stem else count - 2
                        queue_cells.push(SceneTetris::Cell{x: across, y: up, tint: 0})
                        step <- step + 1
                shadow: mutable darray[SceneTetris::Block] = []
                for index in 0..<ghost |shadow, cols, rows|:
                    shadow.push(SceneTetris::Block{
                        x: ((index * 7) % cols).f64(),
                        y: ((index * 2) % rows).f64()})
                air: mutable darray[SceneTetris::Block] = []
                for index in 0..<flying |air, cols, rows|:
                    air.push(SceneTetris::Block{
                        x: ((index * 3) % cols).f64() + 0.5,
                        y: ((index * 5) % rows).f64() + 0.5})
                fits: mutable darray[i64] = []
                recut: mutable darray[bool] = []
                for index in 0..<SLOTS |fits, recut|:
                    fits.push(fits_of(index))
                    recut.push(recut_of(index))

                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneTetris::Paint = SceneTetris::paint_of(black, width, height, 2.0, 2.0)
                SceneTetris::render(&list, &paint, phase, cols, rows, &board,
                                    &queue_cells, &queue_counts,
                                    &fits, &recut, armed, &shadow, clean, &air,
                                    flying, angle.f64(),
                                    sview(STATUS, 0, -1) if say_status else sview("", 0, -1),
                                    sview(READOUT, 0, -1) if say_readout else sview("", 0, -1),
                                    verdict,
                                    sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
