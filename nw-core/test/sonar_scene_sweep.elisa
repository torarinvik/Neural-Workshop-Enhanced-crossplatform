include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_sonar.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate:
        session: mutable SonarGame::Session = SonarGame::initialize(rung, 1, false, 17)
        if mode != 5:
            _ = SonarGame::input(&session, SonarGame::START, -1, 0)
        if mode == 1 or mode == 2 or mode == 4:
            _ = SonarGame::input(&session, SonarGame::PING, 0, 1)
            wrong: i64 = (Sonar::target(&session.board) + 1) % (session.board.dealt.level.side * session.board.dealt.level.side)
            _ = SonarGame::input(&session, SonarGame::DIG, wrong, 2)
            _ = SonarGame::input(&session, SonarGame::PING, wrong, 3)
            _ = SonarGame::input(&session, SonarGame::PING, 0, 4)
            _ = SonarGame::input(&session, SonarGame::PING, 2, 5)
        if mode == 2 or mode == 4:
            _ = SonarGame::input(&session, SonarGame::DIG, Sonar::target(&session.board), 6)
        if mode == 3:
            for j in 0..<session.board.dealt.budget |session|:
                _ = SonarGame::input(&session, SonarGame::PING, 1, j + 1)
        if mode == 4:
            _ = SonarGame::advance(&session, 1806)

        _ = printf("frame %lld %lld %lld\n", rung, mode, 1 if dark else 0)
        if mode == 0 or mode == 1:
            grid: SceneHiddenRule::Rect = SceneSonar::board()
            side: i64 = session.board.dealt.level.side
            for cell in 0..<(side * side) |session, grid, side|:
                box: SceneHiddenRule::Rect = SceneSonar::cell_box(&grid, cell, side)
                _ = printf("hit %lld\n", SceneSonar::hit(&session, box.x + box.w / 2.0, box.y + box.h / 2.0))
            _ = printf("outside %lld %lld\n", SceneSonar::hit(&session, grid.x + grid.w, grid.y + 1.0),
                SceneSonar::hit(&session, grid.x, grid.y))
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneSonar::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate:
        for level in 0..<3:
            rung: i64 = [1, 8, 25][level.usize()]
            for mode in 0..<6 |rung|:
                for dark in 0..<2 |rung, mode|:
                    region scratch(2097152):
                        in scratch:
                            emit(rung, mode, dark != 0)
        return 0.i32()
