include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_bartender.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def frame(game: BartenderGame::Session&, name: cstr):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region scratch(65536):
            in scratch:
                list: mutable Display::DisplayList = Display::DisplayList()
                SceneBartender::render(&list, game, true)
                _ = printf("frame %s %lld %lld %lld %lld %lld\n", name, game.phase, game.rung,
                    game.trial, game.wins, game.run.served)
                for cmd in list.commands |list|:
                    if cmd.kind == Display::CMD_TEXT:
                        for i in 0..<(cmd.len & 0xffffff.u32()).i64() |list, cmd|:
                            _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                        _ = printf("\n")
                    elif cmd.kind == Display::CMD_POLYGON or cmd.kind == Display::CMD_POLY_POINT:
                        _ = printf("poly %u %u %u %.7g %.7g\n", cmd.kind, cmd.color, cmd.len, cmd.a.f64(), cmd.b.f64())
                    elif cmd.kind == Display::CMD_LINE or cmd.kind == Display::CMD_CIRCLE or cmd.kind == Display::CMD_RECT:
                        _ = printf("shape %u %u %.7g %.7g %.7g %.7g\n", cmd.kind, cmd.color,
                            cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64())
                _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        game: mutable BartenderGame::Session = BartenderGame::initialize(1, 1, true, 17)
        frame(&game, "ready")
        _ = BartenderGame::start(&game, 0.0) can Global{Read,Write}
        frame(&game, "start")
        game.run.time <- 1.25
        game.run.level_in <- 0.43
        game.run.drink <- 0
        game.run.ice <- true
        game.run.held <- 0
        game.run.hand.down <- true
        g: RoomsView::Vec = HandView::see(&game.run.camera, Bartender::glass_at(0.0))
        HandView::place(&game.run.hand, g.x, g.y)
        frame(&game, "pour")
        _ = BartenderGame::clear_controls(&game)
        frame(&game, "released")
        BartenderGame::close(&game) can Global{Read,Write}

        game <- BartenderGame::initialize(20, 1, true, 17)
        _ = BartenderGame::start(&game, 0.0) can Global{Read,Write}
        game.run.time <- 14.0
        game.run.level_in <- 0.8
        game.run.drink <- 2
        game.run.ice <- true
        game.run.glass_x <- 3.7
        game.run.strikes <- 1
        frame(&game, "pewter")
        BartenderGame::close(&game) can Global{Read,Write}

        game <- BartenderGame::initialize(1, 1, true, 17)
        _ = BartenderGame::start(&game, 0.0) can Global{Read,Write}
        t: mutable f64 = 0.0
        while game.phase == BartenderGame::PLAYING and t < 31.0 |game, t|:
            port: i64 = Bartender::pilot(&game.run)
            _ = BartenderGame::input(&game, port) can Global{Read,Write}
            t <- t + 1.0 / 60.0
            _ = BartenderGame::advance(&game, t) can Global{Read,Write}
        frame(&game, "won")
        _ = BartenderGame::advance(&game, t + 2.49) can Global{Read,Write}
        frame(&game, "hold")
        _ = BartenderGame::advance(&game, t + 2.5) can Global{Read,Write}
        frame(&game, "done")
        BartenderGame::close(&game) can Global{Read,Write}
        return 0
