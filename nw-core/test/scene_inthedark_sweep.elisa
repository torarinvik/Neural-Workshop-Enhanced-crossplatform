# Differential sweep driver for src/scene_inthedark.elisa.
# See scene_inthedark_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pymath.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_inthedark.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|has_round|lamps|colours|kind|room_lamp|room_other|cursor|rooms|asked|given|asking_at|trial|total_trials|tall|verdict")
            for spec in 0..<40:
                phase: i64 = spec % 5
                black: bool = spec % 7 == 1
                has_round: bool = spec % 13 != 12
                lamps: i64 = 2 + (spec / 5) % 5
                colours: i64 = 2 + (spec / 5) % 4
                # All four room kinds, and they are only drawn while WALKING.
                kind: i64 = (spec / 5) % 4
                room_lamp: i64 = (spec / 5) % lamps
                room_other: i64 = (room_lamp + 1) % lamps
                rooms: i64 = 3 + (spec / 5) % 4
                cursor: i64 = spec % rooms
                asked: i64 = 1 + (spec / 5) % lamps
                # Fewer answers given than asked is a real state: a round can
                # be scored with the last lamp still unanswered.
                given: i64 = (spec / 5) % (asked + 1)
                asking_at: i64 = spec % asked
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 3 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if has_round else 0)
                emit_bar(lamps)
                emit_bar(colours)
                emit_bar(kind)
                emit_bar(room_lamp)
                emit_bar(room_other)
                emit_bar(cursor)
                emit_bar(rooms)
                emit_bar(asked)
                emit_bar(given)
                emit_bar(asking_at)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                asked_lamps: mutable darray[i64] = []
                answers: mutable darray[i64] = []
                given_colours: mutable darray[i64] = []
                for one in 0..<asked |asked_lamps, answers, lamps, colours|:
                    asked_lamps.push((one * 2 + 1) % lamps)
                    answers.push((one * 3) % colours)
                for one in 0..<given |given_colours, colours, one|:
                    # Every other answer wrong, so the pip under the socket is
                    # drawn in both colours it can be.
                    given_colours.push((one * 3 + one % 2) % colours)
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneInTheDark::InTheDarkPaint = SceneInTheDark::paint_of(black, width, height, 2.0, 2.0)
                SceneInTheDark::render(&list, &paint, phase, has_round, lamps,
                                       colours, kind, room_lamp, room_other,
                                       cursor, rooms, &asked_lamps, &answers,
                                       &given_colours, asking_at,
                                       1 + spec % 5, 5,
                                       sview("Rung 3 - three rooms", 0, -1),
                                       verdict,
                                       sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
