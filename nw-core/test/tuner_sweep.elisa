include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/tuner.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def sound(s: Tuner::Sound):
    can Abort.Panic, Console.Write:
        _ = printf("%lld %lld %lld %lld %.17g %.17g %lld %lld %.17g %lld",
            s.bank, s.row, s.label, s.group, s.raw_length, s.speed, s.backward.i64(), s.tune.rhythm, s.tune.root, s.tune.voice)
        for i in 0..<5 |s|:
            _ = printf(" %lld", s.tune.degrees[i.usize()])
        _ = printf("\n")

def emit(rung: i64, seed: i64, clips: darray[Tuner::Clip]&, scenario: i64):
    can Abort.Panic, Memory.Allocate, Console.Write:
        radio: Tuner::Radio = Tuner::deal(rung, seed, clips)
        g: Tuner::Grade = radio.level
        _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %.17g %.17g %.17g %.17g %.17g %.17g %lld\n",
            g.rung, radio.count, radio.target, g.lamps.i64(), g.same_group.i64(), g.shifted.i64(), g.fade.i64(),
            g.near_miss, g.width, g.drift, g.seconds, g.hold, radio.listen, radio.start, radio.seed)
        sound(radio.heard)
        for i in 0..<radio.count |radio|:
            s: Tuner::Station = radio.stations[i.usize()]
            _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g\n", s.at, s.phase, s.drift_rate, s.drift_phase, s.fade_rate, s.fade_phase)
            sound(s.sound)
        run: mutable Tuner::Run = Tuner::initialize(&radio, scenario != 0)
        while run.result == Tuner::PENDING |run, scenario, radio|:
            controls: i64 = Tuner::autopilot(&run) if scenario == 0 else 0
            if (controls & 16) != 0:
                _ = Tuner::press(&run)
            if scenario == 1 and run.t >= radio.listen and run.plays.count == 1.usize():
                _ = Tuner::replay(&run)
            if scenario == 2 and run.t >= radio.listen:
                run.dial <- Tuner::where(&run.radio, (radio.target + 1) % radio.count, run.t)
                _ = Tuner::press(&run)
            Tuner::step(&run, 1.0 / 60.0, controls)
        _ = printf("%lld %.17g %.17g %.17g %lld\n", run.result, run.t, run.dial, run.replay_until, run.gains.count.i64())

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Console.Write:
        none: darray[Tuner::Clip] = []
        clips: mutable darray[Tuner::Clip] = []
        for label in 0..<50 |clips|:
            for i in 0..<3 |clips, label|:
                clips.push(Tuner::Clip{row: label * 3 + i, label: label, duration: 0.8 + i.f64() * 0.7})
        sparse: darray[Tuner::Clip] = [
            Tuner::Clip{row: 1, label: 1, duration: 0.8}, Tuner::Clip{row: 2, label: 1, duration: 1.5},
            Tuner::Clip{row: 3, label: 5, duration: 2.0}, Tuner::Clip{row: 4, label: 7, duration: 3.8},
            Tuner::Clip{row: 8, label: 11, duration: 2.2}]
        for rung in -1..<35 |none, clips, sparse|:
            for seed in -3..<6 |none, rung|:
                emit(rung, seed, &none, 0)
            emit(rung, 17, &clips, 0)
            emit(rung, 17, &sparse, 0)
        emit(30, -9223372036854775807 - 1, &none, 0)
        emit(30, 9223372036854775807, &none, 0)
        emit(20, 17, &none, 1)
        emit(20, 17, &none, 2)
        return 0.i32()
