include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_missing_word.elisa"
include "../src/tasks/passage_corpus.elisa"

extern getchar() -> i32 can[Blocking.IO]
extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def read_input() -> dstr:
    can Blocking.IO, Memory.Allocate, Abort.Panic:
        raw: mutable dstr = []
        while true |raw|:
            b: i32 = getchar()
            break if b < 0.i32() or b == 0.i32()
            raw.push(b.u8())
        return raw

def flag(b: bool) -> i64:
    return 1 if b else 0

def emit_word(text: Passages::Word):
    can Console.Write, Abort.Panic:
        for k in 0..<text.length |text|:
            _ = dprintf(1.i32(), "%c", Passages::letter(text, k).i32())
        _ = dprintf(1.i32(), " ")

def emit_line(row: MissingWord::Line&):
    can Console.Write, Abort.Panic:
        for i in 0..<row.count |row|:
            word: MissingWord::Token = row.words[i.usize()]
            _ = dprintf(1.i32(), "%lld:", word.id)
            emit_word(word.text)
        _ = dprintf(1.i32(), "\n")

def emit(candidate: MissingWord::Candidate&, draw: mutable MT19937&, sources: MissingWord::Sources&, vocab: MissingWord::Vocabulary&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = dprintf(1.i32(), "deal %lld %.17g\n", flag(candidate.valid), py_random(draw))
        return if not candidate.valid
        m: MissingWord::Machine& = &candidate.machine
        _ = dprintf(1.i32(), "seed %lld\n", m.seed.i64())
        for i in 0..<m.level.sentences |m, sources, vocab|:
            emit_line(&m.original[i.usize()])
            emit_line(&m.rows[i.usize()])
            row: MissingWord::Line& = &m.rows[i.usize()]
            for j in 0..<(row.count - 1) |row, m, sources, vocab|:
                selection: MissingWord::Offer = MissingWord::offer(m, row.words[j.usize()], row.words[(j + 1).usize()], sources, vocab)
                for k in 0..<selection.count |selection|:
                    emit_word(selection.words[k.usize()])
                _ = dprintf(1.i32(), "\n")
        for i in 0..<m.count |m|:
            change: MissingWord::Damage = m.damage[i.usize()]
            _ = dprintf(1.i32(), "%lld %lld %lld\n", change.kind, change.row, change.index)

def replay_run(candidate: MissingWord::Candidate&, sources: MissingWord::Sources&, ranked: MissingWord::Vocabulary&, policy: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        return if not candidate.valid
        run: mutable MissingWord::Run = MissingWord::start(candidate.machine)
        if policy == 1:
            row: darray[MissingWord::Token]& = &run.rows[0]
            scale: f64 = MissingWord::row_scale(row)
            HandView::place(&run.hand, MissingWord::TEXT_LEFT + MissingWord::tile_width(row, 0) * scale / 2.0, 540.0)
            MissingWord::act(&run, sources, ranked, HandView::PRESS)
            MissingWord::act(&run, sources, ranked, HandView::PRESS)
            MissingWord::act(&run, sources, ranked, HandView::RELEASE)
            HandView::place(&run.hand, MissingWord::option_x(0, 1), MissingWord::OPT_Y)
            MissingWord::act(&run, sources, ranked, HandView::PRESS)
            _ = dprintf(1.i32(), "struck %lld\n", run.rows[0].count.i64())
            MissingWord::act(&run, sources, ranked, MissingWord::RESET)
            _ = dprintf(1.i32(), "reset %lld\n", run.rows[0].count.i64())
            MissingWord::act(&run, sources, ranked, MissingWord::DONE)
        elif policy == 2:
            MissingWord::step(&run, candidate.machine.level.seconds)
        while run.result == MissingWord::LIVE |run, sources, ranked|:
            port: i64 = MissingWord::pilot(&run)
            MissingWord::act(&run, sources, ranked, port)
            MissingWord::step(&run, 1.0 / 60.0)
            _ = dprintf(1.i32(), "tick %lld %.17g %.17g %.17g %lld %lld %lld %lld %lld\n", port,
                run.t, run.hand.x, run.hand.y, flag(run.hand.down), run.choice.kind, run.choice.row, run.choice.index, run.result)
        _ = dprintf(1.i32(), "result %lld %.17g %lld\n", run.result, run.t, run.made)
        for cue in run.cues:
            _ = dprintf(1.i32(), "cue %.17g %.17g %.17g %lld %.17g\n", cue.t, cue.duration, cue.frequency, cue.voice, cue.gain)

def emit_page(candidate: MissingWord::Candidate&, sources: MissingWord::Sources&, vocab: MissingWord::Vocabulary&, mode: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        return if not candidate.valid
        run: mutable MissingWord::Run = MissingWord::start(candidate.machine)
        row: darray[MissingWord::Token]& = &run.rows[0]
        scale: f64 = MissingWord::row_scale(row)
        if mode == 1:
            HandView::place(&run.hand, MissingWord::TEXT_LEFT + MissingWord::tile_width(row, 0) * scale / 2.0, 540.0)
            MissingWord::act(&run, sources, vocab, HandView::PRESS)
        elif mode == 2:
            HandView::place(&run.hand, MissingWord::TEXT_LEFT + (MissingWord::tile_width(row, 0) + MissingWord::GAP / 2.0) * scale, 510.0)
            MissingWord::act(&run, sources, vocab, HandView::PRESS)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneMissingWord::page(&list, &run)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = dprintf(1.i32(), "text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list|:
                    _ = dprintf(1.i32(), "%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = dprintf(1.i32(), "\n")
            else:
                _ = dprintf(1.i32(), "draw %u %u %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind.i32(), cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64())
        _ = dprintf(1.i32(), "end\n")

def main() -> i32:
    can Blocking.IO, Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            text: mutable dstr = []
            SceneMissingWord::option_note(rung, &text)
            _ = dprintf(1.i32(), "note %lld ", rung)
            for byte in text:
                _ = dprintf(1.i32(), "%c", byte.i32())
            _ = dprintf(1.i32(), "\n")
        custom: bool = getchar() == 1.i32()
        passage_text: dstr = read_input() if custom else []
        sentence_text: dstr = read_input() if custom else []
        vocabulary: dstr = read_input() if custom else []
        corpus: PassageSeed::Corpus = PassageSeed::from_cache(bytes_view(passage_text), bytes_view(sentence_text), bytes_view(vocabulary))
        sentences: Passages::Bank = Passages::read(bytes_view(sentence_text), false) if custom else PassageSeed::sentences()
        sources: MissingWord::Sources = MissingWord::sources(&sentences, &corpus.bank, &corpus.known)
        ranked: MissingWord::Vocabulary = MissingWord::vocabulary(bytes_view(vocabulary))
        for rung in [0, 1, 3, 4, 6, 7, 10, 13, 16, 19, 22, 25, 28, 30, 41, 99] |corpus, sentences, sources, ranked|:
            g: MissingWord::Grade = MissingWord::grade(rung)
            _ = dprintf(1.i32(), "level %lld %lld %lld %lld %lld %lld %.17g\n", g.rung, g.sentences, g.kinds, g.errors, flag(g.hint), flag(g.close), g.seconds)
            for seed in 0..<24 |g, corpus, sentences, sources, ranked|:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                candidate: MissingWord::Candidate = MissingWord::build(g, &draw, &sources, &sentences, &corpus.bank, &corpus.pairs, &corpus.known)
                emit(&candidate, &draw, &sources, &ranked)
            draw: mutable MT19937 = zeroed
            mt_seed_int(&draw, 17.u64())
            screened: MissingWord::Candidate = MissingWord::deal(g, &draw, &sources, &ranked, &sentences,
                &corpus.bank, &corpus.pairs, &corpus.known)
            emit(&screened, &draw, &sources, &ranked)
            replay_run(&screened, &sources, &ranked, 0)
            if rung == 1:
                replay_run(&screened, &sources, &ranked, 1)
                replay_run(&screened, &sources, &ranked, 2)
            for mode in 0..<3 |screened, sources, ranked|:
                emit_page(&screened, &sources, &ranked, mode)
        return 0.i32()
