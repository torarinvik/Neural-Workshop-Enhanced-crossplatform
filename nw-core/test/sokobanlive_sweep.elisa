include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/sokobanlive_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(floor: SokobanLive::Warehouse&):
    can Abort.Panic, Console.Write:
        g: SokobanLive::Grade = floor.level
        _ = printf("grade %lld %lld %lld %lld %lld %.17g %lld %lld %lld\n", g.rung, g.width, g.height,
            g.crates, g.guards, g.beat, g.shutters, g.pulls, g.floor)
        _ = printf("valid %lld\n", floor.valid.i64())
        return if not floor.valid
        _ = printf("room %lld %lld %lld %lld %.17g\n", floor.player, floor.minimum, floor.lower_bound,
            floor.bound, floor.seconds)
        for i in 0..<(g.width * g.height) |floor|:
            k: usize = i.usize()
            _ = printf("cell %lld %lld %lld %lld\n", floor.walls[k].i64(), floor.goals[k].i64(),
                floor.boxes[k].i64(), floor.alive[k].i64())
        for i in 0..<g.guards |floor|:
            guard: SokobanLive::Patrol = floor.patrols[i.usize()]
            _ = printf("patrol %lld %lld %.17g %lld\n", guard.start, guard.heading, guard.phase, guard.lane.length)
            for k in 0..<guard.lane.length |guard|:
                _ = printf("lane %lld\n", guard.lane.start + guard.lane.stride * k)
        for i in 0..<g.shutters |floor|:
            gate: SokobanLive::Shutter = floor.shutters[i.usize()]
            _ = printf("shutter %lld %.17g %.17g %.17g\n", gate.cell, gate.period, gate.open_share, gate.phase)

def emit_solution(floor: SokobanLive::Warehouse&):
    can Abort.Panic, Console.Write, Memory.Allocate:
        return if not floor.valid
        search: mutable SokobanLiveSearch::Search = SokobanLiveSearch::create()
        dist: i64[SokobanLive::MOST_CELLS] = SokobanLiveSearch::distances(floor)
        orders: mutable darray[i64] = []
        found: bool = SokobanLiveSearch::solve(floor, &search, &dist, floor.crate_slots, floor.player, &orders)
        _ = printf("solution %lld %lld\n", found.i64(), orders.count.i64())
        for direction in orders:
            _ = printf("direction %lld\n", direction)

def replay(floor: SokobanLive::Warehouse&, guided: bool):
    can Abort.Panic, Console.Write, Memory.Allocate:
        return if not floor.valid
        run: mutable SokobanLive::Run = SokobanLive::initialize(floor)
        g: SokobanLive::Grade = floor.level
        pilot: mutable SokobanLivePilot::Pilot = SokobanLivePilot::create(floor)
        limit: i64 = 6000 if guided else 360
        for tick in 0..<limit |run, g, guided, pilot|:
            break if run.result != SokobanLive::LIVE
            if guided:
                direction: i64 = SokobanLivePilot::order(&pilot, &run)
                _ = printf("order %lld\n", direction)
                _ = SokobanLive::press(&run, direction)
            elif tick % 4 == 0:
                _ = SokobanLive::press(&run, (tick / 4 + tick / 13) % 4)
            SokobanLive::step(&run, 1.0 / 30.0)
            _ = printf("tick %.17g %lld %.17g %lld %lld %lld %lld %lld\n", run.elapsed, run.player, run.ready_at,
                run.queued, run.result, run.facing, run.pushes, run.steps)
            for i in 0..<(g.width * g.height) |run|:
                if run.boxes[i.usize()]:
                    _ = printf("box %lld\n", i)
            for i in 0..<g.guards |run|:
                guard: SokobanLive::Guard = run.guards[i.usize()]
                _ = printf("guard %lld %lld %.17g\n", guard.at, guard.heading, guard.next_beat)
            for i in 0..<g.shutters |run|:
                _ = printf("gate %lld\n", run.shut[i.usize()].i64())

def sweep(rung: i64, seed: i64):
    can Abort.Panic, Console.Write, Memory.Allocate, Memory.Release:
        region scratch(67108864):
            in scratch:
                draw: mutable MT19937 = zeroed
                magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
                mt_seed_int(&draw, magnitude)
                work: mutable Sokoban::SokobanWork = Sokoban::work_new()
                search: mutable Sokoban::Search = Sokoban::Search(80000)
                floor: SokobanLive::Warehouse = SokobanLive::build(&work, &search, SokobanLive::grade(rung), &draw)
                emit(&floor)
                emit_solution(&floor)
                replay(&floor, false)

def summary(session: SokobanLiveGame::Session&):
    can Abort.Panic, Console.Write:
        done: bool = session.phase == SokobanLiveGame::DONE
        _ = printf("session %lld %lld %lld %lld %lld %lld %lld %lld %lld %.17g\n", session.phase, session.rung,
            session.trial, session.wins, session.best_rung, session.verdict, SokobanLiveGame::info(session, 4),
            SokobanLiveGame::info(session, 5), SokobanLiveGame::info(session, 6), 0.0 if done else session.run.elapsed)

def lifecycle():
    can Abort.Panic, Console.Write, Memory.Allocate, Memory.Release:
        session: mutable SokobanLiveGame::Session = SokobanLiveGame::initialize(1, 2, true, 17)
        _ = SokobanLiveGame::input(&session, SokobanLiveGame::START, 0)
        summary(&session)
        floor: SokobanLive::Warehouse = session.run.warehouse
        pilot: mutable SokobanLivePilot::Pilot = SokobanLivePilot::create(&floor)
        now: mutable i64 = 0
        for trial in 0..<2 |session, now, pilot|:
            while session.phase == SokobanLiveGame::PLAYING |session, now, trial, pilot|:
                if trial == 0:
                    direction: i64 = SokobanLivePilot::order(&pilot, &session.run)
                    if direction >= 0:
                        _ = SokobanLiveGame::input(&session, direction, now)
                next: i64 = now + (137 if (now / 11) % 3 == 0 else 11)
                _ = SokobanLiveGame::advance(&session, next, next.f64() / 1000.0 - now.f64() / 1000.0)
                now <- next
                summary(&session)
            _ = SokobanLiveGame::advance(&session, now + 2999, 2.999)
            summary(&session)
            now <- now + 3000
            _ = SokobanLiveGame::advance(&session, now, 3.0)
            summary(&session)
        _ = SokobanLiveGame::input(&session, SokobanLiveGame::START, now + 1)
        summary(&session)

def main() -> i32:
    can Abort.Panic, Console.Write, Memory.Allocate, Memory.Release:
        for rung in [1, 2, 4, 7, 10, 13, 16, 20, 30]:
            for seed in [-17, 0, 3, 17]:
                sweep(rung, seed)
        for rung in [1, 2, 4, 7, 10, 13, 16, 20, 30]:
            region recording(4194304):
                in recording:
                    floor: SokobanLive::Warehouse = SokobanLivePilot::deal_seed(rung, 17)
                    emit(&floor)
                    replay(&floor, true)
        lifecycle()
        return 0.i32()
