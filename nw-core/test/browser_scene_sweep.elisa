include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_browser.elisa"

# Browser runs played through the game layer, with the scene's chrome text
# and the drawn browser window dumped at each step; browser_scene_diff.py
# draws the same with ui/browser.py.
extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def hex_text(list: Display::DisplayList&, cmd: Display::DrawCmd&):
    can Console.Write, Abort.Panic:
        for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list|:
            _ = dprintf(1.i32(), "%02x", list.pool[(cmd.ref.i64() + i).usize()].i32())
        _ = dprintf(1.i32(), "\n")

def dump(list: Display::DisplayList&, texts_only: bool):
    can Console.Write, Abort.Panic:
        for cmd in list.commands |list, texts_only|:
            if cmd.kind == Display::CMD_TEXT:
                _ = dprintf(1.i32(), "text %u %.9g %.9g %.9g %.9g %u ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(),
                    cmd.d.f64(), cmd.len >> 24.u32())
                hex_text(list, &cmd)
            elif texts_only:
                continue
            elif cmd.kind == Display::CMD_RECT:
                _ = dprintf(1.i32(), "rect %u %.9g %.9g %.9g %.9g\n", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64())
            elif cmd.kind == Display::CMD_BORDERED_RECT:
                _ = dprintf(1.i32(), "bordered %u %.9g %.9g %.9g %.9g %u %.9g\n", cmd.color, cmd.a.f64(), cmd.b.f64(),
                    cmd.c.f64(), cmd.d.f64(), cmd.ref, cmd.e.f64())
            elif cmd.kind == Display::CMD_LINE:
                _ = dprintf(1.i32(), "line %u %.9g %.9g %.9g %.9g %.9g\n", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(),
                    cmd.d.f64(), cmd.e.f64())
            elif cmd.kind == Display::CMD_TRIANGLE:
                _ = dprintf(1.i32(), "triangle %u %.9g %.9g %.9g %.9g %.9g %.9g\n", cmd.color, cmd.a.f64(), cmd.b.f64(),
                    cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
            else:
                _ = dprintf(1.i32(), "other %u\n", cmd.kind.u32())

def frame(game: BrowserGame::Session&, label: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = dprintf(1.i32(), "frame %lld %lld %lld %lld %lld %lld %lld\n", label, game.phase, game.rung, game.trial,
            game.wins, game.best_rung, game.verdict)
        whole: mutable Display::DisplayList = Display::DisplayList()
        SceneBrowser::render(&whole, game, false)
        dump(&whole, true)
        if game.phase == BrowserGame::PLAYING or game.phase == BrowserGame::JUDGED:
            _ = dprintf(1.i32(), "shop\n")
            window: mutable Display::DisplayList = Display::DisplayList()
            SceneBrowser::shop(&window, BrowserGame::frame(), &game.browser)
            dump(&window, false)
        _ = dprintf(1.i32(), "end\n")

# Open the cart with a click on its toolbar button, then go Back.
def detour(game: mutable BrowserGame::Session&, now: f64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        at: BrowserGame::Frame = BrowserGame::frame()
        cart: BrowserSession::Rectangle = BrowserSession::chrome_rectangle(&game.browser, 2)
        _ = BrowserGame::click(game, at.left + (cart.x + 5.0) * at.scale, at.top - (cart.y + 5.0) * at.scale, now)
        frame(game, 2)
        _ = BrowserGame::back(game)
        frame(game, 3)

def run(rung: i64, seed: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = dprintf(1.i32(), "run %lld %lld\n", rung, seed)
        game: mutable BrowserGame::Session = BrowserGame::initialize(rung, 3, true, seed)
        frame(&game, 0)
        _ = BrowserGame::start(&game, 0.0)
        frame(&game, 1)
        now: mutable f64 = 0.0
        for trial in 0..<3 |game, now|:
            ports: mutable darray[i64] = []
            if trial == 1:
                # A detour first, then a scroll the reference path does
                # not expect.
                ports.push(BrowserSession::SCROLL_DOWN)
                detour(&game, now)
            if trial == 2 and seed == 11:
                # Enough detours to buy the right things over par.
                for _ in 0..<(game.par / 2 + 1) |game, now|:
                    detour(&game, now)
            reference: darray[i64] = BrowserPar::reference_ports(&game.browser)
            for port in reference |ports|:
                ports.push(port)
            if trial == 2 and seed != 11:
                # Two clicks where the pointer starts, which can send the
                # path astray.
                _ = BrowserGame::steer(&game, BrowserSession::CLICK, now)
                _ = BrowserGame::steer(&game, BrowserSession::CLICK, now)
            for index in 0..<ports.count.i64() |game, now, ports|:
                port: i64 = ports[index.usize()]
                now <- now + 0.25
                _ = BrowserGame::steer(&game, port, now)
                frame(&game, 10) if port >= BrowserSession::CLICK or index % 9 == 0
                break if game.phase != BrowserGame::PLAYING
            frame(&game, 4)
            now <- now + 3.0
            _ = BrowserGame::advance(&game, now)
            frame(&game, 5)
        _ = dprintf(1.i32(), "over\n")

# _words on its own: long text in narrow room, so shrink-to-fit runs.
def words_cases():
    can Console.Write, Memory.Allocate, Abort.Panic:
        at: BrowserGame::Frame = BrowserGame::frame()
        for length in [5, 30, 60, 120] |at|:
            text: mutable dstr = []
            for _ in 0..<length |text|:
                dstr_append_cstr(&text, "w")
            for size in [12, 15, 22] |at, length, text|:
                for width in [0, 80, 300] |at, length, text, size|:
                    list: mutable Display::DisplayList = Display::DisplayList()
                    drawn: f64 = SceneBrowser::words(&list, at, bytes_view(text), 100.0, 200.0, size.f64(),
                        SceneBrowser::INK, false, Display::ANCHOR_LEFT_CENTER, width.f64())
                    _ = dprintf(1.i32(), "words %lld %lld %lld %.9g\n", length, size, width, drawn)
                    dump(&list, false)

# The options note for every rung the options offer.
def note_cases():
    can Console.Write, Memory.Allocate, Abort.Panic:
        for rung in [1, 3, 6, 9, 12, 15, 18, 21, 25, 30]:
            note: mutable dstr = []
            SceneBrowser::option_note(rung, &note)
            _ = dprintf(1.i32(), "note %lld ", rung)
            for i in 0..<note.count.i64() |note|:
                _ = dprintf(1.i32(), "%02x", note[i.usize()].i32())
            _ = dprintf(1.i32(), "\n")

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region fixtures(268435456)
        in fixtures:
            for rung in [1, 3, 6, 9, 12, 15, 18, 21, 25]:
                for seed in [3, 11] |rung|:
                    run(rung, seed)
            words_cases()
            note_cases()
        destroy fixtures
        return 0.i32()
