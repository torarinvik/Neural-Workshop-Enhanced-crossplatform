include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/shadow_play_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def vec(v: RoomsView::Vec):
    can Console.Write:
        _ = printf("%.17g %.17g %.17g\n", v.x, v.y, v.z)

def matrix(m: DrShape::Matrix):
    can Console.Write:
        vec(m.x)
        vec(m.y)
        vec(m.z)

def rod_line(rod: ShadowPlay::Rod&):
    can Abort.Panic, Console.Write:
        for i in 0..<rod.count |rod|:
            vec(rod.joints[i.usize()])

def run_line(run: ShadowPlay::Run&):
    can Abort.Panic, Console.Write:
        _ = printf("%.17g %.17g %.17g %.17g %.17g %lld %lld %lld %lld\n",
            run.t, run.fit, run.checked, run.fit_since, ShadowPlay::closeness(run), run.result,
            run.dirty.i64(), run.notes.count.i64(), ShadowPlay::autopilot(run))
        matrix(run.turn)

def notes(run: ShadowPlay::Run&):
    can Abort.Panic, Console.Write:
        for i in 0..<run.notes.count |run|:
            cue: DrShapeDeal::Note = run.notes[i]
            _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g %.17g %lld %lld %lld %.17g\n",
                cue.t, cue.dur, cue.freq, cue.pan, cue.pan2, cue.gain, cue.bright, cue.voice, cue.seed, cue.who, cue.room)

def emit(rung: i64, seed: i64):
    can Abort.Panic, Memory.Allocate, Console.Write:
        setup: ShadowPlay::Setup = ShadowPlay::deal(rung, seed)
        g: ShadowPlay::Grade = setup.level
        _ = printf("%lld %lld %lld %lld %lld %.17g %.17g %.17g %.17g %.17g\n", g.rung, g.bends, g.axes,
            g.hum.i64(), g.floor.i64(), g.tol, g.turning, g.swing, g.hold, g.seconds)
        rod_line(&setup.rod)
        matrix(setup.target)
        matrix(setup.start)
        run: mutable ShadowPlay::Run = ShadowPlay::initialize(&setup, true)
        run_line(&run)
        q: RoomsView::Vec = setup.rod.joints[0]
        lamp: RoomsView::Vec = ShadowPlay::wall_light(g.swing, 1.37)
        vec(lamp)
        vec(ShadowPlay::on_wall(q, lamp))
        vec(ShadowPlay::on_floor(q, ShadowPlay::floor_light()))
        for i in 0..<25 |run|:
            ShadowPlay::rotate(&run, 2, 0.19)
            ShadowPlay::step(&run, 1.0 / 120.0, (i * 19) % 64)
        run_line(&run)
        while run.result == ShadowPlay::PENDING |run|:
            ShadowPlay::step(&run, 1.0 / 60.0, ShadowPlay::autopilot(&run))
        run_line(&run)
        notes(&run)

def session_line(session: ShadowPlayGame::Session&):
    can Abort.Panic, Console.Write:
        _ = printf("%lld %lld %lld %lld %lld %.17g\n", session.phase, session.rung, session.trial,
            session.passed, session.best, session.last_tick)
        if session.phase == ShadowPlayGame::PLAYING or session.phase == ShadowPlayGame::JUDGED:
            run_line(&session.run)

def audio_line(session: mutable ShadowPlayGame::Session&, dest: mutable u8&):
    can Abort.Panic, Console.Write, Memory.Allocate:
        count: i64 = ShadowPlayGame::audio_window(session, dest, 32768)
        _ = printf("%.17g ", session.heard_to)
        for i in 0..<count |dest|:
            _ = printf("%02x", dest[i.usize()].i32())
        _ = printf("\n")

def session_replay() -> bool:
    can Abort.Panic, Console.Write, Memory.Allocate, Memory.Release:
        session: mutable ShadowPlayGame::Session = ShadowPlayGame::initialize(1, 2, true, -17)
        now: mutable f64 = 10.0
        return false if not (ShadowPlayGame::start(&session, now) can Global{Read,Write})
        session_line(&session)
        return false if not ShadowPlayGame::drag(&session, 22.0, -12.0, false)
        return false if not (ShadowPlayGame::agent_event(&session, now, ShadowPlay::YAW_L) can Global{Read,Write})
        now <- now + 0.4
        _ = ShadowPlayGame::advance(&session, now, 2) can Global{Read,Write}
        for i in 0..<12 |session, now|:
            now <- now + 0.05
            _ = ShadowPlayGame::advance(&session, now, 0) can Global{Read,Write}
        session_line(&session)
        buffer: mutable u8[32768] = zeroed
        audio_line(&session, &buffer[0])
        audio_line(&session, &buffer[0])
        session.run.turn <- session.run.setup.target
        while session.phase == ShadowPlayGame::PLAYING |session, now|:
            now <- now + 0.05
            _ = ShadowPlayGame::agent_event(&session, now, ShadowPlayGame::UPDATE) can Global{Read,Write}
        session_line(&session)
        audio_line(&session, &buffer[0])
        audio_line(&session, &buffer[0])
        return false if (ShadowPlayGame::advance(&session, session.deadline - 0.01, 0) can Global{Read,Write})
        now <- session.deadline
        _ = ShadowPlayGame::advance(&session, now, 0) can Global{Read,Write}
        session_line(&session)
        while session.phase == ShadowPlayGame::PLAYING |session, now|:
            now <- now + 0.05
            _ = ShadowPlayGame::agent_event(&session, now, ShadowPlayGame::UPDATE) can Global{Read,Write}
        session_line(&session)
        _ = ShadowPlayGame::agent_event(&session, now + 0.05, ShadowPlayGame::UPDATE) can Global{Read,Write}
        session_line(&session)
        return false if not (ShadowPlayGame::start(&session, now + 1.0) can Global{Read,Write})
        session_line(&session)
        ShadowPlayGame::close(&session) can Global{Read,Write}
        return session.phase == ShadowPlayGame::READY and session.run.notes.count == 0.usize()

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Memory.Release, Console.Write:
        for bends in 3..<9:
            rng: mutable MT19937 = zeroed
            mt_seed_int(&rng, bends.u64())
            for k in 0..<50 |bends, rng|:
                rod: ShadowPlay::Rod = ShadowPlay::make_rod(bends, &rng)
                rod_line(&rod)
        for rung in 0..<34:
            emit(rung, 17 + rung * 19)
        emit(3, -17)
        emit(7, -9223372036854775807 - 1)
        emit(25, 9223372036854775807)
        return 0.i32() if (session_replay() can Global{Read,Write}) else 1.i32()
