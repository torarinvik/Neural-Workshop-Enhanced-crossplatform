include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_notebook.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def main() -> i32:
    can Memory.Allocate, Console.Write, Abort.Panic:
        for key in 0..<160:
            _ = printf("%llu\n", Notebook::name_hash(key))
        for rung in 1..<41:
            for seed in -12..<12 |rung|:
                deal: Notebook::Deal = Notebook::deal(rung, seed)
                level: Notebook::Grade = deal.level
                _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld\n",
                    rung, seed, level.facts, level.hold, level.gap, level.choices, level.noise, level.updates, level.lines)
                play: mutable Notebook::Round = Notebook::initialize(deal)
                for index in 0..<deal.count |deal, play, level, seed|:
                    card: Notebook::Card = deal.cards[index.usize()]
                    _ = printf("%lld %lld %lld %lld", card.kind, card.key, card.code, card.answer)
                    if card.kind == Notebook::QUESTION:
                        for i in 0..<level.choices |card|:
                            _ = printf(" %lld", card.choices[i.usize()])
                        return 1.i32() if Notebook::write(&play, 0) or Notebook::next(&play)
                        choice: i64 = (card.answer + (1 if seed % 2 != 0 else 0)) % level.choices
                        _ = printf(" %lld", Notebook::answer(&play, choice))
                    else:
                        line: i64 = play.at % level.lines
                        return 2.i32() if Notebook::answer(&play, 0) != -1
                        return 3.i32() if not Notebook::write(&play, line)
                        note: Notebook::Note = play.lines[line.usize()]
                        _ = printf(" %lld %lld", note.key, note.code)
                        return 4.i32() if not Notebook::next(&play)
                    _ = printf("\n")
                return 5.i32() if not Notebook::over(&play)
                _ = printf("done %lld %lld", play.given, play.right)
                for line in 0..<level.lines |play|:
                    note: Notebook::Note = play.lines[line.usize()]
                    _ = printf(" %lld %lld", note.key, note.code)
                _ = printf("\n")
        game: mutable NotebookGame::Run = NotebookGame::initialize(13, 2, true, -17)
        return 6.i32() if SceneNotebook::hit(&game, 450.0, 300.0) != NotebookGame::START
        return 6.i32() if not NotebookGame::steer(&game, NotebookGame::START, 0)
        for trial in 1..<3 |game|:
            perfect: bool = trial == 1
            _ = printf("round %lld %lld\n", game.play.dealt.seed, game.rung)
            while game.phase == NotebookGame::PLAYING |game, perfect|:
                card: Notebook::Card = game.play.dealt.cards[game.play.at.usize()]
                if card.kind == Notebook::QUESTION:
                    rect: SceneHiddenRule::Rect = SceneNotebook::answer_box(card.answer, game.play.dealt.level.choices)
                    return 13.i32() if SceneNotebook::hit(&game, rect.x + rect.w / 2.0, rect.y + rect.h / 2.0) != card.answer
                    choice: i64 = card.answer if perfect else (card.answer + 1) % game.play.dealt.level.choices
                    return 7.i32() if not NotebookGame::steer(&game, choice, 100)
                else:
                    rect: SceneHiddenRule::Rect = SceneNotebook::write_box(0, game.play.dealt.level.lines)
                    write: i64 = SceneNotebook::hit(&game, rect.x + rect.w / 2.0, rect.y + rect.h / 2.0)
                    return 8.i32() if write != NotebookGame::WRITE or not NotebookGame::steer(&game, write, 100)
                    if game.play.at == 0:
                        frame: mutable Display::DisplayList = Display::DisplayList()
                        SceneNotebook::render(&frame, &game, not perfect)
                        return 14.i32() if frame.commands.count < 20.usize()
                    return 9.i32() if not NotebookGame::steer(&game, NotebookGame::NEXT, 100)
            _ = printf("scored %lld %lld %lld %lld\n", game.trial, game.rung, game.play.right, game.passed_count)
            return 15.i32() if SceneNotebook::hit(&game, 450.0, 300.0) != -1
            verdict: mutable Display::DisplayList = Display::DisplayList()
            SceneNotebook::render(&verdict, &game, not perfect)
            return 16.i32() if verdict.commands.count < 10.usize()
            return 10.i32() if NotebookGame::advance(&game, 2599)
            return 11.i32() if not NotebookGame::advance(&game, 2600)
        return 12.i32() if game.phase != NotebookGame::DONE or game.best_rung != 13
        return 0.i32()
