include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_escort.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        session: mutable EscortGame::Session = EscortGame::initialize(rung, 1, false, 17)
        if mode != 0:
            _ = EscortGame::input(&session, EscortGame::START, 0)
        now: mutable i64 = 0
        if mode >= 2:
            stop: i64 = 300 if mode == 2 else (4500 if mode == 3 else 180000)
            if mode == 2:
                _ = EscortGame::input(&session, 0, 0)
            while session.phase == EscortGame::PLAYING and now < stop |session, now, stop, mode|:
                if mode == 3 or mode == 6:
                    port: i64 = Escort::autopilot(&session.run)
                    if port >= 0:
                        _ = EscortGame::input(&session, port, now)
                next: i64 = now + 100
                _ = EscortGame::advance(&session, next, next.f64() / 1000.0 - now.f64() / 1000.0)
                now <- next
        if mode == 5:
            _ = EscortGame::advance(&session, session.deadline_ms, 0.0)
        _ = printf("frame %lld %lld %lld\n", rung, mode, 1 if dark else 0)
        area: SceneEscort::Frame = SceneEscort::frame()
        if session.phase == EscortGame::PLAYING or session.phase == EscortGame::JUDGED:
            temple: Escort::Temple& = &session.run.temple
            count: i64 = EscortGame::info(&session, 5)
            for j in 0..<count |area, session, count|:
                box: SceneHiddenRule::Rect = SceneEscort::lever_box(area, count, j)
                x: f64 = box.x + box.w / 2.0
                y: f64 = box.y + box.h / 2.0
                _ = printf("hit %lld %.9g %.9g\n", SceneEscort::hit(&session, x, y), x, y)
            for j in 0..<temple.count |area, session, temple|:
                d: Escort::Device = temple.devices[j.usize()]
                p: SceneEscort::Point = SceneEscort::device_point(area, temple, d)
                _ = printf("hit %lld %.9g %.9g\n", SceneEscort::hit(&session, p.x, p.y), p.x, p.y)
        _ = printf("hit %lld 0 0\n", SceneEscort::hit(&session, 0.0, 0.0))
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneEscort::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneEscort::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 7, 16, 25]:
            for mode in 0..<7 |rung|:
                for dark in 0..<2 |rung, mode|:
                    region scratch(2097152):
                        in scratch:
                            emit(rung, mode, dark != 0)
        return 0.i32()
