# Stateful Sokoban run-controller sweep. The Python side in
# sokoban_game_diff.py instantiates the reference UI controller headlessly and
# compares every exported state (including the full generated board) after
# start, movement, undo, restart, solve/loss, and no-op phase transitions.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/pyset.elisa"
include "../src/tasks/sokoban.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_sokoban.elisa"
include "../src/tasks/sokoban_game.elisa"

# The latest Stage1 backend lowers an explicit region's first block through
# this internal runtime hook. The standalone sweep intentionally includes the
# port's frozen Stage0 runtime so its oracle remains independent of the
# compiler checkout; provide the same source-level bridge here rather than
# changing that shared oracle runtime just for this fixture.
def arena_profile_explicit_create(a: Arena&, r: heap Region&) -> void:
    arena_profile_allocation_event(
        ELISA_PROFILE_ALLOCATION_REGION_CREATE,
        r.cast[uintptr], r.capacity * size_of(uintptr),
        0.uintptr(), 0.usize(), a.cast[uintptr], 0.usize()
    )

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx.usize()] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx.usize()] <- 45
            printr((&buf[idx.usize()]).cast[cstr])

def emit_i64(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

def emit_board(run: SokobanGame::SokobanRun&, cells: i64, field: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        cell: mutable i64 = 0
        while cell < cells |cell, run, field|:
            printr("1" if SokobanGame::cell(run, field, cell) != 0 else "0")
            cell <- cell + 1

def emit_state(run: SokobanGame::SokobanRun&, seed: i64, rung: i64, event: i64):
    can Console.Write, Abort.Panic:
        printr("state")
        emit_i64(seed)
        emit_i64(rung)
        emit_i64(event)
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_PHASE))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_RUNG))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_TRIAL))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_TOTAL_TRIALS))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_PLAYER))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_PUSHES))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_MOVES))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_VERDICT))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_WIDTH))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_HEIGHT))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_PAR))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_MINIMUM))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_AT_LEAST))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_BOUND))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_SOLVED_COUNT))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_LOST_COUNT))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_BEST_RUNG))
        emit_i64(SokobanGame::info(run, SokobanGame::INFO_EFFICIENCY))
        cells: i64 = SokobanGame::info(run, SokobanGame::INFO_WIDTH) * SokobanGame::info(run, SokobanGame::INFO_HEIGHT)
        emit_board(run, cells, SokobanGame::CELL_WALL)
        emit_board(run, cells, SokobanGame::CELL_GOAL)
        emit_board(run, cells, SokobanGame::CELL_TRAP)
        emit_board(run, cells, SokobanGame::CELL_BOX)
        print("")

def main() -> i64:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        for case in 0..<15:
            rung: i64 = 1 + case / 5
            seed: i64 = [0, 1, 7, 17, 42][case % 5]
            run: mutable SokobanGame::SokobanRun = zeroed
            SokobanGame::initialize(&run, rung, 1, false, true, seed)
            emit_state(run, seed, rung, -1)
            SokobanGame::apply(&run, 0, 1000)
            emit_state(run, seed, rung, 0)
            for event in 0..<15:
                # Interleave all directional edges, then undo/restart and a
                # Space no-op during an active puzzle. This exercises pushes,
                # illegal moves, histories, and source phases reproducibly.
                action: i64 = [1, 2, 3, 4, 4, 3, 2, 1, 5, 5, 6, 0, 3, 4, 1][event]
                SokobanGame::apply(&run, action, 1000 + (event + 1) * 1250)
                emit_state(run, seed, rung, event + 1)
            SokobanGame::dispose(&run)
        return 0
