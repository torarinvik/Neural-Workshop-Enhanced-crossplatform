include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/camera_game.elisa"
include "../src/tasks/camera_view.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit_pose(p: Camera::Pose&):
    can Console.Write:
        _ = printf("pose %.17g %.17g %.17g %.17g %.17g\n", p.x, p.y, p.z, p.yaw, p.pitch)

def emit(rung: i64, seed: i64):
    can Memory.Allocate, Abort.Panic, Console.Write:
        rng: mutable MT19937 = mt19937_new()
        mt_seed_int(&rng, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
        scene: Camera::Scene = Camera::deal(rung, &rng)
        level: Camera::Grade = scene.level
        _ = printf("case %lld %lld %lld\n", rung, seed, 1 if scene.valid else 0)
        _ = printf("grade %lld %lld %lld %lld %lld %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g\n",
            level.rung, level.objects, level.kinds, level.occluders, level.anchors, 1 if level.meter else 0,
            level.reach, level.aim, level.field, level.lift, level.tilt, level.start, level.turn)
        if scene.valid:
            emit_pose(&scene.target)
            emit_pose(&scene.start)
            _ = printf("things %lld %lld\n", scene.things.count.i64(), Camera::anchors(&scene.target, &scene.things, level.field))
            view: Camera::Frustum = Camera::frustum(&scene.target)
            for thing in scene.things |view|:
                depth: f64 = Camera::in_frame(&view, RoomsView::vec(thing.x, thing.size / 2.0, thing.z))
                _ = printf("thing %lld %lld %lld %.17g %.17g %.17g %.17g %.17g\n", thing.shape, thing.colour,
                    1 if thing.occluder else 0, thing.x, thing.z, thing.size, thing.spin, depth)
            pose: mutable Camera::Pose = scene.start
            for step in 0..<50 |pose, scene, level|:
                movement: i64 = step % Camera::MOVES
                amount: f64 = 120.0 if step >= 40 else 1.0 / ((step % 4) + 1).f64()
                pose <- Camera::moved(&pose, movement, amount, &level)
                emit_pose(&pose)
                _ = printf("error %.17g %.17g %.17g %lld\n", Camera::distance(&pose, &scene.target),
                    Camera::angle(&pose, &scene.target), Camera::closeness(&pose, &scene.target, &level),
                    1 if Camera::matches(&pose, &scene.target, &level) else 0)
        _ = printf("rng %lld\n", py_getrandbits(&rng, 32).i64())

def free_camera_case(owner: mutable Arena&):
    can Memory.Release, Abort.Panic:
        arena_free(owner) can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}

def emit_result(result: CameraGame::Result&):
    can Console.Write:
        _ = printf("result %lld %lld %.17g %.17g %.17g\n", result.rung, 1 if result.matched else 0,
            result.distance, result.angle, result.seconds)

def session_cases() -> bool:
    can Abort.Panic, Memory.Allocate, Memory.Release, Console.Write:
        session: mutable CameraGame::Session = CameraGame::initialize(8, 3, true, 17)
        return false if not ((CameraGame::start(&session, 0.0) can Global{Read,Write}))
        emit_pose(&session.pose)
        for port in 0..<CameraGame::SUBMIT |session|:
            return false if not ((CameraGame::press(&session, port, 0.0) can Global{Read,Write}))
            emit_pose(&session.pose)
        return false if not (CameraGame::set_peek(&session, true) and session.peek)
        return false if not (CameraGame::set_held(&session, Camera::FORWARD, true))
        return false if not (CameraGame::set_slow(&session, true))
        return false if not ((CameraGame::advance(&session, 0.16) can Global{Read,Write}))
        emit_pose(&session.pose)
        return false if not (CameraGame::clear_controls(&session) and not session.peek)
        return false if (CameraGame::advance(&session, 0.21) can Global{Read,Write})
        return false if not (CameraGame::drag_view(&session, 24.0, -12.0, false))
        emit_pose(&session.pose)
        return false if not (CameraGame::submit(&session, 0.5))
        return false if not (session.phase == CameraGame::JUDGED and session.rung == 7)
        emit_result(&session.results[0])
        return false if (CameraGame::advance(&session, 2.29) can Global{Read,Write})
        return false if not ((CameraGame::advance(&session, 2.31) can Global{Read,Write}))
        return false if not (session.phase == CameraGame::SEARCHING and session.trial == 2)
        emit_pose(&session.pose)
        session.pose <- session.scene.target
        return false if not (CameraGame::submit(&session, 2.75))
        return false if not (session.phase == CameraGame::JUDGED and session.rung == 8)
        emit_result(&session.results[1])
        return false if not ((CameraGame::agent_advance(&session, 2.80) can Global{Read,Write}))
        return false if not (session.phase == CameraGame::JUDGED)
        return false if not ((CameraGame::agent_advance(&session, 2.81) can Global{Read,Write}))
        return false if not (session.phase == CameraGame::SEARCHING and session.trial == 3)
        emit_pose(&session.pose)
        return false if not (CameraGame::submit(&session, 3.5))
        emit_result(&session.results[2])
        return false if not ((CameraGame::advance(&session, 5.31) can Global{Read,Write}))
        return false if not (session.phase == CameraGame::DONE and session.scored == 3 and session.matched == 1 and session.best == 7)
        _ = printf("mean %.17g\n", CameraGame::mean_seconds(&session))
        CameraGame::close(&session) can Global{Read,Write}
        return true

def emit_meshes():
    can Abort.Panic, Memory.Allocate, Console.Write:
        for kind in 0..<8:
            mesh: CameraMesh::Mesh = CameraMesh::build(kind, 18.5)
            _ = printf("mesh %lld %lld %lld\n", kind, mesh.vertices.count.i64(), mesh.indices.count.i64())
            for v in mesh.vertices:
                _ = printf("vertex %.17g %.17g %.17g %.17g %.17g %.17g\n", v.position.x, v.position.y,
                    v.position.z, v.normal.x, v.normal.y, v.normal.z)
            for index in mesh.indices:
                _ = printf("index %lld\n", index.i64())
        for index in 0..<13:
            colour: RoomsView::Vec = CameraMesh::colour(index)
            _ = printf("colour %.17g %.17g %.17g\n", colour.x, colour.y, colour.z)
        for index in 0..<2:
            thing: Camera::Thing = Camera::Thing{shape: 0, colour: 0, x: -7.0, z: 12.0, size: 2.5, spin: 72.0, occluder: index == 1}
            matrix: CameraMesh::Transform = CameraMesh::transform(&thing)
            _ = printf("transform %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g\n",
                matrix.translation.x, matrix.translation.y, matrix.translation.z,
                matrix.scale.x, matrix.scale.y, matrix.scale.z, matrix.cosine, matrix.sine)

def history_check() -> bool:
    can Abort.Panic, Memory.Allocate, Memory.Release:
        session: mutable CameraGame::Session = CameraGame::initialize(1, 35, false, 7)
        if not (CameraGame::start(&session, 0.0) can Global{Read,Write}):
            return false
        for index in 0..<35 |session|:
            now: f64 = index.f64() * 2.0
            return false if not CameraGame::submit(&session, now)
            return false if not (CameraGame::advance(&session, now + 2.0) can Global{Read,Write})
        valid: bool = session.phase == CameraGame::DONE and session.results.count == 35.usize() and session.matched == 0
        valid_restart: bool = CameraGame::start(&session, 71.0) can Global{Read,Write}
        clean: bool = valid and valid_restart and session.results.count == 0.usize() and session.scored == 0
        CameraGame::close(&session) can Global{Read,Write}
        return clean

def emit_matrix(matrix: CameraView::Matrix&):
    can Abort.Panic, Console.Write:
        _ = printf("matrix")
        for item in matrix.column:
            _ = printf(" %.17g", item)
        _ = printf("\n")

def view_cases():
    can Abort.Panic, Console.Write:
        widths: f64[3] = [912.0, 480.0, 1736.0]
        heights: f64[3] = [684.0, 720.0, 960.0]
        field: f64 = 18.5
        pose: Camera::Pose = Camera::Pose{x: 2.0, y: 3.0, z: -7.0, yaw: 37.0, pitch: 28.0}
        for i in 0..<3 |widths, heights, pose, field|:
            live: CameraView::Rect = CameraView::live_rect(widths[i.usize()], heights[i.usize()])
            photo: CameraView::Rect = CameraView::photo_rect(&live)
            _ = printf("rect %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g\n",
                live.left, live.bottom, live.width, live.height, photo.left, photo.bottom, photo.width, photo.height)
            basis: CameraView::Matrix = CameraView::perspective(&pose, live.width.i64().f64() / live.height.i64().f64(), field)
            emit_matrix(&basis)
        light: CameraView::Lighting = CameraView::lighting(field)
        emit_matrix(&light.clip)
        emit_matrix(&light.shadow)
        for i in 0..<2:
            thing: Camera::Thing = Camera::Thing{shape: 2, colour: 4, x: -7.0, z: 12.0, size: 2.5, spin: 72.0, occluder: i == 1}
            draw: CameraView::Draw = CameraView::draw(&thing)
            emit_matrix(&draw.model)
            _ = printf("normal %.17g %.17g %.17g\n", draw.normal_scale.x, draw.normal_scale.y, draw.normal_scale.z)
        outside: CameraView::Draw = CameraView::ground(CameraMesh::OUTSIDE)
        field_draw: CameraView::Draw = CameraView::ground(CameraMesh::FIELD)
        _ = printf("ground %lld %lld %lld %lld\n", outside.mesh, field_draw.mesh, 1 if outside.casts else 0, 1 if field_draw.casts else 0)

def main() -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic, Console.Write:
        return 1.i32() if not (session_cases() can Global{Read,Write})
        return 1.i32() if not (history_check() can Global{Read,Write})
        emit_meshes()
        view_cases()
        rungs: i64[13] = [-1, 1, 3, 4, 5, 6, 8, 12, 20, 27, 40, 75, 1000]
        for rung in rungs:
            for seed in -1..<4 |rung|:
                owner: mutable Arena = zeroed
                in owner:
                    emit(rung, seed)
                free_camera_case(&owner) can Global{Read,Write}
        return 0.i32()
