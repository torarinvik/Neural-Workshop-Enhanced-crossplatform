# Differential sweep driver for tasks/reflex.elisa. See reflex_diff.py for the
# reference side.
#
# The pictures and the placing are the shell's, so what is compared is the
# clock a target lives on, the adaptive life, and the run's score. The adaptive
# life is a MULTIPLICATIVE walk with two different rates and two clamps, so a
# long alternating run of hits and misses is the real check on it -- a single
# step would agree by accident.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/pymath.elisa"
include "../src/tasks/reflex.elisa"

# printr(i64) and int_to_string_scratch both trip a stage1 backend decline of
# store_* generics (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)


def emit_scaled(value: f64):
    can Console.Write, Abort.Panic:
        emit_cell(py_round_half_even(value * 1000000.0))

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(64 * 1024 * 1024)
        in w:
            # A target's clock, across the whole of its life and past the end.
            for life_step in 1..<9:
                lifetime: f64 = life_step.f64() * 0.25
                for tick in 0..<26:
                    now: f64 = 100.0 + tick.f64() * 0.1
                    printr("life")
                    emit_cell(life_step)
                    emit_cell(tick)
                    emit_scaled(Reflex::remaining(100.0, lifetime, now))
                    emit_cell(1 if Reflex::is_gone(100.0, lifetime, now) else 0)
                    print("")
            # A zero lifetime is gone at once rather than dividing by zero.
            printr("life")
            emit_cell(0)
            emit_cell(0)
            emit_scaled(Reflex::remaining(100.0, 0.0, 100.0))
            emit_cell(1 if Reflex::is_gone(100.0, 0.0, 100.0) else 0)
            print("")

            # The hit box, walked across both edges.
            for step in 0..<13:
                x: f64 = 100.0 + step.f64() * 5.0 - 30.0
                printr("box")
                emit_cell(step)
                emit_cell(1 if Reflex::contains(100.0, 50.0, 40.0, x, 50.0) else 0)
                emit_cell(1 if Reflex::contains(100.0, 50.0, 40.0, 100.0, x - 50.0) else 0)
                print("")

            # The adaptive walk. Both clamps are reachable: forty hits bottoms
            # out at the floor, forty misses tops out at base * 2.5.
            for pattern in 0..<4:
                for base_step in 1..<5:
                    base: f64 = base_step.f64() * 0.5
                    run: mutable Reflex::ReflexKernelRun = Reflex::new_run(base, true, 64)
                    printr("adapt")
                    emit_cell(pattern)
                    emit_cell(base_step)
                    for step in 0..<40 |run, pattern|:
                        hit: bool = when pattern:
                            0 -> true
                            1 -> false
                            2 -> step % 2 == 0
                            _ -> step % 3 != 0
                        if hit:
                            Reflex::score_hit(&run, 0.2 + step.f64() * 0.01)
                        else:
                            Reflex::score_miss(&run)
                    emit_scaled(run.lifetime)
                    emit_cell(run.hits)
                    emit_cell(run.misses)
                    emit_cell(Reflex::presented(&run))
                    emit_cell(Reflex::accuracy(&run))
                    emit_cell(Reflex::mean_ms(&run))
                    print("")

            # A run that never adapts, and an empty one.
            steady: mutable Reflex::ReflexKernelRun = Reflex::new_run(1.0, false, 8)
            Reflex::score_hit(&steady, 0.5)
            Reflex::score_miss(&steady)
            printr("steady")
            emit_scaled(steady.lifetime)
            emit_cell(Reflex::accuracy(&steady))
            emit_cell(Reflex::mean_ms(&steady))
            print("")
            empty: mutable Reflex::ReflexKernelRun = Reflex::new_run(1.0, true, 8)
            printr("empty")
            emit_cell(Reflex::presented(&empty))
            emit_cell(Reflex::accuracy(&empty))
            emit_cell(Reflex::mean_ms(&empty))
            print("")
        destroy w
        return 0
