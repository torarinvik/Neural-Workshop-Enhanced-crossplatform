# Differential sweep driver for src/scene_scrabble.elisa.
# See scene_scrabble_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_scrabble.elisa"
include "scene_emit.elisa"

const RACK_LETTERS: cstr = "qjxzkvwe"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|phase|black|size|rack|spent|show_premiums|at|hovered|hovered_tile|hovered_play|down|laid|trial|total_trials|tall|verdict")
        region w(256 * 1024 * 1024)
        in w:
            for spec in 0..<40:
                phase: i64 = spec % 4
                black: bool = spec % 7 == 1
                size: i64 = 5 + (spec / 4) % 4 * 3
                cells: i64 = size * size
                rack: i64 = 2 + (spec / 4) % 7
                # Every tile spent is a real state: the rack goes empty and
                # the status line says so in words.
                spent: i64 = (spec / 4) % (rack + 1)
                show_premiums: bool = spec % 3 != 2
                at: i64 = spec % cells
                hovered: i64 = -1 if spec % 5 == 4 else (at + size + 1) % cells
                hovered_tile: i64 = -1 if spec % 3 == 1 else spec % rack
                hovered_play: bool = spec % 4 == 2
                down: bool = (spec / 4) % 2 == 0
                # Nothing laid means the Play button is drawn dim.
                laid: i64 = (spec / 4) % 4
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(size)
                emit_bar(rack)
                emit_bar(spent)
                emit_bar(1 if show_premiums else 0)
                emit_bar(at)
                emit_bar(hovered)
                emit_bar(hovered_tile)
                emit_bar(1 if hovered_play else 0)
                emit_bar(1 if down else 0)
                emit_bar(laid)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")

                # A board with every premium kind on it, some squares already
                # written and some laid this turn -- a laid tile takes the
                # premium wash away with it, which is its own arm.
                premiums: mutable darray[i64] = []
                letters: mutable darray[i64] = []
                on_board: mutable darray[i64] = []
                for cell in 0..<cells |premiums, letters, on_board, laid|:
                    premiums.push(cell % 5)
                    letters.push(0 if cell % 4 != 3 else 97 + cell % 26)
                    on_board.push(97 + cell % 26 if cell % 9 == 1 and cell / 9 < laid else 0)
                tiles: mutable darray[i64] = []
                used: mutable darray[bool] = []
                for slot in 0..<rack |tiles, used, spent|:
                    tiles.push(sview_at(sview(RACK_LETTERS, 0, -1), (slot % 8).usize()).i64())
                    used.push(slot < spent)

                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneScrabble::Paint = SceneScrabble::paint_of(black, width, height, 2.0, 2.0)
                SceneScrabble::render(&list, &paint, phase, true, size,
                                      &premiums, &letters, &on_board, &tiles,
                                      &used, show_premiums, at, hovered,
                                      hovered_tile, hovered_play, down,
                                      1 + spec % 5, 5,
                                      sview("Rung 3 - seven tiles", 0, -1),
                                      verdict,
                                      sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
