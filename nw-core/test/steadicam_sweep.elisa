include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/steadicam.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# Steadicam against steadicam.py, for steadicam_diff.py: the grade table, the
# dealt parks -- every walker's path, the trees, the cues -- and every step
# of a take: the reference autopilot at nine rungs, nobody at the camera, a
# pan held right, tilting and zooming in turn, and every port in turn.

def player(run: Steadicam::Run&, mode: i64, n: i64) -> i64:
    can Abort.Panic:
        return Steadicam::pilot(run) if mode == 0
        return -1 if mode == 1
        return Steadicam::PAN_R if mode == 2
        if mode == 3:
            script: i64[4] = [Steadicam::TILT_U, Steadicam::ZOOM_IN, Steadicam::TILT_D, Steadicam::ZOOM_OUT]
            return script[((n / 40) % 4).usize()]
        return (n / 25) % 7 - 1

def replay(rung: i64, seed: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(16777216):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                park: Steadicam::Park = Steadicam::deal(rung, &draw)
                _ = printf("park %lld %lld %lld %d %u %lld %.17g %.17g %.17g\n", mode, rung, seed, 1 if park.valid else 0,
                    py_getrandbits(&draw, 32).u32(), park.cues, park.yaw, park.pitch, park.fov)
                for k in 0..<park.level.people |park|:
                    w: Steadicam::Walker& = &park.walkers[k.usize()]
                    _ = printf("walker %lld\n", w.count)
                    for i in 0..<w.count |w|:
                        _ = printf("%.17g %.17g %.17g\n", w.xs[i.usize()], w.zs[i.usize()], w.pace[i.usize()])
                for k in 0..<Steadicam::TREES |park|:
                    _ = printf("tree %.17g %.17g %.17g\n", park.tree_x[k.usize()], park.tree_z[k.usize()], park.tree_r[k.usize()])
                for c in 0..<park.cues |park|:
                    _ = printf("cue %.17g %lld\n", park.cue_at[c.usize()], park.cue_who[c.usize()])
                run: mutable Steadicam::Run = Steadicam::begin(park)
                n: mutable i64 = 0
                while run.result == Steadicam::LIVE |run, mode, n|:
                    port: i64 = player(&run, mode, n)
                    Steadicam::step(&run, 1.0 / 120.0, port)
                    at: Steadicam::Place = Steadicam::place(&run)
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %d %lld %d %.17g %.17g %.17g %.17g\n",
                        port, run.result, run.t, run.yaw, run.pitch, run.fov, run.vyaw, run.vpitch, run.framed, run.counted,
                        run.lost_since if run.lost else -1.0, 1 if Steadicam::in_frame(&run) else 0, Steadicam::whom(&run),
                        1 if run.lost else 0, at.ux, at.uy, at.tall, Steadicam::motion(&run))
                    n <- n + 1
                _ = printf("end %lld %lld %.17g\n", run.result, run.notes.count.i64(), Steadicam::share(&run))
                for cue in run.notes:
                    _ = printf("%lld %lld %.17g\n", cue.seed, cue.voice, cue.t)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in 0..<41:
            g: Steadicam::Grade = Steadicam::grade(rung)
            _ = printf("grade %lld %.17g %.17g %.17g %.17g %.17g %.17g %d %d %d %lld %.17g %.17g %.17g\n", g.rung, g.speed,
                g.wind, g.near, g.box, g.low, g.high, 1 if g.heavy else 0, 1 if g.moods else 0, 1 if g.lead else 0,
                g.people, g.cue, g.seconds, g.need)
        for rung in [1.i64(), 4.i64(), 7.i64(), 10.i64(), 13.i64(), 16.i64(), 20.i64(), 25.i64(), 30.i64()]:
            replay(rung, 17, 0)
        replay(1, 19, 1)
        replay(4, 19, 2)
        replay(10, 19, 3)
        replay(16, 19, 4)
        return 0
