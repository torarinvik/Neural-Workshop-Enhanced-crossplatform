include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/full_stop.elisa"
include "../src/tasks/passage_corpus.elisa"

extern getchar() -> i32 can[Blocking.IO]
extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def read_input() -> dstr:
    can Blocking.IO, Memory.Allocate, Abort.Panic:
        raw: mutable dstr = []
        while true |raw|:
            b: i32 = getchar()
            break if b < 0.i32() or b == 0.i32()
            raw.push(b.u8())
        return raw

def flag(b: bool) -> i64:
    return 1 if b else 0

def emit_machine(candidate: FullStop::Candidate&, rng: mutable MT19937&):
    can Console.Write, Abort.Panic:
        _ = dprintf(1.i32(), "deal %lld %.17g\n", flag(candidate.valid), py_random(rng))
        return if not candidate.valid
        m: FullStop::Machine& = &candidate.machine
        _ = dprintf(1.i32(), "size %lld %.17g\n", m.count, m.seconds)
        for i in 0..<m.count |m|:
            w: Passages::Word = m.words[i.usize()]
            for k in 0..<w.length |w|:
                _ = dprintf(1.i32(), "%c", Passages::letter(w, k).i32())
            _ = dprintf(1.i32(), " %lld\n", flag(m.stops[i.usize()]))

def play(candidate: FullStop::Candidate&, policy: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        return if not candidate.valid
        run: mutable FullStop::Run = FullStop::start(candidate.machine)
        _ = dprintf(1.i32(), "scale %.17g\n", run.layout.scale)
        for i in 0..<run.machine.count |run|:
            tile: FullStop::Tile = run.layout.tiles[i.usize()]
            _ = dprintf(1.i32(), "tile %.17g %.17g %.17g\n", tile.x, tile.y, tile.width)
        if policy == 1:
            tile: FullStop::Tile = run.layout.tiles[0]
            HandView::place(&run.hand, tile.x, tile.y)
            FullStop::act(&run, HandView::PRESS)
            FullStop::act(&run, HandView::PRESS)
            FullStop::act(&run, HandView::RELEASE)
            FullStop::act(&run, HandView::PRESS)
            FullStop::act(&run, HandView::RELEASE)
            FullStop::act(&run, FullStop::RESET)
            last: FullStop::Tile = run.layout.tiles[(run.machine.count - 1).usize()]
            HandView::place(&run.hand, last.x, last.y)
            FullStop::act(&run, HandView::PRESS)
            FullStop::act(&run, HandView::RELEASE)
            HandView::place(&run.hand, tile.x, tile.y)
            FullStop::act(&run, HandView::PRESS)
            FullStop::act(&run, FullStop::DONE)
        elif policy == 2:
            FullStop::step(&run, run.machine.seconds)
        while run.result == FullStop::LIVE |run|:
            port: i64 = FullStop::pilot(&run)
            FullStop::act(&run, port)
            FullStop::step(&run, 1.0 / 60.0)
            _ = dprintf(1.i32(), "tick %lld %.17g %.17g %.17g %lld %lld %lld\n", port, run.t, run.hand.x,
                run.hand.y, flag(run.hand.down), run.count, run.result)
        _ = dprintf(1.i32(), "result %lld %lld %lld\n", run.result, run.missing, run.extra)
        for cue in run.notes:
            _ = dprintf(1.i32(), "cue %.17g %.17g %.17g %lld %.17g %.17g\n",
                cue.t, cue.duration, cue.frequency, cue.voice, cue.gain, cue.pan)

def main() -> i32:
    can Blocking.IO, Console.Write, Memory.Allocate, Abort.Panic:
        custom: bool = getchar() == 1.i32()
        passages: dstr = read_input() if custom else []
        sentences: dstr = read_input() if custom else []
        lexicon: dstr = read_input() if custom else []
        corpus: PassageSeed::Corpus = PassageSeed::from_cache(bytes_view(passages), bytes_view(sentences), bytes_view(lexicon))
        bank: Passages::Bank& = &corpus.bank
        pairs: Passages::Index& = &corpus.pairs
        known: Passages::Index& = &corpus.known
        for rung in [1, 4, 9, 10, 13, 14, 19, 20, 22, 23, 30, 41, 99] |bank, pairs, known|:
            level: FullStop::Grade = FullStop::grade(rung)
            _ = dprintf(1.i32(), "level %lld %lld %lld %lld %lld %.17g\n",
                rung, level.sentences, flag(level.hint), flag(level.flat), flag(level.short), level.pace)
            for seed in 0..<32 |level, bank, pairs, known|:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                candidate: FullStop::Candidate = FullStop::build(level, &draw, bank, pairs, known)
                emit_machine(&candidate, &draw)
            draw: mutable MT19937 = zeroed
            mt_seed_int(&draw, 17.u64())
            screened: FullStop::Candidate = FullStop::deal(rung, &draw, bank, pairs, known)
            emit_machine(&screened, &draw)
            play(&screened, 0)
            if rung == 1:
                play(&screened, 1)
                play(&screened, 2)
        return 0.i32()
