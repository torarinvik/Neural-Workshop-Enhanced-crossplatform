# Differential sweep for gamemode.elisa against neural_workshop/gamemode.py.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "../src/strings.elisa"
include "../src/gamemode.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

def emit_flag(value: bool):
    can Console.Write, Abort.Panic:
        emit_cell(1 if value else 0)

# ---------------------------------------------------------------------------
# Config profiles. Each one is mirrored key for key by gamemode_diff.py, which
# assembles the same values into a real DotDict and assigns it to state.cfg.
# ---------------------------------------------------------------------------

const PROFILE_COUNT: i64 = 4

def back_overrides(profile: i64) -> darray[ModeOverride]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[ModeOverride] = []
        if profile == 0:
            # Stock config.ini: the combination and arithmetic modes start
            # at 1-back because they are much harder.
            out.push(ModeOverride{mode: 4, value: 1})
            out.push(ModeOverride{mode: 5, value: 1})
            out.push(ModeOverride{mode: 6, value: 1})
            out.push(ModeOverride{mode: 7, value: 1})
            out.push(ModeOverride{mode: 8, value: 1})
            out.push(ModeOverride{mode: 9, value: 1})
        if profile == 2:
            # Overrides ON VARIANT MODES, so the lookup answers before the
            # `mode > 127` fall-back ever runs.
            out.push(ModeOverride{mode: 2, value: 5})
            out.push(ModeOverride{mode: 130, value: 9})
            out.push(ModeOverride{mode: 258, value: 4})
            out.push(ModeOverride{mode: 1154, value: 6})
        return out

def ticks_overrides(profile: i64) -> darray[ModeOverride]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[ModeOverride] = []
        if profile == 0:
            out.push(ModeOverride{mode: 4, value: 35})
            out.push(ModeOverride{mode: 5, value: 35})
            out.push(ModeOverride{mode: 6, value: 35})
            out.push(ModeOverride{mode: 7, value: 40})
            out.push(ModeOverride{mode: 8, value: 40})
            out.push(ModeOverride{mode: 9, value: 40})
        if profile == 2:
            out.push(ModeOverride{mode: 130, value: 11})
            out.push(ModeOverride{mode: 514, value: 99})
            out.push(ModeOverride{mode: 1026, value: 77})
        return out

def make_cfg(profile: i64) -> GameCfg:
    can Memory.Allocate, Abort.Panic:
        backs: darray[ModeOverride] = back_overrides(profile)
        ticks: darray[ModeOverride] = ticks_overrides(profile)
        if profile == 1:
            # No per-mode keys at all, and a non-zero crab bonus so the
            # variant arithmetic actually moves.
            return GameCfg{game_mode: 2, back_default: 3, ticks_default: 25,
                bonus_ticks_crab: 7, bonus_ticks_multi2: 2, bonus_ticks_multi3: 4,
                bonus_ticks_multi4: 6, num_trials: 15, num_trials_factor: 2,
                num_trials_exponent: 3, manual: true, hide_text: true,
                skip_title_screen: true, black_background: true,
                back_overrides: backs, ticks_overrides: ticks}
        if profile == 2:
            return GameCfg{game_mode: 2, back_default: 1, ticks_default: 45,
                bonus_ticks_crab: 3, bonus_ticks_multi2: 5, bonus_ticks_multi3: 10,
                bonus_ticks_multi4: 15, num_trials: 25, num_trials_factor: 1,
                num_trials_exponent: 1, manual: false, hide_text: false,
                skip_title_screen: true, black_background: false,
                back_overrides: backs, ticks_overrides: ticks}
        if profile == 3:
            # Degenerate knobs: a zero exponent and factor collapse the session
            # length to NUM_TRIALS, and every bonus is zero.
            return GameCfg{game_mode: 107, back_default: 4, ticks_default: 0,
                bonus_ticks_crab: 1, bonus_ticks_multi2: 0, bonus_ticks_multi3: 0,
                bonus_ticks_multi4: 0, num_trials: 0, num_trials_factor: 0,
                num_trials_exponent: 0, manual: false, hide_text: true,
                skip_title_screen: false, black_background: true,
                back_overrides: backs, ticks_overrides: ticks}
        # Profile 0: stock config.ini.
        return GameCfg{game_mode: 2, back_default: 2, ticks_default: 30,
            bonus_ticks_crab: 0, bonus_ticks_multi2: 5, bonus_ticks_multi3: 10,
            bonus_ticks_multi4: 15, num_trials: 20, num_trials_factor: 1,
            num_trials_exponent: 2, manual: false, hide_text: false,
            skip_title_screen: false, black_background: false,
            back_overrides: backs, ticks_overrides: ticks}

# Mode integers that are NOT in the tables, so default_nback_mode and
# default_ticks are exercised outside the generated set too.
const EXTRA_MODE_COUNT: i64 = 34

def extra_mode_at(index: i64) -> i64:
    0 return if index == 0
    1 return if index == 1
    13 return if index == 2
    19 return if index == 3
    29 return if index == 4
    99 return if index == 5
    108 return if index == 6
    126 return if index == 7
    127 return if index == 8
    128 return if index == 9
    129 return if index == 10
    142 return if index == 11
    255 return if index == 12
    256 return if index == 13
    257 return if index == 14
    383 return if index == 15
    384 return if index == 16
    511 return if index == 17
    512 return if index == 18
    640 return if index == 19
    768 return if index == 20
    769 return if index == 21
    895 return if index == 22
    1023 return if index == 23
    1024 return if index == 24
    1025 return if index == 25
    1151 return if index == 26
    1152 return if index == 27
    1279 return if index == 28
    1280 return if index == 29
    1408 return if index == 30
    1791 return if index == 31
    1792 return if index == 32
    return 2047

# ---------------------------------------------------------------------------
# Sweeps
# ---------------------------------------------------------------------------

# The generated tables, in generation order: index, mode, flags, modalities,
# short name, long name. Names carry commas, so they sit after a '|'.
def sweep_tables(tables: ModeTables&):
    can Console.Write, Abort.Panic:
        count: i64 = tables.entries.count.i64()
        index: mutable i64 = 0
        while index < count |tables, index, count|:
            entry: ModeEntry = tables.entries[index.usize()]
            printr("mo")
            emit_cell(index)
            emit_cell(entry.mode)
            emit_cell(entry.flags.crab)
            emit_cell(entry.flags.multi)
            emit_cell(entry.flags.selfpaced)
            emit_cell(entry.modalities.count.i64())
            modality_index: mutable i64 = 0
            while modality_index < entry.modalities.count.i64() |entry, modality_index|:
                printr(":")
                print_i64(modality_code(entry.modalities[modality_index.usize()]))
                modality_index <- modality_index + 1
            printr("|")
            printr(entry.short_name)
            printr("|")
            printr(entry.long_name)
            print("")
            index <- index + 1

def sweep_orders():
    can Console.Write, Abort.Panic:
        for index in 0..<INPUT_MODALITY_COUNT:
            printr("im")
            emit_cell(index)
            emit_cell(modality_code(input_modality_at(index)))
            print("")
        for index in 0..<STIMULUS_FIELD_COUNT:
            printr("sf")
            emit_cell(index)
            emit_cell(stimulus_field_code(stimulus_field_at(index)))
            print("")

def sweep_defaults(tables: ModeTables&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        table_count: i64 = tables.entries.count.i64()
        total: i64 = table_count + EXTRA_MODE_COUNT
        profile: mutable i64 = 0
        while profile < PROFILE_COUNT |tables, profile, table_count, total|:
            cfg: GameCfg = make_cfg(profile)
            index: mutable i64 = 0
            while index < total |tables, cfg, profile, index, table_count, total|:
                mode: i64 = tables.entries[index.usize()].mode if index < table_count else extra_mode_at(index - table_count)
                printr("nb")
                emit_cell(profile)
                emit_cell(mode)
                emit_cell(default_nback_mode(&cfg, mode))
                print("")
                ticks: TicksResult = default_ticks_checked(&cfg, mode)
                printr("tk")
                emit_cell(profile)
                emit_cell(mode)
                emit_cell(ticks.ticks)
                emit_flag(ticks.is_float)
                print("")
                index <- index + 1
            profile <- profile + 1

def sweep_colors():
    can Console.Write, Abort.Panic:
        # Palette 0 is the stock config: COLOR_1..COLOR_8 plus the two _BLK
        # overrides. Palette 1 drops COLOR_4_BLK and COLOR_8, so the sweep also
        # covers the indices where the reference raises KeyError.
        full: mutable Palette = palette_empty()
        palette_set_color(&full, 1, Rgba{r: 0, g: 0, b: 255, alpha: 255})
        palette_set_color(&full, 2, Rgba{r: 0, g: 255, b: 255, alpha: 255})
        palette_set_color(&full, 3, Rgba{r: 0, g: 255, b: 0, alpha: 255})
        palette_set_color(&full, 4, Rgba{r: 48, g: 48, b: 48, alpha: 255})
        palette_set_color(&full, 5, Rgba{r: 255, g: 0, b: 255, alpha: 255})
        palette_set_color(&full, 6, Rgba{r: 255, g: 0, b: 0, alpha: 255})
        palette_set_color(&full, 7, Rgba{r: 208, g: 208, b: 208, alpha: 255})
        palette_set_color(&full, 8, Rgba{r: 255, g: 255, b: 0, alpha: 255})
        palette_set_blk(&full, 4, Rgba{r: 255, g: 255, b: 255, alpha: 255})
        palette_set_blk(&full, 7, Rgba{r: 64, g: 64, b: 64, alpha: 255})

        sparse: mutable Palette = palette_empty()
        palette_set_color(&sparse, 1, Rgba{r: 0, g: 0, b: 255, alpha: 255})
        palette_set_color(&sparse, 2, Rgba{r: 0, g: 255, b: 255, alpha: 255})
        palette_set_color(&sparse, 3, Rgba{r: 0, g: 255, b: 0, alpha: 255})
        palette_set_color(&sparse, 4, Rgba{r: 48, g: 48, b: 48, alpha: 255})
        palette_set_color(&sparse, 5, Rgba{r: 255, g: 0, b: 255, alpha: 255})
        palette_set_color(&sparse, 6, Rgba{r: 255, g: 0, b: 0, alpha: 255})
        palette_set_color(&sparse, 7, Rgba{r: 208, g: 208, b: 208, alpha: 255})
        palette_set_blk(&sparse, 7, Rgba{r: 64, g: 64, b: 64, alpha: 255})

        for which in [0, 1] |full, sparse|:
            for black in [0, 1] |which, full, sparse|:
                for color in 0..<11 |which, black, full, sparse|:
                    found: ColorLookup = get_color(&full, black == 1, color) if which == 0 else get_color(&sparse, black == 1, color)
                    printr("gc")
                    emit_cell(which)
                    emit_cell(black)
                    emit_cell(color)
                    emit_flag(found.ok)
                    emit_cell(found.rgba.r)
                    emit_cell(found.rgba.g)
                    emit_cell(found.rgba.b)
                    emit_cell(found.rgba.alpha)
                    print("")

        # get_3d_color wraps mod 8 through CPython's floored modulo, so the
        # negative half of this range is the interesting half.
        for color in -12..<21:
            face: Rgba = get_3d_color(color)
            printr("c3")
            emit_cell(color)
            emit_cell(face.r)
            emit_cell(face.g)
            emit_cell(face.b)
            emit_cell(face.alpha)
            print("")

# Mode construction and enforce_standard_mode, over every profile.
def sweep_mode(tables: ModeTables&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        profile: mutable i64 = 0
        while profile < PROFILE_COUNT |tables, profile|:
            base: GameCfg = make_cfg(profile)
            selector: mutable i64 = 0
            while selector < 16 |tables, base, profile, selector|:
                selected: i64 = tables.entries[(selector * 14).usize()].mode if selector < 15 else 1152
                cfg: GameCfg = GameCfg{game_mode: selected, back_default: base.back_default,
                    ticks_default: base.ticks_default, bonus_ticks_crab: base.bonus_ticks_crab,
                    bonus_ticks_multi2: base.bonus_ticks_multi2,
                    bonus_ticks_multi3: base.bonus_ticks_multi3,
                    bonus_ticks_multi4: base.bonus_ticks_multi4,
                    num_trials: base.num_trials, num_trials_factor: base.num_trials_factor,
                    num_trials_exponent: base.num_trials_exponent, manual: base.manual,
                    hide_text: base.hide_text, skip_title_screen: base.skip_title_screen,
                    black_background: base.black_background,
                    back_overrides: base.back_overrides, ticks_overrides: base.ticks_overrides}
                game: mutable Mode = Mode(&cfg)
                printr("md")
                emit_cell(profile)
                emit_cell(game.mode)
                emit_cell(game.back)
                emit_cell(game.ticks_per_trial)
                emit_flag(game.ticks_per_trial_is_float)
                emit_cell(game.num_trials)
                emit_cell(game.num_trials_factor)
                emit_cell(game.num_trials_exponent)
                emit_cell(game.num_trials_total)
                emit_flag(game.manual)
                emit_flag(game.hide_text)
                emit_flag(game.title_screen)
                emit_cell(game.session_number)
                emit_cell(game.trial_number)
                emit_cell(arith_op_code(game.current_operation))
                emit_cell(trial_phase_code(game.phase))
                printr("|")
                printr(mode_short_label(tables, game.mode, game.back))
                print("")

                # enforce_standard_mode after the player switches mode by hand:
                # the level and session length snap back to the defaults for
                # the NEW mode, and the session counter restarts.
                switched: i64 = 2 if selected != 2 else 107
                game.mode <- switched
                game.session_number <- 7
                game.back <- 42
                enforce_standard_mode(&game, &cfg)
                printr("es")
                emit_cell(profile)
                emit_cell(game.mode)
                emit_cell(game.back)
                emit_cell(game.ticks_per_trial)
                emit_flag(game.ticks_per_trial_is_float)
                emit_cell(game.num_trials_total)
                emit_cell(game.session_number)
                printr("|")
                printr(mode_short_label(tables, game.mode, game.back))
                print("")
                selector <- selector + 1
            profile <- profile + 1

# The three per-key dicts a fresh Mode starts with. The port indexes them by
# INPUT_MODALITIES / STIMULUS_FIELDS order instead of by string key, so this
# checks the arrays start where the dicts start -- and, with the `im` / `sf`
# rows above, that the index really does carry the same information as the key.
def sweep_initial_state():
    can Console.Write, Memory.Allocate, Abort.Panic:
        cfg: GameCfg = make_cfg(0)
        game: Mode = Mode(&cfg)
        for index in 0..<INPUT_MODALITY_COUNT |game|:
            printr("in")
            emit_cell(index)
            emit_flag(game.inputs[index.usize()])
            emit_cell((game.input_rts[index.usize()] * 100000.0).i64())
            print("")
        for index in 0..<STIMULUS_FIELD_COUNT |game|:
            printr("cs")
            emit_cell(index)
            emit_cell(game.current_stim[index.usize()])
            print("")

# mode_index: the guard the reference does not have in front of
# short_mode_names[mode].
def sweep_lookup(tables: ModeTables&):
    can Console.Write, Abort.Panic:
        for mode in [2, 3, 107, 130, 258, 514, 770, 1026, 1154, 2025, 0, 1, 13, 128, 1152, 2047] |tables|:
            printr("mi")
            emit_cell(mode)
            emit_flag(mode_index(tables, mode) >= 0)
            print("")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(64 * 1024 * 1024)
        in work:
            tables: ModeTables = ModeTables()
            sweep_tables(&tables)
            sweep_orders()
            sweep_defaults(&tables)
            sweep_colors()
            sweep_mode(&tables)
            sweep_initial_state()
            sweep_lookup(&tables)
        destroy work
        return 0
