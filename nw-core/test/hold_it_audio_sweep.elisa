include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/hold_it_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def main() -> i32:
    can Memory.Allocate, Console.Write, Abort.Panic:
        rungs: i64[5] = [1, 7, 10, 13, 25]
        for scenario in 0..<5 |rungs|:
            ask: HoldIt::Ask = HoldIt::deal(rungs[scenario.usize()], scenario - 2)
            for window in 0..<80 |ask|:
                begin: f64 = window.f64() * 0.117
                end: f64 = begin + 0.117
                data: mutable u8[10400] = zeroed
                length: i64 = HoldItAudio::render(&ask, begin, end, &data[0], 10400)
                for index in 0..<length |data|:
                    _ = printf("%02x", data[index.usize()].i32())
                _ = printf("\n")
        return 0.i32()
