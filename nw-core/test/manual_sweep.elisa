include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/manual_text.elisa"

# Manual's grades, deals, procedures, follow(), reference ports and seeded
# play; manual_diff.py replays the same against manual.py.
extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def flag(value: bool) -> i64:
    return 1 if value else 0

def text(value: dstr&):
    can Console.Write, Abort.Panic:
        for i in 0..<value.count.i64() |value|:
            _ = dprintf(1.i32(), "%02x", value[i.usize()].i32())
        _ = dprintf(1.i32(), "\n")

# The panel: where every control stands, then each lamp and the display.
def emit_panel(tag: cstr, board: Manual::Panel&):
    can Console.Write:
        _ = dprintf(1.i32(), "%s", tag)
        for at in 0..<Manual::controls(&board.level) |board|:
            _ = dprintf(1.i32(), " %lld", Manual::control(board, at))
        for lit in 0..<board.level.lamps |board|:
            _ = dprintf(1.i32(), " %lld", Manual::lamp(board, lit))
        _ = dprintf(1.i32(), " %lld\n", Manual::display(board))

def emit_deal(dealt: Manual::Deal&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        g: Manual::Grade = dealt.level
        _ = dprintf(1.i32(), "grade %lld %lld %lld %lld %lld %lld %lld", g.rung, g.switches, g.knobs, g.buttons, g.lamps, g.steps,
            flag(g.shuffled))
        for at in 0..<g.kind_count |g|:
            _ = dprintf(1.i32(), " %lld", g.kinds[at.usize()])
        _ = dprintf(1.i32(), "\n")
        count: i64 = Manual::controls(&g)
        _ = dprintf(1.i32(), "deal %lld", dealt.seed)
        for lit in 0..<g.lamps |dealt, count|:
            for at in 0..<count |dealt, lit|:
                _ = dprintf(1.i32(), " %lld", dealt.wiring.lamps[(lit * Manual::MOST_CONTROLS + at).usize()])
        for at in 0..<count |dealt|:
            _ = dprintf(1.i32(), " %lld", dealt.wiring.display[at.usize()])
        for at in 0..<g.switches |dealt|:
            _ = dprintf(1.i32(), " %lld", flag(dealt.switches[at.usize()]))
        for at in 0..<g.knobs |dealt|:
            _ = dprintf(1.i32(), " %lld", dealt.knobs[at.usize()])
        for at in 0..<g.switches |dealt|:
            _ = dprintf(1.i32(), " %lld", dealt.switch_slots[at.usize()])
        for at in 0..<g.knobs |dealt|:
            _ = dprintf(1.i32(), " %lld", dealt.knob_slots[at.usize()])
        for at in 0..<g.buttons |dealt|:
            _ = dprintf(1.i32(), " %lld", dealt.button_slots[at.usize()])
        _ = dprintf(1.i32(), "\n")
        words: mutable dstr = []
        ManualText::procedure(&words, dealt)
        text(&words)

def next_state(state: i64) -> i64:
    return (state * 1103515245 + 12345) % 2147483648

# Seeded play: hands on every control, some out of range, and now and
# then a whole port; each step's panel, then what is wrong at the end.
def play(dealt: Manual::Deal&, seed: i64, want: Manual::Panel&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        board: mutable Manual::Panel = Manual::start(dealt)
        rolling: mutable i64 = seed % 2147483648
        for _ in 0..<40 |board, rolling, dealt|:
            rolling <- next_state(rolling)
            draw: i64 = rolling / 128
            kind: i64 = draw % 4
            index: i64 = (draw / 4) % 8 - 1
            moved: mutable bool = false
            if kind == 0:
                moved <- Manual::toggle(&board, index)
            elif kind == 1:
                moved <- Manual::turn(&board, index, 1 if (draw / 32) % 2 == 1 else -1)
            elif kind == 2:
                moved <- Manual::press(&board, index)
            else:
                moved <- Manual::steer(&board, dealt, (draw / 4) % Manual::PORTS)
            _ = dprintf(1.i32(), "hand %lld %lld %lld\n", kind, index, flag(moved))
            emit_panel("panel", &board)
        wrong: mutable dstr = []
        ManualText::mistakes(&wrong, &board, want)
        text(&wrong)

def sample(rung: i64, seed: i64, from_run: bool):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = dprintf(1.i32(), "case %lld %lld %lld\n", rung, seed, flag(from_run))
        dealt: mutable Manual::Deal = zeroed
        if from_run:
            run: mutable MT19937 = zeroed
            mt_seed_int(&run, seed.u64())
            dealt <- Manual::deal(rung, &run)
            _ = dprintf(1.i32(), "after %.17g\n", py_random(&run))
        else:
            dealt <- Manual::deal_seeded(rung, seed)
        emit_deal(&dealt)
        want: Manual::Panel = Manual::follow(&dealt)
        emit_panel("follow", &want)
        _ = dprintf(1.i32(), "log %lld", want.log_count)
        for at in 0..<want.log_count |want|:
            _ = dprintf(1.i32(), " %lld", want.log[at.usize()])
        _ = dprintf(1.i32(), "\n")
        ports: darray[i64] = Manual::reference_ports(&dealt)
        _ = dprintf(1.i32(), "reference %lld", ports.count.i64())
        for port in ports:
            _ = dprintf(1.i32(), " %lld", port)
        _ = dprintf(1.i32(), "\n")
        replay: mutable Manual::Panel = Manual::start(&dealt)
        for port in ports |replay, dealt|:
            _ = Manual::steer(&replay, &dealt, port)
        emit_panel("replayed", &replay)
        none: mutable dstr = []
        ManualText::mistakes(&none, &replay, &want)
        text(&none)
        play(&dealt, seed * 31 + rung, &want)
        _ = dprintf(1.i32(), "end\n")

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region fixtures(268435456)
        in fixtures:
            for rung in 0..<33:
                for seed in [0, 2, 17, 42, 99] |rung|:
                    sample(rung, seed, false)
            for rung in [1, 2, 5, 9, 13, 17, 20, 25, 30]:
                for seed in [5, 2024] |rung|:
                    sample(rung, seed, true)
        destroy fixtures
        return 0.i32()
