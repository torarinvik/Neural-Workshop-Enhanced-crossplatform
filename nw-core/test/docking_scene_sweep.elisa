include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_docking.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read:
        session: mutable DockingGame::Session = DockingGame::initialize(rung, 1, true, 17)
        if mode != 0:
            _ = DockingGame::start(&session, 0.0)
        if mode == 2:
            _ = DockingGame::key(&session, Docking::YAW_R, true)
            for k in 1..<15 |session|:
                _ = DockingGame::advance(&session, k.f64() * 0.125)
            _ = DockingGame::clear_keys(&session)
        if mode == 3:
            session.run.pos <- Docking::Vec{x: 0.04, y: -0.02, z: -0.55}
            session.run.att <- Docking::Vec{x: 0.1, y: 0.0, z: 0.2}
            session.run.fuel <- session.run.approach.fuel * 0.16
        if mode == 4:
            session.run.pos <- Docking::Vec{x: 1.0, y: 0.0, z: 0.0}
            session.run.vel <- Docking::Vec{x: 0.0, y: 0.0, z: 2.0}
            session.run.att <- Docking::Vec{x: 0.3, y: 0.0, z: Docking::station_roll(&session.run) + 0.3}
            _ = DockingGame::advance(&session, 0.0)
        if mode == 5:
            session.run.pos <- Docking::Vec{x: 0.0, y: 0.0, z: -100.0}
            _ = DockingGame::advance(&session, 0.0)
        if mode >= 6:
            session.run.pos <- Docking::Vec{x: 0.0, y: 0.0, z: 0.0}
            session.run.vel <- Docking::Vec{x: 0.0, y: 0.0, z: 0.15}
            session.run.att <- Docking::Vec{x: 0.0, y: 0.0, z: Docking::station_roll(&session.run)}
            _ = DockingGame::advance(&session, 0.0)
            if mode == 7:
                _ = DockingGame::advance(&session, 2.5)
        _ = printf("frame %lld %lld %lld\n", rung, mode, 1 if dark else 0)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneDocking::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneDocking::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 7, 16, 30]:
            for mode in 0..<8 |rung|:
                for dark in 0..<2 |rung, mode|:
                    region scratch(2097152):
                        in scratch:
                            emit(rung, mode, dark != 0)
        return 0.i32()
