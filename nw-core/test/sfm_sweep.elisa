include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_sfm.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, seed: i64):
    can Abort.Panic, Console.Write:
        p: ShapeFromMotion::Puzzle = ShapeFromMotion::deal(rung, seed)
        g: ShapeFromMotion::Grade = p.level
        _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld %.17g %.17g %.17g\n",
            rung, seed, g.rung, p.solid, 1.i64() if p.spin else 0.i64(), p.way, p.count, p.answer, g.dots,
            g.life, g.eye, g.period)
        for i in 0..<p.count |p|:
            _ = printf("%lld\n", p.options[i.usize()] if not p.spin else -1.i64())
        cloud: mutable ShapeFromMotion::Cloud = zeroed
        times: f64[6] = [0.0, 0.017, 0.249, 0.5, 3.333, 0.017]
        for frame in 0..<6 |p, cloud, times, g|:
            ShapeFromMotion::update(&p, times[frame.usize()], &cloud)
            for i in 0..<g.dots |cloud|:
                dot: ShapeFromMotion::Dot = cloud.dots[i.usize()]
                _ = printf("%.17g %.17g %.17g\n", dot.x, dot.y, dot.size)

def paint(run: ShapeFromMotionGame::Run&, dark: bool) -> bool:
    can Memory.Allocate, Abort.Panic:
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneShapeFromMotion::render(&list, run, dark)
        count: mutable i64 = 0
        for i in 0..<list.commands.count |list, count|:
            cmd: Display::DrawCmd = get list.commands[i] else zeroed
            count <- count + 1 if cmd.kind == Display::CMD_RECT and cmd.color == SceneShapeFromMotion::DOT_COLOR
        return count == run.puzzle.level.dots

def replay() -> bool:
    can Console.Write, Memory.Allocate, Abort.Panic:
        run: mutable ShapeFromMotionGame::Run = ShapeFromMotionGame::initialize(12, 2, true, 17)
        return false if not ShapeFromMotionGame::start(&run, 10.0)
        _ = printf("%lld %lld\n", run.puzzle.seed, run.puzzle.answer)
        first: ShapeFromMotion::Dot = run.cloud.dots[0]
        return false if ShapeFromMotionGame::choose(&run, run.puzzle.count, 10.1)
        return false if not ShapeFromMotionGame::advance(&run, 10.4) or run.cloud.dots[0].x == first.x
        return false if not paint(&run, true)
        index: i64 = run.puzzle.answer
        width: f64 = SceneShapeFromMotion::button_width(run.puzzle.count)
        x: f64 = SceneShapeFromMotion::button_left(run.puzzle.count, width, index) + width / 2.0
        return false if SceneShapeFromMotion::hit(&run, x, SceneShapeFromMotion::BOTTOM + 5.0) != index
        return false if not ShapeFromMotionGame::choose(&run, index, 10.4)
        after: f64 = run.cloud.dots[0].x
        return false if ShapeFromMotionGame::advance(&run, 12.899) or run.cloud.dots[0].x != after
        return false if not paint(&run, false)
        return false if not ShapeFromMotionGame::advance(&run, 12.9) or run.trial != 2 or run.rung != 13
        _ = printf("%lld %lld\n", run.puzzle.seed, run.puzzle.answer)
        return false if not ShapeFromMotionGame::agent_event(&run, 13.0, (run.puzzle.answer + 1) % run.puzzle.count)
        return false if not ShapeFromMotionGame::agent_event(&run, 13.02, -1) or run.phase != ShapeFromMotionGame::JUDGED
        return false if not ShapeFromMotionGame::agent_event(&run, 13.04, -1) or run.phase != ShapeFromMotionGame::DONE
        return run.passed == 1 and run.best == 12 and run.rung == 12

def main() -> i32:
    can Abort.Panic, Console.Write, Memory.Allocate:
        for rung in -1..<31:
            for seed in -8..<9 |rung|:
                emit(rung, seed)
        extra: i64[5] = [9, 11, 14, 23, 71]
        for index in 0..<5 |extra|:
            emit(12, extra[index.usize()])
        emit(16, -9223372036854775807 - 1)
        emit(25, 9223372036854775807)
        emit(24, 1073741823)
        return 0.i32() if replay() else 1.i32()
