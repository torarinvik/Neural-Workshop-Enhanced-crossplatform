# Differential sweep driver for src/scene_cookiethief.elisa.
# See scene_cookiethief_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_cookiethief.elisa"
include "scene_emit.elisa"

const ASKED: cstr = "Rung 3, quick hands. Take 6 and get out. She stands in the door for 2 beats first. The golden one is worth 3. Not everyone at the door is her."

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|phase|black|room|quota|notice|opening|limit|jar|eaten|pace|beat|grabbing|reaching|gold_from|gold_taken|at_door|who|trial|total_trials|tall|verdict")
        region w(256 * 1024 * 1024)
        in w:
            for spec in 0..<48:
                phase: i64 = spec % 5
                black: bool = spec % 7 == 1
                room: i64 = 8 + (spec / 5) % 5
                quota: i64 = 4 + (spec / 5) % 4
                notice: i64 = 10 + (spec / 5) % 4 * 5
                opening: i64 = 5 + (spec / 5) % 3 * 5
                limit: i64 = 150 + (spec / 5) % 4 * 40
                jar: i64 = (spec / 5) % (room + 5)
                eaten: i64 = spec % (room + 7)
                pace: i64 = spec % 31
                beat: i64 = spec % 19
                grabbing: bool = spec % 4 == 1
                # A reach under way draws the arm in the jar and a word for it.
                reaching: i64 = 0 if spec % 3 != 2 else 1 + spec % 2
                # -1 is "never offered"; taken and expired are the other two
                # ways the golden one is off the counter.
                gold_from: i64 = -1 if spec % 5 == 4 else beat - spec % 9
                gold_taken: bool = spec % 11 == 10
                # Nobody, coming, and watching -- and every one of the three
                # who it might be.
                at_door: i64 = (spec / 5) % 3
                who: i64 = (spec / 5) % 3
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 3 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(room)
                emit_bar(quota)
                emit_bar(notice)
                emit_bar(opening)
                emit_bar(limit)
                emit_bar(jar)
                emit_bar(eaten)
                emit_bar(pace)
                emit_bar(beat)
                emit_bar(1 if grabbing else 0)
                emit_bar(reaching)
                emit_bar(gold_from)
                emit_bar(1 if gold_taken else 0)
                emit_bar(at_door)
                emit_bar(who)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneCookieThief::Paint = SceneCookieThief::paint_of(black, width, height, 2.0, 2.0)
                SceneCookieThief::render(&list, &paint, phase, true, room,
                                         quota, notice, opening, limit, jar,
                                         eaten, pace, beat, grabbing,
                                         reaching, gold_from, gold_taken,
                                         at_door, who, sview(ASKED, 0, -1),
                                         1 + spec % 5, 5,
                                         sview("Take six and go", 0, -1),
                                         verdict,
                                         sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
