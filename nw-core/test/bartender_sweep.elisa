include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/bartender_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def pcm(run: Bartender::Run&, bank: DrShapeAudio::Bank&, start: f64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region audio(524288):
            in audio:
                bytes: mutable u8[8824] = zeroed
                used: i64 = BartenderAudio::render(run, bank, start, start + 0.1, &bytes[0], 8824)
                _ = printf("audio %.17g\n", start)
                for j in 0..<used |bytes|:
                    _ = printf("%02x", bytes[j.usize()].i32())
                _ = printf("\n")

def orders(night: Bartender::Night&):
    can Console.Write, Abort.Panic, Memory.Allocate:
        for i in 0..<night.orders.count.i64() |night|:
            o: Bartender::Order = night.orders[i.usize()]
            _ = printf("%lld %lld %lld %d %d %.17g %.17g\n", o.seat, o.hat, o.recipe.drink, 1 if o.recipe.double else 0,
                1 if o.recipe.ice else 0, o.arrive, o.leave)
            message: mutable dstr = []
            Bartender::order_text(&message, &o, &night.level)
            for j in 0..<message.count.i64() |message|:
                _ = printf("%c", message[j.usize()].i32())
            _ = printf("\n")

def setup(run: mutable Bartender::Run&, mode: i64):
    can Abort.Panic:
        return if mode == 0
        order: Bartender::Order = run.night.orders[0]
        run.strikes <- run.night.level.strikes - 1 if mode != Bartender::UNSERVED
        if mode == Bartender::SPILT:
            q: RoomsView::Vec = HandView::see(&run.camera, Bartender::glass_at(0.0))
            HandView::place(&run.hand, q.x, q.y)
            run.hand.down <- true
            run.held <- 0
            run.level_in <- 1.04
        elif mode == Bartender::FLOOR:
            run.glass_x <- Bartender::END
            run.sliding <- true
            run.slide_to <- Bartender::END + 1.0
            run.slide_speed <- 3.0
        elif mode == Bartender::WALKOUT or mode == Bartender::UNSERVED:
            run.time <- order.leave
        else:
            run.time <- order.arrive if mode == Bartender::WRONG_DRINK
            run.glass_x <- Bartender::seat_at(order.seat)
            run.sliding <- true
            run.slide_to <- run.glass_x
            run.slide_speed <- 3.0

def replay(rung: i64, seed: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(2097152):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                night: mutable Bartender::Night = zeroed
                if not Bartender::deal(&night, rung, &draw):
                    _ = printf("deal failed %lld %lld\n", rung, seed)
                    return
                _ = printf("night %lld %lld %lld %lld %u\n", mode, rung, seed, night.seed, py_getrandbits(&draw, 32).u32())
                orders(&night)
                run: mutable Bartender::Run = Bartender::begin(night)
                setup(&run, mode)
                while run.result == Bartender::LIVE |run, mode|:
                    port: i64 = Bartender::pilot(&run) if mode == 0 else -1
                    Bartender::act(&run, port)
                    Bartender::step(&run, 1.0 / 60.0)
                    _ = printf("%lld %lld %.17g %.17g %d %.17g %lld %lld %lld %.17g %.17g %lld %d %lld %.17g %d",
                        port, run.result, run.hand.x, run.hand.y, 1 if run.hand.down else 0, run.time,
                        run.served, run.gone, run.strikes, run.glass_x, run.level_in, run.drink, 1 if run.ice else 0,
                        run.held, Bartender::was(&run), 1 if run.sliding else 0)
                    if run.sliding:
                        _ = printf(" %.17g %.17g", run.slide_to, run.slide_speed)
                    _ = printf("\n")
                _ = printf("notes %lld\n", run.notes.count.i64())
                for cue in run.notes:
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g %.17g\n",
                        cue.seed, cue.voice, cue.t, cue.dur, cue.freq, cue.gain, cue.pan)
                bank: DrShapeAudio::Bank = BartenderAudio::patches()
                pcm(&run, &bank, 0.0)
                pcm(&run, &bank, 1.2)
                pcm(&run, &bank, run.time - 0.04)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in 0..<81:
            g: Bartender::Grade = Bartender::grade(rung)
            _ = printf("grade %lld %lld %lld %d %d %d %d %lld %.17g\n", g.rung, g.customers, g.bottles,
                1 if g.doubles else 0, 1 if g.ice else 0, 1 if g.pewter else 0, 1 if g.usual else 0, g.strikes, g.patience)
        region generation(524288):
            in generation:
                night: mutable Bartender::Night = zeroed
                Bartender::build(&night, Bartender::grade(1000), 19.u64())
                orders(&night)
        for rung in [1.i64(), 4.i64(), 7.i64(), 10.i64(), 13.i64(), 16.i64(), 20.i64(), 25.i64(), 30.i64()]:
            replay(rung, 17, 0)
        for mode in 2..<8:
            replay(1, 19, mode)
        return 0
