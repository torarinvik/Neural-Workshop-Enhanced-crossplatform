include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_balance.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def state(run: Balance::Trial&):
    can Console.Write:
        _ = printf("%.17g %.17g %.17g %.17g %.17g %lld %.17g %lld %lld\n", run.time, run.x, run.velocity,
            run.theta, run.omega, run.flag, run.still, run.result, run.pushing)

def emit(rung: i64, seed: i64):
    can Abort.Panic, Console.Write:
        course: Balance::Course = Balance::deal(rung, seed)
        _ = printf("%lld %lld %lld %lld %.17g %.17g %.17g %.17g %.17g\n", rung, seed, course.level.count,
            course.gust_seed, course.level.length, course.level.gusts, course.level.seconds, course.change_at, course.changed_length)
        for i in 0..<course.level.count |course|:
            _ = printf("%.17g ", course.flags[i.usize()])
        _ = printf("\n")
        run: mutable Balance::Trial = Balance::trial(course)
        for i in 0..<120 |run|:
            port: i64 = Balance::RIGHT if i % 17 < 8 else (Balance::COAST if i % 17 < 12 else Balance::LEFT)
            Balance::step(&run, 1.0 / 120.0, port)
            state(&run)
        replay: Balance::Trial = Balance::play(course)
        state(&replay)

def main() -> i32:
    can Abort.Panic, Console.Write, Memory.Allocate:
        for r in 0..<35:
            for seed in -2..<3 |r|:
                emit(r, seed)
        emit(25, -9223372036854775807 - 1)
        emit(25, 9223372036854775807)
        session: mutable BalanceGame::Session = BalanceGame::initialize(4, 2, true, 17)
        return 1.i32() if not BalanceGame::input(&session, BalanceGame::START, 0.0)
        return 2.i32() if not BalanceGame::input(&session, Balance::RIGHT, 0.0)
        return 3.i32() if not BalanceGame::input(&session, Balance::LEFT, 0.0)
        return 4.i32() if not BalanceGame::advance(&session, 0.05) or session.run.pushing != -1
        return 5.i32() if not BalanceGame::input(&session, BalanceGame::LEFT_UP, 0.05)
        return 6.i32() if not BalanceGame::advance(&session, 0.10) or session.run.pushing != 1
        return 7.i32() if not BalanceGame::input(&session, BalanceGame::CLEAR, 0.10)
        return 8.i32() if not BalanceGame::advance(&session, 0.15) or session.run.pushing != 0
        return 9.i32() if not BalanceGame::agent_event(&session, 0.15, Balance::LEFT)
        return 10.i32() if not BalanceGame::agent_event(&session, 0.20, -1) or session.run.pushing != -1
        return 11.i32() if not BalanceGame::agent_event(&session, 0.25, -1) or session.run.pushing != 0
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneBalance::render(&list, &session, false)
        return 12.i32() if Display::encode_binary(&list).count < 1000.usize()
        course: Balance::Course = Balance::deal(1, 17)
        buffer: mutable Balance::Trial = Balance::trial(course)
        buffer.x <- 0.61
        buffer.theta <- 0.0
        buffer.velocity <- -2.0
        Balance::step(&buffer, 0.02, Balance::COAST)
        return 13.i32() if buffer.result != Balance::BUFFER
        timeout: mutable Balance::Trial = Balance::trial(course)
        timeout.theta <- 0.0
        timeout.time <- course.level.seconds - 0.01
        Balance::step(&timeout, 0.02, Balance::COAST)
        return 14.i32() if timeout.result != Balance::TIMEOUT
        win: mutable Balance::Trial = Balance::trial(course)
        win.theta <- 0.0
        win.flag <- course.level.count - 1
        win.x <- course.flags[win.flag.usize()]
        win.still <- 0.99
        Balance::step(&win, 0.02, Balance::COAST)
        return 15.i32() if win.result != Balance::PASSED or win.flag != course.level.count
        return 0.i32()
