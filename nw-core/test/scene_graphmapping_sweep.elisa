# Differential sweep driver for src/scene_graphmapping.elisa.
# See scene_graphmapping_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_graphmapping.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|phase|black|nodes|edges|trial|total_trials|right|tall|verdict")
        region w(256 * 1024 * 1024)
        in w:
            for spec in 0..<50:
                max_state: bool = spec >= 40
                extra: i64 = spec - 40 if max_state else 0
                phase: i64 = extra % 5 if max_state else spec % 5
                black: bool = extra >= 5 if max_state else spec % 7 == 1
                nodes: i64 = 16 if max_state else 4 + (spec / 5) % 8
                edges: i64 = 29 if max_state else (spec / 5) % (nodes + 3)
                alternate: i64 = extra if max_state else spec
                tall: i64 = 1368 if alternate % 2 == 0 else 960
                verdict: i64 = ((1 if extra < 5 else 0) if max_state else (spec % 3) - 1) if phase == 3 else -1
                trial: i64 = 1 + extra % 5 if max_state else 1 + spec % 5
                total_trials: i64 = 5
                right: i64 = extra % 4 if max_state else spec % 4
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(nodes)
                emit_bar(edges)
                emit_bar(trial)
                emit_bar(total_trials)
                emit_bar(right)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                # The two panels are NOT the same graph and NOT the same
                # layout, because the whole task is telling them apart.
                left_edges: mutable darray[SceneGraphMapping::Edge] = []
                right_edges: mutable darray[SceneGraphMapping::Edge] = []
                for one in 0..<edges |left_edges, right_edges, nodes|:
                    left_edges.push(SceneGraphMapping::Edge{
                        first: one % nodes, second: (one * 3 + 1) % nodes})
                    right_edges.push(SceneGraphMapping::Edge{
                        first: (one * 2) % nodes, second: (one + 2) % nodes})
                left_spots: mutable darray[SceneGraphMapping::GraphMappingPoint] = []
                right_spots: mutable darray[SceneGraphMapping::GraphMappingPoint] = []
                for node in 0..<nodes |left_spots, right_spots|:
                    left_spots.push(SceneGraphMapping::GraphMappingPoint{
                        x: 0.09 + 0.1 * (node % 9).f64(),
                        y: 0.11 + 0.09 * (node % 8).f64()})
                    right_spots.push(SceneGraphMapping::GraphMappingPoint{
                        x: 0.13 + 0.08 * (node % 7).f64(),
                        y: 0.17 + 0.11 * (node % 6).f64()})
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneGraphMapping::GraphMappingPaint = SceneGraphMapping::paint_of(black, width, height, 2.0, 2.0)
                SceneGraphMapping::render(&list, &paint, phase, nodes,
                                          &left_edges, &right_edges,
                                          &left_spots, &right_spots,
                                          trial, total_trials, right,
                                          sview("The same network?", 0, -1),
                                          verdict,
                                          sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
