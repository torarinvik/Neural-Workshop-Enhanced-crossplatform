# Differential sweep driver for src/scene_monkeyladder.elisa.
# See scene_monkeyladder_diff.py for the reference side, which builds the real
# pyglet screen headless and reads back what it drew.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/display.elisa"
include "../src/scene_monkeyladder.elisa"
include "scene_emit.elisa"

# `Click 1 through %d`, and the two fixed messages either side of it.
def message_for(out: mutable dstr&, phase: i64, count: i64):
    can Memory.Allocate, Abort.Panic:
        if phase == SceneMonkeyLadder::PHASE_SHOW:
            dstr_append_cstr(out, "Remember the order")
            return
        if phase == SceneMonkeyLadder::PHASE_INPUT:
            dstr_append_cstr(out, "Click 1 through ")
            dstr_append_i64(out, count)
            return
        dstr_append_cstr(out, "Press Space to watch the numbers")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            width: f64 = 1824.0
            height: f64 = 1368.0
            print("names|spec|grid|seed|level|phase|black|clicked_upto|wrong|cursor_cell|cursor_enabled|reveal|count")
            for spec in 0..<30 |width, height|:
                grid: i64 = 3 + spec % 4
                cells: i64 = grid * grid
                level: mutable i64 = 2 + spec % 7
                level <- cells if level > cells
                seed: i64 = 7000 + spec * 13
                phase: i64 = spec % 4
                black: bool = spec % 5 == 4
                clicked_upto: i64 = spec % (level + 1)
                wrong: i64 = -1 if spec % 7 != 3 else (spec * 5) % cells
                cursor_cell: i64 = (spec * 3) % cells
                cursor_enabled: bool = spec % 3 != 0
                reveal: bool = spec % 2 == 0

                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, seed.u64())
                sequence: mutable darray[i64] = py_sample_range(&rng, 0, cells - 1, level)

                printr("spec|")
                print_i64(spec)
                emit_bar(grid)
                emit_bar(seed)
                emit_bar(level)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(clicked_upto)
                emit_bar(wrong)
                emit_bar(cursor_cell)
                emit_bar(1 if cursor_enabled else 0)
                emit_bar(1 if reveal else 0)
                emit_bar(level)
                print("")

                message: mutable dstr = []
                message_for(&message, phase, level)
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneMonkeyLadder::MonkeyLadderPaint = SceneMonkeyLadder::paint_of(black, width, height, 2.0, 2.0)
                SceneMonkeyLadder::render(&list, &paint, &sequence, level, grid,
                                          phase, level, clicked_upto, wrong,
                                          cursor_cell, cursor_enabled, reveal,
                                          bytes_view(message))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
