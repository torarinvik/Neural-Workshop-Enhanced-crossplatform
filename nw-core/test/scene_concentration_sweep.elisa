# Differential sweep driver for src/scene_concentration.elisa.
# See scene_concentration_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pymath.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_concentration.elisa"
include "scene_emit.elisa"

const IMAGE_COUNT: i64 = 3

def image_width_of(which: i64) -> i64:
    if which == 0:
        return 64
    elif which == 1:
        return 200
    return 37

def image_height_of(which: i64) -> i64:
    if which == 0:
        return 64
    elif which == 1:
        return 50
    return 91

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|black|medium|pairs|turns|show_turns|tall|verdict")
            for spec in 0..<40:
                black: bool = spec % 7 == 1
                medium: i64 = spec % 2
                # Every board size from two pairs to fifteen: the column
                # count is a rounded square root walked down while a row
                # would be empty, so a size that lands on the walk is where a
                # wrong rounding shows.
                pairs: i64 = 2 + (spec / 2) % 14
                turns: i64 = spec % 23
                show_turns: bool = spec % 5 != 4
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if spec % 11 == 3 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(1 if black else 0)
                emit_bar(medium)
                emit_bar(pairs)
                emit_bar(turns)
                emit_bar(1 if show_turns else 0)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                cards: mutable darray[SceneConcentration::SceneConcentrationCard] = []
                for index in 0..<(pairs * 2) |cards|:
                    which: i64 = index % IMAGE_COUNT
                    cards.push(SceneConcentration::SceneConcentrationCard{
                        # All three fills appear on every board: matched,
                        # face up, and face down.
                        face_up: index % 3 == 1,
                        matched: index % 3 == 2,
                        index: index / 2,
                        asset: which,
                        image_width: image_width_of(which),
                        image_height: image_height_of(which)})
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneConcentration::SceneConcentrationPaint = SceneConcentration::paint_of(black, width, height, 2.0, 2.0)
                SceneConcentration::render(&list, &paint, medium, &cards,
                                           pairs, turns, show_turns,
                                           sview("Find the pairs", 0, -1),
                                           verdict,
                                           sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
