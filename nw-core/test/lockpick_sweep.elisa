include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/lockpick_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def pcm(run: LockPick::Run&, bank: DrShapeAudio::Bank&, start: f64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region audio(524288):
            in audio:
                bytes: mutable u8[8824] = zeroed
                used: i64 = LockPickAudio::render(run, bank, start, start + 0.1, &bytes[0], 8824)
                _ = printf("audio %.17g\n", start)
                for j in 0..<used |bytes|:
                    _ = printf("%02x", bytes[j.usize()].i32())
                _ = printf("\n")

def replay(rung: i64, seed: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(2097152):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                lock: LockPick::Lock = LockPick::deal(rung, &draw)
                _ = printf("lock %lld %lld %lld %lld %d %u\n", mode, rung, seed, lock.seed, 1 if lock.valid else 0, py_getrandbits(&draw, 32).u32())
                for i in 0..<lock.level.pins |lock|:
                    _ = printf("%.17g %lld\n", lock.heights[i.usize()], lock.order[i.usize()])
                run: mutable LockPick::Run = LockPick::begin(lock)
                if mode == 3:
                    run.set_count <- 1
                    run.tension <- 0.55
                    run.hand.down <- true
                    HandView::place(&run.hand, LockPick::pin_x(lock.order[1]), LockPick::FLOOR + LockPick::LIFT)
                elif mode == 4:
                    pin: i64 = lock.order[1]
                    run.hand.down <- true
                    HandView::place(&run.hand, LockPick::pin_x(pin),
                        LockPick::FLOOR + LockPick::LIFT * (1.0 - lock.heights[pin.usize()]))
                while run.result == LockPick::LIVE |run, mode|:
                    port: i64 = LockPick::pilot(&run) if mode == 0 else (LockPick::TENSION if mode == 1 else -1)
                    LockPick::act(&run, port)
                    LockPick::step(&run, 1.0 / 60.0)
                    _ = printf("%lld %lld %.17g %.17g %d %.17g %.17g %.17g %lld %lld %.17g %lld",
                        port, run.result, run.hand.x, run.hand.y, 1 if run.hand.down else 0, run.time,
                        run.tension, run.tension_until, run.set_count, run.slips, run.at_height, run.under)
                    for i in 0..<run.lock.level.pins |run|:
                        _ = printf(" %.17g %d", run.lifts[i.usize()], 1 if run.fooled[i.usize()] else 0)
                    _ = printf("\n")
                _ = printf("notes %lld\n", run.notes.count.i64())
                for cue in run.notes:
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g %.17g\n",
                        cue.seed, cue.voice, cue.t, cue.dur, cue.freq, cue.gain, cue.pan)
                bank: DrShapeAudio::Bank = LockPickAudio::patches()
                pcm(&run, &bank, 0.0)
                pcm(&run, &bank, 1.2)
                pcm(&run, &bank, run.time - 0.04)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in 0..<81:
            g: LockPick::Grade = LockPick::grade(rung)
            _ = printf("grade %lld %lld %.17g %.17g %.17g %d %d %d %d %d %.17g\n",
                g.rung, g.pins, g.fine, g.low, g.high, 1 if g.ordered else 0, 1 if g.glow else 0,
                1 if g.tone else 0, 1 if g.false_click else 0, 1 if g.hidden else 0, g.seconds)
        for rung in [1.i64(), 4.i64(), 7.i64(), 10.i64(), 13.i64(), 16.i64(), 20.i64(), 25.i64(), 30.i64(), 80.i64()]:
            replay(rung, 17, 0)
        replay(1, 19, 1)
        replay(1, 19, 2)
        replay(1, 19, 3)
        replay(10, 19, 4)
        return 0
