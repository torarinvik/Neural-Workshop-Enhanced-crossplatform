# Differential sweep driver for src/scene_recognition.elisa.
# See scene_recognition_diff.py for the reference side.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_recognition.elisa"
include "scene_emit.elisa"

const IMAGE_COUNT: i64 = 3

def image_width_of(which: i64) -> i64:
    if which == 0:
        return 64
    elif which == 1:
        return 200
    return 37

def image_height_of(which: i64) -> i64:
    if which == 0:
        return 64
    elif which == 1:
        return 50
    return 91

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|medium|asset|index|trials|tall|verdict")
            for spec in 0..<36:
                # The phase is the SLOW knob and the medium the fast one, so
                # every pairing of the two appears -- including a picture in
                # the hidden phase, which is the branch where the stage goes
                # blank and only the buttons are left.
                phase: i64 = (spec / 2) % 4
                black: bool = spec % 7 == 1
                # Sounds and pictures do NOT behave alike: a sound's plate
                # stays up through the hidden phase and a picture does not.
                medium: i64 = spec % 2
                asset: i64 = (spec / 2) % IMAGE_COUNT
                # The counter is `min(index + 1, trials)` and `current()` is
                # None once the index runs off the end, so the sweep carries
                # both -- but MOST frames must land inside the run, or the
                # stage is never drawn at all. A first attempt had trials
                # running 0..4 against an index of 0..5 and never once drew a
                # picture; the suite passed and checked nothing.
                index: i64 = spec % 7
                # Inside the run almost always -- a first attempt swept the
                # two against each other and landed outside it four frames
                # out of five, so the stage was drawn three times in the whole
                # suite. The out-of-range arm is now its own case.
                trials: i64 = index if spec % 9 == 8 else 7
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 3 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(medium)
                emit_bar(asset)
                emit_bar(index)
                emit_bar(trials)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneRecognition::RecognitionPaint = SceneRecognition::paint_of(black, width, height, 2.0, 2.0)
                SceneRecognition::render(&list, &paint, phase, medium,
                                         asset,
                                         image_width_of(asset),
                                         image_height_of(asset),
                                         index, trials,
                                         sview("Seen it, or new?", 0, -1),
                                         verdict,
                                         sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
