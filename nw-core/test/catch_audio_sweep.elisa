include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/catch_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(court: Catch::Court&, begin: f64):
    can Memory.Allocate, Abort.Panic, Console.Write:
        pcm: mutable u8[9000] = zeroed
        length: i64 = CatchAudio::render(court, begin, begin + 0.093, &pcm[0], 9000)
        for i in 0..<length |pcm|:
            _ = printf("%02x", pcm[i.usize()].i32())
        _ = printf("\n")

def main() -> i32:
    can Memory.Allocate, Abort.Panic, Console.Write:
        for rung in 1..<26:
            continue if (rung - 1) % 6 != 0
            court: Catch::Court = Catch::deal(rung, 17)
            for i in 0..<160 |court|:
                emit(&court, i.f64() * 0.117)
        return 0.i32()
