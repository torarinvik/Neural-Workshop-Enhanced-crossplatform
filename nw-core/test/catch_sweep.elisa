include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_catch.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def report(run: Catch::Run&):
    can Abort.Panic, Console.Write:
        _ = printf("%.17g %lld %lld %lld", run.time, run.caught, run.missed, run.result)
        baskets: i64 = 2 if run.court.level.two else 1
        for i in 0..<baskets |run|:
            p: Catch::Point = run.baskets[i.usize()]
            _ = printf(" %.17g %.17g", p.x, p.z)
        for i in 0..<run.court.level.count |run|:
            _ = printf(" %lld", run.fate[i.usize()])
        _ = printf("\n")

def emit(rung: i64, seed: i64):
    can Abort.Panic, Console.Write:
        court: Catch::Court = Catch::deal(rung, seed)
        _ = printf("%lld %lld %lld\n", rung, seed, court.level.count)
        for i in 0..<court.level.count |court|:
            b: Catch::Ball = court.balls[i.usize()]
            _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %lld\n",
                b.t0, b.x0, b.vx, b.vy, b.vz, b.ax, b.flight, b.land.x, b.land.z, b.colour)
            for j in 0..<5 |court, b|:
                p: Catch::Position = Catch::where(b, b.t0 + b.flight * j.f64() / 4.0, court.level.walls)
                _ = printf("%.17g %.17g %.17g\n", p.x, p.y, p.z)
        run: mutable Catch::Run = Catch::trial(court)
        for i in 0..<3 |run|:
            run.time <- 2.3 * i.f64()
            lens: SceneCatch::Lens = SceneCatch::lens(&run)
            p: RoomsView::Vec = SceneCatch::see(&lens, -3.5, 0.6, 12.0)
            _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g\n", lens.focal, lens.cx, lens.cy, p.x, p.y, p.z)
        run.time <- 0.0
        for tick in 0..<1440 |run|:
            if tick % 90 == 0:
                Catch::aim(&run, (tick / 90 % 9 - 4).f64() * 2.5, (tick / 90 % 8).f64() * 2.5)
            Catch::step(&run, 1.0 / 120.0, 1 << (tick / 20 % 8).u64())
            if tick % 80 == 79:
                report(&run)
        run <- Catch::trial(court)
        while run.result == Catch::PENDING |run|:
            Catch::step(&run, 1.0 / 60.0, Catch::pilot(&run))
        report(&run)

def session_check() -> bool:
    can Memory.Allocate, Abort.Panic:
        session: mutable CatchGame::Session = CatchGame::initialize(20, 1, true, 17)
        return false if not CatchGame::start(&session, 0.0)
        _ = CatchGame::advance(&session, 0.1)
        view: SceneCatch::Lens = SceneCatch::lens(&session.run)
        target: RoomsView::Vec = SceneCatch::see(&view, -1.0, 0.0, 9.0)
        return false if not SceneCatch::pointer(&session, target.x, target.y)
        return false if not session.run.aimed[1] or session.run.aimed[0]
        aim: Catch::Point = session.run.aim[1]
        return false if py_hypot(aim.x + 1.0, aim.z - 9.0) > 0.000000001
        _ = CatchGame::agent_event(&session, 0.1, 0)
        _ = CatchGame::agent_event(&session, 0.1, 3)
        _ = CatchGame::agent_event(&session, 0.2, -1)
        red: Catch::Point = session.run.baskets[0]
        return false if red.x >= -3.0 or red.z <= 6.0 or session.pulse != 0
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneCatch::render(&list, &session, false)
        pcm: mutable u8[4096] = zeroed
        return list.commands.count > 300.usize() and CatchGame::audio_window(&session, &pcm[0], 4096) == 4096

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Console.Write:
        return 1.i32() if not session_check()
        for rung in -1..<35:
            for seed in -1..<2 |rung|:
                emit(rung, seed)
        emit(30, -9223372036854775807 - 1)
        emit(65, 9223372036854775807)
        return 0.i32()
