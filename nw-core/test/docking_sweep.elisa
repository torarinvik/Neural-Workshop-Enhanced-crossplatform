include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/docking_game.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def approach(ap: Docking::Approach&):
    can Console.Write:
        g: Docking::Grade = ap.level
        _ = dprintf(1.i32(), "grade %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g %lld %.17g %.17g %.17g %.17g\n",
            g.rung, g.lateral_x, g.lateral_y, g.drift, g.far, g.nose, g.spin, g.station, 1 if g.readouts else 0,
            g.tol, g.vmax, g.angle, g.slack)
        _ = dprintf(1.i32(), "approach %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g\n",
            ap.pos.x, ap.pos.y, ap.pos.z, ap.vel.x, ap.vel.y, ap.vel.z, ap.att.x, ap.att.y, ap.att.z,
            ap.spin.x, ap.spin.y, ap.spin.z, ap.roll0, ap.fuel)

def state(run: Docking::Run&, mask: i64):
    can Console.Write:
        _ = dprintf(1.i32(), "tick %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %lld %lld\n",
            mask, run.t, run.pos.x, run.pos.y, run.pos.z, run.vel.x, run.vel.y, run.vel.z,
            run.att.x, run.att.y, run.att.z, run.spin.x, run.spin.y, run.spin.z, run.fuel,
            Docking::station_roll(run), Docking::roll_error(run), run.result, run.problems)

def cases(rung: i64, seed: i64, mode: i64):
    can Abort.Panic, Console.Write:
        _ = dprintf(1.i32(), "case %lld %lld %lld\n", rung, seed, mode)
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, seed.u64())
        if mode == 0:
            for _ in 0..<3 |rung, rng|:
                ap: Docking::Approach = Docking::build(Docking::grade(rung), &rng)
                approach(&ap)
            return
        ap: mutable Docking::Approach = Docking::build(Docking::grade(rung), &rng)
        if mode == 1:
            deal: DockingReference::Deal = DockingReference::deal_seed(rung, seed)
            if not deal.valid:
                _ = dprintf(1.i32(), "no deal\n")
                return
            ap <- deal.approach
        approach(&ap)
        run: mutable Docking::Run = Docking::start(ap)
        if mode == 3:
            run.pos <- Docking::Vec{x: 1.0, y: 0.0, z: 0.0}
            run.vel <- Docking::Vec{x: 0.0, y: 0.0, z: 2.0}
            run.att <- Docking::Vec{x: 0.3, y: 0.0, z: Docking::station_roll(&run) + 0.3}
        if mode == 4:
            run.pos <- Docking::Vec{x: 0.0, y: 0.0, z: -ap.level.far - 16.0}
        tick: mutable i64 = 0
        while run.result == Docking::LIVE and (mode != 2 or tick < 600) |run, mode, tick|:
            mask: mutable i64 = 0
            if mode == 1:
                mask <- DockingReference::mask(DockingReference::choose(&run))
            if mode == 2:
                pattern: i64 = (tick / 37) % 4
                mask <- 1041 if pattern == 1 else 288 if pattern == 2 else 4095 if pattern == 3 else 0
            Docking::step(&run, 1.0 / 30.0, mask)
            state(&run, mask)
            tick <- tick + 1

def session_trace() -> i32:
    can Abort.Panic:
        session: mutable DockingGame::Session = DockingGame::initialize(4, 3, true, 17)
        return 1.i32() if not DockingGame::agent_event(&session, 0.0, DockingGame::START)
        _ = DockingGame::key(&session, Docking::FORE, true)
        _ = DockingGame::key(&session, Docking::LEFT, true)
        return 2.i32() if DockingGame::control(&session) != Docking::LEFT
        _ = DockingGame::key(&session, Docking::LEFT, false)
        return 3.i32() if DockingGame::control(&session) != Docking::FORE
        _ = DockingGame::steer(&session, Docking::RIGHT)
        expect: mutable Docking::Run = session.run
        for _ in 0..<12 |expect|:
            Docking::step(&expect, 0.1 / 12.0, DockingReference::mask(Docking::RIGHT))
        _ = DockingGame::advance(&session, 1.0)
        return 4.i32() if session.run.vel.x != expect.vel.x or session.run.pos.x != expect.pos.x
        return 5.i32() if DockingGame::control(&session) != Docking::FORE
        _ = DockingGame::clear_keys(&session)
        return 6.i32() if DockingGame::control(&session) != Docking::NEUTRAL
        session.run.pos <- Docking::Vec{x: 0.0, y: 0.0, z: 0.0}
        session.run.att <- Docking::Vec{x: 0.0, y: 0.0, z: 0.0}
        _ = DockingGame::advance(&session, 1.0)
        return 7.i32() if session.phase != DockingGame::JUDGED or session.rung != 5
        return 8.i32() if DockingGame::advance(&session, 3.49)
        _ = DockingGame::advance(&session, 3.5)
        return 9.i32() if session.phase != DockingGame::PLAYING or session.trial != 2
        session.run.pos <- Docking::Vec{x: 0.0, y: 0.0, z: -100.0}
        _ = DockingGame::advance(&session, 3.5)
        return 10.i32() if session.phase != DockingGame::JUDGED or session.rung != 4
        _ = DockingGame::agent_event(&session, 3.5, Docking::NEUTRAL)
        return 11.i32() if session.phase != DockingGame::PLAYING or session.trial != 3
        session.run.pos <- Docking::Vec{x: 0.0, y: 0.0, z: -100.0}
        _ = DockingGame::advance(&session, 3.5)
        _ = DockingGame::agent_event(&session, 3.5, Docking::NEUTRAL)
        return 12.i32() if session.phase != DockingGame::DONE or session.wins != 1 or session.best_rung != 4
        return 13.i32() if not DockingGame::start(&session, 3.5) or session.rung != 4 or session.trial != 1
        return 0.i32()

def main() -> i32:
    can Abort.Panic, Console.Write:
        status: i32 = session_trace()
        if status != 0.i32():
            _ = dprintf(2.i32(), "Docking session assertion %d\n", status)
            return status
        for rung in [0, 1, 2, 4, 6, 7, 10, 12, 13, 16, 20, 30, 60]:
            for seed in [0, 17, 42] |rung|:
                cases(rung, seed, 0)
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            cases(rung, 17, 1)
        for rung in [1, 7, 16, 30]:
            cases(rung, 42, 2)
        cases(16, 17, 3)
        cases(16, 17, 4)
        return 0.i32()
