# Differential sweep for matching.elisa against neural_workshop/matching.py.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../src/nback.elisa"
include "../src/matching.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

# Same deterministic walk the harness uses, so both sides see one history.
def token_at(seed: i64, index: i64, span: i64) -> i64:
    mixed: i64 = (seed * 1103515245 + index * 12345 + 7) % 2147483647
    positive: i64 = mixed if mixed >= 0 else -mixed
    return 1 + positive % span

def sweep_effective_back():
    can Console.Write, Abort.Panic:
        for back in [1, 2, 3, 5]:
            for crab in [0, 1] |back|:
                for trial in 1..<13 |back, crab|:
                    ctx: MatchContext = MatchContext{crab: crab == 1, back: back, trial_number: trial, variable_nback: false}
                    printr("eb")
                    emit_cell(back)
                    emit_cell(crab)
                    emit_cell(trial)
                    emit_cell(effective_back(&ctx))
                    print("")

def sweep_check(a: mutable Arena&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        in a:
            history: mutable darray[i64] = []
            for index in 0..<20 |history|:
                history.push(token_at(5, index, 3))
            variable: mutable darray[i64] = []
            for index in 0..<20 |variable|:
                variable.push(1 + index % 4)

            for back in [1, 2, 3] |a, history, variable|:
                for crab in [0, 1] |back, history, variable|:
                    for varnb in [0, 1] |back, crab, history, variable|:
                        for trial in [1, 2, 3, 5, 8, 12] |back, crab, varnb, history, variable|:
                            for current in [1, 2, 3] |back, crab, varnb, trial, history, variable|:
                                for missed in [0, 1] |back, crab, varnb, trial, current, history, variable|:
                                    for positions in [0, 1, 3, 10] |back, crab, varnb, trial, current, missed, history, variable|:
                                        ctx: MatchContext = MatchContext{crab: crab == 1, back: back, trial_number: trial, variable_nback: varnb == 1}
                                        # Code 9 marks the inputs where the
                                        # reference raises IndexError, so both
                                        # sides line up on those rows too.
                                        lookup: IndexLookup = nback_trial_index_checked(&ctx, effective_back(&ctx), &variable)
                                        raises: bool = (not lookup.ok) and positions >= back
                                        verdict: Verdict = check_match(&ctx, current, &history, &variable, positions, missed == 1)
                                        printr("cm")
                                        emit_cell(back)
                                        emit_cell(crab)
                                        emit_cell(varnb)
                                        emit_cell(trial)
                                        emit_cell(current)
                                        emit_cell(missed)
                                        emit_cell(positions)
                                        emit_cell(9 if raises else verdict_code(verdict))
                                        print("")

def sweep_channels():
    can Console.Write, Abort.Panic:
        for code in 0..<5:
            input_type: MatchInput = MatchInput.VisVis if code == 0 else (MatchInput.VisAudio if code == 1 else (MatchInput.AudioVis if code == 2 else (MatchInput.Image if code == 3 else MatchInput.Direct)))
            pair: ChannelPair = channels_for(input_type)
            current_code: i64 = 0 if pair.current == StimChannel.Vis else (1 if pair.current == StimChannel.Audio else 2)
            history_code: i64 = 0 if pair.history == StimChannel.Vis else (1 if pair.history == StimChannel.Audio else 2)
            printr("ch")
            emit_cell(code)
            emit_cell(current_code)
            emit_cell(history_code)
            print("")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(16 * 1024 * 1024)
        arena: mutable Arena& = (&work).cast[mutable Arena&]
        sweep_effective_back()
        sweep_check(arena)
        sweep_channels()
        destroy work
        return 0
