# Differential sweep driver for tasks/lookout.elisa. See lookout_diff.py for
# the reference side.
#
# Three streams, each fed by the same RNG in the same order:
#
#   * the flock's layout, which relaxes WITHOUT rewinding when it will not fit;
#   * the cue, which shuffles all 24 glyphs and takes the FIRST minimum, so the
#     shuffle decides every tie -- and with three shapes a tie is the rule;
#   * a whole run, ticked at 1/30 with a scripted presser, so hits, false
#     alarms, slips and the adaptive flock size all land.
#
# One config carries a long morph gap and the fewest shapes, which is what lets
# a live channel stay dry past DROUGHT_SECONDS and forces the morph to produce
# the match itself.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/pymath.elisa"
include "../src/geometry.elisa"
include "../src/tasks/tracking.elisa"
include "../src/tasks/lookout.elisa"

# printr(i64) and int_to_string_scratch both trip a stage1 backend decline of
# store_* generics (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

def emit_scaled(value: f64):
    can Console.Write, Abort.Panic:
        emit_cell(py_round_half_even(value * 1000000.0))

def emit_flag(value: bool):
    can Console.Write, Abort.Panic:
        emit_cell(1 if value else 0)

def window_width(which: i64) -> f64:
    can Abort.Panic:
        return 912.0 if which == 0
        return 640.0 if which == 1
        return 1366.0 if which == 2
        return 1101.0

def window_height(which: i64) -> f64:
    can Abort.Panic:
        return 684.0 if which == 0
        return 480.0 if which == 1
        return 768.0 if which == 2
        return 617.0

def cfg_watching(cfg: i64) -> i64:
    can Abort.Panic:
        return Lookout::WATCH_COLOR if (cfg % 3) == 0
        return Lookout::WATCH_FORM if (cfg % 3) == 1
        return Lookout::WATCH_BOTH

# The long gap belongs to the fewest-shapes config, which is where a channel
# can stay dry past DROUGHT_SECONDS.
def cfg_morph_gap(cfg: i64) -> f64:
    can Abort.Panic:
        return 3.0 if cfg == 0
        return 1.2 if (cfg % 2) == 1
        return 0.8

def cfg_count(cfg: i64) -> i64:
    can Abort.Panic:
        return 3 if cfg == 0
        return 5 if (cfg % 3) == 1
        return 12

def emit_flock(flock: mutable Lookout::Flock&):
    can Console.Write, Abort.Panic:
        emit_cell(flock.count)
        for at in 0..<flock.count |flock|:
            emit_scaled(Floats::at_ref(&flock.x, at))
            emit_scaled(Floats::at_ref(&flock.y, at))
            emit_scaled(Floats::at_ref(&flock.vx, at))
            emit_scaled(Floats::at_ref(&flock.vy, at))
            emit_cell(Ints::at_ref(&flock.color, at))
            emit_cell(Ints::at_ref(&flock.form, at))
            emit_scaled(Floats::at_ref(&flock.next_morph, at))

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(64 * 1024 * 1024)
        in w:
            # --- the radius and the bounds it carves ---------------------
            for size in 0..<4:
                width: f64 = window_width(size)
                height: f64 = window_height(size)
                edge: Lookout::Bounds = Lookout::bounds(width, height)
                printr("edge")
                emit_cell(size)
                emit_scaled(Lookout::radius(height))
                emit_scaled(edge.low_x)
                emit_scaled(edge.high_x)
                emit_scaled(edge.low_y)
                emit_scaled(edge.high_y)
                print("")

            # --- clamping the flock size ---------------------------------
            for want in -2..<36:
                printr("clamp")
                emit_cell(want)
                emit_cell(Lookout::clamped(want))
                print("")

            # --- the colours, said as the feedback line says them --------
            for which in 0..<Lookout::COLOR_COUNT:
                paint: Lookout::Rgb = Lookout::color_rgb(which)
                printr("rgb")
                emit_cell(which)
                emit_cell(paint.r)
                emit_cell(paint.g)
                emit_cell(paint.b)
                print("")

            # --- a flock laid, then a cue dealt against it ---------------
            flock: mutable Lookout::Flock = Lookout::new_flock()
            for count in 3..<16 |flock|:
                for seed in 1..<3 |flock, count|:
                    rng: mutable MT19937 = mt19937_new()
                    mt_seed_int(&rng, (count * 100 + seed).u64())
                    Lookout::spawn_flock(&flock, count, 912.0, 684.0, 0.0, 0.6, 1.0, &rng)
                    printr("spawn")
                    emit_cell(count)
                    emit_cell(seed)
                    emit_flock(&flock)
                    print("")
                    for watching in 0..<3 |flock, count, seed, rng|:
                        cue: Lookout::Cue = Lookout::absent_cue(&flock, watching, &rng)
                        printr("cue")
                        emit_cell(count)
                        emit_cell(seed)
                        emit_cell(watching)
                        emit_cell(cue.color)
                        emit_cell(cue.form)
                        emit_flock(&flock)
                        print("")

            # --- a whole run, ticked at 1/30 with a scripted presser -----
            run: mutable Lookout::Run = Lookout::new_run()
            for cfg in 0..<6 |flock, run|:
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, (500 + cfg).u64())
                width: f64 = window_width(cfg % 4)
                height: f64 = window_height(cfg % 4)
                run.watching <- cfg_watching(cfg)
                run.speed <- 0.4 + cfg.f64() * 0.1
                run.morph_gap <- cfg_morph_gap(cfg)
                run.total_cues <- 5
                run.adaptive <- (cfg % 2) == 0
                run.start_count <- cfg_count(cfg)
                Lookout::start_run(&run, &flock, width, height, 0.0, &rng)
                printr("start")
                emit_cell(cfg)
                emit_cell(run.count)
                emit_cell(run.cue_number)
                emit_cell(run.cue_color)
                emit_cell(run.cue_form)
                emit_cell(run.phase)
                emit_flock(&flock)
                print("")

                dt: f64 = 1.0 / 30.0
                now: mutable f64 = 0.0
                tick: mutable i64 = 0
                while run.phase != Lookout::PHASE_DONE and tick < 3000 |run, flock, cfg, width, height, now, tick, dt, rng|:
                    now <- now + dt
                    Lookout::update(&run, &flock, dt, width, height, now, &rng)
                    # A presser that neither waits nor watches: every fifth
                    # tick, alternating channels. Hits, false alarms and slips
                    # all arrive on their own.
                    if (tick % 5) == 0:
                        Lookout::answer(&run, &flock, (tick / 5) % 2, width, height, now, &rng)
                    printr("tick")
                    emit_cell(cfg)
                    emit_cell(tick)
                    emit_cell(run.phase)
                    emit_cell(run.cue_number)
                    emit_cell(run.cue_color)
                    emit_cell(run.cue_form)
                    emit_cell(run.count)
                    emit_cell(flock.count)
                    emit_cell(run.hits)
                    emit_cell(run.misses)
                    emit_cell(run.false_alarms)
                    emit_cell(run.verdict)
                    emit_cell(Ints::at_ref(&run.seen_set, 0))
                    emit_cell(Ints::at_ref(&run.seen_set, 1))
                    emit_flock(&flock)
                    print("")
                    tick <- tick + 1

                tally: Lookout::Score = Lookout::score(&run)
                printr("score")
                emit_cell(cfg)
                emit_cell(tick)
                emit_cell(tally.hits)
                emit_cell(tally.misses)
                emit_cell(tally.false_alarms)
                emit_cell(tally.mean_ms)
                emit_cell(tally.most_shapes)
                emit_flock(&flock)
                print("")
        destroy w
        return 0
