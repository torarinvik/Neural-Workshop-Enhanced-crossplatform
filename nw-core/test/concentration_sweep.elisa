# Differential sweep driver for tasks/concentration.elisa. See
# concentration_diff.py for the reference side.
#
# Three things are swept. The grid, over pair counts and window shapes -- the
# column-dropping loop and the 80px floor both need a short window to fire. The
# hit test, over a fixed lattice of probe points, which pins the rects and the
# deal order at once. And a whole played board: the deal is one shuffle over 2n
# cards, and after it a scripted player flips, sometimes waiting the hide timer
# out and sometimes flipping straight through it, so the third-flip resolve and
# the `owed` lapse both land.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/pymath.elisa"
include "../src/tasks/concentration.elisa"

# printr(i64) and int_to_string_scratch both trip a stage1 backend decline of
# store_* generics (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

def emit_scaled(value: f64):
    can Console.Write, Abort.Panic:
        emit_cell(py_round_half_even(value * 1000000.0))

def emit_flag(value: bool):
    can Console.Write, Abort.Panic:
        emit_cell(1 if value else 0)

# The window widths the grid is swept over.
def sweep_width(which: i64) -> f64:
    can Abort.Panic:
        return 800.0 if which == 0
        return 1280.0 if which == 1
        return 1920.0

# The band the board is laid between. The middle one is shorter than the 80px
# floor the reference keeps, so `max(80.0, ...)` has to fire.
def sweep_floor(which: i64) -> f64:
    can Abort.Panic:
        return 120.0 if which == 0
        return 80.0 if which == 1
        return 200.0

def sweep_ceiling(which: i64) -> f64:
    can Abort.Panic:
        return 596.0 if which == 0
        return 130.0 if which == 1
        return 900.0

# The cards a scripted player may turn over next: unmatched, and not already
# showing. Returns how many were written into `out`.
def choices(board: mutable Concentration::Board&, out: mutable darray[i64]&) -> i64:
    can Abort.Panic:
        found: mutable i64 = 0
        for card in 0..<board.count |board, out, found|:
            face_up: i64 = Ints::at_ref(&board.face_up, card)
            matched: i64 = Ints::at_ref(&board.matched, card)
            if face_up == 0 and matched == 0:
                Ints::put(out, found, card)
                found <- found + 1
        return found

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(64 * 1024 * 1024)
        in w:
            # --- the grid, and the rects it lays -------------------------
            for pairs in 2..<13:
                for shape_case in 0..<9:
                    width: f64 = sweep_width(shape_case / 3)
                    floor: f64 = sweep_floor(shape_case % 3)
                    ceiling: f64 = sweep_ceiling(shape_case % 3)
                    # Before the deal there are no cards, so the grid is sized
                    # from the pairs about to be laid.
                    empty: Concentration::Layout = Concentration::grid_shape(0, pairs, width, floor, ceiling)
                    plan: Concentration::Layout = Concentration::layout_board(pairs * 2, pairs, width, floor, ceiling)
                    printr("grid")
                    emit_cell(pairs)
                    emit_cell(shape_case)
                    emit_cell(empty.columns)
                    emit_cell(empty.rows)
                    emit_cell(plan.columns)
                    emit_cell(plan.rows)
                    emit_scaled(plan.side)
                    emit_scaled(plan.gap)
                    emit_scaled(plan.left)
                    emit_scaled(plan.top)
                    print("")
                    printr("rect")
                    emit_cell(pairs)
                    emit_cell(shape_case)
                    for position in 0..<(pairs * 2) |plan|:
                        box: Concentration::Rect = Concentration::card_rect(&plan, position)
                        emit_scaled(box.left)
                        emit_scaled(box.bottom)
                        emit_scaled(box.width)
                        emit_scaled(box.height)
                    print("")

            # --- the hit test, over a lattice of probes ------------------
            for pairs in 3..<9:
                for shape_case in 0..<9:
                    width: f64 = sweep_width(shape_case / 3)
                    floor: f64 = sweep_floor(shape_case % 3)
                    ceiling: f64 = sweep_ceiling(shape_case % 3)
                    plan: Concentration::Layout = Concentration::layout_board(pairs * 2, pairs, width, floor, ceiling)
                    room: f64 = Concentration::board_room(floor, ceiling)
                    printr("hit")
                    emit_cell(pairs)
                    emit_cell(shape_case)
                    for px in 0..<11 |plan, width, floor, room, pairs|:
                        for py in 0..<7 |plan, width, floor, room, pairs, px|:
                            x: f64 = width * (px.f64() + 0.5) / 11.0
                            y: f64 = floor + room * (py.f64() + 0.5) / 7.0
                            emit_cell(Concentration::card_at(&plan, pairs * 2, x, y))
                    print("")

            # --- the card backs ------------------------------------------
            for combo in 0..<8:
                face_up: bool = (combo % 2) == 1
                matched: bool = ((combo / 2) % 2) == 1
                dark: bool = (combo / 4) == 1
                paint: Concentration::Fill = Concentration::card_fill(face_up, matched, dark)
                printr("fill")
                emit_cell(combo)
                emit_cell(paint.r)
                emit_cell(paint.g)
                emit_cell(paint.b)
                emit_cell(paint.alpha)
                print("")

            # --- a board dealt, and played out ---------------------------
            board: mutable Concentration::Board = Concentration::new_board()
            picks: mutable darray[i64] = Ints::zeros(Concentration::MOST_CARDS)
            for pairs in 3..<9 |board, picks|:
                for seed in 1..<4 |board, picks, pairs|:
                    rng: mutable MT19937 = mt19937_new()
                    mt_seed_int(&rng, (pairs * 1000 + seed).u64())
                    Concentration::reset(&board)
                    board.coach <- (seed % 2) == 1
                    peek_ms: i64 = 0 if seed == 2 else 800
                    sound: bool = seed == 3
                    Concentration::deal(&board, pairs, peek_ms, sound, &rng)
                    printr("deal")
                    emit_cell(pairs)
                    emit_cell(seed)
                    emit_cell(board.count)
                    emit_cell(board.phase)
                    for at in 0..<board.count |board|:
                        emit_cell(Ints::at_ref(&board.index, at))
                        emit_cell(Ints::at_ref(&board.face_up, at))
                    print("")

                    Concentration::peek_over(&board)
                    printr("peeked")
                    emit_cell(pairs)
                    emit_cell(seed)
                    emit_cell(board.phase)
                    for at in 0..<board.count |board|:
                        emit_cell(Ints::at_ref(&board.face_up, at))
                    print("")

                    step: mutable i64 = 0
                    playing: mutable bool = true
                    while playing and step < 400 |board, picks, pairs, seed, step, playing, rng|:
                        # Half the time the player waits the hide timer out;
                        # the rest of the time it flips straight through it and
                        # the third flip resolves the pair on its way in.
                        if Concentration::hiding(&board) and (step % 3) == 0:
                            Concentration::resolve(&board)
                        found: mutable i64 = choices(&board, &picks)
                        if found == 0:
                            Concentration::resolve(&board)
                            found <- choices(&board, &picks)
                        if found == 0:
                            playing <- false
                        else:
                            card: i64 = Ints::at_ref(&picks, py_randbelow(&rng, found.u64()).i64())
                            Concentration::flip(&board, card)
                            printr("flip")
                            emit_cell(pairs)
                            emit_cell(seed)
                            emit_cell(step)
                            emit_cell(card)
                            emit_cell(board.turns)
                            emit_cell(board.lapses)
                            emit_cell(board.phase)
                            emit_flag(board.owed)
                            emit_cell(board.verdict)
                            emit_cell(board.flipped_count)
                            for at in 0..<board.count |board|:
                                emit_cell(Ints::at_ref(&board.face_up, at))
                                emit_cell(Ints::at_ref(&board.matched, at))
                            print("")
                            step <- step + 1
                            playing <- false if Concentration::cleared(&board)

                    printr("end")
                    emit_cell(pairs)
                    emit_cell(seed)
                    emit_cell(step)
                    emit_cell(board.turns)
                    emit_cell(board.lapses)
                    emit_cell(board.phase)
                    emit_flag(Concentration::known_pair(&board))
                    print("")
        destroy w
        return 0
