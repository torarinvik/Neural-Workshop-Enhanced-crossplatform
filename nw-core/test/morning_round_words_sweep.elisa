include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/morning_round_words.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def sample(rung: i64):
    can Abort.Panic, Console.Write, Memory.Allocate:
        draw: mutable MT19937 = zeroed
        mt_seed_int(&draw, 17.u64())
        for _ in 0..<75 |rung, draw|:
            c: MorningRoundRules::Candidate = MorningRoundRules::build(MorningRound::grade(rung), &draw)
            continue if not c.valid
            for k in 0..<c.street.book.count |c|:
                rule: MorningRoundRules::Rule = c.street.book.rules[k.usize()]
                words: mutable dstr = []
                MorningRoundWords::describe(&rule, rule.count - 1, false, &words)
                for byte in words:
                    _ = dprintf(1.i32(), "%c", byte.i32())
                _ = dprintf(1.i32(), "\n")

def main() -> i32:
    can Abort.Panic, Console.Write, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 6, 10, 12, 16, 25, 40, 100]:
            region scratch(4194304):
                in scratch:
                    sample(rung)
        return 0.i32()
