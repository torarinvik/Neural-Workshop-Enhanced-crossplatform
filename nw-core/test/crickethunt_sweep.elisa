include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/crickethunt.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# Cricket Hunt against crickethunt.py, for crickethunt_diff.py: the grade
# table, dealt rooms (each checked by the autopilot playing it through),
# and tries played step by step -- the reference autopilot, nobody, three
# grabs at nothing, and walking, turning and looking by hand before the
# autopilot takes over -- with where each cricket is heard from, the notes,
# and every sound track's settings and phases.

def player(run: CricketHunt::Run&, mode: i64, n: i64) -> i64:
    can Abort.Panic:
        auto: i64 = CricketHunt::pilot(run)
        return auto if mode == 0
        return -1 if mode == 1
        return (CricketHunt::GRAB if n % 30 == 0 else -1) if mode == 2
        return (n / 40) % 6 if n < 600 else auto

def replay(rung: i64, seed: i64, mode: i64, dt: f64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(134217728):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                room: CricketHunt::Room = CricketHunt::deal(rung, &draw)
                _ = printf("room %lld %lld %lld %u %.17g %.17g %.17g %.17g\n", mode, rung, seed, py_getrandbits(&draw, 32).u32(),
                    room.start[0], room.start[1], room.start[2], room.seconds)
                for c in 0..<room.level.crickets |room|:
                    k: CricketHunt::Cricket = room.crickets[c.usize()]
                    _ = printf("cricket %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g\n", k.at[0], k.at[1], k.at[2],
                        k.hop[0], k.hop[1], k.hop[2], k.pitch, k.phase)
                _ = printf("furniture")
                for i in 0..<15 |room|:
                    _ = printf(" %.17g", room.furniture[i.usize()])
                _ = printf("\n")
                return if mode < 0
                run: mutable CricketHunt::Run = CricketHunt::begin(room, true)
                n: mutable i64 = 0
                while run.result == CricketHunt::LIVE |run, mode, n, dt|:
                    port: i64 = player(&run, mode, n)
                    if port == CricketHunt::GRAB:
                        CricketHunt::act(&run, port)
                    CricketHunt::step(&run, dt, port if port != CricketHunt::GRAB else -1)
                    ear: CricketHunt::Heard = CricketHunt::heard(&run, 0)
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g %.17g %lld %lld %lld %.17g %.17g %.17g %.17g %lld\n", port,
                        run.result, run.t, run.x, run.z, run.yaw, run.pitch, run.misses, CricketHunt::caught_count(&run),
                        run.times.count.i64(), ear.r, ear.side, ear.ahead, ear.facing, 1 if CricketHunt::aimed(&run, 0) else 0)
                    n <- n + 1
                _ = printf("end %lld %.17g\n", run.result, run.t)
                for c in 0..<room.level.crickets |run|:
                    u: usize = (3 * c).usize()
                    _ = printf("where %.17g %.17g %.17g\n", run.where[u], run.where[u + 1], run.where[u + 2])
                for note in run.notes:
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g\n", note.seed, note.voice, note.t, note.freq, note.dur, note.gain)
                for i in 0..<run.times.count.i64() |run, room|:
                    _ = printf("%.17g", run.times[i.usize()])
                    for track in 0..<CricketHunt::TRACKS |run, room, i|:
                        continue if track != CricketHunt::HUM and track >= room.level.crickets
                        at: usize = (i * CricketHunt::TRACKS + track).usize()
                        _ = printf(" %.17g %.17g %.17g %.17g", run.left[at], run.right[at], run.bright[at], run.phases[at])
                    _ = printf("\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in 0..<41:
            level: CricketHunt::Grade = CricketHunt::grade(rung)
            _ = printf("grade %lld %.17g %lld %.17g %.17g %.17g %.17g %lld %.17g\n", level.rung, level.room, level.crickets,
                level.low, level.high, level.every, level.hum, 1 if level.hop else 0, level.radius)
        for rung in [1.i64(), 2.i64(), 3.i64(), 4.i64(), 6.i64(), 7.i64(), 8.i64(), 9.i64(), 10.i64(), 12.i64(), 13.i64(),
                16.i64(), 20.i64(), 25.i64(), 30.i64(), 40.i64()]:
            for seed in 1..<4 |rung|:
                replay(rung, seed, -1, 0.0)
        for rung in [1.i64(), 2.i64(), 4.i64(), 7.i64(), 8.i64(), 10.i64(), 13.i64()]:
            for mode in [0.i64(), 2.i64(), 3.i64()] |rung|:
                replay(rung, 17 + mode, mode, 1.0 / 30.0)
        replay(1, 5, 1, 1.0 / 30.0)
        replay(4, 9, 0, 1.0 / 120.0)
        replay(20, 3, 0, 1.0 / 30.0)
        return 0
