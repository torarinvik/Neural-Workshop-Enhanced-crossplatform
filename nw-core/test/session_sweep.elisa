# Differential sweep for session.elisa against neural_workshop/session.py.
#
# Each case runs a WHOLE seeded session -- config profile x game mode x n-back
# level x seed -- and prints one line per trial carrying every stimulus field,
# the arithmetic operation, _real_back() and _current_variable_back(). The `s`
# line that closes a case carries a 32-bit draw off the same generator, so the
# comparison also pins how many times the Mersenne Twister was consumed.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../src/pyrandom.elisa"
include "../src/stimulus.elisa"
include "../src/board.elisa"
include "../src/gamemode.elisa"
include "../src/session.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

# ---------------------------------------------------------------------------
# Config profiles. Mirrored key for key by PROFILES in session_diff.py, which
# assembles the same values into a real DotDict and assigns it to state.cfg.
# ---------------------------------------------------------------------------

const TRIALS: i64 = 18

# ARITHMETIC_ACCEPTABLE_DECIMALS, as the exact rationals SessionCfg wants.
# Stock config.ini's list, in its own order (the order is irrelevant -- it is a
# membership test -- but keeping it makes the two files read the same).
def stock_acceptable(a: mutable Arena&) -> darray[Rational]:
    can Memory.Allocate, Abort.Panic:
        in a:
            out: mutable darray[Rational] = []
            for tenth in 1..<9 |out|:
                out.push(Rational{numerator: tenth, denominator: 10})
            out.push(Rational{numerator: 125, denominator: 1000})
            out.push(Rational{numerator: 25, denominator: 100})
            out.push(Rational{numerator: 375, denominator: 1000})
            out.push(Rational{numerator: 625, denominator: 1000})
            out.push(Rational{numerator: 75, denominator: 100})
            out.push(Rational{numerator: 875, denominator: 1000})
            for fifth in [15, 35, 45, 55, 65, 85, 95] |out|:
                out.push(Rational{numerator: fifth, denominator: 100})
            return out

def stock_visual_colors(a: mutable Arena&) -> darray[i64]:
    can Memory.Allocate, Abort.Panic:
        in a:
            out: mutable darray[i64] = []
            for color in [1, 3, 8, 6] |out|:
                out.push(color)
            return out

# SessionCfg's fields are immutable, as GameCfg's are, so each profile is one
# literal built from the per-key tables below. The comment on each key says
# which profiles move it off the stock value:
#
#   1: variable n-back, image multi-mode, a 5x5 board with its centre in play,
#      negative arithmetic operands, and matches twice as likely.
#   2: the 3D cube board (36 pattern ids, 64 colour ids), and division as the
#      ONLY arithmetic operation -- so choice() runs over a single-item list,
#      which still draws.
#   3: a board capped to three cells with matches almost always forced. The
#      quad-stim modes then index `positions` past its end, exactly as the
#      reference does.
#   4: Jaeggi mode, which overwrites position1/audio from the fixed sequence
#      after everything else has been decided. GRID_SIZE is below
#      GRID_SIZE_MIN, so the board clamps up to 2x2.
#   5: variable n-back on a board capped through the LEGACY POSITION_CELL_COUNT
#      key, interference always on and guaranteed matches off -- so every
#      planted lag comes from the shuffle in _interference_back. GRID_SIZE is
#      above GRID_SIZE_MAX, so the board clamps down to 4x4.
const PROFILE_COUNT: i64 = 6

def profile_chance_match(profile: i64) -> f64:
    0.5 return if profile == 1
    0.25 return if profile == 2
    0.9 return if profile == 3
    0.0 return if profile == 5
    return 0.125

def profile_chance_interference(profile: i64) -> f64:
    0.5 return if profile == 1
    0.75 return if profile == 2
    0.9 return if profile == 3
    1.0 return if profile == 5
    return 0.125

def profile_variable_nback(profile: i64) -> bool:
    return profile == 1 or profile == 5

def profile_multi_mode_color(profile: i64) -> bool:
    return not (profile == 1 or profile == 5)

def profile_max_number(profile: i64) -> i64:
    9 return if profile == 1
    4 return if profile == 3
    7 return if profile == 5
    return 12

def profile_use_negatives(profile: i64) -> bool:
    return profile == 1 or profile == 5

def profile_grid_size(profile: i64) -> i64:
    5 return if profile == 1
    5 return if profile == 3
    1 return if profile == 4
    6 return if profile == 5
    return 3

def profile_grid_size_max(profile: i64) -> i64:
    4 return if profile == 5
    return 32

# ACTIVE_POSITION_CELLS, and its legacy POSITION_CELL_COUNT alias, which
# grid.current_active_cell_limit() falls back on.
def profile_active_cells(profile: i64) -> i64:
    3 return if profile == 3
    return 0

def profile_legacy_cells(profile: i64) -> i64:
    5 return if profile == 5
    return 0

def make_cfg(a: mutable Arena&, profile: i64) -> SessionCfg:
    can Memory.Allocate, Abort.Panic:
        return SessionCfg{
            chance_of_guaranteed_match: profile_chance_match(profile),
            chance_of_interference: profile_chance_interference(profile),
            variable_nback: profile_variable_nback(profile),
            jaeggi_mode: profile == 4,
            multi_mode_color: profile_multi_mode_color(profile),
            visual_colors: stock_visual_colors(a),
            arithmetic_use_addition: profile != 2,
            arithmetic_use_subtraction: profile != 2 and profile != 4,
            arithmetic_use_multiplication: profile != 2,
            arithmetic_use_division: profile != 4,
            arithmetic_use_negatives: profile_use_negatives(profile),
            arithmetic_max_number: profile_max_number(profile),
            acceptable_fractions: stock_acceptable(a),
            grid_size: profile_grid_size(profile),
            grid_size_min: 2,
            grid_size_max: profile_grid_size_max(profile),
            grid_include_center: profile == 1,
            grid_3d: profile == 2,
            grid_3d_cubes: 2 if profile == 2 else 1,
            active_position_cells: profile_active_cells(profile),
            position_cell_count: profile_legacy_cells(profile)}

# The gamemode.py slice, so `Mode` starts exactly where gamemode.Mode() does.
# MANUAL is on in every profile, so mode_new() leaves the constructor's values
# alone and the sweep overrides `back` and `num_trials_total` itself.
def make_game_cfg(a: mutable Arena&, mode: i64) -> GameCfg:
    can Memory.Allocate, Abort.Panic:
        in a:
            no_back: mutable darray[ModeOverride] = []
            no_ticks: mutable darray[ModeOverride] = []
            return GameCfg{
                game_mode: mode,
                back_default: 2,
                ticks_default: 30,
                bonus_ticks_crab: 0,
                bonus_ticks_multi2: 5,
                bonus_ticks_multi3: 10,
                bonus_ticks_multi4: 15,
                num_trials: 20,
                num_trials_factor: 1,
                num_trials_exponent: 2,
                manual: true,
                hide_text: false,
                skip_title_screen: false,
                black_background: false,
                back_overrides: no_back,
                ticks_overrides: no_ticks}

# The fixed Jaeggi sequence session_diff.py injects. Built without touching the
# random stream; see the note there.
def make_bt_positions(a: mutable Arena&, length: i64) -> darray[i64]:
    can Memory.Allocate, Abort.Panic:
        in a:
            out: mutable darray[i64] = []
            index: mutable i64 = 0
            while index < length |out, index, length|:
                out.push(1 + py_mod(index * 3 + 1, 8))
                index <- index + 1
            return out

def make_bt_audio(a: mutable Arena&, length: i64) -> darray[i64]:
    can Memory.Allocate, Abort.Panic:
        in a:
            out: mutable darray[i64] = []
            index: mutable i64 = 0
            while index < length |out, index, length|:
                out.push(1 + py_mod(index * 5 + 2, 8))
                index <- index + 1
            return out

def empty_i64(a: mutable Arena&) -> darray[i64]:
    can Memory.Allocate, Abort.Panic:
        in a:
            out: mutable darray[i64] = []
            return out

# ---------------------------------------------------------------------------
# One seeded session
# ---------------------------------------------------------------------------

def run_case(tables: ModeTables&, case: i64, profile: i64, mode: i64, back: i64, seed: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(32 * 1024 * 1024)
        arena: mutable Arena& = (&work).cast[mutable Arena&]

        cfg: SessionCfg = make_cfg(arena, profile)
        game_cfg: GameCfg = make_game_cfg(arena, mode)
        game: mutable Mode = mode_new(&game_cfg)
        game.back <- back
        game.trial_number <- 0
        game.num_trials_total <- TRIALS

        rng: mutable MT19937 = mt19937_new()
        mt_seed_int(&rng, seed.u64())

        printr("c")
        emit_cell(case)
        emit_cell(profile)
        emit_cell(mode)
        emit_cell(back)
        emit_cell(seed)
        print("")

        variable_list: mutable darray[i64] = empty_i64(arena)
        if cfg.variable_nback:
            variable_list <- variable_nback_list(arena, &rng, TRIALS - back, back)
        bt_positions: darray[i64] = make_bt_positions(arena, TRIALS)
        bt_audio: darray[i64] = make_bt_audio(arena, TRIALS)

        buffers: mutable SessionBuffers = SessionBuffers{
            history: session_history_new(arena),
            variable_list: variable_list,
            bt_positions: bt_positions,
            bt_audio: bt_audio}

        done: mutable i64 = 0
        alive: mutable bool = true
        trial: mutable i64 = 0
        while trial < TRIALS and alive |arena, cfg, tables, game, buffers, rng, case, done, alive, trial|:
            if game.trial_number > 0:
                history_record_stimulus(arena, &buffers.history, &game)
            game.trial_number <- game.trial_number + 1
            outcome: GenerateOutcome = generate_stimulus(arena, &rng, &cfg, tables, &game, &buffers)
            printr("t")
            emit_cell(case)
            emit_cell(game.trial_number)
            if outcome.status == GenerateStatus.Ok:
                emit_cell(0)
                for field in 0..<STIMULUS_FIELD_COUNT |game|:
                    emit_cell(game.current_stim[field.usize()])
                emit_cell(arith_op_code(game.current_operation))
                emit_cell(outcome.real_back)
                emit_cell(outcome.variable)
                done <- done + 1
            else:
                # The reference raises straight out of generate_stimulus and
                # the session dies with it.
                emit_cell(1)
                alive <- false
            print("")
            trial <- trial + 1

        printr("s")
        emit_cell(case)
        emit_cell(done)
        emit_cell(py_getrandbits(&rng, 32).i64())
        print("")

        destroy work

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region tables_region(8 * 1024 * 1024)
        tables_arena: mutable Arena& = (&tables_region).cast[mutable Arena&]
        tables: ModeTables = mode_tables_new(tables_arena)

        case: mutable i64 = 0
        profile: mutable i64 = 0
        while profile < PROFILE_COUNT |tables, case, profile|:
            for mode in [2, 5, 7, 8, 9, 20, 21, 24, 100, 107, 130, 258, 514, 770, 276, 533, 1026, 386] |tables, case, profile|:
                for back in [1, 2, 3, 5] |tables, case, profile, mode|:
                    for seed in [1, 7, 12345] |tables, case, profile, mode, back|:
                        run_case(&tables, case, profile, mode, back, seed)
                        case <- case + 1
            profile <- profile + 1

        destroy tables_region
        return 0
