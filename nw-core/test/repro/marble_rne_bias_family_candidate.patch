--- a/src/engine/engine_core_smooth.c
+++ b/src/engine/engine_core_smooth.c
@@ -34,6 +34,45 @@
 #include "engine/engine_util_sparse.h"
 #include "engine/engine_util_spatial.h"
 
+#ifdef __EMSCRIPTEN__
+extern mjtNum mj_marble_wheel_fma(mjtNum, mjtNum, mjtNum);
+
+// Private complete bias-force family, qualified against the actual original
+// mj_rne(flg_acc=0) return, not a newer-SDK intermediate. The acceleration
+// mode and shared generic primitives are deliberately unchanged.
+static void marble_rne_dof_vec(mjtNum out[6], const mjtNum* dof,
+                               const mjtNum* vec, int n) {
+  mju_zero(out, 6);
+  if (n == 1) {
+    for (int c = 0; c < 6; ++c) out[c] = dof[c]*vec[0];
+  } else {
+    for (int j = 0; j < n; ++j) if (vec[j] != 0) {
+      for (int c = 0; c < 6; ++c)
+        out[c] = mj_marble_wheel_fma(dof[6*j+c], vec[j], out[c]);
+    }
+  }
+}
+
+static void marble_rne_cross_force(mjtNum out[6], const mjtNum v[6],
+                                   const mjtNum f[6]) {
+  out[0] = mj_marble_wheel_fma(-v[2], f[1], v[1]*f[2]) +
+           mj_marble_wheel_fma(-v[5], f[4], v[4]*f[5]);
+  out[1] = mj_marble_wheel_fma(v[2], f[0], (-v[0])*f[2]) +
+           mj_marble_wheel_fma(v[5], f[3], (-v[3])*f[5]);
+  out[2] = mj_marble_wheel_fma(-v[1], f[0], v[0]*f[1]) +
+           mj_marble_wheel_fma(-v[4], f[3], v[3]*f[4]);
+  out[3] = mj_marble_wheel_fma(-v[2], f[4], v[1]*f[5]);
+  out[4] = mj_marble_wheel_fma(v[2], f[3], (-v[0])*f[5]);
+  out[5] = mj_marble_wheel_fma(-v[1], f[3], v[0]*f[4]);
+}
+
+static mjtNum marble_rne_dot(const mjtNum a[6], const mjtNum b[6]) {
+  return (mj_marble_wheel_fma(a[0], b[0], a[2]*b[2]) +
+          mj_marble_wheel_fma(a[1], b[1], a[3]*b[3])) +
+          mj_marble_wheel_fma(a[4], b[4], a[5]*b[5]);
+}
+#endif
+
 MJAPI int mj_rne_projection_trace_size(const mjModel* m) {
   return 36 * m->nbody + 13 * m->nv;
 }
