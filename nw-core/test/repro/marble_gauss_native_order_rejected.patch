+// Probe the actual compiled PrimalUpdateConstraint's Gauss producer with
+// zero constraints, owned output storage, and complete validated dof arrays.
+MJAPI int mj_marble_gauss_probe(const mjtNum* packet, int size, mjtNum* output) {
+  if (!packet || !output || size < 2 || size > 2050) return 0;
+  for (int i = 0; i < size; ++i) if (!isfinite(packet[i])) return 0;
+  if (packet[0] != 1 || packet[1] < 0 || packet[1] > 512 ||
+      packet[1] != floor(packet[1])) return 0;
+  const int n = (int)packet[1];
+  if (size != 2 + 4*n) return 0;
+  mjPrimalContext ctx = {0};
+  mjtNum zero = 0, constraint_force[512] = {0};
+  int zero_int = 0;
+  mjContact contact = {0};
+  ctx.nv = n; ctx.island = -1;
+  ctx.contact = &contact;
+  ctx.efc_D = ctx.efc_R = ctx.efc_frictionloss = ctx.efc_aref = &zero;
+  ctx.efc_id = ctx.efc_type = &zero_int; ctx.efc_state = &zero_int;
+  ctx.efc_force = ctx.J = ctx.Jaref = &zero;
+  ctx.Ma = (mjtNum*)(packet+2);
+  ctx.qfrc_smooth = packet+2+n;
+  ctx.qacc = (mjtNum*)(packet+2+2*n);
+  ctx.qacc_smooth = packet+2+3*n;
+  ctx.qfrc_constraint = constraint_force;
+  ctx.marble_trace_valid = MARBLE_VALID_MA;
+  PrimalUpdateConstraint(&ctx, 0);
+  if (!isfinite(ctx.quadGauss[0]) || !isfinite(ctx.cost)) return 0;
+  output[0] = ctx.quadGauss[0]; output[1] = ctx.cost;
+  return 1;
+}
