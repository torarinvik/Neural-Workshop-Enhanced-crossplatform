+// Complete comVel family, qualified on actual original public routine outputs.
+// Three-DOF accumulation shares the already-qualified ordered RNE accumulator;
+// the single-axis rounded product/add path is deliberately unchanged.
+static void marble_comvel_cross_motion(mjtNum out[6], const mjtNum v[6],
+                                       const mjtNum axis[6]) {
+  out[0] = mj_marble_wheel_fma(-v[2], axis[1], v[1]*axis[2]);
+  out[1] = mj_marble_wheel_fma(v[2], axis[0], (-v[0])*axis[2]);
+  out[2] = mj_marble_wheel_fma(-v[1], axis[0], v[0]*axis[1]);
+  out[3] = mj_marble_wheel_fma(-v[2], axis[4], v[1]*axis[5]) +
+           mj_marble_wheel_fma(-v[5], axis[1], v[4]*axis[2]);
+  out[4] = mj_marble_wheel_fma(v[2], axis[3], (-v[0])*axis[5]) +
+           mj_marble_wheel_fma(v[5], axis[0], (-v[3])*axis[2]);
+  out[5] = mj_marble_wheel_fma(-v[1], axis[3], v[0]*axis[4]) +
+           mj_marble_wheel_fma(-v[4], axis[0], v[3]*axis[1]);
+}
+#define MARBLE_COMVEL_DOF_VEC marble_rne_dof_vec
+#define MARBLE_COMVEL_CROSS_MOTION marble_comvel_cross_motion
+#else
+#define MARBLE_COMVEL_DOF_VEC mju_mulDofVec
+#define MARBLE_COMVEL_CROSS_MOTION mji_crossMotion
+#endif
