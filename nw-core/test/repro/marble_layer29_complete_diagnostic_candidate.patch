+MJAPI int mj_marble_eval_probe(const mjtNum* values, int count, mjtNum* output) {
+  if (!values || !output || count < 9 || count > 800000) return 0;
+  for (int k=0; k < count; ++k) if (!isfinite(values[k])) return 0;
+  if (values[0] != 1) return 0;
