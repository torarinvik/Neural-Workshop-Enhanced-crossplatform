+static mjtNum marble_noslip_input_trace[MARBLE_NOSLIP_INPUT_CAPACITY];
+static int marble_noslip_input_trace_size;
+static void marbleRecordNoSlipInput(const mjModel* m, const mjData* d,
+                                   int island, int nefc,
+                                   const int* efclist) {
+  const int global_nefc = d->nefc;
+  const bool sparse = mj_isSparse(m);
+  bool ar_available = !global_nefc || (d->efc_AR &&
+      (!sparse || (d->efc_AR_rowadr && d->efc_AR_rownnz && d->efc_AR_colind)));
+  const int ar_size = ar_available ? global_nefc * global_nefc : 0;
+  const int needed = 4 + nefc + 3*global_nefc + ar_size;
+  if (needed > MARBLE_NOSLIP_INPUT_CAPACITY) return;
+  if (marble_noslip_input_trace_size + needed > MARBLE_NOSLIP_INPUT_CAPACITY) return;
+  const int record_start = marble_noslip_input_trace_size;
+  int offset = record_start;
+  marble_noslip_input_trace[offset++] = island;
+  marble_noslip_input_trace[offset++] = nefc;
+  marble_noslip_input_trace[offset++] = global_nefc;
+  marble_noslip_input_trace[offset++] = ar_available;
+  for (int c = 0; c < nefc; ++c) {
+    marble_noslip_input_trace[offset++] = efclist ? efclist[c] : c;
+  }
+  for (int i = 0; i < global_nefc; ++i) marble_noslip_input_trace[offset++] = d->efc_b[i];
+  for (int i = 0; i < global_nefc; ++i) marble_noslip_input_trace[offset++] = d->efc_R[i];
+  for (int i = 0; i < global_nefc; ++i) marble_noslip_input_trace[offset++] = d->efc_force[i];
+  if (ar_available && !sparse) {
+    for (int i = 0; i < global_nefc*global_nefc; ++i) {
+      marble_noslip_input_trace[offset++] = d->efc_AR[i];
+    }
+  } else if (ar_available) {
+    const int ar_offset = offset;
+    for (int row = 0; row < global_nefc; ++row) {
+      const int adr = d->efc_AR_rowadr[row];
+      const int nnz = d->efc_AR_rownnz[row];
+      if (adr < 0 || nnz < 0 || adr + nnz > d->nA) { ar_available = false; break; }
+      for (int k = 0; k < nnz; ++k) {
+        const int column = d->efc_AR_colind[adr+k];
+        if (column < 0 || column >= global_nefc) { ar_available = false; break; }
+        marble_noslip_input_trace[ar_offset + row*global_nefc + column] = d->efc_AR[adr+k];
+      }
+      if (!ar_available) break;
+    }
+    if (ar_available) offset += ar_size;
+  }
+  marble_noslip_input_trace[record_start + 3] = ar_available;
+  marble_noslip_input_trace_size = offset;
+}
