--- /dev/null
+++ b/src/engine/marble_primal_eval_trace.h
@@ -0,0 +1,66 @@
+// Diagnostic-only completed PrimalEval capture, paired to initialized preparation.
+#ifndef MARBLE_PRIMAL_EVAL_TRACE_H_
+#define MARBLE_PRIMAL_EVAL_TRACE_H_
+
+#define MARBLE_EVAL_TRACE_CAPACITY 300000
+static mjtNum marble_eval_trace[MARBLE_EVAL_TRACE_CAPACITY];
+static int marble_eval_size, marble_eval_calls;
+static int marble_eval_enabled, marble_eval_overflow, marble_eval_invalid;
+
+MJAPI void mj_solver_eval_trace_begin(void) {
+  marble_eval_size = marble_eval_calls = 0;
+  marble_eval_overflow = marble_eval_invalid = 0;
+  marble_eval_enabled = 1;
+}
+MJAPI void mj_solver_eval_trace_end(void) { marble_eval_enabled = 0; }
+MJAPI int mj_solver_eval_trace_schema(void) { return 1; }
+MJAPI int mj_solver_eval_trace_size(void) { return marble_eval_size; }
+MJAPI int mj_solver_eval_trace_calls(void) { return marble_eval_calls; }
+MJAPI int mj_solver_eval_trace_overflow(void) { return marble_eval_overflow; }
+MJAPI int mj_solver_eval_trace_invalid(void) { return marble_eval_invalid; }
+MJAPI void mj_solver_eval_trace_copy(mjtNum* out) {
+  if (out && marble_eval_size) {
+    memcpy(out, marble_eval_trace, (size_t)marble_eval_size*sizeof(mjtNum));
+  }
+}
+
+// quad/Jaref/Jv/D/type/id/contact/Gauss are in the associated preparation.
+// Only still-missing friction bounds plus fully assigned outputs are copied.
+static void marbleRecordEvaluated(const mjPrimalContext* ctx, mjtNum alpha,
+                                  mjtNum cost, mjtNum d0, mjtNum d1, mjtNum raw_d1) {
+  if (!marble_eval_enabled) return;
+  const int ordinal = marble_eval_calls++;
+  const unsigned int required = MARBLE_VALID_COST | MARBLE_VALID_JV |
+      MARBLE_VALID_SEARCH | MARBLE_VALID_MA | MARBLE_VALID_JAREF;
+  if ((ctx->marble_trace_valid & required) != required ||
+      ctx->marble_prepare_trace_ordinal < 0 || ctx->nv < 1 || ctx->nv > 512 ||
+      ctx->nefc < 0 || ctx->nefc > 65536 || ctx->ne < 0 || ctx->nf < 0 ||
+      ctx->ne+ctx->nf > ctx->nefc) {
+    marble_eval_invalid = 1;
+    return;
+  }
+  const int width = 13 + ctx->nefc + ctx->nf;
+  if (marble_eval_size + width > MARBLE_EVAL_TRACE_CAPACITY) {
+    marble_eval_overflow = 1;
+    return;
+  }
+  mjtNum* out = marble_eval_trace + marble_eval_size;
+  out[0] = 1;
+  out[1] = ordinal;
+  out[2] = ctx->marble_prepare_trace_ordinal;
+  out[3] = ctx->island;
+  out[4] = ctx->nv;
+  out[5] = ctx->nefc;
+  out[6] = ctx->ne;
+  out[7] = ctx->nf;
+  out[8] = alpha;
+  out[9] = cost;
+  out[10] = d0;
+  out[11] = d1;
+  out[12] = raw_d1;
+  if (ctx->nefc) memcpy(out+13, ctx->efc_R, (size_t)ctx->nefc*sizeof(mjtNum));
+  if (ctx->nf) memcpy(out+13+ctx->nefc, ctx->efc_frictionloss+ctx->ne,
+                      (size_t)ctx->nf*sizeof(mjtNum));
+  marble_eval_size += width;
+}
+#endif
diff --git a/src/engine/marble_primal_prepare_trace.h b/src/engine/marble_primal_prepare_trace.h
new file mode 100644
--- /dev/null
+++ b/src/engine/marble_primal_prepare_trace.h
@@ -0,0 +1,120 @@
+// Diagnostic-only initialized PrimalPrepare capture; no solver arithmetic.
+#ifndef MARBLE_PRIMAL_PREPARE_TRACE_H_
+#define MARBLE_PRIMAL_PREPARE_TRACE_H_
+
+#define MARBLE_PREPARE_TRACE_CAPACITY 300000
+static mjtNum marble_prepare_trace[MARBLE_PREPARE_TRACE_CAPACITY];
+static int marble_prepare_size, marble_prepare_calls;
+static int marble_prepare_enabled, marble_prepare_overflow, marble_prepare_invalid;
+
+MJAPI void mj_solver_prepare_trace_begin(void) {
+  marble_prepare_size = marble_prepare_calls = 0;
+  marble_prepare_overflow = marble_prepare_invalid = 0;
+  marble_prepare_enabled = 1;
+}
+MJAPI void mj_solver_prepare_trace_end(void) { marble_prepare_enabled = 0; }
+MJAPI int mj_solver_prepare_trace_schema(void) { return 1; }
+MJAPI int mj_solver_prepare_trace_size(void) { return marble_prepare_size; }
+MJAPI int mj_solver_prepare_trace_calls(void) { return marble_prepare_calls; }
+MJAPI int mj_solver_prepare_trace_overflow(void) { return marble_prepare_overflow; }
+MJAPI int mj_solver_prepare_trace_invalid(void) { return marble_prepare_invalid; }
+MJAPI void mj_solver_prepare_trace_copy(mjtNum* out) {
+  if (out && marble_prepare_size) {
+    memcpy(out, marble_prepare_trace, (size_t)marble_prepare_size*sizeof(mjtNum));
+  }
+}
+
+// Called only AFTER PrimalSearch produces Mv/Jv and PrimalPrepare writes outputs.
+// quad[3..8] is copied only for elliptic groups, never unused trailing storage.
+static void marbleRecordPrepared(mjPrimalContext* ctx) {
+  if (!marble_prepare_enabled) return;
+  const int ordinal = marble_prepare_calls++;
+  const int nv = ctx->nv, nefc = ctx->nefc;
+  const unsigned int required = MARBLE_VALID_COST | MARBLE_VALID_JV |
+      MARBLE_VALID_SEARCH | MARBLE_VALID_MA | MARBLE_VALID_JAREF;
+  if ((ctx->marble_trace_valid & required) != required ||
+      nv < 1 || nv > 512 || nefc < 0 || nefc > 65536) {
+    marble_prepare_invalid = 1;
+    return;
+  }
+  int blocks = 0, width = 13 + 4*nv + 5*nefc;
+  for (int row = 0; row < nefc;) {
+    int dim = 1;
+    if (ctx->efc_type[row] == mjCNSTR_CONTACT_ELLIPTIC) {
+      dim = ctx->contact[ctx->efc_id[row]].dim;
+      if ((dim != 3 && dim != 4 && dim != 6) || row+dim > nefc) {
+        marble_prepare_invalid = 1;
+        return;
+      }
+      for (int k = row; k < row+dim; ++k) {
+        if (ctx->efc_type[k] != mjCNSTR_CONTACT_ELLIPTIC ||
+            ctx->efc_id[k] != ctx->efc_id[row]) {
+          marble_prepare_invalid = 1;
+          return;
+        }
+      }
+    }
+    ++blocks;
+    width += 5 + (dim == 1 ? 3 : 15);
+    row += dim;
+  }
+  if (marble_prepare_size + width > MARBLE_PREPARE_TRACE_CAPACITY) {
+    marble_prepare_overflow = 1;
+    return;
+  }
+  mjtNum* out = marble_prepare_trace + marble_prepare_size;
+  int offset = 0;
+  out[offset++] = 1;
+  out[offset++] = ordinal;
+  out[offset++] = ctx->island;
+  out[offset++] = nv;
+  out[offset++] = nefc;
+  out[offset++] = ctx->ne;
+  out[offset++] = ctx->nf;
+  out[offset++] = ctx->is_sparse;
+  out[offset++] = blocks;
+  out[offset++] = ctx->marble_trace_valid & required;
+#define PREPARE_COPY(values, count) do { \
+    memcpy(out+offset, values, (size_t)(count)*sizeof(mjtNum)); \
+    offset += (count); \
+  } while (0)
+#define PREPARE_COPY_INTS(values, count) do { \
+    for (int k = 0; k < (count); ++k) out[offset++] = (values)[k]; \
+  } while (0)
+  PREPARE_COPY(ctx->search, nv);
+  PREPARE_COPY(ctx->Ma, nv);
+  PREPARE_COPY(ctx->Mv, nv);
+  PREPARE_COPY(ctx->qfrc_smooth, nv);
+  PREPARE_COPY(ctx->Jaref, nefc);
+  PREPARE_COPY(ctx->Jv, nefc);
+  PREPARE_COPY(ctx->efc_D, nefc);
+  PREPARE_COPY_INTS(ctx->efc_type, nefc);
+  PREPARE_COPY_INTS(ctx->efc_id, nefc);
+  PREPARE_COPY(ctx->quadGauss, 3);
+  for (int row = 0; row < nefc;) {
+    const int kind = ctx->efc_type[row];
+    const int elliptic = kind == mjCNSTR_CONTACT_ELLIPTIC;
+    const mjContact* con = elliptic ? ctx->contact+ctx->efc_id[row] : NULL;
+    const int dim = elliptic ? con->dim : 1;
+    out[offset++] = row;
+    out[offset++] = dim;
+    out[offset++] = ctx->efc_id[row];
+    out[offset++] = kind;
+    out[offset++] = elliptic ? 9 : 3;
+    if (elliptic) {
+      out[offset++] = con->mu;
+      PREPARE_COPY(con->friction, 5);
+    }
+    PREPARE_COPY(ctx->quad+3*row, elliptic ? 9 : 3);
+    row += dim;
+  }
+#undef PREPARE_COPY
+#undef PREPARE_COPY_INTS
+  if (offset != width) {
+    marble_prepare_invalid = 1;
+    return;
+  }
+  marble_prepare_size += offset;
+  ctx->marble_prepare_trace_ordinal = ordinal;
+}
+#endif
diff --git a/src/engine/marble_qcqp_kernel_trace.h b/src/engine/marble_qcqp_kernel_trace.h
new file mode 100644
--- /dev/null
+++ b/src/engine/marble_qcqp_kernel_trace.h
@@ -0,0 +1,84 @@
+// Private initialized generic-five-tangent kernel diagnostics; no arithmetic.
+#ifndef MARBLE_QCQP_KERNEL_TRACE_H_
+#define MARBLE_QCQP_KERNEL_TRACE_H_
+#define MARBLE_QCQP_KERNEL_CAPACITY 300000
+static mjtNum marble_qcqp_kernel_values[MARBLE_QCQP_KERNEL_CAPACITY];
+static int marble_qcqp_kernel_size;
+static int marble_qcqp_kernel_calls;
+static int marble_qcqp_kernel_overflow;
+static int marble_qcqp_kernel_invalid;
+static int marble_qcqp_kernel_parent = -1;
+
+MJAPI void mj_solver_qcqp_kernel_reset(void) {
+  marble_qcqp_kernel_size = 0;
+  marble_qcqp_kernel_calls = 0;
+  marble_qcqp_kernel_overflow = 0;
+  marble_qcqp_kernel_invalid = 0;
+  marble_qcqp_kernel_parent = -1;
+}
+MJAPI void mj_solver_qcqp_kernel_begin(int parent) {
+  if (parent < 0 || marble_qcqp_kernel_parent >= 0) {
+    marble_qcqp_kernel_invalid = 1;
+    return;
+  }
+  marble_qcqp_kernel_parent = parent;
+}
+MJAPI void mj_solver_qcqp_kernel_end(void) { marble_qcqp_kernel_parent = -1; }
+MJAPI int mj_solver_qcqp_kernel_schema(void) { return 1; }
+MJAPI int mj_solver_qcqp_kernel_size(void) { return marble_qcqp_kernel_size; }
+MJAPI int mj_solver_qcqp_kernel_calls(void) { return marble_qcqp_kernel_calls; }
+MJAPI int mj_solver_qcqp_kernel_overflow(void) { return marble_qcqp_kernel_overflow; }
+MJAPI int mj_solver_qcqp_kernel_invalid(void) { return marble_qcqp_kernel_invalid; }
+MJAPI void mj_solver_qcqp_kernel_copy(mjtNum* output) {
+  if (output && marble_qcqp_kernel_size) {
+    memcpy(output, marble_qcqp_kernel_values,
+           (size_t)marble_qcqp_kernel_size * sizeof(mjtNum));
+  }
+}
+static void marbleRecordQCQPKernel(int iteration, int n, int rank, int valid,
+                                  int reason, mjtNum before, mjtNum after,
+                                  mjtNum norm, mjtNum value, mjtNum product,
+                                  mjtNum derivative, mjtNum delta,
+                                  const mjtNum* A, const mjtNum* b,
+                                  const mjtNum* prefactor, const mjtNum* factor,
+                                  const mjtNum* solved, const mjtNum* tmp) {
+  if (marble_qcqp_kernel_parent < 0) return;
+  int ordinal = marble_qcqp_kernel_calls++;
+  if (n != 5 || iteration < 0 || iteration >= 20 || rank < 0 || rank > n ||
+      reason < 0 || reason > 4 ||
+      valid != (reason == 0 ? 3 : reason == 1 ? 7 : reason == 2 ? 15 : 31)) {
+    marble_qcqp_kernel_invalid = 1;
+    return;
+  }
+  int width = 15 + 3*n*n + n + ((valid & 4) ? n : 0) + ((valid & 8) ? n : 0);
+  if (marble_qcqp_kernel_size + width > MARBLE_QCQP_KERNEL_CAPACITY) {
+    marble_qcqp_kernel_overflow = 1;
+    return;
+  }
+  mjtNum* out = marble_qcqp_kernel_values + marble_qcqp_kernel_size;
+  int offset = 0;
+  out[offset++] = 1; out[offset++] = ordinal;
+  out[offset++] = marble_qcqp_kernel_parent;
+  out[offset++] = iteration; out[offset++] = n; out[offset++] = rank;
+  out[offset++] = valid; out[offset++] = reason;
+  out[offset++] = before; out[offset++] = after;
+  out[offset++] = (valid & 4) ? norm : 0;
+  out[offset++] = (valid & 4) ? value : 0;
+  out[offset++] = (valid & 8) ? product : 0;
+  out[offset++] = (valid & 8) ? derivative : 0;
+  out[offset++] = (valid & 8) ? delta : 0;
+  for (int j = 0; j < n*n; ++j) out[offset++] = A[j];
+  for (int j = 0; j < n; ++j) out[offset++] = b[j];
+  for (int j = 0; j < n*n; ++j) out[offset++] = prefactor[j];
+  for (int j = 0; j < n*n; ++j) out[offset++] = factor[j];
+  if (valid & 4) for (int j = 0; j < n; ++j) out[offset++] = solved[j];
+  if (valid & 8) for (int j = 0; j < n; ++j) out[offset++] = tmp[j];
+  for (int j = 0; j < width; ++j) {
+    if (!isfinite(out[j])) {
+      marble_qcqp_kernel_invalid = 1;
+      return;
+    }
+  }
+  marble_qcqp_kernel_size += width;
+}
+#endif
diff --git a/src/engine/marble_qcqp_trace.h b/src/engine/marble_qcqp_trace.h
new file mode 100644
--- /dev/null
+++ b/src/engine/marble_qcqp_trace.h
@@ -0,0 +1,89 @@
+// Private initialized no-slip diagnostics. Never a production arithmetic patch.
+#ifndef MARBLE_QCQP_TRACE_H_
+#define MARBLE_QCQP_TRACE_H_
+
+#define MARBLE_QCQP_TRACE_CAPACITY 300000
+typedef struct {
+  int valid;
+  int active;
+  mjtNum raw[5];
+  mjtNum projected[5];
+} marbleQCQPWitness;
+
+static mjtNum marble_qcqp_trace[MARBLE_QCQP_TRACE_CAPACITY];
+static int marble_qcqp_trace_size;
+static int marble_qcqp_trace_calls;
+static int marble_qcqp_trace_overflow;
+static int marble_qcqp_trace_invalid;
+static int marble_qcqp_trace_enabled;
+
+MJAPI int mj_solver_qcqp_trace_schema(void) { return 1; }
+MJAPI int mj_solver_qcqp_trace_size(void) { return marble_qcqp_trace_size; }
+MJAPI int mj_solver_qcqp_trace_calls(void) { return marble_qcqp_trace_calls; }
+MJAPI int mj_solver_qcqp_trace_overflow(void) { return marble_qcqp_trace_overflow; }
+MJAPI int mj_solver_qcqp_trace_invalid(void) { return marble_qcqp_trace_invalid; }
+MJAPI void mj_solver_qcqp_trace_copy(mjtNum* output) {
+  if (output && marble_qcqp_trace_size) {
+    memcpy(output, marble_qcqp_trace,
+           (size_t)marble_qcqp_trace_size * sizeof(mjtNum));
+  }
+}
+
+static void marbleRecordQCQP(const mjData* d, int island, int iteration,
+                            int row, int dim, const mjtNum* mu,
+                            const mjtNum* Ac, const mjtNum* bc,
+                            const mjtNum* oldforce, const mjtNum* residual,
+                            const marbleQCQPWitness* witness,
+                            int restored, mjtNum costchange) {
+  if (!marble_qcqp_trace_enabled) return;
+  int ordinal = marble_qcqp_trace_calls++;
+  if ((dim != 3 && dim != 4 && dim != 6) || row < 0 ||
+      row + dim > d->nefc || d->efc_id[row] < 0 ||
+      d->efc_id[row] >= d->ncon || (witness->valid != 0 && witness->valid != 3)) {
+    marble_qcqp_trace_invalid = 1;
+    return;
+  }
+  int n = dim - 1;
+  int valid = witness->valid | 4;  // raw=1, post-projection=2, retained=4
+  int width = 14 + n*n + (valid == 7 ? 7 : 5)*n;
+  if (marble_qcqp_trace_size + width > MARBLE_QCQP_TRACE_CAPACITY) {
+    marble_qcqp_trace_overflow = 1;
+    return;
+  }
+  mjtNum* out = marble_qcqp_trace + marble_qcqp_trace_size;
+  int offset = 0;
+  out[offset++] = 1;
+  out[offset++] = ordinal;
+  out[offset++] = island;
+  out[offset++] = iteration;
+  out[offset++] = row;
+  out[offset++] = d->efc_id[row];
+  out[offset++] = dim;
+  out[offset++] = witness->valid ? n : 0;
+  out[offset++] = valid;
+  out[offset++] = witness->valid ? witness->active : -1;
+  out[offset++] = witness->valid ? !!witness->active : 0;
+  out[offset++] = restored;
+  out[offset++] = costchange;
+  out[offset++] = d->efc_force[row];
+  for (int j = 0; j < n; ++j) out[offset++] = mu[j];
+  for (int j = 0; j < n*n; ++j) out[offset++] = Ac[j];
+  for (int j = 0; j < n; ++j) out[offset++] = bc[j];
+  for (int j = 0; j < n; ++j) out[offset++] = oldforce[j];
+  for (int j = 0; j < n; ++j) out[offset++] = residual[j];
+  if (valid & 1) {
+    for (int j = 0; j < n; ++j) out[offset++] = witness->raw[j];
+  }
+  if (valid & 2) {
+    for (int j = 0; j < n; ++j) out[offset++] = witness->projected[j];
+  }
+  for (int j = 0; j < n; ++j) out[offset++] = d->efc_force[row+1+j];
+  for (int j = 0; j < width; ++j) {
+    if (!isfinite(out[j])) {
+      marble_qcqp_trace_invalid = 1;
+      return;
+    }
+  }
+  marble_qcqp_trace_size += width;
+}
+#endif
