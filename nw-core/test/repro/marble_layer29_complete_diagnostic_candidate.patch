+  }
+}
+
+MJAPI void mj_constraint_state_trace_record(int label, const mjData* d) {
+  if (!marble_constraint_update_trace_recording) return;
+  const int nefc = d->nefc;
+  const int width = 2 + 2*nefc;
+  const int offset = marble_constraint_state_trace_size;
+  if (offset + width > MARBLE_CONSTRAINT_STATE_TRACE_CAPACITY) return;
+  mjtNum* out = marble_constraint_state_trace + offset;
+  out[0] = label;
+  out[1] = nefc;
+  for (int i = 0; i < nefc; ++i) out[2+i] = d->efc_state[i];
+  for (int i = 0; i < nefc; ++i) out[2+nefc+i] = d->efc_force[i];
+  marble_constraint_state_trace_size += width;
+}
+
+MJAPI void mj_constraint_state_trace_record_arrays(int label, int nefc,
+                                                    const int* state,
+                                                    const mjtNum* force) {
+  if (!marble_constraint_update_trace_recording || nefc < 0 || !state || !force) return;
+  const int width = 2 + 2*nefc;
+  const int offset = marble_constraint_state_trace_size;
+  if (offset + width > MARBLE_CONSTRAINT_STATE_TRACE_CAPACITY) return;
+  mjtNum* out = marble_constraint_state_trace + offset;
+  out[0] = label;
+  out[1] = nefc;
+  for (int i = 0; i < nefc; ++i) out[2+i] = (mjtNum)state[i];
+  for (int i = 0; i < nefc; ++i) out[2+nefc+i] = force[i];
+  marble_constraint_state_trace_size += width;
+}
+
+MJAPI int mj_constraint_state_trace_size(void) {
+  return marble_constraint_state_trace_size;
+}
+
+MJAPI void mj_constraint_state_trace_copy(mjtNum* output) {
+  if (output && marble_constraint_state_trace_size > 0) {
+    memcpy(output, marble_constraint_state_trace,
+           (size_t)marble_constraint_state_trace_size * sizeof(mjtNum));
+  }
+}
+
+MJAPI int mj_constraint_update_trace_record(const mjModel* m, const mjData* d,
+                                             const mjtNum* jar,
+                                             mjtNum* cost,
+                                             int flg_coneHessian) {
+  if (!marble_constraint_update_trace_recording) return -1;
+  const int ne = d->ne, nf = d->nf, nefc = d->nefc, ncon = d->ncon;
+  const int has_cost = cost != NULL;
+  const int width = 7 + 8*nefc + nf + 7*ncon + 2*nefc + has_cost + m->nv;
+  const int offset = marble_constraint_update_trace_size;
+  if (offset + width > MARBLE_CONSTRAINT_UPDATE_TRACE_CAPACITY) {
+    marble_constraint_update_trace_size = 0;
+    marble_constraint_update_trace_recording = 0;
+    return -1;
+  }
+  mjtNum* out = marble_constraint_update_trace + offset;
+  out[0] = ne;
+  out[1] = nf;
+  out[2] = nefc;
+  out[3] = ncon;
+  out[4] = flg_coneHessian;
+  out[5] = has_cost;
+  out[6] = m->nv;
+  int cursor = 7;
+#define MARBLE_TRACE_COPY_NUMBERS(values, count) do { \
+    memcpy(out + cursor, (values), (size_t)(count) * sizeof(mjtNum)); \
+    cursor += (count); \
+  } while (0)
+#define MARBLE_TRACE_COPY_INTS(values, count) do { \
+    for (int k = 0; k < (count); ++k) out[cursor++] = (values)[k]; \
+  } while (0)
+  MARBLE_TRACE_COPY_NUMBERS(jar, nefc);
+  MARBLE_TRACE_COPY_NUMBERS(d->efc_D, nefc);
+  MARBLE_TRACE_COPY_NUMBERS(d->efc_R, nefc);
+  MARBLE_TRACE_COPY_NUMBERS(d->efc_frictionloss, nf);
+  MARBLE_TRACE_COPY_NUMBERS(d->efc_aref, nefc);
+  MARBLE_TRACE_COPY_INTS(d->efc_type, nefc);
+  MARBLE_TRACE_COPY_INTS(d->efc_id, nefc);
+  MARBLE_TRACE_COPY_INTS(d->efc_state, nefc);
+  MARBLE_TRACE_COPY_NUMBERS(d->efc_force, nefc);
+  for (int i = 0; i < ncon; ++i) {
+    out[cursor++] = d->contact[i].dim;
+    out[cursor++] = d->contact[i].mu;
+    MARBLE_TRACE_COPY_NUMBERS(d->contact[i].friction, 5);
+  }
+#undef MARBLE_TRACE_COPY_NUMBERS
+#undef MARBLE_TRACE_COPY_INTS
+  return offset;
+}
+
+MJAPI void mj_constraint_update_trace_finish(const mjData* d, mjtNum* cost,
+                                              int offset) {
+  if (!marble_constraint_update_trace_recording || offset < 0) return;
+  const mjtNum* header = marble_constraint_update_trace + offset;
+  const int nf = (int)header[1], nefc = (int)header[2], ncon = (int)header[3];
+  const int has_cost = (int)header[5], nv = (int)header[6];
+  int cursor = offset + 7 + 8*nefc + nf + 7*ncon;
+  for (int i = 0; i < nefc; ++i) marble_constraint_update_trace[cursor++] = d->efc_force[i];
+  for (int i = 0; i < nefc; ++i) marble_constraint_update_trace[cursor++] = d->efc_state[i];
+  if (has_cost) marble_constraint_update_trace[cursor++] = *cost;
+  for (int i = 0; i < nv; ++i) marble_constraint_update_trace[cursor++] = d->qfrc_constraint[i];
+  marble_constraint_update_trace_size = cursor;
+}
