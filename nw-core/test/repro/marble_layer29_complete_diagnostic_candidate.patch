+static void marbleRecordSparseInput(const mjPrimalContext* ctx) {
+  if (marble_sparse_input_trace_size) return;
+  const int nv = ctx->nv;
+  const int nnz = ctx->M_rowadr[nv - 1] + ctx->M_rownnz[nv - 1];
+  mjtNum* out = marble_sparse_input_trace;
+  out[0] = nv;
+  out[1] = nnz;
+  marble_sparse_input_trace_size = 2;
+  const int needed = 2 + 4*nv + 2*nnz;
+  if (needed > MARBLE_SPARSE_INPUT_CAPACITY) return;
+  int offset = 2;
+  for (int i = 0; i < nv; ++i) out[offset++] = ctx->M_rownnz[i];
+  for (int i = 0; i < nv; ++i) out[offset++] = ctx->M_rowadr[i];
+  for (int i = 0; i < nnz; ++i) out[offset++] = ctx->M_colind[i];
+  for (int i = 0; i < nnz; ++i) out[offset++] = ctx->M[i];
+  for (int i = 0; i < nv; ++i) out[offset++] = ctx->qacc[i];
+  marble_sparse_input_trace_size = offset;
+}
