+static void marbleRecordCholSolve(const mjPrimalContext* ctx,
+                                  const mjtNum* factor) {
+  if (marble_chol_solve_trace_size) return;
+  const int n = ctx->nv;
+  const int nnz = ctx->is_sparse
+      ? ctx->L_rowadr[n-1] + ctx->L_rownnz[n-1] : -1;
+  const int factor_size = ctx->is_sparse ? nnz : n*n;
+  const int needed = 2 + (ctx->is_sparse ? 2*n + 2*nnz : 0) +
+                     factor_size + n;
+  if (needed > MARBLE_CHOL_SOLVE_CAPACITY) return;
+  int offset = 0;
+  marble_chol_solve_trace[offset++] = n;
+  marble_chol_solve_trace[offset++] = nnz;
+  if (ctx->is_sparse) {
+    for (int i = 0; i < n; ++i) marble_chol_solve_trace[offset++] = ctx->L_rownnz[i];
+    for (int i = 0; i < n; ++i) marble_chol_solve_trace[offset++] = ctx->L_rowadr[i];
+    for (int i = 0; i < nnz; ++i) marble_chol_solve_trace[offset++] = ctx->L_colind[i];
+  }
+  for (int i = 0; i < factor_size; ++i) marble_chol_solve_trace[offset++] = factor[i];
+  for (int i = 0; i < n; ++i) marble_chol_solve_trace[offset++] = ctx->grad[i];
+  marble_chol_solve_trace_size = offset;
+}
