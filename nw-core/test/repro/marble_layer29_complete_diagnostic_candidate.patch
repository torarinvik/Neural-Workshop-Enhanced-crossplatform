new file mode 100644
--- /dev/null
+++ b/src/engine/marble_costchange_trace.h
@@ -0,0 +1,100 @@
+// Private assigned no-slip costChange diagnostics; never a physics policy.
+#ifndef MARBLE_COSTCHANGE_TRACE_H_
+#define MARBLE_COSTCHANGE_TRACE_H_
+
+#define MARBLE_COSTCHANGE_CAPACITY 300000
+typedef struct {
+  int active;
+  int ordinal;
+  int island;
+  int iteration;
+  int row;
+  int contact;
+  int dim;
+} marbleCostOwner;
+static marbleCostOwner marble_cost_owner;
+static mjtNum marble_cost_trace[MARBLE_COSTCHANGE_CAPACITY];
+static int marble_cost_size;
+static int marble_cost_calls;
+static int marble_cost_overflow;
+static int marble_cost_invalid;
+static int marble_cost_enabled;
+
+MJAPI int mj_solver_costchange_schema(void) { return 1; }
+MJAPI int mj_solver_costchange_size(void) { return marble_cost_size; }
+MJAPI int mj_solver_costchange_calls(void) { return marble_cost_calls; }
+MJAPI int mj_solver_costchange_overflow(void) { return marble_cost_overflow; }
+MJAPI int mj_solver_costchange_invalid(void) { return marble_cost_invalid; }
+MJAPI void mj_solver_costchange_copy(mjtNum* output) {
+  if (output && marble_cost_size) {
+    memcpy(output, marble_cost_trace, (size_t)marble_cost_size * sizeof(mjtNum));
+  }
+}
+static void marbleCostReset(void) {
+  marble_cost_owner.active = 0;
+  marble_cost_size = marble_cost_calls = marble_cost_overflow = marble_cost_invalid = 0;
+}
+static void marbleCostBegin(const mjData* d, int island, int iteration,
+                            int row, int dim, int ordinal) {
+  marble_cost_owner.active = 0;
+  if (!marble_cost_enabled) return;
+  int call = marble_cost_calls++;
+  if (!d || !d->efc_id || !d->contact || (dim != 3 && dim != 4 && dim != 6) ||
+      row < 0 || row > d->nefc - dim || island < -1 || iteration < 0 ||
+      ordinal != call || d->efc_id[row] < 0 || d->efc_id[row] >= d->ncon ||
+      d->contact[d->efc_id[row]].dim != dim) {
+    marble_cost_invalid = 1;
+    return;
+  }
+  marble_cost_owner = (marbleCostOwner){1, ordinal, island, iteration, row,
+                                       d->efc_id[row], dim-1};
+}
+static void marbleCostEnd(void) { marble_cost_owner.active = 0; }
+
+static void marbleRecordCost(const mjtNum* A, const mjtNum* oldforce,
+                             const mjtNum* beforeforce, const mjtNum* res,
+                             const mjtNum* delta, const mjtNum* finalforce,
+                             int dim, mjtNum quadratic, mjtNum dot,
+                             mjtNum beforechange, mjtNum finalchange, int restored) {
+  if (!marble_cost_owner.active) return;
+  if (!A || !oldforce || !beforeforce || !res || !delta || !finalforce ||
+      dim != marble_cost_owner.dim || (dim != 2 && dim != 3 && dim != 5) ||
+      (restored != 0 && restored != 1)) {
+    marble_cost_invalid = 1;
+    return;
+  }
+  int width = 13 + dim*dim + 5*dim;
+  if (marble_cost_size > MARBLE_COSTCHANGE_CAPACITY - width) {
+    marble_cost_overflow = 1;
+    return;
+  }
+  mjtNum* out = marble_cost_trace + marble_cost_size;
+  int at = 0;
+  out[at++] = 1;
+  out[at++] = marble_cost_owner.ordinal;
+  out[at++] = marble_cost_owner.island;
+  out[at++] = marble_cost_owner.iteration;
+  out[at++] = marble_cost_owner.row;
+  out[at++] = marble_cost_owner.contact;
+  out[at++] = dim;
+  out[at++] = 7;  // actual delta, quadratic/dot, final/restoration assigned
+  out[at++] = restored;
+  out[at++] = quadratic;
+  out[at++] = dot;
+  out[at++] = beforechange;
+  out[at++] = finalchange;
+  for (int i = 0; i < dim*dim; ++i) out[at++] = A[i];
+  for (int i = 0; i < dim; ++i) out[at++] = oldforce[i];
+  for (int i = 0; i < dim; ++i) out[at++] = beforeforce[i];
+  for (int i = 0; i < dim; ++i) out[at++] = res[i];
+  for (int i = 0; i < dim; ++i) out[at++] = delta[i];
+  for (int i = 0; i < dim; ++i) out[at++] = finalforce[i];
+  for (int i = 0; i < width; ++i) {
+    if (!isfinite(out[i])) {
+      marble_cost_invalid = 1;
+      return;
+    }
+  }
+  marble_cost_size += width;
+}
+#endif
