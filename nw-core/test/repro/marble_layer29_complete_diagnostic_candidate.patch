+static void marbleRecordConstraintInput(const mjPrimalContext* ctx,
+                                        int flg_coneHessian) {
+  if (marble_constraint_input_trace_size) return;
+  int ncontact = 0;
+  for (int i = ctx->ne + ctx->nf; i < ctx->nefc; ++i) {
+    if (ctx->efc_type[i] == mjCNSTR_CONTACT_ELLIPTIC &&
+        ctx->efc_id[i] + 1 > ncontact) ncontact = ctx->efc_id[i] + 1;
+  }
+  const int nefc = ctx->nefc, nf = ctx->nf;
+  const int needed = 7 + 9*nefc + nf + 7*ncontact;
+  marble_constraint_input_trace_size = 1;
+  if (needed > MARBLE_CONSTRAINT_INPUT_CAPACITY) return;
+  mjtNum* out = marble_constraint_input_trace;
+  int offset = 0;
+  out[offset++] = ctx->ne;
+  out[offset++] = nf;
+  out[offset++] = nefc;
+  out[offset++] = ncontact;
+  out[offset++] = flg_coneHessian;
+  out[offset++] = ctx->cost;
+#define MARBLE_COPY_NUMBERS(field, count) do { \
+    memcpy(out + offset, ctx->field, (size_t)(count) * sizeof(mjtNum)); \
+    offset += (count); \
+  } while (0)
+#define MARBLE_COPY_INTS(field, count) do { \
+    for (int k = 0; k < (count); ++k) out[offset++] = ctx->field[k]; \
+  } while (0)
+  MARBLE_COPY_NUMBERS(efc_D, nefc);
+  MARBLE_COPY_NUMBERS(efc_R, nefc);
+  MARBLE_COPY_NUMBERS(efc_frictionloss, nf);
+  MARBLE_COPY_NUMBERS(Jaref, nefc);
+  MARBLE_COPY_INTS(efc_type, nefc);
+  MARBLE_COPY_INTS(efc_id, nefc);
+  MARBLE_COPY_INTS(efc_state, nefc);
+  MARBLE_COPY_NUMBERS(efc_force, nefc);
+  for (int i = 0; i < ncontact; ++i) {
+    out[offset++] = ctx->contact[i].dim;
+    out[offset++] = ctx->contact[i].mu;
+    for (int j = 0; j < 5; ++j) out[offset++] = ctx->contact[i].friction[j];
+  }
+  marble_constraint_input_trace_size = offset;
+#undef MARBLE_COPY_NUMBERS
+#undef MARBLE_COPY_INTS
+}
