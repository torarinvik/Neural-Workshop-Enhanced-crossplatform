+static void marbleRecordNewtonState(const mjPrimalContext* ctx, int label,
+                                    mjtNum alpha, mjtNum cost,
+                                    mjtNum deriv0, mjtNum deriv1) {
+  const int nv = ctx->nv;
+  const int nefc = ctx->nefc;
+  const int width = 9 + 5*nv + 2*nefc;
+  const int needed = marble_newton_trace_value_count + width;
+  if (needed > MARBLE_NEWTON_TRACE_CAPACITY) return;
+  mjtNum* record = marble_newton_trace + marble_newton_trace_value_count;
+  record[0] = label;
+  record[1] = alpha;
+  record[2] = ctx->LSiter;
+  record[3] = ctx->LSslope;
+  record[4] = nv;
+  record[5] = nefc;
+  record[6] = cost;
+  record[7] = deriv0;
+  record[8] = deriv1;
+  int offset = 9;
+#define MARBLE_COPY_TRACE(field, count) do { \
+    if (ctx->field) memcpy(record + offset, ctx->field, \
+                           (size_t)(count) * sizeof(mjtNum)); \
+    else memset(record + offset, 0, (size_t)(count) * sizeof(mjtNum)); \
+    offset += (count); \
+  } while (0)
+#define MARBLE_COPY_VALID_TRACE(field, count, bit) do { \
+    if (ctx->marble_trace_valid & (bit)) { MARBLE_COPY_TRACE(field, count); } \
+    else { \
+      memset(record + offset, 0, (size_t)(count)*sizeof(mjtNum)); \
+      offset += (count); \
+    } \
+  } while (0)
+  MARBLE_COPY_TRACE(efc_force, nefc);
+  MARBLE_COPY_TRACE(qacc, nv);
+  MARBLE_COPY_VALID_TRACE(Ma, nv, MARBLE_VALID_MA);
+  MARBLE_COPY_VALID_TRACE(grad, nv, MARBLE_VALID_GRAD);
+  MARBLE_COPY_VALID_TRACE(Mgrad, nv, MARBLE_VALID_MGRAD);
+  MARBLE_COPY_VALID_TRACE(search, nv, MARBLE_VALID_SEARCH);
+  MARBLE_COPY_VALID_TRACE(Jaref, nefc, MARBLE_VALID_JAREF);
+#undef MARBLE_COPY_VALID_TRACE
+#undef MARBLE_COPY_TRACE
+  marble_newton_trace_count++;
+  marble_newton_trace_value_count += width;
+}
