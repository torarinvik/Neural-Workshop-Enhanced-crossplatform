diff --git a/src/engine/marble_primal_eval_trace.h b/src/engine/marble_primal_eval_trace.h
new file mode 100644
index 0000000..e896119
--- /dev/null
+++ b/src/engine/marble_primal_eval_trace.h
@@ -0,0 +1,66 @@
+// Diagnostic-only completed PrimalEval capture, paired to initialized preparation.
+#ifndef MARBLE_PRIMAL_EVAL_TRACE_H_
+#define MARBLE_PRIMAL_EVAL_TRACE_H_
+
+#define MARBLE_EVAL_TRACE_CAPACITY 300000
+static mjtNum marble_eval_trace[MARBLE_EVAL_TRACE_CAPACITY];
+static int marble_eval_size, marble_eval_calls;
+static int marble_eval_enabled, marble_eval_overflow, marble_eval_invalid;
+
+MJAPI void mj_solver_eval_trace_begin(void) {
+  marble_eval_size = marble_eval_calls = 0;
+  marble_eval_overflow = marble_eval_invalid = 0;
+  marble_eval_enabled = 1;
+}
+MJAPI void mj_solver_eval_trace_end(void) { marble_eval_enabled = 0; }
+MJAPI int mj_solver_eval_trace_schema(void) { return 1; }
+MJAPI int mj_solver_eval_trace_size(void) { return marble_eval_size; }
+MJAPI int mj_solver_eval_trace_calls(void) { return marble_eval_calls; }
+MJAPI int mj_solver_eval_trace_overflow(void) { return marble_eval_overflow; }
+MJAPI int mj_solver_eval_trace_invalid(void) { return marble_eval_invalid; }
+MJAPI void mj_solver_eval_trace_copy(mjtNum* out) {
+  if (out && marble_eval_size) {
+    memcpy(out, marble_eval_trace, (size_t)marble_eval_size*sizeof(mjtNum));
+  }
+}
+
+// quad/Jaref/Jv/D/type/id/contact/Gauss are in the associated preparation.
+// Only still-missing friction bounds plus fully assigned outputs are copied.
+static void marbleRecordEvaluated(const mjPrimalContext* ctx, mjtNum alpha,
+                                  mjtNum cost, mjtNum d0, mjtNum d1, mjtNum raw_d1) {
+  if (!marble_eval_enabled) return;
+  const int ordinal = marble_eval_calls++;
+  const unsigned int required = MARBLE_VALID_COST | MARBLE_VALID_JV |
+      MARBLE_VALID_SEARCH | MARBLE_VALID_MA | MARBLE_VALID_JAREF;
+  if ((ctx->marble_trace_valid & required) != required ||
+      ctx->marble_prepare_trace_ordinal < 0 || ctx->nv < 1 || ctx->nv > 512 ||
+      ctx->nefc < 0 || ctx->nefc > 65536 || ctx->ne < 0 || ctx->nf < 0 ||
+      ctx->ne+ctx->nf > ctx->nefc) {
+    marble_eval_invalid = 1;
+    return;
+  }
+  const int width = 13 + ctx->nefc + ctx->nf;
+  if (marble_eval_size + width > MARBLE_EVAL_TRACE_CAPACITY) {
+    marble_eval_overflow = 1;
+    return;
+  }
+  mjtNum* out = marble_eval_trace + marble_eval_size;
+  out[0] = 1;
+  out[1] = ordinal;
+  out[2] = ctx->marble_prepare_trace_ordinal;
+  out[3] = ctx->island;
+  out[4] = ctx->nv;
+  out[5] = ctx->nefc;
+  out[6] = ctx->ne;
+  out[7] = ctx->nf;
+  out[8] = alpha;
+  out[9] = cost;
+  out[10] = d0;
+  out[11] = d1;
+  out[12] = raw_d1;
+  if (ctx->nefc) memcpy(out+13, ctx->efc_R, (size_t)ctx->nefc*sizeof(mjtNum));
+  if (ctx->nf) memcpy(out+13+ctx->nefc, ctx->efc_frictionloss+ctx->ne,
+                      (size_t)ctx->nf*sizeof(mjtNum));
+  marble_eval_size += width;
+}
+#endif

