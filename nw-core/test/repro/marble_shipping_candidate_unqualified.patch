+  extern mjtNum mj_marble_wheel_fma(mjtNum, mjtNum, mjtNum);
+  mjtNum* frame = con->frame;
+  for (int axis = 0; axis < 2; axis++) {
+    mjtNum* vector = frame + 3*axis;
+    mjtNum norm = mju_sqrt(mj_marble_wheel_fma(vector[2], vector[2],
