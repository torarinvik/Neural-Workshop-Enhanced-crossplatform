diff --git a/src/engine/marble_gauss_trace.h b/src/engine/marble_gauss_trace.h
new file mode 100644
index 0000000..1270a61
--- /dev/null
+++ b/src/engine/marble_gauss_trace.h
@@ -0,0 +1,55 @@
+// Private, bounded assigned Gauss operands/partial sums; no arithmetic policy.
+#ifndef MARBLE_GAUSS_TRACE_H_
+#define MARBLE_GAUSS_TRACE_H_
+#define MARBLE_GAUSS_CAPACITY 300000
+static mjtNum marble_gauss_values[MARBLE_GAUSS_CAPACITY];
+static int marble_gauss_size, marble_gauss_calls;
+static int marble_gauss_overflow, marble_gauss_invalid, marble_gauss_enabled;
+MJAPI void mj_solver_gauss_reset(void) {
+  marble_gauss_size = marble_gauss_calls = 0;
+  marble_gauss_overflow = marble_gauss_invalid = marble_gauss_enabled = 0;
+}
+MJAPI void mj_solver_gauss_begin(void) { marble_gauss_enabled = 1; }
+MJAPI void mj_solver_gauss_end(void) { marble_gauss_enabled = 0; }
+MJAPI int mj_solver_gauss_schema(void) { return 1; }
+MJAPI int mj_solver_gauss_size(void) { return marble_gauss_size; }
+MJAPI int mj_solver_gauss_calls(void) { return marble_gauss_calls; }
+MJAPI int mj_solver_gauss_overflow(void) { return marble_gauss_overflow; }
+MJAPI int mj_solver_gauss_invalid(void) { return marble_gauss_invalid; }
+MJAPI void mj_solver_gauss_copy(mjtNum* out) {
+  if (out && marble_gauss_size) {
+    memcpy(out, marble_gauss_values, (size_t)marble_gauss_size*sizeof(mjtNum));
+  }
+}
+static void marbleRecordGauss(const mjPrimalContext* ctx, mjtNum before,
+                              mjtNum gauss, const mjtNum* partial) {
+  if (!marble_gauss_enabled) return;
+  int ordinal = marble_gauss_calls++;
+  if (ctx->nv < 0 || ctx->nv > 512 || ctx->nefc < 0 || ctx->nefc > 65536 ||
+      (ctx->marble_trace_valid & (MARBLE_VALID_COST | MARBLE_VALID_MA)) !=
+          (MARBLE_VALID_COST | MARBLE_VALID_MA)) {
+    marble_gauss_invalid = 1;
+    return;
+  }
+  int width = 9 + 5*ctx->nv;
+  if (marble_gauss_size + width > MARBLE_GAUSS_CAPACITY) {
+    marble_gauss_overflow = 1;
+    return;
+  }
+  mjtNum* out = marble_gauss_values + marble_gauss_size;
+  int offset = 0;
+  out[offset++] = 1; out[offset++] = ordinal;
+  out[offset++] = ctx->island; out[offset++] = ctx->nv;
+  out[offset++] = ctx->nefc; out[offset++] = 3;
+  out[offset++] = before; out[offset++] = ctx->cost; out[offset++] = gauss;
+  const mjtNum* arrays[] = {ctx->Ma, ctx->qfrc_smooth, ctx->qacc,
+                           ctx->qacc_smooth, partial};
+  for (int field = 0; field < 5; ++field) {
+    for (int i = 0; i < ctx->nv; ++i) out[offset++] = arrays[field][i];
+  }
+  for (int i = 0; i < width; ++i) {
+    if (!isfinite(out[i])) { marble_gauss_invalid = 1; return; }
+  }
+  marble_gauss_size += width;
+}
+#endif
