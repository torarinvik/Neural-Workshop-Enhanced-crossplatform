+    mj_marble_wheel_fma(a[3], b[1], mj_marble_wheel_fma(a[2], b[0], mj_marble_wheel_fma(a[0], b[2], -(a[1]*b[3])))),
+    mj_marble_wheel_fma(a[3], b[0], mj_marble_wheel_fma(-a[2], b[1], mj_marble_wheel_fma(a[0], b[3], a[1]*b[2])))
+  };
+  mji_copy4(res, tmp);
+}
+#endif
