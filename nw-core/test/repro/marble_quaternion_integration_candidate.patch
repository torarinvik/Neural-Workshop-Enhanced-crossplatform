 // integrate quaternion given 3D angular velocity
+#ifdef __EMSCRIPTEN__
+// Integration-local original ARM64 ordering; generic multiplication stays unchanged.
+extern mjtNum mj_marble_wheel_fma(mjtNum, mjtNum, mjtNum);
+static void marble_integrate_mulQuat(mjtNum res[4], const mjtNum a[4],
+                                     const mjtNum b[4]) {
+  mjtNum tmp[4] = {
+    mj_marble_wheel_fma(-a[3], b[3], mj_marble_wheel_fma(-a[2], b[2], mj_marble_wheel_fma(a[0], b[0], -(a[1]*b[1])))),
