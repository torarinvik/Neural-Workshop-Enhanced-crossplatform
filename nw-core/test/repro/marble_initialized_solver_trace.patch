+static void marbleRecordNoSlipStep(const mjData* d, int island, int iteration,
+                                   int nefc, const int* efclist,
+                                   mjtNum raw_improvement, mjtNum scale,
+                                   mjtNum scaled_improvement, int nactive,
+                                   int nchange, const int* oldstate) {
+  const int width = 8 + 4*nefc;
+  if (marble_noslip_step_trace_size + width >
+      MARBLE_NOSLIP_STEP_TRACE_CAPACITY) return;
+  mjtNum* record = marble_noslip_step_trace + marble_noslip_step_trace_size;
+  int offset = 0;
+  record[offset++] = island;
+  record[offset++] = iteration;
+  record[offset++] = nefc;
+  record[offset++] = raw_improvement;
+  record[offset++] = scale;
+  record[offset++] = scaled_improvement;
+  record[offset++] = nactive;
+  record[offset++] = nchange;
+  for (int c = 0; c < nefc; ++c) {
+    int i = efclist ? efclist[c] : c;
+    record[offset++] = i;
+    record[offset++] = d->efc_force[i];
+    record[offset++] = oldstate[c];
+    record[offset++] = d->efc_state[i];
+  }
+  marble_noslip_step_trace_size += width;
+}
+static void marbleRecordJaref(const mjPrimalContext* ctx) {
+  // The first investigation targets the dense path. Sparse records need a
+  // separate row/column schema and are intentionally omitted rather than
+  // pretending a packed J array has dense semantics.
+  if (ctx->is_sparse) return;
+  const int nefc = ctx->nefc;
+  const int nv = ctx->nv;
+  const int width = 4 + nv + nefc + nefc*nv + nefc;
+  if (marble_jaref_trace_size + width > MARBLE_JAREF_TRACE_CAPACITY) return;
+  mjtNum* record = marble_jaref_trace + marble_jaref_trace_size;
+  int offset = 0;
+  record[offset++] = ctx->island;
+  record[offset++] = nefc;
+  record[offset++] = nv;
+  record[offset++] = ctx->is_sparse;
+  for (int i = 0; i < nv; ++i) record[offset++] = ctx->qacc[i];
+  for (int i = 0; i < nefc; ++i) record[offset++] = ctx->efc_aref[i];
+  for (int i = 0; i < nefc*nv; ++i) record[offset++] = ctx->J[i];
+  for (int i = 0; i < nefc; ++i) record[offset++] = ctx->Jaref[i];
+  marble_jaref_trace_size += width;
+}
+static void marbleRecordJv(const mjPrimalContext* ctx) {
+  // This is the dense J*search result used as the line-search direction.
+  if (ctx->is_sparse) return;
+  const int nefc = ctx->nefc;
+  const int nv = ctx->nv;
+  const int width = 4 + nv + nefc*nv + nefc;
+  if (marble_jv_trace_size + width > MARBLE_JV_TRACE_CAPACITY) return;
+  mjtNum* record = marble_jv_trace + marble_jv_trace_size;
+  int offset = 0;
+  record[offset++] = ctx->island;
+  record[offset++] = nefc;
+  record[offset++] = nv;
+  record[offset++] = ctx->is_sparse;
+  for (int i = 0; i < nv; ++i) record[offset++] = ctx->search[i];
+  for (int i = 0; i < nefc*nv; ++i) record[offset++] = ctx->J[i];
+  for (int i = 0; i < nefc; ++i) record[offset++] = ctx->Jv[i];
+  marble_jv_trace_size += width;
+}
+static int marbleBeginJarefUpdate(const mjPrimalContext* ctx, mjtNum alpha) {
+  const int nefc = ctx->nefc;
+  const int width = 3 + 3*nefc;
+  if (marble_jaref_update_trace_size + width >
+      MARBLE_JAREF_UPDATE_TRACE_CAPACITY) return -1;
+  const int offset = marble_jaref_update_trace_size;
+  mjtNum* record = marble_jaref_update_trace + offset;
+  int cursor = 0;
+  record[cursor++] = ctx->island;
+  record[cursor++] = nefc;
+  record[cursor++] = alpha;
+  for (int i = 0; i < nefc; ++i) record[cursor++] = ctx->Jaref[i];
+  for (int i = 0; i < nefc; ++i) record[cursor++] = ctx->Jv[i];
+  return offset;
+}
+static void marbleFinishJarefUpdate(const mjPrimalContext* ctx, int offset) {
+  if (offset < 0) return;
+  const int nefc = ctx->nefc;
+  mjtNum* record = marble_jaref_update_trace + offset;
+  int cursor = 3 + 2*nefc;
+  for (int i = 0; i < nefc; ++i) record[cursor++] = ctx->Jaref[i];
+  marble_jaref_update_trace_size = offset + cursor;
+}
+static void marbleRecordNoSlipContact(const mjData* d, int island, int iter,
+                                      int row, int dim, mjtNum normal,
+                                      const mjtNum* mu, const mjtNum* residual,
+                                      const mjtNum* oldforce, const mjtNum* Ac,
+                                      const mjtNum* bc, mjtNum costchange) {
+  const int tangent = dim - 1;
+  const int width = 12 + 7*tangent + tangent*tangent;
+  if (marble_noslip_contact_trace_size + width > MARBLE_NOSLIP_CONTACT_TRACE_CAPACITY) return;
+  mjtNum* record = marble_noslip_contact_trace + marble_noslip_contact_trace_size;
+  int offset = 0;
+  record[offset++] = island; record[offset++] = iter; record[offset++] = row;
+  record[offset++] = dim; record[offset++] = d->efc_id[row]; record[offset++] = normal;
+  for (int j = 0; j < 5; ++j) record[offset++] = mu[j];
+  for (int j = 0; j < tangent; ++j) record[offset++] = residual[j];
+  for (int j = 0; j < tangent; ++j) record[offset++] = oldforce[j];
+  for (int j = 0; j < tangent*tangent; ++j) record[offset++] = Ac[j];
+  for (int j = 0; j < tangent; ++j) record[offset++] = bc[j];
+  for (int j = 0; j < tangent; ++j) record[offset++] = d->efc_force[row+1+j];
+  record[offset++] = costchange;
+  for (int j = 0; j < tangent; ++j) record[offset++] = d->efc_b[row+1+j];
+  for (int j = 0; j < tangent; ++j) record[offset++] = d->efc_R[row+1+j];
+  for (int j = 0; j < tangent; ++j) record[offset++] = d->efc_force[row+1+j];
+  marble_noslip_contact_trace_size += width;
+}
+static void marbleRecordNoSlip(const mjData* d, int island, int iteration,
+                               int nefc, const int* efclist,
+                               mjtNum improvement, int nactive, int nchange) {
+  const int width = 6 + 3*nefc;
+  if (marble_noslip_trace_size + width > MARBLE_NOSLIP_TRACE_CAPACITY) return;
+  mjtNum* record = marble_noslip_trace + marble_noslip_trace_size;
+  record[0] = island; record[1] = iteration; record[2] = nefc;
+  record[3] = improvement; record[4] = nactive; record[5] = nchange;
+  int offset = 6;
+  for (int c = 0; c < nefc; ++c) {
+    int i = efclist ? efclist[c] : c;
+    record[offset++] = i; record[offset++] = d->efc_force[i];
+    record[offset++] = d->efc_state[i];
+  }
+  marble_noslip_trace_size += width;
+}
