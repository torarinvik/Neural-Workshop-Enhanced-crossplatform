+// Copy-isolated remainder of mj_advance for these free-body-only models:
+// return qacc, updated qvel, and updated qpos after the velocity/position step.
+std::vector<double> marble_free_joint_advance_probe(const MjModel& model,
+                                                     const MjData& source) {
+  const mjModel* m = model.get();
+  const mjData* d = source.get();
+  std::vector<double> solve = marble_free_joint_solve_probe(model, source);
+  std::vector<double> qacc(m->nv, 0.0);
+  int free_index = 0;
+  for (int joint = 0; joint < m->njnt; ++joint) {
+    if (m->jnt_type[joint] != mjJNT_FREE) continue;
+    const int adr = m->jnt_dofadr[joint];
+    const int solved_offset = free_index++ * 84 + 78;
+    for (int i = 0; i < 6; ++i) qacc[adr + i] = solve[solved_offset + i];
+  }
+  std::vector<double> qvel(d->qvel, d->qvel + m->nv);
+  mju_addToScl(qvel.data(), qacc.data(), m->opt.timestep, m->nv);
+  std::vector<double> qpos(d->qpos, d->qpos + m->nq);
+  mj_integratePos(m, qpos.data(), qvel.data(), m->opt.timestep);
+  std::vector<double> result;
+  result.insert(result.end(), qacc.begin(), qacc.end());
+  result.insert(result.end(), qvel.begin(), qvel.end());
+  result.insert(result.end(), qpos.begin(), qpos.end());
+  return result;
+}
