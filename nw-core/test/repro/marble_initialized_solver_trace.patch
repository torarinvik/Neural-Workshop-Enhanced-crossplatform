+// Diagnostic-only copy-isolated capture of MuJoCo's standalone free-joint
+// implicit solve. Each row is [A(36), LU(36), pivots(6), qacc(6)].
+std::vector<double> marble_free_joint_solve_probe(const MjModel& model,
+                                                   const MjData& source) {
+  MjData copy(model, source);
+  mjModel* m = model.get();
+  mjData* d = copy.get();
+  mjd_smooth_vel(m, d, /*flg_bias=*/0);
+  std::vector<double> result;
+  for (int joint = 0; joint < m->njnt; ++joint) {
+    if (m->jnt_type[joint] != mjJNT_FREE) continue;
+    mjtNum A[36];
+    if (!mjd_freeMhat(m, d, joint, m->opt.timestep, A)) continue;
+    mjtNum LU[36];
+    mju_copy(LU, A, 36);
+    int pivot[6];
+    int singular = mju_factorLU6(LU, pivot);
+    int adr = m->jnt_dofadr[joint];
+    mjtNum rhs[6], x[6] = {};
+    for (int i = 0; i < 6; ++i) {
+      rhs[i] = d->qfrc_smooth[adr + i] + d->qfrc_constraint[adr + i];
+    }
+    if (singular) mju_solveLU6(x, LU, rhs, pivot);
+    result.insert(result.end(), A, A + 36);
+    result.insert(result.end(), LU, LU + 36);
+    for (int value : pivot) result.push_back(value);
+    result.insert(result.end(), x, x + 6);
+  }
+  return result;
+}
