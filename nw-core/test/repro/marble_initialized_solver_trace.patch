+MJAPI void mj_solver_trace_run(const mjModel* model, mjData* data) {
+  mj_solver_trace_reset();
+  extern void mj_constraint_update_trace_begin(void);
+  extern void mj_constraint_update_trace_end(void);
+  mj_constraint_update_trace_begin();
+  // The trace buffer is process-global; force the same independent island tasks
+  // through MuJoCo's serial dispatch path while collecting diagnostic records.
+  uintptr_t threadpool = data->threadpool;
+  data->threadpool = 0;
+  mj_fwdConstraint(model, data);
+  data->threadpool = threadpool;
+  mj_constraint_update_trace_end();
+}
