+std::vector<double> marble_free_joint_derivative_probe(const MjModel& model,
+                                                        const MjData& source) {
+  MjData copy(model, source);
+  const mjModel* m = model.get();
+  mjData* d = copy.get();
+  mjd_smooth_vel(m, d, /*flg_bias=*/0);
+  std::vector<double> result;
+  for (int joint = 0; joint < m->njnt; ++joint) {
+    if (m->jnt_type[joint] != mjJNT_FREE) continue;
+    const int dof = m->jnt_dofadr[joint];
+    double block[36] = {};
+    for (int row = 0; row < 6; ++row) {
+      const int global_row = dof + row;
+      const int rowadr = m->D_rowadr[global_row];
+      for (int k = 0; k < m->D_rownnz[global_row]; ++k) {
