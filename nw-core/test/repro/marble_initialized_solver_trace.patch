+  mj_constraint_state_trace_copy(state_trace.data());
+  val state_trace_values = val::array();
+  for (int i = 0; i < state_trace_size; i++) {
+    state_trace_values.set(i, state_trace[i]);
+  }
+  output.set("constraintStateTrace", state_trace_values);
+  return output;
+}
+
+// Diagnostic-only helper: MjData::contact() returns value-copied wrappers,
+// so JS writes to those wrappers do not reach mjData::contact.  Copy the
+// captured solver contacts through the backing C array instead.
+bool marble_sync_solver_contacts_wrapper(MjData& d, const val& contacts) {
+  mjData* data = d.get();
+  const int count = contacts["length"].as<int>();
+  if (count != data->ncon) return false;
+  for (int i = 0; i < count; ++i) {
+    const val source = contacts[i];
+    mjContact* target = data->contact + i;
+    target->geom1 = source["geom1"].as<int>();
+    target->geom2 = source["geom2"].as<int>();
+    target->dist = source["dist"].as<mjtNum>();
+    target->dim = source["dim"].as<int>();
+    target->mu = source["mu"].as<mjtNum>();
+    const val pos = source["pos"];
+    const val frame = source["frame"];
+    const val friction = source["friction"];
+    for (int j = 0; j < 3; ++j) target->pos[j] = pos[j].as<mjtNum>();
+    for (int j = 0; j < 9; ++j) target->frame[j] = frame[j].as<mjtNum>();
+    for (int j = 0; j < 5; ++j) {
+      target->friction[j] = friction[j].as<mjtNum>();
+    }
+  }
+  return true;
+}
+
+void marble_constraint_update_trace_begin_wrapper() {
+  mj_constraint_update_trace_begin();
+}
+
+void marble_constraint_update_trace_end_wrapper() {
+  mj_constraint_update_trace_end();
+}
+
+val marble_constraint_update_trace_copy_wrapper() {
+  const int size = mj_constraint_update_trace_size();
+  std::vector<mjtNum> trace(size);
+  mj_constraint_update_trace_copy(trace.data());
+  val output = val::array();
+  for (int i = 0; i < size; ++i) output.set(i, trace[i]);
+  return output;
+}
