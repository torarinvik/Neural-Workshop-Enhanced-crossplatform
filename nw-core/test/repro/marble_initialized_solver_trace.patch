+  if (marble_constraint_input_trace_size <= 1 || marble_constraint_output_recorded) return;
+  int offset = marble_constraint_input_trace_size;
+  for (int i = 0; i < ctx->nefc; ++i) {
+    marble_constraint_input_trace[offset++] = ctx->efc_force[i];
+  }
+  for (int i = 0; i < ctx->nefc; ++i) {
+    marble_constraint_input_trace[offset++] = ctx->efc_state[i];
+  }
+  marble_constraint_input_trace[offset++] = ctx->cost;
+  marble_constraint_input_trace_size = offset;
+  marble_constraint_output_recorded = 1;
+}
+
+// Snapshot the exact operands/results of each iterative primal constraint update.
+// Record pairs are tagged with phase 0 (inputs) or 1 (outputs).
+static void marbleRecordConstraintIteration(const mjPrimalContext* ctx,
+                                            int flg_coneHessian,
+                                            int phase) {
+  int ncontact = 0;
+  for (int i = ctx->ne + ctx->nf; i < ctx->nefc; ++i) {
+    if (ctx->efc_type[i] == mjCNSTR_CONTACT_ELLIPTIC &&
+        ctx->efc_id[i] + 1 > ncontact) ncontact = ctx->efc_id[i] + 1;
+  }
+  const int nefc = ctx->nefc, nf = ctx->nf;
+  const int width = 7 + 8*nefc + nf + 7*ncontact + 2*ctx->nv;
+  if (marble_constraint_iteration_trace_size + width >
+      MARBLE_CONSTRAINT_ITERATION_TRACE_CAPACITY) return;
+  mjtNum* out = marble_constraint_iteration_trace +
+                marble_constraint_iteration_trace_size;
+  int offset = 0;
+  out[offset++] = phase;
+  out[offset++] = ctx->ne;
+  out[offset++] = nf;
+  out[offset++] = nefc;
+  out[offset++] = ncontact;
+  out[offset++] = ctx->nv;
+  out[offset++] = flg_coneHessian;
+  out[offset++] = ctx->cost;
+#define MARBLE_ITER_COPY_NUMBERS(values, count) do { \
+    memcpy(out + offset, (values), (size_t)(count) * sizeof(mjtNum)); \
+    offset += (count); \
+  } while (0)
+#define MARBLE_ITER_COPY_INTS(values, count) do { \
+    for (int k = 0; k < (count); ++k) out[offset++] = (values)[k]; \
+  } while (0)
+  MARBLE_ITER_COPY_NUMBERS(ctx->efc_D, nefc);
+  MARBLE_ITER_COPY_NUMBERS(ctx->efc_R, nefc);
+  MARBLE_ITER_COPY_NUMBERS(ctx->efc_frictionloss, nf);
+  MARBLE_ITER_COPY_NUMBERS(ctx->Jaref, nefc);
+  MARBLE_ITER_COPY_INTS(ctx->efc_type, nefc);
+  MARBLE_ITER_COPY_INTS(ctx->efc_id, nefc);
+  MARBLE_ITER_COPY_INTS(ctx->efc_state, nefc);
+  MARBLE_ITER_COPY_NUMBERS(ctx->efc_force, nefc);
+  MARBLE_ITER_COPY_NUMBERS(ctx->Jv, ctx->nv);
+  MARBLE_ITER_COPY_NUMBERS(ctx->search, ctx->nv);
+  for (int i = 0; i < ncontact; ++i) {
+    out[offset++] = ctx->contact[i].dim;
+    out[offset++] = ctx->contact[i].mu;
+    MARBLE_ITER_COPY_NUMBERS(ctx->contact[i].friction, 5);
+  }
+#undef MARBLE_ITER_COPY_NUMBERS
+#undef MARBLE_ITER_COPY_INTS
+  marble_constraint_iteration_trace_size += offset;
+}
+
+static void marbleRecordCholSolve(const mjPrimalContext* ctx,
+                                  const mjtNum* factor) {
+  if (marble_chol_solve_trace_size) return;
+  const int n = ctx->nv;
+  const int nnz = ctx->is_sparse
+      ? ctx->L_rowadr[n-1] + ctx->L_rownnz[n-1] : -1;
+  const int factor_size = ctx->is_sparse ? nnz : n*n;
+  const int needed = 2 + (ctx->is_sparse ? 2*n + 2*nnz : 0) +
+                     factor_size + n;
+  if (needed > MARBLE_CHOL_SOLVE_CAPACITY) return;
+  int offset = 0;
+  marble_chol_solve_trace[offset++] = n;
+  marble_chol_solve_trace[offset++] = nnz;
+  if (ctx->is_sparse) {
+    for (int i = 0; i < n; ++i) marble_chol_solve_trace[offset++] = ctx->L_rownnz[i];
+    for (int i = 0; i < n; ++i) marble_chol_solve_trace[offset++] = ctx->L_rowadr[i];
+    for (int i = 0; i < nnz; ++i) marble_chol_solve_trace[offset++] = ctx->L_colind[i];
+  }
+  for (int i = 0; i < factor_size; ++i) marble_chol_solve_trace[offset++] = factor[i];
+  for (int i = 0; i < n; ++i) marble_chol_solve_trace[offset++] = ctx->grad[i];
+  marble_chol_solve_trace_size = offset;
+}
