 // compute cost change
 static mjtNum costChange(const mjtNum* A, mjtNum* force, const mjtNum* oldforce,
                          const mjtNum* res, int dim, int* restored) {
   mjtNum change;
+  mjtNum delta[6], marble_before_force[6];
+  mjtNum marble_quadratic = 0, marble_dot = 0;
+  int marble_record = marble_cost_owner.active;
+  int marble_restored = 0;
+  if (marble_record) {
+    if (dim != marble_cost_owner.dim || (dim != 2 && dim != 3 && dim != 5) ||
+        !A || !force || !oldforce || !res) {
+      marble_cost_invalid = 1;
+      marble_record = 0;
+    } else {
+      mju_copy(marble_before_force, force, dim);
+    }
+  }
   if (restored) *restored = 0;
 
   // compute change
   if (dim == 1) {
-    mjtNum delta = force[0] - oldforce[0];
-    change = 0.5*delta*delta*A[0] + delta*res[0];
+    mjtNum scalar_delta = force[0] - oldforce[0];
+    change = 0.5*scalar_delta*scalar_delta*A[0] + scalar_delta*res[0];
   } else {
-    mjtNum delta[6];
     mju_sub(delta, force, oldforce, dim);
-    change = 0.5*mju_mulVecMatVec(delta, A, delta, dim) + mju_dot(delta, res, dim);
+    if (marble_record) {
+      // Retain each ACTUAL producer return; never evaluate it a second time.
+      marble_quadratic = mju_mulVecMatVec(delta, A, delta, dim);
+      marble_dot = mju_dot(delta, res, dim);
+      change = 0.5*marble_quadratic + marble_dot;
+    } else {
+      change = 0.5*mju_mulVecMatVec(delta, A, delta, dim) + mju_dot(delta, res, dim);
+    }
   }
+  mjtNum marble_before_change = change;
 
   // positive change: restore force
   if (change > 1e-10) {
+    marble_restored = 1;
     if (restored) *restored = 1;
     mju_copy(force, oldforce, dim);
     change = 0;
   }
 
+  if (marble_record) {
+    marbleRecordCost(A, oldforce, marble_before_force, res, delta, force,
+                     dim, marble_quadratic, marble_dot, marble_before_change,
+                     change, marble_restored);
+  }
   return change;
 }
 
