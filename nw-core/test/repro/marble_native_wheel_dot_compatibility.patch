diff --git a/src/engine/engine_util_blas.c b/src/engine/engine_util_blas.c
--- a/src/engine/engine_util_blas.c
+++ b/src/engine/engine_util_blas.c
@@ -495,6 +495,13 @@
 
 // vector dot-product
 mjtNum mju_dot(const mjtNum* vec1, const mjtNum* vec2, int n) {
+#if defined(__APPLE__) && defined(__aarch64__)
+  // Diagnostic native reference compatibility, not a browser arithmetic change.
+  // The original arm64 wheel rounds separate products in complete 32-element
+  // chunks, then uses fused four-lane accumulation for the remaining quads.
+  // Apple Clang 21 instead chooses 16-element chunks unless this is explicit.
+#pragma clang fp contract(off)
+#endif
   mjtNum res = 0;
   int i = 0;
 #ifdef mjUSEAVX
@@ -509,8 +516,19 @@
   mjtNum res2 = 0;
   mjtNum res3 = 0;
 
+#if defined(__APPLE__) && defined(__aarch64__)
+  int rounded_end = (n / 32) * 32;
+#pragma clang loop vectorize(disable) interleave(disable)
+  for (; i < rounded_end; i += 4) {
+    res0 += vec1[i] * vec2[i];
+    res1 += vec1[i+1] * vec2[i+1];
+    res2 += vec1[i+2] * vec2[i+2];
+    res3 += vec1[i+3] * vec2[i+3];
+  }
+#pragma clang loop vectorize(disable) interleave(disable)
+#endif
   for (; i <= n_4; i+=4) {
-#if defined(__EMSCRIPTEN__)
+#if defined(__EMSCRIPTEN__) || (defined(__APPLE__) && defined(__aarch64__))
     res0 = fma(vec1[i], vec2[i], res0);
     res1 = fma(vec1[i+1], vec2[i+1], res1);
     res2 = fma(vec1[i+2], vec2[i+2], res2);
@@ -528,20 +546,20 @@
   // process remaining
   int n_i = n - i;
   if (n_i == 3) {
-#if defined(__EMSCRIPTEN__)
+#if defined(__EMSCRIPTEN__) || (defined(__APPLE__) && defined(__aarch64__))
     res += fma(vec1[i+2], vec2[i+2],
                fma(vec1[i], vec2[i], vec1[i+1] * vec2[i+1]));
 #else
     res += vec1[i]*vec2[i] + vec1[i+1]*vec2[i+1] + vec1[i+2]*vec2[i+2];
 #endif
   } else if (n_i == 2) {
-#if defined(__EMSCRIPTEN__)
+#if defined(__EMSCRIPTEN__) || (defined(__APPLE__) && defined(__aarch64__))
     res += fma(vec1[i], vec2[i], vec1[i+1] * vec2[i+1]);
 #else
     res += vec1[i]*vec2[i] + vec1[i+1]*vec2[i+1];
 #endif
   } else if (n_i == 1) {
-#if defined(__EMSCRIPTEN__)
+#if defined(__EMSCRIPTEN__) || (defined(__APPLE__) && defined(__aarch64__))
     res = fma(vec1[i], vec2[i], res);
 #else
     res += vec1[i]*vec2[i];
