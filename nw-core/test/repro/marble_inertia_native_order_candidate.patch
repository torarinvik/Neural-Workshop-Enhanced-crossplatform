 // multiply 6D vector (rotation, translation) by 6D inertia matrix
+#ifdef __EMSCRIPTEN__
+extern mjtNum mj_marble_wheel_fma(mjtNum, mjtNum, mjtNum);
+#endif
 void mju_mulInertVec(mjtNum* restrict res, const mjtNum i[10], const mjtNum v[6]) {
+#ifdef __EMSCRIPTEN__
+  // Private combined candidate: actual original arm64 public routine order.
+  // This SHARED helper also serves mass-matrix/derivative callers, not only RNE.
+  res[0] = mj_marble_wheel_fma(i[7], v[5], mj_marble_wheel_fma(-i[8], v[4],
+      mj_marble_wheel_fma(i[4], v[2], mj_marble_wheel_fma(i[0], v[0], i[3]*v[1]))));
+  res[1] = mj_marble_wheel_fma(-i[6], v[5], mj_marble_wheel_fma(i[8], v[3],
+      mj_marble_wheel_fma(i[5], v[2], mj_marble_wheel_fma(i[3], v[0], i[1]*v[1]))));
+  res[2] = mj_marble_wheel_fma(i[6], v[4], mj_marble_wheel_fma(-i[7], v[3],
+      mj_marble_wheel_fma(i[2], v[2], mj_marble_wheel_fma(i[4], v[0], i[5]*v[1]))));
+  res[3] = mj_marble_wheel_fma(i[9], v[3], mj_marble_wheel_fma(i[8], v[1], (-i[7])*v[2]));
+  res[4] = mj_marble_wheel_fma(i[9], v[4], mj_marble_wheel_fma(i[6], v[2], (-i[8])*v[0]));
+  res[5] = mj_marble_wheel_fma(i[9], v[5], mj_marble_wheel_fma(i[7], v[0], (-i[6])*v[1]));
+#else
   res[0] = i[0]*v[0] + i[3]*v[1] + i[4]*v[2] - i[8]*v[4] + i[7]*v[5];
   res[1] = i[3]*v[0] + i[1]*v[1] + i[5]*v[2] + i[8]*v[3] - i[6]*v[5];
   res[2] = i[4]*v[0] + i[5]*v[1] + i[2]*v[2] - i[7]*v[3] + i[6]*v[4];
   res[3] = i[8]*v[1] - i[7]*v[2] + i[9]*v[3];
   res[4] = i[6]*v[2] - i[8]*v[0] + i[9]*v[4];
   res[5] = i[7]*v[0] - i[6]*v[1] + i[9]*v[5];
+#endif
 }
 
+#ifdef __EMSCRIPTEN__
+// Packet [schema1,inertia10,vector6]; validate the whole packet before pointers.
+MJAPI int mj_marble_inertia_probe(const mjtNum* packet, int size, mjtNum* output) {
+  if (!packet || !output || size != 17) return 0;
+  for (int i = 0; i < size; ++i) if (!isfinite(packet[i])) return 0;
+  if (packet[0] != 1) return 0;
+  mju_mulInertVec(output, packet+1, packet+11);
+  for (int i = 0; i < 6; ++i) if (!isfinite(output[i])) return 0;
+  return 1;
+}
+#endif
