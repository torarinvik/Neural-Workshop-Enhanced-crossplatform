diff --git a/src/engine/engine_collision_driver.c b/src/engine/engine_collision_driver.c
index 8c586d9..fff05dd 100644
--- a/src/engine/engine_collision_driver.c
+++ b/src/engine/engine_collision_driver.c
@@ -1862,7 +1862,40 @@ static void mj_setContact(const mjModel* m, mjContact* con,
   }
 
   // complete frame
+#ifdef __EMSCRIPTEN__
+  // Collision-local original-wheel ordering; generic makeFrame is unchanged.
+  extern mjtNum mj_marble_wheel_fma(mjtNum, mjtNum, mjtNum);
+  mjtNum* frame = con->frame;
+  for (int axis = 0; axis < 2; axis++) {
+    mjtNum* vector = frame + 3*axis;
+    mjtNum norm = mju_sqrt(mj_marble_wheel_fma(vector[2], vector[2],
+                           mj_marble_wheel_fma(vector[0], vector[0], vector[1]*vector[1])));
+    if (axis == 0 && norm < 0.5) mjERROR("xaxis of contact frame undefined");
+    if (norm < mjMINVAL) {
+      vector[0] = 1; vector[1] = vector[2] = 0;
+    } else {
+      mjtNum inverse = 1/norm;
+      for (int k = 0; k < 3; k++) vector[k] *= inverse;
+    }
+    if (axis == 0) {
+      mjtNum tangentNormSquared = mj_marble_wheel_fma(frame[5], frame[5],
+                                   mj_marble_wheel_fma(frame[3], frame[3], frame[4]*frame[4]));
+      if (tangentNormSquared < 0.25) {
+        mju_zero3(frame+3);
+        if (frame[1] < 0.5 && frame[1] > -0.5) frame[4] = 1;
+        else frame[5] = 1;
+      }
+      mjtNum projection = mj_marble_wheel_fma(frame[2], frame[5],
+                            mj_marble_wheel_fma(frame[0], frame[3], frame[1]*frame[4]));
+      for (int k = 0; k < 3; k++) frame[k+3] -= frame[k]*projection;
+    }
+  }
+  frame[6] = mj_marble_wheel_fma(frame[1], frame[5], -(frame[2]*frame[4]));
+  frame[7] = mj_marble_wheel_fma(frame[2], frame[3], -(frame[0]*frame[5]));
+  frame[8] = mj_marble_wheel_fma(frame[0], frame[4], -(frame[1]*frame[3]));
+#else
   mju_makeFrame(con->frame);
+#endif
 
   // clear fields that are computed later
   con->efc_address = -1;
