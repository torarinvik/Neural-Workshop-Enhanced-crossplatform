+extern mjtNum mj_marble_wheel_fma(mjtNum, mjtNum, mjtNum);
+static mjtNum marble_bias_dot(const mjtNum a[3], const mjtNum b[3]) {
+  return mj_marble_wheel_fma(a[2], b[2], mj_marble_wheel_fma(a[0], b[0], a[1]*b[1]));
+}
+static void marble_bias_cross(mjtNum out[3], const mjtNum a[3], const mjtNum b[3]) {
+  out[0] = mj_marble_wheel_fma(a[1], b[2], -(a[2]*b[1]));
+  out[1] = mj_marble_wheel_fma(a[2], b[0], -(a[0]*b[2]));
+  out[2] = mj_marble_wheel_fma(a[0], b[1], -(a[1]*b[0]));
