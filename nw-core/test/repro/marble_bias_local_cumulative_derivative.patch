+void mjd_freeJoint_qDeriv_probe(const mjModel* m, const mjData* d, int jnt,
+                                mjtNum block[36]) {
+  mjData* copy = mj_copyData(NULL, m, d);
+  mjd_smooth_vel(m, copy, /*flg_bias=*/0);
+  mju_zero(block, 36);
+  int dof = m->jnt_dofadr[jnt];
+  for (int row = 0; row < 6; ++row) {
+    int global_row = dof + row;
+    int rowadr = m->D_rowadr[global_row];
+    for (int k = 0; k < m->D_rownnz[global_row]; ++k) {
+      int offset = rowadr + k;
+      int col = m->D_colind[offset] - dof;
+      if (col >= 0 && col < 6) block[6*row + col] = copy->qDeriv[offset];
+    }
+  }
+  mj_deleteData(copy);
+}
