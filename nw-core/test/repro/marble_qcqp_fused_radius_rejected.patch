+// Fixed-size diagnostic packet: schema, n=5, radius, matrix25, RHS5, mu5.
+MJAPI int mj_marble_qcqp5_probe(const mjtNum* packet, int size,
+                              mjtNum* output, int* active) {
+  if (!packet || !output || !active || size != 38) return 0;
+  for (int i = 0; i < size; ++i) if (!isfinite(packet[i])) return 0;
+  if (packet[0] != 1 || packet[1] != 5 || packet[2] < 0) return 0;
+  for (int i = 33; i < 38; ++i) if (packet[i] <= 0) return 0;
+  int value = mju_QCQP(output, packet+3, packet+28, packet+33, packet[2], 5);
+  if (value != 0 && value != 1) return 0;
+  for (int i = 0; i < 5; ++i) if (!isfinite(output[i])) return 0;
+  *active = value;
+  return 1;
+}
