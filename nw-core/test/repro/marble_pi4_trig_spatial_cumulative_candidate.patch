 void mju_quatIntegrate(mjtNum quat[4], const mjtNum vel[3], mjtNum scale) {
   mjtNum angle, tmp[4], qrot[4];
 
   // form local rotation quaternion, apply
   mji_copy3(tmp, vel);
+#ifdef __EMSCRIPTEN__
+  // Integration-local original-wheel norm ordering; generic normalization
+  // remains unchanged for unrelated engine callers.
+  mjtNum norm = mju_sqrt(mj_marble_wheel_fma(tmp[2], tmp[2],
+                          mj_marble_wheel_fma(tmp[0], tmp[0], tmp[1]*tmp[1])));
+  if (norm < mjMINVAL) {
+    tmp[0] = 1;
+    tmp[1] = tmp[2] = 0;
+  } else {
+    mjtNum inverse = 1/norm;
+    tmp[0] *= inverse;
+    tmp[1] *= inverse;
+    tmp[2] *= inverse;
+  }
+  angle = scale * norm;
+#else
   angle = scale * mju_normalize3(tmp);
+#endif
+#ifdef __EMSCRIPTEN__
+  // Private bounded reconstruction of the original macOS combined trig ABI.
+  // Unsupported angles retain the existing path, NOT a parity guarantee.
+  mjtNum half = angle*0.5;
+  if (angle != 0 && mju_abs(half) <= 0x1.921fb54442d18p-1) {
+    const mjtNum sine_coefficients[6] = {
+      0x1.5d8fd1fd19ccdp-33, -0x1.ae5e5a9291f5dp-26,
+      0x1.71de3567d48a1p-19, -0x1.a01a019bfdf03p-13,
+      0x1.111111110f7d0p-7, -0x1.5555555555548p-3
+    };
+    const mjtNum cosine_coefficients[7] = {
+      -0x1.8fa49a0861a9bp-37, 0x1.1ee9d7b4e3f05p-29,
+      -0x1.27e4f7eac4bc6p-22, 0x1.a01a019c844f5p-16,
+      -0x1.6c16c16c14f91p-10, 0x1.555555555554bp-5,
+      -0x1.0000000000000p-1
+    };
+    mjtNum square = half*half;
+    mjtNum polynomial = sine_coefficients[0];
+    for (int i=1; i<6; i++) {
+      polynomial = mj_marble_wheel_fma(square, polynomial, sine_coefficients[i]);
+    }
+    mjtNum sine = mj_marble_wheel_fma(half, square*polynomial, 0) + half;
+    square = mj_marble_wheel_fma(half, half, 0);
+    polynomial = cosine_coefficients[0];
+    for (int i=1; i<7; i++) {
+      polynomial = mj_marble_wheel_fma(square, polynomial, cosine_coefficients[i]);
+    }
+    qrot[0] = mj_marble_wheel_fma(square, polynomial, 1);
+    qrot[1] = tmp[0]*sine;
+    qrot[2] = tmp[1]*sine;
+    qrot[3] = tmp[2]*sine;
+  } else {
+    mji_axisAngle2Quat(qrot, tmp, angle);
+  }
+#else
   mji_axisAngle2Quat(qrot, tmp, angle);
+#endif
+#ifdef __EMSCRIPTEN__
+  mj_marble_quaternion_normalize4(quat);
+  marble_integrate_mulQuat(quat, quat, qrot);
+#else
   mju_normalize4(quat);
   mju_mulQuat(quat, quat, qrot);
+#endif
 }
 
 
