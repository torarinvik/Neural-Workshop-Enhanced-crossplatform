+MJAPI int mj_rne_projection_trace_size(const mjModel* m) {
+  return 36 * m->nbody + 13 * m->nv;
+}
+
+MJAPI void mj_rne_projection_trace(const mjModel* m, mjData* d,
+                                   mjtNum* output) {
+  memset(output, 0, mj_rne_projection_trace_size(m) * sizeof(mjtNum));
+  int sleep_filter = mjENABLED(mjENBL_SLEEP) && d->nbody_awake < m->nbody;
+  int nbody = sleep_filter ? d->nbody_awake : m->nbody;
+  int nparent = sleep_filter ? d->nparent_awake : m->nbody;
+  int nv = sleep_filter ? d->nv_awake : m->nv;
+
+  // Diagnostic mirror of mj_rne's forward/backward passes. Each body's six
+  // slots record cacc, inertial acceleration, inertial velocity, cross force,
+  // body force before accumulation, and body force after accumulation.
+  mj_markStack(d);
+  mjtNum* loc_cacc = mjSTACKALLOC(d, m->nbody*6, mjtNum);
+  mjtNum* loc_cfrc_body = mjSTACKALLOC(d, m->nbody*6, mjtNum);
+  mju_zero(loc_cacc, 6);
+  if (!mjDISABLED(mjDSBL_GRAVITY)) {
+    mju_scl3(loc_cacc+3, m->opt.gravity, -1);
+  }
+  for (int b=1; b < nbody; b++) {
+    int i = sleep_filter ? d->body_awake_ind[b] : b;
+    int bda = m->body_dofadr[i];
+    mjtNum tmp[6];
+#ifdef __EMSCRIPTEN__
+    marble_rne_dof_vec(tmp, d->cdof_dot+6*bda, d->qvel+bda,
+                       m->body_dofnum[i]);
+#else
+    mju_mulDofVec(tmp, d->cdof_dot+6*bda, d->qvel+bda,
+                  m->body_dofnum[i]);
+#endif
+    mju_add(loc_cacc+6*i, loc_cacc+6*m->body_parentid[i], tmp, 6);
+    memcpy(output + 36*i, loc_cacc+6*i, 6*sizeof(mjtNum));
+
+    mju_mulInertVec(loc_cfrc_body+6*i, d->cinert+10*i, loc_cacc+6*i);
+    memcpy(output + 36*i + 6, loc_cfrc_body+6*i, 6*sizeof(mjtNum));
+    mju_mulInertVec(tmp, d->cinert+10*i, d->cvel+6*i);
+    memcpy(output + 36*i + 12, tmp, 6*sizeof(mjtNum));
+    mjtNum tmp1[6];
+#ifdef __EMSCRIPTEN__
+    marble_rne_cross_force(tmp1, d->cvel+6*i, tmp);
+#else
+    mji_crossForce(tmp1, d->cvel+6*i, tmp);
+#endif
+    memcpy(output + 36*i + 18, tmp1, 6*sizeof(mjtNum));
+    mju_addTo(loc_cfrc_body+6*i, tmp1, 6);
+    memcpy(output + 36*i + 24, loc_cfrc_body+6*i, 6*sizeof(mjtNum));
+  }
+  mju_zero(loc_cfrc_body, 6);
+  for (int b=nparent-1; b > 0; b--) {
+    int i = sleep_filter ? d->parent_awake_ind[b] : b;
+    int j = m->body_parentid[i];
+    if (j) {
+      mju_addTo(loc_cfrc_body+6*j, loc_cfrc_body+6*i, 6);
+    }
+  }
+  for (int i=0; i < m->nbody; i++) {
+    memcpy(output + 36*i + 30, loc_cfrc_body+6*i, 6*sizeof(mjtNum));
+  }
+  mjtNum* projection = output + 36*m->nbody + m->nv;
+  for (int v=0; v < nv; v++) {
+    int i = sleep_filter ? d->dof_awake_ind[v] : v;
+    int body = m->dof_bodyid[i];
+    memcpy(projection + 12*i, d->cdof+6*i, 6*sizeof(mjtNum));
+    memcpy(projection + 12*i + 6, loc_cfrc_body+6*body,
+           6*sizeof(mjtNum));
+  }
+  mj_rne(m, d, 0, output + 36*m->nbody);
+  mj_freeStack(d);
+}
+
+// Compatibility names expected by the Python diagnostic harness.
+MJAPI int mj_rne_trace_size(const mjModel* m) {
+  return mj_rne_projection_trace_size(m);
+}
+
+MJAPI void mj_rne_trace(const mjModel* m, mjData* d, mjtNum* output) {
+  memset(output, 0, mj_rne_trace_size(m) * sizeof(mjtNum));
+  mj_rne_projection_trace(m, d, output);
+}
