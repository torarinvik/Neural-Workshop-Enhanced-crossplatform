+static mjtNum marble_box_dot(mjtNum a0, mjtNum a1, mjtNum a2,
+                            const mjtNum* b) {
+  return mj_marble_wheel_fma(a2, b[2],
+           mj_marble_wheel_fma(a0, b[0], a1*b[1]));
+}
