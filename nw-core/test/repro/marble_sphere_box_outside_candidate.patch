   mjtNum pos[3];
   mjtNum dist, closest;
 
+#ifdef __EMSCRIPTEN__
+  // Qualified original-wheel ordering, only for outside-center contacts.
+  // The existing native and inside-center paths remain below unchanged.
+  mjtNum delta[3], local[3], clamp[3], direction[3], midpoint[3];
+  mji_sub3(delta, pos1, pos2);
+  for (int axis = 0; axis < 3; axis++) {
+    local[axis] = marble_box_dot(mat2[axis], mat2[axis+3], mat2[axis+6], delta);
+    clamp[axis] = size2[axis] > 0 ? mju_clip(local[axis], -size2[axis], size2[axis]) : local[axis];
+    direction[axis] = clamp[axis] - local[axis];
+  }
+  mjtNum length = mju_sqrt(marble_box_dot(direction[0], direction[1], direction[2], direction));
+  if (length > mjMINVAL) {
+    if (length - size1[0] > margin) return 0;
+    mjtNum inverse = 1 / length;
+    for (int axis = 0; axis < 3; axis++) {
+      direction[axis] *= inverse;
+      mjtNum farpoint = mj_marble_wheel_fma(direction[axis], size1[0], local[axis]);
+      midpoint[axis] = mj_marble_wheel_fma(farpoint, 0.5,
+                          mj_marble_wheel_fma(clamp[axis], 0.5, 0));
+    }
+    for (int axis = 0; axis < 3; axis++) {
+      con[0].normal[axis] = marble_box_dot(mat2[3*axis], mat2[3*axis+1], mat2[3*axis+2], direction);
+      con[0].pos[axis] = marble_box_dot(mat2[3*axis], mat2[3*axis+1], mat2[3*axis+2], midpoint) + pos2[axis];
+    }
+    con[0].dist = length - size1[0];
+    mji_zero3(con[0].tangent);
+    return 1;
+  }
+#endif
