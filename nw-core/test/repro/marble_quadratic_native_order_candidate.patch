 // multiply square matrix with vectors on both sides: return vec1'*mat*vec2
+#ifdef __EMSCRIPTEN__
+extern mjtNum mj_marble_wheel_fma(mjtNum, mjtNum, mjtNum);
+
+// Private candidate, original arm64 wheel's qualified n=2/3/5 row order.
+// Explicit out-of-line FMA prevents LLVM from replacing fused operations.
+static mjtNum marbleCostRowDot(const mjtNum* a, const mjtNum* b, int n) {
+  mjtNum res = 0;
+  if (n == 5) {
+    mjtNum r0 = mj_marble_wheel_fma(a[0], b[0], 0);
+    mjtNum r1 = mj_marble_wheel_fma(a[1], b[1], 0);
+    mjtNum r2 = mj_marble_wheel_fma(a[2], b[2], 0);
+    mjtNum r3 = mj_marble_wheel_fma(a[3], b[3], 0);
+    res = (r0+r2)+(r1+r3);
+    return mj_marble_wheel_fma(a[4], b[4], res);
+  }
+  mjtNum row = mj_marble_wheel_fma(a[0], b[0], a[1]*b[1]);
+  if (n == 3) row = mj_marble_wheel_fma(a[2], b[2], row);
+  return res+row;
+}
+#endif
+
 mjtNum mju_mulVecMatVec(const mjtNum* vec1, const mjtNum* mat, const mjtNum* vec2, int n) {
   mjtNum res = 0;
+#ifdef __EMSCRIPTEN__
+  if (n == 2 || n == 3 || n == 5) {
+    for (int i = 0; i < n; ++i) {
+      mjtNum row = marbleCostRowDot(mat+i*n, vec2, n);
+      res = mj_marble_wheel_fma(vec1[i], row, res);
+    }
+    return res;
+  }
+#endif
   for (int i=0; i < n; i++) {
     res += vec1[i] * mju_dot(mat + i*n, vec2, n);
   }
   return res;
 }
 
+#ifdef __EMSCRIPTEN__
+// Complete bounded operands validated before any shape-dependent read.
+// Calls the actual public producers, not a JavaScript recomputation.
+MJAPI int mj_marble_cost_primitives_probe(const mjtNum* packet, int size, mjtNum* output) {
+  if (!packet || !output || size < 2 || size > 42) return 0;
+  for (int i = 0; i < size; ++i) if (!isfinite(packet[i])) return 0;
+  if (packet[0] != 1 || (packet[1] != 2 && packet[1] != 3 && packet[1] != 5)) return 0;
+  int n = (int)packet[1];
+  if (size != 2+n*n+3*n) return 0;
+  const mjtNum* left = packet+2;
+  const mjtNum* matrix = left+n;
+  const mjtNum* right = matrix+n*n;
+  const mjtNum* residual = right+n;
+  output[0] = mju_mulVecMatVec(left, matrix, right, n);
+  output[1] = mju_dot(left, residual, n);
+  return isfinite(output[0]) && isfinite(output[1]);
+}
+#endif
