+// Bounded actual two-tangent kernel probe, separate from the generic probe.
+MJAPI int mj_marble_qcqp2_probe(const mjtNum* packet, int size,
+                               mjtNum* output, int* active) {
+  if (!packet || !output || !active || size != 11) return 0;
+  for (int i = 0; i < size; ++i) if (!isfinite(packet[i])) return 0;
+  if (packet[0] != 1 || packet[1] != 2 || packet[2] < 0 ||
+      packet[9] <= 0 || packet[10] <= 0) return 0;
+  *active = mju_QCQP2(output, packet+3, packet+7, packet+9, packet[2]);
+  return (*active == 0 || *active == 1) &&
+         isfinite(output[0]) && isfinite(output[1]);
+}
