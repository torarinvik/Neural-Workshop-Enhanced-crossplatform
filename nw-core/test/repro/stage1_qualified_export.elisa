# Minimal stage1 regression: a qualified export target must resolve the owner
# and member separately and emit the public wrapper symbol.

module ExportFixture:
    def increment(value: i64) -> i64:
        return value + 1

export fn increment_export(value: i64) -> i64 = ExportFixture::increment
export fn increment_export_spaced(value: i64) -> i64 = ExportFixture :: increment
