+// Diagnostic-only bounded packet bridge calls the SAME compiled PrimalEval.
+// Schema: [1,alpha,ne,nf,n,ncon],Gauss[3],Jar/Jv/D/R[n],loss[nf],
+//         type/id[n],contact(dim,mu)[ncon],quad[3*n]. Unused quad slots are
+// initialized transport padding, not captured or compared solver scratch.
+MJAPI int mj_marble_eval_probe(const mjtNum* values, int count, mjtNum* output) {
+  if (!values || !output || count < 9 || count > 800000) return 0;
+  for (int k=0; k < count; ++k) if (!isfinite(values[k])) return 0;
+  if (values[0] != 1) return 0;
+  for (int k=2; k < 6; ++k) {
+    if (values[k] < 0 || values[k] > 65536 || values[k] != floor(values[k])) return 0;
+  }
+  int ne = (int)values[2], nf = (int)values[3];
+  int n = (int)values[4], ncon = (int)values[5];
+  if (ne+nf > n || count != 9+9*n+nf+2*ncon) return 0;
+  const mjtNum* jar = values+9;
+  const mjtNum* jv = jar+n;
+  const mjtNum* D = jv+n;
+  const mjtNum* R = D+n;
+  const mjtNum* loss = R+n;
+  const mjtNum* types = loss+nf;
+  const mjtNum* ids = types+n;
+  const mjtNum* contact_values = ids+n;
+  const mjtNum* quad = contact_values+2*ncon;
+  for (int i=0; i < n; ++i) {
+    if (D[i] < 0 || R[i] < 0 || types[i] < 0 || types[i] > 7 ||
+        types[i] != floor(types[i]) || ids[i] < -1 || ids[i] > 2147483647 ||
+        ids[i] != floor(ids[i])) return 0;
+  }
+  for (int i=0; i < nf; ++i) if (loss[i] < 0) return 0;
+  for (int i=0; i < ncon; ++i) {
+    mjtNum dim = contact_values[2*i];
+    if ((dim != 1 && dim != 3 && dim != 4 && dim != 6) || contact_values[2*i+1] < 0) return 0;
+  }
+  for (int i=0; i < n; ++i) {
+    if (types[i] != mjCNSTR_CONTACT_ELLIPTIC) continue;
+    if (i < ne+nf || ids[i] < 0 || ids[i] >= ncon) return 0;
+    int c = (int)ids[i], dim = (int)contact_values[2*c];
+    if (dim < 3 || i+dim > n || contact_values[2*c+1] <= 0) return 0;
+    for (int j=1; j < dim; ++j) if (types[i+j] != 7 || ids[i+j] != c) return 0;
+    i += dim-1;
+  }
+  int* integer_arrays = malloc((size_t)(n ? 2*n : 2)*sizeof(int));
+  mjContact* contacts = calloc((size_t)(ncon ? ncon : 1), sizeof(mjContact));
+  mjtNum* full_loss = calloc((size_t)(ne+nf ? ne+nf : 1), sizeof(mjtNum));
+  if (!integer_arrays || !contacts || !full_loss) {
+    free(integer_arrays); free(contacts); free(full_loss); return 0;
+  }
+  for (int i=0; i < n; ++i) { integer_arrays[i] = (int)types[i]; integer_arrays[n+i] = (int)ids[i]; }
+  for (int i=0; i < ncon; ++i) {
+    contacts[i].dim = (int)contact_values[2*i]; contacts[i].mu = contact_values[2*i+1];
+  }
+  for (int i=0; i < nf; ++i) full_loss[ne+i] = loss[i];
+  mjPrimalContext ctx = {0};
+  ctx.island = -1; ctx.ne = ne; ctx.nf = nf; ctx.nefc = n;
+  ctx.contact = contacts; ctx.efc_D = D; ctx.efc_R = R; ctx.efc_frictionloss = full_loss;
+  ctx.efc_type = integer_arrays; ctx.efc_id = integer_arrays+n;
+  ctx.Jaref = (mjtNum*)jar; ctx.Jv = (mjtNum*)jv; ctx.quad = (mjtNum*)quad;
+  memcpy(ctx.quadGauss, values+6, 3*sizeof(mjtNum));
+  mjPrimalPnt p = {0}; p.alpha = values[1];
+  PrimalEval(&ctx, &p);
+  output[0] = p.cost; output[1] = p.deriv[0]; output[2] = p.deriv[1];
+  free(integer_arrays); free(contacts); free(full_loss);
+  return ctx.LSiter == 1 && isfinite(output[0]) && isfinite(output[1]) && isfinite(output[2]);
+}
