include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/firebreak.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, seed: i64, nested: bool):
    can Abort.Panic, Console.Write:
        random: mutable MT19937 = zeroed
        mt_seed_int(&random, seed.u64())
        land: Firebreak::Land = Firebreak::deal(rung, &random) if nested else Firebreak::deal_seed(rung, -seed)
        g: Firebreak::Grade = land.level
        _ = printf("grade %lld %lld %.17g %.17g %lld %.17g %lld %.17g %lld %lld\n",
            g.rung, g.fires, g.pace, g.wind, g.shift.i64(), g.embers, g.hidden_wind.i64(), g.dig, g.spare, g.distance)
        _ = printf("wind %.17g %.17g %.17g\n", land.initial_wind, land.wind_turn, land.shifted_wind)
        _ = printf("supply %lld %lld\n", land.shovels, Firebreak::reaches_town(&land).i64())
        for fire in 0..<g.fires |land|:
            _ = printf("fire %lld\n", land.fires[fire.usize()])
        for i in 0..<6 |land|:
            _ = printf("town %lld\n", land.town[i.usize()])
        for i in 0..<Firebreak::CELLS |land|:
            _ = printf("cell %lld %.17g %.17g\n", land.terrain[i.usize()],
                land.rough[i.usize()], land.ember_draw[i.usize()])

def main() -> i32:
    can Abort.Panic, Console.Write:
        for rung in [0, 1, 4, 7, 10, 13, 16, 19, 20, 25, 30, 60]:
            for index in 0..<5 |rung|:
                emit(rung, 17 + index * 31337, index % 2 == 1)
        return 0.i32()
