include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/airtraffic_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def deal(rung: i64, seed: i64):
    can Abort.Panic, Console.Write:
        sky: AirTraffic::Sky = AirTraffic::deal_seed(rung, seed)
        level: AirTraffic::Grade = sky.level
        _ = printf("grade %lld %lld %.17g %.17g %lld %lld %.17g %lld %lld %.17g\n", level.rung, level.planes,
            level.interval, level.speed, level.runways, level.storms, level.fuel, level.closure.i64(), level.wind_shift.i64(), level.occupy)
        _ = printf("sky %lld %.17g %.17g %.17g %.17g\n", sky.closed_runway, sky.closed_from, sky.closed_until, sky.shift, sky.seconds)
        for i in 0..<level.runways |sky|:
            rw: AirTraffic::Runway = sky.runways[i.usize()]
            _ = printf("runway %.17g %.17g %.17g %.17g\n", rw.point.x, rw.point.y, rw.heading, rw.length)
        for i in 0..<level.planes |sky|:
            plan: AirTraffic::Arrival = sky.arrivals[i.usize()]
            _ = printf("plan %.17g %.17g %.17g %.17g %lld %.17g\n",
                plan.due, plan.point.x, plan.point.y, plan.heading, plan.runway, plan.fuel)
        for i in 0..<level.storms |sky|:
            storm: AirTraffic::Storm = sky.storms[i.usize()]
            _ = printf("storm %.17g %.17g %.17g %.17g %.17g\n", storm.x, storm.y, storm.vx, storm.vy, storm.radius)

def publish(run: AirTraffic::Run&):
    can Abort.Panic, Console.Write:
        _ = printf("tick %.17g %lld %lld %lld %lld %lld %lld %lld %.17g %.17g\n", run.elapsed, run.active,
            run.waiting, run.selected, run.flipped.i64(), run.result, run.first_slot, run.second_slot, run.loss.x, run.loss.y)
        for i in 0..<run.active |run|:
            p: AirTraffic::Plane = run.planes[i.usize()]
            _ = printf("plane %lld %lld %lld %.17g %.17g %.17g %.17g %.17g %lld %lld\n", p.number, p.slot, p.runway,
                p.x, p.y, p.heading, p.target, p.fuel, p.mode, p.cleared.i64())
        for i in 0..<run.sky.level.storms |run|:
            storm: AirTraffic::Storm = run.storms[i.usize()]
            _ = printf("storm %.17g %.17g %.17g %.17g %.17g\n", storm.x, storm.y, storm.vx, storm.vy, storm.radius)
        for i in 0..<run.sky.level.runways |run|:
            _ = printf("busy %.17g\n", run.busy_until[i.usize()])
        _ = printf("landed %lld\n", run.landed_count)
        for i in 0..<run.landed_count |run|:
            _ = printf("arrival %lld\n", run.landed[i.usize()])
        start: i64 = run.notice_count - AirTraffic::NOTICES if run.notice_count > AirTraffic::NOTICES else 0
        _ = printf("notes %lld\n", run.notice_count - start)
        for i in start..<run.notice_count |run|:
            event: AirTraffic::Notice = run.notices[(i % AirTraffic::NOTICES).usize()]
            _ = printf("note %.17g %lld %.17g %.17g\n", event.time, event.why, event.point.x, event.point.y)

def replay(rung: i64, seed: i64, policy: i64):
    can Abort.Panic, Console.Write:
        sky: AirTraffic::Sky = AirTraffic::deal_seed(rung, seed)
        run: mutable AirTraffic::Run = AirTraffic::initialize(&sky)
        for tick in 0..<7000 |run, policy|:
            break if run.result != AirTraffic::LIVE
            if policy == 1 and run.active > 0 and tick % 113 == 0:
                pick: AirTraffic::Plane = run.planes[((tick / 113) % run.active).usize()]
                _ = AirTraffic::apply(&run, pick.slot)
                _ = AirTraffic::apply(&run, AirTraffic::SLOTS + (tick / 113) % 4)
            elif policy == 2:
                for i in 0..<run.active |run|:
                    p: AirTraffic::Plane = run.planes[i.usize()]
                    if not p.cleared:
                        _ = AirTraffic::apply(&run, p.slot)
                        _ = AirTraffic::apply(&run, AirTraffic::SLOTS + AirTraffic::LAND)
            elif policy == 3:
                instruction: AirTraffic::Instruction = AirTraffic::autopilot(&run)
                slot: i64 = instruction.slot
                _ = printf("instruction %lld %lld\n", slot if slot != run.selected else -1, instruction.order)
                if slot >= 0:
                    _ = AirTraffic::apply(&run, slot)
                    _ = AirTraffic::apply(&run, AirTraffic::SLOTS + instruction.order)
            AirTraffic::step(&run, 1.0 / 30.0)
            publish(&run)

def edge_case(which: i64):
    can Abort.Panic, Console.Write:
        sky: mutable AirTraffic::Sky = AirTraffic::deal_seed(10, 17)
        sky.seconds <- 0.5 if which == 0
        sky.shift <- 1.01 if which == 4
        run: mutable AirTraffic::Run = AirTraffic::initialize(&sky)
        run.elapsed <- 1.0
        run.waiting <- 1
        run.active <- 1
        run.selected <- 0
        threshold: AirTraffic::Point = AirTraffic::threshold(&run, 0)
        heading: f64 = AirTraffic::runway_heading(&run, 0)
        angle: f64 = AirTraffic::radians(heading)
        x: f64 = threshold.x + (cos(angle) * 6.0 if which == 3 else 0.0)
        y: f64 = threshold.y + (sin(angle) * 6.0 if which == 3 else 0.0)
        mode: i64 = AirTraffic::FREE if which <= 1 else (AirTraffic::APPROACH if which == 4 else AirTraffic::FINAL)
        run.planes[0] <- AirTraffic::Plane{number: 0, slot: 0, runway: 0, x: x, y: y,
            heading: heading, target: heading, fuel: 0.01 if which == 1 else 100.0, mode: mode,
            cleared: mode != AirTraffic::FREE}
        run.busy_until[0] <- 3.0 if which == 2 else 0.0
        AirTraffic::step(&run, 1.0 / 30.0)
        publish(&run)

def session_row(session: AirTrafficGame::Session&):
    can Abort.Panic, Console.Write:
        done: bool = session.phase == AirTrafficGame::DONE
        _ = printf("session %lld %lld %lld %lld %lld %lld %lld %.17g %.17g\n", session.phase, session.rung,
            session.trial, session.wins, session.best_rung, session.verdict, AirTrafficGame::info(session, 6),
            0.0 if done else session.airspace.elapsed, session.trail_clock)
        if not done:
            for i in 0..<session.airspace.sky.level.planes |session|:
                trail: AirTrafficGame::Trail& = &session.trails[i.usize()]
                start: i64 = trail.count - AirTrafficGame::TRAIL_SAMPLES if trail.count > AirTrafficGame::TRAIL_SAMPLES else 0
                _ = printf("trail %lld\n", trail.count - start)
                for j in start..<trail.count |trail|:
                    point: AirTraffic::Point = trail.points[(j % AirTrafficGame::TRAIL_SAMPLES).usize()]
                    _ = printf("point %.17g %.17g\n", point.x, point.y)

def lifecycle():
    can Abort.Panic, Console.Write:
        session: mutable AirTrafficGame::Session = AirTrafficGame::initialize(1, 2, true, 17)
        _ = AirTrafficGame::input(&session, AirTrafficGame::START, 0)
        session_row(&session)
        now: mutable i64 = 0
        for trial in 0..<2 |session, now|:
            while session.phase == AirTrafficGame::PLAYING |session, now, trial|:
                if trial == 0:
                    order: AirTraffic::Instruction = AirTraffic::autopilot(&session.airspace)
                    if order.slot >= 0:
                        _ = AirTrafficGame::input(&session, order.slot, now)
                        _ = AirTrafficGame::input(&session, AirTraffic::SLOTS + order.order, now)
                next: i64 = now + (137 if (now / 11) % 3 == 0 else 11)
                _ = AirTrafficGame::advance(&session, next, next.f64() / 1000.0 - now.f64() / 1000.0)
                now <- next
                session_row(&session)
            _ = AirTrafficGame::advance(&session, now + 2999, 2.999)
            session_row(&session)
            now <- now + 3000
            _ = AirTrafficGame::advance(&session, now, 3.0)
            session_row(&session)
        _ = AirTrafficGame::input(&session, AirTrafficGame::START, now + 1)
        session_row(&session)

def main() -> i32:
    can Abort.Panic, Console.Write:
        for rung in 1..<41:
            for seed in [-17, 0, 17, 2026]:
                deal(rung, seed)
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 35]:
            for policy in 0..<4:
                replay(rung, 17, policy)
        for which in 0..<5:
            edge_case(which)
        lifecycle()
        return 0.i32()
