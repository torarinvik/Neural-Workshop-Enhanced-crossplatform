include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/morning_round_audio.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Console.Write:
        draw: mutable MT19937 = zeroed
        mt_seed_int(&draw, 17.u64())
        candidate: mutable MorningRoundRules::Candidate = MorningRoundRules::build(MorningRound::grade(4), &draw)
        return 1.i32() if not candidate.valid
        run: mutable MorningRoundRide::Run = MorningRoundRide::start(candidate.street)
        for voice in 0..<7 |run|:
            run.t <- 0.125 + voice.f64() * 0.2
            pan: f64 = (voice - 3).f64() / 4.0
            MorningRoundRide::note(&run, 0.225, 110.0 + 150.0 * voice.f64(), voice, 0.37, pan)
        for i in 0..<21 |run|:
            data: mutable u8[8820] = zeroed
            begin: f64 = i.f64() * 0.1
            count: i64 = MorningRoundAudio::render(&run, begin, begin + 0.1, &data[0], 8820)
            for j in 0..<count |data|:
                _ = dprintf(1.i32(), "%02x", data[j.usize()].i32())
            _ = dprintf(1.i32(), "\n")
        return 0.i32()
