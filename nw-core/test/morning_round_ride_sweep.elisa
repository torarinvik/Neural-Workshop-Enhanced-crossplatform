include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/morning_round_game.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def tick_state(run: MorningRoundRide::Run&, port: i64):
    can Abort.Panic, Console.Write:
        _ = dprintf(1.i32(), "tick %lld %.17g %.17g %.17g %.17g %lld %lld %lld %lld %lld %lld %.17g %.17g %lld %lld\n",
            port, run.t, run.s, run.x, run.speed, run.papers, run.flying_count, run.passed, run.mistakes, run.falls,
            run.result, run.down_until, run.last_throw, run.known_count, run.cue_count)
        for i in 0..<run.flying_count |run|:
            p: MorningRoundRide::Paper = run.flying[i.usize()]
            _ = dprintf(1.i32(), "paper %.17g %.17g %lld %.17g\n", p.x, p.d, p.side, p.speed)

def flag(value: bool) -> i64:
    return 1 if value else 0

def final_state(run: MorningRoundRide::Run&):
    can Abort.Panic, Console.Write:
        for i in 0..<run.street.layout.count |run|:
            known: i64 = flag(run.known[i.usize()])
            _ = dprintf(1.i32(), "house %lld %lld\n", run.got[i.usize()], known)
        for i in 0..<run.street.traffic.count |run|:
            hit: i64 = flag(run.hit[i.usize()])
            _ = dprintf(1.i32(), "hit %lld\n", hit)
        for i in 0..<run.cue_count |run|:
            c: MorningRoundRide::Cue = run.cues[i.usize()]
            _ = dprintf(1.i32(), "cue %.17g %.17g %.17g %lld %.17g %.17g\n", c.t, c.duration, c.frequency, c.voice, c.gain, c.pan)

def replay(rung: i64, policy: i64):
    can Abort.Panic, Console.Write:
        _ = dprintf(1.i32(), "case %lld %lld\n", rung, policy)
        draw: mutable MT19937 = zeroed
        mt_seed_int(&draw, 17.u64())
        deal: MorningRoundRules::Candidate = MorningRoundReference::deal(rung, &draw)
        if not deal.valid:
            _ = dprintf(1.i32(), "no deal\n")
            return
        _ = dprintf(1.i32(), "deal %lld %.17g %lld %.17g\n", deal.street.papers, deal.street.seconds, deal.street.traffic.count, py_random(&draw))
        run: mutable MorningRoundRide::Run = MorningRoundRide::start(deal.street)
        pilot: mutable MorningRoundReference::Pilot = zeroed
        if policy == 3:
            run.t <- run.street.seconds
            MorningRoundRide::step(&run, 0.0, -1)
            tick_state(&run, -1)
        elif policy == 4:
            run.t <- run.street.layout.level.brief
            thing: MorningRound::Thing = run.street.traffic.things[0]
            run.s <- MorningRoundRide::thing_d(&run, thing)
            run.x <- thing.x
            run.falls <- 2
            MorningRoundRide::step(&run, 0.0, -1)
            tick_state(&run, -1)
        else:
            i: mutable i64 = 0
            while run.result == MorningRoundRide::LIVE |run, pilot, policy, i|:
                port: i64 = MorningRoundReference::choose(&run, &pilot, policy)
                MorningRoundReference::tick(&run, port, MorningRoundReference::STEP)
                tick_state(&run, port)
                if i % 60 == 0:
                    block: i64 = MorningRoundRide::block_at(&run, run.s)
                    weights: MorningRoundReference::Weights = MorningRoundReference::believed(&run, &pilot, block)
                    for k in 0..<run.street.book.count |weights|:
                        _ = dprintf(1.i32(), "belief %.17g\n", weights.values[k.usize()])
                i <- i + 1
        final_state(&run)

def session_trace() -> i32:
    can Abort.Panic, Global.Read:
        session: mutable MorningRoundGame::Session = MorningRoundGame::initialize(12, 2, true, 17)
        return 1.i32() if not MorningRoundGame::start(&session, 0.0)
        return 2.i32() if not MorningRoundRide::rulebook_open(&session.run)
        return 3.i32() if MorningRoundGame::steer(&session, MorningRound::THROW_L)
        _ = MorningRoundGame::key(&session, 0, true)
        _ = MorningRoundGame::key(&session, 4, true)
        _ = MorningRoundGame::key(&session, 1, true)
        _ = MorningRoundGame::key(&session, 0, false)
        return 4.i32() if MorningRoundGame::control(&session) != MorningRound::LEFT
        _ = MorningRoundGame::key(&session, 4, false)
        return 5.i32() if MorningRoundGame::control(&session) != MorningRound::RIGHT
        _ = MorningRoundGame::clear_keys(&session)
        session.run.t <- session.run.street.layout.level.brief
        return 6.i32() if MorningRoundRide::rulebook_open(&session.run)
        papers: i64 = session.run.papers
        return 7.i32() if not MorningRoundGame::agent_event(&session, 0.0, MorningRound::THROW_L)
        return 8.i32() if MorningRoundGame::steer(&session, MorningRound::THROW_R)
        return 9.i32() if session.run.papers != papers - 1 or session.run.flying_count != 1
        _ = MorningRoundGame::steer(&session, MorningRound::FASTER)
        _ = MorningRoundGame::advance(&session, 1.0)
        return 10.i32() if session.run.speed <= session.run.street.layout.level.speed or MorningRoundGame::control(&session) != -1
        session.run.flying_count <- 0
        for i in 0..<session.run.street.layout.count |session|:
            session.run.got[i.usize()] <- MorningRoundRide::DELIVERED
        session.run.s <- session.run.street.layout.length
        _ = MorningRoundGame::advance(&session, 1.0)
        return 11.i32() if session.phase != MorningRoundGame::JUDGED or session.rung != 13 or session.run.result != MorningRoundRide::CLEAR
        return 12.i32() if MorningRoundGame::advance(&session, 4.49)
        _ = MorningRoundGame::advance(&session, 4.5)
        return 13.i32() if session.phase != MorningRoundGame::PLAYING or session.trial != 2
        session.run.t <- session.run.street.seconds
        _ = MorningRoundGame::advance(&session, 4.5)
        _ = MorningRoundGame::agent_event(&session, 4.5, MorningRoundGame::NEUTRAL)
        return 14.i32() if session.phase != MorningRoundGame::DONE or session.wins != 1 or session.best_rung != 12
        return 15.i32() if not MorningRoundGame::reconfigure(&session, 1, 1, false)
        return 16.i32() if not MorningRoundGame::start(&session, 4.5) or session.trial != 1 or session.wins != 0
        return 0.i32()

def main() -> i32:
    can Abort.Panic, Console.Write, Global.Read:
        status: i32 = session_trace()
        if status != 0.i32():
            _ = dprintf(2.i32(), "Morning Round session assertion %d\n", status)
            return status
        for rung in [1, 3, 5, 7, 9, 11, 12, 16, 20, 25, 30]:
            replay(rung, 0)
        for policy in 1..<5:
            replay(12, policy)
        return 0.i32()
