include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_kitchen.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        session: mutable KitchenGame::Session = KitchenGame::initialize(rung, 2, true, 17)
        if mode != 0:
            _ = KitchenGame::input(&session, KitchenGame::START, 0)
        now: mutable i64 = 0
        stop: i64 = 125 if mode == 2 else 3500 if mode == 3 else 8000 if mode == 4 else 11000 if mode == 5 else 16000 if mode == 6 else 21000 if mode == 7 else 600000
        if mode >= 2:
            while session.phase == KitchenGame::PLAYING and now < stop |session, now, stop, mode|:
                port: mutable i64 = -1
                if mode <= 7:
                    port <- 0 if now == 0 else 4 if now == 2000 or now == 4000 else 6 if now == 5000 or now == 18000 else 12 if now == 20000 else -1
                elif mode == 10 or mode == 11:
                    port <- KitchenReference::choose(&session.run)
                if port >= 0:
                    _ = KitchenGame::input(&session, port, now)
                next: i64 = now + 125
                _ = KitchenGame::advance(&session, next, next.f64() / 1000.0 - now.f64() / 1000.0)
                now <- next
        if mode == 9 or mode == 11:
            _ = KitchenGame::advance(&session, session.deadline_ms - 1, 0.0)
            _ = KitchenGame::advance(&session, session.deadline_ms, 0.0)
        _ = printf("frame %lld %lld %lld %lld %lld %lld %lld %lld\n", rung, mode, 1 if dark else 0,
            session.phase, session.rung, session.trial, session.wins, session.best_rung)
        _ = printf("hit %lld\n", SceneKitchen::hit(&session, 0.0, 0.0))
        if session.phase == KitchenGame::PLAYING:
            area: SceneKitchen::Frame = SceneKitchen::frame()
            for p in 0..<Kitchen::PORTS |session, area|:
                at: Kitchen::Station = session.run.shift.stations[p.usize()]
                if at.present:
                    x: f64 = area.x + at.x * area.scale
                    y: f64 = area.y + at.y * area.scale
                    _ = printf("hit %lld\n", SceneKitchen::hit(&session, x, y))
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneKitchen::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        KitchenGame::close(&session)
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneKitchen::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 16]:
            for mode in 0..<12 |rung|:
                for dark in 0..<2 |rung, mode|:
                    region scratch(2097152):
                        in scratch:
                            emit(rung, mode, dark != 0)
        return 0.i32()
