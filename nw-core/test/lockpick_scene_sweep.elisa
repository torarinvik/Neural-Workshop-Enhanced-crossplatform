include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_lockpick.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def frame(game: LockPickGame::Session&, name: cstr):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region scratch(65536):
            in scratch:
                list: mutable Display::DisplayList = Display::DisplayList()
                SceneLockPick::render(&list, game, true)
                _ = printf("frame %s %lld %lld %lld %lld %lld\n", name, game.phase, game.rung,
                    game.trial, game.wins, game.run.set_count)
                for cmd in list.commands |list|:
                    if cmd.kind == Display::CMD_TEXT:
                        for i in 0..<(cmd.len & 0xffffff.u32()).i64() |list, cmd|:
                            _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                        _ = printf("\n")
                    elif cmd.kind == Display::CMD_POLYGON or cmd.kind == Display::CMD_POLY_POINT:
                        _ = printf("poly %u %u %u %.7g %.7g\n", cmd.kind, cmd.color, cmd.len, cmd.a.f64(), cmd.b.f64())
                    elif cmd.kind == Display::CMD_LINE or cmd.kind == Display::CMD_CIRCLE or cmd.kind == Display::CMD_RECT:
                        _ = printf("shape %u %u %.7g %.7g %.7g %.7g\n", cmd.kind, cmd.color,
                            cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64())
                _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        game: mutable LockPickGame::Session = LockPickGame::initialize(1, 1, true, 17)
        frame(&game, "ready")
        _ = LockPickGame::start(&game, 0.0) can Global{Read,Write}
        frame(&game, "start")
        _ = LockPickGame::hold_key(&game, 1, true)
        _ = LockPickGame::hold_key(&game, 2, true)
        _ = LockPickGame::hold_key(&game, 1, false)
        _ = LockPickGame::advance(&game, 0.1) can Global{Read,Write}
        if game.tension_keys != 2 or fabs(game.run.tension - 0.09) > 0.00001:
            return 1
        _ = LockPickGame::hold_key(&game, 2, false)
        _ = LockPickGame::advance(&game, 0.2) can Global{Read,Write}
        if game.tension_keys != 0 or fabs(game.run.tension - 0.04) > 0.00001:
            return 2
        game.run.tension <- 0.48
        game.run.set_count <- 1
        game.run.lifts[0] <- game.run.lock.heights[0]
        game.run.lifts[1] <- 0.33
        game.run.slips <- 1
        _ = LockPickGame::pointer(&game, SceneHand::x(320.0), SceneHand::y(286.1), 1, 0.2) can Global{Read,Write}
        frame(&game, "engaged")
        LockPickGame::close(&game) can Global{Read,Write}

        game <- LockPickGame::initialize(30, 1, true, 17)
        _ = LockPickGame::start(&game, 0.0) can Global{Read,Write}
        game.run.tension <- 0.76
        game.run.set_count <- 4
        frame(&game, "hidden")
        LockPickGame::close(&game) can Global{Read,Write}

        game <- LockPickGame::initialize(1, 1, true, 17)
        _ = LockPickGame::start(&game, 0.0) can Global{Read,Write}
        t: mutable f64 = 0.0
        while game.phase == LockPickGame::PLAYING and t < 33.0 |game, t|:
            port: i64 = LockPick::pilot(&game.run)
            _ = LockPickGame::input(&game, port) can Global{Read,Write}
            t <- t + 1.0 / 60.0
            _ = LockPickGame::advance(&game, t) can Global{Read,Write}
        frame(&game, "won")
        _ = LockPickGame::advance(&game, t + 2.49) can Global{Read,Write}
        frame(&game, "hold")
        _ = LockPickGame::advance(&game, t + 2.5) can Global{Read,Write}
        frame(&game, "done")
        LockPickGame::close(&game) can Global{Read,Write}
        return 0
