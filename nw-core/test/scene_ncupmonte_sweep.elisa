# Differential sweep driver for src/scene_ncupmonte.elisa.
# See scene_ncupmonte_diff.py for the reference side.
#
# Two slot layouts a spec: the settled one, and one nudged off it, because a
# cup between slots is a frame the game really draws and `xs` is the only thing
# that says so.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/display.elisa"
include "../src/scene_ncupmonte.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            width: f64 = 1824.0
            height: f64 = 1368.0
            print("names|spec|cups|phase|black|ball|guess|show_numbers|seed|nudged")
            for spec in 0..<32 |width, height|:
                cups: i64 = 3 + spec % 8
                phase: i64 = spec % 6
                black: bool = spec % 3 == 1
                ball: i64 = (spec * 5) % cups
                guess: i64 = (spec * 3) % cups
                show_numbers: bool = spec % 4 != 3
                seed: i64 = 900 + spec
                nudged: bool = spec % 2 == 1

                order: mutable darray[i64] = Ints::zeros(SceneNCupMonte::MOST_CUPS)
                for index in 0..<cups |order|:
                    Ints::put(&order, index, index)
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, seed.u64())
                py_shuffle_i64_prefix(&rng, &order, cups)

                xs: mutable darray[f64] = Floats::zeros(SceneNCupMonte::MOST_CUPS)
                SceneNCupMonte::slot_positions(&xs, width, cups)
                if nudged:
                    # A shuffle in flight: every other cup slid a third of a
                    # slot toward the next one.
                    for index in 0..<cups |xs, index|:
                        if index % 2 == 0:
                            Floats::put(&xs, index, Floats::at_ref(&xs, index) + 17.5)

                printr("spec|")
                print_i64(spec)
                emit_bar(cups)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(ball)
                emit_bar(guess)
                emit_bar(1 if show_numbers else 0)
                emit_bar(seed)
                emit_bar(1 if nudged else 0)
                print("")
                message: mutable dstr = []
                dstr_append_cstr(&message, "Press Space to hide the ball")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneNCupMonte::NCupMontePaint = SceneNCupMonte::paint_of(black, width, height, 2.0, 2.0)
                SceneNCupMonte::render(&list, &paint, &order, &xs, cups, phase,
                                       ball, guess, show_numbers,
                                       bytes_view(message))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
