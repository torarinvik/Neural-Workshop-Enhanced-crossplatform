include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_glider.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def report(run: Glider::Run&):
    can Abort.Panic, Console.Write:
        _ = printf("%.17g %.17g %.17g %.17g %lld %lld %lld %lld %lld\n", run.time, run.y, run.vy,
            Glider::gust(&run.course, run.time), 1 if run.lifting else 0, run.passed, run.result, run.hit, run.trail_count)
        for i in 0..<run.trail_count |run|:
            point: Glider::Point = run.trail[((run.trail_next + 24 - run.trail_count + i) % 24).usize()]
            _ = printf("%.17g %.17g\n", point.time, point.y)

def emit(rung: i64, seed: i64):
    can Abort.Panic, Console.Write:
        course: Glider::Course = Glider::deal(rung, seed)
        _ = printf("%lld %lld %lld %lld\n", rung, seed, course.level.count, course.gust_seed)
        for i in 0..<course.level.count |course|:
            wall: Glider::Wall = course.walls[i.usize()]
            _ = printf("%.17g %.17g %.17g\n", wall.x, wall.centre, wall.phase)
        run: mutable Glider::Run = Glider::trial(course)
        for tick in 0..<480 |run|:
            Glider::step(&run, 1.0 / 120.0, tick % 72 < 27)
            if tick % 32 == 31:
                report(&run)
        run <- Glider::trial(course)
        while run.result == Glider::PENDING |run|:
            Glider::step(&run, 1.0 / 60.0, Glider::pilot(&run))
        report(&run)

def session_check() -> bool:
    can Abort.Panic, Memory.Allocate:
        run: mutable GliderGame::Session = GliderGame::initialize(1, 1, true, 17)
        return false if not GliderGame::start(&run, 0.0)
        return false if not GliderGame::input(&run, GliderGame::LIFT, 0.0)
        _ = GliderGame::advance(&run, 0.1)
        return false if not run.run.lifting or run.run.y <= 30.0
        return false if not GliderGame::input(&run, GliderGame::RELEASE, 0.1)
        _ = GliderGame::advance(&run, 0.2)
        return false if run.run.lifting
        return false if not GliderGame::agent_event(&run, 0.2, GliderGame::LIFT)
        _ = GliderGame::agent_event(&run, 0.3, -1)
        return false if not run.run.lifting
        _ = GliderGame::agent_event(&run, 0.4, -1)
        return false if run.run.lifting
        time: mutable f64 = 0.4
        while run.phase == GliderGame::PLAYING |run, time|:
            time <- time + 0.05
            _ = GliderGame::advance(&run, time)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneGlider::render(&list, &run, false)
        return false if run.run.result != Glider::FLOOR or list.commands.count == 0.usize()
        return GliderGame::advance(&run, run.deadline) and run.phase == GliderGame::DONE

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Console.Write:
        return 1.i32() if not session_check()
        for rung in -1..<39:
            for seed in -2..<3 |rung|:
                emit(rung, seed)
        emit(31, -9223372036854775807 - 1)
        emit(100, 9223372036854775807)
        return 0.i32()
