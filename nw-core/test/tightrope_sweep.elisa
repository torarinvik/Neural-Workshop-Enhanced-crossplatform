include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/tightrope_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def pcm(run: Tightrope::Run&, bank: DrShapeAudio::Bank&, start: f64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region audio(524288):
            in audio:
                bytes: mutable u8[8824] = zeroed
                used: i64 = TightropeAudio::render(run, bank, start, start + 0.1, &bytes[0], 8824)
                _ = printf("audio %.17g\n", start)
                for j in 0..<used |bytes|:
                    _ = printf("%02x", bytes[j.usize()].i32())
                _ = printf("\n")

def replay(rung: i64, seed: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(1048576):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                walk: Tightrope::Walk = Tightrope::deal(rung, &draw)
                _ = printf("walk %lld %lld %lld %lld %d %u\n", mode, rung, seed, walk.seed, 1 if walk.valid else 0, py_getrandbits(&draw, 32).u32())
                for i in 0..<walk.level.gusts |walk|:
                    g: Tightrope::Gust = walk.gusts[i.usize()]
                    _ = printf("%.17g %.17g %.17g\n", g.t, g.dur, g.push)
                for i in 0..<walk.level.birds |walk|:
                    b: Tightrope::Bird = walk.birds[i.usize()]
                    _ = printf("%.17g %lld\n", b.t, b.side)
                run: mutable Tightrope::Run = Tightrope::begin(walk)
                HandView::place(&run.hand, 0.0 if mode == 1 else 500.0,
                    0.0 if mode == 2 else (640.0 if mode == 3 else 250.0)) if mode > 0
                while run.result == Tightrope::LIVE |run, mode|:
                    port: i64 = Tightrope::pilot(&run) if mode == 0 else -1
                    Tightrope::act(&run, port)
                    Tightrope::step(&run, 1.0 / 60.0)
                    _ = printf("%lld %lld %.17g %.17g %d %.17g %.17g %.17g %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %lld",
                        port, run.result, run.hand.x, run.hand.y, 1 if run.hand.down else 0, run.time,
                        run.lean, run.rate, run.taken, run.held, run.held_f, run.pitch, run.prate,
                        run.swing, run.swing_v, run.boing, run.boing_v, run.bird_no)
                    for i in 0..<run.perches |run|:
                        _ = printf(" %lld", run.perched[i.usize()])
                    _ = printf("\n")
                _ = printf("notes %lld\n", run.notes.count.i64())
                for cue in run.notes:
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g %.17g\n",
                        cue.seed, cue.voice, cue.t, cue.dur, cue.freq, cue.gain, cue.pan)
                bank: DrShapeAudio::Bank = TightropeAudio::patches()
                pcm(&run, &bank, 0.0)
                pcm(&run, &bank, 1.2)
                pcm(&run, &bank, run.time - 0.04)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in 0..<81:
            g: Tightrope::Grade = Tightrope::grade(rung)
            _ = printf("grade %lld %lld %.17g %.17g %.17g %lld %.17g %lld %.17g %.17g %.17g %.17g %.17g %.17g\n",
                g.rung, g.steps, g.jolt, g.tip, g.sway, g.gusts, g.blow, g.birds, g.breeze, g.spring, g.bounce, g.tip_p, g.jolt_p, g.seconds)
        for rung in [1.i64(), 4.i64(), 7.i64(), 10.i64(), 13.i64(), 16.i64(), 20.i64(), 25.i64(), 30.i64()]:
            replay(rung, 17, 0)
        for mode in 1..<5:
            replay(1, 19, mode)
        return 0
