include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_stop_switch.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def has_color(list: Display::DisplayList&, color: u32) -> bool:
    can Abort.Panic:
        for index in 0..<list.commands.count.i64() |list, color|:
            return true if list.commands[index.usize()].color == color
        return false

def main() -> i32:
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic:
        run: mutable StopSwitchGame::Run = StopSwitchGame::initialize(25, 1, false, 0)
        return 1.i32() if SceneStopSwitch::hit(&run) != StopSwitchGame::START
        _ = StopSwitchGame::start(&run, 0.0)
        idle: mutable Display::DisplayList = Display::DisplayList()
        SceneStopSwitch::render(&idle, &run, true)
        return 2.i32() if has_color(&idle, 0x787c86ff) or has_color(&idle, SceneStopSwitch::ORANGE)
        return 3.i32() if SceneStopSwitch::hit(&run) != -1
        _ = StopSwitchGame::advance(&run, 0.6)
        shown: mutable Display::DisplayList = Display::DisplayList()
        SceneStopSwitch::render(&shown, &run, true)
        return 4.i32() if not has_color(&shown, 0x787c86ff) or not has_color(&shown, SceneStopSwitch::ORANGE)
        return 5.i32() if not StopSwitchGame::steer(&run, 1, 0.7)
        _ = StopSwitchGame::advance(&run, run.shown_at)
        _ = StopSwitchGame::advance(&run, run.shown_at + 0.299)
        quiet: mutable Display::DisplayList = Display::DisplayList()
        SceneStopSwitch::render(&quiet, &run, false)
        return 6.i32() if has_color(&quiet, SceneStopSwitch::STOP) or not has_color(&quiet, SceneStopSwitch::CORRECT)
        _ = StopSwitchGame::advance(&run, run.shown_at + 0.301)
        stopped: mutable Display::DisplayList = Display::DisplayList()
        SceneStopSwitch::render(&stopped, &run, false)
        return 7.i32() if not has_color(&stopped, SceneStopSwitch::STOP)
        encoded: darray[u8] = Display::encode_binary(&stopped)
        return 8.i32() if encoded.count <= 64.usize()
        _ = StopSwitchGame::advance(&run, run.shown_at + 1.0)
        return 9.i32() if run.hits != 2 or run.ring
        prepared: mutable StopSwitchGame::Run = StopSwitchGame::initialize(1, 1, false, 0)
        _ = StopSwitchGame::start(&prepared, 0.0)
        cue: mutable Display::DisplayList = Display::DisplayList()
        SceneStopSwitch::render(&cue, &prepared, false)
        return 10.i32() if not has_color(&cue, 0x966ec8ff)
        _ = printf("PASS: Stop & Switch prepared and concealed cues, stop-ring timing, marks, and pointer gates\n")
        return 0.i32()
