# Differential sweep driver for src/scene_fogofwar.elisa.
# See scene_fogofwar_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_fogofwar.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|phase|black|wide|tall_cells|seen|at|trial|total_trials|tall")
        region w(256 * 1024 * 1024)
        in w:
            for spec in 0..<32:
                phase: i64 = spec % 4
                black: bool = spec % 3 == 1
                wide: i64 = 9 + (spec / 4) % 4 * 4
                tall_cells: i64 = 7 + (spec / 4) % 3 * 4
                cells: i64 = wide * tall_cells
                # How much of the world has been lit, from none to all of it.
                seen: i64 = (spec / 4) % 5
                at: i64 = spec * 7 % cells
                tall: i64 = 1368 if spec % 2 == 0 else 960
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(wide)
                emit_bar(tall_cells)
                emit_bar(seen)
                emit_bar(at)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                print("")
                walls: mutable darray[bool] = []
                revealed: mutable darray[bool] = []
                for cell in 0..<cells |walls, revealed, wide, tall_cells, seen|:
                    x: i64 = cell % wide
                    y: i64 = cell / wide
                    walls.push(x == 0 or y == 0 or x == wide - 1 or y == tall_cells - 1 or (x % 3 == 0 and y % 3 == 0))
                    revealed.push(seen == 4 or (seen > 0 and cell % (6 - seen) == 0))
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneFogOfWar::Paint = SceneFogOfWar::paint_of(black, width, height, 2.0, 2.0)
                SceneFogOfWar::render(&list, &paint, phase, true, wide,
                                      tall_cells, &walls, &revealed, at,
                                      1 + spec % 5, 5,
                                      sview("Press Space to start", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
