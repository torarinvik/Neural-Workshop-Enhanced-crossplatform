# Differential sweep driver for src/scene_algebra.elisa.
# See scene_algebra_diff.py for the reference side.
#
# `candidates` is swept across all three branches of `search_line`, and around
# the two boundaries -- 1.5 and 5.0 -- because that is where a comparison
# written with the wrong sign still reads correctly.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_algebra.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Global.Read, Global.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            width: f64 = 1824.0
            height: f64 = 1368.0
            print("names|spec|phase|black|has_problem|show_working|trial|total_trials|tenths")
            for spec in 0..<28 |width, height|:
                phase: i64 = spec % 4
                black: bool = spec % 5 == 2
                has_problem: bool = spec % 9 != 8
                show_working: bool = spec % 3 != 1
                # 0.2 apart, which walks both boundaries.
                tenths: i64 = 2 + spec * 4
                candidates: f64 = tenths.f64() / 10.0
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if has_problem else 0)
                emit_bar(1 if show_working else 0)
                emit_bar(1 + spec % 6)
                emit_bar(6)
                emit_bar(tenths)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneAlgebra::AlgebraPaint = SceneAlgebra::paint_of(black, width, height, 2.0, 2.0)
                SceneAlgebra::render(&list, &paint, phase, has_problem,
                                     sview("3x + 7 = 22", 0, -1),
                                     sview("solve for x", 0, -1),
                                     sview("3x = 15\nx = 5", 0, -1),
                                     sview("5", 0, -1),
                                     candidates, show_working,
                                     1 + spec % 6, 6,
                                     sview("Press Space to start", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
