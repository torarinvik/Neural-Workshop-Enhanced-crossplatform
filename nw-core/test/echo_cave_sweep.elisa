include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_echo_cave.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def wave(w: EchoCave::Wave):
    can Console.Write:
        _ = printf("%.17g %.17g %.17g\n", w.amplitude, w.wavelength, w.phase)

def state(run: EchoCave::Run&):
    can Console.Write:
        _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g %.17g %lld %lld %lld\n",
            run.time, run.z, run.x, run.y, run.vx, run.vy, EchoCave::lit(run), run.caught, run.caught_mask, run.result)

def emit(rung: i64, seed: i64):
    can Abort.Panic, Console.Write:
        cave: EchoCave::Cave = EchoCave::deal(rung, seed)
        _ = printf("%lld %lld %lld %lld\n", rung, seed, cave.level.moths, cave.flutter)
        wave(cave.horizontal_one)
        wave(cave.horizontal_two)
        wave(cave.vertical_one)
        wave(cave.vertical_two)
        wave(cave.width)
        for i in 0..<cave.level.moths |cave|:
            m: EchoCave::Moth = cave.moths[i.usize()]
            _ = printf("%.17g %.17g %.17g\n", m.z, m.dx, m.dy)
        run: mutable EchoCave::Run = EchoCave::trial(cave)
        for tick in 0..<1440 |run|:
            if tick % 9 == 0:
                _ = EchoCave::click(&run)
            run.aimed <- tick % 60 < 25
            run.aim <- EchoCave::Point{x: -1.4, y: 0.6}
            mask: i64 = (1 << (tick / 37 % 8).u64()) | (1 << (tick / 81 % 8).u64())
            EchoCave::step(&run, 1.0 / 120.0, 0 if tick % 60 < 40 else mask)
            if tick % 96 == 95:
                state(&run)
        run <- EchoCave::trial(cave)
        while run.result == EchoCave::PENDING |run|:
            if run.clicked_at < 0.0 or run.time - run.clicked_at > 0.5:
                _ = EchoCave::click(&run)
            EchoCave::step(&run, 1.0 / 60.0, EchoCave::pilot(&run))
        state(&run)
        _ = printf("%lld\n", run.cue_count)
        for i in 0..<run.cue_count |run|:
            n: EchoCave::Cue = run.cues[i.usize()]
            _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g %lld\n",
                n.time, n.duration, n.pitch, n.pan, n.gain, n.bright, n.voice)

def session_check() -> bool:
    can Memory.Allocate, Abort.Panic:
        session: mutable EchoCaveGame::Session = EchoCaveGame::initialize(10, 1, true, 17)
        return false if not EchoCaveGame::start(&session, 0.0)
        dark: mutable Display::DisplayList = Display::DisplayList()
        SceneEchoCave::render(&dark, &session, true)
        return false if not EchoCaveGame::agent_mask(&session, 288)
        return false if EchoCaveGame::info(&session, 14) != 40000
        return false if EchoCaveGame::input(&session, EchoCave::CLICK, 0.0)
        _ = EchoCaveGame::agent_event(&session, 0.05, -1)
        return false if session.run.vx <= 0.0 or session.run.vy <= 0.0 or session.pulse != 0
        flash: mutable Display::DisplayList = Display::DisplayList()
        SceneEchoCave::render(&flash, &session, true)
        pcm: mutable u8[5000] = zeroed
        length: i64 = EchoCaveGame::audio_window(&session, &pcm[0], 5000)
        return length > 0 and flash.commands.count > dark.commands.count

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Console.Write:
        return 1.i32() if not session_check()
        for rung in -1..<34:
            for seed in -1..<2 |rung|:
                emit(rung, seed)
        emit(30, -9223372036854775807 - 1)
        emit(70, 9223372036854775807)
        return 0.i32()
