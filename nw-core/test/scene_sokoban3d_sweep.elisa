# Differential sweep driver for src/scene_sokoban3d.elisa.
# See scene_sokoban3d_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pymath.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_sokoban3d.elisa"
include "scene_emit.elisa"

const COLUMNS: i64 = 180

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|phase|black|wide|tall_cells|show_traps|show_marks|marks|steps|pushes|trial|total_trials|tall|verdict")
        region w(512 * 1024 * 1024)
        in w:
            for spec in 0..<25:
                phase: i64 = spec % 5
                black: bool = spec % 7 == 1
                wide: i64 = 7 + (spec / 5) % 3 * 4
                tall_cells: i64 = 7 + (spec / 5) % 2 * 6
                show_traps: bool = (spec / 5) % 2 == 0
                show_marks: bool = (spec / 5) % 3 != 2
                marks: i64 = (spec / 5) % 4
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 or phase == 3 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(wide)
                emit_bar(tall_cells)
                emit_bar(1 if show_traps else 0)
                emit_bar(1 if show_marks else 0)
                emit_bar(marks)
                emit_bar(spec % 31)
                emit_bar(spec % 13)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")

                cells: i64 = wide * tall_cells
                walls: mutable darray[bool] = []
                goals: mutable darray[bool] = []
                traps: mutable darray[bool] = []
                live: mutable darray[bool] = []
                plan_boxes: mutable darray[i64] = []
                for cell in 0..<cells |walls, goals, traps, live, plan_boxes, wide, tall_cells|:
                    x: i64 = cell % wide
                    y: i64 = cell / wide
                    edge: bool = x == 0 or y == 0 or x == wide - 1 or y == tall_cells - 1
                    walls.push(edge)
                    goals.push(not edge and cell % 7 == 3)
                    traps.push(not edge and cell % 11 == 5)
                    # A box on a goal is drawn green and one off it blue, so
                    # the sweep puts some of each in front of the rays.
                    box: bool = not edge and cell % 5 == 2
                    live.push(box)
                    if box:
                        plan_boxes.push(cell)

                sights: mutable darray[SceneSokoban3D::Sight] = []
                for column in 0..<COLUMNS |sights, cells|:
                    beyond: bool = column % 37 == 0
                    sights.push(SceneSokoban3D::Sight{
                        distance: SceneSokoban3D::FAR if beyond else 0.2 + 0.09 * (column % 61).f64(),
                        cell: (column * 7) % cells,
                        side: column % 2})
                spots: mutable darray[SceneSokoban3D::Mark] = []
                for one in 0..<marks |spots|:
                    spots.push(SceneSokoban3D::Mark{
                        across: 0.07 + 0.23 * one.f64(),
                        distance: 0.3 + 2.5 * one.f64()})

                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneSokoban3D::Paint = SceneSokoban3D::paint_of(black, width, height, 2.0, 2.0)
                SceneSokoban3D::render(&list, &paint, phase, true, wide,
                                       tall_cells, &walls, &goals, &traps,
                                       &plan_boxes, wide + 1, &live,
                                       show_traps, show_marks, &sights,
                                       &spots, spec % 31, spec % 13,
                                       1 + spec % 5, 5,
                                       sview("Rung 3 - minimum 12 pushes", 0, -1),
                                       verdict,
                                       sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
