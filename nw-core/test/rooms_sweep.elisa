include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_rooms.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(room: Rooms::Room&):
    can Console.Write, Abort.Panic:
        _ = printf("%lld %lld %lld\n", room.name, room.tint, room.count)
        for i in 0..<room.count |room|:
            thing: Rooms::Thing = room.things[i.usize()]
            _ = printf("%lld %lld %lld %.17g %.17g\n", thing.cell, thing.kind, thing.colour, thing.size, thing.yaw)

def main() -> i32:
    can Memory.Allocate, Console.Write, Abort.Panic:
        for rung in -1..<33:
            for seed in -12..<12 |rung|:
                puzzle: Rooms::Puzzle = Rooms::deal(rung, seed)
                level: Rooms::Grade = puzzle.level
                _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %.17g\n", rung, seed, level.rung,
                    level.cols, level.rows, level.rooms, puzzle.tested, puzzle.change, puzzle.answer_count,
                    puzzle.answer[0], puzzle.answer[1], puzzle.angle)
                for i in 0..<level.rooms |puzzle|:
                    emit(&puzzle.rooms[i.usize()])
                emit(&puzzle.changed)
                cam: RoomsView::Camera = RoomsView::camera(level.cols, level.rows, puzzle.angle)
                bounds: RoomsView::Bounds = RoomsView::bounds(&cam, level.cols, level.rows)
                picture: RoomsView::Picture = RoomsView::scene(&cam, level.cols, level.rows, &puzzle.changed)
                _ = printf("%lld %.17g %.17g %.17g %.17g\n", picture.count, bounds.left, bounds.bottom, bounds.right, bounds.top)
                for i in 0..<picture.count |picture|:
                    p: RoomsView::Polygon& = &picture.polygons[i.usize()]
                    _ = printf("%lld %llu %lld", p.cell, p.colour.u64(), p.count)
                    x: mutable f64 = 0.0
                    y: mutable f64 = 0.0
                    for k in 0..<p.count |p, x, y|:
                        point: RoomsView::Point = p.points[k.usize()]
                        x <- x + point.x
                        y <- y + point.y
                        _ = printf(" %.17g %.17g", point.x, point.y)
                    _ = printf(" %lld\n", RoomsView::pick(&picture, x / p.count.f64(), y / p.count.f64()))
        run: mutable RoomsGame::Run = RoomsGame::initialize(16, 3, true, -17)
        return 1.i32() if not RoomsGame::configure_think(&run, 0.25, 0.125)
        return 2.i32() if SceneRooms::hit(&run, 0.0, 0.0) != RoomsGame::START
        return 2.i32() if not RoomsGame::steer(&run, RoomsGame::START, 0)
        _ = printf("start %lld %lld\n", run.puzzle.seed, run.puzzle.level.rung)
        return 3.i32() if RoomsGame::steer(&run, 0, 0)
        return 3.i32() if SceneRooms::hit(&run, 456.0, 190.0) != RoomsGame::NEXT
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneRooms::render(&list, &run, false)
        return 3.i32() if Display::encode_binary(&list).count < 1000.usize()
        for room in 0..<run.puzzle.level.rooms |run|:
            return 4.i32() if not RoomsGame::steer(&run, RoomsGame::NEXT, 0)
        return 5.i32() if RoomsGame::steer(&run, RoomsGame::NEXT, 0)
        return 6.i32() if RoomsGame::steer(&run, 29, 0)
        return 7.i32() if not RoomsGame::steer(&run, run.puzzle.answer[0], 10)
        return 8.i32() if not RoomsGame::step(&run, 0.125) or run.phase != RoomsGame::JUDGED
        return 9.i32() if run.rung != 17 or run.deadline != 3010 or run.passed_count != 1 or run.best_rung != 16
        return 10.i32() if not RoomsGame::step(&run, 0.125) or run.phase != RoomsGame::PLAYING
        _ = printf("next %lld %lld\n", run.puzzle.seed, run.puzzle.level.rung)
        return 11.i32() if not RoomsGame::step(&run, 0.25) or run.phase != RoomsGame::FLAGGED or run.forfeits != 1
        return 12.i32() if not RoomsGame::step(&run, 0.125) or run.think_left != 0.125
        _ = printf("refill %lld %lld\n", run.puzzle.seed, run.puzzle.level.rung)
        for room in 0..<run.puzzle.level.rooms |run|:
            return 13.i32() if not RoomsGame::steer(&run, RoomsGame::NEXT, 0)
        wrong: mutable i64 = 1 if Rooms::correct(&run.puzzle, 0) else 0
        wrong <- 2 if Rooms::correct(&run.puzzle, wrong)
        return 14.i32() if not RoomsGame::steer(&run, wrong, 0) or run.passed or run.rung != 16
        return 15.i32() if RoomsGame::advance(&run, 2999) or not RoomsGame::advance(&run, 3000)
        return 16.i32() if run.phase != RoomsGame::DONE or run.passed_count != 1
        return 0.i32()
