# Differential sweep driver for src/scene_numberology.elisa.
# See scene_numberology_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_numberology.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|has_puzzle|trial|total_trials|tall|verdict")
            for spec in 0..<24:
                phase: i64 = spec % 4
                black: bool = spec % 5 == 1
                has_puzzle: bool = spec % 7 != 6
                # Two window heights, so every `int()` truncation in the
                # layout is exercised at two different scale factors. 960 is
                # 480 points, the shortest window geometry will lay out --
                # anything shorter is clamped up and the reference would then
                # be drawing at a height the sweep never named.
                tall: i64 = 1368 if spec % 2 == 0 else 960
                # -1 no verdict, 0 wrong, 1 right. Only a judged trial has
                # one; the screen clears it when the next trial opens.
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if has_puzzle else 0)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneNumberology::NumberologyPaint = SceneNumberology::paint_of(black, width, height, 2.0, 2.0)
                SceneNumberology::render(&list, &paint, phase, has_puzzle,
                                         sview("2, 4, 8, 16, ?", 0, -1),
                                         sview("each term doubles", 0, -1),
                                         sview("32", 0, -1),
                                         1 + spec % 5, 5,
                                         sview("Difficulty 3", 0, -1),
                                         verdict,
                                         sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
