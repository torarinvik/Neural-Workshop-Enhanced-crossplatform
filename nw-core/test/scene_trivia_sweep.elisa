# Differential sweep driver for src/scene_trivia.elisa.
# See scene_trivia_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/textmetrics.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_trivia.elisa"
include "scene_emit.elisa"

# Mirrored, in order, by QUESTIONS in scene_trivia_diff.py. One that does not
# wrap, one that wraps to two lines and one that wraps to several -- the whole
# column of options hangs off how tall the question turned out.
const QUESTION_COUNT: i64 = 3

def question_of(which: i64) -> cstr:
    if which == 0:
        return "Which planet is nearest the Sun?"
    elif which == 1:
        return "Which international court, seated in The Hague, settles disputes submitted to it by states and gives advisory opinions on questions referred by United Nations organs?"
    return "In the history of the calendar, the reform promulgated in 1582 dropped ten days from October in the countries that adopted it at once, adjusted the rule for which century years are leap years, and was not taken up in Britain and its colonies for another 170 years, by which time the discrepancy had grown to eleven days. Which reform was it, and by what body was the corresponding rule for the date of Easter fixed in the same document, given that the two questions are usually treated together?"

const OPTION_COUNT: i64 = 8

def option_of(which: i64) -> cstr:
    if which == 0:
        return "Mercury"
    elif which == 1:
        return "Venus"
    elif which == 2:
        return "the International Court of Justice"
    elif which == 3:
        return "Earth"
    elif which == 4:
        return "the Permanent Court of Arbitration"
    elif which == 5:
        return "Mars"
    elif which == 6:
        return "the Gregorian reform"
    return "Jupiter"

const MISSING: cstr = "Trivia is on its seed questions -- for the whole bank run python -m neural_workshop.trivia"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|has_round|question|options|choice|answered|answer|show_answer|fetched|pool|trial|total_trials|tall|verdict")
            for spec in 0..<48:
                phase: i64 = spec % 4
                black: bool = spec % 7 == 1
                has_round: bool = spec % 13 != 12
                # Divided by the phase stride: the question is only drawn in
                # two of the four phases, so a modulo would hand every frame
                # that draws it the same value.
                which: i64 = (spec / 4) % QUESTION_COUNT
                shown: i64 = 2 + (spec / 4) % (OPTION_COUNT - 1)
                choice: i64 = spec % shown
                answered: i64 = (spec + 1) % shown
                answer: i64 = (spec + 2) % shown
                show_answer: bool = spec % 5 != 4
                fetched: bool = spec % 3 != 2
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if has_round else 0)
                emit_bar(which)
                emit_bar(shown)
                emit_bar(choice)
                emit_bar(answered)
                emit_bar(answer)
                emit_bar(1 if show_answer else 0)
                emit_bar(1 if fetched else 0)
                emit_bar(137)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                options: mutable darray[sview] = []
                if has_round:
                    for one in 0..<shown |options|:
                        options.push(sview(option_of(one), 0, -1))
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneTrivia::TriviaPaint = SceneTrivia::paint_of(black, width, height, 2.0, 2.0)
                SceneTrivia::render(&list, &paint, phase, has_round,
                                    sview(question_of(which), 0, -1), &options,
                                    choice, answered, answer, show_answer,
                                    fetched, sview(MISSING, 0, -1), 137,
                                    1 + spec % 5, 5,
                                    sview("Rung 3 - general", 0, -1), verdict,
                                    sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
