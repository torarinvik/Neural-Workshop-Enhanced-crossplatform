include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "../src/tasks/what_next_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def clip(data: mutable darray[u8]&, count: i64, seed: i64, size: i64, still: bool) -> WhatNext::Clip:
    can Memory.Allocate, Abort.Panic:
        offset: i64 = data.count.i64()
        samples: i64 = (size + 96) / 97
        for frame in 0..<count |data, samples, seed, still|:
            for at in 0..<samples |data, frame, seed, still|:
                value: i64 = 64 if still else (seed * 37 + frame * 6 + at * 97 * 3) % 256
                data.push(value.u8())
        return WhatNext::Clip{frames: count, stride: samples, offset: offset}

def trial(rung: i64, scenario: i64, seed: i64):
    can Memory.Allocate, Abort.Panic, Console.Write:
        data: mutable darray[u8] = []
        group: mutable WhatNext::Group = zeroed
        length: i64 = 9 if scenario == 1 else (27 if scenario == 2 else 120)
        group.clips[0] <- clip(&data, length, 0, 600, scenario == 3)
        extra: i64 = 0 if scenario == 3 or scenario == 5 else 6
        group.count <- extra + 1
        for at in 0..<extra |data, group, scenario|:
            size: i64 = 400 if at % 2 == 0 else 600
            length_other: i64 = 12 if scenario == 4 and at < 2 else 100
            group.clips[(at + 1).usize()] <- clip(&data, length_other, 3 if scenario == 6 else at + 3, size, false)
        rng: mutable MT19937 = mt19937_new()
        mt_seed_int(&rng, seed.u64())
        level: WhatNext::Grade = WhatNext::grade(rung)
        puzzle: WhatNext::Puzzle = WhatNext::build(&group, &data[0], data.count.i64(), &level, &rng)
        _ = printf("%lld %lld %lld %lld %lld %.17g %lld %lld %lld %lld\n", rung, scenario, seed,
            level.choices, level.kinds, level.context, puzzle.count, puzzle.answer, puzzle.opening.start,
            py_getrandbits(&rng, 32).i64())
        for at in 0..<puzzle.count |puzzle|:
            choice: WhatNext::Choice = puzzle.options[at.usize()]
            _ = printf("%lld %lld %lld %lld %lld\n", choice.kind, choice.slice.clip,
                choice.slice.start, choice.slice.length, choice.slice.step)
        if puzzle.count > 0:
            _ = printf("%lld\n", puzzle.opening.length)
            for tick in 0..<(puzzle.opening.length + puzzle.options[0].slice.length + 2) |puzzle|:
                for stream in 0..<(puzzle.count + 1) |puzzle, tick|:
                    _ = printf("%lld\n", WhatNext::playback(&puzzle, stream, tick))

def game() -> bool:
    can Memory.Allocate, Abort.Panic:
        data: mutable darray[u8] = []
        group: mutable WhatNext::Group = zeroed
        group.clips[0] <- clip(&data, 120, 0, 600, false)
        group.count <- 1
        missing: WhatNext::Group = zeroed
        run: mutable WhatNextGame::Run = WhatNextGame::initialize(20, 1, true, -17)
        return false if not WhatNextGame::start(&run)
        return false if WhatNextGame::load_clips(&run, &missing, &data[0], data.count.i64(), 1.0) or run.phase != WhatNextGame::LOADING or run.trial != 0
        return false if not WhatNextGame::load_clips(&run, &group, &data[0], data.count.i64(), 2.0)
        return false if WhatNextGame::choose(&run, 6, 2.1)
        return false if WhatNextGame::frame(&run, 0, 2.5) != run.puzzle.opening.start + 7
        answer: i64 = run.puzzle.answer
        return false if not WhatNextGame::choose(&run, (answer + 1) % run.puzzle.count, 3.0)
        return false if run.phase != WhatNextGame::JUDGED or run.rung != 19 or run.scored != 1 or run.passed != 0
        return false if run.results[0].rung != 20 or run.results[0].passed
        return false if WhatNextGame::choose(&run, answer, 4.0) or WhatNextGame::advance(&run, 5.999)
        return false if not WhatNextGame::advance(&run, 6.0) or run.phase != WhatNextGame::DONE
        return false if WhatNextGame::frame(&run, 0, 6.0) != -1
        return false if not WhatNextGame::start(&run) or run.rung != 20 or run.scored != 0
        return false if not WhatNextGame::load_clips(&run, &group, &data[0], data.count.i64(), 7.0)
        return false if not WhatNextGame::choose(&run, run.puzzle.answer, 8.0)
        return false if run.rung != 21 or run.scored != 1 or run.passed != 1 or run.best != 20
        return false if not WhatNextGame::advance(&run, 11.0)
        return false if not WhatNextGame::start(&run) or not WhatNextGame::unavailable(&run)
        return run.phase == WhatNextGame::READY and run.trial == 0

def main() -> i32:
    can Memory.Allocate, Abort.Panic, Console.Write:
        for rung in -1..<36:
            for scenario in 0..<7 |rung|:
                trial(rung, scenario, (rung + 2) * 13 + scenario)
        return 0 if game() else 1
