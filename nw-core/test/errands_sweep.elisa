include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/errands_text.elisa"

# Errands' deals, mail, plans, par, reference ports and seeded play;
# errands_diff.py replays the same against errands.py.
extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def flag(value: bool) -> i64:
    return 1 if value else 0

def text(value: dstr&):
    can Console.Write, Abort.Panic:
        for i in 0..<value.count.i64() |value|:
            _ = dprintf(1.i32(), "%02x", value[i.usize()].i32())
        _ = dprintf(1.i32(), "\n")

def emit_action(action: BrowserPages::Action):
    can Console.Write:
        _ = dprintf(1.i32(), " %lld %lld %lld %lld %lld", action.kind, action.department, action.number, action.sort, action.index)

def emit_step(tag: cstr, step: ErrandsOffice::Step):
    can Console.Write:
        _ = dprintf(1.i32(), "%s %lld %lld", tag, step.kind, step.value)
        emit_action(step.shop)
        _ = dprintf(1.i32(), "\n")

def emit_deal(dealt: Errands::Deal&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        g: Errands::Grade = dealt.level
        _ = dprintf(1.i32(), "grade %lld %lld %lld %lld %lld %lld %lld %.17g\n", g.rung, g.errands, flag(g.shopping), g.shop_rung,
            g.noise, flag(g.policy), flag(g.amend), g.slack)
        _ = dprintf(1.i32(), "deal %lld %lld", dealt.seed, dealt.mail_count)
        for index in 0..<8 |dealt|:
            _ = dprintf(1.i32(), " %lld", dealt.numbers[index.usize()])
        _ = dprintf(1.i32(), "\n")
        if dealt.shopping:
            _ = dprintf(1.i32(), "shop %lld %lld %lld %lld", dealt.shop.seed, dealt.shop.level.departments, dealt.shop.product_count,
                dealt.shop.goal_count)
            for goal in 0..<dealt.shop.goal_count |dealt|:
                _ = dprintf(1.i32(), " %lld %lld", dealt.shop.targets[goal.usize()], dealt.categories[goal.usize()])
            _ = dprintf(1.i32(), "\n")
        else:
            _ = dprintf(1.i32(), "receipt %lld %lld %lld\n", dealt.receipt.number, dealt.receipt.amount, dealt.receipt.category)
        for index in 0..<dealt.mail_count |dealt|:
            mail: Errands::Mail = dealt.mails[index.usize()]
            _ = dprintf(1.i32(), "mail %lld\n", flag(Errands::is_work(&mail)))
            said: mutable dstr = []
            ErrandsText::sender(&said, &mail)
            text(&said)
            said <- []
            ErrandsText::subject(&said, &mail)
            text(&said)
            said <- []
            ErrandsText::time(&said, &mail)
            text(&said)
            said <- []
            ErrandsText::mail_body(&said, dealt, &mail)
            text(&said)
            lines: darray[i64] = ErrandsText::wrap(&said)
            _ = dprintf(1.i32(), "wrap %lld", lines.count.i64())
            for at in lines:
                _ = dprintf(1.i32(), " %lld", at)
            _ = dprintf(1.i32(), "\n")

def emit_state(office: ErrandsOffice::Office&, port: i64, kind: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        shop: ErrandShop::Shop = office.shop
        _ = dprintf(1.i32(), "step %lld %lld %lld %lld %lld %lld %lld %lld %lld %.17g %.17g %lld %lld %.17g %lld %lld", port, kind,
            office.app, office.reading, office.read, office.form.focus, office.form.category, office.form.claim_count,
            office.clicks, office.pointer.x, office.pointer.y, flag(office.done), office.notice, shop.session.scroll,
            shop.session.cart.count, shop.order_count)
        emit_action(shop.session.page)
        for order in 0..<shop.order_count |shop|:
            _ = dprintf(1.i32(), " %lld %lld %lld", shop.orders[order.usize()].number, shop.orders[order.usize()].total,
                shop.orders[order.usize()].items.count)
        _ = dprintf(1.i32(), "\n")
        typed: mutable dstr = []
        ErrandsText::digits(&typed, &office.form.fields[0])
        typed.push(124.u8())
        ErrandsText::digits(&typed, &office.form.fields[1])
        text(&typed)

def next_state(state: i64) -> i64:
    return (state * 1103515245 + 12345) % 2147483648

# Seeded play: pointer ports, clicks on whatever the office or its shop
# offers (sometimes anywhere), and digits, until Done or the budget.
def play(dealt: Errands::Deal&, seed: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        office: mutable ErrandsOffice::Office = ErrandsOffice::start(dealt)
        rolling: mutable i64 = seed % 2147483648
        for _ in 0..<200 |office, rolling|:
            rolling <- next_state(rolling)
            draw: i64 = rolling / 128
            pick: i64 = draw % 100
            port: mutable i64 = (draw / 100) % 15
            kind: mutable i64 = 0
            if pick < 30:
                ErrandsOffice::steer(&office, port)
            elif pick < 85:
                kind <- 1
                count: i64 = ErrandsOffice::target_count(&office)
                shown: BrowserPages::Layout = ErrandShop::elements(&office.shop)
                links: mutable darray[i64] = []
                if office.app == ErrandsOffice::SHOP:
                    for index in 0..<shown.count |links, shown, office|:
                        element: BrowserPages::Element = shown.elements[index.usize()]
                        links.push(index) if element.action.kind != BrowserPages::NONE and BrowserSession::visible(&office.shop.session, &element)
                # Done only rarely, so rounds get somewhere first.
                choice: i64 = (draw / 100) % (count + links.count.i64() + 3)
                port <- choice
                if choice < count:
                    place: mutable ErrandsOffice::Rectangle = zeroed
                    found: ErrandsOffice::Step = ErrandsOffice::target(&office, choice, &place)
                    if found.kind == ErrandsOffice::DONE and (draw / 7) % 9 != 0:
                        port <- -2
                    else:
                        _ = ErrandsOffice::click_at(&office, place.x + place.width / 2.0, place.y + place.height / 2.0)
                elif choice < count + links.count.i64():
                    element: BrowserPages::Element = shown.elements[links[(choice - count).usize()].usize()]
                    spot: BrowserSession::Rectangle = BrowserSession::on_screen(&office.shop.session, &element)
                    _ = ErrandsOffice::click_at(&office, spot.x + spot.width / 2.0, spot.y + spot.height / 2.0)
                else:
                    _ = ErrandsOffice::click_at(&office, ((draw / 7) % 1000).f64(), ((draw / 11) % 640).f64())
            else:
                kind <- 2
                port <- (draw / 100) % 11
                if office.app == ErrandsOffice::EXPENSES and not office.done:
                    office.clicks <- office.clicks + 1
                    ErrandsOffice::act(&office, ErrandsOffice::step(ErrandsOffice::PRESS, port))
            emit_state(&office, port, kind)
            break if office.done
        verdict: ErrandsPar::Mistakes = ErrandsPar::mistakes(&office)
        _ = dprintf(1.i32(), "played %lld\n", flag(ErrandsPar::passed(verdict)))
        said: mutable dstr = []
        ErrandsText::mistakes(&said, &verdict)
        text(&said)

# The plan carried out directly, with a junk claim filed before Done and,
# when `skip`, the last real claim never submitted.
def scripted(dealt: Errands::Deal&, skip: bool):
    can Console.Write, Memory.Allocate, Abort.Panic:
        office: mutable ErrandsOffice::Office = ErrandsOffice::start(dealt)
        steps: darray[ErrandsOffice::Step] = ErrandsPar::plan(dealt, false)
        last_submit: mutable i64 = -1
        for index in 0..<steps.count.i64() |last_submit, steps|:
            last_submit <- index if steps[index.usize()].kind == ErrandsOffice::SUBMIT
        for index in 0..<steps.count.i64() |office, steps, skip, last_submit|:
            wanted: ErrandsOffice::Step = steps[index.usize()]
            continue if skip and index == last_submit
            if wanted.kind == ErrandsOffice::DONE:
                junk: ErrandsOffice::Step[7] = [ErrandsOffice::step(ErrandsOffice::APP, ErrandsOffice::EXPENSES),
                    ErrandsOffice::step(ErrandsOffice::FIELD, 0), ErrandsOffice::step(ErrandsOffice::PRESS, 4),
                    ErrandsOffice::step(ErrandsOffice::FIELD, 1), ErrandsOffice::step(ErrandsOffice::PRESS, 9),
                    ErrandsOffice::step(ErrandsOffice::CATEGORY, 3), ErrandsOffice::step(ErrandsOffice::SUBMIT, 0)]
                for extra in junk |office|:
                    office.clicks <- office.clicks + 1
                    ErrandsOffice::act(&office, extra)
            office.clicks <- office.clicks + 1
            ErrandsOffice::act(&office, wanted)
        verdict: ErrandsPar::Mistakes = ErrandsPar::mistakes(&office)
        _ = dprintf(1.i32(), "scripted %lld %lld %lld\n", flag(skip), flag(ErrandsPar::passed(verdict)), office.form.claim_count)
        said: mutable dstr = []
        ErrandsText::mistakes(&said, &verdict)
        text(&said)

def sample(rung: i64, seed: i64, from_run: bool):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = dprintf(1.i32(), "case %lld %lld %lld\n", rung, seed, flag(from_run))
        dealt: mutable Errands::Deal = zeroed
        if from_run:
            run: mutable MT19937 = zeroed
            mt_seed_int(&run, seed.u64())
            dealt <- Errands::deal(rung, &run)
            _ = dprintf(1.i32(), "after %.17g\n", py_random(&run))
        else:
            dealt <- Errands::deal_seeded(rung, seed)
        emit_deal(&dealt)
        _ = dprintf(1.i32(), "par %lld %lld %lld\n", ErrandsPar::fewest(&dealt), ErrandsPar::thorough(&dealt), ErrandsPar::par(&dealt))
        for step in ErrandsPar::plan(&dealt, false):
            emit_step("plan", step)
        start: mutable ErrandsOffice::Office = ErrandsOffice::start(&dealt)
        start.pointer <- BrowserSession::Pointer{x: (seed % 1000).f64(), y: (rung * 20 % 640).f64()}
        ports: darray[i64] = ErrandsPar::reference_ports(&start)
        _ = dprintf(1.i32(), "reference %lld", ports.count.i64())
        for port in ports:
            _ = dprintf(1.i32(), " %lld", port)
        _ = dprintf(1.i32(), "\n")
        replay: mutable ErrandsOffice::Office = start
        for port in ports |replay|:
            ErrandsOffice::steer(&replay, port)
        _ = dprintf(1.i32(), "replayed %lld %lld %lld\n", flag(replay.done), flag(ErrandsPar::passed(ErrandsPar::mistakes(&replay))),
            replay.clicks)
        scripted(&dealt, false)
        scripted(&dealt, true)
        play(&dealt, seed * 31 + rung)
        play(&dealt, seed * 37 + rung + 1) if rung % 3 == 0
        _ = dprintf(1.i32(), "end\n")

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region fixtures(536870912)
        in fixtures:
            for rung in 0..<31:
                for seed in [0, 2, 17, 42] |rung|:
                    sample(rung, seed, false)
            for rung in [1, 3, 6, 9, 12, 15, 21, 30]:
                for seed in [5, 2024] |rung|:
                    sample(rung, seed, true)
        destroy fixtures
        return 0.i32()
