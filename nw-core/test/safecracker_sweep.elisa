include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_safecracker.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit_text(text: dstr):
    can Abort.Panic, Console.Write:
        for byte in text:
            _ = printf("%c", byte.i32())
        _ = printf("\n")

def emit(rung: i64, seed: i64):
    can Memory.Allocate, Abort.Panic, Console.Write:
        draw: mutable MT19937 = mt19937_new()
        mt_seed_int(&draw, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
        safe: Safecracker::Safe = Safecracker::deal(rung, &draw)
        _ = printf("%lld %lld %lld\n", rung, seed, 1 if safe.valid else 0)
        return if not safe.valid
        _ = printf("%lld %lld %lld %lld %.17g\n", safe.lamps[0], safe.lamps[1], safe.bolts, safe.seed, safe.level.seconds)
        for target in safe.combo:
            _ = printf("%lld ", target)
        _ = printf("\n")
        for target in safe.decoys:
            _ = printf("%lld ", target)
        _ = printf("\n")
        emit_text(safe.clue)
        emit_text(safe.answer)
        run: mutable Safecracker::Run = Safecracker::initialize(safe)
        frame: mutable i64 = 0
        while run.result == Safecracker::PENDING |run, frame|:
            port: i64 = Safecracker::pilot(&run)
            Safecracker::act(&run, port)
            Safecracker::tick(&run, 1.0 / 60.0)
            if frame % 19 == 0 or run.result != Safecracker::PENDING:
                _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %.17g %.17g %.17g %.17g %.17g %.17g\n",
                    frame, port, run.result, run.tumblers_set, run.grab, run.last_way, run.length, run.strikes,
                    run.time, run.reading, run.travel, run.hand.x, run.hand.y, run.lever)
            frame <- frame + 1
        _ = printf("cues %lld\n", run.notes.count.i64())
        for cue in run.notes:
            _ = printf("%.17g %.17g %.17g %lld %.17g %lld\n", cue.time, cue.duration, cue.pitch, cue.voice, cue.gain, cue.seed)

def alarms() -> bool:
    can Memory.Allocate, Abort.Panic:
        safe: Safecracker::Safe = Safecracker::build(Safecracker::grade(10), 17)
        run: mutable Safecracker::Run = Safecracker::initialize(safe)
        for _mistake in 0..<3 |run, safe|:
            for _letter in 0..<safe.answer.count.i64() |run|:
                Safecracker::act(&run, Safecracker::LETTER + 25)
        return false if run.result != Safecracker::MISTAKES or run.strikes != 3
        run <- Safecracker::initialize(safe)
        Safecracker::tick(&run, safe.level.seconds)
        return run.result == Safecracker::TIMEOUT

def session_check() -> bool:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        session: mutable SafecrackerGame::Session = SafecrackerGame::initialize(13, 1, false, 17)
        accepted: mutable bool = false
        region request(4096):
            in request:
                accepted <- SafecrackerGame::start(&session, 0.0) can Global{Read,Write}
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneSafecracker::render(&list, &session, true)
        valid: mutable bool = accepted and list.commands.count > 100.usize()
        target: mutable f64 = 0.0
        while session.phase == SafecrackerGame::PLAYING |session, target|:
            port: i64 = Safecracker::pilot(&session.run)
            if port >= 0:
                _ = SafecrackerGame::agent_event(&session, target, port) can Global{Read,Write}
            target <- target + 1.0 / 60.0
            _ = SafecrackerGame::agent_event(&session, target, -1) can Global{Read,Write}
        valid <- valid and session.run.result == Safecracker::PASSED and session.run.notes.count > 0.usize()
        _ = SafecrackerGame::agent_event(&session, target + 1.0 / 60.0, -1) can Global{Read,Write}
        valid <- valid and session.phase == SafecrackerGame::DONE
        SafecrackerGame::close(&session) can Global{Read,Write}
        return valid and session.phase == SafecrackerGame::READY

def main() -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic, Console.Write:
        return 1.i32() if not alarms() or not (session_check() can Global{Read,Write})
        rungs: i64[13] = [-1, 1, 4, 7, 9, 10, 12, 13, 16, 19, 20, 25, 36]
        for rung in rungs:
            for seed in -1..<4 |rung|:
                emit(rung, seed)
        return 0.i32()
