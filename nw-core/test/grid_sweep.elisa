# Differential sweep for src/grid.elisa against neural_workshop/grid.py.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "../src/board.elisa"
include "../src/grid.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            index: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                index <- 22
                buf[22] <- 48.u8()
            else:
                negative: bool = n < 0
                while n != 0 |buf, index, n|:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    index <- index - 1
                    buf[index.usize()] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    index <- index - 1
                    buf[index.usize()] <- 45.u8()
            printr((&buf[index.usize()]).cast[cstr])

def emit(value: i64):
    can Console.Write, Abort.Panic:
        printr("|")
        print_i64(value)

def emit_point(point: Grid::Point):
    can Console.Write, Abort.Panic:
        emit(point.x)
        emit(point.y)

def emit_ids(tag: cstr, ids: darray[i64]):
    can Console.Write, Abort.Panic:
        printr(tag)
        for id in ids |ids|:
            emit(id)
        print("")

def make_cfg(spec: i64) -> Grid::Config:
    return Grid::Config{
        size: 1 + spec % 9,
        size_min: (spec % 5) - 1,
        size_max: 2 + spec % 8,
        include_center: spec % 2 == 1,
        grid_3d: spec % 4 == 3,
        cubes: (spec % 9) - 2,
        active_cells: 0 if spec % 3 != 0 else (spec % 11),
        legacy_cell_count: 0 if spec % 5 != 0 else (2 + spec % 7)}

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|kind|values")
        region work(64 * 1024 * 1024)
        in work:
            for spec in 0..<32:
                cfg: Grid::Config = make_cfg(spec)
                field: Grid::Field = Grid::Field{size: (640 + spec * 17).f64(),
                                                  center_x: 456.0 + (spec % 5).f64() / 2.0,
                                                  center_y: 342.0 + (spec % 7).f64() / 2.0}
                bounds: Grid::Bounds = Grid::current_grid_bounds(cfg)
                printr("scalar")
                emit(spec)
                emit(bounds.low)
                emit(bounds.high)
                emit(Grid::current_grid_size(cfg))
                emit(1 if Grid::current_include_center(cfg) else 0)
                emit(1 if Grid::current_grid_3d(cfg) else 0)
                emit(Grid::current_3d_cube_count(cfg))
                emit(Grid::current_3d_palette_size())
                emit(Grid::current_3d_color_count(cfg))
                emit(Grid::current_cell_count(cfg))
                emit(Grid::current_cell_px(cfg, field).i64())
                emit(Grid::current_active_cell_limit(cfg))
                print("")

                count: i64 = 1 + spec % 7
                faces: darray[i64] = Grid::decode_3d_pattern(spec - 4, count)
                emit_ids("faces", faces)
                colors: darray[i64] = Grid::decode_3d_colors(spec - 4, count)
                emit_ids("colors", colors)
                active: darray[i64] = Grid::current_active_position_ids(cfg)
                emit_ids("active", active)

                for position in [-2, 0, 1, 2, 8, 9, 25, 64] |cfg, field|:
                    centre: Grid::Point = Grid::position_pixel_center(cfg, field, position)
                    printr("centre")
                    emit(spec)
                    emit(position)
                    emit_point(centre)
                    print("")

                node: Grid::Point = Grid::position_3d_node_px(field,
                    (spec % 8 - 2).f64(), (spec % 7).f64(),
                    (spec % 11).f64(), 5 + spec % 4)
                printr("node")
                emit(spec)
                emit_point(node)
                print("")
        destroy work
        return 0
