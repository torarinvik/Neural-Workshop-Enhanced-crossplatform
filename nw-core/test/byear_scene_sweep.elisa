include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_byear.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# The keyboard By Ear draws, for byear_scene_diff.py, in frames of 1/60 s:
# while the tune plays; the autopilot a moment after its second key, the
# key still blue; the autopilot's try judged; a wrong key judged, red; and
# a shifted tune just after it plays, its first key gold. Then which key a
# click plays at points across the keyboard, and the options notes.

def emit(rung: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        session: mutable ByEarGame::Session = ByEarGame::initialize(rung, 1, true, 17)
        _ = ByEarGame::start(&session, 0.0)
        after: mutable i64 = -1
        frame: mutable i64 = 1
        while frame <= 7200 and session.phase == ByEarGame::PLAYING |session, mode, after, frame|:
            break if mode == 0 and frame > 30
            break if after >= 0 and frame - after > 6
            run: ByEar::Run& = &session.run
            key: mutable i64 = ByEar::pilot(run)
            if mode == 3 and key >= 0 and run.done == 1:
                want: i64 = ByEar::mask(run.tune.want[1])
                key <- 0 if (want & 1) == 0 else 12
            if key >= 0 and (mode == 1 or mode == 2 or mode == 3):
                _ = ByEarGame::input(&session, key) can Global{Read,Write}
            _ = ByEarGame::advance(&session, frame.f64() / 60.0) can Global{Read,Write}
            if after < 0:
                if (mode == 1 and session.run.pressed.count.i64() >= 2) or (mode == 4 and not ByEar::listening(&session.run)):
                    after <- frame
            frame <- frame + 1
        _ = printf("frame %lld %lld %lld\n", rung, mode, session.run.result)
        caption: mutable dstr = []
        SceneByEar::verdict_text(&session.run, &caption)
        _ = printf("verdict ")
        for char in caption:
            _ = printf("%c", char.i32())
        _ = printf("\n")
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneByEar::view(&list, &session.run)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")
        if mode == 0:
            _ = printf("hits")
            for i in 0..<61 |session|:
                for j in 0..<25 |session, i|:
                    x: f64 = 100.0 + i.f64() * 12.0
                    y: f64 = 100.0 + j.f64() * 16.0
                    _ = printf(" %lld", SceneByEar::hit(&session.run, x, y))
            _ = printf("\n")
        ByEarGame::close(&session)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneByEar::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 2, 4, 7, 10, 13, 16]:
            for mode in 0..<5 |rung|:
                region scratch(33554432):
                    in scratch:
                        emit(rung, mode)
        return 0.i32()
