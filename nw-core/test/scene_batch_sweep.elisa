# Smoke/differential driver for the assembled workshop batch.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/board.elisa"
include "../src/grid.elisa"
include "../src/gamemode.elisa"
include "../src/decimal.elisa"
include "../src/nback.elisa"
include "../src/session.elisa"
include "../src/session_app.elisa"
include "../src/display.elisa"
include "../src/scene_field.elisa"
include "../src/scene_hud.elisa"
include "../src/hudtext.elisa"
include "../src/readouttext.elisa"
include "../src/trialuitext.elisa"
include "../src/scene_readouts.elisa"
include "../src/scene_trialui.elisa"
include "../src/scene_title.elisa"
include "../src/scene_batch.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|case|started|black|mode|trial|commands")
        region work(256 * 1024 * 1024)
        in work:
            case: mutable i64 = 0
            for started in [0, 1] |case|:
                for black in [0, 1] |case, started|:
                    for mode in [2, 7, 21, 258] |case, started, black|:
                        trial: i64 = 1 + case % 7
                        list: mutable Display::DisplayList = Display::DisplayList()
                        SceneBatch::render_batch_frame(&list, trial, 2, 7, mode,
                                           black == 1, started == 1,
                                           case % 5 == 0, case % 4 == 0,
                                           mode == 258, case % 3 == 0,
                                           true, case % 2 == 0, case % 3 == 1,
                                           case % 6, case % 4 - 1, case % 4)
                        printr("case|")
                        print_i64(case)
                        printr("|")
                        print_i64(started)
                        printr("|")
                        print_i64(black)
                        printr("|")
                        print_i64(mode)
                        printr("|")
                        print_i64(trial)
                        printr("|")
                        print_i64(list.commands.count.i64())
                        print("")
                        emit_frame(&list)
                        print("end")
                        case <- case + 1
        destroy work
        return 0
