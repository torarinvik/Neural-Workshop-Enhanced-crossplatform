include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/cipher_abyss_mind.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def print_rules(program: darray[CipherLang::Node]&, entries: darray[i64]&):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        _ = printf("count %lld\n", entries.count.i64())
        for entry in entries:
            region row(4096):
                in row:
                    code: mutable dstr = []
                    CipherLang::write_code(&code, program, entry)
                    _ = printf("%lld ", CipherLang::size(program, entry))
                    for byte in code:
                        _ = printf("%c", byte.i32())
                    _ = printf("\n")

def print_row(row: darray[i64]&):
    can Console.Write:
        _ = printf(" %lld", row.count.i64())
        for value in row:
            _ = printf(" %lld", value)

def solve(program: darray[CipherLang::Node]&, rules: CipherLang::Rules&, level: CipherAbyss::Grade):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        target: i64 = rules.truths[(rules.truths.count / 2.usize())]
        reference: mutable CipherLang::Mind = CipherLang::mind(level, &rules.hypotheses, 37)
        state: mutable CipherLang::State = zeroed
        log: mutable darray[CipherLang::Sample] = []
        for i in 0..<level.budget |program, reference, state, log, target, level|:
            given: darray[i64] = CipherLang::experiment(program, &reference)
            break if given.count == 0.usize()
            result: darray[i64] = CipherLang::run(program, target, &given, level.symbols, &state)
            state <- CipherLang::advance(program, target, &state, &given, &result)
            log.push(CipherLang::Sample{given: given, result: result})
            CipherLang::update(program, &reference, &log)
            _ = printf("experiment %lld", reference.alive.count.i64())
            print_row(&given)
            print_row(&result)
            _ = printf("\n")
        _ = printf("after %llu\n", py_getrandbits(&reference.draw, 32))
        earlier: i64 = CipherAbyss::max(0, reference.snapshots.count.i64() - 3)
        print_rules(program, &reference.snapshots[earlier.usize()].entries)
        CipherLang::begin_test(&reference)
        state <- zeroed
        for i in 0..<3 |program, reference, state, target, level|:
            given: darray[i64] = [(i + 1) % level.symbols, i % level.symbols, i % level.symbols, 0]
            guess: darray[i64] = CipherLang::answer(program, &reference, &given)
            result: darray[i64] = CipherLang::run(program, target, &given, level.symbols, &state)
            state <- CipherLang::advance(program, target, &state, &given, &result)
            CipherLang::tested_on(program, &reference, &given, &result)
            _ = printf("answer %lld %lld", reference.testing.count.i64(), reference.split)
            print_row(&guess)
            print_row(&result)
            _ = printf("\n")

def sweep(rung: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        level: CipherAbyss::Grade = CipherAbyss::grade(rung)
        _ = printf("rung %lld\n", rung)
        region raw(1048576):
            in raw:
                program: mutable darray[CipherLang::Node] = []
                base: CipherLang::Rules = CipherLang::open_rules(&program, level) if level.stage == 11 else CipherLang::raw(&program, level)
                print_rules(&program, &base.hypotheses)
                print_rules(&program, &base.truths)
        region cooked(1048576):
            in cooked:
                program: mutable darray[CipherLang::Node] = []
                rules: CipherLang::Rules = CipherLang::families(&program, level)
                print_rules(&program, &rules.hypotheses)
                print_rules(&program, &rules.truths)
                if rung == 1 or rung == 4 or rung == 13 or rung == 22 or rung == 40:
                    looks: darray[CipherLang::RivalSet] = CipherLang::one_look(&program, &rules, level)
                    for outcome in looks:
                        print_rules(&program, &outcome.entries)
                    solve(&program, &rules, level)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in [1, 2, 3, 4, 5, 7, 8, 9, 10, 13, 14, 16, 18, 19, 20, 21,
                     22, 23, 25, 26, 28, 30, 35, 40, 52, 100, 180]:
            sweep(rung)
        return 0.i32()
