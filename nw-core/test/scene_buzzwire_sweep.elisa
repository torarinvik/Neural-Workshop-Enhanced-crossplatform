# Differential sweep driver for src/scene_buzzwire.elisa.
# See scene_buzzwire_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pymath.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_buzzwire.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|phase|black|flying|trial|total_trials|along|left|buzzes|touches|show_meter|used|tall|verdict")
        region w(256 * 1024 * 1024)
        in w:
            for spec in 0..<34:
                phase: i64 = spec % 4
                black: bool = spec % 7 == 1
                flying: bool = spec % 11 != 10
                along: i64 = spec * 3 % 101
                left: i64 = spec % 29
                buzzes: i64 = spec % 5
                touches: i64 = 3 + spec % 3
                show_meter: bool = spec % 3 != 2
                # Every cell of the gauge, and past both ends of it: the
                # share is clamped before it is rounded, so 1.4 fills the bar
                # rather than overrunning it.
                used: i64 = (spec % 17) - 2
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if flying else 0)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(along)
                emit_bar(left)
                emit_bar(buzzes)
                emit_bar(touches)
                emit_bar(1 if show_meter else 0)
                emit_bar(used)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneBuzzWire::Paint = SceneBuzzWire::paint_of(black, width, height, 2.0, 2.0)
                SceneBuzzWire::render(&list, &paint, phase, flying,
                                      1 + spec % 5, 5, along, left, buzzes,
                                      touches, show_meter,
                                      used.f64() / 12.0,
                                      sview("Steady now", 0, -1), verdict,
                                      sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
