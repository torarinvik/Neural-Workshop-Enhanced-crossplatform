# Printing a display list in framerec's canonical form.
#
# Shared by every scene sweep, because the alternative is forty-three copies of
# a formatter and forty-three places for one of them to print a field in the
# wrong order. A scene sweep includes this and writes only its own `main`.
#
# Numbers cross as the i32 their f32 bytes spell. The display list stores f32 --
# that IS the contract -- so comparing at f64 would compare a precision the
# format does not deliver, and rounding to a decimal would let a coordinate half
# a float out through. Bits are neither.
#
# Every drawing kind the format carries has a case below. A kind with no case
# prints its position and colour and nothing else, which looks like agreement
# for the first four cells and then stops -- that is how the Box case came to be
# missing, and it is why a scene that draws one is what found it rather than a
# reading of this file.
#
# NOTE: needs display included by the driver, and ints for Bytes.

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_bar(value: i64):
    can Console.Write, Abort.Panic:
        printr("|")
        print_i64(value)

# An f32 as the i32 its bytes spell, which is what the harness prints.
def emit_f32(value: f32):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            holder: f32[1] = [value]
            bits: mutable i32[1] = [0.i32()]
            memcpy((&bits[0]).cast[mutable void&], (&holder[0]).cast[void&], 4.usize())
            emit_bar(bits[0].i64())

def emit_color(color: u32):
    can Console.Write, Abort.Panic:
        printr("|")
        print_i64(((color >> 24.u32()) & 255.u32()).i64())
        printr(".")
        print_i64(((color >> 16.u32()) & 255.u32()).i64())
        printr(".")
        print_i64(((color >> 8.u32()) & 255.u32()).i64())
        printr(".")
        print_i64((color & 255.u32()).i64())

# The pool slice a TEXT command names, spelled the way Python's `repr` of a
# str spells it.
#
# The first version of this just wrapped the bytes in single quotes, on the
# grounds that the strings a screen draws are plain. Algebra's working is
# `'\n'.join(...)`, so it is not, and a raw newline split one command into two
# lines of output -- which showed up as a count mismatch rather than as a text
# difference, three scenes later than it was written.
#
# repr's rules, in order: the quote is a single quote unless the text contains
# one and no double quote; a backslash, the chosen quote, a newline, a return
# and a tab are escaped; everything else printable goes through as itself,
# non-ASCII included -- Python 3 does not escape an em dash.
def emit_text(list: mutable Display::DisplayList&, cmd: Display::DrawCmd&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        offset: i64 = cmd.ref.i64()
        length: i64 = (cmd.len & 16777215.u32()).i64()
        has_single: mutable bool = false
        has_double: mutable bool = false
        for index in 0..<length |list, offset, has_single, has_double|:
            byte: i64 = Bytes::at_ref(&list.pool, offset + index).i64()
            has_single <- true if byte == 39
            has_double <- true if byte == 34
        quote: i64 = 34 if has_single and not has_double else 39

        out: mutable dstr = []
        out.push(quote.u8())
        for index in 0..<length |list, offset, out, quote|:
            byte: i64 = Bytes::at_ref(&list.pool, offset + index).i64()
            if byte == 92 or byte == quote:
                out.push(92.u8())
                out.push(byte.u8())
            elif byte == 10:
                out.push(92.u8())
                out.push(110.u8())
            elif byte == 13:
                out.push(92.u8())
                out.push(114.u8())
            elif byte == 9:
                out.push(92.u8())
                out.push(116.u8())
            else:
                out.push(byte.u8())
        out.push(quote.u8())
        out.push(0.u8())
        printr("|")
        trusted Unsafe.PointerCast:
            printr((&out[0.usize()]).cast[cstr])

def emit_anchor(cmd: Display::DrawCmd&):
    can Console.Write, Abort.Panic:
        anchor: i64 = (cmd.len >> 24.u32()).i64()
        across: i64 = anchor % 3
        down: i64 = anchor / 3
        printr("|left" if across == 0 else "|center" if across == 1 else "|right")
        printr("|bottom" if down == 0 else "|center" if down == 1 else "|top")

# A multiline is a header plus `len` point records, and the recorder prints all
# of it on ONE line -- so the points are appended to the header's row here and
# the records themselves print nothing of their own.
def emit_int(value: f32):
    can Console.Write, Abort.Panic:
        printr("|")
        print_i64(value.f64().i64())

def emit_points(list: mutable Display::DisplayList&, after: i64, count: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        for step in 0..<count |list, after|:
            point: Display::DrawCmd = list.commands[(after + 1 + step).usize()]
            emit_f32(point.a)
            emit_f32(point.b)

def emit_command(list: mutable Display::DisplayList&, cmd: Display::DrawCmd&, at: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        kind: i64 = cmd.kind.i64()
        print_i64(kind)
        emit_f32(cmd.a)
        emit_f32(cmd.b)
        emit_color(cmd.color)
        if kind == Display::CMD_RECT.i64():
            emit_f32(cmd.c)
            emit_f32(cmd.d)
            # The anchor. Zero for every rectangle but a Lookout glyph's
            # square, and emitted for all of them so the one that is not zero
            # is compared rather than assumed.
            emit_f32(cmd.e)
            emit_f32(cmd.f)
        if kind == Display::CMD_BORDERED_RECT.i64():
            emit_f32(cmd.c)
            emit_f32(cmd.d)
            emit_f32(cmd.e)
            # The border's own colour, which the format keeps in `ref`. A
            # bordered rect with a transparent fill is drawn ENTIRELY by this,
            # so leaving it out would compare two commands that agree on
            # everything visible about them and nothing else.
            emit_color(cmd.ref)
        if kind == Display::CMD_BOX.i64():
            emit_f32(cmd.c)
            emit_f32(cmd.d)
            emit_f32(cmd.e)
        if kind == Display::CMD_CIRCLE.i64():
            emit_f32(cmd.c)
        if kind == Display::CMD_ARC.i64():
            emit_f32(cmd.c)
            emit_f32(cmd.e)
            emit_f32(cmd.f)
        if kind == Display::CMD_LINE.i64():
            emit_f32(cmd.c)
            emit_f32(cmd.d)
            emit_f32(cmd.e)
        if kind == Display::CMD_TRIANGLE.i64():
            emit_f32(cmd.c)
            emit_f32(cmd.d)
            emit_f32(cmd.e)
            emit_f32(cmd.f)
        if kind == Display::CMD_SPRITE.i64():
            # Scale and rotation as bits, then the image's own pixel size as
            # PLAIN INTEGERS -- which is how the recorder prints them, because
            # they are a fact about the file rather than a coordinate.
            emit_f32(cmd.c)
            emit_f32(cmd.e)
            emit_int(cmd.d)
            emit_int(cmd.f)
        if kind == Display::CMD_STAR.i64():
            emit_f32(cmd.c)
            emit_f32(cmd.d)
            emit_f32(cmd.e)
            emit_f32(cmd.f)
        if kind == Display::CMD_MULTILINE.i64():
            emit_f32(cmd.c)
            emit_points(list, at, cmd.len.i64())
        if kind == Display::CMD_TEXT.i64():
            emit_text(list, cmd)
            emit_f32(cmd.c)
            emit_anchor(cmd)
            printr("|bold" if cmd.d != 0.0.f32() else "|normal")
        print("")

# Whether a command puts anything on screen. Mirrors framerec's `_visible`,
# because a command that draws nothing is not part of a frame and the recorder
# on the other side cannot see one. A bordered rect is drawn by its border as
# well as its fill, so it needs both to be clear before it counts as absent.
def draws_something(cmd: Display::DrawCmd&) -> bool:
    fill: i64 = (cmd.color & 255.u32()).i64()
    return true if fill != 0
    return false if cmd.kind.i64() != Display::CMD_BORDERED_RECT.i64()
    return (cmd.ref & 255.u32()).i64() != 0

def emit_frame(list: mutable Display::DisplayList&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        for index in 0..<list.commands.count.i64() |list|:
            kind: i64 = list.commands[index.usize()].kind.i64()
            # A point record is printed by the header that owns it, never on a
            # row of its own.
            if kind != Display::CMD_POLY_POINT.i64() and draws_something(&list.commands[index.usize()]):
                emit_command(list, &list.commands[index.usize()], index)

