include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_sokobanlive.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        session: mutable SokobanLiveGame::Session = SokobanLiveGame::initialize(rung, 1, false, 17)
        if mode != 0:
            _ = SokobanLiveGame::input(&session, SokobanLiveGame::START, 0)
        now: mutable i64 = 0
        if mode >= 2:
            floor: SokobanLive::Warehouse = session.run.warehouse
            pilot: mutable SokobanLivePilot::Pilot = SokobanLivePilot::create(&floor)
            stop: i64 = 100 if mode == 2 else (4500 if mode == 3 else 200000)
            if mode == 2:
                _ = SokobanLiveGame::input(&session, 3, 0)
            while session.phase == SokobanLiveGame::PLAYING and now < stop |session, now, stop, mode, pilot|:
                if mode == 3 or mode == 6:
                    port: i64 = SokobanLivePilot::order(&pilot, &session.run)
                    if port >= 0:
                        _ = SokobanLiveGame::input(&session, port, now)
                next: i64 = now + 100
                _ = SokobanLiveGame::advance(&session, next, next.f64() / 1000.0 - now.f64() / 1000.0)
                now <- next
        if mode == 5:
            _ = SokobanLiveGame::advance(&session, session.deadline_ms, 0.0)
        _ = printf("frame %lld %lld %lld\n", rung, mode, 1 if dark else 0)
        _ = printf("hit %lld 0 0\n", SceneSokobanLive::hit(&session, 0.0, 0.0))
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneSokobanLive::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneSokobanLive::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 7, 16, 25]:
            for mode in 0..<7 |rung|:
                for dark in 0..<2 |rung, mode|:
                    region scratch(2097152):
                        in scratch:
                            emit(rung, mode, dark != 0)
        return 0.i32()
