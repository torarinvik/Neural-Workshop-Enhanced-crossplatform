include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/forms_fill.elisa"

# Forms' grades, deals, cards, the reference typist, par and seeded
# typing; forms_diff.py replays the same against forms.py.
extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def flag(value: bool) -> i64:
    return 1 if value else 0

def text(value: Forms::Text&):
    can Console.Write:
        if value.count == 0:
            _ = dprintf(1.i32(), "-")
        for i in 0..<value.count |value|:
            _ = dprintf(1.i32(), "%02x", value.bytes[i.usize()].i32())

def emit_deal(dealt: Forms::Deal&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        g: Forms::Grade = dealt.level
        _ = dprintf(1.i32(), "grade %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %.17g %.17g\n", g.rung, flag(g.dates),
            flag(g.digits), flag(g.choices), flag(g.checks), g.fields, g.pages, flag(g.letter), flag(g.decoys),
            flag(g.conditional), g.penalty, g.factor, g.slack)
        _ = dprintf(1.i32(), "fields %lld", dealt.field_count)
        for at in 0..<dealt.field_count |dealt|:
            key: i64 = dealt.fields[at.usize()].key
            _ = dprintf(1.i32(), " %lld %lld %lld ", key, dealt.fields[at.usize()].page, Forms::answer_index(&dealt.who, key))
            answer: Forms::Text = Forms::answer_text(&dealt.who, key)
            text(&answer)
        _ = dprintf(1.i32(), "\ncard %lld", dealt.card_count)
        for at in 0..<dealt.card_count |dealt|:
            _ = dprintf(1.i32(), " ")
            text(&dealt.card[at.usize()])
        _ = dprintf(1.i32(), "\n")

# Everything a key can change, and what a form and the verdict say of it.
def emit_form(form: FormsFill::Filling&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = dprintf(1.i32(), "form %lld %lld %lld %lld %lld %lld %lld %lld ", form.keys, form.bounced, form.page, form.focus,
            FormsFill::focused(form), flag(form.sent), form.lit, FormsFill::spent(form))
        text(&form.query)
        for at in 0..<form.dealt.field_count |form|:
            key: i64 = form.dealt.fields[at.usize()].key
            _ = dprintf(1.i32(), " %lld %lld %lld %lld %lld ", form.picks[key.usize()], flag(form.marked[key.usize()]),
                flag(FormsFill::showing(form, key)), flag(FormsFill::valid(form, key)), flag(FormsFill::right(form, key)))
            text(&form.values[key.usize()])
        _ = dprintf(1.i32(), "\n")

def next_state(state: i64) -> i64:
    return (state * 1103515245 + 12345) % 2147483648

# Seeded typing: the reference's key half the time, else any port, a
# capital letter, or a click on a field.
def play(dealt: Forms::Deal, seed: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        form: mutable FormsFill::Filling = FormsFill::start(dealt)
        rolling: mutable i64 = seed % 2147483648
        for _ in 0..<160 |form, rolling|:
            break if form.sent
            rolling <- next_state(rolling)
            draw: i64 = rolling / 128
            kind: i64 = draw % 8
            if kind < 4:
                key: i64 = FormsFill::reference_key(&form)
                _ = dprintf(1.i32(), "key %lld\n", key)
                FormsFill::press(&form, key)
            elif kind < 6:
                key: i64 = FormsFill::port_key((draw / 8) % FormsFill::PORTS)
                _ = dprintf(1.i32(), "key %lld\n", key)
                FormsFill::press(&form, key)
            elif kind == 6:
                key: i64 = 65 + (draw / 8) % 26
                _ = dprintf(1.i32(), "key %lld\n", key)
                FormsFill::press(&form, key)
            else:
                index: i64 = (draw / 8) % 5
                _ = dprintf(1.i32(), "click %lld\n", index)
                FormsFill::focus_on(&form, index)
            emit_form(&form)
        found: FormsFill::Mistakes = FormsFill::wrong(&form)
        count: i64 = found.count
        wrong: bool[11] = found.fields
        _ = dprintf(1.i32(), "wrong %lld", count)
        for key in 0..<Forms::KEY_COUNT |wrong|:
            if wrong[key.usize()]:
                _ = dprintf(1.i32(), " %lld", key)
        _ = dprintf(1.i32(), "\n")

def sample(rung: i64, seed: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = dprintf(1.i32(), "case %lld %lld\n", rung, seed)
        run: mutable MT19937 = zeroed
        mt_seed_int(&run, seed.u64())
        dealt: Forms::Deal = Forms::deal(rung, &run)
        _ = dprintf(1.i32(), "after %.17g\n", py_random(&run))
        emit_deal(&dealt)
        typist: mutable FormsFill::Filling = FormsFill::start(dealt)
        _ = dprintf(1.i32(), "reference")
        for _ in 0..<2000 |typist|:
            key: i64 = FormsFill::reference_key(&typist)
            break if key == Forms::NO_KEY
            _ = dprintf(1.i32(), " %lld", key)
            FormsFill::press(&typist, key)
        _ = dprintf(1.i32(), "\n")
        emit_form(&typist)
        _ = dprintf(1.i32(), "par %.17g\n", FormsFill::par(dealt))
        play(dealt, seed * 31 + rung)
        _ = dprintf(1.i32(), "end\n")

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region fixtures(268435456)
        in fixtures:
            for rung in 0..<31:
                for seed in [0, 2, 3, 11, 17, 42, 99, 2024] |rung|:
                    sample(rung, seed)
        destroy fixtures
        return 0.i32()
