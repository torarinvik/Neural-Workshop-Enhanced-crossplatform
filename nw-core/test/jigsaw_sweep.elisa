# Differential sweep driver for tasks/jigsaw.elisa. See jigsaw_diff.py for the
# reference side.
#
# `scramble` REDRAWS the identity away rather than patching it away, so on a
# 2x2 grid -- where a quarter of all shuffles are the identity -- it spends a
# different number of draws on different seeds, and every later number moves
# with it. Sides 2 and 3 are swept hardest for that reason.
#
# The solver is deterministic and deliberately imperfect: it follows cycles,
# which is the exact minimum, but wastes a swap on a fixed cadence, so the
# efficiency lands between the ladder's two thresholds and the adaptive grid
# moves in both directions.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/pymath.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/tasks/jigsaw.elisa"

# printr(i64) and int_to_string_scratch both trip a stage1 backend decline of
# store_* generics (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

def emit_scaled(value: f64):
    can Console.Write, Abort.Panic:
        emit_cell(py_round_half_even(value * 1000000.0))

def window_width(which: i64) -> f64:
    can Abort.Panic:
        return 912.0 if which == 0
        return 640.0 if which == 1
        return 1366.0 if which == 2
        return 1101.0

def window_height(which: i64) -> f64:
    can Abort.Panic:
        return 684.0 if which == 0
        return 480.0 if which == 1
        return 768.0 if which == 2
        return 617.0

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(64 * 1024 * 1024)
        in w:
            # --- clamping the grid ---------------------------------------
            for want in 0..<14:
                printr("clamp")
                emit_cell(want)
                emit_cell(Jigsaw::clamped(want))
                print("")

            # --- the shuffle, and the par it sets ------------------------
            order: mutable darray[i64] = Ints::zeros(Jigsaw::MOST_TILES)
            seen: mutable darray[i64] = Ints::zeros(Jigsaw::MOST_TILES)
            for side in 2..<11 |order, seen|:
                # Small grids get many seeds: a 2x2 lands on the identity a
                # quarter of the time, so the redraw fires often there.
                seeds: i64 = 40 if side < 4 else 6
                for seed in 1..<(seeds + 1) |order, seen, side|:
                    rng: mutable MT19937 = mt19937_new()
                    mt_seed_int(&rng, (side * 1000 + seed).u64())
                    Jigsaw::scramble(&order, side, &rng)
                    count: i64 = side * side
                    printr("scramble")
                    emit_cell(side)
                    emit_cell(seed)
                    emit_cell(Jigsaw::minimum_swaps(&order, count, &seen))
                    for at in 0..<count |order|:
                        emit_cell(Ints::at_ref(&order, at))
                    print("")

            # --- where the tiles are drawn -------------------------------
            for size in 0..<4:
                for preview_on in 0..<2 |size|:
                    preview: bool = preview_on == 1
                    width: f64 = window_width(size)
                    height: f64 = window_height(size)
                    view: Jigsaw::Canvas = Jigsaw::canvas(width, height)
                    board: Jigsaw::Square = Jigsaw::board_rect(width, height, preview)
                    lid: Jigsaw::Square = Jigsaw::preview_rect(width, height)
                    printr("layout")
                    emit_cell(size)
                    emit_cell(preview_on)
                    emit_scaled(view.left)
                    emit_scaled(view.bottom)
                    emit_scaled(view.width)
                    emit_scaled(view.height)
                    emit_scaled(board.left)
                    emit_scaled(board.bottom)
                    emit_scaled(board.size)
                    emit_scaled(lid.left)
                    emit_scaled(lid.bottom)
                    emit_scaled(lid.size)
                    print("")
                    for side in 2..<11 |width, height, preview, size, preview_on|:
                        printr("tiles")
                        emit_cell(size)
                        emit_cell(preview_on)
                        emit_cell(side)
                        for position in 0..<(side * side) |width, height, preview, side|:
                            box: Jigsaw::Rect = Jigsaw::tile_rect(width, height, preview, side, position)
                            emit_scaled(box.left)
                            emit_scaled(box.bottom)
                            emit_scaled(box.width)
                            emit_scaled(box.height)
                        print("")
                        printr("hit")
                        emit_cell(size)
                        emit_cell(preview_on)
                        emit_cell(side)
                        for px in 0..<13 |width, height, preview, side|:
                            for py in 0..<9 |width, height, preview, side, px|:
                                x: f64 = width * (px.f64() + 0.5) / 13.0
                                y: f64 = height * (py.f64() + 0.5) / 9.0
                                emit_cell(Jigsaw::tile_at(width, height, preview, side, x, y))
                        print("")

            # --- whole runs, solved ---------------------------------------
            for cfg in 0..<8:
                run: mutable Jigsaw::Run = Jigsaw::new_run()
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, (600 + cfg).u64())
                run.start_side <- 2 + (cfg % 4)
                run.total_puzzles <- 4
                run.adaptive <- (cfg % 2) == 0
                run.preview <- (cfg % 3) != 0
                Jigsaw::start_run(&run, 0.0, &rng)
                printr("start")
                emit_cell(cfg)
                emit_cell(run.phase)
                emit_cell(run.puzzle)
                emit_cell(run.trial_side)
                emit_cell(run.par)
                for at in 0..<(run.trial_side * run.trial_side) |run|:
                    emit_cell(Ints::at_ref(&run.order, at))
                print("")

                # The solver: follow the cycle from the first tile that is not
                # home, which is the exact minimum, but waste a swap on a fixed
                # cadence so the efficiency lands short of one.
                waste_every: i64 = 4 + cfg
                dt: f64 = 1.0 / 30.0
                now: mutable f64 = 0.0
                step: mutable i64 = 0
                while run.phase != Jigsaw::PHASE_DONE and step < 4000 |run, cfg, waste_every, now, step, dt, rng|:
                    now <- now + dt
                    Jigsaw::update(&run, now, &rng)
                    if run.phase == Jigsaw::PHASE_SOLVING:
                        count: i64 = run.trial_side * run.trial_side
                        if run.picked < 0:
                            first: mutable i64 = -1
                            for at in 0..<count |run, first|:
                                if first < 0 and Ints::at_ref(&run.order, at) != at:
                                    first <- at
                            Jigsaw::pick(&run, first, now)
                        else:
                            held: i64 = run.picked
                            target: mutable i64 = Ints::at_ref(&run.order, held)
                            if (step % waste_every) == 0:
                                target <- (held + 1 + step % count) % count
                            Jigsaw::pick(&run, target, now)
                    if (step % 3) == 0:
                        printr("step")
                        emit_cell(cfg)
                        emit_cell(step)
                        emit_cell(run.phase)
                        emit_cell(run.puzzle)
                        emit_cell(run.trial_side)
                        emit_cell(run.side)
                        emit_cell(run.par)
                        emit_cell(run.swaps)
                        emit_cell(run.picked)
                        emit_cell(run.verdict)
                        for at in 0..<(run.trial_side * run.trial_side) |run|:
                            emit_cell(Ints::at_ref(&run.order, at))
                        print("")
                    step <- step + 1

                tally: Jigsaw::Score = Jigsaw::score(&run)
                printr("score")
                emit_cell(cfg)
                emit_cell(step)
                emit_cell(tally.puzzles)
                emit_cell(tally.efficiency)
                emit_scaled(tally.mean_seconds)
                emit_cell(tally.best_side)
                for at in 0..<run.result_count |run|:
                    emit_cell(Ints::at_ref(&run.result_side, at))
                    emit_scaled(Floats::at_ref(&run.result_efficiency, at))
                    emit_scaled(Floats::at_ref(&run.result_took, at))
                print("")
        destroy w
        return 0
