# Builds a representative frame and writes the encoded display list to stdout
# as hex. display_diff.py decodes it with the reference Python decoder and
# checks every command round-trips.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../src/display.elisa"

def print_hex_byte(value: u8):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            digits: cstr = "0123456789abcdef"
            pair: u8[3] = zeroed
            pair[0] <- digits.cast[u8&][(value >> 4.u8()).usize()]
            pair[1] <- digits.cast[u8&][(value & 15.u8()).usize()]
            pair[2] <- 0
            printr((&pair[0]).cast[cstr])

def build_frame(list: mutable Display::DisplayList&):
    can Memory.Allocate, Abort.Panic:
        # A grid cell, a highlighted stimulus, and the trial chrome: roughly
        # what one n-back frame paints.
        Display::draw_rect(list, 0.0, 0.0, Display::REFERENCE_WIDTH, Display::REFERENCE_HEIGHT, Display::rgba(0, 0, 0, 255))
        Display::draw_box(list, 306.0, 114.0, 300.0, 300.0, Display::rgba(64, 64, 64, 255), 2.0)
        Display::draw_bordered_rect(list, 406.0, 214.0, 100.0, 100.0, Display::rgba(0, 128, 255, 255), Display::rgba(255, 255, 255, 255), 3.0)
        Display::draw_circle(list, 456.0, 264.0, 24.0, Display::rgba(255, 200, 0, 255))
        Display::draw_arc(list, 456.0, 264.0, 40.0, 0.0, 180.0, Display::rgba(128, 128, 128, 255))
        Display::draw_line(list, 0.0, 100.0, 912.0, 100.0, 1.5, Display::rgba(90, 90, 90, 255))
        Display::draw_triangle(list, 10.0, 10.0, 30.0, 10.0, 20.0, 30.0, Display::rgba(255, 0, 255, 255))
        Display::begin_polygon(list, 3, 100.0, 100.0, Display::rgba(10, 200, 10, 255))
        Display::polygon_point(list, 100.0, 100.0)
        Display::polygon_point(list, 140.0, 100.0)
        Display::polygon_point(list, 120.0, 140.0)
        Display::draw_sprite(list, 7.u32(), 700.0, 500.0, 1.5, 90.0, 64, 48, Display::rgba(255, 255, 255, 255))
        Display::draw_text(list, "Position match", 456.0, 60.0, 18.0, Display::rgba(255, 255, 255, 255), Display::ANCHOR_CENTER_CENTER)
        Display::draw_text(list, "N = 2", 20.0, 650.0, 14.0, Display::rgba(200, 200, 200, 255), Display::ANCHOR_LEFT_TOP)
        Display::emit_sound(list, 3.u32(), 0.8)
        Display::emit_verdict(list, 0)
        Display::emit_marker(list, "trial-end")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(4 * 1024 * 1024)
        in work:
            list: mutable Display::DisplayList = Display::DisplayList()
            build_frame(&list)
            encoded: darray[u8] = Display::encode_binary(&list)
            for byte in encoded:
                print_hex_byte(byte)
            print("")
        destroy work
        return 0
