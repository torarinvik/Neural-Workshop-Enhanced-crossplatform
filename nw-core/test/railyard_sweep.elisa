include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/railyard_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def sweep(rung: i64, seed: i64):
    can Abort.Panic, Console.Write:
        yard: RailYard::Yard = RailYard::deal_seed(rung, seed)
        level: RailYard::Grade = yard.level
        _ = printf("yard %lld %lld %lld %lld %.17g %.17g %.17g %.17g %lld %.17g\n", level.rung,
            level.depth, level.portals, level.trains, level.headway, level.speed, level.throw_seconds,
            level.express, level.forgive, yard.seconds)
        for i in 0..<yard.layout.node_count |yard|:
            node: RailYard::Node = yard.layout.nodes[i.usize()]
            _ = printf("node %lld %.17g %.17g %lld %lld\n", node.kind, node.point.x, node.point.y, node.index, node.out_count)
            for j in 0..<node.out_count |node|:
                _ = printf("out %lld\n", node.out[j.usize()])
        for i in 0..<yard.layout.segment_count |yard|:
            piece: RailYard::Segment = yard.layout.segments[i.usize()]
            _ = printf("segment %lld %lld %.17g %lld\n", piece.start, piece.end, piece.length, piece.point_count)
            for j in 0..<piece.point_count |piece|:
                point: RailYard::Point = piece.points[j.usize()]
                _ = printf("point %.17g %.17g\n", point.x, point.y)
        for i in 0..<level.trains |yard, level|:
            plan: RailYard::TrainPlan = yard.plans[i.usize()]
            _ = printf("plan %lld %lld %.17g %.17g %lld\n", plan.portal, plan.station, plan.due, plan.speed, plan.express.i64())
            path: RailYard::Route = RailYard::route(&yard.layout, level.depth, plan.portal, plan.station)
            for j in 0..<path.count |path|:
                _ = printf("route %lld %lld\n", path.segments[j.usize()], path.ways[j.usize()])

def play(rung: i64, seed: i64, policy: i64):
    can Abort.Panic, Console.Write:
        yard: RailYard::Yard = RailYard::deal_seed(rung, seed)
        run: mutable RailYard::Run = RailYard::initialize(&yard)
        switches: i64 = (1 << yard.level.depth) - 1
        for tick in 0..<5000 |run, yard, policy, switches|:
            break if run.result != RailYard::LIVE
            if policy == 1 and tick == 0:
                for portal in 0..<yard.level.portals |run|:
                    _ = RailYard::steer(&run, RailYard::MOST_SWITCHES + portal)
            elif policy == 2:
                for port in 0..<switches |run, tick|:
                    if (tick + 13 * port) % 47 == 0:
                        _ = RailYard::steer(&run, port)
                for portal in 0..<yard.level.portals |run, tick|:
                    if (tick + 31 * portal) % 171 == 0:
                        _ = RailYard::steer(&run, RailYard::MOST_SWITCHES + portal)
            elif policy == 3:
                for i in 0..<yard.level.trains |run, yard|:
                    train: RailYard::Train = run.trains[i.usize()]
                    if train.state == RailYard::RUNNING and train.segment == yard.layout.starts[0]:
                        if run.points[0].target != yard.plans[i.usize()].station:
                            _ = RailYard::steer(&run, 0)
                        break
            elif policy == 4:
                mask: i64 = RailYard::autopilot(&run)
                _ = printf("pilot %lld\n", mask)
                for port in 0..<RailYard::PORTS |mask, run|:
                    if (mask & (1 << port)) != 0:
                        _ = RailYard::steer(&run, port)
            RailYard::step(&run, 1.0 / 30.0)
            _ = printf("tick %.17g %lld %lld %lld %.17g %.17g %lld %lld\n", run.elapsed, run.result, run.right,
                run.delivered, run.crash.x, run.crash.y, run.first_train, run.second_train)
            for i in 0..<yard.level.trains |run|:
                train: RailYard::Train = run.trains[i.usize()]
                _ = printf("train %lld %lld %.17g %.17g\n", train.state, train.segment, train.distance, train.left_at)
            for i in 0..<switches |run|:
                points: RailYard::Points = run.points[i.usize()]
                _ = printf("switch %lld %lld %.17g\n", points.way, points.target, points.moving)
            for i in 0..<yard.level.portals |run|:
                _ = printf("signal %lld\n", run.signals[i.usize()].i64())

def summary(session: RailYardGame::Session&):
    can Console.Write:
        _ = printf("session %lld %lld %lld %lld %lld %lld %lld %.17g\n", session.phase, session.rung,
            session.trial, session.wins, session.best_rung, session.verdict, RailYardGame::info(session, 6),
            0.0 if session.phase == RailYardGame::DONE else session.yard.elapsed)

def lifecycle():
    can Abort.Panic, Console.Write:
        session: mutable RailYardGame::Session = RailYardGame::initialize(13, 2, true, 17)
        _ = RailYardGame::input(&session, RailYardGame::START, 0)
        summary(&session)
        now: mutable i64 = 0
        for trial in 0..<2 |session, now|:
            while session.phase == RailYardGame::PLAYING |session, now, trial|:
                if trial == 0:
                    mask: i64 = RailYard::autopilot(&session.yard)
                    for port in 0..<RailYard::PORTS |session, mask, now|:
                        if (mask & (1 << port)) != 0:
                            _ = RailYardGame::input(&session, port, now)
                next: i64 = now + (137 if (now / 11) % 3 == 0 else 11)
                _ = RailYardGame::advance(&session, next, next.f64() / 1000.0 - now.f64() / 1000.0)
                now <- next
                summary(&session)
            _ = RailYardGame::advance(&session, now + 2999, 2.999)
            summary(&session)
            now <- now + 3000
            _ = RailYardGame::advance(&session, now, 3.0)
            summary(&session)
        _ = RailYardGame::input(&session, RailYardGame::START, now + 1)
        summary(&session)

def main() -> i32:
    can Abort.Panic, Console.Write:
        for rung in 1..<36:
            for seed in [-17, 0, 17, 2026]:
                sweep(rung, seed)
        for rung in [1, 4, 7, 10, 13, 16, 20, 26, 35]:
            for policy in 0..<3:
                play(rung, 17, policy)
        play(1, 17, 3)
        for rung in [1, 7, 13, 16, 20, 26, 35]:
            play(rung, 17, 4)
        lifecycle()
        return 0.i32()
