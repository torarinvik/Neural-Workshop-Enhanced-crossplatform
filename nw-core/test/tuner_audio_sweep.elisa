include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/tuner_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def window(run: Tuner::Run&, audio: TunerAudio::Audio&, start: f64, end: f64):
    can Abort.Panic, Memory.Allocate, Console.Write:
        output: mutable u8[32768] = zeroed
        count: i64 = TunerAudio::mix(run, audio, start, end, &output[0], 32768)
        for i in 0..<count |output|:
            _ = printf("%02x", output[i.usize()].i32())
        _ = printf("\n")

def trial(rung: i64, seed: i64):
    can Abort.Panic, Memory.Allocate, Console.Write:
        empty: darray[Tuner::Clip] = []
        radio: Tuner::Radio = Tuner::deal(rung, seed, &empty)
        run: mutable Tuner::Run = Tuner::initialize(&radio, true)
        audio: TunerAudio::Audio = TunerAudio::prepare_tunes(&radio)
        while run.t < radio.listen + 2.0 |radio, run|:
            controls: i64 = 1 if run.t < radio.listen + 0.19 else 2
            if run.t >= radio.listen + 0.45 and run.plays.count == 1.usize():
                _ = Tuner::replay(&run)
            Tuner::step(&run, 1.0 / 60.0, controls)
        window(&run, &audio, 0.15, 0.37)
        window(&run, &audio, 0.7, 0.92)
        window(&run, &audio, radio.listen + 0.11, radio.listen + 0.40)
        window(&run, &audio, radio.listen + 0.43, radio.listen + 0.67)
        window(&run, &audio, radio.listen + 1.94, radio.listen + 2.19)

def recording(rate: i64, channels: i64):
    can Abort.Panic, Memory.Allocate, Console.Write:
        pcm: mutable darray[i16] = []
        for i in 0..<(4000 * channels) |pcm|:
            pcm.push(((i * 931) % 65536 - 32768).i16())
        wave: TunerAudio::Wave = TunerAudio::recorded_wave(&pcm, rate, channels, 0.017, 0.097)
        shifted: TunerAudio::Wave = TunerAudio::playback(&wave, 0.93, true)
        _ = printf("%lld %lld\n", wave.samples.count.i64(), shifted.samples.count.i64())
        for i in 0..<shifted.samples.count |shifted|:
            sample: f32 = shifted.samples[i]
            _ = printf("%.9g ", sample.f64())
        _ = printf("\n")

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Console.Write:
        rungs: i64[5] = [1, 10, 16, 24, 32]
        for rung in rungs:
            for seed in 7..<10 |rung|:
                region trial_memory(67108864):
                    in trial_memory:
                        trial(rung, seed)
        recording(44100, 2)
        recording(32000, 1)
        recording(16000, 2)
        return 0.i32()
