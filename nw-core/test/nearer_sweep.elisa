include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_nearer.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, seed: i64) -> bool:
    can Memory.Allocate, Abort.Panic, Console.Write:
        puzzle: Nearer::Puzzle = Nearer::deal(rung, seed)
        level: Nearer::Grade = puzzle.level
        return false if puzzle.count == 0
        _ = printf("%lld %lld %lld %lld %lld %lld %.17g %.17g %.17g\n", rung, seed, level.rung, puzzle.count,
            level.cue, 1 if level.order else 0, level.ratio, Nearer::eye_x(level, 0.6), Nearer::eye_x(level, 0.9))
        for i in 0..<puzzle.count |puzzle|:
            item: Nearer::Solid = puzzle.solids[i.usize()]
            _ = printf("%lld %lld %lld %.17g %.17g %.17g %.17g %.17g\n", item.kind, item.colour,
                puzzle.order[i.usize()], item.x, item.y, item.z, item.size, item.yaw)
        elapsed: f64 = 0.9
        picture: NearerView::Picture = NearerView::scene(&puzzle, elapsed)
        _ = printf("%lld %lld\n", picture.count, picture.visible_count)
        for i in 0..<picture.count |picture|:
            shape: NearerView::Shape& = &picture.shapes[i.usize()]
            _ = printf("%lld %llu %lld", shape.port, shape.colour.u64(), shape.count)
            for k in 0..<shape.count |shape|:
                point: RoomsView::Point = shape.points[k.usize()]
                _ = printf(" %.17g %.17g", point.x, point.y)
            _ = printf("\n")
        for i in 0..<picture.visible_count |picture|:
            port: i64 = picture.front[i.usize()]
            b: RoomsView::Bounds = picture.boxes[port.usize()]
            _ = printf("%lld %.17g %.17g %.17g %.17g %lld\n", port, b.left, b.bottom, b.right, b.top,
                NearerView::hit(&picture, (b.left + b.right) / 2.0, (b.bottom + b.top) / 2.0))
        return true

def main() -> i32:
    can Memory.Allocate, Abort.Panic, Console.Write:
        for rung in -1..<34:
            for seed in -16..<16 |rung|:
                return 1.i32() if not emit(rung, seed)
        return 2.i32() if not emit(20, -9223372036854775807 - 1)
        return 3.i32() if not emit(20, 9223372036854775807)
        run: mutable NearerGame::Run = NearerGame::initialize(20, 2, true, 17)
        return 4.i32() if SceneNearer::hit(&run, 456.0, 400.0) != NearerGame::START
        return 4.i32() if not NearerGame::agent_event(&run, 0.0, NearerGame::START)
        _ = printf("start %lld %lld\n", run.puzzle.seed, run.rung)
        return 5.i32() if not NearerGame::agent_event(&run, 0.6, NearerGame::UPDATE)
        return 6.i32() if NearerGame::elapsed(&run) != 0.6
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneNearer::render(&list, &run, false)
        return 17.i32() if Display::encode_binary(&list).count < 1000.usize()
        button: SceneNearer::Buttons = SceneNearer::buttons(run.puzzle.count)
        return 18.i32() if SceneNearer::hit(&run, button.left + 2.0, SceneNearer::BOTTOM + 2.0) != 0
        first: i64 = run.puzzle.order[0]
        return 7.i32() if not NearerGame::agent_event(&run, 0.6, first)
        return 8.i32() if NearerGame::agent_event(&run, 0.6, first) or run.phase != NearerGame::PLAYING
        for i in 1..<run.puzzle.count |run|:
            return 9.i32() if not NearerGame::agent_event(&run, 0.6, run.puzzle.order[i.usize()])
        return 10.i32() if run.phase != NearerGame::JUDGED or run.rung != 21 or not run.passed
        return 11.i32() if not NearerGame::agent_event(&run, 0.7, NearerGame::UPDATE) or run.phase != NearerGame::JUDGED
        return 12.i32() if not NearerGame::agent_event(&run, 0.8, NearerGame::UPDATE) or run.phase != NearerGame::PLAYING
        _ = printf("next %lld %lld\n", run.puzzle.seed, run.rung)
        return 13.i32() if not NearerGame::choose(&run, run.puzzle.order[1], 1.0)
        return 14.i32() if run.passed or run.rung != 20 or run.passed_count != 1
        return 15.i32() if NearerGame::advance(&run, 3.99) or not NearerGame::advance(&run, 4.0)
        return 16.i32() if run.phase != NearerGame::DONE or not run.has_verdict
        return 0.i32()
