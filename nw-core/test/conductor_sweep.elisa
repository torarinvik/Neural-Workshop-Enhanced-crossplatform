include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/conductor_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def pcm(run: Conductor::Run&, bank: DrShapeAudio::Bank&, start: f64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region audio(524288):
            in audio:
                bytes: mutable u8[8824] = zeroed
                used: i64 = ConductorAudio::render(run, bank, start, start + 0.1, &bytes[0], 8824)
                _ = printf("audio %.17g\n", start)
                for j in 0..<used |bytes|:
                    _ = printf("%02x", bytes[j.usize()].i32())
                _ = printf("\n")

def replay(rung: i64, seed: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(1048576):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                piece: Conductor::Piece = Conductor::deal(rung, &draw)
                _ = printf("piece %lld %lld %lld %lld %lld %u\n", mode, rung, seed, piece.seed, piece.key, py_getrandbits(&draw, 32).u32())
                for value in piece.times:
                    _ = printf("%.17g ", value)
                _ = printf("\n")
                for cue in piece.cues:
                    _ = printf("%lld %lld %lld\n", cue.beat, cue.kind, cue.section)
                run: mutable Conductor::Run = Conductor::begin(piece)
                while run.result == Conductor::LIVE |run, mode|:
                    port: i64 = Conductor::pilot(&run) if mode == 0 else (Conductor::SOFTER if mode == 2 else -1)
                    Conductor::act(&run, port)
                    Conductor::step(&run, 1.0 / 60.0)
                    flags: i64 = (1 if run.playing[0] else 0) + (2 if run.playing[1] else 0) + (4 if run.playing[2] else 0) + (8 if run.playing[3] else 0)
                    _ = printf("%lld %lld %.17g %.17g %d %.17g %.17g %.17g %lld %lld %lld %lld %lld %lld\n",
                        port, run.result, run.hand.x, run.hand.y, 1 if run.hand.down else 0, run.time, run.fall,
                        run.flash, run.loud, run.slips, run.next, run.judged, flags, Conductor::shown_beat(&run))
                _ = printf("notes %lld\n", run.notes.count.i64())
                for cue in run.notes:
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g %.17g\n",
                        cue.seed, cue.voice, cue.t, cue.dur, cue.freq, cue.gain, cue.pan)
                bank: DrShapeAudio::Bank = ConductorAudio::patches()
                pcm(&run, &bank, 0.0)
                pcm(&run, &bank, 2.0)
                pcm(&run, &bank, run.time - 0.04)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in 0..<81:
            level: Conductor::Grade = Conductor::grade(rung)
            _ = printf("grade %lld %lld %lld %.17g %.17g %lld %d %.17g %lld\n",
                level.rung, level.beats, level.cues, level.period, level.moment, level.numbers,
                1 if level.strict else 0, level.bend, level.slips)
        for rung in [1.i64(), 4.i64(), 7.i64(), 10.i64(), 13.i64(), 16.i64(), 20.i64(), 45.i64(), 60.i64()]:
            replay(rung, 17, 0)
        replay(4, 19, 1)
        replay(20, 19, 2)
        return 0
