include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_glove.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# The ballpark Glove draws, for glove_scene_diff.py, in frames of 1/60 s:
# at the start; the autopilot a moment after its first catch, the glove
# flashing green; no hands a moment after the first miss, flashing red; the
# autopilot's inning judged; the glove held up and right with a pitch in
# flight; and no hands to the end. Then the options notes.

def emit(rung: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        session: mutable GloveGame::Session = GloveGame::initialize(rung, 1, true, 17)
        _ = GloveGame::start(&session, 0.0)
        after: mutable i64 = -1
        frame: mutable i64 = 1
        while frame <= 7200 and session.phase == GloveGame::PLAYING |session, mode, after, frame|:
            break if mode == 0 or (after >= 0 and frame - after > 6)
            port: mutable i64 = -1
            if mode == 1 or mode == 3:
                port <- Glove::pilot(&session.run)
            elif mode == 4:
                port <- Glove::UP if frame <= 40 else Glove::RIGHT
            if port >= 0:
                _ = GloveGame::input(&session, port)
            _ = GloveGame::advance(&session, frame.f64() / 60.0) can Global{Read,Write}
            if after < 0:
                if (mode == 1 and session.run.caught > 0) or (mode == 2 and session.run.missed > 0):
                    after <- frame
                elif mode == 4 and Glove::ball(&session.run) >= 0 and frame > 60:
                    after <- frame + 10
            frame <- frame + 1
        _ = printf("frame %lld %lld %lld\n", rung, mode, session.run.result)
        caption: mutable dstr = []
        SceneGlove::verdict_text(&session.run, &caption)
        _ = printf("verdict ")
        for char in caption:
            _ = printf("%c", char.i32())
        _ = printf("\n")
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneGlove::view(&list, &session.run)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")
        GloveGame::close(&session)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneGlove::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 4, 10, 16, 30]:
            for mode in 0..<6 |rung|:
                region scratch(33554432):
                    in scratch:
                        emit(rung, mode)
        return 0.i32()
