# Differential sweep driver for src/scene_ravens.elisa.
# See scene_ravens_diff.py for the reference side.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/tasks/ravens.elisa"
include "../src/scene_ravens.elisa"
include "scene_emit.elisa"

const NOTES: cstr = "each row adds a shape   ·   the fill alternates   ·   the size grows left to right"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|phase|black|across|choices|answer|picked|hovered|explain|trial|total_trials|right|trial_level|tall|verdict")
        region w(256 * 1024 * 1024)
        in w:
            for spec in 0..<40:
                phase: i64 = spec % 5
                black: bool = spec % 7 == 1
                across: i64 = 2 + (spec / 5) % 3
                # Four candidates make the choice block SHORTER than the
                # grid, which is the arm that once pushed the grid up through
                # the title; eight make it taller.
                choices: i64 = 4 + (spec / 5) % 5
                answer: i64 = spec % choices
                # -1 is a real state: no answer given yet.
                picked: i64 = -1 if spec % 3 == 2 else (spec + 1) % choices
                hovered: i64 = -1 if spec % 4 == 3 else (spec + 2) % choices
                # The explanation takes its room OUT of the puzzle, so the
                # whole board moves when it is on.
                explain: bool = (spec / 5) % 2 == 0
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 3 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(across)
                emit_bar(choices)
                emit_bar(answer)
                emit_bar(picked)
                emit_bar(hovered)
                emit_bar(1 if explain else 0)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(spec % 4)
                emit_bar(spec % 6)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneRavens::RavensPaint = SceneRavens::paint_of(black, width, height, 2.0, 2.0)
                SceneRavens::render(&list, &paint, phase, true, across,
                                    choices, answer, picked, hovered, explain,
                                    0, 512, 1, 128, sview(NOTES, 0, -1),
                                    1 + spec % 5, 5, spec % 4, spec % 6,
                                    sview("Which one finishes it?", 0, -1),
                                    verdict,
                                    sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
