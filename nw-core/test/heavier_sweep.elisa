include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/heavier_game.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def flag(value: bool) -> i64:
    return 1 if value else 0

def replay(rung: i64, seed: i64, policy: i64):
    can Abort.Panic, Console.Write:
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, seed.u64())
        deal: Heavier::Deal = Heavier::deal(rung, &rng)
        _ = dprintf(1.i32(), "case %lld %lld %lld %lld\n", rung, seed, policy, flag(deal.valid))
        return if not deal.valid
        level: Heavier::Grade = deal.round.level
        _ = dprintf(1.i32(), "level %lld %lld %.17g %lld %.17g %.17g %lld %lld %lld %.17g\n",
            level.rung, level.crates, level.ratio, level.boards, level.seconds, level.weak,
            flag(level.floors), flag(level.slippery), flag(level.sizes), py_random(&rng))
        for k in 0..<level.boards |deal, level|:
            b: Heavier::Board = deal.round.boards[k.usize()]
            _ = dprintf(1.i32(), "board %lld %lld %.17g\n", flag(b.slippery), b.answer, b.force)
            for i in 0..<level.crates |b|:
                _ = dprintf(1.i32(), "crate %.17g %.17g %.17g\n", b.mass[i.usize()], b.grip[i.usize()], b.size[i.usize()])
        run: mutable Heavier::Run = Heavier::start(deal.round)
        pilot: mutable Heavier::Pilot = zeroed
        i: mutable i64 = 0
        while run.result == Heavier::LIVE |run, pilot, i, policy, level|:
            port: mutable i64 = -1
            if policy == 0:
                port <- Heavier::choose(&run, &pilot)
            elif policy == 1:
                port <- 0
            elif i == 0:
                port <- Heavier::FIRST_PICK + (Heavier::current(&run).answer + 1) % level.crates
            if port >= Heavier::FIRST_PICK:
                _ = Heavier::answer(&run, port - Heavier::FIRST_PICK)
            Heavier::step(&run, Heavier::STEP, port)
            _ = dprintf(1.i32(), "tick %lld %.17g %lld %.17g %lld %lld %lld\n", port, run.t, run.board, run.started,
                run.right, run.result, run.cue_count)
            for k in 0..<level.crates |run|:
                _ = dprintf(1.i32(), "motion %.17g %.17g %.17g\n", run.x[k.usize()], run.v[k.usize()], run.pushed[k.usize()])
            i <- i + 1
        for k in 0..<run.cue_count |run|:
            cue: Heavier::Cue = run.cues[k.usize()]
            _ = dprintf(1.i32(), "cue %.17g %.17g %.17g %lld %.17g\n", cue.t, cue.duration, cue.pitch, cue.voice, cue.gain)

def session_trace() -> i32:
    can Abort.Panic, Global.Read:
        session: mutable HeavierGame::Session = HeavierGame::initialize(1, 2, true, 17)
        return 1.i32() if not HeavierGame::start(&session, 0.0)
        return 2.i32() if HeavierGame::steer(&session, 3) or HeavierGame::steer(&session, 7)
        _ = HeavierGame::pointer(&session, 2)
        _ = HeavierGame::key(&session, 1, true)
        _ = HeavierGame::key(&session, 0, true)
        return 3.i32() if HeavierGame::held(&session) != 0
        _ = HeavierGame::key(&session, 0, false)
        return 4.i32() if HeavierGame::held(&session) != 1
        _ = HeavierGame::steer(&session, 0)
        _ = HeavierGame::advance(&session, 0.25)
        return 5.i32() if session.run.pushed[0] < 0.099 or session.run.pushed[1] != 0.0
        _ = HeavierGame::key(&session, 1, false)
        _ = HeavierGame::advance(&session, 0.35)
        return 6.i32() if session.run.pushed[2] < 0.099
        _ = HeavierGame::clear_controls(&session)
        return 7.i32() if HeavierGame::held(&session) != -1
        for _ in 0..<5 |session|:
            _ = HeavierGame::steer(&session, Heavier::FIRST_PICK + Heavier::current(&session.run).answer)
        _ = HeavierGame::advance(&session, 1.0)
        return 8.i32() if session.phase != HeavierGame::JUDGED or session.rung != 2 or session.wins != 1
        return 9.i32() if HeavierGame::advance(&session, 3.49)
        _ = HeavierGame::advance(&session, 3.5)
        return 10.i32() if session.phase != HeavierGame::PLAYING or session.trial != 2
        _ = HeavierGame::steer(&session, Heavier::FIRST_PICK + (Heavier::current(&session.run).answer + 1) % 3)
        _ = HeavierGame::advance(&session, 3.5)
        return 11.i32() if session.phase != HeavierGame::JUDGED or session.rung != 1
        _ = HeavierGame::agent_event(&session, 3.5, HeavierGame::NEUTRAL)
        return 12.i32() if session.phase != HeavierGame::DONE or session.best_rung != 1
        return 13.i32() if not HeavierGame::reconfigure(&session, 7, 1, false)
        return 14.i32() if not HeavierGame::start(&session, 3.5) or session.trial != 1 or session.rung != 7
        return 0.i32()

def main() -> i32:
    can Abort.Panic, Console.Write, Global.Read:
        status: i32 = session_trace()
        if status != 0.i32():
            _ = dprintf(2.i32(), "Heavier session assertion %d\n", status)
            return status
        for rung in [-1, 2, 3, 4, 6, 7, 9, 10, 12, 13, 16, 25, 30, 90]:
            for seed in [0, 17, 107] |rung|:
                replay(rung, seed, 0)
        replay(1, 17, 1)
        replay(7, 17, 2)
        return 0.i32()
