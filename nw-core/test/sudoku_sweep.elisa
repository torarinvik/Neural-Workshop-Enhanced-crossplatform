# Differential sweep driver for tasks/sudoku.elisa. See sudoku_diff.py for the
# reference side: the same rungs and seeds run through the real
# neural_workshop/sudoku.py.
#
# `generate` is the whole module in one call -- it fills a grid (shuffled
# depth-first), digs it out (shuffled, and every blank checked by a search),
# and rates the result through all six techniques. So a divergence anywhere,
# in the draw order or in a technique, shows up as a different puzzle rather
# than as a single wrong number, and the sweep prints the WHOLE grid so the
# harness can say which cell first differs.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/sudoku.elisa"

# printr(i64) and int_to_string_scratch both trip a stage1 backend decline of
# store_* generics (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)


def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(512 * 1024 * 1024)
        in w:
            # The ladder itself, so a wrong band shows up here rather than as a
            # puzzle that merely came out different.
            for level in 1..<14:
                g: Sudoku::Grade = Sudoku::grade_at(level)
                printr("grd")
                emit_cell(level)
                emit_cell(g.box)
                emit_cell(g.floor)
                emit_cell(g.ceiling)
                emit_cell(g.guesses)
                emit_cell(g.keep)
                emit_cell(g.tries)
                print("")

            # Rating and generation together. `attempts` is passed explicitly so
            # both sides do the same number of rejection rounds -- the rung's own
            # budget would make a sixteen take minutes on the reference side.
            for level in 1..<9:
                for seed in 1..<7:
                    made: Sudoku::Puzzle = Sudoku::generate(level, seed, 3)
                    printr("gen")
                    emit_cell(level)
                    emit_cell(seed)
                    emit_cell(made.box)
                    emit_cell(made.tier)
                    emit_cell(made.guesses)
                    blanks: mutable i64 = 0
                    for cell in 0..<made.cells |made, blanks|:
                        blanks <- blanks + 1 if Ints::at_ref(&made.givens, cell) == 0
                    emit_cell(blanks)
                    for cell in 0..<made.cells |made|:
                        emit_cell(Ints::at_ref(&made.givens, cell))
                    for cell in 0..<made.cells |made|:
                        emit_cell(Ints::at_ref(&made.solution, cell))
                    print("")

            # One sixteen, at one attempt, because a dug-out sixteen costs
            # nearly two seconds a deal on the reference side.
            for seed in 1..<3:
                big: Sudoku::Puzzle = Sudoku::generate(9, seed, 1)
                printr("big")
                emit_cell(seed)
                emit_cell(big.box)
                emit_cell(big.tier)
                emit_cell(big.guesses)
                for cell in 0..<big.cells |big|:
                    emit_cell(Ints::at_ref(&big.givens, cell))
                print("")
        destroy w
        return 0
