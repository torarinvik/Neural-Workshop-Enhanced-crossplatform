# Differential sweep driver for src/scene_maze.elisa.
# See scene_maze_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/pyset.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_maze.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|has_maze|wide|tall_cells|show_trail|doors|held|steps|trial|total_trials|tall|verdict")
            for spec in 0..<40:
                phase: i64 = spec % 4
                black: bool = spec % 7 == 1
                has_maze: bool = spec % 13 != 12
                wide: i64 = 7 + (spec / 4) % 4 * 4
                tall_cells: i64 = 5 + (spec / 4) % 3 * 4
                show_trail: bool = (spec / 4) % 2 == 0
                # Up to eight doors, so `colour % 6` wraps and two doors share
                # a colour -- which is the reference's own arithmetic.
                doors: i64 = (spec / 4) % 9
                held: i64 = spec % 32
                steps: i64 = spec % 23
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if has_maze else 0)
                emit_bar(wide)
                emit_bar(tall_cells)
                emit_bar(1 if show_trail else 0)
                emit_bar(doors)
                emit_bar(held)
                emit_bar(steps)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")

                cells: i64 = wide * tall_cells
                walls: mutable darray[i64] = []
                walked: mutable darray[i64] = []
                for cell in 0..<cells |walls, walked, wide, tall_cells, cells|:
                    x: i64 = cell % wide
                    y: i64 = cell / wide
                    if x == 0 or y == 0 or x == wide - 1 or y == tall_cells - 1 or (x % 2 == 0 and y % 2 == 0):
                        walls.push(cell)
                    elif cell % 3 == 1:
                        walked.push(cell)
                door_cells: mutable darray[i64] = []
                key_cells: mutable darray[i64] = []
                for one in 0..<doors |door_cells, key_cells, wide, cells|:
                    door_cells.push((wide + 1 + one * 5) % cells)
                    key_cells.push((wide + 3 + one * 7) % cells)
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneMaze::Paint = SceneMaze::paint_of(black, width, height, 2.0, 2.0)
                SceneMaze::render(&list, &paint, phase, has_maze, wide,
                                  tall_cells, &walls, &walked, show_trail,
                                  cells - wide - 2, &door_cells, &key_cells,
                                  held, wide + 1, steps, 1 + spec % 5, 5,
                                  sview("Rung 3 - two keys", 0, -1), verdict,
                                  sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
