# Differential sweep driver for src/scene_overrun.elisa.
# See scene_overrun_diff.py for the reference side.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pymath.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/textmetrics.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_overrun.elisa"
include "scene_emit.elisa"

const WORD_COUNT: i64 = 6

def word_of(which: i64) -> cstr:
    if which == 0:
        return "the"
    elif which == 1:
        return "quick"
    elif which == 2:
        return "brown"
    elif which == 3:
        return "fox"
    elif which == 4:
        return "jumps"
    return "over"

const MISSING: cstr = "Overrun is on its seed sentences -- for the whole word list run python -m neural_workshop.wordlist"

# A typed prefix with a mistake in it, so the blue and the vermillion arms
# are both drawn. Index 2 is the wrong letter for every word above.
const TYPED_COUNT: i64 = 4

def typed_of(which: i64) -> cstr:
    if which == 0:
        return ""
    elif which == 1:
        return "q"
    elif which == 2:
        return "quz"
    return "quzck"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|has_wave|words|cleared|typed|drift|lives|stocked|trial|total_waves|tall|verdict")
            for spec in 0..<40:
                phase: i64 = spec % 4
                black: bool = spec % 7 == 1
                has_wave: bool = spec % 13 != 12
                shown: i64 = 2 + (spec / 4) % (WORD_COUNT - 1)
                cleared: i64 = (spec / 4) % (shown + 1)
                typed: i64 = (spec / 4) % TYPED_COUNT
                drift: i64 = (spec / 4) % 7 * 3
                lives: i64 = (spec / 4) % 11 - 1
                stocked: bool = spec % 3 != 2
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if has_wave else 0)
                emit_bar(shown)
                emit_bar(cleared)
                emit_bar(typed)
                emit_bar(drift)
                emit_bar(lives)
                emit_bar(1 if stocked else 0)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                words: mutable darray[sview] = []
                starts: mutable darray[i64] = []
                length: mutable i64 = 0
                letters: mutable i64 = 0
                for one in 0..<shown |words, starts, length, letters|:
                    text: sview = sview(word_of(one), 0, -1)
                    words.push(text)
                    starts.push(length)
                    span: i64 = sview_len(text).i64()
                    length <- length + span + 1
                    letters <- letters + span
                # `' '.join(words)` has one fewer space than the loop added.
                length <- length - 1
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneOverrun::OverrunPaint = SceneOverrun::paint_of(black, width, height, 2.0, 2.0)
                SceneOverrun::render(&list, &paint, phase, has_wave, &words,
                                     &starts, length, letters,
                                     length.f64() / 6.5, cleared,
                                     sview(typed_of(typed), 0, -1),
                                     drift.f64() * 0.5, lives, stocked,
                                     sview(MISSING, 0, -1), 1 + spec % 5, 5,
                                     sview("Rung 3 - plain words", 0, -1),
                                     verdict,
                                     sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
