# Differential sweep driver for src/scene_mrtime.elisa.
# See scene_mrtime_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pymath.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/tasks/mrtime.elisa"
include "../src/scene_mrtime.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|phase|black|kind|rung|target|typed|trial|total_trials|right|tall|verdict")
        region w(256 * 1024 * 1024)
        in w:
            for spec in 0..<42:
                phase: i64 = spec % 7
                black: bool = spec % 5 == 1
                # All six outlines, and the turn is not a multiple of a right
                # angle so a square is drawn as a diamond rather than as a
                # square that happens to line up.
                kind: i64 = (spec / 7) % 6
                rung: i64 = 1 + (spec / 7) % 6
                # The quantity line steps at ten of the rung's own unit, so
                # the targets straddle it at every rung.
                target: i64 = 3 + spec % 23
                typed: i64 = spec % 3
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 5 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(kind)
                emit_bar(rung)
                emit_bar(target)
                emit_bar(typed)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(spec % 4)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneMrTime::Paint = SceneMrTime::paint_of(black, width, height, 2.0, 2.0)
                SceneMrTime::render(&list, &paint, phase, true, kind,
                                    0.18 + 0.05 * (spec % 9).f64(),
                                    0.22 + 0.04 * (spec % 7).f64(),
                                    0.10 + 0.011 * (spec % 10).f64(),
                                    0.37 + 0.29 * (spec % 11).f64(),
                                    rung, target.f64() / 7.0,
                                    sview("", 0, -1) if typed == 0 else (sview("1.5", 0, -1) if typed == 1 else sview("12.75", 0, -1)),
                                    1 + spec % 5, 5, spec % 4,
                                    sview("Time it", 0, -1), verdict,
                                    sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
