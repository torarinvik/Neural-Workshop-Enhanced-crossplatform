include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/drshape_deal.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit_grade(rung: i64):
    can Console.Write, Abort.Panic:
        g: DrShape::Grade = DrShape::grade(rung)
        _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %.17g %.17g %.17g %.17g\n",
            g.rung, g.candidates, g.turn, g.colours, g.instruments,
            g.keep.i64(), g.mirror.i64(), g.near.i64(), g.echo_key.i64(), g.echo_voice.i64(),
            g.floor.i64(), g.each_side.i64(), g.tumble.i64() + 2 * g.chorus.i64(), g.overload, g.wild, g.choose, g.tempo)
        for i in 0..<g.family_count |g|:
            _ = printf("%lld ", g.families[i.usize()])
        _ = printf("\n")
        for i in 0..<g.mode_count |g|:
            entry: DrShape::Mode = g.modes[i.usize()]
            _ = printf("%lld %.17g ", entry.kind, entry.weight)
        _ = printf("\n")
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, 17.u64())
        for i in 0..<64 |g, rng|:
            _ = printf("%lld ", DrShape::pick_mode(&g, &rng))
        _ = printf("\n")

def emit_program(program: DrShape::Program&):
    can Console.Write, Abort.Panic:
        _ = printf("%lld\n", program.count)
        for i in 0..<program.count |program|:
            op: DrShape::Op = program.ops[i.usize()]
            _ = printf("%lld %.17g\n", op.kind, op.value)
        path: DrShape::Path = DrShape::trace(program)
        _ = printf("%lld\n", path.count)
        for i in 0..<path.count |path|:
            stroke: DrShape::Segment = path.segments[i.usize()]
            _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g\n", stroke.a.x, stroke.a.y, stroke.a.z, stroke.b.x, stroke.b.y, stroke.b.z)

def emit_form(form: DrShape::Form&):
    can Console.Write, Abort.Panic:
        _ = printf("%lld %lld\n", form.path.count, form.face_count)
        for i in 0..<form.path.count |form|:
            stroke: DrShape::Segment = form.path.segments[i.usize()]
            _ = printf("%lld %.17g %.17g %.17g %.17g %.17g %.17g\n", form.tints[i.usize()],
                stroke.a.x, stroke.a.y, stroke.a.z, stroke.b.x, stroke.b.y, stroke.b.z)
        for i in 0..<form.face_count |form|:
            face: DrShape::Face& = &form.faces[i.usize()]
            _ = printf("%lld %lld\n", face.count, face.tint)
            for j in 0..<face.count |face|:
                point: RoomsView::Vec = face.vertices[j.usize()]
                _ = printf("%.17g %.17g %.17g\n", point.x, point.y, point.z)

def emit_matrix(m: DrShape::Matrix):
    can Console.Write:
        _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g\n",
            m.x.x, m.x.y, m.x.z, m.y.x, m.y.y, m.y.z, m.z.x, m.z.y, m.z.z)

def emit_match(rung: i64, mode: i64, seed: i64):
    can Console.Write, Abort.Panic, Memory.Allocate:
        level: DrShape::Grade = DrShape::grade(rung)
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, seed.u64())
        matched: DrShapeDeal::Match = DrShapeDeal::build_match(&level, mode, &rng)
        _ = printf("%lld %lld\n", matched.count, matched.answer)
        return if matched.count == 0
        emit_form(&matched.target)
        emit_matrix(matched.view)
        for i in 0..<matched.count |matched|:
            card: DrShapeDeal::Candidate& = &matched.cards[i.usize()]
            emit_form(&card.form)
            emit_matrix(card.view)
            _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g\n",
                card.spin.x, card.spin.y, card.spin.z, card.size, card.depth, card.side)
        sound: DrShapeDeal::Voice = DrShapeDeal::Voice{offset: 3, spare: -1, pan_shift: 0.3, pan_width: 0.8,
            gain: 0.55, transpose: -7, who: 2, distance: 5.3}
        song: DrShapeDeal::Song = DrShapeDeal::sing(&matched.target, matched.view, 0.4, level.tempo, sound)
        _ = printf("%lld %.17g\n", song.count, song.end)
        for i in 0..<song.count |song|:
            note: DrShapeDeal::Note = song.notes[i.usize()]
            _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %lld %lld %lld %.17g %.17g\n",
                note.t, note.dur, note.freq, note.pan, note.pan2, note.gain, note.gain2, note.bright,
                note.voice, note.seed, note.who, note.room, song.drawn_by[i.usize()])

def emit_layout(layout: DrShapeDeal::Layout&):
    can Console.Write, Abort.Panic:
        for i in 0..<3 |layout|:
            p: DrShapeDeal::Place = layout.places[i.usize()]
            _ = printf("%lld %.17g %.17g\n", p.thing, p.x, p.z)

def emit_platform(rung: i64, mode: i64, seed: i64):
    can Console.Write, Abort.Panic, Memory.Allocate:
        level: DrShape::Grade = DrShape::grade(rung)
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, seed.u64())
        scene: DrShapeDeal::Platform = DrShapeDeal::build_platform(&level, mode, &rng)
        _ = printf("%lld %lld\n", scene.count, scene.answer)
        return if scene.count == 0
        _ = printf("%lld %.17g\n", scene.thing_count, scene.look)
        emit_layout(&scene.target)
        camera: DrShapeDeal::Eye = DrShapeDeal::eye(scene.look)
        emit_matrix(camera.view)
        for i in 0..<scene.thing_count |scene, camera|:
            thing: DrShapeDeal::Thing& = &scene.things[i.usize()]
            emit_form(&thing.form)
            emit_matrix(thing.turn)
            lift: f64 = DrShapeDeal::ground_lift(thing)
            _ = printf("%.17g\n", lift)
            if i < 3:
                p: DrShapeDeal::Place = scene.target.places[i.usize()]
                v: RoomsView::Vec = DrShapeDeal::seen_from(camera, RoomsView::vec(p.x, lift, p.z))
                _ = printf("%.17g %.17g %.17g\n", v.x, v.y, v.z)
        for i in 0..<scene.count |scene|:
            c: DrShapeDeal::PlatformCard& = &scene.cards[i.usize()]
            _ = printf("%.17g\n", c.look)
            emit_layout(&c.layout)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate:
        for rung in -2..<55:
            emit_grade(rung)
        for family in 0..<6:
            for seed in 0..<40 |family|:
                rng: mutable MT19937 = zeroed
                mt_seed_int(&rng, seed.u64())
                program: mutable DrShape::Program = DrShape::make_program(family, &rng)
                emit_program(&program)
                DrShape::bend(&program, &rng)
                emit_program(&program)
        for family in 6..<10:
            for seed in 0..<40 |family|:
                rng: mutable MT19937 = zeroed
                mt_seed_int(&rng, seed.u64())
                params: mutable DrShape::Params = DrShape::draw_params(family, &rng)
                original: DrShape::Form = DrShape::build(family, &params)
                emit_form(&original)
                DrShape::nudge(family, &params, &rng)
                changed: mutable DrShape::Form = DrShape::build(family, &params)
                emit_form(&changed)
                DrShape::colour(&changed, 3, &rng, seed % 4 - 1)
                emit_form(&changed)
                DrShape::recolour(&changed, &rng)
                emit_form(&changed)
        rungs: i64[7] = [1, 4, 7, 11, 16, 19, 30]
        for row in 0..<7 |rungs|:
            for mode in 0..<4 |row, rungs|:
                for seed in 0..<4 |row, rungs, mode|:
                    emit_match(rungs[row.usize()], mode, seed)
        for rung in 20..<26:
            for mode in 4..<6 |rung|:
                for seed in 0..<6 |rung, mode|:
                    emit_platform(rung, mode, seed)
        return 0.i32()
