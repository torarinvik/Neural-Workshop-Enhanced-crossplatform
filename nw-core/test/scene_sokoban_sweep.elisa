# Differential sweep driver for src/scene_sokoban.elisa.
# See scene_sokoban_diff.py for the reference side.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/pyset.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_sokoban.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|has_level|wide|tall_cells|show_traps|pushes|trial|total_trials|tall|verdict")
            for spec in 0..<40:
                phase: i64 = spec % 5
                black: bool = spec % 7 == 1
                has_level: bool = spec % 13 != 12
                wide: i64 = 5 + (spec / 5) % 4 * 3
                tall_cells: i64 = 4 + (spec / 5) % 3 * 4
                show_traps: bool = (spec / 5) % 2 == 0
                pushes: i64 = spec % 17
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 or phase == 3 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if has_level else 0)
                emit_bar(wide)
                emit_bar(tall_cells)
                emit_bar(1 if show_traps else 0)
                emit_bar(pushes)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")

                # A deterministic room, mirrored cell for cell by the harness:
                # a wall border, goals and traps sprinkled by index, and boxes
                # PUSHED IN ONE ORDER so the frozenset can hand them back in
                # another.
                cells: i64 = wide * tall_cells
                walls: mutable darray[bool] = []
                goals: mutable darray[bool] = []
                traps: mutable darray[bool] = []
                boxes: mutable darray[i64] = []
                for cell in 0..<cells |walls, goals, traps, boxes, wide, tall_cells, cells|:
                    x: i64 = cell % wide
                    y: i64 = cell / wide
                    edge: bool = x == 0 or y == 0 or x == wide - 1 or y == tall_cells - 1
                    walls.push(edge)
                    goals.push(not edge and cell % 7 == 3)
                    traps.push(not edge and cell % 11 == 5)
                    if not edge and cell % 5 == 2:
                        boxes.push(cell)
                player: i64 = wide + 1
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneSokoban::SokobanPaint = SceneSokoban::paint_of(black, width, height, 2.0, 2.0)
                SceneSokoban::render(&list, &paint, phase, has_level, wide,
                                     tall_cells, &walls, &goals, &traps,
                                     &boxes, player, show_traps, pushes,
                                     1 + spec % 5, 5,
                                     sview("Rung 3 - one room", 0, -1),
                                     verdict,
                                     sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
