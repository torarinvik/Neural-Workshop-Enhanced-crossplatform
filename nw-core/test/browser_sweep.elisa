include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/browser_par.elisa"

# Browser's deals, every page of them, par and the reference ports, and
# seeded play; browser_diff.py replays the same against browser.py.
extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def flag(value: bool) -> i64:
    return 1 if value else 0

# Text as hex bytes, so spaces and punctuation survive the line format.
def text(value: dstr&):
    can Console.Write, Abort.Panic:
        for i in 0..<value.count.i64() |value|:
            _ = dprintf(1.i32(), "%02x", value[i.usize()].i32())
        _ = dprintf(1.i32(), "\n")

def emit_action(action: BrowserPages::Action&):
    can Console.Write:
        _ = dprintf(1.i32(), " %lld %lld %lld %lld %lld", action.kind, action.department, action.number, action.sort, action.index)

def emit_deal(dealt: Browser::Deal&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        g: Browser::Grade = dealt.level
        _ = dprintf(1.i32(), "grade %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %.17g\n", g.rung, g.departments,
            g.products, g.buys, flag(g.sorting), flag(g.stock), flag(g.shipping), flag(g.paged), flag(g.stale),
            g.criteria_count, g.slack)
        _ = dprintf(1.i32(), "deal %lld %lld %lld %lld\n", dealt.seed, dealt.shop, dealt.product_count, dealt.featured)
        for department in 0..<g.departments |dealt|:
            _ = dprintf(1.i32(), "kind %lld\n", dealt.kinds[department.usize()])
        for index in 0..<dealt.product_count |dealt|:
            p: Browser::Product = dealt.products[index.usize()]
            _ = dprintf(1.i32(), "product %lld %lld %lld %lld %.17g %lld %lld\n", p.department, p.price, p.listed,
                flag(p.stock), p.rating, p.shipping, index)
            spelled: mutable dstr = []
            BrowserText::name(&spelled, &p)
            text(&spelled)
        for goal in 0..<dealt.goal_count |dealt|:
            _ = dprintf(1.i32(), "goal %lld %lld %lld\n", dealt.goal_criteria[goal.usize()],
                dealt.goal_departments[goal.usize()], dealt.targets[goal.usize()])
        said: mutable dstr = []
        BrowserText::goal_words(&said, dealt)
        text(&said)

def emit_layout(dealt: Browser::Deal&, page: BrowserPages::Action&, cart: BrowserPages::Cart&, notice: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        shown: BrowserPages::Layout = BrowserPages::layout(dealt, page, cart, notice)
        _ = dprintf(1.i32(), "page %lld %.17g", shown.count, BrowserPages::page_height(&shown))
        emit_action(page)
        _ = dprintf(1.i32(), "\n")
        for index in 0..<shown.count |shown, dealt|:
            e: BrowserPages::Element = shown.elements[index.usize()]
            _ = dprintf(1.i32(), "element %.17g %.17g %.17g %.17g %lld", e.x, e.y, e.width, e.height, e.style)
            emit_action(&e.action)
            _ = dprintf(1.i32(), "\n")
            said: mutable dstr = []
            BrowserText::words(&said, dealt, e.words)
            text(&said)
        where: mutable dstr = []
        BrowserText::address(&where, dealt, page)
        text(&where)
        title: mutable dstr = []
        BrowserText::page_title(&title, dealt, page)
        text(&title)

def emit_pages(dealt: Browser::Deal&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        empty: BrowserPages::Cart = zeroed
        home: BrowserPages::Action = BrowserPages::action(BrowserPages::HOME)
        emit_layout(dealt, &home, &empty, 0)
        orders: i64 = 3 if dealt.level.sorting else 1
        for department in 0..<dealt.level.departments |dealt, empty, orders|:
            for sort in 0..<orders |dealt, empty, department|:
                for number in 0..<BrowserPages::pages_of(dealt, department) |dealt, empty, department, sort|:
                    listed: BrowserPages::Action = BrowserPages::list_page(department, number, sort)
                    emit_layout(dealt, &listed, &empty, 0)
        for index in 0..<dealt.product_count |dealt, empty|:
            if index % 5 == 0 or index == dealt.targets[0]:
                item: BrowserPages::Action = BrowserPages::indexed(BrowserPages::ITEM, index)
                emit_layout(dealt, &item, &empty, index % 3)
        cart_page: BrowserPages::Action = BrowserPages::action(BrowserPages::CART)
        emit_layout(dealt, &cart_page, &empty, 0)
        full: mutable BrowserPages::Cart = zeroed
        for goal in 0..<dealt.goal_count |full, dealt, cart_page|:
            full.items[full.count.usize()] <- dealt.targets[goal.usize()]
            full.count <- full.count + 1
        full.items[full.count.usize()] <- dealt.featured
        full.count <- full.count + 1
        emit_layout(dealt, &cart_page, &full, 0)

def emit_state(session: BrowserSession::Session&, port: i64, kind: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = dprintf(1.i32(), "step %lld %lld %.17g %.17g %.17g %lld %lld %lld %lld %lld %.17g", port, kind,
            session.scroll, session.pointer.x, session.pointer.y, session.clicks, session.notice,
            flag(session.checked_out), session.history.count, flag(BrowserSession::right(session)),
            BrowserSession::max_scroll(session))
        emit_action(&session.page)
        for slot in 0..<session.cart.count |session|:
            _ = dprintf(1.i32(), " %lld", session.cart.items[slot.usize()])
        _ = dprintf(1.i32(), "\n")

# A small generator both sides share, so the play is the same: 31 bits,
# so no product overflows.
def next_state(state: i64) -> i64:
    return (state * 1103515245 + 12345) % 2147483648

# Seeded play: pointer ports, clicks on whatever a page offers (sometimes
# off it), and Back, until checkout or the step budget runs out.
def play(dealt: Browser::Deal&, seed: i64, offset: f64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        session: mutable BrowserSession::Session = BrowserSession::start(dealt, offset)
        state: mutable i64 = seed % 2147483648
        for _ in 0..<160 |session, state|:
            state <- next_state(state)
            draw: i64 = state / 128
            pick: i64 = draw % 100
            port: mutable i64 = -1
            kind: mutable i64 = 0
            if pick < 35:
                port <- (draw / 100) % 15
                BrowserSession::steer(&session, port)
            elif pick < 90:
                kind <- 1
                shown: BrowserPages::Layout = BrowserSession::elements(&session)
                links: mutable darray[i64] = []
                for index in 0..<shown.count |shown, links, session|:
                    element: BrowserPages::Element = shown.elements[index.usize()]
                    links.push(index) if element.action.kind != BrowserPages::NONE and BrowserSession::visible(&session, &element)
                choice: i64 = (draw / 100) % (links.count.i64() + 4)
                if choice < links.count.i64():
                    element: BrowserPages::Element = shown.elements[links[choice.usize()].usize()]
                    spot: BrowserSession::Rectangle = BrowserSession::on_screen(&session, &element)
                    port <- links[choice.usize()]
                    _ = BrowserSession::click_at(&session, spot.x + spot.width / 2.0, spot.y + spot.height / 2.0)
                elif choice < links.count.i64() + 3:
                    rectangle: BrowserSession::Rectangle = BrowserSession::chrome_rectangle(&session, choice - links.count.i64())
                    port <- 100 + choice - links.count.i64()
                    _ = BrowserSession::click_at(&session, rectangle.x + 5.0, rectangle.y + 5.0)
                else:
                    port <- 200
                    _ = BrowserSession::click_at(&session, 500.0, 20.0)
            else:
                kind <- 2
                session.clicks <- session.clicks + 1
                BrowserSession::act(&session, BrowserPages::action(BrowserPages::BACK))
            emit_state(&session, port, kind)
            break if session.checked_out
        _ = dprintf(1.i32(), "played\n")

def sample(rung: i64, seed: i64, from_run: bool):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = dprintf(1.i32(), "case %lld %lld %lld\n", rung, seed, flag(from_run))
        dealt: mutable Browser::Deal = zeroed
        if from_run:
            run: mutable MT19937 = zeroed
            mt_seed_int(&run, seed.u64())
            dealt <- Browser::deal(rung, &run)
            _ = dprintf(1.i32(), "after %.17g\n", py_random(&run))
        else:
            dealt <- Browser::deal_seeded(Browser::grade(rung), seed)
        emit_deal(&dealt)
        best: BrowserPar::Path = BrowserPar::fewest(&dealt)
        _ = dprintf(1.i32(), "par %lld %lld %lld\n", best.count, BrowserPar::thorough(&dealt, best.count), BrowserPar::par(&dealt))
        for step in best.actions:
            _ = dprintf(1.i32(), "path")
            emit_action(&step)
            _ = dprintf(1.i32(), "\n")
        emit_pages(&dealt)
        start: BrowserSession::Session = BrowserSession::start(&dealt, 0.0)
        ports: darray[i64] = BrowserPar::reference_ports(&start)
        _ = dprintf(1.i32(), "reference %lld", ports.count.i64())
        for port in ports:
            _ = dprintf(1.i32(), " %lld", port)
        _ = dprintf(1.i32(), "\n")
        # The reference ports must buy the goal at par or under.
        replay: mutable BrowserSession::Session = BrowserSession::start(&dealt, 0.0)
        for port in ports |replay|:
            BrowserSession::steer(&replay, port)
        _ = dprintf(1.i32(), "replayed %lld %lld %lld\n", flag(replay.checked_out), flag(BrowserSession::right(&replay)), replay.clicks)
        play(&dealt, seed * 31 + rung, 0.0)
        play(&dealt, seed * 37 + rung + 1, 40.0) if rung % 4 == 0
        _ = dprintf(1.i32(), "end\n")

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region fixtures(268435456)
        in fixtures:
            for rung in 0..<31:
                for seed in [0, 17, 42, 99] |rung|:
                    sample(rung, seed, false)
            for rung in [1, 3, 6, 9, 12, 15, 18, 21, 25, 30, 40]:
                for seed in [5, 2024] |rung|:
                    sample(rung, seed, true)
        destroy fixtures
        return 0.i32()
