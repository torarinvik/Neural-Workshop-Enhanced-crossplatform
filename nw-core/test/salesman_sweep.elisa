# Differential sweep driver for tasks/salesman.elisa. See salesman_diff.py for
# the reference side.
#
# The scatter, the tour length and the Held-Karp optimum, all float output, so
# every number is emitted as a scaled integer.
#
# The scatter is the interesting one for the stream: it rejection-samples
# against a minimum separation and, when a layout will not fit, RELAXES the
# separation and starts a fresh layout WITHOUT rewinding -- so the draws that
# failed are spent and a divergence anywhere shows up as different cities.
# Counts up to twelve reach that relaxation.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/pymath.elisa"
include "../src/tasks/salesman.elisa"

# printr(i64) and int_to_string_scratch both trip a stage1 backend decline of
# store_* generics (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)


def emit_scaled(value: f64):
    can Console.Write, Abort.Panic:
        emit_cell(py_round_half_even(value * 1000000.0))

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            for count in 0..<22:
                printr("clamp")
                emit_cell(count)
                emit_cell(Salesman::clamped(count))
                print("")

            # Scatter and solve. Twelve cities is 4096 subsets and still quick
            # on the reference side; the ceiling of eighteen is the same code.
            for count in 5..<13:
                for seed in 1..<4:
                    rng: mutable MT19937 = mt19937_new()
                    mt_seed_int(&rng, (count * 100 + seed).u64())
                    cities: mutable Salesman::Cities = Salesman::new_cities(Salesman::MOST_CITIES)
                    Salesman::scatter(&cities, count, &rng)
                    printr("scatter")
                    emit_cell(count)
                    emit_cell(seed)
                    emit_cell(cities.count)
                    for at in 0..<cities.count |cities|:
                        emit_scaled(Floats::at_ref(&cities.x, at))
                        emit_scaled(Floats::at_ref(&cities.y, at))
                    print("")

                    best: Salesman::Tour = Salesman::optimal_tour(&cities, count)
                    printr("tour")
                    emit_cell(count)
                    emit_cell(seed)
                    emit_scaled(best.length)
                    for at in 0..<count |best|:
                        emit_cell(Ints::at_ref(&best.order, at))
                    print("")

                    # The identity tour, and the optimum measured back through
                    # tour_length -- which must agree with what Held-Karp said.
                    walk: mutable darray[i64] = Ints::zeros(Salesman::MOST_CITIES)
                    for at in 0..<count |walk|:
                        Ints::put(&walk, at, at)
                    printr("len")
                    emit_cell(count)
                    emit_cell(seed)
                    emit_scaled(Salesman::tour_length(&cities, &walk, count))
                    emit_scaled(Salesman::tour_length(&cities, &best.order, count))
                    print("")

            # The ladder, over the whole closeness range and both thresholds.
            for count in 4..<20:
                for hundredth in 0..<21:
                    close: f64 = hundredth.f64() * 0.05
                    printr("ladder")
                    emit_cell(count)
                    emit_cell(hundredth)
                    emit_cell(Salesman::next_count(count, close))
                    print("")
            printr("close")
            emit_scaled(Salesman::closeness(1.0, 0.0))
            emit_scaled(Salesman::closeness(2.0, 4.0))
            print("")
        destroy w
        return 0
