include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_beat.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def report(run: Beat::Run&):
    can Abort.Panic, Memory.Allocate, Console.Write:
        message: mutable dstr = []
        Beat::result_text(run, &message)
        _ = printf("%lld %lld %lld %lld ", run.hits, run.strays, run.result, run.tap_count)
        for i in 0..<message.count.i64() |message|:
            _ = printf("%c", message[i.usize()].i32())
        _ = printf("\n")

def emit(rung: i64, seed: i64):
    can Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast, Console.Write:
        song: Beat::Song = Beat::deal(rung, seed)
        _ = printf("%lld %lld %lld %lld %.17g %.17g\n", rung, seed, song.level.cycle, song.count, song.level.window, song.end)
        for i in 0..<song.count |song|:
            time: f64 = song.times[i.usize()]
            _ = printf("%.17g %lld %lld %lld\n", time, 1 if Beat::heard(&song, i) else 0,
                1 if Beat::curtain(&song, time - 0.01) else 0, 1 if Beat::curtain(&song, time) else 0)
        run: mutable Beat::Run = Beat::trial(song)
        while run.result == Beat::PENDING |run|:
            if Beat::pilot(&run):
                _ = Beat::tap(&run)
            Beat::step(&run, 1.0 / 60.0)
        report(&run)
        Beat::dispose(&run)
        run <- Beat::trial(song)
        for tick in 0..<2400 |run|:
            if tick % 7 == 0:
                _ = Beat::tap(&run)
            Beat::step(&run, 1.0 / 60.0)
        report(&run)
        Beat::dispose(&run)
        run <- Beat::trial(song)
        Beat::step(&run, song.end)
        report(&run)
        Beat::dispose(&run)

def session_check() -> bool:
    can Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
        game: mutable BeatGame::Session = BeatGame::initialize(16, 1, true, 17)
        return false if not BeatGame::start(&game, 0.0)
        time: mutable f64 = 0.0
        while game.phase == BeatGame::PLAYING |game, time|:
            if Beat::pilot(&game.run):
                _ = BeatGame::agent_event(&game, time, Beat::TAP)
            time <- time + 1.0 / 60.0
            _ = BeatGame::agent_event(&game, time, -1)
        good: bool = game.phase == BeatGame::JUDGED and game.passed_count == 1 and game.rung == 17
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneBeat::render(&list, &game, false)
        pcm: mutable u8[4096] = zeroed
        length: i64 = BeatGame::audio_window(&game, &pcm[0], 4096)
        completed: bool = BeatGame::agent_event(&game, time + 1.0 / 60.0, -1)
        return good and length == 4096 and completed and game.phase == BeatGame::DONE and game.run.taps == 0 and list.commands.count > 0.usize()

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast, Console.Write:
        return 1.i32() if not session_check()
        for rung in -1..<45:
            for seed in -3..<4 |rung|:
                emit(rung, seed)
        emit(31, -9223372036854775807 - 1)
        emit(31, 9223372036854775807)
        return 0.i32()
