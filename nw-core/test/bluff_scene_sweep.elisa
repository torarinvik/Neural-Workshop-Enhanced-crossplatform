include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_bluff.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        session: mutable BluffGame::Session = BluffGame::initialize(rung, 1, false, 17)
        if mode > 0:
            _ = BluffGame::input(&session, BluffGame::START, 0) can Global{Read,Write}
        if mode >= 2:
            turn: mutable i64 = 0
            while session.phase == BluffGame::PLAYING |session, mode, turn|:
                break if mode == 2 and not Bluff::opening(session.round.spot)
                break if mode == 3 and session.round.records.count >= 14.usize()
                _ = BluffGame::input(&session, turn % 2, turn) can Global{Read,Write}
                turn <- turn + 1
        if mode == 5:
            _ = BluffGame::advance(&session, session.deadline_ms) can Global{Read,Write}
        _ = printf("frame %lld %lld %lld\n", rung, mode, 1 if dark else 0)
        area: SceneHiddenRule::Rect = SceneBluff::table()
        for choice in 0..<2 |session, area|:
            box: SceneHiddenRule::Rect = SceneBluff::button(&area, choice)
            x: f64 = box.x + box.w / 2.0
            y: f64 = box.y + box.h / 2.0
            _ = printf("hit %lld %.14g %.14g\n", SceneBluff::hit(&session, x, y), x, y)
        _ = printf("hit %lld 0 0\n", SceneBluff::hit(&session, 0.0, 0.0))
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneBluff::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("style %u %lld\n", cmd.len >> 24.u32(), cmd.d.i64())
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")
        BluffGame::close(&session) can Global{Read,Write}

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        scores: f64[9] = [0.05, 0.15, 0.25, 0.35, 1.05, -1.05, 2.25, -2.25, -0.04]
        for score in scores:
            label: mutable dstr = []
            SceneBluff::points(&label, score)
            _ = printf("points ")
            for char in label:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 3, 5, 7, 10, 14, 18, 21, 25]:
            note: mutable dstr = []
            SceneBluff::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 14, 21]:
            for mode in 0..<6 |rung|:
                for dark in 0..<2 |rung, mode|:
                    region scratch(2097152):
                        in scratch:
                            emit(rung, mode, dark != 0) can Global{Read,Write}
        return 0.i32()
