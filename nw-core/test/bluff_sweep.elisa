include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/bluff_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def replay(deal: Bluff::Deal, policy: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        round: mutable Bluff::Match = Bluff::initialize(deal)
        model: mutable BluffReference::Model = BluffReference::initialize(deal.level.cards)
        move_count: mutable i64 = 0
        while not Bluff::over(&round) |round, model, move_count, deal, policy|:
            index: usize = round.records.count
            hand: Bluff::Hand = deal.hands[index]
            choice: mutable i64 = 0
            if policy == 1:
                choice <- move_count % 2
            elif policy == 2:
                choice <- 1 if hand.player * 2 >= deal.level.cards - 1 else 0
            elif policy == 3:
                choice <- BluffReference::reference_move(&model, &round)
            elif policy == 4:
                choice <- BluffReference::sound_move(&round)
            _ = printf("move %lld %lld %lld\n", index.i64(), round.spot, choice)
            _ = Bluff::act(&round, choice)
            move_count <- move_count + 1
            if round.records.count > index:
                record: Bluff::Record = round.records[index]
                BluffReference::saw(&model, record) if policy == 3
                _ = printf("record %lld %lld %lld %lld %.17g\n", record.spot, record.player_card, record.shown,
                    record.won, record.worth)
        _ = printf("score %lld %.17g\n", round.chips, Bluff::value(&round))
        for habit in round.habits |round|:
            _ = printf("habit %lld %lld %lld %lld %lld %lld\n",
                habit.kind, habit.bets, habit.bluffs, habit.shown, habit.folds, habit.faced)

def emit(rung: i64, rng: mutable MT19937&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        deal: Bluff::Deal = Bluff::deal(rung, rng)
        level: Bluff::Grade = deal.level
        _ = printf("round %lld %lld %lld %.17g %lld %lld %lld %lld\n", level.rung, level.cards, level.hands,
            level.allow, level.kind_count, deal.first_kind, deal.later_kind, deal.switch_at)
        for i in 0..<level.kind_count |level|:
            _ = printf("kind %lld\n", level.kinds[i.usize()])
        for hand in deal.hands |deal|:
            _ = printf("hand %lld %lld %lld %.17g %.17g\n",
                hand.player, hand.opponent, 1 if hand.player_first else 0, hand.coins[0], hand.coins[1])
        for policy in 0..<5 |deal|:
            replay(deal, policy)
        _ = printf("par %.17g\n", BluffReference::par(deal))

def controller():
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        session: mutable BluffGame::Session = BluffGame::initialize(18, 2, true, -17)
        now: mutable i64 = 0
        _ = BluffGame::input(&session, BluffGame::START, now) can Global{Read,Write}
        for trial in 0..<2 |session, now|:
            _ = printf("trial %lld %lld %.17g\n", session.rung, session.trial, session.par)
            model: mutable BluffReference::Model = BluffReference::initialize(session.round.dealt.level.cards)
            while session.phase == BluffGame::PLAYING |session, model, now, trial|:
                index: usize = session.round.records.count
                choice: i64 = BluffReference::reference_move(&model, &session.round) if trial == 0 else 0
                now <- now + 16
                _ = BluffGame::input(&session, choice, now) can Global{Read,Write}
                if session.round.records.count > index:
                    BluffReference::saw(&model, session.round.records[index])
            _ = printf("judged %lld %lld %.17g %lld %lld %lld\n", session.rung, session.wins,
                session.verdict_value, session.verdict_chips, session.verdict_first, session.verdict_later)
            early: bool = BluffGame::advance(&session, now + 2999) can Global{Read,Write}
            _ = printf("early %lld\n", 1 if early else 0)
            now <- now + 3000
            _ = BluffGame::advance(&session, now) can Global{Read,Write}
        _ = printf("done %lld %lld %lld %lld\n", session.phase, session.wins, session.best_rung, session.round.dealt.hands.count.i64())
        _ = BluffGame::input(&session, BluffGame::START, now + 1) can Global{Read,Write}
        _ = printf("restart %lld %lld %lld\n", session.rung, session.trial, session.wins)
        BluffGame::close(&session) can Global{Read,Write}

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        rungs: i64[15] = [0, 1, 2, 3, 5, 7, 9, 10, 13, 14, 17, 18, 20, 21, 30]
        for index in 0..<4 |rungs|:
            rng: mutable MT19937 = zeroed
            mt_seed_int(&rng, (17 + index * 421).u64())
            for rung in rungs |rng|:
                region scratch(1048576):
                    in scratch:
                        emit(rung, &rng)
        controller() can Global{Read,Write}
        return 0.i32()
