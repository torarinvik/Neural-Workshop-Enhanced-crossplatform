# Exact, source-seeded Numberology generation across small and high levels.
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_bigint.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/numberology.elisa"
include "../src/tasks/numberology_exact.elisa"

def emit_i64(value: i64):
    can Console.Write, Global.Read, Global.Write, Memory.Allocate, Abort.Panic:
        text: mutable dstr = []
        number: BigInt = bigint_from_i64(value)
        bigint_append_decimal(&text, &number)
        text.push(0.u8())
        trusted Unsafe.PointerCast:
            printr((&text[0]).cast[cstr])

def main() -> i64:
    can Console.Write, Global.Read, Global.Write, Memory.Allocate, Abort.Panic:
        for level in [1, 2, 3, 4, 5, 6, 7, 20, 40, 200, 1000, 3000, 10000]:
            for seed in [0, 1, 19, 97] |level|:
                puzzle: mutable NumberologyExact::NumberologyExactPuzzle = NumberologyExact::generate(level, seed)
                emit_i64(level)
                printr("|")
                emit_i64(seed)
                printr("|")
                emit_i64(puzzle.shown)
                printr("|")
                emit_i64(puzzle.rule_id)
                printr("|")
                emit_i64(puzzle.rule_a)
                printr("|")
                emit_i64(puzzle.rule_b)
                printr("|")
                emit_i64(puzzle.rule_c)
                printr("|")
                emit_i64(puzzle.complexity)
                printr("|")
                for at in 0..<puzzle.text.count.i64() |at, puzzle|:
                    if Bytes::at_ref(&puzzle.text, at) == 10.u8(): puzzle.text[at.usize()] <- 44.u8()
                puzzle.text.push(0.u8())
                trusted Unsafe.PointerCast:
                    printr((&puzzle.text[0]).cast[cstr])
                print("")
        return 0
