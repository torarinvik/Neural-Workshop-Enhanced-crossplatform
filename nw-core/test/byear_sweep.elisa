include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/byear.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# By Ear against byear.py, for byear_diff.py: the grade table, dealt tunes
# (every step's keys in the order Python's frozensets give them, the shift
# and the lit key), and tries played step by step: the reference autopilot,
# nobody, a wrong key, a pair pressed one key short, and keys pressed by
# rote, while listening too.

def emit_step(word: cstr, s: ByEar::Step):
    can Console.Write, Abort.Panic:
        _ = printf("%s %lld", word, s.count)
        for j in 0..<s.count |s|:
            _ = printf(" %lld", s.keys[j.usize()])
        _ = printf("\n")

def player(run: ByEar::Run&, mode: i64, n: i64) -> i64:
    can Abort.Panic:
        auto: i64 = ByEar::pilot(run)
        return auto if mode == 0
        return -1 if mode == 1
        if mode == 2:
            return -1 if auto < 0 or run.done < 1
            want: i64 = ByEar::mask(run.tune.want[run.done.usize()])
            for k in 0..<ByEar::KEYS |want|:
                return k if (want & (1 << k)) == 0
            return -1
        if mode == 3:
            return -1 if auto >= 0 and run.held != 0
            return auto
        return (n * 7) % 13 if n % 25 == 0 else -1

def replay(rung: i64, seed: i64, mode: i64, dt: f64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(16777216):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                tune: ByEar::Tune = ByEar::deal(rung, &draw)
                _ = printf("tune %lld %lld %lld %d %u %lld\n", mode, rung, seed, 1 if tune.valid else 0,
                    py_getrandbits(&draw, 32).u32(), tune.lit)
                for k in 0..<tune.level.length |tune|:
                    emit_step("want", tune.want[k.usize()])
                    emit_step("heard", tune.heard[k.usize()])
                return if mode < 0
                run: mutable ByEar::Run = ByEar::begin(tune)
                _ = printf("begin %.17g %.17g\n", run.listen_end, run.end)
                n: mutable i64 = 0
                while run.result == ByEar::LIVE |run, mode, n, dt|:
                    key: i64 = player(&run, mode, n)
                    ByEar::press(&run, key) if key >= 0
                    ByEar::step(&run, dt)
                    _ = printf("%lld %lld %.17g %lld %lld %lld %lld\n", key, run.result, run.t, run.done, run.held,
                        run.notes.count.i64(), run.pressed.count.i64())
                    n <- n + 1
                _ = printf("end %lld %lld\n", run.result, run.done)
                for note in run.notes:
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g\n", note.seed, note.voice, note.t, note.freq, note.dur, note.gain)
                for p in run.pressed:
                    _ = printf("press %.17g %lld %d\n", p.t, p.key, 1 if p.right else 0)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in 0..<41:
            level: ByEar::Grade = ByEar::grade(rung)
            _ = printf("grade %lld %lld %lld %.17g %d %.17g %lld", level.rung, level.count, level.length, level.note,
                1 if level.shift else 0, level.pairs, level.patch)
            for i in 0..<level.count |level|:
                _ = printf(" %lld", level.keys[i.usize()])
            _ = printf("\n")
        for rung in 1..<41:
            for seed in 1..<16 |rung|:
                replay(rung, seed, -1, 0.0)
        for rung in [1.i64(), 2.i64(), 4.i64(), 7.i64(), 10.i64(), 13.i64(), 16.i64(), 25.i64(), 40.i64()]:
            for mode in 0..<5 |rung|:
                replay(rung, 17 + mode, mode, 1.0 / 120.0)
        replay(13, 5, 0, 1.0 / 30.0)
        replay(30, 9, 3, 1.0 / 30.0)
        return 0
