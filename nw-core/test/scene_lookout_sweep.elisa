# Differential sweep driver for src/scene_lookout.elisa and
# src/scene_glyphrow.elisa. See scene_lookout_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/textmetrics.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_glyphrow.elisa"
include "../src/scene_lookout.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|watching|shapes|cue_color|cue_form|cue_number|total_cues|tall|verdict")
            for spec in 0..<40:
                phase: i64 = spec % 4
                black: bool = spec % 7 == 1
                # All three channel settings, because the footnote is built
                # from them and says one key, the other, or both.
                watching: i64 = (spec / 4) % 3
                count: i64 = 4 + (spec / 4) % 6 * 3
                cue_color: i64 = (spec / 4) % SceneGlyphRow::COLOR_COUNT
                cue_form: i64 = (spec / 4) % SceneGlyphRow::FORM_COUNT
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(watching)
                emit_bar(count)
                emit_bar(cue_color)
                emit_bar(cue_form)
                emit_bar(1 + spec % 9)
                emit_bar(9)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                # Every form and every colour appears in a flock of twelve or
                # more, so all four classes and all six colours are drawn.
                shapes: mutable darray[SceneLookout::Drifter] = []
                for index in 0..<count |shapes|:
                    shapes.push(SceneLookout::Drifter{
                        x: 0.06 + 0.11 * (index % 8).f64(),
                        y: 0.13 + 0.13 * (index % 6).f64(),
                        color: index % SceneGlyphRow::COLOR_COUNT,
                        form: index % SceneGlyphRow::FORM_COUNT})
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneLookout::Paint = SceneLookout::paint_of(black, width, height, 2.0, 2.0)
                SceneLookout::render(&list, &paint, phase, watching, &shapes,
                                     cue_color, cue_form, 1 + spec % 9, 9,
                                     sview("Watch for it", 0, -1), verdict,
                                     sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
