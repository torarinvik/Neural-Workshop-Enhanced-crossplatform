include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/clawmachine.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# Claw Machine against clawmachine.py, for clawmachine_diff.py: the grade
# table, dealt cabinets (each checked by the autopilot playing it through),
# and tries played step by step -- the reference autopilot, nobody, the
# claw dropped at once, the trolley driven every way by hand before the
# autopilot takes over, and the claw dropped over the second prize -- with the trolley, the swing, the drop, the belt
# and the notes.

def player(run: ClawMachine::Run&, mode: i64, n: i64) -> i64:
    can Abort.Panic:
        auto: i64 = ClawMachine::pilot(run)
        return auto if mode == 0
        return -1 if mode == 1
        return (ClawMachine::DROP if n == 0 else -1) if mode == 2
        return ((n / 30) % 4 if n < 240 else auto) if mode == 3
        # Over the second prize, then drop; or (mode 5) over the gold one
        # left and right, then all the way in, then drop.
        which: usize = 0 if mode == 5 else 1
        dx: f64 = ClawMachine::prize_x(run, &run.cab.prizes[which]) - run.x
        dz: f64 = 0.0 if mode == 5 else run.cab.prizes[which].z - run.z
        return ClawMachine::IN if mode == 5 and fabs(dx) <= 0.02 and run.z < ClawMachine::DEEP
        return (ClawMachine::RIGHT if dx > 0.0 else ClawMachine::LEFT) if fabs(dx) > 0.02
        return (ClawMachine::IN if dz > 0.0 else ClawMachine::OUT) if fabs(dz) > 0.02
        return ClawMachine::DROP

def replay(rung: i64, seed: i64, mode: i64, dt: f64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(67108864):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                cab: ClawMachine::Cabinet = ClawMachine::deal(rung, &draw)
                _ = printf("cabinet %lld %lld %lld %u %.17g %.17g\n", mode, rung, seed, py_getrandbits(&draw, 32).u32(),
                    cab.start[0], cab.start[1])
                for k in 0..<cab.level.prizes |cab|:
                    p: ClawMachine::Prize = cab.prizes[k.usize()]
                    _ = printf("prize %.17g %.17g %.17g %u\n", p.x, p.z, p.r, p.colour)
                return if mode < 0
                run: mutable ClawMachine::Run = ClawMachine::begin(cab)
                n: mutable i64 = 0
                while run.result == ClawMachine::LIVE |run, mode, n, dt|:
                    port: i64 = player(&run, mode, n)
                    if port == ClawMachine::DROP:
                        ClawMachine::act(&run, port)
                    ClawMachine::step(&run, dt, port if port != ClawMachine::DROP else -1)
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g\n", port,
                        run.result, run.t, run.x, run.z, run.vx, run.vz, run.ox, run.oz, run.wx, run.wz, run.depth, run.belt,
                        ClawMachine::prize_x(&run, &run.cab.prizes[0]))
                    n <- n + 1
                _ = printf("end %lld %.17g %d %.17g\n", run.result, run.t, 1 if run.dropped else 0, run.drop)
                for note in run.notes:
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g\n", note.seed, note.voice, note.t, note.freq, note.dur, note.gain)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in 0..<41:
            level: ClawMachine::Grade = ClawMachine::grade(rung)
            _ = printf("grade %lld %d %d %.17g %d %d %.17g %.17g %lld\n", level.rung, 1 if level.side else 0,
                1 if level.shadow else 0, level.swing, 1 if level.low else 0, 1 if level.sizes else 0, level.belt, level.tol,
                level.prizes)
        for rung in 1..<21:
            for seed in 1..<4 |rung|:
                replay(rung, seed, -1, 0.0)
        for rung in [25.i64(), 30.i64(), 40.i64()]:
            replay(rung, 5, -1, 0.0)
        for rung in [1.i64(), 2.i64(), 4.i64(), 7.i64(), 8.i64(), 10.i64(), 13.i64(), 16.i64(), 20.i64()]:
            for mode in [0.i64(), 2.i64(), 3.i64()] |rung|:
                replay(rung, 17 + mode, mode, 1.0 / 30.0)
        replay(1, 5, 1, 1.0 / 30.0)
        for seed in 1..<13:
            replay(1, seed, 2, 1.0 / 30.0)
        replay(1, 4, 4, 1.0 / 30.0)
        replay(4, 6, 4, 1.0 / 30.0)
        replay(1, 7, 5, 1.0 / 30.0)
        replay(8, 9, 0, 1.0 / 120.0)
        replay(14, 3, 3, 1.0 / 120.0)
        return 0
