include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_manual.elisa"

# Manual runs played through the game layer, with every frame's display
# list and a grid of hit tests; manual_scene_diff.py draws the same with
# ui/manual.py.
extern printf(format: cstr, ...) -> i32 can[Console.Write]

def dump(list: Display::DisplayList&):
    can Console.Write, Abort.Panic:
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n", cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(),
                    cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")

def frame(session: ManualGame::Session&, label: i64, dark: bool):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = printf("frame %lld %lld %lld %lld %lld %lld %lld\n", label, session.phase, session.ladder.rung, session.ladder.trial,
            session.ladder.wins, session.ladder.best_rung, session.verdict)
        region scratch(4194304):
            in scratch:
                list: mutable Display::DisplayList = Display::DisplayList()
                SceneManual::render(&list, session, dark)
                dump(&list)

# The port under every point of a coarse grid over the window.
def grid(session: ManualGame::Session&):
    can Console.Write, Abort.Panic:
        _ = printf("grid")
        for row in 0..<36 |session|:
            for column in 0..<48 |session, row|:
                _ = printf(" %lld", SceneManual::hit(session, 4.5 + column.f64() * 19.0, 2.5 + row.f64() * 19.0))
        _ = printf("\n")

def run(rung: i64, seed: i64, dark: bool):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = printf("run %lld %lld %lld\n", rung, seed, 1 if dark else 0)
        game: mutable ManualGame::Session = ManualGame::initialize(rung, 3, true, seed)
        frame(&game, 0, dark)
        _ = ManualGame::press(&game, -1, 0.0)
        frame(&game, 1, dark)
        now: mutable f64 = 0.0
        for trial in 0..<3 |game, now, dark|:
            grid(&game)
            if trial == 0:
                # The procedure exactly, then Finish.
                ports: darray[i64] = Manual::reference_ports(&game.deal)
                for index in 0..<ports.count.i64() |game, now, ports, dark|:
                    now <- now + 0.25
                    _ = ManualGame::steer(&game, ports[index.usize()], now)
                    frame(&game, 10, dark) if index % 3 == 0 or game.phase != ManualGame::PLAYING
            elif trial == 1:
                # Hands where the procedure may not want them, then Enter.
                for port in [0, 7, 14, 1, 6, 15, 14, 20 - 1] |game, now, dark|:
                    now <- now + 0.25
                    _ = ManualGame::steer(&game, port, now)
                    frame(&game, 11, dark)
                _ = ManualGame::enter(&game, now)
            else:
                # Finish with nothing done: never right.
                _ = ManualGame::press(&game, Manual::FINISH_PORT, now)
            frame(&game, 6, dark)
            now <- now + 3.0
            _ = ManualGame::advance(&game, now)
            frame(&game, 7, dark)
        _ = printf("over\n")

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        for rung in [1, 2, 5, 9, 13, 17, 20, 25, 30]:
            note: mutable dstr = []
            SceneManual::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        region fixtures(268435456):
            in fixtures:
                for rung in [1, 2, 5, 9, 13, 17, 20, 25, 30]:
                    for seed in [3, 11] |rung|:
                        run(rung, seed, seed == 11)
        return 0.i32()
