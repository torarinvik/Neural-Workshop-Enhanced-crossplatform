include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_stagehand.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit_show(show: Stagehand::Show&):
    can Abort.Panic, Console.Write:
        _ = printf("%lld %lld %lld %.17g\n", show.level.props, show.lines.count.i64(), show.cuts.count.i64(), show.seconds)
        _ = printf("%lld\n", show.seed)
        for i in 0..<show.level.props |show|:
            _ = printf("%lld %lld\n", show.props[i.usize()], show.marks[i.usize()])
        for line in show.lines:
            _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld\n",
                line.kind, line.prop, line.mark, line.key, line.wait, line.count, line.decoy, line.destination, line.via)
            for byte in line.text:
                _ = printf("%c", byte.i32())
            _ = printf("\n")
        for cut in show.cuts:
            _ = printf("%.17g %lld\n", cut.time, cut.camera)

def replay(show: Stagehand::Show):
    can Memory.Allocate, Abort.Panic, Console.Write:
        run: mutable Stagehand::Run = Stagehand::initialize(show)
        frame: mutable i64 = 0
        while run.result == Stagehand::PENDING |run, frame|:
            port: i64 = Stagehand::pilot(&run)
            Stagehand::act(&run, port)
            Stagehand::tick(&run, 1.0 / 60.0)
            if frame % 61 == 0 or run.result != Stagehand::PENDING:
                _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g\n",
                    frame, port, run.result, run.line_no, run.camera, run.drag, run.lit, run.on,
                    run.time, run.opens, run.due, run.hand.x, run.hand.y, run.actor.x, run.actor.z,
                    run.held_at.x, run.held_at.z)
                for i in 0..<run.show.level.props |run|:
                    _ = printf("%lld ", run.marks[i.usize()])
                _ = printf("\n")
            frame <- frame + 1
        _ = printf("cues %lld\n", run.notes.count.i64())
        for cue in run.notes:
            _ = printf("%.17g %.17g %lld %.17g %.17g %lld\n", cue.time, cue.duration, cue.voice, cue.pitch, cue.gain, cue.seed)

def emit(rung: i64, seed: i64):
    can Memory.Allocate, Abort.Panic, Console.Write:
        draw: mutable MT19937 = mt19937_new()
        mt_seed_int(&draw, (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64())
        show: Stagehand::Show = Stagehand::deal(rung, &draw)
        _ = printf("%lld %lld %lld\n", rung, seed, 1 if show.valid else 0)
        return if not show.valid
        emit_show(&show)
        replay(show)

def session_check() -> bool:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        session: mutable StagehandGame::Session = StagehandGame::initialize(13, 1, false, 17)
        accepted: mutable bool = false
        region request(4096):
            in request:
                accepted <- StagehandGame::start(&session, 0.0) can Global{Read,Write}
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneStagehand::render(&list, &session, true)
        valid: mutable bool = accepted and list.commands.count > 100.usize()
        target: mutable f64 = 0.0
        while session.phase == StagehandGame::PLAYING |session, target|:
            port: i64 = Stagehand::pilot(&session.run)
            if port >= 0:
                _ = StagehandGame::agent_event(&session, target, port) can Global{Read,Write}
            target <- target + 1.0 / 60.0
            _ = StagehandGame::agent_event(&session, target, -1) can Global{Read,Write}
        valid <- valid and session.run.result == Stagehand::SUCCESS and session.run.notes.count > 0.usize()
        _ = StagehandGame::agent_event(&session, target + 1.0 / 60.0, -1) can Global{Read,Write}
        valid <- valid and session.phase == StagehandGame::DONE
        StagehandGame::close(&session) can Global{Read,Write}
        return valid and session.phase == StagehandGame::READY

def main() -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic, Console.Write:
        return 1.i32() if not (session_check() can Global{Read,Write})
        rungs: i64[12] = [-1, 1, 4, 7, 9, 10, 12, 13, 16, 19, 20, 30]
        for rung in rungs:
            for seed in -1..<4 |rung|:
                emit(rung, seed)
        return 0.i32()
