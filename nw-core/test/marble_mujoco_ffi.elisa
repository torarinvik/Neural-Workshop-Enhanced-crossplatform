include "../src/native/sdl_mujoco_exports.elisa"

def renderer_data_test() -> bool:
    can Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Unsafe.PointerCast:
        handle: i64 = marble_create(3, 2, 0, 2600, 0, 42)
        return false if handle <= 0
        slot: mutable usize = 0.usize()
        packet: mutable f64[587] = zeroed
        body: mutable f64[182] = zeroed
        _ = marble_action(handle, MarbleMazeGame::ACTION_START, 0, 0)
        started: i32 = SDLMarblePhysics::update(&slot, handle, 0, 0)
        size: i64 = SDLMarblePhysics::view(slot, 913, 685, &packet[0], 587)
        first_view: f64 = packet[469]
        body_size: i64 = SDLMarblePhysics::mesh(slot, 0, &body[0], 182)
        _ = marble_action(handle, MarbleMazeGame::ACTION_HOLD_EAST, 0, 0)
        advanced: i32 = SDLMarblePhysics::update(&slot, handle, 50, 0)
        next_size: i64 = SDLMarblePhysics::view(slot, 913, 685, &packet[0], 587)
        good: mutable bool = started == 1.i32() and advanced == 1.i32() and size > 456 and next_size == size and packet[469] != first_view and packet[2] > 0.0 and body_size == 182 and body[0] == 72.0 and body[1] == 36.0
        if good:
            trusted Unsafe.PointerCast:
                session: mutable heap SDLMarblePhysics::Session& = slot.cast[mutable heap SDLMarblePhysics::Session&]
                engine: mutable MarbleMuJoCo::Engine& = &session.physics.engine
                run: heap MarbleMazeGame::MarbleRun& = handle.uintptr().cast[heap MarbleMazeGame::MarbleRun&]
                seed: i64 = run.board_seed
                generation: i64 = run.board_generation
                _ = marble_action(handle, MarbleMazeGame::ACTION_RESTART, 0, 0)
                good <- false if SDLMarblePhysics::update(&slot, handle, 0, 114) != 1.i32()
                reset_size: i64 = SDLMarblePhysics::view(slot, 913, 685, &packet[0], 587)
                good <- false if reset_size != size or packet[469] != first_view or run.board_seed != seed or run.board_generation != generation or run.elapsed_ms != 0 or run.held_mask != 0
                work: mutable MarbleMaze::MarbleWork = MarbleMaze::MarbleWork()
                tray: mutable MarbleMaze::MarbleTray = MarbleMaze::MarbleTray()
                MarbleMaze::deal(3, marble_info(handle, 5), 24, &work, &tray)
                # Put the marble just above the first pit and step through the SDL path.
                engine.motion[1] <- Floats::at(tray.holes.x, 0).f32().f64()
                engine.motion[2] <- Floats::at(tray.holes.y, 0).f32().f64()
                engine.motion[3] <- 0.000001
                for axis in 0..<6 |axis, engine|:
                    engine.motion[(1 + 7 * engine.count + axis).usize()] <- 0.0
                good <- false if SDLMarblePhysics::update(&slot, handle, 10, 0) != 1.i32() or engine.lost != 1 or marble_info(handle, 0) != MarbleMazeGame::PHASE_FEEDBACK
                good <- false if run.result_count != 1
                good <- false if MarbleMazeGame::value(run, MarbleMazeGame::RESULT_LOST, 0) != 1 or MarbleMazeGame::value(run, MarbleMazeGame::RESULT_BOARD_SEED, 0) != seed
                feedback_size: i64 = SDLMarblePhysics::view(slot, 913, 685, &packet[0], 587)
                good <- false if feedback_size != 456 or packet[3] != 0.0
                _ = marble_action(handle, MarbleMazeGame::ACTION_NEXT, 0, 0)
                good <- false if SDLMarblePhysics::update(&slot, handle, 0, 0) != 1.i32()
                new_size: i64 = SDLMarblePhysics::view(slot, 913, 685, &packet[0], 587)
                good <- false if run.phase != MarbleMazeGame::PHASE_RUNNING or run.trial != 2 or run.board_generation == generation or run.board_seed == seed
                good <- false if new_size <= 456 or packet[3] != 1.0 or packet[0] != run.board_generation.f64() or run.result_count != 1
        _ = SDLMarblePhysics::update(&slot, 0, 0, 0)
        _ = marble_destroy(handle)
        return good and slot == 0.usize() and SDLMarblePhysics::view(slot, 913, 685, &packet[0], 587) == 0

def session_test() -> bool:
    can Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Unsafe.PointerCast:
        run: mutable MarbleMazeGame::MarbleRun = zeroed
        physics: mutable MarbleNativeSession::Physics = zeroed
        MarbleMazeGame::initialize(&run, 1, 2, false, 5, 30, 42)
        good: mutable bool = MarbleNativeSession::key_action(&run, &physics, MarbleMazeGame::ACTION_START)
        good <- false if not MarbleNativeSession::advance(&run, &physics, 10) or run.elapsed_ms != 10
        generation: i64 = run.board_generation
        good <- false if not MarbleNativeSession::key_action(&run, &physics, MarbleMazeGame::ACTION_RESTART) or run.elapsed_ms != 0 or physics.generation != generation
        good <- false if not MarbleNativeSession::advance(&run, &physics, 45) or run.phase != MarbleMazeGame::PHASE_FEEDBACK or run.result_count != 1 or run.elapsed_ms != 45
        good <- false if not MarbleNativeSession::advance(&run, &physics, 5) or run.phase != MarbleMazeGame::PHASE_RUNNING or physics.generation == generation
        physics.engine.home <- physics.engine.count
        good <- false if not MarbleNativeSession::advance(&run, &physics, 0) or run.result_count != 2 or run.verdict != 1
        good <- false if not MarbleNativeSession::advance(&run, &physics, 5) or run.phase != MarbleMazeGame::PHASE_DONE or physics.engine.data == 0.usize()
        MarbleNativeSession::close(&physics)
        return good and physics.engine.data == 0.usize()

def selftest() -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Unsafe.PointerCast:
        work: mutable MarbleMaze::MarbleWork = MarbleMaze::MarbleWork()
        tray: mutable MarbleMaze::MarbleTray = MarbleMaze::MarbleTray()
        MarbleMaze::deal(16, 42, 24, &work, &tray)
        engine: mutable MarbleMuJoCo::Engine = zeroed
        return 1.i32() if not MarbleMuJoCo::open(&engine, &tray)
        state: mutable f64[105] = zeroed
        expected: i64 = 1 + 13 * tray.start_n
        too_short: i64 = MarbleMuJoCo::advance(&engine, 0.05, 2, &state[0], expected - 1)
        initial: i64 = MarbleMuJoCo::advance(&engine, 0.0, 0, &state[0], expected)
        initial_ok: mutable bool = initial == expected and state[0] == 0.0
        for ball in 0..<tray.start_n |ball, tray, state, initial_ok|:
            offset: usize = (1 + ball * 7).usize()
            dx: f64 = state[offset] - Floats::at(tray.start_x, ball).f32().f64()
            dy: f64 = state[offset + 1.usize()] - Floats::at(tray.start_y, ball).f32().f64()
            if dx < -0.0000005 or dx > 0.0000005 or dy < -0.0000005 or dy > 0.0000005 or state[offset + 2.usize()] != 0.0075:
                initial_ok <- false
        stepped: i64 = MarbleMuJoCo::advance(&engine, 0.2, 2, &state[0], expected)
        elapsed_ok: bool = state[0] > 0.049999999999 and state[0] < 0.050000000001
        direction_ok: bool = engine.roll > 0.017999999999 and engine.roll < 0.018000000001 and engine.pitch == 0.0 and state[(1 + 7 * tray.start_n).usize()] > 0.0
        for tick in 0..<10 |tick, engine, state, expected|:
            _ = MarbleMuJoCo::advance(&engine, 0.05, 1, &state[0], expected)
        limit_ok: bool = engine.pitch == -0.140
        MarbleMuJoCo::level(&engine)
        _ = MarbleMuJoCo::advance(&engine, 0.001, 0, &state[0], expected)
        level_ok: bool = engine.roll == 0.0 and engine.pitch == 0.0 and engine.nudge_due == 0.0
        velocity: usize = (1 + 7 * engine.count).usize()
        engine.motion[4] <- 1.0
        engine.motion[5] <- 0.0
        engine.motion[6] <- 0.0
        engine.motion[7] <- 0.0
        engine.motion[velocity] <- 2.0
        engine.motion[velocity + 1.usize()] <- 0.0
        engine.motion[velocity + 3.usize()] <- 2.0
        engine.motion[velocity + 4.usize()] <- 0.0
        engine.motion[velocity + 5.usize()] <- 0.1
        MarbleMuJoCo::adjust_velocity(&engine, 0.usize(), 1.usize(), velocity, 0.0, false)
        cap_ok: bool = engine.motion[velocity] == 1.0 and engine.motion[velocity + 3.usize()] == 1.0 and engine.motion[velocity + 5.usize()] == 0.0
        engine.motion[velocity] <- 0.002
        engine.motion[velocity + 3.usize()] <- 0.2
        MarbleMuJoCo::adjust_velocity(&engine, 0.usize(), 1.usize(), velocity, 0.0, true)
        rest_ok: bool = engine.motion[velocity] == 0.0 and engine.motion[velocity + 3.usize()] == 0.0
        home_hole: mutable i64 = -1
        loss_hole: mutable i64 = -1
        for hole in 0..<tray.holes.count |hole, tray, home_hole, loss_hole|:
            if Ints::at(tray.holes.home, hole) != 0:
                home_hole <- hole
            else:
                loss_hole <- hole
        outcomes_ok: mutable bool = home_hole >= 0 and loss_hole >= 0 and engine.count >= 2
        if outcomes_ok:
            engine.motion[1] <- Floats::at(tray.holes.x, home_hole).f32().f64()
            engine.motion[2] <- Floats::at(tray.holes.y, home_hole).f32().f64()
            engine.motion[3] <- 0.000001
            engine.motion[8] <- Floats::at(tray.holes.x, loss_hole).f32().f64()
            engine.motion[9] <- Floats::at(tray.holes.y, loss_hole).f32().f64()
            engine.motion[10] <- 0.000001
            for axis in 0..<12 |axis, engine|:
                engine.motion[(1 + 7 * engine.count + axis).usize()] <- 0.0
            _ = MarbleMuJoCo::advance(&engine, 0.01, 0, &state[0], expected)
            home_x: f64 = state[1]
            lost_x: f64 = state[8]
            feedback_ok: bool = engine.cupped_this_step == 1 and engine.lost_this_step == 1
            _ = MarbleMuJoCo::advance(&engine, 0.01, 0, &state[0], expected)
            outcomes_ok <- feedback_ok and engine.cupped_this_step == 0 and engine.lost_this_step == 0 and engine.status[0] == MarbleMuJoCo::HOME and engine.status[1] == MarbleMuJoCo::LOST and engine.home == 1 and engine.lost == 1 and state[1] == home_x and state[8] == lost_x
        MarbleMuJoCo::close(&engine)
        MarbleMuJoCo::close(&engine)
        return 2.i32() if too_short != 0 or not initial_ok
        return 3.i32() if stepped != expected or not elapsed_ok
        return 4.i32() if not direction_ok
        return 5.i32() if not limit_ok or not level_ok
        return 6.i32() if not outcomes_ok
        return 7.i32() if not cap_ok or not rest_ok
        return 8.i32() if not session_test()
        return 9.i32() if not renderer_data_test()
        return 10.i32() if sdl_marble_assets_selftest() != 0.i32()
        return 0.i32()

export fn nw_marble_mujoco_selftest() -> i32 = selftest

def replay(rung: i64, seed: i64, out: mutable f64&) -> i64:
    can Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Unsafe.PointerCast:
        work: mutable MarbleMaze::MarbleWork = MarbleMaze::MarbleWork()
        tray: mutable MarbleMaze::MarbleTray = MarbleMaze::MarbleTray()
        MarbleMaze::deal(rung, seed, 24, &work, &tray)
        engine: mutable MarbleMuJoCo::Engine = zeroed
        return 0 if not MarbleMuJoCo::open(&engine, &tray)
        size: i64 = 1 + 13 * tray.start_n
        stride: i64 = size + tray.start_n + 5
        state: mutable f64[105] = zeroed
        for tick in 0..<240 |tick, engine, tray, state, size, stride, out|:
            if tick % 60 == 45:
                MarbleMuJoCo::level(&engine)
            direction: i64 = (tick / 60)
            held: i64 = 0 if tick % 60 >= 45 else (1 << direction)
            elapsed: f64 = 0.05 if tick % 17 == 0 else (0.010 if tick % 2 == 0 else 0.023)
            _ = MarbleMuJoCo::advance(&engine, elapsed, held, &state[0], size)
            row: usize = (tick * stride).usize()
            out[row] <- engine.roll
            out[row + 1.usize()] <- engine.pitch
            out[row + 2.usize()] <- engine.cupped_this_step.f64()
            out[row + 3.usize()] <- engine.lost_this_step.f64()
            out[row + 4.usize()] <- engine.struck_this_step
            for field in 0..<size |field, row, out, state|:
                out[row + 5.usize() + field.usize()] <- state[field.usize()]
            for ball in 0..<tray.start_n |ball, row, size, engine, out|:
                out[row + (5 + size + ball).usize()] <- engine.status[ball.usize()].f64()
        MarbleMuJoCo::close(&engine)
        return stride

export fn nw_marble_mujoco_replay(rung: i64, seed: i64, out: mutable f64&) -> i64 = replay

def geometry(rung: i64, seed: i64, part: i64, out: mutable f64&, capacity: i64) -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        work: mutable MarbleMaze::MarbleWork = MarbleMaze::MarbleWork()
        tray: mutable MarbleMaze::MarbleTray = MarbleMaze::MarbleTray()
        MarbleMaze::deal(rung, seed, 24, &work, &tray)
        if part == 7:
            return 0 if capacity < 4 * MarbleGeometry::MAX_SHADER_HOLES
            return 4 * MarbleGeometry::shader_holes(&tray, out, 0)
        mesh: MarbleGeometry::Mesh = MarbleGeometry::build(&tray, part)
        coords: i64 = mesh.positions.count.i64()
        indices: i64 = mesh.indices.count.i64()
        size: i64 = 2 + coords * 2 + indices
        return 0 if size > capacity
        out[0] <- coords.f64()
        out[1] <- indices.f64()
        for at in 0..<coords |at, coords, mesh, out|:
            out[(2 + at).usize()] <- mesh.positions[at.usize()]
            out[(2 + coords + at).usize()] <- mesh.normals[at.usize()]
        for at in 0..<indices |at, coords, indices, mesh, out|:
            out[(2 + coords * 2 + at).usize()] <- mesh.indices[at.usize()].f64()
        return size

export fn nw_marble_geometry(rung: i64, seed: i64, part: i64, out: mutable f64&, capacity: i64) -> i64 = geometry

def view_test(out: mutable f64&):
    can Abort.Panic:
        stage: i64[4] = MarbleView::stage(913, 685)
        frame: f64[16] = MarbleView::board_frame(0.11, -0.07)
        camera: f64[16] = MarbleView::camera(0.33, 0.28, stage[2].f64() / stage[3].f64())
        model: f64[16] = MarbleView::marble(&frame, 0.043, 0.0075, -0.052, 0.8, 0.36, 0.48, 0.0)
        light: MarbleView::Light = MarbleView::light(0.33, 0.28)
        for at in 0..<4 |at, stage, out|:
            out[at.usize()] <- stage[at.usize()].f64()
        for at in 0..<16 |at, frame, camera, model, light, out|:
            out[(4 + at).usize()] <- frame[at.usize()]
            out[(20 + at).usize()] <- camera[at.usize()]
            out[(36 + at).usize()] <- model[at.usize()]
            out[(52 + at).usize()] <- light.clip[at.usize()]
            out[(68 + at).usize()] <- light.texture[at.usize()]

export fn nw_marble_view_test(out: mutable f64&) = view_test


def gl_mesh_test(program: u32) -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        source: mutable MarbleGeometry::Mesh = MarbleGeometry::empty()
        MarbleGeometry::box(&source, -0.5, -0.5, -0.5, 0.5, 0.5, 0.5)
        mesh: mutable MarbleGLMesh::Mesh = zeroed
        return 1.i32() if not MarbleGLMesh::upload(&mesh, &source)
        matrix: f32[16] = [1.0.f32(), 0.0.f32(), 0.0.f32(), 0.0.f32(),
            0.0.f32(), 1.0.f32(), 0.0.f32(), 0.0.f32(),
            0.0.f32(), 0.0.f32(), 1.0.f32(), 0.0.f32(),
            0.0.f32(), 0.0.f32(), 0.0.f32(), 1.0.f32()]
        glUseProgram(program)
        glUniformMatrix4fv(glGetUniformLocation(program, "model"), 1.i32(), 0.u8(), &matrix[0])
        glUniformMatrix4fv(glGetUniformLocation(program, "light_clip"), 1.i32(), 0.u8(), &matrix[0])
        glEnable(2929.u32()) # GL_DEPTH_TEST
        glClear(256.u32()) # GL_DEPTH_BUFFER_BIT
        MarbleGLMesh::draw(&mesh, program)
        depth: mutable f32 = 1.0.f32()
        glReadPixels(32.i32(), 32.i32(), 1.i32(), 1.i32(), 6402.u32(), 5126.u32(), &depth)
        MarbleGLMesh::close(&mesh)
        glUseProgram(0.u32())
        return 0.i32() if glGetError() == 0.u32() and depth > 0.24.f32() and depth < 0.26.f32() else 2.i32()

export fn nw_marble_gl_mesh_test(program: u32) -> i32 = gl_mesh_test

def gl_shadow_test(program: u32) -> i32:
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        handle: i64 = marble_create(3, 1, 0, 2600, 0, 42)
        return 1.i32() if handle <= 0
        slot: mutable usize = 0.usize()
        packet: mutable f64[587] = zeroed
        target: mutable MarbleGLShadow::Target = zeroed
        mesh: mutable MarbleGLMesh::Mesh = zeroed
        good: mutable bool = false
        _ = marble_action(handle, MarbleMazeGame::ACTION_START, 0, 0)
        if SDLMarblePhysics::update(&slot, handle, 17, 0) == 1.i32() and SDLMarblePhysics::view(slot, 912, 684, &packet[0], 587) > 0:
            trusted Unsafe.PointerCast:
                session: heap SDLMarblePhysics::Session& = slot.cast[heap SDLMarblePhysics::Session&]
                body: MarbleGeometry::Mesh = MarbleGeometry::build(&session.physics.tray, 0)
                if MarbleGLShadow::open(&target) and MarbleGLMesh::upload(&mesh, &body):
                    MarbleGLShadow::begin(&target, program, &packet[0])
                    MarbleGLShadow::draw(program, &mesh, &packet[0], 24, true)
                    covered: mutable f32 = 1.0.f32()
                    clear: mutable f32 = 0.0.f32()
                    glReadPixels(512.i32(), 512.i32(), 1.i32(), 1.i32(), 6402.u32(), 5126.u32(), &covered)
                    glReadPixels(0.i32(), 0.i32(), 1.i32(), 1.i32(), 6402.u32(), 5126.u32(), &clear)
                    good <- covered > 0.0.f32() and covered < 1.0.f32() and clear == 1.0.f32()
        glBindFramebuffer(MarbleGLShadow::FRAMEBUFFER, 0.u32())
        glUseProgram(0.u32())
        MarbleGLMesh::close(&mesh)
        MarbleGLShadow::close(&target)
        _ = SDLMarblePhysics::update(&slot, 0, 0, 0)
        _ = marble_destroy(handle)
        return 0.i32() if good and glGetError() == 0.u32() else 2.i32()

export fn nw_marble_gl_shadow_test(program: u32) -> i32 = gl_shadow_test

def gl_colour_test() -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        target: mutable MarbleGLColour::Target = zeroed
        return 1.i32() if not MarbleGLColour::resize(&target, 29.i32(), 17.i32())
        texture: u32 = target.texture
        reused: bool = MarbleGLColour::resize(&target, 29.i32(), 17.i32()) and texture == target.texture
        MarbleGLColour::begin(&target, false)
        MarbleGLColour::resolve(&target)
        glBindFramebuffer(MarbleGLColour::FRAMEBUFFER, target.resolved)
        light: mutable f32[4] = zeroed
        glReadPixels(28.i32(), 16.i32(), 1.i32(), 1.i32(), 6408.u32(), 5126.u32(), &light[0])
        resized: bool = MarbleGLColour::resize(&target, 17.i32(), 29.i32())
        MarbleGLColour::begin(&target, true)
        MarbleGLColour::resolve(&target)
        glBindFramebuffer(MarbleGLColour::FRAMEBUFFER, target.resolved)
        dark: mutable f32[4] = zeroed
        glReadPixels(16.i32(), 28.i32(), 1.i32(), 1.i32(), 6408.u32(), 5126.u32(), &dark[0])
        glBindFramebuffer(MarbleGLColour::FRAMEBUFFER, 0.u32())
        MarbleGLColour::close(&target)
        return 0.i32() if reused and resized and light[0] > 0.89.f32() and light[3] == 1.0.f32() and dark[0] < 0.06.f32() and dark[3] == 1.0.f32() and glGetError() == 0.u32() else 2.i32()

export fn nw_marble_gl_colour_test() -> i32 = gl_colour_test

def gl_composite_test(program: u32) -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        target: mutable MarbleGLColour::Target = zeroed
        array: mutable u32 = 0.u32()
        return 1.i32() if not MarbleGLColour::resize(&target, 15.i32(), 11.i32())
        if not MarbleGLComposite::open(&array):
            MarbleGLColour::close(&target)
            return 1.i32()
        MarbleGLColour::begin(&target, false)
        MarbleGLColour::resolve(&target)
        glClearColor(0.125.f32(), 0.25.f32(), 0.5.f32(), 1.0.f32())
        glClear(16384.u32())
        stage: i64[4] = [7, 9, 31, 27]
        MarbleGLComposite::draw(program, array, &target, &stage, 64.i32(), 64.i32())
        inside: mutable f32[4] = zeroed
        outside: mutable f32[4] = zeroed
        glReadPixels(7.i32(), 9.i32(), 1.i32(), 1.i32(), 6408.u32(), 5126.u32(), &inside[0])
        glReadPixels(6.i32(), 9.i32(), 1.i32(), 1.i32(), 6408.u32(), 5126.u32(), &outside[0])
        MarbleGLComposite::close(&array)
        MarbleGLColour::close(&target)
        return 0.i32() if inside[0] > 0.89.f32() and inside[3] == 1.0.f32() and outside[0] > 0.12.f32() and outside[0] < 0.13.f32() and glGetError() == 0.u32() else 2.i32()

export fn nw_marble_gl_composite_test(program: u32) -> i32 = gl_composite_test

def gl_scene_test() -> i32:
    can Blocking.IO, Memory.Allocate, Memory.Release, Console.Write, Abort.Panic, Unsafe.PointerCast:
        handle: i64 = marble_create(3, 1, 0, 2600, 0, 42)
        return 1.i32() if handle <= 0
        slot: mutable usize = 0
        renderer: mutable usize = 0
        _ = marble_action(handle, MarbleMazeGame::ACTION_START, 0, 0)
        started: bool = SDLMarblePhysics::update(&slot, handle, 17, 0) == 1.i32()
        drawn: bool = SDLMarblePhysics::render(&renderer, slot, 64.i32(), 64.i32(), 0) == 1.i32()
        centre: mutable f32[4] = zeroed
        glReadPixels(32.i32(), 40.i32(), 1.i32(), 1.i32(), 6408.u32(), 5126.u32(), &centre[0])
        good: bool = started and drawn and centre[0] < 0.89.f32() and centre[0] > 0.0.f32()
        SDLMarblePhysics::render_close(&renderer, 1.i32())
        _ = SDLMarblePhysics::update(&slot, 0, 0, 0)
        _ = marble_destroy(handle)
        return 0.i32() if good else 2.i32()

export fn nw_marble_gl_scene_test() -> i32 = gl_scene_test

def read_shadow(slot: usize, out: mutable f32&):
    can Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            renderer: heap SDLMarblePhysics::Renderer& = slot.cast[heap SDLMarblePhysics::Renderer&]
            glBindFramebuffer(MarbleGLShadow::FRAMEBUFFER, renderer.scene.shadow.framebuffer)
            glReadPixels(0.i32(), 0.i32(), MarbleGLShadow::SIZE, MarbleGLShadow::SIZE, 6402.u32(), 5126.u32(), out)
            glBindFramebuffer(MarbleGLShadow::FRAMEBUFFER, 0.u32())

export fn nw_marble_test_read_shadow(slot: usize, out: mutable f32&) = read_shadow

extern glGetUniformfv(program: u32, location: i32, value: mutable f32&)

def read_shadow_holes(slot: usize, out: mutable f32&):
    can Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            renderer: heap SDLMarblePhysics::Renderer& = slot.cast[heap SDLMarblePhysics::Renderer&]
            program: u32 = renderer.scene.shadow_program
            glGetUniformfv(program, glGetUniformLocation(program, "holes[0]"), out)
            glGetUniformfv(program, glGetUniformLocation(program, "hole_count"), &out[4])

export fn nw_marble_test_read_shadow_holes(slot: usize, out: mutable f32&) = read_shadow_holes

def place_at_pit(slot: usize):
    can Unsafe.PointerCast, Abort.Panic:
        trusted Unsafe.PointerCast:
            session: mutable heap SDLMarblePhysics::Session& = slot.cast[mutable heap SDLMarblePhysics::Session&]
            engine: mutable MarbleMuJoCo::Engine& = &session.physics.engine
            engine.motion[1] <- engine.holes[0]
            engine.motion[2] <- engine.holes[1]
            engine.motion[3] <- 0.000001

export fn nw_marble_test_place_at_pit(slot: usize) = place_at_pit

def desktop_frame(phase: i64, dark: i64, dest: i64, capacity: i64) -> i64:
    can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        handle: i64 = marble_create(3, 1, 0, 2600, 0, 42)
        return 0 if handle <= 0
        if phase > 0:
            _ = marble_action(handle, MarbleMazeGame::ACTION_START, 0, 0)
        if phase >= 2:
            _ = marble_action(handle, MarbleMazeGame::ACTION_REPORT, 0, 1000)
            _ = marble_action(handle, MarbleMazeGame::ACTION_RECORD_RESULT, 0, 1)
        if phase == 4:
            _ = marble_action(handle, MarbleMazeGame::ACTION_NEXT, 0, 0)
        matched: bool = marble_info(handle, 0) == phase
        size: i64 = marble_frame_write(dest, capacity, handle, dark, 913, 685) if matched else 0
        _ = marble_destroy(handle)
        return size

export fn nw_marble_test_desktop_frame(phase: i64, dark: i64, dest: i64, capacity: i64) -> i64 = desktop_frame
