include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_tightrope.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def frame(game: TightropeGame::Session&, name: cstr):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region scratch(65536):
            in scratch:
                list: mutable Display::DisplayList = Display::DisplayList()
                SceneTightrope::render(&list, game, true)
                _ = printf("frame %s %lld %lld %lld %lld %lld\n", name, game.phase, game.rung,
                    game.trial, game.wins, game.run.taken)
                for cmd in list.commands |list|:
                    if cmd.kind == Display::CMD_TEXT:
                        for i in 0..<(cmd.len & 0xffffff.u32()).i64() |list, cmd|:
                            _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                        _ = printf("\n")
                    elif cmd.kind == Display::CMD_POLYGON or cmd.kind == Display::CMD_POLY_POINT:
                        _ = printf("poly %u %u %u %.7g %.7g\n", cmd.kind, cmd.color, cmd.len, cmd.a.f64(), cmd.b.f64())
                    elif cmd.kind == Display::CMD_LINE or cmd.kind == Display::CMD_CIRCLE or cmd.kind == Display::CMD_RECT:
                        _ = printf("shape %u %u %.7g %.7g %.7g %.7g\n", cmd.kind, cmd.color,
                            cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64())
                _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        game: mutable TightropeGame::Session = TightropeGame::initialize(16, 1, true, 17)
        frame(&game, "ready")
        _ = TightropeGame::start(&game, 0.0) can Global{Read,Write}
        frame(&game, "start")
        _ = TightropeGame::input(&game, Tightrope::STEP) can Global{Read,Write}
        _ = TightropeGame::input(&game, Tightrope::STEP) can Global{Read,Write}
        if game.run.taken != 1:
            return 1
        game.run.time <- 3.25
        game.run.swing <- 0.31
        game.run.boing <- -0.12
        game.run.lean <- -0.14
        game.run.pitch <- 0.35
        game.run.held <- -0.66
        game.run.held_f <- 0.31
        game.run.perched[0] <- -1
        game.run.perched[1] <- 1
        game.run.perches <- 2
        frame(&game, "wind")
        spot: RoomsView::Vec = Tightrope::bird_spot(&game.run, -1)
        _ = TightropeGame::pointer(&game, SceneHand::x(spot.x), SceneHand::y(spot.y), 1, 0.0) can Global{Read,Write}
        if game.run.perches != 1 or game.run.perched[0] != 1 or not game.run.hand.down:
            return 2
        _ = TightropeGame::clear_controls(&game) can Global{Read,Write}
        frame(&game, "shoo")
        game.run.pitch <- -0.61
        _ = TightropeGame::advance(&game, 0.01) can Global{Read,Write}
        frame(&game, "fell")
        TightropeGame::close(&game) can Global{Read,Write}

        game <- TightropeGame::initialize(1, 1, true, 17)
        _ = TightropeGame::start(&game, 0.0) can Global{Read,Write}
        t: mutable f64 = 0.0
        while game.phase == TightropeGame::PLAYING and t < 30.0 |game, t|:
            port: i64 = Tightrope::pilot(&game.run)
            _ = TightropeGame::input(&game, port) can Global{Read,Write}
            t <- t + 1.0 / 60.0
            _ = TightropeGame::advance(&game, t) can Global{Read,Write}
        frame(&game, "won")
        _ = TightropeGame::advance(&game, t + 2.49) can Global{Read,Write}
        frame(&game, "hold")
        _ = TightropeGame::advance(&game, t + 2.5) can Global{Read,Write}
        frame(&game, "done")
        TightropeGame::close(&game) can Global{Read,Write}
        return 0
