include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/reading_quiz_audio.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Console.Write:
        round: ReadingQuiz::Round = zeroed
        run: mutable ReadingQuiz::Run = ReadingQuiz::begin(round)
        run.time <- 0.05
        ReadingQuiz::note(&run, 0.05, 720.0, ReadingQuiz::TICK, 0.2)
        run.time <- 0.09
        ReadingQuiz::note(&run, 0.3, 880.0, ReadingQuiz::RIGHT, 0.4)
        run.time <- 0.28
        ReadingQuiz::note(&run, 0.35, 180.0, ReadingQuiz::WRONG, 0.4)
        run.time <- 0.42
        ReadingQuiz::note(&run, 0.6, 1320.0, ReadingQuiz::DONE, 0.5)
        run.time <- 0.53
        ReadingQuiz::note(&run, 0.5, 90.0, ReadingQuiz::MISS, 0.5)
        for i in 0..<15 |run|:
            data: mutable u8[8820] = zeroed
            begin: f64 = i.f64() * 0.1
            count: i64 = ReadingQuizAudio::render(&run, begin, begin + 0.1, &data[0], 8820)
            for j in 0..<count |data|:
                _ = dprintf(1.i32(), "%02x", data[j.usize()].i32())
            _ = dprintf(1.i32(), "\n")
        return 0.i32()
