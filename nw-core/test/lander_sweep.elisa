include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_lander.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def state(craft: Lander::Craft&):
    can Console.Write:
        _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g %.17g %lld %lld\n", craft.time, craft.x, craft.y,
            craft.vx, craft.vy, craft.angle, craft.fuel, 1 if craft.firing else 0, craft.result)

def emit(rung: i64, seed: i64):
    can Abort.Panic, Console.Write:
        f: Lander::Flight = Lander::deal(rung, seed)
        _ = printf("%lld %lld %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g\n", rung, seed, f.count,
            f.gravity, f.ratio, f.pad_x, f.pad_y, f.start_x, f.start_vx, f.wind, f.phase)
        for i in 0..<f.count |f|:
            p: Lander::Point = f.ground[i.usize()]
            _ = printf("%.17g %.17g\n", p.x, p.y)
        craft: mutable Lander::Craft = Lander::trial(f)
        for i in 0..<720 |craft|:
            port: i64 = (i / 40) % 6 - 1
            Lander::step(&craft, 1.0 / 120.0, port)
            if i % 16 == 15:
                state(&craft)
        craft <- Lander::trial(f)
        while craft.result == Lander::PENDING |craft|:
            Lander::step(&craft, 1.0 / 60.0, Lander::pilot(&craft))
        state(&craft)

def main() -> i32:
    can Abort.Panic, Console.Write:
        for rung in -1..<35:
            for seed in -3..<4 |rung|:
                emit(rung, seed)
        emit(29, -9223372036854775807 - 1)
        emit(29, 9223372036854775807)
        return 0.i32()
