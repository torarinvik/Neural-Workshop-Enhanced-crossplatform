include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_shadowpuppets.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# Shadow Puppets frames for shadowpuppets_scene_diff.py, which draws the
# same states with the reference's own ShadowPuppets._scene and requires
# every one of its shapes, polygons and labels to appear, in order, in
# these frames.
#
# Mid-game states are reached by stepping the run itself, 1/60 s a step
# with the reference autopilot or a script, exactly as the diff steps
# shadowpuppets.Run: the wanted shadow on the wall at rung 1, on a card at
# rung 7, only named at rung 13, the figure behind the screen at rung 16,
# a dragged and rolled figure at rung 4, and then whole sessions to a pass
# and a fail verdict.

def frame(game: ShadowPuppetsGame::Session&, name: cstr):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region scratch(262144):
            in scratch:
                list: mutable Display::DisplayList = Display::DisplayList()
                SceneShadowPuppets::render(&list, game, true)
                _ = printf("frame %s %lld %lld %lld %lld %lld\n", name, game.phase, game.rung,
                    game.trial, game.wins, game.run.at)
                for cmd in list.commands |list|:
                    if cmd.kind == Display::CMD_TEXT:
                        for i in 0..<(cmd.len & 0xffffff.u32()).i64() |list, cmd|:
                            _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                        _ = printf("\n")
                    elif cmd.kind == Display::CMD_POLYGON or cmd.kind == Display::CMD_POLY_POINT:
                        _ = printf("poly %u %u %u %.7g %.7g\n", cmd.kind, cmd.color, cmd.len, cmd.a.f64(), cmd.b.f64())
                    elif cmd.kind == Display::CMD_LINE or cmd.kind == Display::CMD_CIRCLE or cmd.kind == Display::CMD_RECT:
                        _ = printf("shape %u %u %.7g %.7g %.7g %.7g\n", cmd.kind, cmd.color,
                            cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64())
                _ = printf("end\n")

# Step the run: `steps` frames, with the autopilot (mode 0) or the script
# the core sweep uses (mode 2).
def walk(game: mutable ShadowPuppetsGame::Session&, steps: i64, mode: i64):
    can Abort.Panic, Memory.Allocate, Memory.Release:
        script: i64[12] = [12, 3, 3, 0, 14, 14, 4, 1, 15, 13, 9, 6]
        for n in 0..<steps |game, mode, script|:
            break if game.run.result != ShadowPuppets::LIVE
            port: i64 = ShadowPuppets::pilot(&game.run) if mode == 0 else script[(n % 12).usize()]
            ShadowPuppetsGame::reserve_cues(game, 4) can Global{Read,Write}
            ShadowPuppets::act(&game.run, port)
            ShadowPuppets::step(&game.run, 1.0 / 60.0)

def session(rung: i64) -> ShadowPuppetsGame::Session:
    can Abort.Panic, Memory.Allocate, Memory.Release:
        game: mutable ShadowPuppetsGame::Session = ShadowPuppetsGame::initialize(rung, 1, true, 17)
        _ = ShadowPuppetsGame::start(&game, 0.0) can Global{Read,Write}
        return game

# A whole session: the run played to its verdict through the controller.
def finish(game: mutable ShadowPuppetsGame::Session&, piloted: bool) -> f64:
    can Abort.Panic, Memory.Allocate, Memory.Release:
        t: mutable f64 = 0.0
        while game.phase == ShadowPuppetsGame::PLAYING and t < 400.0 |game, t, piloted|:
            port: i64 = ShadowPuppets::pilot(&game.run) if piloted else -1
            if port >= 0:
                _ = ShadowPuppetsGame::input(game, port) can Global{Read,Write}
            t <- t + 1.0 / 60.0
            _ = ShadowPuppetsGame::advance(game, t) can Global{Read,Write}
        return t

def shot(rung: i64, steps: i64, mode: i64, name: cstr):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        game: mutable ShadowPuppetsGame::Session = session(rung) can Global{Read,Write}
        walk(&game, steps, mode) can Global{Read,Write}
        frame(&game, name)
        ShadowPuppetsGame::close(&game) can Global{Read,Write}

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        game: mutable ShadowPuppetsGame::Session = ShadowPuppetsGame::initialize(1, 1, true, 17)
        frame(&game, "ready")
        ShadowPuppetsGame::close(&game) can Global{Read,Write}

        shot(1, 120, 0, "wall") can Global{Read,Write}
        shot(7, 200, 0, "card") can Global{Read,Write}
        shot(13, 90, 0, "named") can Global{Read,Write}
        shot(16, 90, 0, "hidden") can Global{Read,Write}
        shot(4, 40, 2, "rolled") can Global{Read,Write}

        game <- session(1) can Global{Read,Write}
        t: mutable f64 = finish(&game, true) can Global{Read,Write}
        frame(&game, "passed")
        _ = ShadowPuppetsGame::advance(&game, t + 2.49) can Global{Read,Write}
        frame(&game, "hold")
        _ = ShadowPuppetsGame::advance(&game, t + 2.5) can Global{Read,Write}
        frame(&game, "done")
        ShadowPuppetsGame::close(&game) can Global{Read,Write}

        game <- session(1) can Global{Read,Write}
        _ = finish(&game, false) can Global{Read,Write}
        frame(&game, "failed")
        ShadowPuppetsGame::close(&game) can Global{Read,Write}

        rungs: i64[11] = [1, 4, 7, 10, 13, 16, 20, 25, 30, 0, 200]
        for i in 0..<11 |rungs|:
            region note(4096):
                in note:
                    text: mutable dstr = []
                    SceneShadowPuppets::option_note(rungs[i.usize()], &text)
                    _ = printf("note %lld ", rungs[i.usize()])
                    view: sview = bytes_view(text)
                    for j in 0..<sview_len(view).i64() |view|:
                        _ = printf("%c", sview_at(view, j.usize()).i32())
                    _ = printf("\n")
        return 0
