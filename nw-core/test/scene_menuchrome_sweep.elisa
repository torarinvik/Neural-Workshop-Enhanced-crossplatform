# Differential sweep driver for scene_menu.elisa's two extra captions --
# the mode-select screen's resolved-mode line and the task-options note.
# See scene_menuchrome_diff.py for the reference side.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/display.elisa"
include "../src/scene_menu.elisa"
include "scene_emit.elisa"

def mode_text(index: i64) -> sview:
    can Memory.Allocate:
        return sview("Dual N-Back", 0, -1) if index == 0 else (sview("3D Position V. N-Back", 0, -1) if index == 1 else (sview("An invalid mode has been selected.", 0, -1) if index == 2 else sview("Quad Combination N-Back", 0, -1)))

def note_text(index: i64) -> sview:
    can Memory.Allocate:
        return sview("Three modalities on a 4x4 board.", 0, -1) if index == 0 else (sview("Nothing is selected, so nothing will be played; pick at least one modality before you start.", 0, -1) if index == 1 else sview("Variable N-Back draws a fresh level each trial.", 0, -1))

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|black|which|text|tall")
        region w(16 * 1024 * 1024)
        in w:
            for spec in 0..<24:
                black: bool = spec % 3 == 1
                # 0 the mode caption, 1 the options note, 2 both at once.
                which: i64 = spec % 3
                text: i64 = spec % 4
                tall: i64 = 1368 if spec % 2 == 0 else 960
                printr("spec|")
                print_i64(spec)
                emit_bar(1 if black else 0)
                emit_bar(which)
                emit_bar(text)
                emit_bar(tall)
                print("")
                width: f64 = 1824.0
                height: f64 = tall.f64()
                list: mutable Display::DisplayList = Display::DisplayList()
                if which != 1:
                    put_mode_label(&list, mode_text(text), width, height, 2.0, 2.0)
                if which != 0:
                    put_options_note(&list, note_text(text % 3), black, width, height, 2.0, 2.0)
                emit_frame(&list)
                print("end")
        destroy w
        return 0
