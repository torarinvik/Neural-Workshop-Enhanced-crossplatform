include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/cipher_lang_family.elisa"
include "../src/tasks/cipher_lang_parse.elisa"
include "../src/tasks/cipher_lang_words.elisa"
include "../src/tasks/cipher_abyss.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(row: darray[i64]&):
    can Console.Write:
        _ = printf(" %lld", row.count.i64())
        for symbol in row:
            _ = printf(" %lld", symbol)

def programs(k: i64) -> darray[CipherLang::Node]:
    can Abort.Panic, Memory.Allocate:
        nodes: mutable darray[CipherLang::Node] = []
        for op in 0..<(CipherLang::META + 1) |k, nodes|:
            args: mutable darray[i64] = []
            children: mutable darray[i64] = []
            if op == CipherLang::PERM:
                args <- [2, 4, 3, 1, 0]
            elif op == CipherLang::SUB:
                for i in 0..<k |args, k|:
                    args.push(k - 1 - i)
            elif op == CipherLang::CONV:
                args <- [3, 2, 1]
            elif op == CipherLang::AFFINE:
                args <- [3, 1]
            elif op == CipherLang::FEISTEL:
                children <- [CipherLang::SEQ]
            elif op == CipherLang::SEQ:
                children <- [CipherLang::WEAVE, CipherLang::TSHIFT, CipherLang::PREFIX]
            elif op == CipherLang::IF:
                children <- [CipherLang::PAL, CipherLang::DIFF, CipherLang::MEM]
            elif op == CipherLang::ALT:
                children <- [CipherLang::IF, CipherLang::GF]
            elif op == CipherLang::EXCEPT:
                children <- [CipherLang::ALT, CipherLang::DEDUPE]
            elif op == CipherLang::PROG:
                args <- [0, 1, 0]
                children <- [CipherLang::REV, CipherLang::SHIFT, CipherLang::SWAP]
            elif op == CipherLang::META:
                children <- [CipherLang::EVENS, CipherLang::EXCEPT, CipherLang::PROG, CipherLang::SEQ]
            elif op == CipherLang::ROT or op == CipherLang::SHIFT or op == CipherLang::MUL or op == CipherLang::TSHIFT or op == CipherLang::ODDSHIFT or op == CipherLang::XOR or op == CipherLang::GF or op == CipherLang::STRIDE or (op >= CipherLang::FIRST and op <= CipherLang::EVENS) or op == CipherLang::ECHO:
                args <- [2]
            nodes.push(CipherLang::Node{op: op, args: args, children: children})
        nodes.push(CipherLang::Node{op: CipherLang::META, args: [], children: [CipherLang::SAME, CipherLang::META, CipherLang::IF]})
        return nodes

def code_line(nodes: darray[CipherLang::Node]&, entry: i64):
    can Console.Write, Abort.Panic, Memory.Allocate:
        code: mutable dstr = []
        CipherLang::write_code(&code, nodes, entry)
        _ = printf(" %lld %lld %lld ", CipherLang::size(nodes, entry),
            1 if CipherLang::uses_state(nodes, entry) else 0, 1 if CipherLang::fixed_length(nodes, entry) else 0)
        for byte in code:
            _ = printf("%c", byte.i32())

def parser_code(nodes: darray[CipherLang::Node]&, entry: i64, k: i64):
    can Console.Write, Abort.Panic, Memory.Allocate:
        code: mutable dstr = []
        CipherLang::write_code(&code, nodes, entry)
        graph: mutable darray[CipherLang::Node] = []
        parsed: i64 = CipherLang::parse(&graph, bytes_view(code))
        _ = printf("parsed %lld %lld ", k, entry)
        if parsed >= 0:
            code_line(&graph, parsed)
        _ = printf("\n")

def notation(k: i64):
    can Console.Write, Abort.Panic, Memory.Allocate:
        nodes: mutable darray[CipherLang::Node] = programs(k)
        target: i64 = CipherLang::add_node(&nodes, CipherLang::SEQ, [],
            [CipherLang::SHIFT, CipherLang::SHIFT, CipherLang::REV, CipherLang::REV,
                CipherLang::WEAVE, CipherLang::UNWEAVE, CipherLang::SORT, CipherLang::SORT])
        branch: i64 = CipherLang::add_node(&nodes, CipherLang::IF, [], [CipherLang::FIRST, target, target])
        nested: i64 = CipherLang::add_node(&nodes, CipherLang::SEQ, [], [target, branch, CipherLang::SHIFT])
        for entry in 0..<(nested + 1) |nodes, k|:
            normalized: i64 = CipherLang::canonical(&nodes, entry, 5, k)
            _ = printf("code %lld %lld", k, entry)
            code_line(&nodes, entry)
            code_line(&nodes, normalized)
            _ = printf("\n")
        for entry in 0..<(nested + 1) |nodes, k|:
            parser_code(&nodes, entry, k)
        for entry in 0..<(nested + 1) |nodes, k|:
            words: mutable dstr = []
            CipherLang::write_rule_words(&words, &nodes, entry)
            _ = printf("words %lld %lld ", k, entry)
            for byte in words:
                _ = printf("%c", byte.i32())
            _ = printf("\n")

def invalid_notation():
    can Console.Write, Abort.Panic, Memory.Allocate:
        nodes: mutable darray[CipherLang::Node] = []
        initial: i64 = CipherLang::parse(&nodes, "shift(1)")
        prior: i64 = nodes.count.i64()
        _ = printf("invalid %lld %lld %lld %lld %lld %lld %lld\n", initial, prior,
            CipherLang::parse(&nodes, "seq(rev,shift())"),
            CipherLang::parse(&nodes, "if(pal,rev)"),
            CipherLang::parse(&nodes, "prog(0:seq(rev,sort))"),
            CipherLang::parse(&nodes, "rev shift(1)"), nodes.count.i64())

def samples(k: i64):
    can Console.Write, Abort.Panic, Memory.Allocate:
        nodes: darray[CipherLang::Node] = programs(k)
        for index in 0..<130 |k, nodes|:
            region scratch(8192):
                in scratch:
                    count: i64 = index % 13
                    row: mutable darray[i64] = []
                    last: mutable darray[i64] = []
                    for i in 0..<count |row, index, k|:
                        row.push((index + i * (index / 13) + i * i) % k)
                    for i in 0..<(index % 7) |last, index, k|:
                        last.push((index + 3 * i) % k)
                    st: CipherLang::State = CipherLang::State{runs: index, last_in: last, last_out: last, meta: 2 * index}
                    for op in 0..<nodes.count.i64() |k, nodes, row, st, index|:
                        _ = printf("%lld %lld %lld", k, index, op)
                        if op >= CipherLang::FIRST and op <= CipherLang::SORTED:
                            _ = printf(" %lld", 1 if CipherLang::test(&nodes[op.usize()], &row, &st) else 0)
                        else:
                            result: darray[i64] = CipherLang::run(&nodes, op, &row, k, &st)
                            emit(&result)
                            changed: CipherLang::State = CipherLang::advance(&nodes, op, &st, &row, &result)
                            _ = printf(" %lld %lld", changed.runs, changed.meta)
                        _ = printf("\n")
        log: darray[CipherLang::Sample] = [
            CipherLang::Sample{given: [0, 0, 0], result: [3]},
            CipherLang::Sample{given: [1, 2, 3, 0], result: [3]},
            CipherLang::Sample{given: [2, 2], result: [3]},
            CipherLang::Sample{given: [2, 0, 1, 3], result: [3]}
        ]
        st: CipherLang::State = CipherLang::replay(&nodes, CipherLang::META + 1, &log, k)
        _ = printf("replay %lld %lld %lld", k, st.runs, st.meta)
        emit(&st.last_in)
        emit(&st.last_out)
        _ = printf("\n")

def families(k: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        inputs: darray[CipherLang::Probe] = CipherLang::probes(5, k)
        for row in inputs:
            _ = printf("probe %lld", k)
            emit(&row.values)
            _ = printf("\n")
        nodes: mutable darray[CipherLang::Node] = programs(k)
        entries: mutable darray[i64] = []
        for i in 0..<nodes.count.i64() |entries|:
            entries.push(i) if i < CipherLang::FIRST or i >= CipherLang::SEQ
        for a in 0..<CipherLang::FIRST |nodes, entries|:
            for b in 0..<CipherLang::FIRST |nodes, entries, a|:
                entries.push(CipherLang::add_node(&nodes, CipherLang::SEQ, [], [a, b]))
        best: darray[i64] = CipherLang::dedupe(&nodes, &entries, 5, k)
        _ = printf("family %lld %lld\n", k, best.count.i64())
        for entry in best:
            code_line(&nodes, entry)
            _ = printf("\n")

def print_grade(r: i64):
    can Console.Write, Abort.Panic:
        g: CipherAbyss::Grade = CipherAbyss::grade(r)
        _ = printf("grade %lld %lld %lld %lld %lld %lld %lld %.0f %lld %s\n", g.rung, g.stage, g.step,
            g.symbols, g.length, g.budget, g.tests, g.seconds, 1 if CipherAbyss::plain(g) else 0,
            CipherAbyss::stage_name(g))

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for r in -2..<160:
            print_grade(r)
        print_grade(9223372036854775807)
        samples(4)
        samples(8)
        notation(4)
        notation(8)
        families(4)
        families(8)
        invalid_notation()
        return 0.i32()
