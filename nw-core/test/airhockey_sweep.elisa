include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/airhockey_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def pcm(run: AirHockey::Run&, bank: DrShapeAudio::Bank&, start: f64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region audio(524288):
            in audio:
                bytes: mutable u8[8824] = zeroed
                used: i64 = AirHockeyAudio::render(run, bank, start, start + 0.1, &bytes[0], 8824)
                _ = printf("audio %.17g\n", start)
                for j in 0..<used |bytes|:
                    _ = printf("%02x", bytes[j.usize()].i32())
                _ = printf("\n")

def replay(rung: i64, seed: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(2097152):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                game: AirHockey::Game = AirHockey::deal(rung, &draw)
                _ = printf("game %lld %lld %lld %lld %d %u %.17g %lld\n", mode, rung, seed, game.seed,
                    1 if game.valid else 0, py_getrandbits(&draw, 32).u32(), game.serve, game.flip_count)
                for i in 0..<game.flip_count |game|:
                    span: RoomsView::Point = game.flips[i.usize()]
                    _ = printf("%.17g %.17g\n", span.x, span.y)
                run: mutable AirHockey::Run = AirHockey::begin(game)
                if mode > 0:
                    run.wait <- 0.0
                    run.time <- game.level.seconds - 0.01 if mode == 3
                    run.puck <- AirHockey::point(0.0, 1.96) if mode == 1 else AirHockey::point(0.25, 0.04)
                    run.velocity <- AirHockey::point(0.0, 0.5) if mode == 1 else AirHockey::point(0.0, -0.5)
                    run.score[0] <- game.level.need - 1 if mode == 1
                    run.score[1] <- game.level.allow - 1 if mode == 2
                while run.result == AirHockey::LIVE |run, mode|:
                    port: i64 = AirHockey::pilot(&run) if mode == 0 else -1
                    AirHockey::act(&run, port)
                    AirHockey::step(&run, 1.0 / 60.0)
                    _ = printf("%lld %lld %.17g %.17g %d %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %lld %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g %d\n",
                        port, run.result, run.hand.x, run.hand.y, 1 if run.hand.down else 0, run.time,
                        run.mine.x, run.mine.y, run.mine_v.x, run.mine_v.y, run.theirs.x, run.theirs.y,
                        run.theirs_v.x, run.theirs_v.y, run.keeper, run.score[0], run.score[1],
                        run.wait, run.puck.x, run.puck.y, run.velocity.x, run.velocity.y, run.angle,
                        run.clack_at, 1 if AirHockey::far_end(&run) else 0)
                _ = printf("notes %lld\n", run.notes.count.i64())
                for cue in run.notes:
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g %.17g\n",
                        cue.seed, cue.voice, cue.t, cue.dur, cue.freq, cue.gain, cue.pan)
                bank: DrShapeAudio::Bank = AirHockeyAudio::patches()
                pcm(&run, &bank, 0.0)
                pcm(&run, &bank, 1.2)
                pcm(&run, &bank, run.time - 0.04)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in 0..<81:
            g: AirHockey::Grade = AirHockey::grade(rung)
            _ = printf("grade %lld %lld %lld %.17g %.17g %.17g %.17g %d %.17g\n",
                g.rung, g.need, g.allow, g.pace, g.rival, g.mouth, g.swing, 1 if g.flips else 0, g.seconds)
        for rung in [1.i64(), 4.i64(), 7.i64(), 10.i64(), 13.i64(), 16.i64(), 20.i64(), 25.i64(), 30.i64()]:
            replay(rung, 17, 0)
        for mode in 1..<4:
            replay(1, 19, mode)
        return 0
