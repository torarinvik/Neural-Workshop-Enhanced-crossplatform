include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_delay.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def contains(list: Display::DisplayList&, word: cstr) -> bool:
    can Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            input: u8& = word.uintptr().cast[u8&]
            length: i64 = strlen(word).i64()
            for start in 0..<(list.pool.count.i64() - length + 1) |list, input, length|:
                matches: mutable bool = true
                for index in 0..<length |start, list, input, matches|:
                    if list.pool[(start + index).usize()] != input[index.usize()]:
                        matches <- false
                        break
                return true if matches
            return false

def render_has(session: DelayGame::Session&, now: f64, dark: bool, label: cstr, forbidden: cstr = "") -> bool:
    can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneDelay::render(&list, session, now, dark)
        return false if not contains(&list, label)
        return false if strlen(forbidden) > 0.usize() and contains(&list, forbidden)
        encoded: darray[u8] = Display::encode_binary(&list)
        return encoded.count > 64.usize()

def main() -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Unsafe.PointerCast:
        session: mutable DelayGame::Session = DelayGame::initialize(1, 1, false, 17)
        return 1.i32() if not render_has(&session, 0.0, false, "Press Space or click to start")
        return 2.i32() if SceneDelay::hit(&session, 456.0, 340.0) != SceneDelay::START
        _ = DelayGame::start(&session, 0.0)
        return 3.i32() if not render_has(&session, 0.0, false, "Wait 3.0 s")
        port: mutable i64 = SceneDelay::hit(&session, 610.0, 360.0)
        return 4.i32() if port != DelayGame::WAIT or not DelayGame::steer(&session, port, 1.0)
        return 5.i32() if SceneDelay::hit(&session, 610.0, 360.0) != -1
        return 6.i32() if not render_has(&session, 2.25, true, "1.2 s")
        port <- SceneDelay::hit(&session, 300.0, 360.0)
        return 7.i32() if port != DelayGame::TAKE or not DelayGame::steer(&session, port, 2.5)
        return 8.i32() if not render_has(&session, 2.5, false, "next offer ...", "Give up")
        return 9.i32() if SceneDelay::hit(&session, 300.0, 360.0) != -1
        _ = DelayGame::advance(&session, 60.0)
        return 10.i32() if not render_has(&session, 60.0, true, "0 coins (par 90)")
        _ = DelayGame::advance(&session, 63.0)
        return 11.i32() if not render_has(&session, 63.0, true, "0 of 1 passed")
        hidden: mutable DelayGame::Session = DelayGame::initialize(4, 1, false, 17)
        _ = DelayGame::start(&hidden, 0.0)
        return 12.i32() if not render_has(&hidden, 0.0, false, "Wait for it", "Wait 3.0 s")
        _ = printf("PASS: Delay scene labels, hidden waits, both themes, and pointer phases\n")
        return 0.i32()
