include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_railyard.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        session: mutable RailYardGame::Session = RailYardGame::initialize(rung, 1, false, 17)
        if mode != 0:
            _ = RailYardGame::input(&session, RailYardGame::START, 0)
        if mode == 2:
            _ = RailYardGame::input(&session, 0, 0)
        now: mutable i64 = 0
        if mode >= 2:
            stop: i64 = 700 if mode == 2 else (5600 if mode == 3 else 160000)
            while session.phase == RailYardGame::PLAYING and now < stop |session, now, stop|:
                next: i64 = now + 100
                _ = RailYardGame::advance(&session, next, next.f64() / 1000.0 - now.f64() / 1000.0)
                now <- next
        if mode == 5:
            _ = RailYardGame::advance(&session, session.deadline_ms, 0.0)
        _ = printf("frame %lld %lld %lld\n", rung, mode, 1 if dark else 0)
        area: SceneRailYard::Frame = SceneRailYard::frame()
        if session.phase == RailYardGame::PLAYING or session.phase == RailYardGame::JUDGED:
            count: i64 = (1 << session.yard.yard.level.depth) - 1
            for j in 0..<count |area, session|:
                node: RailYard::Node = session.yard.yard.layout.nodes[j.usize()]
                p: RailYard::Point = SceneRailYard::at(area, node.point.x, node.point.y)
                _ = printf("hit %lld %.9g %.9g\n", SceneRailYard::hit(&session, p.x, p.y), p.x, p.y)
            for j in 0..<session.yard.yard.level.portals |area, session|:
                node: RailYard::Node = SceneRailYard::portal_node(&session.yard.yard.layout, j)
                p: RailYard::Point = SceneRailYard::at(area, node.point.x + 3.0, node.point.y + 6.5)
                _ = printf("hit %lld %.9g %.9g\n", SceneRailYard::hit(&session, p.x, p.y), p.x, p.y)
        _ = printf("hit %lld 0 0\n", SceneRailYard::hit(&session, 0.0, 0.0))
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneRailYard::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneRailYard::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 7, 13, 20]:
            for mode in 0..<6 |rung|:
                for dark in 0..<2 |rung, mode|:
                    region scratch(2097152):
                        in scratch:
                            emit(rung, mode, dark != 0)
        return 0.i32()
