# Differential sweep driver for src/scene_hud.elisa.
# See scene_hud_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/display.elisa"
include "../src/scene_hud.elisa"
include "scene_emit.elisa"

const UPDATE: cstr = "An update is available (5.2). Press W to open web site"
const GAME_MODE: cstr = "Dual 2-Back"
const JAEGGI: cstr = "Please disable Jaeggi Mode to access additional modes."
const KEYS: cstr = "I: Select Images\nM: Manual Mode\n\nG: Daily Progress Graph\n\nF11: Full Screen\nESC: Task menu\n"
const VERSION: cstr = "Version 5.1"
const NATIVE: cstr = "native: C"
const TITLE_KEYS: cstr = "SPACE: Task menu\nC: Choose N-Back mode\nS: Choose Sounds\nI: Choose Images\nU: Choose User\nG: Daily Progress Graph\nF11: Full Screen\nO: Edit configuration file"
const CONGRATS: cstr = "Perfect score! N-Back increased"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|black|circles|progress|showing|flashing|lifted|paused|tall")
        region w(64 * 1024 * 1024)
        in w:
            for spec in 0..<24:
                black: bool = spec % 3 == 1
                circles: i64 = 1 + spec % 5
                progress: i64 = spec % (circles + 1)
                # Hidden means drawn in the BACKGROUND at zero alpha rather
                # than not drawn -- the row keeps its place either way.
                showing: bool = spec % 4 != 3
                flashing: bool = spec % 5 == 2
                lifted: bool = spec % 2 == 0
                paused: bool = spec % 7 == 3
                tall: i64 = 1368 if spec % 2 == 0 else 960
                width: f64 = 1824.0
                height: f64 = tall.f64()
                # The field is the square the stimuli appear in: five eighths
                # of the window's height, centred twenty above the middle.
                field_size: f64 = (height * 0.625).i64().f64()
                field_x: f64 = Geometry::width_center(width).f64()
                field_y: f64 = Geometry::from_height_center(height, 20.0).f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(1 if black else 0)
                emit_bar(circles)
                emit_bar(progress)
                emit_bar(1 if showing else 0)
                emit_bar(1 if flashing else 0)
                emit_bar(1 if lifted else 0)
                emit_bar(1 if paused else 0)
                emit_bar(tall)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneHud::Paint = SceneHud::paint_of(black, width, height, field_x, field_y, field_size, 2.0, 2.0)
                SceneHud::put_circles(&list, &paint, circles, progress, showing)
                SceneHud::put_update(&list, &paint, sview(UPDATE, 0, -1))
                SceneHud::put_game_mode(&list, &paint, sview(GAME_MODE, 0, -1), flashing)
                SceneHud::put_jaeggi_warning(&list, &paint, sview(JAEGGI, 0, -1))
                SceneHud::put_keys_list(&list, &paint, sview(KEYS, 0, -1), lifted)
                SceneHud::put_title_message(&list, &paint, sview(VERSION, 0, -1), sview(NATIVE, 0, -1))
                SceneHud::put_title_keys(&list, &paint, sview(TITLE_KEYS, 0, -1))
                SceneHud::put_native_tag(&list, &paint, sview(NATIVE, 0, -1))
                SceneHud::put_logo_words(&list, &paint)
                SceneHud::put_paused(&list, &paint, paused)
                SceneHud::put_congrats(&list, &paint, sview(CONGRATS, 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
