# Differential sweep driver for tasks/counting.elisa. See counting_diff.py for
# the reference side.
#
# Every shape is float output in fractions of the drawing area, emitted as
# scaled integers. What is really being checked is the DRAW ORDER: a line
# rejection-samples for a long enough chord and each failed attempt spends five
# draws, so a divergence in one shape moves every shape after it.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/pymath.elisa"
include "../src/tasks/counting.elisa"

# printr(i64) and int_to_string_scratch both trip a stage1 backend decline of
# store_* generics (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)


def emit_scaled(value: f64):
    can Console.Write, Abort.Panic:
        emit_cell(py_round_half_even(value * 1000000.0))

def emit_shape(shape: Counting::CountShape):
    can Console.Write, Abort.Panic:
        emit_cell(shape.kind)
        emit_cell(shape.points)
        emit_scaled(shape.radius)
        for at in 0..<shape.points |shape|:
            emit_scaled(shape.x[at.usize()])
            emit_scaled(shape.y[at.usize()])

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(64 * 1024 * 1024)
        in w:
            for count in 0..<70:
                printr("clamp")
                emit_cell(count)
                emit_cell(Counting::clamp_shapes(count))
                print("")

            # Every kind on its own, then MIXED -- where the kind is drawn per
            # shape and is therefore part of the stream.
            tangle: mutable Counting::Tangle = Counting::new_tangle()
            for kind in 0..<5 |tangle|:
                for seed in 1..<5 |tangle, kind|:
                    rng: mutable MT19937 = mt19937_new()
                    mt_seed_int(&rng, (kind * 1000 + seed).u64())
                    Counting::generate(&tangle, kind, 12, &rng)
                    printr("gen")
                    emit_cell(kind)
                    emit_cell(seed)
                    emit_cell(tangle.count)
                    for at in 0..<tangle.count |tangle|:
                        emit_shape(tangle.shapes[at.usize()])
                    print("")

            # A long tangle, so the line rejection is hit many times over.
            for seed in 1..<4 |tangle|:
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, (7000 + seed).u64())
                Counting::generate(&tangle, Counting::MIXED, Counting::MAX_SHAPES, &rng)
                printr("long")
                emit_cell(seed)
                emit_cell(tangle.count)
                for at in 0..<tangle.count |tangle|:
                    emit_shape(tangle.shapes[at.usize()])
                print("")

            # The perimeter, on every edge.
            for side in 0..<4:
                for step in 0..<5:
                    along: f64 = step.f64() * 0.25
                    printr("edge")
                    emit_cell(side)
                    emit_cell(step)
                    emit_scaled(Counting::perimeter_x(side, along))
                    emit_scaled(Counting::perimeter_y(side, along))
                    print("")
        destroy w
        return 0
