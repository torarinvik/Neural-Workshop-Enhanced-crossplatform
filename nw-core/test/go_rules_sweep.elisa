# Rule fixtures for the original one-move Go rules, including captures at the
# edge and corner, occupied/suicide rejection, and the stateless ko replay.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/pyset.elisa"
include "../src/tasks/go.elisa"

def print_i64(value: i64):
    can Global{Read,Write}, Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_case(name: cstr, size: i64, x: i64, y: i64, colour: i64,
              source: mutable darray[i64]&):
    can Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic:
        work: mutable Go::GoWork = Go::GoWork()
        work.size <- size
        work.cells <- size * size
        board: mutable darray[i64] = Ints::zeros(size * size)
        result: mutable darray[i64] = Ints::zeros(size * size)
        cell: mutable i64 = 0
        while cell < work.cells |cell, work, source|:
            Ints::put(&board, cell, Ints::at_ref(source, cell))
            cell <- cell + 1
        legal: bool = Go::play(&work, &board, x, y, colour, &result)
        printr(name)
        printr(",1" if legal else ",0")
        if legal:
            cell <- 0
            while cell < work.cells |cell, work|:
                printr(",")
                print_i64(Ints::at(result, cell))
                cell <- cell + 1
        print("")

def main() -> i64:
    can Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic:
        region w(32 * 1024 * 1024)
        in w:
            edge: mutable darray[i64] = Ints::zeros(25)
            Ints::put(&edge, 10, 2)
            Ints::put(&edge, 11, 1)
            Ints::put(&edge, 5, 1)
            emit_case("edge_capture", 5, 0, 3, 1, &edge)

            corner: mutable darray[i64] = Ints::zeros(25)
            Ints::put(&corner, 0, 2)
            Ints::put(&corner, 1, 1)
            emit_case("corner_capture", 5, 0, 1, 1, &corner)

            occupied: mutable darray[i64] = Ints::zeros(25)
            Ints::put(&occupied, 12, 1)
            emit_case("occupied", 5, 2, 2, 1, &occupied)

            suicide: mutable darray[i64] = Ints::zeros(25)
            Ints::put(&suicide, 11, 2)
            Ints::put(&suicide, 13, 2)
            Ints::put(&suicide, 7, 2)
            Ints::put(&suicide, 17, 2)
            emit_case("suicide", 5, 2, 2, 1, &suicide)

            ko: mutable darray[i64] = Ints::zeros(25)
            Ints::put(&ko, 6, 2)
            Ints::put(&ko, 8, 2)
            Ints::put(&ko, 2, 2)
            Ints::put(&ko, 11, 1)
            Ints::put(&ko, 13, 1)
            Ints::put(&ko, 17, 1)
            Ints::put(&ko, 12, 2)
            emit_case("ko_capture", 5, 2, 1, 1, &ko)

            ko_after: mutable darray[i64] = Ints::zeros(25)
            Ints::put(&ko_after, 6, 2)
            Ints::put(&ko_after, 8, 2)
            Ints::put(&ko_after, 2, 2)
            Ints::put(&ko_after, 11, 1)
            Ints::put(&ko_after, 13, 1)
            Ints::put(&ko_after, 17, 1)
            Ints::put(&ko_after, 7, 1)
            emit_case("ko_recapture", 5, 2, 2, 2, &ko_after)
        destroy w
        return 0
