include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_desktop.elisa"

# Desktop runs played through the game layer, with frames' display lists
# and where a grid of pixels lands on the screen; desktop_scene_diff.py
# draws the same with ui/desktop.py.
extern printf(format: cstr, ...) -> i32 can[Console.Write]

def dump(list: Display::DisplayList&):
    can Console.Write, Abort.Panic:
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n", cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(),
                    cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")

def frame(session: mutable DesktopGame::Session&, label: i64, dark: bool):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        _ = printf("frame %lld %lld %lld %lld %lld %lld %lld %lld\n", label, session.phase, session.ladder.rung,
            session.ladder.trial, session.ladder.wins, session.ladder.best_rung, session.verdict,
            session.desk.clicks if DesktopGame::live(session) else 0)
        region scratch(16777216):
            in scratch:
                list: mutable Display::DisplayList = Display::DisplayList()
                SceneDesktop::render(&list, session, dark)
                dump(&list)

# Where a coarse grid of pixels lands on the screen.
def grid():
    can Console.Write, Abort.Panic:
        _ = printf("grid")
        for row in 0..<36:
            for column in 0..<48 |row|:
                point: SceneDesktop::Point = SceneDesktop::model_point(4.5 + column.f64() * 19.0, 2.5 + row.f64() * 19.0)
                if point.inside:
                    _ = printf(" %.6f %.6f", point.x, point.y)
                else:
                    _ = printf(" -")
        _ = printf("\n")

# One reference action through the game: a drag is pressed, moved (a
# frame shows its preview) and let go.
def act(game: mutable DesktopGame::Session&, step: DesktopReference::Action, now: f64, dark: bool, label: i64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        _ = DesktopGame::point_at(game, step.x.f64(), step.y.f64(), now)
        if step.kind == DesktopReference::CLICK:
            _ = DesktopGame::click(game, now)
            return
        _ = DesktopGame::press(game, now)
        _ = DesktopGame::point_at(game, step.to_x.f64(), step.to_y.f64(), now)
        frame(game, label, dark)
        _ = DesktopGame::release(game, now)

# The reference to the end, framing every `every`th action; with
# `early` Done goes one action before the end.
def finish(game: mutable DesktopGame::Session&, start: f64, dark: bool, every: i64, early: bool, label: i64) -> f64:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        now: mutable f64 = start
        for step in 0..<3000 |game, now, dark, every, early, label|:
            break if game.phase != DesktopGame::WORKING
            action: DesktopReference::Action = DesktopReference::action(&game.desk)
            now <- now + 0.25
            if action.kind != DesktopReference::CLICK and action.kind != DesktopReference::DRAG:
                _ = DesktopGame::steer(game, DesktopGame::FINISH, now)
            elif early and DesktopFiles::solved(&game.desk) == false and step > 2 and step % 7 == 3:
                _ = DesktopGame::steer(game, DesktopGame::FINISH, now)
            else:
                act(game, action, now, dark, label + 1)
            frame(game, label, dark) if step % every == 0 or game.phase != DesktopGame::WORKING
        return now

def run(rung: i64, seed: i64, dark: bool):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        _ = printf("run %lld %lld %lld\n", rung, seed, 1 if dark else 0)
        game: mutable DesktopGame::Session = DesktopGame::initialize(rung, 3, true, seed)
        frame(&game, 0, dark)
        _ = DesktopGame::start(&game, 0.0) can Global{Read,Write}
        frame(&game, 1, dark)
        now: mutable f64 = 0.0
        for trial in 0..<3 |game, now, dark|:
            if trial == 0:
                now <- finish(&game, now, dark, 3, false, 10)
            elif trial == 1:
                # Ports, a right click, a title bar dragged, then the reference.
                for port in [0, 4, 8, 10, 1, 12, 16, 12, 5, 13, 3, 3, 14, 7, 12] |game, now, dark|:
                    now <- now + 0.25
                    _ = DesktopGame::steer(&game, port, now)
                    frame(&game, 12, dark)
                top: i64 = game.desk.order[(game.desk.order.count - 1.usize())]
                win: DesktopState::Window = game.desk.windows[top.usize()]
                _ = DesktopGame::point_at(&game, win.x + 40.0, win.y + 12.0, now)
                _ = DesktopGame::press(&game, now)
                _ = DesktopGame::point_at(&game, win.x + 95.0, win.y + 47.0, now)
                frame(&game, 13, dark)
                _ = DesktopGame::release(&game, now)
                frame(&game, 14, dark)
                now <- finish(&game, now, dark, 5, false, 20)
            else:
                now <- finish(&game, now, dark, 5, true, 30)
            frame(&game, 6, dark)
            now <- now + 3.0
            _ = DesktopGame::advance(&game, now) can Global{Read,Write}
            frame(&game, 7, dark)
        _ = printf("over\n")

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        for rung in [1, 2, 3, 4, 5, 6, 8, 11, 13, 15, 16, 18, 20, 25, 30]:
            note: mutable dstr = []
            SceneDesktop::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        grid()
        region fixtures(268435456):
            in fixtures:
                for rung in [1, 3, 6, 8, 11, 13, 15, 16, 18, 20, 25, 30]:
                    run(rung, rung * 7 + 1, rung % 2 == 1) can Global{Read,Write}
        return 0.i32()
