include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_damkeeper.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, 17.u64())
        level: DamKeeper::Grade = DamKeeper::grade(rung)
        valley: DamKeeper::Valley = DamKeeper::build(level, &rng)
        session: mutable DamKeeperGame::Session = DamKeeperGame::initialize(rung, 1, false, 17)
        DamKeeper::reset(&session.run, valley)
        session.trial <- 1
        session.phase <- DamKeeperGame::PLAYING
        session.run.t <- valley.storms[0].start - 2.5 if mode == 0 else valley.storms[0].start + 4.0
        if mode > 0:
            for _j in 0..<3 |session|:
                _ = DamKeeper::press(&session.run, 0)
            for _j in 0..<30 |session|:
                DamKeeper::step(&session.run, DamKeeper::SUBSTEP)
        _ = printf("frame %lld %lld %lld\n", rung, mode, 1 if dark else 0)
        for k in 0..<level.dams |session, level|:
            gx: f64 = SceneDamKeeper::x(SceneDamKeeper::dam(k, level.dams))
            gy: f64 = SceneDamKeeper::y(SceneDamKeeper::bed(k) + 8.0)
            _ = printf("hit %lld %lld\n", SceneDamKeeper::hit(&session, gx, gy + 1.0), SceneDamKeeper::hit(&session, gx, gy))
        _ = printf("miss %lld\n", SceneDamKeeper::hit(&session, 20.0, 20.0))
        if mode == 2:
            session.run.town <- 6.0
            session.run.result <- DamKeeper::FLOODED
            session.phase <- DamKeeperGame::JUDGED
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneDamKeeper::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
        for level in 0..<3:
            rung: i64 = [1, 16, 30][level.usize()]
            for mode in 0..<3 |rung|:
                for dark in 0..<2 |rung, mode|:
                    region scratch(1048576):
                        in scratch:
                            emit(rung, mode, dark != 0)
        return 0.i32()
