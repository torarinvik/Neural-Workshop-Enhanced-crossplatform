include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_airtraffic.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        session: mutable AirTrafficGame::Session = AirTrafficGame::initialize(rung, 1, false, 17)
        if mode != 0:
            _ = AirTrafficGame::input(&session, AirTrafficGame::START, 0)
        now: mutable i64 = 0
        if mode >= 2:
            stop: i64 = 5000 if mode == 2 or mode == 3 else 180000
            while session.phase == AirTrafficGame::PLAYING and now < stop |session, now, stop, mode|:
                if now == 3200 and (mode == 2 or mode == 3):
                    _ = AirTrafficGame::input(&session, 0, now)
                    _ = AirTrafficGame::input(&session, AirTraffic::SLOTS + (AirTraffic::HOLD if mode == 2 else AirTraffic::LAND), now)
                next: i64 = now + 100
                _ = AirTrafficGame::advance(&session, next, next.f64() / 1000.0 - now.f64() / 1000.0)
                now <- next
        if mode == 5:
            _ = AirTrafficGame::advance(&session, session.deadline_ms, 0.0)
        _ = printf("frame %lld %lld %lld\n", rung, mode, 1 if dark else 0)
        area: SceneAirTraffic::Frame = SceneAirTraffic::frame()
        if session.phase == AirTrafficGame::PLAYING or session.phase == AirTrafficGame::JUDGED:
            for i in 0..<session.airspace.active |area, session|:
                plane: AirTraffic::Plane = session.airspace.planes[i.usize()]
                p: AirTraffic::Point = SceneAirTraffic::at(area, plane.x, plane.y)
                _ = printf("hit %lld %.9g %.9g\n", SceneAirTraffic::hit(&session, p.x, p.y), p.x, p.y)
            for i in 0..<session.airspace.sky.level.runways |area, session|:
                runway: AirTraffic::Runway = session.airspace.sky.runways[i.usize()]
                p: AirTraffic::Point = SceneAirTraffic::at(area, runway.point.x, runway.point.y)
                _ = printf("hit %lld %.9g %.9g\n", SceneAirTraffic::hit(&session, p.x, p.y), p.x, p.y)
        _ = printf("hit %lld 0 0\n", SceneAirTraffic::hit(&session, 0.0, 0.0))
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneAirTraffic::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneAirTraffic::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 7, 16, 30]:
            for mode in 0..<6 |rung|:
                for dark in 0..<2 |rung, mode|:
                    region scratch(2097152):
                        in scratch:
                            emit(rung, mode, dark != 0)
        return 0.i32()
