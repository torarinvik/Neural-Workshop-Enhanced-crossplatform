include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_kerbside.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# The street Kerbside draws, for kerbside_scene_diff.py: at the start, two
# and six seconds into the autopilot's crossing, at its end, and where a
# walker who does not listen is struck; then the options notes.

def emit(rung: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        session: mutable KerbsideGame::Session = KerbsideGame::initialize(rung, 1, true, 17)
        _ = KerbsideGame::start(&session, 0.0)
        frames: i64 = 0 if mode == 0 else (20 if mode == 1 else (60 if mode == 2 else 4000))
        for frame in 1..<(frames + 1) |session, mode|:
            break if session.phase != KerbsideGame::PLAYING
            port: i64 = Kerbside::FORWARD if mode == 4 else Kerbside::pilot(&session.run)
            _ = KerbsideGame::input(&session, port)
            _ = KerbsideGame::advance(&session, frame.f64() / 10.0)
        _ = printf("frame %lld %lld %lld\n", rung, mode, session.run.result)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneKerbside::street(&list, &session.run)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")
        KerbsideGame::close(&session)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneKerbside::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 4, 7, 10, 30]:
            for mode in 0..<5 |rung|:
                region scratch(2097152):
                    in scratch:
                        emit(rung, mode)
        return 0.i32()
