include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_unicycle.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        session: mutable UnicycleGame::Session = UnicycleGame::initialize(rung, 1, true, 17)
        if mode != 0:
            _ = UnicycleGame::start(&session, 0.0)
        if mode == 2:
            _ = UnicycleGame::key(&session, 0, true)
            _ = UnicycleGame::key(&session, 4, true)
            _ = UnicycleGame::key(&session, 2, true)
            for k in 1..<14 |session|:
                if k == 3:
                    _ = UnicycleGame::key(&session, 0, false)
                if k == 7:
                    _ = UnicycleGame::key(&session, 3, true)
                if k == 9:
                    _ = UnicycleGame::clear_keys(&session)
                _ = UnicycleGame::advance(&session, 0.025 * k.f64())
        if mode == 3 or mode == 4:
            x: f64 = session.run.track.finish - 2.0
            y: f64 = Unicycle::ground(&session.run.track, x)
            session.run.body.px <- x
            session.run.body.py <- y + 0.35
            session.run.body.qx <- x + 0.15
            session.run.body.qy <- y + 1.3
            session.run.body.a <- 0.9
            session.run.t <- 5.0
            if mode == 4:
                session.run.result <- Unicycle::CLEAR
                UnicycleGame::judge(&session, 0.0)
        if mode == 5 or mode == 6:
            session.run.body.qy <- 0.1
            if mode == 6:
                session.run.body.py <- -0.4
                session.run.body.qy <- 0.08
            _ = UnicycleGame::advance(&session, 0.0)
        if mode == 7:
            session.run.t <- session.run.track.seconds + 0.1
            _ = UnicycleGame::advance(&session, 0.0)
        if mode == 8:
            session.run.body.qy <- 0.1
            _ = UnicycleGame::advance(&session, 0.0)
            _ = UnicycleGame::advance(&session, 2.5)
        _ = printf("frame %lld %lld %lld\n", rung, mode, 1 if dark else 0)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneUnicycle::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneUnicycle::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 4, 13, 30]:
            for mode in 0..<9 |rung|:
                for dark in 0..<2 |rung, mode|:
                    region scratch(2097152):
                        in scratch:
                            emit(rung, mode, dark != 0)
        return 0.i32()
