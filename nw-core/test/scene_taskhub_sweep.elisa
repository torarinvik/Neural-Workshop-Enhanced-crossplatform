# Differential sweep driver for src/scene_taskhub.elisa.
# See scene_taskhub_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/textmetrics.elisa"
include "../src/display.elisa"
include "../src/taskhub_tasks.elisa"
include "../src/scene_taskhub.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|black|category|selected|tall")
        region w(256 * 1024 * 1024)
        in w:
            # Every category at every window height, with the selection
            # walking the grid -- so every card is the picked one at least
            # once and the row arithmetic is exercised at one, two and five
            # rows.
            for spec in 0..<56:
                black: bool = spec % 3 == 1
                category: i64 = spec % TaskHubTasks::CATEGORY_COUNT
                tasks: i64 = TaskHubTasks::task_count(category)
                selected: i64 = spec % (tasks if tasks > 0 else 1)
                tall: i64 = 1368 if spec % 2 == 0 else 960
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(1 if black else 0)
                emit_bar(category)
                emit_bar(selected)
                emit_bar(tall)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneTaskHub::HubPaint = SceneTaskHub::paint_of(black, width, height, 2.0, 2.0)
                SceneTaskHub::render(&list, &paint, category, selected)
                emit_frame(&list)
                print("end")
        destroy w
        return 0
