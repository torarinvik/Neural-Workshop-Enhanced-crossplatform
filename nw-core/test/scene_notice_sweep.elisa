# Differential sweep driver for src/scene_notice.elisa.
# See scene_notice_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/display.elisa"
include "../src/scene_notice.elisa"
include "scene_emit.elisa"

const NOTICE: cstr = "The image library is empty. See the Readme for how to point the workshop at a folder of pictures."
const TITLE: cstr = "Enter a name for the new user"
const TYPED: cstr = "torarin"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|which|black|left|cursor_at|cursor_visible|tall")
        region w(64 * 1024 * 1024)
        in w:
            for spec in 0..<24:
                which: i64 = spec % 3
                black: bool = spec % 2 == 1
                on_the_left: bool = (spec / 3) % 2 == 0
                # The caret walks the typed text, including both ends.
                cursor_at: i64 = (spec / 3) % 8
                cursor_visible: bool = (spec / 6) % 2 == 0
                tall: i64 = 1368 if spec % 2 == 0 else 960
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(which)
                emit_bar(1 if black else 0)
                emit_bar(1 if on_the_left else 0)
                emit_bar(cursor_at)
                emit_bar(1 if cursor_visible else 0)
                emit_bar(tall)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                if which == 0:
                    SceneNotice::put_message(&list, sview(NOTICE, 0, -1),
                                             black, width, height, 2.0, 2.0)
                elif which == 1:
                    SceneNotice::put_saccadic(&list, on_the_left, width,
                                              height, 2.0, 2.0)
                else:
                    SceneNotice::put_prompt(&list, sview(TITLE, 0, -1),
                                            sview(TYPED, 0, -1), cursor_at,
                                            cursor_visible, black, width,
                                            height, 2.0, 2.0)
                emit_frame(&list)
                print("end")
        destroy w
        return 0
