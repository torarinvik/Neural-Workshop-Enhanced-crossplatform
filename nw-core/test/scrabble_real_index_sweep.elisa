# Optional real-index check. The Python driver supplies this temporary path.
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_fileio.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/strings.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/crossword.elisa"
include "../src/tasks/crossword_lexicon.elisa"
include "../src/tasks/scrabble.elisa"
include "../src/tasks/scrabble_lexicon.elisa"

def print_number(value: i64):
    can Console.Write, Global.Read, Global.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            at: mutable i64 = 23
            left: mutable i64 = 0 - value if value < 0 else value
            if left == 0:
                at <- 22
                buf[22] <- 48
            else:
                while left > 0 |buf, at, left|:
                    at <- at - 1
                    buf[at] <- (48 + left % 10).u8()
                    left <- left / 10
            if value < 0:
                at <- at - 1
                buf[at] <- 45
            printr((&buf[at]).cast[cstr])

def emit_number(value: i64):
    can Console.Write, Global.Read, Global.Write, Abort.Panic:
        printr(",")
        print_number(value)

def main() -> i64:
    can Console.Write, Global.Read, Global.Write, Memory.Allocate, Memory.Release, Blocking.IO, Abort.Panic:
        region work(268435456)
        in work:
            arena: mutable Arena& = (&work).cast[mutable Arena&]
            body: cstr = try read_entire_file_cstr(arena, "/tmp/nw_scrabble_real_index.tsv") else "".cast[cstr]
            text: sview = sview(body, 0, string_len(body))
            return 1 if sview_len(text) == 0.usize()
            full: ScrabbleLexicon::ScrabbleIndexStats = ScrabbleLexicon::inspect(text, 1073741824, 15)
            return 4 if not full.valid or full.words == 0
            all_words: mutable Scrabble::ScrabbleLexiconData = Scrabble::new_lexicon_sized(full.words, full.letters)
            ScrabbleLexicon::read_scrabble_index(text, 1073741824, 15, &all_words)
            last: i64 = all_words.count - 1
            first_letter: i64 = Ints::at_ref(&all_words.start, last)
            word_length: i64 = Ints::at_ref(&all_words.length, last)
            sample: mutable darray[i64] = Ints::zeros(word_length)
            for digit in 0..<word_length |sample, all_words, first_letter|:
                Ints::put(&sample, digit, Ints::at_ref(&all_words.letter, first_letter + digit))
            return 5 if not Scrabble::valid(&all_words, &sample, 0, word_length)
            printr("capacity")
            emit_number(full.words)
            emit_number(full.letters)
            print("")
            for rung in 1..<3 |text|:
                grade: Scrabble::ScrabbleGrade = Scrabble::grade_of(rung)
                stats: ScrabbleLexicon::ScrabbleIndexStats = ScrabbleLexicon::inspect(text, grade.top_rank, grade.size)
                return 2 if not stats.valid or stats.words == 0
                lex: mutable Scrabble::ScrabbleLexiconData = Scrabble::new_lexicon_sized(stats.words, stats.letters)
                ScrabbleLexicon::read_scrabble_index(text, grade.top_rank, grade.size, &lex)
                board: mutable Scrabble::ScrabbleBoard = Scrabble::new_board()
                work: mutable Scrabble::ScrabbleWork = Scrabble::new_work()
                plays: mutable Scrabble::ScrabblePlays = Scrabble::new_plays()
                rack: mutable darray[i64] = Ints::zeros(Scrabble::RACK)
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, 17.u64())
                deal: Scrabble::ScrabbleSeededDeal = Scrabble::deal_one(&board, &work, &lex, grade, &rng, &rack, &plays)
                return 3 if deal.overflow
                print_number(rung)
                emit_number(stats.words)
                emit_number(stats.letters)
                emit_number(1 if deal.dealt else 0)
                if deal.dealt:
                    for cell in 0..<(grade.size * grade.size) |board|:
                        emit_number(Ints::at_ref(&board.letters, cell))
                    emit_number(deal.rack_n)
                    for at in 0..<deal.rack_n |rack|:
                        emit_number(Ints::at_ref(&rack, at))
                    emit_number(Ints::at_ref(&plays.score, deal.best))
                    emit_number(Ints::at_ref(&plays.down, deal.best))
                    start: i64 = Ints::at_ref(&plays.word_at, deal.best)
                    length: i64 = Ints::at_ref(&plays.word_length, deal.best)
                    emit_number(length)
                    for at in 0..<length |plays, start|:
                        emit_number(Ints::at_ref(&plays.word_letter, start + at))
                print("")
        destroy work
        return 0
