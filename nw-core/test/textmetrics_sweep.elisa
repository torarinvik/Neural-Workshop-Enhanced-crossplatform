# Differential sweep driver for src/textmetrics.elisa.
#
# The reference side is pyglet itself: a real Label is built at each size and
# its content_width and content_height read back. Nothing is lifted, because
# the thing being checked IS the toolkit's own measurement.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/strings.elisa"
include "../src/textmetrics.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

# Mirrored, in order, by TEXTS in textmetrics_diff.py. A chain and not an
# array because a table of cstr is not a type this compiler has.
const TEXT_COUNT: i64 = 16

def text_of(which: i64) -> cstr:
    if which == 0:
        return ""
    elif which == 1:
        return " "
    elif which == 2:
        return "\n"
    elif which == 3:
        return "a"
    elif which == 4:
        return "a b"
    elif which == 5:
        return "aaaa"
    elif which == 6:
        return "the quick brown fox"
    elif which == 7:
        return "supercalifragilisticexpialidocious"
    elif which == 8:
        return "aa bbbbbbbbbb cc"
    elif which == 9:
        return "aaa bbb"
    elif which == 10:
        return "  a  b  "
    elif which == 11:
        return "a\n\nb"
    elif which == 12:
        return "\na"
    elif which == 13:
        return "one two three four five six seven eight"
    elif which == 14:
        return "brown-fox don't x. (y) 1,000 end."
    elif which == 15:
        return "ggggggggggggg hi the quick a bb ccc dddd eeeee"
    return ""

def main() -> i64:
    can Console.Write, Abort.Panic:
        # Every tenth of a point from 5.0 to 60.0, which is the whole range the
        # chrome and the boards between them ask for.
        for tenths in 50..<601:
            size: f64 = tenths.f64() / 10.0
            printr("m")
            emit_cell(tenths)
            emit_cell(TextMetrics::advance(size))
            emit_cell(TextMetrics::line_height(size))
            for characters in [1, 2, 7, 10, 64]:
                emit_cell(TextMetrics::text_width(size, characters))
            for lines in [1, 2, 3, 5, 8]:
                emit_cell(TextMetrics::text_height(size, lines))
            print("")

        # The wrapping half. A label that wraps is measured by where pyglet
        # decided to break it, so the cases are chosen to sit on the decisions
        # rather than to look like prose: a width narrower than one glyph, a
        # word with no break in it at all, a line that fills the width
        # EXACTLY, trailing and doubled spaces, and forced newlines including
        # an empty one.
        for which in 0..<TEXT_COUNT:
            text: sview = sview(text_of(which), 0, -1)
            for tenths in [80, 100, 120, 220]:
                size: f64 = tenths.f64() / 10.0
                for cols in [1, 2, 3, 4, 5, 8, 13, 40, 97]:
                    width: f64 = (cols * TextMetrics::advance(size)).f64()
                    printr("w")
                    emit_cell(which)
                    emit_cell(tenths)
                    emit_cell(cols)
                    emit_cell(TextMetrics::wrapped_width(size, text, width))
                    emit_cell(TextMetrics::wrapped_lines(size, text, width))
                    emit_cell(TextMetrics::wrapped_height(size, text, width))
                    print("")
        return 0
