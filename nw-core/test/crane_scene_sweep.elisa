include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_crane.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read:
        session: mutable CraneGame::Session = CraneGame::initialize(rung, 1, true, 17)
        if mode != 0:
            _ = CraneGame::start(&session, 0.0)
        if mode >= 2:
            _ = CraneGame::key(&session, 1, true)
            for k in 1..<13 |session|:
                _ = CraneGame::advance(&session, k.f64() * 0.125)
            _ = CraneGame::clear_keys(&session)
        if mode >= 3:
            # Preserve the production placement, hooks and contact queries,
            # then place the trolley precisely for each visual checkpoint.
            item: i64 = CraneReference::next_box(&session.run)
            at: Crane::Position = Crane::box_rect(&session.run, item)
            session.run.x <- at.x
            session.run.v <- 0.0
            session.run.theta <- 0.0
            session.run.omega <- 0.0
            session.run.cable <- Crane::RAIL - (at.y + Crane::BOX_H)
            if mode >= 4:
                Crane::grab(&session.run)
                session.run.theta <- 0.08
                session.run.omega <- -0.15
                session.run.cable <- 6.0
            if mode >= 5:
                bay: i64 = CraneReference::bay_for(&session.run, session.run.yard.boxes[item.usize()].colour)
                session.run.x <- session.run.yard.bays[bay.usize()].x
                session.run.theta <- 0.0
                session.run.omega <- 0.0
                session.run.cable <- Crane::RAIL - (Crane::BOX_H + (3.0 if mode == 5 else 0.0))
                Crane::grab(&session.run)
                if mode == 6:
                    session.run.placed <- session.run.yard.level.boxes
                if mode != 7:
                    _ = CraneGame::advance(&session, 1.5)
                if mode == 8:
                    _ = CraneGame::advance(&session, 4.5)
        _ = printf("frame %lld %lld %lld\n", rung, mode, 1 if dark else 0)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneCrane::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneCrane::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 13, 20, 30]:
            for mode in 0..<9 |rung|:
                for dark in 0..<2 |rung, mode|:
                    region scratch(2097152):
                        in scratch:
                            emit(rung, mode, dark != 0)
        return 0.i32()
