include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/crossroads_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def sweep(rung: i64, seed: i64):
    can Abort.Panic, Console.Write, Memory.Allocate:
        town: Crossroads::Town = Crossroads::deal_seed(rung, seed)
        g: Crossroads::Grade = town.level
        _ = printf("town %lld %lld %.17g %.17g %lld %lld %.17g %lld %lld\n", g.rung, g.layout, g.rate,
            g.lopsided, g.ambulances, g.rush.i64(), g.seconds, town.path_count, town.arrivals.count.i64())
        for j in 0..<g.layout |town|:
            at: Crossroads::Junction = town.junctions[j.usize()]
            _ = printf("junction %.17g %.17g %lld\n", at.x, at.y, town.start_green[j.usize()])
        for j in 0..<town.path_count |town|:
            path: Crossroads::Path = town.paths[j.usize()]
            _ = printf("path %.17g %.17g %lld %lld %.17g %lld %lld\n", path.x, path.y,
                path.dx, path.dy, path.length, path.count, path.axis)
            for k in 0..<path.count |path|:
                cross: Crossroads::Crossing = path.crosses[k.usize()]
                _ = printf("cross %.17g %lld\n", cross.at, cross.junction)
        for event in town.arrivals:
            _ = printf("arrival %.17g %lld %lld\n", event.time, event.path, event.ambulance.i64())
        for policy in 0..<2 |town|:
            run: mutable Crossroads::Run = Crossroads::initialize(&town)
            while run.result == Crossroads::LIVE |run, policy|:
                mask: i64 = Crossroads::autopilot(&run) if policy == 1 else 0
                for j in 0..<run.town.level.layout |run, mask|:
                    if (mask & (1 << j)) != 0:
                        _ = Crossroads::toggle(&run, j)
                _ = Crossroads::step(&run, 1.0 / 30.0)
                _ = printf("tick %lld %.17g %lld %lld %lld %.17g\n", mask, run.elapsed,
                    run.result, run.served, run.car_count, run.total_wait)
                for i in 0..<run.town.level.layout |run|:
                    lamp: Crossroads::Light = run.lights[i.usize()]
                    _ = printf("light %lld %lld %.17g\n", lamp.green, lamp.changing.i64(), lamp.since)
                for i in 0..<run.town.path_count |run|:
                    _ = printf("queue %lld\n", run.backlog[i.usize()])
                for i in 0..<run.car_count |run|:
                    car: Crossroads::Car = run.cars[i.usize()]
                    _ = printf("car %lld %.17g %.17g %lld %.17g %lld %.17g\n",
                        car.path, car.s, car.v, car.ambulance.i64(), car.waited, car.colour, car.born)

def summary(session: CrossroadsGame::Session&):
    can Abort.Panic, Console.Write:
        _ = printf("session %lld %lld %lld %lld %lld %lld %lld %.17g\n",
            session.phase, session.rung, session.trial, session.wins, session.best_rung,
            session.verdict, session.traffic.served, session.traffic.elapsed)

def lifecycle():
    can Abort.Panic, Console.Write, Memory.Allocate, Memory.Release:
        session: mutable CrossroadsGame::Session = CrossroadsGame::initialize(13, 2, true, -17)
        _ = CrossroadsGame::input(&session, CrossroadsGame::START, 0) can Global{Read,Write}
        summary(&session)
        now: mutable i64 = 0
        for trial in 0..<2 |session, now|:
            while session.phase == CrossroadsGame::PLAYING |session, now, trial|:
                if trial == 0:
                    mask: i64 = Crossroads::autopilot(&session.traffic)
                    for j in 0..<session.traffic.town.level.layout |session, mask, now|:
                        if (mask & (1 << j)) != 0:
                            _ = CrossroadsGame::input(&session, j, now) can Global{Read,Write}
                next: i64 = now + (250 if session.traffic.elapsed == 0.0 else 50)
                _ = CrossroadsGame::advance(&session, next, next.f64() / 1000.0 - now.f64() / 1000.0) can Global{Read,Write}
                now <- next
                summary(&session)
            _ = CrossroadsGame::advance(&session, now + 2999, 2.999) can Global{Read,Write}
            summary(&session)
            now <- now + 3000
            _ = CrossroadsGame::advance(&session, now, 3.0) can Global{Read,Write}
            summary(&session)
        _ = CrossroadsGame::input(&session, CrossroadsGame::START, now + 1) can Global{Read,Write}
        summary(&session)
        CrossroadsGame::close(&session) can Global{Read,Write}

def main() -> i32:
    can Abort.Panic, Console.Write, Memory.Allocate, Memory.Release:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25]:
            region scratch(2097152):
                in scratch:
                    sweep(rung, 17)
        lifecycle() can Global{Read,Write}
        return 0.i32()
