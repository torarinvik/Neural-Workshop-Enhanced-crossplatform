# Differential sweep for src/screen.elisa against neural_workshop/events.py's
# `on_draw`. See screen_diff.py for the reference side.
#
# A spec is the four flags the dispatch branches on, the clinical build flag
# and a feedback-label count; the frame is the layers it puts on screen, in
# order. Every combination of the six is walked rather than a sample: there are
# only ninety-six of them, and the interesting ones are the contradictory
# states -- graph AND title at once, a started session on the title screen --
# which a sampled sweep would be the first thing to miss.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/strings.elisa"
include "../src/gamemode.elisa"
include "../src/screen.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr("|")
        print_i64(value)

def flag(value: bool) -> i64:
    return 1 if value else 0

# Only the fields the dispatch reads carry a spec's state.
def blank_mode() -> Mode:
    rts: f64[15] = zeroed
    stim: i64[13] = zeroed
    return Mode{mode: 2, back: 2, ticks_per_trial: 6,
                ticks_per_trial_is_float: false,
                num_trials: 20, num_trials_factor: 1, num_trials_exponent: 2,
                num_trials_total: 24, manual: true, inputs: zeroed,
                input_rts: rts, hide_text: false, current_stim: stim,
                current_operation: ArithOp.NoneOp,
                started: false, paused: false, show_missed: false,
                sound_select: false, draw_graph: false, saccadic: false,
                title_screen: false, session_number: 1, trial_number: 0,
                trial_starttime: 0.0, tick: 0, progress: 0,
                phase: TrialPhase.NotStarted, phase_elapsed: 0,
                step_mode: false, frame_seq: 0, session_done: false}

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|draw_graph|saccadic|title_screen|started|clinical|labels")
        spec: mutable i64 = 0
        for graph_bit in 0..<2 |spec|:
            for saccadic_bit in 0..<2 |spec, graph_bit|:
                for title_bit in 0..<2 |spec, graph_bit, saccadic_bit|:
                    for started_bit in 0..<2 |spec, graph_bit, saccadic_bit, title_bit|:
                        for clinical_bit in 0..<2 |spec, graph_bit, saccadic_bit, title_bit, started_bit|:
                            for labels in 0..<3 |spec, graph_bit, saccadic_bit, title_bit, started_bit, clinical_bit|:
                                game: mutable Mode = blank_mode()
                                game.draw_graph <- graph_bit == 1
                                game.saccadic <- saccadic_bit == 1
                                game.title_screen <- title_bit == 1
                                game.started <- started_bit == 1
                                screen: ScreenState = screen_state(clinical_bit == 1, labels)

                                printr("spec|")
                                print_i64(spec)
                                emit_cell(graph_bit)
                                emit_cell(saccadic_bit)
                                emit_cell(title_bit)
                                emit_cell(started_bit)
                                emit_cell(clinical_bit)
                                emit_cell(labels)
                                print("")
                                spec <- spec + 1

                                layers: darray[i64] = frame_layers(&game, &screen)
                                for one in layers:
                                    print_i64(one)
                                    print("")
                                # The batch's own line, so a branch that put
                                # the board on screen without a layer for it
                                # could not pass by printing nothing.
                                printr("batch|")
                                print_i64(flag(batch_on_screen(&game)))
                                print("")
                                print("end")
        return 0
