include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_fileio.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/tasks/crossword.elisa"
include "../src/tasks/crossword_lexicon.elisa"
include "../src/tasks/scramble.elisa"
include "../src/tasks/scramble_corpus.elisa"

def print_number(value: i64):
    can Console.Write, Global.Read, Global.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            at: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                at <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    at <- at - 1
                    buf[at.usize()] <- (48 + (0 - digit if digit < 0 else digit)).u8()
                    n <- n / 10
                if negative:
                    at <- at - 1
                    buf[at.usize()] <- 45
            printr((&buf[at.usize()]).cast[cstr])

def report(text: sview, limit: i64):
    can Console.Write, Global.Read, Global.Write, Memory.Allocate, Abort.Panic:
        stats: ScrambleCorpus::ScrambleCorpusStats = ScrambleCorpus::inspect(text, limit)
        vocab: mutable Scramble::ScrambleVocab = Scramble::new_vocab_sized(stats.words, stats.letters)
        ScrambleCorpus::read_scramble_vocabulary(text, limit, &vocab)
        hash: mutable u64 = 14695981039346656037.u64()
        letters: mutable i64 = 0
        for i in 0..<vocab.count |vocab, hash, letters|:
            hash <- (hash ^ Ints::at_ref(&vocab.rank, i).u64()) * 1099511628211.u64()
            start: i64 = Ints::at_ref(&vocab.start, i)
            length: i64 = Ints::at_ref(&vocab.length, i)
            letters <- letters + length
            hash <- (hash ^ length.u64()) * 1099511628211.u64()
            for c in 0..<length |vocab, start, hash|:
                hash <- (hash ^ Ints::at_ref(&vocab.letter, start + c).u64()) * 1099511628211.u64()
        print_number(vocab.count)
        printr(",")
        print_number(letters)
        printr(",")
        print_number(hash.i64())
        print("")

def report_bank(index: sview, sentences: sview, rung: i64):
    can Console.Write, Global.Read, Global.Write, Memory.Allocate, Abort.Panic:
        grade: Scramble::ScrambleGrade = Scramble::grade_of(rung)
        capacity: ScrambleCorpus::ScrambleCorpusStats = ScrambleCorpus::inspect(index, grade.top_rank)
        vocab: mutable Scramble::ScrambleVocab = Scramble::new_vocab_sized(capacity.words, capacity.letters)
        ScrambleCorpus::read_scramble_vocabulary(index, grade.top_rank, &vocab)
        bank: mutable Scramble::ScrambleBank = Scramble::ScrambleBank{count: 0, words: Ints::zeros(0), word_at: Ints::zeros(0), word_length: Ints::zeros(0), letter_at: Ints::zeros(0), letter: Ints::zeros(0)}
        stats: ScrambleCorpus::ScrambleBankStats = ScrambleCorpus::scan_bank(sentences, &grade, &vocab, &bank, false)
        bank.words <- Ints::zeros(stats.sentences)
        bank.word_at <- Ints::zeros(stats.sentences)
        bank.word_length <- Ints::zeros(stats.words)
        bank.letter_at <- Ints::zeros(stats.words)
        bank.letter <- Ints::zeros(stats.letters)
        written: ScrambleCorpus::ScrambleBankStats = ScrambleCorpus::scan_bank(sentences, &grade, &vocab, &bank, true)
        hash: mutable u64 = 14695981039346656037.u64()
        for s in 0..<bank.count |bank, hash|:
            count: i64 = Ints::at_ref(&bank.words, s)
            first: i64 = Ints::at_ref(&bank.word_at, s)
            hash <- (hash ^ count.u64()) * 1099511628211.u64()
            for w in 0..<count |bank, first, hash|:
                length: i64 = Ints::at_ref(&bank.word_length, first + w)
                start: i64 = Ints::at_ref(&bank.letter_at, first + w)
                hash <- (hash ^ length.u64()) * 1099511628211.u64()
                for c in 0..<length |bank, start, hash|:
                    hash <- (hash ^ Ints::at_ref(&bank.letter, start + c).u64()) * 1099511628211.u64()
        print_number(written.sentences)
        printr(",")
        print_number(written.words)
        printr(",")
        print_number(written.letters)
        printr(",")
        print_number(hash.i64())
        print("")

def main() -> i64:
    can Console.Write, Global.Read, Global.Write, Memory.Allocate, Memory.Release, Blocking.IO, Abort.Panic:
        region work(268435456)
        in work:
                fixture: sview = sview("zoo\t2\t\na\t1\t\ncat\t2\t\na\t4\t\ncat\t2\t\n", 0, -1)
                report(fixture, 2)
                return 1 if ScrambleCorpus::inspect(sview("bad\tx\t\n", 0, -1), 100).valid
                arena: mutable Arena& = (&work).cast[mutable Arena&]
                missing: mutable darray[u8] = []
                body: mutable darray[u8] = try read_entire_file(arena, "/tmp/nw_scramble_real_index.tsv") else missing
                text: sview = bytes_view(body)
                return 2 if sview_len(text) == 0.usize() or not ScrambleCorpus::inspect(text, 60000).valid
                report(text, 3000)
                report(text, 60000)
                missing_sentences: mutable darray[u8] = []
                sentence_body: mutable darray[u8] = try read_entire_file(arena, "/tmp/nw_scramble_real_sentences.txt") else missing_sentences
                sentence_text: sview = bytes_view(sentence_body)
                return 3 if sview_len(sentence_text) == 0.usize()
                report_bank(text, sentence_text, 1)
                report_bank(text, sentence_text, 12)
        return 0
