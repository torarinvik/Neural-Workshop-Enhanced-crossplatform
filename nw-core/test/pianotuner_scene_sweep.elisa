include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_pianotuner.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# The piano Piano Tuner draws, for pianotuner_scene_diff.py, in frames of
# 1/60 s: at the start; the pin turned up by hand for a second; the
# autopilot just past its first string's done, the hammer on the next pin
# and a green mark under the first; the autopilot's try judged; and done said
# too soon, judged sharp or flat; turned down for four seconds and said done,
# flat; and left alone until out of time. Then the options notes.

def emit(rung: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        session: mutable PianoTunerGame::Session = PianoTunerGame::initialize(rung, 1, true, 17)
        _ = PianoTunerGame::start(&session, 0.0)
        after: mutable i64 = -1
        frame: mutable i64 = 1
        while frame <= 7200 and session.phase == PianoTunerGame::PLAYING |session, mode, after, frame|:
            break if mode == 0 or (mode == 1 and frame > 60) or (after >= 0 and frame - after > 3)
            port: mutable i64 = PianoTuner::pilot(&session.run)
            if mode == 1:
                port <- PianoTuner::UP
            elif mode == 4:
                port <- PianoTuner::DONE if frame == 30 else (-1 if port == PianoTuner::DONE else port)
            elif mode == 5:
                port <- PianoTuner::DONE if frame == 240 else PianoTuner::DOWN
            elif mode == 6:
                port <- -1
            if port >= 0:
                _ = PianoTunerGame::input(&session, port) can Global{Read,Write}
            _ = PianoTunerGame::advance(&session, frame.f64() / 60.0) can Global{Read,Write}
            if after < 0 and mode == 2 and session.run.count >= 1:
                after <- frame
            frame <- frame + 1
        _ = printf("frame %lld %lld %lld\n", rung, mode, session.run.result)
        caption: mutable dstr = []
        ScenePianoTuner::verdict_text(&session.run, &caption)
        _ = printf("verdict ")
        for char in caption:
            _ = printf("%c", char.i32())
        _ = printf("\n")
        list: mutable Display::DisplayList = Display::DisplayList()
        ScenePianoTuner::view(&list, &session.run)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")
        PianoTunerGame::close(&session)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            ScenePianoTuner::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 4, 7, 10, 13, 25]:
            for mode in 0..<7 |rung|:
                region scratch(33554432):
                    in scratch:
                        emit(rung, mode)
        return 0.i32()
