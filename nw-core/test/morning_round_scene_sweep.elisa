include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_morning_round.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Global.Read, Global.Write:
        session: mutable MorningRoundGame::Session = MorningRoundGame::initialize(rung, 1, false, 17)
        _ = MorningRoundGame::start(&session, 0.0)
        if mode > 0:
            session.run.t <- session.run.street.layout.level.brief + 1.0
        if mode >= 2:
            session.run.s <- 330.0 + 180.0 * (mode - 2).f64()
            session.run.x <- 561.0
            _ = MorningRoundRide::throw(&session.run, -1)
            session.run.got[0] <- MorningRoundRide::DELIVERED
            session.run.got[1] <- MorningRoundRide::WRONG
            session.run.got[2] <- MorningRoundRide::MISSED
            session.run.mistakes <- 2
        if mode == 3:
            session.run.down_until <- session.run.t + 1.0
            session.run.falls <- 1
            session.run.hit[0] <- true
        if mode == 4:
            session.run.s <- session.run.street.layout.blocks[1].start if session.run.street.layout.level.blocks > 1
        if mode == 5:
            session.run.s <- session.run.street.layout.length - 180.0
        _ = printf("frame %lld %lld\n", rung, mode)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneMorningRound::scene(&list, &session.run)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneMorningRound::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 4, 6, 9, 12, 30]:
            for mode in 0..<6 |rung|:
                region scratch(2097152):
                    in scratch:
                        emit(rung, mode)
        return 0.i32()
