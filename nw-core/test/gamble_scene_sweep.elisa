include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_gamble.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        session: mutable GambleGame::Session = GambleGame::initialize(rung, 1, false, 17)
        if mode != 0:
            _ = GambleGame::input(&session, GambleGame::START, 0) can Global{Read,Write}
        if mode >= 2:
            limit: i64 = 14 if mode == 2 else session.dealt.level.pulls
            for turn in 0..<limit |session, mode|:
                break if session.phase != GambleGame::PULLING
                if mode >= 3 and turn == 5 and session.dealt.level.price > 0:
                    _ = GambleGame::input(&session, GambleGame::STOP, turn) can Global{Read,Write}
                else:
                    _ = GambleGame::input(&session, 0, turn) can Global{Read,Write}
        if mode == 4:
            _ = GambleGame::advance(&session, session.deadline_ms) can Global{Read,Write}

        _ = printf("frame %lld %lld %lld\n", rung, mode, 1 if dark else 0)
        if session.phase == GambleGame::PULLING or session.phase == GambleGame::JUDGED:
            area: SceneHiddenRule::Rect = SceneGamble::table()
            arms: i64 = session.dealt.level.arms
            for arm in 0..<arms |session, area, arms|:
                box: SceneHiddenRule::Rect = SceneGamble::machine_box(&area, arms, arm)
                _ = printf("hit %lld %.9g %.9g\n", SceneGamble::hit(&session, box.x + box.w / 2.0, box.y + box.h / 2.0),
                    box.x + box.w / 2.0, box.y + box.h / 2.0)
            first: SceneHiddenRule::Rect = SceneGamble::machine_box(&area, arms, 0)
            stop: SceneHiddenRule::Rect = SceneGamble::stop_box(&area, first.w)
            _ = printf("hit %lld %.9g %.9g\n", SceneGamble::hit(&session, stop.x + stop.w / 2.0, stop.y + stop.h / 2.0),
                stop.x + stop.w / 2.0, stop.y + stop.h / 2.0)
        _ = printf("hit %lld 0 0\n", SceneGamble::hit(&session, 0.0, 0.0))
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneGamble::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")
        GambleGame::close(&session) can Global{Read,Write}

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in [1, 3, 6, 10, 14, 18, 21, 25, 30]:
            note: mutable dstr = []
            SceneGamble::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 18, 25]:
            for mode in 0..<5 |rung|:
                for dark in 0..<2 |rung, mode|:
                    region scratch(2097152):
                        in scratch:
                            emit(rung, mode, dark != 0) can Global{Read,Write}
        return 0.i32()
