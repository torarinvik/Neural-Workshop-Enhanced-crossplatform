include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/delay_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def main() -> i32:
    can Abort.Panic, Console.Write:
        rungs: i64[4] = [1, 10, 16, 25]
        for index in 0..<4 |index, rungs|:
            session: mutable DelayGame::Session = DelayGame::initialize(rungs[index.usize()], 2, index != 2, 17)
            _ = DelayGame::start(&session, 0.0)
            for tick in 0..<528 |tick, index, session|:
                now: f64 = tick.f64() / 4.0
                _ = DelayGame::advance(&session, now)
                if session.phase == DelayGame::DONE:
                    _ = printf("done %lld %lld\n", session.passed_count, session.best_rung)
                    break
                if tick % 2 == 0:
                    _ = DelayGame::steer(&session, DelayGame::WAIT if index == 0 or tick % 6 != 0 else DelayGame::TAKE, now)
                _ = printf("%lld %lld %lld %lld %lld %lld %lld %.9f\n", session.phase, session.mode,
                    session.rung, session.trial, session.offer, session.coins, session.passed_count, session.par)
        return 0.i32()
