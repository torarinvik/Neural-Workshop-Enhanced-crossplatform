include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_steadicam.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# The viewfinder Steadicam draws, for steadicam_scene_diff.py: at the start,
# three and twelve seconds into the autopilot's take, panned off the walker,
# and zoomed in; then the options notes.

def emit(rung: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        session: mutable SteadicamGame::Session = SteadicamGame::initialize(rung, 1, true, 17)
        _ = SteadicamGame::start(&session, 0.0)
        frames: i64 = 0 if mode == 0 else (30 if mode == 1 else (120 if mode == 2 else 20))
        for frame in 1..<(frames + 1) |session, mode|:
            break if session.phase != SteadicamGame::PLAYING
            port: i64 = Steadicam::pilot(&session.run) if mode <= 2 else (Steadicam::PAN_R if mode == 3 else Steadicam::ZOOM_IN)
            _ = SteadicamGame::input(&session, port)
            _ = SteadicamGame::advance(&session, frame.f64() / 10.0)
        _ = printf("frame %lld %lld %lld\n", rung, mode, session.run.result)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneSteadicam::view(&list, &session.run)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")
        SteadicamGame::close(&session)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneSteadicam::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 4, 10, 16, 30]:
            for mode in 0..<5 |rung|:
                region scratch(4194304):
                    in scratch:
                        emit(rung, mode)
        return 0.i32()
