# Differential sweep driver for src/scene_crossedwires.elisa.
# See scene_crossedwires_diff.py for the reference side.
#
# The screen is handed only what a player may see -- two spots, two counters
# and a budget -- because that is all the reference hands it. So the sweep
# names those directly rather than playing a round to reach them: the wiring
# behind a Bench cannot change the picture, and a suite that drove presses
# would be testing the wiring twice and the drawing once.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/crossedwires.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_crossedwires.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            width: f64 = 1824.0
            height: f64 = 1368.0
            print("names|spec|rung|phase|black|show_grid|at_x|at_y|goal_x|goal_y|goal_at|goals_n|presses_left|budget|trial|total_trials")
            for spec in 0..<36 |width, height|:
                rung: i64 = 1 + spec % 12
                grade: CrossedWires::Grade = CrossedWires::grade_at(rung)
                phase: i64 = 1 if spec % 5 != 4 else 2
                black: bool = spec % 3 == 2
                show_grid: bool = spec % 4 != 3
                at_x: i64 = (spec * 3) % grade.across
                at_y: i64 = (spec * 5) % grade.down
                goal_x: i64 = (spec * 7 + 2) % grade.across
                goal_y: i64 = (spec * 2 + 1) % grade.down
                goals_n: i64 = grade.targets
                goal_at: i64 = spec % (goals_n + 1)
                budget: i64 = 20 + spec
                presses_left: i64 = (spec * 3) % (budget + 1)
                printr("spec|")
                print_i64(spec)
                emit_bar(rung)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if show_grid else 0)
                emit_bar(at_x)
                emit_bar(at_y)
                emit_bar(goal_x)
                emit_bar(goal_y)
                emit_bar(goal_at)
                emit_bar(goals_n)
                emit_bar(presses_left)
                emit_bar(budget)
                emit_bar(1 + spec % 6)
                emit_bar(6)
                print("")
                message: mutable dstr = []
                if phase == SceneCrossedWires::PHASE_PLAYING:
                    dstr_append_cstr(&message, SceneCrossedWires::grade_name(rung))
                    dstr_append_cstr(&message, " ")
                    dstr_append_em_dash(&message)
                    dstr_append_cstr(&message, " ")
                    dstr_append_i64(&message, grade.keys)
                    dstr_append_cstr(&message, " keys, ")
                    dstr_append_i64(&message, grade.targets)
                    dstr_append_cstr(&message, " targets")
                else:
                    dstr_append_cstr(&message, "Press Space to start")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneCrossedWires::Paint = SceneCrossedWires::paint_of(black, width, height, 2.0, 2.0)
                SceneCrossedWires::render(&list, &paint, rung, phase, show_grid,
                                          at_x, at_y, goal_x, goal_y, goal_at,
                                          goals_n, presses_left, budget,
                                          1 + spec % 6, 6, bytes_view(message),
                                          -1, sview("", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
