# Differential sweep for pyrandom.elisa against CPython's random module.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "../src/pyrandom.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

def sweep_getrandbits():
    can Console.Write, Abort.Panic:
        for seed in [0, 42, 1234567890123456789]:
            for k in [1, 3, 8, 16, 31, 32, 33, 48, 64] |seed|:
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, seed.u64())
                printr("grb")
                emit_cell(seed)
                emit_cell(k)
                for _draw in 0..<4 |rng, k|:
                    # Printed as a signed i64; the harness casts the same way.
                    emit_cell(py_getrandbits(&rng, k).i64())
                print("")

def sweep_randbelow():
    can Console.Write, Abort.Panic:
        for seed in [7, 99]:
            for n in [1, 2, 3, 5, 8, 10, 16, 17, 100, 1000] |seed|:
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, seed.u64())
                printr("rbl")
                emit_cell(seed)
                emit_cell(n)
                for _draw in 0..<6 |rng, n|:
                    emit_cell(py_randbelow(&rng, n.u64()).i64())
                print("")

def sweep_randint():
    can Console.Write, Abort.Panic:
        for seed in [3, 2024]:
            for high in [1, 6, 8, 52, 1000] |seed|:
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, seed.u64())
                printr("ri")
                emit_cell(seed)
                emit_cell(high)
                for _draw in 0..<6 |rng, high|:
                    emit_cell(py_randint(&rng, 1, high))
                print("")

# randint over an EQUAL-BOUNDS range. CPython's randint(a, a) is
# a + _randbelow(1), which draws getrandbits(1) and rejects until it comes up
# 0 -- so it consumes the stream even though the answer is never in doubt. The
# trailing draw is the column that proves it: a short-circuiting implementation
# returns the same value here and the WRONG one after.
def sweep_randint_equal_bounds():
    can Console.Write, Abort.Panic:
        for seed in [11, 4242]:
            for repeats in [1, 2, 5] |seed|:
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, seed.u64())
                index: mutable i64 = 0
                while index < repeats |index, rng, repeats|:
                    _ = py_randint(&rng, 7, 7)
                    index <- index + 1
                printr("rieq")
                emit_cell(seed)
                emit_cell(repeats)
                # Stream position after the equal-bounds calls.
                emit_cell(py_getrandbits(&rng, 32).i64())
                print("")

def sweep_shuffle():
    can Console.Write, Memory.Allocate, Abort.Panic:
        for seed in [1, 42, 777]:
            for count in [2, 3, 8, 20] |seed|:
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, seed.u64())
                values: mutable darray[i64] = []
                for index in 0..<count |values|:
                    values.push(index)
                py_shuffle_i64(&rng, &values)
                printr("sh")
                emit_cell(seed)
                emit_cell(count)
                for value in values:
                    emit_cell(value)
                print("")

def sweep_sample():
    can Console.Write, Memory.Allocate, Abort.Panic:
        for seed in [5, 31337]:
            # Population sizes straddling the setsize heuristic boundary.
            for high in [4, 8, 21, 22, 30, 64, 200] |seed|:
                for k in [1, 2, 5, 6, 7] |seed, high|:
                    continue if k > high
                    rng: mutable MT19937 = mt19937_new()
                    mt_seed_int(&rng, seed.u64())
                    picked: darray[i64] = py_sample_range(&rng, 1, high, k)
                    printr("sm")
                    emit_cell(seed)
                    emit_cell(high)
                    emit_cell(k)
                    for value in picked:
                        emit_cell(value)
                    print("")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(32 * 1024 * 1024)
        in work:
            sweep_getrandbits()
            sweep_randbelow()
            sweep_randint()
            sweep_randint_equal_bounds()
            sweep_shuffle()
            sweep_sample()
        destroy work
        return 0
