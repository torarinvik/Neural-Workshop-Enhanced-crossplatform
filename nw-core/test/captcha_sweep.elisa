include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/captcha_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, seed: i64):
    can Abort.Panic, Console.Write, Memory.Allocate, Unsafe.PointerCast:
        puzzle: Captcha::Puzzle = Captcha::deal(rung, seed)
        level: Captcha::Grade = puzzle.level
        _ = printf("%lld %lld %lld %.17g %lld %.17g %.17g %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld\n",
            level.rung, level.length, level.faces, level.tilt, 1.i64() if level.colours else 0.i64(), level.wave, level.crowd,
            level.strikes, level.noise, level.clutter, level.blobs, level.decoys, puzzle.rules, puzzle.keep,
            puzzle.light.i64(), puzzle.other.i64(), puzzle.stripes)
        for c in puzzle.answer:
            _ = printf("%c", c.i32())
        _ = printf("\n")
        rule: mutable dstr = []
        Captcha::rule_text(&puzzle, &rule)
        for c in rule:
            _ = printf("%c", c.i32())
        _ = printf("\n")
        preview: mutable dstr = []
        Captcha::option_note(rung, &preview)
        for c in preview:
            _ = printf("%c", c.i32())
        _ = printf("\n")
        for glyph in puzzle.glyphs:
            _ = printf("%c %.17g %.17g %.17g %.17g %lld %lld %lld\n", glyph.char.i32(),
                glyph.x, glyph.y, glyph.size, glyph.angle, glyph.face, glyph.colour, 1.i64() if glyph.real else 0.i64())
        for mark in puzzle.marks:
            _ = printf("%lld %.17g %lld %lld %lld", mark.kind, mark.width, mark.colour.i64(), mark.char.i64(), mark.face)
            length: i64 = 3 if mark.kind == Captcha::BLOB else (
                5 if mark.kind == Captcha::ARC else (18 if mark.kind == Captcha::STRIKE else 4))
            for i in 0..<length |mark, i|:
                _ = printf(" %.17g", mark.points[i.usize()])
            _ = printf("\n")

def session_line(session: CaptchaGame::Session&, changed: bool):
    can Abort.Panic, Console.Write:
        _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld ",
            1.i64() if changed else 0.i64(), session.phase, session.rung, session.trial, session.last_ms,
            session.passed, session.best, session.deadline, 1.i64() if session.cursor else 0.i64())
        for c in session.puzzle.answer:
            _ = printf("%c", c.i32())
        _ = printf("|")
        for i in 0..<session.length |session, i|:
            _ = printf("%c", session.typed[i.usize()].i32())
        _ = printf("\n")

def port_for(char: u8) -> i64:
    can Unsafe.PointerCast:
        for i in 0..<Captcha::BACKSPACE |char, i|:
            return i if Captcha::alphabet_at(i) == char
        return -1

def emit_session():
    can Abort.Panic, Console.Write, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
        game: mutable CaptchaGame::Session = CaptchaGame::initialize(16, 2, true, 17)
        session_line(&game, CaptchaGame::event(&game, CaptchaGame::START, 0) can Global{Read,Write})
        session_line(&game, CaptchaGame::event(&game, Captcha::BACKSPACE, 100) can Global{Read,Write})
        session_line(&game, CaptchaGame::event(&game, 0, 501) can Global{Read,Write})
        session_line(&game, CaptchaGame::event(&game, Captcha::BACKSPACE, 601) can Global{Read,Write})
        for i in 0..<game.puzzle.answer.count.i64() |game, i|:
            port: i64 = port_for(game.puzzle.answer[i.usize()])
            _ = CaptchaGame::event(&game, port, 1000) can Global{Read,Write}
        session_line(&game, CaptchaGame::event(&game, Captcha::SUBMIT, 1030) can Global{Read,Write})
        session_line(&game, CaptchaGame::advance(&game, 3529) can Global{Read,Write})
        session_line(&game, CaptchaGame::advance(&game, 3530) can Global{Read,Write})
        for i in 0..<14 |game, i|:
            _ = CaptchaGame::event(&game, i % Captcha::BACKSPACE, 4000) can Global{Read,Write}
        session_line(&game, CaptchaGame::event(&game, 0, 3999) can Global{Read,Write})
        session_line(&game, CaptchaGame::event(&game, Captcha::SUBMIT, 4100) can Global{Read,Write})
        session_line(&game, CaptchaGame::advance(&game, 6600) can Global{Read,Write})
        session_line(&game, CaptchaGame::event(&game, CaptchaGame::START, 7000) can Global{Read,Write})
        CaptchaGame::close(&game) can Global{Read,Write}

def main() -> i32:
    can Abort.Panic, Console.Write, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
        levels: i64[22] = [-2, 1, 3, 4, 6, 7, 9, 10, 12, 13, 15, 16, 19, 20, 23, 24, 27, 29, 30, 31, 100, 9223372036854775807]
        for i in 0..<22 |levels, i|:
            for seed in -4..<9 |levels, i, seed|:
                region sample(524288):
                    in sample:
                        emit(levels[i.usize()], seed)
        emit_session() can Global{Read,Write}
        return 0.i32()
