# Differential sweep driver for nback.elisa; nback_diff.py holds the reference side.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../src/nback.elisa"

# printr(i64) trips the stage1 store_* decline (repro/nw_generic_protocol_impl_stage1.elisa).
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

# A deterministic pseudo-stream so both sides build identical inputs without
# needing a shared RNG: a small linear congruential walk folded into [1, span].
def token_at(seed: i64, index: i64, span: i64) -> i64:
    mixed: i64 = (seed * 1103515245 + index * 12345 + 7) % 2147483647
    positive: i64 = mixed if mixed >= 0 else -mixed
    return 1 + positive % span

def sweep_resolve_back():
    can Console.Write, Memory.Allocate, Abort.Panic:
        variable: mutable darray[i64] = []
        for step in 0..<12 |variable|:
            variable.push(1 + step % 5)
        for nback in [1, 2, 3, 5] |variable|:
            for crab in [0, 1] |nback, variable|:
                for has_var in [0, 1] |nback, crab, variable|:
                    for x in 0..<14 |nback, crab, has_var, variable|:
                        printr("rb")
                        emit_cell(nback)
                        emit_cell(crab)
                        emit_cell(has_var)
                        emit_cell(x)
                        emit_cell(resolve_back(x, nback, crab == 1, &variable, has_var == 1))
                        print("")

def sweep_match():
    can Console.Write, Memory.Allocate, Abort.Panic:
        history: mutable darray[i64] = []
        for step in 0..<8 |history|:
            history.push(token_at(11, step, 4))
        for current in [1, 2, 3, 4] |history|:
            for trial in [-2, -1, 0, 1, 3, 7, 8, 12] |current, history|:
                printr("m")
                emit_cell(current)
                emit_cell(trial)
                emit_cell(is_nback_match(current, &history, trial))
                print("")

def sweep_score():
    can Console.Write, Memory.Allocate, Abort.Panic:
        variable: mutable darray[i64] = []
        for step in 0..<40 |variable|:
            variable.push(1 + step % 4)
        for seed in [3, 17] |variable|:
            for span in [2, 3] |seed, variable|:
                for length in [6, 12, 25] |seed, span, variable|:
                    data: mutable darray[i64] = []
                    inputs: mutable darray[i64] = []
                    for index in 0..<length |data, inputs, seed, span|:
                        data.push(token_at(seed, index, span))
                        inputs.push(token_at(seed + 1, index, 2) - 1)
                    for nback in [1, 2, 3] |data, inputs, variable, seed, span, length|:
                        for crab in [0, 1] |data, inputs, variable, nback, seed, span, length|:
                            for jaeggi in [0, 1] |data, inputs, variable, nback, crab, seed, span, length|:
                                for has_var in [0, 1] |data, inputs, variable, nback, crab, jaeggi, seed, span, length|:
                                    result: Score = score_direct(&data, &inputs, true, nback, crab == 1, jaeggi == 1, &variable, has_var == 1)
                                    printr("sc")
                                    emit_cell(seed)
                                    emit_cell(span)
                                    emit_cell(length)
                                    emit_cell(nback)
                                    emit_cell(crab)
                                    emit_cell(jaeggi)
                                    emit_cell(has_var)
                                    emit_cell(result.rights)
                                    emit_cell(result.wrongs)
                                    print("")

def sweep_mean():
    can Console.Write, Memory.Allocate, Abort.Panic:
        for length in [0, 1, 4, 9]:
            values: mutable darray[f64] = []
            for index in 0..<length |values|:
                values.push((10 * index + 3).f64())
            for window in [0, 1, 2, 5, 20] |values, length|:
                # Report the mean scaled by 1000 and truncated, so the
                # comparison stays in exact integers on both sides.
                scaled: f64 = mean_tail(&values, window) * 1000.0
                printr("mt")
                emit_cell(length)
                emit_cell(window)
                emit_cell(scaled.i64())
                print("")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(32 * 1024 * 1024)
        in work:
            sweep_resolve_back()
            sweep_match()
            sweep_score()
            sweep_mean()
        destroy work
        return 0
