# Parses the REAL config defaults template (written to /tmp by config_diff.py)
# and dumps every key with its parsed type and value, so the harness can check
# all 342 entries against Python's eval()-based parse.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_fileio.elisa"
include "../src/stats.elisa"
include "../src/config.elisa"

const TEMPLATE_PATH: cstr = "/tmp/nw_config_defaults.ini"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def print_view(view: sview):
    can Console.Write, Abort.Panic:
        index: mutable i64 = 0
        length: i64 = sview_len(view).i64()
        trusted Unsafe.PointerCast:
            while index < length |index, view, length|:
                one: u8[2] = zeroed
                one[0] <- sview_at(view, index.usize())
                one[1] <- 0
                printr((&one[0]).cast[cstr])
                index <- index + 1

def main() -> i64:
    can Console.Write, Memory.Allocate, Memory.Release, Blocking.IO, Abort.Panic:
        region work(64 * 1024 * 1024)
        arena: mutable Arena& = (&work).cast[mutable Arena&]
        in work:
            body: cstr = try read_entire_file_cstr(arena, TEMPLATE_PATH) else ""
            text: sview = sview(body.cast[u8&?], 0, string_len(body.cast[u8&?]))
            cfg: mutable Config = config_new()
            parse_config_text(&cfg, text)

            index: mutable i64 = 0
            while index < cfg.names.count.i64() |index, cfg|:
                name: sview = get cfg.names[index.usize()] else ""
                kind: u8 = get cfg.kinds[index.usize()] else 0.u8()
                print_view(name)
                printr(",")
                print_i64(kind.i64())
                printr(",")
                if kind == CONFIG_INT or kind == CONFIG_BOOL:
                    print_i64(get cfg.ints[index.usize()] else 0)
                elif kind == CONFIG_FLOAT:
                    # Scaled and truncated so the comparison stays integral.
                    print_i64(((get cfg.floats[index.usize()] else 0.0) * 1000000.0).i64())
                elif kind == CONFIG_TUPLE or kind == CONFIG_LIST:
                    count: i64 = (get cfg.element_count[index.usize()] else 0.usize()).i64()
                    start: i64 = (get cfg.element_start[index.usize()] else 0.usize()).i64()
                    print_i64(count)
                    element: mutable i64 = 0
                    while element < count |element, cfg, start|:
                        printr(":")
                        print_i64(get cfg.elements[(start + element).usize()] else 0)
                        element <- element + 1
                else:
                    print_view(get cfg.texts[index.usize()] else "")
                print("")
                index <- index + 1
        destroy work
        return 0
