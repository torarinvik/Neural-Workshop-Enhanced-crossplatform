include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "../src/tasks/beliefs_game.elisa"
include "../src/beliefs_text.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit_text(value: dstr&):
    can Console.Write, Abort.Panic:
        for i in 0..<value.count.i64() |value|:
            _ = printf("%c", value[i.usize()].i32())
        _ = printf("\n")

def emit(rung: i64, seed: i64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        region scratch(65536):
            in scratch:
                story: Beliefs::Story = Beliefs::deal(rung, seed)
                level: Beliefs::Grade = story.level
                q: Beliefs::Question = story.question
                _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld\n",
                    rung, seed, level.people, level.containers, level.things, story.count,
                    q.kind, q.who, q.other, q.thing, story.answer)
                question: mutable dstr = []
                BeliefsText::question(&story, &question)
                emit_text(&question)
                options: mutable dstr = []
                BeliefsText::option_note(rung, &options)
                emit_text(&options)
                for who in 0..<level.people |story|:
                    _ = printf("%lld\n", story.names[who.usize()])
                tracker: mutable Beliefs::Tracker = Beliefs::tracker(level.people)
                for i in 0..<story.count |story, tracker, level|:
                    panel: Beliefs::Panel = story.panels[i.usize()]
                    e: Beliefs::Event = panel.event
                    _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld\n",
                        e.kind, e.who, e.other, e.thing, e.where, panel.present,
                        panel.places[0], panel.places[1], panel.places[2])
                    text: mutable dstr = []
                    BeliefsText::caption(&story, e, &text)
                    emit_text(&text)
                    Beliefs::apply(&tracker, e)
                    for a in 0..<level.people |tracker, level|:
                        for thing in 0..<level.things |tracker, a|:
                            _ = printf("%lld ", tracker.belief[Beliefs::belief_at(a, thing)])
                        for b in 0..<level.people |tracker, level, a|:
                            for thing in 0..<level.things |tracker, a, b|:
                                _ = printf("%lld ", tracker.second[Beliefs::second_at(a, b, thing)])
                    _ = printf("\n")

def state(run: BeliefsGame::Run&, accepted: bool):
    can Console.Write:
        _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %.17g\n",
            1 if accepted else 0, BeliefsGame::info(run, 0), BeliefsGame::info(run, 1), BeliefsGame::info(run, 2),
            BeliefsGame::info(run, 6), BeliefsGame::info(run, 9), BeliefsGame::info(run, 10),
            BeliefsGame::info(run, 11), BeliefsGame::info(run, 12), BeliefsGame::info(run, 13), run.think_left)

def sessions():
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        run: mutable BeliefsGame::Run = BeliefsGame::initialize(2, 2, true, 17)
        accepted: mutable bool = BeliefsGame::start(&run)
        state(&run, accepted)
        accepted <- BeliefsGame::steer(&run, 3, 100)
        state(&run, accepted)
        accepted <- BeliefsGame::steer(&run, run.story.answer, 100)
        state(&run, accepted)
        accepted <- BeliefsGame::advance(&run, 2599)
        state(&run, accepted)
        accepted <- BeliefsGame::advance(&run, 2600)
        state(&run, accepted)
        accepted <- BeliefsGame::steer(&run, (run.story.answer + 1) % run.story.level.containers, 2700)
        state(&run, accepted)
        accepted <- BeliefsGame::advance(&run, 5200)
        state(&run, accepted)
        accepted <- BeliefsGame::start(&run)
        state(&run, accepted)

        clock: mutable BeliefsGame::Run = BeliefsGame::initialize(21, 2, true, 17)
        _ = BeliefsGame::configure_think(&clock, 0.5, 0.25)
        accepted <- BeliefsGame::start(&clock)
        state(&clock, accepted)
        accepted <- BeliefsGame::step(&clock, 0.5)
        state(&clock, accepted)
        accepted <- BeliefsGame::step(&clock, 0.01)
        state(&clock, accepted)
        accepted <- BeliefsGame::steer(&clock, clock.story.answer, 100)
        state(&clock, accepted)
        accepted <- BeliefsGame::step(&clock, 0.5)
        state(&clock, accepted)
        accepted <- BeliefsGame::step(&clock, 0.5)
        state(&clock, accepted)

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        for rung in 1..<31:
            for seed in -5..<20 |rung|:
                emit(rung, seed)
        sessions()
        return 0.i32()
