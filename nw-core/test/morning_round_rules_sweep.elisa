include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/morning_round_rules.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def emit(street: MorningRoundRules::Street&):
    can Abort.Panic, Console.Write:
        _ = dprintf(1.i32(), "street %lld %.17g %lld\n", street.papers, street.seconds, street.traffic.count)
        for j in 0..<street.layout.level.blocks |street|:
            _ = dprintf(1.i32(), "active %lld\n", street.active[j.usize()])
        for i in 0..<street.layout.count |street|:
            h: MorningRound::House = street.layout.houses[i.usize()]
            _ = dprintf(1.i32(), "house %lld %lld\n", 1 if h.sign else 0, 1 if MorningRoundRules::pick(street.want, i) else 0)
        for j in 0..<street.book.count |street|:
            rule: MorningRoundRules::Rule = street.book.rules[j.usize()]
            _ = dprintf(1.i32(), "rule %lld\n", rule.count)
            for k in 0..<rule.count |rule|:
                node: MorningRoundRules::Node = rule.nodes[k.usize()]
                _ = dprintf(1.i32(), "node %lld %lld %lld\n", node.op, node.a, node.b)
            vote: MorningRoundRules::Votes = street.book.votes[j.usize()]
            for k in 0..<street.layout.count |vote|:
                _ = dprintf(1.i32(), "vote %lld\n", 1 if MorningRoundRules::pick(vote, k) else 0)
        for j in 0..<street.traffic.count |street|:
            t: MorningRound::Thing = street.traffic.things[j.usize()]
            _ = dprintf(1.i32(), "thing %.17g %.17g %.17g %lld %.17g\n", t.d, t.x, t.radius, t.kind, t.speed)

def samples(rung: i64):
    can Abort.Panic, Console.Write:
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, 17.u64())
        _ = dprintf(1.i32(), "rung %lld\n", rung)
        for _ in 0..<75 |rung, rng|:
            c: MorningRoundRules::Candidate = MorningRoundRules::build(MorningRound::grade(rung), &rng)
            _ = dprintf(1.i32(), "valid %lld\n", 1 if c.valid else 0)
            emit(&c.street) if c.valid
        _ = dprintf(1.i32(), "draw %.17g\n", py_random(&rng))

def main() -> i32:
    can Abort.Panic, Console.Write:
        for rung in [1, 4, 5, 6, 7, 9, 10, 11, 12, 13, 16, 20, 25, 30, 40, 60, 100]:
            samples(rung)
        return 0.i32()
