include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_clawmachine.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# The cabinet Claw Machine draws, for clawmachine_scene_diff.py, in frames
# of 1/60 s: at the start; the trolley moved right for half a second and
# then in; the autopilot's claw a third of a second into its drop; the
# autopilot's try judged, the gold prize in the claw; the claw dropped at
# once; the trolley moved in for a second; and left alone until out of
# time. Then the options notes.

def emit(rung: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        session: mutable ClawMachineGame::Session = ClawMachineGame::initialize(rung, 1, true, 17)
        _ = ClawMachineGame::start(&session, 0.0)
        after: mutable i64 = -1
        frame: mutable i64 = 1
        while frame <= 21600 and session.phase == ClawMachineGame::PLAYING |session, mode, after, frame|:
            break if mode == 0 or (mode == 1 and frame > 60) or (mode == 5 and frame > 60) or (after >= 0 and frame - after > 20)
            port: mutable i64 = ClawMachine::pilot(&session.run)
            if mode == 1:
                port <- ClawMachine::RIGHT if frame <= 30 else ClawMachine::IN
            elif mode == 4:
                port <- ClawMachine::DROP if frame == 1 else -1
            elif mode == 5:
                port <- ClawMachine::IN
            elif mode == 6:
                port <- -1
            if port >= 0:
                _ = ClawMachineGame::input(&session, port) can Global{Read,Write}
            _ = ClawMachineGame::advance(&session, frame.f64() / 60.0) can Global{Read,Write}
            if after < 0 and mode == 2 and session.run.dropped:
                after <- frame
            frame <- frame + 1
        _ = printf("frame %lld %lld %lld\n", rung, mode, session.run.result)
        caption: mutable dstr = []
        SceneClawMachine::verdict_text(&session.run, &caption)
        _ = printf("verdict ")
        for char in caption:
            _ = printf("%c", char.i32())
        _ = printf("\n")
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneClawMachine::view(&list, &session.run)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")
        ClawMachineGame::close(&session)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneClawMachine::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 2, 4, 7, 10, 13]:
            for mode in 0..<7 |rung|:
                region scratch(134217728):
                    in scratch:
                        emit(rung, mode)
        return 0.i32()
