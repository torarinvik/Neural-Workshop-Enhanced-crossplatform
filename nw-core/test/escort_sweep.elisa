include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/escort_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(temple: Escort::Temple&):
    can Abort.Panic, Console.Write:
        _ = printf("candidate %lld %.17g\n", temple.valid.i64(), temple.seconds)
        return if not temple.valid
        level: Escort::Grade = temple.level
        for w in 0..<level.walkers |temple|:
            path: Escort::Path& = &temple.paths[w.usize()]
            pace: Escort::Pace& = &temple.paces[w.usize()]
            _ = printf("walker %lld %.17g %lld\n", path.count, temple.delays[w.usize()], pace.count)
            for i in 0..<path.count |path|:
                cell: Escort::Cell = path.cells[i.usize()]
                _ = printf("cell %lld %lld\n", cell.column, cell.row)
            for i in 0..<pace.count |pace|:
                change: Escort::PaceChange = pace.changes[i.usize()]
                _ = printf("pace %.17g %.17g\n", change.time, change.factor)
        for i in 0..<temple.count |temple|:
            device: Escort::Device = temple.devices[i.usize()]
            _ = printf("device %lld %lld %lld %lld %.17g %.17g %.17g %lld\n", device.kind, device.walker,
                device.at, device.lever, device.period, device.duty, device.phase, temple.start[i.usize()].i64())
        for i in 0..<level.levers |temple|:
            lever: Escort::Lever = temple.levers[i.usize()]
            _ = printf("lever %lld\n", lever.count)
            for j in 0..<lever.count |lever|:
                _ = printf("link %lld\n", lever.devices[j.usize()])

def sweep(rung: i64, seed: i64):
    can Abort.Panic, Console.Write:
        level: Escort::Grade = Escort::grade(rung)
        _ = printf("grade %lld %lld %lld %lld %lld %lld %.17g %lld\n", level.rung, level.walkers,
            level.devices, level.jets, level.levers, level.coupled.i64(), level.speed, level.wobble.i64())
        draw: mutable MT19937 = zeroed
        magnitude: u64 = (-(seed + 1)).u64() + 1.u64() if seed < 0 else seed.u64()
        mt_seed_int(&draw, magnitude)
        for _ in 0..<5 |draw, level|:
            temple: Escort::Temple = Escort::build(level, &draw)
            emit(&temple)

def replay(temple: Escort::Temple&, guided: bool):
    can Abort.Panic, Console.Write:
        run: mutable Escort::Run = Escort::initialize(temple)
        while run.result == Escort::LIVE |run, guided|:
            port: i64 = Escort::autopilot(&run) if guided else -1
            if port >= 0:
                _ = Escort::pull(&run, port)
            Escort::step(&run, 1.0 / 30.0)
            level: Escort::Grade = run.temple.level
            _ = printf("tick %lld %.17g %lld\n", port, run.elapsed, run.result)
            for w in 0..<level.walkers |run|:
                cell: Escort::Position = Escort::where(&run, w)
                i: usize = w.usize()
                _ = printf("walker %.17g %lld %.17g %lld %.17g %.17g\n", run.positions[i], run.states[i],
                    run.paces[i], run.next_pace[i], cell.column, cell.row)
            for i in 0..<run.temple.count |run|:
                index: usize = i.usize()
                _ = printf("motion %lld %.17g\n", run.targets[index].i64(), run.progress[index])
                device: Escort::Device = run.temple.devices[index]
                if device.kind == Escort::JET:
                    cycle: Escort::JetCycle = Escort::jet_next(device, run.elapsed)
                    _ = printf("jet %lld %.17g %.17g\n", Escort::jet_on(device, run.elapsed).i64(), cycle.next_on, cycle.next_off)
            for i in 0..<level.levers |run|:
                _ = printf("pulled %.17g\n", run.pulled[i.usize()])

def session_row(session: EscortGame::Session&):
    can Abort.Panic, Console.Write:
        done: bool = session.phase == EscortGame::DONE
        _ = printf("session %lld %lld %lld %lld %lld %lld %lld %.17g\n", session.phase,
            session.rung, session.trial, session.wins, session.best_rung, session.verdict,
            EscortGame::info(session, 6), 0.0 if done else session.run.elapsed)
        if not done:
            for i in 0..<session.run.temple.level.walkers |session|:
                trail: EscortGame::Trail& = &session.trails[i.usize()]
                start: i64 = trail.count - EscortGame::TRAIL_SAMPLES if trail.count > EscortGame::TRAIL_SAMPLES else 0
                _ = printf("trail %lld\n", trail.count - start)
                for j in start..<trail.count |trail|:
                    point: Escort::Position = trail.points[(j % EscortGame::TRAIL_SAMPLES).usize()]
                    _ = printf("point %.17g %.17g\n", point.column, point.row)
            for i in 0..<session.run.temple.level.levers |session|:
                _ = printf("flip %lld\n", session.flips[i.usize()])

def lifecycle():
    can Abort.Panic, Console.Write:
        session: mutable EscortGame::Session = EscortGame::initialize(13, 2, true, 17)
        _ = EscortGame::input(&session, EscortGame::START, 0)
        session_row(&session)
        now: mutable i64 = 0
        for trial in 0..<2 |session, now|:
            while session.phase == EscortGame::PLAYING |session, now, trial|:
                if trial == 0:
                    port: i64 = Escort::autopilot(&session.run)
                    if port >= 0:
                        _ = EscortGame::input(&session, port, now)
                next: i64 = now + (137 if (now / 11) % 3 == 0 else 11)
                _ = EscortGame::advance(&session, next, next.f64() / 1000.0 - now.f64() / 1000.0)
                now <- next
                session_row(&session)
            _ = EscortGame::advance(&session, now + 2999, 2.999)
            session_row(&session)
            now <- now + 3000
            _ = EscortGame::advance(&session, now, 3.0)
            session_row(&session)
        _ = EscortGame::input(&session, EscortGame::START, now + 1)
        session_row(&session)

def main() -> i32:
    can Abort.Panic, Console.Write:
        for rung in 1..<37:
            for seed in [-17, 0, 17, 2026]:
                sweep(rung, seed)
        for rung in [1, 6, 7, 10, 13, 16, 20, 26]:
            temple: Escort::Temple = Escort::deal_seed(rung, 17)
            emit(&temple)
            replay(&temple, false)
            replay(&temple, true)
        lifecycle()
        return 0.i32()
