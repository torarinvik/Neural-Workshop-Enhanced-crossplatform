# Differential sweep driver for src/scene_marblemaze.elisa.
# See scene_marblemaze_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pymath.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_marblemaze.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|phase|black|rolling|trial|total_trials|home|marbles|left|roll|pitch|tall|verdict")
        region w(256 * 1024 * 1024)
        in w:
            for spec in 0..<32:
                phase: i64 = spec % 4
                black: bool = spec % 7 == 1
                rolling: bool = spec % 11 != 10
                marbles: i64 = 1 + (spec / 4) % 5
                home: i64 = spec % (marbles + 1)
                left: i64 = spec % 47
                # Both signs, because a tilt reads as `-3°/7°` and a port
                # that dropped the sign would look right on half the frames.
                roll: i64 = (spec % 13) - 6
                pitch: i64 = 6 - (spec % 13)
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if rolling else 0)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(home)
                emit_bar(marbles)
                emit_bar(left)
                emit_bar(roll)
                emit_bar(pitch)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneMarbleMaze::Paint = SceneMarbleMaze::paint_of(black, width, height, 2.0, 2.0)
                SceneMarbleMaze::render(&list, &paint, phase, rolling,
                                        1 + spec % 5, 5, home, marbles, left,
                                        roll, pitch,
                                        sview("Tip it home", 0, -1), verdict,
                                        sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
