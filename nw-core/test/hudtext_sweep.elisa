# Differential sweep for src/hudtext.elisa against the update() methods in
# neural_workshop/ui/hud.py. See hudtext_diff.py for the reference side.
#
# Each spec is one session-and-config state; the frame is what each of the six
# labels says in it, plus the three-strikes colours and the key list's y.
#
# Text comes out bracketed and with newlines escaped, because a label's blank
# lines ARE its layout -- the hub key list spaces its groups with bare "\n"
# entries -- and a comparison that trimmed or split them would pass on a list
# whose spacing had drifted.
#
# The grid numbers are supplied already inside their valid ranges. Clamping
# GRID_SIZE to its configured bounds and GRID_3D_CUBES to 1..6 lives in
# grid.py, which is not ported here; a spec that leant on it would be testing
# a clamp neither side owns.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/display.elisa"
include "../src/board.elisa"
include "../src/gamemode.elisa"
include "../src/scene_title.elisa"
include "../src/hudtext.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr("|")
        print_i64(value)

def flag(value: bool) -> i64:
    return 1 if value else 0

# One byte at a time, with the two characters that would break a line-per-row
# comparison written as escapes.
def emit_view(view: sview):
    can Console.Write, Abort.Panic:
        printr("[")
        index: mutable i64 = 0
        while index < sview_len(view).i64() |index, view|:
            byte: u8 = sview_at(view, index.usize())
            if byte == 10:
                printr("\\n")
            elif byte == 92:
                printr("\\\\")
            else:
                one: mutable u8[2] = zeroed
                one[0] <- byte
                trusted Unsafe.PointerCast:
                    printr((&one[0]).cast[cstr])
            index <- index + 1
        print("]")

def emit_text(text: dstr):
    can Console.Write, Memory.Allocate, Abort.Panic:
        emit_view(bytes_view(text))

def blank_mode() -> Mode:
    rts: f64[15] = zeroed
    stim: i64[13] = zeroed
    return Mode{mode: 2, back: 2, ticks_per_trial: 6,
                ticks_per_trial_is_float: false,
                num_trials: 20, num_trials_factor: 1, num_trials_exponent: 2,
                num_trials_total: 24, manual: false, inputs: zeroed,
                input_rts: rts, hide_text: false, current_stim: stim,
                current_operation: ArithOp.NoneOp,
                started: false, paused: false, show_missed: false,
                sound_select: false, draw_graph: false, saccadic: false,
                title_screen: false, session_number: 1, trial_number: 0,
                trial_starttime: 0.0, tick: 0, progress: 0,
                phase: TrialPhase.NotStarted, phase_elapsed: 0,
                step_mode: false, frame_seq: 0, session_done: false}

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(4 * 1024 * 1024)
        in work:
            tables: ModeTables = ModeTables()
            print("names|spec|started|hide_text|manual|paused|jaeggi|clinical|grid3d|varnback|fullscreen|morse|black|feedback|progress|mode|back|trials|gridsize|include_center|limit|cubes|update_avail|banner|show|advance|fallback|awesome|great|good|perfect|threshold")
            # The first ninety-six specs sample the whole state space with
            # coprime strides; the last hundred and twenty-eight walk the seven
            # flags the two multi-part captions are built from EXHAUSTIVELY.
            # Both are needed. The sample alone put Jaeggi mode and manual mode
            # together exactly once, in a spec that also hid the text -- so
            # swapping the order of their two prefixes changed nothing and a
            # negative control passed.
            for spec in 0..<224 |tables|:
                bits: i64 = spec - 96
                walked: bool = spec >= 96
                started: bool = (bits / 64) % 2 == 1 if walked else spec % 3 == 1
                hide_text: bool = (bits / 32) % 2 == 1 if walked else spec % 7 == 2
                manual: bool = (bits / 16) % 2 == 1 if walked else spec % 5 == 3
                jaeggi: bool = (bits / 8) % 2 == 1 if walked else spec % 13 == 6
                clinical: bool = (bits / 4) % 2 == 1 if walked else spec % 17 == 8
                grid3d: bool = (bits / 2) % 2 == 1 if walked else spec % 6 == 5
                varnback: bool = bits % 2 == 1 if walked else spec % 9 == 7
                paused: bool = spec % 11 == 4
                fullscreen: bool = spec % 4 == 2
                morse: bool = spec % 8 == 3
                black: bool = spec % 2 == 1
                feedback: bool = spec % 5 != 0
                progress: i64 = spec % 4
                # Mode 10 is the one with the cell counts in its caption, so
                # it comes round often; the rest walk the base table. No
                # unknown mode is swept: the reference raises KeyError on one,
                # so there is no reference frame to be equal to.
                mode: i64 = 10 if spec % 3 == 0 else (2 + spec % 6)
                back: i64 = 1 + spec % 7
                trials: i64 = 15 + spec % 9
                gridsize: i64 = 2 + spec % 4
                include_center: bool = spec % 3 == 2
                limit: i64 = spec % 5
                cubes: i64 = 1 + spec % 3
                update_avail: bool = spec % 5 == 1
                banner: i64 = spec % 3
                show: bool = spec % 2 == 0
                advance: bool = spec % 7 == 1
                fallback: bool = spec % 7 == 4
                awesome: bool = spec % 11 == 2
                great: bool = spec % 11 == 5
                good: bool = spec % 11 == 8
                perfect: bool = spec % 19 == 3
                threshold: i64 = 2 + spec % 4

                printr("spec|")
                print_i64(spec)
                emit_cell(flag(started))
                emit_cell(flag(hide_text))
                emit_cell(flag(manual))
                emit_cell(flag(paused))
                emit_cell(flag(jaeggi))
                emit_cell(flag(clinical))
                emit_cell(flag(grid3d))
                emit_cell(flag(varnback))
                emit_cell(flag(fullscreen))
                emit_cell(flag(morse))
                emit_cell(flag(black))
                emit_cell(flag(feedback))
                emit_cell(progress)
                emit_cell(mode)
                emit_cell(back)
                emit_cell(trials)
                emit_cell(gridsize)
                emit_cell(flag(include_center))
                emit_cell(limit)
                emit_cell(cubes)
                emit_cell(flag(update_avail))
                emit_cell(banner)
                emit_cell(flag(show))
                emit_cell(flag(advance))
                emit_cell(flag(fallback))
                emit_cell(flag(awesome))
                emit_cell(flag(great))
                emit_cell(flag(good))
                emit_cell(flag(perfect))
                emit_cell(threshold)
                print("")

                game: mutable Mode = blank_mode()
                game.started <- started
                game.hide_text <- hide_text
                game.manual <- manual
                game.paused <- paused
                game.progress <- progress
                game.mode <- mode
                game.back <- back
                game.num_trials_total <- trials

                cfg: HudConfig = HudConfig{
                    clinical_mode: clinical, jaeggi_mode: jaeggi,
                    grid_3d: grid3d, variable_nback: varnback,
                    window_fullscreen: fullscreen, black_background: black,
                    use_session_feedback: feedback, morse_audio: morse,
                    threshold_fallback_sessions: threshold,
                    grid_size: gridsize, include_center: include_center,
                    active_cell_limit: limit, cube_count: cubes}

                emit_text(update_notice_text(&game, update_avail, "5.1"))
                emit_text(game_mode_text(&tables, &game, &cfg))
                emit_view(jaeggi_warning_text())
                emit_text(keys_list_text(&game, &cfg))
                emit_view(native_tag_text(&game, &cfg, banner))
                emit_view(paused_text(&game))
                emit_text(congrats_text(&cfg, show, advance, fallback,
                                        awesome, great, good, perfect))

                printr("lifted|")
                print_i64(flag(keys_list_lifted(&game, &cfg)))
                print("")
                printr("circles")
                emit_cell(circle_count(&cfg))
                for index in 0..<circle_count(&cfg) |cfg, game|:
                    emit_cell(circle_color(&cfg, &game, index).i64())
                print("")
                print("end")
        destroy work
        return 0
