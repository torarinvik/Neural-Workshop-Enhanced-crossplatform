include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/camera_render.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(bytes: darray[u8]&):
    can Console.Write:
        for byte in bytes:
            _ = printf("%02x", byte.i32())
        _ = printf("\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
        session: mutable CameraGame::Session = CameraGame::initialize(8, 3, true, 17)
        return 1 if not ((CameraGame::start(&session, 0.0) can Global{Read,Write}))
        live: CameraRender::Frame = CameraRender::frame(&session, 881, 641)
        normal: darray[u8] = CameraRender::encode_frame(&live)
        emit(&normal)
        return 1 if not CameraGame::set_peek(&session, true)
        peek: CameraRender::Frame = CameraRender::frame(&session, 881, 641)
        photo: darray[u8] = CameraRender::encode_frame(&peek)
        emit(&photo)
        tiny: CameraRender::Frame = CameraRender::frame(&session, 80, 10)
        empty: darray[u8] = CameraRender::encode_frame(&tiny)
        return 1 if empty.count != 0.usize()
        for kind in 0..<8 |live|:
            mesh: darray[u8] = CameraRender::encode_mesh(kind, live.field)
            emit(&mesh)
        CameraGame::close(&session) can Global{Read,Write}
        return 0
