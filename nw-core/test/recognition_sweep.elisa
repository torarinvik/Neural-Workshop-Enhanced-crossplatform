# Differential sweep driver for tasks/recognition.elisa. See
# recognition_diff.py for the reference side.
#
# The plan is the load-bearing part. `wants_repeat` is drawn on EVERY position
# whether or not anything is eligible, so a run with nothing to repeat still
# spends a draw per trial and a divergence anywhere shifts the whole stream.
# The configs deliberately include libraries too small for the run, which is
# where the fresh list runs dry and the third branch starts repeating.
#
# The layout goes through geometry.elisa's int() truncation, so the stage and
# the two buttons are swept over window sizes that do not divide evenly.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/pymath.elisa"
include "../src/geometry.elisa"
include "../src/tasks/recognition.elisa"

# printr(i64) and int_to_string_scratch both trip a stage1 backend decline of
# store_* generics (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

def emit_scaled(value: f64):
    can Console.Write, Abort.Panic:
        emit_cell(py_round_half_even(value * 1000000.0))

def emit_flag(value: bool):
    can Console.Write, Abort.Panic:
        emit_cell(1 if value else 0)

def window_width(which: i64) -> f64:
    can Abort.Panic:
        return 912.0 if which == 0
        return 640.0 if which == 1
        return 1366.0 if which == 2
        return 1920.0 if which == 3
        return 1101.0

def window_height(which: i64) -> f64:
    can Abort.Panic:
        return 684.0 if which == 0
        return 480.0 if which == 1
        return 768.0 if which == 2
        return 1080.0 if which == 3
        return 617.0

def cfg_trials(cfg: i64) -> i64:
    can Abort.Panic:
        return 2 if (cfg % 4) == 0
        return 6 if (cfg % 4) == 1
        return 12 if (cfg % 4) == 2
        return 24

def cfg_repeat_percent(cfg: i64) -> i64:
    can Abort.Panic:
        return 0 if ((cfg / 3) % 4) == 0
        return 30 if ((cfg / 3) % 4) == 1
        return 60 if ((cfg / 3) % 4) == 2
        return 100

def cfg_available(cfg: i64) -> i64:
    can Abort.Panic:
        return 2 if ((cfg / 8) % 3) == 0
        return 5 if ((cfg / 8) % 3) == 1
        return 30

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(64 * 1024 * 1024)
        in w:
            # --- the stage and the two buttons ---------------------------
            for size in 0..<5:
                width: f64 = window_width(size)
                height: f64 = window_height(size)
                stage: Recognition::Stage = Recognition::stage_rect(width, height)
                printr("stage")
                emit_cell(size)
                emit_scaled(stage.center_x)
                emit_scaled(stage.center_y)
                emit_scaled(stage.side)
                print("")
                for which in 0..<2 |width, height, size|:
                    box: Recognition::Button = Recognition::button_rect(width, height, which)
                    printr("button")
                    emit_cell(size)
                    emit_cell(which)
                    emit_cell(box.choice)
                    emit_scaled(box.left)
                    emit_scaled(box.bottom)
                    emit_scaled(box.width)
                    emit_scaled(box.height)
                    print("")
                printr("hit")
                emit_cell(size)
                for px in 0..<13 |width, height|:
                    for py in 0..<9 |width, height, px|:
                        x: f64 = width * (px.f64() + 0.5) / 13.0
                        y: f64 = height * (py.f64() + 0.5) / 9.0
                        emit_cell(Recognition::button_hit(width, height, x, y))
                print("")

            # --- the plan, and a run played out --------------------------
            task: mutable Recognition::Task = Recognition::new_task()
            for cfg in 0..<24 |task|:
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, (100 + cfg).u64())
                Recognition::reset(&task)
                task.total_trials <- cfg_trials(cfg)
                task.min_lag <- 1 + ((cfg / 4) % 3)
                task.repeat_percent <- cfg_repeat_percent(cfg)
                task.study_ms <- 0 if (cfg % 5) == 0 else 100
                task.feedback <- (cfg % 2) == 0
                task.sound <- (cfg % 7) == 0
                available: i64 = cfg_available(cfg)

                ok: bool = Recognition::start_run(&task, available, 0.0, &rng)
                printr("plan")
                emit_cell(cfg)
                emit_flag(ok)
                emit_cell(task.count)
                emit_cell(task.phase)
                emit_cell(Recognition::needed_items(task.total_trials))
                for at in 0..<task.count |task|:
                    emit_cell(Ints::at_ref(&task.item, at))
                    emit_cell(Ints::at_ref(&task.repeat, at))
                print("")

                # The player holds each item for a few ticks before answering,
                # so a run with a study timer reaches `hidden` on its own.
                wait: i64 = 3 + (cfg % 4)
                held: mutable i64 = 0
                now: mutable f64 = 0.0
                step: mutable i64 = 0
                while task.phase != Recognition::PHASE_DONE and step < 2000 |task, cfg, wait, held, now, step|:
                    now <- now + 0.05
                    Recognition::update(&task, now)
                    printr("tick")
                    emit_cell(cfg)
                    emit_cell(step)
                    emit_cell(task.phase)
                    emit_cell(task.index)
                    emit_cell(task.answered)
                    print("")
                    if task.phase == Recognition::PHASE_SHOWING or task.phase == Recognition::PHASE_HIDDEN:
                        held <- held + 1
                        if held >= wait:
                            held <- 0
                            item: i64 = Recognition::current_item(&task)
                            said: i64 = Recognition::CHOICE_SEEN if ((step * 7 + item * 3) % 5) < 2 else Recognition::CHOICE_NEW
                            Recognition::answer(&task, said, now)
                            printr("ans")
                            emit_cell(cfg)
                            emit_cell(step)
                            emit_cell(item)
                            emit_cell(said)
                            emit_cell(task.phase)
                            emit_cell(task.last_correct)
                            emit_cell(task.index)
                            emit_cell(task.answered)
                            print("")
                    step <- step + 1

                tally: Recognition::Score = Recognition::score(&task)
                printr("score")
                emit_cell(cfg)
                emit_cell(step)
                emit_cell(tally.hits)
                emit_cell(tally.misses)
                emit_cell(tally.false_alarms)
                emit_cell(tally.correct_rejections)
                emit_cell(tally.repeats)
                emit_cell(tally.answered)
                emit_cell(tally.accuracy)
                print("")
        destroy w
        return 0
