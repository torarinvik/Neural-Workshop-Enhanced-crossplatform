# Differential sweep driver for src/scene_counting.elisa.
# See scene_counting_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_counting.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|shapes|typed|trial|total_trials|right|tall|verdict")
            for spec in 0..<40:
                phase: i64 = spec % 5
                black: bool = spec % 7 == 1
                count: i64 = (spec / 5) % 9
                # An empty answer draws a caret rather than nothing, so both
                # arms of `answer_text or '_'` are swept.
                typed: i64 = spec % 3
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 3 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(count)
                emit_bar(typed)
                emit_bar(1 + spec % 6)
                emit_bar(6)
                emit_bar(spec % 4)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                # One of every kind, cycled, so all four classes appear in
                # every tangle big enough to hold them.
                shapes: mutable darray[SceneCounting::CountRenderShape] = []
                for index in 0..<count |shapes, count|:
                    step: f64 = (index % 10).f64() / 10.0
                    shapes.push(SceneCounting::CountRenderShape{
                        kind: index % 4,
                        x1: 0.05 + 0.6 * step,
                        y1: 0.08 + 0.5 * step,
                        x2: 0.30 + 0.5 * step,
                        y2: 0.35 + 0.4 * step,
                        x3: 0.55 + 0.3 * step,
                        y3: 0.62 + 0.2 * step,
                        radius: 0.06 + 0.012 * (index % 10).f64()})
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneCounting::CountPaint = SceneCounting::paint_of(black, width, height, 2.0, 2.0)
                SceneCounting::render(&list, &paint, phase, &shapes,
                                      sview("", 0, -1) if typed == 0 else (sview("7", 0, -1) if typed == 1 else sview("41", 0, -1)),
                                      1 + spec % 6, 6, spec % 4,
                                      sview("How many?", 0, -1), verdict,
                                      sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
