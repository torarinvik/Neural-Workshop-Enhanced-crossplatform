# Exercise the full-band lexicon size without depending on downloaded data.
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/crossword.elisa"

def main() -> i64:
    can Console.Write, Global.Read, Global.Write, Memory.Allocate, Abort.Panic:
        region work(128 * 1024 * 1024)
        in work:
            count: i64 = 100000
            lex: mutable Crossword::Lexicon = Crossword::new_lexicon_sized(count, count * 4)
            for index in 0..<count |lex|:
                Ints::put(&lex.start, index, index * 4)
                Ints::put(&lex.length, index, 4)
                Ints::put(&lex.rank, index, index + 1)
                Ints::put(&lex.clue, index, index + 1)
                value: mutable i64 = index
                for digit in 0..<4 |lex, index, value|:
                    Ints::put(&lex.letter, index * 4 + 3 - digit, value % 26)
                    value <- value / 26
            lex.count <- count
            Crossword::index_lexicon(&lex)
            sample_word: mutable darray[i64] = Ints::zeros(4)
            value: mutable i64 = count - 1
            for digit in 0..<4 |sample_word, value|:
                Ints::put(&sample_word, 3 - digit, value % 26)
                value <- value / 26
            return 1 if Ints::at_ref(&lex.length_count, 4) != count
            return 2 if lex.prefixes != count * 3
            return 3 if Crossword::word_of(&lex, &sample_word, 0, 4) != count - 1
            return 4 if not Crossword::is_prefix(&lex, &sample_word, 0, 3, 4)
            print("capacity-ok")
        destroy work
        return 0
