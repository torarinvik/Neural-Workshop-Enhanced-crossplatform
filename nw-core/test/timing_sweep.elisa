# Differential sweep for src/timing.elisa against neural_workshop/timing.py.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../src/scheduling.elisa"
include "../src/timing.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            index: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                index <- 22
                buf[22] <- 48.u8()
            else:
                negative: bool = n < 0
                while n != 0 |buf, index, n|:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    index <- index - 1
                    buf[index.usize()] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    index <- index - 1
                    buf[index.usize()] <- 45.u8()
            printr((&buf[index.usize()]).cast[cstr])

def emit(value: i64):
    can Console.Write, Abort.Panic:
        printr("|")
        print_i64(value)

def row(tag: cstr, spec: i64, state: Timing::State):
    can Console.Write, Abort.Panic:
        phases: TrialPhases = Timing::plan_current_trial_phases(state)
        printr(tag)
        emit(spec)
        emit(Timing::tick_duration_ms(state))
        emit(Timing::trial_interval_ms(state))
        emit(state.ticks_per_trial)
        emit(phases.total_ticks)
        emit(phases.stimulus_ticks)
        emit(phases.blank_ticks)
        emit(phases.feedback_ticks)
        emit(phases.stimulus_ms)
        emit(phases.blank_ms)
        emit(phases.feedback_ms)
        emit(Timing::feedback_tick(state))
        print("")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|tag|tick|interval|mode_ticks|total|stim|blank|feedback|stim_ms|blank_ms|feedback_ms|feedback_tick")
        for spec in 0..<48:
            state: mutable Timing::State = Timing::State{
                tick_ms: (spec % 7) - 1,
                interval_ms: (spec % 9 - 3) * 137,
                stimulus_ms: (spec % 8) * 83,
                feedback_ms: (spec % 6) * 117,
                ticks_per_trial: 1 + spec % 12}
            row("before", spec, state)
            wanted: i64 = (spec - 20) * 211
            snapped: i64 = Timing::set_trial_interval_ms(state, wanted)
            printr("set")
            emit(spec)
            emit(wanted)
            emit(snapped)
            emit(state.interval_ms)
            emit(state.ticks_per_trial)
            print("")
            state.interval_ms <- 0 if spec % 2 == 0
            Timing::apply_trial_interval_override(state)
            row("after", spec, state)
        return 0
