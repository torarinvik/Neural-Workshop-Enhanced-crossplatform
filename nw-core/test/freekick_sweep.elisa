include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/freekick.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# Free Kick against freekick.py, for freekick_diff.py: the grade table, the
# dealt pitches and the kick each plan finds, a grid of kicks judged on every
# pitch with where they crossed, and every step of a round: the reference
# autopilot at ten rungs, nobody at the dials, every port in turn and a kick,
# and a dial script with a late kick.

def player(run: mutable FreeKick::Run&, mode: i64, n: i64) -> i64:
    can Abort.Panic, Memory.Allocate:
        return FreeKick::pilot(run) if mode == 0
        return -1 if mode == 1
        return (n / 20) % 9 if mode == 2
        return FreeKick::KICK if n == 300
        return (n / 15) % 8

def replay(rung: i64, seed: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(67108864):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                p: FreeKick::Pitch = FreeKick::deal(rung, &draw)
                _ = printf("pitch %lld %lld %lld %d %u %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g\n",
                    mode, rung, seed, 1 if p.valid else 0, py_getrandbits(&draw, 32).u32(), p.spot_x, p.spot_z, p.goal_x,
                    p.ring_x, p.ring_y, p.ring_r, p.wall_x, p.wall_z, p.wall_w, p.wall_h, p.keeper, p.wind_x, p.wind_z)
                found: FreeKick::Found = FreeKick::plan(&p)
                _ = printf("plan %d %.17g %.17g %.17g %.17g\n", 1 if found.ok else 0, found.kick.aim, found.kick.lift,
                    found.kick.curl, found.kick.power)
                aims: f64[5] = [-20.0, -8.0, 0.0, 8.0, 20.0]
                lifts: f64[5] = [0.0, 6.0, 14.0, 25.0, 40.0]
                curls: f64[3] = [-14.0, 0.0, 9.0]
                powers: f64[3] = [8.0, 20.0, 34.0]
                for a in 0..<5 |p, aims, lifts, curls, powers|:
                    for l in 0..<5 |p, aims, lifts, curls, powers, a|:
                        for c in 0..<3 |p, aims, lifts, curls, powers, a, l|:
                            for w in 0..<3 |p, aims, lifts, curls, powers, a, l, c|:
                                k: FreeKick::Kick = FreeKick::Kick{aim: aims[a.usize()], lift: lifts[l.usize()],
                                    curl: curls[c.usize()], power: powers[w.usize()]}
                                v: FreeKick::Verdict = FreeKick::judge(&p, k)
                                f: FreeKick::Flight = FreeKick::flight(&p, k, true)
                                _ = printf("kick %lld %.17g %lld %.17g %.17g %.17g %.17g\n", v.code, v.miss, f.how, f.x, f.y,
                                    f.t, f.last)
                run: mutable FreeKick::Run = FreeKick::begin(p)
                n: mutable i64 = 0
                while run.result == FreeKick::LIVE |run, mode, n|:
                    port: i64 = player(&run, mode, n)
                    FreeKick::act(&run, port)
                    FreeKick::step(&run, 1.0 / 120.0, -1 if port == FreeKick::KICK else port)
                    at: FreeKick::Point = FreeKick::ball(&run)
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g %.17g %d %.17g %.17g %.17g %.17g %.17g\n", port, run.result,
                        run.t, run.kick.aim, run.kick.lift, run.kick.curl, run.kick.power, 1 if run.struck else 0,
                        run.kicked, at.x, at.y, at.z, FreeKick::keeper_x(&run))
                    n <- n + 1
                _ = printf("end %lld %.17g %lld %lld\n", run.result, run.miss, run.path.count.i64(), run.notes.count.i64())
                for note in run.notes:
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g\n", note.seed, note.voice, note.t, note.freq, note.dur, note.gain)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in 0..<41:
            g: FreeKick::Grade = FreeKick::grade(rung)
            _ = printf("grade %lld %d %.17g %lld %.17g %.17g %.17g %.17g %.17g\n", g.rung, 1 if g.guide else 0, g.ring,
                g.wall, g.jump, g.keeper, g.wind, g.side, g.distance)
        for rung in [1.i64(), 2.i64(), 3.i64(), 4.i64(), 7.i64(), 10.i64(), 13.i64(), 16.i64(), 20.i64(), 30.i64()]:
            replay(rung, 17, 0)
        replay(1, 19, 1)
        replay(4, 19, 2)
        replay(10, 19, 3)
        replay(13, 23, 2)
        return 0
