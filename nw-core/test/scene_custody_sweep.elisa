# Differential sweep driver for src/scene_custody.elisa.
# See scene_custody_diff.py for the reference side.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_custody.elisa"
include "scene_emit.elisa"

const ASKED: cstr = "rung 3, two machines:   deliver the ringed box to the bay   charged to 60   under 70 heat"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|phase|black|span|machines|boxes|claw|need_charge|max_heat|budget|spent|trial|total_trials|tall|verdict")
        region w(256 * 1024 * 1024)
        in w:
            for spec in 0..<40:
                phase: i64 = spec % 5
                black: bool = spec % 7 == 1
                span: i64 = 3 + (spec / 5) % 5
                slots: i64 = span * 2
                machines: i64 = (spec / 5) % 4
                boxes: i64 = 1 + (spec / 5) % 5
                # The claw walks both runs, so the arm is drawn reaching up
                # on the top row and down on the bottom one.
                claw: i64 = spec % slots
                # Zero means the round does not ask for a charge at all, and
                # 100 heat means it does not ask about heat.
                need_charge: i64 = 0 if (spec / 5) % 3 == 2 else 40 + (spec / 5) % 3 * 20
                max_heat: i64 = 100 if (spec / 5) % 4 == 3 else 50 + (spec / 5) % 3 * 15
                budget: i64 = 20 + (spec / 5) % 4 * 10
                spent: i64 = spec % (budget + 1)
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 3 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(span)
                emit_bar(machines)
                emit_bar(boxes)
                emit_bar(claw)
                emit_bar(need_charge)
                emit_bar(max_heat)
                emit_bar(budget)
                emit_bar(spent)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                shop: mutable darray[SceneCustody::CustodyMachine] = []
                for index in 0..<machines |shop, slots|:
                    shop.push(SceneCustody::CustodyMachine{slot: (1 + index * 3) % slots,
                                                    kind: index % 3})
                crates: mutable darray[SceneCustody::CustodyBox] = []
                for index in 0..<boxes |crates, slots|:
                    crates.push(SceneCustody::CustodyBox{
                        slot: (2 + index * 2) % slots,
                        # Exactly one box is held, and one is delivered and
                        # therefore not drawn at all.
                        held: index == 1,
                        delivered: index == 3,
                        look: index,
                        # A zero charge draws no fill, which is its own arm.
                        charge: 0 if index % 4 == 0 else 25 * (index % 4),
                        heat: 0 if index % 3 == 0 else 30 * (index % 3),
                        is_core: index == 0})
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneCustody::CustodyPaint = SceneCustody::paint_of(black, width, height, 2.0, 2.0)
                SceneCustody::render(&list, &paint, phase, true, span, slots,
                                     slots - 1, &shop, &crates, claw,
                                     need_charge, max_heat, budget, spent,
                                     sview(ASKED, 0, -1), 1 + spec % 5, 5,
                                     sview("Follow the Core", 0, -1), verdict,
                                     sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
