include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/kitchen_reference.elisa"

# The pinned Stage0 runtime already declares a compiler-generated printf.
extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def emit_shift(shift: Kitchen::Shift&):
    can Console.Write, Abort.Panic:
        g: Kitchen::Grade = shift.level
        _ = dprintf(1.i32(), "grade %lld %lld %lld %lld %lld %lld %lld %.17g %.17g %.17g %lld %.17g\n",
            g.rung, g.parts, g.foods, g.boards, g.stoves, g.plates, g.tickets, g.gap, g.patience,
            g.hold, g.lapse, g.chopped_only)
        for port in 0..<Kitchen::PORTS |shift|:
            station: Kitchen::Station = shift.stations[port.usize()]
            if station.present:
                _ = dprintf(1.i32(), "station %lld %.17g %.17g %lld\n", port, station.x, station.y, station.food)
        for ticket in shift.tickets:
            _ = dprintf(1.i32(), "ticket %.17g %.17g %lld", ticket.due, ticket.patience, ticket.dish.count)
            for i in 0..<ticket.dish.count |ticket|:
                _ = dprintf(1.i32(), " %lld", ticket.dish.parts[i.usize()])
            _ = dprintf(1.i32(), "\n")

def emit_dish(dish: Kitchen::Dish&):
    can Console.Write, Abort.Panic:
        _ = dprintf(1.i32(), " %lld", dish.count)
        for i in 0..<dish.count |dish|:
            _ = dprintf(1.i32(), " %lld", dish.parts[i.usize()])

def emit_tick(run: Kitchen::Run&, port: i64):
    can Console.Write, Abort.Panic:
        _ = dprintf(1.i32(), "tick %lld %.17g %.17g %.17g %lld %lld %lld %lld %lld %lld %lld %lld",
            port, run.t, run.x, run.y, run.target, run.held_part, run.chopping, run.arrived,
            run.served, run.lapsed, run.result, run.burnt)
        emit_dish(&run.held_dish)
        for i in 0..<run.shift.level.boards |run|:
            item: Kitchen::WorkItem = run.boards[i.usize()]
            _ = dprintf(1.i32(), " %lld %.17g", item.part, item.time)
        for i in 0..<run.shift.level.stoves |run|:
            item: Kitchen::WorkItem = run.stoves[i.usize()]
            _ = dprintf(1.i32(), " %lld %.17g", item.part, item.time)
        for i in 0..<run.shift.level.plates |run|:
            emit_dish(&run.plates[i.usize()])
        for status in run.status:
            _ = dprintf(1.i32(), " %lld", status)
        count: i64 = run.flash_count if run.flash_count < 6 else 6
        _ = dprintf(1.i32(), " %lld", count)
        for i in (run.flash_count - count)..<run.flash_count |run|:
            flash: Kitchen::Flash = run.flashes[(i % 6).usize()]
            _ = dprintf(1.i32(), " %lld %lld %.17g", flash.words, flash.port, flash.time)
        _ = dprintf(1.i32(), "\n")

def sample(rung: i64, seed: i64, mode: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = dprintf(1.i32(), "case %lld %lld %lld\n", rung, seed, mode)
        if mode == 0:
            rng: mutable MT19937 = zeroed
            mt_seed_int(&rng, seed.u64())
            for _ in 0..<3 |rng, rung|:
                shift: Kitchen::Shift = Kitchen::build(Kitchen::grade(rung), &rng)
                emit_shift(&shift)
            _ = dprintf(1.i32(), "end\n")
            return
        shift: Kitchen::Shift = KitchenReference::deal_seed(rung, seed)
        emit_shift(&shift)
        run: mutable Kitchen::Run = Kitchen::start(shift)
        for tick in 0..<18000 |run, mode|:
            port: mutable i64 = Kitchen::NO_PORT
            if mode == 1:
                port <- KitchenReference::choose(&run)
            elif mode == 2 and tick % 49 == 0:
                port <- (tick / 49 * 5) % Kitchen::PORTS
            elif mode == 3:
                if tick == 0:
                    port <- Kitchen::CRATE
                elif tick == 60 or tick == 120:
                    port <- Kitchen::BOARD
                elif tick == 150 or tick == 480:
                    port <- Kitchen::STOVE
                elif tick == 510:
                    port <- Kitchen::BIN
            _ = Kitchen::send(&run, port)
            Kitchen::step(&run, 1.0 / 30.0)
            emit_tick(&run, port)
            break if run.result != Kitchen::LIVE
        _ = dprintf(1.i32(), "end\n")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region fixtures(32 * 1024 * 1024)
        in fixtures:
            for rung in [0, 1, 4, 7, 10, 13, 16, 20, 25, 30, 75]:
                for seed in [0, 17, 42] |rung|:
                    sample(rung, seed, 0)
            for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
                sample(rung, 17, 1)
            sample(7, 42, 2)
            sample(1, 17, 3)
        destroy fixtures
        return 0
