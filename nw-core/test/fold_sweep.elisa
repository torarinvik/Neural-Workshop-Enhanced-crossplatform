include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/fold_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, seed: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        region scratch(65536):
            in scratch:
                puzzle: Fold::Puzzle = Fold::deal(rung, seed)
                cells: i64[6] = Fold::cells(puzzle.net)
                frames: Fold::Frame[6] = Fold::frames(puzzle.net)
                _ = printf("%lld %lld %lld %lld %lld\n", rung, seed, puzzle.asked, puzzle.answer, puzzle.level.choices)
                for i in 0..<6 |puzzle, cells, frames|:
                    mark: Fold::Print = puzzle.marks[i.usize()]
                    face: Fold::Frame = frames[i.usize()]
                    _ = printf("%lld %lld %lld %lld %lld %lld %lld\n", cells[i.usize()],
                        mark.glyph, mark.colour, mark.quarter, face.normal, face.right, face.up)
                if puzzle.level.opposite:
                    _ = printf("%lld %lld %lld %lld\n", puzzle.letters[0], puzzle.letters[1], puzzle.letters[2], puzzle.letters[3])
                else:
                    for i in 0..<puzzle.level.choices |puzzle|:
                        option: Fold::Option = puzzle.cubes[i.usize()]
                        _ = printf("%lld\n", option.turn)
                        for j in 0..<6 |option|:
                            face: Fold::Face = option.cube.faces[j.usize()]
                            _ = printf("%lld %lld %lld %lld %lld\n", face.normal, face.up, face.glyph,
                                face.colour, 1 if face.mirrored else 0)

def state(run: FoldGame::Run&, accepted: bool):
    can Console.Write:
        _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %.17g\n",
            1 if accepted else 0, FoldGame::info(run, 0), FoldGame::info(run, 1), FoldGame::info(run, 2),
            FoldGame::info(run, 6), FoldGame::info(run, 9), FoldGame::info(run, 10),
            FoldGame::info(run, 11), FoldGame::info(run, 12), FoldGame::info(run, 13), run.think_left)

def sessions():
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        run: mutable FoldGame::Run = FoldGame::initialize(3, 2, true, 17)
        accepted: mutable bool = FoldGame::start(&run)
        state(&run, accepted)
        accepted <- FoldGame::steer(&run, 5, 100)
        state(&run, accepted)
        accepted <- FoldGame::steer(&run, run.puzzle.answer, 100)
        state(&run, accepted)
        accepted <- FoldGame::advance(&run, 2599)
        state(&run, accepted)
        accepted <- FoldGame::advance(&run, 2600)
        state(&run, accepted)
        accepted <- FoldGame::steer(&run, (run.puzzle.answer + 1) % run.puzzle.level.choices, 2700)
        state(&run, accepted)
        accepted <- FoldGame::advance(&run, 5200)
        state(&run, accepted)
        accepted <- FoldGame::start(&run)
        state(&run, accepted)

        clock: mutable FoldGame::Run = FoldGame::initialize(4, 2, true, 17)
        _ = FoldGame::configure_think(&clock, 0.5, 0.25)
        accepted <- FoldGame::start(&clock)
        state(&clock, accepted)
        accepted <- FoldGame::step(&clock, 0.5)
        state(&clock, accepted)
        accepted <- FoldGame::step(&clock, 0.01)
        state(&clock, accepted)
        accepted <- FoldGame::steer(&clock, clock.puzzle.answer, 100)
        state(&clock, accepted)
        accepted <- FoldGame::step(&clock, 0.5)
        state(&clock, accepted)
        accepted <- FoldGame::step(&clock, 0.5)
        state(&clock, accepted)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
        for rung in 1..<31:
            for seed in -5..<20 |rung|:
                emit(rung, seed)
        sessions()
        return 0.i32()
