include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/safecracker_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def window(run: Safecracker::Run&, begin: f64, end: f64):
    can Memory.Allocate, Abort.Panic, Console.Write:
        data: mutable u8[8820] = zeroed
        count: i64 = SafecrackerAudio::render(run, begin, end, &data[0], 8820)
        for i in 0..<count |data|:
            _ = printf("%02x", data[i.usize()].i32())
        _ = printf("\n")

def emit(rung: i64, seed: i64):
    can Memory.Allocate, Abort.Panic, Console.Write:
        draw: mutable MT19937 = mt19937_new()
        mt_seed_int(&draw, seed.u64())
        job: Safecracker::Safe = Safecracker::deal(rung, &draw)
        run: mutable Safecracker::Run = Safecracker::initialize(job)
        frame: mutable i64 = 0
        while run.result == Safecracker::PENDING |run, frame|:
            begin: f64 = run.time
            port: i64 = Safecracker::pilot(&run)
            Safecracker::act(&run, port)
            Safecracker::tick(&run, 1.0 / 60.0)
            if frame % 7 == 0:
                window(&run, begin, begin + 1.0 / 60.0)
            frame <- frame + 1

def isolated():
    can Memory.Allocate, Abort.Panic, Console.Write:
        job: Safecracker::Safe = Safecracker::build(Safecracker::grade(1), 17)
        run: mutable Safecracker::Run = Safecracker::initialize(job)
        for voice in 0..<7 |run|:
            Safecracker::note(&run, 0.6 * voice.f64(), 0.15, 330.0 + 110.0 * voice.f64(), voice, 0.4)
        for index in 0..<48 |run|:
            begin: f64 = index.f64() * 0.1 - 0.04
            window(&run, begin, begin + 0.099)

def main() -> i32:
    can Memory.Allocate, Abort.Panic, Console.Write:
        isolated()
        emit(13, 1)
        emit(16, 2)
        emit(25, 4)
        return 0.i32()
