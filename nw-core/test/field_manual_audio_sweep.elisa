include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/field_manual_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def window(run: FieldManualRun::Run&, begin: f64, end: f64):
    can Memory.Allocate, Abort.Panic, Console.Write:
        data: mutable u8[8820] = zeroed
        count: i64 = FieldManualAudio::render(run, begin, end, &data[0], 8820)
        for i in 0..<count |data|:
            _ = printf("%02x", data[i.usize()].i32())
        _ = printf("\n")

def emit(rung: i64, seed: i64):
    can Memory.Allocate, Abort.Panic, Console.Write:
        job: FieldManual::Job = FieldManual::build(FieldManual::grade(rung), seed)
        run: mutable FieldManualRun::Run = FieldManualRun::initialize(job)
        frame: mutable i64 = 0
        while run.result == FieldManualRun::PENDING |run, frame|:
            begin: f64 = run.time
            port: i64 = FieldManualRun::pilot(&run)
            FieldManualRun::act(&run, port)
            FieldManualRun::tick(&run, 1.0 / 60.0, port == FieldManual::SHIFT)
            if frame % 7 == 0:
                window(&run, begin, begin + 1.0 / 60.0)
            frame <- frame + 1

def isolated():
    can Memory.Allocate, Abort.Panic, Console.Write:
        job: FieldManual::Job = FieldManual::build(FieldManual::grade(1), 17)
        run: mutable FieldManualRun::Run = FieldManualRun::initialize(job)
        for voice in 0..<7 |run|:
            FieldManualRun::note(&run, 0.6 * voice.f64(), 0.15, 330.0 + 110.0 * voice.f64(), voice, 0.4, 0.3)
        for index in 0..<48 |run|:
            begin: f64 = index.f64() * 0.1 - 0.04
            window(&run, begin, begin + 0.099)

def main() -> i32:
    can Memory.Allocate, Abort.Panic, Console.Write:
        isolated()
        emit(13, 1)
        emit(16, 2)
        emit(25, 4)
        return 0.i32()
