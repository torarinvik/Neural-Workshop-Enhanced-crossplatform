include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_ferry.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, mode: i64, dark: bool):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read:
        session: mutable FerryGame::Session = FerryGame::initialize(rung, 1, true, 17)
        if mode != 0:
            _ = FerryGame::start(&session, 0.0)
        if mode >= 2:
            _ = FerryGame::key(&session, 2, true)
            for k in 1..<15 |session|:
                _ = FerryGame::key(&session, 1, k < 6)
                _ = FerryGame::advance(&session, k.f64() * 0.125)
            _ = FerryGame::clear_keys(&session)
        if mode == 3 and session.run.river.level.lanes > 0:
            lane: Ferry::Barge = session.run.river.barges[0]
            session.run.x <- Ferry::barge_x(lane, 0, session.run.t) + 10.0
            session.run.y <- lane.lane_y
        if mode == 4:
            pier: Ferry::Point = Ferry::target(&session.run)
            session.run.x <- pier.x
            session.run.y <- pier.y
            session.run.speed <- 0.0
            session.run.docked_since <- session.run.t - 1.25
        if mode == 5:
            session.run.x <- Ferry::WIDTH
            _ = FerryGame::advance(&session, 1.75)
        if mode >= 6:
            session.run.t <- session.run.t + 3.0
            session.run.leg <- session.run.river.level.crossings
            pier: Ferry::Point = Ferry::target(&session.run)
            session.run.x <- pier.x
            session.run.y <- pier.y
            session.run.speed <- 0.0
            session.run.docked_since <- session.run.t - 2.01
            _ = FerryGame::advance(&session, 1.75)
            if mode == 7:
                _ = FerryGame::advance(&session, 4.75)
        _ = printf("frame %lld %lld %lld\n", rung, mode, 1 if dark else 0)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneFerry::render(&list, &session, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            else:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release, Global.Read, Global.Write:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneFerry::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        for rung in [1, 7, 16, 30]:
            for mode in 0..<8 |rung|:
                for dark in 0..<2 |rung, mode|:
                    region scratch(2097152):
                        in scratch:
                            emit(rung, mode, dark != 0)
        return 0.i32()
