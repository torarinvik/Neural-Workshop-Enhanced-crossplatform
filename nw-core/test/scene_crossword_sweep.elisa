# Differential sweep driver for src/scene_crossword.elisa.
# See scene_crossword_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_crossword.elisa"
include "scene_emit.elisa"

const CLUE: cstr = "a bird that cannot fly"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic, Global.Read, Global.Write:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|has_puzzle|size|at|down|hovered|show_mistakes|clued|trial|total_trials|tall|verdict")
            for spec in 0..<40:
                phase: i64 = spec % 4
                black: bool = spec % 7 == 1
                has_puzzle: bool = spec % 13 != 12
                size: i64 = 5 + (spec / 4) % 4 * 3
                at: i64 = (spec / 4) % (size * size)
                down: bool = (spec / 4) % 2 == 0
                # -1 is a real state: the pointer is not over the grid.
                hovered: i64 = -1 if spec % 5 == 4 else (at + size + 1) % (size * size)
                show_mistakes: bool = spec % 3 != 2
                # An unclued slot draws the "no clue" line instead, em dashes
                # and all.
                clued: bool = (spec / 4) % 3 != 2
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if has_puzzle else 0)
                emit_bar(size)
                emit_bar(at)
                emit_bar(1 if down else 0)
                emit_bar(hovered)
                emit_bar(1 if show_mistakes else 0)
                emit_bar(1 if clued else 0)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")

                # A grid built the same way on both sides: every seventh cell
                # blocked, every third filled, every fifth of those given and
                # every eleventh wrong.
                cells: i64 = size * size
                solution: mutable darray[i64] = []
                filled: mutable darray[i64] = []
                givens: mutable darray[bool] = []
                for cell in 0..<cells |solution, filled, givens|:
                    if cell % 7 == 6:
                        solution.push(0)
                        filled.push(0)
                        givens.push(false)
                    else:
                        answer: i64 = 97 + cell % 26
                        solution.push(answer)
                        if cell % 3 == 0:
                            filled.push(answer + 1 if cell % 11 == 0 else answer)
                            givens.push(cell % 5 == 0)
                        else:
                            filled.push(0)
                            givens.push(false)

                # One across slot and one down slot a row, both three long and
                # both starting on an unblocked cell.
                slot_number: mutable darray[i64] = []
                slot_down: mutable darray[bool] = []
                slot_first: mutable darray[i64] = []
                slot_length: mutable darray[i64] = []
                clues: mutable darray[sview] = []
                for row in 0..<(size - 2) |slot_number, slot_down, slot_first, slot_length, clues, size, clued, row|:
                    slot_number.push(row + 1)
                    slot_down.push(false)
                    slot_first.push(row * size)
                    slot_length.push(3)
                    clues.push(sview(CLUE, 0, -1) if clued else sview("", 0, -1))
                    slot_number.push(row + 1 + size)
                    slot_down.push(true)
                    slot_first.push(row)
                    slot_length.push(3)
                    clues.push(sview(CLUE, 0, -1) if clued else sview("", 0, -1))

                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneCrossword::CrosswordPaint = SceneCrossword::paint_of(black, width, height, 2.0, 2.0)
                SceneCrossword::render(&list, &paint, phase, has_puzzle, size,
                                       &solution, &filled, &givens,
                                       &slot_number, &slot_down, &slot_first,
                                       &slot_length, &clues, at, down, hovered,
                                       show_mistakes, 1 + spec % 5, 5,
                                       sview("Rung 3 - five squares", 0, -1),
                                       verdict,
                                       sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
