include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_hold_it.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def scene_has_color(session: HoldItGame::Session&, color: u32, dark: bool) -> bool:
    can Memory.Allocate, Abort.Panic:
        frame: mutable Display::DisplayList = Display::DisplayList()
        SceneHoldIt::render(&frame, session, dark)
        for at in 0..<frame.commands.count.i64() |frame, color|:
            return true if frame.commands[at.usize()].color == color
        return false

def scene_check() -> bool:
    can Memory.Allocate, Abort.Panic:
        session: mutable HoldItGame::Session = HoldItGame::initialize(10, 1, false, 17)
        _ = HoldItGame::start(&session, 0.0)
        return false if scene_has_color(&session, SceneHoldIt::FIRST_LAMP, false)
        return false if scene_has_color(&session, SceneHoldIt::SECOND_LAMP, true)
        session.run.time <- session.run.ask.lamps[0].on
        return false if not scene_has_color(&session, SceneHoldIt::FIRST_LAMP, false)
        return false if scene_has_color(&session, SceneHoldIt::SECOND_LAMP, false)
        session.run.time <- session.run.ask.lamps[1].on
        return false if scene_has_color(&session, SceneHoldIt::FIRST_LAMP, true)
        return false if not scene_has_color(&session, SceneHoldIt::SECOND_LAMP, true)
        session.run.time <- session.run.ask.turn
        _ = HoldItGame::advance(&session, 0.03125, true)
        return false if not scene_has_color(&session, SceneHoldIt::FIRST_LAMP, false)
        return false if not scene_has_color(&session, SceneHoldIt::SECOND_LAMP, false)
        return false if scene_has_color(&session, 0x78dc96ff, true)
        _ = HoldItGame::advance(&session, 0.0625, false)
        return scene_has_color(&session, 0x78dc96ff, true) and scene_has_color(&session, 0xffc86eff, true)

def main() -> i32:
    can Memory.Allocate, Console.Write, Abort.Panic:
        return 1.i32() if not scene_check()
        for rung in 1..<36:
            for seed in -100..<100 |rung|:
                ask: HoldIt::Ask = HoldIt::deal(rung, seed)
                _ = printf("%lld %lld %lld %lld %.9f %.9f %.9f %.9f %.9f %.9f",
                    rung, seed, ask.kind, ask.count, ask.level.low, ask.level.high,
                    ask.level.margin, ask.factor, ask.target, ask.tick)
                _ = printf(" %.9f", ask.turn)
                for lamp in 0..<ask.count |ask|:
                    timing: HoldIt::Lamp = ask.lamps[lamp.usize()]
                    _ = printf(" %.9f %.9f", timing.on, timing.off)
                _ = printf("\n")
        rungs: i64[4] = [1, 7, 10, 25]
        for scenario in 0..<4 |rungs|:
            session: mutable HoldItGame::Session = HoldItGame::initialize(rungs[scenario.usize()], 2, true, 17)
            _ = HoldItGame::start(&session, 0.0)
            for tick in 1..<2200 |session, scenario|:
                now: f64 = tick.f64() / 32.0
                run: HoldIt::Run = session.run
                scale: f64 = 0.3 if scenario == 1 else (1.5 if scenario == 2 else 1.0)
                pressed: bool = scenario != 3 and run.time >= run.ask.turn and (not run.started or run.time - run.down < run.ask.target * scale - 0.000000001)
                _ = HoldItGame::advance(&session, now, pressed)
                if session.phase == HoldItGame::DONE:
                    _ = printf("done %lld %lld\n", session.passed_count, session.best_rung)
                    break
                _ = printf("%lld %lld %lld %.9f %lld %lld %.9f %lld %lld",
                    session.phase, session.trial, session.rung, session.run.time,
                    1 if session.run.started else 0, 1 if session.run.holding else 0,
                    session.run.held, session.run.result, 1 if HoldIt::lamp_lit(&session.run, 0) else 0)
                _ = printf(" %lld", 1 if HoldIt::lamp_lit(&session.run, 1) else 0)
                verdict: mutable dstr = []
                HoldIt::result_text(&session.run, &verdict)
                for byte in 0..<verdict.count.i64() |verdict|:
                    _ = printf("%c", verdict[byte.usize()].i32())
                _ = printf("\n")
        return 0.i32()
