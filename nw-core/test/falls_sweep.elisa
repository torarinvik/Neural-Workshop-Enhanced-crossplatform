include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/falls_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit_puzzle(puzzle: Falls::Puzzle&):
    can Console.Write, Abort.Panic:
        _ = printf("%lld %lld %lld\n", puzzle.kind, puzzle.choices, puzzle.answer)
        if puzzle.kind == Falls::STAND or puzzle.kind == Falls::FIRST:
            _ = printf("%lld %lld\n", puzzle.tower.count, Falls::first_to_fall(&puzzle.tower))
            for index in 0..<puzzle.tower.count |puzzle|:
                block: Falls::Block = puzzle.tower.blocks[index.usize()]
                _ = printf("%.17g %.17g %.17g %.17g %.17g\n", block.x, block.y, block.w, block.h,
                    Falls::lean(&puzzle.tower, index) if index > 0 else 0.0)
        elif puzzle.kind == Falls::LEVER:
            _ = printf("%lld\n", puzzle.lever.pivot)
            for index in 0..<Falls::PILE_SLOTS |puzzle|:
                _ = printf("%lld\n", puzzle.lever.piles[index.usize()])
        else:
            path: Falls::Flight = puzzle.flight
            _ = printf("%.17g %.17g %.17g %.17g %.17g %.17g\n", path.height, path.edge, path.speed, path.lo, path.hi,
                Falls::landing(path.height, path.speed, path.edge, path.bounces))
            for index in 0..<path.dot_count |path|:
                dot: Falls::Point = path.dots[index.usize()]
                _ = printf("%.17g %.17g\n", dot.x, dot.y)

def emit(rung: i64, seed: i64):
    can Console.Write, Abort.Panic:
        level: Falls::Grade = Falls::grade(rung)
        _ = printf("%lld %lld %lld %lld %lld %.17g %lld %lld %d\n", rung, seed, level.rung,
            level.newest, level.blocks, level.margin, level.bins, level.dots, 1 if level.offset_pivot else 0)
        puzzle: Falls::Puzzle = Falls::deal(rung, seed)
        emit_puzzle(&puzzle)

def replay() -> bool:
    can Console.Write, Abort.Panic:
        run: mutable FallsGame::Run = FallsGame::initialize(16, 5, true, -17)
        return false if not FallsGame::start(&run, 10)
        for index in 0..<5 |run|:
            now: i64 = 100 + index * 3000
            _ = printf("%lld %lld\n", run.rung, run.trial)
            emit_puzzle(&run.puzzle)
            answer: i64 = run.puzzle.answer
            return false if FallsGame::choose(&run, run.puzzle.choices, now)
            choice: i64 = answer if index % 2 == 0 else (answer + 1) % run.puzzle.choices
            return false if not FallsGame::choose(&run, choice, now)
            return false if FallsGame::choose(&run, answer, now) or FallsGame::advance(&run, now + 2799)
            return false if not FallsGame::advance(&run, now + 2800)
        _ = printf("%lld %lld %lld %lld\n", run.scored, run.passed, run.best, run.rung)
        return run.phase == FallsGame::DONE and FallsGame::start(&run, 20000) and run.rung == 16 and run.trial == 1 and run.scored == 0

def main() -> i32:
    can Console.Write, Abort.Panic:
        for rung in -1..<43:
            for seed in -11..<13 |rung|:
                emit(rung, seed)
        emit(24, -9223372036854775807 - 1)
        emit(24, 9223372036854775807)
        return 0.i32() if replay() else 1.i32()
