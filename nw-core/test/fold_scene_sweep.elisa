include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_fold.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, dark: bool, wrong: bool):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        run: mutable FoldGame::Run = FoldGame::initialize(rung, 1, false, 17)
        ready: i64 = SceneFold::hit(&run, 0.0, 0.0)
        _ = FoldGame::steer(&run, ready, 0)
        count: i64 = run.puzzle.level.choices
        opposite: bool = run.puzzle.level.opposite
        _ = printf("frame %lld %lld %lld %lld\n", rung, 1 if dark else 0, 1 if wrong else 0, ready)
        for i in 0..<count |run, count, opposite|:
            b: SceneFold::Box = SceneFold::card(opposite, count, i)
            _ = printf("hit %lld\n", SceneFold::hit(&run, b.x + b.width / 2.0, b.y + b.height / 2.0))
        if wrong:
            _ = FoldGame::steer(&run, (run.puzzle.answer + 1) % count, 1)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneFold::render(&list, &run, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u ", cmd.color)
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_BOX:
                _ = printf("box %u %.9g %.9g %.9g %.9g %.9g\n",
                    cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64())
            elif cmd.kind == Display::CMD_RECT:
                _ = printf("rect %u %.9g %.9g %.9g %.9g\n",
                    cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64())
            elif cmd.kind == Display::CMD_POLYGON:
                _ = printf("poly %u %u\n", cmd.color, cmd.len)
            elif cmd.kind == Display::CMD_POLY_POINT:
                _ = printf("point %.9g %.9g\n", cmd.a.f64(), cmd.b.f64())
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        levels: i64[5] = [1, 4, 11, 17, 26]
        for rung in levels:
            for theme in 0..<2 |rung|:
                for phase in 0..<2 |rung, theme|:
                    region scratch(1048576):
                        in scratch:
                            emit(rung, theme != 0, phase != 0)
        return 0.i32()
