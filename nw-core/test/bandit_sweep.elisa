include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/bandit_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, seed: i64, direct: bool):
    can Abort.Panic, Console.Write:
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, seed.u64())
        run: Bandit::Deal = Bandit::deal_seed(rung, -seed) if direct else Bandit::deal(rung, &rng)
        level: Bandit::Grade = run.level
        _ = printf("grade %lld %lld %lld %.17g %.17g %lld %lld %.17g\n",
            level.rung, level.arms, level.pulls, level.gap, level.drift, level.jumps, level.batch, level.noise)
        chosen: mutable i64[Bandit::PULLS] = zeroed
        for turn in 0..<level.pulls |run, level, chosen|:
            arm: i64 = Bandit::reference_move(&run, &chosen[0], turn)
            chosen[turn.usize()] <- arm
            _ = printf("turn %lld %lld\n", arm, Bandit::seen_after(level, turn))
            for machine in 0..<level.arms |run, turn|:
                _ = printf("pay %.17g %lld\n", run.means[(turn * Bandit::ARMS + machine).usize()],
                    Bandit::payout(&run, turn, machine))
        _ = printf("scores %lld %.17g %lld %.17g\n", Bandit::reference(&run), Bandit::floor(&run),
            Bandit::best(&run), Bandit::par(&run))

def state(session: BanditGame::Session&, accepted: bool):
    can Console.Write, Abort.Panic:
        _ = printf("session %lld %lld %lld %lld %lld %lld %lld %lld %lld %.17g\n",
            accepted.i64(), session.phase, session.rung, session.trial, session.pulls,
            session.revealed_coins, session.passed.i64(), session.wins, session.best_rung,
            session.par)

def controller():
    can Console.Write, Abort.Panic:
        session: mutable BanditGame::Session = BanditGame::initialize(16, 2, true, -17)
        started: bool = BanditGame::input(&session, BanditGame::START, 0)
        state(&session, started)
        now: mutable i64 = 0
        for trial in 0..<2 |session, now|:
            state(&session, BanditGame::input(&session, 7, now))
            while session.phase == BanditGame::PLAYING |session, now, trial|:
                arm: i64 = Bandit::reference_move(&session.run, &session.chosen[0], session.pulls) if trial == 0 else 0
                now <- now + 1
                state(&session, BanditGame::input(&session, arm, now))
            state(&session, BanditGame::advance(&session, now + 2999))
            now <- now + 3000
            state(&session, BanditGame::advance(&session, now))
        state(&session, BanditGame::input(&session, BanditGame::START, now + 1))

def main() -> i32:
    can Abort.Panic, Console.Write:
        rungs: i64[16] = [0, 1, 3, 4, 5, 6, 7, 9, 10, 12, 13, 16, 19, 20, 25, 35]
        for index in 0..<16 |rungs|:
            for seed in 0..<4 |rungs, index|:
                emit(rungs[index.usize()], 17 + seed * 31337, seed % 2 == 0)
        controller()
        return 0.i32()
