include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_signpainter.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def frame(game: SignPainterGame::Session&, name: cstr):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region scratch(65536):
            in scratch:
                list: mutable Display::DisplayList = Display::DisplayList()
                SceneSignPainter::render(&list, game, true)
                _ = printf("frame %s %lld %lld %lld %lld %lld\n", name, game.phase, game.rung,
                    game.trial, game.wins, game.run.stroke)
                for cmd in list.commands |list|:
                    if cmd.kind == Display::CMD_TEXT:
                        for i in 0..<(cmd.len & 0xffffff.u32()).i64() |list, cmd|:
                            _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                        _ = printf("\n")
                    elif cmd.kind == Display::CMD_POLYGON or cmd.kind == Display::CMD_POLY_POINT:
                        _ = printf("poly %u %u %u %.7g %.7g\n", cmd.kind, cmd.color, cmd.len, cmd.a.f64(), cmd.b.f64())
                    elif cmd.kind == Display::CMD_LINE or cmd.kind == Display::CMD_CIRCLE or cmd.kind == Display::CMD_RECT:
                        _ = printf("shape %u %u %.7g %.7g %.7g %.7g\n", cmd.kind, cmd.color,
                            cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64())
                _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        game: mutable SignPainterGame::Session = SignPainterGame::initialize(1, 1, true, 17)
        frame(&game, "ready")
        _ = SignPainterGame::start(&game, 0.0) can Global{Read,Write}
        frame(&game, "start")
        game.run.stroke <- 1
        game.run.point <- 3
        frame(&game, "outline")
        SignPainterGame::close(&game) can Global{Read,Write}

        game <- SignPainterGame::initialize(10, 1, true, 17)
        _ = SignPainterGame::start(&game, 0.0) can Global{Read,Write}
        game.run.time <- 3.25
        game.run.stroke <- 1
        game.run.point <- 3
        game.run.paint <- 2
        game.run.smudges <- 1
        _ = SignPainterGame::input(&game, SignPainter::RED + game.run.sign.colour) can Global{Read,Write}
        p: RoomsView::Point = game.run.sign.points[game.run.sign.ends[0].usize()]
        q: RoomsView::Vec = SignPainter::see(&game.run, p.x, p.y)
        _ = SignPainterGame::pointer(&game, SceneHand::x(q.x), SceneHand::y(q.y), 1, 0.0) can Global{Read,Write}
        frame(&game, "corners")
        _ = SignPainterGame::clear_controls(&game) can Global{Read,Write}
        _ = SignPainterGame::input(&game, SignPainter::DIP) can Global{Read,Write}
        frame(&game, "dipped")
        SignPainterGame::close(&game) can Global{Read,Write}

        game <- SignPainterGame::initialize(16, 1, true, 17)
        _ = SignPainterGame::start(&game, 0.0) can Global{Read,Write}
        game.run.time <- 1.8
        frame(&game, "unguided")
        SignPainterGame::close(&game) can Global{Read,Write}

        game <- SignPainterGame::initialize(1, 1, true, 17)
        _ = SignPainterGame::start(&game, 0.0) can Global{Read,Write}
        t: mutable f64 = 0.0
        while game.phase == SignPainterGame::PLAYING and t < 40.0 |game, t|:
            port: i64 = SignPainter::pilot(&game.run)
            _ = SignPainterGame::input(&game, port) can Global{Read,Write}
            t <- t + 1.0 / 60.0
            _ = SignPainterGame::advance(&game, t) can Global{Read,Write}
        frame(&game, "won")
        _ = SignPainterGame::advance(&game, t + 2.49) can Global{Read,Write}
        frame(&game, "hold")
        _ = SignPainterGame::advance(&game, t + 2.5) can Global{Read,Write}
        frame(&game, "done")
        SignPainterGame::close(&game) can Global{Read,Write}
        return 0
