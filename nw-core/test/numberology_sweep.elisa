# Differential sweep driver for tasks/numberology.elisa. See
# numberology_diff.py for the reference side: the same grid runs through the
# real neural_workshop/numberology.py.
#
# The generator reseeds per puzzle, so each row is independent -- but the DRAW
# ORDER inside a puzzle is still the thing under test, and the `x or 1` idiom
# is where it would break: substituting 1 for a zero draw must not redraw.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/pyset.elisa"
include "../src/tasks/maze.elisa"
include "../src/tasks/numberology.elisa"

# printr(i64) trips a stage1 backend decline of store_* generics
# (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

# sequence_length on its own, including the explicit-length path.
def sweep_length():
    can Console.Write, Abort.Panic:
        for difficulty in [-5, 0, 1, 2, 39, 40, 41, 79, 80, 400, 4000]:
            for requested in [0, -1, 1, 3, 4, 5, 12]:
                printr("len")
                emit_cell(difficulty)
                emit_cell(requested)
                emit_cell(Numberology::sequence_length(difficulty, requested))
                print("")

# Every family, across the level boundaries that switch between them.
def sweep_generate():
    can Console.Write, Memory.Allocate, Abort.Panic:
        for difficulty in [-2, 1, 2, 3, 4, 5, 6, 7, 8, 11, 12, 16, 18, 20, 24, 32, 36, 40, 48, 60]:
            for seed in [0, 1, 7, 42, 12345] |difficulty|:
                puzzle: Numberology::SeqPuzzle = Numberology::generate(difficulty, seed, 0)
                printr("gen")
                emit_cell(difficulty)
                emit_cell(seed)
                emit_cell(puzzle.shown)
                emit_cell(puzzle.answer)
                emit_cell(puzzle.rule_id)
                emit_cell(puzzle.rule_a)
                emit_cell(puzzle.rule_b)
                emit_cell(puzzle.rule_c)
                emit_cell(puzzle.difficulty)
                emit_cell(puzzle.complexity)
                term: mutable i64 = 0
                while term < puzzle.shown |term, puzzle|:
                    emit_cell(Ints::at(puzzle.terms, term))
                    term <- term + 1
                print("")

# An explicit length changes `shown`, which changes the recurrence order cap --
# so this is not just the same puzzles with more terms shown.
def sweep_lengths():
    can Console.Write, Memory.Allocate, Abort.Panic:
        for difficulty in [1, 3, 5, 6, 9, 20, 40]:
            for length in [4, 5, 8, 12] |difficulty|:
                for seed in [0, 3, 999] |difficulty, length|:
                    puzzle: Numberology::SeqPuzzle = Numberology::generate(difficulty, seed, length)
                    printr("lenpuz")
                    emit_cell(difficulty)
                    emit_cell(length)
                    emit_cell(seed)
                    emit_cell(puzzle.shown)
                    emit_cell(puzzle.answer)
                    emit_cell(puzzle.rule_id)
                    emit_cell(puzzle.rule_a)
                    emit_cell(puzzle.rule_b)
                    emit_cell(puzzle.rule_c)
                    emit_cell(puzzle.complexity)
                    term: mutable i64 = 0
                    while term < puzzle.shown |term, puzzle|:
                        emit_cell(Ints::at(puzzle.terms, term))
                        term <- term + 1
                    print("")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region arena_region(64 * 1024 * 1024)
        in arena_region:
            sweep_length()
            sweep_generate()
            sweep_lengths()
        destroy arena_region
        return 0
