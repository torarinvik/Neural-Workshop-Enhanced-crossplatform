include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_touching.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, seed: i64):
    can Console.Write, Abort.Panic:
        puzzle: Touching::Puzzle = Touching::deal(rung, seed)
        _ = printf("%lld %lld %lld %lld %.17g\n", rung, seed, puzzle.count, puzzle.answer, puzzle.level.margin)
        for i in 0..<puzzle.count |puzzle|:
            s: Touching::Shape = puzzle.shapes[i.usize()]
            _ = printf("%d %d %.17g %.17g %.17g %.17g\n", 1 if s.square else 0, 1 if s.filled else 0,
                s.x, s.y, s.r, s.turn)
            for j in 0..<i |puzzle, s|:
                _ = printf("%.17g\n", Touching::gap(s, puzzle.shapes[j.usize()]))

def main() -> i32:
    can Console.Write, Memory.Allocate, Abort.Panic:
        for rung in -1..<42:
            for seed in -12..<12 |rung|:
                emit(rung, seed)
        emit(25, -9223372036854775807 - 1)
        emit(25, 9223372036854775807)
        run: mutable TouchingGame::Run = TouchingGame::initialize(13, 3, true, 17)
        return 1.i32() if not TouchingGame::configure_think(&run, 0.2, 0.05)
        return 2.i32() if not TouchingGame::steer(&run, TouchingGame::START, 0)
        return 3.i32() if TouchingGame::choices(&run.puzzle) != 6 or run.puzzle.count != 4
        button: SceneHiddenRule::Rect = SceneTouching::button(run.puzzle.answer, 6)
        port: i64 = SceneTouching::hit(&run, button.x + button.w / 2.0, button.y + button.h / 2.0)
        return 4.i32() if port != run.puzzle.answer or not TouchingGame::steer(&run, port, 10)
        return 5.i32() if run.rung != 14 or run.best_rung != 13 or not run.passed
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneTouching::render(&list, &run, false)
        return 6.i32() if Display::encode_binary(&list).count < 1000.usize()
        return 7.i32() if not TouchingGame::step(&run, 0.1) or run.phase != TouchingGame::JUDGED
        return 8.i32() if not TouchingGame::step(&run, 0.1) or run.trial != 2
        return 9.i32() if not TouchingGame::step(&run, 0.2) or run.phase != TouchingGame::FLAGGED
        return 10.i32() if not TouchingGame::step(&run, 0.1) or run.think_left != 0.05
        return 0.i32()
