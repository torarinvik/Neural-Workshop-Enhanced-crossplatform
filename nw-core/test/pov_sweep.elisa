include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_pov.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def polygon(p: RoomsView::Polygon&):
    can Console.Write, Abort.Panic:
        _ = printf("%lld %llu %lld", p.cell, p.colour.u64(), p.count)
        for i in 0..<p.count |p|:
            v: RoomsView::Point = p.points[i.usize()]
            _ = printf(" %.17g %.17g", v.x, v.y)
        _ = printf("\n")

def emit(rung: i64, seed: i64) -> bool:
    can Memory.Allocate, Console.Write, Abort.Panic:
        puzzle: PointOfView::Puzzle = PointOfView::deal(rung, seed)
        return false if puzzle.table.count == 0
        _ = printf("%lld %lld %lld %lld %lld %lld %.17g %.17g\n", rung, seed, puzzle.level.rung, puzzle.table.count,
            puzzle.level.choices, puzzle.answer, puzzle.target.angle, puzzle.target.eye)
        for i in 0..<puzzle.table.count |puzzle|:
            s: Nearer::Solid = puzzle.table.solids[i.usize()]
            _ = printf("%lld %lld %.17g %.17g %.17g %.17g %.17g\n", s.kind, s.colour, s.x, s.y, s.z, s.size, s.yaw)
            p: RoomsView::Polygon = PointOfViewView::footprint(s)
            polygon(&p)
        for i in 0..<puzzle.level.choices |puzzle|:
            view: PointOfView::View = puzzle.views[i.usize()]
            _ = printf("%lld %.17g %.17g %lld\n", 1 if view.mirrored else 0, view.angle, view.eye,
                PointOfView::signature(&puzzle.table, view))
            painted: RoomsView::Picture = PointOfViewView::picture(&puzzle.table, view)
            _ = printf("%lld\n", painted.count)
            for j in 0..<painted.count |painted|:
                polygon(&painted.polygons[j.usize()])
        return true

def main() -> i32:
    can Memory.Allocate, Console.Write, Abort.Panic:
        for rung in -1..<32:
            for seed in -10..<10 |rung|:
                return 1.i32() if not emit(rung, seed)
        return 2.i32() if not emit(25, -9223372036854775807 - 1)
        return 3.i32() if not emit(25, 9223372036854775807)
        run: mutable PointOfViewGame::Run = PointOfViewGame::initialize(20, 3, true, 17)
        return 4.i32() if not PointOfViewGame::configure_think(&run, 0.2, 0.05)
        return 5.i32() if not PointOfViewGame::steer(&run, PointOfViewGame::START, 0)
        _ = printf("start %lld %lld\n", run.puzzle.seed, run.rung)
        list: mutable Display::DisplayList = Display::DisplayList()
        ScenePointOfView::render(&list, &run, false)
        return 6.i32() if Display::encode_binary(&list).count < 1000.usize()
        card: ScenePointOfView::Card = ScenePointOfView::card(run.puzzle.answer, run.puzzle.level.choices)
        port: i64 = ScenePointOfView::hit(&run, card.x + card.w / 2.0, card.y + card.h / 2.0)
        return 7.i32() if port != run.puzzle.answer or not PointOfViewGame::steer(&run, port, 0)
        return 8.i32() if not PointOfViewGame::step(&run, 0.1) or run.phase != PointOfViewGame::JUDGED
        return 9.i32() if not PointOfViewGame::step(&run, 0.1) or run.phase != PointOfViewGame::PLAYING
        _ = printf("next %lld %lld\n", run.puzzle.seed, run.rung)
        return 10.i32() if not PointOfViewGame::step(&run, 0.2) or run.phase != PointOfViewGame::FLAGGED
        return 11.i32() if not PointOfViewGame::step(&run, 0.1) or run.think_left != 0.05 or run.forfeits != 1
        _ = printf("refill %lld %lld\n", run.puzzle.seed, run.rung)
        wrong: i64 = (run.puzzle.answer + 1) % 5
        return 12.i32() if not PointOfViewGame::steer(&run, wrong, 100)
        return 13.i32() if run.passed or run.rung != 20 or run.passed_count != 1
        return 14.i32() if PointOfViewGame::advance(&run, 2599) or not PointOfViewGame::advance(&run, 2600)
        return 15.i32() if run.phase != PointOfViewGame::DONE or not run.has_verdict or run.scored_count != 2
        return 0.i32()
