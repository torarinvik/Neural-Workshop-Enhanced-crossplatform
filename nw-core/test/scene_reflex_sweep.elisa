# Differential sweep driver for src/scene_reflex.elisa.
# See scene_reflex_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_reflex.elisa"
include "scene_emit.elisa"

# The stand-in library, mirrored by the harness. Three shapes of image, so a
# scale taken from the WIDTH is not the same number as one taken from the
# height or from the larger side.
const IMAGE_COUNT: i64 = 3

def image_width_of(which: i64) -> i64:
    if which == 0:
        return 64
    elif which == 1:
        return 200
    return 37

def image_height_of(which: i64) -> i64:
    if which == 0:
        return 64
    elif which == 1:
        return 50
    return 91

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|targets|start_size|spawned|total_targets|hits|misses|tall|verdict")
            for spec in 0..<36:
                phase: i64 = spec % 3
                black: bool = spec % 7 == 1
                count: i64 = (spec / 3) % 6
                start_size: i64 = 40 + (spec / 3) % 4 * 30
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(count)
                emit_bar(start_size)
                emit_bar(spec % 13)
                emit_bar(12)
                emit_bar(spec % 5)
                emit_bar(spec % 4)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                targets: mutable darray[SceneReflex::Target] = []
                for index in 0..<count |targets|:
                    which: i64 = index % IMAGE_COUNT
                    targets.push(SceneReflex::Target{
                        x: 0.12 + 0.14 * (index % 6).f64(),
                        y: 0.22 + 0.12 * (index % 5).f64(),
                        # A target with NO life left is still drawn, at the
                        # scale floor, so one of every five is spent.
                        remaining: 0.0 if index % 5 == 4 else 1.0 - 0.17 * (index % 5).f64(),
                        asset: which,
                        image_width: image_width_of(which),
                        image_height: image_height_of(which)})
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneReflex::Paint = SceneReflex::paint_of(black, width, height, 2.0, 2.0)
                SceneReflex::render(&list, &paint, phase, &targets,
                                    start_size.f64(), spec % 13, 12,
                                    spec % 5, spec % 4,
                                    sview("Click them before they go", 0, -1),
                                    verdict,
                                    sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
