# Differential sweep for stimulus.elisa against bwaccel/fallback.py.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../src/pyrandom.elisa"
include "../src/stimulus.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

def sweep_variable():
    can Console.Write, Memory.Allocate, Abort.Panic:
        for seed in [1, 42, 9999]:
            for back in [2, 3, 4, 7, 10] |seed|:
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, seed.u64())
                levels: darray[i64] = variable_nback_list(&rng, 15, back)
                printr("vnl")
                emit_cell(seed)
                emit_cell(back)
                for level in levels:
                    emit_cell(level)
                print("")

def sweep_sample():
    can Console.Write, Memory.Allocate, Abort.Panic:
        for seed in [8, 4242]:
            for high in [6, 20, 25, 64] |seed|:
                for k in [1, 3, 6] |seed, high|:
                    rng: mutable MT19937 = mt19937_new()
                    mt_seed_int(&rng, seed.u64())
                    picked: darray[i64] = sample_unique(&rng, 1, high, k)
                    printr("su")
                    emit_cell(seed)
                    emit_cell(high)
                    emit_cell(k)
                    for value in picked:
                        emit_cell(value)
                    print("")

# An unrealizable request raises in the reference; the harness prints a
# zero-length row for it on both sides.
def empty_sequence() -> BtSequence:
    can Memory.Allocate, Abort.Panic:
        blank_positions: mutable darray[i64] = []
        blank_audio: mutable darray[i64] = []
        return BtSequence{positions: blank_positions, audio: blank_audio}

def sweep_bt():
    can Console.Write, Memory.Allocate, Abort.Panic:
        for seed in [2, 1234]:
            for nback in [1, 2, 3] |seed|:
                for trials in [12, 20, 30] |seed, nback|:
                    for both in [0, 2, 4] |seed, nback, trials|:
                        rng: mutable MT19937 = mt19937_new()
                        mt_seed_int(&rng, seed.u64())
                        built: BtSequence = try compute_bt_sequence(&rng, trials, nback, 6, 6, both, 8, 8) else empty_sequence()
                        printr("bt")
                        emit_cell(seed)
                        emit_cell(nback)
                        emit_cell(trials)
                        emit_cell(both)
                        emit_cell(built.positions.count.i64())
                        for value in built.positions:
                            emit_cell(value)
                        for value in built.audio:
                            emit_cell(value)
                        print("")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(64 * 1024 * 1024)
        in work:
            sweep_variable()
            sweep_sample()
            sweep_bt()
        destroy work
        return 0
