# Differential sweep for stimulus.elisa against bwaccel/fallback.py.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../src/pyrandom.elisa"
include "../src/stimulus.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

def sweep_variable(a: mutable Arena&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        in a:
            for seed in [1, 42, 9999] |a|:
                for back in [2, 3, 4, 7, 10] |a, seed|:
                    rng: mutable MT19937 = mt19937_new()
                    mt_seed_int(&rng, seed.u64())
                    levels: darray[i64] = variable_nback_list(a, &rng, 15, back)
                    printr("vnl")
                    emit_cell(seed)
                    emit_cell(back)
                    for level in levels:
                        emit_cell(level)
                    print("")

def sweep_sample(a: mutable Arena&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        in a:
            for seed in [8, 4242] |a|:
                for high in [6, 20, 25, 64] |a, seed|:
                    for k in [1, 3, 6] |a, seed, high|:
                        rng: mutable MT19937 = mt19937_new()
                        mt_seed_int(&rng, seed.u64())
                        picked: darray[i64] = sample_unique(a, &rng, 1, high, k)
                        printr("su")
                        emit_cell(seed)
                        emit_cell(high)
                        emit_cell(k)
                        for value in picked:
                            emit_cell(value)
                        print("")

# An unrealizable request raises in the reference; the harness prints a
# zero-length row for it on both sides.
def empty_sequence(a: mutable Arena&) -> BtSequence:
    can Memory.Allocate, Abort.Panic:
        in a:
            blank_positions: mutable darray[i64] = []
            blank_audio: mutable darray[i64] = []
            return BtSequence{positions: blank_positions, audio: blank_audio}

def sweep_bt(a: mutable Arena&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        in a:
            for seed in [2, 1234] |a|:
                for nback in [1, 2, 3] |a, seed|:
                    for trials in [12, 20, 30] |a, seed, nback|:
                        for both in [0, 2, 4] |a, seed, nback, trials|:
                            rng: mutable MT19937 = mt19937_new()
                            mt_seed_int(&rng, seed.u64())
                            built: BtSequence = try compute_bt_sequence(a, &rng, trials, nback, 6, 6, both, 8, 8) else empty_sequence(a)
                            printr("bt")
                            emit_cell(seed)
                            emit_cell(nback)
                            emit_cell(trials)
                            emit_cell(both)
                            emit_cell(built.positions.count.i64())
                            for value in built.positions:
                                emit_cell(value)
                            for value in built.audio:
                                emit_cell(value)
                            print("")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(64 * 1024 * 1024)
        arena: mutable Arena& = (&work).cast[mutable Arena&]
        sweep_variable(arena)
        sweep_sample(arena)
        sweep_bt(arena)
        destroy work
        return 0
