# Differential sweep driver for src/scene_chess.elisa.
# See scene_chess_diff.py for the reference side.
#
# The position is named rather than played: the sweep writes a piece table
# directly, which reaches boards no legal game would and keeps move generation
# -- the one dependency this project decided to keep rather than reimplement --
# out of the drawing test. The target squares come in the same way.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/chess.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_chess.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            width: f64 = 1824.0
            height: f64 = 1368.0
            piece: mutable darray[i64] = Ints::zeros(64)
            white: mutable darray[i64] = Ints::zeros(64)
            targets: mutable darray[i64] = Ints::zeros(64)
            print("names|spec|phase|black|view_white|selected|trial|total_trials")
            for spec in 0..<24 |width, height, piece, white, targets|:
                phase: i64 = 1 + spec % 3
                black: bool = spec % 5 == 3
                view_white: bool = spec % 2 == 0
                for square in 0..<64 |piece, white, targets, spec|:
                    # A third of the squares hold a man, and the kinds cycle so
                    # every glyph is drawn somewhere.
                    kind: mutable i64 = 0
                    if (square * 5 + spec) % 3 == 0:
                        kind <- Chess::PAWN + (square + spec) % 6
                    Ints::put(piece, square, kind)
                    Ints::put(white, square, 1 if (square + spec) % 2 == 0 else 0)
                    Ints::put(targets, square, 1 if (square * 3 + spec) % 7 == 0 else 0)
                selected: i64 = -1 if spec % 4 == 3 else (spec * 11) % 64
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if view_white else 0)
                emit_bar(selected)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                print("")
                message: mutable dstr = []
                dstr_append_cstr(&message, "Level 3 ")
                dstr_append_em_dash(&message)
                dstr_append_cstr(&message, " White to move and mate in one")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneChess::Paint = SceneChess::paint_of(black, width, height, 2.0, 2.0)
                SceneChess::render(&list, &paint, piece, white, targets,
                                   view_white, phase, selected, 1 + spec % 5, 5,
                                   bytes_view(message))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
