include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/rover_game.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def emit(session: RoverGame::Session&):
    can Abort.Panic, Console.Write:
        _ = dprintf(1.i32(), "state")
        for field in 0..<20 |session|:
            _ = dprintf(1.i32(), " %lld", RoverGame::info(session, field))
        _ = dprintf(1.i32(), "\n")

def replay() -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic, Global.Read, Global.Write, Console.Write:
        session: mutable RoverGame::Session = RoverGame::initialize(4, 3, true, 17)
        return 1.i32() if not RoverGame::start(&session, 0.0)
        emit(&session)
        return 2.i32() if RoverGame::reconfigure(&session, 7, 1, false)
        _ = RoverGame::key(&session, 0, true)
        _ = RoverGame::key(&session, 4, true)
        _ = RoverGame::key(&session, 7, true)
        for i in 1..<121 |session|:
            if i == 3:
                _ = RoverGame::key(&session, 0, false)
            if i == 11:
                _ = RoverGame::key(&session, 4, false)
            if i == 17:
                _ = RoverGame::steer(&session, Rover::BRAKE)
            if i == 21:
                _ = RoverGame::clear_keys(&session)
            region frame(262144):
                in frame:
                    _ = RoverGame::advance(&session, i.f64() * 0.125)
            emit(&session)

        for i in 0..<session.run.ground.level.flags |session|:
            p: Rover::Point = session.run.ground.flags[i.usize()]
            session.run.state <- Rover::State{x: p.x, z: p.z, heading: 0.0, v: 0.0}
            _ = RoverGame::advance(&session, 15.0)
            emit(&session)
        return 3.i32() if session.phase != RoverGame::JUDGED or session.rung != 5
        return 4.i32() if RoverGame::advance(&session, 17.49)
        _ = RoverGame::advance(&session, 17.5)
        emit(&session)
        session.run.t <- session.run.ground.seconds + 1.0
        _ = RoverGame::advance(&session, 17.5)
        emit(&session)
        _ = RoverGame::agent_event(&session, 17.5, Rover::NEUTRAL)
        emit(&session)
        rock: Rover::Rock = session.run.ground.rocks[0]
        session.run.state <- Rover::State{x: rock.at.x, z: rock.at.z, heading: 0.0, v: 0.0}
        _ = RoverGame::advance(&session, 17.5)
        emit(&session)
        _ = RoverGame::agent_event(&session, 17.5, Rover::NEUTRAL)
        emit(&session)
        return 5.i32() if session.phase != RoverGame::DONE or session.wins != 1 or session.best_rung != 4
        return 6.i32() if not RoverGame::reconfigure(&session, 1, 1, false)
        return 7.i32() if not RoverGame::start(&session, 17.5)
        emit(&session)
        RoverGame::close(&session)
        RoverGame::close(&session)
        return 0.i32()

def main() -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic, Global.Read, Global.Write, Console.Write:
        return replay()
