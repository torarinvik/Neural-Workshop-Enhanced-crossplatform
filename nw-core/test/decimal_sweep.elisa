# Differential sweep for decimal.elisa against CPython's `decimal`,
# bwaccel/arithmetic.py and neural_workshop/matching.py.
#
# Every case prints one CSV line. Values cross as `str(Decimal)`, which encodes
# sign, coefficient and exponent exactly, so 0.1 and 0.10 cannot pass for each
# other. Failures print E1 (DivisionByZero), E2 (InvalidOperation) or E3
# (Overflow) -- the same codes decimal_diff.py derives from the exceptions the
# reference raises.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
# score_arithmetic reaches for nback.elisa's resolve_back, the port of the
# reference's _resolve_back.
include "../src/nback.elisa"
include "../src/decimal.elisa"

const PARSE_INPUT_COUNT: i64 = 50
const FROM_INT_COUNT: i64 = 8
const DEC_OPERAND_COUNT: i64 = 16
const CHECK_ANSWER_COUNT: i64 = 5
const CHECK_LEFT_COUNT: i64 = 5
const CHECK_RIGHT_COUNT: i64 = 3
const OP_COUNT: i64 = 4
const SESSION_LENGTH: i64 = 14

# Printing integers still declines under stage1's backend (see PORTING.md), so
# the sweep carries its own.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def print_text(text: DecimalText&):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            printr((&text.b[0]).cast[cstr])

def view_of(text: cstr) -> sview:
    can Abort.Panic:
        return sview(text.cast[u8&?], 0, string_len(text.cast[u8&?]))

def emit_value(outcome: DecimalOutcome&):
    can Console.Write, Abort.Panic:
        if outcome.status != DEC_OK:
            printr("E")
            print_i64(outcome.status)
        else:
            rendered: DecimalText = decimal_to_text(&outcome.value)
            print_text(&rendered)

def emit_i64(value: i64):
    can Console.Write, Abort.Panic:
        print_i64(value)
        printr(",")

def op_at(index: i64) -> ArithmeticOp:
    if index == 0:
        return ArithmeticOp.Add
    if index == 1:
        return ArithmeticOp.Subtract
    if index == 2:
        return ArithmeticOp.Multiply
    return ArithmeticOp.Divide

def parse_decimal(text: cstr) -> Decimal:
    can Abort.Panic:
        outcome: DecimalOutcome = decimal_from_string_checked(view_of(text))
        return outcome.value

# Strings fed to from_string: whitespace, signs, empty fraction parts, leading
# zeros, exponents, and the spellings this port rejects. Kept index-for-index
# with PARSE_INPUTS in decimal_diff.py.
def parse_input(index: i64) -> cstr:
    if index == 0:
        return "0"
    if index == 1:
        return "-0"
    if index == 2:
        return "+0"
    if index == 3:
        return "1"
    if index == 4:
        return "-1"
    if index == 5:
        return "12"
    if index == 6:
        return "1.5"
    if index == 7:
        return "-1.5"
    if index == 8:
        return "0.5"
    if index == 9:
        return ".5"
    if index == 10:
        return "-.5"
    if index == 11:
        return "5."
    if index == 12:
        return "1.50"
    if index == 13:
        return "0.00"
    if index == 14:
        return "000"
    if index == 15:
        return "0.0100"
    if index == 16:
        return "00123"
    if index == 17:
        return "007"
    if index == 18:
        return "1e5"
    if index == 19:
        return "1E+5"
    if index == 20:
        return "1E-5"
    if index == 21:
        return "-2.5E-3"
    if index == 22:
        return "  -12.75  "
    if index == 23:
        return "\t7\n"
    if index == 24:
        return "0.1E+1000000000"
    if index == 25:
        return "12345678901234567890123456789012"
    if index == 26:
        return "0.000000000000000000000000000001"
    if index == 27:
        return "9999999999999999999999999999"
    if index == 28:
        return "1E+1000000"
    if index == 29:
        return ""
    if index == 30:
        return "."
    if index == 31:
        return "-"
    if index == 32:
        return "+"
    if index == 33:
        return "1.2.3"
    if index == 34:
        return "1 2"
    if index == 35:
        return "abc"
    if index == 36:
        return "1e"
    if index == 37:
        return "1e+"
    if index == 38:
        return "1E5x"
    if index == 39:
        return "--1"
    if index == 40:
        return "1-"
    if index == 41:
        return "NaN"
    if index == 42:
        return "Infinity"
    if index == 43:
        return "-Infinity"
    if index == 44:
        return "sNaN"
    if index == 45:
        return "1_000"
    if index == 46:
        return "1E+2000000000"
    if index == 47:
        return "12345678901234567890123456789012345678901234567890123456789012345"
    # The capacity boundaries themselves, which must still be accepted.
    if index == 48:
        return "1234567890123456789012345678901234567890123456789012345678901234"
    if index == 49:
        return "1E-1000000000"
    return ""

# Decimal(int) is exact; the extremes check the digit extraction, including the
# most negative i64 (spelled as a subtraction because its magnitude has no i64
# literal).
def from_int_at(index: i64) -> i64:
    if index == 0:
        return 0
    if index == 1:
        return 1
    if index == 2:
        return -1
    if index == 3:
        return 7
    if index == 4:
        return -7
    if index == 5:
        return 1000000
    if index == 6:
        return 9223372036854775807
    return -9223372036854775807 - 1

# Operands for the string-driven operation grid: zeros at several exponents,
# trailing-zero forms, a negative fraction, an exponent form, and a 28-digit
# coefficient whose products have to round.
def dec_operand(index: i64) -> cstr:
    if index == 0:
        return "0"
    if index == 1:
        return "0.00"
    if index == 2:
        return "1"
    if index == 3:
        return "1.0"
    if index == 4:
        return "-1"
    if index == 5:
        return "2.5"
    if index == 6:
        return "-0.125"
    if index == 7:
        return "12"
    if index == 8:
        return "100"
    if index == 9:
        return "0.1"
    if index == 10:
        return "1E+3"
    if index == 11:
        return "9999999999999999999999999999"
    if index == 12:
        return "1E+30"
    if index == 13:
        return "1E-30"
    if index == 14:
        return "10000000000000000000000000005"
    return "10000000000000000000000000015"

def check_answer(index: i64) -> cstr:
    if index == 0:
        return "0"
    if index == 1:
        return "7"
    if index == 2:
        return "2.5"
    if index == 3:
        return "0.3333333333333333333333333333"
    return "4"

# The answers the player typed in the scored session: what a 2-back run with no
# crab and no variable list would have called correct on seven of the trials.
# Three hits are spelled differently from the computed answer (-1.50, 0.00, and
# the full 28-digit quotient of 1/3) because Decimal equality is numeric.
def session_answer(index: i64) -> cstr:
    if index == 0:
        return "0"
    if index == 1:
        return "1"
    if index == 2:
        return "3"
    if index == 3:
        return "5"
    if index == 4:
        return "0"
    if index == 5:
        return "2"
    if index == 6:
        return "7"
    if index == 7:
        return "-6"
    if index == 8:
        return "-1.50"
    if index == 9:
        return "0"
    if index == 10:
        return "-2"
    if index == 11:
        return "0"
    if index == 12:
        return "0.00"
    return "0.3333333333333333333333333333"

def check_left(index: i64) -> i64:
    if index == 0:
        return 0
    if index == 1:
        return 1
    if index == 2:
        return 3
    if index == 3:
        return 7
    return 12

def check_right(index: i64) -> i64:
    if index == 0:
        return 0
    if index == 1:
        return 2
    return 3

def sweep_parse():
    can Console.Write, Abort.Panic:
        index: mutable i64 = 0
        while index < PARSE_INPUT_COUNT |index|:
            printr("parse,")
            emit_i64(index)
            outcome: DecimalOutcome = decimal_from_string_checked(view_of(parse_input(index)))
            emit_value(&outcome)
            print("")
            index <- index + 1

def sweep_from_int():
    can Console.Write, Abort.Panic:
        index: mutable i64 = 0
        while index < FROM_INT_COUNT |index|:
            value: i64 = from_int_at(index)
            printr("fromint,")
            emit_i64(value)
            converted: Decimal = decimal_from_i64(value)
            rendered: DecimalText = decimal_to_text(&converted)
            print_text(&rendered)
            print("")
            index <- index + 1

# The operand range a session actually produces: randint over
# -ARITHMETIC_MAX_NUMBER..ARITHMETIC_MAX_NUMBER, default maximum 12.
def sweep_game():
    can Console.Write, Abort.Panic:
        op_index: mutable i64 = 0
        while op_index < OP_COUNT |op_index|:
            left: mutable i64 = -12
            while left <= 12 |left, op_index|:
                right: mutable i64 = -12
                while right <= 12 |right, left, op_index|:
                    a: Decimal = decimal_from_i64(left)
                    b: Decimal = decimal_from_i64(right)
                    outcome: DecimalOutcome = apply_arithmetic_checked(op_at(op_index), &a, &b)
                    printr("game,")
                    emit_i64(op_index)
                    emit_i64(left)
                    emit_i64(right)
                    emit_value(&outcome)
                    print("")
                    right <- right + 1
                left <- left + 1
            op_index <- op_index + 1

def sweep_dec():
    can Console.Write, Abort.Panic:
        op_index: mutable i64 = 0
        while op_index < OP_COUNT |op_index|:
            left: mutable i64 = 0
            while left < DEC_OPERAND_COUNT |left, op_index|:
                right: mutable i64 = 0
                while right < DEC_OPERAND_COUNT |right, left, op_index|:
                    a: Decimal = parse_decimal(dec_operand(left))
                    b: Decimal = parse_decimal(dec_operand(right))
                    outcome: DecimalOutcome = apply_arithmetic_checked(op_at(op_index), &a, &b)
                    printr("dec,")
                    emit_i64(op_index)
                    printr(dec_operand(left))
                    printr(",")
                    printr(dec_operand(right))
                    printr(",")
                    emit_value(&outcome)
                    print("")
                    right <- right + 1
                left <- left + 1
            op_index <- op_index + 1

def sweep_remainder():
    can Console.Write, Abort.Panic:
        left: mutable i64 = 0
        while left < DEC_OPERAND_COUNT |left|:
            right: mutable i64 = 0
            while right < DEC_OPERAND_COUNT |right, left|:
                a: Decimal = parse_decimal(dec_operand(left))
                b: Decimal = parse_decimal(dec_operand(right))
                outcome: DecimalOutcome = decimal_remainder_checked(&a, &b)
                printr("rem,")
                printr(dec_operand(left))
                printr(",")
                printr(dec_operand(right))
                printr(",")
                emit_value(&outcome)
                print("")
                right <- right + 1
            left <- left + 1

def sweep_compare():
    can Console.Write, Abort.Panic:
        left: mutable i64 = 0
        while left < DEC_OPERAND_COUNT |left|:
            right: mutable i64 = 0
            while right < DEC_OPERAND_COUNT |right, left|:
                a: Decimal = parse_decimal(dec_operand(left))
                b: Decimal = parse_decimal(dec_operand(right))
                printr("cmp,")
                printr(dec_operand(left))
                printr(",")
                printr(dec_operand(right))
                printr(",")
                print_i64(decimal_compare(&a, &b))
                print("")
                right <- right + 1
            left <- left + 1

# The verdict matching.py's _check_arithmetic returns: 1 for CORRECT, 0 for
# INCORRECT -- including the x/0 rows, where the reference catches the
# exception and scores the trial wrong.
def sweep_check():
    can Console.Write, Abort.Panic:
        op_index: mutable i64 = 0
        while op_index < OP_COUNT |op_index|:
            left: mutable i64 = 0
            while left < CHECK_LEFT_COUNT |left, op_index|:
                right: mutable i64 = 0
                while right < CHECK_RIGHT_COUNT |right, left, op_index|:
                    answer: mutable i64 = 0
                    while answer < CHECK_ANSWER_COUNT |answer, right, left, op_index|:
                        a: Decimal = decimal_from_i64(check_left(left))
                        b: Decimal = decimal_from_i64(check_right(right))
                        given: Decimal = parse_decimal(check_answer(answer))
                        correct: bool = arithmetic_answer_is_correct(op_at(op_index), &a, &b, &given)
                        printr("check,")
                        emit_i64(op_index)
                        emit_i64(check_left(left))
                        emit_i64(check_right(right))
                        printr(check_answer(answer))
                        printr(",")
                        print_i64(1 if correct else 0)
                        print("")
                        answer <- answer + 1
                    right <- right + 1
                left <- left + 1
            op_index <- op_index + 1

# The error-set surface, which the rest of the sweep does not reach: every
# other section calls the *_checked functions, so these rows are what proves
# `raise` fires and `catch` sees it. The variant is recovered from the checked
# call because variant patterns in catch arms are stage0-only (see
# Code/test_programs/fileio_std.elisa).
def emit_union_parse(tag: i64, text: cstr):
    can Console.Write, Abort.Panic:
        printr("union,")
        emit_i64(tag)
        catch decimal_from_string(view_of(text)):
            parsed:
                rendered: DecimalText = decimal_to_text(&parsed)
                print_text(&rendered)
            error e:
                fallback: DecimalOutcome = decimal_from_string_checked(view_of(text))
                printr("E")
                print_i64(fallback.status)
        print("")

def emit_union_op(tag: i64, op: ArithmeticOp, left: i64, right: i64):
    can Console.Write, Abort.Panic:
        a: Decimal = decimal_from_i64(left)
        b: Decimal = decimal_from_i64(right)
        printr("union,")
        emit_i64(tag)
        catch apply_arithmetic(op, &a, &b):
            computed:
                rendered: DecimalText = decimal_to_text(&computed)
                print_text(&rendered)
            error e:
                fallback: DecimalOutcome = apply_arithmetic_checked(op, &a, &b)
                printr("E")
                print_i64(fallback.status)
        print("")

def emit_union_remainder(tag: i64, left: i64, right: i64):
    can Console.Write, Abort.Panic:
        a: Decimal = decimal_from_i64(left)
        b: Decimal = decimal_from_i64(right)
        printr("union,")
        emit_i64(tag)
        catch decimal_remainder(&a, &b):
            computed:
                rendered: DecimalText = decimal_to_text(&computed)
                print_text(&rendered)
            error e:
                fallback: DecimalOutcome = decimal_remainder_checked(&a, &b)
                printr("E")
                print_i64(fallback.status)
        print("")

def sweep_error_union():
    can Console.Write, Abort.Panic:
        emit_union_parse(0, "12.5")
        emit_union_parse(1, "oops")
        emit_union_parse(2, "12345678901234567890123456789012345678901234567890123456789012345")
        emit_union_op(3, ArithmeticOp.Add, 1, 2)
        emit_union_op(4, ArithmeticOp.Subtract, 1, 2)
        emit_union_op(5, ArithmeticOp.Multiply, 3, 4)
        emit_union_op(6, ArithmeticOp.Divide, 1, 3)
        emit_union_op(7, ArithmeticOp.Divide, 1, 0)
        emit_union_op(8, ArithmeticOp.Divide, 0, 0)
        emit_union_remainder(9, 7, 2)
        emit_union_remainder(10, 1, 0)

# Whole-session scoring. The session mixes a zero operand (so division fails),
# answers that are right on some trials, and every fifth operation carrying an
# out-of-range code -- the reference's unknown-operation ValueError.
def sweep_score(a: mutable Arena&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        in a:
            numbers: mutable darray[Decimal] = []
            operations: mutable darray[i64] = []
            answers: mutable darray[Decimal] = []
            variable_list: mutable darray[i64] = []
            index: mutable i64 = 0
            while index < SESSION_LENGTH |index, numbers, operations, answers, variable_list|:
                numbers.push(decimal_from_i64((index % 7) - 3))
                operations.push(index % 5)
                answers.push(parse_decimal(session_answer(index)))
                variable_list.push(1 + index % 4)
                index <- index + 1
            for nback in [1, 2, 3] |numbers, operations, answers, variable_list|:
                for crab in [0, 1] |numbers, operations, answers, variable_list, nback|:
                    for varnb in [0, 1] |numbers, operations, answers, variable_list, nback, crab|:
                        score: ArithmeticScore = score_arithmetic(&numbers, &operations, &answers, nback, crab != 0, &variable_list, varnb != 0)
                        printr("score,")
                        emit_i64(nback)
                        emit_i64(crab)
                        emit_i64(varnb)
                        emit_i64(score.rights)
                        print_i64(score.wrongs)
                        print("")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work(4 * 1024 * 1024)
        arena: mutable Arena& = (&work).cast[mutable Arena&]
        sweep_parse()
        sweep_from_int()
        sweep_game()
        sweep_dec()
        sweep_remainder()
        sweep_compare()
        sweep_check()
        sweep_error_union()
        sweep_score(arena)
        destroy work
        return 0
