# Differential sweep driver for tasks/hanoi.elisa. See hanoi_diff.py for the
# reference side.
#
# Tower of Hanoi has no core module in the reference -- its rules live in
# ui/hanoi.py beside the drawing -- so what is compared is the rules, the
# adaptive ladder and the scoring, driven through a scripted run of moves
# rather than through a window.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/hanoi.elisa"

# printr(i64) and int_to_string_scratch both trip a stage1 backend decline of
# store_* generics (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)


def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(64 * 1024 * 1024)
        in w:
            # The formula, the clamp, and the ladder's two thresholds.
            for disks in 0..<16:
                printr("par")
                emit_cell(disks)
                emit_cell(Hanoi::clamped(disks))
                emit_cell(Hanoi::minimum_moves(Hanoi::clamped(disks)))
                print("")

            # The recursive solution walked move by move through the rules, so
            # a wrong `can_move` shows up as a solve that stops early rather
            # than as a number.
            for disks in 3..<11:
                board: mutable Hanoi::Board = Hanoi::fresh_pegs(disks)
                moves: mutable darray[i64] = Ints::zeros(2 * ((1 << disks) + 1))
                count: mutable i64 = 0
                Hanoi::solve(disks, 0, 1, 2, &moves, &count)
                walked: mutable i64 = 0
                legal: mutable bool = true
                for at in 0..<count |board, moves, walked, legal|:
                    break if not legal
                    source: i64 = Ints::at_ref(&moves, at * 2)
                    target: i64 = Ints::at_ref(&moves, at * 2 + 1)
                    if Hanoi::apply_move(&board, source, target):
                        walked <- walked + 1
                    else:
                        legal <- false
                printr("solve")
                emit_cell(disks)
                emit_cell(count)
                emit_cell(walked)
                emit_cell(1 if legal else 0)
                emit_cell(1 if Hanoi::solved(&board) else 0)
                for peg in 0..<Hanoi::PEGS |board|:
                    emit_cell(Ints::at_ref(&board.height, peg))
                print("")

            # Illegal moves are REFUSED and not scored, so the board has to be
            # unchanged after one. Every ordered pair from a mid-solve position.
            board: mutable Hanoi::Board = Hanoi::fresh_pegs(5)
            _ = Hanoi::apply_move(&board, 0, 2)
            _ = Hanoi::apply_move(&board, 0, 1)
            for source in 0..<Hanoi::PEGS |board|:
                for target in 0..<Hanoi::PEGS |board, source|:
                    printr("legal")
                    emit_cell(source)
                    emit_cell(target)
                    emit_cell(1 if Hanoi::can_move(&board, source, target) else 0)
                    emit_cell(Hanoi::top_of(&board, source))
                    emit_cell(Hanoi::top_of(&board, target))
                    print("")

            # The adaptive ladder, over the whole efficiency range and every
            # tower size, including both sides of each threshold.
            for disks in 2..<14:
                for hundredth in 0..<21:
                    eff: f64 = hundredth.f64() * 0.05
                    printr("adapt")
                    emit_cell(disks)
                    emit_cell(hundredth)
                    emit_cell(Hanoi::next_disks(disks, eff))
                    print("")

            # Efficiency and the reported percent, including the cap at one and
            # the round-half-even at the reporting boundary.
            # `used`, not `moves`: an earlier loop body here declares a
            # `moves` darray, and stage1 resolves a later loop BINDER of that
            # name to it -- see loop_binder_after_container_local.elisa in the
            # compiler repo. stage0 is correct; this is a one-word workaround
            # for an open stage1 bug, not a style choice.
            for par in 1..<40:
                for used in 1..<40:
                    printr("eff")
                    emit_cell(par)
                    emit_cell(used)
                    emit_cell(py_round_half_even(Hanoi::efficiency(par, used) * 1000000.0))
                    emit_cell(Hanoi::efficiency_percent(Hanoi::efficiency(par, used), 1))
                    print("")
        destroy w
        return 0
