include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/sheet_text.elisa"

# Spreadsheet's deals, questions, par, the reference ports and seeded play;
# sheet_diff.py replays the same against sheet.py.
extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def flag(value: bool) -> i64:
    return 1 if value else 0

# Text as hex bytes, so spaces and punctuation survive the line format.
def text(value: dstr&):
    can Console.Write, Abort.Panic:
        for i in 0..<value.count.i64() |value|:
            _ = dprintf(1.i32(), "%02x", value[i.usize()].i32())
        _ = dprintf(1.i32(), "\n")

def emit_puzzle(puzzle: Sheet::Puzzle&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        g: Sheet::Grade = Sheet::grade(puzzle.rung)
        _ = dprintf(1.i32(), "grade %lld %lld %lld %lld %.17g", g.rung, g.rows, g.categories, g.kind_count, g.slack)
        for index in 0..<g.kind_count |g|:
            _ = dprintf(1.i32(), " %lld", g.kinds[index.usize()])
        _ = dprintf(1.i32(), "\n")
        _ = dprintf(1.i32(), "puzzle %lld %lld %lld", puzzle.kind, puzzle.answer, puzzle.tool_count)
        for index in 0..<puzzle.tool_count |puzzle|:
            _ = dprintf(1.i32(), " %lld %lld", puzzle.tools[index.usize()].kind, puzzle.tools[index.usize()].value)
        for index in 0..<puzzle.category_count |puzzle|:
            _ = dprintf(1.i32(), " %lld", puzzle.categories[index.usize()])
        _ = dprintf(1.i32(), "\n")
        for index in 0..<puzzle.row_count |puzzle|:
            row: Sheet::Row = puzzle.rows[index.usize()]
            _ = dprintf(1.i32(), "row %lld %lld %lld %lld %lld\n", row.id, row.category, row.qty, row.price, row.total)
            item: mutable dstr = []
            SheetText::cell(&item, &row, Sheet::ITEM)
            text(&item)
        said: mutable dstr = []
        SheetText::question(&said, puzzle)
        text(&said)

def emit_state(state: Sheet::Workbook&, port: i64, kind: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        figures: Sheet::Stats = Sheet::stats(state)
        _ = dprintf(1.i32(), "step %lld %lld %lld %lld %lld %lld %lld %lld %lld %.17g %.17g %lld %lld %lld %lld %lld %lld",
            port, kind, state.filter, state.sort_column, flag(state.sort_down), state.scroll, state.stat,
            state.typed_count, state.clicks, state.pointer.x, state.pointer.y, flag(state.submitted), state.answer,
            Sheet::max_scroll(state), figures.sum if state.stat >= 0 else 0, figures.count,
            figures.largest if state.stat >= 0 else 0)
        for index in Sheet::visible_rows(state) |state|:
            _ = dprintf(1.i32(), " %lld", state.puzzle.rows[index.usize()].id)
        _ = dprintf(1.i32(), "\n")
        typed: mutable dstr = []
        SheetText::typed(&typed, state)
        text(&typed)
        status: mutable dstr = []
        SheetText::status(&status, state)
        text(&status)

# A small generator both sides share, so the play is the same.
def next_state(state: i64) -> i64:
    return (state * 1103515245 + 12345) % 2147483648

# Seeded play: pointer ports, clicks on the targets (sometimes anywhere),
# and keys, until Submit takes an answer or the step budget runs out.
def play(puzzle: Sheet::Puzzle&, seed: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        state: mutable Sheet::Workbook = Sheet::start(puzzle)
        rolling: mutable i64 = seed % 2147483648
        for _ in 0..<120 |state, rolling|:
            rolling <- next_state(rolling)
            draw: i64 = rolling / 128
            pick: i64 = draw % 100
            port: mutable i64 = (draw / 100) % 15
            kind: mutable i64 = 0
            if pick < 30:
                Sheet::steer(&state, port)
            elif pick < 75:
                kind <- 1
                choice: i64 = (draw / 100) % (Sheet::target_count(&state) + 2)
                port <- choice
                if choice < Sheet::target_count(&state):
                    place: mutable Sheet::Rectangle = zeroed
                    _ = Sheet::target(&state, choice, &place)
                    Sheet::click_at(&state, place.x + place.width / 2.0, place.y + place.height / 2.0)
                else:
                    Sheet::click_at(&state, ((draw / 7) % 1000).f64(), ((draw / 11) % 640).f64())
            else:
                kind <- 2
                port <- (draw / 100) % 12
                wanted: Sheet::Action = Sheet::action(Sheet::SUBMIT, 0) if port == 11 else Sheet::action(Sheet::KEY, port)
                Sheet::press(&state, wanted)
            emit_state(&state, port, kind)
            break if state.submitted
        _ = dprintf(1.i32(), "played\n")

def sample(rung: i64, seed: i64, from_run: bool):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = dprintf(1.i32(), "case %lld %lld %lld\n", rung, seed, flag(from_run))
        puzzle: mutable Sheet::Puzzle = zeroed
        if from_run:
            run: mutable MT19937 = zeroed
            mt_seed_int(&run, seed.u64())
            puzzle <- Sheet::deal(rung, &run)
            _ = dprintf(1.i32(), "after %.17g\n", py_random(&run))
        else:
            puzzle <- Sheet::deal_seeded(rung, seed)
        emit_puzzle(&puzzle)
        _ = dprintf(1.i32(), "par %lld %lld\n", Sheet::fewest(&puzzle), Sheet::par(&puzzle))
        for step in Sheet::plan(&puzzle):
            _ = dprintf(1.i32(), "plan %lld %lld\n", step.kind, step.value)
        fresh: mutable Sheet::Workbook = Sheet::start(puzzle)
        fresh.pointer <- BrowserSession::Pointer{x: (seed % 1000).f64(), y: (rung * 20 % 640).f64()}
        ports: darray[i64] = Sheet::reference_ports(&fresh)
        _ = dprintf(1.i32(), "reference %lld", ports.count.i64())
        for port in ports:
            _ = dprintf(1.i32(), " %lld", port)
        _ = dprintf(1.i32(), "\n")
        replay: mutable Sheet::Workbook = fresh
        for port in ports |replay|:
            Sheet::steer(&replay, port)
        _ = dprintf(1.i32(), "replayed %lld %lld %lld\n", flag(replay.submitted), replay.answer, replay.clicks)
        play(&puzzle, seed * 31 + rung)
        play(&puzzle, seed * 37 + rung + 1) if rung % 3 == 0
        _ = dprintf(1.i32(), "end\n")

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region fixtures(268435456)
        in fixtures:
            for rung in 0..<31:
                for seed in [0, 2, 17, 42, 99, 314] |rung|:
                    sample(rung, seed, false)
            for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30, 40]:
                for seed in [5, 2024] |rung|:
                    sample(rung, seed, true)
        destroy fixtures
        return 0.i32()
