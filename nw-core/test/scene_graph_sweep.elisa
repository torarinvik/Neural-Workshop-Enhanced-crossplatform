# Differential sweep driver for src/scene_graph.elisa.
# See scene_graph_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pymath.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/display.elisa"
include "../src/scene_graph.elisa"
include "scene_emit.elisa"

const KEYS: cstr = "G: Return to Main Screen\n\nN: Next Game Type"
const TITLE: cstr = "Dual N-Back"
const LEGEND: cstr = "Last 50 rounds:   Position: 82%      Sound: 74%     "

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        print("names|spec|black|days|low|high|tall")
        region w(64 * 1024 * 1024)
        in w:
            for spec in 0..<28:
                black: bool = spec % 3 == 1
                # Under two days is the "insufficient data" arm; past ten the
                # date labels stack; and the label thinning depends on how
                # many there are.
                days: i64 = spec % 14
                # The y range in quarter points, so the axis walks a
                # different number of rungs each time.
                low: i64 = 4 + spec % 5
                high: i64 = low + 2 + spec % 7
                tall: i64 = 1368 if spec % 2 == 0 else 960
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(1 if black else 0)
                emit_bar(days)
                emit_bar(low)
                emit_bar(high)
                emit_bar(tall)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneGraph::Paint = SceneGraph::paint_of(black, width, height, 2.0, 2.0)
                frame: mutable SceneGraph::Frame = SceneGraph::Frame{left: 0.0, right: 0.0, top: 0.0, bottom: 0.0, centre_x: 0.0, centre_y: 0.0, width: 0.0, height: 0.0}
                SceneGraph::frame_of(&frame, width, height)
                SceneGraph::put_frame(&list, &paint, &frame,
                                      sview(KEYS, 0, -1), sview(TITLE, 0, -1))
                if days < 2:
                    SceneGraph::put_insufficient(&list, &paint, &frame)
                else:
                    low_score: f64 = low.f64() / 4.0
                    high_score: f64 = high.f64() / 4.0
                    # The date labels, stacked past ten days.
                    held: mutable darray[dstr] = []
                    labels: mutable darray[sview] = []
                    for index in 0..<days |held, days, index|:
                        text: mutable dstr = []
                        dstr_append_cstr(&text, "26")
                        text.push(45.u8() if days <= 10 else 10.u8())
                        dstr_append_cstr(&text, "08")
                        text.push(45.u8() if days <= 10 else 10.u8())
                        if index + 1 < 10:
                            text.push(48.u8())
                        dstr_append_i64(&text, index + 1)
                        held.push(text)
                    for index in 0..<days |labels, held|:
                        labels.push(bytes_view(get held[index.usize()] else []))
                    SceneGraph::put_x_axis(&list, &paint, &frame, &labels, days)

                    marks: mutable darray[dstr] = []
                    ticks: mutable darray[sview] = []
                    step: mutable i64 = 0
                    at: mutable f64 = low_score
                    while at <= high_score |marks, at, step, high_score|:
                        text: mutable dstr = []
                        dstr_append_fixed(&text, at, 2)
                        marks.push(text)
                        at <- at + 0.25
                        step <- step + 1
                    for one in 0..<step |ticks, marks|:
                        ticks.push(bytes_view(get marks[one.usize()] else []))
                    SceneGraph::put_y_axis(&list, &paint, &frame, low_score,
                                           high_score, &ticks)

                    avg_x: mutable darray[f64] = []
                    avg_y: mutable darray[f64] = []
                    max_x: mutable darray[f64] = []
                    max_y: mutable darray[f64] = []
                    for index in 0..<days |avg_x, avg_y, max_x, max_y, frame, days, low_score, high_score|:
                        x: f64 = SceneGraph::point_x(&frame, index, days)
                        avg_x.push(x)
                        avg_y.push(SceneGraph::point_y(&frame, low_score + (high_score - low_score) * (index % 5).f64() / 4.0, low_score, high_score))
                        max_x.push(x)
                        max_y.push(SceneGraph::point_y(&frame, low_score + (high_score - low_score) * (index % 3).f64() / 2.0, low_score, high_score))
                    SceneGraph::put_series(&list, &paint, &avg_x, &avg_y, SceneGraph::color_average())
                    SceneGraph::put_series(&list, &paint, &max_x, &max_y, SceneGraph::color_maximum())
                    SceneGraph::put_legend(&list, &paint, sview(LEGEND, 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
