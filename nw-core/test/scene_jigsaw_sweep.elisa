# Differential sweep driver for src/scene_jigsaw.elisa.
# See scene_jigsaw_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_jigsaw.elisa"
include "scene_emit.elisa"

# The source picture the tiles are cut from, and the tiles' own pixel size.
const IMAGE_WIDTH: i64 = 240
const IMAGE_HEIGHT: i64 = 160
const TILE_PIXELS: i64 = 40

const SMALL_LIBRARY: cstr = "one picture only -- add more to see them"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|side|preview|picked|hovered|mark_placed|puzzle|total_puzzles|swaps|par|small|tall|verdict")
            for spec in 0..<40:
                phase: i64 = spec % 4
                black: bool = spec % 7 == 1
                side: i64 = 2 + (spec / 4) % 4
                preview: bool = (spec / 4) % 2 == 0
                places: i64 = side * side
                # -1 for neither, so the mark rules are exercised with and
                # without a pick and a hover.
                picked: i64 = -1 if spec % 5 == 4 else spec % places
                hovered: i64 = -1 if spec % 3 == 2 else (spec + 2) % places
                mark_placed: bool = (spec / 4) % 3 != 2
                small: bool = spec % 6 == 5
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(side)
                emit_bar(1 if preview else 0)
                emit_bar(picked)
                emit_bar(hovered)
                emit_bar(1 if mark_placed else 0)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(spec % 17)
                emit_bar(spec % 11)
                emit_bar(1 if small else 0)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                # An order with some tiles home and some not, so the
                # already-placed mark has both arms to take.
                order: mutable darray[i64] = []
                assets: mutable darray[i64] = []
                for position in 0..<places |order, assets, places|:
                    order.push(position if position % 3 == 0 else (position + 1) % places)
                    assets.push(position)
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneJigsaw::JigsawPaint = SceneJigsaw::paint_of(black, width, height, 2.0, 2.0)
                SceneJigsaw::render(&list, &paint, phase, side, &order,
                                    TILE_PIXELS, preview, true, IMAGE_WIDTH,
                                    IMAGE_HEIGHT, &assets, places, picked,
                                    hovered, mark_placed, 1 + spec % 5, 5,
                                    spec % 17, spec % 11,
                                    sview(SMALL_LIBRARY, 0, -1) if small else sview("", 0, -1),
                                    sview("Put it back together", 0, -1),
                                    verdict,
                                    sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
