include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/potter_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def snapshot(run: Potter::Run&, port: i64):
    can Console.Write, Abort.Panic:
        _ = printf("%lld %lld %.17g %.17g %d %.17g %.17g %.17g %.17g %lld %lld %d",
            port, run.result, run.hand.x, run.hand.y, 1 if run.hand.down else 0,
            run.time, run.turn, run.wet, run.good_for, run.speed, run.touching, 1 if Potter::shown(run) else 0)
        for j in 0..<run.pot.level.bands |run|:
            _ = printf(" %.17g %d", run.radius[j.usize()], 1 if run.was_near[j.usize()] else 0)
        _ = printf("\n")

def pcm(run: Potter::Run&, bank: DrShapeAudio::Bank&, start: f64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region audio(524288):
            in audio:
                bytes: mutable u8[8824] = zeroed
                used: i64 = PotterAudio::render(run, bank, start, start + 0.1, &bytes[0], 8824)
                _ = printf("audio %.17g\n", start)
                for j in 0..<used |bytes|:
                    _ = printf("%02x", bytes[j.usize()].i32())
                _ = printf("\n")

def replay(rung: i64, seed: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(524288):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                pot: Potter::Pot = Potter::deal(rung, &draw)
                _ = printf("pot %lld %lld %lld %lld %u", mode, rung, seed, pot.seed, py_getrandbits(&draw, 32).u32())
                for j in 0..<pot.level.bands |pot|:
                    _ = printf(" %.17g", pot.shape[j.usize()])
                _ = printf("\n")
                run: mutable Potter::Run = Potter::begin(pot)
                while run.result == Potter::LIVE |run, mode|:
                    port: mutable i64 = Potter::pilot(&run) if mode == 0 else -1
                    if mode == 1:
                        # Holding near the axis on fresh clay collapses the pot.
                        HandView::place(&run.hand, Potter::AXIS, Potter::band_y(run.pot.level.bands, 0.0))
                        port <- HandView::PRESS
                    if mode == 2 and run.time >= 10.0:
                        HandView::place(&run.hand, Potter::AXIS, Potter::band_y(run.pot.level.bands, 0.0))
                        port <- HandView::PRESS
                    Potter::act(&run, port)
                    Potter::step(&run, 1.0 / 60.0)
                    snapshot(&run, port)
                _ = printf("notes %lld\n", run.notes.count.i64())
                for cue in run.notes:
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g\n",
                        cue.seed, cue.voice, cue.t, cue.dur, cue.freq, cue.gain)
                bank: DrShapeAudio::Bank = PotterAudio::patches()
                pcm(&run, &bank, 0.0)
                pcm(&run, &bank, 0.8)
                pcm(&run, &bank, run.time - 0.04)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in 0..<81:
            level: Potter::Grade = Potter::grade(rung)
            _ = printf("grade %lld %lld %.17g %.17g %.17g %lld %.17g %.17g\n",
                level.rung, level.bands, level.near, level.drag, level.dry, level.ghost, level.wobble, level.seconds)
        for rung in [1.i64(), 4.i64(), 7.i64(), 10.i64(), 13.i64(), 20.i64(), 35.i64(), 60.i64()]:
            replay(rung, 17, 0)
        replay(1, 19, 1)
        replay(13, 19, 2)
        return 0
