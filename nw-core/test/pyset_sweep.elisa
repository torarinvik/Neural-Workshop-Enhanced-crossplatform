# Differential sweep for tasks/pyset.elisa against a real CPython `set`.
#
# The set exists for ONE observable property -- iteration order -- so that is what
# is compared, over a deterministic grid of add/discard sequences. Nothing else
# about the table is checked, because nothing else is observable.
#
# The sequences are generated from a simple LCG rather than pyrandom, so the
# harness does not depend on the module it is meant to keep honest.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/pyset.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

# A deterministic sequence generator, independent of pyrandom.
def lcg_next(state: mutable i64&) -> i64:
    state <- (state * 1103515245 + 12345) & 2147483647
    return state

# One trial: `ops` add/discard operations with keys drawn below `span`, then the
# table's iteration order.
def sweep_trial(trial: i64, span: i64, ops: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        table: mutable PySet::Table = PySet::new(ops + 8)
        out: mutable darray[i64] = Ints::zeros(ops + 8)
        state: mutable i64 = trial * 7919 + 13
        printr("set")
        emit_cell(trial)
        emit_cell(span)
        emit_cell(ops)
        step: mutable i64 = 0
        while step < ops |step, ops, span, state, table|:
            key: i64 = lcg_next(&state) % span
            if lcg_next(&state) % 100 < 65:
                PySet::add(&table, key)
            else:
                PySet::discard(&table, key)
            step <- step + 1
        count: i64 = PySet::to_list(table, &out)
        emit_cell(count)
        index: mutable i64 = 0
        while index < count |index, out|:
            emit_cell(Ints::at(out, index))
            index <- index + 1
        print("")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region work_region(64 * 1024 * 1024)
        in work_region:
            for span in [8, 32, 256, 1024] |work_region|:
                for ops in [1, 2, 5, 13, 40, 90] |span|:
                    for trial in 0..<25 |span, ops|:
                        sweep_trial(trial, span, ops)
        destroy work_region
        return 0
