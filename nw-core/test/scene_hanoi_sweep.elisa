# Differential sweep driver for src/scene_hanoi.elisa.
# See scene_hanoi_diff.py for the reference side.
#
# The board is walked into position by APPLYING MOVES rather than by being
# assembled: a peg layout that no sequence of legal moves reaches is a layout
# the screen never draws, and a suite that drew one would be testing a picture
# the game cannot produce. The moves are the same on both sides.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/display.elisa"
include "../src/tasks/hanoi.elisa"
include "../src/scene_hanoi.elisa"
include "scene_emit.elisa"

def message_for(out: mutable dstr&, phase: i64):
    can Memory.Allocate, Abort.Panic:
        if phase == SceneHanoi::PHASE_SOLVING:
            dstr_append_cstr(out, "Rebuild the tower on another peg")
            return
        if phase == SceneHanoi::PHASE_SOLVED:
            dstr_append_cstr(out, "Solved")
            return
        dstr_append_cstr(out, "Press Space to start")

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            width: f64 = 1824.0
            height: f64 = 1368.0
            print("names|spec|disks|seed|phase|black|picked|moves|round|total_rounds|walk")
            for spec in 0..<28 |width, height|:
                disks: i64 = 3 + spec % 8
                seed: i64 = 3300 + spec * 11
                phase: i64 = 1 if spec % 5 != 4 else (2 if spec % 3 == 0 else 0)
                black: bool = spec % 4 == 3
                walk: i64 = spec * 2
                board: mutable Hanoi::Board = Hanoi::fresh_pegs(disks)
                rng: mutable MT19937 = mt19937_new()
                mt_seed_int(&rng, seed.u64())
                moves: mutable i64 = 0
                for _step in 0..<walk |board, rng, moves|:
                    source: i64 = py_randrange(&rng, 0, 3)
                    target: i64 = py_randrange(&rng, 0, 3)
                    if source != target and Hanoi::can_move(&board, source, target):
                        # `can_move` has already said yes, so `apply_move` says
                        # true -- the `if` is how a return value is consumed
                        # here, not a second check.
                        if Hanoi::apply_move(&board, source, target):
                            moves <- moves + 1
                picked: i64 = -1 if spec % 3 != 1 else spec % 3
                printr("spec|")
                print_i64(spec)
                emit_bar(disks)
                emit_bar(seed)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(picked)
                emit_bar(moves)
                emit_bar(1 + spec % 4)
                emit_bar(4)
                emit_bar(walk)
                print("")
                message: mutable dstr = []
                message_for(&message, phase)
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneHanoi::Paint = SceneHanoi::paint_of(black, width, height, 2.0, 2.0)
                SceneHanoi::render(&list, &paint, &board, phase, picked,
                                   1 + spec % 4, 4, moves,
                                   Hanoi::minimum_moves(disks), disks,
                                   bytes_view(message))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
