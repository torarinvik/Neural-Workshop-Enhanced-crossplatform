include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/rover_reference.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def terrain(g: Rover::Ground&):
    can Abort.Panic, Console.Write:
        lv: Rover::Grade = g.level
        _ = dprintf(1.i32(), "ground %lld %.17g %.17g %lld %lld %.17g %.17g %.17g %.17g %lld\n",
            lv.rung, lv.delay, lv.wander, lv.flags, lv.rocks, lv.hills, lv.tip, lv.drag, g.seconds, g.delays.count.i64())
        if lv.hills != 0.0:
            for i in 0..<Rover::WAVES |g|:
                w: Rover::Wave = g.waves[i.usize()]
                _ = dprintf(1.i32(), "wave %.17g %.17g %.17g %.17g\n", w.amp, w.kx, w.kz, w.phase)
        for i in 0..<lv.flags |g|:
            p: Rover::Point = g.flags[i.usize()]
            _ = dprintf(1.i32(), "flag %.17g %.17g\n", p.x, p.z)
        for i in 0..<lv.rocks |g|:
            r: Rover::Rock = g.rocks[i.usize()]
            _ = dprintf(1.i32(), "rock %.17g %.17g %.17g\n", r.at.x, r.at.z, r.radius)
        for i in 0..<g.delays.count |g|:
            _ = dprintf(1.i32(), "delay %.17g\n", Rover::delay_at(g, i.f64() + 0.75))
        _ = dprintf(1.i32(), "edges %.17g %.17g\n", Rover::delay_at(g, -5.0), Rover::delay_at(g, g.seconds + 100.0))

def replay(g: Rover::Ground&):
    can Abort.Panic, Console.Write:
        s: mutable Rover::State = zeroed
        for i in 0..<480 |g, s|:
            pattern: i64 = i / 40 % 6
            controls: Rover::Controls = Rover::Controls{drive: 1.0 if pattern < 2 else 0.3 if pattern == 3 else 0.0,
                brake: 1.0 if pattern == 4 else 0.4 if pattern == 3 else 0.0,
                left: 0.6 if pattern == 1 or pattern == 5 else 0.0, right: 0.5 if pattern == 3 else 0.0}
            dt: f64 = 1.0 / 30.0 if i % 2 == 0 else 1.0 / 120.0
            s <- Rover::advance(g.level, s, controls, dt)
            _ = dprintf(1.i32(), "tick %.17g %.17g %.17g %.17g %.17g %.17g\n", s.x, s.z, s.heading, s.v,
                Rover::height(g, s.x, s.z), Rover::slope(g, s.x, s.z, s.heading))

def sample(rung: i64, seed: i64):
    can Abort.Panic, Console.Write, Memory.Allocate:
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, seed.u64())
        _ = dprintf(1.i32(), "case %lld %lld\n", rung, seed)
        for i in 0..<3 |rung, seed, rng|:
            g: Rover::Ground = Rover::build(Rover::grade(rung), &rng)
            terrain(&g)
            if i == 0:
                replay(&g)
                if seed == 17:
                    emit_route(RoverReference::route(&g))

def run_state(run: Rover::Run&, port: i64):
    can Abort.Panic, Console.Write:
        observed: Rover::State = Rover::seen(run)
        state: Rover::State = run.state
        cue_time: f64 = run.cues[(run.cue_count - 1).usize()].at if run.cue_count > 0 else -1.0
        _ = dprintf(1.i32(), "run %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %lld %lld %lld %lld %lld %.17g\n",
            port, run.t, state.x, state.z, state.heading, state.v, observed.x, observed.z, observed.heading, observed.v,
            run.queued, run.history_count, run.reached, run.result, run.cue_count, cue_time)

def delayed(mode: i64):
    can Abort.Panic, Console.Write, Memory.Allocate:
        _ = dprintf(1.i32(), "delayed %lld\n", mode)
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, 17.u64())
        g: Rover::Ground = Rover::build(Rover::grade(13), &rng)
        run: mutable Rover::Run = Rover::start(g)
        if mode == 0:
            for i in 0..<5100 |run|:
                port: i64 = (i / 29) % 5 - 1
                dt: f64 = 0.012 if i % 3 == 0 else 1.0 / 120.0
                Rover::step(&run, dt, port)
                run_state(&run, port)
                break if run.result != Rover::LIVE
        elif mode == 1:
            for i in 0..<g.level.flags |g, run|:
                goal: Rover::Point = g.flags[i.usize()]
                run.state <- Rover::State{x: goal.x, z: goal.z, heading: 0.0, v: 0.0}
                Rover::step(&run, 0.0, Rover::NEUTRAL)
                run_state(&run, Rover::NEUTRAL)
        else:
            if mode == 2:
                rock: Rover::Rock = g.rocks[0]
                run.state <- Rover::State{x: rock.at.x, z: rock.at.z, heading: 0.0, v: 0.0}
            elif mode == 3:
                run.state <- Rover::State{x: 5.0, z: -17.0, heading: 2.0, v: 0.5}
            else:
                run.t <- g.seconds + 0.1
            Rover::step(&run, 0.0, Rover::NEUTRAL)
            run_state(&run, Rover::NEUTRAL)

def emit_route(path: darray[Rover::Point]):
    can Abort.Panic, Console.Write:
        _ = dprintf(1.i32(), "route %lld\n", path.count.i64())
        for i in 0..<path.count |path|:
            p: Rover::Point = path[i]
            _ = dprintf(1.i32(), "waypoint %.17g %.17g\n", p.x, p.z)

def deal_trace(rung: i64):
    can Abort.Panic, Console.Write, Memory.Allocate, Memory.Release:
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, 17.u64())
        _ = dprintf(1.i32(), "deal %lld\n", rung)
        ground: Rover::Ground = RoverReference::deal(rung, &rng)
        if ground.seconds <= 0.0:
            _ = dprintf(1.i32(), "no deal\n")
            return
        terrain(&ground)
        _ = dprintf(1.i32(), "draw %.17g\n", py_random(&rng))
        path: darray[Rover::Point] = RoverReference::route(&ground)
        emit_route(path)
        run: mutable Rover::Run = Rover::start(ground)
        along: mutable i64 = 0
        while run.result == Rover::LIVE |run, along, path|:
            port: i64 = RoverReference::choose(&run, &path, &along)
            Rover::step(&run, RoverReference::STEP, port)
            run_state(&run, port)

def blocked_route():
    can Abort.Panic, Memory.Allocate, Console.Write:
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, 17.u64())
        g: Rover::Ground = Rover::build(Rover::grade(4), &rng)
        rocks: mutable Rover::Rock[40] = g.rocks
        rocks[0] <- Rover::Rock{at: Rover::Point{x: 0.0, z: 0.0}, radius: 5.0}
        blocked: Rover::Ground = Rover::Ground{level: g.level, waves: g.waves, rocks: rocks,
            flags: g.flags, delays: g.delays, seconds: g.seconds}
        emit_route(RoverReference::route(&blocked))

def main() -> i32:
    can Abort.Panic, Console.Write, Memory.Allocate, Memory.Release, Global.Write, Global.Read:
        for rung in [0, 1, 2, 4, 6, 7, 10, 12, 13, 20, 30, 40, 60]:
            for seed in [0, 17, 42] |rung|:
                region scratch(16777216):
                    in scratch:
                        sample(rung, seed)
        for mode in 0..<5:
            region scratch(2097152):
                in scratch:
                    delayed(mode)
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            region scratch(16777216):
                in scratch:
                    deal_trace(rung)
        region scratch(4194304):
            in scratch:
                blocked_route()
        return 0.i32()
