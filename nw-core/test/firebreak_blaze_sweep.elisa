include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/firebreak_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def frame(blaze: Firebreak::Blaze&):
    can Abort.Panic, Console.Write:
        digest: mutable u64 = 14695981039346656037.u64()
        for i in 0..<Firebreak::CELLS |blaze, digest|:
            at: usize = i.usize()
            code: u64 = (blaze.terrain[at] + 6 * blaze.state[at] + 18 * blaze.thrown[at].i64()).u64()
            digest <- (digest ^ code) * 1099511628211.u64()
        _ = printf("frame %.17g %lld %lld %lld %.17g %lld %lld %llu\n", blaze.elapsed,
            blaze.col, blaze.row, blaze.shovels, blaze.ready_at, blaze.result, Firebreak::burned(blaze), digest)

def route(blaze: mutable Firebreak::Blaze&):
    can Abort.Panic, Console.Write, Memory.Allocate:
        region scratch(8192):
            in scratch:
                ports: darray[i64] = Firebreak::route(blaze, Firebreak::pilot_target(blaze))
                _ = printf("ports")
                for port in ports |blaze|:
                    _ = printf(" %lld", port)
                    _ = Firebreak::apply(blaze, port)
                _ = printf("\n")

def replay(rung: i64, policy: i64):
    can Abort.Panic, Console.Write, Memory.Allocate:
        land: Firebreak::Land = Firebreak::deal_seed(rung, 17)
        blaze: mutable Firebreak::Blaze = Firebreak::initialize(&land)
        _ = printf("case %lld %lld\n", rung, policy)
        arrivals: f64[Firebreak::CELLS] = Firebreak::arrival(&blaze)
        for cell in 0..<Firebreak::CELLS |arrivals|:
            _ = printf("%.17g\n", arrivals[cell.usize()])
        frame(&blaze)
        while blaze.result == Firebreak::LIVE |blaze, policy|:
            route(&blaze) if policy == 1
            _ = Firebreak::step(&blaze, 1.0 / 30.0)
            frame(&blaze)

def session_row(session: FirebreakGame::Session&):
    can Abort.Panic, Console.Write:
        _ = printf("session %lld %lld %lld %lld %lld %lld %lld %lld %lld %.17g\n",
            session.phase, session.rung, session.trial, session.wins, session.best_rung,
            session.verdict, session.blaze.col, session.blaze.row, session.blaze.shovels, session.blaze.elapsed)

def controller():
    can Abort.Panic, Console.Write:
        session: mutable FirebreakGame::Session = FirebreakGame::initialize(16, 2, true, -17)
        _ = FirebreakGame::input(&session, FirebreakGame::START, 0)
        session_row(&session)
        now: mutable i64 = 0
        for trial in 0..<2 |session, now|:
            cell: i64 = 15 + 9 * Firebreak::COLS
            _ = FirebreakGame::input(&session, FirebreakGame::FIRST_CELL + cell, now)
            _ = FirebreakGame::input(&session, 8, now)
            while session.phase == FirebreakGame::PLAYING |session, now|:
                next: i64 = now + (250 if session.blaze.elapsed == 0.0 else 50)
                _ = FirebreakGame::advance(&session, next, next.f64() / 1000.0 - now.f64() / 1000.0)
                now <- next
                session_row(&session)
            _ = FirebreakGame::advance(&session, now + 2999, 2.999)
            session_row(&session)
            now <- now + 3000
            _ = FirebreakGame::advance(&session, now, 3.0)
            session_row(&session)
        _ = FirebreakGame::input(&session, FirebreakGame::START, now + 1)
        session_row(&session)

def main() -> i32:
    can Abort.Panic, Console.Write, Memory.Allocate:
        for rung in [1, 7, 10, 13, 16, 25]:
            for policy in 0..<2 |rung|:
                replay(rung, policy)
        land: Firebreak::Land = Firebreak::deal_seed(13, 17)
        blaze: mutable Firebreak::Blaze = Firebreak::initialize(&land)
        blaze.elapsed <- 119.9
        for i in 0..<land.level.fires |blaze, land|:
            blaze.lit_at[land.fires[i.usize()].usize()] <- 119.9
        _ = Firebreak::step(&blaze, 0.1)
        frame(&blaze)
        controller()
        return 0.i32()
