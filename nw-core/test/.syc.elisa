include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/strings.elisa"
include "../src/tasks/ints.elisa"
include "../src/tasks/syllogism_words.elisa"
include "../src/tasks/syllogism.elisa"

def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)

# The ladder itself, including the clamped ends.
def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(64 * 1024 * 1024)
        in w:
            for count in [3, 4]:
                shapes: i64 = sy_shape_count(count)
                premises: mutable SyStatements = sy_statements_new(SY_MOST_PREMISES)
                index: mutable i64 = 0
                while index < shapes |index, shapes, count, premises|:
                    sy_shape_at(count, index, &premises)
                    printr("s")
                    emit_cell(count)
                    emit_cell(index)
                    link: mutable i64 = 0
                    while link < premises.count |link, premises|:
                        emit_cell(Ints::at(premises.form, link))
                        emit_cell(Ints::at(premises.subject, link))
                        emit_cell(Ints::at(premises.predicate, link))
                        link <- link + 1
                    emit_cell(1 if sy_satisfiable(count, &premises, -1, 0, 0) else 0)
                    emit_cell(sy_atmosphere(&premises))
                    form: mutable i64 = 0
                    while form < 4 |form, count, premises|:
                        emit_cell(1 if sy_entails(count, &premises, form, 0, count - 1) else 0)
                        form <- form + 1
                    print("")
                    index <- index + 1
        destroy w
        return 0
