include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/proofreader_audio.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Console.Write:
        machine: Proofreader::Machine = zeroed
        run: mutable Proofreader::Run = Proofreader::start(machine)
        run.t <- 0.05
        Proofreader::note(&run, 0.05, 520.0, 0, 0.2)
        run.t <- 0.125
        Proofreader::note(&run, 0.08, 660.0, 1, 0.3)
        run.t <- 0.15
        Proofreader::note(&run, 0.06, 420.0, 2, 0.3, -0.75)
        run.t <- 0.17
        Proofreader::note(&run, 0.08, 660.0, 3, 0.3)
        run.t <- 0.21
        Proofreader::note(&run, 0.6, 880.0, 4, 0.5)
        run.t <- 0.55
        Proofreader::note(&run, 0.5, 90.0, 5, 0.5)
        for i in 0..<15 |run|:
            data: mutable u8[8820] = zeroed
            begin: f64 = i.f64() * 0.1
            count: i64 = ProofreaderAudio::render(&run, begin, begin + 0.1, &data[0], 8820)
            for j in 0..<count |data|:
                _ = dprintf(1.i32(), "%02x", data[j.usize()].i32())
            _ = dprintf(1.i32(), "\n")
        return 0.i32()
