include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_errands.elisa"

# Errands runs played through the game layer, with the scene's chrome text
# and the drawn computer dumped at each step; errands_scene_diff.py draws
# the same with ui/errands.py.
extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def hex_text(list: Display::DisplayList&, cmd: Display::DrawCmd&):
    can Console.Write, Abort.Panic:
        for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list|:
            _ = dprintf(1.i32(), "%02x", list.pool[(cmd.ref.i64() + i).usize()].i32())
        _ = dprintf(1.i32(), "\n")

def dump(list: Display::DisplayList&, texts_only: bool):
    can Console.Write, Abort.Panic:
        for cmd in list.commands |list, texts_only|:
            if cmd.kind == Display::CMD_TEXT:
                _ = dprintf(1.i32(), "text %u %.9g %.9g %.9g %.9g %u ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(),
                    cmd.d.f64(), cmd.len >> 24.u32())
                hex_text(list, &cmd)
            elif texts_only:
                continue
            elif cmd.kind == Display::CMD_RECT:
                _ = dprintf(1.i32(), "rect %u %.9g %.9g %.9g %.9g\n", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64())
            elif cmd.kind == Display::CMD_BORDERED_RECT:
                _ = dprintf(1.i32(), "bordered %u %.9g %.9g %.9g %.9g %u %.9g\n", cmd.color, cmd.a.f64(), cmd.b.f64(),
                    cmd.c.f64(), cmd.d.f64(), cmd.ref, cmd.e.f64())
            elif cmd.kind == Display::CMD_LINE:
                _ = dprintf(1.i32(), "line %u %.9g %.9g %.9g %.9g %.9g\n", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(),
                    cmd.d.f64(), cmd.e.f64())
            elif cmd.kind == Display::CMD_TRIANGLE:
                _ = dprintf(1.i32(), "triangle %u %.9g %.9g %.9g %.9g %.9g %.9g\n", cmd.color, cmd.a.f64(), cmd.b.f64(),
                    cmd.c.f64(), cmd.d.f64(), cmd.e.f64(), cmd.f.f64())
            else:
                _ = dprintf(1.i32(), "other %u\n", cmd.kind.u32())

def frame(game: ErrandsGame::Session&, label: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = dprintf(1.i32(), "frame %lld %lld %lld %lld %lld %lld %lld\n", label, game.phase, game.ladder.rung,
            game.ladder.trial, game.ladder.wins, game.ladder.best_rung, game.verdict)
        whole: mutable Display::DisplayList = Display::DisplayList()
        SceneErrands::render(&whole, game, false)
        dump(&whole, true)
        if game.phase == ErrandsGame::PLAYING or game.phase == ErrandsGame::JUDGED:
            _ = dprintf(1.i32(), "computer\n")
            drawn: mutable Display::DisplayList = Display::DisplayList()
            SceneErrands::computer(&drawn, &game.office)
            dump(&drawn, false)
        _ = dprintf(1.i32(), "end\n")

# A click at the middle of a page rectangle, through the display frame.
def press(game: mutable ErrandsGame::Session&, place: ErrandsOffice::Rectangle, now: f64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        at: BrowserGame::Frame = BrowserGame::frame()
        _ = ErrandsGame::click(game, at.left + (place.x + place.width / 2.0) * at.scale,
            at.top - (place.y + place.height / 2.0) * at.scale, now)
        frame(game, 2)

# Detours through every app, then Done with nothing done.
def wander(game: mutable ErrandsGame::Session&, now: f64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        press(game, ErrandsOffice::mail_row(0), now)
        press(game, ErrandsOffice::inbox_link(), now)
        press(game, ErrandsOffice::mail_row(game.office.deal.mail_count - 1), now)
        if game.office.deal.shopping:
            press(game, ErrandsOffice::tab(ErrandsOffice::SHOP), now)
            _ = ErrandsGame::scroll(game, 1)
            frame(game, 3)
            _ = ErrandsGame::scroll(game, -1)
            frame(game, 3)
        press(game, ErrandsOffice::tab(ErrandsOffice::EXPENSES), now)
        press(game, ErrandsOffice::submit_box(), now)
        press(game, ErrandsOffice::field_box(1), now)
        for digit in [3, 0, 7, ErrandsOffice::DELETE] |game, now|:
            _ = ErrandsGame::type_key(game, digit, now)
            frame(game, 4)
        press(game, ErrandsOffice::field_box(0), now)
        for index in [0, 5, 10, 4] |game, now|:
            press(game, ErrandsOffice::key_box(index), now)
        press(game, ErrandsOffice::category_box(2), now)
        press(game, ErrandsOffice::submit_box(), now)
        press(game, ErrandsOffice::tab(ErrandsOffice::MAIL), now)
        press(game, ErrandsOffice::done_box(), now)

def reference(game: mutable ErrandsGame::Session&, now: mutable f64&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        return if game.phase != ErrandsGame::PLAYING
        ports: darray[i64] = ErrandsPar::reference_ports(&game.office)
        for index in 0..<ports.count.i64() |game, now, ports|:
            port: i64 = ports[index.usize()]
            now <- now + 0.25
            _ = ErrandsGame::steer(game, port, now)
            frame(game, 10) if port >= BrowserSession::CLICK or index % 9 == 0
            break if game.phase != ErrandsGame::PLAYING

def run(rung: i64, seed: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = dprintf(1.i32(), "run %lld %lld\n", rung, seed)
        game: mutable ErrandsGame::Session = ErrandsGame::initialize(rung, 3, true, seed)
        frame(&game, 0)
        _ = ErrandsGame::start(&game, 0.0)
        frame(&game, 1)
        now: mutable f64 = 0.0
        for trial in 0..<3 |game, now|:
            if trial == 1:
                wander(&game, now)
            if trial == 2:
                # Clicks that change nothing, enough to go over par.
                for count in 0..<40 |game, now|:
                    _ = ErrandsGame::click(&game, BrowserGame::frame().left + 500.0 * BrowserGame::frame().scale,
                        BrowserGame::frame().top - 20.0 * BrowserGame::frame().scale, now)
                    frame(&game, 5) if count % 10 == 0
            reference(&game, &now)
            frame(&game, 6)
            now <- now + 3.0
            _ = ErrandsGame::advance(&game, now)
            frame(&game, 7)
        _ = dprintf(1.i32(), "over\n")

# The options note for every rung the options offer.
def note_cases():
    can Console.Write, Memory.Allocate, Abort.Panic:
        for rung in [1, 3, 6, 9, 12, 15, 18, 21, 25, 30]:
            note: mutable dstr = []
            SceneErrands::option_note(rung, &note)
            _ = dprintf(1.i32(), "note %lld ", rung)
            for i in 0..<note.count.i64() |note|:
                _ = dprintf(1.i32(), "%02x", note[i.usize()].i32())
            _ = dprintf(1.i32(), "\n")

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region fixtures(536870912)
        in fixtures:
            for rung in [1, 3, 6, 9, 12, 15, 21, 30]:
                for seed in [3, 11] |rung|:
                    run(rung, seed)
            note_cases()
        destroy fixtures
        return 0.i32()
