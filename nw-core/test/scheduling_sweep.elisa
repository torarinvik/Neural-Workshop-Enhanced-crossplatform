# Differential sweep driver for scheduling.elisa.
#
# Prints one CSV line per input combination over a deterministic grid; the
# Python harness (scheduling_diff.py) runs the same grid through the original
# bwaccel/scheduling.py and diffs the streams byte-for-byte.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../src/scheduling.elisa"

# Both printr(i64) (generic print[T: Str]) and int_to_string_scratch trip a
# stage1 backend decline of store_* generics (repro/
# nw_print_int_generic_stage1.elisa in the elisa-core worktree), so format
# by hand into a stack buffer until that stage1 gap is fixed.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Memory.Allocate, Console.Format, Abort.Panic:
        printr(",")
        print_i64(value)

def emit_line(tag: cstr, a: i64, b: i64, c: i64, d: i64, result: i64):
    can Console.Write, Memory.Allocate, Console.Format, Abort.Panic:
        printr(tag)
        emit_cell(a)
        emit_cell(b)
        emit_cell(c)
        emit_cell(d)
        emit_cell(result)
        print("")

def sweep_ms_to_ticks():
    can Console.Write, Memory.Allocate, Console.Format, Abort.Panic:
        for ms in [0, 1, 49, 50, 51, 99, 100, 149, 150, 250, 333, 999, 1000, 1050, 2500, 60000]:
            for tick in [0, 1, 10, 50, 100, 250]:
                emit_line("m2t", ms, tick, 0, 0, ms_to_ticks(ms.f64(), tick))

def sweep_clamp():
    can Console.Write, Memory.Allocate, Console.Format, Abort.Panic:
        for ms in [-100, 0, 199, 200, 201, 299, 300, 301, 1000, 1049, 1050, 59999, 60000, 60001, 100000]:
            for tick in [1, 50, 100]:
                for mt in [1, 2, 3, 5]:
                    emit_line("clamp", ms, tick, mt, 60000, clamp_trial_interval_ms(ms, tick, mt, 60000))

def sweep_phases():
    can Console.Write, Memory.Allocate, Console.Format, Abort.Panic:
        for trial in [1, 100, 500, 1000, 2200, 3000, 4500]:
            for stim in [1, 100, 500, 1000, 4000]:
                for fb in [1, 120, 500, 4000]:
                    for tick in [1, 100]:
                        phases: TrialPhases = plan_trial_phases(trial, stim, fb, tick)
                        printr("ph")
                        emit_cell(trial)
                        emit_cell(stim)
                        emit_cell(fb)
                        emit_cell(tick)
                        emit_cell(phases.total_ticks)
                        emit_cell(phases.stimulus_ticks)
                        emit_cell(phases.blank_ticks)
                        emit_cell(phases.feedback_ticks)
                        emit_cell(phases.stimulus_ms)
                        emit_cell(phases.blank_ms)
                        emit_cell(phases.feedback_ms)
                        print("")

def sweep_step():
    can Console.Write, Memory.Allocate, Console.Format, Abort.Panic:
        for ms in [0, 1, 20, 21, 99, 100, 101, 500, 501, 1999, 2000, 2001, 50000]:
            emit_line("step", ms, 0, 0, 0, interval_adjust_step(ms))

def main() -> i64:
    can Console.Write, Memory.Allocate, Console.Format, Abort.Panic:
        sweep_ms_to_ticks()
        sweep_clamp()
        sweep_phases()
        sweep_step()
        return 0
