include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/echo_cave_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def window(run: EchoCave::Run&, begin: f64, end: f64):
    can Memory.Allocate, Abort.Panic, Console.Write:
        data: mutable u8[3200] = zeroed
        length: i64 = EchoCaveAudio::render(run, begin, end, &data[0], 3200)
        for i in 0..<length |data|:
            _ = printf("%02x", data[i.usize()].i32())
        _ = printf("\n")

def emit(rung: i64):
    can Memory.Allocate, Abort.Panic, Console.Write:
        run: mutable EchoCave::Run = EchoCave::trial(EchoCave::deal(rung, 17))
        for tick in 0..<1320 |run|:
            begin: f64 = run.time
            if run.clicked_at < 0.0 or run.time - run.clicked_at > 0.5:
                _ = EchoCave::click(&run)
            EchoCave::step(&run, 1.0 / 60.0, EchoCave::pilot(&run))
            if tick % 9 == 0 and run.time > begin:
                window(&run, begin, run.time)
            break if run.result != EchoCave::PENDING

def main() -> i32:
    can Memory.Allocate, Abort.Panic, Console.Write:
        emit(1)
        emit(10)
        emit(20)
        return 0.i32()
