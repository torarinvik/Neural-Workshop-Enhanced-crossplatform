include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/pianotuner_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# Piano Tuner's live sound against pianotuner.mix, for
# pianotuner_audio_diff.py: tries played by the reference autopilot and one
# done too soon, at several rungs (stiff strings among them), each cut into
# windows -- at the start, as the pin turns, across each done and its note,
# past the last setting as the tracks fade, and at awkward offsets.

def pcm(run: PianoTuner::Run&, bank: PianoTunerAudio::Bank&, start: f64, width: f64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region audio(8388608):
            in audio:
                bytes: mutable u8[88204] = zeroed
                used: i64 = PianoTunerAudio::render(run, bank, start, start + width, &bytes[0], 88204)
                _ = printf("audio %.17g %.17g\n", start, width)
                for j in 0..<used |bytes|:
                    _ = printf("%02x", bytes[j.usize()].i32())
                _ = printf("\n")

def replay(rung: i64, seed: i64, early: bool, bank: PianoTunerAudio::Bank&):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(67108864):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                job: PianoTuner::Job = PianoTuner::deal(rung, &draw)
                run: mutable PianoTuner::Run = PianoTuner::begin(job)
                n: mutable i64 = 0
                while run.result == PianoTuner::LIVE |run, n, early|:
                    port: mutable i64 = PianoTuner::pilot(&run)
                    if early:
                        port <- PianoTuner::DONE if n == 90 else (-1 if port == PianoTuner::DONE else port)
                    PianoTuner::act(&run, port) if port == PianoTuner::DONE
                    PianoTuner::step(&run, 1.0 / 120.0, port if port != PianoTuner::DONE else -1)
                    n <- n + 1
                _ = printf("run %lld %lld %d %lld %.17g %lld\n", rung, seed, 1 if early else 0, run.result, run.t,
                    run.notes.count.i64())
                pcm(&run, bank, 0.0, 0.1)
                pcm(&run, bank, 0.37, 0.25)
                pcm(&run, bank, run.t / 2.0, 0.1)
                for note in run.notes |run, bank|:
                    pcm(&run, bank, note.t - 0.05, 0.4)
                pcm(&run, bank, run.t - 0.1, 0.5)
                pcm(&run, bank, run.t + 0.2, 0.1)
                pcm(&run, bank, 1.0 / 3.0, 1.0)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region banks(16777216):
            in banks:
                bank: PianoTunerAudio::Bank = PianoTunerAudio::bank()
                for rung in [1.i64(), 4.i64(), 10.i64(), 13.i64(), 25.i64()]:
                    replay(rung, 17, false, &bank)
                replay(7, 3, true, &bank)
        return 0
