include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "../src/tasks/triage.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def main() -> i32:
    can Abort.Panic, Console.Write:
        for rung in 1..<36 |rung|:
            for seed in 0..<16 |rung, seed|:
                dealt: mutable Triage::Deal = zeroed
                Triage::deal(rung, seed, &dealt)
                _ = printf("%lld %lld %lld %lld %.9f", rung, seed, dealt.budget, Triage::best(&dealt), Triage::par(&dealt))
                for i in 0..<dealt.level.cards |dealt, i|:
                    card: Triage::Card = dealt.cards[i.usize()]
                    _ = printf(" %lld %lld %lld", card.length, card.cost, card.pays)
                    for j in 0..<card.length |j, card|:
                        _ = printf(" %llu", Triage::digit(card.row, j))
                _ = printf("\n")
                play: mutable Triage::Round = zeroed
                Triage::reset(&dealt, &play)
                while not Triage::over(&dealt, &play) |dealt, play|:
                    action: Triage::Move = Triage::reference_move(&dealt, &play)
                    _ = Triage::apply(&dealt, &play, action)
                    _ = printf("%lld %lld %lld %lld %lld %lld ", action.kind, action.at,
                        play.used, play.value, play.turned, play.solved)
                _ = printf("\n")
        return 0.i32()
