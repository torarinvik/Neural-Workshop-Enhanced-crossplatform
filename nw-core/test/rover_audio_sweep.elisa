include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/rover_audio.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Console.Write:
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, 17.u64())
        ground: Rover::Ground = Rover::build(Rover::grade(13), &rng)
        run: mutable Rover::Run = Rover::start(ground)
        for i in 0..<2 |ground, run|:
            flag: Rover::Point = ground.flags[i.usize()]
            run.t <- 0.125 + 0.25 * i.f64()
            run.state <- Rover::State{x: flag.x, z: flag.z, heading: 0.0, v: 0.0}
            Rover::step(&run, 0.0, Rover::NEUTRAL)
        rock: Rover::Rock = ground.rocks[0]
        run.t <- 0.625
        run.state <- Rover::State{x: rock.at.x, z: rock.at.z, heading: 0.0, v: 0.0}
        Rover::step(&run, 0.0, Rover::NEUTRAL)

        for i in 0..<14 |run|:
            data: mutable u8[8820] = zeroed
            begin: f64 = i.f64() * 0.1
            count: i64 = RoverAudio::render(&run, begin, begin + 0.1, &data[0], 8820)
            for j in 0..<count |data|:
                _ = dprintf(1.i32(), "%02x", data[j.usize()].i32())
            _ = dprintf(1.i32(), "\n")
        return 0.i32()
