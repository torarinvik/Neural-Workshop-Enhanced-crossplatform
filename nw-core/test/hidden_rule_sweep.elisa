include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/hidden_rule_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def main() -> i32:
    can Memory.Allocate, Memory.Release, Console.Write, Abort.Panic:
        for rung in 1..<23 |rung|:
            region trial(8388608):
                in trial:
                    level: HiddenRule::Grade = HiddenRule::grade(rung)
                    world: HiddenRule::Space = HiddenRule::build(&level)
                    digest: mutable u64 = 1.u64()
                    for index in 0..<(world.count * HiddenRule::WORDS) |world, index, digest|:
                        value: u64 = Ints::at_view(&world.masks, index).u64()
                        digest <- ((digest * 16777619.u64()) ^ value ^ (value >> 32.u64())) & 4294967295.u64()
                    _ = printf("%lld %lld %lld %llu\n", rung, level.items, world.count, digest)
                    for seed in 0..<5 |seed, level, world|:
                        rng: mutable MT19937 = mt19937_new()
                        mt_seed_int(&rng, seed.u64())
                        deal: mutable HiddenRule::Deal = zeroed
                        HiddenRule::deal(&level, &world, &rng, &deal)
                        _ = printf("%lld %lld %lld %lld", seed, deal.rule, deal.seeds[0], deal.seeds[1])
                        for index in 0..<HiddenRule::BUDGET |index, deal|:
                            _ = printf(" %d", 1.i32() if deal.lies[index.usize()] else 0.i32())
                        for index in 0..<level.exam |index, deal|:
                            _ = printf(" %lld", deal.exam[index.usize()])
                        _ = printf("\n")
                        round: mutable HiddenRule::Round = zeroed
                        _ = printf("%lld %lld", HiddenRule::test(&round, &level, &deal, -1), HiddenRule::question(&round, &deal))
                        for index in 0..<HiddenRule::BUDGET |index, round, level, deal|:
                            reading: i64 = HiddenRule::test(&round, &level, &deal, (index * 19) % level.items)
                            _ = printf(" %lld", reading)
                        _ = printf(" %lld", HiddenRule::test(&round, &level, &deal, 0))
                        _ = HiddenRule::start_exam(&round)
                        for index in 0..<level.exam |index, round, level, deal|:
                            _ = HiddenRule::answer(&round, &level, &deal, index % 3 == 0)
                        _ = printf(" %lld %lld %lld\n", round.wrong, HiddenRule::cost(&round, &level), HiddenRule::question(&round, &deal))
                        reference: mutable HiddenRule::Round = zeroed
                        HiddenRuleReference::play(&level, &world, &deal, &reference)
                        _ = printf("%lld %lld %.0f", reference.wrong, HiddenRule::cost(&reference, &level), HiddenRuleReference::par(&level, &reference) * 1000000000.0)
                        for index in 0..<reference.test_count |index, reference|:
                            _ = printf(" %lld %d", reference.tests[index.usize()], 1.i32() if reference.readings[index.usize()] else 0.i32())
                        for index in 0..<reference.answer_count |index, reference|:
                            _ = printf(" %d", 1.i32() if reference.answers[index.usize()] else 0.i32())
                        _ = printf("\n")
                destroy trial
        return check_session()

def check_session() -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        run: mutable HiddenRuleGame::Run = HiddenRuleGame::initialize(1, 3, true, 17)
        return 1.i32() if not HiddenRuleGame::start(&run)
        return 2.i32() if not HiddenRuleGame::steer(&run, 0, 0) or HiddenRuleGame::item_index(&run) != 2
        return 3.i32() if not HiddenRuleGame::steer(&run, HiddenRuleGame::EXAM, 0)
        for at in 0..<run.level.exam |at, run|:
            item: i64 = HiddenRule::question(&run.round, &run.dealt)
            _ = HiddenRuleGame::answer(&run, HiddenRule::deal_lit(&run.dealt, item), 1000)
        return 4.i32() if run.phase != HiddenRuleGame::JUDGED or not run.passed or run.rung != 2
        return 5.i32() if HiddenRuleGame::advance(&run, 3999) or not HiddenRuleGame::advance(&run, 4000)
        for at in 0..<HiddenRule::BUDGET |at, run|:
            return 6.i32() if not HiddenRuleGame::test(&run)
        return 7.i32() if run.phase != HiddenRuleGame::EXAMINING or run.round.test_count != HiddenRule::BUDGET
        for at in 0..<run.level.exam |at, run|:
            item: i64 = HiddenRule::question(&run.round, &run.dealt)
            _ = HiddenRuleGame::answer(&run, not HiddenRule::deal_lit(&run.dealt, item), 5000)
        return 8.i32() if run.passed or run.rung != 1 or run.best_rung != 1
        return 9.i32() if not HiddenRuleGame::advance(&run, 8000) or run.trial != 3
        _ = HiddenRuleGame::begin_exam(&run)
        for at in 0..<run.level.exam |at, run|:
            item: i64 = HiddenRule::question(&run.round, &run.dealt)
            _ = HiddenRuleGame::answer(&run, HiddenRule::deal_lit(&run.dealt, item), 10000)
        return 10.i32() if not HiddenRuleGame::advance(&run, 13000) or run.phase != HiddenRuleGame::DONE
        return 11.i32() if run.answered != 3 or run.passed_count != 2 or run.total_cost != 78 or HiddenRuleGame::mean_cost(&run) != 26.0
        return 12.i32() if not HiddenRuleGame::start(&run) or run.trial != 1 or run.answered != 0
        return 0.i32()
