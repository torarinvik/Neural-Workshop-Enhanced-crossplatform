include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_crazy_cog.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def frame(game: CrazyCogGame::Session&, label: cstr):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = printf("frame %s %lld %lld %lld %lld %lld %lld %lld %lld\n", label, game.phase, game.rung,
            game.trial, game.wins, game.run.layer, game.run.carry, game.run.result, game.run.cues.count.i64())
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneCrazyCog::render(&list, game, true)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text ")
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_RECT or cmd.kind == Display::CMD_CIRCLE:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g\n", cmd.kind, cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64())

def run(rung: i64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        game: mutable CrazyCogGame::Session = CrazyCogGame::initialize(rung, 1, true, 17)
        frame(&game, "ready")
        _ = CrazyCogGame::start(&game, 0.0) can Global{Read,Write}
        frame(&game, "start")
        x: f64 = SceneHand::x(CrazyCog::tray_x(0, CrazyCog::slots(&game.run)))
        y: f64 = SceneHand::y(CrazyCog::TRAY_Y)
        region mouse(4096):
            in mouse:
                _ = CrazyCogGame::pointer(&game, x, y, 1, 0.0) can Global{Read,Write}
                _ = CrazyCogGame::pointer(&game, SceneHand::x(game.run.machine.motor.x), SceneHand::y(game.run.machine.motor.y), 0, 0.0) can Global{Read,Write}
        frame(&game, "drag")
        _ = CrazyCogGame::input(&game, HandView::RELEASE) can Global{Read,Write}
        _ = CrazyCogGame::input(&game, CrazyCog::CLEAR) can Global{Read,Write}
        _ = CrazyCogGame::select_layer(&game, game.run.machine.level.layers - 1) can Global{Read,Write}
        frame(&game, "layer")
        _ = CrazyCogGame::select_layer(&game, 0) can Global{Read,Write}
        i: mutable i64 = 0
        while game.phase == CrazyCogGame::PLAYING and i < 20000 |game, i|:
            region event(4096):
                in event:
                    port: i64 = CrazyCog::pilot(&game.run)
                    if port >= 0:
                        _ = CrazyCogGame::input(&game, port) can Global{Read,Write}
                    _ = CrazyCogGame::advance(&game, (i + 1).f64() / 60.0) can Global{Read,Write}
            i <- i + 1
        frame(&game, "judged")
        _ = CrazyCogGame::advance(&game, game.deadline - 0.01) can Global{Read,Write}
        frame(&game, "feedback")
        _ = CrazyCogGame::advance(&game, game.deadline) can Global{Read,Write}
        frame(&game, "done")
        CrazyCogGame::close(&game) can Global{Read,Write}

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            note: mutable dstr = []
            SceneCrazyCog::option_note(rung, &note)
            _ = printf("note %lld ", rung)
            for char in note:
                _ = printf("%c", char.i32())
            _ = printf("\n")
        run(1) can Global{Read,Write}
        run(20) can Global{Read,Write}
        return 0.i32()
