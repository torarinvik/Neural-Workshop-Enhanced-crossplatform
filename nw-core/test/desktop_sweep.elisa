include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/desktop_game.elisa"

# Desktop's grades, deals, reference rounds, par and seeded play;
# desktop_diff.py replays the same with desktop.py and compares.
extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def flag(value: bool) -> i64:
    return 1 if value else 0

def name(value: DesktopDeal::Name&):
    can Console.Write:
        for i in 0..<value.count |value|:
            _ = dprintf(1.i32(), "%02x", value.bytes[i.usize()].i32())

def list(tag: cstr, values: darray[i64]&):
    can Console.Write:
        _ = dprintf(1.i32(), "%s", tag)
        for value in values:
            _ = dprintf(1.i32(), " %lld", value)
        _ = dprintf(1.i32(), "\n")

def emit_grade(g: Desktop::Grade&):
    can Console.Write:
        h: Desktop::Hiding = g.hiding
        f: Desktop::Files = g.files
        _ = dprintf(1.i32(), "grade %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld", g.rung, g.windows, g.tabs, g.per_tab,
            g.rows, g.kind_count, g.dialogs, flag(g.submenus), g.depends, g.applies)
        _ = dprintf(1.i32(), " %lld %lld %lld %lld %lld", h.popups, h.minimised, h.closed, h.notes, h.offscreen)
        _ = dprintf(1.i32(), " %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld", flag(f.explorer), f.moves,
            f.deletes, f.restores, f.depth, f.desktop_files, f.ex_tabs, f.pinned, flag(f.explorer_closed), f.copies,
            flag(f.list_view), flag(f.hide_card))
        _ = dprintf(1.i32(), " %lld %.17g %.17g\n", g.goals, g.factor, g.slack)

def emit_controls(dealt: DesktopDeal::Deal&):
    can Console.Write:
        level: Desktop::Grade = dealt.level
        _ = dprintf(1.i32(), "titles")
        for index in 0..<level.windows |dealt|:
            _ = dprintf(1.i32(), " %lld", dealt.titles[index.usize()])
        _ = dprintf(1.i32(), "\nspecs %lld", dealt.specs.count.i64())
        for spec in dealt.specs:
            _ = dprintf(1.i32(), " %lld %lld %lld %lld", spec.label, spec.kind, spec.count, spec.value)
            if spec.kind == Desktop::CHOICE or spec.kind == Desktop::DROPDOWN or spec.kind == Desktop::COLOUR:
                for at in 0..<spec.count |spec|:
                    _ = dprintf(1.i32(), " %lld", spec.words[at.usize()])
        _ = dprintf(1.i32(), "\ntabs")
        for window in 0..<level.windows |dealt, level|:
            for tab in 0..<level.tabs |dealt, level, window|:
                for row in 0..<level.per_tab |dealt, window, tab|:
                    _ = dprintf(1.i32(), " %lld", dealt.tabs[DesktopDeal::tab_slot(window, tab, row).usize()])
        _ = dprintf(1.i32(), "\ndialogs %lld", dealt.dialogs.count.i64())
        for made in dealt.dialogs:
            _ = dprintf(1.i32(), " %lld %lld %lld %lld %lld %lld %lld %lld", made.title, made.window, made.menu, made.item,
                made.sub, made.members[0], made.members[1], made.members[2])
        _ = dprintf(1.i32(), "\napplies")
        for index in 0..<level.windows |dealt|:
            _ = dprintf(1.i32(), " %lld", flag(dealt.applies[index.usize()]))
        _ = dprintf(1.i32(), "\n")

def emit_layout(dealt: DesktopDeal::Deal&):
    can Console.Write:
        level: Desktop::Grade = dealt.level
        _ = dprintf(1.i32(), "places")
        for index in 0..<level.windows |dealt|:
            _ = dprintf(1.i32(), " %lld %lld", dealt.layout.x[index.usize()], dealt.layout.y[index.usize()])
        _ = dprintf(1.i32(), "\n")
        list("order", &dealt.layout.order)
        _ = dprintf(1.i32(), "minimised")
        for index in 0..<level.windows |dealt|:
            if dealt.layout.minimised[index.usize()]:
                _ = dprintf(1.i32(), " %lld", index)
        _ = dprintf(1.i32(), "\nclosed")
        for index in 0..<level.windows |dealt|:
            if dealt.layout.closed[index.usize()]:
                _ = dprintf(1.i32(), " %lld", index)
        _ = dprintf(1.i32(), "\nnotes")
        for note in dealt.notes:
            _ = dprintf(1.i32(), " %lld %lld %lld", note.text, note.x, note.y)
        _ = dprintf(1.i32(), "\npopups")
        for popup in dealt.popups:
            _ = dprintf(1.i32(), " %lld %lld %lld", popup.at, popup.window, flag(popup.safe_left))
        _ = dprintf(1.i32(), "\nexplorer %lld %lld\n", dealt.layout.explorer_x, dealt.layout.explorer_y)
        list("pinned", &dealt.pinned)
        list("shortcuts", &dealt.shortcuts)

def pairs(tag: cstr, values: darray[DesktopDeal::Pair]&):
    can Console.Write:
        _ = dprintf(1.i32(), "%s", tag)
        for pair in values:
            _ = dprintf(1.i32(), " %lld %lld", pair.first, pair.second)
        _ = dprintf(1.i32(), "\n")

def emit_card(dealt: DesktopDeal::Deal&):
    can Console.Write:
        _ = dprintf(1.i32(), "requires")
        for need in dealt.requires:
            _ = dprintf(1.i32(), " %lld %lld %lld", need.ident, need.other, need.value)
        _ = dprintf(1.i32(), "\n")
        pairs("goals", &dealt.goals)
        _ = dprintf(1.i32(), "files %lld", dealt.files.count.i64())
        for entry in dealt.files:
            _ = dprintf(1.i32(), " ")
            name(&entry.name)
            _ = dprintf(1.i32(), " %lld %lld %lld", flag(entry.folder), entry.kind, entry.parent)
        _ = dprintf(1.i32(), "\n")
        pairs("moves", &dealt.moves)
        pairs("copies", &dealt.copies)
        _ = dprintf(1.i32(), "view %lld %lld\n", flag(dealt.list_view), flag(dealt.hide_card))

# Everything a click can change.
def emit_desk(desk: DesktopState::Desk&):
    can Console.Write, Memory.Allocate, Abort.Panic:
        o: DesktopState::Overlay = desk.overlay
        p: DesktopState::Picking = desk.picking
        _ = dprintf(1.i32(), "desk %lld %lld %.17g %.17g %lld", desk.clicks, flag(desk.done), desk.pointer.x, desk.pointer.y,
            flag(desk.pointer.held))
        _ = dprintf(1.i32(), " %lld %lld %lld %lld %lld %lld %lld %lld %lld", o.dialog, o.menu_window,
            o.menu_index if o.menu_window != -1 else 0, o.menu_sub if o.menu_window != -1 else -1, o.dropdown,
            flag(o.start_open), flag(o.start_all), o.popup, o.next_popup)
        if o.has_context:
            _ = dprintf(1.i32(), " 1 %lld %lld %lld %.17g %.17g", o.context.what, o.context.node, o.context.window,
                o.context.x, o.context.y)
        else:
            _ = dprintf(1.i32(), " 0 0 0 0 0 0")
        _ = dprintf(1.i32(), " %lld %lld %lld %lld %lld %lld %lld\n", p.picked, p.last, p.previous, p.clipboard,
            flag(p.copying), flag(p.peeking), flag(DesktopFiles::solved(desk)))
        list("order", &desk.order)
        _ = dprintf(1.i32(), "windows")
        for win in desk.windows:
            _ = dprintf(1.i32(), " %.17g %.17g %lld %lld %lld %lld %lld %lld %lld", win.x, win.y, win.rows, win.active,
                win.scroll[0], win.scroll[1], win.scroll[2], flag(win.minimised), flag(win.closed))
        _ = dprintf(1.i32(), "\n")
        if desk.explorer != -1:
            b: DesktopState::Browsing = desk.windows[desk.explorer.usize()].browsing
            _ = dprintf(1.i32(), "explorer %lld %lld %lld", b.current, flag(b.list_view), b.places.count.i64())
            for place in b.places:
                _ = dprintf(1.i32(), " %lld %lld %lld %lld", place.path, place.scroll, place.selected, place.history.count.i64())
                for back in place.history:
                    _ = dprintf(1.i32(), " %lld", back)
            _ = dprintf(1.i32(), "\n")
        _ = dprintf(1.i32(), "controls")
        for control in desk.controls:
            _ = dprintf(1.i32(), " %lld %lld", control.value, control.shown)
        _ = dprintf(1.i32(), "\nnodes %lld", desk.nodes.count.i64())
        for at in 0..<desk.nodes.count.i64() |desk|:
            node: DesktopState::Node = desk.nodes[at.usize()]
            _ = dprintf(1.i32(), " %lld %lld", node.parent, node.origin)
            if at >= desk.dealt.files.count.i64():
                _ = dprintf(1.i32(), " ")
                name(&node.name)
        _ = dprintf(1.i32(), "\n")

def next_state(state: i64) -> i64:
    return (state * 1103515245 + 12345) % 2147483648

# Seeded play: the reference half the time, else clicks, drags from a
# title bar or anywhere, and right clicks.
def play(dealt: DesktopDeal::Deal, seed: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        desk: mutable DesktopState::Desk = DesktopState::start(dealt)
        rolling: mutable i64 = seed % 2147483648
        for _ in 0..<160 |desk, rolling|:
            break if desk.done
            rolling <- next_state(rolling)
            draw: i64 = rolling / 128
            kind: i64 = draw % 10
            x: i64 = (draw / 16) % 200 * 5
            y: i64 = (draw / 3200) % 128 * 5
            if kind < 5:
                step: DesktopReference::Action = DesktopReference::action(&desk)
                if step.kind == DesktopReference::CLICK or step.kind == DesktopReference::DRAG:
                    _ = dprintf(1.i32(), "act %lld %lld %lld %lld %lld\n", step.kind, step.x, step.y, step.to_x, step.to_y)
                    DesktopReference::act(&desk, step)
                else:
                    _ = dprintf(1.i32(), "click %lld %lld\n", x, y)
                    DesktopPointer::click(&desk, x.f64(), y.f64())
            elif kind < 7:
                _ = dprintf(1.i32(), "click %lld %lld\n", x, y)
                DesktopPointer::click(&desk, x.f64(), y.f64())
            elif kind < 9:
                window: i64 = desk.order[((draw / 7) % desk.order.count.i64()).usize()]
                win: DesktopState::Window = desk.windows[window.usize()]
                from_x: f64 = win.x + 20.0 if kind == 7 else x.f64()
                from_y: f64 = win.y + 10.0 if kind == 7 else y.f64()
                to_x: f64 = from_x + ((draw / 11) % 41 - 20).f64() * 10.0
                to_y: f64 = from_y + ((draw / 13) % 41 - 20).f64() * 10.0
                _ = dprintf(1.i32(), "drag %.17g %.17g %.17g %.17g\n", from_x, from_y, to_x, to_y)
                DesktopPointer::press(&desk, from_x, from_y)
                DesktopPointer::release(&desk, to_x, to_y)
            else:
                _ = dprintf(1.i32(), "right %lld %lld\n", x, y)
                DesktopPointer::right_click(&desk, x.f64(), y.f64())
            emit_desk(&desk)

def sample(rung: i64, seed: i64):
    can Console.Write, Memory.Allocate, Abort.Panic:
        _ = dprintf(1.i32(), "case %lld %lld\n", rung, seed)
        run: mutable MT19937 = zeroed
        mt_seed_int(&run, seed.u64())
        again: MT19937 = run
        dealt: DesktopDeal::Deal = DesktopDeal::deal(rung, &run)
        _ = dprintf(1.i32(), "after %.17g\n", py_random(&run))
        emit_grade(&dealt.level)
        emit_controls(&dealt)
        emit_layout(&dealt)
        emit_card(&dealt)
        desk: mutable DesktopState::Desk = DesktopState::start(dealt)
        _ = dprintf(1.i32(), "reference")
        for _ in 0..<DesktopReference::MOST_STEPS |desk|:
            step: DesktopReference::Action = DesktopReference::action(&desk)
            _ = dprintf(1.i32(), " %lld %lld %lld %lld %lld", step.kind, step.x, step.y, step.to_x, step.to_y)
            break if step.kind == DesktopReference::DONE or step.kind == DesktopReference::STUCK
            DesktopReference::act(&desk, step)
        _ = dprintf(1.i32(), "\n")
        emit_desk(&desk)
        # Fresh deals for par and play: a deal passed by value shares its
        # buffers with the desk made from it.
        first: mutable MT19937 = again
        _ = dprintf(1.i32(), "par %.17g\n", DesktopReference::par(DesktopDeal::deal(rung, &first)))
        second: mutable MT19937 = again
        play(DesktopDeal::deal(rung, &second), seed * 31 + rung)
        _ = dprintf(1.i32(), "end\n")

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region fixtures(268435456)
        in fixtures:
            for rung in 0..<41:
                for seed in [0, 2, 3, 11, 17, 42, 99, 2024] |rung|:
                    sample(rung, seed)
        destroy fixtures
        return 0.i32()
