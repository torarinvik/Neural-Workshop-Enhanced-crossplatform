include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/docking_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(mode: i64):
    can Abort.Panic, Memory.Allocate, Console.Write:
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, 17.u64())
        run: mutable Docking::Run = Docking::start(Docking::build(Docking::grade(1), &rng))
        run.pos <- Docking::Vec{x: 1.0 if mode == 1 else 0.0, y: 0.0, z: -100.0 if mode == 2 else 0.0}
        Docking::step(&run, 0.125, 0)
        for i in 0..<10 |run|:
            data: mutable u8[8820] = zeroed
            begin: f64 = i.f64() * 0.1
            count: i64 = DockingAudio::render(&run, begin, begin + 0.1, &data[0], 8820)
            for j in 0..<count |data|:
                _ = printf("%02x", data[j.usize()].i32())
            _ = printf("\n")

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Console.Write:
        for mode in 0..<3:
            emit(mode)
        return 0.i32()
