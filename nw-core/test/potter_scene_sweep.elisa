include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_potter.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def frame(game: PotterGame::Session&, name: cstr):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region scratch(65536):
            in scratch:
                list: mutable Display::DisplayList = Display::DisplayList()
                ScenePotter::render(&list, game, true)
                _ = printf("frame %s %lld %lld %lld %lld %lld\n", name, game.phase, game.rung,
                    game.trial, game.wins, game.run.touching)
                for cmd in list.commands |list|:
                    if cmd.kind == Display::CMD_TEXT:
                        for i in 0..<(cmd.len & 0xffffff.u32()).i64() |list, cmd|:
                            _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                        _ = printf("\n")
                    elif cmd.kind == Display::CMD_POLYGON or cmd.kind == Display::CMD_POLY_POINT:
                        _ = printf("poly %u %u %u %.7g %.7g\n", cmd.kind, cmd.color, cmd.len, cmd.a.f64(), cmd.b.f64())
                    elif cmd.kind == Display::CMD_LINE or cmd.kind == Display::CMD_CIRCLE or cmd.kind == Display::CMD_RECT:
                        _ = printf("shape %u %u %.7g %.7g %.7g %.7g\n", cmd.kind, cmd.color,
                            cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64())
                _ = printf("end\n")

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        game: mutable PotterGame::Session = PotterGame::initialize(4, 2, true, 17)
        frame(&game, "ready")
        _ = PotterGame::start(&game, 0.0) can Global{Read,Write}
        frame(&game, "over")
        x: f64 = SceneHand::x(Potter::AXIS)
        y: f64 = SceneHand::y(Potter::band_y(6, 0.0))
        _ = PotterGame::pointer(&game, x, y, 1, 0.0) can Global{Read,Write}
        _ = PotterGame::input(&game, Potter::FASTER) can Global{Read,Write}
        _ = PotterGame::advance(&game, 0.1) can Global{Read,Write}
        frame(&game, "touch")
        _ = PotterGame::clear_controls(&game) can Global{Read,Write}
        _ = PotterGame::input(&game, Potter::WET) can Global{Read,Write}
        frame(&game, "released")
        _ = PotterGame::pointer(&game, x, y, 1, 0.1) can Global{Read,Write}
        t: mutable f64 = 0.1
        while game.phase == PotterGame::PLAYING and t < 3.0 |game, t|:
            t <- t + 0.025
            _ = PotterGame::advance(&game, t) can Global{Read,Write}
        frame(&game, "lost")
        _ = PotterGame::advance(&game, t + 2.49) can Global{Read,Write}
        frame(&game, "hold")
        t <- t + 2.5
        _ = PotterGame::advance(&game, t) can Global{Read,Write}
        frame(&game, "next")
        limit: f64 = t + 45.0
        while game.phase == PotterGame::PLAYING and t < limit |game, t, limit|:
            port: i64 = Potter::pilot(&game.run)
            _ = PotterGame::input(&game, port) can Global{Read,Write}
            t <- t + 1.0 / 60.0
            _ = PotterGame::advance(&game, t) can Global{Read,Write}
        frame(&game, "won")
        _ = PotterGame::advance(&game, t + 2.5) can Global{Read,Write}
        frame(&game, "done")
        PotterGame::close(&game) can Global{Read,Write}

        _ = PotterGame::reconfigure(&game, 13, 1, false) can Global{Read,Write}
        _ = PotterGame::start(&game, t + 3.0) can Global{Read,Write}
        frame(&game, "brief")
        for i in 1..<61 |game, t|:
            _ = PotterGame::advance(&game, t + 3.0 + 0.1 * i.f64()) can Global{Read,Write}
        frame(&game, "hidden")
        PotterGame::close(&game) can Global{Read,Write}
        return 0
