include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_juggler.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def state(run: Juggler::Trial&):
    can Abort.Panic, Console.Write:
        _ = printf("%.17g %.17g %.17g %lld %lld", run.time, run.x, run.velocity, run.result, run.flash_count)
        for i in 0..<run.act.level.count |run|:
            b: Juggler::Ball& = &run.balls[i.usize()]
            _ = printf(" %.17g %.17g %.17g %.17g %lld %lld %lld", b.x, b.y, b.vx, b.vy, 1 if b.live else 0,
                b.catches, b.trail_count)
        _ = printf("\n")

def emit(rung: i64, seed: i64):
    can Abort.Panic, Console.Write:
        act: Juggler::Act = Juggler::deal(rung, seed)
        _ = printf("%lld %lld %lld %lld %.17g %.17g %.17g\n", rung, seed, act.level.count, act.draught_seed,
            act.level.tray, act.level.draught, act.level.seconds)
        for i in 0..<act.level.count |act|:
            drop: Juggler::Drop = act.drops[i.usize()]
            _ = printf("%.17g %.17g %.17g\n", drop.time, drop.x, drop.weight)
        run: mutable Juggler::Trial = Juggler::trial(act)
        for i in 0..<640 |run|:
            port: i64 = Juggler::LEFT if i % 40 < 12 else (Juggler::RIGHT if i % 40 < 24 else Juggler::BRAKE)
            Juggler::step(&run, 1.0 / 120.0, port)
            if i % 16 == 15:
                state(&run)
        replay: Juggler::Trial = Juggler::play(act)
        state(&replay)

def main() -> i32:
    can Abort.Panic, Console.Write, Memory.Allocate:
        emit(0, -1)
        emit(1, 17)
        emit(2, -2)
        emit(4, 3)
        emit(7, -17)
        emit(10, 0)
        emit(13, 1)
        emit(16, 2)
        emit(20, 3)
        emit(30, -1)
        emit(1, -9223372036854775807 - 1)
        emit(7, 9223372036854775807)
        session: mutable JugglerGame::Session = JugglerGame::initialize(7, 1, true, 17)
        return 1.i32() if not JugglerGame::agent_event(&session, 0.0, JugglerGame::START)
        return 2.i32() if not JugglerGame::agent_event(&session, 0.0, Juggler::LEFT)
        return 3.i32() if not JugglerGame::agent_event(&session, 0.05, -1) or session.run.velocity >= 0.0
        return 4.i32() if not JugglerGame::input(&session, Juggler::RIGHT, 0.05)
        return 5.i32() if not JugglerGame::advance(&session, 0.15) or session.run.velocity <= 0.0
        return 6.i32() if not JugglerGame::input(&session, JugglerGame::CLEAR, 0.15)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneJuggler::render(&list, &session, false)
        return 7.i32() if Display::encode_binary(&list).count < 5000.usize()
        return 0.i32()
