# Differential sweep driver for src/scene_removals.elisa.
#
# See scene_removals_diff.py for the reference side, which builds the REAL
# pyglet screen headless and reads back what it drew.
#
# The frame is emitted in framerec's canonical form so the two sides are one
# string comparison. Numbers cross as the i32 their f32 bytes spell: the
# display list stores f32, that IS the contract, and comparing at f64 would
# compare a precision the format does not deliver. Bits rather than a rounded
# decimal, so that nothing is compared at a tolerance.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/display.elisa"
include "../src/tasks/removals.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_removals.elisa"

include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(512 * 1024 * 1024)
        in w:
            work: mutable Removals::RemovalsWork = Removals::RemovalsWork()
            got: mutable Removals::RemovalsRound = Removals::RemovalsRound()
            best: mutable Removals::RemovalsRound = Removals::RemovalsRound()
            # The window the reference is driven at: 912x684 reference units on
            # a retina display, so 1824x1368 physical and a scale of two.
            width: f64 = 1824.0
            height: f64 = 1368.0
            print("names|spec|rung|seed|ok|black|phase|cursor|asking_at|vans|moves|asked|trial|total_trials")
            for spec in 0..<24 |work, got, best, width, height|:
                rung: i64 = 1 + spec % 12
                seed: i64 = 1000 + spec * 7
                black: bool = spec % 6 == 5
                ok: bool = Removals::generate(&work, rung, seed, 200, &got, &best)
                phase: i64 = SceneRemovals::PHASE_MOVING if spec % 3 != 2 else SceneRemovals::PHASE_ASKING
                cursor: i64 = (spec * 3) % got.move_n if got.move_n > 0 else 0
                asking_at: i64 = spec % got.asked_n if got.asked_n > 0 else 0
                printr("spec|")
                print_i64(spec)
                emit_bar(rung)
                emit_bar(seed)
                emit_bar(1 if ok else 0)
                emit_bar(1 if black else 0)
                emit_bar(phase)
                emit_bar(cursor)
                emit_bar(asking_at)
                emit_bar(got.yard.vans)
                emit_bar(got.move_n)
                emit_bar(got.asked_n)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneRemovals::RemovalsPaint = SceneRemovals::paint_of(black, width, height, 2.0, 2.0)
                SceneRemovals::render(&list, &paint, &got, phase, rung, 1 + spec % 5,
                                      5, cursor, asking_at)
                emit_frame(&list)
                print("end")
        destroy w
        return 0
