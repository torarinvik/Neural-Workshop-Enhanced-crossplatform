# Differential sweep driver for tasks/tracking.elisa. See tracking_diff.py for
# the reference side.
#
# The bounds and the radius come from the shell, so the sweep pins them and
# compares the physics and the deal. The deal's DRAW ORDER is the load-bearing
# part -- targets sampled first, then every spawn spot, then a heading per ball
# -- so a divergence anywhere moves the whole flock rather than one number.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/pymath.elisa"
include "../src/tasks/ints.elisa"
include "../src/pymath.elisa"
include "../src/tasks/tracking.elisa"

# printr(i64) and int_to_string_scratch both trip a stage1 backend decline of
# store_* generics (repro/nw_print_int_generic_stage1.elisa), so format by hand.
def print_i64(value: i64):
    can Console.Write, Abort.Panic:
        trusted Unsafe.PointerCast:
            buf: u8[24] = zeroed
            idx: mutable i64 = 23
            n: mutable i64 = value
            if n == 0:
                idx <- 22
                buf[22] <- 48
            else:
                negative: bool = n < 0
                while n != 0:
                    digit: i64 = n % 10
                    magnitude: i64 = digit if digit >= 0 else -digit
                    idx <- idx - 1
                    buf[idx] <- (48 + magnitude).u8()
                    n <- n / 10
                if negative:
                    idx <- idx - 1
                    buf[idx] <- 45
            printr((&buf[idx]).cast[cstr])

def emit_cell(value: i64):
    can Console.Write, Abort.Panic:
        printr(",")
        print_i64(value)


def emit_scaled(value: f64):
    can Console.Write, Abort.Panic:
        emit_cell(py_round_half_even(value * 1000000.0))

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(64 * 1024 * 1024)
        in w:
            # The bounce, on both walls and well past them, with the velocity
            # both ways -- the overshoot is folded back, not clamped, so a ball
            # thrown far outside comes back proportionally far in.
            for step in 0..<21:
                position: f64 = -0.5 + step.f64() * 0.1
                for sign in 0..<2:
                    velocity: f64 = 2.0 if sign == 0 else -2.0
                    across: Tracking::Axis = Tracking::bounced(position, velocity, 0.1, 0.9)
                    printr("bounce")
                    emit_cell(step)
                    emit_cell(sign)
                    emit_scaled(across.position)
                    emit_scaled(across.velocity)
                    print("")

            # A dealt round, then flown. Ball counts span the crowding that
            # makes the scatter relax its separation.
            flock: mutable Tracking::Flock = Tracking::new_flock()
            for balls in 4..<13 |flock|:
                for seed in 1..<4 |flock, balls|:
                    rng: mutable MT19937 = mt19937_new()
                    mt_seed_int(&rng, (balls * 100 + seed).u64())
                    Tracking::deal_round(&flock, balls, 3, 0.35, 0.09, 0.06, 0.94, 0.10, 0.86, &rng)
                    printr("deal")
                    emit_cell(balls)
                    emit_cell(seed)
                    emit_cell(flock.count)
                    emit_cell(Tracking::tracked_now(&flock))
                    for at in 0..<flock.count |flock|:
                        emit_scaled(Floats::at_ref(&flock.x, at))
                        emit_scaled(Floats::at_ref(&flock.y, at))
                        emit_scaled(Floats::at_ref(&flock.vx, at))
                        emit_scaled(Floats::at_ref(&flock.vy, at))
                        emit_cell(Ints::at_ref(&flock.target, at))
                    print("")

                    # Fly it long enough that every ball has hit a wall.
                    for _tick in 0..<200 |flock|:
                        Tracking::advance(&flock, 0.05, 0.5625, 0.06, 0.94, 0.10, 0.86)
                    printr("flown")
                    emit_cell(balls)
                    emit_cell(seed)
                    for at in 0..<flock.count |flock|:
                        emit_scaled(Floats::at_ref(&flock.x, at))
                        emit_scaled(Floats::at_ref(&flock.y, at))
                        emit_scaled(Floats::at_ref(&flock.vx, at))
                        emit_scaled(Floats::at_ref(&flock.vy, at))
                    print("")
        destroy w
        return 0
