include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_nightwatch.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# Night Watch frames for nightwatch_scene_diff.py, which draws the same
# states with the reference's own NightWatch._scene and requires every one
# of its shapes, polygons and labels to appear, in order, in these frames.
#
# Mid-game states are reached by stepping the run itself, 1/60 s a step,
# exactly as the diff steps nightwatch.Run: with the reference autopilot,
# with a hand that goes for the guard and the cat, or with the view turned
# along a wide floor; then whole sessions to a pass and a fail verdict.

def frame(game: NightWatchGame::Session&, name: cstr):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region scratch(262144):
            in scratch:
                list: mutable Display::DisplayList = Display::DisplayList()
                SceneNightWatch::render(&list, game, true)
                _ = printf("frame %s %lld %lld %lld %lld %lld\n", name, game.phase, game.rung,
                    game.trial, game.wins, game.run.caught)
                for cmd in list.commands |list|:
                    if cmd.kind == Display::CMD_TEXT:
                        for i in 0..<(cmd.len & 0xffffff.u32()).i64() |list, cmd|:
                            _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                        _ = printf("\n")
                    elif cmd.kind == Display::CMD_POLYGON or cmd.kind == Display::CMD_POLY_POINT:
                        _ = printf("poly %u %u %u %.7g %.7g\n", cmd.kind, cmd.color, cmd.len, cmd.a.f64(), cmd.b.f64())
                    elif cmd.kind == Display::CMD_LINE or cmd.kind == Display::CMD_CIRCLE or cmd.kind == Display::CMD_RECT:
                        _ = printf("shape %u %u %.7g %.7g %.7g %.7g\n", cmd.kind, cmd.color,
                            cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64())
                _ = printf("end\n")

# The players the core sweep uses: 0 the autopilot, 3 the wrong people,
# 4 the view turned left and right. `until` 1 stops at the first strike.
def player(run: NightWatch::Run&, mode: i64, n: i64) -> i64:
    can Abort.Panic:
        return NightWatch::pilot(run) if mode == 0
        if mode == 3:
            return -1 if run.result != NightWatch::LIVE
            return HandView::RELEASE if run.hand.down
            best: mutable i64 = -1
            nearest: mutable f64 = 0.0
            for k in 0..<run.night.count |run, best, nearest|:
                continue if run.night.walkers[k.usize()].kind == NightWatch::THIEF
                q: NightWatch::Spot = NightWatch::spot(run, k)
                continue if not q.valid
                d: f64 = py_hypot(q.x - run.hand.x, q.y - run.hand.y)
                if best < 0 or d < nearest:
                    best <- k
                    nearest <- d
            return -1 if best < 0
            return HandView::PRESS if NightWatch::under(run) == best
            q: NightWatch::Spot = NightWatch::spot(run, best)
            return HandView::toward(&run.hand, q.x, q.y, 6.0)
        return -1 if n % 3 != 0
        return NightWatch::LEFT if (n / 30) % 2 == 0 else NightWatch::RIGHT

def walk(game: mutable NightWatchGame::Session&, steps: i64, mode: i64, until: i64 = 0):
    can Abort.Panic, Memory.Allocate, Memory.Release:
        for n in 0..<steps |game, mode, until|:
            break if game.run.result != NightWatch::LIVE
            break if until == 1 and game.run.strikes > 0
            port: i64 = player(&game.run, mode, n)
            NightWatchGame::reserve_cues(game, 8) can Global{Read,Write}
            NightWatch::act(&game.run, port)
            NightWatch::step(&game.run, 1.0 / 60.0)

def session(rung: i64) -> NightWatchGame::Session:
    can Abort.Panic, Memory.Allocate, Memory.Release:
        game: mutable NightWatchGame::Session = NightWatchGame::initialize(rung, 1, true, 17)
        _ = NightWatchGame::start(&game, 0.0) can Global{Read,Write}
        return game

def finish(game: mutable NightWatchGame::Session&, piloted: bool) -> f64:
    can Abort.Panic, Memory.Allocate, Memory.Release:
        t: mutable f64 = 0.0
        while game.phase == NightWatchGame::PLAYING and t < 400.0 |game, t, piloted|:
            port: i64 = NightWatch::pilot(&game.run) if piloted else -1
            if port >= 0:
                _ = NightWatchGame::input(game, port) can Global{Read,Write}
            t <- t + 1.0 / 60.0
            _ = NightWatchGame::advance(game, t) can Global{Read,Write}
        return t

def shot(rung: i64, steps: i64, mode: i64, name: cstr, until: i64 = 0):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        game: mutable NightWatchGame::Session = session(rung) can Global{Read,Write}
        walk(&game, steps, mode, until) can Global{Read,Write}
        frame(&game, name)
        NightWatchGame::close(&game) can Global{Read,Write}

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        game: mutable NightWatchGame::Session = NightWatchGame::initialize(1, 1, true, 17)
        frame(&game, "ready")
        NightWatchGame::close(&game) can Global{Read,Write}

        shot(1, 183, 0, "fixed") can Global{Read,Write}
        shot(10, 185, 0, "orders") can Global{Read,Write}
        shot(7, 100, 4, "wide") can Global{Read,Write}
        shot(10, 4000, 3, "struck", 1) can Global{Read,Write}
        shot(16, 187, 0, "weave") can Global{Read,Write}
        shot(10, 804, 0, "cat") can Global{Read,Write}

        game <- session(1) can Global{Read,Write}
        t: mutable f64 = finish(&game, true) can Global{Read,Write}
        frame(&game, "passed")
        _ = NightWatchGame::advance(&game, t + 2.49) can Global{Read,Write}
        frame(&game, "hold")
        _ = NightWatchGame::advance(&game, t + 2.5) can Global{Read,Write}
        frame(&game, "done")
        NightWatchGame::close(&game) can Global{Read,Write}

        game <- session(1) can Global{Read,Write}
        _ = finish(&game, false) can Global{Read,Write}
        frame(&game, "failed")
        NightWatchGame::close(&game) can Global{Read,Write}

        rungs: i64[11] = [1, 4, 7, 10, 13, 16, 20, 25, 30, 0, 200]
        for i in 0..<11 |rungs|:
            region note(4096):
                in note:
                    text: mutable dstr = []
                    SceneNightWatch::option_note(rungs[i.usize()], &text)
                    _ = printf("note %lld ", rungs[i.usize()])
                    view: sview = bytes_view(text)
                    for j in 0..<sview_len(view).i64() |view|:
                        _ = printf("%c", sview_at(view, j.usize()).i32())
                    _ = printf("\n")
        return 0
