include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "../src/tasks/signals_game.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, seed: i64):
    can Abort.Panic, Console.Write, Memory.Allocate:
        deal: Signals::Deal = Signals::deal(rung, seed)
        level: Signals::Grade = deal.level
        ref: Signals::Game = SignalsReference::reference_game(&deal)
        _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld %.17g %.17g\n",
            level.rung, level.objects, level.exchanges, level.roles, 1.i64() if level.shapes else 0.i64(),
            level.length, level.swaps, deal.change_at, ref.score, SignalsReference::guessing(&deal), SignalsReference::par(&deal))
        for g in 0..<Signals::GLYPHS |deal, g|:
            _ = printf("%lld %lld\n", deal.meaning[g.usize()], deal.changed[g.usize()])
        for at in 0..<level.exchanges |deal, level, ref, at|:
            ex: Signals::Exchange = deal.exchanges[at.usize()]
            result: Signals::Result = ref.history[at.usize()]
            said: Signals::Message = Signals::partner_says(&deal, at)
            _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld %lld", ex.role, ex.target, ex.coin,
                said.first, said.second, result.signal.first, result.signal.second, result.picked,
                1.i64() if result.right else 0.i64(), Signals::partner_picks(&deal, at, said))
            for i in 0..<level.objects |ex, i|:
                _ = printf(" %lld", ex.objects[i.usize()])
            _ = printf("\n")

def session_line(game: SignalsGame::Session&, changed: bool):
    can Console.Write:
        _ = printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld\n",
            1.i64() if changed else 0.i64(), game.phase, game.rung, game.trial, game.game.at, game.game.drafted,
            game.game.score, game.game.deal.seed, game.passed, game.best, game.last_ms, game.deadline)

def play(session: mutable SignalsGame::Session&, now: i64, perfect: bool):
    can Abort.Panic, Console.Write, Memory.Allocate, Memory.Release:
        while session.phase == SignalsGame::PLAYING |session, now, perfect|:
            dealt: Signals::Deal& = &session.game.deal
            at: i64 = session.game.at
            exchange: Signals::Exchange& = &dealt.exchanges[at.usize()]
            target: i64 = exchange.target if perfect else (exchange.target + 1) % dealt.level.objects
            if exchange.role == Signals::LISTEN:
                _ = SignalsGame::event(session, target, now)
            else:
                thing: i64 = exchange.objects[target.usize()]
                colour: i64 = Signals::glyph_for(dealt, at, thing / 4)
                shape: i64 = Signals::glyph_for(dealt, at, 4 + thing % 4)
                _ = SignalsGame::event(session, SignalsGame::SEND + colour, now)
                if perfect and at == 1:
                    session_line(session, true)
                _ = SignalsGame::event(session, SignalsGame::SEND + shape, now)

def emit_session():
    can Abort.Panic, Console.Write, Memory.Allocate, Memory.Release:
        run: mutable SignalsGame::Session = SignalsGame::initialize(12, 2, true, 17)
        session_line(&run, SignalsGame::event(&run, SignalsGame::START, 0))
        session_line(&run, SignalsGame::event(&run, SignalsGame::SEND, 50))
        play(&run, 100, true)
        session_line(&run, true)
        session_line(&run, SignalsGame::advance(&run, 2899))
        session_line(&run, SignalsGame::advance(&run, 2900))
        play(&run, 3000, false)
        session_line(&run, true)
        session_line(&run, SignalsGame::advance(&run, 5800))
        session_line(&run, SignalsGame::event(&run, SignalsGame::START, 6000))

def main() -> i32:
    can Abort.Panic, Console.Write, Memory.Allocate, Memory.Release:
        for rung in 1..<36 |rung|:
            for seed in -10..<11 |rung, seed|:
                region scratch(131072):
                    in scratch:
                        emit(rung, seed)
        emit_session()
        return 0.i32()
