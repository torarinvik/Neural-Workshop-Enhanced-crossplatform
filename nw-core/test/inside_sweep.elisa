include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/geometry.elisa"
include "../src/scene_inside.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, seed: i64) -> bool:
    can Memory.Allocate, Console.Write, Abort.Panic:
        puzzle: Inside::Puzzle = Inside::deal(rung, seed)
        return false if puzzle.count == 0
        _ = printf("%lld %lld %lld %lld %lld %lld %lld\n", rung, seed, puzzle.level.size, puzzle.answer,
            puzzle.dots[0.usize()], puzzle.dots[1.usize()], puzzle.count)
        for i in 0..<puzzle.count |puzzle|:
            _ = printf("%lld ", puzzle.loop[i.usize()])
        _ = printf("\n")
        rng: mutable MT19937 = puzzle.decoy_rng
        for _ in 0..<puzzle.level.decoys |puzzle, rng|:
            line: Inside::Stroke = Inside::decoy(puzzle.level.size, &rng)
            for i in 0..<line.count |line|:
                p: Inside::Point = line.points[i.usize()]
                _ = printf("%.17g %.17g ", p.x, p.y)
            _ = printf("\n")
        return true

def main() -> i32:
    can Memory.Allocate, Console.Write, Abort.Panic:
        for rung in -1..<36:
            for seed in -10..<10 |rung|:
                return 1.i32() if not emit(rung, seed)
        return 2.i32() if not emit(31, -9223372036854775807 - 1)
        return 3.i32() if not emit(31, 9223372036854775807)
        run: mutable InsideGame::Run = InsideGame::initialize(20, 3, true, 17)
        return 4.i32() if not InsideGame::configure_think(&run, 0.2, 0.05)
        return 5.i32() if not InsideGame::steer(&run, InsideGame::START, 0)
        return 6.i32() if run.phase != InsideGame::PLAYING or run.puzzle.count <= 4
        return 7.i32() if not InsideGame::steer(&run, run.puzzle.answer, 0)
        return 8.i32() if run.rung != 21 or run.best_rung != 20 or not run.passed
        return 9.i32() if not InsideGame::step(&run, 0.1) or run.phase != InsideGame::JUDGED
        return 10.i32() if not InsideGame::step(&run, 0.1) or run.phase != InsideGame::PLAYING
        return 11.i32() if not run.puzzle.level.pair or run.trial != 2
        return 12.i32() if not InsideGame::step(&run, 0.2) or run.phase != InsideGame::FLAGGED
        return 13.i32() if not InsideGame::step(&run, 0.1) or run.trial != 3
        return 14.i32() if run.forfeits != 1 or run.think_left != 0.05
        button: SceneHiddenRule::Rect = SceneInside::button(run.puzzle.answer)
        port: i64 = SceneInside::hit(&run, button.x + button.w / 2.0, button.y + button.h / 2.0)
        return 15.i32() if port != run.puzzle.answer
        return 16.i32() if not InsideGame::steer(&run, port, 250)
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneInside::render(&list, &run, false)
        return 17.i32() if Display::encode_binary(&list).count < 1000.usize()
        return 18.i32() if InsideGame::advance(&run, 2749) or not InsideGame::advance(&run, 2750)
        return 19.i32() if run.phase != InsideGame::DONE
        return 0.i32()
