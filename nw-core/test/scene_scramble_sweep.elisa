# Differential sweep driver for src/scene_scramble.elisa.
# See scene_scramble_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pymath.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_scramble.elisa"
include "scene_emit.elisa"

# The readings line branches at 0.05 and at 5.0, and rounds half to EVEN on
# both sides. 1.5 is the tie that tells the two roundings apart: 10^1.5 is
# 31.62, which is not a tie -- but 5.5 as a POWER is, and half-to-even sends
# it to 6 where half-up would send it to 6 as well, so 6.5 is carried too,
# where they differ.
const AMBIGUITY_COUNT: i64 = 8

def ambiguity_of(which: i64) -> f64:
    if which == 0:
        return 0.0
    elif which == 1:
        return 0.04999
    elif which == 2:
        return 0.05
    elif which == 3:
        return 1.5
    elif which == 4:
        return 4.999
    elif which == 5:
        return 5.0
    elif which == 6:
        return 5.5
    return 6.5

const MISSING: cstr = "Scramble is on its seed sentences -- for the whole word list run python -m neural_workshop.wordlist"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|has_deal|ambiguity|moves_spaces|words|show_count|stocked|trial|total_trials|tall|verdict")
            for spec in 0..<32:
                phase: i64 = spec % 4
                black: bool = spec % 7 == 1
                has_deal: bool = spec % 11 != 10
                # Divided and not modulo'd by the phase's own stride: the
                # readings line is only drawn while READING, and `spec % 8`
                # would hand every reading frame the same two values.
                which: i64 = (spec / 4) % AMBIGUITY_COUNT
                moves_spaces: bool = spec % 3 == 1
                words: i64 = 3 + spec % 9
                show_count: bool = spec % 5 != 4
                # Likewise: the missing-text line is only joined on while
                # READY, so this has to vary across the ready frames.
                stocked: bool = spec % 3 != 2
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if has_deal else 0)
                emit_bar(which)
                emit_bar(1 if moves_spaces else 0)
                emit_bar(words)
                emit_bar(1 if show_count else 0)
                emit_bar(1 if stocked else 0)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneScramble::Paint = SceneScramble::paint_of(black, width, height, 2.0, 2.0)
                SceneScramble::render(&list, &paint, phase, has_deal,
                                      sview("thec atsa tont hema t", 0, -1),
                                      sview("the cat sat on the ma", 0, -1),
                                      ambiguity_of(which), moves_spaces, words,
                                      show_count, stocked,
                                      sview(MISSING, 0, -1),
                                      1 + spec % 5, 5,
                                      sview("Rung 3 - letters only", 0, -1),
                                      verdict,
                                      sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
