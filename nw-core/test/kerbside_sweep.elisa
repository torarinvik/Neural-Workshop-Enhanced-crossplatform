include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/kerbside_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# Kerbside against kerbside.py, for kerbside_diff.py: the grade table, dealt
# streets with the reference's own checks on them, and every step of play --
# the reference autopilot at nine rungs, nobody at all, a walker who does
# not listen, and one who walks and backs in turn -- with the live sound of
# each run cut into windows.

def pcm(run: Kerbside::Run&, bank: KerbsideAudio::Bank&, cache: mutable KerbsideAudio::Phases&, start: f64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region audio(4194304):
            in audio:
                bytes: mutable u8[8824] = zeroed
                used: i64 = KerbsideAudio::render(run, bank, cache, start, start + 0.1, &bytes[0], 8824)
                _ = printf("audio %.17g\n", start)
                for j in 0..<used |bytes|:
                    _ = printf("%02x", bytes[j.usize()].i32())
                _ = printf("\n")

# 0 the autopilot, 1 nobody, 2 a walker who does not listen and sets off at
# three seconds, 3 forty steps on and twenty back.
def player(run: Kerbside::Run&, mode: i64, n: i64) -> i64:
    can Abort.Panic:
        return Kerbside::pilot(run) if mode == 0
        return -1 if mode == 1
        return (Kerbside::FORWARD if run.t >= 3.0 else -1) if mode == 2
        return Kerbside::FORWARD if n % 60 < 40 else Kerbside::BACK

def replay(rung: i64, seed: i64, mode: i64, bank: KerbsideAudio::Bank&):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(67108864):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                street: Kerbside::Street = Kerbside::deal(rung, &draw)
                _ = printf("street %lld %lld %lld %lld %d %u %lld %.17g %.17g %.17g %.17g %.17g\n", mode, rung, seed,
                    street.seed, 1 if street.valid else 0, py_getrandbits(&draw, 32).u32(), street.cars.count.i64(),
                    street.seconds, street.van_a0, street.van_b0, street.van_a1, street.van_b1)
                for car in street.cars:
                    _ = printf("car %lld %lld %.17g %.17g %d %.17g\n", car.lane, car.dir, car.speed, car.at,
                        1 if car.electric else 0, car.pitch)
                _ = printf("checks %d %d %lld\n", 1 if Kerbside::play(street, 1.0 / 30.0, 1, -1) else 0,
                    1 if Kerbside::play(street, 1.0 / 60.0, 2, -1) else 0, Kerbside::blind(street))
                run: mutable Kerbside::Run = Kerbside::begin(street)
                n: mutable i64 = 0
                while run.result == Kerbside::LIVE |run, mode, n|:
                    port: i64 = player(&run, mode, n)
                    Kerbside::step(&run, 1.0 / 120.0, port)
                    _ = printf("%lld %lld %.17g %.17g %lld\n", port, run.result, run.t, run.y, run.lane)
                    n <- n + 1
                _ = printf("end %lld %lld\n", run.result, run.notes.count.i64())
                cache: mutable KerbsideAudio::Phases = KerbsideAudio::phases(KerbsideAudio::tracks(&run))
                pcm(&run, bank, &cache, 1.0)
                pcm(&run, bank, &cache, run.t / 2.0)
                pcm(&run, bank, &cache, run.t - 0.05)
                pcm(&run, bank, &cache, 2.0)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in 0..<41:
            g: Kerbside::Grade = Kerbside::grade(rung)
            _ = printf("grade %lld %lld %.17g %.17g %.17g %d %.17g\n", g.rung, g.lanes, g.speed, g.gap, g.electric,
                1 if g.vans else 0, g.wind)
        bank: KerbsideAudio::Bank = KerbsideAudio::bank()
        for rung in [1.i64(), 4.i64(), 7.i64(), 10.i64(), 13.i64(), 16.i64(), 20.i64(), 25.i64(), 30.i64()]:
            replay(rung, 17, 0, &bank)
        replay(1, 19, 1, &bank)
        replay(4, 19, 2, &bank)
        replay(10, 19, 3, &bank)
        return 0
