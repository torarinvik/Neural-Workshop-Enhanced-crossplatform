include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/scene_beliefs.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def emit(rung: i64, seed: i64, dark: bool, phase: i64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        run: mutable BeliefsGame::Run = BeliefsGame::initialize(rung, 1, false, seed)
        ready: i64 = SceneBeliefs::hit(&run, 0.0, 0.0)
        _ = BeliefsGame::steer(&run, ready, 0)
        count: i64 = run.story.level.containers
        _ = printf("frame %lld %lld %lld %lld %lld\n", rung, seed, 1 if dark else 0, phase, ready)
        for i in 0..<count |run, count|:
            b: SceneBeliefs::Box = SceneBeliefs::button(count, i)
            _ = printf("hit %lld\n", SceneBeliefs::hit(&run, b.x + b.w / 2.0, b.y + b.h / 2.0))
        _ = printf("miss %lld\n", SceneBeliefs::hit(&run, 200.0, 450.0))
        if phase == BeliefsGame::JUDGED:
            _ = BeliefsGame::steer(&run, (run.story.answer + 1) % count, 1)
        elif phase == BeliefsGame::FLAGGED:
            run.phase <- BeliefsGame::FLAGGED
        list: mutable Display::DisplayList = Display::DisplayList()
        SceneBeliefs::render(&list, &run, dark)
        for cmd in list.commands |list|:
            if cmd.kind == Display::CMD_TEXT:
                _ = printf("text %u %.9g %.9g %.9g ", cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64())
                for i in 0..<(cmd.len & 0xffffff.u32()).i64() |cmd, list, i|:
                    _ = printf("%c", list.pool[(cmd.ref.i64() + i).usize()].i32())
                _ = printf("\n")
            elif cmd.kind == Display::CMD_RECT or cmd.kind == Display::CMD_BOX or cmd.kind == Display::CMD_CIRCLE:
                _ = printf("shape %u %u %.9g %.9g %.9g %.9g %.9g\n", cmd.kind,
                    cmd.color, cmd.a.f64(), cmd.b.f64(), cmd.c.f64(), cmd.d.f64(), cmd.e.f64())
        _ = printf("end\n")

def main() -> i32:
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        levels: i64[6] = [1, 6, 13, 21, 25, 25]
        for index in 0..<6 |levels|:
            rung: i64 = levels[index.usize()]
            seed: i64 = 222 if index == 5 else 17
            for theme in 0..<2 |rung, seed|:
                for variant in 0..<3 |rung, theme, seed|:
                    region scratch(1048576):
                        in scratch:
                            emit(rung, seed, theme != 0, [1, 2, 4][variant.usize()])
        return 0.i32()
