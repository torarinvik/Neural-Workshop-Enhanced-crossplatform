include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/shadowpuppets_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# Shadow Puppets against shadowpuppets.py, for shadowpuppets_diff.py: the 24
# ways a cube sits, the shape masks, the grade table, dealt figures, and
# every step of play -- the reference autopilot at nine rungs, nobody at
# all, and a scripted hand that presses, drags and rolls both ways.

def pcm(run: ShadowPuppets::Run&, bank: DrShapeAudio::Bank&, start: f64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region audio(524288):
            in audio:
                bytes: mutable u8[8824] = zeroed
                used: i64 = ShadowPuppetsAudio::render(run, bank, start, start + 0.1, &bytes[0], 8824)
                _ = printf("audio %.17g\n", start)
                for j in 0..<used |bytes|:
                    _ = printf("%02x", bytes[j.usize()].i32())
                _ = printf("\n")

def matrix(m: f64[9]):
    can Console.Write, Abort.Panic:
        for k in 0..<9 |m|:
            _ = printf(" %.17g", m[k.usize()])

# The player for each mode: 0 the reference autopilot, 1 nobody, 2 a script.
def player(run: ShadowPuppets::Run&, mode: i64, step: i64) -> i64:
    can Abort.Panic:
        return ShadowPuppets::pilot(run) if mode == 0
        return -1 if mode == 1
        script: i64[12] = [12, 3, 3, 0, 14, 14, 4, 1, 15, 13, 9, 6]
        return script[(step % 12).usize()]

def replay(rung: i64, seed: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(8388608):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                puppet: ShadowPuppets::Puppet = ShadowPuppets::deal(rung, &draw)
                _ = printf("puppet %lld %lld %lld %lld %d %u %lld %lld %lld", mode, rung, seed, puppet.seed,
                    1 if puppet.valid else 0, py_getrandbits(&draw, 32).u32(), puppet.front, puppet.side, puppet.count)
                matrix(puppet.start)
                for i in 0..<puppet.count |puppet|:
                    _ = printf(" %lld %lld", puppet.wanted[i.usize()], puppet.names[i.usize()])
                _ = printf("\n")
                run: mutable ShadowPuppets::Run = ShadowPuppets::begin(puppet)
                n: mutable i64 = 0
                while run.result == ShadowPuppets::LIVE |run, mode, n|:
                    port: i64 = player(&run, mode, n)
                    ShadowPuppets::act(&run, port)
                    ShadowPuppets::step(&run, 1.0 / 60.0)
                    _ = printf("%lld %lld %.17g %.17g %d %.17g %lld %.17g %.17g %.17g", port, run.result,
                        run.hand.x, run.hand.y, 1 if run.hand.down else 0, run.time, run.at, run.stay,
                        run.tone_at, ShadowPuppets::off(&run))
                    matrix(run.m)
                    _ = printf("\n")
                    n <- n + 1
                _ = printf("end %lld %lld\n", run.result, run.at)
                _ = printf("notes %lld\n", run.notes.count.i64())
                for cue in run.notes:
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g %.17g\n",
                        cue.seed, cue.voice, cue.t, cue.dur, cue.freq, cue.gain, cue.pan)
                bank: DrShapeAudio::Bank = ShadowPuppetsAudio::patches()
                pcm(&run, &bank, 0.0)
                pcm(&run, &bank, 1.0)
                pcm(&run, &bank, run.time - 0.04)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        all: f64[216] = ShadowPuppets::squares()
        for q in 0..<ShadowPuppets::SQUARES |all|:
            _ = printf("square")
            matrix(ShadowPuppets::square(&all, q))
            _ = printf("\n")
        _ = printf("cells")
        for s in 0..<ShadowPuppets::SHAPES:
            _ = printf(" %lld", ShadowPuppets::cells(s))
        _ = printf("\n")
        for rung in 0..<81:
            g: ShadowPuppets::Grade = ShadowPuppets::grade(rung)
            _ = printf("grade %lld %d %lld %.17g %lld %d %d %.17g\n", g.rung, 1 if g.flat else 0, g.shadows,
                g.near, g.shown, 1 if g.tone else 0, 1 if g.hidden else 0, g.seconds)
        for rung in [1.i64(), 4.i64(), 7.i64(), 10.i64(), 13.i64(), 16.i64(), 20.i64(), 25.i64(), 30.i64()]:
            replay(rung, 17, 0)
        replay(1, 19, 1)
        replay(4, 19, 2)
        return 0
