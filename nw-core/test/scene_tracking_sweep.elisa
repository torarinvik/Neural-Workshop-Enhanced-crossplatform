# Differential sweep driver for src/scene_tracking.elisa.
# See scene_tracking_diff.py for the reference side.

include "../../../Elisa-compiler-latest/elisacore_std/elisacore_runtime.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_rng.elisa"
include "../../../Elisa-compiler-latest/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_tracking.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|balls|round|total_rounds|tall|verdict")
            for spec in 0..<36:
                phase: i64 = spec % 6
                black: bool = spec % 7 == 1
                count: i64 = 3 + (spec / 6) % 6 * 5
                # Zero rounds is a real state: the counter is joined on only
                # when there is a total to count against.
                total_rounds: i64 = 0 if spec % 11 == 10 else 8
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 4 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(count)
                emit_bar(1 + spec % 8)
                emit_bar(total_rounds)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                # A deterministic flock: every combination of target and
                # picked appears, because the reveal colours all four.
                balls: mutable darray[SceneTracking::TrackingBall] = []
                for index in 0..<count |balls, count|:
                    balls.push(SceneTracking::TrackingBall{
                        x: 0.07 + (index % 7).f64() * 0.13,
                        y: 0.13 + (index % 5).f64() * 0.17,
                        target: index % 2 == 0,
                        picked: index % 3 == 0})
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneTracking::TrackingPaint = SceneTracking::paint_of(black, width, height, 2.0, 2.0)
                SceneTracking::render(&list, &paint, phase, &balls,
                                      1 + spec % 8, total_rounds,
                                      sview("Follow the orange balls", 0, -1),
                                      verdict,
                                      sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
