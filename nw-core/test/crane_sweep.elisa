include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/crane_game.elisa"

extern dprintf(fd: i32, format: cstr, ...) -> i32 can[Console.Write]

def emit(yard: Crane::Yard&):
    can Abort.Panic, Console.Write:
        level: Crane::Grade = yard.level
        _ = dprintf(1.i32(), "yard %lld %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g %lld %.17g %.17g %lld\n",
            level.rung, level.boxes, level.damping, level.wall, level.wind, level.gusts,
            level.roll, level.speed, level.seconds, 1 if level.two_high else 0, yard.wall_x, yard.wind_sign, yard.gust_seed)
        for i in 0..<yard.bay_count |yard|:
            bay: Crane::Bay = yard.bays[i.usize()]
            _ = dprintf(1.i32(), "bay %.17g %lld\n", bay.x, bay.colour)
        for i in 0..<level.boxes |yard|:
            box: Crane::Box = yard.boxes[i.usize()]
            _ = dprintf(1.i32(), "box %lld %.17g %lld\n", box.colour, Crane::column_x(box.column), box.level)

def tick_line(run: Crane::Run&, port: i64):
    can Abort.Panic, Console.Write:
        tip: Crane::Position = Crane::hook(run)
        speed: Crane::Position = Crane::velocity(run)
        _ = dprintf(1.i32(), "tick %lld %.17g %.17g %.17g %.17g %.17g %.17g %lld %lld %lld %.17g %.17g %.17g %.17g %.17g",
            port, run.t, run.x, run.v, run.cable, run.theta, run.omega, run.held, run.placed, run.result,
            run.last_grab, tip.x, tip.y, speed.x, speed.y)
        for i in 0..<run.yard.level.boxes |run|:
            box: Crane::Position = Crane::box_rect(run, i)
            _ = dprintf(1.i32(), " %lld %.17g %.17g", run.location[i.usize()], box.x, box.y)
        _ = dprintf(1.i32(), "\n")

def replay(rung: i64, seed: i64, mode: i64):
    can Abort.Panic, Console.Write:
        _ = dprintf(1.i32(), "case %lld %lld %lld\n", rung, seed, mode)
        rng: mutable MT19937 = zeroed
        mt_seed_int(&rng, seed.u64())
        if mode == 0:
            for _ in 0..<3 |rung, rng|:
                yard: Crane::Yard = Crane::build(Crane::grade(rung), &rng)
                emit(&yard)
        else:
            yard: Crane::Yard = CraneReference::deal_seed(rung, seed) if mode == 2 or mode == 4 else Crane::build(Crane::grade(rung), &rng)
            emit(&yard)
            if mode == 4:
                _ = dprintf(1.i32(), "end\n")
                return
            run: mutable Crane::Run = Crane::start(yard)
            pilot: mutable CraneReference::Pilot = zeroed
            tick: mutable i64 = 0
            while run.result == Crane::LIVE and (mode != 3 or tick < 900) |mode, run, pilot, tick|:
                port: i64 = (tick / 63) % 6 - 1 if mode == 3 else CraneReference::choose(&pilot, &run)
                CraneReference::apply(&run, port, 1.0 / 60.0)
                tick_line(&run, port)
                tick <- tick + 1
        _ = dprintf(1.i32(), "end\n")

def edges():
    can Abort.Panic, Console.Write:
        _ = dprintf(1.i32(), "edges\n")
        yard: Crane::Yard = CraneReference::deal_seed(1, 17)
        for scenario in [0, 2, 3, 4, 5, 6] |yard|:
            run: mutable Crane::Run = Crane::start(yard)
            index: i64 = CraneReference::next_box(&run)
            origin: Crane::Position = Crane::box_rect(&run, index)
            run.x <- origin.x
            run.cable <- Crane::RAIL - (origin.y + Crane::BOX_H)
            Crane::grab(&run)
            tick_line(&run, Crane::GRAB)
            bay: i64 = CraneReference::bay_for(&run, yard.boxes[index.usize()].colour)
            target: i64 = 1 - bay if scenario == 3 else bay
            run.x <- 18.0 if scenario == 4 else yard.bays[target.usize()].x
            run.cable <- Crane::RAIL - (Crane::BOX_H + (3.0 if scenario == 2 else -0.2 if scenario == 0 or scenario == 5 else 0.0))
            if scenario == 5:
                run.v <- 1.0
            if scenario == 6:
                run.t <- yard.level.seconds
                Crane::step(&run, 0.01, Crane::NEUTRAL)
            elif scenario == 0 or scenario == 5:
                Crane::collide(&run)
            else:
                Crane::grab(&run)
            tick_line(&run, Crane::NEUTRAL)

def session_trace():
    can Abort.Panic, Console.Write:
        _ = dprintf(1.i32(), "session\n")
        session: mutable CraneGame::Session = CraneGame::initialize(7, 2, true, 17)
        _ = CraneGame::start(&session, 0.0)
        for at in 1..<13 |session|:
            now: f64 = at.f64() * 0.125
            if at == 1:
                _ = CraneGame::key(&session, 1, true)
            elif at == 2:
                _ = CraneGame::key(&session, 4, true)
            elif at == 3:
                _ = CraneGame::key(&session, 0, true)
                _ = CraneGame::key(&session, 4, false)
            elif at == 4:
                _ = CraneGame::agent_event(&session, now, Crane::DOWN)
            elif at == 6:
                _ = CraneGame::clear_keys(&session)
            elif at == 7:
                _ = CraneGame::agent_event(&session, now, Crane::GRAB)
            elif at == 10:
                session.run.placed <- session.run.yard.level.boxes
            _ = CraneGame::advance(&session, now)
            _ = dprintf(1.i32(), "phase %lld %lld %lld %lld %lld %.17g\n", session.phase,
                session.rung, session.trial, session.wins, session.best_rung, session.deadline)
            tick_line(&session.run, Crane::NEUTRAL)
        if CraneGame::advance(&session, session.deadline):
            emit(&session.run.yard)
        session.run.t <- session.run.yard.level.seconds
        _ = CraneGame::agent_event(&session, 5.0, Crane::NEUTRAL)
        _ = CraneGame::agent_event(&session, 5.125, Crane::NEUTRAL)
        _ = dprintf(1.i32(), "done %lld %lld %lld %lld %lld\n", session.phase,
            session.rung, session.trial, session.wins, session.best_rung)
        _ = CraneGame::reconfigure(&session, 4, 1, false)
        _ = CraneGame::start(&session, 6.0)
        emit(&session.run.yard)

def main() -> i64:
    can Abort.Panic, Console.Write:
        for rung in [0, 1, 4, 7, 10, 13, 16, 20, 25, 30, 60]:
            for seed in [0, 17, 42] |rung|:
                replay(rung, seed, 0)
        for rung in [1, 4, 7, 10, 13, 16, 20, 25, 30]:
            replay(rung, 17, 1)
            replay(rung, 42, 3)
        replay(1, 17, 2)
        replay(7, 17, 2)
        replay(20, 6, 4)
        replay(60, 0, 4)
        edges()
        session_trace()
        return 0
