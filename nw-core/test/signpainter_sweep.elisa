include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/signpainter_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

def pcm(run: SignPainter::Run&, bank: DrShapeAudio::Bank&, start: f64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region audio(524288):
            in audio:
                bytes: mutable u8[8824] = zeroed
                used: i64 = SignPainterAudio::render(run, bank, start, start + 0.1, &bytes[0], 8824)
                _ = printf("audio %.17g\n", start)
                for j in 0..<used |bytes|:
                    _ = printf("%02x", bytes[j.usize()].i32())
                _ = printf("\n")

def layout(sign: SignPainter::Sign&):
    can Console.Write, Abort.Panic:
        for i in 0..<sview_len(sign.word).i64() |sign|:
            _ = printf("%c", sview_at(sign.word, i.usize()).i32())
        _ = printf(" %lld %.17g %lld %lld %lld %lld\n", sign.colour, sign.seconds, sign.seed,
            sign.point_count, sign.stroke_count, sign.corner_count)
        for i in 0..<sign.stroke_count |sign|:
            _ = printf("%lld ", sign.ends[i.usize()])
        _ = printf("\n")
        for i in 0..<sign.point_count |sign|:
            p: RoomsView::Point = sign.points[i.usize()]
            _ = printf("%.17g %.17g\n", p.x, p.y)
        for i in 0..<sign.corner_count |sign|:
            p: RoomsView::Point = sign.corners[i.usize()]
            _ = printf("%.17g %.17g\n", p.x, p.y)

def replay(rung: i64, seed: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(2097152):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                sign: SignPainter::Sign = SignPainter::deal(rung, &draw)
                _ = printf("sign %lld %lld %lld %d %u\n", mode, rung, seed, 1 if sign.valid else 0, py_getrandbits(&draw, 32).u32())
                layout(&sign)
                run: mutable SignPainter::Run = SignPainter::begin(sign)
                tick: mutable i64 = 0
                while run.result == SignPainter::LIVE |run, mode, tick, sign|:
                    port: mutable i64 = -1
                    if mode == 0:
                        port <- SignPainter::pilot(&run)
                    elif mode == 1:
                        port <- SignPainter::RED + (sign.colour + 1) % 4 if tick == 0 else (HandView::PRESS if tick % 2 == 1 else HandView::RELEASE)
                    elif mode == 2:
                        if tick == 0:
                            p: RoomsView::Point = sign.points[0]
                            q: RoomsView::Vec = SignPainter::see(&run, p.x, p.y)
                            HandView::place(&run.hand, q.x, q.y)
                        else:
                            HandView::place(&run.hand, 480.0, 285.0)
                        port <- HandView::PRESS if tick == 0 or tick % 2 == 0 else HandView::RELEASE
                    elif tick == 0:
                        port <- HandView::PRESS
                    SignPainter::act(&run, port)
                    SignPainter::step(&run, 1.0 / 60.0)
                    _ = printf("%lld %lld %.17g %.17g %d %.17g %lld %lld %lld %lld %lld %d %d",
                        port, run.result, run.hand.x, run.hand.y, 1 if run.hand.down else 0, run.time,
                        run.stroke, run.point, run.colour, run.paint, run.smudges,
                        1 if run.smudged_now else 0, 1 if run.has_brush else 0)
                    if run.has_brush:
                        _ = printf(" %.17g %.17g", run.brush.x, run.brush.y)
                    _ = printf("\n")
                    tick <- tick + 1
                _ = printf("notes %lld\n", run.notes.count.i64())
                for cue in run.notes:
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g %.17g\n",
                        cue.seed, cue.voice, cue.t, cue.dur, cue.freq, cue.gain, cue.pan)
                bank: DrShapeAudio::Bank = SignPainterAudio::patches()
                pcm(&run, &bank, 0.0)
                pcm(&run, &bank, 1.2)
                pcm(&run, &bank, run.time - 0.04)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in 0..<81:
            g: SignPainter::Grade = SignPainter::grade(rung)
            _ = printf("grade %lld %lld %.17g %d %lld %lld %.17g %.17g %.17g\n",
                g.rung, g.length, g.brush, 1 if g.colour else 0, g.guide, g.load, g.swing, g.drag, g.seconds)
        for rung in [1.i64(), 10.i64(), 16.i64()]:
            for seed in 0..<64 |rung|:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                sign: SignPainter::Sign = SignPainter::build(SignPainter::grade(rung), &draw)
                layout(&sign)
        for rung in [1.i64(), 4.i64(), 7.i64(), 10.i64(), 13.i64(), 16.i64(), 20.i64(), 25.i64(), 30.i64()]:
            replay(rung, 17, 0)
        replay(4, 17, 1)
        replay(1, 17, 2)
        replay(7, 17, 3)
        return 0
