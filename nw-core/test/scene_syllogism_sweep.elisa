# Differential sweep driver for src/scene_syllogism.elisa.
# See scene_syllogism_diff.py for the reference side.

include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/textmetrics.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_syllogism.elisa"
include "scene_emit.elisa"

# Premise blocks of 2, 7 and 13 lines: the size steps at 6 and at 10, so one
# block sits in each band.
const BLOCK_COUNT: i64 = 3

def block_of(which: i64) -> cstr:
    if which == 0:
        return "Alice is taller than Bob.\nBob is taller than Carol."
    elif which == 1:
        return "Alice is taller than Bob.\nBob is taller than Carol.\nCarol is taller than Dave.\nDave is taller than Erin.\nErin is taller than Frank.\nFrank is taller than Grace.\nGrace is taller than Heidi."
    return "Alice is taller than Bob.\nBob is taller than Carol.\nCarol is taller than Dave.\nDave is taller than Erin.\nErin is taller than Frank.\nFrank is taller than Grace.\nGrace is taller than Heidi.\nHeidi is taller than Ivan.\nIvan is taller than Judy.\nJudy is taller than Karl.\nKarl is taller than Lena.\nLena is taller than Mona.\nMona is taller than Nate."

def block_lines(which: i64) -> i64:
    if which == 0:
        return 2
    elif which == 1:
        return 7
    return 13

# The answers. Past twelve they are shortened word by word, so the long set is
# the compass sentences the shortening was written for.
const ANSWER_COUNT: i64 = 27

def answer_of(which: i64) -> cstr:
    ring: i64 = which % 9
    if ring == 0:
        return "north and east"
    elif ring == 1:
        return "south and west"
    elif ring == 2:
        return "above and north"
    elif ring == 3:
        return "below and south"
    elif ring == 4:
        return "east"
    elif ring == 5:
        return "west and above"
    elif ring == 6:
        return "north"
    elif ring == 7:
        return "nowhere in particular"
    return "below"

const HINT: cstr = "no two of them are equal, so \"not more than\" means \"less than\""

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|has_question|block|answers|choice|answered|trial|total_trials|tall|verdict")
            for spec in 0..<48:
                phase: i64 = spec % 4
                black: bool = spec % 7 == 1
                has_question: bool = spec % 17 != 16
                which: i64 = (spec / 4) % BLOCK_COUNT
                # 3, 5, 9, 12 and 27 answers: one column, one column at the
                # edge of it, numbered, unnumbered, and the shortened four.
                shown: i64 = shown_of((spec / 4) % 5)
                choice: i64 = spec % shown
                answered: i64 = (spec + 1) % shown
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(1 if has_question else 0)
                emit_bar(which)
                emit_bar(shown)
                emit_bar(choice)
                emit_bar(answered)
                emit_bar(1 + spec % 5)
                emit_bar(5)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                options: mutable darray[sview] = []
                for one in 0..<shown |options|:
                    options.push(sview(answer_of(one), 0, -1))
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneSyllogism::SyllogismPaint = SceneSyllogism::paint_of(black, width, height, 2.0, 2.0)
                SceneSyllogism::render(&list, &paint, phase, has_question,
                                       sview(block_of(which), 0, -1),
                                       block_lines(which),
                                       sview("Who is the tallest?", 0, -1),
                                       sview(HINT, 0, -1), &options,
                                       choice, answered, 1 + spec % 5, 5,
                                       sview("Rung 3 - order", 0, -1), verdict,
                                       sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0

def shown_of(which: i64) -> i64:
    if which == 0:
        return 3
    elif which == 1:
        return 5
    elif which == 2:
        return 9
    elif which == 3:
        return 12
    return 27
