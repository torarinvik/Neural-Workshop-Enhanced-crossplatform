# Differential sweep driver for src/scene_salesman.elisa.
# See scene_salesman_diff.py for the reference side.

include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_rng.elisa"
include "../../worktrees/elisa-core-nw/compiler/runtime/elisacore_std/elisacore_math.elisa"
include "../src/pyrandom.elisa"
include "../src/tasks/ints.elisa"
include "../src/strings.elisa"
include "../src/geometry.elisa"
include "../src/verdict.elisa"
include "../src/display.elisa"
include "../src/scene_verdict.elisa"
include "../src/scene_salesman.elisa"
include "scene_emit.elisa"

def main() -> i64:
    can Console.Write, Memory.Allocate, Abort.Panic:
        region w(256 * 1024 * 1024)
        in w:
            print("names|spec|phase|black|cities|steps|show_best|round|total_rounds|tall|verdict")
            for spec in 0..<40:
                phase: i64 = spec % 4
                black: bool = spec % 7 == 1
                count: i64 = 4 + (spec / 4) % 5 * 2
                # 0, 1 and the full tour all matter: an empty route starts
                # from no city, a one-city route has no closing edge, and a
                # full one has every edge and every circle recoloured.
                steps: i64 = (spec / 4) % (count + 1)
                show_best: bool = spec % 5 != 4
                tall: i64 = 1368 if spec % 2 == 0 else 960
                verdict: i64 = (spec % 3) - 1 if phase == 2 else -1
                width: f64 = 1824.0
                height: f64 = tall.f64()
                printr("spec|")
                print_i64(spec)
                emit_bar(phase)
                emit_bar(1 if black else 0)
                emit_bar(count)
                emit_bar(steps)
                emit_bar(1 if show_best else 0)
                emit_bar(1 + spec % 6)
                emit_bar(6)
                emit_bar(tall)
                emit_bar(verdict)
                print("")
                # Cities on an irrational-ish spiral, mirrored by the harness.
                cities: mutable darray[SceneSalesman::Point] = []
                for index in 0..<count |cities, count|:
                    cities.push(SceneSalesman::Point{
                        x: 0.05 + 0.9 * ((index * 37) % 100).f64() / 100.0,
                        y: 0.05 + 0.9 * ((index * 61) % 100).f64() / 100.0})
                # The route visits every OTHER city first, so it is not the
                # identity permutation and an off-by-one in the edges shows.
                route: mutable darray[i64] = Ints::zeros(count)
                for at in 0..<count |route, count|:
                    Ints::put(&route, at, (at * 3) % count)
                best: mutable darray[i64] = Ints::zeros(count)
                for at in 0..<count |best, count|:
                    Ints::put(&best, at, (count - 1 - at))
                list: mutable Display::DisplayList = Display::DisplayList()
                paint: SceneSalesman::Paint = SceneSalesman::paint_of(black, width, height, 2.0, 2.0)
                SceneSalesman::render(&list, &paint, phase, &cities, &route,
                                      steps, &best, count, show_best,
                                      1 + spec % 6, 6, count,
                                      sview("Eight cities", 0, -1), verdict,
                                      sview("Right", 0, -1) if verdict == 1 else sview("No", 0, -1))
                emit_frame(&list)
                print("end")
        destroy w
        return 0
