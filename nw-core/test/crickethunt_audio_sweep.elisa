include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/crickethunt_audio.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# Cricket Hunt's live sound against crickethunt.mix, for
# crickethunt_audio_diff.py: tries played by the reference autopilot at
# several rungs (the hum and hopping crickets among them) and one of three
# grabs at nothing, each cut into windows -- before the start, at it, as
# the head turns, across each note, past the last setting as the tracks
# fade, and at awkward offsets.

def pcm(run: CricketHunt::Run&, bank: CricketHuntAudio::Bank&, start: f64, width: f64):
    can Console.Write, Memory.Allocate, Memory.Release, Abort.Panic:
        region audio(8388608):
            in audio:
                bytes: mutable u8[88204] = zeroed
                used: i64 = CricketHuntAudio::render(run, bank, start, start + width, &bytes[0], 88204)
                _ = printf("audio %.17g %.17g\n", start, width)
                for j in 0..<used |bytes|:
                    _ = printf("%02x", bytes[j.usize()].i32())
                _ = printf("\n")

def replay(rung: i64, seed: i64, grabs: bool, bank: CricketHuntAudio::Bank&):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(134217728):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                room: CricketHunt::Room = CricketHunt::deal(rung, &draw)
                run: mutable CricketHunt::Run = CricketHunt::begin(room, true)
                n: mutable i64 = 0
                while run.result == CricketHunt::LIVE |run, n, grabs|:
                    port: mutable i64 = CricketHunt::pilot(&run)
                    if grabs:
                        port <- CricketHunt::GRAB if n % 20 == 10 else CricketHunt::RIGHT
                    CricketHunt::act(&run, port) if port == CricketHunt::GRAB
                    CricketHunt::step(&run, 1.0 / 30.0, port if port != CricketHunt::GRAB else -1)
                    n <- n + 1
                _ = printf("run %lld %lld %d %lld %.17g %lld\n", rung, seed, 1 if grabs else 0, run.result, run.t,
                    run.notes.count.i64())
                pcm(&run, bank, -0.15, 0.1)
                pcm(&run, bank, 0.0, 0.1)
                pcm(&run, bank, 0.37, 0.25)
                pcm(&run, bank, run.t / 2.0, 0.1)
                for note in run.notes |run, bank|:
                    pcm(&run, bank, note.t - 0.05, 0.4)
                pcm(&run, bank, run.t - 0.1, 0.5)
                pcm(&run, bank, run.t + 0.2, 0.1)
                pcm(&run, bank, 1.0 / 3.0, 1.0)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region banks(16777216):
            in banks:
                bank: CricketHuntAudio::Bank = CricketHuntAudio::bank()
                for rung in [1.i64(), 4.i64(), 8.i64(), 10.i64()]:
                    replay(rung, 17, false, &bank)
                replay(2, 3, true, &bank)
        return 0
