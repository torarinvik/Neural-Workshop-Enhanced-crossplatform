include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_runtime.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_rng.elisa"
include "@ELISA_STAGE1_ROOT@/elisacore_std/elisacore_math.elisa"
include "../src/tasks/glove.elisa"

extern printf(format: cstr, ...) -> i32 can[Console.Write]

# Glove against glove.py, for glove_diff.py: the grade table, the dealt
# innings -- every pitch's flight and crossing, the camera's cuts -- and every
# step of an inning: the reference autopilot at nine rungs, nobody at the
# glove, every port in turn, and up and right held in turn.

def player(run: Glove::Run&, mode: i64, n: i64) -> i64:
    can Abort.Panic:
        return Glove::pilot(run) if mode == 0
        return -1 if mode == 1
        return (n / 20) % 5 - 1 if mode == 2
        return Glove::UP if (n / 90) % 2 == 0 else Glove::RIGHT

def replay(rung: i64, seed: i64, mode: i64):
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        region trial(67108864):
            in trial:
                draw: mutable MT19937 = zeroed
                mt_seed_int(&draw, seed.u64())
                game: Glove::Game = Glove::deal(rung, &draw)
                _ = printf("game %lld %lld %lld %d %u %.17g %lld\n", mode, rung, seed, 1 if game.valid else 0,
                    py_getrandbits(&draw, 32).u32(), game.seconds, game.cuts)
                for k in 0..<game.level.pitches |game|:
                    p: Glove::Pitch& = &game.pitches[k.usize()]
                    _ = printf("pitch %.17g %lld %.17g %.17g %.17g\n", p.at, p.count, p.cross_x, p.cross_y, p.cross_t)
                    for i in 0..<p.count |p|:
                        _ = printf("%.17g %.17g %.17g %.17g\n", p.ts[i.usize()], p.xs[i.usize()], p.ys[i.usize()], p.zs[i.usize()])
                for c in 0..<game.cuts |game|:
                    _ = printf("cut %.17g %lld\n", game.cut_at[c.usize()], game.cut_view[c.usize()])
                run: mutable Glove::Run = Glove::begin(game)
                n: mutable i64 = 0
                while run.result == Glove::LIVE |run, mode, n|:
                    port: i64 = player(&run, mode, n)
                    Glove::step(&run, 1.0 / 120.0, port)
                    way: Glove::Axes = Glove::axes(Glove::view(&run), run.glove_x, run.glove_y)
                    seen: Glove::Two = Glove::project(Glove::view(&run), run.glove_x, run.glove_y, 0.0)
                    b: i64 = Glove::ball(&run)
                    at: f64[3] = Glove::ball_point(&run, b) if b >= 0 else [0.0, 0.0, 0.0]
                    _ = printf("%lld %lld %.17g %.17g %.17g %lld %lld %lld %lld %lld %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %d %.17g %d\n",
                        port, run.result, run.t, run.glove_x, run.glove_y, run.next, run.caught, run.missed, Glove::view(&run), b,
                        at[0], at[1], at[2], way.right.x, way.right.y, way.up.x, way.up.y, seen.x, seen.y,
                        1 if run.flashed else 0, run.flash_t, 1 if run.flash_got else 0)
                    n <- n + 1
                _ = printf("end %lld %lld %lld %lld\n", run.result, run.caught, run.missed, run.notes.count.i64())
                for note in run.notes:
                    _ = printf("%lld %lld %.17g %.17g %.17g %.17g\n", note.seed, note.voice, note.t, note.freq, note.dur, note.gain)

def main() -> i32:
    can Console.Write, Abort.Panic, Memory.Allocate, Memory.Release:
        for rung in 0..<41:
            g: Glove::Grade = Glove::grade(rung)
            _ = printf("grade %lld %lld %lld %.17g %.17g %.17g %d %lld %.17g %.17g\n", g.rung, g.pitches, g.misses, g.speed,
                g.curve, g.cut, 1 if g.per_pitch else 0, g.views, g.glove, g.spread)
        for rung in [1.i64(), 2.i64(), 4.i64(), 7.i64(), 10.i64(), 13.i64(), 16.i64(), 20.i64(), 30.i64()]:
            replay(rung, 17, 0)
        replay(1, 19, 1)
        replay(4, 19, 2)
        replay(10, 19, 3)
        replay(13, 23, 2)
        return 0
